// json: recursive-descent JSON parse + stringify.
//
// `JsonValue` is the tagged union of every JSON shape. `parse` returns
// `JsonValue | JsonError` ; parse failures surface as the `JsonError` variant,
// propagated by an explicit `if e is JsonError { return e }` narrowing guard.
// `stringify` writes a value back, compact or indented. `member` and its typed
// forms read an object without a match on every shape, and `sequence_entry`
// frames a value for a JSON text sequence (RFC 7464).
//
// Numbers are stored as `f64`: fine for the compiler's use cases
// (manifests, diagnostics) but loses precision past 2^53. Cf. TODO.md `std/json`
// v2 for generated serialisers à la kotlinx-serialization.

module "json"

import "std/string"
import "std/char"
import "std/string_builder"
import "std/collections"
import "std/numbers"

// ---- value tree -----------------------------------------------------------

/// Tagged union covering every JSON shape (`null`, `true`/`false`, numbers,
/// strings, arrays, objects). Discriminated via `is JsonString` etc. in
/// `match`. Numbers carry an `f64` ; precision past 2^53 is lost (a known
/// limitation).
export JsonValue :: JsonString | JsonNumber | JsonBool | JsonNull | JsonArray | JsonObject

/// JSON string variant: UTF-8 decoded, escape-resolved.
export JsonString :: struct { value: string }

/// JSON number variant: `f64`. Integer-valued numbers round-trip
/// through `to_compact_string` for cleaner output.
export JsonNumber :: struct { value: f64 }

/// JSON `true`/`false`.
export JsonBool :: struct { value: bool }

/// JSON `null`. No payload.
export JsonNull :: struct {}

/// JSON array: ordered list of `JsonValue`s.
export JsonArray :: struct { items: JsonValue[] }

/// JSON object: string-keyed map of `JsonValue`s. Insertion order is
/// preserved by the parser ; lookup is O(1) average via `Map`.
export JsonObject :: struct { entries: Map<string, JsonValue> }

// ---- error ----------------------------------------------------------------

/// Error raised by `parse` when the input isn't valid JSON. `pos` is the
/// byte offset of the offending character.
export JsonError :: struct {
    msg: string
    pos: i64
}

JsonError implements Error {
    message :: fn(self) -> string = self.msg
}

// ---- parser ---------------------------------------------------------------

Parser :: struct {
    src: string
    pos: i64 = 0
}

at_end :: fn(p: Parser) = p.pos >= p.src.byte_len()

peek_byte :: fn(p: Parser) -> char {
    if at_end(p) {
        return '\0'
    }
    return char(p.src.byte_at(p.pos))
}

advance :: fn(p: Parser) -> void {
    p.pos = p.pos + 1
}

skip_ws :: fn(p: Parser) -> void {
    for !at_end(p) {
        if is_white_char(peek_byte(p)) {
            advance(p)
        } else {
            return
        }
    }
}

fail :: fn(p: Parser, msg: string) -> JsonError {
    return JsonError { .msg = msg, .pos = p.pos }
}

expect_byte :: fn(p: Parser, expected: char) -> JsonError | null {
    if at_end(p) {
        return fail(p, "unexpected end of input")
    }
    if peek_byte(p) != expected {
        return fail(p, "unexpected character")
    }
    advance(p)
    return null
}

match_keyword :: fn(p: Parser, kw: string) -> bool {
    if !p.src.matches_at(p.pos, kw) {
        return false
    }
    p.pos += kw.byte_len()
    return true
}

// ---- parse value dispatch -------------------------------------------------

/// Maximum container-nesting depth. A guard against unbounded recursion on
/// adversarial input (`[[[[...` / `{"a":{"a":...`) : without it a deep document
/// overflows the call stack (VM trap / native segfault) instead of returning a
/// `JsonError`. Kept well under the VM's 1024-frame limit (each nesting level
/// costs ~2 frames) and comfortably above any realistic document.
MAX_DEPTH :: 200

parse_value :: fn(p: Parser, depth: i32) -> JsonValue | JsonError {
    if depth > MAX_DEPTH {
        return fail(p, "maximum nesting depth exceeded")
    }
    skip_ws(p)
    if at_end(p) {
        return fail(p, "unexpected end of input")
    }
    c :: peek_byte(p)
    if c == '"' {
        s :: parse_string(p)
        if s is JsonError { return s }
        return JsonString { .value = s }
    }
    if c == '{' {
        obj :: parse_object(p, depth)
        if obj is JsonError { return obj }
        return obj
    }
    if c == '[' {
        arr :: parse_array(p, depth)
        if arr is JsonError { return arr }
        return arr
    }
    if c == 't' || c == 'f' {
        bv :: parse_bool(p)
        if bv is JsonError { return bv }
        return bv
    }
    if c == 'n' {
        nv :: parse_null(p)
        if nv is JsonError { return nv }
        return nv
    }
    if c == '-' || is_digit(c) {
        num :: parse_number(p)
        if num is JsonError { return num }
        return num
    }
    return fail(p, "unexpected character")
}

// ---- literal-keyword parsers ---------------------------------------------

parse_null :: fn(p: Parser) -> JsonNull | JsonError {
    if !match_keyword(p, "null") {
        return fail(p, "expected `null`")
    }
    return JsonNull {}
}

parse_bool :: fn(p: Parser) -> JsonBool | JsonError {
    if match_keyword(p, "true") {
        return JsonBool { .value = true }
    }
    if match_keyword(p, "false") {
        return JsonBool { .value = false }
    }
    return fail(p, "expected `true` or `false`")
}

// ---- number parser --------------------------------------------------------

parse_number :: fn(p: Parser) -> JsonNumber | JsonError {
    start :: p.pos
    if peek_byte(p) == '-' {
        advance(p)
    }
    if at_end(p) || !is_digit(peek_byte(p)) {
        return fail(p, "expected digit")
    }
    // RFC 8259 `int = zero / (digit1-9 *DIGIT)`: the integer part is a lone `0`
    // or a nonzero digit followed by more ; a leading zero (`01`, `-0123`) is
    // invalid.
    first_digit :: peek_byte(p)
    advance(p)
    if first_digit == '0' && !at_end(p) && is_digit(peek_byte(p)) {
        return fail(p, "leading zeros are not allowed")
    }
    for !at_end(p) && is_digit(peek_byte(p)) {
        advance(p)
    }
    if !at_end(p) && peek_byte(p) == '.' {
        advance(p)
        if at_end(p) || !is_digit(peek_byte(p)) {
            return fail(p, "expected digit after `.`")
        }
        for !at_end(p) && is_digit(peek_byte(p)) {
            advance(p)
        }
    }
    if !at_end(p) && (peek_byte(p) == 'e' || peek_byte(p) == 'E') {
        advance(p)
        if !at_end(p) && (peek_byte(p) == '+' || peek_byte(p) == '-') {
            advance(p)
        }
        if at_end(p) || !is_digit(peek_byte(p)) {
            return fail(p, "expected digit in exponent")
        }
        for !at_end(p) && is_digit(peek_byte(p)) {
            advance(p)
        }
    }
    raw :: p.src.byte_slice(start, p.pos)
    parsed :: raw.parse_float()
    match parsed {
        is f64 -> {
            // Bind to a typed local so the C emit unboxes the union value
            // (the trailing-match form keeps the box on the stack).
            n: f64: parsed
            return JsonNumber { .value = n }
        }
        is ParseError -> { return fail(p, "invalid number") }
    }
}

// ---- string parser --------------------------------------------------------

/// Consume the next `"..."` JSON string. Looks for the closing `"` or
/// the first escape byte ; if no escape is hit, returns a zero-copy
/// slice of the source so multi-byte UTF-8 sequences survive intact
/// (the byte scan never decodes them).
///
/// @param p  the parser (advanced past the closing quote on success).
/// @return   the decoded string body.
/// @error    `JsonError` on unterminated input or a bad escape.
parse_string :: fn(p: Parser) -> string | JsonError {
    opening :: expect_byte(p, '"')
    if opening is JsonError { return opening }
    start :: p.pos
    for scan in p.pos..<p.src.byte_len() {
        b :: p.src.byte_at(scan)
        if b == '"' {
            p.pos = scan + 1
            return p.src.byte_slice(start, scan)
        }
        if b == '\\' {
            sb :: StringBuilder {}
            sb.append(p.src.byte_slice(start, scan))
            p.pos = scan
            return parse_string_with_escapes(p, sb)
        }
    }
    return fail(p, "unterminated string")
}

/// Slow path of `parse_string`: invoked once the scanner sees a `\` byte.
/// `sb` already carries the literal prefix that preceded the escape ;
/// `p.pos` points at the `\`. Each decoded escape and each run of raw bytes
/// between escapes goes onto `sb` as one part.
///
/// @param p   the parser (advanced past the closing quote on success).
/// @param sb  the builder seeded with the pre-escape literal prefix.
/// @return    the decoded string body.
/// @error     `JsonError` on unterminated input or a bad escape.
parse_string_with_escapes :: fn(p: Parser, sb: StringBuilder) -> string | JsonError {
    for !at_end(p) {
        b :: p.src.byte_at(p.pos)
        if b == '"' {
            advance(p)
            return sb.to_string()
        }
        if b == '\\' {
            advance(p)
            if at_end(p) {
                return fail(p, "unterminated escape")
            }
            esc :: peek_byte(p)
            advance(p)
            if esc == '"' {
                sb.append_char('"')
            } else if esc == '\\' {
                sb.append_char('\\')
            } else if esc == '/' {
                sb.append_char('/')
            } else if esc == 'n' {
                sb.append_char('\n')
            } else if esc == 't' {
                sb.append_char('\t')
            } else if esc == 'r' {
                sb.append_char('\r')
            } else if esc == 'b' {
                sb.append_char(char(u32(8)))
            } else if esc == 'f' {
                sb.append_char(char(u32(12)))
            } else if esc == 'u' {
                if !decode_unicode_escape(p, sb) {
                    return fail(p, "invalid \\u escape")
                }
            } else {
                return fail(p, "unknown escape")
            }
        } else {
            // The bytes up to the next quote or escape, copied undecoded : a
            // multi-byte UTF-8 sequence passes through intact.
            run :: p.pos
            for !at_end(p) && p.src.byte_at(p.pos) != '"' && p.src.byte_at(p.pos) != '\\' {
                advance(p)
            }
            sb.append(p.src.byte_slice(run, p.pos))
        }
    }
    return fail(p, "unterminated string")
}

// Read exactly 4 hex digits at `p.pos` (a `\uXXXX` payload: the `\u` is
// already consumed), advancing `p.pos` by 4 on success. Returns the 0..0xFFFF
// value, or null (without advancing) on incomplete input / a non-hex digit.
read_hex4 :: fn(p: Parser) -> i32 | null {
    if p.pos + 4 > p.src.byte_len() {
        return null
    }
    v := 0
    for k in i64(0)..<4 {
        d :: hex_digit_value(char(p.src.byte_at(p.pos + k))) ?? return null
        v = v * 16 + d
    }
    p.pos = p.pos + 4
    return v
}

// Decode a `\uXXXX` escape (the `\u` is already consumed) and append the result
// to `sb`. A high surrogate is recombined with an immediately-following
// `\uYYYY` low surrogate into one non-BMP code point (JSON's only way to escape
// U+10000..U+10FFFF). An unpaired / mismatched surrogate becomes U+FFFD: any
// trailing escape that wasn't a low surrogate is left unconsumed for the main
// loop to re-decode, so it keeps its own meaning. Returns false on incomplete /
// non-hex input.
decode_unicode_escape :: fn(p: Parser, sb: StringBuilder) -> bool {
    hi_val :: read_hex4(p) ?? return false
    hi :: u32(hi_val)
    if !is_surrogate(hi) {
        sb.append_char(char(hi))            // ordinary BMP scalar
        return true
    }
    if is_high_surrogate(hi) {
        if p.pos + 2 <= p.src.byte_len()
            && p.src.byte_at(p.pos) == '\\'
            && p.src.byte_at(p.pos + 1) == 'u' {
            saved :: p.pos
            p.pos = p.pos + 2
            lo_val :: read_hex4(p)
            if lo_val != null && is_low_surrogate(u32(lo_val)) {
                sb.append_char(combine_surrogates(hi, u32(lo_val)))
                return true
            }
            p.pos = saved
        }
    }
    sb.append_char(REPLACEMENT_CHAR)
    return true
}

// ---- array parser ---------------------------------------------------------

parse_array :: fn(p: Parser, depth: i32) -> JsonArray | JsonError {
    opening :: expect_byte(p, '[')
    if opening is JsonError { return opening }
    items: JsonValue[]: []
    skip_ws(p)
    if !at_end(p) && peek_byte(p) == ']' {
        advance(p)
        return JsonArray { .items = items }
    }
    for !at_end(p) {
        v :: parse_value(p, depth + 1)
        if v is JsonError { return v }
        items.push(v)
        skip_ws(p)
        if at_end(p) {
            return fail(p, "unterminated array")
        }
        c :: peek_byte(p)
        if c == ',' {
            advance(p)
            skip_ws(p)
            continue
        }
        if c == ']' {
            advance(p)
            return JsonArray { .items = items }
        }
        return fail(p, "expected `,` or `]`")
    }
    return fail(p, "unterminated array")
}

// ---- object parser --------------------------------------------------------

parse_object :: fn(p: Parser, depth: i32) -> JsonObject | JsonError {
    opening :: expect_byte(p, '{')
    if opening is JsonError { return opening }
    entries :: Map<string, JsonValue> {}
    skip_ws(p)
    if !at_end(p) && peek_byte(p) == '}' {
        advance(p)
        return JsonObject { .entries = entries }
    }
    for !at_end(p) {
        skip_ws(p)
        key :: parse_string(p)
        if key is JsonError { return key }
        skip_ws(p)
        colon :: expect_byte(p, ':')
        if colon is JsonError { return colon }
        value :: parse_value(p, depth + 1)
        if value is JsonError { return value }
        entries[key] = value
        skip_ws(p)
        if at_end(p) {
            return fail(p, "unterminated object")
        }
        c :: peek_byte(p)
        if c == ',' {
            advance(p)
            continue
        }
        if c == '}' {
            advance(p)
            return JsonObject { .entries = entries }
        }
        return fail(p, "expected `,` or `}`")
    }
    return fail(p, "unterminated object")
}

// ---- public parse ---------------------------------------------------------

/// Parse a complete JSON document. The input must contain exactly one
/// JSON value optionally surrounded by whitespace ; trailing non-whitespace
/// is an error.
///
/// Policy: malformed *syntax* (a bad escape, an unterminated string / container,
/// an invalid number, nesting past `MAX_DEPTH`) returns a `JsonError`. A
/// syntactically valid but unpaired `\u` surrogate is handled leniently: it
/// decodes to U+FFFD (matching Go's `encoding/json`), since a lone surrogate
/// has no UTF-8 representation.
/// @param input  the JSON text.
/// @return       the parsed `JsonValue` on success.
/// @error        `JsonError` carrying a short message and the byte offset
///               of the offending character.
export parse :: fn(input: string) -> JsonValue | JsonError {
    p :: Parser { .src = input }
    v :: parse_value(p, 0)
    if v is JsonError { return v }
    skip_ws(p)
    if !at_end(p) {
        return fail(p, "trailing characters after JSON value")
    }
    return v
}

// ---- stringify ------------------------------------------------------------

// `s` quoted, then `close`: `"` after a value, `":` after an object key. The
// bytes between two escapes go onto `sb` as one part, undecoded : only ASCII
// bytes are ever escaped, so a multi-byte UTF-8 sequence passes through intact.
write_string :: fn(sb: StringBuilder, s: string, close: string) -> void {
    sb.append("\"")
    n :: s.byte_len()
    run: i64 = 0
    for i in 0..<n {
        escape :: escape_of(s.byte_at(i)) ?? continue
        if run < i {
            sb.append(s.byte_slice(run, i))
        }
        sb.append(escape)
        run = i + 1
    }
    if run == 0 {
        sb.append(s)
    } else {
        sb.append(s.byte_slice(run, n))
    }
    sb.append(close)
}

// The JSON escape for byte `c`, or null when it stands for itself.
escape_of :: fn(c: u8) -> string | null = match c {
    '"'       -> "\\\""
    '\\'      -> "\\\\"
    '\n'      -> "\\n"
    '\t'      -> "\\t"
    '\r'      -> "\\r"
    0..=0x1F  -> "\\u" + u64(c).to_hex().pad_start(4, '0')
    _         -> null
}

// Strip the trailing `.0` from integer-valued floats so `42.0` round-trips
// as `42`. Vader stores every JsonNumber as `f64` (the parser doesn't keep
// an int/float distinction), so preserving `.0` would carry no information:
// emit the canonical short form, matching JS `JSON.stringify`, Go
// `encoding/json`, and RFC 8785 (JCS).
write_number :: fn(sb: StringBuilder, v: f64) -> void = sb.append(v.to_compact_string())

write_value :: fn(sb: StringBuilder, v: JsonValue, indent: i32, depth: i32) -> void {
    match v {
        is JsonNull   -> { sb.append("null") }
        is JsonBool   -> {
            if v.value {
                sb.append("true")
            } else {
                sb.append("false")
            }
        }
        is JsonNumber -> { write_number(sb, v.value) }
        is JsonString -> { write_string(sb, v.value, "\"") }
        is JsonArray  -> { write_array(sb, v, indent, depth) }
        is JsonObject -> { write_object(sb, v, indent, depth) }
    }
}

write_indent :: fn(sb: StringBuilder, indent: i32, depth: i32) -> void {
    if indent <= 0 {
        return
    }
    sb.append("\n")
    sb.append_repeated(' ', indent * depth)
}

write_array :: fn(sb: StringBuilder, a: JsonArray, indent: i32, depth: i32) -> void {
    if a.items.len() == 0 {
        sb.append("[]")
        return
    }
    sb.append("[")
    first := true
    for item in a.items {
        if !first {
            sb.append(",")
        }
        write_indent(sb, indent, depth + 1)
        write_value(sb, item, indent, depth + 1)
        first = false
    }
    write_indent(sb, indent, depth)
    sb.append("]")
}

write_object :: fn(sb: StringBuilder, o: JsonObject, indent: i32, depth: i32) -> void {
    if o.entries.len() == 0 {
        sb.append("{}")
        return
    }
    sb.append("{")
    first := true
    for [k, v] in o.entries {
        if !first {
            sb.append(",")
        }
        write_indent(sb, indent, depth + 1)
        write_string(sb, k, "\":")
        if indent > 0 {
            sb.append(" ")
        }
        write_value(sb, v, indent, depth + 1)
        first = false
    }
    write_indent(sb, indent, depth)
    sb.append("}")
}

/// Serialise `v` to a JSON string, one line per element when `indent` is
/// positive.
///
/// @param v       the value to serialise.
/// @param indent  spaces per nesting level; 0, the default, and below write the
///                smallest valid encoding.
/// @example
///   list :: JsonArray { .items = [JsonNumber { .value = 1.0 }, JsonNull {}] }
///   stringify(list)      // "[1,null]"
///   stringify(list, 2)   // "[\n  1,\n  null\n]"
export stringify :: fn(v: JsonValue, indent: i32 = 0) -> string {
    sb :: StringBuilder {}
    write_value(sb, v, indent, 0)
    return sb.to_string()
}

// ---- reading a value ------------------------------------------------------

/// The member `key` of `value`, null when `value` is no object or has no such
/// member.
///
/// @param value  the value to read, an object or any other shape.
/// @param key    the name of the member.
/// @example
///   member(JsonNull {}, "port")   // null
export member :: fn(value: JsonValue, key: string) -> JsonValue | null {
    if value is JsonObject {
        return value.entries[key]
    }
    return null
}

/// The string member `key` of `value`, null when there is none or when the
/// member is another shape.
///
/// @param value  the value to read, an object or any other shape.
/// @param key    the name of the member.
export string_member :: fn(value: JsonValue, key: string) -> string | null {
    found :: member(value, key)
    if found is JsonString {
        return found.value
    }
    return null
}

/// The number member `key` of `value`, null when there is none or when the
/// member is another shape.
///
/// @param value  the value to read, an object or any other shape.
/// @param key    the name of the member.
export number_member :: fn(value: JsonValue, key: string) -> f64 | null {
    found :: member(value, key)
    if found is JsonNumber {
        return found.value
    }
    return null
}

/// The strings of the array member `key` of `value`, the items of another shape
/// left out; none when there is no such array.
///
/// @param value  the value to read, an object or any other shape.
/// @param key    the name of the member.
export strings_member :: fn(value: JsonValue, key: string) -> string[] {
    out: string[]: []
    found :: member(value, key)
    if found is JsonArray {
        for item in found.items {
            if item is JsonString {
                out.push(item.value)
            }
        }
    }
    return out
}

/// The strings of `value`, an array of strings; null when `value` is another
/// shape or holds an item of another shape, which `strings_member` leaves out.
///
/// @param value  the value to read.
/// @example
///   strings_of(JsonArray { .items = [JsonString { .value = "a" }] })   // ["a"]
///   strings_of(JsonArray { .items = [JsonNull {}] })                   // null
export strings_of :: fn(value: JsonValue) -> string[] | null {
    if value !is JsonArray {
        return null
    }
    out: string[]: []
    for item in value.items {
        if item !is JsonString {
            return null
        }
        out.push(item.value)
    }
    return out
}

/// The keys of `value` that `known` does not list, in the order of the object:
/// what a reader that takes only the keys `known` names would leave unread.
///
/// @param value  the object to check.
/// @param known  the keys it may hold.
export unknown_keys :: fn(value: JsonObject, known: string[]) -> string[] {
    out: string[]: []
    for key in value.entries.keys() {
        if key !in known {
            out.push(key)
        }
    }
    return out
}

// ---- text sequences -------------------------------------------------------

/// `value` as an entry of a JSON text sequence (RFC 7464): a record separator
/// (0x1E), the compact JSON text, a line feed.
///
/// A reader splits the stream on the separator, so an entry a writer left
/// unfinished spoils that entry alone.
///
/// @param value  the value to write.
/// @example
///   sequence_entry(JsonNull {})   // "\u{1e}null\n"
export sequence_entry :: fn(value: JsonValue) -> string = "\u{1e}${stringify(value)}\n"

// ---- tests ----------------------------------------------------------------

import "std/testing"

/// Parse `src` and assert it produced a `JsonString` whose value matches
/// `expected`.
///
/// @param src       the JSON document to parse.
/// @param expected  the expected decoded string body.
expect_string :: fn(src: string, expected: string) -> void {
    parsed :: parse(src)
    if parsed is JsonString {
        assert_eq(parsed.value, expected)
    } else {
        fail("expected JsonString")
    }
}

/// Parse `src` and assert it produced a `JsonError`.
///
/// @param src  the malformed JSON document.
expect_error :: fn(src: string) -> void {
    parsed :: parse(src)
    if parsed !is JsonError {
        fail("expected JsonError")
    }
}

/// Parse `src` and assert it produced a `JsonNumber` equal to `expected`.
///
/// @param src       the JSON document to parse.
/// @param expected  the expected decoded numeric value.
expect_number :: fn(src: string, expected: f64) -> void {
    parsed :: parse(src)
    if parsed is JsonNumber {
        assert_eq(parsed.value, expected)
    } else {
        fail("expected JsonNumber")
    }
}

@test test_number_leading_zeros :: fn() -> void {
    // RFC 8259 forbids a leading zero in the integer part.
    expect_error("01")
    expect_error("-0123")
    expect_error("00")
    // A lone zero, and normal integers / decimals, are valid.
    expect_number("0",   0.0)
    expect_number("0.5", 0.5)
    expect_number("10",  10.0)
    expect_number("100", 100.0)
}

@test test_string_empty :: fn() -> void {
    expect_string("\"\"", "")
}

@test test_string_plain :: fn() -> void {
    expect_string("\"hello\"",      "hello")
    expect_string("\"hello world\"", "hello world")
    expect_string("\"x\"",          "x")
}

@test test_string_unicode_passthrough :: fn() -> void {
    // Multi-byte UTF-8 bytes flow through unchanged ; the parser walks
    // bytes, not codepoints, so `é` and the snowman survive intact.
    expect_string("\"café\"",   "café")
    expect_string("\"☃\"",      "☃")
}

@test test_string_escape_simple :: fn() -> void {
    expect_string("\"a\\nb\"",  "a\nb")
    expect_string("\"a\\tb\"",  "a\tb")
    expect_string("\"a\\rb\"",  "a\rb")
    expect_string("\"a\\\"b\"", "a\"b")
    expect_string("\"a\\\\b\"", "a\\b")
    expect_string("\"a\\/b\"",  "a/b")
}

@test test_string_escape_unicode :: fn() -> void {
    expect_string("\"\\u0041\"",      "A")
    expect_string("\"\\u00e9\"",      "é")
    expect_string("\"a\\u00e9b\"",    "aéb")
}

@test test_string_escape_at_boundary :: fn() -> void {
    // Boundary cases for the fast path's "first backslash" scan : the
    // empty-prefix case (escape at byte 0) and the empty-tail case
    // (escape just before the closing quote) both must hand off to the
    // slow path correctly.
    expect_string("\"\\nfoo\"", "\nfoo")
    expect_string("\"foo\\n\"", "foo\n")
    expect_string("\"\\n\"",    "\n")
}

@test test_string_multibyte_after_escape :: fn() -> void {
    // Regression : `test_string_unicode_passthrough` only covers raw
    // multi-byte chars on the fast (no-escape) path. Once any escape
    // appears, the rest of the string runs through the slow path, which
    // used to step the cursor a single byte per character: stranding it
    // on the continuation byte of a multi-byte codepoint and decoding the
    // tail as `U+FFFD`. So `'é'` round-tripped to TWO codepoints (the LSP
    // surfaced this as L0005 on every accented char in an opened file).
    // A raw multi-byte codepoint after an escape must survive whole.
    expect_string("\"\\tcafé\"",     "\tcafé")
    expect_string("\"a\\né☃b\"",     "a\né☃b")
    expect_string("\"\\u0041café\"", "Acafé")
    // Escape AFTER the multi-byte char too: the cursor must be aligned
    // when it reaches the escape.
    expect_string("\"café\\tx\"",    "café\tx")
}

@test test_string_errors :: fn() -> void {
    expect_error("\"unterminated")
    expect_error("\"\\")
    expect_error("\"\\q\"")
    expect_error("\"\\u00\"")
}

@test test_object_string_keys :: fn() -> void {
    // Object keys go through the same `parse_string` path: exercise an
    // input where one key is escape-free (fast path) and one carries an
    // escape (slow path).
    parsed :: parse("{\"key\": 1, \"k\\ny\": 2}")
    if parsed is JsonObject {
        assert_eq(parsed.entries.len(), 2)
    } else {
        fail("expected JsonObject")
    }
}

@test test_array_of_strings :: fn() -> void {
    parsed :: parse("[\"a\", \"b\\nc\", \"\"]")
    if parsed is JsonArray {
        assert_eq(parsed.items.len(), 3)
    } else {
        fail("expected JsonArray")
    }

}

@test test_string_escape_surrogate_pair :: fn() -> void {
    // A `\uXXXX\uYYYY` surrogate pair recombines into one non-BMP code point
    // (U+1D11E), encoded as 4-byte UTF-8, not two 3-byte WTF-8 halves.
    expect_string("\"\\uD834\\uDD1E\"",   "\u{1D11E}")
    expect_string("\"a\\uD834\\uDD1Eb\"", "a\u{1D11E}b")
}

@test test_string_escape_lone_surrogate :: fn() -> void {
    // A lone or mismatched surrogate decodes to U+FFFD rather than an invalid
    // WTF-8 sequence.
    expect_string("\"\\uD834\"",        "\u{FFFD}")       // lone high
    expect_string("\"\\uDD1E\"",        "\u{FFFD}")       // lone low
    expect_string("\"\\uD834\\u0041\"", "\u{FFFD}A")      // high + BMP char
}

@test test_parse_rejects_deep_nesting :: fn() -> void {
    // Unbounded-recursion guard : a document nested past MAX_DEPTH is a
    // JsonError, not a stack overflow (VM trap / native segfault).
    sb :: StringBuilder {}
    for i in 0..<(MAX_DEPTH + 5) { sb.append_char('[') }
    for i in 0..<(MAX_DEPTH + 5) { sb.append_char(']') }
    expect_error(sb.to_string())
    // A modestly-nested document still parses.
    ok :: parse("[[[[[1]]]]]")
    if ok !is JsonArray { fail("expected JsonArray for shallow nesting") }
}

@test test_stringify_escapes_a_string :: fn() -> void {
    v :: JsonString { .value = "a\"b\\c\nd\te\r\u{1}" }
    assert_eq(stringify(v), "\"a\\\"b\\\\c\\nd\\te\\r\\u0001\"")
}

@test test_stringify_keeps_multibyte_text :: fn() -> void {
    assert_eq(stringify(JsonString { .value = "é\n你" }), "\"é\\n你\"")
    assert_eq(stringify(JsonString { .value = "" }), "\"\"")
}

@test test_stringify_object_in_insertion_order :: fn() -> void {
    parsed :: parse("{\"b\": 1, \"a\": [true, null, \"x\"]}")
    if parsed is JsonError {
        fail(parsed.msg)
        return
    }
    assert_eq(stringify(parsed), "{\"b\":1,\"a\":[true,null,\"x\"]}")
}

// `src` parsed, the test failed when it is not JSON.
parsed_value :: fn(src: string) -> JsonValue {
    parsed :: parse(src)
    if parsed is JsonError {
        fail("not JSON: ${src}")
        return JsonNull {}
    }
    return parsed
}

@test test_member_of_an_object :: fn() -> void {
    port :: member(parsed_value("{\"port\": 8080}"), "port")
    assert(port is JsonNumber, "the member is read")
    assert(member(parsed_value("{\"port\": 8080}"), "host") == null, "a missing member is null")
}

@test test_member_of_another_shape_is_null :: fn() -> void {
    assert(member(parsed_value("[1, 2]"), "port") == null, "an array has no member")
}

@test test_string_member_of_another_shape_is_null :: fn() -> void {
    value :: parsed_value("{\"name\": \"vader\", \"port\": 8080}")
    assert_eq(string_member(value, "name") ?? "", "vader")
    assert(string_member(value, "port") == null, "a number is no string")
}

@test test_number_member :: fn() -> void {
    value :: parsed_value("{\"port\": 8080, \"name\": \"vader\"}")
    assert_eq(number_member(value, "port") ?? 0.0, 8080.0)
    assert(number_member(value, "name") == null, "a string is no number")
}

@test test_strings_member_keeps_the_strings :: fn() -> void {
    value :: parsed_value("{\"tags\": [\"a\", 1, \"b\", null], \"name\": \"x\"}")
    assert_eq(strings_member(value, "tags").join(","), "a,b")
    assert_eq(strings_member(value, "name").len(), 0)
    assert_eq(strings_member(value, "absent").len(), 0)
}

@test test_strings_of_an_array_of_strings :: fn() -> void {
    assert_eq((strings_of(parsed_value("[\"a\", \"b\"]")) ?? []).join(","), "a,b")
    assert_eq((strings_of(parsed_value("[]")) ?? ["x"]).len(), 0)
}

@test test_strings_of_another_shape_is_null :: fn() -> void {
    assert(strings_of(parsed_value("[\"a\", 1]")) == null, "an item of another shape")
    assert(strings_of(parsed_value("\"a\"")) == null, "a string is no array")
}

@test test_unknown_keys_in_the_order_of_the_object :: fn() -> void {
    value :: parsed_value("{\"b\": 1, \"name\": 2, \"a\": 3}")
    if value is JsonObject {
        assert_eq(unknown_keys(value, ["name"]).join(","), "b,a")
    } else {
        fail("not an object")
    }
}

@test test_sequence_entry_frames_the_compact_text :: fn() -> void {
    assert_eq(sequence_entry(parsed_value("{\"a\": [1, true]}")), "\u{1e}{\"a\":[1,true]}\n")
}
