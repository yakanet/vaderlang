// json/encode: a value with a JSON form.
//
// `json/derive` gives each struct marked `@json` an impl of `ToJson`, written
// into the struct's module; a type can also implement it by hand. The impl adds
// no name to the module, and reaches every module that sees the type.

module "json"

/// A value with a JSON form.
///
/// @example
///   Celsius :: struct {
///       degrees: f64
///   }
///   Celsius implements ToJson {
///       to_json_value :: fn(self) -> JsonValue = JsonNumber { .value = self.degrees }
///   }
///   Celsius { .degrees = 21.5 }.to_json()   // "21.5"
export ToJson :: trait {
    /// The value as a JSON tree.
    to_json_value :: fn(self) -> JsonValue
    /// Its JSON text, compact.
    to_json :: fn(self) -> string = stringify(self.to_json_value())
}
