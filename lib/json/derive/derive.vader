// json/derive: a source stage and a body stage writing a JSON serialiser for each
// struct marked `@json`.
//
// It reads the decorators of `json` (`decorators.vader` there): `@json` above a
// struct, `@json_name("key")` and `@json_skip` above a field. The source stage
// runs while the build loads the project, and the impl of `ToJson` it declares
// for each struct joins the struct's own module before anything is checked,
// which is what lets it name the type: a module of its own would have to import
// the struct's module, which imports it back. An impl adds no name to the module,
// and reaches every module that sees the struct. Its member has no body: the body
// stage writes it once the comptime has computed the values of the decorators, so
// a key may be computed (`@json_name(@comptime key_of("id"))`).

module "json/derive"

import "std/iter"
import "std/string_builder"
AST :: import "toolchain/ast"
import "toolchain/diagnostics"
import "toolchain/lexer"
import "toolchain/span"
import "toolchain/stage"

/// A source stage and a body stage giving each struct marked `@json` a JSON
/// serialiser: an impl of `ToJson` (`json`), whose `to_json_value()` builds a
/// `JsonValue` and `to_json()` writes its text.
///
/// The impl is written into the struct's own module. The mapping reads each
/// field's type as written: a number, a `string`, a `bool`, a struct of the same
/// module marked `@json` (through its own impl), or an array of one of them. Any
/// other field is reported, and left out. A field takes the key `@json_name`
/// gives, its name otherwise, and `@json_skip` leaves it out. The key is the value
/// of the argument, computed at compile time when it is written `@comptime`.
///
/// @example
///   # import "toolchain/build"
///   # ctx :: new_build_context(["driver", "."])
///   ctx.use(JsonDerive {})
export JsonDerive :: struct {}

JsonDerive implements SourceStage {
    describe :: fn(self) -> SourceSpec = SourceSpec {
        .name = "json",
        .given = [DecoratorOrigin { .module = JSON_MODULE, .name = "json" }],
    }

    run :: fn(self, input: Sources) -> Generated {
        structs: AST.StructDecl[]: []
        for file in input.files {
            structs.push_all(json_structs(file.decls))
        }
        if structs.len() == 0 {
            return Generated {}
        }
        out :: StringBuilder {}
        out.append("import \"std/collections\"\n")
        out.append("${JSON_ALIAS} :: import \"json\"\n")
        // Each impl reports at the `@json` that asked for it, in the impls' order.
        anchors: Span[]: []
        for s in structs {
            write_signature(out, s)
            marker :: json_decorator(s.decorators, "json") else continue
            anchors.push(marker.span)
        }
        return Generated { .text = out.to_string(), .anchors = anchors }
    }
}

JsonDerive implements BodyStage {
    describe :: fn(self) -> BodySpec = BodySpec { .name = "json" }

    // The struct names are collected before any body is written, so a field whose
    // type is a sibling struct is recognised as one however the files order them.
    run :: fn(self, input: BodyRequest) -> Body {
        structs :: json_structs(input.declarations)
        target :: implementing_type(input.owner)
        marked :: structs.find((s) -> s.name == target) else {
            unknown :: hook_error(
                .HookReport,
                input.decl.name_span,
                "`json/derive` was asked a body for no struct marked `@json`",
            )
            return Body { .text = EMPTY_BODY, .diagnostics = [unknown] }
        }
        reports: Diagnostic[]: []
        out :: StringBuilder {}
        write_body(out, reports, marked, structs.map((s) -> s.name).collect())
        return Body { .text = out.to_string(), .diagnostics = reports }
    }
}

// The body of a `to_json_value` that has no struct to read: an empty object.
EMPTY_BODY :: "{ return ${JSON_ALIAS}.JsonObject { "
    + ".entries = Map<string, ${JSON_ALIAS}.JsonValue> {} } }"

// The name of the type `owner` implements the trait for, empty for no impl.
implementing_type :: fn(owner: AST.ImplDecl | null) -> string {
    if owner == null {
        return ""
    }
    return AST.impl_type_name(owner) else ""
}

// The structs among `decls` marked `@json`.
json_structs :: fn(decls: AST.Decl[]) -> AST.StructDecl[] =
    decls.filter_is<AST.StructDecl>().filter(is_json_struct).collect()

is_json_struct :: fn(d: AST.StructDecl) -> bool = json_decorator(d.decorators, "json") != null

NUMERIC_TYPES :: ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64"]

// The decorator of `json` called `name` among `decorators`, null when none is
// written.
json_decorator :: fn(decorators: AST.Decorator[], name: string) -> AST.Decorator | null =
    AST.find_declared_decorator(decorators, JSON_MODULE, name)

// The module that declares the decorators the stage reads.
JSON_MODULE :: "json"

// The alias the generated file reaches `json` through. A file's alias shares the
// module's names, so it must be one no hand-written declaration takes.
JSON_ALIAS :: "DerivedJson"

// The impl of `ToJson` for `s`, its member without a body: the body stage gives
// it.
write_signature :: fn(out: StringBuilder, s: AST.StructDecl) -> void {
    out.append("\n/// Generated from `${s.name}` by `json/derive`.\n")
    out.append("${s.name} implements ${JSON_ALIAS}.ToJson {\n")
    out.append("    to_json_value :: fn(self) -> ${JSON_ALIAS}.JsonValue\n")
    out.append("}\n")
}

// The body of `to_json_value` for `s`, a block.
write_body :: fn(
    out: StringBuilder,
    reports: Diagnostic[],
    s: AST.StructDecl,
    siblings: string[],
) -> void {
    out.append("{\n")
    out.append("    entries :: Map<string, ${JSON_ALIAS}.JsonValue> {}\n")
    for f in s.fields {
        write_field(out, reports, f, siblings)
    }
    out.append("    return ${JSON_ALIAS}.JsonObject { .entries = entries }\n")
    out.append("}")
}

// The statements of `to_json_value` that put one field into `entries`. A field
// whose type has no JSON mapping is reported against the field, so the user sees
// which one.
write_field :: fn(
    out: StringBuilder,
    reports: Diagnostic[],
    f: AST.StructField,
    siblings: string[],
) -> void {
    if json_decorator(f.decorators, "json_skip") != null {
        return
    }
    key :: quote_vader(key_of(reports, f))
    access :: "self.${f.name}"
    scalar :: value_expression(f.ty, access, siblings)
    if scalar != null {
        out.append("    entries[${key}] = ${scalar}\n")
        return
    }
    array :: f.ty
    if array is AST.ArrayTypeExpr {
        element :: value_expression(array.element, "element", siblings)
        if element != null {
            items :: "items_${f.name}"
            out.append("    ${items}: ${JSON_ALIAS}.JsonValue[]: []\n")
            out.append("    for element in ${access} {\n")
            out.append("        ${items}.push(${element})\n")
            out.append("    }\n")
            out.append("    entries[${key}] = ${JSON_ALIAS}.JsonArray { .items = ${items} }\n")
            return
        }
    }
    reports.push(hook_error(
        .HookReport,
        f.span,
        "field `${f.name}` has no JSON mapping: skipped by the derived serialiser",
    ))
}

// The key `f` takes: the one its `@json_name` gives, its name otherwise. A
// `@json_name` that arrives without one is reported, and the name stands in.
key_of :: fn(reports: Diagnostic[], f: AST.StructField) -> string {
    renamed :: json_decorator(f.decorators, "json_name") else return f.name
    key :: AST.argument_named(renamed, "name", 0) else {
        reports.push(hook_error(.HookReport, renamed.span, "`@json_name` gives no key"))
        return f.name
    }
    return AST.string_literal_text(key) else f.name
}

// The `JsonValue` expression for a value of type `ty` read at `access`, or null when
// there is none. A number goes through `f64`, which is what `JsonNumber` carries;
// `stringify` prints an integral one without a decimal point. A struct is one of
// `siblings` only, through its impl: the stage sees no other module's. The trait
// is in scope through `JSON_ALIAS` alone, so its method is called qualified: the
// method form does not reach through an alias (T3078).
value_expression :: fn(ty: AST.TypeExpr, access: string, siblings: string[]) -> string | null {
    if ty !is AST.IdentExpr {
        return null
    }
    if ty.name in NUMERIC_TYPES {
        return "${JSON_ALIAS}.JsonNumber { .value = f64(${access}) }"
    }
    if ty.name == "string" {
        return "${JSON_ALIAS}.JsonString { .value = ${access} }"
    }
    if ty.name == "bool" {
        return "${JSON_ALIAS}.JsonBool { .value = ${access} }"
    }
    if ty.name in siblings {
        return "${JSON_ALIAS}.ToJson.to_json_value(${access})"
    }
    return null
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

named_type :: fn(name: string) -> AST.TypeExpr = AST.IdentExpr {
    .span = empty_span(),
    .name = name,
    .implicit_dot = false,
}

field_of :: fn(name: string, ty: AST.TypeExpr) -> AST.StructField = AST.StructField {
    .span = empty_span(),
    .name = name,
    .ty = ty,
    .visibility = .Public,
    .default = null,
}

@test
test_value_expression_reaches_a_struct_of_the_module_only :: fn() -> void {
    assert_eq(
        value_expression(named_type("Address"), "x", ["Address"]) else "",
        "DerivedJson.ToJson.to_json_value(x)",
    )
    assert(value_expression(named_type("Address"), "x", []) == null, "another module's struct")
}

// A decorator of `json`, as the build hands it to a stage.
json_mark :: fn(name: string, args: AST.CallArg[]) -> AST.Decorator = AST.Decorator {
    .span = empty_span(),
    .name = name,
    .name_span = empty_span(),
    .args = args,
    .module_name = JSON_MODULE,
}

string_argument :: fn(text: string) -> AST.CallArg = AST.CallArg {
    .span = empty_span(),
    .name = null,
    .value = AST.StringLitExpr {
        .span = empty_span(),
        .parts = [AST.StringLitText { .value = text, .span = empty_span() }],
    },
    .spread = false,
}

@test
test_a_field_takes_the_key_its_json_name_writes :: fn() -> void {
    reports: Diagnostic[]: []
    out :: StringBuilder {}
    field :: field_of("id", named_type("i64"))
    field.decorators = [json_mark("json_name", [string_argument("user\"id")])]
    write_field(out, reports, field, [])
    assert(out.to_string().contains("entries[\"user\\\"id\"]"), out.to_string())
    assert_eq(reports.len(), 0)
}

@test
test_a_field_under_json_skip_is_left_out :: fn() -> void {
    reports: Diagnostic[]: []
    out :: StringBuilder {}
    field :: field_of("when", named_type("Instant"))
    field.decorators = [json_mark("json_skip", [])]
    write_field(out, reports, field, [])
    assert_eq(out.to_string(), "")
    assert_eq(reports.len(), 0)
}

@test
test_a_json_name_without_a_key_is_reported :: fn() -> void {
    reports: Diagnostic[]: []
    out :: StringBuilder {}
    field :: field_of("id", named_type("i64"))
    field.decorators = [json_mark("json_name", [])]
    write_field(out, reports, field, [])
    assert(out.to_string().contains("entries[\"id\"]"), "the name stands in")
    assert_eq(reports.len(), 1)
}

@test
test_write_field_reports_an_unmapped_field :: fn() -> void {
    reports: Diagnostic[]: []
    out :: StringBuilder {}
    write_field(out, reports, field_of("when", named_type("Instant")), [])
    assert_eq(out.to_string(), "")
    assert_eq(reports.len(), 1)
    assert_eq(reports[0].code.id, "H6004")
}
