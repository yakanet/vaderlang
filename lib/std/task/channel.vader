// std/task/channel: channels, which hand messages from task to task.
//
// A channel holds at most `capacity` messages: a `send` to a full channel parks
// until a `receive` takes one, so a producer runs at the pace of its consumers.
//
// The threads parked on a channel wait in the order they came. A `send` wakes the
// first receiver, a `receive` the first sender, and neither wakes again while the
// one it woke has not run. A thread woken for what it no longer takes (it was
// cancelled before it ran) wakes the next one in its place.

module "std/task"

import "std/abort"
import "std/collections"
import "std/runtime/scheduler"

/// A queue of messages between tasks. A message sent belongs to its receiver: the
/// sender leaves it alone.
///
/// The capacity is given at creation, `Channel<Job> { .capacity = 64 }`; a channel
/// that never makes a sender wait takes `UNBOUNDED`. A channel iterates over the
/// messages it receives until it is closed and drained: `for job in jobs { ... }`.
@task_shared
export Channel :: struct<T> {
    /// How many messages the channel holds before a `send` parks: at least 1.
    capacity: i64
    /// Held over the state below, by `send`, `receive` and `close`.
    @internal
    mutex: Mutex = Mutex {}
    @internal
    messages: Queue<T> = Queue<T> {}
    @internal
    closed: bool = false
    /// The threads parked on a full channel, in the order they came.
    @internal
    senders: i64[] = []
    /// The threads parked on an empty channel, in the order they came.
    @internal
    receivers: i64[] = []
    /// A sender was woken and has not run since: no other wake is due.
    @internal
    sender_woken: bool = false
    /// A receiver was woken and has not run since: no other wake is due.
    @internal
    receiver_woken: bool = false
}

/// The capacity of a channel that never makes a sender wait.
export UNBOUNDED: i64: 0x7FFF_FFFF_FFFF_FFFF

/// What `receive` gives back once the channel is closed and every message taken.
export Closed :: struct {}

Closed implements Display -> "closed"

/// What `poll` gives back when the channel holds no message and is open.
export Empty :: struct {}

Empty implements Display -> "empty"

/// What `offer` gives back once its message is sent.
export Sent :: struct {}

Sent implements Display -> "sent"

Channel<T> implements<T> Iterator<T> {
    next :: fn(self) -> T | Stop {
        message :: receive(self)
        if message is Closed {
            return Stop {}
        }
        return message
    }
}

/// Send `message` to the receivers of `channel`, parking while it is full.
///
/// @param channel  the channel to send on.
/// @param message  the message: it belongs to its receiver from now on.
/// @error          stops the program when `channel` is closed, or closes while the
///                 sender waits, and when its capacity is below 1.
/// @example
///   jobs :: Channel<i32> { .capacity = 2 }
///   jobs.send(1)
///   jobs.receive()   // 1
@task_primitive(gives = "message", parks = true, grows = "messages")
export send :: fn<T>(channel: Channel<T>, message: T) -> void {
    publish(message)
    // No defer lets the mutex go: a cancelled sender leaves from `await_room`,
    // whose `gave_up_sending` lets it go.
    channel.mutex.lock()
    if channel.capacity < 1 {
        panic("send: a channel holds at least one message, its capacity is ${channel.capacity}")
    }
    if channel.messages.len() >= channel.capacity && !channel.closed {
        await_room(channel)
    }
    if channel.closed {
        panic("send: the channel is closed")
    }
    put(channel, message)
}

/// Take the oldest message of `channel`, parking while it is empty.
///
/// @param channel  the channel to receive from.
/// @return         the message, or `Closed` once the channel is closed and every
///                 message taken.
/// @example
///   jobs :: Channel<i32> { .capacity = 2 }
///   jobs.send(1)
///   jobs.close()
///   jobs.receive()   // 1
///   jobs.receive()   // closed
@task_primitive(parks = true, writes = "messages", takes = true)
export receive :: fn<T>(channel: Channel<T>) -> T | Closed {
    // No defer, as in `send`: `gave_up_receiving` lets a cancelled receiver's go.
    channel.mutex.lock()
    if channel.messages.is_empty() && !channel.closed {
        await_message(channel)
    }
    if channel.messages.is_empty() {
        channel.mutex.unlock()
        return Closed {}
    }
    return taken(channel)
}

/// Take the oldest message of `channel` when it holds one, without parking.
///
/// @param channel  the channel to receive from.
/// @return         the message; `Empty` when the channel holds none and is open,
///                 `Closed` once it is closed and every message taken.
/// @example
///   jobs :: Channel<i32> { .capacity = 2 }
///   jobs.poll()   // empty
///   jobs.send(1)
///   jobs.poll()   // 1
@task_primitive(writes = "messages", takes = true)
export poll :: fn<T>(channel: Channel<T>) -> T | Empty | Closed {
    channel.mutex.lock()
    if channel.messages.is_empty() {
        closed :: channel.closed
        channel.mutex.unlock()
        if closed {
            return Closed {}
        }
        return Empty {}
    }
    return taken(channel)
}

/// Send `message` to `channel` when it has room, without parking.
///
/// @param channel  the channel to send on.
/// @param message  the message: it belongs to its receiver once sent, and comes
///                 back to the caller otherwise.
/// @return         `Sent`; `message` back when the channel is full, or closed.
/// @example
///   jobs :: Channel<i32> { .capacity = 1 }
///   jobs.offer(1)   // sent
///   jobs.offer(2)   // 2
@task_primitive(gives = "message", grows = "messages", takes = true)
export offer :: fn<T>(channel: Channel<T>, message: T) -> T | Sent {
    publish(message)
    channel.mutex.lock()
    if channel.closed || channel.messages.len() >= channel.capacity {
        channel.mutex.unlock()
        return message
    }
    put(channel, message)
    return Sent {}
}

// Take the oldest message of `channel`, which holds one, under its mutex, and
// let the mutex go: a sender waiting for room may go on, and so may the next
// receiver while messages are left.
taken :: fn<T>(channel: Channel<T>) -> T {
    message :: channel.messages.remove_first()
    wake_sender(channel)
    if !channel.messages.is_empty() {
        wake_receiver(channel)
    }
    channel.mutex.unlock()
    return message
}

// Add `message` to `channel`, which has room for it, under its mutex, and let
// the mutex go: a receiver may go on, and so may the next sender while room
// is left.
put :: fn<T>(channel: Channel<T>, message: T) -> void {
    channel.messages.push(message)
    wake_receiver(channel)
    if channel.messages.len() < channel.capacity {
        wake_sender(channel)
    }
    channel.mutex.unlock()
}

/// Close `channel`: its receivers take the messages it holds, then get `Closed`.
/// Closing a closed channel does nothing.
///
/// @param channel  the channel to close.
@task_primitive(writes = "closed")
export close :: fn<T>(channel: Channel<T>) -> void {
    channel.mutex.lock()
    channel.closed = true
    for thread in channel.receivers {
        wake(thread)
    }
    for thread in channel.senders {
        wake(thread)
    }
    channel.mutex.unlock()
}

// Park until `channel` has room or is closed.
await_room :: fn<T>(channel: Channel<T>) -> void {
    me :: current_thread()
    channel.senders.push(me)
    defer gave_up_sending(channel, me)
    for channel.messages.len() >= channel.capacity && !channel.closed {
        channel.mutex.wait()
        channel.sender_woken = false
    }
    channel.senders.remove_value(me)
}

// Park until `channel` holds a message or is closed.
await_message :: fn<T>(channel: Channel<T>) -> void {
    me :: current_thread()
    channel.receivers.push(me)
    defer gave_up_receiving(channel, me)
    for channel.messages.is_empty() && !channel.closed {
        channel.mutex.wait()
        channel.receiver_woken = false
    }
    channel.receivers.remove_value(me)
}

// `me` stopped waiting for room without taking it, cancelled: room a `receive`
// woke it for goes to the next sender. The cancelled sender never returns to
// `send`, so the mutex its wait took back is let go here.
gave_up_sending :: fn<T>(channel: Channel<T>, me: i64) -> void {
    if !channel.senders.remove_value(me) {
        return
    }
    channel.sender_woken = false
    if channel.messages.len() < channel.capacity {
        wake_sender(channel)
    }
    channel.mutex.unlock()
}

// `me` stopped waiting for a message without taking it, cancelled: a message a
// `send` woke it for goes to the next receiver. The mutex goes as in
// `gave_up_sending`.
gave_up_receiving :: fn<T>(channel: Channel<T>, me: i64) -> void {
    if !channel.receivers.remove_value(me) {
        return
    }
    channel.receiver_woken = false
    if !channel.messages.is_empty() {
        wake_receiver(channel)
    }
    channel.mutex.unlock()
}

// Wake the first parked sender, unless a sender woken before has not run yet.
wake_sender :: fn<T>(channel: Channel<T>) -> void {
    if !channel.sender_woken && channel.senders.len() > 0 {
        channel.sender_woken = true
        wake(channel.senders[0])
    }
}

// Wake the first parked receiver, as `wake_sender` does a sender.
wake_receiver :: fn<T>(channel: Channel<T>) -> void {
    if !channel.receiver_woken && channel.receivers.len() > 0 {
        channel.receiver_woken = true
        wake(channel.receivers[0])
    }
}

// ---- tests ----------------------------------------------------------------

import "std/string"
import "std/testing"
import "std/time"

@test
test_channel_gives_back_messages_in_order :: fn() -> void {
    channel :: Channel<i32> { .capacity = 4 }
    channel.send(1)
    channel.send(2)
    channel.send(3)
    assert_eq("${channel.receive()} ${channel.receive()} ${channel.receive()}", "1 2 3")
}

@test
test_channel_ring_wraps_around :: fn() -> void {
    channel :: Channel<i32> { .capacity = 2 }
    channel.send(1)
    channel.send(2)
    first :: channel.receive()
    channel.send(3)
    assert_eq("${first} ${channel.receive()} ${channel.receive()}", "1 2 3")
}

@test
test_unbounded_channel_grows_past_a_wrapped_ring :: fn() -> void {
    channel :: Channel<i32> { .capacity = UNBOUNDED }
    channel.send(1)
    channel.send(2)
    channel.receive()
    for n in 3..=6 {
        channel.send(n)
    }
    out: string[]: []
    for _ in 0..<5 {
        out.push("${channel.receive()}")
    }
    assert_eq(out.join(" "), "2 3 4 5 6")
}

@test
test_poll_takes_what_a_channel_holds_and_parks_for_nothing :: fn() -> void {
    channel :: Channel<i32> { .capacity = 2 }
    assert_eq("${channel.poll()}", "empty")
    channel.send(1)
    assert_eq("${channel.poll()} ${channel.poll()}", "1 empty")
    channel.close()
    assert_eq("${channel.poll()}", "closed")
}

@test
test_offer_sends_while_there_is_room_and_gives_back_otherwise :: fn() -> void {
    channel :: Channel<i32> { .capacity = 1 }
    assert_eq("${channel.offer(1)} ${channel.offer(2)}", "sent 2")
    assert_eq("${channel.receive()}", "1")
    channel.close()
    assert_eq("${channel.offer(3)}", "3")
}

@test
test_an_offer_wakes_a_parked_receiver :: fn() -> void {
    channel :: Channel<i32> { .capacity = 1 }
    receiver :: launch(() -> channel.receive())
    sleep(1.millis())
    assert_eq("${channel.offer(7)}", "sent")
    assert_eq("${receiver.join()}", "7")
}

@test
test_channel_carries_a_null_message :: fn() -> void {
    channel :: Channel<i32 | null> { .capacity = 2 }
    channel.send(null)
    channel.close()
    assert_eq("${channel.receive()} ${channel.receive()}", "null closed")
}

@test
test_closed_channel_is_drained_before_it_says_closed :: fn() -> void {
    channel :: Channel<i32> { .capacity = 2 }
    channel.send(7)
    channel.close()
    assert_eq("${channel.receive()} ${channel.receive()}", "7 closed")
}

// Send `0..<n` on `channel`, then close it.
produce :: fn(channel: Channel<i32>, n: i32) -> i32 {
    for i in 0..<n {
        channel.send(i)
    }
    channel.close()
    return n
}

@test
test_full_channel_parks_the_sender_until_a_receive :: fn() -> void {
    channel :: Channel<i32> { .capacity = 1 }
    producer :: launch(() -> produce(channel, 5))
    total: i32 = 0
    for n in channel {
        total += n
    }
    assert_eq(total, 10)
    assert_eq("${producer.join()}", "5")
}

@test
test_cancelled_receiver_hands_its_message_on :: fn() -> void {
    channel :: Channel<i32> { .capacity = 1 }
    first :: launch(() -> channel.receive())
    second :: launch(() -> channel.receive())
    yield_now()
    channel.send(7)
    first.cancel()
    assert_eq("${second.join()} ${first.join()}", "7 cancelled")
}
