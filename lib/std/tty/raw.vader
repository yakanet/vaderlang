// std/tty/raw: putting the terminal in raw mode, and reading keys from it.
//
// Split from `tty.vader` because it is a different KIND of thing: the colour
// helpers decorate a string and change nothing, while these mutate the
// terminal's state and impose a pairing contract on the caller. Same module
// (`std/tty`) so nothing about an import changes.
//
// The widgets built on these live in `cli/prompt`; this layer is the terminal,
// not the interaction.
//
// Cross-platform by construction: raw mode clears `ECHO`, `ICANON` and `ISIG`
// through `termios` on POSIX, and the matching console flags on Windows, where
// it also sets `ENABLE_VIRTUAL_TERMINAL_INPUT` so arrows arrive as the SAME ANSI
// sequences POSIX sends. One decoder therefore serves all three targets.

module "std/tty"

import "std/io"
import "std/string"
import "system/posix"
import "system/windows"

/// Put stdin in raw mode: keys arrive as they are pressed, with no echo and no
/// line editing.
///
/// It also turns OFF signal generation, so **Ctrl-C arrives as the byte `0x03`**
/// instead of killing the process. That is what keeps the terminal usable (a
/// process killed mid-prompt would leave the shell with no echo) and it makes
/// handling the cancellation the caller's job.
///
/// ⚠️ **Always pair it with `defer raw_mode_end()`.** `defer` covers the normal
/// return AND a panic (the runtime runs pending defers before aborting), which
/// is the whole reason the restore does not need a signal handler. What it does
/// not cover is a kill from outside the process; a shell's `reset` fixes that.
///
/// @return `true` when raw mode is now installed, `false` when stdin is not an
///         interactive terminal: in which case NOTHING was changed and the
///         caller must fall back rather than read keys.
///
/// ⚠️ On POSIX this goes through `cfmakeraw`, which also clears `OPOST`: a bare
/// `\n` no longer returns the carriage. Print through `raw_print` between
/// `begin` and `end`: `println` is only safe once the terminal is restored.
@target
export raw_mode_begin :: fn() -> bool {
    // No terminal to put in raw mode: `wasi-wasm32` and `browser-wasm32`.
    return false
}

/// Restore the terminal state saved by `raw_mode_begin`. A no-op when raw mode
/// is not installed, so an unpaired call is harmless.
@target
export raw_mode_end :: fn() -> void {}

/// The terminal state to restore, and whether there is one.
RawState :: struct {
    active: bool = false
    /// The POSIX state. OPAQUE, bytes only C interprets, which is what lets a
    /// `termios` cross without Vader knowing its shape: it differs between systems
    /// (`c_line` is Linux-only) and its `c_cc` is an array.
    termios: u8[]
    /// The Windows state: the console mode of stdin.
    console_mode: u32 = 0
}

@singleton
raw_state :: fn() -> RawState = RawState { .termios = [0] * TERMIOS_BYTES }

@target(.Linux, .Darwin)
raw_mode_begin :: fn() -> bool {
    state :: raw_state()
    if state.active {
        return true
    }
    if sys_isatty(0) == 0 {
        return false
    }
    if sys_tcgetattr(0, state.termios) != 0 {
        return false
    }
    work: u8[]: [0] * TERMIOS_BYTES
    if sys_tcgetattr(0, work) != 0 {
        return false
    }
    sys_cfmakeraw(work)
    if sys_tcsetattr(0, TCSAFLUSH, work) != 0 {
        return false
    }
    state.active = true
    return true
}

@target(.Linux, .Darwin)
raw_mode_end :: fn() -> void {
    state :: raw_state()
    if !state.active {
        return
    }
    sys_tcsetattr(0, TCSAFLUSH, state.termios)
    state.active = false
}

@target(.Windows)
raw_mode_begin :: fn() -> bool {
    state :: raw_state()
    if state.active {
        return true
    }
    h :: get_std_handle(STD_INPUT_HANDLE)
    if i64(h) == INVALID_HANDLE {
        return false
    }
    mode: u32[]: [0]
    // Fails on a pipe or a redirected file: exactly when there is no console to
    // put in raw mode. Reported rather than pretended.
    if !get_console_mode(h, mode) {
        return false
    }
    state.console_mode = mode[0]
    off :: ENABLE_LINE_INPUT | ENABLE_ECHO_INPUT | ENABLE_PROCESSED_INPUT
    raw :: (mode[0] & ~off) | ENABLE_VIRTUAL_TERMINAL_INPUT
    if !set_console_mode(h, raw) {
        return false
    }
    // Keys typed before raw mode, like those left unread when it ends, were not
    // meant for the reader that comes next: dropped, as `TCSAFLUSH` drops them on
    // POSIX.
    flush_console_input_buffer(h)
    state.active = true
    return true
}

@target(.Windows)
raw_mode_end :: fn() -> void {
    state :: raw_state()
    if !state.active {
        return
    }
    h :: get_std_handle(STD_INPUT_HANDLE)
    if i64(h) != INVALID_HANDLE {
        set_console_mode(h, state.console_mode)
        flush_console_input_buffer(h)
    }
    state.active = false
}

/// Terminal width in columns, or 0 when it cannot be determined, not a
/// terminal, or the query failed. A caller that needs a number anyway should
/// pick its own default rather than treat 0 as a width.
@target
export columns :: fn() -> i32 {
    // No terminal to measure: `wasi-wasm32` and `browser-wasm32`. `0` is the
    // documented "cannot be determined", which every caller already handles.
    return 0
}

@target(.Linux, .Darwin)
columns :: fn() -> i32 {
    ws :: Winsize { .ws_row = 0, .ws_col = 0, .ws_xpixel = 0, .ws_ypixel = 0 }
    if sys_ioctl_winsize(1, TIOCGWINSZ, ws) != 0 {
        return 0
    }
    return i32(ws.ws_col)
}

@target(.Windows)
columns :: fn() -> i32 {
    h :: get_std_handle(STD_OUTPUT_HANDLE)
    if i64(h) == INVALID_HANDLE {
        return 0
    }
    info :: ScreenBufferInfo {
        .dwSize              = Coord { .X = 0, .Y = 0 },
        .dwCursorPosition    = Coord { .X = 0, .Y = 0 },
        .wAttributes         = 0,
        .srWindow            = SmallRect { .Left = 0, .Top = 0, .Right = 0, .Bottom = 0 },
        .dwMaximumWindowSize = Coord { .X = 0, .Y = 0 },
    }
    if !get_console_screen_buffer_info(h, info) {
        return 0
    }
    // The rectangle is INCLUSIVE, hence the `+ 1`.
    width :: i32(info.srWindow.Right) - i32(info.srWindow.Left) + 1
    return if width > 0 { width } else { 0 }
}

/// Read the keys pressed so far, blocking until there is at least one.
///
/// Returns everything already queued, up to `max` bytes (capped at 64). Reading
/// a BURST rather than a byte is what makes a lone `Escape` distinguishable from
/// the start of an arrow sequence: the arrow's three bytes arrive in one call,
/// `Escape` alone arrives as one byte. No timing is involved, and it behaves the
/// same on POSIX and on a Windows console, whose keys arrive as the UTF-8 of
/// what was typed whatever its code page.
///
/// @param max  ceiling on the bytes returned; values above 64 are clamped.
/// @return     the bytes read, never empty, since a successful read yields at
///             least one byte, or `null` at end of input, on a read failure,
///             and on a target with no terminal.
export read_keys :: fn(max: i32) -> string | null = read_available_or_null(i64(clamp_keys(max)))

/// Bytes returned at most, whatever the caller asked for. A key press is a few
/// bytes (an arrow is three); more is a paste, handed over in pieces.
KEYS_MAX: i32 : 64

/// The read size: the caller's ask, capped at `KEYS_MAX`.
clamp_keys :: fn(max: i32) -> i32 {
    if max > KEYS_MAX {
        return KEYS_MAX
    }
    return max
}

/// Print `s` the way a raw-mode terminal needs, terminated.
///
/// `raw_mode_begin` clears `OPOST` on POSIX, so a bare `\n` advances a row
/// without returning the carriage. `s` may be several lines: terminating only
/// the last one leaves the rest climbing a staircase to the right.
///
/// @param s  one line, or a whole frame joined on `\n`.
export raw_print :: fn(s: string) -> void = print(raw_terminated(s))

// Split out so a test can see it: `raw_print` itself only prints.
raw_terminated :: fn(s: string) -> string = "${s.replace_all("\n", "\r\n")}\r\n"

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_raw_termination_returns_the_carriage_on_every_line :: fn() -> void {
    out :: raw_terminated("a\nb\nc")
    assert_eq(out, "a\r\nb\r\nc\r\n")
    assert(!("\n" in out.replace_all("\r\n", "")), "no bare newline survives")
}
