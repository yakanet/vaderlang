// std/runtime: runtime introspection and controls (GC, memory and scheduler).
//
// Lives in std/ rather than a hypothetical internal/ namespace because Vader
// has no compiler-private visibility tier today and Go-style "runtime"
// naming already signals the intent. Mostly intended for test harnesses
// and stress tests ; user programs should rarely need to call these.
//
// The VM (`vader run`, `vader test`) has no collector of its own: there
// `collect()` only counts a cycle, and the byte and allocation counters read 0.

module "std/runtime"

import "std/collections"
import "std/env"
import "std/io"
import "std/numbers"
import "std/string"
import "std/time"
import "system/darwin"
import "system/posix"

/// Force a full collection now: a minor, then a major over the old
/// generation. Returns once it completes.
@intrinsic
export collect :: fn() -> void

/// Total number of GC cycles run since process start. Monotonically
/// increasing ; useful for asserting in stress tests that a forced
/// `collect()` actually ran.
/// @return  total cycle count since process start.
@intrinsic
export collections :: fn() -> i64

/// Old-generation live bytes plus the young generation's allocation. Right
/// after `collect()` this is the live-object footprint ; mid-mutation it also
/// counts uncollected garbage.
/// @return  the bytes in use, old and young.
@intrinsic
export bytes_used :: fn() -> i64

/// Cumulative bytes copied across all collections. A coarse measure of
/// total GC work: divide by `collections()` for the average per-cycle
/// payload.
/// @return  total bytes copied since process start.
@intrinsic
export bytes_copied :: fn() -> i64

/// Cumulative bytes requested from the collector since process start. Counts
/// every allocation only once `count_allocations()` has run, and a part of them
/// before. 0 under the VM, which has no collector.
/// @return  the bytes allocated, as requested.
@intrinsic
export allocated_bytes :: fn() -> i64

/// Number of allocations made through the collector since process start,
/// counted as `allocated_bytes()` counts their bytes.
/// @return  the allocation count.
@intrinsic
export allocations :: fn() -> i64

/// Count every allocation from now on, so that `allocated_bytes()` and
/// `allocations()` miss none. Each allocation then leaves the inline path,
/// which slows it down. Counting stays on for the rest of the run.
@intrinsic
export count_allocations :: fn() -> void

// ---- memory footprint -----------------------------------------------------

/// The most memory the process has held resident at once, in bytes: it never
/// decreases. 0 where the platform gives no reading, as on Windows.
/// @return  the peak resident set size, in bytes.
@target
export peak_resident_bytes :: fn() -> i64 = 0

@target(.Linux, .Darwin)
peak_resident_bytes :: fn() -> i64 {
    usage: i64[]: [0] * RUSAGE_CELLS
    if sys_getrusage(RUSAGE_SELF, usage) != 0 {
        return 0
    }
    return usage[RU_MAXRSS_CELL] * RU_MAXRSS_UNIT
}

/// The memory the process holds resident now, in bytes. Where the platform
/// gives no current reading, the peak stands in for it.
/// @return  the resident set size, in bytes.
@target
export resident_bytes :: fn() -> i64 = peak_resident_bytes()

@target(.Darwin)
resident_bytes :: fn() -> i64 {
    info: u64[]: [0] * 6
    count: u32[]: [MACH_TASK_BASIC_INFO_COUNT]
    if task_info(mach_task_self(), MACH_TASK_BASIC_INFO, info, count) != KERN_SUCCESS {
        return peak_resident_bytes()
    }
    return i64(info[1])
}

// `/proc/self/statm` holds sizes in pages, the resident set second.
@target(.Linux)
resident_bytes :: fn() -> i64 {
    statm :: read_file_string("/proc/self/statm")
    if statm is IOError {
        return peak_resident_bytes()
    }
    fields :: statm.split(" ")
    if fields.len() < 2 {
        return peak_resident_bytes()
    }
    pages :: parse_int_in_base(fields[1], 10)
    if pages is ParseError {
        return peak_resident_bytes()
    }
    return pages * sys_sysconf(SC_PAGESIZE)
}

// ---- cooperative async scheduler (std/async backend) ----------------------

// The clock and the wakes armed on it. The clock counts the waits alone:
// milliseconds from 0, set by `sched_park` to each deadline it reaches, so what a
// program prints depends on the order of its deadlines, never on how long its
// work took.
Scheduler :: struct {
    now: i64 = 0
    deadlines: MinHeap<i64> = MinHeap<i64> {}
}

@singleton
scheduler :: fn() -> Scheduler = Scheduler {}

// `VADER_ASYNC_VIRTUAL_CLOCK`, whatever its value: `sched_park` jumps to the
// next deadline instead of sleeping until it.
@singleton
clock_is_virtual :: fn() -> bool = get_env("VADER_ASYNC_VIRTUAL_CLOCK") != null

/// The scheduler clock, in milliseconds from 0. Advanced by `sched_park` as
/// timers fire. Backs `std/async`'s `sleep`.
/// @return  the current scheduler time in ms.
export sched_now :: fn() -> i64 = scheduler().now

/// Register a wake at `deadline` (absolute scheduler ms) on the timer heap: the
/// scheduler will resume the parked program no earlier than then.
/// @param deadline  absolute scheduler time (ms) at which to wake.
export sched_arm :: fn(deadline: i64) -> void {
    scheduler().deadlines.push(deadline)
}

/// Park until the nearest armed deadline : wait for it (real time, unless
/// `VADER_ASYNC_VIRTUAL_CLOCK` is set), advance the clock to it, and drop every
/// timer then due: the caller re-drives all of its tasks after a park, so one
/// wake serves them all.
/// @return  true once the clock reached the next deadline ; false on a deadlock:
///          nothing armed, every task suspended with nothing left to wake it.
export sched_park :: fn() -> bool {
    s :: scheduler()
    drop_due_timers(s)
    next :: s.deadlines.peek() ?? return false
    if !clock_is_virtual() {
        sleep((next - s.now).millis())
    }
    s.now = next
    drop_due_timers(s)
    return true
}

// A timer already due carries nothing: the caller re-drives every task after a
// park, so each of them sees the clock it waited for.
drop_due_timers :: fn(s: Scheduler) -> void {
    for {
        next :: s.deadlines.peek() ?? return
        if next > s.now {
            return
        }
        s.deadlines.pop()
    }
}

// ---------------------------------------------------------------------- tests

import "std/testing"

@test
test_sched_park_reports_a_deadlock_with_nothing_armed :: fn() -> void {
    assert(!sched_park(), "nothing armed is a deadlock")
}

@test
test_sched_park_advances_to_the_nearest_deadline :: fn() -> void {
    start :: sched_now()
    sched_arm(start + 3)
    sched_arm(start + 1)
    assert(sched_park(), "park to the first deadline")
    assert_eq(sched_now(), start + 1)
    assert(sched_park(), "park to the second deadline")
    assert_eq(sched_now(), start + 3)
    assert(!sched_park(), "nothing left armed")
}

@test
test_resident_bytes_read_the_process_where_the_platform_tells :: fn() -> void {
    readable :: VADER_OS != .Windows
    assert((resident_bytes() > 0) == readable, "the resident set, where the platform gives it")
    assert((peak_resident_bytes() > 0) == readable, "the peak, where the platform gives it")
}
