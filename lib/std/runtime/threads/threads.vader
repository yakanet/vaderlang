// std/runtime/threads: the primitives of virtual threads, under the scheduler.
//
// A virtual thread runs a function on a stack of its own; a switch leaves the
// running thread where it stands and resumes another. Nothing here decides
// which thread runs: a scheduler written on top does, and runs on a thread of
// its own, which the runtime knows. A thread whose function returns switches
// to the scheduler, which frees its stack.
//
// A thread is named by an `i64` handle. A handle stays valid while its thread
// runs or waits; a switch to a thread that has ended stops the program.
//
// This module imports nothing, so the scheduler can sit under `std/io` and
// `std/time`.

module "std/runtime/threads"

/// Start the scheduler: a thread that runs `run`, which never returns. The
/// first switch to it starts it; every thread whose function returns switches
/// to it, and the scheduler frees that thread's stack.
///
/// @param run  the scheduler's loop: it picks the next thread and switches to
///             it, and waits when no thread can run.
/// @return     the scheduler's handle.
/// @error      stops the program when the scheduler is already started, or
///             when `run` returns.
@intrinsic
export start_scheduler :: fn(run: fn() -> void) -> i64

/// Create a thread that runs `entry`. It does not run yet: the first switch to
/// it starts it.
///
/// @param entry  what the thread runs; when it returns, the thread ends.
/// @return       the thread's handle.
/// @error        stops the program when no scheduler is started.
@intrinsic
export create_thread :: fn(entry: fn() -> void) -> i64

/// Leave the running thread for `to`, which resumes where it stands, or starts.
/// Returns when a switch comes back to the running thread. A switch to the
/// running thread does nothing.
///
/// @param to  the handle of the thread to run.
/// @error     stops the program when `to` has ended, or when C is running
///            under the switch: a callback that C called cannot switch, since
///            another thread would run over the C frames.
@intrinsic
export switch_to_thread :: fn(to: i64) -> void

/// The handle of the running thread. The main thread has one before it ever
/// switches.
@intrinsic
export current_thread :: fn() -> i64
