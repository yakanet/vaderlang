// std/runtime/scheduler: virtual threads, and the scheduler that runs them.
//
// A virtual thread runs a function on a stack of its own. A thread runs until
// it parks, sleeps or ends; the scheduler then runs the ready threads in the
// order they became ready. With none ready, it waits for the nearest sleep to
// end or for what a thread watches: a descriptor to read, a child to end. With
// neither, every thread waits on another, and the program stops on a deadlock.
//
// A thread is named by an `i64` handle. Once its thread has ended, a handle
// names nothing, and waking or cancelling it does nothing. When `main` returns,
// the threads still running are cancelled, stderr names them, and the exit code
// is not zero.
//
// The runtime serves these, and under the VM the host serves them with its
// own: a program and the VM that runs it share one scheduler. This module
// imports nothing, so any module can sit on it: `std/task` and `std/process` do.
//
// Over them, the gates of the values built on first use: in a program that
// loads this module, every `@singleton`, and every constant whose value runs
// code, waits on its own `InitGate` while another thread builds it. A program
// that does not load it has one thread, and needs none.

module "std/runtime/scheduler"

/// Start a thread that runs `entry`. It is ready at once, and runs once the
/// running thread parks; when `entry` returns, the thread ends.
///
/// A thread cancelled before it starts runs `entry` all the same, and unwinds at
/// its first park: an entry that must run nothing then asks `is_cancelled`
/// first.
///
/// @param entry  what the thread runs.
/// @return       the thread's handle.
export spawn_thread :: fn(entry: fn() -> void) -> i64 = Intrinsic.spawn_thread(entry)

/// Park the running thread until a `wake` names it.
///
/// A wake meant for an earlier wait can end a park too, so a thread parks in a
/// loop that checks what it waits for.
///
/// @error  stops the program when no thread is ready and none sleeps: nothing
///         would ever wake one. Also when C is running under the park: a
///         callback that C called cannot park, since another thread would run
///         over the C frames.
export park :: fn() -> void = Intrinsic.park()

/// Make `thread` ready, unless it has ended: a parked thread runs again in its
/// turn. A thread that wakes itself and then parks lets the ready threads run
/// first.
///
/// @param thread  the handle of the thread to wake.
export wake :: fn(thread: i64) -> void = Intrinsic.wake(thread)

/// Park the running thread for at least `nanos` nanoseconds, while the other
/// threads run. A zero or negative `nanos` returns at once; a `wake` does not
/// end the sleep.
///
/// Under `VADER_VIRTUAL_CLOCK`, the clock counts the sleeps alone: with
/// no thread ready, it jumps to the end of the nearest sleep, unless a thread
/// waits on the system, which holds the clock until the system answers.
///
/// @param nanos  how long to sleep.
/// @error        as `park`.
export sleep_for :: fn(nanos: i64) -> void = Intrinsic.sleep_for(nanos)

/// Cancel `thread`: at its next run, it cancels the threads it launched that
/// have not ended and waits for their ends, then runs its pending defers and
/// ends. One that has not started runs its entry up to its first park, as
/// `spawn_thread` says. The running thread cancels itself at once, and
/// `cancel_thread` does not return. A defer that parks parks the cancelled
/// thread.
///
/// @param thread  the handle of the thread to cancel.
/// @error         stops the program on the main thread, which cannot be
///                cancelled.
export cancel_thread :: fn(thread: i64) -> void = Intrinsic.cancel_thread(thread)

/// The handle of the running thread. The main thread has one from the start.
export current_thread :: fn() -> i64 = Intrinsic.current_thread()

/// Whether the running thread was cancelled: it is unwinding, or it was
/// cancelled before it started and runs its entry.
export is_cancelled :: fn() -> bool = Intrinsic.is_cancelled()

/// Whether `thread` is on its way out, so that `main` returning waits for it
/// without naming it: it was cancelled, or the thread that launched it is
/// leaving and a defer of that thread's cancellation did not launch it.
///
/// @param thread  the handle of a thread; one that has ended is not leaving.
export is_leaving :: fn(thread: i64) -> bool = Intrinsic.is_leaving(thread)

/// Make the running thread's next park end once descriptor `fd` has input to
/// read, or has reached its end. The watch lasts that one park, which a `wake`
/// can end first; one the system cannot follow ends it after 2 ms instead. A
/// thread checks what it waits for in a loop.
///
/// @param fd  a descriptor of the process: a pipe, a terminal, a socket. On
///            Windows, 0 for stdin, else the read end of a pipe
///            `create_watched_pipe` made, as its handle.
export watch_readable :: fn(fd: i64) -> void = Intrinsic.watch_readable(fd)

/// Make the running thread's next park end once the child process `child` has
/// ended, as `watch_readable` does for a descriptor.
///
/// @param child  the pid of a child of this process; on Windows, its process
///               handle.
export watch_exit :: fn(child: i64) -> void = Intrinsic.watch_exit(child)

// ---- the monitor ------------------------------------------------------------

/// Take the monitor over the state the tasks of `std/task` share, for the
/// running thread: one thread at a time holds it, whichever system thread runs
/// it.
///
/// It is reentrant: a thread lets it go as often as it took it. A thread that
/// parks lets it go meanwhile, and takes it back before it runs again. What the
/// holder allocates stays readable from every system thread; a value it made
/// before it took the monitor does not, and goes in through
/// `monitor_enter_to_publish`.
export monitor_enter :: fn() -> void = Intrinsic.monitor_enter(false)

/// Take the monitor as `monitor_enter` does, to store in the shared state values
/// the running thread made before: the captures of a task, a message, a result.
/// Every system thread can then read them.
export monitor_enter_to_publish :: fn() -> void = Intrinsic.monitor_enter(true)

/// Let go of the monitor once.
///
/// @error  stops the program when the running thread does not hold it.
export monitor_exit :: fn() -> void = Intrinsic.monitor_exit()

// ---- gates ----------------------------------------------------------------

/// What a value built on first use waits on while a thread builds it: the
/// instance of a `@singleton`, or the value of a constant computed at each read.
/// The compiler gives each such value a gate of its own.
export InitGate :: struct {
    /// Whether a thread is building the value.
    @internal
    held: bool = false
    /// The thread building it, while `held`.
    @internal
    owner: i64 = 0
    /// The threads waiting for it to be built, in the order they came.
    @internal
    waiters: i64[] = []
}

/// `gate`, or a new gate when there is none yet. The caller holds the monitor
/// (`monitor_enter_to_publish`) from its read of `gate`, stores the gate where
/// the next reader finds it, then hands it to `run_gated`, which lets the
/// monitor go.
///
/// @param gate  the gate of a value, null until its first build.
export gate_or_new :: fn(gate: InitGate | null) -> InitGate = gate else InitGate {}

/// Run `build` holding `gate`, once no other thread holds it ; false, without
/// running it, when the running thread holds it already.
///
/// A thread that finds `gate` held by another parks until it is let go, then
/// takes it: `build` checks whether the value was built meanwhile. A thread
/// cancelled while it holds `gate` lets it go, and the next one builds.
///
/// `build` runs holding the monitor its caller took to read the gate, which
/// `run_gated` lets go: the value it builds is readable from every system
/// thread once it is stored.
///
/// @param gate   the gate of the value.
/// @param build  builds the value, unless it is built already.
/// @return       false when the running thread reads the value again while it
///               builds it.
export run_gated :: fn(gate: InitGate, build: fn() -> void) -> bool {
    defer monitor_exit()
    me :: current_thread()
    if gate.held && gate.owner == me {
        return false
    }
    if gate.held {
        await_gate(gate, me)
    }
    gate.held = true
    gate.owner = me
    defer let_go(gate)
    build()
    return true
}

// Park until no thread holds `gate`.
await_gate :: fn(gate: InitGate, me: i64) -> void {
    gate.waiters.push(me)
    defer gate.waiters.remove_value(me)
    for gate.held {
        park()
    }
}

// Let `gate` go, and wake the threads waiting on it: the first to run takes it.
let_go :: fn(gate: InitGate) -> void {
    gate.held = false
    for thread in gate.waiters {
        wake(thread)
    }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// `gate`, with the monitor taken, as the compiler reads a gate before
// `run_gated`.
gated :: fn(gate: InitGate) -> InitGate {
    monitor_enter_to_publish()
    return gate
}

// Let the ready threads run, then go on.
yield_turn :: fn() -> void {
    wake(current_thread())
    park()
}

// Launch a thread that parks, and note its handle in `handle`: a `defer` that
// launches it keeps no result.
launch_parked :: fn(handle: i64[]) -> void {
    handle[0] = spawn_thread(() -> park())
}

// Build under `gate`, parking until a `wake` in the middle of the build.
build_parked :: fn(gate: InitGate, log: string[]) -> void {
    gated(gate).run_gated(fn() {
        log.push("first builds")
        park()
        log.push("first done")
    })
}

@test
test_run_gated_runs_the_build :: fn() -> void {
    gate :: InitGate {}
    built :: [false]
    assert(gated(gate).run_gated(fn() {
        built[0] = true
    }), "the gate was free")
    assert(built[0], "the build ran")
}

@test
test_run_gated_refuses_the_thread_holding_the_gate :: fn() -> void {
    gate :: InitGate {}
    again :: [true]
    gated(gate).run_gated(fn() {
        again[0] = gated(gate).run_gated(fn() {})
    })
    assert(!again[0], "the holder reads the value again")
}

@test
test_gate_makes_another_thread_wait_for_the_build :: fn() -> void {
    gate :: InitGate {}
    log: string[]: []
    main :: current_thread()
    first :: spawn_thread(() -> build_parked(gate, log))
    spawn_thread(fn() {
        gated(gate).run_gated(() -> log.push("second builds"))
        wake(main)
    })
    yield_turn()
    wake(first)
    park()
    assert(log.content_equals(["first builds", "first done", "second builds"]), "in turn")
}

@test
test_cancelled_holder_lets_the_gate_go :: fn() -> void {
    gate :: InitGate {}
    log: string[]: []
    main :: current_thread()
    first :: spawn_thread(() -> build_parked(gate, log))
    spawn_thread(fn() {
        gated(gate).run_gated(() -> log.push("second builds"))
        wake(main)
    })
    yield_turn()
    cancel_thread(first)
    park()
    assert(log.content_equals(["first builds", "second builds"]), "the second builds")
}

@test
test_is_leaving_follows_a_cancellation_to_the_threads_it_launched :: fn() -> void {
    child: i64[]: [-1]
    parent :: spawn_thread(fn() {
        launch_parked(child)
        park()
    })
    yield_turn()
    assert(!is_leaving(parent), "the launcher stays until it is cancelled")
    assert(!is_leaving(child[0]), "the thread it launched stays with it")
    cancel_thread(parent)
    assert(is_leaving(parent), "the cancelled thread leaves")
    assert(is_leaving(child[0]), "the thread it launched leaves with it")
}

@test
test_is_leaving_spares_a_thread_a_defer_of_a_cancellation_launched :: fn() -> void {
    late: i64[]: [-1]
    parked :: spawn_thread(fn() {
        defer launch_parked(late)
        park()
    })
    yield_turn()
    cancel_thread(parked)
    yield_turn()
    assert(!is_leaving(late[0]), "it outlives its launcher")
    // Nothing else ends it.
    cancel_thread(late[0])
}
