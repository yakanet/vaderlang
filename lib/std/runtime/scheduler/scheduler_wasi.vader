// std/runtime/scheduler/scheduler_wasi: the scheduler of a WASI program, over
// the threads of the component model.
//
// The host runs the threads (`Intrinsic.wasm_thread_*`): a thread that
// suspends lets the threads made ready before it run, in that order; a wait on
// the host blocks the thread that waits alone; with no thread able to run, the
// host stops the program on a deadlock. What is left here is what the scheduler
// keeps of each thread: its number, its launcher, the threads it launched that
// have not ended, whether it is ready or was cancelled. A handle numbers a
// thread once: the host's index of a thread serves again after its end.
//
// A thread unwinds as the native scheduler's does (`runtime/c/rt/scheduler.c`):
// cancelled, it cancels at its next run the threads it launched that have not
// ended and waits for their ends, then `wasm_thread_exit` runs its pending
// defers and ends it. A thread notes its own end in its first defer, which
// runs last. A cancelled thread that sleeps unwinds once its sleep ends: the
// host's wait is not cut short.
//
// The state lives in a `@singleton`, which the compiler gates for every module
// but this one: its gate would ask this state which thread runs.

module "std/runtime/scheduler"

import "std/abort"
import "std/iter"
import "system/wasi"
WasiClock :: import "wasi:clocks/monotonic-clock@0.3.0"
WasiStderr :: import "wasi:cli/stderr@0.3.0"

// What the scheduler keeps of a thread that has not ended.
WasiThread :: struct {
    handle: i64
    /// How a report names it, `task #number`; 0 for the main thread.
    number: i64
    /// The host's index of it, -1 until the host made it.
    index: i64 = -1
    /// The thread that launched it, -1 for the main thread.
    parent: i64 = -1
    /// The threads it launched that have not ended.
    children: i64 = 0
    /// Made ready and not run since: its next park lets the others run first.
    ready: bool = false
    /// Suspended by a park, until a wake makes it ready.
    suspended: bool = false
    cancelled: bool = false
    /// Cancelling the threads it launched, then running its defers.
    unwinding: bool = false
    /// Waits for the threads it launched to end.
    reaping: bool = false
    /// Launched by a defer of its launcher's cancellation, which it outlives.
    outlives: bool = false
    /// Its task ended: `main` returning waits for it without naming it.
    task_ended: bool = false
}

// The threads that have not ended, the main thread first, in the order they
// began.
WasiScheduler :: struct {
    threads: WasiThread[] = []
    next_handle: i64 = 1
    /// `main` returned, and waits for the threads it cancelled.
    exiting: bool = false
}

// The handle of the main thread.
MAIN_THREAD: i64: 0

// The state, made by the main thread: the first to start a thread, or to ask.
@singleton
wasi_scheduler :: fn() -> WasiScheduler {
    main :: WasiThread {
        .handle = MAIN_THREAD,
        .number = 0,
        .index = Intrinsic.wasm_thread_index(),
    }
    return WasiScheduler { .threads = [main] }
}

@target(.Wasi)
spawn_thread :: fn(entry: fn() -> void, number: i64) -> i64 {
    s :: wasi_scheduler()
    launcher :: running(s)
    thread :: WasiThread {
        .handle = s.next_handle,
        .number = number,
        .parent = launcher.handle,
        .outlives = launcher.unwinding,
        .ready = true,
    }
    s.next_handle += 1
    s.threads.push(thread)
    launcher.children += 1
    handle :: thread.handle
    thread.index = Intrinsic.wasm_thread_new(() -> run_thread(handle, entry))
    Intrinsic.wasm_thread_resume_later(thread.index)
    return handle
}

// Run `entry` on the thread `handle`, which ends with it.
run_thread :: fn(handle: i64, entry: fn() -> void) -> void {
    defer thread_ended(handle)
    thread :: thread_of(wasi_scheduler(), handle)
    if thread != null {
        thread.ready = false
    }
    entry()
}

@target(.Wasi)
park :: fn() -> void {
    me :: running(wasi_scheduler())
    unwind_if_cancelled(me)
    if me.ready {
        Intrinsic.wasm_thread_yield()
    } else {
        me.suspended = true
        Intrinsic.wasm_thread_suspend()
    }
    me.ready = false
    unwind_if_cancelled(me)
}

@target(.Wasi)
wake :: fn(thread: i64) -> void {
    woken :: thread_of(wasi_scheduler(), thread) else return
    if woken.ready {
        return
    }
    woken.ready = true
    if woken.suspended {
        woken.suspended = false
        Intrinsic.wasm_thread_resume_later(woken.index)
    }
}

@target(.Wasi)
sleep_for :: fn(nanos: i64) -> void {
    if nanos <= 0 {
        return
    }
    WasiClock.wait_for(u64(nanos))
    unwind_if_cancelled(running(wasi_scheduler()))
}

@target(.Wasi)
cancel_thread :: fn(thread: i64) -> void {
    if thread == MAIN_THREAD {
        panic("virtual threads: the main thread cannot be cancelled")
    }
    s :: wasi_scheduler()
    cancelled :: thread_of(s, thread) else return
    if cancelled.cancelled {
        return
    }
    cancelled.cancelled = true
    if cancelled.index == Intrinsic.wasm_thread_index() {
        unwind(cancelled)
    }
    wake(thread)
}

@target(.Wasi)
current_thread :: fn() -> i64 = running(wasi_scheduler()).handle

@target(.Wasi)
is_cancelled :: fn() -> bool = running(wasi_scheduler()).cancelled

@target(.Wasi)
is_leaving :: fn(thread: i64) -> bool {
    s :: wasi_scheduler()
    at := thread
    for at != MAIN_THREAD {
        t :: thread_of(s, at) else return false
        if t.cancelled {
            return true
        }
        if t.outlives {
            return false
        }
        at = t.parent
    }
    return false
}

@target(.Wasi)
task_ended :: fn() -> void {
    running(wasi_scheduler()).task_ended = true
}

@target(.Wasi)
wait :: fn(mutex: Mutex) -> void = park()

@target(.Wasi)
exit_threads :: fn(code: i32) -> i32 {
    s :: wasi_scheduler()
    if s.threads.len() <= 1 {
        return code
    }
    left_running := false
    // Every name before any cancel, which would make the threads it launched
    // leave.
    for t in s.threads {
        if t.handle != MAIN_THREAD && !is_leaving(t.handle) && !t.task_ended {
            line :: "vader: task #${t.number} still runs when main returns: cancelled\n"
            // A report that does not reach stderr has nowhere else to go.
            _ :: WasiStderr.write_via_stream(line.bytes()).wait()
            left_running = true
        }
    }
    // An end changes the threads: the loop walks their handles.
    for handle in s.threads.map((t) -> t.handle).collect() {
        if handle != MAIN_THREAD {
            cancel_thread(handle)
        }
    }
    s.exiting = true
    for s.threads.len() > 1 {
        park()
    }
    s.exiting = false
    if code != 0 || !left_running {
        return code
    }
    return 1
}

// ---- building blocks ------------------------------------------------------

// The running thread.
running :: fn(s: WasiScheduler) -> WasiThread {
    index :: Intrinsic.wasm_thread_index()
    return s.threads.find((t) -> t.index == index)
        else panic("virtual threads: the running thread is unknown to the scheduler")
}

// The thread `handle`, null once it ended.
thread_of :: fn(s: WasiScheduler, handle: i64) -> WasiThread | null =
    s.threads.find((t) -> t.handle == handle)

// Unwind `me`, the running thread, when it was cancelled and has not begun to.
unwind_if_cancelled :: fn(me: WasiThread) -> void {
    if me.cancelled && !me.unwinding {
        unwind(me)
    }
}

// Cancel the threads `me`, the running one, launched that have not ended, wait
// for their ends, then run its defers and end it.
unwind :: fn(me: WasiThread) -> void {
    me.unwinding = true
    s :: wasi_scheduler()
    children :: s.threads.filter((t) -> t.parent == me.handle).map((t) -> t.handle).collect()
    for child in children {
        cancel_thread(child)
    }
    me.reaping = true
    for me.children > 0 {
        park()
    }
    me.reaping = false
    Intrinsic.wasm_thread_exit()
}

// The thread `handle` has ended: its launcher stops waiting for it, and so does
// `main` returning, once it is the last.
thread_ended :: fn(handle: i64) -> void {
    s :: wasi_scheduler()
    ended :: thread_of(s, handle) else return
    s.threads.remove_where((t) -> t.handle == handle)
    launcher :: thread_of(s, ended.parent)
    if launcher != null {
        launcher.children -= 1
        if launcher.children == 0 && launcher.reaping {
            wake(launcher.handle)
        }
    }
    if s.exiting && s.threads.len() == 1 {
        wake(MAIN_THREAD)
    }
}
