// std/fs/fs_wasi: the files of a WASI program, through `wasi:filesystem`.
//
// A WASI program reaches only the directories the host preopens. A path is
// resolved as wasi-libc resolves it: under the preopened directory whose name
// prefixes it by whole components, the longest and at a tie the latest, a
// relative path under `.`.
// A file is the descriptor `open-at` returns, held by its `File` with its
// position and the read under way: the stream `read-via-stream` opens at the
// position on the first read, kept until it ends or a write or a seek moves the
// position. A write sends its bytes whole through `write-via-stream`, or
// `append-via-stream` for a file open to append, and waits for them.
//
// The host hands out a descriptor once per call, a preopened one included: each
// is given back by `drop` once done with, the descriptor of a file when it
// closes.
//
// WASI has no permission bits: a file is never read-only, and setting it so is
// refused.

module "std/fs"

import "std/io"
import "std/iter"
import "std/path"
import "std/string"
import "system/wasi"
WasiFs :: import "wasi:filesystem/types@0.3.0"
WasiPreopens :: import "wasi:filesystem/preopens@0.3.0"

// A file open under WASI: its descriptor, its position, and the read under way.
WasiFile :: struct {
    descriptor: WasiFs.Descriptor
    /// Where the next read or write starts, from the start of the file.
    position: i64 = 0
    /// Open to append: a write goes at the end, wherever the position stands.
    append: bool = false
    /// Null before the first read, and once the stream has ended.
    read: WasiRead | null = null
    /// Whether the stream has ended: a read past it reads nothing.
    ended: bool = false
}

// A read under way: the stream of the file's bytes, and how it ends.
WasiRead :: struct {
    bytes: WasmReadable<u8>
    done: WasmFuture<void | WasiFs.ErrorCode>
}

// The preopened directory `path` is under, and the path under it. The host is
// asked for the preopened directories at each path, not once: kept in a
// singleton, the list would be one value for every task, which the task check
// refuses where the compiler reads files from several tasks (T3128). The others
// are dropped as they lose, the one returned by the caller.
resolve :: fn(path: string) -> [WasiFs.Descriptor, string] | IOError {
    preopens :: WasiPreopens.get_directories()
    best: i64 = -1
    best_length: i64 = -1
    for [entry, i] in preopens.indexed() {
        prefix :: preopen_prefix(entry.1)
        length :: prefix.byte_len()
        if !covers(prefix, path) || length < best_length {
            WasiFs.drop(entry.0)
            continue
        }
        if best >= 0 {
            WasiFs.drop(preopens[best].0)
        }
        best = i
        best_length = length
    }
    if best < 0 {
        return IOError { .msg = "no preopened directory holds `${path}`", .kind = .NotFound }
    }
    rest :: path.byte_slice(best_length, path.byte_len()).trim_prefix("/")
    under: string: if rest == "" { "." } else { rest }
    return [preopens[best].0, under]
}

// The name of a preopened directory as a prefix: `.` and a leading `./` drop.
preopen_prefix :: fn(name: string) -> string = if name == "." { "" } else { name.trim_prefix("./") }

// Whether `prefix` covers `path` by whole components: an empty one covers any
// relative path.
covers :: fn(prefix: string, path: string) -> bool {
    if prefix == "" {
        return !path.starts_with("/")
    }
    return to_path(path).starts_with(to_path(prefix))
}

// A failure of `wasi:filesystem` as an `IOError`.
wasi_io_error :: fn(failure: WasiFs.ErrorCode, path: string) -> IOError {
    if failure is WasiFs.ErrorCodeOther {
        return IOError { .msg = "`${path}`: ${failure.value else "error"}" }
    }
    code :: i32(failure)
    return io_error_of(code, "`${path}`: error ${code}")
}

// What a descriptor opened only to read is allowed.
READ_ONLY :: WasiFs.DescriptorFlags { .read = true }

// The descriptor `open-at` opens at `path`, with `flags`, for what `access`
// allows.
open_under :: fn(
    path: string,
    flags: WasiFs.OpenFlags,
    access: WasiFs.DescriptorFlags = READ_ONLY,
) -> WasiFs.Descriptor | IOError {
    found :: resolve(path) else return found
    defer WasiFs.drop(found.0)
    opened :: WasiFs.open_at(found.0, WasiFs.PathFlags {}, found.1, flags, access)
        else is WasiFs.ErrorCode { return wasi_io_error(opened, path) }
    return opened
}

@target(.Wasi)
system_open :: fn(path: string, options: OpenOptions) -> FileHandle | IOError {
    flags :: WasiFs.OpenFlags {
        .create = options.create || options.create_new,
        .exclusive = options.create_new,
        .truncate = options.truncate,
    }
    access :: WasiFs.DescriptorFlags {
        .read = options.read,
        .write = options.write || options.append,
    }
    opened :: open_under(path, flags, access) else return opened
    // `open-at` takes a directory for reading alone, which the first read then
    // refuses; a write refuses it already.
    if !access.write && is_directory(opened) {
        WasiFs.drop(opened)
        return IOError { .msg = "`${path}`: is a directory", .kind = .IsADirectory }
    }
    return WasiFile { .descriptor = opened, .append = options.append }
}

// Whether `descriptor` is a directory.
is_directory :: fn(descriptor: WasiFs.Descriptor) -> bool {
    stat :: descriptor_stat(descriptor) else return false
    return entry_kind_of(stat.type) == .Directory
}

// What `descriptor` names, null when the host cannot say.
descriptor_stat :: fn(descriptor: WasiFs.Descriptor) -> WasiFs.DescriptorStat | null {
    stat :: WasiFs.stat(descriptor) else is WasiFs.ErrorCode {
        return null
    }
    return stat
}

@target(.Wasi)
system_read :: fn(handle: FileHandle, into: u8[], count: i64) -> i64 | IOError {
    file :: wasi_file_of(handle)
    if file.ended {
        return 0
    }
    read :: file.read else {
        [bytes, done] :: WasiFs.read_via_stream(file.descriptor, u64(file.position))
        started :: WasiRead { .bytes = bytes, .done = done }
        file.read = started
        started
    }
    chunk :: read.bytes.read(count, -1) else {
        file.read = null
        file.ended = true
        outcome :: read.done.wait() else is WasiFs.ErrorCode {
            return wasi_io_error(outcome, "a read")
        }
        return 0
    }
    for [b, i] in chunk.indexed() {
        into[i] = b
    }
    file.position += chunk.len()
    return chunk.len()
}

@target(.Wasi)
system_write :: fn(handle: FileHandle, bytes: u8[]) -> i64 | IOError {
    file :: wasi_file_of(handle)
    file.moved()
    done :: if file.append {
        WasiFs.append_via_stream(file.descriptor, bytes)
    } else {
        WasiFs.write_via_stream(file.descriptor, bytes, u64(file.position))
    }
    outcome :: done.wait() else is WasiFs.ErrorCode {
        return wasi_io_error(outcome, "a write")
    }
    file.position += bytes.len()
    return bytes.len()
}

@target(.Wasi)
system_seek :: fn(handle: FileHandle, offset: i64, from: SeekFrom) -> i64 | IOError {
    file :: wasi_file_of(handle)
    base: i64: match from {
        .Start   -> 0
        .Current -> file.position
        .End     -> system_size(handle)
    }
    position :: base + offset
    if base < 0 || position < 0 {
        return IOError { .msg = "seek failed", .kind = .InvalidInput }
    }
    file.moved()
    file.position = position
    return position
}

@target(.Wasi)
system_size :: fn(handle: FileHandle) -> i64 {
    stat :: descriptor_stat(wasi_file_of(handle).descriptor) else return -1
    return i64(stat.size)
}

@target(.Wasi)
system_close :: fn(handle: FileHandle) -> void | IOError {
    file :: wasi_file_of(handle)
    file.moved()
    WasiFs.drop(file.descriptor)
}

// The position of `file` moved, or its bytes changed under it: the read under
// way, which reads on from where it started, is dropped.
moved :: fn(file: WasiFile) -> void {
    read :: file.read
    if read != null {
        read.bytes.drop()
        read.done.drop()
    }
    file.read = null
    file.ended = false
}

// What `path` names, its links followed, null when it cannot be reached.
stat_of :: fn(path: string) -> WasiFs.DescriptorStat | null = stat_at(path, true) else null

// What `path` names, its links followed when `follow_links` says so.
stat_at :: fn(path: string, follow_links: bool) -> WasiFs.DescriptorStat | IOError {
    found :: resolve(path) else return found
    defer WasiFs.drop(found.0)
    flags :: WasiFs.PathFlags { .symlink_follow = follow_links }
    stat :: WasiFs.stat_at(found.0, flags, found.1) else is WasiFs.ErrorCode {
        return wasi_io_error(stat, path)
    }
    return stat
}

// The nanoseconds since the Unix epoch of `instant`, 0 for none.
nanoseconds_of :: fn(instant: WasiFs.Instant | null) -> i64 {
    if instant == null {
        return 0
    }
    return instant.seconds * 1_000_000_000 + i64(instant.nanoseconds)
}

@target(.Wasi)
exists :: fn(path: string) -> bool = stat_of(path) != null

@target(.Wasi)
is_dir :: fn(path: string) -> bool {
    stat :: stat_of(path) else return false
    return entry_kind_of(stat.type) == .Directory
}

@target(.Wasi)
modification_time :: fn(path: string) -> i64 | IOError {
    stat :: stat_at(path, true) else return stat
    return nanoseconds_of(stat.data_modification_timestamp)
}

@target(.Wasi)
system_metadata :: fn(path: string, follow_links: bool) -> Metadata | IOError {
    stat :: stat_at(path, follow_links) else return stat
    return Metadata {
        .kind = entry_kind_of(stat.type),
        .size = i64(stat.size),
        .modification_time = nanoseconds_of(stat.data_modification_timestamp),
        .read_only = false,
    }
}

@target(.Wasi)
system_set_read_only :: fn(path: string, read_only: bool) -> void | IOError =
    IOError { .msg = "`${path}`: WASI has no permissions to set" }

// A directory above a preopened one is there, though the program cannot reach
// it: `create_dir` passes it on the way to the one it creates.
@target(.Wasi)
mkdir_one :: fn(path: string) -> bool = mkdir_new(path) || is_dir(path) || holds_a_preopen(path)

// Whether `path` is a directory above a preopened one.
holds_a_preopen :: fn(path: string) -> bool {
    holds: bool = false
    for entry in WasiPreopens.get_directories() {
        WasiFs.drop(entry.0)
        prefix :: preopen_prefix(entry.1)
        if prefix != path && covers(path, prefix) {
            holds = true
        }
    }
    return holds
}

@target(.Wasi)
mkdir_new :: fn(path: string) -> bool {
    found :: resolve(path) else return false
    defer WasiFs.drop(found.0)
    return WasiFs.create_directory_at(found.0, found.1) !is WasiFs.ErrorCode
}

@target(.Wasi)
system_rename :: fn(from: string, to: string) -> void | IOError {
    source :: resolve(from) else return source
    defer WasiFs.drop(source.0)
    target :: resolve(to) else return target
    defer WasiFs.drop(target.0)
    renamed :: WasiFs.rename_at(source.0, source.1, target.0, target.1) else is WasiFs.ErrorCode {
        return wasi_io_error(renamed, from)
    }
}

@target(.Wasi)
system_copy :: fn(from: string, to: string) -> void | IOError = from.copy_content(to)

@target(.Wasi)
system_remove :: fn(path: string, options: RemoveOptions) -> void | IOError {
    stat :: stat_at(path, false) else return stat
    if entry_kind_of(stat.type) == .Directory {
        return path.remove_directory(options)
    }
    found :: resolve(path) else return found
    defer WasiFs.drop(found.0)
    removed :: WasiFs.unlink_file_at(found.0, found.1) else is WasiFs.ErrorCode {
        return wasi_io_error(removed, path)
    }
}

@target(.Wasi)
system_remove_directory :: fn(path: string) -> void | IOError {
    found :: resolve(path) else return found
    defer WasiFs.drop(found.0)
    removed :: WasiFs.remove_directory_at(found.0, found.1) else is WasiFs.ErrorCode {
        return wasi_io_error(removed, path)
    }
}

// The entries of the directory `path`, read from the stream `read-directory`
// opens, each with its kind; a link is reported as one.
@target(.Wasi)
list_dir :: fn(path: string) -> ListedEntry[] | IOError {
    opened :: open_under(path, WasiFs.OpenFlags { .directory = true }) else return opened
    defer WasiFs.drop(opened)
    [entries, done] :: WasiFs.read_directory(opened)
    out: ListedEntry[]: []
    for {
        chunk :: entries.read(64, -1) else break
        for e in chunk {
            out.push(ListedEntry { .name = e.name, .kind = entry_kind_of(e.type) })
        }
    }
    outcome :: done.wait() else is WasiFs.ErrorCode {
        return wasi_io_error(outcome, path)
    }
    return out
}

entry_kind_of :: fn(t: WasiFs.DescriptorType) -> EntryKind {
    if t is WasiFs.DescriptorTypeOther {
        return .Other
    }
    // @partial: a block or a character device, a pipe and a socket are `Other`.
    return @partial match t {
        .Directory    -> .Directory
        .RegularFile  -> .File
        .SymbolicLink -> .Symlink
        _             -> .Other
    }
}
