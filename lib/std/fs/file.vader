// std/fs/file: a file held open, read, written and sought in place.
//
// A `File` reads and writes straight through: it is a `Reader` and a `Writer`
// of `std/io` with one position, and a buffer is a `BufferedReader` or a
// `BufferedWriter` set on it. What it holds of the system is a descriptor on
// POSIX and a handle on Windows; only the `system_*` primitives at the end of
// this file name either.

module "std/fs"

import "std/io"
import "std/math"
import "std/target"
import "system/posix"
import "system/windows"

// ---- opening --------------------------------------------------------------

/// How `open` opens a file. Every field has a default, so a literal names only
/// what changes: `OpenOptions { .write = true, .create = true }`.
export OpenOptions :: struct {
    read:        bool = true
    /// Write from the position, which `seek` moves.
    write:       bool = false
    /// Write at the end of the file, wherever the position stands.
    append:      bool = false
    /// Create the file when it is missing. Needs `write` or `append`.
    create:      bool = false
    /// Empty the file when it exists. Needs `write`, and refuses `append`.
    truncate:    bool = false
    /// Create the file, and fail with `.AlreadyExists` when one is there. Needs
    /// `write` or `append`.
    create_new:  bool = false
}

/// Where `seek` counts an offset from.
export SeekFrom :: enum {
    Start
    Current
    End
}

/// A file `open` holds open: a `Reader` and a `Writer`. Reads, writes and `seek`
/// move one position through it, and each one asks the system. Under `append`,
/// a write lands at the end of the file wherever the position stands.
///
/// Read it by lines, or in small pieces, through a `BufferedReader`. The reader
/// reads ahead, so the position of the file is then past what the reader has
/// handed out: seek and write a file that nothing buffers.
///
/// Close it with `close`, most often by `defer`: a `File` dropped open keeps its
/// system handle until the process ends.
export File :: struct {
    @internal
    handle: Fd | Handle
    @internal
    closed: bool = false
}

/// Open the file at `path` as `options` say: for reading alone by default.
///
/// @param path     the file to open.
/// @param options  how: read, write, append, create.
/// @error          `IOError` when the file cannot be opened as asked:
///                 `.NotFound`, `.PermissionDenied`, `.AlreadyExists` under
///                 `create_new`, `.IsADirectory` for a directory, and
///                 `.InvalidInput` for options that contradict each other.
/// @example
///   # import "std/console"
///   # import "std/io"
///   f :: open("notes.txt")
///   if f is File {
///       defer f.close()
///       for line in BufferedReader { .source = f }.lines() {
///           println(line)
///       }
///   }
export open :: fn(path: string, options: OpenOptions = OpenOptions {}) -> File | IOError {
    refusal :: refusal_of(path, options)
    if refusal != null {
        return refusal
    }
    handle :: system_open(path, options)
    if handle is IOError {
        return handle
    }
    return File { .handle = handle }
}

/// Open the file at `path` for writing alone, created when it is missing and
/// emptied when it exists.
///
/// @param path  the file to create.
/// @error       `IOError` when the file cannot be created or emptied.
export create :: fn(path: string) -> File | IOError = open(path, OpenOptions {
    .read = false,
    .write = true,
    .create = true,
    .truncate = true,
})

// Why `path` and `options` open no file, null when they do.
refusal_of :: fn(path: string, options: OpenOptions) -> IOError | null {
    if path.has_nul() {
        return NUL_IN_PATH
    }
    writes :: options.write || options.append
    if !options.read && !writes {
        return invalid_options("neither read nor write")
    }
    if (options.create || options.create_new) && !writes {
        return invalid_options("create without write")
    }
    if options.truncate && !options.write {
        return invalid_options("truncate without write")
    }
    if options.truncate && options.append {
        return invalid_options("truncate with append")
    }
    return null
}

// Whether `path` holds a NUL byte, which ends it at the C boundary: the call
// would reach an entry the caller never named, so it is refused.
has_nul :: fn(path: string) = path.bytes().index_of(0) != null

NUL_IN_PATH :: IOError { .msg = "path contains a NUL byte", .kind = .InvalidInput }

invalid_options :: fn(why: string) = IOError {
    .msg = "invalid open options: ${why}",
    .kind = .InvalidInput,
}

// ---- reading, writing and seeking -----------------------------------------

File implements Reader {
    read :: fn(self, into: u8[]) -> i64 | null | IOError {
        if self.closed {
            return FILE_CLOSED
        }
        if into.len() == 0 {
            return 0
        }
        count :: system_read(self.handle, into, into.len())
        if count is IOError {
            return count
        }
        if count == 0 {
            return null
        }
        return count
    }
}

File implements Writer {
    write :: fn(self, content: u8[] | string) -> null | IOError {
        if self.closed {
            return FILE_CLOSED
        }
        bytes :: content.bytes_of()
        done: i64 = 0
        for done < bytes.len() {
            n :: system_write(self.handle, bytes[done..<bytes.len()])
            if n is IOError {
                return n
            }
            // A write the system took none of, without saying why, would
            // otherwise be asked again forever.
            if n == 0 {
                return IOError { .msg = "write failed: nothing written" }
            }
            done += n
        }
        return null
    }
}

/// Move the position to `offset` bytes from `from`.
///
/// @param offset  the distance, negative to go back.
/// @param from    `.Start`, `.Current` or `.End` of the file.
/// @return        the new position, from the start of the file.
/// @error         `IOError` when the position would be negative, `f` cannot be
///                sought (a pipe), or `f` is closed.
export seek :: fn(f: File, offset: i64, from: SeekFrom) -> i64 | IOError {
    if f.closed {
        return FILE_CLOSED
    }
    return system_seek(f.handle, offset, from)
}

/// The size of the file in bytes, every write included: a `File` writes straight
/// through, so nothing waits to be written.
///
/// @error  `IOError` when the file has no size (a pipe, a device), or `f` is
///         closed.
export size :: fn(f: File) -> i64 | IOError {
    if f.closed {
        return FILE_CLOSED
    }
    length :: system_size(f.handle)
    if length < 0 {
        return IOError { .msg = "no size: not a regular file", .kind = .InvalidInput }
    }
    return length
}

/// Close `f`: its system handle goes back, and every later read, write or seek
/// fails. A second `close` does nothing.
///
/// @error  `IOError` when the system reports a failure on closing, which some
///         file systems keep for a write that never reached the disk.
export close :: fn(f: File) -> null | IOError {
    if f.closed {
        return null
    }
    f.closed = true
    return system_close(f.handle)
}

// What a read, a write or a seek on a closed `File` answers.
FILE_CLOSED: IOError: IOError { .msg = "file is closed", .kind = .BadHandle }

// ---- system primitives ----------------------------------------------------

// Open `path` as `options` say, which `refusal_of` has checked: a
// descriptor on POSIX, a handle on Windows.
@target
system_open :: fn(path: string, options: OpenOptions) -> Fd | Handle | IOError

@target(.Linux, .Darwin)
system_open :: fn(path: string, options: OpenOptions) -> Fd | Handle | IOError {
    fd :: sys_open(path, open_flags(options), 0o666)
    if fd < 0 {
        return last_io_error("cannot open file")
    }
    // `open` takes a directory for reading alone, and its first read fails; a
    // write refuses it with `EISDIR` already.
    if access_mode(options) == O_RDONLY && sys_fd_kind(fd) == PATH_DIRECTORY {
        sys_close(fd)
        return is_a_directory(EISDIR)
    }
    return Fd(fd)
}

@target(.Windows)
system_open :: fn(path: string, options: OpenOptions) -> Fd | Handle | IOError {
    // Every share mode, so that a file open here can be read, written, renamed
    // or deleted elsewhere, as POSIX lets it be.
    h :: create_file_w(to_wide(path), desired_access(options),
                       FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, null,
                       disposition(options), FILE_ATTRIBUTE_NORMAL, null)
    if i64(h) == INVALID_HANDLE {
        return last_io_error("cannot open file").refine_directory_denial(path)
    }
    return h
}

// The refusal of a directory, with the platform's code for it.
is_a_directory :: fn(code: i32) = IOError {
    .msg = "is a directory",
    .kind = .IsADirectory,
    .code = code,
}

// `failure`, or the refusal of a directory when `path` names one: Windows
// refuses a directory as it refuses a forbidden file.
refine_directory_denial :: fn(failure: IOError, path: string) -> IOError {
    if failure.kind == .PermissionDenied && is_dir(path) {
        return is_a_directory(failure.code)
    }
    return failure
}

// The `open(2)` flags of `options`.
open_flags :: fn(options: OpenOptions) -> i32 {
    flags: i32 = O_CLOEXEC | access_mode(options)
    if options.append     { flags = flags | O_APPEND }
    if options.create     { flags = flags | O_CREAT }
    if options.truncate   { flags = flags | O_TRUNC }
    if options.create_new { flags = flags | O_CREAT | O_EXCL }
    return flags
}

// The `open(2)` access mode of `options`.
access_mode :: fn(options: OpenOptions) -> i32 {
    writes :: options.write || options.append
    if options.read && writes { return O_RDWR }
    if writes                 { return O_WRONLY }
    return O_RDONLY
}

// The `CreateFileW` access rights of `options`. A handle that may write only by
// appending lacks `FILE_WRITE_DATA`, and Windows then writes at the end.
desired_access :: fn(options: OpenOptions) -> u32 {
    access: u32 = 0
    if options.read {
        access = GENERIC_READ
    }
    if options.append {
        access = access | (FILE_GENERIC_WRITE & ~FILE_WRITE_DATA)
    } else if options.write {
        access = access | GENERIC_WRITE
    }
    return access
}

// The `CreateFileW` disposition of `options`.
disposition :: fn(options: OpenOptions) -> u32 {
    if options.create_new                 { return CREATE_NEW }
    if options.create && options.truncate { return CREATE_ALWAYS }
    if options.create                     { return OPEN_ALWAYS }
    if options.truncate                   { return TRUNCATE_EXISTING }
    return OPEN_EXISTING
}

// Read at most `count` bytes into `into`: how many, 0 at the end of the file.
@target
system_read :: fn(handle: Fd | Handle, into: u8[], count: i64) -> i64 | IOError

@target(.Linux, .Darwin)
system_read :: fn(handle: Fd | Handle, into: u8[], count: i64) -> i64 | IOError {
    for {
        n :: sys_read(fd_of(handle), into, count)
        if n >= 0 {
            return n
        }
        // A signal cut the read short before any byte came: ask again.
        if sys_last_errno() != EINTR {
            return last_io_error("read failed")
        }
    }
}

@target(.Windows)
system_read :: fn(handle: Fd | Handle, into: u8[], count: i64) -> i64 | IOError {
    got: u32[]: [0]
    if !read_file(handle_of(handle), into, u32(min(count, WHOLE_READ_MAX)), got, null) {
        // A pipe whose writer has closed ends this way, not with a read of 0.
        if get_last_error() == ERROR_BROKEN_PIPE {
            return 0
        }
        return last_io_error("read failed")
    }
    return i64(got[0])
}

// The size of the regular file `handle` is open on, -1 for anything else: a
// pipe or a device, whose size says nothing of what a read finds.
@target
system_size :: fn(handle: Fd | Handle) -> i64

@target(.Linux, .Darwin)
system_size :: fn(handle: Fd | Handle) -> i64 = sys_fd_size(fd_of(handle))

@target(.Windows)
system_size :: fn(handle: Fd | Handle) -> i64 {
    h :: handle_of(handle)
    size: i64[]: [-1]
    if get_file_type(h) != FILE_TYPE_DISK || !get_file_size_ex(h, size) {
        return -1
    }
    return size[0]
}

// Write what one system call takes of `bytes`: how many.
@target
system_write :: fn(handle: Fd | Handle, bytes: u8[]) -> i64 | IOError

@target(.Linux, .Darwin)
system_write :: fn(handle: Fd | Handle, bytes: u8[]) -> i64 | IOError {
    for {
        n :: sys_write(fd_of(handle), bytes, bytes.len())
        if n >= 0 {
            return n
        }
        // A signal cut the write short before any byte went: ask again.
        if sys_last_errno() != EINTR {
            return last_io_error("write failed")
        }
    }
}

@target(.Windows)
system_write :: fn(handle: Fd | Handle, bytes: u8[]) -> i64 | IOError {
    written: u32[]: [0]
    count :: u32(min(bytes.len(), WHOLE_READ_MAX))
    if !write_file(handle_of(handle), bytes, count, written, null) {
        return last_io_error("write failed")
    }
    return i64(written[0])
}

// Move the position `offset` bytes from `from`: the new one, from the start.
@target
system_seek :: fn(handle: Fd | Handle, offset: i64, from: SeekFrom) -> i64 | IOError

@target(.Linux, .Darwin)
system_seek :: fn(handle: Fd | Handle, offset: i64, from: SeekFrom) -> i64 | IOError {
    position :: sys_lseek(fd_of(handle), offset, whence_of(from))
    if position < 0 {
        return last_io_error("seek failed")
    }
    return position
}

@target(.Windows)
system_seek :: fn(handle: Fd | Handle, offset: i64, from: SeekFrom) -> i64 | IOError {
    // The distance goes in two halves, and the high one comes back in place.
    high: i32[]: [i32(offset >> 32)]
    low :: set_file_pointer(handle_of(handle), i32(offset), high, method_of(from))
    if low == INVALID_SET_FILE_POINTER && get_last_error() != 0 {
        return last_io_error("seek failed")
    }
    return (i64(high[0]) << 32) | i64(low)
}

whence_of :: fn(from: SeekFrom) -> i32 = match from {
    .Start   -> SEEK_SET
    .Current -> SEEK_CUR
    .End     -> SEEK_END
}

method_of :: fn(from: SeekFrom) -> u32 = match from {
    .Start   -> FILE_BEGIN
    .Current -> FILE_CURRENT
    .End     -> FILE_END
}

// Give the handle back to the system.
@target
system_close :: fn(handle: Fd | Handle) -> null | IOError

@target(.Linux, .Darwin)
system_close :: fn(handle: Fd | Handle) -> null | IOError {
    // Not asked again on `EINTR`: Linux has closed the descriptor by then, and
    // another thread may already have it.
    if sys_close(fd_of(handle)) != 0 {
        return last_io_error("close failed")
    }
    return null
}

@target(.Windows)
system_close :: fn(handle: Fd | Handle) -> null | IOError {
    if !close_handle(handle_of(handle)) {
        return last_io_error("close failed")
    }
    return null
}

// A `File` holds an `Fd` on POSIX and a `Handle` on Windows: the other member is
// a bug of this module, and stops the program.

fd_of :: fn(handle: Fd | Handle) -> i32 = @unreachable match handle {
    is Fd -> i32(handle)
}

handle_of :: fn(handle: Fd | Handle) -> Handle = @unreachable match handle {
    is Handle -> handle
}

// ---- tests ----------------------------------------------------------------

import "std/env"
import "std/iter"
import "std/string"
import "std/testing"

// A file of `content` in the temp directory, for one test.
probe_file :: fn(name: string, content: string) -> string {
    path :: "${temp_dir()}/vader_file_${name}"
    wrote :: write_file(path, content)
    assert(wrote !is IOError, "the probe was written")
    return path
}

// The number a call answered: -1 at the end of the file, -2 for a failure.
number_of :: fn(answer: i64 | null | IOError) -> i64 = match answer {
    is i64     -> answer
    is IOError -> -2
    is null    -> -1
}

// What `f` reads from its position to its end, `chunk` bytes at a time.
read_rest :: fn(f: File, chunk: i64) -> string {
    out: u8[]: []
    into: u8[]: [0] * chunk
    for {
        got :: f.read(into) ?? return out.bytes_to_string()
        if got is IOError {
            assert(false, "the read succeeds")
            return ""
        }
        out.push_all(into[0..<got])
    }
}

@test
test_open_a_missing_file_is_not_found :: fn() -> void {
    f :: open("${temp_dir()}/vader_file_absent")
    if f is IOError {
        assert_eq(f.kind, .NotFound)
    } else {
        assert(false, "a missing file does not open")
    }
}

@test
test_open_refuses_a_directory :: fn() -> void {
    f :: open(temp_dir())
    if f is IOError {
        assert_eq(f.kind, .IsADirectory)
    } else {
        assert(false, "a directory does not open as a file")
    }
}

@test
test_open_refuses_options_that_contradict_each_other :: fn() -> void {
    path :: probe_file("contradict", "x")
    defer remove(path)
    no_access :: open(path, OpenOptions { .read = false })
    assert(no_access is IOError && no_access.kind == .InvalidInput, "neither read nor write")
    no_write :: open(path, OpenOptions { .truncate = true })
    assert(no_write is IOError && no_write.kind == .InvalidInput, "truncate without write")
}

@test
test_create_then_read_back :: fn() -> void {
    path :: "${temp_dir()}/vader_file_round_trip"
    w :: create(path)
    if w is IOError {
        assert(false, "the file is created")
        return
    }
    defer remove(path)
    assert(w.write("hello, ") !is IOError, "the first write")
    assert(w.write("world") !is IOError, "the second write")
    assert(w.close() !is IOError, "the close")
    r :: open(path)
    if r is IOError {
        assert(false, "the file opens")
        return
    }
    defer r.close()
    assert_eq(read_rest(r, 3), "hello, world")
}

@test
test_read_takes_the_room_it_is_given :: fn() -> void {
    path :: probe_file("rooms", "abcdefghij")
    defer remove(path)
    for chunk in [1, 3, 4, 5, 100] {
        f :: open(path)
        if f is IOError {
            assert(false, "the file opens")
            return
        }
        assert_eq(read_rest(f, chunk), "abcdefghij")
        f.close()
    }
}

@test
test_read_gives_zero_to_an_empty_array_and_null_at_the_end :: fn() -> void {
    path :: probe_file("end", "ab")
    defer remove(path)
    f :: open(path)
    if f is IOError {
        assert(false, "the file opens")
        return
    }
    defer f.close()
    none: u8[]: []
    assert_eq(number_of(f.read(none)), 0)
    assert_eq(read_rest(f, 8), "ab")
    into: u8[]: [0] * 8
    assert(f.read(into) == null, "the end is null")
}

@test
test_seek_counts_from_the_position :: fn() -> void {
    path :: probe_file("seek", "0123456789")
    defer remove(path)
    f :: open(path)
    if f is IOError {
        assert(false, "the file opens")
        return
    }
    defer f.close()
    into: u8[]: [0] * 2
    assert_eq(number_of(f.read(into)), 2)
    assert_eq(into.bytes_to_string(), "01")
    assert_eq(number_of(f.seek(0, .Current)), 2)
    assert_eq(number_of(f.seek(3, .Current)), 5)
    assert_eq(read_rest(f, 10), "56789")
    assert_eq(number_of(f.seek(-3, .End)), 7)
    assert_eq(read_rest(f, 10), "789")
    assert_eq(number_of(f.seek(1, .Start)), 1)
    assert_eq(read_rest(f, 10), "123456789")
}

@test
test_a_write_after_a_read_lands_at_the_position :: fn() -> void {
    path :: probe_file("read_then_write", "0123456789")
    defer remove(path)
    f :: open(path, OpenOptions { .write = true })
    if f is IOError {
        assert(false, "the file opens")
        return
    }
    into: u8[]: [0] * 3
    f.read(into)
    assert(f.write("abc") !is IOError, "the write")
    f.close()
    back :: read_file_string(path)
    assert(back is string && back == "012abc6789", "written after the three bytes read")
}

@test
test_append_writes_at_the_end_wherever_the_position :: fn() -> void {
    path :: probe_file("append", "head")
    defer remove(path)
    f :: open(path, OpenOptions { .append = true })
    if f is IOError {
        assert(false, "the file opens")
        return
    }
    f.seek(0, .Start)
    assert(f.write("+tail") !is IOError, "the write")
    f.close()
    back :: read_file_string(path)
    assert(back is string && back == "head+tail", "appended")
}

@test
test_create_new_refuses_an_existing_file :: fn() -> void {
    path :: probe_file("create_new", "x")
    defer remove(path)
    f :: open(path, OpenOptions { .write = true, .create_new = true })
    if f is IOError {
        assert_eq(f.kind, .AlreadyExists)
    } else {
        assert(false, "an existing file is not created anew")
    }
}

@test
test_a_buffered_reader_reads_its_lines :: fn() -> void {
    text :: "one\r\ntwo\n\nlonger than the buffer\nlast\r"
    path :: probe_file("lines", text)
    defer remove(path)
    f :: open(path)
    if f is IOError {
        assert(false, "the file opens")
        return
    }
    defer f.close()
    reader :: BufferedReader { .source = f, .capacity = 4 }
    read: string[]: []
    for line in reader.lines() {
        read.push(line)
    }
    assert(reader.error !is IOError, "no read failed")
    assert(read.content_equals(text.lines().collect()), "the lines of the string")
}

@test
test_the_lines_of_a_closed_file_end_on_its_error :: fn() -> void {
    path :: probe_file("lines_closed", "a\nb\n")
    defer remove(path)
    f :: open(path)
    if f is IOError {
        assert(false, "the file opens")
        return
    }
    f.close()
    reader :: BufferedReader { .source = f }
    count: i64 = 0
    for line in reader.lines() {
        count += 1
    }
    assert_eq(count, 0)
    failure :: reader.error
    assert(failure is IOError && failure.kind == .BadHandle, "the loop says why")
}

@test
test_a_buffered_writer_reaches_the_file_at_its_flush :: fn() -> void {
    path :: "${temp_dir()}/vader_file_buffered_writer"
    f :: path.create()
    if f is IOError {
        assert(false, "the file is created")
        return
    }
    defer path.remove()
    writer :: BufferedWriter { .sink = f }
    writer.write("status: ")
    writer.write([50, 48, 48])
    assert_eq(number_of(f.size()), 0)
    assert(writer.flush() !is IOError, "the flush")
    f.close()
    back :: read_file_string(path)
    assert(back is string && back == "status: 200", "written at the flush")
}

@test
test_size_counts_every_write :: fn() -> void {
    path :: "${temp_dir()}/vader_file_size"
    f :: path.create()
    if f is IOError {
        assert(false, "the file is created")
        return
    }
    defer path.remove()
    assert_eq(number_of(f.size()), 0)
    f.write("abc")
    assert_eq(number_of(f.size()), 3)
    f.write([100, 101])
    assert_eq(number_of(f.size()), 5)
    f.close()
    after :: f.size()
    assert(after is IOError && after.kind == .BadHandle, "a closed file has no size")
}

@test
test_close_twice_and_read_after :: fn() -> void {
    path :: probe_file("close", "x")
    defer path.remove()
    f :: path.open()
    if f is IOError {
        assert(false, "the file opens")
        return
    }
    assert(f.close() !is IOError, "the first close")
    assert(f.close() !is IOError, "a second does nothing")
    into: u8[]: [0]
    after :: f.read(into)
    assert(after is IOError && after.kind == .BadHandle, "a read after close fails")
}
