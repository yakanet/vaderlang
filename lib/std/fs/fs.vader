// std/fs: files and directories.
//
// Synchronous: every call blocks the system thread, and every task with it.

module "std/fs"

import "std/io"
import "std/path"
import "std/target"
import "system/posix"
import "system/windows"

/// Read a file fully into a fresh owned byte array. Lossless for arbitrary
/// binary: the bytes are taken verbatim, no UTF-8 reinterpretation. This is
/// the canonical file-read primitive ; `read_file_string` decodes on top.
///
/// A regular file is read in one go, into an array of its size. Anything else
/// is read by chunks to its end or to `max_bytes`: a pipe or a device, a file
/// that grew, and one whose size passes `max_bytes`, a size being a claim the
/// content may not bear out.
///
/// @param path       filesystem path (absolute or cwd-relative).
/// @param max_bytes  the most bytes accepted, `READ_LIMIT_DEFAULT` by default:
///                   the read is refused once it passes them, which also stops
///                   a stream that never ends. Name your own when you know what
///                   you are reading, a larger file included.
/// @return           the file's raw bytes.
/// @error            `IOError` if the file can't be opened or read, or if it
///                   passes `max_bytes`: `"file too large"`.
export read_file_bytes :: fn(path: string, max_bytes: i64 = READ_LIMIT_DEFAULT) -> u8[] | IOError {
    f :: open(path)
    if f is IOError {
        return f
    }
    defer f.close()
    out: u8[] = []
    length :: system_size(f.handle)
    if reads_whole(length, max_bytes) {
        // Its size and one byte more, so that a read short of it shows the end.
        whole: u8[]: [0] * (length + 1)
        got :: read_into(f.handle, whole)
        if got is IOError {
            return got
        }
        if got <= length {
            return whole[0..<got]
        }
        // It grew past its size: the chunks read on.
        out = whole
    }
    chunk: u8[]: [0] * READ_CHUNK
    for {
        if out.len() > max_bytes {
            return IOError { .msg = "file too large" }
        }
        n :: system_read(f.handle, chunk, READ_CHUNK)
        if n is IOError {
            return n
        }
        if n == 0 {
            return out
        }
        out.push_all(chunk[0..<n])
    }
}

// Whether a file of `size` bytes is read in one go: a regular file (-1 is
// anything else), held to `max_bytes` (past it, the chunks refuse what the
// content bears out), that one `ReadFile` call can ask for.
reads_whole :: fn(size: i64, max_bytes: i64) =
    size >= 0 && size <= max_bytes && size < WHOLE_READ_MAX

// Fill `into` from `handle`, read after read: how many bytes came, fewer than
// `into.len()` once the file has ended.
read_into :: fn(handle: Fd | Handle, into: u8[]) -> i64 | IOError {
    got: i64 = 0
    for got < into.len() {
        n :: system_read(handle, into[got..<into.len()], into.len() - got)
        if n is IOError {
            return n
        }
        if n == 0 {
            return got
        }
        got += n
    }
    return got
}

// The largest file read whole: what one `ReadFile` call can ask for.
WHOLE_READ_MAX: i64: @max(u32)

// 64 KiB per chunk.
READ_CHUNK: i64 : 64 * 1024

/// A ceiling for a read whose caller has no figure of its own.
///
/// It is a policy number, not a fact about files, and it is bounded from BOTH
/// sides. It has to clear anything the toolchain legitimately reads: the
/// largest `.vader` source here is 161 KiB and the largest emitted seed unit
/// 2.3 MiB. And it has to stay under what the smallest backend can hold, or it
/// never fires: the interpreter carries a `u8` per slot, so 256 MiB of file
/// costs it about 2 GB and the GC traps before the refusal can be returned.
/// 16 MiB clears the first by ~100x and refuses cleanly on both backends.
///
/// Name your own when you know what you are reading.
export READ_LIMIT_DEFAULT: i64: 16 * 1024 * 1024

/// Write `content` to `path`, replacing any existing file: an array of bytes
/// as it stands, lossless for binary, and a string as its UTF-8 bytes.
///
/// @param path     filesystem path.
/// @param content  what the file holds afterwards.
/// @error          `IOError` if the file can't be opened or written.
export write_file :: fn(path: string, content: u8[] | string) -> null | IOError {
    f :: path.create()
    if f is IOError {
        return f
    }
    written :: f.write(content)
    // Closed either way, and its failure reported: some file systems keep for
    // `close` a write that never reached the disk.
    closed :: f.close()
    if written is IOError {
        return written
    }
    return closed
}

// Create one directory. True when it exists afterwards: an existing directory
// is success. The platforms report "already there" differently (`EEXIST` /
// `ERROR_ALREADY_EXISTS`) and neither says WHAT is there, so both re-ask rather
// than read the error code: a regular file in the way must stay a failure.
@target
mkdir_one :: fn(path: string) -> bool

@target(.Linux, .Darwin)
mkdir_one :: fn(path: string) -> bool = sys_mkdir(path, 0o777) == 0 || is_dir(path)

@target(.Windows)
mkdir_one :: fn(path: string) -> bool = create_directory(to_wide(path), null) || is_dir(path)

/// Create `path` and every missing parent, the way `mkdir -p` does.
///
/// An existing directory is success, not an error: the caller asked for it to
/// exist, and it does. Permissions follow the process umask.
///
/// @param path  directory to create, `/`-separated.
/// @return      `null` on success.
/// @error       `IOError` when a component cannot be created: a parent that is
///              a file, a read-only mount, a path over 4096 bytes.
export create_dir :: fn(path: string) -> null | IOError {
    if path.byte_len() == 0 {
        return IOError { .msg = "empty path" }
    }
    if path.byte_len() >= 4096 {
        return IOError { .msg = "path too long" }
    }
    // Each prefix in turn. From 1, so a leading `/` is a root and not a
    // component, and repeated separators are skipped.
    for i in 1..<path.byte_len() {
        if path.byte_at(i) != '/' {
            continue
        }
        if path.byte_at(i - 1) == '/' {
            continue
        }
        // `C:` is a root, not a component. `CreateDirectoryA("C:")` reports
        // ERROR_ALREADY_EXISTS, and the re-test then asks about "the current
        // directory ON DRIVE C:": a per-drive notion that need not exist when
        // the process works from another drive. A CI runner on `D:\a\...` with
        // a `C:` temp directory is exactly that shape. Not guarded off POSIX,
        // where a directory may legitimately be named `a:`.
        if VADER_OS == .Windows && i == 2 && path.byte_at(1) == ':' {
            continue
        }
        if !mkdir_one(path.byte_slice(0, i)) {
            return IOError { .msg = "cannot create parent" }
        }
    }
    if !mkdir_one(path) {
        return IOError { .msg = "cannot create directory" }
    }
    return null
}

/// Read a file fully into a UTF-8 string: a thin text decode over
/// `read_file_bytes`. Use `read_file_bytes` directly for binary data.
/// @param path       filesystem path (absolute or cwd-relative).
/// @param max_bytes  the most bytes accepted, `READ_LIMIT_DEFAULT` by default;
///                   see `read_file_bytes`.
/// @return           file contents as a UTF-8 string.
/// @error            `IOError` if the file can't be opened or read, or if it
///                   passes `max_bytes`.
export read_file_string :: fn(path: string, max_bytes: i64 = READ_LIMIT_DEFAULT) -> string | IOError {
    r :: read_file_bytes(path, max_bytes)
    if r is IOError { return r }
    return r.bytes_to_string()
}

/// True iff `path` resolves to an existing filesystem entry (file or
/// directory). Errors (e.g. permission denied) collapse to `false`.
/// @param path  filesystem path to probe.
/// @return      `true` if the entry exists, `false` otherwise (including
///              on access errors).
@target
export exists :: fn(path: string) -> bool

@target(.Linux, .Darwin)
exists :: fn(path: string) -> bool = sys_access(path, F_OK) == 0

// The attribute query, NOT an open. The Windows CRT refuses to open a directory
// as a file, so an `fopen`-shaped check reports every directory as missing,
// which silently empties module discovery: `walk_root`
// (vader/front/resolver/discover.vader) guards on `exists(dir)` and bails before
// indexing anything, and every compile on Windows then fails with R2001.
@target(.Windows)
exists :: fn(path: string) -> bool = get_file_attributes(to_wide(path)) != INVALID_FILE_ATTRIBUTES

/// True iff `path` exists AND is a directory. Errors collapse to `false`.
///
/// Read permission on the directory is NOT required: traverse rights on its
/// parent are enough, which is what `stat` asks for.
///
/// @param path  filesystem path to probe.
/// @return      `true` iff `path` names a directory.
@target
export is_dir :: fn(path: string) -> bool

// Through the runtime rather than a `struct stat` mirror, see
// `lib/system/posix/posix.vader::sys_path_kind` for why no mirror can express it.
@target(.Linux, .Darwin)
is_dir :: fn(path: string) -> bool = sys_path_kind(path) == PATH_DIRECTORY

@target(.Windows)
is_dir :: fn(path: string) -> bool {
    attrs :: get_file_attributes(to_wide(path))
    if attrs == INVALID_FILE_ATTRIBUTES {
        return false
    }
    return (attrs & FILE_ATTRIBUTE_DIRECTORY) != 0
}

/// When `path` was last modified, in nanoseconds since the Unix epoch : what a
/// cache compares to learn that a file changed without reading it.
///
/// @param path  filesystem path to probe.
/// @error       `IOError` when `path` cannot be probed : `NotFound` when it does
///              not exist.
@target
export modification_time :: fn(path: string) -> i64 | IOError

@target(.Linux, .Darwin)
modification_time :: fn(path: string) -> i64 | IOError {
    cells :: path.stat_cells(true)
    if cells is IOError {
        return cells
    }
    return cells[2]
}

@target(.Windows)
modification_time :: fn(path: string) -> i64 | IOError {
    data: u32[]: [0] * 9
    if !get_file_attributes_ex(to_wide(path), GET_FILE_EX_INFO_STANDARD, data) {
        return last_io_error("cannot probe file")
    }
    return nanoseconds_of_filetime(data[5], data[6])
}

// The nanoseconds since the Unix epoch of a `FILETIME`, given as its two halves.
nanoseconds_of_filetime :: fn(low: u32, high: u32) -> i64 {
    ticks :: i64(low) | (i64(high) << 32)
    return (ticks - FILETIME_UNIX_EPOCH_TICKS) * 100
}

// The 100 ns ticks a `FILETIME` counts from 1601-01-01 to the Unix epoch.
FILETIME_UNIX_EPOCH_TICKS: i64: 116_444_736_000_000_000

/// `path` as the filesystem resolves it: absolute, `/`-separated, every symbolic
/// link followed and every `.` and `..` gone. Two spellings of one file give one
/// answer (`/tmp` and `/private/tmp` under macOS), which a lexical normalization
/// (`std/path`) cannot promise.
///
/// @param path  an existing file or directory.
/// @error       `IOError` when `path` cannot be resolved: `NotFound` when it
///              does not exist.
@target
export real_path :: fn(path: string) -> string | IOError

@target(.Linux, .Darwin)
real_path :: fn(path: string) -> string | IOError {
    // `PATH_MAX` is 1024 on Darwin and 4096 on Linux.
    resolved: u8[]: [0] * 4096
    if sys_realpath(path, resolved) == null {
        return last_io_error("cannot resolve path")
    }
    return up_to_nul(resolved)
}

@target(.Windows)
real_path :: fn(path: string) -> string | IOError {
    // A handle that asks for no access, only to name the file.
    h :: create_file_w(to_wide(path), 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                       null, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, null)
    if i64(h) == INVALID_HANDLE {
        return last_io_error("cannot resolve path")
    }
    // Runs once a `return` has computed its value: `last_io_error` reads the
    // last-error slot before `CloseHandle` overwrites it.
    defer close_handle(h)
    // The longest path Windows names, in UTF-16 units, and its NUL.
    buf: u16[]: [0] * 32768
    n :: get_final_path_name_by_handle_w(h, buf, u32(buf.len()), VOLUME_NAME_DOS)
    if n == 0 {
        return last_io_error("cannot resolve path")
    }
    return without_verbatim_prefix(to_posix(from_wide(buf, i32(n))))
}

// A path `GetFinalPathNameByHandleW` wrote, `/`-separated, without its verbatim
// prefix: `//?/C:/x` is `C:/x`, `//?/UNC/host/share/x` is `//host/share/x`.
// `byte_slice` stops at the end of a shorter path.
without_verbatim_prefix :: fn(p: string) -> string {
    if p.byte_slice(0, 8) == "//?/UNC/" {
        return "//" + p.byte_slice(8, p.byte_len())
    }
    if p.byte_slice(0, 4) == "//?/" {
        return p.byte_slice(4, p.byte_len())
    }
    return p
}

/// List the immediate entries of `path` in OS-provided order. Excludes
/// `.` and `..`. Names are relative: join against `path` (e.g. via
/// `std/path`) for full paths.
/// @param path  the directory to list.
/// @return      entry names (no path prefix).
/// @error       `IOError` if `path` isn't a directory or can't be opened.
@target
export read_dir :: fn(path: string) -> string[] | IOError

@target(.Linux, .Darwin)
read_dir :: fn(path: string) -> string[] | IOError {
    d :: sys_opendir(path) ?? return IOError {
        .msg = "read_dir: cannot open `${path}`",
    }
    defer sys_closedir(d)
    out: string[]: []
    for {
        p :: sys_readdir(d) ?? break
        name :: dirent_name(p)
        if name != "." && name != ".." {
            out.push(name)
        }
    }
    return out
}

// What `read_dir` puts between `path` and `*`: nothing after a separator, after a
// drive's colon, or on the empty path.
glob_separator :: fn(path: string) -> string {
    n :: path.byte_len()
    if n == 0 {
        return ""
    }
    tail :: path.byte_at(n - 1)
    if tail == '\\' || tail == '/' || tail == ':' {
        return ""
    }
    return "\\"
}

@target(.Windows)
read_dir :: fn(path: string) -> string[] | IOError {
    // `FindFirstFileW` wants a GLOB, not a directory: the separator is added
    // only when the path does not already end in one, so `C:\` stays `C:\*`.
    // The last byte decides, read directly: a separator is ASCII, so a byte test
    // is exact.
    //
    // An EMPTY path takes no separator either. `\*` is the root of the current
    // DRIVE, while `*` is the current directory, and the host implementation
    // this replaces appended nothing to an empty path, so prefixing one would
    // silently start listing `C:\`. A bare `C:` is left alone for the same
    // reason: in Win32 it means "the current directory on C", not `C:\`.
    sep :: glob_separator(path)
    data: u8[]: [0] * FIND_DATA_BYTES
    h :: find_first_file(to_wide("${path}${sep}*"), data)
    if i64(h) == INVALID_HANDLE {
        return IOError { .msg = "read_dir: cannot open `${path}`" }
    }
    defer find_close(h)
    out: string[]: []
    for {
        name :: find_data_name(data)
        if name != "." && name != ".." {
            out.push(name)
        }
        if !find_next_file(h, data) {
            break
        }
    }
    return out
}

// ---- tests ----------------------------------------------------------------

import "std/env"
import "std/testing"

@test test_is_dir_separates_a_directory_from_a_file :: fn() -> void {
    file :: "${temp_dir()}/vader_is_dir_probe"
    wrote :: write_file(file, "x")
    assert(wrote !is IOError, "the probe was written")
    defer remove(file)

    assert(is_dir(temp_dir()), "the temp dir is a directory")
    assert(!is_dir(file), "a regular file is not")
    assert(exists(file), "and the probe is really there")
    assert(!is_dir("${temp_dir()}/vader_is_dir_absent"), "a missing path is not")
}

@test test_modification_time_of_a_file_and_of_a_missing_path :: fn() -> void {
    file :: "${temp_dir()}/vader_mtime_probe"
    wrote :: write_file(file, "x")
    assert(wrote !is IOError, "the probe was written")
    defer remove(file)

    written :: modification_time(file)
    assert(written is i64 && written > 0, "a file just written has a time after the epoch")
    missing :: modification_time("${temp_dir()}/vader_mtime_absent")
    if missing is IOError {
        assert_eq(missing.kind, .NotFound)
    } else {
        assert(false, "a missing path has no modification time")
    }
}

@test test_real_path_gives_two_spellings_of_a_file_one_answer :: fn() -> void {
    file :: "${temp_dir()}/vader_real_path_probe"
    wrote :: write_file(file, "x")
    assert(wrote !is IOError, "the probe was written")
    defer remove(file)

    direct :: real_path(file)
    temp_name :: to_path(temp_dir()).filename()
    detour :: real_path("${temp_dir()}/../${temp_name}/./vader_real_path_probe")
    if direct is IOError || detour is IOError {
        assert(false, "both spellings resolve")
    } else {
        assert_eq(detour, direct)
    }
}

@test test_real_path_resolves_a_directory :: fn() -> void {
    dir :: real_path(temp_dir())
    assert(dir is string && is_dir(dir), "the temp dir resolves to a directory")
}

@test test_real_path_of_a_missing_path :: fn() -> void {
    missing :: real_path("${temp_dir()}/vader_real_path_absent")
    if missing is IOError {
        assert_eq(missing.kind, .NotFound)
    } else {
        assert(false, "a missing path does not resolve")
    }
}

@test test_a_failed_read_carries_why :: fn() -> void {
    // A missing path is the one classification every platform agrees on:
    // POSIX `ENOENT`, Win32 `ERROR_FILE_NOT_FOUND`.
    missing :: read_file_bytes("${temp_dir()}/vader_no_such_probe", READ_LIMIT_DEFAULT)
    if missing is IOError {
        assert_eq(missing.kind, .NotFound)
        assert(missing.code != 0, "the raw platform code came through too")
    } else {
        assert(false, "reading a missing path must fail")
    }

    // A ceiling this library imposes is not a system failure, so it carries no
    // code and stays `.Other`.
    file :: "${temp_dir()}/vader_kind_probe"
    wrote :: write_file(file, "0123456789")
    assert(wrote !is IOError, "the probe was written")
    defer remove(file)

    too_big :: read_file_bytes(file, 4)
    if too_big is IOError {
        assert_eq(too_big.kind, .Other)
        assert_eq(too_big.code, 0)
    } else {
        assert(false, "a read past the ceiling must fail")
    }
}

@test test_read_file_bytes_honours_its_ceiling :: fn() -> void {
    file :: "${temp_dir()}/vader_read_limit_probe"
    wrote :: write_file(file, "0123456789")
    assert(wrote !is IOError, "the probe was written")
    defer remove(file)

    // The ceiling is inclusive.
    assert(read_file_bytes(file, 10) !is IOError, "exactly at the ceiling is fine")
    assert(read_file_bytes(file, 9) is IOError, "one byte past it is refused")
}

@test test_read_file_bytes_reads_a_file_past_one_chunk :: fn() -> void {
    file :: "${temp_dir()}/vader_read_whole_probe"
    content: u8[]: [7] * (READ_CHUNK + 10)
    content[content.len() - 1] = 9
    wrote :: write_file(file, content)
    assert(wrote !is IOError, "the probe was written")
    defer remove(file)

    back :: read_file_bytes(file)
    if back is IOError {
        assert(false, "a file past one chunk reads")
    } else {
        assert(back.content_equals(content), "every byte read back, the last one included")
    }
}

@test test_read_file_bytes_reads_a_file_of_exactly_one_chunk :: fn() -> void {
    file :: "${temp_dir()}/vader_read_one_chunk_probe"
    content: u8[]: [3] * READ_CHUNK
    wrote :: write_file(file, content)
    assert(wrote !is IOError, "the probe was written")
    defer remove(file)

    back :: read_file_bytes(file)
    if back is IOError {
        assert(false, "a file of one chunk reads")
    } else {
        assert_eq(back.len(), READ_CHUNK)
    }
}

@test test_read_file_bytes_holds_a_stream_to_its_ceiling :: fn() -> void {
    if VADER_OS == .Windows {
        return
    }
    // Past its first chunk, a device has no size: the chunks go on to the ceiling.
    endless :: read_file_bytes("/dev/zero", READ_CHUNK * 2)
    assert(endless is IOError, "an endless stream stops at its ceiling")
}

@test test_read_file_bytes_holds_a_file_read_whole_to_its_ceiling :: fn() -> void {
    file :: "${temp_dir()}/vader_read_whole_ceiling_probe"
    content: u8[]: [5] * (READ_CHUNK * 3)
    wrote :: write_file(file, content)
    assert(wrote !is IOError, "the probe was written")
    defer remove(file)

    assert(read_file_bytes(file, content.len()) !is IOError, "exactly at the ceiling is fine")
    assert(read_file_bytes(file, content.len() - 1) is IOError, "one byte past it is refused")
}

@test test_read_file_bytes_reads_the_null_device_empty :: fn() -> void {
    read :: read_file_bytes(null_device())
    if read is IOError {
        assert(false, "the null device reads")
    } else {
        assert_eq(read.len(), 0)
    }
}

// The device that reads empty, by platform.
null_device :: fn() -> string {
    if VADER_OS == .Windows {
        return "NUL"
    }
    return "/dev/null"
}
