// std/net/tcp: TCP sockets a task waits on.
//
// A `TcpListener` accepts connections, a `TcpStream` is one: a `Reader` and a
// `Writer` of `std/io`. An `accept` or a read with nothing to take parks the
// running task until the socket has something, and the other tasks run
// meanwhile: a server is one task per connection, written as if each call
// waited.
//
// Closing a socket ends the waits of the tasks parked on it: their call fails,
// the socket being closed.
//
// What a socket is to the system is a descriptor on macOS and Linux and a
// handle on Windows; only the `system_*` primitives at the end of this file
// name either.

module "std/net"

import "std/io"
import "std/math"
import "std/task"
import "system/posix"
import "system/windows"

// ---- what the system holds ------------------------------------------------

// What a socket call takes from the system and gives back to it. Nothing
// computes with it.
Socket :: Fd | SocketHandle

// ---- listening ------------------------------------------------------------

/// A socket that accepts the connections made to an address.
export TcpListener :: struct {
    @internal
    socket: Socket
    @internal
    closed: AtomicBool
}

/// Listen for connections to `address`.
///
/// The address may be one a connection closed a moment ago still holds, so a
/// server restarts at once.
///
/// @param address  where to listen; port 0 for a free port, which
///                 `local_address` then tells.
/// @param backlog  how many connections may wait for an `accept`.
/// @error          `IOError` when the address cannot be bound: taken by another
///                 listener, not one of this machine, or a port the program may
///                 not open.
/// @example
///   # import "std/console"
///   listener :: listen(loopback(8080))
///   if listener is IOError {
///       eprintln("cannot listen: ${listener}")
///   }
export listen :: fn(address: SocketAddress, backlog: i32 = 128) -> TcpListener | IOError {
    socket :: system_listen(address, backlog)
    if socket is IOError {
        return socket
    }
    return TcpListener { .socket = socket, .closed = AtomicBool {} }
}

/// Wait for the next connection to `listener`, the other tasks running
/// meanwhile.
///
/// @param listener  the listening socket.
/// @error           `IOError` when the listener is closed, or the system
///                  refuses: no descriptor left, say.
export accept :: fn(listener: TcpListener) -> TcpStream | IOError {
    if listener.closed.load() {
        return SOCKET_CLOSED
    }
    socket :: system_accept(listener.socket, listener.closed)
    if socket is IOError {
        return socket
    }
    return TcpStream { .socket = socket, .closed = AtomicBool {} }
}

/// The address `listener` listens on, with the port the system picked when it
/// was asked for port 0.
///
/// @param listener  the listening socket.
/// @error           `IOError` when the listener is closed.
export local_address :: fn(listener: TcpListener) -> SocketAddress | IOError {
    if listener.closed.load() {
        return SOCKET_CLOSED
    }
    return system_address(listener.socket, false)
}

/// Stop listening: the connections not accepted yet are refused, and every
/// later `accept` fails. A second `close` does nothing. The connections already
/// accepted go on.
///
/// @param listener  the listening socket.
/// @error           `IOError` when the system reports a failure on closing.
export close :: fn(listener: TcpListener) -> null | IOError {
    return close_once(listener.socket, listener.closed)
}

// ---- a connection ---------------------------------------------------------

/// One end of a TCP connection: a `Reader` of what the other end sends and a
/// `Writer` of what it receives.
export TcpStream :: struct {
    @internal
    socket: Socket
    @internal
    closed: AtomicBool
}

/// Connect to the listener at `address`.
///
/// @param address  where the other end listens.
/// @error          `IOError` when nothing listens there, or the machine cannot
///                 be reached.
/// @example
///   stream :: connect(loopback(8080))
///   if stream is TcpStream {
///       stream.write("hello\n")
///       stream.close()
///   }
export connect :: fn(address: SocketAddress) -> TcpStream | IOError {
    socket :: system_connect(address)
    if socket is IOError {
        return socket
    }
    return TcpStream { .socket = socket, .closed = AtomicBool {} }
}

TcpStream implements Reader {
    read :: fn(self, into: u8[]) -> i64 | null | IOError {
        if self.closed.load() {
            return SOCKET_CLOSED
        }
        if into.len() == 0 {
            return 0
        }
        return system_receive(self.socket, into, self.closed)
    }
}

TcpStream implements Writer {
    write :: fn(self, content: u8[] | string) -> null | IOError {
        if self.closed.load() {
            return SOCKET_CLOSED
        }
        return system_send(self.socket, content.bytes_of(), self.closed)
    }
}

/// The address of this end of `stream`.
///
/// @param stream  the connection.
/// @error         `IOError` when the stream is closed.
export local_address :: fn(stream: TcpStream) -> SocketAddress | IOError {
    if stream.closed.load() {
        return SOCKET_CLOSED
    }
    return system_address(stream.socket, false)
}

/// The address of the other end of `stream`.
///
/// @param stream  the connection.
/// @error         `IOError` when the stream is closed, or the connection is
///                gone.
export peer_address :: fn(stream: TcpStream) -> SocketAddress | IOError {
    if stream.closed.load() {
        return SOCKET_CLOSED
    }
    return system_address(stream.socket, true)
}

/// Say that this end sends nothing more: the other end reads to the end of the
/// stream, and may still answer, which `stream` goes on reading.
///
/// @param stream  the connection.
/// @error         `IOError` when the stream is closed, or the connection is
///                gone.
export close_write :: fn(stream: TcpStream) -> null | IOError {
    if stream.closed.load() {
        return SOCKET_CLOSED
    }
    return system_close_write(stream.socket)
}

/// Close `stream`: the other end reads to the end of the stream, and every
/// later read or write on `stream` fails. A second `close` does nothing.
///
/// @param stream  the connection.
/// @error         `IOError` when the system reports a failure on closing.
export close :: fn(stream: TcpStream) -> null | IOError {
    return close_once(stream.socket, stream.closed)
}

// Give `socket` back to the system unless `closed` says it went already.
close_once :: fn(socket: Socket, closed: AtomicBool) -> null | IOError {
    if closed.load() {
        return null
    }
    closed.store(true)
    return system_close(socket)
}

// What a call on a closed socket answers.
SOCKET_CLOSED: IOError: IOError { .msg = "socket is closed", .kind = .BadHandle }

// ---- system primitives ----------------------------------------------------

// A socket that listens on `address`, in the mode where a call with nothing to
// take fails instead of waiting.
@target
system_listen :: fn(address: SocketAddress, backlog: i32) -> Socket | IOError

@target(.Linux, .Darwin)
system_listen :: fn(address: SocketAddress, backlog: i32) -> Socket | IOError {
    fd :: sys_socket(family_of(address), SOCK_STREAM, 0)
    if fd < 0 {
        return last_io_error("cannot open a socket")
    }
    encoded :: sockaddr_of(address)
    if sys_setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, [1], 4) != 0
        || sys_bind(fd, encoded, u32(encoded.len())) != 0
        || sys_listen(fd, backlog) != 0
        || !set_non_blocking(fd) {
        return closing(fd, last_io_error("cannot listen on ${address}"))
    }
    return Fd(fd)
}

// Without `SO_REUSEADDR`: Windows already lets a server restart at once, and
// the option there lets two listeners take one address.
@target(.Windows)
system_listen :: fn(address: SocketAddress, backlog: i32) -> Socket | IOError {
    handle :: open_windows_socket(address)
    if handle is IOError {
        return handle
    }
    encoded :: sockaddr_of(address)
    if winsock_bind(handle, encoded, i32(encoded.len())) != 0
        || winsock_listen(handle, backlog) != 0 {
        return abandoning(handle, last_io_error("cannot listen on ${address}"))
    }
    return handle
}

// The next connection to the listener `socket`, parking until there is one or
// `closed` says the listener went.
@target
system_accept :: fn(socket: Socket, closed: AtomicBool) -> Socket | IOError

@target(.Linux, .Darwin)
system_accept :: fn(socket: Socket, closed: AtomicBool) -> Socket | IOError {
    fd :: fd_of(socket)
    for {
        accepted :: sys_accept(fd, null, null)
        if accepted >= 0 {
            if !set_non_blocking(accepted) {
                return closing(accepted, last_io_error("cannot accept"))
            }
            return Fd(accepted)
        }
        code :: sys_last_errno()
        if code == EAGAIN {
            if !park_readable(fd, closed) {
                return SOCKET_CLOSED
            }
        } else if code != EINTR {
            return last_io_error("cannot accept")
        }
    }
}

@target(.Windows)
system_accept :: fn(socket: Socket, closed: AtomicBool) -> Socket | IOError {
    listener :: handle_of(socket)
    for {
        accepted :: winsock_accept(listener, null, null)
        if accepted != INVALID_SOCKET {
            return followed(accepted)
        }
        code :: get_last_error()
        if code != WSAEWOULDBLOCK {
            return io_error_of(i32(code), "cannot accept")
        }
        wait_readable(listener)
        if closed.load() {
            return SOCKET_CLOSED
        }
    }
}

// A socket connected to `address`, in the mode `system_listen` describes,
// parking until the other end answers.
@target
system_connect :: fn(address: SocketAddress) -> Socket | IOError

@target(.Linux, .Darwin)
system_connect :: fn(address: SocketAddress) -> Socket | IOError {
    fd :: sys_socket(family_of(address), SOCK_STREAM, 0)
    if fd < 0 {
        return last_io_error("cannot open a socket")
    }
    if !set_non_blocking(fd) {
        return closing(fd, last_io_error("cannot connect to ${address}"))
    }
    encoded :: sockaddr_of(address)
    if sys_connect(fd, encoded, u32(encoded.len())) == 0 {
        return Fd(fd)
    }
    // A connection a signal interrupts goes on as one under way does.
    code :: sys_last_errno()
    if code != EINPROGRESS && code != EINTR {
        return closing(fd, io_error_of(code, "cannot connect to ${address}"))
    }
    wait_writable(Fd(fd))
    block_until(fd, POLLOUT)
    // Writable once the connection is made or has failed: the socket holds
    // which.
    failure: i32[]: [0]
    if sys_getsockopt(fd, SOL_SOCKET, SO_ERROR, failure, [4]) != 0 {
        return closing(fd, last_io_error("cannot connect to ${address}"))
    }
    if failure[0] != 0 {
        return closing(fd, io_error_of(failure[0], "cannot connect to ${address}"))
    }
    return Fd(fd)
}

@target(.Windows)
system_connect :: fn(address: SocketAddress) -> Socket | IOError {
    handle :: open_windows_socket(address)
    if handle is IOError {
        return handle
    }
    encoded :: sockaddr_of(address)
    if winsock_connect(handle, encoded, i32(encoded.len())) == 0 {
        return handle
    }
    code :: get_last_error()
    if code != WSAEWOULDBLOCK {
        return abandoning(handle, io_error_of(i32(code), "cannot connect to ${address}"))
    }
    // A wait ends for more than the end of the attempt: the socket tells
    // whether it is over, and how it went.
    happened: i32[]: [0] * NETWORK_EVENTS_CELLS
    for happened[0] & FD_CONNECT == 0 {
        wait_writable(handle)
        if wsa_enum_network_events(handle, null, happened) != 0 {
            return abandoning(handle, last_io_error("cannot connect to ${address}"))
        }
    }
    outcome :: happened[NETWORK_EVENTS_CONNECT_CODE]
    if outcome != 0 {
        return abandoning(handle, io_error_of(outcome, "cannot connect to ${address}"))
    }
    return handle
}

// Some bytes of the connection `socket` into `into`, parking until there are
// some or `closed` says the stream went; null at the end of the stream.
@target
system_receive :: fn(socket: Socket, into: u8[], closed: AtomicBool) -> i64 | null | IOError

@target(.Linux, .Darwin)
system_receive :: fn(socket: Socket, into: u8[], closed: AtomicBool) -> i64 | null | IOError {
    fd :: fd_of(socket)
    for {
        got :: sys_read(fd, into, into.len())
        if got > 0 {
            return got
        }
        if got == 0 {
            return null
        }
        code :: sys_last_errno()
        if code == EAGAIN {
            if !park_readable(fd, closed) {
                return SOCKET_CLOSED
            }
        } else if code != EINTR {
            return last_io_error("read failed")
        }
    }
}

@target(.Windows)
system_receive :: fn(socket: Socket, into: u8[], closed: AtomicBool) -> i64 | null | IOError {
    stream :: handle_of(socket)
    for {
        got :: winsock_receive(stream, into, winsock_length(into), 0)
        if got > 0 {
            return i64(got)
        }
        if got == 0 {
            return null
        }
        code :: get_last_error()
        if code != WSAEWOULDBLOCK {
            return io_error_of(i32(code), "read failed")
        }
        wait_readable(stream)
        if closed.load() {
            return SOCKET_CLOSED
        }
    }
}

// All of `bytes` to the connection `socket`, parking while the system has no
// room for them, until `closed` says the stream went.
@target
system_send :: fn(socket: Socket, bytes: u8[], closed: AtomicBool) -> null | IOError

@target(.Linux, .Darwin)
system_send :: fn(socket: Socket, bytes: u8[], closed: AtomicBool) -> null | IOError {
    fd :: fd_of(socket)
    done: i64 = 0
    for done < bytes.len() {
        rest :: bytes[done..<bytes.len()]
        sent :: sys_write(fd, rest, rest.len())
        if sent > 0 {
            done += sent
            continue
        }
        // A write the system took none of, without saying why, would otherwise
        // be asked again forever.
        if sent == 0 {
            return IOError { .msg = "write failed: nothing written" }
        }
        code :: sys_last_errno()
        if code == EAGAIN {
            if !park_writable(fd, closed) {
                return SOCKET_CLOSED
            }
        } else if code != EINTR {
            return last_io_error("write failed")
        }
    }
    return null
}

@target(.Windows)
system_send :: fn(socket: Socket, bytes: u8[], closed: AtomicBool) -> null | IOError {
    stream :: handle_of(socket)
    done: i64 = 0
    for done < bytes.len() {
        rest :: bytes[done..<bytes.len()]
        sent :: winsock_send(stream, rest, winsock_length(rest), 0)
        if sent > 0 {
            done += i64(sent)
            continue
        }
        // A send that took nothing and says no more would be asked again
        // forever.
        if sent == 0 {
            return IOError { .msg = "write failed: nothing written" }
        }
        code :: get_last_error()
        if code != WSAEWOULDBLOCK {
            return io_error_of(i32(code), "write failed")
        }
        wait_writable(stream)
        if closed.load() {
            return SOCKET_CLOSED
        }
    }
    return null
}

// The address of the other end of `socket` when `peer`, of this end otherwise.
@target
system_address :: fn(socket: Socket, peer: bool) -> SocketAddress | IOError

@target(.Linux, .Darwin)
system_address :: fn(socket: Socket, peer: bool) -> SocketAddress | IOError {
    encoded: u8[]: [0] * SOCKADDR_IN6_BYTES
    length: u32[]: [u32(SOCKADDR_IN6_BYTES)]
    read :: if peer {
        sys_getpeername(fd_of(socket), encoded, length)
    } else {
        sys_getsockname(fd_of(socket), encoded, length)
    }
    if read != 0 {
        return last_io_error("cannot read the address of the socket")
    }
    return address_of(encoded)
}

@target(.Windows)
system_address :: fn(socket: Socket, peer: bool) -> SocketAddress | IOError {
    handle :: handle_of(socket)
    encoded: u8[]: [0] * SOCKADDR_IN6_BYTES
    length: i32[]: [i32(SOCKADDR_IN6_BYTES)]
    read :: if peer {
        winsock_peer_name(handle, encoded, length)
    } else {
        winsock_local_name(handle, encoded, length)
    }
    if read != 0 {
        return last_io_error("cannot read the address of the socket")
    }
    return address_of(encoded)
}

@target
system_close_write :: fn(socket: Socket) -> null | IOError

@target(.Linux, .Darwin)
system_close_write :: fn(socket: Socket) -> null | IOError =
    failure_unless(sys_shutdown(fd_of(socket), SHUT_WR) == 0, "cannot end the sending side")

@target(.Windows)
system_close_write :: fn(socket: Socket) -> null | IOError = failure_unless(
    winsock_shutdown(handle_of(socket), SD_SEND) == 0,
    "cannot end the sending side",
)

@target
system_close :: fn(socket: Socket) -> null | IOError

// The tasks parked on the socket are woken first: the system hands the number
// of a closed descriptor out again. Not asked again on `EINTR`: Linux has closed
// the descriptor by then, and another socket may already have its number.
@target(.Linux, .Darwin)
system_close :: fn(socket: Socket) -> null | IOError {
    stop_waiting(socket_descriptor(socket))
    return failure_unless(sys_close(fd_of(socket)) == 0, "close failed")
}

// As on the other systems, the tasks parked on the socket are woken first;
// then the scheduler forgets it, the system handing its number out again.
@target(.Windows)
system_close :: fn(socket: Socket) -> null | IOError {
    handle :: handle_of(socket)
    stop_waiting(handle)
    forget_socket(i64(handle))
    return failure_unless(close_socket(handle) == 0, "close failed")
}

// A socket is an `Fd` on POSIX: the other member is a bug of this module, and
// stops the program.
fd_of :: fn(socket: Socket) -> i32 = @unreachable match socket {
    is Fd -> i32(socket)
}

// `error`, once the socket `fd` that met it is given back. The error is read
// before this body runs: closing would replace it.
closing :: fn(fd: i32, error: IOError) -> IOError {
    sys_close(fd)
    return error
}

// Whether `fd` is now in the mode where a call with nothing to take fails with
// `EAGAIN` instead of waiting.
set_non_blocking :: fn(fd: i32) -> bool {
    flags :: sys_fcntl(fd, F_GETFL, 0)
    return flags >= 0 && sys_fcntl(fd, F_SETFL, flags | O_NONBLOCK) == 0
}

// A socket as `std/io` waits on it.
socket_descriptor :: fn(socket: Socket) -> Descriptor = Fd(fd_of(socket))

// A socket is a `SocketHandle` on Windows, as it is an `Fd` on POSIX.
handle_of :: fn(socket: Socket) -> SocketHandle = @unreachable match socket {
    is SocketHandle -> socket
}

// Winsock 2.2, as `WSAStartup` takes it.
WINSOCK_VERSION: u16: 0x0202

// Whether this process may call Winsock, asked once.
@singleton
winsock_started :: fn() -> bool = wsa_startup(WINSOCK_VERSION, [0] * WSADATA_BYTES) == 0

// The events a socket is followed for: all that end a wait of this module.
SOCKET_EVENTS: i32: FD_READ | FD_WRITE | FD_ACCEPT | FD_CONNECT | FD_CLOSE

// A new socket for the family of `address`, in the mode `followed` describes.
open_windows_socket :: fn(address: SocketAddress) -> SocketHandle | IOError {
    if !winsock_started() {
        return IOError { .msg = "cannot start Winsock" }
    }
    handle :: winsock_socket(family_of(address), WINSOCK_SOCK_STREAM, 0)
    if handle == INVALID_SOCKET {
        return last_io_error("cannot open a socket")
    }
    return followed(handle)
}

// `handle`, once the scheduler follows it: the system signals each of
// `SOCKET_EVENTS`, which ends the waits of `std/io` on the socket, and a call
// with nothing to take fails from then on instead of waiting. The system says
// a kind of event again only once the call that takes it found nothing: a
// task waits after such a call, never before. On failure `handle` is given
// back.
followed :: fn(handle: SocketHandle) -> SocketHandle | IOError {
    event :: follow_socket(i64(handle))
    if event == null {
        close_socket(handle)
        return IOError { .msg = "cannot follow a socket" }
    }
    if wsa_event_select(handle, event, SOCKET_EVENTS) != 0 {
        return abandoning(handle, last_io_error("cannot follow a socket"))
    }
    return handle
}

// `error`, once the socket `handle` that met it is given back, as `closing`
// does.
abandoning :: fn(handle: SocketHandle, error: IOError) -> IOError {
    forget_socket(i64(handle))
    close_socket(handle)
    return error
}

// How many bytes of `bytes` one Winsock call is asked for: its lengths are 32
// bits wide.
WINSOCK_CHUNK: i64: 0x4000_0000

winsock_length :: fn(bytes: u8[]) -> i32 = i32(min(bytes.len(), WINSOCK_CHUNK))

// Park the running task until `fd` has something to read; false when `closed`
// says the socket went meanwhile, its number then naming nothing of this
// socket's.
park_readable :: fn(fd: i32, closed: AtomicBool) -> bool {
    wait_readable(Fd(fd))
    if closed.load() {
        return false
    }
    block_until(fd, POLLIN)
    return true
}

// Park the running task until `fd` takes a write; false as `park_readable`.
park_writable :: fn(fd: i32, closed: AtomicBool) -> bool {
    wait_writable(Fd(fd))
    if closed.load() {
        return false
    }
    block_until(fd, POLLOUT)
    return true
}

// Wait on the system thread until `fd` is as `events` say. A wait of `std/io`
// returns at once when no other task runs: the system waits then, here.
block_until :: fn(fd: i32, events: i16) -> void {
    watched :: Pollfd { .fd = fd, .events = events, .revents = 0 }
    sys_poll_one(watched, 1, -1)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "std/time"

// Send back what `stream` sends until it ends; the bytes sent back.
echo :: fn(stream: TcpStream) -> i64 {
    buffer: u8[]: [0] * 64
    total: i64 = 0
    for {
        got :: stream.read(buffer)
        if got !is i64 {
            break
        }
        stream.write(buffer[0..<got])
        total += got
    }
    stream.close()
    return total
}

// Serve `connections` connections of `listener`, each in a task; the bytes
// sent back in all.
serve :: fn(listener: TcpListener, connections: i64) -> i64 {
    serving: Task<i64>[]: []
    for serving.len() < connections {
        stream :: listener.accept()
        if stream is IOError {
            break
        }
        serving.push(launch(() -> echo(stream)))
    }
    total: i64 = 0
    for task in serving {
        sent :: task.join()
        if sent is i64 {
            total += sent
        }
    }
    return total
}

// A listener on a free port of the loopback address; null, the test having
// failed, when the system refuses.
loopback_listener :: fn() -> TcpListener | null {
    listener :: listen(loopback(0))
    if listener is IOError {
        assert(false, "cannot listen: ${listener.msg}")
        return null
    }
    return listener
}

// The address `listener` listens on; null, the test having failed, when the
// system does not tell.
bound_address :: fn(listener: TcpListener) -> SocketAddress | null {
    address :: listener.local_address()
    if address is IOError {
        assert(false, "no address: ${address.msg}")
        return null
    }
    return address
}

// A connection to `address`; null, the test having failed, when there is none.
connection_to :: fn(address: SocketAddress) -> TcpStream | null {
    stream :: connect(address)
    if stream is IOError {
        assert(false, "cannot connect: ${stream.msg}")
        return null
    }
    return stream
}

// What `server` counted, -1 for a task that was cancelled.
counted :: fn(server: Task<i64>) -> i64 {
    total :: server.join()
    if total is i64 {
        return total
    }
    return -1
}

// What the other end of `stream` answers to `message`, read to the end.
exchange :: fn(stream: TcpStream, message: string) -> string {
    stream.write(message)
    stream.close_write()
    reader :: BufferedReader { .source = stream }
    answer :: reader.read_to_end(1024)
    if answer is IOError {
        return "error: ${answer.msg}"
    }
    return bytes_to_string(answer)
}

@test
test_listener_binds_a_free_port :: fn() -> void {
    listener :: loopback_listener() ?? return
    address :: bound_address(listener) ?? return
    assert(address.port != 0, "the system picked a port")
    assert_eq(address.ip.to_string(), "127.0.0.1")
    listener.close()
}

@test
test_streams_carry_bytes_both_ways :: fn() -> void {
    listener :: loopback_listener() ?? return
    address :: bound_address(listener) ?? return
    server :: launch(() -> serve(listener, 1))
    stream :: connection_to(address) ?? return
    assert_eq(exchange(stream, "hello"), "hello")
    stream.close()
    assert_eq(counted(server), 5)
    listener.close()
}

@test
test_connections_are_served_at_the_same_time :: fn() -> void {
    listener :: loopback_listener() ?? return
    address :: bound_address(listener) ?? return
    server :: launch(() -> serve(listener, 2))
    first :: connection_to(address) ?? return
    second :: connection_to(address) ?? return
    // The second to connect is answered while the first has sent nothing.
    assert_eq(exchange(second, "second"), "second")
    assert_eq(exchange(first, "first"), "first")
    first.close()
    second.close()
    assert_eq(counted(server), 11)
    listener.close()
}

// Write `count` bytes on `stream`, then say nothing more comes.
send_bytes :: fn(stream: TcpStream, count: i64) -> void {
    payload: u8[]: ['x'] * count
    stream.write(payload)
    stream.close_write()
}

@test
test_a_write_larger_than_the_socket_holds_goes_through :: fn() -> void {
    listener :: loopback_listener() ?? return
    address :: bound_address(listener) ?? return
    server :: launch(() -> serve(listener, 1))
    stream :: connection_to(address) ?? return
    // More than the system keeps for a socket: the server has to read while
    // this end still writes, and this end to read while the server writes back.
    size: i64: 4 * 1024 * 1024
    sender :: launch(() -> send_bytes(stream, size))
    buffer: u8[]: [0] * 65536
    received: i64 = 0
    for {
        got :: stream.read(buffer)
        if got !is i64 {
            break
        }
        received += got
    }
    assert_eq(received, size)
    sender.join()
    stream.close()
    assert_eq(counted(server), size)
    listener.close()
}

@test
test_listen_fails_on_an_address_already_taken :: fn() -> void {
    listener :: loopback_listener() ?? return
    address :: bound_address(listener) ?? return
    second :: listen(address)
    if second is TcpListener {
        return assert(false, "two listeners on one address")
    }
    assert_eq(second.kind, .AddressInUse)
    listener.close()
}

@test
test_peer_address_is_the_listener_s :: fn() -> void {
    listener :: loopback_listener() ?? return
    address :: bound_address(listener) ?? return
    stream :: connection_to(address) ?? return
    peer :: stream.peer_address()
    if peer is IOError {
        return assert(false, "no peer: ${peer.msg}")
    }
    assert_eq(peer.to_string(), address.to_string())
    stream.close()
    listener.close()
}

@test
test_one_task_connects_accepts_and_reads :: fn() -> void {
    listener :: loopback_listener() ?? return
    address :: bound_address(listener) ?? return
    client :: connection_to(address) ?? return
    server :: listener.accept()
    if server is IOError {
        return assert(false, "no connection: ${server.msg}")
    }
    client.write("ping")
    buffer: u8[]: [0] * 16
    got :: server.read(buffer)
    if got !is i64 {
        return assert(false, "nothing read")
    }
    assert_eq(bytes_to_string(buffer[0..<got]), "ping")
    client.close()
    server.close()
    listener.close()
}

@test
test_connect_fails_where_nothing_listens :: fn() -> void {
    listener :: loopback_listener() ?? return
    address :: bound_address(listener) ?? return
    listener.close()
    refused :: connect(address)
    if refused is TcpStream {
        return assert(false, "nothing listens on a closed port")
    }
    assert_eq(refused.kind, .ConnectionRefused)
}

@test
test_a_closed_stream_refuses_reads_and_writes :: fn() -> void {
    listener :: loopback_listener() ?? return
    address :: bound_address(listener) ?? return
    stream :: connection_to(address) ?? return
    stream.close()
    assert(stream.write("late") is IOError, "a write after close")
    assert(stream.read([0] * 8) is IOError, "a read after close")
    assert(stream.close() == null, "a second close does nothing")
    listener.close()
}

// What a read of `stream` answers once something ends it.
read_outcome :: fn(stream: TcpStream) -> string {
    got :: stream.read([0] * 8)
    if got is IOError {
        return got.msg
    }
    if got == null {
        return "end of stream"
    }
    return "bytes"
}

@test
test_closing_a_stream_ends_the_read_parked_on_it :: fn() -> void {
    listener :: loopback_listener() ?? return
    address :: bound_address(listener) ?? return
    stream :: connection_to(address) ?? return
    // Nothing is ever sent: the read parks until the close.
    reading :: launch(() -> read_outcome(stream))
    sleep(5.millis())
    stream.close()
    outcome :: reading.join()
    if outcome is Cancelled {
        return assert(false, "the reader was cancelled")
    }
    assert_eq(outcome, "socket is closed")
    listener.close()
}

@test
test_closing_a_listener_ends_the_accept_parked_on_it :: fn() -> void {
    listener :: loopback_listener() ?? return
    accepting :: launch(() -> listener.accept() is IOError)
    sleep(5.millis())
    listener.close()
    refused :: accepting.join()
    assert(refused is bool && refused, "the accept failed once the listener closed")
}

@test
test_ipv6_loopback_carries_bytes :: fn() -> void {
    listener :: listen(loopback_v6(0))
    if listener is IOError {
        // A machine with no IPv6 has no `::1` to bind.
        return
    }
    address :: bound_address(listener) ?? return
    server :: launch(() -> serve(listener, 1))
    stream :: connection_to(address) ?? return
    assert_eq(exchange(stream, "six"), "six")
    stream.close()
    assert_eq(counted(server), 3)
    listener.close()
}
