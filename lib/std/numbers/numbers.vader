// std/numbers: number formatting helpers.
//
// Lives outside std/core so it can build its strings with std/string_builder.
// UFCS-callable as `n.to_hex()` once `import "std/numbers"` is in scope.

module "std/numbers"

import "std/string"
import "std/char"
import "std/string_builder"

/// True for an ASCII hex digit: `0`..`9`, `a`..`f`, `A`..`F`.
/// @param c  codepoint to classify.
/// @return   `true` iff `c` is a valid hex digit.
export is_hex_digit :: fn(c: char) -> bool =
    c.is_digit() || c in 'a'..='f' || c in 'A'..='F'

/// True when `c` is a valid digit in `base`. Supported bases : 2, 8, 10, 16.
/// Unsupported bases fall through to base-10.
/// @param c     codepoint to classify.
/// @param base  the numeric base ; 2, 8, 10, or 16.
export is_digit_in_base :: fn(c: char, base: i32) -> bool {
    if base == 2 { return c == '0' || c == '1' }
    if base == 8 { return c in '0'..='7' }
    if base == 16 { return c.is_hex_digit() }
    return c.is_digit()
}

/// 0..15 for an ASCII hex digit, null for anything else. Case-insensitive.
/// @param c  codepoint to decode.
/// @return   the digit's numeric value, or null if `c` isn't `0..9a..fA..F`.
export hex_digit_value :: fn(c: char) -> i32 | null = match c {
    '0'..='9' -> i32(u32(c) - '0')
    'a'..='f' -> i32(u32(c) - 'a' + 10)
    'A'..='F' -> i32(u32(c) - 'A' + 10)
    _         -> null
}

/// Parse `s` as an `i64` in the given base. `s` must be pure digits in
/// that base: no `0x`/`0b`/`0o` prefix, no `_` separators, no leading
/// sign. Empty input or any non-digit character yields an error.
/// @param s     the digits-only input.
/// @param base  one of 2 / 8 / 10 / 16.
/// @return      the parsed `i64`.
/// @error       `ParseError` on empty input, any out-of-base digit, or a value
///              past the greatest `i64` (carries `.msg = "overflow"`).
export parse_int_in_base :: fn(s: string, base: i32) -> i64 | ParseError {
    magnitude :: parse_uint_in_base(s, base) else return magnitude
    if magnitude > u64(@max(i64)) {
        return ParseError { .msg = "overflow" }
    }
    return i64(magnitude)
}

/// Parse an unsigned integer in the given base. Same input shape as
/// `parse_int_in_base` (digits only: caller strips prefix / underscores).
/// Carries the full u64 range so literals up to `u64.MAX` round-trip
/// without losing top bits. No sign accepted: the lexer wraps negative
/// literals in a `UnaryExpr.neg` over the unsigned magnitude.
/// @param s     the digits-only input.
/// @param base  one of 2 / 8 / 10 / 16.
/// @return      the parsed `u64`.
/// @error       `ParseError` on empty input, any out-of-base digit, or a
///              magnitude exceeding `u64.MAX` (carries `.msg = "overflow"`).
export parse_uint_in_base :: fn(s: string, base: i32) -> u64 | ParseError {
    if s.is_empty() {
        return ParseError { .msg = "empty input" }
    }
    acc: u64 = 0
    b: u64: u64(base)
    // Past `cutoff`, or at it with a digit past `last`, the multiply-add would
    // wrap past `u64.MAX`, which itself still reads.
    cutoff :: @max(u64) / b
    last :: @max(u64) % b
    for c in s {
        d :: hex_digit_value(c) else return ParseError { .msg = "invalid digit" }
        if d >= base {
            return ParseError { .msg = "invalid digit" }
        }
        if acc > cutoff || acc == cutoff && u64(d) > last {
            return ParseError { .msg = "overflow" }
        }
        acc = acc * b + u64(d)
    }
    return acc
}

/// One lowercase digit for a value below 36, `0` to `9` then `a` to `z`: the hex
/// digit of a nibble. Shared with `std/crypto`, which needs the lowercase form
/// (`shasum` / `openssl` convention).
///
/// @param n  a value below 36.
export hex_digit :: fn(n: u64) -> char {
    if n <= 9 {
        return char('0' + u32(n))
    }
    return char('a' + u32(n) - 10)
}

/// Hexadecimal stringification of a `u64`: lowercase, no `0x` prefix, no
/// leading zeros. `format` writes a prefix, capitals or a least number of digits.
///
/// @param self  the integer to render.
/// @example
///   (255).to_hex()   // "ff"
export to_hex :: fn(self: u64) -> string = digits_in_base(self, 16, false)

/// Octal stringification of a `u64`: no `0o` prefix, no leading zeros.
///
/// @param self  the integer to render.
/// @example
///   (8).to_oct()   // "10"
export to_oct :: fn(self: u64) -> string = digits_in_base(self, 8, false)

/// Binary stringification of a `u64`: no `0b` prefix, no leading zeros.
///
/// @param self  the integer to render.
/// @example
///   (5).to_bin()   // "101"
export to_bin :: fn(self: u64) -> string = digits_in_base(self, 2, false)

// The digits of `n` in `base`, 2 to 36, most significant first, with no leading zero.
digits_in_base :: fn(n: u64, base: u64, uppercase: bool) -> string {
    if n == 0 {
        return "0"
    }
    // Digits come least significant first, so they are read back from the end.
    reversed: char[]: []
    x := n
    for x > 0 {
        reversed.push(digit_char(x % base, uppercase))
        x = x / base
    }
    sb :: StringBuilder {}
    count :: reversed.len()
    for k in 0..<count {
        sb.append_char(reversed[count - 1 - k])
    }
    return sb.to_string()
}

// The digit of value `d`, below 36: `0` to `9`, then `a` to `z`, or `A` to `Z`.
digit_char :: fn(d: u64, uppercase: bool) -> char {
    if uppercase && d >= 10 {
        return char('A' + u32(d) - 10)
    }
    return hex_digit(d)
}

// 2^53 : every whole `f64` of smaller magnitude is an exact `i64`.
EXACT_INTEGER_LIMIT: f64: 9007199254740992.0

/// Format a float in the most compact decimal form: strips a trailing
/// `.0` from integer-valued floats so `10.0` becomes `"10"`. Otherwise
/// behaves like the default `Display` impl on `f64`. Matches
/// `JSON.stringify` semantics ; useful for snapshot-style output and any
/// wire format that prefers `42` over `42.0` for whole numbers.
///
/// @param self  the float to render.
/// @return      the compact decimal representation.
/// @example
///   (10.0).to_compact_string()    // "10"
///   (3.14).to_compact_string()    // "3.14"
///   (0.5).to_compact_string()     // "0.5"
///   (-0.0).to_compact_string()    // "0"
export to_compact_string :: fn(self: f64) -> string {
    // A whole number below 2^53 is exactly an `i64`, whose text is the float's
    // without the `.0`, and printing it as one skips the float formatter. The
    // range test runs first : it is false for NaN and ±inf, which `i64` cannot
    // hold. `-0.0` prints `0`, as `JSON.stringify` does.
    if self > -EXACT_INTEGER_LIMIT && self < EXACT_INTEGER_LIMIT && self == f64(i64(self)) {
        return "${i64(self)}"
    }
    return "${self}".trim_suffix(".0")
}

/// Render `self` with exactly `decimals` digits after the point, rounded half
/// away from zero on the digits `Display` shows. A value that rounds to zero
/// carries no sign; NaN and the infinities print as `"${self}"` does. Short
/// for `format` with `DecimalFormat { .decimals = decimals }`.
///
/// @param self      the float to render.
/// @param decimals  the digits after the point; 0, or a negative count, for
///                  none.
/// @return          the fixed-point text.
/// @example
///   (3.14159).to_fixed(2)   // "3.14"
///   (2.5).to_fixed(0)       // "3"
///   (1.005).to_fixed(2)     // "1.01"
///   (-0.04).to_fixed(1)     // "0.0"
export to_fixed :: fn(self: f64, decimals: i64) -> string =
    self.format(DecimalFormat { .decimals = decimals })

/// Strip the base prefix (`0x` / `0b` / `0o`) and every `_` digit separator
/// from a literal's source text. The result is a pure digit string ready for
/// `parse_int_in_base` / `parse_uint_in_base` / `parse_float`.
///
/// @param text    the original literal text (e.g. `"0xFF_FF"` / `"1_000"`).
/// @param base    the literal's base: 10 leaves the leading bytes
///                untouched, anything else strips the two-byte `0x` /
///                `0b` / `0o` prefix.
/// @return        the digit-only payload, suitable for the base-aware
///                numeric parsers in this module.
/// @example
///   strip_numeric_text("0xFF", 16)   // "FF"
///   strip_numeric_text("1_000", 10)  // "1000"
export strip_numeric_text :: fn(text: string, base: i32) -> string {
    start: i64: if base == 10 { 0 } else { 2 }
    body :: text.byte_slice(start, text.byte_len())
    // Fast path : no `_` to filter -> return the slice directly.
    if !body.contains("_") { return body }
    return body.replace_chars_where((c: char) -> c == '_', "")
}

// ---- tests ---------------------------------------------------------------

import "std/testing"

@test test_strip_numeric_text :: fn() -> void {
    assert_eq(strip_numeric_text("0xFF",    16),  "FF")
    assert_eq(strip_numeric_text("0xFF_FF", 16),  "FFFF")   // hex with digit separator
    assert_eq(strip_numeric_text("0b1010",  2),   "1010")
    assert_eq(strip_numeric_text("1_000",   10),  "1000")
    assert_eq(strip_numeric_text("3.14",    10),  "3.14")
    assert_eq(strip_numeric_text("42",      10),  "42")     // fast path
}

@test test_parse_int_in_base_reads_the_greatest_i64 :: fn() -> void {
    greatest :: parse_int_in_base("9223372036854775807", 10)
    assert(greatest is i64 && greatest == 0x7FFF_FFFF_FFFF_FFFF, "the greatest i64 reads")
}

@test test_parse_int_in_base_refuses_an_overflow :: fn() -> void {
    past :: parse_int_in_base("9223372036854775808", 10)
    assert(past is ParseError && past.msg == "overflow", "one past the greatest i64 is refused")
    long :: parse_int_in_base("FFFFFFFFFFFFFFFFF", 16)
    assert(long is ParseError && long.msg == "overflow", "17 hex digits are refused")
}

@test test_to_compact_str_whole_numbers :: fn() -> void {
    assert_eq((42.0).to_compact_string(), "42")
    assert_eq((-7.0).to_compact_string(), "-7")
    assert_eq((-0.0).to_compact_string(), "0")
    assert_eq((9007199254740991.0).to_compact_string(), "9007199254740991")
    assert_eq((9007199254740992.0).to_compact_string(), "9007199254740992")
    assert_eq((1e21).to_compact_string(), "1e+21")
}

@test test_to_compact_str_fractions :: fn() -> void {
    assert_eq((0.5).to_compact_string(), "0.5")
    assert_eq((-2.5e-7).to_compact_string(), "-2.5e-7")
    assert_eq((1.0 / 0.0).to_compact_string(), "${1.0 / 0.0}")
}

@test test_to_fixed_rounds_to_the_digits :: fn() -> void {
    assert_eq((3.14159).to_fixed(2), "3.14")
    assert_eq((2.5).to_fixed(0), "3")
    assert_eq((42.0).to_fixed(1), "42.0")
    assert_eq((0.004).to_fixed(2), "0.00")
    assert_eq((7.0).to_fixed(-1), "7")
}

@test test_to_fixed_signs :: fn() -> void {
    assert_eq((-1.25).to_fixed(1), "-1.3")
    assert_eq((-0.04).to_fixed(1), "0.0")
}

@test test_to_fixed_writes_large_values_in_full :: fn() -> void {
    assert_eq(1.0e16.to_fixed(2), "10000000000000000.00")
}

@test test_to_oct :: fn() -> void {
    assert_eq("${(8).to_oct()} ${(0).to_oct()} ${(511).to_oct()}", "10 0 777")
}
