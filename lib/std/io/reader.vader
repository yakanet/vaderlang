// std/io/reader: where bytes come from, and the buffer that reads ahead of them.
//
// `Reader` is the one method a source of bytes has: a file, a socket, an array
// in memory (memory.vader). `BufferedReader` sits on any of them and carries what
// reading a protocol or a text needs: a line, an exact count, up to a delimiter,
// a look ahead.
//
// A reader has one task at a time: every read moves a position.

module "std/io"

import "std/iter"
import "std/math"

// ---- the trait ------------------------------------------------------------

/// Where bytes come from.
///
/// An impl hands back nothing it keeps: an error it stores is copied before it
/// is returned.
export Reader :: trait {
    /// Read some bytes into `into`, from its start, waiting until at least one
    /// is there. Fewer than `into.len()` is not the end: only `null` is.
    ///
    /// @param into  the room to fill; a slice writes its parent.
    /// @return      how many bytes were written, never 0 unless `into` is
    ///              empty, and `null` once the source has ended.
    /// @error       `IOError` when the source cannot be read. The next call asks
    ///              it again.
    read :: fn(self, into: u8[]) -> i64 | null | IOError
}

// ---- the buffered reader --------------------------------------------------

/// The longest line `read_line` and `lines` take unless told otherwise, so a
/// source that never sends a line break cannot make them grow without end.
export LINE_LIMIT_DEFAULT: i64: 1024 * 1024

/// A reader that reads ahead of its caller, `capacity` bytes at a time.
///
/// What it has read ahead is gone from `source`: once a `BufferedReader` sits
/// on a source, read that source through it alone.
///
/// @example
///   # import "std/console"
///   reader :: BufferedReader { .source = BytesReader { .content = "one\ntwo\n" } }
///   for line in reader.lines() {
///       println(line)
///   }
export BufferedReader :: struct {
    /// What is read.
    source: Reader
    /// How many bytes one read of `source` asks for at most. Also the most
    /// `peek` can look ahead.
    capacity: i64 = 8192
    /// What ended a `lines` loop early, null while nothing did.
    error: IOError | null = null
    /// `buffer[next..<filled]` is read from `source` and not yet handed out.
    @internal
    buffer: u8[] = []
    @internal
    next: i64 = 0
    @internal
    filled: i64 = 0
}

BufferedReader implements Reader {
    read :: fn(self, into: u8[]) -> i64 | null | IOError {
        if into.len() == 0 {
            return 0
        }
        if self.next == self.filled {
            // The buffer would only add a copy.
            if into.len() >= self.capacity {
                return self.source.read(into)
            }
            got :: self.refill() ?? return null
            if got is IOError {
                return got
            }
        }
        count :: min(self.filled - self.next, into.len())
        self.buffer.copy_to(self.next, into, 0, count)
        self.next += count
        return count
    }
}

/// Read one line, without its line break: a `\n`, and the `\r` right before it.
/// The end of the source ends a last line that has no break.
///
/// @param max  the longest line taken, in bytes.
/// @return     the line, and `null` once the source has ended with nothing left.
/// @error      `IOError` when the source cannot be read, and `.InvalidInput`
///             for a line longer than `max`.
/// @example
///   reader :: BufferedReader { .source = BytesReader { .content = "a\r\nb" } }
///   reader.read_line()   // "a"
///   reader.read_line()   // "b"
///   reader.read_line()   // null
export read_line :: fn(
    r: BufferedReader,
    max: i64 = LINE_LIMIT_DEFAULT,
) -> string | null | IOError {
    line :: r.take_until('\n', max) ?? return null
    if line is IOError {
        return line
    }
    return line[0..<line.len() - carriage_return_at_end(line)].bytes_to_string()
}

// 1 when `line` ends with the `\r` of a `\r\n` break, else 0.
carriage_return_at_end :: fn(line: u8[]) -> i64 {
    count :: line.len()
    if count > 0 && line[count - 1] == '\r' {
        return 1
    }
    return 0
}

/// Lazily yield the lines `read_line` reads, to the end of the source.
///
/// A read that fails ends the loop as the end of the source would: `r.error`
/// then holds why.
///
/// @param max  the longest line taken, in bytes.
export lines :: fn(r: BufferedReader, max: i64 = LINE_LIMIT_DEFAULT) -> Iterator<string> {
    for {
        line :: r.read_line(max) ?? break
        if line is IOError {
            r.error = line
            return
        }
        yield line
    }
}

/// Read up to the next `delimiter`, which is taken from the source and left out
/// of the result. The end of the source ends a last run that has no delimiter.
///
/// @param delimiter  the byte that ends the run.
/// @param max        the longest run taken, in bytes.
/// @return           the bytes before `delimiter`, and `null` once the source
///                   has ended with nothing left.
/// @error            `IOError` when the source cannot be read, and
///                   `.InvalidInput` for a run longer than `max`.
export read_until :: fn(r: BufferedReader, delimiter: u8, max: i64) -> u8[] | null | IOError {
    run :: r.take_until(delimiter, max) ?? return null
    if run is IOError {
        return run
    }
    return run.clone()
}

// What `read_until` reads, as a slice of the buffer when the run sits in it
// whole: the next read of `r` writes over it, so the caller copies it first.
take_until :: fn(r: BufferedReader, delimiter: u8, max: i64) -> u8[] | null | IOError {
    run: u8[]: []
    for {
        if r.next == r.filled {
            got :: r.refill()
            if got is IOError {
                return got
            }
            if got == null {
                if run.len() == 0 {
                    return null
                }
                return run
            }
        }
        unread :: r.buffer[r.next..<r.filled]
        at :: unread.index_of(delimiter)
        taken :: at ?? unread.len()
        if run.len() + taken > max {
            return IOError {
                .msg = "more than ${max} bytes before the delimiter",
                .kind = .InvalidInput,
            }
        }
        if at != null {
            r.next += taken + 1
            if run.len() == 0 {
                return unread[0..<taken]
            }
            run.push_all(unread[0..<taken])
            return run
        }
        run.push_all(unread)
        r.next = r.filled
    }
}

/// Read exactly `count` bytes.
///
/// @param count  how many bytes to read.
/// @error        `IOError` when the source cannot be read, `.EndOfInput` when it
///               ends before `count` bytes, and `.InvalidInput` for a negative
///               `count`.
export read_exact :: fn(r: BufferedReader, count: i64) -> u8[] | IOError {
    if count < 0 {
        return IOError { .msg = "negative read size", .kind = .InvalidInput }
    }
    out: u8[]: [0] * count
    done: i64 = 0
    for done < count {
        got :: r.read(out[done..<count])
        if got is IOError {
            return got
        }
        if got == null {
            return IOError {
                .msg = "end of input after ${done} of ${count} bytes",
                .kind = .EndOfInput,
            }
        }
        done += got
    }
    return out
}

/// Read to the end of the source.
///
/// @param max  the most bytes taken.
/// @return     every byte left, empty when the source had already ended.
/// @error      `IOError` when the source cannot be read, and `.InvalidInput`
///             when more than `max` bytes are left.
export read_to_end :: fn(r: BufferedReader, max: i64) -> u8[] | IOError {
    out: u8[]: []
    for {
        if r.next == r.filled {
            got :: r.refill() ?? break
            if got is IOError {
                return got
            }
        }
        unread :: r.buffer[r.next..<r.filled]
        if out.len() + unread.len() > max {
            return IOError { .msg = "more than ${max} bytes to the end", .kind = .InvalidInput }
        }
        out.push_all(unread)
        r.next = r.filled
    }
    return out
}

/// Look at the next bytes without taking them: the next read hands them out
/// again.
///
/// @param count  how many bytes to look at, `r.capacity` at most.
/// @return       a copy of the next `count` bytes, fewer when the source ends
///               before that, and `null` once it has ended with nothing left.
/// @error        `IOError` when the source cannot be read, and `.InvalidInput`
///               for a `count` that is negative or above `r.capacity`.
export peek :: fn(r: BufferedReader, count: i64) -> u8[] | null | IOError {
    if count < 0 || count > r.capacity {
        return IOError {
            .msg = "cannot look ${count} bytes ahead with a buffer of ${r.capacity}",
            .kind = .InvalidInput,
        }
    }
    if r.filled - r.next < count {
        r.compact()
    }
    for r.filled - r.next < count {
        got :: r.source.read(r.buffer[r.filled..<r.capacity]) ?? break
        if got is IOError {
            return got
        }
        r.filled += got
    }
    unread :: r.filled - r.next
    if unread == 0 && count > 0 {
        return null
    }
    return r.buffer[r.next..<r.next + min(unread, count)].clone()
}

// Read ahead once the caller has taken all that was: the bytes `source` gave,
// null at its end.
refill :: fn(r: BufferedReader) -> i64 | null | IOError {
    r.reserve()
    got :: r.source.read(r.buffer) ?? return null
    if got is IOError {
        return got
    }
    r.next = 0
    r.filled = got
    return got
}

// Move what is unread to the start of the buffer, so the room after it is all
// there is.
compact :: fn(r: BufferedReader) -> void {
    r.reserve()
    unread :: r.filled - r.next
    r.buffer.copy_to(r.next, r.buffer, 0, unread)
    r.next = 0
    r.filled = unread
}

// The buffer takes its size at the first read that needs it.
reserve :: fn(r: BufferedReader) -> void {
    if r.buffer.len() == 0 {
        r.buffer = [0] * r.capacity
    }
}

// ---- tests ----------------------------------------------------------------

import "std/string"
import "std/testing"

// A reader over `text` that hands out `size` bytes at a time through a buffer
// of `capacity`: each test runs with the source whole, then cut everywhere.
cut :: fn(text: string, size: i64, capacity: i64) = BufferedReader {
    .source = FragmentedReader { .source = BytesReader { .content = text }, .size = size },
    .capacity = capacity,
}

// Every way of cutting a short source that a test is run under.
CUTS: i64[]: [1, 2, 3, 7, 64]

@test
test_read_line_takes_each_line_without_its_break :: fn() -> void {
    for size in CUTS {
        r :: cut("one\r\ntwo\n\nlast", size, 4)
        assert_eq(shown(r.read_line()), "one")
        assert_eq(shown(r.read_line()), "two")
        assert_eq(shown(r.read_line()), "")
        assert_eq(shown(r.read_line()), "last")
        assert(r.read_line() == null, "the end is null, cut by ${size}")
    }
}

@test
test_read_line_keeps_a_carriage_return_inside_the_line :: fn() -> void {
    r :: cut("a\rb\r\n", 1, 4)
    assert_eq(shown(r.read_line()), "a\rb")
}

@test
test_read_line_refuses_a_line_past_its_limit :: fn() -> void {
    r :: cut("abcdef\n", 2, 4)
    line :: r.read_line(5)
    assert(line is IOError && line.kind == .InvalidInput, "a line of 6 under a limit of 5")
    exact :: cut("abcde\n", 2, 4)
    assert_eq(shown(exact.read_line(5)), "abcde")
}

@test
test_lines_yields_to_the_end :: fn() -> void {
    for size in CUTS {
        r :: cut("a\nb\nc", size, 4)
        seen: string[]: []
        for line in r.lines() {
            seen.push(line)
        }
        assert_eq(seen.join(","), "a,b,c")
        assert(r.error == null, "no error at the end of the source")
    }
}

@test
test_lines_keeps_the_error_that_ended_them :: fn() -> void {
    r :: BufferedReader {
        .source = FailingReader {
            .source = FragmentedReader { .source = BytesReader { .content = "a\nb\n" }, .size = 2 },
            .calls = 1,
        },
    }
    seen: string[]: []
    for line in r.lines() {
        seen.push(line)
    }
    assert_eq(seen.join(","), "a")
    assert(r.error != null, "the failed read is kept")
}

@test
test_read_until_leaves_the_delimiter_out :: fn() -> void {
    for size in CUTS {
        r :: cut("name: value", size, 4)
        assert_eq(shown(r.read_until(':', 64)), "name")
        assert_eq(shown(r.read_until(':', 64)), " value")
        assert(r.read_until(':', 64) == null, "the end is null, cut by ${size}")
    }
}

@test
test_read_exact_reads_across_refills :: fn() -> void {
    for size in CUTS {
        r :: cut("0123456789", size, 4)
        assert_eq(shown(r.read_exact(3)), "012")
        assert_eq(shown(r.read_exact(6)), "345678")
        assert_eq(shown(r.read_exact(0)), "")
        short :: r.read_exact(2)
        assert(
            short is IOError && short.kind == .EndOfInput,
            "one byte left of two, cut by ${size}",
        )
    }
}

@test
test_read_to_end_takes_what_is_left :: fn() -> void {
    for size in CUTS {
        r :: cut("head\nbody of the text", size, 4)
        assert_eq(shown(r.read_line()), "head")
        assert_eq(shown(r.read_to_end(64)), "body of the text")
        assert_eq(shown(r.read_to_end(64)), "")
    }
}

@test
test_read_to_end_refuses_more_than_its_limit :: fn() -> void {
    r :: cut("0123456789", 3, 4)
    rest :: r.read_to_end(9)
    assert(rest is IOError && rest.kind == .InvalidInput, "ten bytes under a limit of nine")
}

@test
test_peek_takes_nothing :: fn() -> void {
    for size in CUTS {
        r :: cut("abcdef", size, 4)
        assert_eq(shown(r.read_exact(1)), "a")
        assert_eq(shown(r.peek(3)), "bcd")
        assert_eq(shown(r.peek(4)), "bcde")
        assert_eq(shown(r.read_exact(4)), "bcde")
        assert_eq(shown(r.peek(4)), "f")
        assert_eq(shown(r.read_exact(1)), "f")
        assert(r.peek(1) == null, "the end is null, cut by ${size}")
    }
}

@test
test_peek_refuses_more_than_the_buffer_holds :: fn() -> void {
    r :: cut("abcdef", 2, 4)
    ahead :: r.peek(5)
    assert(ahead is IOError && ahead.kind == .InvalidInput, "five bytes ahead in a buffer of four")
}

@test
test_read_into_an_empty_array_is_zero :: fn() -> void {
    r :: cut("abc", 2, 4)
    none: u8[]: []
    assert_eq(count_of(r.read(none)), 0)
    assert_eq(shown(r.read_exact(3)), "abc")
}

@test
test_read_writes_the_slice_it_is_given :: fn() -> void {
    r :: cut("abcd", 64, 2)
    into: u8[]: ['.'] * 6
    assert_eq(count_of(r.read(into[1..<5])), 4)
    assert_eq(shown(into), ".abcd.")
}
