// std/io: the vocabulary the I/O modules share.
//
// `IOError`, the failure every fallible call of `std/console`, `std/fs` and
// `std/env` returns, with its portable `IOErrorKind`, and the descriptors a task
// waits on.

module "std/io"

Wait :: import "std/runtime/wait"
import "std/time"
import "system/posix"
import "system/windows"

/// What went wrong, classified so a caller can branch on it without
/// transcribing platform numbers.
///
/// A raw `errno` is not portable (`EAGAIN` is 35 on Darwin and 11 on Linux)
/// and Windows has no `errno` at all, only `GetLastError` with its own
/// numbering. This is the shared vocabulary; `IOError.code` keeps the raw value
/// for the cases it does not cover.
@displayable
export IOErrorKind :: enum(u8) {
    /// The failure carried no code, or one this does not classify. Read `code`.
    Other
    NotFound
    PermissionDenied
    /// Interrupted by a signal: the caller may retry.
    Interrupted
    AlreadyExists
    NotADirectory
    IsADirectory
    /// The operation would block on a non-blocking handle.
    WouldBlock
    BrokenPipe
    NoSpace
    InvalidInput
    DirectoryNotEmpty
    BadHandle
    /// The input ended: nothing more will arrive on it.
    EndOfInput
    /// Nothing listens at the address a connection was asked to.
    ConnectionRefused
    /// The other end dropped the connection.
    ConnectionReset
    /// Another socket already listens on the address.
    AddressInUse
    /// The address is not one of this machine.
    AddressNotAvailable
    /// The socket has no connection.
    NotConnected
    /// The other end did not answer in time.
    TimedOut
}

/// Raised by every fallible I/O operation: the concrete error member of each
/// `T | IOError` return. Narrow with `is IOError` ; widen to `Error` for
/// a trait-typed slot.
export IOError :: struct {
    /// Short human-readable diagnostic ("file not found", "end of input", ...).
    msg: string
    /// Portable classification. `.Other` when the failure had no platform code
    /// (a ceiling this library imposes) or when the code is one `IOErrorKind`
    /// does not name.
    kind: IOErrorKind = .Other
    /// The raw platform value: `errno` on POSIX, `GetLastError` on Windows.
    /// Zero when the failure did not come from a system call. NOT portable:
    /// branch on `kind`, and read this only to report or to test something
    /// `kind` does not cover.
    code: i32 = 0
}

IOError implements Error -> self.msg

/// A short human-readable phrase for `kind`, `fallback` for `.Other`.
///
/// @param kind      the classification to describe.
/// @param fallback  the phrase of a failure `kind` does not classify.
/// @return          e.g. `"file not found"`.
describe_io_error_kind :: fn(kind: IOErrorKind, fallback: string) -> string = match kind {
    .NotFound          -> "file not found"
    .PermissionDenied  -> "permission denied"
    .Interrupted       -> "interrupted"
    .AlreadyExists     -> "already exists"
    .NotADirectory     -> "not a directory"
    .IsADirectory      -> "is a directory"
    .WouldBlock        -> "would block"
    .BrokenPipe        -> "broken pipe"
    .NoSpace           -> "no space left on device"
    .InvalidInput      -> "invalid argument"
    .DirectoryNotEmpty -> "directory not empty"
    .BadHandle         -> "bad file descriptor"
    .EndOfInput        -> "end of input"
    .ConnectionRefused -> "connection refused"
    .ConnectionReset   -> "connection reset"
    .AddressInUse      -> "address already in use"
    .AddressNotAvailable -> "address not available"
    .NotConnected      -> "not connected"
    .TimedOut          -> "timed out"
    .Other             -> fallback
}

/// The failure the LAST system call reported, wrapped as an `IOError`.
///
/// Call it immediately after the failing call. It reads the platform's
/// last-error slot (`errno` on POSIX, `GetLastError` on Windows) and any
/// intervening system call may have replaced it. In particular, do not close a
/// handle first: `fclose` and `CloseHandle` both overwrite it.
///
/// @param msg  fallback diagnostic, used only when the platform gave a code this
///             library does not classify. A recognised code names itself.
/// @return     the reason, its portable classification, and the raw code.
@target
export last_io_error :: fn(msg: string) -> IOError

@target(.Linux, .Darwin)
last_io_error :: fn(msg: string) -> IOError = io_error_of(sys_last_errno(), msg)

@target(.Windows)
last_io_error :: fn(msg: string) -> IOError = io_error_of(i32(get_last_error()), msg)

/// The failure the system names by `code`, wrapped as an `IOError`: for a code
/// read some other way than as the last error, a socket's pending one say.
///
/// @param code  the raw platform value: an `errno` on POSIX, a `GetLastError`
///              code on Windows.
/// @param msg   fallback diagnostic, as `last_io_error` takes it.
/// @return      the reason, its portable classification, and `code`.
@target
export io_error_of :: fn(code: i32, msg: string) -> IOError

@target(.Linux, .Darwin)
io_error_of :: fn(code: i32, msg: string) -> IOError =
    classified_error(msg, errno_kind(code), code)

@target(.Windows)
io_error_of :: fn(code: i32, msg: string) -> IOError =
    classified_error(msg, win32_error_kind(u32(code)), code)

/// Null when the system call whose outcome is `succeeded` worked, else the
/// error it left, as `last_io_error` reads it.
///
/// `succeeded` is computed before this body runs, so nothing reaches the system
/// between the call and the read of its error.
///
/// @param succeeded  whether the call worked: `sys_rmdir(path) == 0`.
/// @param msg        the fallback diagnostic of `last_io_error`.
/// @example
///   # import "system/posix"
///   removed :: failure_unless(sys_rmdir("build/empty") == 0, "cannot remove directory")
export failure_unless :: fn(succeeded: bool, msg: string) -> null | IOError {
    if succeeded {
        return null
    }
    return last_io_error(msg)
}

// The error of the platform code `code`, which `kind` classifies; `msg` names
// it when `kind` does not.
classified_error :: fn(msg: string, kind: IOErrorKind, code: i32) = IOError {
    .msg = describe_io_error_kind(kind, msg),
    .kind = kind,
    .code = code,
}

// The classification of the POSIX code `e`. An `if` chain, not a `match`: an arm
// takes a literal, never a named constant, and a code is a platform value.
errno_kind :: fn(e: i32) -> IOErrorKind {
    if e == ENOENT    { return .NotFound }
    if e == EPERM     { return .PermissionDenied }
    if e == EACCES    { return .PermissionDenied }
    if e == EINTR     { return .Interrupted }
    if e == EEXIST    { return .AlreadyExists }
    if e == ENOTDIR   { return .NotADirectory }
    if e == EISDIR    { return .IsADirectory }
    if e == EAGAIN    { return .WouldBlock }
    if e == EPIPE     { return .BrokenPipe }
    if e == ENOSPC    { return .NoSpace }
    if e == EINVAL    { return .InvalidInput }
    if e == ENOTEMPTY { return .DirectoryNotEmpty }
    if e == EBADF     { return .BadHandle }
    if e == ECONNREFUSED  { return .ConnectionRefused }
    if e == ECONNRESET    { return .ConnectionReset }
    if e == EADDRINUSE    { return .AddressInUse }
    if e == EADDRNOTAVAIL { return .AddressNotAvailable }
    if e == ENOTCONN      { return .NotConnected }
    if e == ETIMEDOUT     { return .TimedOut }
    return .Other
}

// The classification of the Win32 code `e`, an `if` chain as `errno_kind` is.
win32_error_kind :: fn(e: u32) -> IOErrorKind {
    if e == ERROR_FILE_NOT_FOUND { return .NotFound }
    if e == ERROR_PATH_NOT_FOUND { return .NotFound }
    if e == ERROR_ACCESS_DENIED  { return .PermissionDenied }
    if e == ERROR_INVALID_HANDLE { return .BadHandle }
    if e == ERROR_FILE_EXISTS    { return .AlreadyExists }
    if e == ERROR_ALREADY_EXISTS { return .AlreadyExists }
    if e == ERROR_BROKEN_PIPE    { return .BrokenPipe }
    if e == ERROR_NO_DATA        { return .BrokenPipe }
    if e == ERROR_DISK_FULL      { return .NoSpace }
    if e == ERROR_DIR_NOT_EMPTY  { return .DirectoryNotEmpty }
    if e == ERROR_DIRECTORY      { return .NotADirectory }
    if e == WSAEINTR             { return .Interrupted }
    if e == WSAEWOULDBLOCK       { return .WouldBlock }
    if e == WSAECONNREFUSED      { return .ConnectionRefused }
    if e == WSAECONNRESET        { return .ConnectionReset }
    if e == WSAECONNABORTED      { return .ConnectionReset }
    if e == WSAEADDRINUSE        { return .AddressInUse }
    if e == WSAEADDRNOTAVAIL     { return .AddressNotAvailable }
    if e == WSAENOTCONN          { return .NotConnected }
    if e == WSAETIMEDOUT         { return .TimedOut }
    return .Other
}

/// What a read takes from the system and gives back to it: a file descriptor
/// on POSIX; on Windows, stdin as descriptor 0, else the read end of a pipe.
/// Nothing computes with it: it converts to nothing, and compares with `==`.
export Descriptor :: Fd | PipeHandle

/// Standard input.
export STDIN: Descriptor: Fd(0)

/// Park the running task until `d` has input to read, or has reached its end,
/// while the other tasks run. With no other task, it returns at once, and the
/// read that follows waits on the system thread.
///
/// @param d  what to wait on; `STDIN` for standard input.
export wait_readable :: fn(d: Descriptor) -> void = Wait.wait_readable(descriptor_word(d))

/// Park the running task as `wait_readable` does, but no longer than `timeout`.
/// With no other task, it returns `true` at once, and the caller asks the
/// system itself.
///
/// @param d        what to wait on; `STDIN` for standard input.
/// @param timeout  the longest wait; a negative one waits with no deadline.
/// @return         `false` once `timeout` has passed with nothing to read on `d`.
export wait_readable_for :: fn(d: Descriptor, timeout: Duration) -> bool =
    Wait.wait_readable_for(descriptor_word(d), timeout.to_nanos())

/// Park the running task until `d` takes a write without blocking, or fails,
/// while the other tasks run. With no other task, it returns at once, and the
/// write that follows waits on the system thread.
///
/// @param d  what to wait on.
export wait_writable :: fn(d: Descriptor) -> void = Wait.wait_writable(descriptor_word(d))

/// Park the running task as `wait_writable` does, but no longer than `timeout`.
/// With no other task, it returns `true` at once, and the caller asks the
/// system itself.
///
/// @param d        what to wait on.
/// @param timeout  the longest wait; a negative one waits with no deadline.
/// @return         `false` once `timeout` has passed with no room on `d`.
export wait_writable_for :: fn(d: Descriptor, timeout: Duration) -> bool =
    Wait.wait_writable_for(descriptor_word(d), timeout.to_nanos())

/// End the waits of the tasks parked on `d`, each returning as if `d` were
/// ready. Call it before closing `d`: the system hands its number out again,
/// and a task still parked would then wait on whatever takes it.
///
/// @param d  what is about to be closed.
export stop_waiting :: fn(d: Descriptor) -> void = Wait.stop_waiting(descriptor_word(d))

// The machine word a wait names `d` by: the descriptor, or the address of the
// handle.
descriptor_word :: fn(d: Descriptor) -> i64 = match d {
    is Fd         -> i64(d)
    is PipeHandle -> i64(d)
}
