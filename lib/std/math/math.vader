// std/math: basic numeric operations and constants.

module "std/math"

import "std/ffi"

/// π (3.141592653589793).
export PI :: 3.141592653589793
/// Euler's number, e (2.718281828459045).
export E :: 2.718281828459045

// ---- Float operations -----------------------------------------------------

/// The C math library, declared by `<math.h>`. No library to open: every
/// binary links libm, so the process has it.
LIBM :: CLibrary { .name = "", .headers = ["<math.h>"] }

/// Square root.
/// @param x  non-negative finite input.
/// @return   `sqrt(x)`. `NaN` when `x < 0`.
@extern(LIBM, "sqrt")
export sqrt :: fn(x: f64) -> f64

/// Length of the hypotenuse, `sqrt(x * x + y * y)`, without the overflow or
/// the underflow of the squares.
/// @param x  one side.
/// @param y  the other side.
@extern(LIBM, "hypot")
export hypot :: fn(x: f64, y: f64) -> f64

/// Power: `x^n`. Both base and exponent are floats ; for integer exponents
/// the caller is expected to cast.
/// @param x  base.
/// @param n  exponent.
/// @return   `x` raised to the `n`-th power.
@extern(LIBM, "pow")
export pow :: fn(x: f64, n: f64) -> f64

/// Largest integer `n` such that `n <= x`. `floor(-1.2)` → `-2.0`.
@extern(LIBM, "floor")
export floor :: fn(x: f64) -> f64
/// Smallest integer `n` such that `n >= x`. `ceil(-1.2)` → `-1.0`.
@extern(LIBM, "ceil")
export ceil :: fn(x: f64) -> f64
/// Round to the nearest integer, ties away from zero. `round(0.5)` → `1.0`.
@extern(LIBM, "round")
export round :: fn(x: f64) -> f64
/// The integer part of `x`, rounded toward zero: `trunc(-1.7)` is `-1.0`.
@extern(LIBM, "trunc")
export trunc :: fn(x: f64) -> f64

// ---- Exponentials and logarithms ------------------------------------------

/// `e` raised to the power `x`.
@extern(LIBM, "exp")
export exp :: fn(x: f64) -> f64
/// Natural logarithm of `x`: `NaN` when `x < 0`, `-inf` when `x` is zero.
@extern(LIBM, "log")
export log :: fn(x: f64) -> f64
/// Base-2 logarithm of `x`: `NaN` when `x < 0`, `-inf` when `x` is zero.
@extern(LIBM, "log2")
export log2 :: fn(x: f64) -> f64
/// Base-10 logarithm of `x`: `NaN` when `x < 0`, `-inf` when `x` is zero.
@extern(LIBM, "log10")
export log10 :: fn(x: f64) -> f64

// ---- Trigonometry ---------------------------------------------------------

/// Sine of `x` in radians.
@extern(LIBM, "sin")
export sin :: fn(x: f64) -> f64
/// Cosine of `x` in radians.
@extern(LIBM, "cos")
export cos :: fn(x: f64) -> f64
/// Tangent of `x` in radians.
@extern(LIBM, "tan")
export tan :: fn(x: f64) -> f64
/// Arc sine of `x`, in radians in `[-PI/2, PI/2]`: `NaN` outside `[-1, 1]`.
@extern(LIBM, "asin")
export asin :: fn(x: f64) -> f64
/// Arc cosine of `x`, in radians in `[0, PI]`: `NaN` outside `[-1, 1]`.
@extern(LIBM, "acos")
export acos :: fn(x: f64) -> f64
/// Arc tangent of `x`, in radians in `[-PI/2, PI/2]`.
@extern(LIBM, "atan")
export atan :: fn(x: f64) -> f64
/// Angle of the point `(x, y)` from the positive x axis, in radians in
/// `[-PI, PI]`: the arc tangent of `y / x`, in the quadrant of the point.
/// @param y  the ordinate, the first argument as in C.
/// @param x  the abscissa.
@extern(LIBM, "atan2")
export atan2 :: fn(y: f64, x: f64) -> f64

// ---- Float classification -------------------------------------------------
//
// Infinity is read from the bits: a float without its sign has the bits of
// infinity when it is infinite, fewer when it is finite.

F64_MAGNITUDE: u64: 0x7FFF_FFFF_FFFF_FFFF
F64_INFINITY: u64: 0x7FF0_0000_0000_0000
F32_MAGNITUDE: u32: 0x7FFF_FFFF
F32_INFINITY: u32: 0x7F80_0000

/// Whether `x` is a NaN, the one value not equal to itself.
export is_nan :: fn(x: f64) -> bool = x != x
/// Whether `x` is a NaN, the one value not equal to itself.
export is_nan :: fn(x: f32) -> bool = x != x

/// Whether `x` is `inf` or `-inf`.
export is_infinite :: fn(x: f64) -> bool = x.to_bits() & F64_MAGNITUDE == F64_INFINITY
/// Whether `x` is `inf` or `-inf`.
export is_infinite :: fn(x: f32) -> bool = x.to_bits() & F32_MAGNITUDE == F32_INFINITY

/// Whether `x` is neither infinite nor a NaN.
export is_finite :: fn(x: f64) -> bool = x.to_bits() & F64_MAGNITUDE < F64_INFINITY
/// Whether `x` is neither infinite nor a NaN.
export is_finite :: fn(x: f32) -> bool = x.to_bits() & F32_MAGNITUDE < F32_INFINITY

// ---- Comparison + helpers -------------------------------------------------
//
// A float is not `Comparable`, a NaN being unordered: `min`, `max` and `clamp`
// add `f32` and `f64` overloads to their generic form.

/// Smaller of `a` and `b`, `b` on a tie.
///
/// Both share one type: a free literal takes the other's (`min(n, 10)`), and a
/// narrower integer is converted by the caller (`min(i64(small), n)`).
export min :: fn<T: Comparable>(a: T, b: T) -> T = if a < b { a } else { b }
/// Smaller of two `f64`s, NaN when either is.
export min :: fn(a: f64, b: f64) -> f64 = if a < b || is_nan(a) { a } else { b }
/// Smaller of two `f32`s, NaN when either is.
export min :: fn(a: f32, b: f32) -> f32 = if a < b || is_nan(a) { a } else { b }

/// Larger of `a` and `b`, `b` on a tie. Both share one type, as for `min`.
export max :: fn<T: Comparable>(a: T, b: T) -> T = if a > b { a } else { b }
/// Larger of two `f64`s, NaN when either is.
export max :: fn(a: f64, b: f64) -> f64 = if a > b || is_nan(a) { a } else { b }
/// Larger of two `f32`s, NaN when either is.
export max :: fn(a: f32, b: f32) -> f32 = if a > b || is_nan(a) { a } else { b }

/// Absolute value of an `f64`. Preserves the sign of zero (`abs(-0.0)` →
/// `-0.0`): caller normalises if needed.
export abs :: fn(x: f64) -> f64 = if x < 0.0 { -x } else { x }
/// Absolute value of an `i32`. `abs(i32::MIN)` overflows (panics in debug,
/// wraps in release).
export abs :: fn(x: i32) -> i32 = if x < 0 { -x } else { x }
/// Absolute value of an `i64`. Same overflow caveat at `i64::MIN`.
export abs :: fn(x: i64) -> i64 = if x < 0 { -x } else { x }

/// Sign of `x`: `1.0` when positive, `-1.0` when negative, `x` itself
/// otherwise, so a zero keeps its sign and a NaN stays a NaN.
export sign :: fn(x: f64) -> f64 {
    if x > 0.0 {
        return 1.0
    }
    if x < 0.0 {
        return -1.0
    }
    return x
}
/// Sign of `x`: `1`, `-1` or `0`.
export sign :: fn(x: i32) -> i32 = i32(sign(i64(x)))
/// Sign of `x`: `1`, `-1` or `0`.
export sign :: fn(x: i64) -> i64 {
    if x > 0 {
        return 1
    }
    if x < 0 {
        return -1
    }
    return 0
}

/// Clamp `x` to `[lo, hi]`: `min(max(x, lo), hi)`, so `hi` when `lo > hi`.
///
/// @param hi  the upper bound, which wins over `lo` when they cross.
export clamp :: fn<T: Comparable>(x: T, lo: T, hi: T) -> T = min(max(x, lo), hi)
/// Clamp an `f64` to `[lo, hi]`, NaN when any of the three is.
///
/// @param hi  the upper bound, which wins over `lo` when they cross.
export clamp :: fn(x: f64, lo: f64, hi: f64) -> f64 = min(max(x, lo), hi)
/// Clamp an `f32` to `[lo, hi]`, NaN when any of the three is.
///
/// @param hi  the upper bound, which wins over `lo` when they cross.
export clamp :: fn(x: f32, lo: f32, hi: f32) -> f32 = min(max(x, lo), hi)

/// Linear interpolation between `a` (`t = 0`) and `b` (`t = 1`). `t` is
/// clamped to `[0, 1]` so callers don't accidentally extrapolate.
/// @param a  the value at `t = 0`.
/// @param b  the value at `t = 1`.
/// @param t  blend factor, clamped to `[0, 1]`.
/// @return   `a + (b - a) * clamp(t, 0, 1)`.
export lerp :: fn(a: f64, b: f64, t: f64) -> f64 = a + (b - a) * clamp(t, 0.0, 1.0)

// ---- Integer arithmetic ---------------------------------------------------
//
// In `i32` and `i64`: a narrower integer widens into one of them with no loss.
// A result the type does not hold stops the program as `*` or `-` would.

/// Greatest common divisor of `a` and `b`, never negative: `gcd(a, 0)` is
/// `abs(a)`, `gcd(0, 0)` is `0`.
/// @param a  one integer, of either sign.
/// @param b  the other.
/// @example
///   gcd(12, -18)     // 6
export gcd :: fn(a: i32, b: i32) -> i32 {
    x := a
    y := b
    for y != 0 {
        rest :: x % y
        x = y
        y = rest
    }
    return abs(x)
}
/// Greatest common divisor of `a` and `b`, never negative: `gcd(a, 0)` is
/// `abs(a)`, `gcd(0, 0)` is `0`.
/// @param a  one integer, of either sign.
/// @param b  the other.
export gcd :: fn(a: i64, b: i64) -> i64 {
    x := a
    y := b
    for y != 0 {
        rest :: x % y
        x = y
        y = rest
    }
    return abs(x)
}

/// Least common multiple of `a` and `b`, never negative: `0` when either is.
/// @param a  one integer, of either sign.
/// @param b  the other.
/// @example
///   lcm(4, 6)        // 12
export lcm :: fn(a: i32, b: i32) -> i32 {
    if a == 0 || b == 0 {
        return 0
    }
    return abs(a / gcd(a, b) * b)
}
/// Least common multiple of `a` and `b`, never negative: `0` when either is.
/// @param a  one integer, of either sign.
/// @param b  the other.
export lcm :: fn(a: i64, b: i64) -> i64 {
    if a == 0 || b == 0 {
        return 0
    }
    return abs(a / gcd(a, b) * b)
}

/// `base` raised to the power `exponent`, by repeated squaring: `pow(x, 0)` is
/// `1`.
/// @param base      the integer to raise.
/// @param exponent  how many times `base` is multiplied in.
/// @example
///   pow(2, 10)       // 1024
///   pow(-3, 3)       // -27
export pow :: fn(base: i32, exponent: u32) -> i32 {
    result: i32 = 1
    factor := base
    rest := exponent
    for rest > 0 {
        if rest & 1 == 1 {
            result *= factor
        }
        rest = rest >> 1
        // Not past the last bit: a square no bit uses could overflow alone.
        if rest > 0 {
            factor *= factor
        }
    }
    return result
}
/// `base` raised to the power `exponent`, by repeated squaring: `pow(x, 0)` is
/// `1`.
/// @param base      the integer to raise.
/// @param exponent  how many times `base` is multiplied in.
export pow :: fn(base: i64, exponent: u32) -> i64 {
    result: i64 = 1
    factor := base
    rest := exponent
    for rest > 0 {
        if rest & 1 == 1 {
            result *= factor
        }
        rest = rest >> 1
        // Not past the last bit: a square no bit uses could overflow alone.
        if rest > 0 {
            factor *= factor
        }
    }
    return result
}

// ---------------------------------------------------------------------- tests

import "std/testing"

@test test_pi_close :: fn() -> void {
    assert_close(PI, 3.141592653589793, 0.000001)
}

@test test_e_close :: fn() -> void {
    assert_close(E, 2.718281828459045, 0.000001)
}

@test test_sqrt :: fn() -> void {
    assert_close(sqrt(16.0), 4.0, 0.000001)
    assert_close(sqrt(2.0), 1.4142135623730951, 0.000001)
}

@test test_pow :: fn() -> void {
    assert_close(pow(2.0, 10.0), 1024.0, 0.000001)
    assert_close(pow(3.0, 0.0), 1.0, 0.000001)
}

// sin / cos / tan had no test on either backend. They are `@extern`, so the
// wiring check that used to force every bodyless declaration to be served no
// longer covers them: a typo in the symbol would fail at link time natively and
// trap on the VM, with nothing pointing at the cause. Exact values only: these
// are the points where libm is required to be exact, so the test cannot drift
// between platforms.
@test test_trigonometry :: fn() -> void {
    assert_close(sin(0.0), 0.0, 0.000001)
    assert_close(cos(0.0), 1.0, 0.000001)
    assert_close(tan(0.0), 0.0, 0.000001)
    assert_close(sin(PI), 0.0, 0.000001)
    assert_close(cos(PI), -1.0, 0.000001)
}

@test test_floor_ceil_round :: fn() -> void {
    assert_close(floor(3.7), 3.0, 0.000001)
    assert_close(ceil(3.2), 4.0, 0.000001)
    assert_close(round(3.5), 4.0, 0.000001)
    assert_close(round(3.4), 3.0, 0.000001)
}

@test test_min_max_i32 :: fn() -> void {
    assert_eq(min(3, 7), 3)
    assert_eq(max(3, 7), 7)
    assert_eq(min(-2, 2), -2)
}

@test test_min_max_f64 :: fn() -> void {
    assert_close(min(1.5, 2.5), 1.5, 0.000001)
    assert_close(max(1.5, 2.5), 2.5, 0.000001)
}

@test test_min_max_clamp_f32 :: fn() -> void {
    low: f32: 1.5
    high: f32: 2.5
    assert_eq(min(low, high), low)
    assert_eq(max(low, high), high)
    assert_eq(clamp(high, 0.0, low), low)
}

@test test_min_max_any_comparable :: fn() -> void {
    small: u8: 3
    big: u8: 200
    assert_eq(min(small, big), small)
    assert_eq(max('a', 'z'), 'z')
    assert_eq(min("pear", "fig"), "fig")
    assert_eq(clamp("m", "a", "f"), "f")
}

@test test_min_max_literal_takes_the_other_type :: fn() -> void {
    n: i64: 5_000_000_000
    assert_eq(min(n, 10), 10)
    assert_eq(max(10, n), n)
}

@test test_min_max_clamp_propagate_nan :: fn() -> void {
    nan :: sqrt(-1.0)
    assert(is_nan(min(nan, 1.0)), "min, NaN first")
    assert(is_nan(min(1.0, nan)), "min, NaN second")
    assert(is_nan(max(nan, 1.0)), "max, NaN first")
    assert(is_nan(max(1.0, nan)), "max, NaN second")
    assert(is_nan(clamp(nan, 0.0, 1.0)), "clamp of a NaN")
    narrow_nan: f32: f32(nan)
    narrow_one: f32: 1.0
    assert(is_nan(min(narrow_nan, narrow_one)), "f32 min, NaN first")
    assert(is_nan(max(narrow_one, narrow_nan)), "f32 max, NaN second")
}

@test test_abs :: fn() -> void {
    assert_eq(abs(-5), 5)
    assert_eq(abs(5), 5)
    assert_eq(abs(0), 0)
    assert_close(abs(-3.5), 3.5, 0.000001)
}

@test test_clamp :: fn() -> void {
    assert_eq(clamp(5, 0, 10), 5)
    assert_eq(clamp(-3, 0, 10), 0)
    assert_eq(clamp(42, 0, 10), 10)
}

@test test_clamp_with_lo_above_hi :: fn() -> void {
    assert_eq(clamp(5, 10, 0), 0)
}

@test test_lerp :: fn() -> void {
    assert_close(lerp(0.0, 10.0, 0.0), 0.0, 0.000001)
    assert_close(lerp(0.0, 10.0, 1.0), 10.0, 0.000001)
    assert_close(lerp(0.0, 10.0, 0.5), 5.0, 0.000001)
}

@test test_hypot_and_trunc :: fn() -> void {
    assert_close(hypot(3.0, 4.0), 5.0, 0.000001)
    assert_close(trunc(-1.7), -1.0, 0.000001)
    assert_close(trunc(1.7), 1.0, 0.000001)
}

// Points where libm is exact, as for the trigonometry.
@test test_exponentials_and_logarithms :: fn() -> void {
    assert_close(exp(0.0), 1.0, 0.000001)
    assert_close(log(1.0), 0.0, 0.000001)
    assert_close(log(E), 1.0, 0.000001)
    assert_close(log2(8.0), 3.0, 0.000001)
    assert_close(log10(1000.0), 3.0, 0.000001)
}

@test test_inverse_trigonometry :: fn() -> void {
    assert_close(asin(1.0), PI / 2.0, 0.000001)
    assert_close(acos(-1.0), PI, 0.000001)
    assert_close(atan(1.0), PI / 4.0, 0.000001)
    assert_close(atan2(1.0, -1.0), 3.0 * PI / 4.0, 0.000001)
}

@test test_float_classification :: fn() -> void {
    nan :: 0.0 / 0.0
    infinity :: 1.0 / 0.0
    assert(is_nan(nan), "0 / 0 is a NaN")
    assert(!is_nan(infinity), "inf is not a NaN")
    assert(is_infinite(-infinity), "-inf is infinite")
    assert(!is_infinite(nan), "a NaN is not infinite")
    assert(is_finite(-1.5), "-1.5 is finite")
    assert(!is_finite(nan), "a NaN is not finite")
    narrow: f32: 2.5
    assert(is_finite(narrow), "an f32 2.5 is finite")
    assert(!is_nan(narrow), "an f32 2.5 is not a NaN")
    assert(!is_infinite(narrow), "an f32 2.5 is not infinite")
}

@test test_sign :: fn() -> void {
    assert_eq(sign(-7), -1)
    assert_eq(sign(0), 0)
    wide: i64: 9_000_000_000
    assert_eq(sign(wide), 1)
    assert_close(sign(-2.5), -1.0, 0.000001)
    assert(is_nan(sign(0.0 / 0.0)), "the sign of a NaN is a NaN")
}

@test test_gcd_and_lcm :: fn() -> void {
    assert_eq(gcd(12, -18), 6)
    assert_eq(gcd(-12, 0), 12)
    assert_eq(gcd(0, 0), 0)
    assert_eq(lcm(4, -6), 12)
    assert_eq(lcm(0, 5), 0)
    wide: i64: 6_000_000_000
    assert_eq(gcd(wide, 4_000_000_000), 2_000_000_000)
    assert_eq(lcm(wide, 4_000_000_000), 12_000_000_000)
}

@test test_integer_pow :: fn() -> void {
    assert_eq(pow(2, 10), 1024)
    assert_eq(pow(-3, 3), -27)
    assert_eq(pow(7, 0), 1)
    wide: i64: -2
    assert_eq(pow(wide, 63), -0x8000_0000_0000_0000)
}

@test test_round_half_away_from_zero :: fn() -> void {
    // 2.5 tells half-away-from-zero (3.0) from round-half-to-even (2.0).
    assert_close(round(2.5), 3.0, 0.000001)
}
