// std/env: the process's environment.
//
// Its variables, its working directory, the temp directory and the path of the
// running executable.
//
// `get_env` calls libc `getenv` on POSIX and `GetEnvironmentVariableW` on
// Windows, whose C library keeps a copy of the environment that `set_env` does
// not reach.
//
// Reading the build machine's environment during comptime evaluation bakes a
// non-reproducible value, so callers must not do it from a `@comptime`
// context; nothing refuses the call, and `bootstrap/verify.sh` catches it in
// this tree.

module "std/env"

import "std/io"
import "std/path"
import "std/sort"
import "std/string"
import "system/darwin"
import "system/libc"
import "system/posix"
import "system/windows"

// ---- variables ------------------------------------------------------------

/// The value of environment variable `name`, or `null` when it is unset.
///
/// @param name  the variable name, e.g. "NO_COLOR" or "PATH".
/// @return      the variable's value, or `null` if it is not present in the
///              environment. An empty value is returned as `""`, distinct from
///              `null` (unset).
@target
export get_env :: fn(name: string) -> string | null

@target(.Linux, .Darwin)
get_env :: fn(name: string) -> string | null = sys_getenv(name)

@target(.Windows)
get_env :: fn(name: string) -> string | null {
    wide :: to_wide(name)
    none: u16[]: []
    for {
        // The size the value takes, its NUL included: 1 for an empty value, 0
        // when the variable is unset.
        needed :: get_environment_variable_w(wide, none, 0)
        if needed == 0 {
            return null
        }
        value: u16[]: [0] * i64(needed)
        units :: get_environment_variable_w(wide, value, needed)
        // The value may grow between the two calls: it is then asked again.
        if units < needed {
            return from_wide(value, i32(units))
        }
    }
}

/// One variable of the environment.
export EnvVar :: struct {
    name:  string
    value: string
}

/// Every variable of the environment, sorted by name.
///
/// On Windows the `=C:` entries, which hold each drive's working directory,
/// are left out.
export env_vars :: fn() -> EnvVar[] {
    vars: EnvVar[]: []
    index: i64 = 0
    for {
        entry :: system_environ_entry(index) else break
        index += 1
        parts :: entry.split_first("=") else continue
        if parts.0 != "" {
            vars.push(EnvVar { .name = parts.0, .value = parts.1 })
        }
    }
    return sort(vars, by_name)
}

by_name :: fn(a: EnvVar, b: EnvVar) -> bool = a.name < b.name

// The `index`-th `NAME=value` of the environment, null past the last.
@target
system_environ_entry :: fn(index: i64) -> string | null

@target(.Linux, .Darwin)
system_environ_entry :: fn(index: i64) -> string | null = sys_environ_entry(index)

@target(.Windows)
system_environ_entry :: fn(index: i64) -> string | null = environment_entry(index)

/// Set environment variable `name` to `value`, replacing what it held, for this
/// process and the processes it starts from then on.
///
/// The C library does not guard the environment against two threads: a change
/// while another thread reads it is a race. Set it before starting threads.
///
/// @param name   the variable: not empty, and holding neither `=` nor a NUL
///               byte.
/// @param value  its value, which may be empty, distinct from unset; no NUL
///               byte.
/// @error        `IOError`: `.InvalidInput` for a refused name or value, the
///               system's reason when it refuses the change.
/// @example
///   set_env("VADER_COLOR", "never")
///   get_env("VADER_COLOR")   // "never"
export set_env :: fn(name: string, value: string) -> null | IOError {
    if !name.is_variable_name() {
        return invalid_variable("name `${name}`")
    }
    if value.bytes().index_of(0) != null {
        return invalid_variable("value with a NUL byte")
    }
    return name.system_set_env(value)
}

/// Remove environment variable `name`, for this process and the processes it
/// starts from then on. A variable already unset is not an error.
///
/// The race of `set_env` holds here too.
///
/// @param name  the variable: not empty, and holding neither `=` nor a NUL
///              byte.
/// @error       `IOError`: `.InvalidInput` for a refused name, the system's
///              reason when it refuses the change.
export unset_env :: fn(name: string) -> null | IOError {
    if !name.is_variable_name() {
        return invalid_variable("name `${name}`")
    }
    return name.system_unset_env()
}

// Whether `name` can name a variable: not empty, and holding neither `=`, which
// ends a name in the environment, nor a NUL byte, which ends it at the C
// boundary.
is_variable_name :: fn(name: string) -> bool =
    name != "" && name.bytes().index_of('=') == null && name.bytes().index_of(0) == null

invalid_variable :: fn(what: string) = IOError {
    .msg = "invalid environment variable: ${what}",
    .kind = .InvalidInput,
}

@target
system_set_env :: fn(name: string, value: string) -> null | IOError

@target(.Linux, .Darwin)
system_set_env :: fn(name: string, value: string) -> null | IOError {
    return failure_unless(sys_setenv(name, value, 1) == 0, "cannot set variable")
}

@target(.Windows)
system_set_env :: fn(name: string, value: string) -> null | IOError {
    changed :: set_environment_variable_w(to_wide(name), to_wide(value))
    return failure_unless(changed, "cannot set variable")
}

@target
system_unset_env :: fn(name: string) -> null | IOError

@target(.Linux, .Darwin)
system_unset_env :: fn(name: string) = failure_unless(
    sys_unsetenv(name) == 0,
    "cannot unset variable",
)

@target(.Windows)
system_unset_env :: fn(name: string) = failure_unless(
    unset_environment_variable_w(to_wide(name), null),
    "cannot unset variable",
)

/// Whether environment variable `name` turns a switch on: set to a value that
/// is not empty and does not start with `0`. So `1` and `yes` are on, `0` and
/// `00` are off, and `false` is on: only a leading `0` turns a switch off. The
/// runtime reads its own `VADER_GC_*` switches by the same rule.
///
/// @param name  the variable name, e.g. "VADER_PROFILE".
export is_env_flag_on :: fn(name: string) -> bool {
    value :: get_env(name) else return false
    return value.is_flag_value_on()
}

/// Whether `value`, read from an environment variable, turns a switch on: it is
/// not empty and does not start with `0`, the rule of `is_env_flag_on`.
///
/// @param value  the variable's value.
export is_flag_value_on :: fn(value: string) -> bool = value != "" && value.byte_at(0) != '0'

// ---- paths ----------------------------------------------------------------

/// Full path of the running executable, `/`-separated. Use `std/path`'s
/// `parent` to get its directory, e.g. to resolve sidecar resources (stdlib,
/// C runtime) next to the binary. Falls back to `"."` if the OS query fails.
/// @return  the executable's own path.
@target
export current_executable_location :: fn() -> string

@target(.Linux)
current_executable_location :: fn() -> string {
    buf: u8[]: [0] * 4096
    n :: sys_readlink("/proc/self/exe", buf, buf.len() - 1)
    if n <= 0 {
        return "."
    }
    return buf.up_to_nul()
}

@target(.Darwin)
current_executable_location :: fn() -> string {
    raw: u8[]: [0] * 4096
    cap: u32: 4096
    if ns_get_executable_path(raw, [cap]) != 0 {
        return "."
    }
    // What Darwin hands back may be relative or carry symlinks: `argv[0]` as
    // the kernel saw it. Resolving it is what makes it usable as a sidecar anchor.
    // `realpath` itself: `std/fs::real_path` would make this module import
    // `std/fs`, whose tests import this one.
    resolved: u8[]: [0] * 4096
    if sys_realpath(up_to_nul(raw), resolved) == null {
        return "."
    }
    return up_to_nul(resolved)
}

@target(.Windows)
current_executable_location :: fn() -> string {
    // 4096 UTF-16 units, so 8192 bytes.
    buf: u16[]: [0] * 4096
    n :: get_module_file_name(null, buf, u32(buf.len()))
    if n == 0 || i64(n) >= buf.len() {
        return "."
    }
    return from_wide(buf, i32(n)).to_posix()
}

/// The directory the process resolves relative paths against, `/`-separated and
/// WITHOUT a trailing separator: where it was started, unless
/// `set_current_working_directory` moved it. Join with `"/name"` to build a path. Distinct from
/// `current_executable_location`, which answers where the *binary* lives: use
/// this one to resolve a path the user typed, that one for resources shipped
/// beside the executable. Falls back to `"."` if the OS query fails.
/// @return  the working directory.
@target
export current_working_directory :: fn() -> string

@target(.Linux, .Darwin)
current_working_directory :: fn() -> string {
    buf: u8[]: [0] * 4096
    if sys_getcwd(buf, buf.len()) == null {
        return "."
    }
    return buf.up_to_nul()
}

@target(.Windows)
current_working_directory :: fn() -> string {
    // 4096 UTF-16 units, so 8192 bytes.
    buf: u16[]: [0] * 4096
    n :: get_current_directory(u32(buf.len()), buf)
    if n == 0 || i64(n) >= buf.len() {
        return "."
    }
    return from_wide(buf, i32(n)).to_posix()
}

/// Make `path` the directory the process resolves relative paths against.
/// Process-wide: every thread, and every child spawned afterwards, sees it.
///
/// @param path  the new working directory, absolute or relative to the current one.
/// @error       `IOError` when `path` is not a directory the process may enter.
@target
export set_current_working_directory :: fn(path: string) -> null | IOError

@target(.Linux, .Darwin)
set_current_working_directory :: fn(path: string) -> null | IOError {
    if sys_chdir(path) != 0 {
        return last_io_error("cannot change directory")
    }
    return null
}

@target(.Windows)
set_current_working_directory :: fn(path: string) -> null | IOError {
    if set_current_directory(to_wide(path)) == 0 {
        return last_io_error("cannot change directory")
    }
    return null
}

/// OS scratch directory for temporary files, `/`-separated and WITHOUT a
/// trailing separator: join with `"/name"` to build a path. Honours the
/// platform temp-dir environment (`$TMPDIR` on POSIX, `%TMP%` / `%TEMP%` via
/// `GetTempPath` on Windows), falling back to `"/tmp"` when unset. The
/// directory is assumed to exist and be writable ; this does not create it.
/// @return  the temp directory path, e.g. `"/tmp"` or `"/var/folders/.../T"`.
@target
export temp_dir :: fn() -> string

@target(.Linux, .Darwin)
temp_dir :: fn() -> string = temp_dir_of(get_env("TMPDIR"))

// The decision, split out from the environment so a test can reach it.
//
// `else` fires on null alone, and `get_env` reports a SET-BUT-EMPTY variable as
// `""`: a distinction it documents and keeps. `TMPDIR=` then produced an empty
// temp dir, and the build driver joined its probe paths onto it and wrote them
// at the filesystem ROOT.
temp_dir_of :: fn(env: string | null) -> string {
    e :: env else ""
    if e == "" {
        return "/tmp"
    }
    return e.to_path().as_string()
}

@target(.Windows)
temp_dir :: fn() -> string {
    // `GetTempPathW` reports 0 on failure and a length >= the capacity when the
    // buffer is too small; neither wrote anything usable, so both fall back.
    // The fallback is the WORKING directory, which always exists: a POSIX
    // `"/tmp"` would only defer the failure to whoever opens a file under it.
    // 4096 UTF-16 units, so 8192 bytes.
    buf: u16[]: [0] * 4096
    n :: get_temp_path(u32(buf.len()), buf)
    if n == 0 || i64(n) >= buf.len() {
        return "."
    }
    return from_wide(buf, i32(n)).to_posix().to_path().as_string()
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_set_env_then_get_env_then_unset_env :: fn() -> void {
    name :: "VADER_STD_ENV_TEST_SET"
    assert(set_env(name, "one") !is IOError, "set")
    assert_eq(get_env(name) else "unset", "one")
    assert(set_env(name, "two") !is IOError, "replaced")
    assert_eq(get_env(name) else "unset", "two")
    assert(unset_env(name) !is IOError, "unset")
    assert(get_env(name) == null, "and gone")
}

@test
test_set_env_round_trips_a_value_beyond_ascii :: fn() -> void {
    name :: "VADER_STD_ENV_TEST_UNICODE"
    defer unset_env(name)
    assert(set_env(name, "été 東京") !is IOError, "set")
    assert_eq(get_env(name) else "unset", "été 東京")
}

@test
test_set_env_keeps_an_empty_value_apart_from_unset :: fn() -> void {
    name :: "VADER_STD_ENV_TEST_EMPTY"
    defer unset_env(name)
    assert(set_env(name, "") !is IOError, "set empty")
    assert_eq(get_env(name) else "unset", "")
}

@test
test_set_env_refuses_a_name_no_variable_can_take :: fn() -> void {
    for name in ["", "A=B", "A\0B"] {
        refused :: set_env(name, "x")
        assert(refused is IOError && refused.kind == .InvalidInput, "refused: `${name}`")
    }
    nul_value :: set_env("VADER_STD_ENV_TEST_NUL", "a\0b")
    assert(nul_value is IOError && nul_value.kind == .InvalidInput, "a NUL value is refused")
}

@test
test_unset_env_of_an_unset_variable :: fn() -> void {
    assert(unset_env("VADER_STD_ENV_TEST_NEVER_SET") !is IOError, "nothing to remove is no error")
}

@test
test_env_vars_lists_a_set_variable_in_name_order :: fn() -> void {
    name :: "VADER_STD_ENV_TEST_LISTED"
    set_env(name, "a=b")
    defer unset_env(name)
    vars :: env_vars()
    found: string = "absent"
    for v in vars {
        if v.name == name {
            found = v.value
        }
    }
    assert_eq(found, "a=b")
    for i in 1..<vars.len() {
        assert(vars[i - 1].name <= vars[i].name, "sorted by name")
    }
}

@test
test_is_env_flag_on_reads_an_unset_variable_as_off :: fn() -> void {
    assert(!is_env_flag_on("VADER_STD_ENV_TEST_NEVER_SET"), "an unset variable is off")
}

@test
test_is_env_flag_on_reads_a_set_variable_as_on :: fn() -> void {
    assert(is_env_flag_on("PATH"), "`PATH` is set and starts with no `0`")
}

@test
test_is_flag_value_on_reads_a_leading_zero_as_off :: fn() -> void {
    assert(!"00".is_flag_value_on(), "`00` starts with `0`")
}

@test
test_is_flag_value_on_reads_false_as_on :: fn() -> void {
    assert("false".is_flag_value_on(), "only a leading `0` turns a switch off")
}

@test
test_temp_dir_falls_back_when_the_variable_is_empty :: fn() -> void {
    assert_eq(temp_dir_of(null), "/tmp")
    assert_eq(temp_dir_of(""), "/tmp")
    assert_eq(temp_dir_of("/var/folders/xx"), "/var/folders/xx")
    assert_eq(temp_dir_of("/var/folders/xx/"), "/var/folders/xx")
}
