// std/env: the process's environment.
//
// Its variables, its working directory, the temp directory and the path of the
// running executable.
//
// `get_env` is libc `getenv` itself. Reading the build machine's environment
// during comptime evaluation bakes a non-reproducible value, so callers must not
// do it from a `@comptime` context; nothing refuses the call, and
// `bootstrap/verify.sh` catches it in this tree.

module "std/env"

import "std/io"
import "std/path"
import "system/darwin"
import "system/posix"
import "system/windows"

// ---- variables ------------------------------------------------------------

/// The value of environment variable `name`, or `null` when it is unset.
///
/// @param name  the variable name, e.g. "NO_COLOR" or "PATH".
/// @return      the variable's value, or `null` if it is not present in the
///              environment. An empty value is returned as `""`, distinct from
///              `null` (unset).
@c_header("<stdlib.h>")
@extern("getenv")
export get_env :: fn(name: string) -> string | null

/// Whether environment variable `name` turns a switch on: set to a value that
/// is not empty and does not start with `0`. So `1` and `yes` are on, `0` and
/// `00` are off, and `false` is on: only a leading `0` turns a switch off. The
/// runtime reads its own `VADER_GC_*` switches by the same rule.
///
/// @param name  the variable name, e.g. "VADER_PROFILE".
export is_env_flag_on :: fn(name: string) -> bool {
    value :: get_env(name) ?? return false
    return value.is_flag_value_on()
}

/// Whether `value`, read from an environment variable, turns a switch on: it is
/// not empty and does not start with `0`, the rule of `is_env_flag_on`.
///
/// @param value  the variable's value.
export is_flag_value_on :: fn(value: string) -> bool = value != "" && value.byte_at(0) != '0'

// ---- paths ----------------------------------------------------------------

/// Full path of the running executable, `/`-separated. Use `std/path`'s
/// `parent` to get its directory, e.g. to resolve sidecar resources (stdlib,
/// C runtime) next to the binary. Falls back to `"."` if the OS query fails.
/// @return  the executable's own path.
@target
export current_executable_location :: fn() -> string

@target(.Linux)
current_executable_location :: fn() -> string {
    buf: u8[]: [0] * 4096
    n :: sys_readlink("/proc/self/exe", buf, buf.len() - 1)
    if n <= 0 {
        return "."
    }
    return to_posix(up_to_nul(buf))
}

@target(.Darwin)
current_executable_location :: fn() -> string {
    raw: u8[]: [0] * 4096
    cap: u32: 4096
    if ns_get_executable_path(raw, cap) != 0 {
        return "."
    }
    // What Darwin hands back may be relative or carry symlinks: `argv[0]` as
    // the kernel saw it. Resolving it is what makes it usable as a sidecar anchor.
    // `realpath` itself: `std/fs::real_path` would make this module import
    // `std/fs`, whose tests import this one.
    resolved: u8[]: [0] * 4096
    if sys_realpath(up_to_nul(raw), resolved) == null {
        return "."
    }
    return up_to_nul(resolved)
}

@target(.Windows)
current_executable_location :: fn() -> string {
    // 4096 UTF-16 units, so 8192 bytes.
    buf: u16[]: [0] * 4096
    n :: get_module_file_name(null, buf, u32(buf.len()))
    if n == 0 || i64(n) >= buf.len() {
        return "."
    }
    return to_posix(from_wide(buf, i32(n)))
}

/// The directory the process resolves relative paths against, `/`-separated and
/// WITHOUT a trailing separator: where it was started, unless
/// `set_current_working_directory` moved it. Join with `"/name"` to build a path. Distinct from
/// `current_executable_location`, which answers where the *binary* lives: use
/// this one to resolve a path the user typed, that one for resources shipped
/// beside the executable. Falls back to `"."` if the OS query fails.
/// @return  the working directory.
@target
export current_working_directory :: fn() -> string

@target(.Linux, .Darwin)
current_working_directory :: fn() -> string {
    buf: u8[]: [0] * 4096
    if sys_getcwd(buf, buf.len()) == null {
        return "."
    }
    return without_trailing_sep(to_posix(up_to_nul(buf)))
}

@target(.Windows)
current_working_directory :: fn() -> string {
    // 4096 UTF-16 units, so 8192 bytes.
    buf: u16[]: [0] * 4096
    n :: get_current_directory(u32(buf.len()), buf)
    if n == 0 || i64(n) >= buf.len() {
        return "."
    }
    return without_trailing_sep(to_posix(from_wide(buf, i32(n))))
}

/// Make `path` the directory the process resolves relative paths against.
/// Process-wide: every thread, and every child spawned afterwards, sees it.
///
/// @param path  the new working directory, absolute or relative to the current one.
/// @error       `IOError` when `path` is not a directory the process may enter.
@target
export set_current_working_directory :: fn(path: string) -> null | IOError

@target(.Linux, .Darwin)
set_current_working_directory :: fn(path: string) -> null | IOError {
    if sys_chdir(path) != 0 {
        return last_io_error("cannot change directory")
    }
    return null
}

@target(.Windows)
set_current_working_directory :: fn(path: string) -> null | IOError {
    if set_current_directory(to_wide(path)) == 0 {
        return last_io_error("cannot change directory")
    }
    return null
}

/// OS scratch directory for temporary files, `/`-separated and WITHOUT a
/// trailing separator: join with `"/name"` to build a path. Honours the
/// platform temp-dir environment (`$TMPDIR` on POSIX, `%TMP%` / `%TEMP%` via
/// `GetTempPath` on Windows), falling back to `"/tmp"` when unset. The
/// directory is assumed to exist and be writable ; this does not create it.
/// @return  the temp directory path, e.g. `"/tmp"` or `"/var/folders/.../T"`.
@target
export temp_dir :: fn() -> string

@target(.Linux, .Darwin)
temp_dir :: fn() -> string = temp_dir_of(get_env("TMPDIR"))

// The decision, split out from the environment so a test can reach it.
//
// `??` fires on null alone, and `get_env` reports a SET-BUT-EMPTY variable as
// `""`: a distinction it documents and keeps. `TMPDIR=` then produced an empty
// temp dir, and the build driver joined its probe paths onto it and wrote them
// at the filesystem ROOT.
temp_dir_of :: fn(env: string | null) -> string {
    e :: env ?? ""
    if e == "" {
        return "/tmp"
    }
    return without_trailing_sep(e)
}

@target(.Windows)
temp_dir :: fn() -> string {
    // `GetTempPathW` reports 0 on failure and a length >= the capacity when the
    // buffer is too small; neither wrote anything usable, so both fall back.
    // The fallback is the WORKING directory, which always exists: a POSIX
    // `"/tmp"` would only defer the failure to whoever opens a file under it.
    // 4096 UTF-16 units, so 8192 bytes.
    buf: u16[]: [0] * 4096
    n :: get_temp_path(u32(buf.len()), buf)
    if n == 0 || i64(n) >= buf.len() {
        return "."
    }
    return without_trailing_sep(to_posix(from_wide(buf, i32(n))))
}

// Drop trailing separators so `temp_dir() + "/name"` stays clean. Keeps a lone
// `/`, which IS the directory rather than a separator after one.
without_trailing_sep :: fn(p: string) -> string {
    trailing: i64 = 0
    for i in 0..<p.byte_len() {
        last :: p.byte_len() - 1 - i
        if last == 0 || p.byte_at(last) != '/' {
            break
        }
        // `C:/` IS the drive root; the separator is part of it.
        if p.byte_at(last - 1) == ':' {
            break
        }
        trailing += 1
    }
    if trailing == 0 {
        return p
    }
    return p.byte_slice(0, p.byte_len() - trailing)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_is_env_flag_on_reads_an_unset_variable_as_off :: fn() -> void {
    assert(!is_env_flag_on("VADER_STD_ENV_TEST_NEVER_SET"), "an unset variable is off")
}

@test
test_is_env_flag_on_reads_a_set_variable_as_on :: fn() -> void {
    assert(is_env_flag_on("PATH"), "`PATH` is set and starts with no `0`")
}

@test
test_is_flag_value_on_reads_a_leading_zero_as_off :: fn() -> void {
    assert(!"00".is_flag_value_on(), "`00` starts with `0`")
}

@test
test_is_flag_value_on_reads_false_as_on :: fn() -> void {
    assert("false".is_flag_value_on(), "only a leading `0` turns a switch off")
}

@test
test_temp_dir_falls_back_when_the_variable_is_empty :: fn() -> void {
    assert_eq(temp_dir_of(null), "/tmp")
    assert_eq(temp_dir_of(""), "/tmp")
    assert_eq(temp_dir_of("/var/folders/xx"), "/var/folders/xx")
    assert_eq(temp_dir_of("/var/folders/xx/"), "/var/folders/xx")
}
