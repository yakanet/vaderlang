// std/core/decorators: the places a declared decorator may be written, and what
// an interceptor learns of the function it wraps.
//
// A decorator declaration names its places in its parentheses
// (`Route :: decorator(.Function) { ... }`); the compiler types those
// arguments against `DecoratorTarget`. Same `module "std/core"` as
// `core.vader`, so every program sees these types without an import.

module "std/core"

/// A place a decorator may be written, named in the parentheses of its
/// declaration.
///
/// @example
///   Route :: decorator(.Function) {
///       path: string
///   }
export DecoratorTarget :: enum {
    /// Above a top-level function.
    Function
    /// Above a member of a trait.
    TraitMember
    /// Above a member of an `implements` block.
    ImplMember
    /// Above a struct.
    Struct
    /// Above an enum.
    Enum
    /// Above a trait.
    Trait
    /// Above an `implements` block.
    Implementation
    /// Above a module constant.
    Constant
    /// Above a type alias.
    Alias
    /// Above an import.
    Import
    /// Above a struct field.
    Field
    /// Above an enum variant.
    Variant
    /// Above a function parameter.
    Parameter
    /// Above the `module` line of a file, for its whole module: the decorators
    /// of every file of the module add up.
    Module
    /// Before a `match`: the compiler's `@partial` and `@unreachable`.
    Match
    /// Before a value computed at compile time: the compiler's `@comptime`.
    Expression
    /// Standing alone among the declarations: the compiler's `@assert`.
    Assertion
}

/// The function an interceptor wraps, as its `around` receives it: one value per
/// function, built on its first call.
///
/// @example
///   # import "std/console"
///   # @interceptor(around = traced)
///   # Traced :: decorator(.Function) { label: string = "" }
///   # Log :: struct<A, R> {}
///   traced :: fn<A, R>(state: Log<A, R>, site: Site<Traced>, args: A, proceed: fn(A) -> R) -> R {
///       println("${site.marker.label} ${site.function} at ${site.location}")
///       return proceed(args)
///   }
export Site :: struct<D> {
    /// The name of the function, as written.
    function: string
    /// The module that declares it.
    module: string
    /// The file and the line it is declared at: `main.vader:12`.
    location: string
    /// The decorator written on it, every field filled.
    marker: D
}
