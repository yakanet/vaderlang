// std/core/primitives.vader — primitive-type trait impls.
//
// Split out of core.vader so neither file outgrows the ~500-LoC budget. Carries
// the Display / Equals / Hash / Comparable / Step / arithmetic impls for the
// built-in scalar types and `string`, plus the pure-Vader number formatters.
// Part of `module "std/core"` (same folder) — joins the auto-imported prelude
// and shares core.vader's trait declarations without an explicit import.

module "std/core"

//
// `@intrinsic` impls route the call directly to the matching bytecode op
// via `OP_INTRINSIC_BY_MANGLED` (see `src/bytecode/emit.ts`) — no fn-call
// indirection, identical performance to the operator form. `s1 + s2` and
// `(s1).add(s2)` share a single runtime path.

// ---- Display --------------------------------------------------------------
//
// Every primitive type carries a pure-Vader `to_string` so any value
// flowing into a `string` slot (e.g. `print(value)`, `let s: string =
// value`) routes through the blanket `T implements[T: Display] Into<string>`
// declared above. `${x}` string interpolation routes every scalar primitive
// through its `to_string` impl (below) — including `f32`/`f64`, which format
// via the Ryu `format_f32`/`format_f64` shortest-float formatters.

// Pure-Vader Display for the scalar primitives (Target ABI S1 for the
// integers/bool/char/string, S4 for f32/f64). Real-body impls shadow the
// former `@intrinsic` stubs (`lower_impl_member.vader` returns the first
// non-intrinsic match). std/core cannot import std/string_builder / std/string
// (import cycle — that's why std/numbers lives outside core), so every formatter
// here sizes its result first, fills one `Buffer` and interns it once ; f32/f64
// delegate to the Ryu formatters in dtoa.vader / f2s.vader, which render the
// same way.

// Render a signed value working entirely in NON-POSITIVE space, because
// `abs(i64 min)` overflows i64 (|i64 min| = i64 max + 1). So rather than negate
// n into positive space and extract digits there, only POSITIVE inputs are
// shifted negative (`if n > 0 { n = -n }` — always safe) ; i64 min, already
// negative, is never negated. With n <= 0, `n % 10` (I64Mod, C-truncating) is a
// non-positive remainder, so the actual digit is `-(n % 10)`, in 0..9.
//
// A first pass counts the digits so the second can fill a single right-sized
// `Buffer` from the least-significant end and intern it — one allocation, no
// growable array and no reversal pass.
format_signed :: fn(n: i64) -> string {
    if n == 0 { return "0" }
    neg :: n < 0
    if n > 0 { n = -n }                       // shift into non-positive space ; -(i64 min) never evaluated
    ndigits: usize = 0
    m := n
    for m != 0 {
        ndigits = ndigits + 1
        m = m / 10
    }
    total :: if neg { ndigits + 1 } else { ndigits }
    buf :: total.new_buffer()
    i: usize = total
    for n != 0 {
        i = i - 1
        buf.store_u8(i, '0' + u8(-(n % 10)))
        n = n / 10
    }
    if neg { buf.store_u8(0, '-') }
    return buf.intern_string(total)
}

// Render an unsigned value. `% 10` / `/ 10` lower to U64Mod / U64Div
// (op_select), so high-bit-set values don't format as negative. Same
// count-then-fill single-`Buffer` shape as `format_signed`, with no sign slot.
format_unsigned :: fn(n: u64) -> string {
    if n == 0 { return "0" }
    ndigits: usize = 0
    m := n
    for m != 0 {
        ndigits = ndigits + 1
        m = m / 10
    }
    buf :: ndigits.new_buffer()
    i: usize = ndigits
    for n != 0 {
        i = i - 1
        buf.store_u8(i, '0' + u8(n % 10))
        n = n / 10
    }
    return buf.intern_string(ndigits)
}

// ---- write-into-buffer formatters (the off-string interpolation / concat path)
//
// Each writes its value's bytes straight into a caller-owned `Buffer` at byte
// offset `off` and returns the offset past the last byte — NO allocation, NO
// intern. The `${}` / `+` lowering threads one Buffer + `off` through these, so a
// `${int}` no longer mints a throwaway interned string (the `format_*` path) just
// to copy its bytes into the result. Same count-then-fill digit shape as
// `format_signed` / `format_unsigned`, targeting `self` at `off` instead of a
// fresh per-value buffer. Offsets are caller-trusted (the lowering sizes the
// Buffer to fit every part's max width).

/// Allocate a byte `Buffer` of `cap` bytes — the free-fn wrapper the `${}` / `+`
/// lowering resolves (the `new_buffer` impl member isn't reachable by name there).
export new_byte_buffer :: fn(cap: usize) -> Buffer = cap.new_buffer()

/// Intern the buffer's leading `len` bytes as a `string` (one atom-table copy).
export finish_buffer :: fn(self: Buffer, len: usize) -> string = self.intern_string(len)

/// Byte length of `s` (its UTF-8 byte count), an `@intrinsic` read straight off
/// the interned atom. String-only: a `u8[]` uses `.len()` directly.
@intrinsic export byte_len :: fn(s: string) -> usize

/// The byte at index `i` of `s` — an `@intrinsic` header-free read straight off
/// the interned atom, no read-only `u8[]` view materialised: how code reads a
/// string's bytes, the peer of `byte_len` for the `[i]` case.
///
/// @error traps when `i >= byte_len(s)`, matching `s.bytes()[i]`.
@intrinsic export byte_at :: fn(s: string, i: usize) -> u8

/// The bytes of `s` from offset `start` up to `end`, excluded, as a string: an
/// `@intrinsic` slice of the interned atom, nothing copied. Offsets count bytes,
/// where `s[i]` counts codepoints. Like any slice, offsets past the end clamp to
/// it, and an `end` before `start` gives the empty string.
///
/// @param s      source string.
/// @param start  first byte offset, included.
/// @param end    byte offset where the slice stops, excluded.
@intrinsic export byte_slice :: fn(s: string, start: usize, end: usize) -> string

/// Whether every byte of `s` is ASCII (below 0x80): each byte is then one codepoint,
/// and a byte offset is a codepoint index.
///
/// @param s  the string to test.
export is_ascii :: fn(s: string) -> bool {
    for i in 0..<s.byte_len() {
        if s.byte_at(i) >= 0x80 {
            return false
        }
    }
    return true
}

/// Write `s`'s bytes at `off` ; return `off + s.byte_len()`.
export write_string_at :: fn(self: Buffer, off: usize, s: string) -> usize {
    self.write_string(off, s)
    return off + s.byte_len()
}

/// Write the signed decimal digits of `n` at `off` ; return the offset past them.
export write_int :: fn(self: Buffer, off: usize, n: i64) -> usize {
    if n == 0 {
        self.store_u8(off, '0')
        return off + 1
    }
    neg :: n < 0
    if n > 0 { n = -n }                       // non-positive space ; -(i64 min) never evaluated
    ndigits: usize = 0
    m := n
    for m != 0 {
        ndigits = ndigits + 1
        m = m / 10
    }
    total :: if neg { ndigits + 1 } else { ndigits }
    i: usize = off + total
    for n != 0 {
        i = i - 1
        self.store_u8(i, '0' + u8(-(n % 10)))
        n = n / 10
    }
    if neg { self.store_u8(off, '-') }
    return off + total
}

/// Write the unsigned decimal digits of `n` at `off` ; return the offset past them.
export write_unsigned :: fn(self: Buffer, off: usize, n: u64) -> usize {
    if n == 0 {
        self.store_u8(off, '0')
        return off + 1
    }
    ndigits: usize = 0
    m := n
    for m != 0 {
        ndigits = ndigits + 1
        m = m / 10
    }
    i: usize = off + ndigits
    for n != 0 {
        i = i - 1
        self.store_u8(i, '0' + u8(n % 10))
        n = n / 10
    }
    return off + ndigits
}

/// Write `"true"` / `"false"` at `off` ; return the offset past it.
export write_bool :: fn(self: Buffer, off: usize, b: bool) -> usize {
    if b { return self.write_string_at(off, "true") }
    return self.write_string_at(off, "false")
}

/// Materialise a `string` from verbatim UTF-8 bytes — the canonical bytes→string
/// primitive (inverse of `bytes`). Host intrinsic backed by `vader_string_as_string`
/// (the runtime symbol kept its name) ; O(1) on a borrowed `bytes()` slice, O(n) on
/// a packed array, no UTF-8 validation.
/// @param bs  the UTF-8 bytes to materialise (typically a `bytes()` slice).
/// @return    the string those bytes encode.
@intrinsic export bytes_to_string :: fn(bs: u8[]) -> string

/// Borrow the UTF-8 bytes of a string as a read-only `u8[]` view — the canonical
/// string→bytes primitive, inverse of `bytes_to_string`. Host intrinsic backed
/// by `vader_string_bytes_view` (no new runtime symbol) ; a zero-copy borrowed
/// view of the interned bytes on native, read in place on the VM until a write
/// copies it. To read a string's bytes, `byte_len`, `byte_at` and `byte_slice` take
/// the string itself.
/// @param s  source string.
/// @return   a read-only `u8[]` over the UTF-8 bytes of `s`.
@intrinsic export bytes :: fn(s: string) -> u8[]

i8     implements Display -> format_signed(i64(self))
i16    implements Display -> format_signed(i64(self))
i32    implements Display -> format_signed(i64(self))
i64    implements Display -> format_signed(self)
isize  implements Display -> format_signed(i64(self))
u8     implements Display -> format_unsigned(u64(self))
u16    implements Display -> format_unsigned(u64(self))
u32    implements Display -> format_unsigned(u64(self))
u64    implements Display -> format_unsigned(self)
usize  implements Display -> format_unsigned(u64(self))
bool   implements Display -> if self { "true" } else { "false" }
char   implements Display -> utf8_encode(self).bytes_to_string()
string implements Display -> self
null   implements Display -> "null"

f32 implements Display -> format_f32(self)
f64 implements Display -> format_f64(self)

// ---- bit reinterpret (float ↔ raw IEEE bits) ------------------------------
//
// Distinct from the numeric `u64(x)` / `f64(b)` casts (which convert the VALUE).
// `@intrinsic` → the `F64ToBits` / `BitsToF64` opcodes (a `union` cast in C, no
// runtime symbol). Foundation for the pure-Vader shortest-double formatter
// and the S2-deferred `LoadF64` byte codec.

@intrinsic f64 implements FloatBits     // → F64ToBits
@intrinsic u64 implements BitsFloat     // → BitsToF64
@intrinsic f32 implements Float32Bits   // → F32ToBits
@intrinsic u32 implements Bits32Float   // → BitsToF32

// ---- Equals ---------------------------------------------------------------

@intrinsic i8     implements Equals
@intrinsic i16    implements Equals
@intrinsic i32    implements Equals
@intrinsic i64    implements Equals
@intrinsic isize  implements Equals
@intrinsic u8     implements Equals
@intrinsic u16    implements Equals
@intrinsic u32    implements Equals
@intrinsic u64    implements Equals
@intrinsic usize  implements Equals
@intrinsic f32    implements Equals
@intrinsic f64    implements Equals
@intrinsic bool   implements Equals
@intrinsic char   implements Equals
@intrinsic string implements Equals

// ---- Hash -----------------------------------------------------------------
//
// Integer Hash impls cast through u64 ; `string` reads the FNV-1a-64 cached on
// its interned atom (see the `@intrinsic` impl below).

i8    implements Hash -> u64(self)
i16   implements Hash -> u64(self)
i32   implements Hash -> u64(self)
i64   implements Hash -> u64(self)
isize implements Hash -> u64(self)
u8    implements Hash -> u64(self)
u16   implements Hash -> u64(self)
u32   implements Hash -> u64(self)
u64   implements Hash -> u64(self)
usize implements Hash -> u64(self)
char  implements Hash -> u64(self)

// `string` reads the FNV-1a-64 cached on its interned atom (computed once at
// intern) — O(1), no per-call byte walk, no `bytes()` view allocation. Backed by
// `vader_string_hash` (vader.h); the host shims map the mangle. Content-based, so
// map iteration order stays GC-stable.
@intrinsic string implements Hash

// ---- Comparable -----------------------------------------------------------
//
// Three-way `compare` for every integer width plus `char`, factored through the
// shared `three_way` helper so the if-chain lives in ONE place. Floats are
// excluded — IEEE-754's NaN breaks total ordering, so an `Ord`-style trait is the
// right shape for f32/f64 and is deferred. Each `-> three_way(...)` is
// single-expression, so the post-lowering inliner folds it back at every `compare`
// site — DRY with no call overhead.

// Collapse the two primitive comparisons into a three-way result : -1 / 0 / +1.
three_way :: fn(less: bool, greater: bool) -> i32 = if less { -1 } else if greater { 1 } else { 0 }

i8    implements Comparable -> three_way(self < other, self > other)
i16   implements Comparable -> three_way(self < other, self > other)
i32   implements Comparable -> three_way(self < other, self > other)
i64   implements Comparable -> three_way(self < other, self > other)
isize implements Comparable -> three_way(self < other, self > other)
u8    implements Comparable -> three_way(self < other, self > other)
u16   implements Comparable -> three_way(self < other, self > other)
u32   implements Comparable -> three_way(self < other, self > other)
u64   implements Comparable -> three_way(self < other, self > other)
usize implements Comparable -> three_way(self < other, self > other)
char  implements Comparable -> three_way(self < other, self > other)

// Byte order, through the `string.compare` op : `"a" < "b"` lowers to
// `compare("a", "b") < 0`.
@intrinsic string implements Comparable

// ---- Step -----------------------------------------------------------------
//
// Discrete-successor logic per primitive. Every integer width bumps by 1 ;
// `char` round-trips through u32 since it has no native `+ i32` op. Floats
// are intentionally excluded — there's no canonical `next float` semantics.

i8    implements Step -> self + 1
i16   implements Step -> self + 1
i32   implements Step -> self + 1
i64   implements Step -> self + 1
isize implements Step -> self + 1
u8    implements Step -> self + 1
u16   implements Step -> self + 1
u32   implements Step -> self + 1
u64   implements Step -> self + 1
usize implements Step -> self + 1
char  implements Step -> char(u32(self) + 1)

// ---- Numeric arithmetic ---------------------------------------------------
//
// Add/Sub/Mul/Div for every primitive numeric type. Makes `[T: Add]` and
// friends usable on every numeric primitive — `5 + 7` and `(5).add(7)`
// share one path.

@intrinsic i8 implements Add
@intrinsic i8 implements Sub
@intrinsic i8 implements Mul
@intrinsic i8 implements Div

@intrinsic i16 implements Add
@intrinsic i16 implements Sub
@intrinsic i16 implements Mul
@intrinsic i16 implements Div

@intrinsic i32 implements Add
@intrinsic i32 implements Sub
@intrinsic i32 implements Mul
@intrinsic i32 implements Div

@intrinsic i64 implements Add
@intrinsic i64 implements Sub
@intrinsic i64 implements Mul
@intrinsic i64 implements Div

@intrinsic isize implements Add
@intrinsic isize implements Sub
@intrinsic isize implements Mul
@intrinsic isize implements Div

@intrinsic u8 implements Add
@intrinsic u8 implements Sub
@intrinsic u8 implements Mul
@intrinsic u8 implements Div

@intrinsic u16 implements Add
@intrinsic u16 implements Sub
@intrinsic u16 implements Mul
@intrinsic u16 implements Div

@intrinsic u32 implements Add
@intrinsic u32 implements Sub
@intrinsic u32 implements Mul
@intrinsic u32 implements Div

@intrinsic u64 implements Add
@intrinsic u64 implements Sub
@intrinsic u64 implements Mul
@intrinsic u64 implements Div

@intrinsic usize implements Add
@intrinsic usize implements Sub
@intrinsic usize implements Mul
@intrinsic usize implements Div

@intrinsic f32 implements Add
@intrinsic f32 implements Sub
@intrinsic f32 implements Mul
@intrinsic f32 implements Div

@intrinsic f64 implements Add
@intrinsic f64 implements Sub
@intrinsic f64 implements Mul
@intrinsic f64 implements Div

// ---- Additive identity ----------------------------------------------------

i8 implements Zero -> 0
i16 implements Zero -> 0
i32 implements Zero -> 0
i64 implements Zero -> 0
isize implements Zero -> 0
u8 implements Zero -> 0
u16 implements Zero -> 0
u32 implements Zero -> 0
u64 implements Zero -> 0
usize implements Zero -> 0
f32 implements Zero -> 0.0
f64 implements Zero -> 0.0

// ---- Multiplicative identity ----------------------------------------------

i8 implements One -> 1
i16 implements One -> 1
i32 implements One -> 1
i64 implements One -> 1
isize implements One -> 1
u8 implements One -> 1
u16 implements One -> 1
u32 implements One -> 1
u64 implements One -> 1
usize implements One -> 1
f32 implements One -> 1.0
f64 implements One -> 1.0

// ---- String ---------------------------------------------------------------
//
// `Add` is wired here in std/core (auto-imported) so `.add()` and the `Add`
// bound work without `import "std/string"`. Its body interpolates the two
// operands — which desugars to the Buffer-backed StringBuilder chain (S6b),
// so no dedicated `StringConcat` op is needed. The `+` operator never reaches
// this body : it is special-cased in the typechecker (`typecheck/binary.vader`
// — `string + string -> string`) and lowered to the same StringBuilder chain
// directly (`lower/lower_binary.vader`). `s[i]` and `s[lo..<hi]` are in
// `utf8.vader`; strings are immutable, so there is no `IndexSet`. Number
// formatting (`to_hex`, `to_bin`) lives in `std/numbers` so it can use
// `std/string_builder`.

string implements Add -> "${self}${other}"

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_is_ascii :: fn() -> void {
    assert("".is_ascii(), "the empty string is ASCII")
    assert("hello".is_ascii(), "\"hello\" is ASCII")
    assert(!"héllo".is_ascii(), "\"héllo\" is not ASCII")
    assert("héllo".byte_slice(3, 6).is_ascii(), "an ASCII slice of a string that is not")
    assert(!bytes_to_string([0x61, 0xFF]).is_ascii(), "a malformed byte is not ASCII")
}
