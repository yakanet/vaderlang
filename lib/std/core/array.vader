// std/core/array.vader: the built-in array methods.
//
// The growable array `T[]` is a compiler built-in (no struct declaration), but
// its mutation / query methods live here, as functions called by UFCS
// (`xs.push(v)`): each calls the member of `Intrinsic` that does it, and a call
// to one is lowered as that member's operation.
//
// They live in `std/core` (the prelude), so array methods resolve with no
// import: exactly like `arr in coll` (Contains) or `[v] * n` (Mul) in core.vader.
// What produces or consumes an iterator over an array is in `std/iter`.

module "std/core"

/// Number of live elements of `xs`.
///
/// @param xs  the array.
export len :: fn<T>(xs: T[]) -> i64 = Intrinsic.array_len(xs)

/// Append `value` to the end of `xs`, growing its backing storage as needed.
///
/// @param xs     the array, which grows.
/// @param value  the element appended.
export push :: fn<T>(xs: T[], value: T) -> void = Intrinsic.array_push(xs, value)

/// Append every element of `other` to the end of `xs`.
///
/// @param xs     the array, which grows.
/// @param other  the elements appended, only read.
export push_all :: fn<T>(xs: T[], other: T[]) -> void = Intrinsic.array_push_all(xs, other)

/// Copy `count` elements from `xs[source_offset..]` into
/// `destination[destination_offset..]`.
///
/// @param xs                  the array read.
/// @param source_offset       where the copy starts in `xs`.
/// @param destination         the array written.
/// @param destination_offset  where the copy lands in `destination`.
/// @param count               how many elements are copied.
export copy_to :: fn<T>(
    xs: T[],
    source_offset: i64,
    destination: T[],
    destination_offset: i64,
    count: i64,
) -> void = Intrinsic.array_copy_to(xs, source_offset, destination, destination_offset, count)

/// Remove the last element of `xs` and return it.
///
/// @param xs  the array, which shrinks.
/// @return    the element removed ; `null` when `xs` is empty.
export remove_last :: fn<T>(xs: T[]) -> T | null = Intrinsic.array_remove_last(xs)

/// Remove the last element of `xs`, if it has one. Unlike `remove_last`, it takes
/// an array whose elements can be `null`, since nothing is handed back.
///
/// @param xs  the array, which shrinks ; an empty one stays as it is.
/// @example
///   xs: (i32 | null)[]: [1, null]
///   xs.drop_last()   // xs is [1]
export drop_last :: fn<T>(xs: T[]) -> void {
    xs.remove_last()
}

/// Drop every element of `xs` (its length becomes 0), keeping its reserved
/// capacity.
///
/// @param xs  the array emptied.
export clear :: fn<T>(xs: T[]) -> void = Intrinsic.array_clear(xs)

// Tests for `+` do NOT live in this file, unlike everything else here: using the
// impl from inside `std/core` itself leaves its callee unmaterialised, and the emitter
// panics (`unresolved callee 'std_core$$array$Add$add__i32'`). Any other module resolves it
// fine, so the coverage lives in `tests/snippets/array_add_concat/`.
/// `a + b`: a fresh array holding `a`'s elements then `b`'s.
///
/// Mirrors `string + string`, which concatenates rather than adding: an array is
/// the same kind of sequence, so `+` reads the same way. Neither operand is
/// touched; the result is a new allocation, so `a + b` in a loop allocates each
/// time: build with `push_all` when that matters.
T[] implements<T> Add<T[]> {
    add :: fn(self, other: T[]) -> T[] {
        out: T[]: [] * (self.len() + other.len())
        out.push_all(self)
        out.push_all(other)
        return out
    }
}

// ---- construction ---------------------------------------------------------

/// Build an array of `n` elements, calling `make` once per slot.
///
/// The complement of `[v] * n`, which repeats ONE reference into every slot and
/// so cannot build `n` distinct objects (see `W0013`).
///
/// @param n     number of elements to build.
/// @param make  called once per slot, in order ; its result fills that slot.
/// @return      a fresh array of length `n`, its capacity reserved up front.
/// @example
///   rows: BlockId[][] = filled(block_count, () -> [])   // n DISTINCT arrays
///   seen :: filled(n, new_visited_set)                  // or a named factory
export filled :: fn<T>(n: i64, make: fn() -> T) -> T[] {
    out: T[]: [] * n
    for 0..<n {
        out.push(make())
    }
    return out
}

/// Build an array of `n` elements, calling `make(i)` for slot `i`.
///
/// The positional twin of `filled` : reach for it when an element depends on
/// where it sits, and for `filled` when it doesn't.
///
/// @param n     number of elements to build.
/// @param make  called once per slot, in order, with that slot's index.
/// @return      a fresh array of length `n`, its capacity reserved up front.
/// @example
///   squares :: filled_indexed(n, (i) -> i32(i * i))
///   rows    :: filled_indexed(n, (i) -> Row { .id = i })
export filled_indexed :: fn<T>(n: i64, make: fn(i64) -> T) -> T[] {
    out: T[]: [] * n
    for i in 0..<n {
        out.push(make(i))
    }
    return out
}

// ---- comparison -----------------------------------------------------------
//
// An array has no `==` : comparing two walks them, which these names say. `===`
// is the identity test. `contains_all` and `is_disjoint` are tested in
// `tests/snippets/array_content_comparison/`, for the reason `+` is : their `in`
// cannot be materialised from inside `std/core`.

/// Whether `self` and `other` hold equal elements in the same order : the same
/// length, and `self[i] == other[i]` at every index.
///
/// @param other  the array compared with.
/// @example
///   assert([1, 2].content_equals([1, 2]), "same contents")
export content_equals :: fn<T: Equals>(self: T[], other: T[]) -> bool {
    if self.len() != other.len() {
        return false
    }
    for i in 0..<self.len() {
        if self[i] != other[i] {
            return false
        }
    }
    return true
}

/// Whether `other` holds the elements of `self` in some order, each as many times.
/// Quadratic : each element of `self` is looked for among the elements of `other`
/// not yet matched.
///
/// @param other  the array compared with.
/// @example
///   assert([1, 2, 2].is_permutation_of([2, 1, 2]), "same elements")
export is_permutation_of :: fn<T: Equals>(self: T[], other: T[]) -> bool {
    if self.len() != other.len() {
        return false
    }
    matched :: [false] * other.len()
    for item in self {
        i :: first_unmatched(other, matched, item) else return false
        matched[i] = true
    }
    return true
}

// The index of the first element of `other` equal to `item` that `matched` does not
// mark yet ; null when there is none.
first_unmatched :: fn<T: Equals>(other: T[], matched: bool[], item: T) -> i64 | null {
    for i in 0..<other.len() {
        if !matched[i] && other[i] == item {
            return i
        }
    }
    return null
}

/// Whether every element of `other` is in `self`. Each counts once :
/// `[1].contains_all([1, 1])` holds.
///
/// @param other  the elements looked for.
export contains_all :: fn<T: Equals>(self: T[], other: T[]) -> bool {
    for item in other {
        if item !in self {
            return false
        }
    }
    return true
}

/// Whether `self` and `other` share no element.
///
/// @param other  the array compared with.
export is_disjoint :: fn<T: Equals>(self: T[], other: T[]) -> bool {
    for item in self {
        if item in other {
            return false
        }
    }
    return true
}

/// The index of the first element of `self` equal to `value`, null when there
/// is none.
///
/// @param value  the element looked for.
/// @example
///   [3, 5, 3].index_of(3)   // 0
///   [3, 5, 3].index_of(7)   // null
export index_of :: fn<T: Equals>(self: T[], value: T) -> i64 | null {
    for i in 0..<self.len() {
        if self[i] == value {
            return i
        }
    }
    return null
}

/// Remove the first element of `self` equal to `value`, keeping the others in
/// order ; whether there was one.
///
/// @param value  the element to remove.
/// @example
///   xs :: [1, 2, 1]
///   xs.remove_value(1)   // true: xs is [2, 1]
///   xs.remove_value(7)   // false
export remove_value :: fn<T: Equals>(self: T[], value: T) -> bool {
    i :: self.index_of(value) else return false
    self.copy_to(i + 1, self, i, self.len() - i - 1)
    self.drop_last()
    return true
}

/// Remove from `self` every element `drop` says to, keeping the others in
/// order ; how many went.
///
/// @param drop  whether an element goes.
/// @example
///   xs :: [1, 2, 3, 4]
///   xs.remove_where(x -> x % 2 == 0)   // 2: xs is [1, 3]
export remove_where :: fn<T>(self: T[], drop: fn(T) -> bool) -> i64 {
    kept: i64 = 0
    for i in 0..<self.len() {
        if !drop(self[i]) {
            self[kept] = self[i]
            kept += 1
        }
    }
    removed :: self.len() - kept
    for self.len() > kept {
        self.drop_last()
    }
    return removed
}

/// True when `self` holds no element.
export is_empty :: fn<T>(self: T[]) -> bool = self.len() == 0

/// The first element of `self`, null when it is empty.
export first :: fn<T>(self: T[]) -> T | null = if self.len() == 0 { null } else { self[0] }

/// The last element of `self`, null when it is empty.
export last :: fn<T>(self: T[]) -> T | null =
    if self.len() == 0 { null } else { self[self.len() - 1] }

/// A fresh copy of `self`: mutating it does not affect `self`.
///
/// Use this to modify what a frozen value holds (a module constant, a view of a
/// string's bytes), or to break aliasing between a slice view and its parent.
export clone :: fn<T>(self: T[]) -> T[] {
    out: T[]: [] * self.len()
    out.push_all(self)
    return out
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_is_empty_first_and_last_of_an_array :: fn() -> void {
    xs :: [4, 5, 6]
    empty: i32[]: []
    assert(!xs.is_empty() && empty.is_empty(), "only the empty array is empty")
    assert_eq(xs.first() else -1, 4)
    assert_eq(xs.last() else -1, 6)
    assert(empty.first() == null && empty.last() == null, "nothing to take from an empty array")
}

@test
test_clone_is_independent :: fn() -> void {
    xs :: [1, 2]
    copy :: xs.clone()
    copy.push(3)
    assert_eq(xs.len(), 2)
    assert_eq(copy.len(), 3)
}

new_int_row :: fn() -> i32[] = []

@test
test_filled_builds_distinct_elements :: fn() -> void {
    rows :: filled(3, new_int_row)
    assert_eq(rows.len(), 3)
    rows[0].push(42)
    assert_eq(rows[0].len(), 1)
    assert_eq(rows[1].len(), 0)
    assert_eq(rows[2].len(), 0)
}

@test
test_filled_of_zero_is_empty :: fn() -> void {
    assert_eq(filled(0, new_int_row).len(), 0)
}

@test
test_filled_indexed_passes_the_slot_index :: fn() -> void {
    squares :: 4.filled_indexed((i) -> i32(i * i))
    assert_eq(squares.len(), 4)
    assert_eq(squares[0], 0)
    assert_eq(squares[2], 4)
    assert_eq(squares[3], 9)
}

@test
test_content_equals_compares_in_order :: fn() -> void {
    assert([1, 2, 3].content_equals([1, 2, 3]), "equal contents")
    assert(![1, 2, 3].content_equals([3, 2, 1]), "another order")
    assert(![1, 2].content_equals([1, 2, 3]), "another length")
}

@test
test_is_permutation_of_counts_each_element :: fn() -> void {
    assert([1, 2, 2].is_permutation_of([2, 1, 2]), "same elements")
    assert(![1, 2, 2].is_permutation_of([1, 1, 2]), "another multiplicity")
}

@test
test_filled_indexed_of_zero_is_empty :: fn() -> void {
    assert_eq(filled_indexed(0, (i) -> i32(i)).len(), 0)
}

@test
test_drop_last_takes_a_null_element_out :: fn() -> void {
    xs: (i32 | null)[]: [1, null]
    xs.drop_last()
    assert_eq(xs.len(), 1)
    assert(xs[0] == 1, "the first element stays")
}

@test
test_drop_last_leaves_an_empty_array_alone :: fn() -> void {
    xs: i32[]: []
    xs.drop_last()
    assert(xs.is_empty(), "still empty")
}

@test
test_remove_value_takes_the_first_equal_element_out :: fn() -> void {
    xs :: [1, 2, 1, 3]
    assert(xs.remove_value(1), "1 is there")
    assert(xs.content_equals([2, 1, 3]), "the others keep their order")
}

@test
test_remove_where_takes_out_what_the_test_names :: fn() -> void {
    xs :: [1, 2, 3, 4, 6]
    assert_eq(xs.remove_where((x) -> x % 2 == 0), 3)
    assert(xs.content_equals([1, 3]), "the others stay, in order")
}

@test
test_remove_where_leaves_an_array_the_test_names_nothing_of :: fn() -> void {
    xs :: [1, 3]
    assert_eq(xs.remove_where((x) -> x > 9), 0)
    assert(xs.content_equals([1, 3]), "unchanged")
}

@test
test_remove_where_may_empty_an_array :: fn() -> void {
    xs :: [1, 3]
    assert_eq(xs.remove_where((x) -> true), 2)
    assert(xs.is_empty(), "nothing is left")
}

@test
test_remove_value_leaves_an_array_without_it_alone :: fn() -> void {
    xs :: [1, 2]
    assert(!xs.remove_value(7), "7 is not there")
    assert(xs.content_equals([1, 2]), "unchanged")
}

@test
test_index_of_finds_the_first_equal_element :: fn() -> void {
    assert([3, 5, 3].index_of(3) == 0, "the first 3")
    assert([3, 5, 3].index_of(5) == 1, "the 5")
}

@test
test_index_of_an_absent_element_is_null :: fn() -> void {
    assert([3, 5].index_of(7) == null, "7 is not there")
    empty: i32[]: []
    assert(empty.index_of(7) == null, "nothing is in an empty array")
}
