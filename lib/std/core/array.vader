// std/core/array.vader — built-in array methods, declared as intrinsics.
//
// The growable array `T[]` is a compiler built-in (no struct declaration), but
// its mutation / query methods live here as a bodyless `@intrinsic T[] implements
// ArrayOps` — the single source of their names and signatures. This mirrors how
// `Buffer`'s byte ops (buffer.vader) and primitive arithmetic (`i32 + i32`) are
// declared: an `@intrinsic` impl whose members the backend provides directly.
//
// The lowerer recognises these members and emits the dedicated bytecode nodes:
// `push` / `len` keep the typed `ArrayPush { type_id }` / `ArrayLen` ops (so a
// `push` of a primitive writes the raw value, no box / no write barrier), while
// `push_all` / `copy_to` / `remove_last` / `clear` lower to the element-agnostic
// `array.*` intrinsics (the runtime reads the element tag off the buffer).
//
// `ArrayOps` lives in `std/core` (the prelude), so array methods resolve with no
// import — exactly like `arr in coll` (Contains) or `[v] * n` (Mul) in core.vader.

module "std/core"

/// The built-in methods of `T[]`. Bodyless — provided by the compiler's array
/// ops, not a Vader body. `T` is the element type.
export ArrayOps :: trait<T> {
    /// Number of live elements.
    len :: fn(self) -> usize
    /// Append `value` to the end, growing the backing storage as needed.
    /// `value` is stored, hence the marker: on a `Box![]` it must be a mutable
    /// `Box`, since the array hands it back writable.
    push :: fn(self!, value: T!) -> void
    /// Append every element of `other` (a borrowed, immutable view).
    push_all :: fn(self!, other: T[]) -> void
    /// Copy `count` elements from `self[src_off..]` into `dst[dst_off..]`.
    /// Reads `self` ; it is `dst` that is written, hence the marker there.
    copy_to :: fn(self, src_off: usize, dst: T[]!, dst_off: usize, count: usize) -> void
    /// Remove and return the last element, or `null` when empty.
    remove_last :: fn(self!) -> T | null
    /// Drop every element (length → 0), keeping the reserved capacity.
    clear :: fn(self!) -> void
}

@intrinsic T[] implements<T> ArrayOps<T>

/// `a + b` — a fresh array holding `a`'s elements then `b`'s.
///
/// Mirrors `string + string`, which concatenates rather than adding: an array is
/// the same kind of sequence, so `+` reads the same way. Neither operand is
/// touched; the result is a new allocation, so `a + b` in a loop allocates each
/// time — build with `push_all` when that matters.
///
/// The result is immutable (`Out` is `Self`), even though it is a fresh allocation
/// nobody else holds: `+` is for producing a value, not a work buffer. Build with
/// an explicit `T[]!` and `push_all` when you need to keep appending.
// Tests for `+` do NOT live in this file, unlike everything else here: using the
// impl from inside `std/core` itself trips GATE B1 at materialisation
// (`unresolved callee 'std_core$[]$Add$add__i32'`). Any other module resolves it
// fine, so the coverage lives in `tests/snippets/array_add_concat/`.
T[] implements<T> Add<T[]> {
    add :: fn(self, other: T[]) -> T[] {
        out: T[]: [] * (self.len() + other.len())
        out.push_all(self)
        out.push_all(other)
        return out
    }
}

// ---- construction ---------------------------------------------------------

/// Build an array of `n` elements, calling `make` once per slot.
///
/// The complement of `[v] * n`, which repeats ONE reference into every slot and
/// so cannot build `n` distinct objects (see `W0013`).
///
/// @param n     number of elements to build.
/// @param make  called once per slot, in order ; its result fills that slot.
/// @return      a fresh array of length `n`, its capacity reserved up front.
/// @example
///   rows: BlockId[][] = filled(block_count, () -> [])   // n DISTINCT arrays
///   seen :: filled(n, new_visited_set)                  // or a named factory
export filled :: fn<T>(n: usize, make: fn() -> T) -> T[]! {
    out: T[]: [] * n
    for 0..<n {
        out.push(make())
    }
    return out
}

/// Build an array of `n` elements, calling `make(i)` for slot `i`.
///
/// The positional twin of `filled` : reach for it when an element depends on
/// where it sits, and for `filled` when it doesn't.
///
/// @param n     number of elements to build.
/// @param make  called once per slot, in order, with that slot's index.
/// @return      a fresh array of length `n`, its capacity reserved up front.
/// @example
///   squares :: filled_indexed(n, (i) -> i32(i * i))
///   rows    :: filled_indexed(n, (i) -> Row { .id = i })
export filled_indexed :: fn<T>(n: usize, make: fn(usize) -> T) -> T[]! {
    out: T[]: [] * n
    for i in 0..<n {
        out.push(make(i))
    }
    return out
}

// ---- comparison -----------------------------------------------------------
//
// An array has no `==` : comparing two walks them, which these names say. `===`
// is the identity test. `contains_all` and `is_disjoint` are tested in
// `tests/snippets/array_content_comparison/`, for the reason `+` is : their `in`
// cannot be materialised from inside `std/core`.

/// Whether `self` and `other` hold equal elements in the same order : the same
/// length, and `self[i] == other[i]` at every index.
///
/// @param other  the array compared with.
/// @example
///   assert([1, 2].content_equals([1, 2]), "same contents")
export content_equals :: fn<T: Equals>(self: T[], other: T[]) -> bool {
    if self.len() != other.len() {
        return false
    }
    for i in 0..<self.len() {
        if self[i] != other[i] {
            return false
        }
    }
    return true
}

/// Whether `other` holds the elements of `self` in some order, each as many times.
/// Quadratic : each element of `self` is looked for among the elements of `other`
/// not yet matched.
///
/// @param other  the array compared with.
/// @example
///   assert([1, 2, 2].is_permutation_of([2, 1, 2]), "same elements")
export is_permutation_of :: fn<T: Equals>(self: T[], other: T[]) -> bool {
    if self.len() != other.len() {
        return false
    }
    matched :: [false] * other.len()
    for item in self {
        i :: first_unmatched(other, matched, item) ?? return false
        matched[i] = true
    }
    return true
}

// The index of the first element of `other` equal to `item` that `matched` does not
// mark yet ; null when there is none.
first_unmatched :: fn<T: Equals>(other: T[], matched: bool[], item: T) -> usize | null {
    for i in 0..<other.len() {
        if !matched[i] && other[i] == item {
            return i
        }
    }
    return null
}

/// Whether every element of `other` is in `self`. Each counts once :
/// `[1].contains_all([1, 1])` holds.
///
/// @param other  the elements looked for.
export contains_all :: fn<T: Equals>(self: T[], other: T[]) -> bool {
    for item in other {
        if item !in self {
            return false
        }
    }
    return true
}

/// Whether `self` and `other` share no element.
///
/// @param other  the array compared with.
export is_disjoint :: fn<T: Equals>(self: T[], other: T[]) -> bool {
    for item in self {
        if item in other {
            return false
        }
    }
    return true
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

new_int_row :: fn() -> i32[]! = []

@test
test_filled_builds_distinct_elements :: fn() -> void {
    rows :: filled(3, new_int_row)
    assert_eq(rows.len(), 3)
    rows[0].push(42)
    assert_eq(rows[0].len(), 1)
    assert_eq(rows[1].len(), 0)
    assert_eq(rows[2].len(), 0)
}

@test
test_filled_of_zero_is_empty :: fn() -> void {
    assert_eq(filled(0, new_int_row).len(), 0)
}

@test
test_filled_indexed_passes_the_slot_index :: fn() -> void {
    squares :: 4.filled_indexed((i) -> i32(i * i))
    assert_eq(squares.len(), 4)
    assert_eq(squares[0], 0)
    assert_eq(squares[2], 4)
    assert_eq(squares[3], 9)
}

@test
test_content_equals_compares_in_order :: fn() -> void {
    assert([1, 2, 3].content_equals([1, 2, 3]), "equal contents")
    assert(![1, 2, 3].content_equals([3, 2, 1]), "another order")
    assert(![1, 2].content_equals([1, 2, 3]), "another length")
}

@test
test_is_permutation_of_counts_each_element :: fn() -> void {
    assert([1, 2, 2].is_permutation_of([2, 1, 2]), "same elements")
    assert(![1, 2, 2].is_permutation_of([1, 1, 2]), "another multiplicity")
}

@test
test_filled_indexed_of_zero_is_empty :: fn() -> void {
    assert_eq(filled_indexed(0, (i) -> i32(i)).len(), 0)
}
