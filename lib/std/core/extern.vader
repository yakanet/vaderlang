// std/core/extern: where the function of an `@extern` comes from.
//
// A `CLibrary` names a C library once, a `WasmInterface` a component interface;
// each `@extern` that comes from one names the constant as its `from`
// (`@extern(RAYLIB, "InitWindow")`, `@extern(MONOTONIC_CLOCK, "now")`). A
// `WasmStream` and a `WasmFuture` stand for the WIT types an interface's
// functions take and return, which no other Vader type spells. The
// compiler evaluates the constant when it builds, so its fields may depend on
// the target through `VADER_OS` and `VADER_ARCH`. Part of `std/core`: no import
// names it.

module "std/core"

/// A C library that `@extern` declarations come from.
///
/// A native build adds what it lists to the compilation and the link, and only
/// when one of the library's functions is reached. The interpreter opens it by
/// `name`, or, when it ships `archives`, calls it through adapters compiled with
/// them.
export CLibrary :: struct {
    /// What the interpreter opens: `lib<name>.dylib`, `lib<name>.so` or
    /// `<name>.dll`, the running process when empty, and what its adapters link
    /// when there are no `archives`. A native build links what `archives` and
    /// `system` list.
    name: string
    /// The headers declaring the library's functions, each written as
    /// `@c_header` writes it. They serve every `@extern` naming the library
    /// without a `@c_header` of its own.
    headers: string[] = []
    /// A folder of headers, relative to the module declaring the constant: the
    /// compilation searches it (`-I`).
    include: string = ""
    /// Static archives shipped with the binding, relative to the module
    /// declaring the constant.
    archives: string[] = []
    /// What the platform provides: a library by name (`"GL"` links `-lGL`), or an
    /// Apple framework by its bundle name (`"Cocoa.framework"`).
    system: string[] = []
}

/// An interface of the component model, as WIT names it:
/// `wasi:clocks/monotonic-clock@0.3.0` is the package `wasi:clocks`, the
/// interface `monotonic-clock` and the version `0.3.0`.
///
/// A WASM build imports it into the component it writes, and the signature of
/// each `@extern` from it gives the type of the function it imports.
export WasmInterface :: struct {
    /// The namespace and the package, `wasi:clocks`.
    package: string
    name: string
    version: string
}

/// The items a WIT `stream<T>` carries, as an `@extern` of a `WasmInterface`
/// takes them: the call opens the stream, writes every item, then closes it.
export WasmStream :: struct<T> {
    items: T[]
}

/// What a WIT `future<T>` resolves to, as an `@extern` of a `WasmInterface`
/// returns it: the call waits for it once its streams are written.
export WasmFuture :: struct<T> {
    value: T
}
