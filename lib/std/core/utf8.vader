// std/core/utf8 — a string's codepoints, over its bytes.
//
// The UTF-8 encoder and decoder, the codepoint count `len`, and the codepoint walk
// behind `s[i]` and `s[lo..<hi]`, written over the three string primitives every
// backend provides: `byte_len`, `byte_at` and `byte_slice`. The rest of the codec
// (widths of a `char`, surrogates, `chars`) is in `std/string`.

module "std/core"

// ---- constants ------------------------------------------------------------

/// Unicode replacement character (U+FFFD): the standard stand-in for an
/// undecodable byte or an unpaired UTF-16 surrogate.
export REPLACEMENT_CHAR :: char(0xFFFD)

// ---- byte classification --------------------------------------------------

/// True when `b` is a UTF-8 continuation byte (`0x80..0xBF`): the trailing bytes
/// of a multi-byte sequence, never a leading byte.
export is_utf8_continuation :: fn(b: u8) -> bool = (b & 0xC0) == 0x80

// ---- encode ---------------------------------------------------------------

/// Encode a Unicode codepoint to its UTF-8 bytes (pure arithmetic), for
/// interning via `bytes_to_string` or appending into a byte buffer. A `char`
/// that holds no Unicode scalar value, a surrogate or a value past U+10FFFF,
/// encodes as U+FFFD: `codepoint_at_byte` reads back what this writes.
/// @param c  the codepoint to encode.
/// @return   the 1–4 UTF-8 bytes encoding `c`.
export utf8_encode :: fn(c: char) -> u8[] {
    // ASCII first: the VM calls `scalar_or_replacement`, it does not inline it.
    if u32(c) < 0x80 {
        return [u8(c)]
    }
    cp :: scalar_or_replacement(u32(c))
    out: u8[]: []
    if cp < 0x800 {
        out.push(u8(0xC0 | (cp >> 6)))
        out.push(u8(0x80 | (cp & 0x3F)))
    } else if cp < 0x10000 {
        out.push(u8(0xE0 | (cp >> 12)))
        out.push(u8(0x80 | ((cp >> 6) & 0x3F)))
        out.push(u8(0x80 | (cp & 0x3F)))
    } else {
        out.push(u8(0xF0 | (cp >> 18)))
        out.push(u8(0x80 | ((cp >> 12) & 0x3F)))
        out.push(u8(0x80 | ((cp >> 6) & 0x3F)))
        out.push(u8(0x80 | (cp & 0x3F)))
    }
    return out
}

// `cp`, or U+FFFD when it is no Unicode scalar value.
scalar_or_replacement :: fn(cp: u32) -> u32 =
    if cp >= 0xD800 && cp <= 0xDFFF || cp > 0x10FFFF {
        return u32(REPLACEMENT_CHAR)
    } else {
        return cp
    }

// ---- decode ---------------------------------------------------------------

/// Decode the UTF-8 codepoint at byte offset `i` of a string, read in place: the
/// codepoint and the bytes it spans. Advance a byte cursor by that width to land
/// on the next codepoint. Malformed bytes decode as `U+FFFD`, spanning the longest
/// prefix of a well-formed sequence and at least one byte: the substitution
/// Unicode recommends and WHATWG decoders apply. Every codepoint walk in the
/// standard library steps this way, so `len`, `s[i]` and `for c in s` agree on any
/// bytes.
/// @param s  the source string.
/// @param i  byte offset. Traps if `i >= s.byte_len()`.
/// @return   `[codepoint, byte_width]`, the width 1 to 4.
/// @example
///   [c, width] :: "é!".codepoint_at_byte(0)   // ['é', 2]
export codepoint_at_byte :: fn(s: string, i: usize) -> [char, usize] {
    b :: s.byte_at(i)
    if b < 0x80 {
        return [char(b), 1]
    }
    return decode_tail(s, b, i)
}

// The non-ASCII half of `codepoint_at_byte`: the codepoint the byte `b` at byte
// `i` of `s` leads, and its width. It runs once per non-ASCII codepoint of every
// walk, so it calls nothing the VM would not inline and reads each byte once.
decode_tail :: fn(s: string, b: u8, i: usize) -> [char, usize] {
    // A continuation byte, an overlong lead (`C0`, `C1`) and a lead past U+10FFFF
    // (`F5..FF`) lead nothing.
    if b < 0xC2 || b > 0xF4 {
        return [REPLACEMENT_CHAR, 1]
    }
    n :: s.byte_len()
    if i + 1 >= n {
        return [REPLACEMENT_CHAR, 1]
    }
    b1 :: s.byte_at(i + 1)
    if !b1.is_utf8_continuation() {
        return [REPLACEMENT_CHAR, 1]
    }
    if b < 0xE0 {
        return [char(((u32(b) & 0x1F) << 6) | (u32(b1) & 0x3F)), 2]
    }
    // A second byte below `A0` after `E0` encodes an overlong form, one above `9F`
    // after `ED` a surrogate; below `90` after `F0` an overlong form, above `8F`
    // after `F4` a codepoint past U+10FFFF.
    if b < 0xF0 {
        if b == 0xE0 && b1 < 0xA0 || b == 0xED && b1 > 0x9F {
            return [REPLACEMENT_CHAR, 1]
        }
    } else if b == 0xF0 && b1 < 0x90 || b == 0xF4 && b1 > 0x8F {
        return [REPLACEMENT_CHAR, 1]
    }
    if i + 2 >= n {
        return [REPLACEMENT_CHAR, 2]
    }
    b2 :: s.byte_at(i + 2)
    if !b2.is_utf8_continuation() {
        return [REPLACEMENT_CHAR, 2]
    }
    if b < 0xF0 {
        return [char(((u32(b) & 0x0F) << 12) | ((u32(b1) & 0x3F) << 6) | (u32(b2) & 0x3F)), 3]
    }
    if i + 3 >= n {
        return [REPLACEMENT_CHAR, 3]
    }
    b3 :: s.byte_at(i + 3)
    if !b3.is_utf8_continuation() {
        return [REPLACEMENT_CHAR, 3]
    }
    cp :: ((u32(b) & 0x07) << 18) | ((u32(b1) & 0x3F) << 12) | ((u32(b2) & 0x3F) << 6) |
        (u32(b3) & 0x3F)
    return [char(cp), 4]
}

// ---- codepoint index ------------------------------------------------------

/// Codepoint length of `s`: the number of Unicode codepoints, not bytes. In the
/// prelude, so `s.len()` works without importing `std/string`. Counts the steps
/// of `codepoint_at_byte` over the bytes, so it is the number of codepoints `for c
/// in s` yields. O(n) in the byte length.
/// @param s  source string.
/// @return   the codepoint count.
export len :: fn(s: string) -> usize {
    // Its own walk rather than `walk_codepoints`, whose step budget is a second
    // test on every byte.
    n :: s.byte_len()
    i := ascii_prefix(s)
    count := i
    for i < n {
        b :: s.byte_at(i)
        if b < 0x80 {
            i += 1
        } else {
            i += decode_tail(s, b, i).1
        }
        count += 1
    }
    return count
}

// The bytes `ascii_prefix` tests at once.
ASCII_BLOCK: usize: 64

// How many leading bytes of `s` are ASCII, counted in whole blocks: a block of a
// fixed length the C compiler vectorises, the first one holding a non-ASCII byte
// ending the count.
ascii_prefix :: fn(s: string) -> usize {
    n :: s.byte_len()
    i: usize = 0
    for i + ASCII_BLOCK <= n {
        bits: u8 = 0
        for k in i..<i + ASCII_BLOCK {
            bits = bits | s.byte_at(k)
        }
        if bits >= 0x80 {
            return i
        }
        i += ASCII_BLOCK
    }
    return i
}

// The byte offset `count` codepoints past byte `start` of `s`, clamped to its end.
codepoint_offset :: fn(s: string, start: usize, count: usize) -> usize =
    walk_codepoints(s, start, count).0

// Step `count` codepoints from byte `start` of `s`, fewer if it ends first: the byte
// offset reached and the steps taken. Steps through `decode_tail` without building
// the pair for an ASCII byte, which the VM would pay for at every one.
walk_codepoints :: fn(s: string, start: usize, count: usize) -> [usize, usize] {
    n :: s.byte_len()
    i := start
    k: usize = 0
    for i < n && k < count {
        b :: s.byte_at(i)
        if b < 0x80 {
            i += 1
        } else {
            i += decode_tail(s, b, i).1
        }
        k += 1
    }
    return [i, k]
}

// The codepoints `r` spans, none when it ends before it starts.
codepoint_count :: fn(r: Range<usize>) -> usize {
    end := r.end
    if r.inclusive {
        end += 1
    }
    if end < r.start {
        return 0
    }
    return end - r.start
}

/// `s[i]`: the codepoint at codepoint index `i`, found by walking `s` from its
/// start. Traps past the last codepoint, where the walk lands on the length.
string implements Index<usize, char> {
    at :: fn(self, i: usize) -> char = self.codepoint_at_byte(codepoint_offset(self, 0, i)).0
}

/// `s[lo..<hi]` and `s[lo..=hi]`: the codepoints of a range, as a string. Bounds past
/// the end clamp to it, and a range ending before it starts gives the empty string.
string implements Index<Range<usize>, string> {
    at :: fn(self, r: Range<usize>) -> string {
        lo :: codepoint_offset(self, 0, r.start)
        return self.byte_slice(lo, codepoint_offset(self, lo, codepoint_count(r)))
    }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// Assert that `s` decodes to exactly `want`, one `codepoint_at_byte` step each.
assert_decodes :: fn(s: string, want: char[]) -> void {
    i: usize = 0
    k: usize = 0
    for i < s.byte_len() {
        [c, width] :: s.codepoint_at_byte(i)
        assert(k < want.len() && c == want[k], "codepoint ${k} of the walk")
        i += width
        k += 1
    }
    assert_eq(k, want.len())
    assert_eq(i, s.byte_len())
}

@test test_codepoint_at_byte_every_width :: fn() -> void {
    // "aé€😀" = 61 C3 A9 E2 82 AC F0 9F 98 80.
    assert_decodes("aé€😀", ['a', 'é', '€', '😀'])
}

@test test_codepoint_at_byte_malformed :: fn() -> void {
    // The example of the Unicode standard, table 3-8: each maximal subpart of a
    // well-formed sequence decodes as one U+FFFD.
    s :: bytes_to_string([0x61, 0xF1, 0x80, 0x80, 0xE1, 0x80, 0xC2]) +
        bytes_to_string([0x62, 0x80, 0x63, 0x80, 0xBF, 0x64])
    f :: REPLACEMENT_CHAR
    assert_decodes(s, ['a', f, f, f, 'b', f, 'c', f, f, 'd'])
}

@test test_codepoint_at_byte_rejects_what_utf8_forbids :: fn() -> void {
    f :: REPLACEMENT_CHAR
    // An overlong '/' (C0 AF), a surrogate (ED A0 80), a codepoint past U+10FFFF
    // (F4 90 80 80): no byte after the lead is consumed.
    assert_decodes(bytes_to_string([0xC0, 0xAF]), [f, f])
    assert_decodes(bytes_to_string([0xED, 0xA0, 0x80]), [f, f, f])
    assert_decodes(bytes_to_string([0xF4, 0x90, 0x80, 0x80]), [f, f, f, f])
    // A lead followed by ASCII keeps the ASCII.
    assert_decodes(bytes_to_string([0xC3, 0x78]), [f, 'x'])
}

@test test_utf8_encode_writes_what_decodes_back :: fn() -> void {
    // A surrogate and a value past U+10FFFF are no scalar value: U+FFFD.
    assert_decodes(utf8_encode(char(0xD800)).bytes_to_string(), [REPLACEMENT_CHAR])
    assert_decodes(utf8_encode(char(0x110000)).bytes_to_string(), [REPLACEMENT_CHAR])
    assert_decodes(utf8_encode('😀').bytes_to_string(), ['😀'])
}

@test test_len_counts_what_the_walk_decodes :: fn() -> void {
    assert_eq(bytes_to_string([0x80, 0x41, 0x42, 0x43]).len(), 4)
    assert_eq(bytes_to_string([0x63, 0x61, 0x66, 0xE9, 0x21]).len(), 5)
    assert_eq(bytes_to_string([0x61, 0xE2, 0x82]).len(), 2)
}

@test test_string_index_malformed :: fn() -> void {
    // "café!" in Latin-1: E9 leads a three-byte sequence the '!' does not continue.
    s :: bytes_to_string([0x63, 0x61, 0x66, 0xE9, 0x21])
    assert_eq(s[3], REPLACEMENT_CHAR)
    assert_eq(s[4], '!')
    assert_eq(s[3..<5].byte_len(), 2)
}

@test test_is_utf8_continuation :: fn() -> void {
    assert(!is_utf8_continuation(0x41), "ASCII is not a continuation byte")
    assert(!is_utf8_continuation(0xC3), "a leading byte is not a continuation byte")
    assert(is_utf8_continuation(0xA9), "0xA9 is a continuation byte")
}

@test test_codepoint_at_byte_truncated :: fn() -> void {
    // A three-byte lead with one byte left after it: one U+FFFD over both.
    assert_decodes(bytes_to_string([0x61, 0xE2, 0x82]), ['a', REPLACEMENT_CHAR])
}

@test test_string_index_every_width :: fn() -> void {
    // "aé€😀": one codepoint of each UTF-8 width.
    assert_eq("aé€😀"[0], 'a')
    assert_eq("aé€😀"[1], 'é')
    assert_eq("aé€😀"[2], '€')
    assert_eq("aé€😀"[3], '😀')
}

@test test_string_slice_by_codepoints :: fn() -> void {
    assert_eq("aé€😀"[1..<3], "é€")
    assert_eq("aé€😀"[1..=3], "é€😀")
    assert_eq("aé€😀"[2..<99], "€😀")
    assert_eq("aé€😀"[3..<1], "")
}
