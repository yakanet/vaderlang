// std/core: auto-imported in every Vader program.
//
// Layout :
//   1. Trait declarations (Display, Equals, Comparable, Hash, Clone,
//      arithmetic, indexing, containment, iteration, error)
//   2. Core type definitions and their impls (Stop, Range) + the
//      blanket array / Display→string impls
//
// The primitive-type impls (Display, Equals, Hash, Comparable, Step,
// arithmetic, string) live in the sibling `primitives.vader`: same
// `module "std/core"`, split out so neither file outgrows ~500 LoC.
//
// The base `Error` trait marking the error side of a union lives in §1 ; the
// concrete error structs are user-defined.

module "std/core"

// ---- 1. Trait declarations ------------------------------------------------

/// Convert a value to its canonical string form. Drives compile-time
/// string interpolation (`"${value}"`) and the `print` / `println` family
/// in `std/io`. Every primitive type ships an `@intrinsic` impl ; user
/// types opt in by declaring their own `to_string`.
export Display :: trait {
    to_string :: fn(self) -> string
}

/// Structural equality. Powers the `==` and `!=` operators : `a != b` is
/// `!a.equals(b)`, so the two cannot disagree.
export Equals :: trait {
    equals :: fn(self, other: Self) -> bool
}

/// Total ordering. Powers `<` / `<=` / `>` / `>=` : `a < b` is
/// `a.compare(b) < 0`, so an impl provides `compare` alone and the four operators
/// cannot disagree with it.
///
/// `compare(a, b)` must return:
///
/// - `< 0` when `a` is strictly less than `b`,
/// - `= 0` when they're equal,
/// - `> 0` when `a` is strictly greater than `b`.
export Comparable :: trait {
    compare :: fn(self, other: Self) -> i32
}

/// Hash codes for `MutableMap` / `MutableSet` keys: equal values (`Equals`), equal hashes.
/// A map's first probe reads the LOW bits; a key varying only in high ones should mix them down.
export Hash :: trait {
    hash :: fn(self) -> u64
}

/// Advance one position along a discrete sequence. Sole obligation : `step()`
/// returns the *next* value after `self`. Used by `Range[T : Step & Comparable]
/// implements Iterator<T>` so a single generic impl covers every integer
/// width plus `char`: concrete `+ 1` / codepoint-bump logic lives in each
/// primitive's `Step` impl instead of being repeated per `Range<T>` impl.
export Step :: trait {
    step :: fn(self) -> Self
}

/// Explicit deep copy. `clone(x)` (free function) dispatches into this
/// when `T: Clone` ; primitive types don't need it (value-typed by
/// default).
export Clone :: trait {
    clone :: fn(self) -> Self
}

/// Type-to-type conversion. Two surfaces :
///   - **Implicit** : when a value of type `S` flows into a slot
///     expecting `Target` and `S implements Into<Target>`, the compiler
///     inserts `value.into()` at the boundary. Sites : call args with a
///     typed parameter, `return` values, `x: T = v`, struct-literal
///     fields, and the receiver of a method call no function takes as is.
///   - **Explicit** : `Target(value)`, the same `Type(value)` syntax
///     that performs primitive numeric casts (`u32(x)`, `i64(x)`). When
///     `Target` is a user type, the compiler routes the call through
///     the matching `Into` impl instead of emitting a primitive cast.
///
/// Coercion is **not** transitive (`A → B → C` never auto-chains), and
/// `T implements Into<T>` is forbidden. SPEC §4 *Type coercion via `Into`*
/// gives the full rules, among them which targets convert.
export Into :: trait<Target> {
    into :: fn(self) -> Target
}

/// `+` dispatch. Numeric primitives use the built-in bytecode op directly ;
/// user types implement `Add` to opt into the operator form. `Rhs` is the
/// right-operand type and `Out` the result: both default to `Self`, so the
/// common homogeneous case is just `implements Add`; heterogeneous operators
/// (e.g. `Instant implements Add<Duration, Instant>`) spell the params.
export Add :: trait<Rhs = Self, Out = Self> { add :: fn(self, other: Rhs) -> Out }
/// `-` dispatch. See `Add`.
export Sub :: trait<Rhs = Self, Out = Self> { sub :: fn(self, other: Rhs) -> Out }
/// `*` dispatch. See `Add`.
export Mul :: trait<Rhs = Self, Out = Self> { mul :: fn(self, other: Rhs) -> Out }
/// `/` dispatch. See `Add`.
export Div :: trait<Rhs = Self, Out = Self> { div :: fn(self, other: Rhs) -> Out }
/// `%` dispatch. See `Add`.
export Rem :: trait<Rhs = Self, Out = Self> { rem :: fn(self, other: Rhs) -> Out }

/// The additive identity of a type: what a sum of no elements is. A static
/// member : called on the type, `T.zero()` in a body bounded by `T: Zero`.
export Zero :: trait {
    /// The value `z` for which `z + x == x`.
    zero :: fn() -> Self
}

/// Whether `self` is its type's zero, compared with `==`.
///
/// @param self  the value to test.
export is_zero :: fn<T: Zero & Equals>(self: T) -> bool = self == T.zero()

/// The multiplicative identity of a type: what a product of no elements is. A
/// static member, like `Zero.zero`.
export One :: trait {
    /// The value `u` for which `u * x == x`.
    one :: fn() -> Self
}

/// Bit-level view of a float as its raw IEEE 754 integer pattern. This is NOT a
/// numeric conversion : `u64(x)` truncates the VALUE (`3.7 → 3`), whereas
/// `x.to_bits()` returns the exact bits (`3.0 → 0x4008000000000000`). The
/// inverse is `BitsFloat::from_bits`. Powers shortest-double formatting and any
/// float bit-fiddling, with no per-target runtime symbol (lowers to a `union`
/// cast). Mirrors Rust's `f64::to_bits` / `f64::from_bits` (deliberately
/// distinct from the `as`/cast conversion).
export FloatBits :: trait {
    /// The raw IEEE 754 bit pattern of `self`.
    to_bits :: fn(self) -> u64
}

/// Inverse of `FloatBits`: reconstruct an `f64` from a raw IEEE 754 bit pattern.
export BitsFloat :: trait {
    /// Reinterpret `self`'s bits as an `f64` (NOT `f64(self)`, which widens the
    /// integer value).
    from_bits :: fn(self) -> f64
}

/// 32-bit analogue of `FloatBits` : the raw IEEE 754 `u32` bit pattern of an
/// `f32` (NOT `u32(self)`, which truncates the value). Powers the pure-Vader
/// shortest-`f32` formatter (Ryu f2s). Inverse is `Bits32Float::from_bits`.
export Float32Bits :: trait {
    /// The raw IEEE 754 bit pattern of `self`.
    to_bits :: fn(self) -> u32
}

/// Inverse of `Float32Bits`: reconstruct an `f32` from a raw IEEE 754 `u32`
/// bit pattern (NOT `f32(self)`, which widens the integer value).
export Bits32Float :: trait {
    /// Reinterpret `self`'s bits as an `f32`.
    from_bits :: fn(self) -> f32
}

/// Indexed read: `a[i]` dispatches through this when `a` isn't a built-in
/// array. `I` is the index type, `T` the element type.
export Index :: trait<I, T> {
    at :: fn(self, i: I) -> T
}
/// Indexed write: `a[i] = v`. Symmetric with `Index`.
export IndexSet :: trait<I, T> {
    set_at :: fn(self, i: I, v: T)
}

/// Membership test. `x in coll` desugars to `coll.contains(x)` ;
/// `x !in coll` desugars to `!coll.contains(x)`. Implemented by `Range`
/// (for the integer / char ranges), `MutableMap`, `MutableSet`, and any
/// user type that wants infix `in` support.
export Contains :: trait<T> {
    contains :: fn(self, value: T) -> bool
}

/// What `Iterator.next` returns once the iteration is over.
export Stop :: struct {}

/// The value an iterator returns at its end. Return it rather than a fresh
/// `Stop {}`, which allocates.
export STOP :: Stop {}

/// Pull-based iterator. The lowerer dispatches `for x in iter` through
/// the impl table: users never call `next` directly. What consumes one
/// (`count`, `last`, `collect`, `find`...) is a free function over
/// `Iterator<T>` in `std/iter`, a `for` over its argument.
///
/// `next()` hands back the next element, or `STOP` once there is none. A `null`
/// element is just an element: `T = U | null` returns `U | null | Stop`.
export Iterator :: trait<T> {
    next :: fn(self) -> T | Stop
}

/// Base trait for every error type usable in `T | Error` returns. Any struct
/// implementing `Error` participates in such error unions ; a caller narrows
/// on it (`if r is Error`) and returns it to propagate.
///
/// @return  short human-readable message: used by `Display`-style
///          renderers, never parsed.
export Error :: trait {
    message :: fn(self) -> string
}

// ---- 2. Core struct definitions -------------------------------------------

/// Sentinel returned by `Async.resume` when the coroutine suspended (it awaited
/// something not yet ready) rather than completing. `T | Suspended` stays
/// unambiguous because `Suspended` is a distinct nominal type, as `Stop` is for
/// `Iterator.next`.
export Suspended :: struct {
    /// The scheduler time (`sched_now`, in ms) before which resuming again cannot
    /// make progress: a driver holding several awaitables re-drives this one only
    /// once the clock reaches it. `0`, the default, means unknown: re-drive it on
    /// every wake. A coroutine reports the value of the child it is parked on.
    wake_at: i64 = 0
}

/// The awaitable produced by calling an `async fn`: `await e` unwraps
/// `Async<T>` to `T`. Each `async fn`'s synthesised state struct implements
/// it (wired in lowering). Carries no error semantics of its own ; a fallible
/// async fn returns `Async<T | SomeError>`.
export Async :: trait<T> {
    /// Drive the coroutine one step : returns the final value `T` on
    /// completion, or the `Suspended` sentinel when it awaited something not
    /// yet ready. Synthesised per `async fn` by lowering. The resumed value
    /// is delivered out-of-band (a synthesised erased frame slot the scheduler
    /// sets before each call), so this signature stays source-clean.
    resume :: fn(self) -> T | Suspended

    /// Tear the awaitable down without completing it : run any pending `defer`s
    /// (LIFO), recursively cancel the child it is parked on, and retire it.
    /// Called only on a not-yet-completed awaitable (a loser of `race` / `join_any` /
    /// `timeout`, or a subtree whose parent was cancelled): internal to the
    /// runtime, never invoked by user code in v1.
    ///
    /// The default is a no-op : a hand-written awaitable holding no resources
    /// needs no teardown. The compiler synthesises an override per `async fn`
    /// (drain its `defer`s + recurse into its current child) ; the concurrency
    /// combinators override it to cancel every child they own.
    cancel :: fn(self) -> void {}
}

/// One field of a struct type as exposed by the `@fields(T)` reflection
/// intrinsic. `name` is the source-level identifier ; `type` carries the
/// field's declared type as a runtime `type` value.
export Field :: struct {
    name: string
    type: type
}

/// Range produced by `0..<n` / `0..=n` and `'a'..='z'`. Generic over the
/// bound type so integer ranges (every signed / unsigned width plus
/// `i64` / `i64`) and char ranges share a single struct. The `cursor`
/// field is advanced by each `next` call via implicit struct-ref mutation.
export Range :: struct<T> {
    start:     T
    end:       T
    inclusive: bool
    /// Set once an inclusive range has handed out `end`. Its cursor stays there:
    /// a step past `end` may leave `T` (past `255` in a `u8`).
    done:      bool = false
    cursor:    T
}

// Single bounded generic impl pair covering every integer width plus `char`.
// `T : Comparable & Step` lets the bodies dispatch `<` / `<=` / `>` / `>=`
// to T's `Comparable` impl and the advance step to T's `Step` impl:
// concrete `+ 1` / codepoint-bump logic lives in those per-primitive impls
// in this same file (search for `implements Step` and `implements
// Comparable`). The mono pass materialises one specialisation per concrete
// `Range<T>` instance the program uses ; the lowerer routes each method
// call to the right primitive impl statically.

Range<T> implements<T: Comparable & Step> Contains<T> {
    contains :: fn(self, value: T) -> bool {
        if value < self.start { return false }
        if self.inclusive     { return value <= self.end }
        return value < self.end
    }
}

Range<T> implements<T: Comparable & Step> Iterator<T> {
    // One comparison per step: the bound is tested again only at the end. The
    // last value of an inclusive range sets `done` rather than stepping, which
    // could overflow at the type's greatest value.
    next :: fn(self) -> T | Stop {
        if self.done {
            return STOP
        }
        v :: self.cursor
        if v >= self.end {
            if !self.inclusive || v > self.end {
                return STOP
            }
            self.done = true
            return v
        }
        self.cursor = v.step()
        return v
    }
}

// Blanket Into impls live here so the orphan rule passes: Into is owned
// by std/core, the source shapes (`T[]`, bounded `T`) aren't.

// What an array COERCED to `Iterator<T>` becomes. `for x in arr` has its own fast
// path and never comes here.
T[] implements<T> Into<Iterator<T>> {
    into :: fn(self) -> Iterator<T> {
        for i in 0..<self.len() {
            yield self[i]
        }
    }
}

/// Membership for arrays: `v in arr` / `v !in arr` dispatch here. Linear scan
/// via `Equals`. As an
/// impl member, the monomorphised `==` devirtualises to the element's primitive
/// comparison on every backend. Blanket impl (orphan rule : `Contains` is
/// std/core's, `T[]` isn't), mirroring the `Into` blanket above.
T[] implements<T: Equals> Contains<T> {
    contains :: fn(self, value: T) -> bool {
        for item in self {
            if item == value { return true }
        }
        return false
    }
}

/// `[lhs] * n`: array repeat / preallocation, the `*` operator on arrays.
/// `[v] * n` repeats the elements `n` times (`[7, 9] * 2` → `[7, 9, 7, 9]`) ; the
/// empty-LHS form `[] * n` is the preallocation primitive (length 0, capacity `n`:
/// the `with_capacity` replacement). `*` on an array dispatches here through the
/// normal trait lookup : a concrete array matches this blanket via the `"[]"`
/// impl-key (`impl_base_key`), and the lowerer devirtualises BOTH forms to the
/// `array.repeat` intrinsic, which preserves the preallocation form and shallow
/// ref-element semantics. The body is the logical repeat fallback for any path the
/// devirt can't statically reach. The return is a fresh array the caller owns.
/// Blanket impl (orphan rule : `Mul` is std/core's, `T[]` isn't), mirroring
/// `Into` / `Contains`.
T[] implements<T> Mul<i64> {
    mul :: fn(self, other: i64) -> T[] {
        out: T[]: []
        for _ in 0..<other { out.push_all(self) }
        return out
    }
}

/// An array's text: `[`, then each element's own `Display` separated by `, `,
/// then `]`: `[1, 2]`, `[a, b]`, `[[1], [2, 3]]`. Each element is rendered once,
/// then written into one buffer sized to fit them all.
T[] implements<T: Display> Display {
    to_string :: fn(self) -> string {
        parts: string[]: []
        size: i64 = 2
        for item in self {
            part :: item.to_string()
            size += part.byte_len()
            parts.push(part)
        }
        if parts.len() > 1 {
            size += 2 * (parts.len() - 1)
        }
        buffer :: new_byte_buffer(size)
        offset := buffer.write_string_at(0, "[")
        for i in 0..<parts.len() {
            if i > 0 {
                offset = buffer.write_string_at(offset, ", ")
            }
            offset = buffer.write_string_at(offset, parts[i])
        }
        offset = buffer.write_string_at(offset, "]")
        return buffer.finish_buffer(offset)
    }
}

T implements<T: Display> Into<string> {
    into :: fn(self) -> string {
        return self.to_string()
    }
}

