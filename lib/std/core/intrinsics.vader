// std/core/intrinsics: the operations the toolchain performs for the standard
// library.
//
// The toolchain that runs a program implements `Intrinsic` for it: the VM when
// it interprets the program, the native runtime when it is compiled, as the
// target gives `VADER_OS` its value. No Vader type implements it. Its members
// are called on the trait itself, `Intrinsic.byte_len(s)`, and the standard
// library wraps the ones a program calls in functions of its own (`byte_len`).
// What they are is unstable: a program calls the standard library, not these.

module "std/core"

import "std/target"

/// The operations the toolchain performs: the VM and the native runtime each
/// implement every member.
export Intrinsic :: trait {
    // ---- strings --------------------------------------------------------

    /// Byte length of `s` (its UTF-8 byte count).
    byte_len :: fn(s: string) -> i64
    /// The byte at index `i` of `s`.
    byte_at :: fn(s: string, i: i64) -> u8
    /// The bytes of `s` from `start` to `end`, excluded, as a string.
    byte_slice :: fn(s: string, start: i64, end: i64) -> string
    /// Whether every byte of `s` is ASCII.
    is_ascii :: fn(s: string) -> bool
    /// The bytes of `s`, a view that aliases the interned string.
    bytes :: fn(s: string) -> u8[]
    /// The string that holds the bytes `bs`.
    bytes_to_string :: fn(bs: u8[]) -> string
    /// The hash of `s`, computed once when it is interned.
    string_hash :: fn(s: string) -> u64
    /// `a` against `b`, byte by byte: negative when `a` sorts first, 0 when they
    /// are equal, positive otherwise.
    string_compare :: fn(a: string, b: string) -> i32

    // ---- floats ---------------------------------------------------------

    /// The IEEE 754 bit pattern of `x`.
    f64_to_bits :: fn(x: f64) -> u64
    /// The `f64` whose IEEE 754 bit pattern is `bits`.
    bits_to_f64 :: fn(bits: u64) -> f64
    /// The IEEE 754 bit pattern of `x`.
    f32_to_bits :: fn(x: f32) -> u32
    /// The `f32` whose IEEE 754 bit pattern is `bits`.
    bits_to_f32 :: fn(bits: u32) -> f32

    // ---- values ---------------------------------------------------------

    /// A copy of `value` that shares nothing it can write, walked by the layout
    /// of each type it reaches: one host per type copied.
    deep_copy :: fn<T>(value: T) -> T

    // ---- arrays ---------------------------------------------------------

    /// Number of live elements of `xs`.
    array_len :: fn<T>(xs: T[]) -> i64
    /// Append `value` to `xs`, growing its storage as needed.
    array_push :: fn<T>(xs: T[], value: T) -> void
    /// Append every element of `other` to `xs`.
    array_push_all :: fn<T>(xs: T[], other: T[]) -> void
    /// Copy `count` elements of `xs` from `source_offset` into `destination` from
    /// `destination_offset`.
    array_copy_to :: fn<T>(
        xs: T[],
        source_offset: i64,
        destination: T[],
        destination_offset: i64,
        count: i64,
    ) -> void
    /// Remove and return the last element of `xs` ; null when it is empty.
    array_remove_last :: fn<T>(xs: T[]) -> T | null
    /// Drop every element of `xs`, keeping its capacity.
    array_clear :: fn<T>(xs: T[]) -> void

    // ---- byte buffers ---------------------------------------------------

    /// A `Buffer` of `cap` zeroed bytes.
    new_byte_buffer :: fn(cap: i64) -> Buffer
    /// The byte of `buffer` at `offset`.
    buffer_load_u8 :: fn(buffer: Buffer, offset: i64) -> u8
    /// Write `value` at `offset` of `buffer`.
    buffer_store_u8 :: fn(buffer: Buffer, offset: i64, value: u8) -> void
    /// Copy `count` bytes of `source` from `source_offset` into `buffer` from
    /// `offset`, the two ranges free to overlap.
    buffer_memory_copy :: fn(
        buffer: Buffer,
        offset: i64,
        source: Buffer,
        source_offset: i64,
        count: i64,
    ) -> void
    /// The string that holds the first `len` bytes of `buffer`.
    buffer_intern_string :: fn(buffer: Buffer, len: i64) -> string
    /// Copy the bytes of `s` into `buffer` from `offset`.
    buffer_write_string :: fn(buffer: Buffer, offset: i64, s: string) -> void

    // ---- the collector --------------------------------------------------

    /// Run a full collection.
    collect :: fn() -> void
    /// The number of collections run since the process started.
    collections :: fn() -> i64
    /// The bytes in use, old and young generations.
    bytes_used :: fn() -> i64
    /// The bytes copied by every collection since the process started.
    bytes_copied :: fn() -> i64
    /// The bytes requested from the collector since the process started.
    allocated_bytes :: fn() -> i64
    /// The number of allocations made through the collector.
    allocations :: fn() -> i64
    /// Count every allocation from now on.
    count_allocations :: fn() -> void

    // ---- threads --------------------------------------------------------

    /// Start a thread running `entry`, and hand back its handle.
    spawn_thread :: fn(entry: fn() -> void) -> i64
    /// Suspend the running thread until another wakes it.
    park :: fn() -> void
    /// Make the thread `thread` ready to run.
    wake :: fn(thread: i64) -> void
    /// Suspend the running thread for `nanos` nanoseconds.
    sleep_for :: fn(nanos: i64) -> void
    /// Cancel the thread `thread`.
    cancel_thread :: fn(thread: i64) -> void
    /// The handle of the running thread.
    current_thread :: fn() -> i64
    /// Whether the running thread was cancelled.
    is_cancelled :: fn() -> bool
    /// Whether the thread `thread` is leaving.
    is_leaving :: fn(thread: i64) -> bool
    /// Wake the parked threads once `fd` has something to read.
    watch_readable :: fn(fd: i64) -> void
    /// Wake the parked threads once the child `child` has ended.
    watch_exit :: fn(child: i64) -> void
    /// Take the monitor over the state tasks share, for the running thread ;
    /// `publishes` when the holder stores in that state values it made before.
    monitor_enter :: fn(publishes: bool) -> void
    /// Let go of the monitor once.
    monitor_exit :: fn() -> void

    // ---- waits on a descriptor ------------------------------------------

    /// Park until `fd` has something to read.
    wait_readable :: fn(fd: i64) -> void
    /// Park until `fd` has something to read, `nanos` at most.
    wait_readable_for :: fn(fd: i64, nanos: i64) -> bool
    /// Park until `fd` has room to write.
    wait_writable :: fn(fd: i64) -> void
    /// Park until `fd` has room to write, `nanos` at most.
    wait_writable_for :: fn(fd: i64, nanos: i64) -> bool
    /// Forget what the threads parked on `fd` wait for.
    stop_waiting :: fn(fd: i64) -> void

    // ---- the process ----------------------------------------------------

    /// Stop the program with `msg`.
    panic :: fn(msg: string) -> void
    /// The OS the process runs on.
    current_os :: fn() -> Os
    /// The architecture the process runs on.
    current_arch :: fn() -> Arch

    // ---- foreign calls from the VM --------------------------------------

    /// Open the shared library `name`, by the platform's search ; 0 when absent.
    ffi_open :: fn(name: string) -> i64
    /// Open the shared library at `path` ; 0 when it cannot be opened.
    ffi_open_path :: fn(path: string) -> i64
    /// The address of `symbol` in `lib` ; 0 when absent.
    ffi_symbol :: fn(lib: i64, symbol: string) -> i64
    /// Call `fn_ptr` as `desc` describes it, its arguments laid out in `frame`.
    ffi_call :: fn(fn_ptr: i64, desc: u8[], frame: u8[], nfixed: i64) -> string
    /// Call the adapter `fn_ptr`, which reads its arguments from `frame`.
    ffi_call_frame :: fn(fn_ptr: i64, desc: u8[], frame: u8[]) -> string
}
