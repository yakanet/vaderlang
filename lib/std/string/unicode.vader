// std/string/unicode — the codepoint side of the UTF-8 codec.
//
// The width a `char` takes once encoded, and UTF-16 surrogates. The encoder, the
// decoder, the byte classification, `len` and `s[i]` sit in the prelude
// (`std/core/utf8.vader`); the codepoint iterator (`chars`, `StringChars`) in
// `string.vader`.

module "std/string"

// ---- constants ------------------------------------------------------------

/// The highest Unicode scalar value (U+10FFFF), `@max(char)`. Codepoints above
/// this are invalid ; `\u{...}` escapes past it are rejected.
export MAX_CODEPOINT :: char(0x10FFFF)

// ---- widths ---------------------------------------------------------------

/// UTF-8 encoded byte length (1–4) of codepoint `c`, as `utf8_encode` writes it:
///   - `U+0000..U+007F`     → 1 byte
///   - `U+0080..U+07FF`     → 2 bytes
///   - `U+0800..U+FFFF`     → 3 bytes
///   - `U+10000..U+10FFFF`  → 4 bytes
///
/// The width a `char` takes once encoded, not the width it was decoded from:
/// `codepoint_at_byte` answers that one.
/// @param c  the codepoint to measure.
/// @return   its UTF-8 encoded length in bytes (1, 2, 3, or 4).
export codepoint_byte_len :: fn(c: char) -> usize {
    cp :: u32(c)
    if cp < 0x80    { return 1 }
    if cp < 0x800   { return 2 }
    if cp < 0x10000 { return 3 }
    return 4
}

// ---- UTF-16 surrogates ----------------------------------------------------
//
// Surrogates encode astral codepoints (U+10000..U+10FFFF) as a pair of 16-bit
// code units. They exist only in UTF-16, never as a well-formed UTF-8 sequence nor
// as a `char`, but Vader has to speak UTF-16 at two boundaries: JSON `\uXXXX`
// escapes and the LSP `positionEncoding = utf-16`. A code unit is a `u32` here.

/// True for a high (leading) surrogate code unit, `0xD800..0xDBFF`.
export is_high_surrogate :: fn(unit: u32) -> bool = unit >= 0xD800 && unit <= 0xDBFF

/// True for a low (trailing) surrogate code unit, `0xDC00..0xDFFF`.
export is_low_surrogate :: fn(unit: u32) -> bool = unit >= 0xDC00 && unit <= 0xDFFF

/// True for either half of a surrogate pair, `0xD800..0xDFFF`: no `char` holds
/// one, and a decoder that sees one in isolation substitutes `REPLACEMENT_CHAR`.
export is_surrogate :: fn(unit: u32) -> bool = unit >= 0xD800 && unit <= 0xDFFF

/// Recombine a UTF-16 surrogate pair into the astral scalar it encodes. The
/// caller must have verified `is_high_surrogate(hi)` and `is_low_surrogate(lo)`.
/// @param hi  the high surrogate (`0xD800..0xDBFF`).
/// @param lo  the low surrogate (`0xDC00..0xDFFF`).
/// @return    the recombined scalar in `U+10000..U+10FFFF`.
export combine_surrogates :: fn(hi: u32, lo: u32) -> char =
    char(0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00))

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_codepoint_byte_len :: fn() -> void {
    assert_eq(codepoint_byte_len('A'), 1)
    assert_eq(codepoint_byte_len('é'), 2)
    assert_eq(codepoint_byte_len('😀'), 4)
}

@test test_surrogate_classification :: fn() -> void {
    assert(is_high_surrogate(0xD83D), "0xD83D is a high surrogate")
    assert(is_low_surrogate(0xDE00), "0xDE00 is a low surrogate")
    assert(is_surrogate(0xD83D), "a high surrogate is a surrogate")
    assert(!is_surrogate(0x41), "ASCII is not a surrogate")
    assert(!is_high_surrogate(0xDE00), "a low surrogate is not a high surrogate")
}

@test test_combine_surrogates :: fn() -> void {
    // 😀 (U+1F600) is encoded as the surrogate pair [D83D, DE00].
    assert_eq(combine_surrogates(0xD83D, 0xDE00), '😀')
}
