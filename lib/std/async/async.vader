// std/async: run async functions, wait on time, and combine awaitables.
//
// ```
// import "std/async"
// import "std/io"
//
// fetch :: fn(n: i64) -> Async<i64> {
//     await sleep(n)
//     return n * 10
// }
//
// main :: fn() -> i32 {
//     results :: await join_all([fetch(3), fetch(1), fetch(2)])
//     println("${results}")   // [30, 10, 20]
//     return 0
// }
// ```
//
// A function that uses `await` is async: it declares `-> Async<T>` and returns a
// `T`. Calling it gives an `Async<T>`, which `await` waits on from another async
// function and `block_on` runs to completion from one that is not; `main` may
// `await` and keep its `i32`. The combinators are `join_all`, `try_join_all`,
// `race`, `join_any`, `timeout` and `share`.
//
// Single-threaded, timer-driven: the scheduler state (a virtual clock + a
// min-heap of wake deadlines) lives in the runtime (native C / VM host), reached
// through the `std/runtime` `sched_*` intrinsics.

module "std/async"

import "std/runtime"
import "std/abort"

// ---- sleep ----------------------------------------------------------------

/// The awaitable backing `sleep` : arms a wake timer on its first `resume`, then
/// parks (returns `Suspended`) until the scheduler's clock reaches its deadline.
/// Completes with `null` (an async that yields no value: `await sleep(...)`
/// discards it).
///
/// Cancellation uses `Async`'s default no-op : v1 has no `sched_disarm`, so a
/// cancelled `Sleep` leaves its timer armed. The deadline still fires harmlessly
/// (nobody re-drives it), and a lingering timer can only DELAY deadlock
/// detection, never mask it: accepted v1 debt.
Sleep :: struct {
    ms:       i64
    deadline: i64 = 0
    armed:    bool = false
}

Sleep implements Async<null> {
    resume :: fn(self) -> null | Suspended {
        if !self.armed {
            self.armed = true
            self.deadline = sched_now() + self.ms
            sched_arm(self.deadline)
        }
        if sched_now() >= self.deadline { return null }
        return Suspended { .wake_at = self.deadline }
    }
}

/// Suspend the current coroutine for at least `ms` virtual milliseconds. A
/// factory (it constructs the awaitable, it does not itself await), so it is an
/// ordinary function returning an `Async`, not a coroutine.
///
/// @param ms  the minimum delay, in milliseconds.
/// @return    an awaitable that completes once the delay elapses.
/// @example
///   await sleep(10)   // null, 10 ms later
export sleep :: fn(ms: i64) -> Async<null> = Sleep { .ms = ms }

// ---- entry driver ---------------------------------------------------------

/// Drive an `async main`'s root frame to completion and return its exit code.
/// Compiler-invoked : when `main` awaits, the program entry calls this with
/// `main()`'s `Async<i32>` frame. Resumes the root ; whenever it parks, blocks
/// on the nearest armed timer (`sched_park`) and re-drives, never spins.
///
/// @param root  the `Async<i32>` frame produced by calling the async `main`.
/// @return      main's completed `i32` exit code.
/// @error       panics on a park with no timer armed: every task is suspended
///              with nothing left to wake it (a deadlock).
export run_async_main :: fn(root: Async<i32>) -> i32 = block_on(root)

/// Drive any awaitable to completion from synchronous code, returning its
/// result. Resumes `root` and, whenever it parks, blocks on the nearest armed
/// timer (`sched_park`) then re-drives, never spins. Needs no `async main`: it
/// works over the global scheduler state, so a plain sync caller (e.g. the CLI
/// spawning subprocesses) can fan out awaitables and join them here.
///
/// @param root  the awaitable to run to completion.
/// @return      its completed value.
/// @error       panics on a park with nothing armed to wake it (a deadlock).
/// @example
///   block_on(sleep(10))   // null: the caller need not be async
export block_on :: fn<T>(root: Async<T>) -> T {
    for {
        r :: root.resume()
        if r is Suspended {
            if sched_park() == 1 {
                panic("async deadlock: a task is suspended with nothing left to wake it")
            }
        } else {
            return r
        }
    }
}

// ---- share ----------------------------------------------------------------

/// The awaitable backing `share` : drives its task until it completes, then hands
/// that result to every later `resume`. Several awaiters may drive it, each
/// `resume` advancing the one task. Cancelling it does nothing (`Async`'s
/// default), since another awaiter may still wait for the result.
Shared :: struct<T> {
    task: Async<T>
    /// What the task's last `resume` returned : `Suspended` until it completes,
    /// then its result.
    result: T | Suspended = Suspended {}
    /// True while a `resume` drives the task. A `resume` arriving then comes from
    /// inside the task, which awaits itself.
    running: bool = false
}

Shared<T> implements Async<T> {
    resume :: fn(self) -> T | Suspended {
        if self.result is Suspended {
            if self.running {
                panic("a shared task awaits itself")
            }
            self.running = true
            self.result = self.task.resume()
            self.running = false
        }
        return self.result
    }
}

/// Share `task` between any number of awaiters : the first `resume` drives it, and
/// once it completes every later one hands back its result, where a finished
/// coroutine would answer `Suspended`. Cancelling the shared awaitable leaves the
/// task to the others. The task an `async` `@singleton` hands every call.
///
/// @param task  the awaitable to share.
/// @return      an awaitable every awaiter may await.
/// @error       panics when the task awaits its own shared awaitable.
/// @example
///   once :: share(sleep(10))
///   await join_all([once, once])   // [null, null], one timer for both
export share :: fn<T>(task: Async<T>) -> Async<T> = Shared<T> { .task = task }

// ---- wake times -----------------------------------------------------------

// Later than any wake time: the starting point of `earlier`.
NEVER: i64: 0x7FFF_FFFF_FFFF_FFFF

// The earlier of two `Suspended.wake_at` values. An unknown one (`0`) wins, so a
// driver holding it reports unknown too.
earlier :: fn(a: i64, b: i64) = if a < b { a } else { b }

// ---- join_all -------------------------------------------------------------

/// Concurrent join of a group of awaitables (Model A : one awaitable that drives
/// its children on each `resume`). Children make progress together (their timers
/// all sit on the one scheduler heap and fire in deadline order) and their
/// results are returned in INPUT order once every one completes. A `resume` drives
/// only the children whose `wake_at` has passed. No cancellation in v1, so
/// `join_all` waits for every child (failure latency = the slowest child).
JoinAll :: struct<T> {
    children: Async<T>[]
    /// Completed results, in the order the children completed.
    /// Every child is joined once `results.len() == children.len()`.
    results:  T[]
    /// For each input index, where its child's result sits in `results`; -1
    /// while the child runs.
    slot:     i64[]
    /// The `wake_at` each child last reported, by input index ; `NEVER` once it
    /// is done.
    wake_at:  i64[]
}

JoinAll<T> implements Async<T[]> {
    resume :: fn(self) -> T[] | Suspended {
        n :: self.children.len()
        now :: sched_now()
        next: i64 = NEVER
        for i in 0..<n {
            if self.wake_at[i] <= now {
                r :: self.children[i].resume()
                if r is Suspended {
                    self.wake_at[i] = r.wake_at
                } else {
                    self.slot[i] = self.results.len()
                    self.results.push(r)
                    self.wake_at[i] = NEVER
                }
            }
            next = earlier(next, self.wake_at[i])
        }
        if self.results.len() != n {
            return Suspended { .wake_at = next }
        }
        out: T[]: []
        for i in 0..<n {
            out.push(self.results[self.slot[i]])
        }
        return out
    }
    // Tear down every child (a completed one is a no-op teardown). `join_all` owns
    // its children, so cancelling the join cancels the whole fan-out.
    cancel :: fn(self) -> void {
        for c in self.children { c.cancel() }
    }
}

/// Await a group of awaitables concurrently, yielding their results in input
/// order. `await join_all(xs)` completes when every element of `xs` has completed.
///
/// @param xs  the awaitables to join.
/// @return    an awaitable of the results, index-aligned with `xs`.
/// @example
///   await join_all([sleep(20), sleep(10)])   // [null, null], after 20 ms
export join_all :: fn<T>(xs: Async<T>[]) -> Async<T[]> = new_join_all(xs)

// The driver behind `join_all` and `try_join_all`: nothing joined, every child due.
new_join_all :: fn<T>(xs: Async<T>[]) = JoinAll<T> {
    .children = xs,
    .results = [],
    .slot = [-1] * xs.len(),
    .wake_at = [0] * xs.len(),
}

// ---- try_join_all (fallible join, first-error) ----------------------------

/// The awaitable backing `try_join_all`: a hand-written driver (NOT a coroutine :
/// generic async coroutines are out of v1 scope). Wraps a `JoinAll<U | E>` to do
/// the concurrent join, then scans the joined array in input order for the first
/// error. Returns that array verbatim on success, so each element keeps its
/// original boxed form (no `U[]` rebuild).
TryJoinAll :: struct<U, E> {
    inner: JoinAll<U | E>
}

TryJoinAll<U, E> implements Async<(U | E)[] | Error> {
    resume :: fn(self) -> (U | E)[] | Error | Suspended {
        r :: self.inner.resume()
        if r is Suspended { return r }
        for v in r {
            if v is Error { return v }   // first error, by input order
        }
        return r
    }
    // Delegate to the wrapped `JoinAll`: it owns the children.
    cancel :: fn(self) -> void = self.inner.cancel()
}

/// Concurrent join of FALLIBLE awaitables (children of type `U | E`). Runs every
/// child (like `join_all`: no cancellation in v1, so failure latency is the slowest
/// child), then (scanning in input order) completes with the FIRST error, or
/// the full results if none failed.
///
/// The successes come back as `(U | E)[]`, each element typed as the child union:
/// narrow per element at the use site if you need the raw `U`.
///
/// @param xs  the fallible awaitables to join.
/// @return    the results in input order, or the first `Error`.
export try_join_all :: fn<U, E>(xs: Async<U | E>[]) -> Async<(U | E)[] | Error> =
    TryJoinAll<U, E> { .inner = new_join_all(xs) }

// ---- race -----------------------------------------------------------------

/// The awaitable backing `race` : drives every child whose `wake_at` has passed on
/// each `resume` and, the moment one settles (value OR error: `race` does not
/// distinguish), cancels all the others and completes with its result.
/// Deterministic tie-break : the lowest input index wins within a tick.
Race :: struct<T> {
    children: Async<T>[]
    /// The `wake_at` each child last reported, by input index.
    wake_at:  i64[]
}

Race<T> implements Async<T> {
    resume :: fn(self) -> T | Suspended {
        n :: self.children.len()
        now :: sched_now()
        next: i64 = NEVER
        for i in 0..<n {
            if self.wake_at[i] <= now {
                r :: self.children[i].resume()
                if r is Suspended {
                    self.wake_at[i] = r.wake_at
                } else {
                    for j in 0..<n {
                        if j != i { self.children[j].cancel() }
                    }
                    return r
                }
            }
            next = earlier(next, self.wake_at[i])
        }
        return Suspended { .wake_at = next }
    }
    cancel :: fn(self) -> void {
        for c in self.children { c.cancel() }
    }
}

/// Race a group of awaitables : complete with the FIRST to settle (value or
/// error), cancelling the losers so they leave no orphaned work. Unlike
/// `join_all`, the return type is a single `T`: the winner's result.
///
/// @param xs  the awaitables to race.
/// @return    an awaitable of the first to settle.
/// @example
///   await race([sleep(20), sleep(10)])   // null, after 10 ms: the 20 ms sleep is cancelled
export race :: fn<T>(xs: Async<T>[]) -> Async<T> = Race<T> {
    .children = xs,
    .wake_at = [0] * xs.len(),
}

// ---- join_any -------------------------------------------------------------

/// The awaitable backing `join_any` : like `race`, but a settled ERROR is not a win,
/// the child is retired and the others keep running. Completes with the FIRST
/// SUCCESS (cancelling the losers), or (if every child fails): the last error.
JoinAny :: struct<U, E> {
    children: Async<U | E>[]
    /// The `wake_at` each child last reported, by input index ; `NEVER` once it
    /// settled as an error.
    wake_at:  i64[]
    /// How many children settled as an error.
    failed:   i64 = 0
    /// The most recent error: returned if every child ends up failing.
    last:     (U | E) | null = null
}

JoinAny<U, E> implements Async<U | E> {
    resume :: fn(self) -> (U | E) | Suspended {
        n :: self.children.len()
        now :: sched_now()
        next: i64 = NEVER
        for i in 0..<n {
            if self.wake_at[i] <= now {
                r :: self.children[i].resume()
                if r is Suspended {
                    self.wake_at[i] = r.wake_at
                } else {
                    // Bound before the `is Error` test, which narrows `r` to the
                    // trait : `settled` keeps the child's own `U | E`.
                    settled :: r
                    if r is Error {
                        self.wake_at[i] = NEVER
                        self.failed += 1
                        self.last = settled
                    } else {
                        for j in 0..<n {
                            if j != i {
                                self.children[j].cancel()
                            }
                        }
                        return r
                    }
                }
            }
            next = earlier(next, self.wake_at[i])
        }
        if self.failed == n {
            l :: self.last
            if l != null { return l }
        }
        return Suspended { .wake_at = next }
    }
    cancel :: fn(self) -> void {
        for c in self.children { c.cancel() }
    }
}

/// Await a group of FALLIBLE awaitables (children of type `U | E`), completing
/// with the FIRST success and cancelling the rest. If every child fails,
/// completes with the last error. The dual of `try_join_all` (first success vs first
/// error).
///
/// @param xs  the fallible awaitables to race for a success.
/// @return    the first successful result, or the last error if all fail.
export join_any :: fn<U, E>(xs: Async<U | E>[]) -> Async<U | E> =
    JoinAny<U, E> { .children = xs, .wake_at = [0] * xs.len() }

// ---- timeout --------------------------------------------------------------

/// Error completing a `timeout` when its deadline elapses before the awaited
/// value is ready.
export TimeoutError :: struct {
    /// The deadline that elapsed, in milliseconds.
    ms: i64
}

TimeoutError implements Error {
    message :: fn(self) -> string = "operation timed out after ${self.ms}ms"
}

/// The awaitable backing `timeout` : each `resume` drives the child first, then
/// (only if the child is not ready) the timer. Whoever settles first wins (the
/// child's value, or a `TimeoutError` once the timer fires) and the loser is
/// cancelled.
Timeout :: struct<T> {
    child: Async<T>
    timer: Async<null>
    ms:    i64
}

Timeout<T> implements Async<T | TimeoutError> {
    resume :: fn(self) -> T | TimeoutError | Suspended {
        rc :: self.child.resume()
        if rc is Suspended {
            rt :: self.timer.resume()
            if rt is Suspended {
                return if rc.wake_at <= rt.wake_at { rc } else { rt }
            }
            // Timer fired first: cancel the pending child, report the timeout.
            self.child.cancel()
            return TimeoutError { .ms = self.ms }
        }
        // Child completed first: cancel the timer (a no-op in v1), return it.
        self.timer.cancel()
        return rc
    }
    cancel :: fn(self) -> void {
        self.child.cancel()
        self.timer.cancel()
    }
}

/// Await `x`, but fail with a `TimeoutError` if it is not ready within `ms`
/// virtual milliseconds. The losing side (the child on timeout, the timer on
/// success) is cancelled.
///
/// @param ms  the deadline, in milliseconds.
/// @param x   the awaitable to bound.
/// @return    `x`'s result, or a `TimeoutError` if the deadline elapses first.
/// @example
///   await timeout(10, sleep(50))   // a TimeoutError, after 10 ms
///   await timeout(50, sleep(10))   // null, after 10 ms
export timeout :: fn<T>(ms: i64, x: Async<T>) -> Async<T | TimeoutError> =
    Timeout<T> { .child = x, .timer = sleep(ms), .ms = ms }

// ---- tests ----------------------------------------------------------------

import "std/testing"

// What `v` gives once `ms` have passed.
value_after :: fn(ms: i64, v: i32 | null) -> Async<i32 | null> {
    await sleep(ms)
    return v
}

@test
test_join_all_keeps_a_null_result :: fn() -> void {
    assert_eq(block_on(join_all([sleep(2), sleep(1)])).len(), 2)
}

@test
test_join_all_aligns_results_around_a_null :: fn() -> void {
    joined :: block_on(join_all([value_after(3, 1), value_after(1, null), value_after(2, 3)]))
    assert_eq("${joined}", "[1, null, 3]")
}
