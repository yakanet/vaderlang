// std/path: filesystem path manipulation.
//
// Paths are immutable string-backed values. Every operation returns a fresh
// Path rather than mutating. The separator is `/` on every OS: `to_posix`
// brings a path in from the OS, `to_native` takes one out to show it.
//
// What a path's root is depends on the OS the program runs on (`current_os`):
// `/` everywhere, and on Windows a drive (`C:/`) or a share (`//host/share/`).
// Elsewhere `C:` is a file name and `\` a byte a name may hold. The `*_on`
// kernels take the OS as a parameter. No path ends with `/` but a root: what
// builds one leaves it out, what reads one (a `Path(...)` cast) reads past it.

module "std/path"

import "std/string" {
    starts_with as str_starts_with, ends_with as str_ends_with,
}
import "std/string_builder"
import "std/target"

/// Rewrite the separators of the OS the program runs on to the canonical `/`.
/// On Windows, `\` becomes `/` and the verbatim prefix a system call may hand
/// back goes: `\\?\C:\x` is `C:/x`, `\\?\UNC\host\share` is `//host/share`.
/// Elsewhere `\` is a byte a file name may hold, and the path is unchanged.
///
/// A path entering from the OS (a command-line argument, an environment
/// variable, a system call) goes through here first: the operations of this
/// module split on `/` only.
///
/// @param s  a path as the OS writes it.
export to_posix :: fn(s: string) -> string = to_posix_on(s, current_os())

to_posix_on :: fn(s: string, os: Os) -> string {
    if os != .Windows {
        return s
    }
    slashed :: s.replace_chars_where((c: char) -> c == '\\', "/")
    if slashed.str_starts_with("//?/UNC/") {
        return "//" + slashed.byte_slice(8, slashed.byte_len())
    }
    if slashed.str_starts_with("//?/") {
        return slashed.byte_slice(4, slashed.byte_len())
    }
    return slashed
}

/// Rewrite the canonical `/` to the separator of the OS the program runs on:
/// `\` on Windows, unchanged elsewhere. For a path shown to a user or handed to a
/// tool, which expects the form its OS writes.
///
/// @param s  a path in the canonical `/` form; a `\` already there stays.
export to_native :: fn(s: string) -> string {
    if current_os() != .Windows {
        return s
    }
    return s.replace_chars_where((c: char) -> c == '/', "\\")
}

/// An immutable filesystem path: a nominal newtype over `string`. Zero-cost:
/// at runtime a `Path` *is* its UTF-8 string, with no wrapper box. Nominal at
/// typecheck so a `Path` never silently mixes with a raw `string` ; every
/// combinator returns a fresh `Path` rather than mutating in place.
export Path :: string

// ---- constructors ---------------------------------------------------------

/// Wrap a string as a `Path`, without the `/` it ends with unless it is a root
/// (`/`, `C:/`). No other validation: the string is taken as `/`-separated.
/// @param s  the path string.
export to_path :: fn(s: string) -> Path {
    // Asking for the OS is a call; most strings need no trimming.
    if !s.str_ends_with("/") {
        return Path(s)
    }
    return Path(without_trailing_separators(s, current_os()))
}

/// The empty path (`""`). Useful as an identity for `join` / as a default.
export empty_path :: fn() -> Path = Path("")

// ---- accessors ------------------------------------------------------------

/// Return the underlying string representation. Inverse of `to_path`.
export as_string :: fn(self: Path) -> string = string(self)

/// The path with the separator of the OS the program runs on, as `to_native`
/// gives it for a string.
///
/// @param self  a path in the canonical `/` form.
export to_native :: fn(self: Path) -> string = self.as_string().to_native()

/// The last segment: a file or directory name, without separator. Empty for a
/// root and for the empty path; a `/` at the end is read past.
/// @param self  the path receiver.
/// @example
///   "a/b/c.txt".to_path().filename()   // "c.txt"
///   "/".to_path().filename()           // ""
export filename :: fn(self: Path) -> string = filename_on(string(self), current_os())

filename_on :: fn(s: string, os: Os) -> string {
    path :: without_trailing_separators(s, os)
    root :: root_length(path, os)
    cut :: last_separator(path, root) ?? return path.byte_slice(root, path.byte_len())
    return path.byte_slice(cut + 1, path.byte_len())
}

/// The directory holding `self`: everything before its last segment. A root is
/// its own parent (`/`, `C:/`), and a path of one relative segment has the
/// empty path; a `/` at the end is read past.
/// @param self  the path receiver.
/// @example
///   "/usr/bin/cat".to_path().parent()   // "/usr/bin"
///   "/usr".to_path().parent()           // "/"
///   "a".to_path().parent()              // ""
export parent :: fn(self: Path) -> Path = Path(parent_on(string(self), current_os()))

parent_on :: fn(s: string, os: Os) -> string {
    path :: without_trailing_separators(s, os)
    root :: root_length(path, os)
    cut :: last_separator(path, root) ?? return path.byte_slice(0, root)
    return without_trailing_separators(path.byte_slice(0, cut), os)
}

// Byte offset of the extension-separating dot inside a FILENAME (never a full
// path), or null when there is none. The `min_index` of 1 is the whole subtlety: a
// leading dot marks a hidden file rather than an extension, and it only means
// that at the start of the filename, which is why callers must have narrowed to
// `filename()` first. `last_index_of` returns a BYTE offset, so every caller
// slices `bytes()` and not the codepoint-indexed `s[a..<b]`; mixing the two turns
// `café.vader` into `ader`.
extension_dot :: fn(fname: string) -> i64 | null = fname.last_index_of('.', 1)

/// The final segment without its extension.
///
/// One of three views on the last segment, none of them overlapping:
/// `filename()` gives `toto.zip`, `name()` gives `toto`, `extension()` gives
/// `zip`.
///
/// @param self  the path receiver.
/// @return      the filename with its extension and dot removed, or the filename
///              unchanged when it has no extension: a dotfile keeps its full
///              name (`.gitignore` → `.gitignore`), since its leading dot is not
///              an extension separator.
/// @example
///   "src/archive.tar.gz".to_path().name()  // "archive.tar"
///   "dir/.gitignore".to_path().name()      // ".gitignore"
export name :: fn(self: Path) -> string {
    fname :: self.filename()
    idx :: extension_dot(fname) ?? return fname
    return fname.byte_slice(0, idx)
}

/// The final segment's extension, without the dot.
///
/// One of three views on the last segment, none of them overlapping:
/// `filename()` gives `toto.zip`, `name()` gives `toto`, `extension()` gives
/// `zip`. Kept separate rather than returning both halves at once, so a caller
/// wanting one doesn't pay for the other being built.
///
/// @param self  the path receiver.
/// @return      the extension without its dot, or `""` when the final segment
///              has none: a dotfile and a trailing dot both count as none.
/// @example
///   "src/archive.tar.gz".to_path().extension()  // "gz"
///   "dir/.gitignore".to_path().extension()      // ""
export extension :: fn(self: Path) -> string {
    fname :: self.filename()
    idx :: extension_dot(fname) ?? return ""
    return fname.byte_slice(idx + 1, fname.byte_len())
}

// ---- roots ----------------------------------------------------------------

/// The root `self` opens with: `/`, and on Windows a drive (`C:/`, or `C:` for
/// a path from that drive's working directory) or a share (`//host/share/`).
/// Empty for a relative path.
/// @param self  the path receiver.
/// @example
///   "/usr/bin".to_path().root()   // "/"
///   "src/main".to_path().root()   // ""
export root :: fn(self: Path) -> Path {
    s :: string(self)
    return Path(s.byte_slice(0, root_length(s, current_os())))
}

/// True when `self` names the same file from any working directory: `/x` on
/// POSIX, `C:/x` or `//host/share` on Windows. A Windows `/x` is not absolute:
/// it lacks the drive, which joining it to the working directory supplies.
/// @param self  the path receiver.
export is_absolute :: fn(self: Path) -> bool = is_absolute_on(string(self), current_os())

is_absolute_on :: fn(s: string, os: Os) -> bool =
    is_anchored(s, os) && (os != .Windows || prefix_length(s, os) > 0)

// Whether `s` opens on a `/` that a `..` cannot climb past: the POSIX root, the
// root of a drive (`C:/`), a share. Not a drive alone (`C:x`), relative to that
// drive's working directory.
is_anchored :: fn(s: string, os: Os) -> bool {
    root :: root_length(s, os)
    return s.str_starts_with("/") || (root > 0 && s.byte_at(root - 1) == '/')
}

// The bytes of `s` that name a drive or a share on Windows: `C:`, or
// `//host/share` up to the separator after the share. 0 for any other path, and
// on every other OS.
prefix_length :: fn(s: string, os: Os) -> i64 {
    if os != .Windows {
        return 0
    }
    n :: s.byte_len()
    if n >= 2 && is_ascii_letter(s.byte_at(0)) && s.byte_at(1) == ':' {
        return 2
    }
    if n < 3 || s.byte_at(0) != '/' || s.byte_at(1) != '/' || s.byte_at(2) == '/' {
        return 0
    }
    after_host :: next_separator(s, 2) ?? return n
    return next_separator(s, after_host + 1) ?? n
}

// The bytes of the root `s` opens with: its drive or share, and the `/` after.
root_length :: fn(s: string, os: Os) -> i64 {
    prefix :: prefix_length(s, os)
    if prefix < s.byte_len() && s.byte_at(prefix) == '/' {
        return prefix + 1
    }
    return prefix
}

// `s` without the `/` it ends with, the root's own kept: `a/b/` is `a/b`, `/`
// stays `/`.
without_trailing_separators :: fn(s: string, os: Os) -> string {
    n :: s.byte_len()
    if n == 0 || s.byte_at(n - 1) != '/' {
        return s
    }
    root :: root_length(s, os)
    end := n
    for end > root && s.byte_at(end - 1) == '/' {
        end -= 1
    }
    return s.byte_slice(0, end)
}

// Byte scans for `/`, which never occurs inside a multi-byte UTF-8 sequence.
next_separator :: fn(s: string, from: i64) -> i64 | null {
    for i in from..<s.byte_len() {
        if s.byte_at(i) == '/' {
            return i
        }
    }
    return null
}

last_separator :: fn(s: string, from: i64) -> i64 | null {
    i := s.byte_len()
    for i > from {
        i -= 1
        if s.byte_at(i) == '/' {
            return i
        }
    }
    return null
}

is_ascii_letter :: fn(b: u8) -> bool = (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')

// ---- combinators ----------------------------------------------------------

/// `other` appended to `self`, one `/` between them. An absolute `other`
/// replaces `self` (Java `Path.resolve`). On Windows, an `other` from the root
/// (`/x`) keeps the drive of `self`, and one with a drive alone (`D:x`)
/// replaces it.
/// @param self   the base path.
/// @param other  the segment to append (may itself contain separators).
/// @return       a fresh `Path`.
/// @example
///   "a".to_path().join("b/c")    // "a/b/c"
///   "a".to_path().join("/etc")   // "/etc" on POSIX
export join :: fn(self: Path, other: string) -> Path =
    Path(join_on(string(self), other, current_os()))

join_on :: fn(base: string, other: string, os: Os) -> string {
    if other.is_empty() {
        return without_trailing_separators(base, os)
    }
    if prefix_length(other, os) > 0 || is_absolute_on(other, os) {
        return without_trailing_separators(other, os)
    }
    // Left: a Windows `/x`, which keeps the drive of `base`.
    if other.str_starts_with("/") {
        drive :: base.byte_slice(0, prefix_length(base, os))
        return without_trailing_separators(drive + other, os)
    }
    // A drive alone (`C:`) takes the segment with no `/`: `C:x`.
    bare :: base.str_ends_with("/") || base.byte_len() == prefix_length(base, os)
    separator :: if bare { "" } else { "/" }
    return without_trailing_separators(base + separator + other, os)
}

// `path / "child"`: operator sugar for `join`. The `/` mirrors the path
// separator and reads naturally when building child paths.
Path implements Div<string> {
    div :: fn(self, other: string) -> Path = self.join(other)
}

// ---- predicates -----------------------------------------------------------

/// True when `self` starts with `prefix` on a segment boundary, so
/// `/foo/bar` starts with `/foo` but `/foobar` does NOT. Useful for
/// "is this under that directory" checks.
/// @param self    the path receiver.
/// @param prefix  the candidate prefix path.
export starts_with :: fn(self: Path, prefix: Path) -> bool {
    s :: string(self)
    pfx :: string(prefix)
    if !s.str_starts_with(pfx) {
        return false
    }
    self_len :: s.byte_len()
    prefix_len :: pfx.byte_len()
    if self_len == prefix_len {
        return true
    }
    // Boundary check: next char in self must be a separator, or prefix must
    // itself end on one.
    if !pfx.is_empty() && pfx.byte_at(prefix_len - 1) == '/' {
        return true
    }
    return s.byte_at(prefix_len) == '/'
}

/// True when `self` ends with `suffix` on a segment boundary. Same
/// segment-aware rule as `starts_with`.
/// @param self    the path receiver.
/// @param suffix  the candidate suffix path.
export ends_with :: fn(self: Path, suffix: Path) -> bool {
    s :: string(self)
    sfx :: string(suffix)
    if !s.str_ends_with(sfx) {
        return false
    }
    self_len :: s.byte_len()
    suffix_len :: sfx.byte_len()
    if self_len == suffix_len {
        return true
    }
    cut :: self_len - suffix_len
    if !sfx.is_empty() && sfx.byte_at(0) == '/' {
        return true
    }
    return s.byte_at(cut - 1) == '/'
}

// ---- normalization --------------------------------------------------------

/// Collapse `.` and `..` segments and repeated separators. Purely lexical: does
/// NOT touch the filesystem (no symlink resolution, no existence check). Keeps
/// the root, which a `..` does not climb past.
///
/// @param self  the path receiver.
/// @return      a fresh, lexically-normalised `Path`.
/// @example
///   "a/./b".to_path().normalize()     // "a/b"
///   "a/b/..".to_path().normalize()    // "a"
///   "/a/../b".to_path().normalize()   // "/b"
///   "../foo".to_path().normalize()    // "../foo"
export normalize :: fn(self: Path) -> Path = Path(normalize_on(string(self), current_os()))

normalize_on :: fn(s: string, os: Os) -> string {
    n :: s.byte_len()
    if n == 0 {
        return s
    }
    root :: root_length(s, os)
    anchored :: is_anchored(s, os)
    kept: string[]: []
    start := root
    for start <= n {
        end :: next_separator(s, start) ?? n
        segment :: s.byte_slice(start, end)
        start = end + 1
        if segment.is_empty() || segment == "." {
            continue
        }
        climbs :: segment == ".." && kept.len() > 0 && kept[kept.len() - 1] != ".."
        if climbs {
            kept.remove_last()
        } else if segment != ".." || !anchored {
            kept.push(segment)
        }
    }
    if root == 0 && kept.is_empty() {
        return "."
    }
    out :: StringBuilder {}
    out.append(s.byte_slice(0, root))
    for i in 0..<kept.len() {
        if i > 0 {
            out.append("/")
        }
        out.append(kept[i])
    }
    return out.to_string()
}

// ---------------------------------------------------------------------- tests

import "std/testing"

@test test_to_path :: fn() -> void {
    p :: "a/b/c".to_path()
    assert_eq(p.as_string(), "a/b/c")
}

@test test_empty_path :: fn() -> void {
    p :: empty_path()
    assert_eq(p.as_string(), "")
}

@test test_is_absolute :: fn() -> void {
    from_the_root :: if current_os() == .Windows { "C:/usr/bin" } else { "/usr/bin" }
    assert(from_the_root.to_path().is_absolute(), "a path from the root")
    assert(!"relative/path".to_path().is_absolute(), "relative/path is not absolute")
    assert(!empty_path().is_absolute(), "empty path is not absolute")
}

@test test_parent :: fn() -> void {
    assert_eq("a/b/c".to_path().parent().as_string(), "a/b")
    assert_eq("a".to_path().parent().as_string(), "")
    assert_eq("/usr/bin/cat".to_path().parent().as_string(), "/usr/bin")
    assert_eq("/usr".to_path().parent().as_string(), "/")
    assert_eq("/".to_path().parent().as_string(), "/")
}

@test test_filename :: fn() -> void {
    assert_eq("a/b/c".to_path().filename(), "c")
    assert_eq("file.txt".to_path().filename(), "file.txt")
    assert_eq("/".to_path().filename(), "")
}

@test
test_a_trailing_separator_is_read_past :: fn() -> void {
    assert_eq("a/b/".to_path().as_string(), "a/b")
    assert_eq("a//".to_path().as_string(), "a")
    assert_eq("/".to_path().as_string(), "/")
    assert_eq(filename_on("a/b/", .Linux), "b")
    assert_eq(parent_on("a/b/", .Linux), "a")
}

@test
test_root :: fn() -> void {
    assert_eq("/usr/bin".to_path().root().as_string(), "/")
    assert_eq("src/main".to_path().root().as_string(), "")
}

@test
test_root_of_each_os :: fn() -> void {
    windows :: (s: string) -> s.byte_slice(0, root_length(s, .Windows))
    assert_eq(windows("C:/x"), "C:/")
    assert_eq(windows("C:x"), "C:")
    assert_eq(windows("//host/share/x"), "//host/share/")
    assert_eq(windows("//host/share"), "//host/share")
    assert_eq(windows("/x"), "/")
    assert_eq(windows("x"), "")
    linux :: (s: string) -> s.byte_slice(0, root_length(s, .Linux))
    assert_eq(linux("C:/x"), "")
    assert_eq(linux("//host/share"), "/")
}

@test
test_is_absolute_on_each_os :: fn() -> void {
    assert(is_absolute_on("C:/x", .Windows), "a drive and its root")
    assert(is_absolute_on("//host/share", .Windows), "a share")
    assert(!is_absolute_on("/x", .Windows), "a root without its drive")
    assert(!is_absolute_on("C:x", .Windows), "a drive without its root")
    assert(is_absolute_on("/x", .Linux), "the POSIX root")
    assert(!is_absolute_on("C:/x", .Linux), "`C:` is a POSIX file name")
}

@test
test_join_on_windows :: fn() -> void {
    assert_eq(join_on("a", "C:/x", .Windows), "C:/x")
    assert_eq(join_on("D:/work", "/x", .Windows), "D:/x")
    assert_eq(join_on("//host/share", "/x", .Windows), "//host/share/x")
    assert_eq(join_on("C:/a", "D:x", .Windows), "D:x")
    assert_eq(join_on("C:", "x", .Windows), "C:x")
    assert_eq(join_on("C:/", "x/", .Windows), "C:/x")
}

@test
test_join_on_posix :: fn() -> void {
    assert_eq(join_on("a", "C:/x", .Linux), "a/C:/x")
    assert_eq(join_on("a", "/x", .Linux), "/x")
    assert_eq(join_on("a/", "b/", .Linux), "a/b")
    assert_eq(join_on("a/", "", .Linux), "a")
}

@test
test_normalize_keeps_the_root :: fn() -> void {
    assert_eq(normalize_on("C:/../x", .Windows), "C:/x")
    assert_eq(normalize_on("C:/..", .Windows), "C:/")
    assert_eq(normalize_on("//host/share/a/../..", .Windows), "//host/share/")
    assert_eq(normalize_on("C:../x", .Windows), "C:../x")
    assert_eq(normalize_on("//srv/share/x", .Linux), "/srv/share/x")
    assert_eq(normalize_on("/..", .Linux), "/")
    assert_eq(normalize_on("C:/../x", .Linux), "x")
}

@test
test_parent_and_filename_of_a_drive :: fn() -> void {
    assert_eq(parent_on("C:/x", .Windows), "C:/")
    assert_eq(parent_on("C:/", .Windows), "C:/")
    assert_eq(filename_on("C:/", .Windows), "")
    assert_eq(filename_on("C:x", .Windows), "x")
    assert_eq(parent_on("C:/x", .Linux), "C:")
}

@test
test_to_posix_on_each_os :: fn() -> void {
    assert_eq(to_posix_on(r"a\b", .Windows), "a/b")
    assert_eq(to_posix_on(r"\\?\C:\x", .Windows), "C:/x")
    assert_eq(to_posix_on(r"\\?\UNC\host\share\x", .Windows), "//host/share/x")
    assert_eq(to_posix_on(r"a\b", .Linux), r"a\b")
}

// The three views on a final segment, checked together so they can't drift:
// `filename` = `name` + `.` + `extension` whenever an extension is present.
@test test_name_and_extension :: fn() -> void {
    assert_eq("file.txt".to_path().name(), "file")
    assert_eq("file.txt".to_path().extension(), "txt")

    // The LAST dot splits, so a double extension keeps the first half in `name`.
    assert_eq("a/b/c.tar.gz".to_path().name(), "c.tar")
    assert_eq("a/b/c.tar.gz".to_path().extension(), "gz")

    // No extension: `name` is the whole filename, `extension` empty.
    assert_eq("README".to_path().name(), "README")
    assert_eq("README".to_path().extension(), "")

    // A leading dot marks a hidden file, it is not an extension separator,
    // and that holds in a subdirectory too, which is why the search runs on
    // `filename()` rather than on the whole path.
    assert_eq(".gitignore".to_path().name(), ".gitignore")
    assert_eq(".gitignore".to_path().extension(), "")
    assert_eq("dir/.gitignore".to_path().name(), ".gitignore")
    assert_eq("dir/.gitignore".to_path().extension(), "")

    // A trailing dot leaves nothing after it.
    assert_eq("trailing.".to_path().name(), "trailing")
    assert_eq("trailing.".to_path().extension(), "")

    // Multi-byte characters before the dot: the cut is on bytes, so it lands
    // where the dot actually is. A codepoint-indexed slice yields `ader` here.
    assert_eq("café.vader".to_path().name(), "café")
    assert_eq("café.vader".to_path().extension(), "vader")
    assert_eq("données/café.tar.gz".to_path().extension(), "gz")
}

@test test_join :: fn() -> void {
    assert_eq("a".to_path().join("b").as_string(), "a/b")
    assert_eq("a/".to_path().join("b").as_string(), "a/b")
    assert_eq(empty_path().join("b").as_string(), "b")
}

@test test_starts_ends_with :: fn() -> void {
    assert("a/b/c".to_path().starts_with("a/b".to_path()), "a/b/c starts with a/b")
    assert("a/b/c".to_path().ends_with("b/c".to_path()), "a/b/c ends with b/c")
    assert(!"a/b/c".to_path().starts_with("x".to_path()), "a/b/c does not start with x")
}

@test test_to_native :: fn() -> void {
    native :: to_native("C:/a\\b/c")
    if current_os() == .Windows {
        assert_eq(native, "C:\\a\\b\\c")
    } else {
        assert_eq(native, "C:/a\\b/c")
    }
}

@test test_to_native_round_trip :: fn() -> void {
    assert_eq(to_posix(to_native("a/b/c.vader")), "a/b/c.vader")
}

@test
test_starts_with_a_prefix_beyond_ascii :: fn() -> void {
    assert("café/x".to_path().starts_with("café".to_path()), "a segment boundary after `é`")
    assert(!"cafés/x".to_path().starts_with("café".to_path()), "no boundary inside a name")
}

@test
test_ends_with_a_suffix_beyond_ascii :: fn() -> void {
    assert("x/été".to_path().ends_with("été".to_path()), "a segment boundary before `é`")
    assert(!"x/aété".to_path().ends_with("été".to_path()), "no boundary inside a name")
}
