// std/collections/priority_queue: `PriorityQueue`, items taken smallest first.

module "std/collections"

/// Items taken smallest first, whatever order they were pushed in. A binary
/// heap: `push` and `pop` cost `O(log n)`, `peek` is constant. Items that
/// compare equal come out in no particular order.
///
/// A null item would read as an empty queue: push no type that holds null.
///
/// @example
///   q :: PriorityQueue<i64> {}
///   q.push(30)
///   q.push(10)
///   q.push(20)
///   q.peek()   // 10
///   q.pop()    // 10
///   q.len()    // 2
export PriorityQueue :: struct<T: Comparable> {
    /// The heap order: no item is smaller than its parent at `(i - 1) / 2`.
    @internal
    items: T[] = []
}

/// Add `item`.
///
/// @param self  the queue.
/// @param item  the item to add.
export push :: fn<T: Comparable>(self: PriorityQueue<T>, item: T) -> void {
    self.items.push(item)
    i := self.items.len() - 1
    for i > 0 {
        parent :: (i - 1) / 2
        if self.items[parent] <= self.items[i] {
            return
        }
        swap_items(self.items, parent, i)
        i = parent
    }
}

// `peek` shows the smallest item.
PriorityQueue<T> implements<T: Comparable> Peek<T> {
    peek :: fn(self) -> T | null {
        if self.is_empty() {
            return null
        }
        return self.items[0]
    }
}

/// Remove the smallest item.
///
/// @param self  the queue.
/// @return      that item, or null when the queue is empty.
export pop :: fn<T: Comparable>(self: PriorityQueue<T>) -> T | null {
    if self.is_empty() {
        return null
    }
    swap_items(self.items, 0, self.items.len() - 1)
    root :: self.items.remove_last()
    i := 0
    for {
        smallest := i
        left :: 2 * i + 1
        right :: left + 1
        if left < self.items.len() && self.items[left] < self.items[smallest] {
            smallest = left
        }
        if right < self.items.len() && self.items[right] < self.items[smallest] {
            smallest = right
        }
        if smallest == i {
            return root
        }
        swap_items(self.items, i, smallest)
        i = smallest
    }
}

swap_items :: fn<T>(items: T[], a: i64, b: i64) -> void {
    held :: items[a]
    items[a] = items[b]
    items[b] = held
}

/// How many items the queue holds.
export len :: fn<T: Comparable>(self: PriorityQueue<T>) -> i64 = self.items.len()

/// Whether the queue holds no item.
export is_empty :: fn<T: Comparable>(self: PriorityQueue<T>) -> bool = self.items.len() == 0

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_priority_queue_pops_smallest_first :: fn() -> void {
    q :: PriorityQueue<i64> {}
    for x in [5, 1, 4, 2, 3, 2] {
        q.push(x)
    }
    out: i64[]: []
    for {
        x :: q.pop() ?? break
        out.push(x)
    }
    assert_eq("${out}", "[1, 2, 2, 3, 4, 5]")
}

@test
test_priority_queue_peek_leaves_the_item :: fn() -> void {
    q :: PriorityQueue<i64> {}
    q.push(7)
    q.push(3)
    assert_eq(q.peek() ?? -1, 3)
    assert_eq(q.len(), 2)
}

@test
test_priority_queue_empty_gives_null :: fn() -> void {
    q :: PriorityQueue<i64> {}
    assert(q.is_empty(), "a new queue is empty")
    assert(q.peek() == null, "peek on an empty queue")
    assert(q.pop() == null, "pop on an empty queue")
}
