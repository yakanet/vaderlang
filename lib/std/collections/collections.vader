// std/collections: maps, sets, a queue and a priority queue.
//
// ```
// counts :: Map<string, i32> {}
// counts["vader"] = 1
//
// seen :: Set<i32> {}
// seen.add(10)
//
// jobs :: Queue<string> {}
// jobs.push("parse")
//
// deadlines :: PriorityQueue<i64> {}
// deadlines.push(30)
// ```
//
// Sequences are the built-in `T[]` arrays.

module "std/collections"
