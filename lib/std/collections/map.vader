// std/collections/map: `Map`, a compact open-addressed hash map.

module "std/collections"

// Live entries live in two dense parallel arrays (`ekeys[i]` ↔ `evals[i]`) in
// insertion order; a sparse `index` of `i32` maps a hash slot to an entry
// position (1-based; 0 = empty, -1 = tombstone). Lookup hashes the key, probes the
// index (`next_slot`) skipping tombstones, and compares via `Equals`. Insert
// appends to the dense arrays (reusing a slot freed by `remove`); `remove` swaps
// the last entry into the hole and tombstones the index slot.

MINIMAL_INDEX_COUNT: i64: 16

EMPTY_SLOT :: 0    // index slot holds no entry
TOMB_SLOT  :: -1   // index slot held an entry that was removed

/// Compact hash map keyed by any `K` that implements `Hash & Equals`. Entries
/// are stored in insertion order in dense `ekeys` / `evals`; a sparse `i32`
/// `index` resolves a key's hash to its entry position. `K`'s `hash()` is
/// queried on insert / lookup / rehash, `equals()` on probe comparisons.
///
/// `m[k]` is `V | null`, null for an absent key: when `V` admits null itself,
/// tell the two apart with `k in m`.
export Map :: struct<K: Hash & Equals, V> {
    /// Dense entry keys in insertion order. `ekeys[i]` pairs with `evals[i]`.
    /// `[size, ekeys.len())` are spare slots freed by `remove`, reused by `put`.
    @internal
    ekeys: K[] = []
    /// Dense entry values, parallel to `ekeys`.
    @internal
    evals: V[] = []
    /// Open-addressed hash table : slot → entry position + 1 ; `EMPTY_SLOT`
    /// (0) = free, `TOMB_SLOT` (-1) = tombstone. Length is a power of two,
    /// lazily allocated to `MINIMAL_INDEX_COUNT` on first insert.
    @internal
    index: i32[] = []
    /// `index.len() - 1`, the bitmask for the power-of-two slot count; 0 while
    /// `index` is empty.
    @internal
    mask:  i64 = 0
    /// Used index slots (entries + tombstones) at which the next insertion must
    /// grow the index: three quarters of `index.len()`, the 0.75 load factor. Set
    /// by `rehash` with `index`; 0 while `index` is empty, which sends the first
    /// insertion through the rehash.
    @internal
    grow_at: i64 = 0
    /// Live entry count.
    @internal
    size:  i64 = 0
    /// Tombstone count in `index`. Counted toward the load factor so a
    /// remove-heavy map rehashes (clearing tombstones) before the open-addressed
    /// probe runs out of `EMPTY` slots and loops forever.
    @internal
    tombs: i64 = 0
}

// Method signatures below declare just `[K, V]` (no bound repetition): the
// `Hash & Equals` constraint is auto-inherited from the struct decl above by
// the typecheck `inherit-bounds` pass when the first param is `Map<K, V>`.

first_slot :: fn(h: u64, mask: i64) -> i64 = i64(h) & mask

// The probe step after a collision. `perturb` starts as the full hash and loses five
// bits before each step, which brings the high bits into play; once it reaches 0,
// `5 * s + 1` visits every slot of a power-of-two table. Every walk of the index
// takes exactly this sequence, or a key stops being found.
next_slot :: fn(s: i64, perturb: u64, mask: i64) -> i64 = (s *% 5 +% i64(perturb) +% 1) & mask

// Rebuild the index at `new_count` slots from the dense entries: re-probing
// each live key. Clears all tombstones. The dense `ekeys` / `evals` are never
// touched (entries don't move), so growth allocates no entries.
rehash :: fn<K: Hash & Equals, V>(self: Map<K, V>, new_count: i64) -> void {
    fresh: i32[]: []
    for 0..<new_count { fresh.push(EMPTY_SLOT) }
    new_mask :: new_count - 1
    for e in 0..<self.size {
        perturb := self.ekeys[e].hash()
        s := first_slot(perturb, new_mask)
        for fresh[s] != EMPTY_SLOT {
            perturb = perturb >> 5
            s = next_slot(s, perturb, new_mask)
        }
        fresh[s] = i32(e + 1)
    }
    self.index = fresh
    self.mask = new_mask
    // `new_count` is a power of two of at least `MINIMAL_INDEX_COUNT`, so the
    // division is exact: an insertion over `n` used slots passes 0.75, that is
    // `(n + 1) * 4 > new_count * 3`, exactly when `n >= grow_at`.
    self.grow_at = new_count / 4 * 3
    self.tombs = 0
}

// Rehash at the smallest power-of-two slot count, at least
// `MINIMAL_INDEX_COUNT`, that keeps the live entries under 0.75. Sizing to the
// LIVE count lets a tombstone-heavy map compact instead of only ever doubling.
grow_index :: fn<K: Hash & Equals, V>(self: Map<K, V>) -> void {
    new_count := MINIMAL_INDEX_COUNT
    for self.size * 4 > new_count * 3 {
        new_count = new_count * 2
    }
    self.rehash(new_count)
}

/// Insert or overwrite `key → value`. Probes the index from `hash & mask` ; an
/// existing key has its value replaced in place, otherwise a fresh entry is
/// appended (reusing the first tombstone seen, if any). Only an insertion can
/// grow the index.
/// @param self   the map receiver.
/// @param key    key with which `value` is associated.
/// @param value  the new value.
/// @return       `true` when `key` was absent and an entry was added, `false`
///               when its value was replaced.
put :: fn<K: Hash & Equals, V>(self: Map<K, V>, key: K, value: V) -> bool {
    first_tomb: i64 = -1
    empty: i64 = -1
    if self.index.len() > 0 {
        perturb := key.hash()
        s := first_slot(perturb, self.mask)
        for {
            slot :: self.index[s]
            if slot == EMPTY_SLOT {
                empty = s
                break
            }
            if slot == TOMB_SLOT {
                if first_tomb < 0 {
                    first_tomb = s
                }
            } else {
                ei :: i64(slot) - 1
                if self.ekeys[ei].equals(key) {
                    self.evals[ei] = value
                    return false
                }
            }
            perturb = perturb >> 5
            s = next_slot(s, perturb, self.mask)
        }
    }
    // The fresh entry lands at logical position `size`: a spare dense slot freed
    // by a prior `remove` when one is left, else appended. It takes the first
    // tombstone its probe passed, else the empty slot the probe ended on, unless
    // used slots (entries + tombstones) would pass 0.75: the rehash then indexes
    // it with the others. A map with no index yet has a `grow_at` of 0, so its
    // first insert grows it.
    size :: self.size
    if size < self.ekeys.len() {
        self.ekeys[size] = key
        self.evals[size] = value
    } else {
        self.ekeys.push(key)
        self.evals.push(value)
    }
    self.size = size + 1
    if size + self.tombs >= self.grow_at {
        self.grow_index()
    } else if first_tomb >= 0 {
        self.tombs = self.tombs - 1
        self.index[first_tomb] = i32(size + 1)
    } else {
        self.index[empty] = i32(size + 1)
    }
    return true
}

/// The value stored for `key`, after storing `value` there when `key` was
/// absent. One probe either way. The caller evaluates `value` even when `key`
/// is present: for a default that allocates, take `get_or_put_with`.
/// @param self   the map receiver.
/// @param key    key to look up.
/// @param value  stored when `key` is absent.
/// @return       the value now stored for `key`.
/// @example
///   index_of :: Map<string, i64> {}
///   at :: index_of.get_or_put("x", index_of.len())
export get_or_put :: fn<K: Hash & Equals, V>(self: Map<K, V>, key: K, value: V) -> V {
    first_tomb: i64 = -1
    empty: i64 = -1
    if self.index.len() > 0 {
        perturb := key.hash()
        s := first_slot(perturb, self.mask)
        for {
            slot :: self.index[s]
            if slot == EMPTY_SLOT {
                empty = s
                break
            }
            if slot == TOMB_SLOT {
                if first_tomb < 0 {
                    first_tomb = s
                }
            } else {
                ei :: i64(slot) - 1
                if self.ekeys[ei].equals(key) {
                    return self.evals[ei]
                }
            }
            perturb = perturb >> 5
            s = next_slot(s, perturb, self.mask)
        }
    }
    // The insertion of `put`, inlined: a call would add a GC frame to every
    // fresh entry.
    size :: self.size
    if size < self.ekeys.len() {
        self.ekeys[size] = key
        self.evals[size] = value
    } else {
        self.ekeys.push(key)
        self.evals.push(value)
    }
    self.size = size + 1
    if size + self.tombs >= self.grow_at {
        self.grow_index()
    } else if first_tomb >= 0 {
        self.tombs = self.tombs - 1
        self.index[first_tomb] = i32(size + 1)
    } else {
        self.index[empty] = i32(size + 1)
    }
    return value
}

/// Store `value` for `key` unless `key` is already present, in one probe. A
/// present key keeps its value. Like `m[key]`, a stored `null` reads as an
/// absent key when `V` is nullable.
/// @param self   the map receiver.
/// @param key    key to look up.
/// @param value  stored when `key` is absent.
/// @return       the value already stored for `key`, or `null` when `value`
///               was stored.
/// @example
///   owner :: Map<string, string> {}
///   owner.put_absent("std/io", "lib")    // null
///   owner.put_absent("std/io", "vendor") // "lib"
export put_absent :: fn<K: Hash & Equals, V>(self: Map<K, V>, key: K, value: V) -> V | null {
    first_tomb: i64 = -1
    empty: i64 = -1
    if self.index.len() > 0 {
        perturb := key.hash()
        s := first_slot(perturb, self.mask)
        for {
            slot :: self.index[s]
            if slot == EMPTY_SLOT {
                empty = s
                break
            }
            if slot == TOMB_SLOT {
                if first_tomb < 0 {
                    first_tomb = s
                }
            } else {
                ei :: i64(slot) - 1
                if self.ekeys[ei].equals(key) {
                    return self.evals[ei]
                }
            }
            perturb = perturb >> 5
            s = next_slot(s, perturb, self.mask)
        }
    }
    // The insertion of `put`, inlined as in `get_or_put`.
    size :: self.size
    if size < self.ekeys.len() {
        self.ekeys[size] = key
        self.evals[size] = value
    } else {
        self.ekeys.push(key)
        self.evals.push(value)
    }
    self.size = size + 1
    if size + self.tombs >= self.grow_at {
        self.grow_index()
    } else if first_tomb >= 0 {
        self.tombs = self.tombs - 1
        self.index[first_tomb] = i32(size + 1)
    } else {
        self.index[empty] = i32(size + 1)
    }
    return null
}

/// The value stored for `key`, after storing what `make` returns there when
/// `key` was absent. `make` runs only on a miss, so a default that allocates
/// costs nothing when `key` is present. A hit takes one probe; a miss takes a
/// second one after `make`, which may itself change the map.
/// @param self  the map receiver.
/// @param key   key to look up.
/// @param make  builds the value to store when `key` is absent.
/// @return      the value now stored for `key`.
/// @example
///   by_module :: Map<string, string[]> {}
///   by_module.get_or_put_with("std/io", () -> []).push("println")
export get_or_put_with :: fn<K: Hash & Equals, V>(
    self: Map<K, V>,
    key: K,
    make: fn() -> V,
) -> V {
    ei :: self.entry_of(key)
    if ei >= 0 {
        return self.evals[ei]
    }
    value :: make()
    self.put(key, value)
    return value
}

// The dense position of `key`'s entry, or -1 when the map holds no such key.
entry_of :: fn<K: Hash & Equals, V>(self: Map<K, V>, key: K) -> i64 {
    if self.index.len() == 0 {
        return -1
    }
    perturb := key.hash()
    s := first_slot(perturb, self.mask)
    for {
        slot :: self.index[s]
        if slot == EMPTY_SLOT {
            return -1
        }
        if slot != TOMB_SLOT {
            ei :: i64(slot) - 1
            if self.ekeys[ei].equals(key) {
                return ei
            }
        }
        perturb = perturb >> 5
        s = next_slot(s, perturb, self.mask)
    }
}

/// Logically empty the map while KEEPING its backing arrays (`ekeys` / `evals` /
/// `index`) allocated, so a subsequent refill reuses them instead of allocating
/// a fresh map. For hot reuse loops, e.g. a dataflow fixpoint's scratch set
/// that would otherwise mint a new map every round. The dense entries past
/// `size` are stale but unreachable (`size = 0`), and `put` overwrites them
/// from slot 0 on the next insert. O(index slots).
/// @param self  the map receiver.
export clear :: fn<K, V>(self: Map<K, V>) -> void {
    self.size = 0
    self.tombs = 0
    for i in 0..<self.index.len() { self.index[i] = EMPTY_SLOT }
}

/// Look up `key`. Returns the stored value or `null` if absent.
/// @param self  the map receiver.
/// @param key   key to look up.
/// @return      `V` when present, `null` otherwise.
get :: fn<K: Hash & Equals, V>(self: Map<K, V>, key: K) -> V | null {
    if self.index.len() == 0 { return null }
    perturb := key.hash()
    s := first_slot(perturb, self.mask)
    for {
        slot :: self.index[s]
        if slot == EMPTY_SLOT {
            return null
        }
        if slot != TOMB_SLOT {
            ei :: i64(slot) - 1
            if self.ekeys[ei].equals(key) {
                return self.evals[ei]
            }
        }
        perturb = perturb >> 5
        s = next_slot(s, perturb, self.mask)
    }
}

/// True iff `key` has an entry in the map. Distinguishes "key absent" from
/// "key maps to a null-typed value": `get` collapses both to `null`.
/// @param self  the map receiver.
/// @param key   key to test.
contains_key :: fn<K: Hash & Equals, V>(self: Map<K, V>, key: K) -> bool {
    if self.index.len() == 0 { return false }
    perturb := key.hash()
    s := first_slot(perturb, self.mask)
    for {
        slot :: self.index[s]
        if slot == EMPTY_SLOT {
            return false
        }
        if slot != TOMB_SLOT {
            ei :: i64(slot) - 1
            if self.ekeys[ei].equals(key) {
                return true
            }
        }
        perturb = perturb >> 5
        s = next_slot(s, perturb, self.mask)
    }
}

// Find the index slot whose stored value equals `want` (a 1-based entry pos),
// probing from `key`'s hash. Used by `remove` to re-point a swapped entry.
slot_holding :: fn<K: Hash & Equals, V>(self: Map<K, V>, key: K, want: i32) -> i64 {
    perturb := key.hash()
    s := first_slot(perturb, self.mask)
    for self.index[s] != EMPTY_SLOT {
        if self.index[s] == want { return s }
        perturb = perturb >> 5
        s = next_slot(s, perturb, self.mask)
    }
    return self.index.len()
}

/// Remove the entry for `key`, if present. The matching entry is overwritten by
/// the last dense entry (which is re-pointed in the index), the freed dense slot
/// becomes spare, and the key's index slot is tombstoned. A no-op when absent.
/// @param self  the map receiver.
/// @param key   key whose entry to drop.
/// @return      `true` when an entry was removed, `false` when `key` was absent.
export remove :: fn<K: Hash & Equals, V>(self: Map<K, V>, key: K) -> bool {
    if self.index.len() == 0 { return false }
    perturb := key.hash()
    s := first_slot(perturb, self.mask)
    for {
        slot :: self.index[s]
        if slot == EMPTY_SLOT {
            return false
        }
        if slot != TOMB_SLOT {
            ei :: i64(slot) - 1
            if self.ekeys[ei].equals(key) {
                last :: self.size - 1
                if ei != last {
                    moved_slot :: self.slot_holding(self.ekeys[last], i32(last + 1))
                    self.ekeys[ei] = self.ekeys[last]
                    self.evals[ei] = self.evals[last]
                    self.index[moved_slot] = i32(ei + 1)
                }
                self.index[s] = TOMB_SLOT
                self.tombs = self.tombs + 1
                self.size = self.size - 1
                return true
            }
        }
        perturb = perturb >> 5
        s = next_slot(s, perturb, self.mask)
    }
}

/// Number of `(key, value)` entries currently stored in `self`. O(1).
export len :: fn<K, V>(self: Map<K, V>) -> i64 = self.size

/// True iff no entries have been inserted (or all were removed). O(1).
export is_empty :: fn<K, V>(self: Map<K, V>) -> bool = self.size == 0

// Operator sugar: `m[key]` reads via Index, `m[key] = v` writes via
// IndexSet, `key in m` dispatches via Contains. The impl bodies reuse `get` /
// `put` / `contains_key`, so each impl restates the struct's `K: Hash & Equals`
// bound those calls require.
Map<K, V> implements<K: Hash & Equals, V> Index<K, V | null> {
    at :: fn(self, key: K) -> V | null = self.get(key)
}

Map<K, V> implements<K: Hash & Equals, V> IndexSet<K, V> {
    set_at :: fn(self, key: K, v: V) { self.put(key, v) }
}

Map<K, V> implements<K: Hash & Equals, V> Contains<K> {
    contains :: fn(self, key: K) -> bool = self.contains_key(key)
}

/// Walk every key in insertion order, over the map itself: nothing is copied.
///
/// Writing the value of a key already present is safe during the walk. Adding or
/// removing a key is not: the walk then skips or repeats entries, so `collect()`
/// the keys first.
///
/// @param self  the map receiver.
/// @return      a lazy `Iterator<K>` over the stored keys.
export keys :: fn<K, V>(self: Map<K, V>) -> Iterator<K> {
    // A local: a loop body that calls out would reload the field at every entry.
    stored :: self.ekeys
    for i in 0..<self.size {
        yield stored[i]
    }
}

/// Walk every value in the order of `keys()`, over the map itself, under the same
/// rules for writing to the map during the walk.
///
/// @param self  the map receiver.
/// @return      a lazy `Iterator<V>` over the stored values.
export values :: fn<K, V>(self: Map<K, V>) -> Iterator<V> {
    // A local: a loop body that calls out would reload the field at every entry.
    stored :: self.evals
    for i in 0..<self.size {
        yield stored[i]
    }
}

// `for [k, v] in m` works directly thanks to the `Into<Iterator<...>>` impl
// below: no explicit conversion needed. Each entry is yielded as a plain
// `[K, V]` tuple (like `zip` / `indexed`), so the `[k, v]` destructure reads
// its two leaves positionally. `into` is a `generator` : a `for` loop or a
// terminal inlines its body, so `for [k, v] in m` never materialises it ; an
// escaping `m.into()` value materialises the generator's state machine. Walks the
// dense entry arrays by index, with no snapshot, under the rules of `keys()`: the
// value of a key already present may be written during the walk, while adding or
// removing a key skips or repeats entries.

Map<K, V> implements<K, V> Into<Iterator<[K, V]>> {
    into :: fn(self) -> Iterator<[K, V]> {
        // Held in locals: a loop body that calls out would otherwise reload them
        // from `self` at every entry.
        keys :: self.ekeys
        values :: self.evals
        for i in 0..<self.size {
            yield [keys[i], values[i]]
        }
    }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_map_put_get :: fn() -> void {
    m :: Map<string, i32> {}
    m["one"] = 1
    m["two"] = 2
    m["three"] = 3
    assert_eq(m.len(), 3)
    match v :: m.get("two") {
        is i32  -> assert_eq(v, 2)
        is null -> assert(false, "expected key two")
    }
    match m.get("missing") {
        is i32 -> assert(false, "expected null on missing")
        is null -> {}
    }
}

@test test_map_overwrite :: fn() -> void {
    m :: Map<string, i32> {}
    m["k"] = 1
    m["k"] = 99
    assert_eq(m.len(), 1)
    match v :: m.get("k") {
        is i32  -> assert_eq(v, 99)
        is null -> assert(false, "key k expected")
    }
}

@test test_map_contains_key :: fn() -> void {
    m :: Map<string, i32> {}
    m["k"] = 1
    assert(m.contains_key("k"), "should contain k")
    assert(!m.contains_key("nope"), "should not contain nope")
}

@test test_map_is_empty :: fn() -> void {
    m :: Map<string, i32> {}
    assert(m.is_empty(), "fresh map is empty")
    m["x"] = 1
    assert(!m.is_empty(), "after put no longer empty")
}

@test test_map_remove :: fn() -> void {
    m :: Map<string, i32> {}
    m["a"] = 1
    m["b"] = 2
    assert(m.remove("a"), "removing present key returns true")
    assert_eq(m.len(), 1)
    assert(!m.contains_key("a"), "removed key gone")
    assert(m.contains_key("b"), "untouched key stays")
    assert(!m.remove("a"), "removing absent key returns false")
    assert_eq(m.len(), 1)
}

@test test_map_iteration_order :: fn() -> void {
    m :: Map<i32, i32> {}
    for i in 0..<50 { m[i] = i * 2 }
    seen := 0
    sum := 0
    for [k, v] in m {
        seen = seen + 1
        sum = sum + v
        assert_eq(v, k * 2)
    }
    assert_eq(seen, 50)
    assert_eq(sum, 2450)
}

@test test_map_remove_then_reinsert :: fn() -> void {
    m :: Map<i32, i32> {}
    for i in 0..<100 { m[i] = i }
    for i in 0..<100 { if i % 3 == 0 { m.remove(i) } }
    for i in 0..<100 { if i % 3 == 0 { m[i] = i * 7 } }
    assert_eq(m.len(), 100)
    for i in 0..<100 {
        expected :: if i % 3 == 0 { i * 7 } else { i }
        match v :: m.get(i) {
            is i32  -> assert_eq(v, expected)
            is null -> assert(false, "key should be present")
        }
    }
}

@test
test_map_get_or_put_keeps_the_stored_value :: fn() -> void {
    m :: Map<string, i64> {}
    assert_eq(m.get_or_put("a", 1), 1)
    assert_eq(m.get_or_put("a", 2), 1)
    assert_eq(m.len(), 1)
}

@test
test_map_get_or_put_reuses_a_tombstone :: fn() -> void {
    m :: Map<i32, i32> {}
    for i in 0..<8 {
        m[i] = i
    }
    m.remove(3)
    assert_eq(m.get_or_put(3, 30), 30)
    assert_eq(m.len(), 8)
    assert_eq(m.tombs, 0)
}

@test
test_map_put_absent_stores_only_a_new_key :: fn() -> void {
    m :: Map<string, i64> {}
    assert(m.put_absent("a", 1) == null, "a new key is stored")
    assert_eq(m.put_absent("a", 2) ?? -1, 1)
    assert_eq(m["a"] ?? -1, 1)
    assert_eq(m.len(), 1)
}

@test
test_map_put_absent_reuses_a_tombstone :: fn() -> void {
    m :: Map<i32, i32> {}
    for i in 0..<8 {
        m[i] = i
    }
    m.remove(3)
    assert(m.put_absent(3, 30) == null, "a removed key is absent")
    assert_eq(m[3] ?? -1, 30)
    assert_eq(m.tombs, 0)
}

@test
test_map_put_absent_grows_on_the_insertion_past_three_quarters :: fn() -> void {
    m :: Map<i32, i32> {}
    for i in 0..<12 {
        m.put_absent(i, i)
    }
    assert_eq(m.index.len(), 16)
    m.put_absent(12, 12)
    assert_eq(m.index.len(), 32)
    assert_eq(m[12] ?? -1, 12)
}

@test
test_map_get_or_put_with_builds_only_on_a_miss :: fn() -> void {
    m :: Map<string, string[]> {}
    built: i32 = 0
    m.get_or_put_with("a", fn() {
        built += 1
        []
    }).push("x")
    m.get_or_put_with("a", fn() {
        built += 1
        []
    }).push("y")
    assert_eq(built, 1)
    assert_eq((m.get("a") ?? []).len(), 2)
}

@test
test_map_get_or_put_with_survives_a_make_that_inserts :: fn() -> void {
    m :: Map<i32, i32> {}
    got :: m.get_or_put_with(0, fn() {
        for i in 1..<40 {
            m[i] = i
        }
        100
    })
    assert_eq(got, 100)
    assert_eq(m.len(), 40)
    assert_eq(m.get(0) ?? -1, 100)
}

@test
test_map_put_of_a_present_key_does_not_grow :: fn() -> void {
    m :: Map<i32, i32> {}
    for i in 0..<12 {
        m[i] = i
    }
    before :: m.index.len()
    m[0] = 7
    assert_eq(m.index.len(), before)
}

@test
test_map_grows_on_the_insertion_past_three_quarters :: fn() -> void {
    m :: Map<i32, i32> {}
    for i in 0..<12 {
        m[i] = i
    }
    assert_eq(m.index.len(), 16)
    m[12] = 12
    assert_eq(m.index.len(), 32)
}

@test
test_map_tombstones_count_toward_growth :: fn() -> void {
    m :: Map<i32, i32> {}
    for i in 0..<12 {
        m[i] = i
    }
    m.remove(0)
    m.remove(1)
    m[100] = 100
    assert_eq(m.tombs, 0)
    assert_eq(m.index.len(), 16)
}

@test
test_map_get_or_put_grows_on_the_insertion_past_three_quarters :: fn() -> void {
    m :: Map<i32, i32> {}
    for i in 0..<12 {
        m.get_or_put(i, i)
    }
    assert_eq(m.index.len(), 16)
    m.get_or_put(12, 12)
    assert_eq(m.index.len(), 32)
}

@test
test_map_keys_walk_in_insertion_order :: fn() -> void {
    m :: Map<string, i32> {}
    m["b"] = 1
    m["a"] = 2
    m["c"] = 3
    seen: string[]: []
    for k in m.keys() {
        seen.push(k)
    }
    assert(seen.content_equals(["b", "a", "c"]), "keys in insertion order")
}

@test
test_map_values_walk_in_the_order_of_the_keys :: fn() -> void {
    m :: Map<string, i32> {}
    m["b"] = 1
    m["a"] = 2
    m["c"] = 3
    seen: i32[]: []
    for v in m.values() {
        seen.push(v)
    }
    assert(seen.content_equals([1, 2, 3]), "values in the order of the keys")
}

@test
test_map_keys_walk_allows_writing_present_keys :: fn() -> void {
    m :: Map<string, i32> {}
    m["a"] = 1
    m["b"] = 2
    for k in m.keys() {
        m[k] = (m[k] ?? 0) * 10
    }
    assert_eq(m["a"] ?? 0, 10)
    assert_eq(m["b"] ?? 0, 20)
}
