// std/iter: lazy `generator` iterator combinators + terminals.
//
//   - **Combinators** `map` / `filter` / `take` / `skip` / `take_while` /
//     `skip_while` / `step_by` / `scan` / `indexed` / `flat_map` / `chain` /
//     `zip` / `window` / `chunked` / `distinct` / `filter_not_null` are
//     `generator`s. `arr.map(f)` / `it.indexed()` read like
//     a pipeline and dispatch via UFCS ; consumed by a `for` loop or a terminal
//     (`collect` / `count` / `any_match` / ...), the chain fuses to a single flat
//     loop: no intermediate arrays, no iterator struct, no `next()` dispatch
//     (`vader/lower/iter_fusion.vader`). `chain` fuses two source loops ;
//     `zip` stays `T[]`/`U[]` (its lockstep pull needs indexed access, unlike the
//     source-driven combinators). Their tuple elements destructure in `for [x, y]
//     in`. The generator's state machine only materialises when the value escapes.
//   - **Terminals** `collect` / `fold` / `sum` / `count` / `last` / `is_empty` /
//     `any_match` / `all_match` / `find` / `find_map` take an `Iterator<T>` and
//     consume it with one `for` (a raw array auto-coerces at the call site) ; over
//     a chain, the call inlines into the fused loop.
//   - `count` on a `T[]` is its length, in O(1).
//   - `partition` / `group_by` / `unzip` sort the elements into several
//     collections (grouping.vader) ; `peekable` wraps an iterator so its next
//     element can be looked at first (peekable.vader).

module "std/iter"

import "std/collections"

/// True when `it` yields nothing. Pulls one element at most, with no peek: a
/// `false` result has consumed the first one.
///
/// @param it  source iterator.
export is_empty :: fn<T>(it: Iterator<T>) -> bool {
    for _ in it {
        return false
    }
    return true
}

/// How many elements `arr` holds: its length, O(1).
///
/// @param arr  source array.
export count :: fn<T>(arr: T[]) -> i64 = arr.len()

/// Drain `it`, returning how many elements it yielded: O(n).
///
/// @param it  source iterator.
export count :: fn<T>(it: Iterator<T>) -> i64 {
    total: i64 = 0
    for _ in it {
        total += 1
    }
    return total
}

/// Drain `it`, returning its last element, or `null` when it yields none.
///
/// @param it  source iterator.
export last :: fn<T>(it: Iterator<T>) -> T | null {
    result: T | null = null
    for x in it {
        result = x
    }
    return result
}

// `collect` on an array is `arr.clone()` (prelude) ; the only `collect` here
// is the Iterator terminal below: drains a lazy chain into a fresh array.

/// Drain `it` into a fresh array. Pair with the lazy combinators
/// (`it.filter(p).map(f).collect()`) when a snapshot is required ;
/// `for x in it` consumes directly without the intermediate array.
export collect :: fn<T>(it: Iterator<T>) -> T[] {
    out: T[]: []
    for x in it {
        out.push(x)
    }
    return out
}

// `map` / `filter` exist only as the lazy `generator` combinators (bottom of
// this file): `arr.map(f)` resolves unambiguously to the lazy `Iterator<U>`
// and fuses over the raw array (the implicit array head) ; drain to an array
// with `.collect()` when needed.

/// Left-fold the iterator with seed `init`. `f(acc, x)` is called for every
/// element in order ; the final accumulator is returned. A raw array coerces to
/// `Iterator<T>` at the call site (`arr.fold(0, add)` / `fold(arr, 0, add)`).
/// @param self  source iterator (or array, auto-coerced).
/// @param init  initial accumulator value.
/// @param f     reducer ; takes the running accumulator and the next element.
/// @return      the accumulator after consuming the iterator.
export fold :: fn<T, U>(self: Iterator<T>, init: U, f: fn(U, T) -> U) -> U {
    acc := init
    for x in self {
        acc = f(acc, x)
    }
    return acc
}

/// Sum the elements of an iterator (an array auto-coerces at the call site).
///
/// @param self  the elements to add.
/// @return      their sum ; `T.zero()` when there are none.
/// @example
///   total :: [1.5, 2.25].sum()   // 3.75
export sum :: fn<T: Add & Zero>(self: Iterator<T>) -> T {
    s := T.zero()
    for x in self {
        s += x
    }
    return s
}

/// Multiply the elements of an iterator (an array auto-coerces at the call site).
///
/// @param self  the elements to multiply.
/// @return      their product ; `T.one()` when there are none.
/// @example
///   total :: [2, 3, 4].product()   // 24
export product :: fn<T: Mul & One>(self: Iterator<T>) -> T {
    p := T.one()
    for x in self {
        p *= x
    }
    return p
}

/// Lazily pair elements of `self` and `other` into tuples, stopping at the
/// shorter of the two. Mirrors Python `zip` ; useful for stepping parallel
/// arrays in lockstep (e.g. keys + values from a map). Both inputs stay `T[]`/
/// `U[]`: the lockstep pull needs indexed access, so unlike the source-driven
/// combinators `zip` does not take a lazy `Iterator`. `for [x, y] in zip(a, b)`
/// destructures each pair ; consumed directly it fuses to a single index loop.
/// @param self   left source array.
/// @param other  right source array.
/// @return       a lazy `Iterator([T, U])`: `(self[0], other[0])`, ... capped at
///               `min(self.len(), other.len())`.
export zip :: fn<T, U>(self: T[], other: U[]) -> Iterator<[T, U]> {
    n :: if self.len() < other.len() { self.len() } else { other.len() }
    for i in 0..<n {
        yield [self[i], other[i]]
    }
}

/// Slide a fixed-size window over `self`, yielding each run of `size` consecutive
/// elements. Step 1, no partial windows: a source shorter than `size` yields
/// nothing. Like `zip`, takes `T[]` (not a lazy `Iterator`) because the
/// overlapping pull needs indexed access.
///
/// Each window is a zero-copy VIEW aliasing `self` (the built-in `arr[lo..<hi]`
/// slice): cheap, but a later mutation of `self` shows through ; `.clone()` a
/// window to detach it.
///
/// @param self  source array.
/// @param size  window width in elements ; `size == 0` (or `self.len() < size`)
///              yields nothing.
/// @return      a lazy `Iterator<T[]>`: `self[0..<size]`, `self[1..<size+1]`, ...
///              while the window fits.
/// @example
///   for w in [1, 2, 3, 4, 5].window(3) { println("${w}") }   // [1,2,3] [2,3,4] [3,4,5]
export window :: fn<T>(self: T[], size: i64) -> Iterator<T[]> {
    n :: self.len()
    count :: if size > 0 && n >= size { n - size + 1 } else { 0 }
    for start in 0..<count {
        yield self[start..<(start + size)]
    }
}

/// Lazily yield every element of `self`, then every element of `other`: a
/// concatenated stream. Fuses to two back-to-back source loops (no intermediate
/// array) when consumed by a `for` loop or a terminal.
/// @param self   first source iterator (a raw array auto-coerces at the call site).
/// @param other  second source, streamed after `self` is exhausted.
/// @return       a lazy `Iterator<T>` over `self` followed by `other`.
export chain :: fn<T>(self: Iterator<T>, other: Iterator<T>) -> Iterator<T> {
    for x in self { yield x }
    for y in other { yield y }
}

/// Lazily pair each element with its index, starting at 0: the element first,
/// so `for [x, i] in it.indexed() { ... }` reads in the order it is yielded. A
/// 0-arg combinator: fuses over the source with no intermediate array.
/// @param self  source iterator (a raw array auto-coerces at the call site).
/// @return      a lazy `Iterator<[T, i64]>`: `[self[0], 0]`, `[self[1], 1]`, ...
export indexed :: fn<T>(self: Iterator<T>) -> Iterator<[T, i64]> {
    i: i64 = 0
    for x in self {
        yield [x, i]
        i += 1
    }
}

/// The most elements `chunked` reserves up front for one chunk.
CHUNK_RESERVE_CAP: i64: 1024

/// Split `self` into consecutive runs of `size` elements ; the last run holds
/// what remains and may be shorter.
///
/// Unlike `window`, each chunk is a FRESH array, not a view: the source is a
/// lazy `Iterator`, so there is nothing to alias.
///
/// @param self  source iterator (a raw array auto-coerces at the call site).
/// @param size  elements per chunk ; `size == 0` yields nothing.
/// @return      a lazy `Iterator<T[]>`: `[x0, ..., x(size-1)]`, then the next
///              run, ... , then the shorter remainder if any.
/// @example
///   for c in [1, 2, 3, 4, 5].chunked(2) { println("${c}") }   // [1, 2] [3, 4] [5]
export chunked :: fn<T>(self: Iterator<T>, size: i64) -> Iterator<T[]> {
    if size == 0 {
        return
    }
    // Capped : a huge `size` over a short stream must not reserve it whole.
    reserve :: if size < CHUNK_RESERVE_CAP { size } else { CHUNK_RESERVE_CAP }
    chunk: T[] = [] * reserve
    for x in self {
        chunk.push(x)
        if chunk.len() == size {
            yield chunk
            chunk = [] * reserve
        }
    }
    if chunk.len() > 0 {
        yield chunk
    }
}

/// Lazily yield each element of `self` the first time it occurs, in order of
/// first occurrence.
///
/// Remembers every element seen so far, so memory grows with the number of
/// DISTINCT elements, not with the length of the stream.
///
/// @param self  source iterator (a raw array auto-coerces at the call site).
/// @return      a lazy `Iterator<T>` with every repeat dropped.
/// @example
///   for x in [3, 1, 3, 2, 1].distinct() { println("${x}") }   // 3 1 2
export distinct :: fn<T: Hash & Equals>(self: Iterator<T>) -> Iterator<T> {
    seen :: Set<T> {}
    for x in self {
        if seen.add(x) {
            yield x
        }
    }
}

/// Lazily yield the non-null elements of `self`, typed without the `null`.
/// @param self  source iterator over a nullable element type.
/// @return      a lazy `Iterator<T>`: `self` with every `null` dropped.
/// @example
///   maybe: (i32 | null)[]: [1, null, 3]
///   for x in maybe.filter_not_null() { println("${x + 1}") }   // 2 4
export filter_not_null :: fn<T>(self: Iterator<T | null>) -> Iterator<T> {
    for x in self {
        if x != null {
            yield x
        }
    }
}

/// Apply `f` to each element and yield the elements of every resulting array in
/// order. Useful when one input expands to zero-or-more outputs (parsing, tree
/// flattening).
/// @param self  source iterator.
/// @param f     mapper from one element to an array of outputs.
/// @return      an iterator over `f(x0)` then `f(x1)` then ... , flattened.
export flat_map :: fn<T, U>(self: Iterator<T>, f: fn(T) -> U[]) -> Iterator<U> {
    for x in self {
        for y in f(x) {
            yield y
        }
    }
}

// ---------------------------------------------------------------- short-circuit
//
// Each combinator takes an `Iterator<T>`. Raw arrays are accepted at the
// call site via the blanket `T[] implements<T> Into<Iterator<T>>` impl in
// `std/core`: both direct (`any_match(arr, p)`) and UFCS (`arr.any_match(p)`) forms
// auto-coerce.

/// `true` as soon as any element satisfies `pred` ; `false` if none do.
/// Short-circuits: `pred` is not invoked past the first match.
/// @param it    source array or iterator.
/// @param pred  predicate invoked on each element until one returns `true`.
export any_match :: fn<T>(it: Iterator<T>, pred: fn(T) -> bool) -> bool {
    for x in it {
        if pred(x) {
            return true
        }
    }
    return false
}

/// `true` only when every element satisfies `pred`. Short-circuits on the
/// first `false`. Returns `true` on an empty source (vacuous truth).
/// @param it    source array or iterator.
/// @param pred  predicate invoked on each element until one returns `false`.
export all_match :: fn<T>(it: Iterator<T>, pred: fn(T) -> bool) -> bool {
    for x in it {
        if !pred(x) {
            return false
        }
    }
    return true
}

/// First element matching `pred`, or `null` if none does. Short-circuits.
/// Consumers narrow naturally : `match hit :: arr.find(p) { is T -> ... }`.
/// @param it    source array or iterator.
/// @param pred  predicate invoked on each element until one returns `true`.
export find :: fn<T>(it: Iterator<T>, pred: fn(T) -> bool) -> T | null {
    for x in it {
        if pred(x) {
            return x
        }
    }
    return null
}

/// Apply `f` to each element ; return the first non-null result. Combines
/// the transform and the search in one pass: useful for parsing chains
/// where the mapper itself decides whether an element qualifies.
/// @param it  source array or iterator.
/// @param f   mapper that returns `null` to skip the element or a value
///            to short-circuit on.
export find_map :: fn<T, U>(it: Iterator<T>, f: fn(T) -> U | null) -> U | null {
    for x in it {
        v :: f(x)
        if v != null {
            return v
        }
    }
    return null
}

// ---- Lazy iterator chains -------------------------------------------------
//
// Each combinator below is a `generator` over a source `Iterator<T>` : it
// `yield`s transformed elements one at a time, so a chain stays lazy: an
// element only flows through when the downstream consumer pulls it (`next()`,
// or `for x in chain {...}`). The fluent shape (`it.map(f).filter(p)`) reads
// like an Iterator pipeline and dispatches via UFCS through the first param's
// type: overload-resolved against the eager `T[]`-first-param siblings above.
// The lowerer's iter-chain fusion folds a `for`/terminal-consumed chain into a
// single counter loop when it bottoms at an inline range or an array.

/// Fluent lazy `filter`. Distinct from the eager `T[]`-overload above:
/// the resolver picks this one when the receiver implements `Iterator<T>`
/// (Range, an array iterator, Map, ...).
export filter :: fn<T>(self: Iterator<T>, pred: fn(T) -> bool) -> Iterator<T> {
    for x in self { if pred(x) { yield x } }
}

/// Fluent lazy `map`. Mirror of `filter` for transforms ; element type
/// can change (`T` -> `U`).
export map :: fn<T, U>(self: Iterator<T>, f: fn(T) -> U) -> Iterator<U> {
    for x in self { yield f(x) }
}

/// Fluent lazy `take`. Yields the first `n` items from `self`, then ends:
/// pulling exactly `n` items from `self`, none for an `n` of 0 or less.
export take :: fn<T>(self: Iterator<T>, n: i64) -> Iterator<T> {
    if n <= 0 {
        return
    }
    i: i64 = 0
    for x in self {
        yield x
        i += 1
        if i >= n {
            break
        }
    }
}

/// Fluent lazy `skip`. Drops the first `n` items from `self`, then forwards
/// every subsequent item.
export skip :: fn<T>(self: Iterator<T>, n: i64) -> Iterator<T> {
    i: i64 = 0
    for x in self {
        if i >= n { yield x }
        i += 1
    }
}

/// Fluent lazy `take_while`. Yields the leading elements of `self` that satisfy
/// `pred`, and ends at the first one that does not: that one is pulled from
/// `self`, but not yielded.
///
/// @param self  source iterator (a raw array auto-coerces at the call site).
/// @param pred  keeps an element while it holds.
/// @example
///   [1, 2, 5, 1].take_while((x: i32) -> x < 3).collect()   // [1, 2]
export take_while :: fn<T>(self: Iterator<T>, pred: fn(T) -> bool) -> Iterator<T> {
    for x in self {
        if !pred(x) {
            break
        }
        yield x
    }
}

/// Fluent lazy `skip_while`. Drops the leading elements of `self` that satisfy
/// `pred`, then forwards every element from the first one that does not,
/// whatever `pred` says of the later ones.
///
/// @param self  source iterator (a raw array auto-coerces at the call site).
/// @param pred  drops an element while it holds.
/// @example
///   [1, 2, 5, 1].skip_while((x: i32) -> x < 3).collect()   // [5, 1]
export skip_while :: fn<T>(self: Iterator<T>, pred: fn(T) -> bool) -> Iterator<T> {
    skipping := true
    for x in self {
        if skipping && pred(x) {
            continue
        }
        skipping = false
        yield x
    }
}

/// Fluent lazy `step_by`. Yields the first element of `self`, then every
/// `step`-th one after it: the elements at 0, `step`, `2 * step`... A `step` of
/// 0 or less yields nothing, as `chunked(0)` does.
///
/// @param self  source iterator (a raw array auto-coerces at the call site).
/// @param step  the distance between two yielded elements.
/// @example
///   (0..<10).step_by(3).collect()   // [0, 3, 6, 9]
export step_by :: fn<T>(self: Iterator<T>, step: i64) -> Iterator<T> {
    if step <= 0 {
        return
    }
    // Elements still to drop before the next one is yielded.
    gap: i64 = 0
    for x in self {
        if gap == 0 {
            yield x
            gap = step - 1
        } else {
            gap -= 1
        }
    }
}

/// Fluent lazy `scan`. Folds `self` as `fold` does and yields the state after
/// each element. `init` itself is not yielded, so an empty source yields
/// nothing.
///
/// @param self  source iterator (a raw array auto-coerces at the call site).
/// @param init  the state before the first element.
/// @param f     the next state, from the state so far and an element.
/// @return      a lazy `Iterator<U>` with one state per element.
/// @example
///   [1, 2, 3].scan(0, (total: i32, x: i32) -> total + x).collect()   // [1, 3, 6]
export scan :: fn<T, U>(self: Iterator<T>, init: U, f: fn(U, T) -> U) -> Iterator<U> {
    state := init
    for x in self {
        state = f(state, x)
        yield state
    }
}

// The lazy combinators map/filter/take/skip are `generator`s (above).
// Consumed directly (`for` / a terminal), a chain fuses to a flat loop; the
// generator's own state machine only materialises for an escaping iterator
// value.

// ---- extrema --------------------------------------------------------------

/// The least element of an iterator (an array auto-coerces at the call site).
///
/// @param self  the elements to compare.
/// @return      the least, the first of equal ones ; `null` when there are none.
/// @example
///   [3, 1, 2].min()   // 1
export min :: fn<T: Comparable>(self: Iterator<T>) -> T | null {
    least: T | null = null
    for x in self {
        if least == null || x < least {
            least = x
        }
    }
    return least
}

/// The greatest element of an iterator (an array auto-coerces at the call site).
///
/// @param self  the elements to compare.
/// @return      the greatest, the first of equal ones ; `null` when there are none.
/// @example
///   ["pear", "fig"].max()   // "pear"
export max :: fn<T: Comparable>(self: Iterator<T>) -> T | null {
    greatest: T | null = null
    for x in self {
        if greatest == null || x > greatest {
            greatest = x
        }
    }
    return greatest
}

/// The element whose `key` is least (an array auto-coerces at the call site).
///
/// @param self  the elements to compare.
/// @param key   the value each element is compared by.
/// @return      the element of least key, the first of equal ones ; `null` when
///              there are none.
/// @example
///   ["pear", "fig", "apple"].min_by((s: string) -> s.byte_len())   // "fig"
export min_by :: fn<T, K: Comparable>(self: Iterator<T>, key: fn(T) -> K) -> T | null {
    least: T | null = null
    least_key: K | null = null
    for x in self {
        k :: key(x)
        if least_key == null || k < least_key {
            least = x
            least_key = k
        }
    }
    return least
}

/// The element whose `key` is greatest (an array auto-coerces at the call site).
///
/// @param self  the elements to compare.
/// @param key   the value each element is compared by.
/// @return      the element of greatest key, the first of equal ones ; `null`
///              when there are none.
/// @example
///   ["pear", "fig", "apple"].max_by((s: string) -> s.byte_len())   // "apple"
export max_by :: fn<T, K: Comparable>(self: Iterator<T>, key: fn(T) -> K) -> T | null {
    greatest: T | null = null
    greatest_key: K | null = null
    for x in self {
        k :: key(x)
        if greatest_key == null || k > greatest_key {
            greatest = x
            greatest_key = k
        }
    }
    return greatest
}

// ---------------------------------------------------------------------- tests

import "std/testing"

@test test_count :: fn() -> void {
    assert_eq((0..<3).count(), 3)
    assert_eq((0..<0).count(), 0)
}

@test test_last :: fn() -> void {
    assert_eq((0..<3).last() else -1, 2)
    assert_eq((0..<0).last() else -1, -1)
}

@test test_count_of_an_array :: fn() -> void {
    assert_eq([4, 5, 6].count(), 3)
}

@test test_is_empty_iterator :: fn() -> void {
    assert((0..<0).is_empty(), "an empty range")
    assert(!(0..<3).is_empty(), "a range with elements")
}

@test test_sum :: fn() -> void {
    assert_eq(sum([1, 2, 3, 4]), 10)
    empty: i32[]: []
    assert_eq(sum(empty), 0)
}

@test test_map :: fn() -> void {
    out :: [1, 2, 3].map((x: i32) -> x * 2).collect()
    assert_eq(out.len(), 3)
    assert_eq(out[0], 2)
    assert_eq(out[1], 4)
    assert_eq(out[2], 6)
}

@test test_filter :: fn() -> void {
    out :: [1, 2, 3, 4, 5].filter((x: i32) -> x % 2 == 0).collect()
    assert_eq(out.len(), 2)
    assert_eq(out[0], 2)
    assert_eq(out[1], 4)
}

@test test_fold :: fn() -> void {
    total :: [1, 2, 3, 4].fold(0, (acc: i32, x: i32) -> acc + x)
    assert_eq(total, 10)
    folded :: [2, 3, 4].fold(1, (acc: i32, x: i32) -> acc * x)
    assert_eq(folded, 24)
}

@test test_slice :: fn() -> void {
    out :: [1, 2, 3, 4, 5][1..<4]
    assert_eq(out.len(), 3)
    assert_eq(out[0], 2)
    assert_eq(out[2], 4)
}

@test test_window :: fn() -> void {
    windows: i32[][]: []
    for w in [1, 2, 3, 4, 5].window(3) {
        windows.push(w)
    }
    assert_eq(windows.len(), 3)          // [1,2,3] [2,3,4] [3,4,5]
    assert_eq(windows[0][0], 1)
    assert_eq(windows[0][2], 3)
    assert_eq(windows[2][0], 3)
    assert_eq(windows[2][2], 5)

    // no partial windows : size > len yields nothing
    over: i32[][]: []
    for w in [1, 2, 3].window(5) {
        over.push(w)
    }
    assert_eq(over.len(), 0)

    // size 0 yields nothing
    zero: i32[][]: []
    for w in [1, 2, 3].window(0) {
        zero.push(w)
    }
    assert_eq(zero.len(), 0)
}

@test test_chain :: fn() -> void {
    out: i32[]: []
    for x in chain([1, 2], [3, 4, 5]) {
        out.push(x)
    }
    assert_eq(out.len(), 5)
    assert_eq(out[0], 1)
    assert_eq(out[4], 5)
}

@test test_indexed :: fn() -> void {
    idxs: i64[]: []
    vals: string[]: []
    for [s, i] in ["a", "b", "c"].indexed() {
        idxs.push(i)
        vals.push(s)
    }
    assert_eq(idxs.len(), 3)
    assert_eq(idxs[0], 0)
    assert_eq(vals[0], "a")
    assert_eq(idxs[2], 2)
    assert_eq(vals[2], "c")
}

@test test_chunked :: fn() -> void {
    chunks :: [1, 2, 3, 4, 5].chunked(2).collect()
    assert_eq(chunks.len(), 3)
    assert_eq(chunks[0][1], 2)
    assert_eq(chunks[1][0], 3)
    assert_eq(chunks[2].len(), 1)
    assert_eq(chunks[2][0], 5)
}

@test test_chunked_exact_multiple :: fn() -> void {
    assert_eq([1, 2, 3, 4].chunked(2).count(), 2)
}

@test test_chunked_zero_size :: fn() -> void {
    assert_eq([1, 2, 3].chunked(0).count(), 0)
}

@test test_chunked_empty :: fn() -> void {
    empty: i32[]: []
    assert_eq(empty.chunked(3).count(), 0)
}

@test test_distinct :: fn() -> void {
    out :: [3, 1, 3, 2, 1].distinct().collect()
    assert_eq(out.len(), 3)
    assert_eq(out[0], 3)
    assert_eq(out[1], 1)
    assert_eq(out[2], 2)
}

@test test_distinct_strings :: fn() -> void {
    assert_eq(["a", "b", "a", "a"].distinct().count(), 2)
}

@test test_filter_not_null :: fn() -> void {
    maybe: (i32 | null)[]: [1, null, 3, null]
    assert_eq(maybe.filter_not_null().sum(), 4)
}

@test test_any_match :: fn() -> void {
    assert([1, 2, 3].any_match((x: i32) -> x == 2), "should find 2")
    assert(![1, 2, 3].any_match((x: i32) -> x == 9), "should not find 9")
    empty: i32[]: []
    assert(!empty.any_match((x: i32) -> true), "an empty array never matches")
}

@test test_all_match :: fn() -> void {
    assert([2, 4, 6].all_match((x: i32) -> x % 2 == 0), "all even")
    assert(![2, 3, 6].all_match((x: i32) -> x % 2 == 0), "3 is odd")
    empty: i32[]: []
    assert(empty.all_match((x: i32) -> false), "an empty array always matches (vacuous)")
}

@test test_find :: fn() -> void {
    match hit :: [1, 2, 3, 4].find((x: i32) -> x > 2) {
        is i32  -> assert_eq(hit, 3)
        is null -> fail("expected to find 3")
    }
    match [1, 2, 3].find((x: i32) -> x > 99) {
        is i32 -> fail("should not find anything")
        is null -> {}
    }
}

@test test_find_map :: fn() -> void {
    parse_positive :: fn(x: i32) -> i32 | null {
        if x > 0 { return x * 10 }
        return null
    }
    match hit :: [-1, -2, 3, 4].find_map(parse_positive) {
        is i32  -> assert_eq(hit, 30)
        is null -> fail("expected first positive")
    }
    match [-1, -2, -3].find_map(parse_positive) {
        is i32 -> fail("should not find anything")
        is null -> {}
    }
}

// Two instances of one combinator in a fused chain keep their own parameters and
// counters. Each chain is consumed where it is written, which is where it fuses.

@test test_fused_map_twice :: fn() -> void {
    digits := 0
    for v in [1, 2, 3].map((x: i32) -> x + 1).map((x: i32) -> x * 2) {
        digits = digits * 10 + v
    }
    assert_eq(digits, 468)
}

@test test_fused_filter_twice :: fn() -> void {
    kept :: [1, 2, 3, 4, 5, 6, 7].filter((x: i32) -> x % 2 == 1).filter((x: i32) -> x < 6).count()
    assert_eq(kept, 3)
}

@test test_fused_take_twice :: fn() -> void {
    assert_eq([1, 2, 3, 4, 5, 6, 7].take(5).take(2).count(), 2)
}

@test test_fused_skip_twice :: fn() -> void {
    assert_eq([1, 2, 3, 4, 5, 6, 7].skip(1).skip(2).count(), 4)
}

// `take(n)` pulls exactly `n` items from its source, fused where it is consumed
// and lazy once bound to a local.

take_pulls_fused :: fn(n: i64) -> i32 {
    pulls := 0
    counted :: (x: i32) -> {
        pulls += 1
        return x
    }
    for _ in [1, 2, 3, 4].map(counted).take(n) {
    }
    return pulls
}

take_pulls_lazy :: fn(n: i64) -> i32 {
    pulls := 0
    counted :: (x: i32) -> {
        pulls += 1
        return x
    }
    it :: [1, 2, 3, 4].map(counted).take(n)
    for _ in it {
    }
    return pulls
}

@test test_take_pulls_n_fused :: fn() -> void {
    assert_eq(take_pulls_fused(2), 2)
}

@test test_take_pulls_n_lazy :: fn() -> void {
    assert_eq(take_pulls_lazy(2), 2)
}

@test test_take_zero_pulls_nothing_fused :: fn() -> void {
    assert_eq(take_pulls_fused(0), 0)
}

@test test_take_zero_pulls_nothing_lazy :: fn() -> void {
    assert_eq(take_pulls_lazy(0), 0)
}

@test test_take_negative_pulls_nothing_fused :: fn() -> void {
    assert_eq(take_pulls_fused(-1), 0)
}

@test test_take_negative_pulls_nothing_lazy :: fn() -> void {
    assert_eq(take_pulls_lazy(-1), 0)
}

@test
test_min_of_nothing_is_null :: fn() -> void {
    assert((0..<0).min() == null, "an empty range has no least element")
}

@test
test_min_takes_the_least :: fn() -> void {
    assert_eq([3, 1, 2].min() else -1, 1)
}

@test
test_max_takes_the_greatest :: fn() -> void {
    assert_eq(["pear", "fig", "apple"].max() else "", "pear")
}

@test
test_min_by_takes_the_least_key :: fn() -> void {
    assert_eq(["pear", "fig", "apple", "kiwi"].min_by((s: string) -> s.byte_len()) else "", "fig")
}

@test
test_max_by_keeps_the_first_of_equal_keys :: fn() -> void {
    assert_eq(["pear", "fig", "kiwi"].max_by((s: string) -> s.byte_len()) else "", "pear")
}

@test
test_min_by_of_nothing_is_null :: fn() -> void {
    empty: string[]: []
    assert(empty.min_by((s: string) -> s.byte_len()) == null, "no element, no least key")
}

@test
test_take_while_stops_at_the_first_refusal :: fn() -> void {
    assert([1, 2, 5, 1].take_while((x: i32) -> x < 3).collect().content_equals([1, 2]), "1 and 2")
}

@test
test_take_while_lazy :: fn() -> void {
    it :: [1, 2, 5, 1].take_while((x: i32) -> x < 3)
    assert(it.collect().content_equals([1, 2]), "1 and 2, lazily")
}

@test
test_skip_while_forwards_from_the_first_refusal :: fn() -> void {
    assert([1, 2, 5, 1].skip_while((x: i32) -> x < 3).collect().content_equals([5, 1]), "5, then 1")
}

@test
test_skip_while_lazy :: fn() -> void {
    it :: [1, 2, 5, 1].skip_while((x: i32) -> x < 3)
    assert(it.collect().content_equals([5, 1]), "5, then 1, lazily")
}

@test
test_step_by_takes_every_step :: fn() -> void {
    assert((0..<10).step_by(3).collect().content_equals([0, 3, 6, 9]), "every third")
}

@test
test_step_by_one_keeps_every_element :: fn() -> void {
    assert([7, 8].step_by(1).collect().content_equals([7, 8]), "a step of 1 keeps all")
}

@test
test_step_by_zero_yields_nothing :: fn() -> void {
    assert_eq([1, 2, 3].step_by(0).count(), 0)
}

@test
test_scan_yields_each_state :: fn() -> void {
    totals :: [1, 2, 3].scan(0, (total: i32, x: i32) -> total + x).collect()
    assert(totals.content_equals([1, 3, 6]), "running totals")
}

@test
test_scan_of_nothing_yields_nothing :: fn() -> void {
    empty: i32[]: []
    assert_eq(empty.scan(0, (total: i32, x: i32) -> total + x).count(), 0)
}

@test
test_scan_lazy_changes_type :: fn() -> void {
    it :: [1, 2, 3].scan("", (text: string, x: i32) -> "${text}${x}")
    assert(it.collect().content_equals(["1", "12", "123"]), "running concatenation")
}
