// std/iter/grouping.vader: terminals that sort the elements of an iterator
// into several collections.

module "std/iter"

import "std/collections"

/// Split `self` in two by `pred`, keeping the order within each part. Mirrors
/// Kotlin's `partition`.
///
/// @param self  source iterator (a raw array auto-coerces at the call site).
/// @param pred  picks the part of each element.
/// @return      `[matching, others]`: the elements `pred` holds for, then the
///              rest.
/// @example
///   [1, 2, 3, 4, 5].partition((x: i32) -> x % 2 == 0)   // [[2, 4], [1, 3, 5]]
export partition :: fn<T>(self: Iterator<T>, pred: fn(T) -> bool) -> [T[], T[]] {
    matching: T[]: []
    others: T[]: []
    for x in self {
        if pred(x) {
            matching.push(x)
        } else {
            others.push(x)
        }
    }
    return [matching, others]
}

/// Gather the elements of `self` by `key`: each group keeps the source order,
/// and the groups come in the order their key first occurs. Mirrors Kotlin's
/// `groupBy`.
///
/// @param self  source iterator (a raw array auto-coerces at the call site).
/// @param key   the group of each element ; runs once per element.
/// @example
///   ["fig", "pear", "kiwi"].group_by((s: string) -> s.byte_len())   // {3: ["fig"], 4: ["pear", "kiwi"]}
export group_by :: fn<T, K: Hash & Equals>(self: Iterator<T>, key: fn(T) -> K) -> Map<K, T[]> {
    groups :: Map<K, T[]> {}
    for x in self {
        groups.get_or_put_with(key(x), () -> []).push(x)
    }
    return groups
}

/// Split a stream of pairs into the array of their first elements and the
/// array of their second ones: the inverse of `zip`.
///
/// @param self  source iterator over pairs.
/// @return      `[firsts, seconds]`, both as long as `self`.
/// @example
///   [1, 2].zip(["a", "b"]).unzip()   // [[1, 2], ["a", "b"]]
export unzip :: fn<T, U>(self: Iterator<[T, U]>) -> [T[], U[]] {
    firsts: T[]: []
    seconds: U[]: []
    for [first, second] in self {
        firsts.push(first)
        seconds.push(second)
    }
    return [firsts, seconds]
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_partition_keeps_the_order :: fn() -> void {
    [even, odd] :: [1, 2, 3, 4, 5].partition((x: i32) -> x % 2 == 0)
    assert(even.content_equals([2, 4]), "the even numbers")
    assert(odd.content_equals([1, 3, 5]), "the odd numbers")
}

@test
test_group_by_follows_the_first_occurrence :: fn() -> void {
    groups :: ["fig", "pear", "kiwi", "yam"].group_by((s: string) -> s.byte_len())
    assert(groups.keys().collect().content_equals([3, 4]), "lengths in order of first occurrence")
    assert((groups[3] ?? []).content_equals(["fig", "yam"]), "the 3-letter words")
    assert((groups[4] ?? []).content_equals(["pear", "kiwi"]), "the 4-letter words")
}

@test
test_unzip_inverts_zip :: fn() -> void {
    [numbers, letters] :: [1, 2, 3].zip(["a", "b", "c"]).unzip()
    assert(numbers.content_equals([1, 2, 3]), "the first elements")
    assert(letters.content_equals(["a", "b", "c"]), "the second elements")
}
