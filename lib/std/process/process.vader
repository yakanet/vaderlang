// std/process: external-process invocation, async-first.
//
// `spawn_async` is the primitive: a non-blocking awaitable over a child
// process. `spawn_start` launches the child, the awaitable polls
// it to completion on the cooperative scheduler (`spawn_poll`, re-arming a
// short timer between polls — the same timer-driven suspension `std/async`'s
// `sleep` uses), then interns the captured pipes (`spawn_take_stdout/_stderr`).
// Launching N children and joining them with `std/async::join_all` runs them
// concurrently — the OS schedules the child processes across cores.
//
// Blocking `spawn` is `block_on(spawn_async(...))`: one mechanism, cross-
// platform (the child primitives have a POSIX and a Win32 body).
//
// `run_attached` is the other shape: the child shares this process's standard
// streams instead of having them captured, and the call blocks until it exits.
//
// Native-only in MVP: the child primitives sit on `posix_spawn` + pipes (POSIX)
// and `CreateProcessA` + pipes (Windows). WASM has no spawn equivalent.

module "std/process"

import "std/async"
import "std/numbers"
import "std/runtime"
import "system/posix"
import "system/windows"

// Poll interval, ms. A child `cc` runs for 100s of ms, so a 2 ms detection
// latency is negligible ; the scheduler `nanosleep`s between polls (no spin).
POLL_MS: i64: 2

// `spawn_poll` returns RUNNING while the child is alive, SIGNALED on abnormal termination,
// else the exit code (>= 0). `spawn_start` returns a handle (>= 0) or a
// negative value on launch failure.
RUNNING  :: -1
SIGNALED :: -2

/// Error from `spawn` / `spawn_async` when the child can't be launched or
/// terminates abnormally (a non-zero exit is NOT an error — it rides in
/// `ProcessResult.exit`).
export ProcessError :: struct {
    msg: string
}

ProcessError implements Error {
    message :: fn(self) -> string { return self.msg }
}

/// Outcome of a child that ran to completion. `exit` is the OS exit status ;
/// `stdout` / `stderr` hold the full captured pipe contents.
export ProcessResult :: struct {
    exit:   i32
    stdout: string
    stderr: string
}

// ---- the child table -------------------------------------------------------
//
// One tracked child per slot; a handle is an opaque `i64` index into
// `children()`.
//
// Draining is POLL-BEFORE-READ on both systems: ask whether bytes are waiting,
// read only then. The alternative on POSIX is a non-blocking descriptor and on
// Windows a thread per pipe, and the reason for either is the same deadlock —
// a child that fills one pipe while the parent blocks on the other. One
// question asked before each read removes it without a descriptor flag or a
// thread.

/// One tracked child. `proc`, `out_h` and `err_h` are the pid and the two pipe
/// descriptors on POSIX; Windows keeps its handles in `win_handles()` instead.
Child :: struct {
    in_use:    bool  = false
    done:      bool  = false
    exit_code: i32   = 0
    out:       u8[] = []
    err:       u8[] = []
    proc:      i64   = 0
    out_h:     i64   = -1
    err_h:     i64   = -1
    out_eof:   bool  = false
    err_eof:   bool  = false
}

// The children `spawn` started, by handle. A slot is reset to `Child {}` when its
// handle is released.
@singleton
children :: fn() -> Child[] = []

// Windows handles, three words per child (process, stdout read end, stderr read
// end), indexed by handle. Stored as machine words and read back as handles
// through `ptr_at`: a `CPointer` cannot be rebuilt from an integer (T3010).
@singleton
win_handles :: fn() -> u64[] = []

/// The `k`-th handle of child `handle` — 0 process, 1 stdout, 2 stderr.
///
/// @param handle  the child handle.
/// @param k       which of the three.
win_handle :: fn(handle: i64, k: i64) -> Handle = ptr_at(win_handles(), handle * 3 + k)

/// How much to ask for per drain. One page: large enough that a chatty child
/// does not need many rounds, small enough that an idle one costs a syscall
/// and an empty answer.
DRAIN_CHUNK: i64: 4096

/// Take a free slot, growing the table when every one is busy.
///
/// @return  the handle.
child_alloc :: fn() -> i64 {
    table :: children()
    for i in 0..<table.len() {
        if !table[i].in_use {
            table[i] = Child { .in_use = true }
            return i
        }
    }
    table.push(Child { .in_use = true })
    return table.len() - 1
}

/// Whether `handle` names a live slot.
///
/// @param handle  the handle to check.
child_valid :: fn(handle: i64) -> bool =
    handle >= 0 && handle < children().len() && children()[handle].in_use

/// Number of logical processors online — what a caller sizes a parallel fan-out
/// on. At least 1: a platform that cannot tell answers 1.
export processor_count :: fn() -> i32 {
    n :: platform_processor_count()
    return if n < 1 { 1 } else { i32(n) }
}

// The platform call's own answer, failure included (-1 from `sysconf`, 0 from
// Win32), so a test can tell a wrong selector from a one-processor machine.
@target
platform_processor_count :: fn() -> i64 = 1

@target(.Linux, .Darwin)
platform_processor_count :: fn() -> i64 = sys_sysconf(SC_NPROCESSORS_ONLN)

@target(.Windows)
platform_processor_count :: fn() -> i64 = i64(get_active_processor_count(ALL_PROCESSOR_GROUPS))

/// Launch `argv` without waiting ; returns a handle into the child table, or a
/// negative value on launch failure. Pipes for stdout/stderr are captured and
/// drained by `spawn_poll`.
@target
export spawn_start :: fn(argv: string[]) -> i64

/// Advance a launched child WITHOUT blocking: drain its pipes and reap if it
/// exited. Returns `RUNNING` while alive, `SIGNALED` on abnormal termination,
/// else the exit code (>= 0).
@target
export spawn_poll :: fn(handle: i64) -> i32

/// Terminate a spawned child and reap it, freeing its slot.
///
/// For a caller that has given up — a timeout fired, and without this the child
/// keeps running after its parent stopped caring, holding a core and its table
/// slot. SIGKILL rather than a polite signal: this is the path for code that is
/// not responding. Idempotent — killing a finished or unknown handle does
/// nothing, since a caller cannot know which it holds.
///
/// @param handle  the handle `spawn_start` returned.
@target
export spawn_kill :: fn(handle: i64) -> void

@target(.Linux, .Darwin)
spawn_start :: fn(argv: string[]) -> i64 {
    if argv.len() == 0 {
        return -1
    }
    out_fds: i32[]: [0, 0]
    err_fds: i32[]: [0, 0]
    if sys_pipe(out_fds) != 0 {
        return -1
    }
    if sys_pipe(err_fds) != 0 {
        sys_close(out_fds[0])
        sys_close(out_fds[1])
        return -1
    }
    actions: u8[]: [0] * SPAWN_ACTIONS_BYTES
    if sys_spawn_actions_init(actions) != 0 {
        close_pair(out_fds)
        close_pair(err_fds)
        return -1
    }
    // The child keeps only the write ends, dup'd onto its own 1 and 2.
    sys_spawn_actions_addclose(actions, out_fds[0])
    sys_spawn_actions_addclose(actions, err_fds[0])
    sys_spawn_actions_adddup2(actions, out_fds[1], 1)
    sys_spawn_actions_adddup2(actions, err_fds[1], 2)
    sys_spawn_actions_addclose(actions, out_fds[1])
    sys_spawn_actions_addclose(actions, err_fds[1])

    words :: c_argv(argv)
    pid: i32[]: [0]
    rc :: sys_posix_spawnp(pid, argv[0], actions, null, words.vec, sys_environ())
    sys_spawn_actions_destroy(actions)
    free_c_argv(words)
    // The parent holds the read ends only; the child owns the write ends now,
    // and leaving them open here would keep EOF from ever arriving.
    sys_close(out_fds[1])
    sys_close(err_fds[1])
    if rc != 0 {
        sys_close(out_fds[0])
        sys_close(err_fds[0])
        return -1
    }
    h :: child_alloc()
    children()[h] = Child {
        .in_use = true,
        .proc   = i64(pid[0]),
        .out_h  = i64(out_fds[0]),
        .err_h  = i64(err_fds[0]),
    }
    return h
}

/// `argv` as the NULL-terminated `char*` vector a spawn takes, in two views of
/// one vector: `owned` holds the pointers so they can be freed, `vec` is the
/// `u64[]` that lends as the `char**`.
CArgv :: struct {
    owned: CPointer[]
    vec:   u64[]
}

/// Copy `argv` into C strings, freed by `free_c_argv` once the spawn returns.
///
/// @param argv  the words.
c_argv :: fn(argv: string[]) -> CArgv {
    words :: CArgv { .owned = [], .vec = [] }
    for a in argv {
        p :: sys_strdup(a)
        words.owned.push(p)
        words.vec.push(u64(p))
    }
    words.vec.push(0)
    return words
}

/// Free the C strings `c_argv` copied.
///
/// @param words  what `c_argv` returned.
free_c_argv :: fn(words: CArgv) -> void {
    for p in words.owned {
        sys_free(p)
    }
}

/// Close both ends of a pipe pair.
///
/// @param fds  the two descriptors `sys_pipe` filled.
close_pair :: fn(fds: i32[]) -> void {
    sys_close(fds[0])
    sys_close(fds[1])
    return
}

/// Drain whatever is waiting on `fd` into `into`, without ever blocking.
///
/// Asks `poll` first and reads only when it says there is something, which is
/// what lets one thread serve both pipes: a blocking read on an idle one would
/// stall while the other filled and the child wedged.
///
/// @param child  the child handle.
/// @param which  1 for stdout, 2 for stderr — the same indices `win_handle` uses.
/// @param into   the accumulating buffer.
/// @return       true once the writer is gone and the pipe is drained.
@target
drain_pipe :: fn(child: i64, which: i64, into: u8[]) -> bool

@target(.Linux, .Darwin)
drain_pipe :: fn(child: i64, which: i64, into: u8[]) -> bool {
    c :: children()[child]
    fd :: if which == 1 { i32(c.out_h) } else { i32(c.err_h) }
    chunk: u8[]: [0] * DRAIN_CHUNK
    pfd :: Pollfd { .fd = fd, .events = POLLIN, .revents = 0 }
    for {
        if sys_poll_one(pfd, 1, 0) <= 0 {
            return false
        }
        n :: sys_read(fd, chunk, DRAIN_CHUNK)
        if n == 0 {
            // `poll` said ready and the read returned nothing: the writer closed.
            return true
        }
        if n < 0 {
            // An ERROR, not an end. `errno` is out of reach here, and the common
            // case is `EINTR` — a signal landing mid-read. Reporting EOF would
            // discard the rest of the child's output; report "no progress" and
            // let the next poll try again.
            return false
        }
        for i in 0..<n {
            into.push(chunk[i])
        }
    }
}

@target(.Linux, .Darwin)
spawn_poll :: fn(handle: i64) -> i32 {
    if !child_valid(handle) {
        return SIGNALED
    }
    c :: children()[handle]
    if c.done {
        return c.exit_code
    }
    out_eof :: if c.out_eof { true } else { drain_pipe(handle, 1, c.out) }
    err_eof :: if c.err_eof { true } else { drain_pipe(handle, 2, c.err) }
    st: i32[]: [0]
    rc :: sys_waitpid(i32(c.proc), st, WNOHANG)
    if rc == 0 {
        c.out_eof = out_eof
        c.err_eof = err_eof
        return RUNNING
    }
    if rc < 0 {
        // The child is unreachable — `waitpid` answers -1/ECHILD when `SIGCHLD`
        // is `SIG_IGN`, and that disposition is INHERITED across `execve`, so a
        // build launched from a harness that ignores it sees every child
        // auto-reaped. Close here or the descriptors leak for good: the slot is
        // released by `spawn_take_stderr` and nothing holds them after that.
        sys_close(i32(c.out_h))
        sys_close(i32(c.err_h))
        finish(c, SIGNALED)
        return SIGNALED
    }
    // Reaped. Drain once more: the child can write and exit between the drain
    // above and the wait, and those bytes are still sitting in the pipe.
    if !out_eof {
        drain_pipe(handle, 1, c.out)
    }
    if !err_eof {
        drain_pipe(handle, 2, c.err)
    }
    sys_close(i32(c.out_h))
    sys_close(i32(c.err_h))
    code :: reaped_code(st[0])
    finish(c, code)
    return code
}

/// The signal that ended a child, from its `waitpid` status; 0 when it exited.
/// The layout is the same on Darwin and Linux: the low seven bits are the signal,
/// and the exit code is the next byte up.
///
/// @param status  what `waitpid` stored.
terminating_signal :: fn(status: i32) -> i32 = status & 0x7F

/// The exit code of a child that exited, from its `waitpid` status.
///
/// @param status  what `waitpid` stored.
exit_code_of :: fn(status: i32) -> i32 = (status >> 8) & 0xFF

/// What `spawn_poll` answers for a reaped child: its exit code, or `SIGNALED`.
///
/// @param status  what `waitpid` stored.
reaped_code :: fn(status: i32) -> i32 {
    if terminating_signal(status) != 0 {
        return SIGNALED
    }
    return exit_code_of(status)
}

/// Whether a Windows exit code is an NTSTATUS crash code, which sets the top two
/// bits: `STATUS_ACCESS_VIOLATION` is 0xC0000005.
///
/// @param code  what `GetExitCodeProcess` stored.
is_crash_code :: fn(code: u32) -> bool = (code & 0xC000_0000) == 0xC000_0000

/// Mark `c` reaped: `code` recorded and both pipes drained.
///
/// @param c     the slot.
/// @param code  the exit code, or `SIGNALED`.
finish :: fn(c: Child, code: i32) -> void {
    c.done = true
    c.exit_code = code
    c.out_eof = true
    c.err_eof = true
}

@target(.Linux, .Darwin)
spawn_kill :: fn(handle: i64) -> void {
    if !child_valid(handle) {
        return
    }
    c :: children()[handle]
    if !c.done {
        sys_kill(i32(c.proc), SIGKILL)
        st: i32[]: [0]
        sys_waitpid(i32(c.proc), st, 0)
        sys_close(i32(c.out_h))
        sys_close(i32(c.err_h))
    }
    children()[handle] = Child {}
    return
}

@target(.Windows)
spawn_start :: fn(argv: string[]) -> i64 {
    if argv.len() == 0 {
        return -1
    }
    // Inheritable ends, so the child receives the write halves.
    sa :: SecurityAttributes { .nLength = 24, .lpSecurityDescriptor = 0, .bInheritHandle = 1 }
    out_r: u64[]: [0]
    out_w: u64[]: [0]
    err_r: u64[]: [0]
    err_w: u64[]: [0]
    if !create_pipe(out_r, out_w, sa, 0) {
        return -1
    }
    if !create_pipe(err_r, err_w, sa, 0) {
        close_handle(ptr_at(out_r, 0))
        close_handle(ptr_at(out_w, 0))
        return -1
    }
    out_read  :: ptr_at(out_r, 0)
    out_write :: ptr_at(out_w, 0)
    err_read  :: ptr_at(err_r, 0)
    err_write :: ptr_at(err_w, 0)
    // The read ends are the parent's. `CreatePipe` made both ends inheritable so
    // the child gets the write end, and `CreateProcess` inherits everything
    // marked — so without this the child, and every sibling launched after it,
    // also receives handles it has no business holding.
    set_handle_information(out_read, HANDLE_FLAG_INHERIT, 0)
    set_handle_information(err_read, HANDLE_FLAG_INHERIT, 0)

    si :: startup_with(get_std_handle(STD_INPUT_HANDLE), out_write, err_write)
    pi :: ProcessInformation { .hProcess = out_write, .hThread = out_write,
                               .dwProcessId = 0, .dwThreadId = 0 }
    // `CreateProcessA` MODIFIES the command line in place, so it is lent as a
    // mutable NUL-terminated byte buffer rather than passed as a `string`.
    line :: command_line_bytes(argv)
    ok :: create_process(null, line, null, null, true, 0, null, null, si, pi)
    // The parent drops the write ends whatever happened: while it holds one, the
    // read end never reports EOF and the drain never finishes.
    close_handle(out_write)
    close_handle(err_write)
    if !ok {
        close_handle(out_read)
        close_handle(err_read)
        return -1
    }
    close_handle(pi.hThread)
    h :: child_alloc()
    base :: h * 3
    handles :: win_handles()
    for handles.len() < base + 3 {
        handles.push(0)
    }
    handles[base]     = u64(pi.hProcess)
    handles[base + 1] = u64(out_read)
    handles[base + 2] = u64(err_read)
    return h
}

/// The `STARTUPINFOA` that hands a child these three standard handles.
///
/// @param input   its standard input.
/// @param output  its standard output.
/// @param error   its standard error.
startup_with :: fn(input: Handle, output: Handle, error: Handle) -> StartupInfo = StartupInfo {
    .cb = 104,
    .lpReserved = 0,
    .lpDesktop = 0,
    .lpTitle = 0,
    .dwX = 0,
    .dwY = 0,
    .dwXSize = 0,
    .dwYSize = 0,
    .dwXCountChars = 0,
    .dwYCountChars = 0,
    .dwFillAttribute = 0,
    .dwFlags = STARTF_USESTDHANDLES,
    .wShowWindow = 0,
    .cbReserved2 = 0,
    .lpReserved2 = 0,
    .hStdInput = input,
    .hStdOutput = output,
    .hStdError = error,
}

/// Join `argv` into one command line, quoting what needs it, as a mutable
/// NUL-terminated byte buffer.
///
/// `CreateProcessA` takes ONE string and writes into it, which is why this hands
/// back bytes rather than a `string`: an atom is shared and interned, and the
/// callee would be scribbling on it.
///
/// @param argv  the words.
/// @return      the command line, NUL-terminated.
command_line_bytes :: fn(argv: string[]) -> u8[] {
    out: u8[]: []
    for i in 0..<argv.len() {
        if i > 0 {
            out.push(' ')
        }
        push_quoted(argv[i].bytes(), out)
    }
    out.push(0)
    return out
}

/// Append one argument, quoted and escaped the way `CommandLineToArgvW` reads
/// it back.
///
/// The rules are not "wrap in quotes when it has a space". A backslash is
/// ordinary EXCEPT immediately before a quote, where it escapes — so a run of
/// backslashes that meets a quote (the one we add, or one in the argument) has
/// to be doubled, and a quote inside the argument has to be escaped on top of
/// that. Get it wrong and the child sees a different argv: `a"b` plus `c`
/// arrived as the single word `ab c`, and a path ending in a separator escaped
/// the closing quote and swallowed the next argument.
///
/// @param word  the argument's bytes.
/// @param out   the command line being built.
push_quoted :: fn(word: u8[], out: u8[]) -> void {
    if word.len() > 0 && !needs_quoting(word) {
        for b in word {
            out.push(b)
        }
        return
    }
    out.push('"')
    slashes := 0
    for b in word {
        if b == '\\' {
            slashes += 1
            continue
        }
        if b == '"' {
            // The run escapes the quote, so it must survive as itself: double
            // it, then escape the quote with one more.
            for _s in 0..<(slashes * 2 + 1) {
                out.push('\\')
            }
            slashes = 0
            out.push('"')
            continue
        }
        for _s in 0..<slashes {
            out.push('\\')
        }
        slashes = 0
        out.push(b)
    }
    // A run at the END meets the closing quote we are about to add.
    for _s in 0..<(slashes * 2) {
        out.push('\\')
    }
    out.push('"')
    return
}

/// Whether the argument has to be quoted at all.
///
/// The separator set is Win32's, not just space and tab: `CommandLineToArgvW`
/// also breaks on a newline or a vertical tab, and a quote has to be escaped
/// whether or not anything else forces the quoting.
///
/// @param word  the argument's bytes.
needs_quoting :: fn(word: u8[]) -> bool {
    for b in word {
        if b == ' ' || b == '\t' || b == '\n' || b == 11 || b == '"' {
            return true
        }
    }
    return false
}

@target(.Windows)
drain_pipe :: fn(child: i64, which: i64, into: u8[]) -> bool {
    h :: win_handle(child, which)
    chunk: u8[]: [0] * DRAIN_CHUNK
    avail: u32[]: [0]
    got: u32[]: [0]
    for {
        if !peek_named_pipe(h, null, 0, null, avail, null) {
            // The peek fails once the write end is gone — that is the EOF.
            return true
        }
        if avail[0] == 0 {
            return false
        }
        want :: if i64(avail[0]) > DRAIN_CHUNK { u32(DRAIN_CHUNK) } else { avail[0] }
        if !read_file(h, chunk, want, got, null) {
            return true
        }
        if got[0] == 0 {
            return true
        }
        for i in 0..<i64(got[0]) {
            into.push(chunk[i])
        }
    }
}

@target(.Windows)
spawn_poll :: fn(handle: i64) -> i32 {
    if !child_valid(handle) {
        return SIGNALED
    }
    c :: children()[handle]
    if c.done {
        return c.exit_code
    }
    out_eof :: if c.out_eof { true } else { drain_pipe(handle, 1, c.out) }
    err_eof :: if c.err_eof { true } else { drain_pipe(handle, 2, c.err) }
    proc :: win_handle(handle, 0)
    if wait_for_single_object(proc, 0) != WAIT_OBJECT_0 {
        c.out_eof = out_eof
        c.err_eof = err_eof
        return RUNNING
    }
    // Exited. Drain once more: the child can write and exit between the drain
    // above and the wait, and those bytes are still sitting in the pipe.
    if !out_eof {
        drain_pipe(handle, 1, c.out)
    }
    if !err_eof {
        drain_pipe(handle, 2, c.err)
    }
    code: u32[]: [0]
    got :: get_exit_code_process(proc, code)
    close_handle(win_handle(handle, 1))
    close_handle(win_handle(handle, 2))
    close_handle(proc)
    // A crash is `SIGNALED`, never its code: `SpawnAsync.resume` branches on
    // `SIGNALED` alone, and would read a large positive code as a clean run.
    exit_code :: if !got {
        SIGNALED
    } else if is_crash_code(code[0]) {
        SIGNALED
    } else {
        i32(code[0])
    }
    finish(c, exit_code)
    return exit_code
}

@target(.Windows)
spawn_kill :: fn(handle: i64) -> void {
    if !child_valid(handle) {
        return
    }
    c :: children()[handle]
    if !c.done {
        proc :: win_handle(handle, 0)
        terminate_process(proc, 1)
        wait_for_single_object(proc, 2000)
        close_handle(win_handle(handle, 1))
        close_handle(win_handle(handle, 2))
        close_handle(proc)
    }
    children()[handle] = Child {}
    return
}

/// Intern the child's captured stdout (call after `spawn_poll` reports done).
export spawn_take_stdout :: fn(handle: i64) -> string {
    if !child_valid(handle) {
        return ""
    }
    return children()[handle].out.bytes_to_string()
}

/// Intern the child's captured stderr AND release the child slot — the last
/// call for a handle. Take order is stdout then stderr.
export spawn_take_stderr :: fn(handle: i64) -> string {
    if !child_valid(handle) {
        return ""
    }
    c :: children()[handle]
    out :: c.err.bytes_to_string()
    // The LAST call for a handle — releasing here is what frees the slot and
    // the captured buffers, and take order is stdout then stderr.
    children()[handle] = Child {}
    return out
}

// ---- async primitive -------------------------------------------------------

/// The awaitable backing `spawn_async`. On first `resume` it launches the child
/// and arms a poll timer ; each later `resume` polls and, while the child is
/// alive, re-arms the timer and parks (`Suspended`). Completes with a
/// `ProcessResult` (or `ProcessError` on launch failure / signal).
SpawnAsync :: struct {
    argv:     string[]
    started:  bool = false
    handle:   i64  = -1
    deadline: i64  = 0
}

SpawnAsync implements Async<ProcessResult | ProcessError> {
    /// Kill the child and free its slot. Overriding this matters: `Async`'s
    /// default `cancel` is a v1 no-op, so a `timeout` over a spawn would
    /// otherwise unblock the CALLER while the child kept running — spinning a
    /// core and holding its table slot for the life of the process. A cancelled
    /// spawn has to actually stop.
    cancel :: fn(self) -> void {
        if self.handle >= 0 {
            spawn_kill(self.handle)
        }
    }

    resume :: fn(self) -> ProcessResult | ProcessError | Suspended {
        if !self.started {
            self.started = true
            if self.argv.len() == 0 {
                return ProcessError { .msg = "spawn: empty argv" }
            }
            self.handle = spawn_start(self.argv)
            if self.handle < 0 {
                return ProcessError { .msg = "spawn: failed to launch \"${self.argv[0]}\"" }
            }
            self.deadline = sched_now() + POLL_MS
            sched_arm(self.deadline)
            return Suspended { .wake_at = self.deadline }
        }
        // Poll at most once per POLL_MS. A driver may resume us before our
        // timer fires (`timeout` drives its child on every wake), and would
        // otherwise poll the child process and arm a fresh timer each time.
        // Mirrors `Sleep`: stay parked until our timer fires.
        if sched_now() < self.deadline {
            return Suspended { .wake_at = self.deadline }
        }
        finished :: spawn_finished(self.handle, self.argv[0])
        if finished == null {
            self.deadline = sched_now() + POLL_MS
            sched_arm(self.deadline)
            return Suspended { .wake_at = self.deadline }
        }
        return finished
    }
}

/// What a child `spawn_start` launched came to, WITHOUT waiting: null while it
/// runs, then its `ProcessResult`, or a `ProcessError` when a signal stopped
/// it. For a caller with an event loop of its own, polling between two events;
/// once it answers, the handle is spent.
///
/// @param handle   the handle `spawn_start` returned.
/// @param program  the program it runs, which names it in a `ProcessError`.
/// @return         null while the child runs, its result once it exited.
/// @error          `ProcessError` when a signal terminated it.
export spawn_finished :: fn(handle: i64, program: string) -> ProcessResult | ProcessError | null {
    code :: spawn_poll(handle)
    if code == RUNNING {
        return null
    }
    // Both pipes, stdout first, then stderr, which frees the slot, before
    // deciding success vs signal.
    out :: spawn_take_stdout(handle)
    err :: spawn_take_stderr(handle)
    if code == SIGNALED {
        return ProcessError { .msg = "spawn: \"${program}\" terminated by signal" }
    }
    return ProcessResult { .exit = code, .stdout = out, .stderr = err }
}

/// Run `argv[0]` with `argv[1..]` as an awaitable — launches immediately, then
/// completes once the child exits, WITHOUT blocking the scheduler. Fan several
/// out and `await join_all([...])` to run them concurrently (the OS parallelises the
/// child processes). The WASM targets have no subprocess support (unbound).
///
/// @param argv   the command line ; `argv[0]` is the program. Empty is an error.
/// @return       an awaitable completing with the `ProcessResult`.
/// @error        `ProcessError` on launch failure, a killing signal, or empty
///               `argv`.
export spawn_async :: fn(argv: string[]) -> Async<ProcessResult | ProcessError> =
    SpawnAsync { .argv = argv }

/// Run `argv[0]` with `argv[1..]`, BLOCK until exit, and return the exit code
/// plus captured stdout/stderr. A `block_on` over `spawn_async` — prefer
/// `spawn_async` when you need concurrency.
///
/// @param argv   the command line ; `argv[0]` is the program. Empty is an error.
/// @return       a `ProcessResult` with the exit code + drained pipes.
/// @error        `ProcessError` on launch failure, a killing signal, or empty
///               `argv`.
export spawn :: fn(argv: string[]) -> ProcessResult | ProcessError = block_on(spawn_async(argv))

// ---- attached run ----------------------------------------------------------

/// Run `argv[0]` with `argv[1..]` on this process's standard streams, and wait
/// for it to exit: the child reads what this process would read and writes
/// where it writes, a terminal or a pipe, with nothing captured.
///
/// For a program run on the user's behalf, whose output belongs on the screen
/// as it is written. Blocking: the scheduler does not run meanwhile.
///
/// @param argv  the command line; `argv[0]` is the program, looked up on `PATH`
///              when it names no folder.
/// @return      the child's exit code.
/// @error       `ProcessError` when `argv` is empty, the program cannot be
///              launched, or a signal (an exception, on Windows) ended it.
@target
export run_attached :: fn(argv: string[]) -> i32 | ProcessError

@target(.Linux, .Darwin)
run_attached :: fn(argv: string[]) -> i32 | ProcessError {
    if argv.len() == 0 {
        return ProcessError { .msg = "nothing to run: empty argv" }
    }
    // No file action: the child keeps descriptors 0, 1 and 2 as they are here.
    actions: u8[]: [0] * SPAWN_ACTIONS_BYTES
    if sys_spawn_actions_init(actions) != 0 {
        return cannot_launch(argv[0])
    }
    words :: c_argv(argv)
    pid: i32[]: [0]
    rc :: sys_posix_spawnp(pid, argv[0], actions, null, words.vec, sys_environ())
    sys_spawn_actions_destroy(actions)
    free_c_argv(words)
    if rc != 0 {
        return cannot_launch(argv[0])
    }
    st: i32[]: [0]
    if sys_waitpid(pid[0], st, 0) < 0 {
        return ProcessError { .msg = "`${argv[0]}` could not be waited for" }
    }
    signal :: terminating_signal(st[0])
    if signal != 0 {
        return ProcessError { .msg = "`${argv[0]}` was ended by signal ${signal}" }
    }
    return exit_code_of(st[0])
}

@target(.Windows)
run_attached :: fn(argv: string[]) -> i32 | ProcessError {
    if argv.len() == 0 {
        return ProcessError { .msg = "nothing to run: empty argv" }
    }
    si :: startup_with(
        get_std_handle(STD_INPUT_HANDLE),
        get_std_handle(STD_OUTPUT_HANDLE),
        get_std_handle(STD_ERROR_HANDLE),
    )
    // Filled by `CreateProcessA`.
    unset :: ptr_at([0], 0)
    pi :: ProcessInformation {
        .hProcess = unset,
        .hThread = unset,
        .dwProcessId = 0,
        .dwThreadId = 0,
    }
    if !create_process(null, command_line_bytes(argv), null, null, true, 0, null, null, si, pi) {
        return cannot_launch(argv[0])
    }
    close_handle(pi.hThread)
    wait_for_single_object(pi.hProcess, INFINITE)
    code: u32[]: [0]
    got :: get_exit_code_process(pi.hProcess, code)
    close_handle(pi.hProcess)
    if !got {
        return ProcessError { .msg = "`${argv[0]}` could not be waited for" }
    }
    if is_crash_code(code[0]) {
        return ProcessError { .msg = "`${argv[0]}` crashed with status 0x${u64(code[0]).to_hex()}" }
    }
    return i32(code[0])
}

/// The error for a program that did not start.
///
/// @param program  `argv[0]`.
cannot_launch :: fn(program: string) -> ProcessError =
    ProcessError { .msg = "cannot launch `${program}`" }

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_processor_count_platform_call_succeeds :: fn() -> void {
    assert(platform_processor_count() >= 1, "the platform reports its processors (a wrong selector reads -1)")
}
