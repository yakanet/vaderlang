// std/process: external-process invocation.
//
// A child is a value, `ChildProcess`: `spawn_start` launches it with its stdout
// and stderr captured, `poll` follows it without waiting, `kill` stops it. No
// state outlives the value, so each task of `std/task` owns the children it
// starts. `spawn` is the waiting form: between two polls of its child it parks
// the calling task until the child writes or ends, so tasks that spawn run
// their children at once and the OS schedules them across cores.
//
// `spawn_interactive` launches a child that also reads a pipe: `write_input`
// feeds it, `close_input` ends it, and `read_output` takes its answers as they
// come, for a long-lived child that serves one request after another.
//
// `run_attached` is the other shape: the child shares this process's standard
// streams instead of having them captured, and the call blocks until it exits.
//
// Native-only: the child primitives sit on `posix_spawn` + pipes (POSIX)
// and `CreateProcessA` + pipes (Windows). WASM has no spawn equivalent.

module "std/process"

import "std/env"
import "std/io"
import "std/numbers"
import "std/runtime/scheduler"
import "system/libc"
import "system/posix"
import "system/windows"

// `poll_exit` returns RUNNING while the child is alive, SIGNALED on abnormal
// termination, else the exit code (>= 0).
RUNNING  :: -1
SIGNALED :: -2

/// Error from `spawn`, `spawn_start` or `poll` when the child can't be launched or
/// terminates abnormally (a non-zero exit is NOT an error: it rides in
/// `ProcessResult.exit`).
export ProcessError :: struct {
    msg: string
    /// What the child wrote to stdout before a signal ended it ; empty when it
    /// never ran.
    stdout: string = ""
    /// What the child wrote to stderr before a signal ended it (a panic's
    /// message, say) ; empty when it never ran.
    stderr: string = ""
}

ProcessError implements Error {
    message :: fn(self) -> string = self.msg
}

/// Outcome of a child that ran to completion. `exit` is the OS exit status ;
/// `stdout` / `stderr` hold the full captured pipe contents.
export ProcessResult :: struct {
    exit:   i32
    stdout: string
    stderr: string
}

// ---- the child -------------------------------------------------------------
//
// Draining is POLL-BEFORE-READ on both systems: ask whether bytes are waiting,
// read only then. The alternative on POSIX is a non-blocking descriptor and on
// Windows a thread per pipe, and the reason for either is the same deadlock:
// a child that fills one pipe while the parent blocks on the other. One
// question asked before each read removes it without a descriptor flag or a
// thread.

/// A process this one started: a pid on POSIX, a process handle on Windows.
/// Nothing computes with it: it converts to nothing, and compares with `==`.
export Process :: Pid | ProcessHandle

/// A child process `spawn_start` launched, with its stdout and stderr captured:
/// `poll` follows it to its end, `kill` stops it.
///
/// A child dropped before its end keeps running, and its pipes stay open: poll
/// it until it answers, or kill it.
export ChildProcess :: struct {
    /// `argv[0]`, which names the child in a `ProcessError`.
    @internal
    program:   string
    /// Whether the child was reaped: `exit_code` holds its end.
    @internal
    done:      bool  = false
    /// The exit code, or `SIGNALED`.
    @internal
    exit_code: i32   = 0
    /// What the child wrote on stdout so far.
    @internal
    out:       u8[]  = []
    /// What the child wrote on stderr so far.
    @internal
    err:       u8[]  = []
    @internal
    process:   Process
    /// The read end of the stdout pipe.
    @internal
    out_pipe:  Descriptor
    /// The read end of the stderr pipe.
    @internal
    err_pipe:  Descriptor
    /// The write end of the stdin pipe of a child `spawn_interactive` launched,
    /// until `close_input` or the child's end.
    @internal
    in_pipe:   Descriptor | null = null
    @internal
    out_eof:   bool  = false
    @internal
    err_eof:   bool  = false
}

// On POSIX, every `Descriptor` is an `Fd` and every `Process` a `Pid`; on
// Windows, a child's pipe is a `PipeHandle` and the child a `ProcessHandle`.
// The other member is a bug of this module, and stops the program.

fd_of :: fn(d: Descriptor) -> i32 = @unreachable match d {
    is Fd -> i32(d)
}

pid_of :: fn(p: Process) -> i32 = @unreachable match p {
    is Pid -> i32(p)
}

pipe_handle_of :: fn(d: Descriptor) -> Handle = @unreachable match d {
    is PipeHandle -> Handle(d)
}

process_handle_of :: fn(p: Process) -> Handle = @unreachable match p {
    is ProcessHandle -> Handle(p)
}

// The machine words the scheduler names a pipe and a child by: the descriptor
// or the pid, else the address of the handle.

descriptor_word :: fn(d: Descriptor) -> i64 = match d {
    is Fd         -> i64(d)
    is PipeHandle -> i64(d)
}

process_word :: fn(p: Process) -> i64 = match p {
    is Pid           -> i64(p)
    is ProcessHandle -> i64(p)
}

/// How much to ask for per drain. One page: large enough that a chatty child
/// does not need many rounds, small enough that an idle one costs a syscall
/// and an empty answer.
DRAIN_CHUNK: i64: 4096

/// Number of logical processors online: what a caller sizes a parallel fan-out
/// on. At least 1: a platform that cannot tell answers 1.
export processor_count :: fn() -> i32 {
    n :: platform_processor_count()
    return if n < 1 { 1 } else { i32(n) }
}

// The platform call's own answer, failure included (-1 from `sysconf`, 0 from
// Win32), so a test can tell a wrong selector from a one-processor machine.
@target
platform_processor_count :: fn() -> i64 = 1

@target(.Linux, .Darwin)
platform_processor_count :: fn() -> i64 = sys_sysconf(SC_NPROCESSORS_ONLN)

@target(.Windows)
platform_processor_count :: fn() -> i64 = i64(get_active_processor_count(ALL_PROCESSOR_GROUPS))

/// Launch `argv` without waiting, its stdout and stderr captured.
///
/// @param argv  the command line; `argv[0]` is the program, looked up on `PATH`
///              when it names no folder.
/// @return      the child, which `poll` follows and `kill` stops.
/// @error       `ProcessError` when `argv` is empty or the program cannot be
///              launched.
export spawn_start :: fn(argv: string[]) -> ChildProcess | ProcessError = launch_child(argv, false)

/// Launch `argv` without waiting, as `spawn_start` does, with a pipe on its
/// stdin too: `write_input` feeds it, `close_input` ends it, `read_output` takes
/// what the child writes as it comes.
///
/// POSIX only for now: on Windows the launch fails.
///
/// @param argv  the command line; `argv[0]` is the program, looked up on `PATH`
///              when it names no folder.
/// @return      the child, which `poll` follows and `kill` stops.
/// @error       `ProcessError` when `argv` is empty or the program cannot be
///              launched.
export spawn_interactive :: fn(argv: string[]) -> ChildProcess | ProcessError =
    launch_child(argv, true)

launch_child :: fn(argv: string[], piped_input: bool) -> ChildProcess | ProcessError {
    if argv.len() == 0 {
        return ProcessError { .msg = "spawn: empty argv" }
    }
    child :: start_child(argv, piped_input) ?? return ProcessError {
        .msg = "spawn: failed to launch \"${argv[0]}\"",
    }
    return child
}

/// Launch `argv`, not empty, with pipes on its stdout and stderr, and on its
/// stdin when `piped_input` is set; otherwise it shares this process's stdin.
///
/// @param argv         the command line.
/// @param piped_input  whether the child reads a pipe this process writes.
/// @return             the child, or null when it could not be launched.
@target
start_child :: fn(argv: string[], piped_input: bool) -> ChildProcess | null

/// Advance a launched child WITHOUT blocking: drain its pipes and reap it if it
/// exited.
///
/// @param child  what `spawn_start` returned.
/// @return       `RUNNING` while alive, `SIGNALED` on abnormal termination,
///               else the exit code (>= 0).
@target
poll_exit :: fn(child: ChildProcess) -> i32

/// Terminate `child` and reap it.
///
/// For a caller that has given up: a timeout fired, and without this the child
/// keeps running after its parent stopped caring, holding a core. SIGKILL
/// rather than a polite signal: this is the path for code that is not
/// responding. Killing a child that has ended does nothing, so a caller need
/// not know which it holds; a killed child polls as ended by a signal.
///
/// @param child  what `spawn_start` returned.
@target
export kill :: fn(child: ChildProcess) -> void

@target(.Linux, .Darwin)
start_child :: fn(argv: string[], piped_input: bool) -> ChildProcess | null {
    out_fds: i32[]: [0, 0]
    err_fds: i32[]: [0, 0]
    in_fds: i32[]: [0, 0]
    if sys_pipe(out_fds) != 0 {
        return null
    }
    if sys_pipe(err_fds) != 0 {
        close_pair(out_fds)
        return null
    }
    if piped_input && sys_pipe(in_fds) != 0 {
        close_pair(out_fds)
        close_pair(err_fds)
        return null
    }
    actions: u8[]: [0] * SPAWN_ACTIONS_BYTES
    if sys_spawn_actions_init(actions) != 0 {
        close_pair(out_fds)
        close_pair(err_fds)
        if piped_input {
            close_pair(in_fds)
        }
        return null
    }
    // The child keeps only its own ends, dup'd onto its 0, 1 and 2.
    sys_spawn_actions_addclose(actions, out_fds[0])
    sys_spawn_actions_addclose(actions, err_fds[0])
    sys_spawn_actions_adddup2(actions, out_fds[1], 1)
    sys_spawn_actions_adddup2(actions, err_fds[1], 2)
    sys_spawn_actions_addclose(actions, out_fds[1])
    sys_spawn_actions_addclose(actions, err_fds[1])
    if piped_input {
        // The write end stays here for the child's whole life: every child
        // spawned meanwhile would inherit it, and the reader would never see
        // its input end. Closed on exec, it reaches none.
        sys_fcntl(in_fds[1], F_SETFD, FD_CLOEXEC)
        sys_spawn_actions_adddup2(actions, in_fds[0], 0)
        sys_spawn_actions_addclose(actions, in_fds[0])
    }

    words :: c_argv(argv)
    pid: i32[]: [0]
    rc :: sys_posix_spawnp(pid, argv[0], actions, null, words.vec, sys_environ())
    sys_spawn_actions_destroy(actions)
    free_c_argv(words)
    // The parent holds the read ends only; the child owns the write ends now,
    // and leaving them open here would keep EOF from ever arriving.
    sys_close(out_fds[1])
    sys_close(err_fds[1])
    if piped_input {
        sys_close(in_fds[0])
    }
    if rc != 0 {
        sys_close(out_fds[0])
        sys_close(err_fds[0])
        if piped_input {
            sys_close(in_fds[1])
        }
        return null
    }
    child :: ChildProcess {
        .program  = argv[0],
        .process  = Pid(pid[0]),
        .out_pipe = Fd(out_fds[0]),
        .err_pipe = Fd(err_fds[0]),
    }
    if piped_input {
        child.in_pipe = Fd(in_fds[1])
    }
    return child
}

/// `argv` as the NULL-terminated `char*` vector a spawn takes, in two views of
/// one vector: `owned` holds the pointers so they can be freed, `vec` is the
/// `u64[]` that lends as the `char**`.
CArgv :: struct {
    owned: CPointer[]
    vec:   u64[]
}

/// Copy `argv` into C strings, freed by `free_c_argv` once the spawn returns.
///
/// @param argv  the words.
c_argv :: fn(argv: string[]) -> CArgv {
    words :: CArgv { .owned = [], .vec = [] }
    for a in argv {
        p :: sys_strdup(a)
        words.owned.push(p)
        words.vec.push(u64(p))
    }
    words.vec.push(0)
    return words
}

/// Free the C strings `c_argv` copied.
///
/// @param words  what `c_argv` returned.
free_c_argv :: fn(words: CArgv) -> void {
    for p in words.owned {
        sys_free(p)
    }
}

/// Close both ends of a pipe pair.
///
/// @param fds  the two descriptors `sys_pipe` filled.
close_pair :: fn(fds: i32[]) -> void {
    sys_close(fds[0])
    sys_close(fds[1])
    return
}

/// Drain whatever is waiting on `pipe` into `into`, without ever blocking.
///
/// Asks `poll` first and reads only when it says there is something, which is
/// what lets one thread serve both pipes: a blocking read on an idle one would
/// stall while the other filled and the child wedged.
///
/// @param pipe  the read end of one of a child's pipes.
/// @param into  the accumulating buffer.
/// @return      true once the writer is gone and the pipe is drained.
@target
drain_pipe :: fn(pipe: Descriptor, into: u8[]) -> bool

@target(.Linux, .Darwin)
drain_pipe :: fn(pipe: Descriptor, into: u8[]) -> bool {
    fd :: fd_of(pipe)
    chunk: u8[]: [0] * DRAIN_CHUNK
    pfd :: Pollfd { .fd = fd, .events = POLLIN, .revents = 0 }
    for {
        if sys_poll_one(pfd, 1, 0) <= 0 {
            return false
        }
        n :: sys_read(fd, chunk, DRAIN_CHUNK)
        if n == 0 {
            // `poll` said ready and the read returned nothing: the writer closed.
            return true
        }
        if n < 0 {
            // An ERROR, not an end. `errno` is out of reach here, and the common
            // case is `EINTR`: a signal landing mid-read. Reporting EOF would
            // discard the rest of the child's output; report "no progress" and
            // let the next poll try again.
            return false
        }
        for i in 0..<n {
            into.push(chunk[i])
        }
    }
}

@target(.Linux, .Darwin)
poll_exit :: fn(child: ChildProcess) -> i32 {
    if child.done {
        return child.exit_code
    }
    out_eof :: if child.out_eof { true } else { drain_pipe(child.out_pipe, child.out) }
    err_eof :: if child.err_eof { true } else { drain_pipe(child.err_pipe, child.err) }
    st: i32[]: [0]
    rc :: sys_waitpid(pid_of(child.process), st, WNOHANG)
    if rc == 0 {
        child.out_eof = out_eof
        child.err_eof = err_eof
        return RUNNING
    }
    if rc < 0 {
        // The child is unreachable: `waitpid` answers -1/ECHILD when `SIGCHLD`
        // is `SIG_IGN`, and that disposition is INHERITED across `execve`, so a
        // build launched from a harness that ignores it sees every child
        // auto-reaped. Close here or the descriptors leak for good: a child
        // that answered is never drained again.
        close_pipes(child)
        finish(child, SIGNALED)
        return SIGNALED
    }
    // Reaped. Drain once more: the child can write and exit between the drain
    // above and the wait, and those bytes are still sitting in the pipe.
    if !out_eof {
        drain_pipe(child.out_pipe, child.out)
    }
    if !err_eof {
        drain_pipe(child.err_pipe, child.err)
    }
    close_pipes(child)
    code :: reaped_code(st[0])
    finish(child, code)
    return code
}

/// The signal that ended a child, from its `waitpid` status; 0 when it exited.
/// The layout is the same on Darwin and Linux: the low seven bits are the signal,
/// and the exit code is the next byte up.
///
/// @param status  what `waitpid` stored.
terminating_signal :: fn(status: i32) -> i32 = status & 0x7F

/// The exit code of a child that exited, from its `waitpid` status.
///
/// @param status  what `waitpid` stored.
exit_code_of :: fn(status: i32) -> i32 = (status >> 8) & 0xFF

/// What `poll_exit` answers for a reaped child: its exit code, or `SIGNALED`.
///
/// @param status  what `waitpid` stored.
reaped_code :: fn(status: i32) -> i32 {
    if terminating_signal(status) != 0 {
        return SIGNALED
    }
    return exit_code_of(status)
}

/// Whether a Windows exit code is an NTSTATUS crash code, which sets the top two
/// bits: `STATUS_ACCESS_VIOLATION` is 0xC0000005.
///
/// @param code  what `GetExitCodeProcess` stored.
is_crash_code :: fn(code: u32) -> bool = (code & 0xC000_0000) == 0xC000_0000

/// Mark `c` reaped: `code` recorded and both pipes drained.
///
/// @param c     the child.
/// @param code  the exit code, or `SIGNALED`.
finish :: fn(c: ChildProcess, code: i32) -> void {
    c.done = true
    c.exit_code = code
    c.out_eof = true
    c.err_eof = true
}

@target(.Linux, .Darwin)
kill :: fn(child: ChildProcess) -> void {
    if child.done {
        return
    }
    sys_kill(pid_of(child.process), SIGKILL)
    st: i32[]: [0]
    sys_waitpid(pid_of(child.process), st, 0)
    close_pipes(child)
    finish(child, SIGNALED)
}

// Close what this process holds of the pipes of `child`, which has ended.
@target
close_pipes :: fn(child: ChildProcess) -> void

@target(.Linux, .Darwin)
close_pipes :: fn(child: ChildProcess) -> void {
    sys_close(fd_of(child.out_pipe))
    sys_close(fd_of(child.err_pipe))
    close_input(child)
}

@target(.Windows)
start_child :: fn(argv: string[], piped_input: bool) -> ChildProcess | null {
    if piped_input {
        return null
    }
    out_r: u64[]: [0]
    out_w: u64[]: [0]
    err_r: u64[]: [0]
    err_w: u64[]: [0]
    if !create_watched_pipe(out_r, out_w) {
        return null
    }
    if !create_watched_pipe(err_r, err_w) {
        close_handle(ptr_at(out_r, 0))
        close_handle(ptr_at(out_w, 0))
        return null
    }
    out_read  :: ptr_at(out_r, 0)
    out_write :: ptr_at(out_w, 0)
    err_read  :: ptr_at(err_r, 0)
    err_write :: ptr_at(err_w, 0)
    si :: startup_with(get_std_handle(STD_INPUT_HANDLE), out_write, err_write)
    pi :: ProcessInformation { .hProcess = out_write, .hThread = out_write,
                               .dwProcessId = 0, .dwThreadId = 0 }
    // `CreateProcessA` MODIFIES the command line in place, so it is lent as a
    // mutable NUL-terminated byte buffer rather than passed as a `string`.
    line :: command_line_bytes(argv)
    ok :: create_process(null, line, null, null, true, 0, null, null, si, pi)
    // The parent drops the write ends whatever happened: while it holds one, the
    // read end never reports EOF and the drain never finishes.
    close_handle(out_write)
    close_handle(err_write)
    if !ok {
        close_handle(out_read)
        close_handle(err_read)
        return null
    }
    close_handle(pi.hThread)
    return ChildProcess {
        .program  = argv[0],
        .process  = ProcessHandle(pi.hProcess),
        .out_pipe = PipeHandle(out_read),
        .err_pipe = PipeHandle(err_read),
    }
}

/// The `STARTUPINFOA` that hands a child these three standard handles.
///
/// @param input   its standard input.
/// @param output  its standard output.
/// @param error   its standard error.
startup_with :: fn(input: Handle, output: Handle, error: Handle) -> StartupInfo = StartupInfo {
    .cb = 104,
    .lpReserved = 0,
    .lpDesktop = 0,
    .lpTitle = 0,
    .dwX = 0,
    .dwY = 0,
    .dwXSize = 0,
    .dwYSize = 0,
    .dwXCountChars = 0,
    .dwYCountChars = 0,
    .dwFillAttribute = 0,
    .dwFlags = STARTF_USESTDHANDLES,
    .wShowWindow = 0,
    .cbReserved2 = 0,
    .lpReserved2 = 0,
    .hStdInput = input,
    .hStdOutput = output,
    .hStdError = error,
}

/// Join `argv` into one command line, quoting what needs it, as a mutable
/// NUL-terminated byte buffer.
///
/// `CreateProcessA` takes ONE string and writes into it, which is why this hands
/// back bytes rather than a `string`: an atom is shared and interned, and the
/// callee would be scribbling on it.
///
/// @param argv  the words.
/// @return      the command line, NUL-terminated.
command_line_bytes :: fn(argv: string[]) -> u8[] {
    out: u8[]: []
    for i in 0..<argv.len() {
        if i > 0 {
            out.push(' ')
        }
        push_quoted(argv[i].bytes(), out)
    }
    out.push(0)
    return out
}

/// Append one argument, quoted and escaped the way `CommandLineToArgvW` reads
/// it back.
///
/// The rules are not "wrap in quotes when it has a space". A backslash is
/// ordinary EXCEPT immediately before a quote, where it escapes, so a run of
/// backslashes that meets a quote (the one we add, or one in the argument) has
/// to be doubled, and a quote inside the argument has to be escaped on top of
/// that. Get it wrong and the child sees a different argv: `a"b` plus `c`
/// arrived as the single word `ab c`, and a path ending in a separator escaped
/// the closing quote and swallowed the next argument.
///
/// @param word  the argument's bytes.
/// @param out   the command line being built.
push_quoted :: fn(word: u8[], out: u8[]) -> void {
    if word.len() > 0 && !needs_quoting(word) {
        for b in word {
            out.push(b)
        }
        return
    }
    out.push('"')
    slashes := 0
    for b in word {
        if b == '\\' {
            slashes += 1
            continue
        }
        if b == '"' {
            // The run escapes the quote, so it must survive as itself: double
            // it, then escape the quote with one more.
            for _s in 0..<(slashes * 2 + 1) {
                out.push('\\')
            }
            slashes = 0
            out.push('"')
            continue
        }
        for _s in 0..<slashes {
            out.push('\\')
        }
        slashes = 0
        out.push(b)
    }
    // A run at the END meets the closing quote we are about to add.
    for _s in 0..<(slashes * 2) {
        out.push('\\')
    }
    out.push('"')
    return
}

/// Whether the argument has to be quoted at all.
///
/// The separator set is Win32's, not just space and tab: `CommandLineToArgvW`
/// also breaks on a newline or a vertical tab, and a quote has to be escaped
/// whether or not anything else forces the quoting.
///
/// @param word  the argument's bytes.
needs_quoting :: fn(word: u8[]) -> bool {
    for b in word {
        if b == ' ' || b == '\t' || b == '\n' || b == 11 || b == '"' {
            return true
        }
    }
    return false
}

@target(.Windows)
drain_pipe :: fn(pipe: Descriptor, into: u8[]) -> bool {
    h :: pipe_handle_of(pipe)
    chunk: u8[]: [0] * DRAIN_CHUNK
    avail: u32[]: [0]
    got: u32[]: [0]
    for {
        if !peek_named_pipe(h, null, 0, null, avail, null) {
            // The peek fails once the write end is gone: that is the EOF.
            return true
        }
        if avail[0] == 0 {
            return false
        }
        want :: if i64(avail[0]) > DRAIN_CHUNK { u32(DRAIN_CHUNK) } else { avail[0] }
        if !read_file(h, chunk, want, got, null) {
            return true
        }
        if got[0] == 0 {
            return true
        }
        for i in 0..<i64(got[0]) {
            into.push(chunk[i])
        }
    }
}

@target(.Windows)
poll_exit :: fn(child: ChildProcess) -> i32 {
    if child.done {
        return child.exit_code
    }
    out_eof :: if child.out_eof { true } else { drain_pipe(child.out_pipe, child.out) }
    err_eof :: if child.err_eof { true } else { drain_pipe(child.err_pipe, child.err) }
    proc :: process_handle_of(child.process)
    if wait_for_single_object(proc, 0) != WAIT_OBJECT_0 {
        child.out_eof = out_eof
        child.err_eof = err_eof
        return RUNNING
    }
    // Exited. Drain once more: the child can write and exit between the drain
    // above and the wait, and those bytes are still sitting in the pipe.
    if !out_eof {
        drain_pipe(child.out_pipe, child.out)
    }
    if !err_eof {
        drain_pipe(child.err_pipe, child.err)
    }
    code: u32[]: [0]
    got :: get_exit_code_process(proc, code)
    close_pipes(child)
    close_handle(proc)
    // A crash is `SIGNALED`, never its code: `poll` branches on `SIGNALED`
    // alone, and would read a large positive code as a clean run.
    exit_code :: if !got {
        SIGNALED
    } else if is_crash_code(code[0]) {
        SIGNALED
    } else {
        i32(code[0])
    }
    finish(child, exit_code)
    return exit_code
}

@target(.Windows)
close_pipes :: fn(child: ChildProcess) -> void {
    close_handle(pipe_handle_of(child.out_pipe))
    close_handle(pipe_handle_of(child.err_pipe))
}

@target(.Windows)
kill :: fn(child: ChildProcess) -> void {
    if child.done {
        return
    }
    proc :: process_handle_of(child.process)
    terminate_process(proc, 1)
    wait_for_single_object(proc, 2000)
    close_pipes(child)
    close_handle(proc)
    finish(child, SIGNALED)
}

/// What `child` came to, WITHOUT waiting: null while it runs, then its
/// `ProcessResult`. For a caller with an event loop of its own, polling between
/// two events; once the child has ended, every call answers the same.
///
/// @param child  what `spawn_start` returned.
/// @return       null while the child runs, its result once it exited.
/// @error        `ProcessError` when a signal terminated it, `kill` included.
export poll :: fn(child: ChildProcess) -> ProcessResult | ProcessError | null {
    code :: poll_exit(child)
    if code == RUNNING {
        return null
    }
    out :: child.out.bytes_to_string()
    err :: child.err.bytes_to_string()
    if code == SIGNALED {
        return ProcessError {
            .msg = "spawn: \"${child.program}\" terminated by signal",
            .stdout = out,
            .stderr = err,
        }
    }
    return ProcessResult { .exit = code, .stdout = out, .stderr = err }
}

/// Run `argv[0]` with `argv[1..]`, wait until it exits, and return its exit
/// code with what it wrote on stdout and stderr.
///
/// The calling task parks while the child runs, so tasks of `std/task` that
/// spawn run their children at once; a task cancelled meanwhile kills its
/// child.
///
/// @param argv  the command line; `argv[0]` is the program. Empty is an error.
/// @return      a `ProcessResult` with the exit code and the drained pipes.
/// @error       `ProcessError` on launch failure, a killing signal, or empty
///              `argv`.
/// @example
///   # import "std/task"
///   a :: launch(() -> spawn(["cc", "-c", "a.c"]))
///   b :: launch(() -> spawn(["cc", "-c", "b.c"]))
///   join_all([a, b])   // both compiles run at once
export spawn :: fn(argv: string[]) -> ProcessResult | ProcessError {
    child :: spawn_start(argv)
    if child is ProcessError {
        return child
    }
    // A cancelled task runs its defers: the child does not outlive the wait.
    defer child.kill()
    for {
        finished :: child.poll()
        if finished != null {
            return finished
        }
        await_child(child)
    }
}

// Park until `child` may have moved on: it wrote on a pipe not yet at its end,
// or it ended. Anything that wakes the task ends the park too, and the caller
// polls again.
@target
await_child :: fn(child: ChildProcess) -> void

@target(.Linux, .Darwin, .Windows)
await_child :: fn(child: ChildProcess) -> void {
    if !child.out_eof {
        watch_readable(descriptor_word(child.out_pipe))
    }
    if !child.err_eof {
        watch_readable(descriptor_word(child.err_pipe))
    }
    watch_exit(process_word(child.process))
    park()
}

// ---- the interactive child -------------------------------------------------

/// Write `data` on the stdin of a child `spawn_interactive` launched.
///
/// Blocking, and the scheduler does not run meanwhile: a child that reads
/// nothing while this process writes more than a pipe holds stalls it.
///
/// @param child  what `spawn_interactive` returned.
/// @param data   the bytes to write.
/// @error        `ProcessError` when the child has no stdin pipe (another
///               launch, or `close_input`), reads no more input (it closed its
///               stdin, or ended), or the write fails.
@target
export write_input :: fn(child: ChildProcess, data: u8[]) -> null | ProcessError

@target(.Linux, .Darwin)
write_input :: fn(child: ChildProcess, data: u8[]) -> null | ProcessError {
    pipe :: child.in_pipe ?? return ProcessError {
        .msg = "\"${child.program}\" has no stdin to write",
    }
    rest := data
    for rest.len() > 0 {
        n :: sys_write(fd_of(pipe), rest, rest.len())
        if n < 0 {
            // The runtime catches SIGPIPE: a child that closed its stdin, or
            // ended, answers EPIPE.
            failure :: last_io_error("writing to \"${child.program}\" failed")
            if failure.kind == .BrokenPipe {
                return ProcessError { .msg = "\"${child.program}\" reads no more input" }
            }
            return ProcessError { .msg = failure.msg }
        }
        rest = rest[n..<rest.len()]
    }
    return null
}

@target(.Windows)
write_input :: fn(child: ChildProcess, data: u8[]) -> null | ProcessError =
    ProcessError { .msg = "\"${child.program}\" has no stdin to write" }

/// Close the stdin of a child `spawn_interactive` launched: it reads the end of
/// its input. Closing it again, or that of another child, does nothing.
///
/// @param child  what `spawn_interactive` returned.
@target
export close_input :: fn(child: ChildProcess) -> void

@target(.Linux, .Darwin)
close_input :: fn(child: ChildProcess) -> void {
    pipe :: child.in_pipe ?? return
    sys_close(fd_of(pipe))
    child.in_pipe = null
}

// No launch on Windows sets a stdin pipe.
@target(.Windows)
close_input :: fn(child: ChildProcess) -> void {}

/// What a child wrote since the last `read_output`, and whether it has ended.
export ChildOutput :: struct {
    /// Bytes from its stdout.
    out:   u8[]
    /// Bytes from its stderr.
    err:   u8[]
    /// Whether the child has ended: nothing follows these bytes, and `poll`
    /// gives its exit.
    ended: bool
}

/// Take what `child` wrote since the last call, waiting for it to write or end
/// when it has not yet.
///
/// The wait has no deadline: `timeout` of `std/task` gives it one, around the
/// task that reads. A child the deadline gave up on still runs: `kill` it. The
/// bytes are taken: the result of `poll` holds only what no `read_output` took.
///
/// @param child  what `spawn_start` or `spawn_interactive` returned.
/// @return       what the child wrote since the last call, and whether it has
///               ended.
/// @example
///   # import "std/task"
///   # import "std/time"
///   child :: spawn_interactive(["cat"])
///   if child is ChildProcess {
///       child.write_input("hello\n".bytes())
///       child.read_output().out.bytes_to_string()                // "hello\n"
///       launch(() -> child.read_output()).timeout(1.seconds())   // a TimeoutError
///       child.kill()
///   }
export read_output :: fn(child: ChildProcess) -> ChildOutput {
    for !has_news(child) {
        await_child(child)
    }
    taken :: ChildOutput {
        .out   = child.out,
        .err   = child.err,
        .ended = child.done,
    }
    child.out = []
    child.err = []
    return taken
}

// Drain the pipes of `child`, and tell whether it wrote or ended.
has_news :: fn(child: ChildProcess) -> bool =
    poll_exit(child) != RUNNING || child.out.len() > 0 || child.err.len() > 0

// ---- attached run ----------------------------------------------------------

/// Run `argv[0]` with `argv[1..]` on this process's standard streams, and wait
/// for it to exit: the child reads what this process would read and writes
/// where it writes, a terminal or a pipe, with nothing captured.
///
/// For a program run on the user's behalf, whose output belongs on the screen
/// as it is written. Blocking: the scheduler does not run meanwhile.
///
/// @param argv  the command line; `argv[0]` is the program, looked up on `PATH`
///              when it names no folder.
/// @return      the child's exit code.
/// @error       `ProcessError` when `argv` is empty, the program cannot be
///              launched, or a signal (an exception, on Windows) ended it.
@target
export run_attached :: fn(argv: string[]) -> i32 | ProcessError

@target(.Linux, .Darwin)
run_attached :: fn(argv: string[]) -> i32 | ProcessError {
    if argv.len() == 0 {
        return ProcessError { .msg = "nothing to run: empty argv" }
    }
    // No file action: the child keeps descriptors 0, 1 and 2 as they are here.
    actions: u8[]: [0] * SPAWN_ACTIONS_BYTES
    if sys_spawn_actions_init(actions) != 0 {
        return cannot_launch(argv[0])
    }
    words :: c_argv(argv)
    pid: i32[]: [0]
    rc :: sys_posix_spawnp(pid, argv[0], actions, null, words.vec, sys_environ())
    sys_spawn_actions_destroy(actions)
    free_c_argv(words)
    if rc != 0 {
        return cannot_launch(argv[0])
    }
    st: i32[]: [0]
    if sys_waitpid(pid[0], st, 0) < 0 {
        return ProcessError { .msg = "`${argv[0]}` could not be waited for" }
    }
    signal :: terminating_signal(st[0])
    if signal != 0 {
        return ProcessError { .msg = "`${argv[0]}` was ended by signal ${signal}" }
    }
    return exit_code_of(st[0])
}

@target(.Windows)
run_attached :: fn(argv: string[]) -> i32 | ProcessError {
    if argv.len() == 0 {
        return ProcessError { .msg = "nothing to run: empty argv" }
    }
    si :: startup_with(
        get_std_handle(STD_INPUT_HANDLE),
        get_std_handle(STD_OUTPUT_HANDLE),
        get_std_handle(STD_ERROR_HANDLE),
    )
    // Filled by `CreateProcessA`.
    unset :: ptr_at([0], 0)
    pi :: ProcessInformation {
        .hProcess = unset,
        .hThread = unset,
        .dwProcessId = 0,
        .dwThreadId = 0,
    }
    if !create_process(null, command_line_bytes(argv), null, null, true, 0, null, null, si, pi) {
        return cannot_launch(argv[0])
    }
    close_handle(pi.hThread)
    wait_for_single_object(pi.hProcess, INFINITE)
    code: u32[]: [0]
    got :: get_exit_code_process(pi.hProcess, code)
    close_handle(pi.hProcess)
    if !got {
        return ProcessError { .msg = "`${argv[0]}` could not be waited for" }
    }
    if is_crash_code(code[0]) {
        return ProcessError { .msg = "`${argv[0]}` crashed with status 0x${u64(code[0]).to_hex()}" }
    }
    return i32(code[0])
}

/// The error for a program that did not start.
///
/// @param program  `argv[0]`.
cannot_launch :: fn(program: string) -> ProcessError =
    ProcessError { .msg = "cannot launch `${program}`" }

// ---- tests ----------------------------------------------------------------

import "std/task"
import "std/testing"
import "std/time"

@test
test_processor_count_platform_call_succeeds :: fn() -> void {
    assert(platform_processor_count() >= 1, "the platform reports its processors (a wrong selector reads -1)")
}

// The executable running the tests exists on every system, which a shell builtin
// like `echo` does not. It may be a test runner rather than `vader`, so what it
// answers to `--version` does not matter.
@test
test_spawn_runs_a_child_in_each_task :: fn() -> void {
    running :: current_executable_location()
    first :: launch(() -> spawn([running, "--version"]))
    second :: launch(() -> spawn([running, "--version"]))
    for r in join_all([first, second]) {
        assert(r is ProcessResult, "each task runs its own child to its end")
    }
}

@test
test_spawn_start_of_an_empty_argv_is_an_error :: fn() -> void {
    assert(spawn_start([]) is ProcessError, "an empty argv names no program")
}

@test
test_a_killed_child_polls_as_ended_by_a_signal :: fn() -> void {
    child :: spawn_start([current_executable_location(), "--version"])
    assert(child is ChildProcess, "the executable running the tests launches")
    if child is ChildProcess {
        child.kill()
        assert(child.poll() is ProcessError, "a killed child polls as ended by a signal")
    }
}

// `cat` answers each line it reads with the same line. Windows launches no
// interactive child yet.

@test
test_an_interactive_child_answers_one_request_after_another :: fn() -> void {
    if VADER_OS == .Windows {
        return
    }
    child :: spawn_interactive(["cat"])
    assert(child is ChildProcess, "cat launches")
    if child is ChildProcess {
        defer child.kill()
        for request in ["one\n", "two\n"] {
            assert(child.write_input(request.bytes()) == null, "a running child takes its input")
            assert_eq(answer_of(child, request.byte_len()), request)
        }
    }
}

@test
test_closing_the_input_of_an_interactive_child_ends_it :: fn() -> void {
    if VADER_OS == .Windows {
        return
    }
    child :: spawn_interactive(["cat"])
    if child is ChildProcess {
        child.close_input()
        for !child.read_output().ended {}
        assert(child.poll() is ProcessResult, "cat exits once its input ends")
    }
}

@test
test_read_output_of_a_silent_child_waits_until_a_timeout :: fn() -> void {
    if VADER_OS == .Windows {
        return
    }
    child :: spawn_interactive(["cat"])
    if child is ChildProcess {
        defer child.kill()
        waited :: launch(() -> child.read_output()).timeout(1.millis())
        assert(waited is TimeoutError, "nothing came, and `timeout` ended the wait")
    }
}

// The child closes its stdin, says so, then waits: the write finds no reader.
// Without the runtime catching SIGPIPE, the write would end the test process.
@test
test_write_input_of_a_child_that_reads_no_more_is_an_error :: fn() -> void {
    if VADER_OS == .Windows {
        return
    }
    child :: spawn_interactive(["sh", "-c", "exec 0<&-; echo closed; exec sleep 5"])
    if child is ProcessError {
        fail("sh launches")
        return
    }
    defer child.kill()
    assert_eq(answer_of(child, 7), "closed\n")
    assert(child.write_input("x\n".bytes()) is ProcessError, "a child without a reader on its stdin")
}

@test
test_write_input_of_a_child_without_a_stdin_pipe_is_an_error :: fn() -> void {
    child :: spawn_start([current_executable_location(), "--version"])
    if child is ChildProcess {
        defer child.kill()
        assert(child.write_input("x".bytes()) is ProcessError, "spawn_start pipes no stdin")
    }
}

// Read what `child` writes on its stdout until `want` bytes came or it ended.
answer_of :: fn(child: ChildProcess, want: i64) -> string {
    got: u8[]: []
    for got.len() < want {
        chunk :: child.read_output()
        got.push_all(chunk.out)
        if chunk.ended {
            break
        }
    }
    return got.bytes_to_string()
}
