// http/chunked: the chunked transfer coding, read.
//
// A body whose length is not known when its head is written goes as a series
// of chunks, each opened by its size in hexadecimal, and ends with a chunk of
// size zero, some trailer fields and an empty line (RFC 9112, section 7.1):
//
//   5\r\nhello\r\n  6\r\n world\r\n  0\r\n  \r\n
//
// The reader hands out the bytes of the chunks and none of their framing. What
// is malformed there fails the read with `.InvalidInput`: the head was accepted
// long before, and a `Reader` reports an `IOError`.

module "http"

import "std/io"
import "std/math"
import "std/numbers"
import "std/string"

// ---- what `Transfer-Encoding` asks ----------------------------------------

// Whether the `Transfer-Encoding` lines `values` name the chunked coding and
// nothing else, which is all this module decodes. Any other list fails: as
// `.Malformed` when it frames no message (chunked twice, chunked with a
// parameter, a request whose last coding is not chunked), as
// `.CodingNotImplemented` when a coding this module has not is applied.
only_chunked :: fn(values: string[], is_request: bool) -> null | HttpError {
    chunked: i64 = 0
    others: i64 = 0
    last_is_chunked := false
    for value in values {
        for element in value.split(",") {
            coding :: trimmed(element.bytes())
            // An empty element is no coding: a list may hold some.
            if coding.len() == 0 {
                continue
            }
            name_end :: coding.index_of(';') ?? coding.len()
            name :: trimmed(coding[0..<name_end])
            if !is_token(name) {
                return malformed("a transfer coding is not a token")
            }
            last_is_chunked = same_field_name(name.bytes_to_string(), CHUNKED)
            if !last_is_chunked {
                others += 1
                continue
            }
            if name.len() != coding.len() {
                return malformed("the chunked coding takes no parameter")
            }
            chunked += 1
        }
    }
    if chunked > 1 {
        return malformed("the chunked coding applied twice")
    }
    if chunked + others == 0 {
        return malformed("a transfer coding field that names none")
    }
    if !last_is_chunked && is_request {
        return malformed("the last transfer coding of a request is not chunked")
    }
    if others > 0 || !last_is_chunked {
        return HttpError {
            .kind = .CodingNotImplemented,
            .msg = "only the chunked transfer coding is implemented",
        }
    }
    return null
}

// ---- the body -------------------------------------------------------------

// The body of a chunked message: the bytes of its chunks, and no more of
// `source` than the message takes. The trailer fields are read and dropped.
ChunkedBody :: struct {
    source: BufferedReader
    limits: Limits
    // The bytes of the chunk under way not handed out yet.
    left: i64 = 0
    // Whether the data of a chunk was handed out whole, its line break still
    // on `source`.
    data_ended: bool = false
    // The bytes the lines that opened the chunks took beyond the data of
    // their chunk. The digits of a size are never more than the bytes it
    // counts, the one digit of the last chunk aside.
    padding: i64 = 0
    done: bool = false
    // What failed a read. A body that failed is at no end: what is left on
    // `source` is not known to open a chunk, so every later read fails the
    // same.
    failure: IOError | null = null
}

ChunkedBody implements Reader {
    read :: fn(self, into: u8[]) -> i64 | null | IOError {
        failure :: self.failure
        if failure != null {
            return IOError { ...failure }
        }
        if self.done {
            return null
        }
        if into.len() == 0 {
            return 0
        }
        if self.left == 0 {
            size :: self.open_chunk()
            if size is IOError {
                return self.failed(size)
            }
            if size == 0 {
                self.done = true
                return null
            }
            self.left = size
        }
        got :: self.source.read(into[0..<min(into.len(), self.left)])
        if got is IOError {
            return self.failed(got)
        }
        if got == null {
            return self.failed(ended_early("in the middle of a chunk"))
        }
        self.left -= got
        self.data_ended = self.left == 0
        return got
    }
}

// Have every read of `body` from now on fail as `error`, which is returned.
failed :: fn(body: ChunkedBody, error: IOError) -> IOError {
    // A copy is kept: a reader hands back nothing it keeps.
    body.failure = IOError { ...error }
    return error
}

// Read up to the data of the next chunk and give its size; 0 for the last
// chunk, whose trailer fields and final empty line are read with it.
open_chunk :: fn(body: ChunkedBody) -> i64 | IOError {
    if body.data_ended {
        ending :: body.source.read_exact(2)
        if ending is IOError {
            return ending
        }
        if ending[0] != '\r' || ending[1] != '\n' {
            return bad_chunk("the data of a chunk is not followed by a line break")
        }
        body.data_ended = false
    }
    line :: read_head_line(body.source, body.limits.chunk_line, .Malformed)
    if line is HttpError {
        return chunk_io_error(line)
    }
    if line == null {
        return ended_early("before its last chunk")
    }
    size :: chunk_size(line)
    if size is IOError {
        return size
    }
    body.padding += max(0, line.len() - max(size, 1))
    if body.padding > body.limits.chunk_extensions {
        return bad_chunk("the chunks spend more on their extensions than they carry")
    }
    if size > 0 {
        return size
    }
    trailers :: read_fields(body.source, body.limits, false)
    if trailers is HttpError {
        return chunk_io_error(trailers)
    }
    return 0
}

// `chunk-size [ chunk-ext ]`: hexadecimal digits, then extensions, which are
// checked for their form and skipped.
chunk_size :: fn(line: u8[]) -> i64 | IOError {
    digits: i64 = 0
    for digits < line.len() && is_hex_byte(line[digits]) {
        digits += 1
    }
    if digits == 0 {
        return bad_chunk("a chunk opens with its size in hexadecimal")
    }
    if !are_chunk_extensions(line[digits..<line.len()]) {
        return bad_chunk("what follows the size of a chunk is no extension")
    }
    size :: parse_int_in_base(line[0..<digits].bytes_to_string(), 16)
    if size is ParseError {
        return bad_chunk("the size of a chunk is too large to count")
    }
    return size
}

// `*( BWS ";" BWS name [ BWS "=" BWS value ] )`, a name being a token and a
// value a token or a quoted string.
are_chunk_extensions :: fn(text: u8[]) -> bool {
    at: i64 = 0
    for at < text.len() {
        at = after_blanks(text, at)
        if at == text.len() || text[at] != ';' {
            return false
        }
        at = after_blanks(text, at + 1)
        name_end :: after_token(text, at)
        if name_end == at {
            return false
        }
        at = name_end
        equals :: after_blanks(text, at)
        if equals == text.len() || text[equals] != '=' {
            continue
        }
        at = after_blanks(text, equals + 1)
        value_end :: after_extension_value(text, at) ?? return false
        at = value_end
    }
    return true
}

// Where the token or the quoted string that opens at `at` ends, null when
// there is neither.
after_extension_value :: fn(text: u8[], at: i64) -> i64 | null {
    if at < text.len() && text[at] == '"' {
        return after_quoted_string(text, at)
    }
    end :: after_token(text, at)
    if end == at {
        return null
    }
    return end
}

after_blanks :: fn(text: u8[], from: i64) -> i64 {
    at: i64 = from
    for at < text.len() && is_blank(text[at]) {
        at += 1
    }
    return at
}

after_token :: fn(text: u8[], from: i64) -> i64 {
    at: i64 = from
    for at < text.len() && is_token_byte(text[at]) {
        at += 1
    }
    return at
}

// Where the quoted string that opens at `from` ends, null when it does not
// close or holds a byte none may: `DQUOTE *( qdtext / quoted-pair ) DQUOTE`.
after_quoted_string :: fn(text: u8[], from: i64) -> i64 | null {
    at: i64 = from + 1
    for at < text.len() {
        b :: text[at]
        if b == '"' {
            return at + 1
        }
        if b == '\\' {
            if at + 1 == text.len() || !is_field_value(text[at + 1..<at + 2]) {
                return null
            }
            at += 2
            continue
        }
        if !is_field_value(text[at..<at + 1]) {
            return null
        }
        at += 1
    }
    return null
}

// ---- failures -------------------------------------------------------------

bad_chunk :: fn(msg: string) -> IOError = IOError { .msg = msg, .kind = .InvalidInput }

ended_early :: fn(where: string) -> IOError = IOError {
    .msg = "the chunked body ended ${where}",
    .kind = .EndOfInput,
}

// What a failure of the head reader is to the reader of a body.
chunk_io_error :: fn(error: HttpError) -> IOError {
    cause :: error.cause
    if cause != null {
        return cause
    }
    if error.kind == .Incomplete {
        return ended_early("in the middle of a line")
    }
    return bad_chunk(error.msg)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// The head of a request whose body is chunked.
CHUNKED_HEAD :: "POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\n\r\n"

// The body of the chunked request `wire`, read `size` bytes at a time: its
// text, or `error: ` and why it could not be read.
chunked_text :: fn(wire: string, size: i64 = 4096) -> string {
    request :: read_request(cut(CHUNKED_HEAD + wire, size))
    if request !is Request {
        return "no request"
    }
    return text_of(request.body)
}

// How reading the body of the chunked request `wire` fails, null when it does
// not; `.Other` when the head itself is refused, which no case here expects.
chunked_failure :: fn(wire: string, limits: Limits = Limits {}) -> IOErrorKind | null {
    request :: read_request(whole(CHUNKED_HEAD + wire), limits)
    if request !is Request {
        return .Other
    }
    rest :: BufferedReader { .source = request.body }.read_to_end(1024 * 1024)
    if rest is IOError {
        return rest.kind
    }
    return null
}

// Whether a request whose `Transfer-Encoding` field is `codings` fails as
// `kind`.
codings_fail :: fn(codings: string, kind: HttpErrorKind) -> bool = request_fails(
    "POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: ${codings}\r\n\r\n0\r\n\r\n",
    kind,
)

@test
test_chunks_are_joined_however_they_are_cut :: fn() -> void {
    for size in CUTS {
        assert_eq(chunked_text("5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n", size), "hello world")
    }
}

@test
test_the_size_of_a_chunk_is_hexadecimal_in_either_case :: fn() -> void {
    assert_eq(chunked_text("A\r\n0123456789\r\n0\r\n\r\n"), "0123456789")
    assert_eq(chunked_text("a\r\n0123456789\r\n0\r\n\r\n"), "0123456789")
    assert_eq(chunked_text("005\r\nhello\r\n000\r\n\r\n"), "hello")
    assert_eq(chunked_text("0\r\n\r\n"), "")
}

@test
test_what_follows_a_size_is_an_extension_or_nothing :: fn() -> void {
    for opening in ["5;", "5;;a", "5;=x", "5;a=", "5;a=b c", "5;\"x\"", "5 ", "5;a=\"x", "5;a ;"] {
        assert(
            chunked_failure("${opening}\r\nhello\r\n0\r\n\r\n") == IOErrorKind.InvalidInput,
            "`${opening}` opens no chunk",
        )
    }
    assert_eq(chunked_text("5;a=\"x \\\" y\"\r\nhello\r\n0\r\n\r\n"), "hello")
}

@test
test_chunk_extensions_are_skipped :: fn() -> void {
    assert_eq(chunked_text("5;a=b\r\nhello\r\n0\r\n\r\n"), "hello")
    assert_eq(chunked_text("5 ; a = \"x y\" ;b\r\nhello\r\n0;last\r\n\r\n"), "hello")
}

@test
test_the_request_after_a_chunked_body_is_found_whole :: fn() -> void {
    text :: CHUNKED_HEAD + "5\r\nhello\r\n0\r\nX-Sum: 99\r\nX-More: yes\r\n\r\n"
        + "GET /next HTTP/1.1\r\nHost: h\r\n\r\n"
    for size in CUTS {
        reader :: cut(text, size)
        first :: read_request(reader)
        if first !is Request {
            return assert(false, "no first request, cut by ${size}")
        }
        assert_eq(text_of(first.body), "hello")
        next :: read_request(reader)
        if next !is Request {
            return assert(false, "no next request, cut by ${size}")
        }
        assert_eq(next.target, "/next")
    }
}

@test
test_a_chunk_that_is_no_chunk_fails_the_read :: fn() -> void {
    assert(chunked_failure("xyz\r\n") == IOErrorKind.InvalidInput, "no hexadecimal")
    assert(chunked_failure("\r\n") == IOErrorKind.InvalidInput, "no size")
    assert(chunked_failure("+5\r\nhello\r\n0\r\n\r\n") == IOErrorKind.InvalidInput, "a sign")
    assert(chunked_failure("0x5\r\nhello\r\n0\r\n\r\n") == IOErrorKind.InvalidInput, "a prefix")
    assert(chunked_failure("5 x\r\nhello\r\n0\r\n\r\n") == IOErrorKind.InvalidInput, "no extension")
    assert(
        chunked_failure("5\r\nhelloXX0\r\n\r\n") == IOErrorKind.InvalidInput,
        "no break after data",
    )
    assert(
        chunked_failure("5\nhello\r\n0\r\n\r\n") == IOErrorKind.InvalidInput,
        "a line feed alone",
    )
    assert(
        chunked_failure("FFFFFFFFFFFFFFFFF\r\n") == IOErrorKind.InvalidInput,
        "a size too large to count",
    )
    assert(
        chunked_failure("0\r\nX Sum: 1\r\n\r\n") == IOErrorKind.InvalidInput,
        "a trailer that is no field",
    )
    assert(chunked_failure("5\r\nhello\r\n0\r\n\r\n") == null, "a body that is whole")
}

@test
test_a_chunked_body_that_failed_fails_again :: fn() -> void {
    request :: request_of(whole(CHUNKED_HEAD + "zz\r\n0\r\n\r\n"))
    buffer: u8[]: [0] * 8
    first :: request.body.read(buffer)
    assert(first is IOError && first.kind == .InvalidInput, "a chunk with no size")
    again :: request.body.read(buffer)
    assert(
        again is IOError && again.kind == .InvalidInput,
        "what follows the failure opens no chunk",
    )
}

@test
test_a_chunked_body_cut_short_fails_as_ended :: fn() -> void {
    assert(chunked_failure("5\r\nhel") == IOErrorKind.EndOfInput, "in the data")
    assert(chunked_failure("5\r\nhello") == IOErrorKind.EndOfInput, "before the break of a chunk")
    assert(chunked_failure("5\r\nhello\r\n") == IOErrorKind.EndOfInput, "before the last chunk")
    assert(chunked_failure("5\r\nhello\r\n0\r\n") == IOErrorKind.EndOfInput, "before the last line")
    assert(chunked_failure("5") == IOErrorKind.EndOfInput, "in a size")
}

@test
test_the_line_that_opens_a_chunk_is_bounded :: fn() -> void {
    limits :: Limits { .chunk_line = 8 }
    assert(chunked_failure("5;abcdef\r\nhello\r\n0\r\n\r\n", limits) == null, "8 bytes fit")
    assert(
        chunked_failure("5;abcdefg\r\nhello\r\n0\r\n\r\n", limits) == IOErrorKind.InvalidInput,
        "9 bytes do not",
    )
}

@test
test_only_the_chunked_coding_is_read :: fn() -> void {
    assert_eq(chunked_text("2\r\nok\r\n0\r\n\r\n"), "ok")
    named :: read_request(
        whole("POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: , Chunked ,\r\n\r\n0\r\n\r\n"),
    )
    assert(named is Request, "a name in any case, among empty elements")
    assert(codings_fail("gzip, chunked", .CodingNotImplemented), "a coding before chunked")
    assert(codings_fail("gzip", .Malformed), "a request whose last coding is not chunked")
    assert(codings_fail("chunked, gzip", .Malformed), "chunked not last")
    assert(codings_fail("chunked, chunked", .Malformed), "chunked twice")
    assert(codings_fail("chunked;q=1", .Malformed), "chunked with a parameter")
    assert(codings_fail("chun ked", .Malformed), "a coding no token")
    assert(codings_fail(",", .Malformed), "no coding at all")
    assert(
        request_fails(
            "POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: chunked\r\n\r\n",
            .CodingNotImplemented,
        ),
        "the codings of two lines are one list",
    )
}

@test
test_a_transfer_coding_goes_with_no_length_and_no_http_1_0 :: fn() -> void {
    assert(
        request_fails(
            "POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\nContent-Length: 2\r\n\r\n",
            .Malformed,
        ),
        "a coding and a length",
    )
    assert(
        request_fails("POST / HTTP/1.0\r\nTransfer-Encoding: chunked\r\n\r\n", .Malformed),
        "a coding in HTTP/1.0",
    )
}

@test
test_a_chunked_response_is_read_as_a_request_is :: fn() -> void {
    text :: "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
    for size in CUTS {
        response :: read_response(cut(text, size), asking())
        if response !is Response {
            return assert(false, "no response, cut by ${size}")
        }
        assert_eq(text_of(response.body), "abc")
    }
    other :: read_response(
        whole("HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip\r\n\r\n"),
        asking(),
    )
    assert(
        other is HttpError && other.kind == .CodingNotImplemented,
        "a response in a coding not implemented",
    )
}
