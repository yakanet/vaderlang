// http/headers: the fields of a message.
//
// A field is a name and a value (RFC 9110, section 5). Names compare without
// regard to case, a name may come several times, and the order the lines came
// in is kept: a recipient may join the values of one name with commas, never
// reorder them.

module "http"

// ---- fields ---------------------------------------------------------------

/// One field line: a name and its value.
export Header :: struct {
    /// As it was written. `same_field_name` compares two of them.
    name: string
    /// With no whitespace at either end.
    value: string
}

/// The fields of a message, in the order they were written.
///
/// @example
///   headers :: Headers {}
///   headers.set("Content-Type", "text/plain")
///   headers.get("content-type")   // "text/plain"
export Headers :: struct {
    @internal
    lines: Header[] = []
}

/// The field lines of `headers`, in the order they were written.
///
/// @param headers  the fields to walk.
/// @example
///   headers :: Headers {}
///   headers.add("Accept", "text/html")
///   for line in headers.fields() {
///       line.name   // "Accept"
///   }
export fields :: fn(headers: Headers) -> Iterator<Header> {
    for line in headers.lines {
        yield line
    }
}

// Fields equal to `headers` that share nothing with them: a change to either,
// a line of it included, leaves the other as it was.
copied :: fn(headers: Headers) -> Headers {
    lines: Header[]: []
    for line in headers.lines {
        lines.push(Header { ...line })
    }
    return Headers { .lines = lines }
}

/// How many field lines `headers` holds.
///
/// @param headers  the fields to count.
export count :: fn(headers: Headers) -> i64 = headers.lines.len()

/// The value of the first field named `name`, null when there is none.
///
/// @param headers  the fields to search.
/// @param name     the name looked for, in any case.
export get :: fn(headers: Headers, name: string) -> string | null {
    for line in headers.lines {
        if same_field_name(line.name, name) {
            return line.value
        }
    }
    return null
}

/// The values of every field named `name`, in order; empty when there is none.
///
/// @param headers  the fields to search.
/// @param name     the name looked for, in any case.
export get_all :: fn(headers: Headers, name: string) -> string[] {
    values: string[]: []
    for line in headers.lines {
        if same_field_name(line.name, name) {
            values.push(line.value)
        }
    }
    return values
}

/// Whether a field named `name` lists `member`: the value of such a field is
/// members a comma apart (RFC 9110, section 5.6.1), compared here without
/// regard to case. A comma between double quotes parts nothing.
///
/// @param headers  the fields to search.
/// @param name     the name of a field whose value is a list, in any case.
/// @param member   the member looked for, in any case.
/// @example
///   headers :: Headers {}
///   headers.add("Connection", "keep-alive, Upgrade")
///   headers.lists("connection", "upgrade")   // true
export lists :: fn(headers: Headers, name: string, member: string) -> bool {
    wanted :: member.bytes()
    for line in headers.lines {
        if same_field_name(line.name, name) && has_member(line.value.bytes(), wanted) {
            return true
        }
    }
    return false
}

// Whether one of the members of the list `value` is `wanted`, whatever its
// case.
has_member :: fn(value: u8[], wanted: u8[]) -> bool {
    start: i64 = 0
    for start <= value.len() {
        end :: member_end(value, start)
        if same_bytes(trimmed(value[start..<end]), wanted) {
            return true
        }
        start = end + 1
    }
    return false
}

// Where the member of `value` that starts at `from` ends: at the next comma
// outside a quoted string, in which a backslash takes the byte after it as it
// is, or where `value` does.
member_end :: fn(value: u8[], from: i64) -> i64 {
    quoted := false
    at: i64 = from
    for at < value.len() {
        b :: value[at]
        if quoted && b == '\\' {
            at += 2
            continue
        }
        if b == '"' {
            quoted = !quoted
        }
        if b == ',' && !quoted {
            return at
        }
        at += 1
    }
    return value.len()
}

/// Add a field after the ones already there, those named `name` included.
///
/// @param headers  the fields to add to.
/// @param name     the name of the field.
/// @param value    its value.
export add :: fn(headers: Headers, name: string, value: string) -> void {
    headers.lines.push(Header { .name = name, .value = value })
}

/// Give `name` one value: the fields already named `name` go, and the new one
/// comes last.
///
/// @param headers  the fields to change.
/// @param name     the name of the field.
/// @param value    its only value from now on.
export set :: fn(headers: Headers, name: string, value: string) -> void {
    headers.remove(name)
    headers.add(name, value)
}

/// Take out every field named `name`.
///
/// @param headers  the fields to change.
/// @param name     the name to remove, in any case.
export remove :: fn(headers: Headers, name: string) -> void {
    kept: Header[]: []
    for line in headers.lines {
        if !same_field_name(line.name, name) {
            kept.push(line)
        }
    }
    headers.lines = kept
}

/// Whether two field names are one: they differ at most by the case of their
/// ASCII letters.
///
/// @param a  a field name.
/// @param b  another.
export same_field_name :: fn(a: string, b: string) -> bool = same_bytes(a.bytes(), b.bytes())

// Whether `left` and `right` differ at most by the case of their ASCII letters.
same_bytes :: fn(left: u8[], right: u8[]) -> bool {
    if left.len() != right.len() {
        return false
    }
    for i in 0..<left.len() {
        if lower_ascii(left[i]) != lower_ascii(right[i]) {
            return false
        }
    }
    return true
}

lower_ascii :: fn(b: u8) -> u8 {
    if b >= 'A' && b <= 'Z' {
        return b + 32
    }
    return b
}

// ---- tests ----------------------------------------------------------------

import "std/string"
import "std/testing"

@test
test_headers_find_a_name_in_any_case :: fn() -> void {
    headers :: Headers {}
    headers.add("Content-Type", "text/plain")
    assert_eq(headers.get("content-type") ?? "", "text/plain")
    assert_eq(headers.get("CONTENT-TYPE") ?? "", "text/plain")
    assert(headers.get("Content-Length") == null, "an absent name is null")
}

@test
test_headers_keep_the_lines_of_one_name_in_order :: fn() -> void {
    headers :: Headers {}
    headers.add("Accept", "text/html")
    headers.add("Host", "example.org")
    headers.add("accept", "text/plain")
    assert_eq(headers.get_all("Accept").join(" | "), "text/html | text/plain")
    assert_eq(headers.get("Accept") ?? "", "text/html")
}

@test
test_headers_set_replaces_every_line_of_the_name :: fn() -> void {
    headers :: Headers {}
    headers.add("Accept", "text/html")
    headers.add("accept", "text/plain")
    headers.set("ACCEPT", "*/*")
    assert_eq(headers.get_all("Accept").join(" | "), "*/*")
}

@test
test_headers_remove_leaves_the_other_names :: fn() -> void {
    headers :: Headers {}
    headers.add("Accept", "text/html")
    headers.add("Host", "example.org")
    headers.remove("accept")
    assert_eq(headers.count(), 1)
    assert_eq(headers.get("Host") ?? "", "example.org")
}

@test
test_headers_list_a_member_on_any_line_in_any_case :: fn() -> void {
    headers :: Headers {}
    headers.add("Connection", "keep-alive ,\tUpgrade")
    headers.add("connection", "CLOSE")
    assert(headers.lists("Connection", "upgrade"), "a member between a comma and a tab")
    assert(headers.lists("Connection", "close"), "a member of a second line")
    assert(!headers.lists("Connection", "keep"), "the start of a member is not that member")
    assert(!headers.lists("Upgrade", "close"), "another field lists nothing")
}

@test
test_headers_list_no_member_out_of_a_quoted_string :: fn() -> void {
    headers :: Headers {}
    headers.add("Expect", "note=\"a, 100-continue, b\"")
    assert(!headers.lists("Expect", "100-continue"), "a comma between quotes parts nothing")
    headers.add("Expect", "note=\"a \\\", 100-continue, b\", 100-continue")
    assert(headers.lists("Expect", "100-continue"), "a quote after a backslash closes nothing")
    empty :: Headers {}
    empty.add("Connection", ", ,close,")
    assert(empty.lists("Connection", "close"), "empty members are passed over")
}

@test
test_field_names_differ_by_more_than_case :: fn() -> void {
    assert(same_field_name("Host", "hOST"), "case does not tell names apart")
    assert(!same_field_name("Host", "Hosts"), "a longer name is another")
    assert(!same_field_name("Host", "Hast"), "another letter is another name")
}
