// http/serve: the connections of a listener, each served in a task of its own.
//
// `serve` accepts connections and hands each to `serve_connection`
// (server.vader), which owns the exchanges of one. A connection that waits,
// for its next request or for a client slow to read, parks its task, and the
// others go on.
//
// A process that has as many open sockets as it may accepts no connection
// until one closes: `serve` waits and asks again, and the connections it
// serves go on meanwhile.
//
// No connection outlives the call. When no further one is accepted, those
// waiting for a request end at once, and those serving one end after it, or
// are cut where they are once the grace of `ServeOptions` has passed.
// Cancelling the call cuts them all at once.
//
// A connection the server ends after writing to it is closed in two steps:
// its sending side first, then the whole of it once the client has closed
// its own, or has been given its time to.
// docs/adr/0139-a-server-is-a-task-per-connection-none-outlives-it.md has the
// reasons, docs/adr/0141-a-server-stops-between-two-requests.md those of the
// stop.

module "http"

import "std/io"
import "std/math"
import "std/net"
import "std/task"
import "std/time"

// ---- what a caller sets ---------------------------------------------------

/// How `serve` serves its connections.
export ServeOptions :: struct {
    /// How much of a request is read before it is refused.
    limits: Limits = Limits {}
    /// How long a client may take at each step.
    timeouts: Timeouts = Timeouts {}
    /// How long the exchanges under way are given to finish once no further
    /// connection is accepted, in all; null for as long as they take.
    grace: Duration | null = 30.seconds()
}

// ---- serving a listener ---------------------------------------------------

/// Serve the connections made to `listener`, each in a task of its own, until
/// no further one is accepted.
///
/// A connection is served as `serve_connection` serves one, then closed. Its
/// client is held to `options.timeouts`: one that sends the head of a request
/// too slowly is answered `408`, and a connection that stays silent, or whose
/// client stops reading, is closed.
///
/// `handler` runs in the task of a connection, and several connections are
/// served at a time: what it keeps from one request to the next goes in a
/// `Shared` or an `AtomicInt` of `std/task`.
///
/// Closing `listener` ends the call. A connection waiting for a request is
/// then closed at once; one serving a request ends after it, its response
/// saying `Connection: close`, or is cut where it is once `options.grace` has
/// passed. Cancelling the task that runs the call cuts them all at once.
/// None is left when the call returns.
///
/// A process that has as many open sockets as it may does not end the call:
/// the next connection is accepted once the process can open one.
///
/// @param listener  where the connections arrive.
/// @param handler   what answers a request, with a final response.
/// @param options   how much of a request is read, and how long its client
///                  may take.
/// @return          why no further connection was accepted: the listener was
///                  closed, or the system refused.
/// @example
///   # import "std/net"
///   listener :: listen(loopback(8080))
///   if listener is TcpListener {
///       serve(listener, request -> new_response(STATUS_OK, "hello\n"))
///   }
export serve :: fn(
    listener: TcpListener,
    handler: fn(Request) -> Response,
    options: ServeOptions = ServeOptions {},
) -> IOError {
    serving: Connection[]: []
    defer cut(serving)
    accept :: () -> listener.accept()
    for {
        stream :: patiently(accept)
        if stream is IOError {
            wind_down(serving, options.grace)
            return stream
        }
        serving.remove_where((connection) -> connection.task.is_ready())
        // A connection keeps its options for as long as it is served: each is
        // handed a copy, which no other task holds.
        own :: options.deep_copy()
        stop :: Stop {}
        serving.push(
            Connection {
                .stream = stream,
                .stop = stop,
                .task = launch(() -> serve_stream(stream, handler, own, stop)),
            },
        )
    }
}

// How long `patiently` waits before it asks again, at first and at most, in
// milliseconds.
FIRST_PAUSE_MILLIS: i64: 5
LONGEST_PAUSE_MILLIS: i64: 1000

// What `accept` gives, asked again for as long as it fails for want of a
// descriptor: one comes back when a connection closes. The wait doubles each
// time, so that a process that stays short is not kept busy asking.
patiently :: fn(accept: fn() -> TcpStream | IOError) -> TcpStream | IOError {
    pause := FIRST_PAUSE_MILLIS
    for {
        stream :: accept()
        if stream is TcpStream || stream.kind != .NoDescriptor {
            return stream
        }
        sleep(pause.millis())
        pause = min(pause * 2, LONGEST_PAUSE_MILLIS)
    }
}

// A connection, the task that serves it, and what stops it.
Connection :: struct {
    stream: TcpStream
    stop: Stop
    task: Task<void>
}

// Serve the connection `stream` to its end, and close it.
serve_stream :: fn(
    stream: TcpStream,
    handler: fn(Request) -> Response,
    options: ServeOptions,
    stop: Stop,
) -> void {
    defer stream.close()
    pace :: Pace {
        .deadlines = stream,
        .timeouts = options.timeouts,
        .stop = stop,
    }
    end :: serve_paced(stream, stream, handler, options.limits, pace)
    if lingers(end) {
        linger(stream, options.timeouts.linger)
    }
}

// Whether the connection `end` tells of may still carry bytes of its client
// when the server closes it: the server wrote last, and the client did not
// close its side.
lingers :: fn(end: ConnectionEnd) -> bool = match end.reason {
    .ClientDone | .Failed -> false
    .TimedOut -> end.error != null
    .Closed | .LeftHttp | .BadRequest | .BadResponse | .UnreadBody -> true
}

// Close the sending side of `stream`, then read and drop what its client
// still sends, until it closes its own or `time` has passed.
linger :: fn(stream: TcpStream, time: Duration | null) -> void {
    if stream.close_write() is IOError {
        return
    }
    stream.read_by(instant_in(time))
    dropped: u8[]: [0] * COPY_CHUNK
    for {
        got :: stream.read(dropped)
        if got !is i64 {
            return
        }
    }
}

// ---- stopping -------------------------------------------------------------

// Where a connection is, which it and `serve` both move: `WAITING` for a
// request, `SERVING` one, or `STOPPED` by `serve`. A connection stopped as it
// waited is cancelled; one stopped as it served ends after its exchange.
Stop :: struct {
    state: AtomicInt = AtomicInt {}
}

WAITING: i64: 0
SERVING: i64: 1
STOPPED: i64: 2

// Whether the connection may wait for a request after the one it served:
// not once `serve` stops.
waits :: fn(stop: Stop) -> bool =
    stop.state.compare_and_set(SERVING, WAITING) || stop.state.load() == WAITING

// Whether the connection may serve the request whose first byte came: not
// once `serve` has stopped it.
begins :: fn(stop: Stop) -> bool = stop.state.compare_and_set(WAITING, SERVING)

// Whether the exchange under way is the last of its connection, `serve`
// having stopped.
stopping :: fn(stop: Stop) -> bool = stop.state.load() == STOPPED

// Stop the connections of `serving`: those waiting for a request at once,
// the others after the exchange they serve. They are waited for, `grace` in
// all; `cut` ends those still served after it.
wind_down :: fn(serving: Connection[], grace: Duration | null) -> void {
    tasks: Task<void>[]: []
    for connection in serving {
        halt(connection)
        tasks.push(connection.task)
    }
    ended :: launch(() -> join_all(tasks))
    if grace == null {
        ended.join()
    } else {
        ended.timeout(grace)
    }
}

// Stop `connection`: cancelled if it waits for a request. Each move of the
// connection between waiting and serving fails one of the attempts, which is
// then made again.
halt :: fn(connection: Connection) -> void {
    state :: connection.stop.state
    for !connection.task.is_ready() {
        if state.compare_and_set(WAITING, STOPPED) {
            return connection.task.cancel()
        }
        if state.compare_and_set(SERVING, STOPPED) {
            return
        }
    }
}

TcpStream implements Deadlines {
    read_within :: fn(self, timeout: Duration | null) -> void {
        self.read_by(instant_in(timeout))
    }
    write_within :: fn(self, timeout: Duration | null) -> void {
        self.write_by(instant_in(timeout))
    }
}

// The instant `timeout` from now; null for no timeout.
instant_in :: fn(timeout: Duration | null) -> Monotonic | null {
    if timeout == null {
        return null
    }
    return monotonic() + timeout
}

// Cancel the connections of `serving` still served, and wait until each is
// closed. All are cancelled first, so that they unwind together. A task
// cancelled before it started runs nothing, its `defer` included: its stream
// is closed here.
cut :: fn(serving: Connection[]) -> void {
    for connection in serving {
        connection.task.cancel()
    }
    for connection in serving {
        connection.task.join()
        connection.stream.close()
    }
}

// ---- tests ----------------------------------------------------------------

import "std/string"
import "std/testing"

// A listener on a free port of the loopback address; null, the test having
// failed, when the system refuses.
listening :: fn() -> TcpListener | null {
    listener :: listen(loopback(0))
    if listener is IOError {
        assert(false, "cannot listen: ${listener.msg}")
        return null
    }
    return listener
}

// Where `listener` listens; null, the test having failed, when the system
// does not tell.
address_of :: fn(listener: TcpListener) -> SocketAddress | null {
    address :: listener.local_address()
    if address is IOError {
        assert(false, "no address: ${address.msg}")
        return null
    }
    return address
}

// A connection to `address`; null, the test having failed, when there is none.
calling :: fn(address: SocketAddress) -> TcpStream | null {
    stream :: connect(address)
    if stream is IOError {
        assert(false, "cannot connect: ${stream.msg}")
        return null
    }
    return stream
}

// A request for `target` that asks to keep its connection, or to end it.
get :: fn(target: string, last: bool = false) -> string {
    if last {
        return "GET ${target} HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n"
    }
    return "GET ${target} HTTP/1.1\r\nHost: h\r\n\r\n"
}

// What `stream` carries until its end, which a connection left open never
// has: the wait is given up after a while, and the test fails on what it gets.
rest_of :: fn(stream: TcpStream) -> string {
    rest :: launch(() -> read_to_the_end(stream)).timeout(10.seconds())
    if rest is string {
        return rest
    }
    return "no end in sight"
}

read_to_the_end :: fn(stream: TcpStream) -> string {
    reader :: BufferedReader { .source = stream }
    rest :: reader.read_to_end(65536)
    if rest is IOError {
        return "error: ${rest.msg}"
    }
    return rest.bytes_to_string()
}

// The next `count` bytes `stream` carries.
some_of :: fn(stream: TcpStream, count: i64) -> string {
    into: u8[]: [0] * count
    seen: i64 = 0
    for seen < count {
        got :: stream.read(into[seen..<count])
        if got !is i64 {
            return "ended after ${seen} bytes"
        }
        seen += got
    }
    return into.bytes_to_string()
}

// A connection to `address` that has sent the head of a request and two bytes
// of its body of five, once `reading` says its handler reads the body.
half_posted :: fn(address: SocketAddress, reading: AtomicBool) -> TcpStream | null {
    stream :: calling(address) ?? return null
    stream.write("POST /a HTTP/1.1\r\nHost: h\r\nContent-Length: 5\r\n\r\nhe")
    for !reading.load() {
        sleep(1.millis())
    }
    return stream
}

// Answers a request with its target.
naming :: fn(request: Request) -> Response = new_response(STATUS_OK, request.target)

// What `naming` answers to a request for `target`, the last of its connection
// or not.
named :: fn(target: string, last: bool = false) -> string {
    if last {
        return "HTTP/1.1 200 OK\r\nContent-Length: ${target.byte_len()}\r\nConnection: close\r\n\r\n${target}"
    }
    return "HTTP/1.1 200 OK\r\nContent-Length: ${target.byte_len()}\r\n\r\n${target}"
}

@test
test_connections_are_served_at_the_same_time :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    server :: launch(() -> serve(listener, naming))
    first :: calling(address) ?? return
    second :: calling(address) ?? return
    // The last to connect speaks first: a server that served one connection
    // at a time would wait for the first.
    second.write(get("/2", true))
    assert_eq(rest_of(second), named("/2", true))
    first.write(get("/1", true))
    assert_eq(rest_of(first), named("/1", true))
    first.close()
    second.close()
    listener.close()
    server.join()
}

@test
test_a_connection_carries_its_requests_in_turn :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    server :: launch(() -> serve(listener, naming))
    stream :: calling(address) ?? return
    stream.write(get("/a"))
    assert_eq(some_of(stream, named("/a").byte_len()), named("/a"))
    stream.write(get("/b", true))
    assert_eq(rest_of(stream), named("/b", true))
    stream.close()
    listener.close()
    server.join()
}

@test
test_what_a_handler_keeps_is_shared_by_the_connections :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    served :: AtomicInt {}
    server :: launch(
        () -> serve(
            listener,
            fn(request: Request) -> Response {
                return new_response(STATUS_OK, "${served.fetch_add(1) + 1}")
            },
        ),
    )
    answers: string[]: []
    for _ in 0..<3 {
        stream :: calling(address) ?? return
        stream.write(get("/", true))
        answers.push(rest_of(stream).split("\r\n\r\n")[1])
        stream.close()
    }
    assert_eq(answers.join(" "), "1 2 3")
    listener.close()
    server.join()
}

@test
test_closing_the_listener_ends_the_call_and_its_connections :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    server :: launch(() -> serve(listener, naming))
    idle :: calling(address) ?? return
    idle.write(get("/a"))
    assert_eq(some_of(idle, named("/a").byte_len()), named("/a"))
    began :: monotonic()
    listener.close()
    ended :: server.join()
    assert(ended is IOError, "the call tells why it accepts no more")
    // The connection waited for a request: it was closed at once, not given
    // the grace of an exchange under way.
    assert(began.since() < 10.seconds(), "a connection waiting for a request is not waited for")
    assert_eq(rest_of(idle), "")
    idle.close()
}

@test
test_closing_the_listener_lets_an_exchange_under_way_finish :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    reading :: AtomicBool {}
    echo :: fn(request: Request) -> Response {
        reading.store(true)
        return new_response(STATUS_OK, text_of(request.body))
    }
    server :: launch(() -> serve(listener, echo))
    stream :: half_posted(address, reading) ?? return
    listener.close()
    stream.write("llo")
    // Whether the response says `close` depends on whether the server had
    // stopped when its head went out: the tests of `serve_paced` pin it.
    answer :: rest_of(stream)
    assert(answer.starts_with("HTTP/1.1 200 OK\r\n"), "the exchange was answered: ${answer}")
    assert(answer.ends_with("\r\n\r\nhello"), "the whole body was read: ${answer}")
    assert(server.join() is IOError, "the call tells why it accepts no more")
    stream.close()
}

@test
test_an_exchange_past_the_grace_is_cut :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    reading :: AtomicBool {}
    echo :: fn(request: Request) -> Response {
        reading.store(true)
        return new_response(STATUS_OK, text_of(request.body))
    }
    options :: ServeOptions { .grace = 50.millis() }
    server :: launch(() -> serve(listener, echo, options))
    // The body never comes whole.
    stream :: half_posted(address, reading) ?? return
    began :: monotonic()
    listener.close()
    assert(server.join() is IOError, "the call tells why it accepts no more")
    assert(began.since() >= 40.millis(), "the exchange was given its grace")
    assert(began.since() < 10.seconds(), "the exchange was given its grace, no more")
    assert_eq(rest_of(stream), "")
    stream.close()
}

@test
test_a_response_is_not_lost_to_a_body_its_server_left_unread :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    // The response ends the connection, and nothing reads the body.
    hasty :: fn(request: Request) -> Response {
        response :: new_response(STATUS_OK, "done")
        response.headers.set(CONNECTION, CLOSE)
        return response
    }
    server :: launch(() -> serve(listener, hasty))
    stream :: calling(address) ?? return
    stream.write(posting("/a", "x" * 32768))
    // The server is done with the connection before the client reads.
    sleep(50.millis())
    assert_eq(
        rest_of(stream),
        "HTTP/1.1 200 OK\r\nContent-Length: 4\r\nConnection: close\r\n\r\ndone",
    )
    stream.close()
    listener.close()
    server.join()
}

@test
test_a_client_that_keeps_its_side_open_is_given_its_time_to_close :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    client :: calling(address) ?? return
    client.write(get("/a", true))
    accepted :: listener.accept()
    if accepted is IOError {
        return assert(false, "no connection: ${accepted.msg}")
    }
    options :: ServeOptions { .timeouts = Timeouts { .linger = 50.millis() } }
    began :: monotonic()
    serve_stream(accepted, naming, options, Stop {})
    assert(began.since() >= 40.millis(), "the server waited for its client to close")
    assert(began.since() < 10.seconds(), "the server waited for its time, no more")
    assert_eq(rest_of(client), named("/a", true))
    client.close()
    listener.close()
}

// A `Stop` as `serve` leaves it when it stops a connection.
stopped :: fn() -> Stop {
    stop :: Stop {}
    stop.state.store(STOPPED)
    return stop
}

@test
test_a_connection_the_server_stopped_waits_for_no_request :: fn() -> void {
    // Its client, who sends nothing, is not waited for.
    silent :: stalled_after("", naming, stopped())
    assert(silent.end.reason == .Closed, "the server stopped the connection")
    assert_eq(silent.written, "")
}

@test
test_a_request_that_comes_as_the_server_stops_is_not_taken :: fn() -> void {
    late :: stalled_after(get("/a"), naming, stopped())
    assert(late.end.reason == .Closed, "the server stopped the connection")
    assert_eq(late.written, "")
}

@test
test_the_exchange_under_way_as_the_server_stops_is_the_last :: fn() -> void {
    stop :: Stop {}
    // The server stops while the handler runs, as `halt` does.
    halting :: fn(request: Request) -> Response {
        stop.state.compare_and_set(SERVING, STOPPED)
        return naming(request)
    }
    result :: stalled_after(get("/a") + get("/b"), halting, stop)
    assert(result.end.reason == .Closed, "the exchange ended the connection")
    assert_eq(result.written, named("/a", true))
}

@test
test_cancelling_the_call_ends_its_connections :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    server :: launch(() -> serve(listener, naming))
    idle :: calling(address) ?? return
    idle.write(get("/a"))
    assert_eq(some_of(idle, named("/a").byte_len()), named("/a"))
    server.cancel()
    assert(server.join() is Cancelled, "the call was cancelled")
    assert_eq(rest_of(idle), "")
    idle.close()
    listener.close()
}

@test
test_a_connection_cut_before_it_was_served_is_closed :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    client :: calling(address) ?? return
    accepted :: listener.accept()
    if accepted is IOError {
        return assert(false, "no connection: ${accepted.msg}")
    }
    // Nothing parks between the launch and the cut: the task has not started.
    stop :: Stop {}
    cut(
        [
            Connection {
                .stream = accepted,
                .stop = stop,
                .task = launch(() -> serve_stream(accepted, naming, ServeOptions {}, stop)),
            },
        ],
    )
    assert_eq(rest_of(client), "")
    client.close()
    listener.close()
}

@test
test_a_process_out_of_descriptors_is_waited_for :: fn() -> void {
    asked: i64[]: [0]
    short :: IOError { .msg = "too many open files", .kind = .NoDescriptor }
    gone :: IOError { .msg = "socket is closed", .kind = .BadHandle }
    began :: monotonic()
    ended :: patiently(
        fn() -> TcpStream | IOError {
            asked[0] += 1
            if asked[0] < 4 {
                return short
            }
            return gone
        },
    )
    assert(ended is IOError && ended.kind == .BadHandle, "another failure ends the wait")
    assert_eq(asked[0], 4)
    // Three waits, of 5, 10 and 20 ms.
    assert(began.since() >= 35.millis(), "each failure is waited out, longer each time")
}

@test
test_a_connection_kept_idle_too_long_is_closed :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    options :: ServeOptions { .timeouts = Timeouts { .idle = 50.millis() } }
    server :: launch(() -> serve(listener, naming, options))
    stream :: calling(address) ?? return
    stream.write(get("/a"))
    assert_eq(some_of(stream, named("/a").byte_len()), named("/a"))
    began :: monotonic()
    // Nothing more is asked: the server ends the connection, with no answer.
    assert_eq(rest_of(stream), "")
    assert(began.since() >= 40.millis(), "the connection was kept for its time")
    stream.close()
    listener.close()
    server.join()
}

@test
test_a_head_sent_too_slowly_is_answered_408 :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    options :: ServeOptions { .timeouts = Timeouts { .head = 50.millis() } }
    server :: launch(() -> serve(listener, naming, options))
    stream :: calling(address) ?? return
    stream.write("GET /a HTTP/1.1\r\nHo")
    assert_eq(
        rest_of(stream),
        "HTTP/1.1 408 Request Timeout\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
    )
    stream.close()
    listener.close()
    server.join()
}

@test
test_a_client_that_never_speaks_is_let_go :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    options :: ServeOptions { .timeouts = Timeouts { .head = 50.millis() } }
    server :: launch(() -> serve(listener, naming, options))
    stream :: calling(address) ?? return
    assert_eq(rest_of(stream), "")
    stream.close()
    listener.close()
    server.join()
}

@test
test_a_client_that_stops_reading_is_let_go :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    // A response with no end, to a client that reads none of it.
    endless :: fn(request: Request) -> Response = Response { .body = Endless {} }
    options :: ServeOptions { .timeouts = Timeouts { .write = 50.millis() } }
    stream :: calling(address) ?? return
    stream.write(get("/a"))
    accepted :: listener.accept()
    if accepted is IOError {
        return assert(false, "no connection: ${accepted.msg}")
    }
    pace :: Pace { .deadlines = accepted, .timeouts = options.timeouts }
    end :: serve_paced(accepted, accepted, endless, options.limits, pace)
    assert(end.reason == .TimedOut, "the response stopped at a write nobody took")
    accepted.close()
    stream.close()
    listener.close()
}

// A body that never ends.
Endless :: struct {}

Endless implements Reader {
    read :: fn(self, into: u8[]) -> i64 | null | IOError {
        for i in 0..<into.len() {
            into[i] = 'x'
        }
        return into.len()
    }
}

// Send `wire` to `stream` a byte at a time, `every` apart, until the server
// answers; then what it answers, to the end of the connection.
dripped :: fn(stream: TcpStream, wire: string, every: Duration) -> string {
    first: u8[]: [0] * 1
    for byte in wire.bytes() {
        stream.write([byte])
        stream.read_by(instant_in(every))
        got :: stream.read(first)
        if got is i64 {
            stream.read_by(null)
            return first.bytes_to_string() + rest_of(stream)
        }
        if got !is IOError || got.kind != .TimedOut {
            return "the connection ended with no answer"
        }
    }
    return "no answer"
}

// A head that comes a byte at a time and never ends.
SLOW_HEAD :: "GET /a HTTP/1.1\r\nX-Slow: "

@test
test_a_head_sent_a_byte_at_a_time_is_held_to_its_time_in_all :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    options :: ServeOptions { .timeouts = Timeouts { .head = 500.millis() } }
    server :: launch(() -> serve(listener, naming, options))
    stream :: calling(address) ?? return
    // Each byte comes well within the time of a head, and the bytes take four
    // times as long: only the head as a whole runs out of it.
    assert_eq(dripped(stream, SLOW_HEAD + "a" * 100, 20.millis()), REQUEST_TIMEOUT)
    stream.close()
    listener.close()
    server.join()
}

@test
test_the_next_head_of_a_kept_connection_is_held_to_its_time_in_all :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    options :: ServeOptions { .timeouts = Timeouts { .head = 500.millis() } }
    server :: launch(() -> serve(listener, naming, options))
    stream :: calling(address) ?? return
    stream.write(get("/a"))
    assert_eq(some_of(stream, named("/a").byte_len()), named("/a"))
    assert_eq(dripped(stream, SLOW_HEAD + "a" * 100, 20.millis()), REQUEST_TIMEOUT)
    stream.close()
    listener.close()
    server.join()
}

@test
test_a_body_announced_and_never_sent_ends_its_connection :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    echoing :: fn(request: Request) -> Response = Response { .body = request.body }
    options :: ServeOptions { .timeouts = Timeouts { .body = 100.millis() } }
    server :: launch(() -> serve(listener, echoing, options))
    stream :: calling(address) ?? return
    stream.write("POST /a HTTP/1.1\r\nHost: h\r\nContent-Length: 1000000\r\n\r\n")
    assert_eq(rest_of(stream), REQUEST_TIMEOUT)
    stream.close()
    listener.close()
    server.join()
}

@test
test_a_chunk_size_that_is_no_size_ends_its_connection_at_once :: fn() -> void {
    listener :: listening() ?? return
    address :: address_of(listener) ?? return
    ignoring :: fn(request: Request) -> Response = Response {}
    server :: launch(() -> serve(listener, ignoring))
    stream :: calling(address) ?? return
    stream.write("POST /a HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\n\r\n")
    // The size comes in a read of its own, after the server has begun to wait
    // for it.
    sleep(20.millis())
    stream.write("zz\r\n")
    // The size is no size: the body cannot be read past, and the connection
    // ends now, not when the time of a body has passed.
    assert_eq(rest_of(stream), EMPTY_OK)
    stream.close()
    listener.close()
    server.join()
}
