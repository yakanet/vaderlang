// http/connection: what an exchange leaves of its connection.
//
// A connection carries one exchange after another for as long as both ends
// agree to, and each message ends where its fields say (RFC 9112, section
// 9.3). What is here tells whether it does, reads past a body nobody read, and
// answers the client that holds its content back until told to send it (RFC
// 9110, section 10.1.1).

module "http"

import "std/io"

// ---- persistence ----------------------------------------------------------

/// Whether the connection carries another exchange after `response` to
/// `request`.
///
/// It does not when either message says `close`, when either is of HTTP/1.0
/// and does not say `keep-alive`, when the response ends with the connection
/// or turns it into something else than HTTP, and when the request waited for
/// a `100 Continue` that never came: its content may follow, or not.
///
/// A server asks once the response is written, a client once it is read. The
/// body each was handed is then read to its end, as `drain` does, before the
/// next message.
///
/// @param request   the request of the exchange; null for one a server could
///                  not read.
/// @param response  its final response.
/// @example
///   request :: Request { .method = .Get, .target = "/" }
///   persists(request, Response {})   // true
///   request.headers.set("Connection", "close")
///   persists(request, Response {})   // false
export persists :: fn(request: Request | null, response: Response) -> bool {
    if request == null || response.ends_with_connection {
        return false
    }
    if request.exchange.continue_on != null {
        return false
    }
    if response.status == STATUS_SWITCHING_PROTOCOLS
        || opens_tunnel(request.method, response.status) {
        return false
    }
    return lasts(request.version, request.headers) && lasts(response.version, response.headers)
}

// Whether a message of `version` with the fields `headers` lets its connection
// go on (RFC 9112, section 9.3): `close` ends it, HTTP/1.1 keeps it otherwise,
// HTTP/1.0 keeps it when asked to.
lasts :: fn(version: HttpVersion, headers: Headers) -> bool {
    if headers.lists(CONNECTION, CLOSE) {
        return false
    }
    return version == .Http11 || headers.lists(CONNECTION, KEEP_ALIVE)
}

/// Read `body` to its end and drop what is read, so that the next message of
/// its connection is found whole.
///
/// Ask `persists` first: the body of a request that was never told to send its
/// content is not one to wait for.
///
/// @param body    the body of the message last read: of the request for a
///                server, of the response for a client.
/// @param limits  `unread_body` is how much is read past: a peer that sends
///                without end is not read without end.
/// @return        whether the end was reached. When it was not, more was left
///                than is read past or the body failed: the connection carries
///                no further message.
export drain :: fn(body: Reader, limits: Limits = Limits {}) -> bool {
    chunk: u8[]: [0] * COPY_CHUNK
    left: i64 = limits.unread_body
    for {
        got :: body.read(chunk)
        if got is IOError {
            return false
        }
        if got == null {
            return true
        }
        left -= got
        if left < 0 {
            return false
        }
    }
}

// ---- the client that waits to be told to send -----------------------------

// How far a request has been answered on its connection.
Exchange :: struct {
    // Where the `100 Continue` the client waits for is written; null when it
    // waits for none, and once it was told to send its content.
    continue_on: Writer | null = null
    // The final response went out. Any response written after it would be
    // read as the start of the one to the next request.
    answered: bool = false
}

// What the client reads as leave to send its content.
CONTINUE_RESPONSE :: "HTTP/1.1 100 Continue\r\n\r\n"

/// Have the client of `request` told to send its content when the body of
/// `request` is first read, if it waits for that.
///
/// A client may send `Expect: 100-continue` and hold the content of its
/// request back until the server answers `100 Continue`, or a final response
/// that spares it the sending. After this call, the first read of
/// `request.body` writes that `100 Continue` on `writer`. A request that waits
/// for nothing is left as it is: one of HTTP/1.0, or one that carries no
/// content.
///
/// A request answered before its body was read gets no `100 Continue`:
/// `write_response` says the connection closes, `persists` that it does, and a
/// read of the body from then on fails.
///
/// @param request  a request `read_request` returned, its body not read yet.
/// @param writer   where the connection is written. What it is given must go
///                 out at once and not be gathered: the client waits for it.
/// @example
///   # import "std/io"
///   # text :: "PUT /f HTTP/1.1\r\nHost: h\r\nContent-Length: 2\r\nExpect: 100-continue\r\n\r\nhi"
///   # request :: read_request(BufferedReader { .source = BytesReader { .content = text } })
///   out :: BytesWriter {}
///   if request is Request {
///       request.continue_on_read(out)
///       request.body.read([0] * 2)
///       out.written.bytes_to_string()   // "HTTP/1.1 100 Continue\r\n\r\n"
///   }
export continue_on_read :: fn(request: Request, writer: Writer) -> void {
    if !awaits_continue(request) {
        return
    }
    request.exchange.continue_on = writer
    request.body = AwaitedBody { .body = request.body, .exchange = request.exchange }
}

// Whether the client of `request` holds its content back: an HTTP/1.1 request
// that lists the `100-continue` expectation and whose fields say content
// follows. A member of `Expect` is compared as a whole, so a parameter after
// `100-continue`, which it has none, makes it another expectation.
awaits_continue :: fn(request: Request) -> bool {
    if request.version != .Http11 || !request.headers.lists(EXPECT, EXPECTS_CONTINUE) {
        return false
    }
    if request.headers.get(TRANSFER_ENCODING) != null {
        return true
    }
    lengths :: request.headers.get_all(CONTENT_LENGTH)
    if lengths.len() == 0 {
        return false
    }
    length :: content_length(lengths)
    return length is i64 && length > 0
}

// The body of a request whose client waits for `100 Continue`: the first read
// writes it, then reads `body`.
AwaitedBody :: struct {
    body: Reader
    exchange: Exchange
}

AwaitedBody implements Reader {
    read :: fn(self, into: u8[]) -> i64 | null | IOError {
        writer :: self.exchange.continue_on
        if writer != null {
            if self.exchange.answered {
                return IOError { .msg = "the content of the request was never asked for" }
            }
            written :: writer.write(CONTINUE_RESPONSE)
            if written is IOError {
                return written
            }
            self.exchange.continue_on = null
        }
        return self.body.read(into)
    }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// Whether a connection goes on after `response` to the request whose head is
// `request_head`, its empty line left out.
goes_on :: fn(request_head: string, response: Response = Response {}) -> bool =
    persists(request_of(whole(request_head + "\r\n")), response)

// A response of HTTP/1.1 that says `connection` of its connection.
saying :: fn(connection: string, version: HttpVersion = .Http11) -> Response {
    response :: Response { .version = version }
    response.headers.set("Connection", connection)
    return response
}

@test
test_an_http_1_1_connection_goes_on_until_told_to_close :: fn() -> void {
    assert(goes_on("GET / HTTP/1.1\r\nHost: h\r\n"), "nothing said")
    assert(!goes_on("GET / HTTP/1.1\r\nHost: h\r\nConnection: close\r\n"), "the request closes")
    assert(
        !goes_on("GET / HTTP/1.1\r\nHost: h\r\nConnection: Keep-Alive, CLOSE\r\n"),
        "close in a list, in upper case",
    )
    assert(
        !goes_on("GET / HTTP/1.1\r\nHost: h\r\nConnection: upgrade\r\nConnection: close\r\n"),
        "close on a second line",
    )
    assert(
        goes_on("GET / HTTP/1.1\r\nHost: h\r\nConnection: closed\r\n"),
        "another option is not close",
    )
    assert(!goes_on("GET / HTTP/1.1\r\nHost: h\r\n", saying("close")), "the response closes")
}

@test
test_an_http_1_0_connection_goes_on_only_when_asked_to :: fn() -> void {
    assert(!goes_on("GET / HTTP/1.0\r\n"), "nothing said")
    assert(goes_on("GET / HTTP/1.0\r\nConnection: keep-alive\r\n"), "keep-alive")
    assert(
        !goes_on("GET / HTTP/1.0\r\nConnection: keep-alive, close\r\n"),
        "close wins over keep-alive",
    )
    assert(
        !goes_on("GET / HTTP/1.1\r\nHost: h\r\n", Response { .version = .Http10 }),
        "a response of HTTP/1.0",
    )
    assert(
        goes_on("GET / HTTP/1.1\r\nHost: h\r\n", saying("Keep-Alive", .Http10)),
        "a response of HTTP/1.0 that keeps the connection",
    )
}

@test
test_a_connection_ends_with_a_request_that_could_not_be_read :: fn() -> void {
    assert(!persists(null, Response { .status = STATUS_BAD_REQUEST }), "no request")
}

@test
test_a_connection_that_leaves_http_carries_no_further_exchange :: fn() -> void {
    assert(!persists(asking(.Connect), Response {}), "a tunnel")
    assert(persists(asking(.Connect), Response { .status = STATUS_FORBIDDEN }), "a tunnel refused")
    assert(
        !persists(asking(), Response { .status = STATUS_SWITCHING_PROTOCOLS }),
        "another protocol",
    )
}

@test
test_a_response_that_ends_with_the_connection_ends_it :: fn() -> void {
    request :: asking()
    open :: read_response(whole("HTTP/1.1 200 OK\r\n\r\nall that is left"), request)
    assert(open is Response && !persists(request, open), "no length declared")
    counted :: read_response(whole("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok"), request)
    assert(counted is Response && persists(request, counted), "a length declared")
    empty :: read_response(whole("HTTP/1.1 204 No Content\r\n\r\n"), request)
    assert(empty is Response && persists(request, empty), "no content to end")
}

// What `response` puts on the wire in answer to the request whose head is
// `request_head`, its empty line left out.
answer_to_head :: fn(request_head: string, response: Response) -> string {
    wire :: response_wire(response, request_of(whole(request_head + "\r\n")))
    if wire is string {
        return wire
    }
    return "the response is not written"
}

@test
test_a_response_says_when_its_connection_closes :: fn() -> void {
    assert_eq(
        answer_to_head("GET / HTTP/1.1\r\nHost: h\r\nConnection: close\r\n", Response {}),
        "HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
    )
    assert_eq(
        answer_to_head("GET / HTTP/1.1\r\nHost: h\r\n", saying("Close")),
        "HTTP/1.1 200 OK\r\nConnection: Close\r\nContent-Length: 0\r\n\r\n",
    )
    assert_eq(
        answer_to_head("GET / HTTP/1.0\r\n", Response { .status = STATUS_NO_CONTENT }),
        "HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n",
    )
    unread :: response_wire(new_response(STATUS_BAD_REQUEST, "no"), null)
    assert(
        unread is string
            && unread == "HTTP/1.1 400 Bad Request\r\nContent-Length: 2\r\nConnection: close\r\n\r\nno",
        "a request that could not be read",
    )
}

@test
test_a_response_tells_an_http_1_0_client_its_connection_is_kept :: fn() -> void {
    assert_eq(
        answer_to_head(
            "GET / HTTP/1.0\r\nConnection: keep-alive\r\n",
            new_response(STATUS_OK, "hi"),
        ),
        "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: keep-alive\r\n\r\nhi",
    )
    assert_eq(
        answer_to_head("GET / HTTP/1.0\r\nConnection: keep-alive\r\n", saying("keep-alive")),
        "HTTP/1.1 200 OK\r\nConnection: keep-alive\r\nContent-Length: 0\r\n\r\n",
    )
}

@test
test_a_response_that_opens_a_tunnel_says_nothing_of_the_connection :: fn() -> void {
    wire :: response_wire(Response {}, asking(.Connect))
    assert(wire is string && wire == "HTTP/1.1 200 OK\r\n\r\n", "a tunnel")
}

@test
test_an_interim_response_says_nothing_of_the_connection :: fn() -> void {
    early :: Response { .status = Status(103) }
    early.headers.add("Link", "</style.css>; rel=preload")
    assert_eq(
        answer_to_head("GET / HTTP/1.1\r\nHost: h\r\nConnection: close\r\n", early),
        "HTTP/1.1 103 \r\nLink: </style.css>; rel=preload\r\n\r\n",
    )
    old :: Request { .method = .Get, .target = "/", .version = .Http10 }
    assert(
        response_wire(Response { .status = STATUS_CONTINUE }, old) == HttpErrorKind.Malformed,
        "an HTTP/1.0 client reads no interim response",
    )
    assert(
        response_wire(Response { .status = STATUS_CONTINUE }, null) == HttpErrorKind.Malformed,
        "nor one whose request could not be read",
    )
}

@test
test_drain_leaves_the_next_request_whole :: fn() -> void {
    text :: "POST /a HTTP/1.1\r\nHost: h\r\nContent-Length: 5\r\n\r\nhello"
        + "POST /b HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\nX: y\r\n\r\n"
        + "GET /c HTTP/1.1\r\nHost: h\r\n\r\n"
    for size in CUTS {
        reader :: cut(text, size)
        first :: request_of(reader)
        assert(drain(first.body), "a body with a length, cut by ${size}")
        assert(drain(first.body), "a body already at its end, cut by ${size}")
        second :: request_of(reader)
        assert_eq(second.target, "/b")
        assert(drain(second.body), "a body in chunks, cut by ${size}")
        assert_eq(request_of(reader).target, "/c")
    }
}

@test
test_drain_gives_up_on_a_body_too_long_or_broken :: fn() -> void {
    text :: "POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 10\r\n\r\n0123456789"
    assert(drain(request_of(whole(text)).body, Limits { .unread_body = 10 }), "ten bytes of ten")
    assert(!drain(request_of(whole(text)).body, Limits { .unread_body = 9 }), "ten bytes of nine")
    short :: "POST / HTTP/1.1\r\nHost: h\r\nContent-Length: 10\r\n\r\n01234"
    assert(!drain(request_of(whole(short)).body), "a body shorter than declared")
    broken :: "POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\n\r\nz\r\n"
    assert(!drain(request_of(whole(broken)).body), "a chunk with no size")
}

// A request whose client holds two bytes of content back.
EXPECTING :: "PUT /file HTTP/1.1\r\nHost: h\r\nContent-Length: 2\r\nExpect: 100-continue\r\n\r\nhi"

@test
test_a_client_that_waits_is_told_to_send_when_its_body_is_read :: fn() -> void {
    for size in CUTS {
        out :: BytesWriter {}
        request :: request_of(cut(EXPECTING, size))
        request.continue_on_read(out)
        assert_eq(out.written.len(), 0)
        assert_eq(text_of(request.body), "hi")
        assert_eq(out.written.bytes_to_string(), "HTTP/1.1 100 Continue\r\n\r\n")
        assert(write_response(out, Response {}, request) == null, "the response is written")
        assert_eq(
            out.written.bytes_to_string(),
            "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n",
        )
        assert(persists(request, Response {}), "the connection goes on, cut by ${size}")
    }
}

// What is written to a client by the time the body of the request `text` is
// read, when `continue_on_read` had charge of it.
written_on_read :: fn(text: string) -> string {
    out :: BytesWriter {}
    request :: request_of(whole(text))
    request.continue_on_read(out)
    text_of(request.body)
    return out.written.bytes_to_string()
}

@test
test_an_expectation_is_read_in_any_case_and_in_a_list :: fn() -> void {
    head :: "PUT / HTTP/1.1\r\nHost: h\r\nContent-Length: 2\r\n"
    assert_eq(
        written_on_read(head + "Expect: 100-Continue\r\n\r\nhi"),
        "HTTP/1.1 100 Continue\r\n\r\n",
    )
    assert_eq(
        written_on_read(head + "Expect: other=1, 100-continue\r\n\r\nhi"),
        "HTTP/1.1 100 Continue\r\n\r\n",
    )
    assert_eq(written_on_read(head + "Expect: 100-continued\r\n\r\nhi"), "")
    assert_eq(written_on_read(head + "\r\nhi"), "")
}

@test
test_a_request_that_holds_nothing_back_is_told_nothing :: fn() -> void {
    assert_eq(
        written_on_read("PUT / HTTP/1.0\r\nContent-Length: 2\r\nExpect: 100-continue\r\n\r\nhi"),
        "",
    )
    assert_eq(
        written_on_read(
            "PUT / HTTP/1.1\r\nHost: h\r\nContent-Length: 0\r\nExpect: 100-continue\r\n\r\n",
        ),
        "",
    )
    assert_eq(written_on_read("GET / HTTP/1.1\r\nHost: h\r\nExpect: 100-continue\r\n\r\n"), "")
    assert_eq(
        written_on_read(
            "PUT / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\nExpect: 100-continue\r\n\r\n"
                + "2\r\nhi\r\n0\r\n\r\n",
        ),
        "HTTP/1.1 100 Continue\r\n\r\n",
    )
}

@test
test_a_request_answered_before_its_body_was_read_ends_the_connection :: fn() -> void {
    out :: BytesWriter {}
    request :: request_of(whole(EXPECTING))
    request.continue_on_read(out)
    refused :: new_response(STATUS_FORBIDDEN, "no")
    assert(write_response(out, refused, request) == null, "the response is written")
    wire :: "HTTP/1.1 403 Forbidden\r\nContent-Length: 2\r\nConnection: close\r\n\r\nno"
    assert_eq(out.written.bytes_to_string(), wire)
    assert(!persists(request, refused), "content that may follow or not")
    buffer: u8[]: [0] * 8
    assert(request.body.read(buffer) is IOError, "the body is not read after the response")
    assert(!drain(request.body), "nor read past")
    assert_eq(out.written.bytes_to_string(), wire)
}

@test
test_a_body_copied_into_its_response_is_asked_for_before_the_response :: fn() -> void {
    out :: BytesWriter {}
    request :: request_of(whole(EXPECTING))
    request.continue_on_read(out)
    echo :: Response { .body = request.body }
    echo.headers.set("Content-Length", "2")
    assert(write_response(out, echo, request) == null, "the response is written")
    assert_eq(
        out.written.bytes_to_string(),
        "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi",
    )
    assert(persists(request, echo), "the content was read")
}

@test
test_a_100_written_by_hand_is_not_written_again :: fn() -> void {
    out :: BytesWriter {}
    request :: request_of(whole(EXPECTING))
    request.continue_on_read(out)
    written :: write_response(out, Response { .status = STATUS_CONTINUE }, request)
    assert(written == null, "the interim response is written")
    assert_eq(text_of(request.body), "hi")
    assert_eq(out.written.bytes_to_string(), "HTTP/1.1 100 Continue\r\n\r\n")
}

@test
test_a_request_is_answered_once :: fn() -> void {
    out :: BytesWriter {}
    request :: asking()
    assert(write_response(out, Response { .status = Status(103) }, request) == null, "interim")
    assert(write_response(out, Response {}, request) == null, "final")
    wire :: "HTTP/1.1 103 \r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n"
    assert_eq(out.written.bytes_to_string(), wire)
    late :: write_response(out, Response { .status = STATUS_CONTINUE }, request)
    assert(late is HttpError && late.kind == .Malformed, "an interim response after the final one")
    again :: write_response(out, Response {}, request)
    assert(again is HttpError && again.kind == .Malformed, "a second final response")
    assert_eq(out.written.bytes_to_string(), wire)
}

@test
test_a_client_that_is_gone_fails_the_read_of_the_body :: fn() -> void {
    request :: request_of(whole(EXPECTING))
    request.continue_on_read(FailingWriter { .sink = BytesWriter {}, .calls = 0 })
    buffer: u8[]: [0] * 8
    assert(request.body.read(buffer) is IOError, "the 100 could not be written")
}

@test
test_a_request_that_carries_nothing_expects_no_100 :: fn() -> void {
    empty :: request_for(.Put, "/file")
    empty.headers.set("Expect", "100-continue")
    assert(request_wire(empty) == HttpErrorKind.Malformed, "no body")
    declared :: request_for(.Put, "/file")
    declared.headers.set("Expect", "100-continue")
    declared.headers.set("Content-Length", "0")
    assert(request_wire(declared) == HttpErrorKind.Malformed, "a length of zero")
    full :: new_request(.Put, "/file", "hi")
    full.headers.set("Host", "example.org")
    full.headers.set("Expect", "100-continue")
    assert(request_wire(full) is string, "content to wait for")
}
