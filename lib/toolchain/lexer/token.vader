// toolchain/lexer/token: token shapes for the self-hosted lexer.
//
// One enum variant per kind so downstream passes get exhaustive `match`
// checking. `Position` and `Span` come from `toolchain/span`, so tokens, the
// syntax tree and diagnostics share the same canonical source-location types.

module "toolchain/lexer"

import "toolchain/span"

/// The data a token kind carries.
export TokenInfo :: struct {
    /// The source text of a keyword kind, empty for any other kind.
    keyword: string = ""
}

/// What a token is. A kind prints as its variant's name, which is how the token
/// dump shows it; a keyword kind also carries its source text.
@displayable
export TokenKind :: enum(TokenInfo) {
    // Layout
    Eof,
    Newline,

    // Identifiers and literals
    Ident,
    IntLit,
    FloatLit,
    CharLit,

    // String tokens. A literal yields:
    //   StringBegin ( StringPart | InterpolationOpen <expr...> InterpolationClose )* StringEnd
    StringBegin,
    StringPart,
    StringEnd,
    InterpolationOpen,
    InterpolationClose,

    // Keywords
    KwFn         { .keyword = "fn" },
    KwStruct     { .keyword = "struct" },
    KwTrait      { .keyword = "trait" },
    KwImplements { .keyword = "implements" },
    KwEnum       { .keyword = "enum" },
    KwDecorator  { .keyword = "decorator" },
    KwIf         { .keyword = "if" },
    KwElse       { .keyword = "else" },
    KwMatch      { .keyword = "match" },
    KwIs         { .keyword = "is" },
    KwFor        { .keyword = "for" },
    KwIn         { .keyword = "in" },
    KwReturn     { .keyword = "return" },
    KwYield      { .keyword = "yield" },
    KwDefer      { .keyword = "defer" },
    KwBreak      { .keyword = "break" },
    KwContinue   { .keyword = "continue" },
    KwImport     { .keyword = "import" },
    KwAs         { .keyword = "as" },
    KwExport     { .keyword = "export" },
    KwTrue       { .keyword = "true" },
    KwFalse      { .keyword = "false" },
    KwNull       { .keyword = "null" },
    KwSelf       { .keyword = "self" },
    KwConst      { .keyword = "const" },

    // Operators
    Plus, Minus, Star, Slash, Percent,
    PlusPercent,   // +%  (wrapping)
    MinusPercent,  // -%  (wrapping)
    StarPercent,   // *%  (wrapping)
    Amp, Pipe, Caret, Tilde, Shl, Shr,
    Eq, Neq, Lt, Lte, Gt, Gte,
    Same,          // ===
    NotSame,       // !==
    AndAnd, OrOr, Bang,
    Assign,        // =
    PlusAssign,    // +=
    MinusAssign,   // -=
    StarAssign,    // *=
    SlashAssign,   // /=
    PercentAssign, // %=
    PlusPercentAssign,  // +%=
    MinusPercentAssign, // -%=
    StarPercentAssign,  // *%=
    DeclConst,     // ::
    DeclVar,       // :=
    RangeExcl,     // ..<
    RangeIncl,     // ..=
    DotDotDot,     // ...   (struct spread)
    Arrow,         // ->
    FatArrow,      // =>
    At,            // @

    // Punctuation
    LParen, RParen,
    LBracket, RBracket,
    LBrace, RBrace,
    Comma, Dot, Colon,

}

/// Whether `k` is a keyword kind, one whose source text is `k.keyword`.
///
/// @param k  the kind to test.
export is_keyword :: fn(k: TokenKind) -> bool = k.keyword != ""

// `value` carries the parsed payload: the integer for `IntLit`, the float for
// `FloatLit`, the codepoint for `CharLit`, the decoded text for `StringPart`,
// and `null` for everything else (keywords, ops, punctuation).
export Token :: struct {
    kind: TokenKind
    text: string
    span: Span
    value: i64 | u64 | f64 | u32 | string | null
}

/// Whether `tokens[at]` opens a `module "..."` line. `module` is a soft keyword:
/// an identifier everywhere else, a field name or a field access target.
///
/// @param tokens  the tokens of a source, or of its opening.
/// @param at      where the line would open.
export opens_module_line :: fn(tokens: Token[], at: i64) -> bool {
    if at < 0 || at + 1 >= tokens.len() || tokens[at + 1].kind != .StringBegin {
        return false
    }
    return tokens[at].kind == .Ident && tokens[at].text == "module"
}

export empty_file_span :: fn(file: string) -> Span {
    p :: Position { .file = file, .offset = 0, .line = 1, .column = 1 }
    return Span { .start = p, .end = p }
}

export make_token :: fn(kind: TokenKind, text: string, span: Span) -> Token = Token {
    .kind = kind,
    .text = text,
    .span = span,
    .value = null,
}
