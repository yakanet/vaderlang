// toolchain/lexer/keywords: the keyword table.
//
// Folded at compile time from the data of `TokenKind`, the one place a
// keyword's text is written. `lookup_keyword` returns the dedicated `TokenKind`
// for a keyword text, or `Ident` to mean "not a keyword: keep it as an
// identifier".

module "toolchain/lexer"

/// The token kind of the keyword `text` spells.
///
/// @param text  an identifier as the lexer read it.
/// @return      the keyword's own kind, `Ident` when `text` is no keyword.
export lookup_keyword :: fn(text: string) -> TokenKind {
    for k in KEYWORD_KINDS {
        if k.keyword == text {
            return k
        }
    }
    return .Ident
}

/// Every keyword's source text, in declaration order: the list tooling consults
/// for the keyword set (LSP completion, ...). Excludes the `module` soft
/// keyword, which no `TokenKind` spells (it is contextual).
export KEYWORDS: string[]: @comptime {
    out: string[]: []
    for k in KEYWORD_KINDS {
        out.push(k.keyword)
    }
    return out
}

// The keyword kinds, in declaration order.
KEYWORD_KINDS :: @comptime {
    out: TokenKind[]: []
    for k in TokenKind {
        if is_keyword(k) {
            out.push(k)
        }
    }
    return out
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_lookup_keyword_finds_every_keyword_kind :: fn() -> void {
    for k in TokenKind {
        if is_keyword(k) {
            assert_eq(lookup_keyword(k.keyword), k)
        }
    }
}

@test
test_lookup_keyword_leaves_the_module_soft_keyword_an_identifier :: fn() -> void {
    assert_eq(lookup_keyword("module"), .Ident)
}

@test
test_keywords_lists_the_keyword_texts_in_declaration_order :: fn() -> void {
    assert_eq(KEYWORDS[0], "fn")
    assert_eq(KEYWORDS.last() else "", "const")
}
