// toolchain/lexer/keywords: the keyword table.
//
// `lookup_keyword` returns the dedicated `TokenKind` for a keyword text, or
// `Ident` to mean "not a keyword: keep it as an identifier".

module "toolchain/lexer"

/// The token kind of the keyword `text` spells.
///
/// @param text  an identifier as the lexer read it.
/// @return      the keyword's own kind, `Ident` when `text` is no keyword.
export lookup_keyword :: fn(text: string) -> TokenKind = match text {
    "fn"         -> .KwFn
    "struct"     -> .KwStruct
    "trait"      -> .KwTrait
    "implements" -> .KwImplements
    "enum"       -> .KwEnum
    "if"         -> .KwIf
    "else"       -> .KwElse
    "match"      -> .KwMatch
    "is"         -> .KwIs
    "for"        -> .KwFor
    "in"         -> .KwIn
    "return"     -> .KwReturn
    "yield"      -> .KwYield
    "defer"      -> .KwDefer
    "break"      -> .KwBreak
    "continue"   -> .KwContinue
    "import"     -> .KwImport
    "as"         -> .KwAs
    "export"     -> .KwExport
    "true"       -> .KwTrue
    "false"      -> .KwFalse
    "null"       -> .KwNull
    "self"       -> .KwSelf
    "const"      -> .KwConst
    _            -> .Ident
}

/// Every keyword's source text: the single list tooling consults for the
/// keyword set (LSP completion, ...). Kept in lock-step with `lookup_keyword` by
/// `test_keywords_match_lookup`. Excludes the `module` soft keyword, which
/// `lookup_keyword` deliberately does not recognise (it is contextual).
export KEYWORDS :: [
    "fn", "struct", "trait", "implements", "enum", "if", "else", "match", "is",
    "for", "in", "return", "yield", "defer", "break", "continue", "import", "as",
    "export", "true", "false", "null", "self", "const",
]

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_keywords_match_lookup :: fn() -> void {
    // Every KEYWORDS entry must be a real keyword: pins the tooling list to
    // the lexer authority so a bogus or renamed entry breaks here.
    for kw in KEYWORDS {
        assert(lookup_keyword(kw) != .Ident, "KEYWORDS entry is not a keyword: ${kw}")
    }
}

