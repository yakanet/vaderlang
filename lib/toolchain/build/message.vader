// toolchain/build/message: the pipeline events a build driver observes.
//
// A project's `build.vader` pulls these from `BuildContext.messages()`
// (`context.vader`) and reacts to them. `Message` is a closed union, so a
// `match` over it is exhaustive and adding an event forces every existing
// driver to acknowledge it rather than silently ignore it.
//
// Phase names track Vader's own pipeline stages (the ones `vader dump
// --stage=...` prints) rather than another toolchain's vocabulary.

module "toolchain/build"

AST :: import "toolchain/ast"
Protocol :: import "toolchain/protocol"

// ---- events ---------------------------------------------------------------

/// One event the compiler hands a build driver.
export Message :: TypecheckedMessage | PhaseMessage | CompleteMessage

/// Top-level declarations of one module of the project, after typecheck. The
/// modules of the toolchain's library are not the project's: none arrives.
///
/// They are what crosses from `vader` to the driver (`toolchain/protocol`): every
/// declaration the source writes, with what it writes outside the body of a
/// function (values, defaults, the data of a variant). The body of a function
/// (a trait member's default included) and the decorators do not cross, and the
/// nodes hold none; a doc comment is asked for (`doc_of`). A span taken from one
/// anchors a diagnostic in the user's source.
///
/// Each declaration is delivered exactly ONCE per entry. A module the
/// driver generated into is therefore delivered a second time carrying only the
/// generated declarations, never the ones already seen, so a rule applied here
/// fires once however many generation rounds that entry takes.
export TypecheckedMessage :: struct {
    /// The module's declared name, as an `import` spells it and `emit_module`
    /// takes it: `"app"`, `"app/model"`.
    module_name:  string
    declarations: AST.Decl[]
}

/// The pipeline crossed a stage boundary.
export PhaseMessage :: struct {
    phase: Phase
}

/// The build finished; no further message follows.
///
/// Carries the exit code, since a stream has no return value: a driver that
/// drains to the end reads its build's outcome here.
export CompleteMessage :: struct {
    code: i32
}

// ---- phases ---------------------------------------------------------------

/// Where the pipeline is, ordered as the stages run: the `Phase` of
/// `toolchain/protocol`, which `vader` sends.
export Phase :: Protocol.Phase

/// Render a phase as the name a driver would print in a log line.
export display_phase :: fn(p: Phase) -> string = match p {
    .Typechecked   -> "typechecked"
    .Evaluated     -> "evaluated"
    .BeforeEmit    -> "before-emit"
    .Lowered       -> "lowered"
    .OutputWritten -> "output-written"
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_display_phase_typechecked :: fn() -> void {
    assert_eq(display_phase(.Typechecked), "typechecked")
}

@test test_display_phase_before_emit :: fn() -> void {
    // The phase a driver leaves the loop on to decline building.
    assert_eq(display_phase(.BeforeEmit), "before-emit")
}

@test test_complete_carries_the_exit_code :: fn() -> void {
    m: Message: CompleteMessage { .code = 1 }
    assert(m is CompleteMessage, "completion narrows")
    if m is CompleteMessage {
        assert_eq(m.code, 1)
    }
}
