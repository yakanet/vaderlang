// toolchain/build/generate — code a driver writes, materialised as ordinary modules.
//
// A driver hands the compiler TEXT (`emit_module`), never AST. The text lands in
// a real file under `ctx.generated_root`, which is added to the module search
// roots, so a generated module is loaded, typechecked and reported on exactly
// like a hand-written one: real spans, readable in an editor, formattable. This
// is what dissolved the re-entrant typechecker the sibling `@quote` plan
// assumed — the front end simply runs again over a larger file set.
//
// Three properties the file naming carries, and they are the reason it is a
// content hash rather than a counter:
//
//   * `<leaf>_<hash>.vader` — the same text always lands at the same path, so a
//     driver re-emitting it across rounds is a no-op with no bookkeeping. A
//     counter would need a side table of contents to get this right.
//   * A module is a FOLDER, so several emissions to one module name simply
//     become several files in it. Aggregation is legal, and a real symbol clash
//     surfaces as T3053 ("defined more than once with the same signature") like
//     any hand-written module — no diagnostic of our own.
//   * Emission ORDER stops mattering: two drivers emitting A then B, or B then
//     A, produce the same tree.
//
// The price is that a CHANGED module leaves its old hash behind, in the same
// folder, where it still compiles — so the stale sweep is not optional.
// `sweep_generated` runs once before the first round and deletes only files
// carrying the banner, which is what makes it safe against a `generated_root`
// pointed at real sources.
//
// See `.claude/plans/2026-08-26-metacompilation-hook.md` §18.

module "toolchain/build"

import "std/io"
import "std/numbers"
import "std/path"
import "std/string"
import "std/string_builder"
import "vader/diagnostics"
Parse :: import "vader/parser"

// ---- the contract ---------------------------------------------------------

/// One module a driver asked the compiler to generate.
export GeneratedModule :: struct {
    /// Module name, spelled as the `import` that will reach it — `"gen/serde"`.
    name:   string
    /// Imports and declarations. The `module` header is NOT part of this;
    /// `emit_module` writes it, so the name and the file's location cannot
    /// disagree.
    source: string
}

/// First line of every generated file — and the sweep's whole safety argument.
///
/// `sweep_generated` deletes a `.vader` file only when it starts with this, so a
/// `generated_root` mistakenly pointed at hand-written sources destroys nothing.
export GENERATED_BANNER :: "// Generated by `vader build` — do not edit."

/// Rounds of generation allowed before the build gives up.
///
/// A round is one full front end, so this is a real cost, not a formality: a
/// driver that keeps emitting new text every round is looping, and the alternative
/// to a cap is a build that never ends and says nothing. Eight is far above any
/// legitimate depth — transitive derivation settles in two or three.
export MAX_GENERATION_ROUNDS :: 8

/// Queue a module for the compiler to generate.
///
/// The driver writes text; the compiler owns the file. Call it as many times as
/// you like on the same `name` — a module is a folder, so the emissions stack
/// into it, and re-emitting identical text is a no-op. What you must NOT do is
/// emit two different declarations of one symbol — that is T3053, reported
/// against the generated files like any other duplicate.
///
/// Nothing is written until the round ends: the driver observes, emits, and the
/// compiler flushes once the stream reaches `BeforeEmit`. The next round's front
/// end then sees the new modules, and their declarations come back through
/// `messages()` — which is what makes transitive generation work without a
/// mechanism of its own.
///
/// @param ctx     the context accumulating the emissions.
/// @param name    module name, as the `import` reaching it will spell it. Must be
///                a relative `/`-separated path — see `generated_name_problem`.
/// @param source  imports and declarations, WITHOUT a `module` header.
/// @error         H6007 when `name` is not a usable module path. The emission is
///                dropped; the build carries on and reports.
export emit_module :: fn(ctx: BuildContext!, name: string, source: string) -> void {
    problem :: generated_name_problem(name)
    if problem != "" {
        ctx.diagnostics.push(hook_error(.InvalidGeneratedModuleName, driver_span(ctx), problem))
        return
    }
    ctx.pending.push(GeneratedModule { .name = name, .source = source })
}

/// Files written for the generated modules so far, in the order they landed.
///
/// The set is authoritative for the build that produced it: the sweep runs
/// first, so every path listed here was written by this run.
///
/// @return the generated files' paths, relative or absolute as `project_root` is.
export generated_files_of :: fn(ctx: BuildContext) -> string[] = ctx.generated

// ---- names ----------------------------------------------------------------

// Why `name` cannot be used as a module path, or "" when it can.
//
// The grammar belongs to the parser — `Parse.is_valid_module_name` backs P1028 on a
// `module` declaration — so this defers to it rather than restating it. Restating
// it was a real gap, not only duplication: a laxer check here let
// `emit_module("Gen/Serde", …)` write a file the parser then rejected with P1028,
// which is a diagnostic against machine-written code.
//
// It doubles as the gate between driver-built names and `write_file_string`: a
// driver composes these from user data (a struct name, a module name it read),
// and `../../src/main` would otherwise overwrite the project's own source. The
// parser's grammar admits only `[a-z][a-z0-9_]*` segments joined by `/`, so
// traversal, absolute paths, `\` and `:` are all excluded by it.
generated_name_problem :: fn(name: string) -> string {
    if name == "" {
        return "the module name is empty"
    }
    if !Parse.is_valid_module_name(name) {
        return "`${name}` is not a module path — lowercase `[a-z][a-z0-9_]*` segments joined by `/`"
    }
    return ""
}

/// File name for a generated module: `<leaf>_<content hash>.vader`.
///
/// Content-addressed on purpose — see this file's header. The hash is over the
/// FINAL file text, banner and header included, so "same file, same path" holds
/// without qualification.
///
/// @param name     the module name, supplying the readable half — its last
///                 segment, so a diagnostic in generated code names its module
///                 without the reader decoding a hash.
/// @param content  the rendered file, supplying the hash.
export generated_file_name :: fn(name: string, content: string) -> string =
    "${name.to_path().filename()}_${content.hash().to_hex()}.vader"

// ---- rendering ------------------------------------------------------------

/// Render a generated module's file: banner, `module` header, then the driver's
/// text.
///
/// The compiler writes the header rather than trusting the driver's, so the
/// declared module and the folder it lives in cannot drift apart — a mismatch
/// would surface as R2020 against machine-written code.
///
/// @param name    module name to declare.
/// @param source  the driver's imports and declarations.
/// @return        the complete file text, newline-terminated.
export render_generated_module :: fn(name: string, source: string) -> string {
    out :: StringBuilder {}
    out.append("${GENERATED_BANNER}\n")
    out.append("//\n")
    out.append("// Emitted by this project's `build.vader` through `ctx.emit_module`.\n")
    out.append("// Rewritten on every driven build ; edits here are lost.\n")
    out.append("\n")
    out.append("module \"${name}\"\n")
    out.append("\n")
    out.append(source)
    if !source.ends_with("\n") {
        out.append("\n")
    }
    return out.to_string()
}

// ---- materialising --------------------------------------------------------

/// Root the generated tree lives under, as a path.
///
/// @param ctx  the configured context.
export generated_root_of :: fn(ctx: BuildContext) -> string =
    join_path(ctx.project_root, ctx.generated_root)

/// Write every queued emission, and report which modules gained a file.
///
/// The return value is the round loop's fixed-point test: an empty list means
/// this round changed nothing on disk, so running the front end again would see
/// exactly the same files. A path that already exists is skipped — it holds the
/// same content by construction, the name being its hash.
///
/// @param ctx  the context holding the queue ; it is emptied.
/// @return     the module names that gained a file this round, without
///             duplicates. Empty when nothing changed.
/// @error      H6008 when the directory or the file cannot be written. The
///             module is skipped rather than the build aborted, so one
///             unwritable path reports once instead of cascading.
export flush_generated :: fn(ctx: BuildContext!) -> string[] {
    fresh: string[]! = []
    if ctx.pending.len() == 0 {
        return fresh
    }
    root :: generated_root_of(ctx)
    for g in ctx.pending {
        content :: render_generated_module(g.name, g.source)
        dir     :: join_path(root, g.name)
        path    :: join_path(dir, generated_file_name(g.name, content))
        // Already there — same name means same content, so there is nothing to
        // write and nothing changed. This is what makes a driver that re-emits
        // unconditionally settle after one extra round.
        if exists(path) {
            continue
        }
        made :: create_dir(dir)
        if made is IOError as de {
            ctx.diagnostics.push(hook_error(.GeneratedModuleNotWritten, driver_span(ctx),
                "`${dir}` for module `${g.name}`: ${de.msg}"))
            continue
        }
        written :: write_file_string(path, content)
        if written is IOError as we {
            ctx.diagnostics.push(hook_error(.GeneratedModuleNotWritten, driver_span(ctx),
                "`${path}`: ${we.msg}"))
            continue
        }
        ctx.generated.push(path)
        if !(g.name in fresh) {
            fresh.push(g.name)
        }
    }
    ctx.pending.clear()
    return fresh
}

/// Delete the generated files of an earlier build, before this one starts.
///
/// Mandatory rather than tidy: file names are content hashes, so a module whose
/// text CHANGED leaves its previous file in place — in the same folder, where it
/// still compiles, and its declarations collide with the new ones. Sweeping
/// first is also what keeps a renamed or withdrawn module from resolving forever
/// on the machine that generated it while failing on a fresh clone.
///
/// Only files starting with `GENERATED_BANNER` are removed. That is the whole
/// safety argument for a recursive delete driven by a driver-supplied path: a
/// `generated_root` aimed at real sources destroys nothing. Directories are left
/// behind — the stdlib has no `remove_dir`, and an empty folder declares no
/// module, so nothing resolves through it.
///
/// @param dir  the generated root ; a path that does not exist is not an error.
/// @return     how many files were removed.
export sweep_generated :: fn(dir: string) -> usize {
    if !is_dir(dir) {
        return 0
    }
    // `match` arms are expressions here, so an early exit takes the narrowing
    // `if` form rather than an arm — see CLAUDE.md §6 "Null checks".
    listing :: read_dir(dir)
    if listing is IOError {
        return 0
    }
    removed: usize = 0
    for entry in listing {
        path :: join_path(dir, entry)
        if is_dir(path) {
            removed += sweep_generated(path)
            continue
        }
        if !path.ends_with(".vader") {
            continue
        }
        content :: read_file_string(path)
        if content is IOError {
            continue
        }
        if !content.starts_with(GENERATED_BANNER) {
            continue
        }
        dropped :: remove_file(path)
        if dropped is IOError {
            continue
        }
        removed += 1
    }
    return removed
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// Why a flush produced nothing — the four causes, spelled out for a CI log.
//
// `flush_generated` returning 0 has exactly four explanations: nothing was queued,
// the target already existed, `create_dir` failed, or the write failed. The last
// two leave an H6008 report that an `assert_eq` on the count alone throws away.
// Three of these tests were red on Windows for weeks of CI runs saying only
// "expected 1, got 0"; this is what makes the next failure diagnosable.
flush_diagnosis :: fn(ctx: BuildContext, fresh: string[]) -> string {
    out :: StringBuilder {}
    out.append("fresh=${fresh.len()}")
    out.append(" root=${generated_root_of(ctx)}")
    out.append(" root_is_dir=${is_dir(generated_root_of(ctx))}")
    out.append(" pending=${ctx.pending.len()}")
    out.append(" written=${ctx.generated.len()}")
    for f in ctx.generated {
        out.append(" [${f} exists=${exists(f)}]")
    }
    for d in ctx.reports_of() {
        out.append(" {${d.code.id}: ${d.detail}}")
    }
    return out.to_string()
}

@test test_render_declares_the_module :: fn() -> void {
    src :: render_generated_module("gen/serde", "to_json :: fn() -> string = \"{}\"\n")
    assert("module \"gen/serde\"" in src, "the compiler writes the header")
}

@test test_render_starts_with_the_banner :: fn() -> void {
    // The sweep matches on this exact prefix, so it has to be the first byte.
    src :: render_generated_module("gen/serde", "x :: 1\n")
    assert(src.starts_with(GENERATED_BANNER), "banner leads the file")
}

@test test_render_terminates_the_last_line :: fn() -> void {
    src :: render_generated_module("gen/serde", "x :: 1")
    assert(src.ends_with("\n"), "a driver's text need not end in a newline")
}

@test test_file_name_carries_the_module_leaf :: fn() -> void {
    // Readable half: a diagnostic in generated code names its module without the
    // reader decoding a hash.
    name :: generated_file_name("gen/serde", "whatever")
    assert(name.starts_with("serde_"), "the leaf leads the file name")
    assert(name.ends_with(".vader"), "it is a Vader source file")
}

@test test_same_content_same_file_name :: fn() -> void {
    // The property the whole round loop rests on: re-emitting identical text
    // writes to the same path, so it is a no-op.
    a :: generated_file_name("gen/serde", "same")
    b :: generated_file_name("gen/serde", "same")
    assert_eq(a, b)
}

@test test_different_content_different_file_name :: fn() -> void {
    a :: generated_file_name("gen/serde", "one")
    b :: generated_file_name("gen/serde", "two")
    assert(a != b, "two contents cannot share a file")
}

@test test_emit_rejects_a_traversing_name :: fn() -> void {
    // The gate between driver-built names and `write_file_string`.
    ctx :: new_build_context(["driver", "/tmp/proj"])
    ctx.emit_module("../../src/main", "x :: 1")
    assert_eq(ctx.reports_of().len(), 1)
    assert_eq(ctx.reports_of()[0].code.id, "H6007")
    assert_eq(ctx.pending.len(), 0)
}

@test test_emit_rejects_an_empty_name :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    ctx.emit_module("", "x :: 1")
    assert_eq(ctx.reports_of()[0].code.id, "H6007")
}

@test test_emit_rejects_an_uppercase_name :: fn() -> void {
    // The gap a hand-rolled check left: this used to pass, get written, and then
    // fail P1028 against the machine-written file.
    ctx :: new_build_context(["driver", "/tmp/proj"])
    ctx.emit_module("Gen/Serde", "x :: 1")
    assert_eq(ctx.reports_of().len(), 1)
    assert_eq(ctx.reports_of()[0].code.id, "H6007")
    assert_eq(ctx.pending.len(), 0)
}

@test test_emit_rejects_a_windows_separator :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    ctx.emit_module("gen\\serde", "x :: 1")
    assert_eq(ctx.reports_of()[0].code.id, "H6007")
}

@test test_emit_accepts_a_nested_name :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    ctx.emit_module("gen/serde", "x :: 1")
    assert_eq(ctx.reports_of().len(), 0)
    assert_eq(ctx.pending.len(), 1)
}

@test test_emissions_stack_on_one_name :: fn() -> void {
    // A module is a folder: two emissions are two files, not a conflict.
    ctx :: new_build_context(["driver", "/tmp/proj"])
    ctx.emit_module("gen/serde", "a :: 1")
    ctx.emit_module("gen/serde", "b :: 2")
    assert_eq(ctx.pending.len(), 2)
    assert_eq(ctx.reports_of().len(), 0)
}

@test test_flush_writes_and_reports_the_module :: fn() -> void {
    root :: join_path(temp_dir(), "vader_gen_probe_flush")
    ctx :: new_build_context(["driver", root])
    _ :: sweep_generated(generated_root_of(ctx))
    ctx.emit_module("gen/probe", "probe :: fn() -> i32 = 7\n")
    fresh :: ctx.flush_generated()
    assert(fresh.len() == 1, "one module should have been written — ${flush_diagnosis(ctx, fresh)}")
    assert_eq(fresh[0], "gen/probe")
    files :: ctx.generated_files_of()
    assert_eq(files.len(), 1)
    assert(exists(files[0]), "the module landed on disk")
    _ :: sweep_generated(generated_root_of(ctx))
}

@test test_flush_is_idempotent :: fn() -> void {
    // The fixed point: emitting the same text again changes nothing, so the
    // round loop stops.
    root :: join_path(temp_dir(), "vader_gen_probe_idem")
    ctx :: new_build_context(["driver", root])
    _ :: sweep_generated(generated_root_of(ctx))
    ctx.emit_module("gen/probe", "probe :: fn() -> i32 = 7\n")
    first :: ctx.flush_generated()
    assert(first.len() == 1, "the first flush should write — ${flush_diagnosis(ctx, first)}")
    ctx.emit_module("gen/probe", "probe :: fn() -> i32 = 7\n")
    again :: ctx.flush_generated()
    assert_eq(again.len(), 0)
    _ :: sweep_generated(generated_root_of(ctx))
}

@test test_flush_of_nothing_changes_nothing :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    assert_eq(ctx.flush_generated().len(), 0)
}

@test test_sweep_removes_only_generated_files :: fn() -> void {
    // The safety argument for a recursive delete: a hand-written file in the
    // way is left alone.
    root :: join_path(temp_dir(), "vader_gen_probe_sweep")
    _ :: create_dir(root)
    _ :: sweep_generated(root)
    mine :: join_path(root, "handwritten.vader")
    _ :: write_file_string(mine, "module \"mine\"\n")
    ctx :: new_build_context(["driver", temp_dir()])
    ctx.generated_root = "vader_gen_probe_sweep"
    ctx.emit_module("gen/probe", "probe :: fn() -> i32 = 7\n")
    flushed :: ctx.flush_generated()
    removed :: sweep_generated(root)
    assert(removed == 1,
        "the sweep should remove the one generated file — removed=${removed} ${flush_diagnosis(ctx, flushed)}")
    assert(exists(mine), "a file without the banner is not ours to delete")
    _ :: remove_file(mine)
}

@test test_flush_reports_a_path_it_cannot_write :: fn() -> void {
    // `create_dir` cannot make a directory under a FILE. The build has to say so
    // rather than settle having generated nothing.
    blocker :: join_path(temp_dir(), "vader_gen_probe_blocker")
    _ :: write_file_string(blocker, "not a directory\n")
    ctx :: new_build_context(["driver", temp_dir()])
    ctx.generated_root = "vader_gen_probe_blocker/inside"
    ctx.emit_module("gen/probe", "x :: 1")
    assert_eq(ctx.flush_generated().len(), 0)
    assert_eq(ctx.reports_of().len(), 1)
    assert_eq(ctx.reports_of()[0].code.id, "H6008")
    _ :: remove_file(blocker)
}

@test test_sweep_of_a_missing_root_is_not_an_error :: fn() -> void {
    assert_eq(sweep_generated("/nonexistent-generated-root"), 0)
}
