// toolchain/build/drive: draining the stream IS the build.
//
// `messages()` hands a driver what each stage of its build produced. `vader`
// runs the build (ADR 0145) and serves it over the link (`link.vader`): this
// side relays its events to the plugins and the driver's loop, and hands the
// build what they did in between, the reports and the modules they emitted,
// before the next event.
//
// `emit_native` is a shortcut that drains this, not a second implementation,
// so a driver that observes sees exactly the build a driver that does not
// observe gets. The plugins a driver plugs (`plugin.vader`) hear each
// message before its loop does.

module "toolchain/build"

import "std/console"
import "std/iter"
import "toolchain/diagnostics"
import "toolchain/protocol"

// ---- driving the compilation ----------------------------------------------

/// Drive the compilation and yield what the pipeline produces.
///
/// Nothing compiles until the first message is pulled, so a driver configures
/// the context first and iterates second; the configuration is read then, once.
/// Each entry is run through the front end (`load -> resolve + typecheck ->
/// comptime`), yielding one `TypecheckedMessage` per module of the project, then
/// a `PhaseMessage`, and finally one `CompleteMessage` for the whole run. The
/// modules of the toolchain's library are not the project's: none is yielded.
///
/// Every declaration is delivered exactly ONCE per entry, however many
/// generation rounds that entry takes, see `TypecheckedMessage`. A module with
/// nothing new is not yielded at all. The "once" is per ENTRY, not per build: two
/// entries sharing a module both report it.
///
/// A driver that generates code makes the stream LOOP: the phases from
/// `Typechecked` to `BeforeEmit` repeat once per generation round, and the back
/// end runs only after the last one. Declarations are still delivered once each
/// (see `emit_module`), so an observing driver cannot tell the difference.
///
/// What the command asked shapes the stream: `--entry` narrows the entries to
/// one; a check lowers after the last generation round and links nothing; the
/// preparation of a run writes the project for the CLI and stops after the last
/// generation round. A build writes each binary to `build/<profile>-<target>/<name>`,
/// or to `--out` for its one entry, copies the assets beside them, and stops at
/// the first entry that fails. Every mode writes the generated modules.
///
/// The plugins `use` received hear each message first, in that order (see
/// `BuildPlugin`). The end of the stream prints the diagnostics not printed yet,
/// the driver's reports among them, and an error among them makes the build's
/// code 1 even when every entry built.
///
/// @param ctx  the configured context. Without an entry, or when it already
///             holds an error, the stream yields only a failed
///             `CompleteMessage`.
/// @return     a lazy stream of messages, in pipeline order.
/// @error      H6003 when the driver added no entry ; H6009 when `--entry`
///             names none of them ; H6011 when `--out` names one output for
///             several entries ; H6006 when generation never settles ; H6007
///             for a generated module name that is no module path ; H6008
///             when a generated module cannot be written ; H6013 when a plugin
///             pulls it. The build prints them at its end.
export messages :: fn(ctx: BuildContext) -> Iterator<Message> {
    // A build started by a plugin would run inside the one telling it, and
    // deliver and emit everything a second time.
    if plugin_dispatch().running {
        detail :: "`messages()` and `emit_native` start a build, refused in a plugin"
        ctx.diagnostics.push(hook_error(.BuildInsidePlugin, driver_span(ctx), detail))
        yield CompleteMessage { .code = 1 }
        return
    }
    plugins :: plugins_told(ctx)
    link :: open_link(ctx)
    // One `yield` for the whole stream: a driver's loop body is copied at each.
    for {
        msg :: next_message(ctx, link, plugins)
        yield msg
        if msg is CompleteMessage {
            return
        }
        // What the plugins and the driver did meanwhile reaches the build before
        // it resumes: a module emitted at `BeforeEmit` is written next.
        ctx.hand_over(link, NextFrame {})
    }
}

// The plugins `messages` tells, read once as the rest of the configuration is. A
// description builds nothing, so it tells none.
plugins_told :: fn(ctx: BuildContext) -> BuildPlugin[] {
    if ctx.mode() == .Describe {
        return []
    }
    return ctx.plugins.clone()
}

// Configure a build, once the one still open is stopped: `vader` serves one at
// a time. What the driver did so far goes with it: a module asked for before
// the stream is read by its first round.
open_link :: fn(ctx: BuildContext) -> ServerLink {
    process :: driver_process()
    for open in process.contexts {
        stop_build(open)
    }
    configure :: ConfigureFrame {
        .fingerprint = process.fingerprint,
        .entries = ctx.entries,
        .include_paths = ctx.include_paths,
        .assets = ctx.assets,
        .target = ctx.target,
        .cc = ctx.cc,
        .ldflags = ctx.ldflags,
    }
    link :: ctx.server
    ctx.link = link
    link.send(configure)
    ctx.hand_over(link, NextFrame {})
    return link
}

// Hand the build `ctx` opened what the driver did since, and stop it.
stop_build :: fn(ctx: BuildContext) -> void {
    link :: ctx.link else return
    ctx.hand_over(link, StopFrame {})
    ctx.link = null
}

// Send the build what the driver did since it last sent, its reports and the
// modules it emitted, then `closing`: on with the stream, or stop the build.
hand_over :: fn(ctx: BuildContext, link: ServerLink, closing: NextFrame | StopFrame) -> void {
    for i in ctx.printed..<ctx.diagnostics.len() {
        d :: ctx.diagnostics[i]
        link.send(ReportFrame { .code = d.code.id, .span = d.primary, .detail = d.detail })
    }
    ctx.printed = ctx.diagnostics.len()
    for m in ctx.pending {
        link.send(m)
    }
    ctx.pending.clear()
    link.send(closing)
}

// The next message of the stream, once the plugins heard it, the end as
// `finished` settles it. A link `vader` closed ends the stream on a failure.
next_message :: fn(ctx: BuildContext, link: ServerLink, plugins: BuildPlugin[]) -> Message {
    if ctx.lost {
        return finished(ctx, link, plugins, CompleteFrame { .code = 1 })
    }
    frame :: link.receive() else return lost_build(ctx, link, plugins, frame.msg)
    match frame {
        is CompleteFrame                 -> {
            return finished(ctx, link, plugins, frame)
        }
        is DocAnswerFrame                -> {
            return lost_build(ctx, link, plugins, "it was sent an answer for an event")
        }
        is TypecheckedFrame | PhaseFrame -> {
            msg :: message_of(frame)
            tell_plugins(ctx, plugins, msg)
            return msg
        }
    }
}

// The end of a build the driver lost: a failure.
lost_build :: fn(
    ctx: BuildContext,
    link: ServerLink,
    plugins: BuildPlugin[],
    why: string,
) -> Message {
    ctx.lose_build(why)
    return finished(ctx, link, plugins, CompleteFrame { .code = 1 })
}

// Say why the driver lost its build, once however many times it learns it.
lose_build :: fn(ctx: BuildContext, why: string) -> void {
    if !ctx.lost {
        eprintln("vader: the build driver lost its build: ${why}")
    }
    ctx.lost = true
}

message_of :: fn(frame: TypecheckedFrame | PhaseFrame) -> Message {
    if frame is PhaseFrame {
        return PhaseMessage { .phase = frame.phase }
    }
    return TypecheckedMessage {
        .module_name = frame.module_name,
        .declarations = frame.declarations,
    }
}

// The message that ends the stream. The plugins hear the outcome, then the build
// takes what they did on hearing it and prints what it holds. A reported error
// fails the build whatever the pipeline answered.
finished :: fn(
    ctx: BuildContext,
    link: ServerLink,
    plugins: BuildPlugin[],
    frame: CompleteFrame,
) -> CompleteMessage {
    ctx.generated = frame.generated
    tell_plugins(ctx, plugins, CompleteMessage { .code = frame.code })
    ctx.hand_over(link, NextFrame {})
    return CompleteMessage { .code = outcome(ctx, frame.code) }
}

// `code`, or 1 once the context holds an error.
outcome :: fn(ctx: BuildContext, code: i32) -> i32 {
    if ctx.lost || any_error_diag(ctx.diagnostics) {
        return 1
    }
    return code
}

/// Run a driver's `build`, then stop the builds it left open, and give the
/// driver's exit code.
///
/// The entry `vader build` writes beside `build.vader` calls it; a driver does
/// not. Stopping a build hands it the reports and modules the driver made since
/// the build last took them, which it prints and fails on: when the driver left
/// `messages()` before its end, or reported once the build was over. A context
/// that opened no build prints its reports itself.
///
/// @param fingerprint  the fingerprint of the `lib/toolchain` the driver is
///                     compiled from, which its builds send `vader`.
/// @param build        the driver's `build`.
/// @param args         the driver's argv, as `vader` passes it.
/// @return             what `build` returned, or 1 when a context that opened
///                     no build holds an error. `vader` keeps the worst of this
///                     and its own code.
/// @error              H6014, from the build, for a module handed to it once
///                     its rounds ran: emitted after the last `BeforeEmit`, or
///                     before the driver left the loop there.
export run_driver :: fn(fingerprint: string, build: fn(string[]) -> i32, args: string[]) -> i32 {
    driver_process().fingerprint = fingerprint
    result := build(args)
    for ctx in driver_process().contexts {
        result = finished_context(ctx, result)
    }
    return result
}

// What the driver's exit does for one context: stop the build it opened, print
// the reports no build took, and fail on an error.
finished_context :: fn(ctx: BuildContext, code: i32) -> i32 {
    stop_build(ctx)
    ctx.flush_reports()
    return outcome(ctx, code)
}

// ---- producing output -----------------------------------------------------

/// Compile the entries into what the command asks: native binaries unless
/// `--emit` names their C or their text bytecode.
///
/// This is what makes a driver a build system rather than an observer. Each
/// entry is compiled to `build/<profile>-<target>/<name>` under the project, or
/// to `--out` when one entry is built.
///
/// Front-end and lowering diagnostics are gathered with the driver's own
/// reports, and the end of the stream prints them all at once.
///
/// @param ctx  the configured context ; add entries with `add_entry`.
/// @return     0 when every entry built and nothing reported an error, 1
///             otherwise. A driver normally returns this from `build`.
export emit_native :: fn(ctx: BuildContext) -> i32 {
    ctx.target = .Native
    // The stream drained, every message but the last ignored: one build path,
    // the one a driver that observes sees.
    code := 1
    for msg in ctx.messages().filter_is<CompleteMessage>() {
        code = msg.code
    }
    return code
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "toolchain/span"

@test test_the_reports_made_before_the_stream_go_with_the_configuration :: fn() -> void {
    link :: ScriptedLink { .events = [CompleteFrame { .code = 1 }] }
    ctx :: scripted_context(link)
    ctx.add_entry("app", "src/main.vader")
    ctx.add_entry("App", "src/main.vader")
    assert_eq(ctx.emit_native(), 1)
    assert_eq(told(link), "configure report:H6005 next next")
}

@test test_a_module_emitted_before_the_stream_goes_with_the_configuration :: fn() -> void {
    link :: ScriptedLink { .events = [CompleteFrame { .code = 0 }] }
    ctx :: scripted_context(link)
    ctx.emit_module("gen/early", "early :: fn() -> i32 = 1")
    assert_eq(ctx.emit_native(), 0)
    assert_eq(told(link), "configure emit:gen/early next next")
}

@test test_the_build_takes_what_the_driver_did_before_its_next_event :: fn() -> void {
    events: ServerFrame[]: [PhaseFrame { .phase = .BeforeEmit }, CompleteFrame { .code = 0 }]
    link :: ScriptedLink { .events = events }
    ctx :: scripted_context(link)
    for _ in ctx.messages().filter_is<PhaseMessage>() {
        ctx.emit_module("gen/x", "x :: fn() -> i32 = 1")
    }
    assert_eq(told(link), "configure next emit:gen/x next next")
}

@test test_the_end_carries_the_generated_files :: fn() -> void {
    end :: CompleteFrame { .code = 0, .generated = ["build/generated/gen/a1.vader"] }
    ctx :: scripted_context(ScriptedLink { .events = [end] })
    ctx.emit_native()
    assert_eq(ctx.generated_files_of().len(), 1)
}

@test test_the_driver_exit_stops_a_build_left_before_its_end :: fn() -> void {
    link :: ScriptedLink { .events = [PhaseFrame { .phase = .BeforeEmit }] }
    ctx :: scripted_context(link)
    for _ in ctx.messages() {
        break
    }
    ctx.emit_module("gen/late", "late :: fn() -> i32 = 1")
    assert_eq(finished_context(ctx, 0), 0)
    assert_eq(told(link), "configure next emit:gen/late stop")
}

@test test_opening_a_build_stops_the_one_still_open :: fn() -> void {
    first :: ScriptedLink { .events = [PhaseFrame { .phase = .Typechecked }] }
    for _ in scripted_context(first).messages() {
        break
    }
    second :: ScriptedLink { .events = [CompleteFrame { .code = 0 }] }
    scripted_context(second).emit_native()
    assert_eq(told(first), "configure next stop")
    assert_eq(told(second), "configure next next")
}

@test test_a_lost_build_ends_the_stream_on_a_failure :: fn() -> void {
    ctx :: scripted_context(ScriptedLink { .events = [] })
    assert_eq(ctx.emit_native(), 1)
}

@test test_the_driver_exit_fails_on_a_report_the_stream_never_saw :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    ctx.report(empty_span(), "made once the build was over")
    assert_eq(finished_context(ctx, 0), 1)
}
