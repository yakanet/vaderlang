// toolchain/build/context — the build-driver contract.
//
// `toolchain/build` is the ONE module a project's `build.vader` imports; everything
// else under `vader/` is compiler implementation. A driver builds a context,
// configures it, then pulls `messages()` to drive the compilation:
//
//     module "build"
//
//     import "toolchain/build"
//
//     build :: fn(args: string[]) -> i32 {
//         ctx :: new_build_context(args)
//         ctx.add_entry("app", "src/main.vader")
//         for msg in ctx.messages() { … }
//     }
//
// This file is the CONTRACT — what a driver fills in, and what it reads back.
// Draining the stream is `drive.vader`; writing generated modules is
// `generate.vader`; the driver a `vader.json` stands for is `manifest.vader`.
// They share this module, so nothing crosses a boundary.
//
// `build` is a reserved name in `build.vader`, the way `main` is in a program —
// no decorator is involved. The driver is compiled and run NATIVELY, not through
// the comptime VM: it reads the compiler's own AST nodes, and the VM has its own
// value representation (per-module type indices and atom ids), which no shared
// layout can reconcile.

module "toolchain/build"

import "vader/diagnostics"
import "std/io"
import "std/path"
import "vader/pipeline"
import "vader/resolver"
import "toolchain/span"

// ---- context --------------------------------------------------------------

/// Everything a build driver configures, plus the entries it adds.
///
/// A driver mutates this in place. It describes in code what a `vader.json`
/// declares: the entries, the module search roots, the assets. What the command
/// asked (a build, a check or a run, the profile, `--entry`) comes from `args`
/// and is not the driver's to change.
export BuildContext :: struct {
    /// The project folder: the one holding `build.vader`, or the `vader.json`
    /// whose driver runs in the compiler's own process, as the compiler passed
    /// it. The front end searches it for modules and anchors the generated tree
    /// under it, as for any project (`project_of`).
    /// NOT guaranteed absolute — the stdlib exposes no `cwd()`, so this is
    /// whatever the compiler passed, which may be relative to the invocation
    /// directory. Join onto it rather than assuming a prefix.
    project_root:   string
    /// Module search roots, highest precedence first, as `includePaths` in a
    /// `vader.json`: each relative to `project_root`, or under the toolchain's
    /// folder when it starts with `$VADER_HOME`, searched after the project
    /// folder. Left empty by `new_build_context`.
    include_paths:  string[]
    /// Folder holding the `vader` executable that started this build, and
    /// therefore its `lib/` and `runtime/c/`, as the request carries it.
    ///
    /// `@internal`: a driver has no use for it, and it is not the driver's to
    /// choose. It exists because a driver runs as `<project>/build/driver/driver`,
    /// so the sidecar probe that finds the stdlib beside the compiler would look
    /// inside the project instead. Empty when the driver was invoked by hand, in
    /// which case every lookup falls back to that probe — today's behaviour.
    @internal
    toolchain_root: string = ""
    /// Where generated modules land, relative to `project_root`.
    ///
    /// `@internal`, and deliberately not part of the configuration surface: the
    /// RESOLVER decides where generated modules are read from
    /// (`resolver::GENERATED_ROOT_DIR`, probed under the project root), so a
    /// driver that could move where it writes would write somewhere the compiler
    /// never looks. One of the two halves has to be authoritative.
    @internal
    generated_root: string
    /// What the command asked, read from `args` or handed over in process:
    /// the binaries go to `build/<profile>-<target>/<name>` under
    /// `project_root`, or to `--out`.
    @internal
    request:        DriverRequest = DriverRequest {}
    /// C compiler for the link step.
    cc:             string
    /// Raw linker flags, whitespace-split and appended verbatim.
    ldflags:        string
    /// What draining `messages()` produces. `.Native` by default — a build
    /// system builds; a driver that only observes leaves the loop at
    /// `BeforeEmit` rather than setting this.
    target:         BuildTarget
    /// C emitted by a `.C`-targeted drain, in the order of the entries.
    @internal
    c_sources:      string[] = []
    /// Modules the driver asked for in the CURRENT round, awaiting a flush.
    /// Emptied by `flush_generated` once the round reaches `BeforeEmit` — the
    /// driver has had every chance to emit by then.
    @internal
    pending:        GeneratedModule[] = []
    /// Generated files written this build, in the order they landed. The sweep
    /// runs before the first round, so this set is authoritative for this run.
    @internal
    generated:      string[] = []
    /// Entries, in the order `add_entry` added them. Read by the driver loop,
    /// never written directly: the order is what makes a build reproducible,
    /// so it stays behind `add_entry`.
    @internal
    entries:        ManifestEntry[] = []
    /// Files and folders a build copies beside the binaries, relative to
    /// `project_root`.
    @internal
    assets:         string[] = []
    /// The file that describes the project, which a diagnostic about the
    /// driver's behaviour is anchored at.
    @internal
    description_file: string = DRIVER_FILENAME
    /// Diagnostics of the build and the driver's own reports. `flush_reports`
    /// prints them.
    @internal
    diagnostics:    Diagnostic[] = []
}

/// Where generated modules land, relative to the project root.
///
/// The resolver's own constant, restated here so a driver reading this contract
/// does not have to reach into `vader/resolver` for it — and so there is exactly
/// one string. Gitignored by convention (`build/` already is): the generated tree
/// is a build artefact, reproducible from the driver plus the sources it reads.
export DEFAULT_GENERATED_ROOT :: GENERATED_ROOT_DIR

/// Build a context carrying the defaults a driver would otherwise restate.
///
/// The project root comes from `args`, not from the process working directory:
/// the stdlib exposes no `cwd()` (`std/env` has only `get_env`, and the C runtime
/// no `getcwd`), so threading it is the only way a driver can know where it is.
/// The compiler passes the root it resolved in the request; invoked bare, the
/// root is left empty rather than guessed.
///
/// @param args  the driver's argv, as the compiler passes it: the request
///              `parse_driver_request` reads. A driver invoked by hand may supply
///              less; each missing part falls back, the whole to a debug build of
///              every entry.
/// @return      a context with `project_root` set (empty when `args` carried
///              none), no entry and no include paths. Returned MUTABLE: the whole
///              contract is that the driver fills it in.
export new_build_context :: fn(args: string[]) -> BuildContext =
    new_build_context_from(parse_driver_request(args))

// A context for a request already in hand: `new_build_context` reads it from
// `args`, `build_from_manifest` receives it from the CLI.
new_build_context_from :: fn(request: DriverRequest) -> BuildContext = BuildContext {
    .project_root   = request.build.project_root ?? "",
    .toolchain_root = request.toolchain_root,
    .include_paths  = [],
    .generated_root = DEFAULT_GENERATED_ROOT,
    .request        = request,
    .cc             = cc_or_default(request.build.cc),
    .ldflags        = request.build.ldflags,
    .target         = .Native,
}

/// What a drained `messages()` leaves behind.
export BuildTarget :: enum(u8) {
    /// Link a binary per entry.
    Native,
    /// Emit C only, collected by `emit_c`.
    C,
    /// Produce nothing — for a driver that drains the stream purely to observe.
    None,
}

// The roots the front end takes as flags: the CLI's `--include-paths`, then the
// compiler's own `lib/`. What the driver configured reaches the loader at the
// rank of a manifest's `includePaths` (`register_project_roots`), or, with no
// project to register it under, follows `lib/` here as they would.
//
// The stdlib root is appended HERE rather than seeded into `ctx.include_paths`,
// so that a driver which replaces that list keeps the stdlib instead of getting
// `R2001 module not found: std/io`.
search_roots :: fn(ctx: BuildContext) -> string[] {
    roots: string[]: []
    roots.push_all(ctx.request.build.include_paths)
    library :: library_root_of(ctx)
    if library != null {
        roots.push(library)
    }
    // Without a project there is nowhere to register the driver's roots: they
    // are searched relative to the working directory.
    if project_of(ctx) == null {
        for p in ctx.include_paths {
            roots.push(manifest_root("", p, library))
        }
    }
    return roots
}

// The project the front end compiles in: `project_root`, null when the CLI
// passed none.
project_of :: fn(ctx: BuildContext) -> string | null {
    if ctx.project_root == "" {
        return null
    }
    return ctx.project_root
}

// The compiler's own `lib/`, or null when the driver was not told where it is.
library_root_of :: fn(ctx: BuildContext) -> string | null {
    library :: toolchain_sidecar(ctx, LIBRARY_ROOT_DIR, LIBRARY_ROOT_MARKER)
    if library == "" {
        return null
    }
    return library
}

// The compiler's own C runtime, or "" to let the link step probe for itself.
runtime_root_of :: fn(ctx: BuildContext) -> string =
    toolchain_sidecar(ctx, "runtime/c", "vader.h")

// A sidecar of the compiler that started this build, VERIFIED to be there, or ""
// to fall back to the probe the CLI uses.
//
// The check is the whole point. A bundle has `lib/` and `runtime/c/` beside
// its binary; a CHECKOUT has the binary in `build/` with neither beside it, and
// handing the link step a `<repo>/build/runtime/c` that does not exist made `cc`
// fail where the old relative fallback had worked. Same marker-probe shape as
// `resolver::resolve_sidecar`, for the same reason: a path is not a layout.
toolchain_sidecar :: fn(ctx: BuildContext, subdir: string, marker: string) -> string {
    if ctx.toolchain_root == "" {
        return ""
    }
    candidate :: join_path(ctx.toolchain_root, subdir)
    if !exists(join_path(candidate, marker)) {
        return ""
    }
    return candidate
}

// Where to anchor a diagnostic about the DRIVER's behaviour: no entry added, two
// entries of one name, a module name it built badly. The faulty
// line is unknown (it is a behaviour, not a statement) but the faulty FILE never
// is, and `empty_span` would render as `<synthetic>`, naming nothing.
driver_span :: fn(ctx: BuildContext) -> Span =
    file_head_span(join_path(ctx.project_root, ctx.description_file))

// ---- configuration --------------------------------------------------------

/// Add a program for the build to compile, as a key of `entries` does in a
/// `vader.json`.
///
/// Order is preserved and load-bearing: it fixes the order modules are read,
/// and therefore symbol-id assignment, which is what keeps a build byte-identical
/// across runs.
///
/// @param ctx   the context being configured.
/// @param name  what the binary is called, and what `--entry` selects it by.
/// @param path  the entry `.vader` file, relative to `project_root`.
/// @error       H6005 when an entry already has that name, since the two
///              binaries would overwrite each other.
export add_entry :: fn(ctx: BuildContext, name: string, path: string) -> void {
    for entry in ctx.entries {
        if entry.name == name {
            ctx.diagnostics.push(hook_error(.DuplicateEntryName, driver_span(ctx),
                "`${name}` names `${entry.path}` already, and now `${path}`"))
            return
        }
    }
    ctx.entries.push(ManifestEntry { .name = name, .path = path })
}

/// Add a file or folder for a build to copy beside the binaries, as `assets`
/// does in a `vader.json`. It lands under the same relative path, and a folder
/// is copied with everything it holds.
///
/// @param ctx    the context being configured.
/// @param asset  the file or folder, relative to `project_root`.
/// @error        H6010 when it is absolute or climbs out of the project.
export add_asset :: fn(ctx: BuildContext, asset: string) -> void {
    problem :: asset_problem(asset)
    if problem != null {
        ctx.diagnostics.push(hook_error(.AssetOutsideProject, driver_span(ctx), problem))
        return
    }
    ctx.assets.push(asset)
}

// ---- reporting ------------------------------------------------------------

/// Report a problem from the driver, anchored in the user's source.
///
/// Accumulates; `flush_reports` prints. The driver describes the problem and the
/// registry owns the code (`H6004`) — a project's lint rules should never have
/// to allocate diagnostic ids, and every driver report stays greppable under one
/// code.
///
/// Pass the tightest span the user can act on: a decl's `name_span` rather than
/// its `span`, a field rather than the struct holding it.
///
/// @param ctx      the context accumulating the report.
/// @param span     smallest source range the user can act on.
/// @param message  what is wrong, lowercase and without a trailing period —
///                 backtick identifiers, as the registry style requires.
export report :: fn(ctx: BuildContext, span: Span, message: string) -> void {
    ctx.diagnostics.push(hook_error(.HookReport, span, message))
}

/// Reports accumulated so far, in order.
///
/// @return the driver's diagnostics. Inspect them to decide an exit status;
///         `flush_reports` is what puts them on the wire.
export reports_of :: fn(ctx: BuildContext) -> Diagnostic[] = ctx.diagnostics

/// Print every accumulated report, in the compiler's own diagnostic format.
///
/// A driver has to call this: under this model the driver IS the process, so
/// there is no host left to drain the reports for it. They print once, sorted
/// by file and position and without duplicates, which is what makes a driven
/// build's output reproducible.
///
/// @param ctx  the context holding the reports.
/// @return     true when at least one report was printed, so a driver can pick
///             its exit status without counting them itself.
export flush_reports :: fn(ctx: BuildContext) -> bool {
    if ctx.diagnostics.len() == 0 {
        return false
    }
    eprintln(dump_diagnostics_with_file(ctx.diagnostics))
    return true
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_new_context_takes_root_from_args :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    assert_eq(ctx.project_root, "/tmp/proj")
}

@test test_new_context_bare_args_leaves_root_empty :: fn() -> void {
    ctx :: new_build_context(["driver"])
    assert_eq(ctx.project_root, "")
}

@test test_new_context_defaults_generated_root :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    assert_eq(ctx.generated_root, DEFAULT_GENERATED_ROOT)
}

@test test_new_context_has_no_include_paths :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    assert_eq(ctx.include_paths.len(), 0)
}

@test test_add_entry_preserves_order :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    ctx.add_entry("app", "a.vader")
    ctx.add_entry("tool", "b.vader")
    assert_eq(ctx.entries.len(), 2)
    assert_eq(ctx.entries[0].name, "app")
    assert_eq(ctx.entries[1].path, "b.vader")
}

@test test_add_entry_refuses_a_second_entry_of_the_same_name :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    ctx.add_entry("app", "a.vader")
    ctx.add_entry("app", "b.vader")
    assert_eq(ctx.entries.len(), 1)
    assert_eq(ctx.reports_of()[0].code.id, "H6005")
}

@test test_add_asset_refuses_a_path_outside_the_project :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    ctx.add_asset("data")
    ctx.add_asset("../elsewhere")
    assert_eq(ctx.assets.len(), 1)
    assert_eq(ctx.reports_of()[0].code.id, "H6010")
}

@test test_new_context_reads_the_request_from_args :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj", "", "--check", "--release"])
    assert(ctx.request.mode == .Check, "the mode comes from args")
    assert(ctx.request.build.release, "and the profile")
}

@test test_report_accumulates_in_order :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    ctx.report(empty_span(), "first problem")
    ctx.report(empty_span(), "second problem")
    reports :: ctx.reports_of()
    assert_eq(reports.len(), 2)
    assert_eq(reports[0].detail, "first problem")
    assert_eq(reports[1].detail, "second problem")
}

@test test_report_carries_the_registry_code :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    ctx.report(empty_span(), "something")
    assert_eq(ctx.reports_of()[0].code.id, "H6004")
}

@test test_no_reports_by_default :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    assert_eq(ctx.reports_of().len(), 0)
}

