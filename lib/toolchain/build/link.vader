// toolchain/build/link: the driver's end of the link to its build.
//
// `vader` starts the driver and serves its build (ADR 0145): it writes its
// frames on the driver's stdin, and reads the driver's on the driver's stdout,
// which also carries what the project's code prints (`toolchain/protocol`).

module "toolchain/build"

import "std/console"
import "toolchain/protocol"

// ---- the link -------------------------------------------------------------

// A build the driver talks to: what the driver tells it, and its next event.
ServerLink :: trait {
    send    :: fn(self, frame: DriverFrame) -> void
    receive :: fn(self) -> ServerFrame | ProtocolError
}

// The driver's standard streams, on which `vader` serves its build.
PipeLink :: struct {}

PipeLink implements ServerLink {
    send :: fn(self, frame: DriverFrame) -> void = print(encode_driver_frame(frame))

    receive :: fn(self) -> ServerFrame | ProtocolError {
        header :: read_line() else return ProtocolError {
            .msg = "`vader` closed the link: ${header.message()}",
        }
        length :: frame_length(header) else return length
        payload :: read_stdin(length) else return ProtocolError {
            .msg = "`vader` closed the link inside a frame: ${payload.message()}",
        }
        return decode_server_frame(payload)
    }
}

// ---- tests ----------------------------------------------------------------

import "std/string"

// A build that answers each pull with the next event a test lined up, and
// writes down what the driver told it.
ScriptedLink :: struct {
    events: ServerFrame[]
    told: DriverFrame[] = []
    at: i64 = 0
}

ScriptedLink implements ServerLink {
    send :: fn(self, frame: DriverFrame) -> void = self.told.push(frame)

    receive :: fn(self) -> ServerFrame | ProtocolError {
        if self.at >= self.events.len() {
            return ProtocolError { .msg = "the script is over" }
        }
        frame :: self.events[self.at]
        self.at += 1
        return frame
    }
}

// A context whose builds `link` serves.
scripted_context :: fn(link: ScriptedLink) -> BuildContext {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    ctx.server = link
    return ctx
}

// What the driver told the build, a word per frame.
told :: fn(link: ScriptedLink) -> string {
    words: string[]: []
    for frame in link.told {
        words.push(told_word(frame))
    }
    return words.join(" ")
}

told_word :: fn(frame: DriverFrame) -> string = match frame {
    is ConfigureFrame  -> "configure"
    is EmitModuleFrame -> "emit:${frame.name}"
    is ReportFrame     -> "report:${frame.code}"
    is DocQueryFrame   -> "doc"
    is NextFrame       -> "next"
    is StopFrame       -> "stop"
    is GeneratedFrame  -> "generated"
    is BodyFrame       -> "body"
}
