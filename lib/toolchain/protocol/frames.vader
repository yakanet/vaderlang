// toolchain/protocol/frames: what a build driver and `vader` say to each other.
//
// A project's `build.vader` runs as a process of its own, a client of the
// `vader` that launched it (ADR 0145). `vader` keeps the pipeline: it sends the
// driver each event `messages()` yields, a `ServerFrame`, then reads the
// driver's requests, `DriverFrame`s, until a `NextFrame` lets the pipeline go
// on or a `StopFrame` ends the drain. The driver opens with a
// `ConfigureFrame`, on its first pull. A question among the requests
// (`DocQueryFrame`) is answered at once, before the next request is read.
//
// A frame holds strings and integers, a `Span` included, and the declarations of
// a module (`declarations.vader`). Its payload is a sequence of fields, each
// written as its length in bytes, a colon, then the bytes; the first field names
// the frame:
//
// ```
// 11:emit_module3:gen6:x :: 1
// ```
//
// An integer is a field of decimal digits; a list is a field holding its
// count, then its items. `stream.vader` puts a payload on a stream and takes
// it back off.
//
// Both ends are compiled from the same sources: the driver sends the
// fingerprint of `lib/toolchain` it was compiled from, and `vader` rebuilds a
// driver whose fingerprint is not its own. The layout needs no version.

module "toolchain/protocol"

import "std/numbers"
import "std/string"
import "std/string_builder"
AST :: import "toolchain/ast"
import "toolchain/project"
import "toolchain/span"

// ---- frames ---------------------------------------------------------------

/// What `vader` sends a driver: the events of the pipeline, and the answers to
/// its questions.
export ServerFrame :: TypecheckedFrame | PhaseFrame | CompleteFrame | DocAnswerFrame

/// What a driver sends `vader`: its configuration, then its requests and
/// questions.
export DriverFrame :: ConfigureFrame
             | EmitModuleFrame
             | ReportFrame
             | DocQueryFrame
             | NextFrame
             | StopFrame

/// A module passed type checking.
export TypecheckedFrame :: struct {
    module_name: string
    /// The declarations of the module the driver has not received yet, as the
    /// front end left them, those that `crosses` and without the bodies of their
    /// functions (`declarations.vader`): a module a round generated into comes
    /// back with the generated file's alone.
    declarations: AST.Decl[]
}

/// The pipeline reached a phase.
export PhaseFrame :: struct {
    phase: Phase
}

/// The pipeline ended.
export CompleteFrame :: struct {
    /// The exit code of the build, 0 when it succeeded.
    code: i32
    /// Files written for the generated modules, in the order they landed.
    generated: string[] = []
}

/// The configuration of the driver, sent on its first pull of `messages()`.
export ConfigureFrame :: struct {
    /// The fingerprint of `lib/toolchain` the driver was compiled from.
    fingerprint: string
    /// In the order the driver added them.
    entries: ManifestEntry[]
    include_paths: string[]
    assets: string[]
    target: BuildTarget
    cc: string
    ldflags: string
}

/// A module the driver generates, which `vader` writes at `BeforeEmit`.
export EmitModuleFrame :: struct {
    name: string
    source: string
}

/// A diagnostic of the driver.
export ReportFrame :: struct {
    /// The id of the `HookCode` the diagnostic carries (`H6004`).
    code: string
    span: Span
    detail: string
}

/// A question of the driver: the vaderdoc of the declaration, field, variant or
/// member it received whose span is `span`. `vader` answers at once.
export DocQueryFrame :: struct {
    span: Span
}

/// The answer to a `DocQueryFrame`.
export DocAnswerFrame :: struct {
    /// Null when the node has none, or when no node the driver received has
    /// that span.
    doc: AST.DocComment | null
}

/// Let the pipeline go on to its next event.
export NextFrame :: struct {}

/// The driver pulls no more events: its loop ended before the stream did.
export StopFrame :: struct {}

// ---- phases and targets ---------------------------------------------------

/// Where the pipeline is, ordered as the stages run.
///
/// Every variant has an emission site: draining `messages()` walks the whole
/// build, so there is no reserved half of this enum. `BeforeEmit` is the one to
/// know about: it is the last point at which leaving the loop produces nothing,
/// which is how a driver that only wants to observe declines to build.
export Phase :: enum(u8) {
    /// Every module parsed, collected, resolved and typechecked.
    Typechecked,
    /// `@comptime` values evaluated, generic instances harvested.
    Evaluated,
    /// Last point before output. `break` here writes nothing; `break` after
    /// leaves a partial binary.
    BeforeEmit,
    /// The lowered tree exists: desugared, before CFG and bytecode.
    Lowered,
    /// The output file has been written.
    OutputWritten,
}

/// What a drained `messages()` leaves behind.
export BuildTarget :: enum(u8) {
    /// Link a binary per entry.
    Native,
    /// Produce nothing: for a driver that drains the stream purely to observe.
    None,
}

/// A frame that does not read: a malformed or truncated stream, or a frame the
/// reader does not expect.
export ProtocolError :: struct {
    msg: string
}

ProtocolError implements Error {
    message :: fn(self) -> string = self.msg
}

// ---- writing --------------------------------------------------------------

/// The bytes of a frame `vader` sends, without the header that announces them,
/// as `decode_server_frame` reads them back.
///
/// @param frame  the event.
export server_payload :: fn(frame: ServerFrame) -> string {
    out :: StringBuilder {}
    match frame {
        is TypecheckedFrame -> {
            out.write_field("typechecked")
            out.write_field(frame.module_name)
            out.write_declarations(frame.declarations)
        }
        is PhaseFrame       -> {
            out.write_field("phase")
            out.write_integer(i64(frame.phase))
        }
        is CompleteFrame    -> {
            out.write_field("complete")
            out.write_integer(frame.code)
            out.write_strings(frame.generated)
        }
        is DocAnswerFrame   -> {
            out.write_field("doc_answer")
            out.write_doc(frame.doc)
        }
    }
    return out.to_string()
}

write_doc :: fn(out: StringBuilder, doc: AST.DocComment | null) -> void {
    out.write_flag(doc != null)
    if doc == null {
        return
    }
    out.write_integer(doc.lines.len())
    for line in doc.lines {
        out.write_field(line.text)
        out.write_span(line.span)
    }
}

/// The bytes of a frame a driver sends, without the header that announces them,
/// as `decode_driver_frame` reads them back.
///
/// @param frame  the configuration or the request.
export driver_payload :: fn(frame: DriverFrame) -> string {
    out :: StringBuilder {}
    match frame {
        is ConfigureFrame  -> {
            out.write_field("configure")
            out.write_field(frame.fingerprint)
            out.write_integer(frame.entries.len())
            for e in frame.entries {
                out.write_field(e.name)
                out.write_field(e.path)
            }
            out.write_strings(frame.include_paths)
            out.write_strings(frame.assets)
            out.write_integer(i64(frame.target))
            out.write_field(frame.cc)
            out.write_field(frame.ldflags)
        }
        is EmitModuleFrame -> {
            out.write_field("emit_module")
            out.write_field(frame.name)
            out.write_field(frame.source)
        }
        is ReportFrame     -> {
            out.write_field("report")
            out.write_field(frame.code)
            out.write_span(frame.span)
            out.write_field(frame.detail)
        }
        is DocQueryFrame   -> {
            out.write_field("doc_query")
            out.write_span(frame.span)
        }
        is NextFrame       -> out.write_field("next")
        is StopFrame       -> out.write_field("stop")
    }
    return out.to_string()
}

write_field :: fn(out: StringBuilder, text: string) -> void {
    out.append("${text.byte_len()}:")
    out.append(text)
}

write_integer :: fn(out: StringBuilder, value: i64) -> void = out.write_field("${value}")

write_strings :: fn(out: StringBuilder, texts: string[]) -> void {
    out.write_integer(texts.len())
    for t in texts {
        out.write_field(t)
    }
}

write_span :: fn(out: StringBuilder, span: Span) -> void {
    out.write_position(span.start)
    out.write_position(span.end)
}

write_position :: fn(out: StringBuilder, p: Position) -> void {
    out.write_field(p.file)
    out.write_place(p)
}

// A position whose file is written elsewhere.
write_place :: fn(out: StringBuilder, p: Position) -> void {
    out.write_integer(p.offset)
    out.write_integer(p.line)
    out.write_integer(p.column)
}

write_flag :: fn(out: StringBuilder, value: bool) -> void =
    out.write_field(if value { "1" } else { "0" })

write_optional_field :: fn(out: StringBuilder, text: string | null) -> void {
    out.write_flag(text != null)
    if text != null {
        out.write_field(text)
    }
}

write_optional_integer :: fn(out: StringBuilder, value: i64 | null) -> void {
    out.write_flag(value != null)
    if value != null {
        out.write_integer(value)
    }
}

// ---- reading --------------------------------------------------------------

/// Read a frame `vader` sent.
///
/// @param payload  the bytes the header of the frame announced.
/// @error          `ProtocolError` when they hold no frame `vader` sends.
export decode_server_frame :: fn(payload: string) -> ServerFrame | ProtocolError {
    r :: FieldReader { .payload = payload }
    kind :: r.read_field() else return kind
    frame :: read_server_frame(r, kind) else return frame
    if r.at < payload.byte_len() {
        return past_last_field(r)
    }
    return frame
}

/// Read a frame a driver sent.
///
/// @param payload  the bytes the header of the frame announced.
/// @error          `ProtocolError` when they hold no frame a driver sends.
export decode_driver_frame :: fn(payload: string) -> DriverFrame | ProtocolError {
    r :: FieldReader { .payload = payload }
    kind :: r.read_field() else return kind
    frame :: read_driver_frame(r, kind) else return frame
    if r.at < payload.byte_len() {
        return past_last_field(r)
    }
    return frame
}

read_server_frame :: fn(r: FieldReader, kind: string) -> ServerFrame | ProtocolError = match kind {
    "typechecked" -> read_typechecked(r)
    "phase"       -> read_phase(r)
    "complete"    -> read_complete(r)
    "doc_answer"  -> read_doc_answer(r)
    _             -> ProtocolError { .msg = "`${kind}` is no frame `vader` sends" }
}

read_driver_frame :: fn(r: FieldReader, kind: string) -> DriverFrame | ProtocolError = match kind {
    "configure"   -> read_configure(r)
    "emit_module" -> read_emit_module(r)
    "report"      -> read_report(r)
    "doc_query"   -> read_doc_query(r)
    "next"        -> NextFrame {}
    "stop"        -> StopFrame {}
    _             -> ProtocolError { .msg = "`${kind}` is no frame a driver sends" }
}

read_typechecked :: fn(r: FieldReader) -> TypecheckedFrame | ProtocolError {
    module_name :: r.read_field() else return module_name
    declarations :: r.read_declarations() else return declarations
    return TypecheckedFrame { .module_name = module_name, .declarations = declarations }
}

read_phase :: fn(r: FieldReader) -> PhaseFrame | ProtocolError {
    rank :: r.read_integer() else return rank
    if rank !in Phase {
        return ProtocolError { .msg = "${rank} is no phase" }
    }
    return PhaseFrame { .phase = Phase(rank) }
}

read_complete :: fn(r: FieldReader) -> CompleteFrame | ProtocolError {
    code :: r.read_i32() else return code
    generated :: r.read_strings() else return generated
    return CompleteFrame { .code = code, .generated = generated }
}

read_doc_answer :: fn(r: FieldReader) -> DocAnswerFrame | ProtocolError {
    present :: r.read_flag() else return present
    if !present {
        return DocAnswerFrame { .doc = null }
    }
    count :: r.read_count() else return count
    lines: AST.DocCommentLine[]: []
    for _ in 0..<count {
        text :: r.read_field() else return text
        span :: r.read_span() else return span
        lines.push(AST.DocCommentLine { .text = text, .span = span })
    }
    return DocAnswerFrame { .doc = AST.DocComment { .lines = lines } }
}

read_configure :: fn(r: FieldReader) -> ConfigureFrame | ProtocolError {
    fingerprint :: r.read_field() else return fingerprint
    count :: r.read_count() else return count
    entries: ManifestEntry[]: []
    for _ in 0..<count {
        name :: r.read_field() else return name
        path :: r.read_field() else return path
        entries.push(ManifestEntry { .name = name, .path = path })
    }
    include_paths :: r.read_strings() else return include_paths
    assets :: r.read_strings() else return assets
    rank :: r.read_integer() else return rank
    if rank !in BuildTarget {
        return ProtocolError { .msg = "${rank} is no build target" }
    }
    cc :: r.read_field() else return cc
    ldflags :: r.read_field() else return ldflags
    return ConfigureFrame {
        .fingerprint = fingerprint,
        .entries = entries,
        .include_paths = include_paths,
        .assets = assets,
        .target = BuildTarget(rank),
        .cc = cc,
        .ldflags = ldflags,
    }
}

read_emit_module :: fn(r: FieldReader) -> EmitModuleFrame | ProtocolError {
    name :: r.read_field() else return name
    source :: r.read_field() else return source
    return EmitModuleFrame { .name = name, .source = source }
}

read_doc_query :: fn(r: FieldReader) -> DocQueryFrame | ProtocolError {
    span :: r.read_span() else return span
    return DocQueryFrame { .span = span }
}

read_report :: fn(r: FieldReader) -> ReportFrame | ProtocolError {
    code :: r.read_field() else return code
    span :: r.read_span() else return span
    detail :: r.read_field() else return detail
    return ReportFrame {
        .code = code,
        .span = span,
        .detail = detail,
    }
}

FieldReader :: struct {
    payload: string
    /// The byte offset of the next field.
    at: i64 = 0
}

read_field :: fn(r: FieldReader) -> string | ProtocolError {
    colon :: r.payload.index_of(':', r.at) else return ProtocolError {
        .msg = "a field at byte ${r.at} has no length",
    }
    length :: parse_int_in_base(r.payload.byte_slice(r.at, colon), 10) else return ProtocolError {
        .msg = "a field at byte ${r.at} has no length",
    }
    start :: colon + 1
    end :: start + length
    if end > r.payload.byte_len() {
        return ProtocolError { .msg = "a field at byte ${r.at} runs past the end of the frame" }
    }
    r.at = end
    return r.payload.byte_slice(start, end)
}

read_integer :: fn(r: FieldReader) -> i64 | ProtocolError {
    field :: r.read_field() else return field
    digits :: field.trim_prefix("-")
    magnitude :: parse_int_in_base(digits, 10) else return ProtocolError {
        .msg = "`${field}` is no integer",
    }
    if digits.byte_len() < field.byte_len() {
        return -magnitude
    }
    return magnitude
}

// An integer an `i64` may not hold: the magnitude of an integer literal, the
// bits of a float.
read_unsigned :: fn(r: FieldReader) -> u64 | ProtocolError {
    field :: r.read_field() else return field
    value :: parse_uint_in_base(field, 10) else return ProtocolError {
        .msg = "`${field}` is no unsigned integer",
    }
    return value
}

read_i32 :: fn(r: FieldReader) -> i32 | ProtocolError {
    value :: r.read_integer() else return value
    if value < @min(i32) || value > @max(i32) {
        return ProtocolError { .msg = "${value} does not fit an `i32`" }
    }
    return i32(value)
}

read_count :: fn(r: FieldReader) -> i64 | ProtocolError {
    count :: r.read_integer() else return count
    if count < 0 {
        return ProtocolError { .msg = "a list holds ${count} items" }
    }
    return count
}

read_strings :: fn(r: FieldReader) -> string[] | ProtocolError {
    count :: r.read_count() else return count
    texts: string[]: []
    for _ in 0..<count {
        text :: r.read_field() else return text
        texts.push(text)
    }
    return texts
}

read_span :: fn(r: FieldReader) -> Span | ProtocolError {
    start :: r.read_position() else return start
    end :: r.read_position() else return end
    return Span { .start = start, .end = end }
}

read_position :: fn(r: FieldReader) -> Position | ProtocolError {
    file :: r.read_field() else return file
    return r.read_place(file)
}

read_place :: fn(r: FieldReader, file: string) -> Position | ProtocolError {
    offset :: r.read_integer() else return offset
    line :: r.read_i32() else return line
    column :: r.read_i32() else return column
    return Position {
        .file = file,
        .offset = offset,
        .line = line,
        .column = column,
    }
}

read_flag :: fn(r: FieldReader) -> bool | ProtocolError {
    field :: r.read_field() else return field
    return match field {
        "1" -> true
        "0" -> false
        _   -> ProtocolError { .msg = "`${field}` is no flag" }
    }
}

read_optional_field :: fn(r: FieldReader) -> string | null | ProtocolError {
    present :: r.read_flag() else return present
    if !present {
        return null
    }
    return r.read_field()
}

read_optional_integer :: fn(r: FieldReader) -> i64 | null | ProtocolError {
    present :: r.read_flag() else return present
    if !present {
        return null
    }
    return r.read_integer()
}

past_last_field :: fn(r: FieldReader) -> ProtocolError = ProtocolError {
    .msg = "the frame goes on past its last field, at byte ${r.at}",
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_driver_payload_writes_each_field_after_its_length :: fn() -> void {
    frame :: EmitModuleFrame { .name = "gen", .source = "x :: 1" }
    assert_eq(driver_payload(frame), "11:emit_module3:gen6:x :: 1")
    assert_eq(driver_payload(NextFrame {}), "4:next")
}

@test
test_typechecked_frame_round_trips :: fn() -> void {
    alias :: AST.TypeAliasDecl {
        .span = empty_span(),
        .name = "Name",
        .name_span = empty_span(),
        .visibility = .Public,
        .type_params = [],
        .aliased = AST.IdentExpr { .span = empty_span(), .name = "é: 12:", .implicit_dot = false },
        .decorators = [],
    }
    sent :: TypecheckedFrame { .module_name = "app", .declarations = [alias] }
    received :: decode_server_frame(server_payload(sent))
    if received !is TypecheckedFrame {
        assert(false, "a typechecked frame reads back as one")
        return
    }
    assert_eq(received.module_name, "app")
    assert_eq(received.declarations.len(), 1)
    back :: received.declarations[0]
    if back !is AST.TypeAliasDecl {
        assert(false, "the alias reads back as one")
        return
    }
    assert_eq(back.name, "Name")
}

@test
test_phase_and_complete_frames_round_trip :: fn() -> void {
    phase :: decode_server_frame(server_payload(PhaseFrame { .phase = .Lowered }))
    assert(phase is PhaseFrame && phase.phase == .Lowered, "the phase reads back")
    complete :: decode_server_frame(server_payload(CompleteFrame { .code = -1 }))
    assert(complete is CompleteFrame && complete.code == -1, "a negative code reads back")
}

@test
test_complete_frame_carries_the_generated_files :: fn() -> void {
    sent :: CompleteFrame { .code = 0, .generated = ["build/generated/gen/a1b2.vader"] }
    received :: decode_server_frame(server_payload(sent))
    if received !is CompleteFrame {
        assert(false, "a complete frame reads back as one")
        return
    }
    assert_eq(received.generated.join(","), "build/generated/gen/a1b2.vader")
}

@test
test_configure_frame_round_trips :: fn() -> void {
    sent :: ConfigureFrame {
        .fingerprint = "9f86d081",
        .entries = [ManifestEntry { .name = "app", .path = "src/main.vader" }],
        .include_paths = [r"$VADER_HOME/third_party", "vendor"],
        .assets = [],
        .target = .None,
        .cc = "clang",
        .ldflags = "-lm -lpthread",
    }
    received :: decode_driver_frame(driver_payload(sent))
    if received !is ConfigureFrame {
        assert(false, "a configure frame reads back as one")
        return
    }
    assert_eq(received.fingerprint, "9f86d081")
    assert_eq(received.entries.len(), 1)
    assert_eq(received.entries[0].name, "app")
    assert_eq(received.entries[0].path, "src/main.vader")
    assert_eq(received.include_paths.join(","), r"$VADER_HOME/third_party,vendor")
    assert_eq(received.assets.len(), 0)
    assert(received.target == .None, "the target reads back")
    assert_eq(received.cc, "clang")
    assert_eq(received.ldflags, "-lm -lpthread")
}

@test
test_report_frame_round_trips :: fn() -> void {
    span :: Span {
        .start = Position { .file = "src/main.vader", .offset = 40, .line = 3, .column = 1 },
        .end = Position { .file = "src/main.vader", .offset = 47, .line = 3, .column = 8 },
    }
    sent :: ReportFrame {
        .code = "H6004",
        .span = span,
        .detail = "`main` is missing a doc",
    }
    received :: decode_driver_frame(driver_payload(sent))
    if received !is ReportFrame {
        assert(false, "a report frame reads back as one")
        return
    }
    assert_eq(received.code, "H6004")
    assert_eq(received.span.start.offset, 40)
    assert_eq(received.span.end.file, "src/main.vader")
    assert_eq(received.span.end.column, 8)
    assert_eq(received.detail, "`main` is missing a doc")
}

@test
test_a_doc_question_and_its_answer_round_trip :: fn() -> void {
    span :: Span { .start = in_main(12, 2, 1), .end = in_main(30, 2, 19) }
    question :: decode_driver_frame(driver_payload(DocQueryFrame { .span = span }))
    if question !is DocQueryFrame {
        assert(false, "a doc question reads back as one")
        return
    }
    assert(question.span == span, "its span reads back")
    line :: AST.DocCommentLine { .text = " A point: 2 coordinates.", .span = span }
    sent :: DocAnswerFrame { .doc = AST.DocComment { .lines = [line] } }
    answer :: decode_server_frame(server_payload(sent))
    if answer !is DocAnswerFrame {
        assert(false, "a doc answer reads back as one")
        return
    }
    assert_eq(AST.doc_text(answer.doc), "A point: 2 coordinates.")
}

// A position in `src/main.vader`.
in_main :: fn(offset: i64, line: i32, column: i32) -> Position = Position {
    .file = "src/main.vader",
    .offset = offset,
    .line = line,
    .column = column,
}

@test
test_an_answer_without_a_doc_reads_back_empty :: fn() -> void {
    answer :: decode_server_frame(server_payload(DocAnswerFrame { .doc = null }))
    if answer !is DocAnswerFrame {
        assert(false, "a doc answer reads back as one")
        return
    }
    assert(answer.doc == null, "no doc")
}

@test
test_next_and_stop_frames_round_trip :: fn() -> void {
    assert(decode_driver_frame(driver_payload(NextFrame {})) is NextFrame, "next reads back")
    assert(decode_driver_frame(driver_payload(StopFrame {})) is StopFrame, "stop reads back")
}

@test
test_decode_refuses_a_frame_of_the_other_side :: fn() -> void {
    assert(decode_server_frame("4:next") is ProtocolError, "`vader` sends no `next`")
    assert(decode_driver_frame("5:phase1:3") is ProtocolError, "a driver sends no `phase`")
}

@test
test_decode_refuses_a_phase_out_of_range :: fn() -> void {
    assert(decode_server_frame("5:phase1:9") is ProtocolError, "no ninth phase")
}

@test
test_decode_refuses_a_field_past_the_end :: fn() -> void {
    assert(decode_driver_frame("11:emit_module3:gen9:x") is ProtocolError, "the source is cut")
}

@test
test_decode_refuses_bytes_past_the_last_field :: fn() -> void {
    assert(decode_driver_frame("4:next1:x") is ProtocolError, "nothing follows `next`")
}

@test
test_decode_refuses_a_field_with_no_length :: fn() -> void {
    assert(decode_driver_frame("next") is ProtocolError, "a field starts with its length")
}
