// toolchain/protocol/declarations: the declarations of a module, on the wire.
//
// `vader` hands a driver the declarations of each module as the front end left
// them (ADR 0145): every declaration the source writes, with what it writes
// outside the body of a function (ADR 0150). So a constant crosses with its
// value, a field and a parameter with their default, a variant with its value or
// its data, a struct with what it spreads. A function crosses with its
// signature, a trait or an impl with the members its source writes.
//
// What does not cross: a declaration the compiler made (the helper computing a
// `@comptime` constant, a member an impl takes from its trait), the body of a
// function (a trait member's default included), a decorator. A `@comptime`
// constant crosses with the expression it is written with. The node read back
// holds none of them, nor a doc comment, which a driver asks for
// (`DocQueryFrame`).
//
// The layout is the frames' own (`frames.vader`): fields after their length,
// integers as decimal fields, lists as a count then their items. A declaration
// and an expression open with a tag naming their form, a value that may be
// absent with a flag. Every node carries a span, so a span names its file by an
// index into a table written first.

module "toolchain/protocol"

import "std/collections"
import "std/iter"
import "std/string_builder"
AST :: import "toolchain/ast"
import "toolchain/span"

// ---- writing --------------------------------------------------------------

/// The declarations of a module, as `decode_declarations` takes them back.
///
/// @param decls  the declarations, in the order of the module's files ; each
///               one `crosses`.
export encode_declarations :: fn(decls: AST.Decl[]) -> string {
    out :: StringBuilder {}
    out.write_declarations(decls)
    return out.to_string()
}

// Writes declarations, gathering the files their spans name.
DeclWriter :: struct {
    out: StringBuilder = StringBuilder {}
    /// Each file a span named so far, by its index in the table.
    files: Map<string, i64> = Map<string, i64> {}
}

write_declarations :: fn(out: StringBuilder, decls: AST.Decl[]) -> void {
    w :: DeclWriter {}
    w.write_list(decls, write_decl)
    out.write_strings(w.files.keys().collect())
    out.append(w.out.to_string())
}

// A list: its count, then each item as `item` writes it.
write_list :: fn<T>(w: DeclWriter, items: T[], item: fn(DeclWriter, T) -> void) -> void {
    w.out.write_integer(items.len())
    for x in items {
        item(w, x)
    }
}

// A value that may be absent: a flag, then the value as `item` writes it.
write_optional :: fn<T>(w: DeclWriter, value: T | null, item: fn(DeclWriter, T) -> void) -> void {
    w.out.write_flag(value != null)
    if value != null {
        item(w, value)
    }
}

/// Whether `d` crosses: every declaration the source writes does, none the
/// compiler made (`is_compiler_made`).
///
/// @param d  a declaration of a module.
export crosses :: fn(d: AST.Decl) -> bool = d !is AST.FnDecl || !AST.is_compiler_made(d)

write_decl :: fn(w: DeclWriter, d: AST.Decl) -> void {
    match d {
        is AST.StructDecl    -> w.write_struct(d)
        is AST.FnDecl        -> w.write_fn(d)
        is AST.EnumDecl      -> w.write_enum(d)
        is AST.TraitDecl     -> w.write_trait(d)
        is AST.ImplDecl      -> w.write_impl(d)
        is AST.TypeAliasDecl -> w.write_alias(d)
        is AST.ConstDecl     -> w.write_const(d)
        is AST.AssertDecl    -> w.write_assert(d)
        is AST.ImportDecl    -> w.write_import(d)
    }
}

// What a named declaration opens with, past its tag.
write_head :: fn(
    w: DeclWriter,
    span: Span,
    name: string,
    name_span: Span,
    visibility: AST.Visibility,
) -> void {
    w.write_span(span)
    w.out.write_field(name)
    w.write_span(name_span)
    w.out.write_flag(visibility == .Public)
}

write_struct :: fn(w: DeclWriter, d: AST.StructDecl) -> void {
    w.out.write_field("struct")
    w.write_head(d.span, d.name, d.name_span, d.visibility)
    w.write_type_params(d.type_params)
    w.write_list(d.fields, write_struct_field)
    w.write_list(d.spreads, write_spread)
}

write_struct_field :: fn(w: DeclWriter, f: AST.StructField) -> void {
    w.write_span(f.span)
    w.out.write_field(f.name)
    w.out.write_flag(f.visibility == .Public)
    w.write_expr(f.ty)
    w.write_optional_expr(f.default)
}

write_spread :: fn(w: DeclWriter, spread: AST.StructSpread) -> void {
    w.write_span(spread.span)
    w.write_expr(spread.base)
    w.out.write_integer(spread.at)
}

write_fn :: fn(w: DeclWriter, d: AST.FnDecl) -> void {
    w.out.write_field("fn")
    w.write_function(d)
}

// A function past its tag: a member is one, with no tag since only a function
// is.
write_function :: fn(w: DeclWriter, d: AST.FnDecl) -> void {
    w.write_head(d.span, d.name, d.name_span, d.visibility)
    w.write_type_params(d.type_params)
    w.write_span(d.params_span)
    w.write_params(d.params)
    w.write_optional_expr(d.return_type)
}

// The parameters of a function or a lambda.
write_params :: fn(w: DeclWriter, params: AST.FnParam[]) -> void = w.write_list(params, write_param)

write_param :: fn(w: DeclWriter, p: AST.FnParam) -> void {
    w.write_span(p.span)
    w.out.write_field(p.name)
    w.write_span(p.name_span)
    w.write_optional_expr(p.ty)
    w.write_optional_expr(p.default_value)
    w.out.write_flag(p.variadic)
}

write_enum :: fn(w: DeclWriter, d: AST.EnumDecl) -> void {
    w.out.write_field("enum")
    w.write_head(d.span, d.name, d.name_span, d.visibility)
    w.write_exprs(d.header)
    w.write_list(d.variants, write_variant)
}

write_variant :: fn(w: DeclWriter, v: AST.EnumVariant) -> void {
    w.write_span(v.span)
    w.out.write_field(v.name)
    w.out.write_optional_integer(v.value)
    w.write_optional_span(v.value_span)
    w.write_optional(v.data, write_struct_items)
}

write_trait :: fn(w: DeclWriter, d: AST.TraitDecl) -> void {
    w.out.write_field("trait")
    w.write_head(d.span, d.name, d.name_span, d.visibility)
    w.write_type_params(d.type_params)
    w.write_optional_expr(d.requires)
    w.write_members(d.members)
}

write_impl :: fn(w: DeclWriter, d: AST.ImplDecl) -> void {
    w.out.write_field("impl")
    w.write_span(d.span)
    w.write_type_params(d.type_params)
    w.out.write_field(d.trait_name)
    w.write_span(d.trait_name_span)
    w.write_exprs(d.trait_args)
    w.write_expr(d.for_type)
    w.write_members(d.members)
}

write_members :: fn(w: DeclWriter, members: AST.FnDecl[]) -> void {
    written :: members.filter((m: AST.FnDecl) -> !AST.is_compiler_made(m)).collect()
    w.write_list(written, write_function)
}

write_alias :: fn(w: DeclWriter, d: AST.TypeAliasDecl) -> void {
    w.out.write_field("alias")
    w.write_head(d.span, d.name, d.name_span, d.visibility)
    w.write_type_params(d.type_params)
    w.write_expr(d.aliased)
}

write_const :: fn(w: DeclWriter, d: AST.ConstDecl) -> void {
    w.out.write_field("const")
    w.write_head(d.span, d.name, d.name_span, d.visibility)
    w.write_optional_expr(d.ty)
    w.write_expr(AST.written_value(d))
}

write_assert :: fn(w: DeclWriter, d: AST.AssertDecl) -> void {
    w.out.write_field("assert")
    w.write_span(d.span)
    w.write_expr(d.condition)
    w.out.write_optional_field(d.message)
    w.write_optional_span(d.message_span)
}

write_type_params :: fn(w: DeclWriter, params: AST.TypeParam[]) -> void =
    w.write_list(params, write_type_param)

write_type_param :: fn(w: DeclWriter, p: AST.TypeParam) -> void {
    w.write_span(p.span)
    w.out.write_field(p.name)
    w.write_optional_expr(p.bound)
    w.write_optional_expr(p.default)
}

write_import :: fn(w: DeclWriter, d: AST.ImportDecl) -> void {
    w.out.write_field("import")
    w.write_span(d.span)
    w.out.write_field(d.path)
    binding :: d.binding
    match binding {
        is AST.NamedNamespaceImport -> {
            w.out.write_field("namespace")
            w.out.write_field(binding.name)
        }
        is AST.DestructureImport    -> {
            w.out.write_field("destructure")
            w.write_list(binding.names, write_import_name)
        }
        is AST.WildcardImport       -> w.out.write_field("wildcard")
    }
}

write_import_name :: fn(w: DeclWriter, n: AST.ImportName) -> void {
    w.write_span(n.span)
    w.out.write_field(n.name)
    w.out.write_optional_field(n.alias)
}

write_span :: fn(w: DeclWriter, span: Span) -> void {
    w.out.write_integer(w.files.get_or_put(span.start.file, w.files.len()))
    w.out.write_place(span.start)
    w.out.write_place(span.end)
}

write_optional_span :: fn(w: DeclWriter, span: Span | null) -> void =
    w.write_optional(span, write_span)

// ---- reading --------------------------------------------------------------

/// The declarations `encode_declarations` wrote.
///
/// @param text  what it wrote.
/// @error       `ProtocolError` when `text` holds no declarations, or bytes past
///              them.
export decode_declarations :: fn(text: string) -> AST.Decl[] | ProtocolError {
    r :: FieldReader { .payload = text }
    decls :: r.read_declarations() else return decls
    if r.at < text.byte_len() {
        return past_last_field(r)
    }
    return decls
}

// Reads declarations, the files their spans name in hand.
DeclReader :: struct {
    fields: FieldReader
    files: string[]
}

read_declarations :: fn(r: FieldReader) -> AST.Decl[] | ProtocolError {
    files :: r.read_strings() else return files
    d :: DeclReader { .fields = r, .files = files }
    return d.read_list(read_decl)
}

// A list after its count, each item read by `item`.
read_list :: fn<T>(d: DeclReader, item: fn(DeclReader) -> T | ProtocolError) -> T[] | ProtocolError {
    count :: d.fields.read_count() else return count
    items: T[]: []
    for _ in 0..<count {
        next :: item(d) else is ProtocolError {
            return next
        }
        items.push(next)
    }
    return items
}

// A value that may be absent, after its flag, read by `item`.
read_optional :: fn<T>(
    d: DeclReader,
    item: fn(DeclReader) -> T | ProtocolError,
) -> T | null | ProtocolError {
    present :: d.fields.read_flag() else return present
    if !present {
        return null
    }
    return item(d)
}

read_decl :: fn(d: DeclReader) -> AST.Decl | ProtocolError {
    tag :: d.fields.read_field() else return tag
    return match tag {
        "struct" -> d.read_struct()
        "fn"     -> d.read_fn()
        "enum"   -> d.read_enum()
        "trait"  -> d.read_trait()
        "impl"   -> d.read_impl()
        "alias"  -> d.read_alias()
        "const"  -> d.read_const()
        "assert" -> d.read_assert()
        "import" -> d.read_import()
        _        -> ProtocolError { .msg = "`${tag}` is no declaration" }
    }
}

// What a named declaration opens with, read back.
Head :: struct {
    span: Span
    name: string
    name_span: Span
    visibility: AST.Visibility
}

read_head :: fn(d: DeclReader) -> Head | ProtocolError {
    span :: d.read_span() else return span
    name :: d.fields.read_field() else return name
    name_span :: d.read_span() else return name_span
    visibility :: d.read_visibility() else return visibility
    return Head {
        .span = span,
        .name = name,
        .name_span = name_span,
        .visibility = visibility,
    }
}

read_struct :: fn(d: DeclReader) -> AST.StructDecl | ProtocolError {
    head :: d.read_head() else return head
    type_params :: d.read_type_params() else return type_params
    fields :: d.read_list(read_struct_field) else return fields
    spreads :: d.read_list(read_spread) else return spreads
    return AST.StructDecl {
        .span = head.span,
        .name = head.name,
        .name_span = head.name_span,
        .visibility = head.visibility,
        .type_params = type_params,
        .fields = fields,
        .spreads = spreads,
        .decorators = [],
    }
}

read_struct_field :: fn(d: DeclReader) -> AST.StructField | ProtocolError {
    span :: d.read_span() else return span
    name :: d.fields.read_field() else return name
    visibility :: d.read_visibility() else return visibility
    ty :: d.read_expr() else return ty
    default_value :: d.read_optional_expr() else is ProtocolError {
        return default_value
    }
    return AST.StructField {
        .span = span,
        .name = name,
        .ty = ty,
        .visibility = visibility,
        .default = default_value,
    }
}

read_spread :: fn(d: DeclReader) -> AST.StructSpread | ProtocolError {
    span :: d.read_span() else return span
    base :: d.read_expr() else return base
    at :: d.fields.read_integer() else return at
    return AST.StructSpread {
        .span = span,
        .base = base,
        .at = at,
    }
}

read_fn :: fn(d: DeclReader) -> AST.FnDecl | ProtocolError {
    head :: d.read_head() else return head
    type_params :: d.read_type_params() else return type_params
    params_span :: d.read_span() else return params_span
    params :: d.read_params() else return params
    return_type :: d.read_optional_expr() else is ProtocolError {
        return return_type
    }
    return AST.FnDecl {
        .span = head.span,
        .name = head.name,
        .name_span = head.name_span,
        .visibility = head.visibility,
        .type_params = type_params,
        .params = params,
        .params_span = params_span,
        .return_type = return_type,
        .body = null,
        .decorators = [],
        .sam_synthetic = false,
        .is_expression_bodied = false,
        .materialized = false,
    }
}

read_params :: fn(d: DeclReader) -> AST.FnParam[] | ProtocolError = d.read_list(read_param)

read_param :: fn(d: DeclReader) -> AST.FnParam | ProtocolError {
    span :: d.read_span() else return span
    name :: d.fields.read_field() else return name
    name_span :: d.read_span() else return name_span
    ty :: d.read_optional_expr() else is ProtocolError {
        return ty
    }
    default_value :: d.read_optional_expr() else is ProtocolError {
        return default_value
    }
    variadic :: d.fields.read_flag() else return variadic
    return AST.FnParam {
        .span = span,
        .name = name,
        .name_span = name_span,
        .ty = ty,
        .default_value = default_value,
        .variadic = variadic,
        .decorators = [],
    }
}

read_enum :: fn(d: DeclReader) -> AST.EnumDecl | ProtocolError {
    head :: d.read_head() else return head
    header :: d.read_exprs() else return header
    variants :: d.read_list(read_variant) else return variants
    return AST.EnumDecl {
        .span = head.span,
        .name = head.name,
        .name_span = head.name_span,
        .visibility = head.visibility,
        .header = header,
        .variants = variants,
        .decorators = [],
    }
}

read_variant :: fn(d: DeclReader) -> AST.EnumVariant | ProtocolError {
    span :: d.read_span() else return span
    name :: d.fields.read_field() else return name
    value :: d.fields.read_optional_integer() else is ProtocolError {
        return value
    }
    value_span :: d.read_optional_span() else is ProtocolError {
        return value_span
    }
    data :: d.read_optional(read_struct_items) else is ProtocolError {
        return data
    }
    return AST.EnumVariant {
        .span = span,
        .name = name,
        .value = value,
        .value_span = value_span,
        .data = data,
    }
}

read_trait :: fn(d: DeclReader) -> AST.TraitDecl | ProtocolError {
    head :: d.read_head() else return head
    type_params :: d.read_type_params() else return type_params
    requires :: d.read_optional_expr() else is ProtocolError {
        return requires
    }
    members :: d.read_members() else return members
    return AST.TraitDecl {
        .span = head.span,
        .name = head.name,
        .name_span = head.name_span,
        .visibility = head.visibility,
        .type_params = type_params,
        .requires = requires,
        .members = members,
        .decorators = [],
    }
}

read_impl :: fn(d: DeclReader) -> AST.ImplDecl | ProtocolError {
    span :: d.read_span() else return span
    type_params :: d.read_type_params() else return type_params
    trait_name :: d.fields.read_field() else return trait_name
    trait_name_span :: d.read_span() else return trait_name_span
    trait_args :: d.read_exprs() else return trait_args
    for_type :: d.read_expr() else return for_type
    members :: d.read_members() else return members
    return AST.ImplDecl {
        .span = span,
        .type_params = type_params,
        .for_type = for_type,
        .trait_name = trait_name,
        .trait_name_span = trait_name_span,
        .trait_args = trait_args,
        .members = members,
        .decorators = [],
    }
}

read_members :: fn(d: DeclReader) -> AST.FnDecl[] | ProtocolError = d.read_list(read_fn)

read_alias :: fn(d: DeclReader) -> AST.TypeAliasDecl | ProtocolError {
    head :: d.read_head() else return head
    type_params :: d.read_type_params() else return type_params
    aliased :: d.read_expr() else return aliased
    return AST.TypeAliasDecl {
        .span = head.span,
        .name = head.name,
        .name_span = head.name_span,
        .visibility = head.visibility,
        .type_params = type_params,
        .aliased = aliased,
        .decorators = [],
    }
}

read_const :: fn(d: DeclReader) -> AST.ConstDecl | ProtocolError {
    head :: d.read_head() else return head
    ty :: d.read_optional_expr() else is ProtocolError {
        return ty
    }
    value :: d.read_expr() else return value
    return AST.ConstDecl {
        .span = head.span,
        .name = head.name,
        .name_span = head.name_span,
        .visibility = head.visibility,
        .ty = ty,
        .value = value,
        .decorators = [],
    }
}

read_assert :: fn(d: DeclReader) -> AST.AssertDecl | ProtocolError {
    span :: d.read_span() else return span
    condition :: d.read_expr() else return condition
    message :: d.fields.read_optional_field() else is ProtocolError {
        return message
    }
    message_span :: d.read_optional_span() else is ProtocolError {
        return message_span
    }
    return AST.AssertDecl {
        .span = span,
        .condition = condition,
        .message = message,
        .message_span = message_span,
        .decorators = [],
    }
}

read_type_params :: fn(d: DeclReader) -> AST.TypeParam[] | ProtocolError =
    d.read_list(read_type_param)

read_type_param :: fn(d: DeclReader) -> AST.TypeParam | ProtocolError {
    span :: d.read_span() else return span
    name :: d.fields.read_field() else return name
    bound :: d.read_optional_expr() else is ProtocolError {
        return bound
    }
    default_type :: d.read_optional_expr() else is ProtocolError {
        return default_type
    }
    return AST.TypeParam {
        .span = span,
        .name = name,
        .bound = bound,
        .default = default_type,
    }
}

read_import :: fn(d: DeclReader) -> AST.ImportDecl | ProtocolError {
    span :: d.read_span() else return span
    path :: d.fields.read_field() else return path
    binding :: d.read_import_binding() else return binding
    return AST.ImportDecl {
        .span = span,
        .path = path,
        .binding = binding,
        .decorators = [],
    }
}

read_import_binding :: fn(d: DeclReader) -> AST.ImportBinding | ProtocolError {
    form :: d.fields.read_field() else return form
    return match form {
        "namespace"   -> d.read_namespace_binding()
        "destructure" -> d.read_destructure_binding()
        "wildcard"    -> AST.WildcardImport {}
        _             -> ProtocolError { .msg = "`${form}` is no import binding" }
    }
}

read_namespace_binding :: fn(d: DeclReader) -> AST.NamedNamespaceImport | ProtocolError {
    name :: d.fields.read_field() else return name
    return AST.NamedNamespaceImport { .name = name }
}

read_destructure_binding :: fn(d: DeclReader) -> AST.DestructureImport | ProtocolError {
    names :: d.read_list(read_import_name) else return names
    return AST.DestructureImport { .names = names }
}

read_import_name :: fn(d: DeclReader) -> AST.ImportName | ProtocolError {
    span :: d.read_span() else return span
    name :: d.fields.read_field() else return name
    alias :: d.fields.read_optional_field() else is ProtocolError {
        return alias
    }
    return AST.ImportName { .name = name, .alias = alias, .span = span }
}

// A flag rather than a rank: an enum converted from its rank through a namespace
// alias does not lower (M5007).
read_visibility :: fn(d: DeclReader) -> AST.Visibility | ProtocolError {
    public :: d.fields.read_flag() else return public
    return if public { .Public } else { .Private }
}

read_span :: fn(d: DeclReader) -> Span | ProtocolError {
    index :: d.fields.read_integer() else return index
    if index < 0 || index >= d.files.len() {
        return ProtocolError { .msg = "a span names file ${index} of ${d.files.len()}" }
    }
    file :: d.files[index]
    start :: d.fields.read_place(file) else return start
    end :: d.fields.read_place(file) else return end
    return Span { .start = start, .end = end }
}

read_optional_span :: fn(d: DeclReader) -> Span | null | ProtocolError = d.read_optional(read_span)

// ---- tests ----------------------------------------------------------------

import "std/abort"
import "std/testing"
import "toolchain/parser"

// One declaration of each form, each type form among the fields.
SAMPLE :: """
    module "app"

    import "std/io"
    J :: import "json"
    import "std/string" { join as join_strings }

    Point :: struct {
        x: i32
        tags: string[]
        pair: [i32, string]
        maybe: Point | null
        small: 0..=255
        counts: Map<string, i64>
        value: J.JsonValue
        callback: fn(i32) -> bool
    }

    export area :: fn(p: Point, scale: f64) -> f64 = 0.0

    Colour :: enum(u8) { Red, Green = 4 }

    Shape :: trait {
        area :: fn(self) -> f64
        describe :: fn(self) -> string = "a shape"
    }

    Point implements Shape {
        area :: fn(self) -> f64 = 1.0
    }

    Pair<T> :: [T, T]

    Box :: struct<T: Shape = Point> {
        item: T
    }

    first :: fn<T>(items: T[]) -> T | null = null

    Box<T> implements<T: Shape> Shape {
        area :: fn(self) -> f64 = 2.0
    }

    LIMIT :: 10

    @assert(LIMIT > 0)

    Base :: struct {
        id: i64 = 0
    }

    Account :: struct {
        ...Base
        name: string = "anonymous"
    }

    Lean :: enum(Base) {
        East { .id = 90 },
        West { .id = 270 },
    }

    greet :: fn(name: string = "world") -> string = name

    TABLE :: @comptime [1, 2, 3]
    """

sample_declarations :: fn() -> AST.Decl[] = parse_source(SAMPLE, "src/app.vader").program.decls

crossing_sample :: fn() -> AST.Decl[] = sample_declarations().filter(crosses).collect()

crossed_sample :: fn() -> AST.Decl[] = crossed(SAMPLE)

// The declarations of `source` that cross, once they crossed.
crossed :: fn(source: string) -> AST.Decl[] {
    decls :: parse_source(source, "src/app.vader").program.decls.filter(crosses).collect()
    back :: decode_declarations(encode_declarations(decls))
        else panic("the declarations do not read back: ${back.msg}")
    return back
}

@test
test_declarations_read_back_as_written :: fn() -> void {
    decls :: crossed_sample()
    assert_eq(decls.len(), 19)
    assert_eq(encode_declarations(decls), encode_declarations(crossing_sample()))
}

@test
test_a_constant_crosses_with_its_value :: fn() -> void {
    limit :: crossed_sample()[12]
    if limit !is AST.ConstDecl {
        assert(false, "the thirteenth declaration is `LIMIT`")
        return
    }
    assert_eq(limit.name, "LIMIT")
    assert(limit.value is AST.IntLitExpr, "`10`")
}

@test
test_an_assertion_crosses_with_its_condition :: fn() -> void {
    assertion :: crossed_sample()[13]
    if assertion !is AST.AssertDecl {
        assert(false, "the fourteenth declaration is the `@assert`")
        return
    }
    assert(assertion.condition is AST.BinaryExpr, "`LIMIT > 0`")
}

@test
test_a_comptime_constant_crosses_with_what_it_is_written_with :: fn() -> void {
    decls :: sample_declarations()
    helpers :: decls.filter((d: AST.Decl) -> d is AST.FnDecl && d.comptime_synthetic).collect()
    assert_eq(helpers.len(), 1)
    assert(!crosses(helpers[0]), "the helper the parser made")
    table :: crossed_sample()[18]
    if table !is AST.ConstDecl {
        assert(false, "the last declaration is `TABLE`")
        return
    }
    assert(table.value is AST.SeqLitExpr, "`[1, 2, 3]`, not a call to the helper")
}

@test
test_a_struct_keeps_its_defaults_and_what_it_spreads :: fn() -> void {
    account :: crossed_sample()[15]
    if account !is AST.StructDecl {
        assert(false, "the sixteenth declaration is `Account`")
        return
    }
    assert_eq(account.spreads.len(), 1)
    assert(account.spreads[0].base is AST.IdentExpr, "`...Base`")
    assert(account.fields[0].default is AST.StringLitExpr, "`= \"anonymous\"`")
}

@test
test_a_parameter_keeps_its_default :: fn() -> void {
    greet :: crossed_sample()[17]
    if greet !is AST.FnDecl {
        assert(false, "the eighteenth declaration is `greet`")
        return
    }
    assert(greet.params[0].default_value is AST.StringLitExpr, "`= \"world\"`")
}

@test
test_a_variant_keeps_its_data :: fn() -> void {
    lean :: crossed_sample()[16]
    if lean !is AST.EnumDecl {
        assert(false, "the seventeenth declaration is `Lean`")
        return
    }
    data :: lean.variants[1].data else panic("`West` has data")
    assert_eq(data.len(), 1)
    field :: data[0]
    if field !is AST.StructLitField {
        assert(false, "`.id = 270` is a field")
        return
    }
    assert_eq(field.name, "id")
}

@test
test_a_struct_keeps_its_fields_and_their_types :: fn() -> void {
    point :: crossed_sample()[3]
    if point !is AST.StructDecl {
        assert(false, "the fourth declaration is `Point`")
        return
    }
    assert_eq(point.name, "Point")
    assert_eq(point.name_span.start.file, "src/app.vader")
    assert_eq(point.name_span.start.line, 7)
    assert_eq(point.fields.len(), 8)
    assert(point.fields[1].ty is AST.ArrayTypeExpr, "`string[]`")
    assert(point.fields[2].ty is AST.SeqLitExpr, "`[i32, string]`")
    assert(point.fields[3].ty is AST.BinaryExpr, "`Point | null`")
    assert(point.fields[4].ty is AST.RangeExpr, "`0..=255`")
    assert(point.fields[5].ty is AST.GenericInstExpr, "`Map<string, i64>`")
    assert(point.fields[6].ty is AST.FieldExpr, "`J.JsonValue`")
    assert(point.fields[7].ty is AST.FnTypeExpr, "`fn(i32) -> bool`")
}

@test
test_a_function_keeps_its_signature_and_loses_its_body :: fn() -> void {
    area :: crossed_sample()[4]
    if area !is AST.FnDecl {
        assert(false, "the fifth declaration is `area`")
        return
    }
    assert(area.visibility == .Public, "`area` is exported")
    assert_eq(area.params.len(), 2)
    assert_eq(area.params[1].name, "scale")
    assert(area.return_type != null, "`-> f64`")
    assert(area.body == null, "a body does not cross")
}

@test
test_type_parameters_keep_their_bound_and_default :: fn() -> void {
    box :: crossed_sample()[9]
    if box !is AST.StructDecl {
        assert(false, "the tenth declaration is `Box`")
        return
    }
    assert_eq(box.type_params.len(), 1)
    assert_eq(box.type_params[0].name, "T")
    assert(box.type_params[0].bound is AST.IdentExpr, "`: Shape`")
    assert(box.type_params[0].default is AST.IdentExpr, "`= Point`")
}

@test
test_a_function_keeps_its_type_parameters :: fn() -> void {
    first :: crossed_sample()[10]
    if first !is AST.FnDecl {
        assert(false, "the eleventh declaration is `first`")
        return
    }
    assert_eq(first.type_params.len(), 1)
    assert(first.type_params[0].bound == null, "`T` is unbounded")
}

@test
test_a_trait_keeps_its_members_without_their_defaults :: fn() -> void {
    shape :: crossed_sample()[6]
    if shape !is AST.TraitDecl {
        assert(false, "the seventh declaration is `Shape`")
        return
    }
    assert_eq(shape.members.len(), 2)
    assert_eq(shape.members[1].name, "describe")
    assert(shape.members[1].return_type != null, "`-> string`")
    assert(shape.members[1].body == null, "a default body does not cross")
}

@test
test_an_impl_keeps_its_type_parameters_and_members :: fn() -> void {
    impl :: crossed_sample()[11]
    if impl !is AST.ImplDecl {
        assert(false, "the twelfth declaration is the impl for `Box`")
        return
    }
    assert_eq(impl.type_params.len(), 1)
    assert(impl.type_params[0].bound is AST.IdentExpr, "`<T: Shape>`")
    assert_eq(impl.members.len(), 1)
    assert_eq(impl.members[0].name, "area")
}

@test
test_a_member_the_compiler_declared_does_not_cross :: fn() -> void {
    impl :: crossing_sample()[11]
    if impl !is AST.ImplDecl {
        assert(false, "the twelfth declaration is the impl for `Box`")
        return
    }
    impl.members[0].materialized = true
    crossed :: decode_declarations(encode_declarations([impl]))
        else panic("the impl does not read back: ${crossed.msg}")
    read :: crossed[0]
    if read !is AST.ImplDecl {
        assert(false, "an impl reads back as one")
        return
    }
    assert_eq(read.members.len(), 0)
}

@test
test_an_enum_keeps_its_variants_and_their_values :: fn() -> void {
    colour :: crossed_sample()[5]
    if colour !is AST.EnumDecl {
        assert(false, "the sixth declaration is `Colour`")
        return
    }
    assert_eq(colour.variants.len(), 2)
    assert(colour.variants[0].value == null, "`Red` takes the next value")
    assert_eq(colour.variants[1].name, "Green")
    assert_eq(colour.variants[1].value else -1, 4)
}

@test
test_decode_refuses_a_span_naming_no_file :: fn() -> void {
    // No file in the table, one struct whose span names file 0.
    text :: "1:01:16:struct1:0"
    assert(decode_declarations(text) is ProtocolError, "file 0 of 0")
}

@test
test_decode_refuses_an_unknown_declaration :: fn() -> void {
    assert(decode_declarations("1:01:15:macro") is ProtocolError, "no `macro` form")
}
