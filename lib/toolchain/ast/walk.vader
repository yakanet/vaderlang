// toolchain/ast/walk: one walk over every node under a node.
//
// `inspect` reaches every child of every node, so a pass that looks for
// something in a subtree writes only what it looks for, and cannot forget a
// field (a cast's target type, a lambda's return type) the way a hand-written
// walk can. Its match is exhaustive: a new node kind trips T3013 here, once,
// rather than going unseen in every walk.

module "toolchain/ast"

// ---- the walk -------------------------------------------------------------

/// Any node `inspect` hands its visitor: a declaration, an expression (a type
/// expression included, `TypeExpr` being the same union), a statement or a
/// pattern.
export Node :: Decl | Expr | Stmt | Pattern

/// What the visitor of `inspect` answers for the node it was handed.
export Walk :: enum {
    /// Visit the node's children next.
    Descend,
    /// Leave the node's children out, and go on with the rest of the walk.
    Skip,
    /// End the whole walk.
    Stop,
}

/// Walk `n` and every node under it, root first, children in source order.
///
/// Every child is reached: type positions (a parameter's type, a cast's target,
/// an `is` pattern's type), decorator arguments, lambda and `defer` bodies, the
/// statement a `??` falls back to. A node shared with another field is reached
/// once: the place of a compound assignment `x op= y` is the left operand of its
/// value, and a `@comptime` const leaves its `comptime_body` and its type to the
/// helper fn the parser synthesised, which holds both. What is not a node (a
/// binding, a field name) is for the visitor to read on the node
/// that carries it.
///
/// `leave` closes every node `visit` opened: it runs after the node's children,
/// or right away when `visit` answered `Skip`, so a scope pushed on the way in is
/// always popped on the way out. `Stop` ends the walk with no further call.
///
/// @param n      the root.
/// @param visit  called on every node reached ; its answer steers the walk.
/// @param leave  called on every node `visit` answered `Descend` or `Skip`,
///               once its children are walked.
/// @return       true when the visitor answered `Stop`.
/// @example
///   names: string[]: []
///   inspect(decl, (n) -> {
///       if n is IdentExpr {
///           names.push(n.name)
///       }
///       return .Descend
///   })
export inspect :: fn(
    n: Node,
    visit: fn(Node) -> Walk,
    leave: fn(Node) -> void = ignore_node,
) -> bool {
    answer :: visit(n)
    if answer == .Stop {
        return true
    }
    if answer == .Descend {
        // No `_ ->`: it would let a new node kind hide its children from every walk.
        stopped :: match n {
            is IntLitExpr | FloatLitExpr | BoolLitExpr | NullLitExpr | CharLitExpr -> false
            is StringLitExpr -> inspect_parts(n.parts, visit, leave)
            is IdentExpr | DotVariantExpr -> false
            is CallExpr -> inspect_call(n, visit, leave)
            is FieldExpr -> inspect(n.target, visit, leave)
            is IndexExpr -> inspect(n.target, visit, leave) || inspect(n.index, visit, leave)
            is UnaryExpr -> inspect(n.operand, visit, leave)
            is BinaryExpr -> inspect(n.left, visit, leave) || inspect(n.right, visit, leave)
            is NullCoalesceExpr -> inspect(n.left, visit, leave)
                || inspect(n.fallback, visit, leave)
            is IfExpr -> inspect_if(n, visit, leave)
            is MatchExpr -> inspect(n.scrutinee, visit, leave) || inspect_arms(n.arms, visit, leave)
            is BlockExpr -> inspect_stmts(n.stmts, visit, leave)
                || inspect_maybe(n.trailing, visit, leave)
            is LambdaExpr -> inspect_lambda(n, visit, leave)
            is StructLitExpr -> inspect(n.type_name, visit, leave)
                || inspect_items(n.items, visit, leave)
            is SeqLitExpr -> inspect_exprs(n.elements, visit, leave)
            is RangeExpr -> inspect(n.lower, visit, leave) || inspect(n.upper, visit, leave)
            is CastExpr -> inspect(n.value, visit, leave) || inspect(n.target, visit, leave)
            is GenericInstExpr -> inspect(n.callee, visit, leave)
                || inspect_exprs(n.type_args, visit, leave)
            is IntrinsicCallExpr -> inspect_exprs(n.args, visit, leave)
            is FnTypeExpr -> inspect_exprs(n.params, visit, leave)
                || inspect_maybe(n.return_type, visit, leave)
            is ArrayTypeExpr -> inspect(n.element, visit, leave)
            is AwaitExpr -> inspect(n.inner, visit, leave)
            is LetStmt -> inspect_maybe(n.ty, visit, leave) || inspect(n.value, visit, leave)
            is AssignStmt -> inspect_assign(n, visit, leave)
            is DestructureAssignStmt -> inspect_targets(n.targets, visit, leave)
                || inspect(n.value, visit, leave)
            is ExprStmt -> inspect(n.expr, visit, leave)
            is ReturnStmt -> inspect_maybe(n.value, visit, leave)
            is YieldStmt -> inspect(n.value, visit, leave)
            is ForStmt -> inspect_form(n.form, visit, leave) || inspect(n.body, visit, leave)
            is BreakStmt | ContinueStmt -> false
            is DeferStmt -> inspect_defer(n.body, visit, leave)
            is IsPattern -> inspect(n.ty, visit, leave) || inspect_maybe(n.inner, visit, leave)
            is StructPattern -> inspect_pattern_fields(n.fields, visit, leave)
            is WildcardPattern | EnumVariantPattern -> false
            is LiteralPattern -> inspect(n.value, visit, leave)
            is RangePattern -> inspect(n.lower, visit, leave) || inspect(n.upper, visit, leave)
            is OrPattern -> inspect_patterns(n.patterns, visit, leave)
            is ImportDecl -> inspect_decorators(n.decorators, visit, leave)
            is FnDecl -> inspect_fn(n, visit, leave)
            is StructDecl -> inspect_struct(n, visit, leave)
            is EnumDecl -> inspect_enum(n, visit, leave)
            is TraitDecl -> inspect_trait(n, visit, leave)
            is ImplDecl -> inspect_impl(n, visit, leave)
            is TypeAliasDecl -> inspect_alias(n, visit, leave)
            is ConstDecl -> inspect_const(n, visit, leave)
            is AssertDecl -> inspect_decorators(n.decorators, visit, leave)
                || inspect(n.condition, visit, leave)
        }
        if stopped {
            return true
        }
    }
    leave(n)
    return false
}

// The default `leave`: a walk that only looks on the way in.
ignore_node :: fn(n: Node) -> void {}

inspect_maybe :: fn(n: Node | null, visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool {
    present :: n ?? return false
    return inspect(present, visit, leave)
}

// ---- expressions ----------------------------------------------------------

inspect_call :: fn(c: CallExpr, visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool {
    if inspect(c.callee, visit, leave) || inspect_exprs(c.type_args, visit, leave) {
        return true
    }
    for a in c.args {
        if inspect(a.value, visit, leave) {
            return true
        }
    }
    return false
}

inspect_if :: fn(i: IfExpr, visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool {
    if inspect(i.cond, visit, leave) || inspect(i.then_block, visit, leave) {
        return true
    }
    return match tail :: i.else_branch {
        is null        -> false
        is IfElseIf    -> inspect(tail.branch, visit, leave)
        is IfElseBlock -> inspect(tail.block, visit, leave)
    }
}

inspect_arms :: fn(arms: MatchArm[], visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool {
    for arm in arms {
        if inspect(arm.pattern, visit, leave) || inspect_maybe(arm.guard, visit, leave)
            || inspect(arm.body, visit, leave) {
            return true
        }
    }
    return false
}

inspect_lambda :: fn(l: LambdaExpr, visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool =
    inspect_params(l.params, visit, leave) || inspect_maybe(l.return_type, visit, leave)
        || inspect(l.body, visit, leave)

inspect_items :: fn(
    items: StructLitItem[],
    visit: fn(Node) -> Walk,
    leave: fn(Node) -> void,
) -> bool {
    for item in items {
        if inspect(struct_item_value(item), visit, leave) {
            return true
        }
    }
    return false
}

struct_item_value :: fn(item: StructLitItem) -> Expr = match item {
    is StructLitField  -> item.value
    is StructLitSpread -> item.expr
}

inspect_parts :: fn(
    parts: StringLitPart[],
    visit: fn(Node) -> Walk,
    leave: fn(Node) -> void,
) -> bool {
    for part in parts {
        if part is StringLitInterp && inspect(part.expr, visit, leave) {
            return true
        }
    }
    return false
}

inspect_exprs :: fn(es: Expr[], visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool {
    for e in es {
        if inspect(e, visit, leave) {
            return true
        }
    }
    return false
}

// ---- statements -----------------------------------------------------------

// The place of `x op= y` is `value.left`, one node : visiting `target` too would
// hand the visitor the same node twice.
inspect_assign :: fn(s: AssignStmt, visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool {
    if compound_assign_op(s) != null {
        return inspect(s.value, visit, leave)
    }
    return inspect(s.target, visit, leave) || inspect(s.value, visit, leave)
}

inspect_targets :: fn(
    targets: AssignTarget[],
    visit: fn(Node) -> Walk,
    leave: fn(Node) -> void,
) -> bool {
    for t in targets {
        match t {
            is PlaceTarget | RestTarget -> {
                if inspect(t.place, visit, leave) {
                    return true
                }
            }
            is WildcardTarget           -> {}
        }
    }
    return false
}

inspect_form :: fn(
    form: ForForm,
    visit: fn(Node) -> Walk,
    leave: fn(Node) -> void,
) -> bool = match form {
    is InFor       -> inspect(form.iter, visit, leave)
    is WhileFor    -> inspect(form.cond, visit, leave)
    is InfiniteFor -> false
}

inspect_defer :: fn(
    body: DeferBody,
    visit: fn(Node) -> Walk,
    leave: fn(Node) -> void,
) -> bool = match body {
    is DeferStmtBody  -> inspect(body.stmt, visit, leave)
    is DeferBlockBody -> inspect(body.block, visit, leave)
}

inspect_stmts :: fn(ss: Stmt[], visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool {
    for s in ss {
        if inspect(s, visit, leave) {
            return true
        }
    }
    return false
}

// ---- patterns -------------------------------------------------------------

inspect_pattern_fields :: fn(
    fields: StructPatternField[],
    visit: fn(Node) -> Walk,
    leave: fn(Node) -> void,
) -> bool {
    for f in fields {
        value :: f.value
        if value is PatternLiteral && inspect(value.value, visit, leave) {
            return true
        }
    }
    return false
}

inspect_patterns :: fn(ps: Pattern[], visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool {
    for p in ps {
        if inspect(p, visit, leave) {
            return true
        }
    }
    return false
}

// ---- declarations ---------------------------------------------------------

inspect_fn :: fn(f: FnDecl, visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool =
    inspect_decorators(f.decorators, visit, leave)
        || inspect_type_params(f.type_params, visit, leave)
        || inspect_params(f.params, visit, leave)
        || inspect_maybe(f.return_type, visit, leave)
        || inspect_maybe(f.body, visit, leave)

inspect_struct :: fn(s: StructDecl, visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool {
    if inspect_decorators(s.decorators, visit, leave)
        || inspect_type_params(s.type_params, visit, leave) {
        return true
    }
    for field in s.fields {
        if inspect(field.ty, visit, leave)
            || inspect_maybe(field.default, visit, leave) {
            return true
        }
    }
    return false
}

inspect_enum :: fn(e: EnumDecl, visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool {
    if inspect_decorators(e.decorators, visit, leave) || inspect_exprs(e.header, visit, leave) {
        return true
    }
    for v in e.variants {
        data :: v.data ?? continue
        if inspect_items(data, visit, leave) {
            return true
        }
    }
    return false
}

inspect_trait :: fn(t: TraitDecl, visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool =
    inspect_decorators(t.decorators, visit, leave)
        || inspect_type_params(t.type_params, visit, leave)
        || inspect_maybe(t.requires, visit, leave)
        || inspect_fns(t.members, visit, leave)

inspect_impl :: fn(i: ImplDecl, visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool =
    inspect_decorators(i.decorators, visit, leave)
        || inspect_type_params(i.type_params, visit, leave)
        || inspect(i.for_type, visit, leave)
        || inspect_exprs(i.trait_args, visit, leave)
        || inspect_fns(i.members, visit, leave)

inspect_alias :: fn(a: TypeAliasDecl, visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool =
    inspect_decorators(a.decorators, visit, leave)
        || inspect_type_params(a.type_params, visit, leave)
        || inspect(a.aliased, visit, leave)

inspect_const :: fn(c: ConstDecl, visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool =
    inspect_decorators(c.decorators, visit, leave) || inspect_maybe(own_const_type(c), visit, leave)
        || inspect(c.value, visit, leave)

// A `@comptime` const's type is its helper fn's return type, one node.
own_const_type :: fn(c: ConstDecl) -> TypeExpr | null {
    if c.comptime_body != null {
        return null
    }
    return c.ty
}

inspect_fns :: fn(fs: FnDecl[], visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool {
    for f in fs {
        if inspect(f, visit, leave) {
            return true
        }
    }
    return false
}

inspect_params :: fn(ps: FnParam[], visit: fn(Node) -> Walk, leave: fn(Node) -> void) -> bool {
    for p in ps {
        if inspect_decorators(p.decorators, visit, leave)
            || inspect_maybe(p.ty, visit, leave)
            || inspect_maybe(p.default_value, visit, leave) {
            return true
        }
    }
    return false
}

inspect_type_params :: fn(
    ps: TypeParam[],
    visit: fn(Node) -> Walk,
    leave: fn(Node) -> void,
) -> bool {
    for p in ps {
        if inspect_maybe(p.bound, visit, leave)
            || inspect_maybe(p.default, visit, leave) {
            return true
        }
    }
    return false
}

inspect_decorators :: fn(
    ds: Decorator[],
    visit: fn(Node) -> Walk,
    leave: fn(Node) -> void,
) -> bool {
    for d in ds {
        if inspect_exprs(d.args, visit, leave) {
            return true
        }
    }
    return false
}

// ---- tests ----------------------------------------------------------------

import "std/string"
import "std/testing"
import "toolchain/span"

ident :: fn(name: string) -> IdentExpr = IdentExpr {
    .span = empty_span(),
    .name = name,
    .implicit_dot = false,
}

// The names of the identifiers `inspect` reaches under `n`, in visiting order ;
// `skip_lambdas` answers `Skip` on a lambda.
idents_reached :: fn(n: Node, skip_lambdas: bool) -> string[] {
    out: string[]: []
    inspect(n, (m) -> record_ident(m, out, skip_lambdas, ""))
    return out
}

// Records each identifier in `out` ; answers `Skip` on a lambda when
// `skip_lambdas`, and `Stop` on the identifier called `stop_at`.

record_ident :: fn(n: Node, out: string[], skip_lambdas: bool, stop_at: string) -> Walk {
    if n is LambdaExpr && skip_lambdas {
        return .Skip
    }
    if n is IdentExpr {
        out.push(n.name)
        if n.name == stop_at {
            return .Stop
        }
    }
    return .Descend
}

sum_of :: fn(left: Expr, right: Expr) -> BinaryExpr = BinaryExpr {
    .span = empty_span(),
    .op = .Add,
    .left = left,
    .right = right,
}

empty_block :: fn(trailing: Expr) -> BlockExpr = BlockExpr {
    .span = empty_span(),
    .stmts = [],
    .trailing = trailing,
}

lambda_of :: fn(param_type: Expr, body: Expr) -> LambdaExpr {
    param :: FnParam {
        .span = empty_span(),
        .name = "x",
        .name_span = empty_span(),
        .ty = param_type,
        .default_value = null,
        .variadic = false,
        .decorators = [],
    }
    return LambdaExpr {
        .span = empty_span(),
        .params = [param],
        .return_type = null,
        .body = empty_block(body),
    }
}

@test
test_inspect_reaches_type_positions :: fn() -> void {
    cast :: CastExpr {
        .span = empty_span(),
        .target = ident("Target"),
        .value = ident("value"),
    }
    assert_eq(idents_reached(cast, false).join(" "), "value Target")
}

@test
test_inspect_enters_a_lambda_unless_skipped :: fn() -> void {
    call :: CallExpr {
        .span = empty_span(),
        .callee = ident("apply"),
        .args = [
            CallArg {
                .span = empty_span(),
                .name = null,
                .value = lambda_of(ident("Param"), ident("inner")),
                .spread = false,
            },
        ],
    }
    assert_eq(idents_reached(call, false).join(" "), "apply Param inner")
    assert_eq(idents_reached(call, true).join(" "), "apply")
}

@test
test_inspect_stop_ends_the_walk :: fn() -> void {
    sum :: sum_of(sum_of(ident("a"), ident("b")), ident("c"))
    out: string[]: []
    assert(inspect(sum, (n) -> record_ident(n, out, false, "b")), "the walk reports its stop")
    assert_eq(out.join(" "), "a b")
}

@test
test_inspect_visits_a_compound_assignment_place_once :: fn() -> void {
    place :: ident("total")
    assign :: AssignStmt {
        .span = empty_span(),
        .target = place,
        .value = sum_of(place, ident("step")),
    }
    assert_eq(idents_reached(assign, false).join(" "), "total step")
}

// The order `leave` closes the nodes under `n`: identifiers by name, a binary
// expression as `op`, a lambda as `fn` ; `visit` skips lambdas and stops on
// `stop_at`. `record_ident` only steers the walk here: what it records is
// dropped.
nodes_left :: fn(n: Node, stop_at: string) -> string {
    out: string[]: []
    inspect(
        n,
        (m) -> record_ident(m, [], true, stop_at),
        (m) -> out.push(left_name(m)),
    )
    return out.join(" ")
}

// @partial: the trees these tests build hold nothing else.
left_name :: fn(n: Node) -> string = @partial match n {
    is IdentExpr  -> n.name
    is BinaryExpr -> "op"
    is LambdaExpr -> "fn"
    _             -> "?"
}

@test
test_inspect_leaves_children_before_their_parent :: fn() -> void {
    assert_eq(nodes_left(sum_of(ident("a"), ident("b")), ""), "a b op")
}

@test
test_inspect_leaves_a_skipped_node :: fn() -> void {
    sum :: sum_of(lambda_of(ident("Param"), ident("inner")), ident("b"))
    assert_eq(nodes_left(sum, ""), "fn b op")
}

@test
test_inspect_stop_leaves_nothing_more :: fn() -> void {
    assert_eq(nodes_left(sum_of(ident("a"), ident("b")), "b"), "a")
}
