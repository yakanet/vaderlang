// toolchain/ast/ast.vader: the shape of written Vader, as data.
//
// The public contract a build-time metaprogram reads. It lives outside `vader/`
// because of what depends on it: a library shipping a generator must be able to
// walk declarations without depending on the compiler, and this module needs
// nothing from the compiler either: only `toolchain/span`, for where each node
// came from. Everything that INTERPRETS these nodes (resolve, typecheck, lower)
// stays in `vader/`.
//
// It is the tree AS WRITTEN, before resolution: an `IdentExpr("Id")` is the name
// the author typed, not the type it denotes. A generator that needs to know
// whether that name is a primitive, an alias, an imported struct or a distinct
// newtype cannot answer it from here, see the note on resolved declarations in
// the TODO's toolchain item.
//
// Layout note : declaration order is free, the resolver collects every
// decl name in a first pass before walking types in the second, so a
// union alias can sit before or after the variant structs it lists.
// Type-bearing fields are renamed `ty` (since `type` was historically a
// keyword) ; the dumper emits the JSON key as `"type"` so snapshots
// stay stable.

module "toolchain/ast"

import "std/iter"
import "toolchain/span"

/// Sentinel `id` on a node the parser has just minted.
///
/// Node ids are assigned in a later pass (`toolchain/parser::assign_program_ids`), which
/// replaces this with a fresh unique value (>= 1), so a freshly parsed tree carries
/// the sentinel everywhere. A generator reading a typechecked tree sees real ids;
/// one building nodes by hand leaves them at the default: it is every node's
/// `.id` default, so a construction may omit the field.
export UNASSIGNED_NODE_ID :i64 : 0

// ---- Type aliases (declared first, see header) ----------------------------

/// Anything that can appear at the top level of a file.
export Decl :: ImportDecl | FnDecl | StructDecl | EnumDecl | TraitDecl | ImplDecl | TypeAliasDecl | ConstDecl | AssertDecl

/// What an `import` binds: a namespace alias, a modifier list, or nothing.
///
/// The three forms of SPEC §Modules: `X :: import "p"`, `import "p" { a as b }`,
/// and the bare `import "p"` wildcard.
export ImportBinding :: NamedNamespaceImport | DestructureImport | WildcardImport

/// Which of the three `for` shapes a loop is: `for {}`, `for cond {}`, `for x in xs {}`.
export ForForm :: InfiniteFor | WhileFor | InFor

/// Any expression. Also serves as `TypeExpr`, see the note there.
export Expr :: IntLitExpr | FloatLitExpr | BoolLitExpr | NullLitExpr | CharLitExpr | StringLitExpr | IdentExpr | CallExpr | FieldExpr | IndexExpr | UnaryExpr | BinaryExpr | FallbackExpr | IfExpr | MatchExpr | BlockExpr | LambdaExpr | StructLitExpr | SeqLitExpr | RangeExpr | CastExpr | GenericInstExpr | IntrinsicCallExpr | DotVariantExpr | FnTypeExpr | ArrayTypeExpr

/// One piece of a string literal: literal text, or an interpolated expression.
export StringLitPart :: StringLitText | StringLitInterpolation

/// What follows an `else`: another `if` branch, or a final block.
export IfElse :: IfElseIf | IfElseBlock

/// Anything that can appear on the left of a `match` arm's `->`.
export Pattern :: IsPattern | StructPattern | WildcardPattern | EnumVariantPattern | LiteralPattern | RangePattern | OrPattern

/// What a `::` / `:=` binds: one name, a tuple destructure, `_`, or a rest binding.
export LetBinding :: SimpleBinding | TupleBinding | WildcardBinding | RestBinding

/// One element of a `[...] = value` assignment: a place, `_`, or a `...rest` tail.
export AssignTarget :: PlaceTarget | WildcardTarget | RestTarget

/// Inside a struct pattern, what a field is matched against: a binding or a literal.
export PatternFieldValue :: PatternBinding | PatternLiteral

/// What a fallback clause yields. Either a value expression or a divergent
/// statement (`return` / `break` / `continue`, typed `never`). The divergent
/// forms are statements (not `Expr` variants) so they are carried here
/// directly rather than through the `Expr` union.
export FallbackBody :: Expr | ReturnStmt | BreakStmt | ContinueStmt

/// The value expression a read-only expression walker should descend into
/// for a fallback clause : the fallback expression itself, the value of a
/// `return <expr>`, or `null` for a bare `return` / `break` / `continue`.
/// Passes that also need to visit the statement node itself (id assignment,
/// typecheck, formatting) destructure `FallbackBody` directly instead.
export fallback_body_expr :: fn(f: FallbackBody) -> Expr | null = match f {
    is ReturnStmt -> f.value
    is BreakStmt | ContinueStmt -> null
    is Expr -> f
}

/// The places a destructuring assignment writes, in order: every target but `_`.
///
/// For the walkers that visit a statement's sub-expressions and have no use for
/// each element's kind.
export assign_places :: fn(s: DestructureAssignStmt) -> Expr[] {
    out: Expr[]: []
    for t in s.targets {
        match t {
            is PlaceTarget | RestTarget -> { out.push(t.place) }
            is WildcardTarget           -> {}
        }
    }
    return out
}

/// A type AS WRITTEN: the same node set as `Expr`, deliberately.
///
/// Vader's type grammar is a subset of its expression grammar (`i32`, `Foo<T>`,
/// `A | B`, `fn(i32) -> bool`, `T[]`), so the parser reuses the expression nodes
/// rather than duplicating them. What counts as a type expression is decided by
/// POSITION (the slot demanding a type) never by node shape; the alias exists to
/// say so at each slot (`StructField.ty: TypeExpr`).
///
/// A reader must not assume an `IdentExpr` in type position denotes a type it can
/// name: `Id` may be an alias, an imported struct or a distinct newtype, and only
/// the resolver knows which.
export TypeExpr :: IntLitExpr | FloatLitExpr | BoolLitExpr | NullLitExpr | CharLitExpr | StringLitExpr | IdentExpr | CallExpr | FieldExpr | IndexExpr | UnaryExpr | BinaryExpr | FallbackExpr | IfExpr | MatchExpr | BlockExpr | LambdaExpr | StructLitExpr | SeqLitExpr | RangeExpr | CastExpr | GenericInstExpr | IntrinsicCallExpr | DotVariantExpr | FnTypeExpr | ArrayTypeExpr

// ---- Visibility / shared shapes -------------------------------------------

/// Whether a declaration carries `export`.
export Visibility :: enum {
    Public,
    Private,
}

// ---- Top-level ------------------------------------------------------------

/// One parsed source file.
///
/// `module` is null for a file with no `module "..."` header: an error the resolver
/// reports rather than the parser.
export Program :: struct {
    file:    string
    span:    Span
    id:      i64 = UNASSIGNED_NODE_ID
    /// The `module "..."` declaration. Null when absent: the parser
    /// is tolerant ; the resolver's scan emits R2020 on absence.
    module:  ModuleDecl | null = null
    decls:   Decl[]
}

/// The `module "<name>"` decl that opens every `.vader` file. Carries
/// the validated module name + its source span (the `module` keyword
/// itself lives in the node's overall `span`).
export ModuleDecl :: struct {
    span:       Span
    id:         i64 = UNASSIGNED_NODE_ID
    name:       string
    name_span:  Span
    /// The declared decorators written above `module`: the module's, added up
    /// with those of its other files.
    decorators: Decorator[] = []
}

// ---- Generics / Decorators ------------------------------------------------

/// One entry of a `<T: Bound = Default>` list.
export TypeParam :: struct {
    span:    Span
    id:      i64 = UNASSIGNED_NODE_ID
    name:    string
    bound:   TypeExpr | null
    /// Default type for this parameter, from `<T = Default>`. Honored when an
    /// impl supplies fewer trait-args than the trait declares: the trailing
    /// params fill from their defaults at impl materialization
    /// (`front/resolver/materialize.vader::build_subst`). Defaults on struct / fn /
    /// alias params parse but are not yet filled at their use sites (those
    /// instantiations error rather than default). `null` = no default.
    default: TypeExpr | null = null
}

/// An `@name`, `@name(args)` or `@Alias.name(args)` above a declaration.
export Decorator :: struct {
    span: Span
    id:   i64 = UNASSIGNED_NODE_ID
    /// The namespace alias written before the name, `J` in `@J.json_name`; null for
    /// a bare name.
    qualifier: IdentExpr | null = null
    name: string
    /// The name alone, without the `@` or the qualifier.
    name_span: Span
    /// Written as a call's: positional, then named (`@Route(.Get, path = "/")`).
    args: CallArg[]
    /// The module that declares the decorator, `http` for `@H.Route`: what the
    /// build tells a driver. Empty in the front end, and for a decorator of the
    /// compiler.
    module_name: string = ""
}

/// The decorator called `name` that `module_name` declares, among `decs`: what a
/// build driver looks for, since a name alone may be another module's.
///
/// @param decs         the decorators of a declaration, a field or a parameter,
///                     as the build hands them to a driver.
/// @param module_name  the module that declares the decorator (`json`).
/// @param name         the decorator name, without the `@`.
export find_declared_decorator :: fn(
    decs: Decorator[], module_name: string, name: string,
) -> Decorator | null = decs.find((d) -> d.module_name == module_name && d.name == name)

/// The C type a `@c_type("...")` among `decs` names, or `""` when none does or its
/// argument is not one plain string.
///
/// @param decs  the decorators of an `@extern` declaration or of one parameter.
export c_type_of :: fn(decs: Decorator[]) -> string {
    d :: find_compiler_decorator(decs, .CType) else return ""
    return sole_string_argument(d)
}

/// What an `@extern` writes, each part null when it is absent.
export ExternArguments :: struct {
    /// The `CLibrary` constant the symbol comes from: the first of two arguments.
    library: Expr | null = null
    /// The C symbol: the last argument, `symbol = "..."` when it stands alone.
    symbol:  Expr | null = null
}

/// The library and the symbol `d`, an `@extern`, writes.
///
/// @param d  an `@extern` as written.
export extern_arguments :: fn(d: Decorator) -> ExternArguments {
    count :: d.args.len()
    if count == 0 {
        return ExternArguments {}
    }
    symbol :: d.args[count - 1].value
    if count == 2 {
        return ExternArguments { .library = d.args[0].value, .symbol = symbol }
    }
    return ExternArguments { .symbol = symbol }
}

/// The C symbol an `@extern` declaration binds: the symbol its `@extern` writes
/// (`extern_arguments`), else the name the declaration declares.
///
/// @param decl  the bodyless function declaration.
export extern_symbol_of :: fn(decl: FnDecl) -> string {
    d :: find_compiler_decorator(decl.decorators, .Extern) else return decl.name
    symbol :: extern_arguments(d).symbol else return decl.name
    return string_literal_text(symbol) else decl.name
}

/// The header an `@extern` declaration's own `@c_header` names, verbatim with
/// its brackets, or `""` when it carries none.
///
/// @param decl  the bodyless function declaration.
export c_header_of :: fn(decl: FnDecl) -> string {
    d :: find_compiler_decorator(decl.decorators, .CHeader) else return ""
    return sole_string_argument(d)
}

/// The headers that own the prototype of an `@extern` declaration: its own
/// `@c_header`, else the `headers` of the library it names. Empty when none does.
///
/// The backend INCLUDES those headers instead of synthesising a prototype: one
/// of them already has the real one, and a synthesised one that differs is a
/// conflicting declaration the C compiler refuses outright.
///
/// @param decl     the bodyless function declaration.
/// @param library  the `CLibrary` it names, as evaluated ; null for none.
export extern_headers :: fn(decl: FnDecl, library: CLibrary | null) -> string[] {
    own :: c_header_of(decl)
    if own != "" {
        return [own]
    }
    if library == null {
        return []
    }
    return library.headers
}

/// The index of the first parameter of an `@extern` declaration that C receives
/// through the `...` of its prototype, or `-1` when it is not variadic.
///
/// That is the first parameter marked `@c_variadic`.
///
/// @param decl  the bodyless function declaration.
export c_variadic_start :: fn(decl: FnDecl) -> i64 {
    for i in 0..<decl.params.len() {
        if has_compiler_decorator(decl.params[i].decorators, .CVariadic) {
            return i
        }
    }
    return -1
}

/// The C type a struct declaration mirrors, or `""` when it carries no
/// `@c_struct`.
///
/// A bare `@c_struct` names the C type after the struct, read as a `typedef`
/// name: `Color` mirrors `Color`. The argument spells a C type whose name differs
/// (`@c_struct("struct pollfd")`). An argument that is not one plain string reads
/// as `""`; the parser reports it (`P1032`, `P1033`).
///
/// @param decs         the struct's decorators.
/// @param struct_name  the name the struct declares, never its mangled form.
export c_struct_spelling :: fn(decs: Decorator[], struct_name: string) -> string {
    d :: find_compiler_decorator(decs, .CStruct) else return ""
    if d.args.len() == 0 {
        return struct_name
    }
    return sole_string_argument(d)
}

// The text of `d`'s argument when it has exactly one, a plain string; `""`
// otherwise.
sole_string_argument :: fn(d: Decorator) -> string = string_argument(d) else ""

/// The text of the one argument `d` takes, when it is a plain string literal:
/// what a build driver reads of `@json_name("user_id")`.
///
/// @param d  a decorator as written.
/// @return   null when `d` takes no argument, several, or one of another form.
export string_argument :: fn(d: Decorator) -> string | null {
    if d.args.len() != 1 {
        return null
    }
    return string_literal_text(d.args[0].value)
}

// ---- Declarations ---------------------------------------------------------

/// The span of `decl`, from its first token to its last.
///
/// @param decl  a declaration.
export decl_span :: fn(decl: Decl) -> Span = match decl {
    is FnDecl        -> decl.span
    is StructDecl    -> decl.span
    is EnumDecl      -> decl.span
    is TraitDecl     -> decl.span
    is ImplDecl      -> decl.span
    is TypeAliasDecl -> decl.span
    is ConstDecl     -> decl.span
    is AssertDecl    -> decl.span
    is ImportDecl    -> decl.span
}

/// The span of the name `decl` declares.
///
/// @param decl  a declaration.
/// @return      null for an impl, an assert or an import, which declare no name.
export decl_name_span :: fn(decl: Decl) -> Span | null = match decl {
    is FnDecl        -> decl.name_span
    is StructDecl    -> decl.name_span
    is EnumDecl      -> decl.name_span
    is TraitDecl     -> decl.name_span
    is TypeAliasDecl -> decl.name_span
    is ConstDecl     -> decl.name_span
    is ImplDecl | AssertDecl | ImportDecl -> null
}

/// The decorators written above `decl`.
///
/// @param decl  a declaration.
export decl_decorators :: fn(decl: Decl) -> Decorator[] = match decl {
    is ImportDecl    -> decl.decorators
    is FnDecl        -> decl.decorators
    is StructDecl    -> decl.decorators
    is EnumDecl      -> decl.decorators
    is TraitDecl     -> decl.decorators
    is ImplDecl      -> decl.decorators
    is TypeAliasDecl -> decl.decorators
    is ConstDecl     -> decl.decorators
    is AssertDecl    -> decl.decorators
}

/// The decorators written at one place of a declaration, with the place.
export DecoratorSite :: struct {
    /// The `DecoratorTarget` variant the place is: `"Function"`, `"Field"`...
    place:      string
    decorators: Decorator[]
}

/// The `DecoratorTarget` variant `decl` is, where a decorator above it is written.
///
/// @param decl  a top-level declaration, or the member of a trait or an impl.
/// @return      `"Function"`, `"Struct"`... ; `""` for an assertion, which carries
///              no decorator.
export place_of :: fn(decl: Decl) -> string = match decl {
    is FnDecl        -> "Function"
    is StructDecl    -> "Struct"
    is EnumDecl      -> "Enum"
    is TraitDecl     -> "Trait"
    is ImplDecl      -> "Implementation"
    is ConstDecl     -> "Constant"
    is TypeAliasDecl -> "Alias"
    is ImportDecl    -> "Import"
    is AssertDecl    -> ""
}

/// The decorators written above the `module` line of `program`: none when it has
/// no such line.
export module_decorators :: fn(program: Program) -> Decorator[] {
    module :: program.module else return []
    return module.decorators
}

/// Each place of `decl` a decorator may be written at: above it, and above each
/// of its fields, variants and parameters. The members of a trait or an impl are
/// declarations of their own, with sites of their own (`members_of`).
///
/// @param decl  a top-level declaration, or the member of a trait or an impl.
export decorator_sites :: fn(decl: Decl) -> Iterator<DecoratorSite> {
    yield DecoratorSite {
        .place = place_of(decl), .decorators = decl_decorators(decl)
    }
    match decl {
        is StructDecl -> {
            for f in decl.fields {
                yield DecoratorSite { .place = "Field", .decorators = f.decorators }
            }
        }
        is EnumDecl   -> {
            for v in decl.variants {
                yield DecoratorSite { .place = "Variant", .decorators = v.decorators }
            }
        }
        is FnDecl     -> {
            for p in decl.params {
                yield DecoratorSite { .place = "Parameter", .decorators = p.decorators }
            }
        }
        _ -> {}
    }
}

/// The members of a trait or an impl, as it writes them ; none for any other
/// declaration.
///
/// @param decl  a declaration.
export members_of :: fn(decl: Decl) -> FnDecl[] = match decl {
    is TraitDecl -> decl.members
    is ImplDecl  -> decl.members
    is ImportDecl | FnDecl | StructDecl | EnumDecl | TypeAliasDecl | ConstDecl | AssertDecl -> []
}

/// Whether `decl` carries `export`.
///
/// @param decl  a declaration.
/// @return      false for an impl, an assert or an import, which take no `export`.
export decl_is_public :: fn(decl: Decl) -> bool = match decl {
    is FnDecl        -> decl.visibility == .Public
    is StructDecl    -> decl.visibility == .Public
    is EnumDecl      -> decl.visibility == .Public
    is TraitDecl     -> decl.visibility == .Public
    is TypeAliasDecl -> decl.visibility == .Public
    is ConstDecl     -> decl.visibility == .Public
    is ImplDecl | AssertDecl | ImportDecl -> false
}

// ---- Import ---------------------------------------------------------------

/// An `import` statement, whatever its form, see `ImportBinding`.
export ImportDecl :: struct {
    span:       Span
    id:         i64 = UNASSIGNED_NODE_ID
    path:       string
    binding:    ImportBinding
    decorators: Decorator[]
}

/// `name :: import "..."`: namespace binding ; members reached via `name.X`.
export NamedNamespaceImport :: struct {
    name: string
}
/// `import "p" { x as y, z as _ }`: a WILDCARD of p plus per-name modifiers:
/// every listed source name is dropped from the wildcard ; `x as y` also rebinds
/// it as `y`, `z as _` is a pure exclusion. A plain name (no `as`) is an error
/// (R2033): the wildcard already brings every export.
export DestructureImport :: struct {
    names: ImportName[]
    /// True when the source wrote a trailing comma before `}`. Drives the
    /// formatter's Dart-style layout: present -> one name per line.
    trailing_comma: bool = false
}

/// bare `import "..."`, wildcard : every function of the module becomes
/// callable (prefix + UFCS) ; binds no name.
export WildcardImport :: struct {}

/// One `name` or `name as alias` inside an import's modifier list.
///
/// `alias` is null for a bare name, which is `R2033`: a wildcard already brings it.
export ImportName :: struct {
    name:  string
    alias: string | null
    span:  Span
    id:  i64 = UNASSIGNED_NODE_ID
}

// ---- Fn -------------------------------------------------------------------

/// A function declaration, `name :: fn(...) -> T { ... }`.
///
/// Three flags mark functions the parser or the compiler shaped. `sam_synthetic`
/// is a single-abstract-method lambda the parser desugared into an impl member,
/// which the user wrote in short; `materialized` a member declared for an impl
/// from its trait (one it inherits, `inherits`, or an intrinsic stub);
/// `comptime_synthetic` the helper the parser writes to compute a `@comptime`
/// constant. The last two hold nothing of the user's source
/// (`is_compiler_made`). And `is_expression_bodied` distinguishes
/// `f :: fn() = expr` from a braced body,
/// which the formatter needs and a generator emitting source should preserve.
///
/// Each is a plain `bool` defaulting to `false`, never `bool | null` (Vader has no
/// optional fields) and the dumper emits one only when `true`.
export FnDecl :: struct {
    span:                  Span
    id:                  i64 = UNASSIGNED_NODE_ID
    name:                  string
    name_span:             Span
    visibility:            Visibility
    type_params:           TypeParam[]
    params:                FnParam[]
    /// From the `(` to the `)` of the parameters, both included. A declaration
    /// the compiler makes, which has none, carries a span near its own or an
    /// empty one.
    params_span:           Span
    return_type:           TypeExpr | null
    body:                  BlockExpr | null
    decorators:            Decorator[]
    sam_synthetic:         bool
    is_expression_bodied:  bool
    /// `true` when this FnDecl was declared for an impl from its trait rather than
    /// written in it : a member the impl inherits (`inherits`), or a stub of an
    /// `@intrinsic` impl.
    materialized:          bool
    /// `true` when this FnDecl is the `__comptime_NAME` helper the parser
    /// synthesises for the `NAME :: @comptime <expr>` const sugar (see
    /// `through_comptime_helper`). The formatter and a build driver skip it:
    /// the paired `ConstDecl.comptime_body` holds what was written.
    /// Defaults `false` : only the desugar sets it, every other constructor
    /// leaves it off.
    comptime_synthetic:    bool = false
    /// True when the source wrote a trailing comma after the last parameter.
    /// Drives the formatter's Dart-style layout: present -> one param per line.
    trailing_comma:        bool = false
    doc:                   DocComment | null = null
    /// For a member an impl inherits from its trait, the trait's member whose default
    /// body it runs: the body was checked once in the trait, and is lowered for each
    /// impl from there. Null for any other function.
    inherits:              FnDecl | null = null
}

/// Whether the compiler made `f` rather than the source: the helper the parser
/// writes to compute a `@comptime` constant, or a member an impl takes from its
/// trait.
///
/// @param f  the function.
export is_compiler_made :: fn(f: FnDecl) -> bool = f.comptime_synthetic || f.materialized

/// The declaration whose body `fd` runs: for a member an impl inherits, the
/// trait's member (`inherits`), whose default body it is ; `fd` itself otherwise.
/// A reader of a member's body goes through it, or sees an inherited member as
/// bodyless.
///
/// @param fd  a function declaration.
export body_source :: fn(fd: FnDecl) -> FnDecl = fd.inherits else fd

/// One parameter of a function, lambda or trait method.
export FnParam :: struct {
    span:          Span
    id:            i64 = UNASSIGNED_NODE_ID
    name:          string
    /// The name alone, where `span` covers the whole slot, decorators, a variadic
    /// `...`, the type and the default included : what a rename rewrites. `span`
    /// stays the parameter's identity, the key of the side tables.
    name_span:     Span
    // Optional in lambdas.
    ty:            TypeExpr | null
    default_value: Expr | null
    variadic:      bool
    /// Decorators written before the parameter (`@c_out tv: TimeVal`).
    decorators:    Decorator[]
}

// ---- Struct ---------------------------------------------------------------

/// A struct declaration, `Name :: struct { ... }`.
///
/// The node a generator walks most: `fields` in declaration order, each carrying its
/// written type. `name_span` covers the name alone, which is what a diagnostic about
/// the struct itself should point at.
///
/// `fields` holds what the declaration writes, not what its `spreads` bring: the
/// fields of a `...Base` exist only once the typechecker has laid the struct out.
export StructDecl :: struct {
    span:          Span
    id:            i64 = UNASSIGNED_NODE_ID
    name:          string
    name_span:     Span
    visibility:    Visibility
    type_params:   TypeParam[]
    fields:        StructField[]
    spreads:       StructSpread[] = []
    decorators:    Decorator[]
    doc:           DocComment | null = null
    /// What `Name :: decorator(...)` writes in its parentheses: the places it may
    /// be written, then its options (`repeatable = true`). Null for a struct, which
    /// is what tells the two apart; empty for a decorator written anywhere.
    decorator_args: CallArg[] | null = null
}

/// Whether `d` declares a decorator rather than a struct.
///
/// @param d  the declaration.
export is_decorator :: fn(d: StructDecl) -> bool = d.decorator_args != null

/// A spread of another struct's fields into a struct declaration, `...Base`.
export StructSpread :: struct {
    span: Span
    id:   i64 = UNASSIGNED_NODE_ID
    /// The struct whose fields are spread, as written (`Base`, `Box<T>`).
    base: TypeExpr
    /// How many of the declaration's `fields` are written before the spread.
    at:   i64
}

/// A member of a struct body: a field it writes, or a spread of another struct.
export StructMember :: StructField | StructSpread

/// The fields and the spreads of `d`, in the order the declaration writes them.
///
/// @param d  the struct declaration.
export struct_members :: fn(d: StructDecl) -> StructMember[] {
    out: StructMember[]: []
    next_spread: i64 = 0
    for i in 0..=d.fields.len() {
        for next_spread < d.spreads.len() && d.spreads[next_spread].at == i {
            out.push(d.spreads[next_spread])
            next_spread += 1
        }
        if i < d.fields.len() {
            out.push(d.fields[i])
        }
    }
    return out
}

/// One field of a struct.
///
/// `visibility` is `@internal`: fields are public by default, so this is the opt-out.
/// `default` backs `T {}` construction with the field omitted.
export StructField :: struct {
    span:       Span
    id:         i64 = UNASSIGNED_NODE_ID
    name:       string
    ty:         TypeExpr
    visibility: Visibility
    // Optional default value used when a struct literal omits this field.
    default:    Expr | null
    doc:        DocComment | null = null
    /// The declared decorators written above the field ; `@internal` is its
    /// `visibility`.
    decorators: Decorator[] = []
    /// Written `...name: T[]`, the last field of a decorator: it holds the
    /// positional arguments left after the other fields.
    variadic:   bool = false
}

// ---- Enum -----------------------------------------------------------------

/// An enum declaration, `Name :: enum(u8) { A, B }` or
/// `Name :: enum(Info) { A { .f = 1 } }`.
export EnumDecl :: struct {
    span:       Span
    id:         i64 = UNASSIGNED_NODE_ID
    name:       string
    name_span:  Span
    visibility: Visibility
    /// The parenthesised header as written : empty, `(width)`, `(data)` or
    /// `(data, width)`. Which role a lone argument plays depends on what it
    /// resolves to, so the typechecker decides, not the parser.
    header:     TypeExpr[]
    variants:   EnumVariant[]
    decorators: Decorator[]
    doc:        DocComment | null = null
}

/// One variant of an enum, with its explicit value when the source gave one.
export EnumVariant :: struct {
    span:        Span
    id:          i64 = UNASSIGNED_NODE_ID
    name:        string
    // `null` means "previous + 1" (or 0 for the first variant). Stored as i64
    // so the parser can carry the parsed literal verbatim until the
    // typechecker reduces it to the final integer.
    value:       i64 | null
    value_span:  Span | null
    /// The `{ .f = v }` block as written, checked against the header's data
    /// type ; null when the variant has none.
    data:        StructLitItem[] | null = null
    doc:         DocComment | null = null
    /// The declared decorators written above the variant.
    decorators:  Decorator[] = []
}

// ---- Trait ----------------------------------------------------------------

/// A trait declaration.
///
/// `members` are its methods, each an `FnDecl`; one with a `body` is a default
/// method.
export TraitDecl :: struct {
    span:        Span
    id:          i64 = UNASSIGNED_NODE_ID
    name:        string
    name_span:   Span
    visibility:  Visibility
    type_params: TypeParam[]
    /// The supertrait bound, for either form: `Numeric :: trait<T> = Add & Sub`
    /// (alias form, `members` empty) or `Hashable :: trait<T> : Hash & Eq { ... }`
    /// (methods plus composition). A parsed type expression: typically a
    /// `BinaryExpr(.BitAnd)` chain over trait names, though a single trait
    /// reference is valid too. `null` for a plain `trait { ... }`.
    requires:    TypeExpr | null
    members:     FnDecl[]
    decorators:  Decorator[]
    doc:         DocComment | null = null
}

// ---- Impl -----------------------------------------------------------------

/// An `implements` block, or its one-method short form.
///
/// `for_type` is the implementing type as written, `implemented` the trait: a name
/// (`Display`, `Fmt.Display`), with its type arguments when it takes some
/// (`Into<string>`).
export ImplDecl :: struct {
    span:        Span
    id:          i64 = UNASSIGNED_NODE_ID
    type_params: TypeParam[]
    for_type:    TypeExpr
    implemented: TypeExpr
    members:     FnDecl[]
    decorators:  Decorator[]
    doc:         DocComment | null = null
}

/// The node that names the trait of `d`: an `IdentExpr`, or a `FieldExpr` for a
/// trait reached through a namespace alias (`Fmt.Display`).
///
/// @param d  the impl.
export impl_trait_head :: fn(d: ImplDecl) -> Expr {
    if d.implemented is GenericInstExpr {
        return d.implemented.callee
    }
    return d.implemented
}

/// The type arguments written on the trait of `d`: `[string]` for `Into<string>`,
/// none for `Display`.
///
/// @param d  the impl.
export impl_trait_args :: fn(d: ImplDecl) -> TypeExpr[] {
    if d.implemented is GenericInstExpr {
        return d.implemented.type_args
    }
    return []
}

/// The trait's own name in `d`, the alias left out: `Display` for `Fmt.Display`.
///
/// @param d  the impl.
export impl_trait_name :: fn(d: ImplDecl) -> string {
    head :: impl_trait_head(d)
    if head is FieldExpr {
        return head.field
    }
    return if head is IdentExpr { head.name } else { "" }
}

/// The trait of `d` as written, its alias included: `Fmt.Display`.
///
/// @param d  the impl.
export impl_trait_written_name :: fn(d: ImplDecl) -> string {
    head :: impl_trait_head(d)
    if head is FieldExpr && head.target is IdentExpr {
        return "${head.target.name}.${head.field}"
    }
    return impl_trait_name(d)
}

/// Where the trait's own name is written in `d`: `Display` in `Fmt.Display`.
///
/// @param d  the impl.
export impl_trait_name_span :: fn(d: ImplDecl) -> Span {
    head :: impl_trait_head(d)
    return if head is FieldExpr { head.field_span } else { head.span }
}

// ---- TypeAlias ------------------------------------------------------------

/// A type alias, `Name :: SomeType`.
///
/// A generator resolving a written type must expect to meet one of these: the alias
/// and its target are indistinguishable in an `IdentExpr`.
export TypeAliasDecl :: struct {
    span:        Span
    id:          i64 = UNASSIGNED_NODE_ID
    name:        string
    name_span:   Span
    visibility:  Visibility
    type_params: TypeParam[]
    aliased:     TypeExpr
    decorators:  Decorator[]
    doc:         DocComment | null = null
}

// ---- Const ----------------------------------------------------------------

/// A module-level constant, `NAME :: value` or the typed `NAME: T: value`.
///
/// `comptime_body` holds the unevaluated expression for a `@comptime` const, whose
/// `value` is filled in by the comptime engine.
export ConstDecl :: struct {
    span:       Span
    id:         i64 = UNASSIGNED_NODE_ID
    name:       string
    name_span:  Span
    visibility: Visibility
    ty:         TypeExpr | null
    value:      Expr
    decorators: Decorator[]
    /// The value a `@comptime` const was written with, when the parser gave it a
    /// `__comptime_NAME` helper to call (`through_comptime_helper`) : the
    /// formatter re-emits it rather than the call. Non-null marks such a const ;
    /// null for every other const. Holds the raw block/expression (pre-`return`-
    /// lift), so the exact source spelling round-trips.
    comptime_body: Expr | null = null
    /// Set on the hidden constant the parser writes for a `@comptime` argument of
    /// a decorator (`CallArg.comptime_body`): no source names it, so the tools that
    /// show declarations skip it, as they skip the helper of a `@comptime` value.
    comptime_synthetic: bool = false
    doc:        DocComment | null = null
}

/// The value `d` was written with: the operand of its `@comptime` when the
/// parser gave it a helper to call (`comptime_body`), its value otherwise.
///
/// @param d  the constant.
export written_value :: fn(d: ConstDecl) -> Expr = d.comptime_body else d.value

/// Whether the parser wrote `d` for a `@comptime` rather than the source: the
/// helper computing its value, or the hidden constant of a decorator argument.
/// The tools that show declarations skip both.
///
/// @param d  a declaration of a module.
export is_comptime_made :: fn(d: Decl) -> bool =
    d is FnDecl && d.comptime_synthetic || d is ConstDecl && d.comptime_synthetic

/// Whether `d` is written `NAME :: @comptime <expr>`: its value is computed at
/// compile time.
///
/// @param d  the constant.
export is_comptime_const :: fn(d: ConstDecl) -> bool = d.comptime_body != null

/// An `@assert` at the top level: a build-time invariant.
///
/// `condition` is evaluated by the comptime VM and the build fails with C4015 when
/// it is `false`. Nothing is emitted at runtime.
export AssertDecl :: struct {
    span:         Span
    id:           i64 = UNASSIGNED_NODE_ID
    condition:    Expr
    message:      string | null
    /// Where the message literal is written, so it prints in its own spelling.
    message_span: Span | null
    decorators:   Decorator[]
}

// ---- Statements -----------------------------------------------------------

/// A local binding, `x :: e` or `x := e`.
///
/// `mutable` is the `:=` form. Style treats a `:=` that is never reassigned as a
/// defect, so a generator should emit `::` unless it writes to the slot.
export LetStmt :: struct {
    span:    Span
    id:      i64 = UNASSIGNED_NODE_ID
    mutable: bool
    binding: LetBinding
    ty:      TypeExpr | null
    value:   Expr
}

/// A local bound to one name: a leaf of the recursive binding tree, whose other
/// leaf is `WildcardBinding` (ignores the slot) and whose only branch is
/// `TupleBinding` (matches a tuple-typed value element-wise).
///
/// `name_span` covers the name alone: the precise target a rename needs, which the
/// whole-binding `span` is too wide for.
export SimpleBinding :: struct {
    span:      Span
    id:        i64 = UNASSIGNED_NODE_ID
    name:      string
    name_span: Span
}

/// A destructuring local, `[a, b] :: pair`.
export TupleBinding :: struct {
    span:     Span
    id:       i64 = UNASSIGNED_NODE_ID
    elements: LetBinding[]
}

/// A discarded local, `_ :: e`.
export WildcardBinding :: struct {
    span: Span
    id: i64 = UNASSIGNED_NODE_ID
}

/// The `...rest` tail of a destructuring local: collects every slot its sibling
/// `SimpleBinding`s did not consume into a fresh array.
///
/// Valid only as the LAST element of a `TupleBinding` whose source is array-typed.
export RestBinding :: struct {
    span:      Span
    id:        i64 = UNASSIGNED_NODE_ID
    name:      string
    name_span: Span
}

/// An assignment to several existing places at once, `[a, b] = pair`.
///
/// Not an `AssignStmt` over a literal target: its elements are not expressions,
/// `_` and `...rest` only mean something here.
export DestructureAssignStmt :: struct {
    span:    Span
    id:      i64 = UNASSIGNED_NODE_ID
    targets: AssignTarget[]
    value:   Expr
}

/// A place written by a destructuring assignment: a name, a field or an index.
///
/// Any expression parses here; the typechecker refuses what is not a place.
export PlaceTarget :: struct {
    span:  Span
    id:    i64 = UNASSIGNED_NODE_ID
    place: Expr
}

/// A discarded element of a destructuring assignment, `_`.
export WildcardTarget :: struct {
    span: Span
    id:   i64 = UNASSIGNED_NODE_ID
}

/// The `...rest` tail of a destructuring assignment: writes a fresh array of
/// every element its siblings did not consume into `place`.
///
/// Valid only as the LAST target, over an array-typed source.
export RestTarget :: struct {
    span:  Span
    id:    i64 = UNASSIGNED_NODE_ID
    place: Expr
}

/// An assignment to an existing place, `target = value`.
///
/// `lhs op= rhs` parses to one too : `value` is `lhs op rhs` over the SAME `lhs`
/// node as `target`, which `compound_assign_op` recognises.
export AssignStmt :: struct {
    span:   Span
    id:     i64 = UNASSIGNED_NODE_ID
    target: Expr
    value:  Expr
}

/// The operator of a compound assignment `lhs op= rhs`, or null for a plain one.
///
/// `target` and `value.left` are one node, so they carry one span ; a
/// hand-written `a = a + 1` reads an `a` of its own, at another position. A pass
/// that evaluates `lhs`'s operands once, or prints the `op=` back, keys on this,
/// and a pass that copies an assignment keeps the two sides one node.
/// @param s  the assignment.
/// @return   the arithmetic operator the `op=` spells, or null.
export compound_assign_op :: fn(s: AssignStmt) -> BinaryOp | null {
    value :: s.value
    if value is BinaryExpr {
        if value.left.span == s.target.span && is_arith_op(value.op) {
            return value.op
        }
    }
    return null
}

/// Whether `op` is an arithmetic operator a compound assignment spells : `+` `-`
/// `*` `/` `%`, and the wrapping `+%` `-%` `*%`.
/// @param op  the operator.
export is_arith_op :: fn(op: BinaryOp) -> bool = match op {
    .Add | .Sub | .Mul | .Div | .Mod | .AddWrap | .SubWrap | .MulWrap -> true
    .Shl | .Shr | .BitAnd | .BitOr | .BitXor | .And | .Or -> false
    .Eq | .Neq | .Lt | .Lte | .Gt | .Gte | .Is | .In | .NotIn | .Same | .NotSame -> false
}

/// An expression evaluated for its effect, its value discarded.
export ExprStmt :: struct {
    span: Span
    id:   i64 = UNASSIGNED_NODE_ID
    expr: Expr
}

/// A `return`, with no value for a `void` function.
export ReturnStmt :: struct {
    span:  Span
    id:    i64 = UNASSIGNED_NODE_ID
    value: Expr | null
}

/// `yield expr` inside a `generator` fn body: emit one element and suspend.
/// Always carries a value (unlike `return`, which may be bare); the empty /
/// exhausted case is a bare `return` or falling off the end. `value` must
/// coerce to the `T` of the generator's `-> Iterator<T>` return.
export YieldStmt :: struct {
    span:  Span
    id:    i64 = UNASSIGNED_NODE_ID
    value: Expr
}

/// A loop in any of its three forms, see `ForForm`.
///
/// `label` is the loop-jump target of `break <label>` / `continue <label>`.
export ForStmt :: struct {
    span:  Span
    id:    i64 = UNASSIGNED_NODE_ID
    label: string | null
    form:  ForForm
    body:  BlockExpr
    /// `@comptime for x in <arr> { ... }`: unroll at lower time. False for
    /// every other form.
    is_comptime: bool = false
}

/// The `for { ... }` form: no condition, exited by `break` or `return`.
export InfiniteFor :: struct {}
/// The `for cond { ... }` form.
export WhileFor    :: struct { cond: Expr }
/// The `for x in xs { ... }` form.
export InFor       :: struct {
    loop_var: LoopVar
    iter:     Expr
}

/// The loop variable of a `for ... in ...`. A union so the mutually exclusive
/// shapes can't be miscombined and no sentinel / span-geometry heuristic is
/// needed downstream: each pass matches on the variant. Kept structural on the
/// AST (not desugared at parse) so `vader fmt` round-trips every sugar.
export LoopVar :: NamedVar | DestructureVar | DiscardVar
/// `for x in ...`, and the explicit discard `for _ in coll` (name == `"_"`).
export NamedVar       :: struct { name: string, span: Span }
/// `for [k, v] in ...`: the leaves bind against the iterable's element type.
export DestructureVar :: struct { pattern: LetBinding }
/// `for <range>`: no user variable is written (the iterable is the range
/// itself). Also the lower-synthesised varless `for <coll>` (while->for sugar).
export DiscardVar     :: struct {}

/// A `break`, optionally naming the loop to leave.
export BreakStmt :: struct {
    span:  Span
    id:    i64 = UNASSIGNED_NODE_ID
    label: string | null
}

/// A `continue`, optionally naming the loop to resume.
export ContinueStmt :: struct {
    span:  Span
    id:    i64 = UNASSIGNED_NODE_ID
    label: string | null
}

/// A `defer`, running its body when the enclosing scope exits.
export DeferStmt :: struct {
    span: Span
    id:   i64 = UNASSIGNED_NODE_ID
    body: DeferBody
}

/// A `defer` deferring one statement.
export DeferStmtBody  :: struct { stmt: Stmt }
/// A `defer` deferring a block.
export DeferBlockBody :: struct { block: BlockExpr }

/// Anything that can appear as a statement in a block.
///
/// Declared AFTER its variant structs, as `DeferBody` is: the resolver collects
/// every decl name before resolving types, so either order works and this one
/// reads top-down.
export Stmt :: LetStmt | AssignStmt | DestructureAssignStmt | ExprStmt | ReturnStmt | YieldStmt | ForStmt | BreakStmt | ContinueStmt | DeferStmt
/// What a `defer` defers: one statement, or a block.
export DeferBody :: DeferStmtBody | DeferBlockBody

// ---- Expressions: literals ------------------------------------------------

/// An integer literal.
///
/// Stored as `u64` whatever the written base. The literal is FREE (it adopts the
/// surrounding concrete numeric type) so its node carries no width.
export IntLitExpr :: struct {
    span:   Span
    id:     i64 = UNASSIGNED_NODE_ID
    /// Unsigned magnitude, full u64 range (the snapshot format renders the
    /// value as a decimal string with the trailing `n` so 0..u64.MAX all
    /// round-trip losslessly).
    value:  u64
    /// A `-` written against the literal: the parser reads `-5` as one value,
    /// so `-128` is checked as the least `i8` rather than as the negation of a
    /// `128` no `i8` holds, and `-5.to_string()` is `"-5"`. `-(5)` and `- 5`
    /// stay negations.
    negative: bool = false
}

/// The value of an integer literal as an `i64`: a magnitude past `i64` as its
/// bits, the least `i64` from its magnitude 2^63.
///
/// @param literal  the literal.
export int_literal_value :: fn(literal: IntLitExpr) -> i64 {
    if literal.negative {
        return 0 -% i64(literal.value)
    }
    return i64(literal.value)
}

/// An integer literal in decimal, signed as written: `-128`, `300`.
///
/// @param literal  the literal.
export int_literal_text :: fn(literal: IntLitExpr) -> string {
    if literal.negative {
        return "-${literal.value}"
    }
    return "${literal.value}"
}

/// A float literal.
export FloatLitExpr :: struct {
    span:   Span
    id:     i64 = UNASSIGNED_NODE_ID
    /// Signed as written: the parser reads a `-` against the literal into it
    /// (`IntLitExpr.negative`).
    value:  f64
}

/// `true` or `false`.
export BoolLitExpr :: struct {
    span:  Span
    id:    i64 = UNASSIGNED_NODE_ID
    value: bool
}

/// The `null` literal.
export NullLitExpr :: struct {
    span: Span
    id:   i64 = UNASSIGNED_NODE_ID
}

/// A character literal, stored as its codepoint.
///
/// Free like an integer literal: in an integer context it coerces to that width
/// carrying the codepoint.
export CharLitExpr :: struct {
    span:  Span
    id:    i64 = UNASSIGNED_NODE_ID
    value: u32
}

/// A string literal, as the sequence of its parts.
///
/// Always a part list, even with no interpolation, so a reader never has to handle
/// two shapes. A generator emitting source must re-escape `$`, which opens an
/// interpolation.
export StringLitExpr :: struct {
    span:  Span
    id:    i64 = UNASSIGNED_NODE_ID
    parts: StringLitPart[]
}

/// A run of literal text inside a string literal.
export StringLitText          :: struct { value: string, span: Span, id: i64 = UNASSIGNED_NODE_ID }
/// An interpolated `${...}` inside a string literal.
export StringLitInterpolation :: struct { expr:  Expr,   span: Span, id: i64 = UNASSIGNED_NODE_ID }

/// The text of `e` when it is a string literal of one run of text, with no
/// interpolation: what a name spelled out at build time reads (`@field(x, "n")`).
///
/// @param e  any expression.
/// @return   null for anything else, an interpolation included.
export string_literal_text :: fn(e: Expr) -> string | null {
    if e !is StringLitExpr || e.parts.len() != 1 {
        return null
    }
    part :: e.parts[0]
    if part is StringLitText {
        return part.value
    }
    return null
}

// ---- Expressions: naming / access -----------------------------------------

/// A bare name, in value or type position.
///
/// `implicit_dot` marks the leading-dot spelling (`.Variant`), where resolution
/// defers to the surrounding context. The dumper emits its JSON key
/// (`implicitDot`) only when `true`.
export IdentExpr :: struct {
    span:         Span
    id:           i64 = UNASSIGNED_NODE_ID
    name:         string
    implicit_dot: bool
}

/// A call, `callee(args)`.
///
/// `callee` is an arbitrary expression, so this covers `f(x)`, `a.f(x)` (whose callee
/// is a `FieldExpr`) and `P.f(x)` alike: UFCS is not distinguished here.
export CallExpr :: struct {
    span:   Span
    id:     i64 = UNASSIGNED_NODE_ID
    callee: Expr
    /// The type arguments written on the call (`f<i64>(x)`, `x.f<i64>(y)`) : the
    /// callee's type parameters, first ones first. Empty when the call infers them.
    type_args: TypeExpr[] = []
    args:   CallArg[]
    /// The arguments as written, once the type checker replaced `args` with them
    /// in the order of the parameters and the omitted defaults filled in; null
    /// while `args` is what was written.
    written_args: CallArg[] | null = null
    /// Source wrote a trailing comma before `)`: formatter keeps it exploded.
    trailing_comma: bool = false
}

/// One argument of a call.
///
/// `name` is set for a named argument, `spread` for the `...xs` form.
export CallArg :: struct {
    span:   Span
    id:     i64 = UNASSIGNED_NODE_ID
    name:   string | null
    value:  Expr
    /// Reserved for argument-spread `f(...xs)`, not parsed yet, so always
    /// `false` today. The consumers (printer / dump / ufcs) already honour it
    /// so the feature only needs `parse_call_args` to set it.
    spread: bool
    /// The operand of a `@comptime` written as the argument of a declared
    /// decorator, which the parser moved to a hidden constant (`comptime_synthetic`)
    /// that `value` names: the formatter re-emits it. Null for any other argument.
    comptime_body: Expr | null = null
}

/// A member access, `target.field`.
///
/// `is_numeric` marks a tuple index (`t.0`), whose "field" is a position.
export FieldExpr :: struct {
    span:       Span
    id:         i64 = UNASSIGNED_NODE_ID
    target:     Expr
    field:      string
    field_span: Span
    // True when the field was written as an integer literal (`t.0`). Used by
    // the lowerer to map onto synthetic tuple fields `_0`, `_1`, ...
    is_numeric: bool
}

/// An index, `target[index]`.
export IndexExpr :: struct {
    span:   Span
    id:     i64 = UNASSIGNED_NODE_ID
    target: Expr
    index:  Expr
}

// ---- Expressions: operators -----------------------------------------------

/// Which prefix operator a `UnaryExpr` applies.
export UnaryOp :: enum(u8) {
    Neg,
    Not,
    BitNot,
}

/// A prefix operator applied to one operand.
export UnaryExpr :: struct {
    span:    Span
    id:      i64 = UNASSIGNED_NODE_ID
    op:      UnaryOp
    operand: Expr
}

/// Which infix operator a `BinaryExpr` applies. `binary_op_symbol` gives the
/// spelling of each, the parser's table its precedence, and SPEC (§3
/// *Operators*) what each one does. A compound assignment (`a += b`) carries the
/// operator of its arithmetic (`Add`).
///
/// No variant stands for `!is`: the parser reads `x !is T` as a `Not`
/// `UnaryExpr` around an `Is`.
export BinaryOp :: enum(u8) {
    /// `a + b`, through `Add` on a user type.
    Add,
    /// `a - b`, through `Sub` on a user type.
    Sub,
    /// `a * b`, through `Mul` on a user type: `[0] * n` and `"ab" * 3` repeat.
    Mul,
    /// `a / b`.
    Div,
    /// `a % b`, the remainder.
    Mod,
    /// `a << b`.
    Shl,
    /// `a >> b`.
    Shr,
    /// `a & b`, bitwise.
    BitAnd,
    /// `a | b`, bitwise.
    BitOr,
    /// `a ^ b`, bitwise exclusive or.
    BitXor,
    /// `a && b`: `b` is evaluated, and sees `a` narrowed, only when `a` holds.
    And,
    /// `a || b`: `b` is evaluated, and sees `a` false, only when `a` does not hold.
    Or,
    /// `a == b`: equal values, through `Equals`.
    Eq,
    /// `a != b`, the negation of `Eq`.
    Neq,
    /// `a < b`, through `Comparable`, as are the three below.
    Lt,
    /// `a <= b`.
    Lte,
    /// `a > b`.
    Gt,
    /// `a >= b`.
    Gte,
    /// `x is T`: whether `x` holds a value of the type `T`, which narrows `x` where
    /// it does. The right operand is a type.
    Is,
    /// `x in c`: `c.contains(x)`, through `Contains`. With a type on the right
    /// (`h in Hour`), whether `x` is one of its values.
    In,
    /// `x !in c`, the negation of `In`.
    NotIn,
    /// `a === b`: the same object, not an equal value.
    Same,
    /// `a !== b`, the negation of `Same`.
    NotSame,
    /// `a +% b`: integer addition that wraps around its width.
    AddWrap,
    /// `a -% b`, wrapping as `AddWrap` does.
    SubWrap,
    /// `a *% b`, wrapping as `AddWrap` does.
    MulWrap,
}

/// The operator as the source spells it, `"+"` for `Add` : what a diagnostic quotes
/// and the formatter prints.
/// @param op  the operator.
export binary_op_symbol :: fn(op: BinaryOp) -> string = match op {
    .Add     -> "+"
    .Sub     -> "-"
    .Mul     -> "*"
    .Div     -> "/"
    .Mod     -> "%"
    .Shl     -> "<<"
    .Shr     -> ">>"
    .BitAnd  -> "&"
    .BitOr   -> "|"
    .BitXor  -> "^"
    .And     -> "&&"
    .Or      -> "||"
    .Eq      -> "=="
    .Neq     -> "!="
    .Lt      -> "<"
    .Lte     -> "<="
    .Gt      -> ">"
    .Gte     -> ">="
    .Is      -> "is"
    .In      -> "in"
    .NotIn   -> "!in"
    .Same    -> "==="
    .NotSame -> "!=="
    .AddWrap -> "+%"
    .SubWrap -> "-%"
    .MulWrap -> "*%"
}

/// The operator as the source spells it, `"-"` for `Neg`.
/// @param op  the operator.
export unary_op_symbol :: fn(op: UnaryOp) -> string = match op {
    .Neg    -> "-"
    .Not    -> "!"
    .BitNot -> "~"
}

/// The binary operator `binary_op_symbol` spells `symbol`.
///
/// @param symbol  the operator as the source spells it.
/// @return        null when no binary operator is spelled so.
export binary_op_spelled :: fn(symbol: string) -> BinaryOp | null {
    for op in BinaryOp {
        if binary_op_symbol(op) == symbol {
            return op
        }
    }
    return null
}

/// The unary operator `unary_op_symbol` spells `symbol`.
///
/// @param symbol  the operator as the source spells it.
/// @return        null when no unary operator is spelled so.
export unary_op_spelled :: fn(symbol: string) -> UnaryOp | null {
    for op in UnaryOp {
        if unary_op_symbol(op) == symbol {
            return op
        }
    }
    return null
}

/// An infix operator applied to two operands.
export BinaryExpr :: struct {
    span:    Span
    id:      i64 = UNASSIGNED_NODE_ID
    op:      BinaryOp
    /// The operator as written: `!in` and `!is` from their `!`, `+=` for a
    /// compound assignment. `empty_span()` on a node no source spells.
    op_span: Span
    left:    Expr
    right:   Expr
}

/// A fallback, `left else value`, or a chain of clauses
/// `left else is T { ... } else is U { ... } else { ... }`.
///
/// Every clause tests `left`, evaluated once, in order ; each one takes away
/// what it handles before the next. A bare `else` handles `null` and the
/// members known to implement `Error` ; `else is T` handles `T`. The result is
/// `left` without what the clauses handled, or a clause's value.
export FallbackExpr :: struct {
    span:    Span
    id:      i64 = UNASSIGNED_NODE_ID
    left:    Expr
    clauses: FallbackClause[]
    /// On a declaration, the name the clauses see `left` under, narrowed to
    /// what each one handles: the role of `MatchExpr.binding`. Bound whether
    /// a clause reads it or not.
    binding: SimpleBinding | null = null
}

/// One clause of a `FallbackExpr`: `else value` or `else is T { ... }`.
export FallbackClause :: struct {
    span:    Span
    /// Keys the type the clause tests, recorded by the typecheck.
    id:      i64 = UNASSIGNED_NODE_ID
    /// The `else` keyword.
    op_span: Span
    /// `else is T`: the type handled ; `null` on a bare `else`.
    test:    TypeExpr | null = null
    body:    FallbackBody
}

// ---- Expressions: control flow --------------------------------------------

/// An `if`, in statement or value position.
///
/// One node for both: in value position the blocks' trailing expressions are the
/// result, so a generator emitting a conditional value writes this.
export IfExpr :: struct {
    span:        Span
    id:          i64 = UNASSIGNED_NODE_ID
    cond:        Expr
    then_block:  BlockExpr
    else_branch: IfElse | null
}

/// An `else if`, holding the next branch.
export IfElseIf    :: struct { branch: IfExpr }
/// A final `else` block.
export IfElseBlock :: struct { block:  BlockExpr }

/// A `match` over a scrutinee.
///
/// `partial` is `@partial`: the match is knowingly non-exhaustive; `unreachable` is
/// `@unreachable`: the uncovered variants are impossible and trap if reached.
export MatchExpr :: struct {
    span:      Span
    id:        i64 = UNASSIGNED_NODE_ID
    scrutinee: Expr
    arms:      MatchArm[]
    // `@partial match x { ... }` opts out of exhaustiveness: no T3013
    // fires for missing variants. Default `false` keeps the regular
    // exhaustive-by-default behaviour ; the dump suppresses the field
    // when `false` so old snapshots stay byte-identical.
    partial:   bool
    // `@unreachable match x { ... }` likewise opts out of T3013, but asserts
    // the *uncovered* variants can never occur : they fall through to the
    // synthesised trap (`LoweredUnreachable`) instead of being handled. Use
    // it for "handle A/B/C, the rest are impossible": no wildcard, no fake
    // value. Mutually exclusive with `partial`. Defaulted so existing
    // `MatchExpr { ... }` literals and old snapshots are unaffected.
    unreachable: bool = false
    /// `match x :: e { ... }`: the name the scrutinee is bound to, visible in every
    /// arm and guard and narrowed by each arm. Its `name_span` is the declaration
    /// the resolver mints the symbol at.
    binding: SimpleBinding | null = null
}

/// One arm of a `match`, with its optional `if` guard.
export MatchArm :: struct {
    span:    Span
    id:      i64 = UNASSIGNED_NODE_ID
    pattern: Pattern
    guard:   Expr | null
    body:    Expr
}

/// A braced block.
///
/// `trailing` is the block's value when it ends in an expression rather than a
/// statement, which is what makes a block usable in value position.
export BlockExpr :: struct {
    span:     Span
    id:       i64 = UNASSIGNED_NODE_ID
    stmts:    Stmt[]
    trailing: Expr | null
}

// ---- Expressions: lambdas / literals --------------------------------------

/// A lambda, `(x: i32) -> x + 1`.
export LambdaExpr :: struct {
    span:        Span
    id:          i64 = UNASSIGNED_NODE_ID
    params:      FnParam[]
    /// From the `(` to the `)` of the parameters, both included; the parameter
    /// itself for `x -> e`, which writes none.
    params_span: Span
    return_type: TypeExpr | null
    body:        BlockExpr
    /// True when the source wrote a trailing comma after the last parameter.
    trailing_comma: bool = false
    /// True when the source wrote the body as `= expr` (`fn(x: i32) -> i32 = x * 2`):
    /// `body` holds that expression as its trailing value, as a function's does.
    is_expression_bodied: bool = false
}

/// A struct literal, `Point { .x = 1 }`.
///
/// `items` mixes fields and spreads in SOURCE order, which a generator must preserve:
/// a later field overrides an earlier spread.
export StructLitExpr :: struct {
    span:      Span
    id:        i64 = UNASSIGNED_NODE_ID
    type_name: TypeExpr
    items:     (StructLitField | StructLitSpread)[]
    /// True when the source wrote a trailing comma before `}`. The formatter
    /// reads it as a "keep exploded" directive (Dart-style block layout).
    trailing_comma: bool = false
}

/// One entry of a struct literal: a field, or a spread.
export StructLitItem :: StructLitField | StructLitSpread

/// A `.name = value` entry of a struct literal.
export StructLitField :: struct {
    span:      Span
    id:        i64 = UNASSIGNED_NODE_ID
    name:      string
    name_span: Span
    value:     Expr
}

/// A `...expr` entry of a struct literal.
export StructLitSpread :: struct {
    span: Span
    id:   i64 = UNASSIGNED_NODE_ID
    expr: Expr
}

/// An array or tuple literal, `[a, b, c]`.
///
/// One node for both: the parser does not commit to array or tuple, and the
/// typechecker decides from context.
export SeqLitExpr :: struct {
    span:     Span
    id:       i64 = UNASSIGNED_NODE_ID
    elements: Expr[]
    /// True when the source wrote a trailing comma before `]`. Drives the
    /// formatter's Dart-style layout: present -> one element per line.
    trailing_comma: bool = false
}

/// A range, `a..<b` or `a..=b`.
export RangeExpr :: struct {
    span:      Span
    id:        i64 = UNASSIGNED_NODE_ID
    inclusive: bool
    lower:     Expr
    upper:     Expr
}

// ---- Expressions: error / cast / generic / variant ------------------------

/// An explicit conversion, `T(value)`.
///
/// Only a genuine width or representation change needs one: a free literal adopts
/// its context, so a cast around one is a style defect.
export CastExpr :: struct {
    span:   Span
    id:     i64 = UNASSIGNED_NODE_ID
    target: TypeExpr
    value:  Expr
}

/// A generic type with its arguments written, `Box<i32>` : in a type, as a struct
/// literal's name, as the owner of a static member call (`Bag<T>.make()`). A call's
/// own type arguments are `CallExpr.type_args`.
export GenericInstExpr :: struct {
    span:      Span
    id:        i64 = UNASSIGNED_NODE_ID
    callee:    Expr
    type_args: TypeExpr[]
}

/// A call to a compiler intrinsic: `@size_of(T)`, `@type_name(T)`.
///
/// The parser mints this node only for a known `Intrinsic`: an unknown
/// `@name(...)` in expression position raises P1014.
export IntrinsicCallExpr :: struct {
    span:      Span
    id:        i64 = UNASSIGNED_NODE_ID
    intrinsic: Intrinsic
    name_span: Span
    args:      Expr[]
    trailing_comma: bool = false
}

/// A bare `.Variant`, whose enum type comes from context.
export DotVariantExpr :: struct {
    span:         Span
    id:           i64 = UNASSIGNED_NODE_ID
    variant:      string
    variant_span: Span
}

// ---- Patterns (for `match`) -----------------------------------------------

/// A type test in a pattern, `is T`. `inner` nests a further pattern.
///
/// Binds nothing: the arm reads the scrutinee, narrowed in place, or the name
/// the `match` header gives it (`MatchExpr.binding`).
export IsPattern :: struct {
    span:  Span
    id:    i64 = UNASSIGNED_NODE_ID
    ty:    TypeExpr
    inner: Pattern | null
}

/// A struct destructuring pattern.
export StructPattern :: struct {
    span:   Span
    id:     i64 = UNASSIGNED_NODE_ID
    fields: StructPatternField[]
}

/// One field of a struct pattern.
export StructPatternField :: struct {
    span:      Span
    id:        i64 = UNASSIGNED_NODE_ID
    name:      string
    name_span: Span
    value:     PatternFieldValue
}

/// A struct-pattern field bound to a name.
export PatternBinding :: struct { name: string, span: Span, id: i64 = UNASSIGNED_NODE_ID }
/// A struct-pattern field matched against a literal.
export PatternLiteral :: struct { value: Expr }

/// The `_` pattern.
///
/// On a closed union this silences the exhaustiveness check, which is why the style
/// guide forbids it in value position there.
export WildcardPattern :: struct { span: Span, id: i64 = UNASSIGNED_NODE_ID }

/// A pattern matching one enum variant, `.Variant`.
export EnumVariantPattern :: struct {
    span:    Span
    id:      i64 = UNASSIGNED_NODE_ID
    variant: string
}

/// Match a literal value : `'a' -> ...`, `42 -> ...`, `"ok" -> ...`, etc.
/// The inner `value` is the parsed literal as an Expr ; the lowerer
/// emits `scrutinee == value` as the arm predicate.
export LiteralPattern :: struct {
    span:  Span
    id:    i64 = UNASSIGNED_NODE_ID
    value: Expr
}

/// Range pattern : `'a'..='z' -> ...`, `0..<10 -> ...`. Matches when a scalar
/// scrutinee falls in the range. `inclusive` = `..=` (upper bound included),
/// else `..<` (excluded). The bounds are literal scalar exprs (char / int) of
/// the scrutinee's type ; the lowerer emits
/// `scrutinee >= lower && scrutinee <(=) upper`. Binds nothing, and (like a
/// literal pattern over an open scalar domain) exhausts nothing.
export RangePattern :: struct {
    span:      Span
    id:        i64 = UNASSIGNED_NODE_ID
    inclusive: bool
    lower:     Expr
    upper:     Expr
}

/// Or-pattern : `.A | .B -> ...`, `1 | 2 | 3 -> ...`. Matches when ANY alternative
/// matches. Parsed from pipe-separated patterns in a match arm. The `is A | B`
/// form does NOT produce this: there the type parser folds `A | B` into a
/// single union `IsPattern` (equivalent narrowing + exhaustiveness). The
/// alternatives are value-level (enum variants / literals) and bind nothing.
export OrPattern :: struct {
    span:     Span
    id:       i64 = UNASSIGNED_NODE_ID
    patterns: Pattern[]
}

// ---- Type expressions -----------------------------------------------------

/// A function type as written, `fn(i32) -> bool`: type-only, with no value-side
/// counterpart.
export FnTypeExpr :: struct {
    span:        Span
    id:          i64 = UNASSIGNED_NODE_ID
    params:      TypeExpr[]
    return_type: TypeExpr | null
}

/// An array type as written, `T[]`: type-only.
///
/// The bracketed form `[T1, T2]` parses as a `SeqLitExpr` (tuple type) instead.
export ArrayTypeExpr :: struct {
    span:    Span
    id:      i64 = UNASSIGNED_NODE_ID
    element: TypeExpr
}

// ---- Helpers --------------------------------------------------------------

/// Flatten a `T | U | V | ...` `BitOr` BinaryExpr chain into its variant
/// list, in source order. Non-`BitOr` expressions are returned as a
/// single-element list. Used by `vader/tools/fmt` and `vader/front/typecheck` to
/// avoid hand-rolling the same recursion on each side.
export collect_bitor_variants :: fn(e: Expr) -> Expr[] {
    out: Expr[]: []
    append_bitor_variants(e, out)
    return out
}

append_bitor_variants :: fn(e: Expr, out: Expr[]) -> void {
    match e {
        is BinaryExpr -> {
            if e.op == .BitOr {
                append_bitor_variants(e.left, out)
                append_bitor_variants(e.right, out)
                return
            }
            out.push(e)
        }
        _ -> { out.push(e) }
    }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_every_operator_is_spelled_back_to_itself :: fn() -> void {
    for op in BinaryOp {
        assert(binary_op_spelled(binary_op_symbol(op)) == op, binary_op_symbol(op))
    }
    for op in UnaryOp {
        assert(unary_op_spelled(unary_op_symbol(op)) == op, unary_op_symbol(op))
    }
}
