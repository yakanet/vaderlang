// toolchain/ast/ast.vader — the shape of written Vader, as data.
//
// The public contract a build-time metaprogram reads. It lives outside `vader/`
// because of what depends on it: a library shipping a generator must be able to
// walk declarations without depending on the compiler, and this module needs
// nothing from the compiler either — only `toolchain/span`, for where each node
// came from. Everything that INTERPRETS these nodes (resolve, typecheck, lower)
// stays in `vader/`.
//
// It is the tree AS WRITTEN, before resolution: an `IdentExpr("Id")` is the name
// the author typed, not the type it denotes. A generator that needs to know
// whether that name is a primitive, an alias, an imported struct or a distinct
// newtype cannot answer it from here — see the note on resolved declarations in
// the TODO's toolchain item.
//
// Layout note : declaration order is free — the resolver collects every
// decl name in a first pass before walking types in the second, so a
// union alias can sit before or after the variant structs it lists.
// Type-bearing fields are renamed `ty` (since `type` was historically a
// keyword) ; the dumper emits the JSON key as `"type"` so snapshots
// stay stable.

module "toolchain/ast"

import "toolchain/span"

/// Sentinel `id` on a node the parser has just minted.
///
/// Node ids are assigned in a later pass (`vader/parser::assign_program_ids`), which
/// replaces this with a fresh unique value (≥ 1), so a freshly parsed tree carries
/// the sentinel everywhere. A generator reading a typechecked tree sees real ids;
/// one building nodes by hand leaves them at the default — it is every node's
/// `.id` default, so a construction may omit the field.
export UNASSIGNED_NODE_ID :: usize(0)

// ============================================================================
// Type aliases (declared first — see header)
// ============================================================================

/// Anything that can appear at the top level of a file.
export Decl :: ImportDecl | FnDecl | StructDecl | EnumDecl | TraitDecl | ImplDecl | TypeAliasDecl | ConstDecl | AssertDecl

/// What an `import` binds: a namespace alias, a modifier list, or nothing.
///
/// The three forms of SPEC §Modules — `X :: import "p"`, `import "p" { a as b }`,
/// and the bare `import "p"` wildcard.
export ImportBinding :: NamedNamespaceImport | DestructureImport | WildcardImport

/// Which of the three `for` shapes a loop is: `for {}`, `for cond {}`, `for x in xs {}`.
export ForForm :: InfiniteFor | WhileFor | InFor

/// Any expression. Also serves as `TypeExpr` — see the note there.
export Expr :: IntLitExpr | FloatLitExpr | BoolLitExpr | NullLitExpr | CharLitExpr | StringLitExpr | IdentExpr | CallExpr | FieldExpr | IndexExpr | UnaryExpr | BinaryExpr | NullCoalesceExpr | IfExpr | MatchExpr | BlockExpr | LambdaExpr | StructLitExpr | SeqLitExpr | RangeExpr | CastExpr | GenericInstExpr | IntrinsicCallExpr | DotVariantExpr | FnTypeExpr | ArrayTypeExpr | MutableTypeExpr | AwaitExpr

/// One piece of a string literal: literal text, or an interpolated expression.
export StringLitPart :: StringLitText | StringLitInterp

/// What follows an `else`: another `if` branch, or a final block.
export IfElse :: IfElseIf | IfElseBlock

/// Anything that can appear on the left of a `match` arm's `->`.
export Pattern :: IsPattern | StructPattern | TuplePattern | WildcardPattern | BindingPattern | EnumVariantPattern | LiteralPattern | RangePattern | OrPattern

/// What a `::` / `:=` binds: one name, a tuple destructure, `_`, or a rest binding.
export LetBinding :: SimpleBinding | TupleBinding | WildcardBinding | RestBinding

/// Inside a struct pattern, what a field is matched against: a binding or a literal.
export PatternFieldValue :: PatternBinding | PatternLiteral

/// Right operand of `??` (null-coalescing). Either an ordinary value
/// expression (must be assignable to the non-null result type) or a
/// divergent statement (`return` / `break` / `continue`, typed `never`).
/// The divergent forms are statements — not `Expr` variants — so they are
/// carried here directly rather than through the `Expr` union.
export CoalesceFallback :: Expr | ReturnStmt | BreakStmt | ContinueStmt

/// The value expression a read-only expression walker should descend into
/// for a `??` fallback : the fallback expression itself, the value of a
/// `return <expr>`, or `null` for a bare `return` / `break` / `continue`.
/// Passes that also need to visit the statement node itself (id assignment,
/// typecheck, formatting) destructure `CoalesceFallback` directly instead.
export coalesce_fallback_expr :: fn(f: CoalesceFallback) -> Expr | null = match f {
    is ReturnStmt -> f.value
    is BreakStmt | ContinueStmt -> null
    is Expr -> f
}

/// A type AS WRITTEN — the same node set as `Expr`, deliberately.
///
/// Vader's type grammar is a subset of its expression grammar (`i32`, `Foo<T>`,
/// `A | B`, `fn(i32) -> bool`, `T[]`), so the parser reuses the expression nodes
/// rather than duplicating them. What counts as a type expression is decided by
/// POSITION — the slot demanding a type — never by node shape; the alias exists to
/// say so at each slot (`StructField.ty: TypeExpr`).
///
/// A reader must not assume an `IdentExpr` in type position denotes a type it can
/// name: `Id` may be an alias, an imported struct or a distinct newtype, and only
/// the resolver knows which.
export TypeExpr :: IntLitExpr | FloatLitExpr | BoolLitExpr | NullLitExpr | CharLitExpr | StringLitExpr | IdentExpr | CallExpr | FieldExpr | IndexExpr | UnaryExpr | BinaryExpr | NullCoalesceExpr | IfExpr | MatchExpr | BlockExpr | LambdaExpr | StructLitExpr | SeqLitExpr | RangeExpr | CastExpr | GenericInstExpr | IntrinsicCallExpr | DotVariantExpr | FnTypeExpr | ArrayTypeExpr | MutableTypeExpr | AwaitExpr

// ============================================================================
// Visibility / shared shapes
// ============================================================================

/// Whether a declaration carries `export`.
export Visibility :: enum(u8) {
    Public,
    Private,
}

// ============================================================================
// Top-level
// ============================================================================

/// One parsed source file.
///
/// `module` is null for a file with no `module "..."` header — an error the resolver
/// reports rather than the parser.
export Program :: struct {
    file:    string
    span:    Span
    id:      usize = UNASSIGNED_NODE_ID
    /// The `module "..."` declaration. Null when absent — the parser
    /// is tolerant ; the resolver's scan emits R2020 on absence.
    module:  ModuleDecl! | null = null
    decls:   Decl[]
}

/// The `module "<name>"` decl that opens every `.vader` file. Carries
/// the validated module name + its source span (the `module` keyword
/// itself lives in the node's overall `span`).
export ModuleDecl :: struct {
    span:      Span
    id:        usize = UNASSIGNED_NODE_ID
    name:      string
    name_span: Span
}

// ============================================================================
// Generics / Decorators
// ============================================================================

/// One entry of a `[T: Bound = Default]` list.
///
/// `is_comptime_value` marks a parameter that carries a VALUE rather than a type
/// (`[N: usize]`), which the comptime engine substitutes.
export TypeParam :: struct {
    span:               Span
    id:                 usize = UNASSIGNED_NODE_ID
    name:               string
    bound:              TypeExpr | null
    /// Default type for this parameter, from `<T = Default>`. Honored when an
    /// impl supplies fewer trait-args than the trait declares — the trailing
    /// params fill from their defaults at impl materialization
    /// (`resolver/materialize.vader::build_subst`). Defaults on struct / fn /
    /// alias params parse but are not yet filled at their use sites (those
    /// instantiations error rather than default). `null` = no default.
    default:            TypeExpr | null = null
    is_comptime_value:  bool
}

/// An `@name` or `@name(args)` above a declaration.
export Decorator :: struct {
    span: Span
    id:   usize = UNASSIGNED_NODE_ID
    name: string
    args: Expr[]
}

/// Whether `decs` carries the decorator called `name`.
///
/// Here rather than in each pass: six modules open-coded this loop, and a
/// decorator's presence is a question about the AST, which is what this module
/// owns.
///
/// @param decs  the declaration's decorators.
/// @param name  the decorator name, without the `@`.
export decorators_have :: fn(decs: Decorator[], name: string) -> bool {
    for d in decs {
        if d.name == name {
            return true
        }
    }
    return false
}

// ============================================================================
// Declarations
// ============================================================================

// ---- Import ---------------------------------------------------------------

/// An `import` statement, whatever its form — see `ImportBinding`.
export ImportDecl :: struct {
    span:       Span
    id:         usize = UNASSIGNED_NODE_ID
    path:       string
    binding:    ImportBinding
    decorators: Decorator[]
}

/// `name :: import "..."` — namespace binding ; members reached via `name.X`.
export NamedNamespaceImport :: struct {
    name: string
}
/// `import "p" { x as y, z as _ }` — a WILDCARD of p plus per-name modifiers:
/// every listed source name is dropped from the wildcard ; `x as y` also rebinds
/// it as `y`, `z as _` is a pure exclusion. A plain name (no `as`) is an error
/// (R2033) — the wildcard already brings every export.
export DestructureImport :: struct {
    names: ImportName![]
    /// True when the source wrote a trailing comma before `}`. Drives the
    /// formatter's Dart-style layout: present -> one name per line.
    trailing_comma: bool = false
}

/// bare `import "..."` — wildcard : every function of the module becomes
/// callable (prefix + UFCS) ; binds no name.
export WildcardImport :: struct {}

/// One `name` or `name as alias` inside an import's modifier list.
///
/// `alias` is null for a bare name, which is `R2033`: a wildcard already brings it.
export ImportName :: struct {
    name:  string
    alias: string | null
    span:  Span
    id:  usize = UNASSIGNED_NODE_ID
}

// ---- Fn -------------------------------------------------------------------

/// A function declaration, `name :: fn(...) -> T { ... }`.
///
/// Four flags mark functions the user did not write. `sam_synthetic` is a
/// single-abstract-method lambda the parser desugared into an impl member;
/// `materialized` a trait default-method body cloned into an implementing type;
/// `comptime_synthetic` a declaration the comptime engine produced. And
/// `is_expression_bodied` distinguishes `f :: fn() = expr` from a braced body,
/// which the formatter needs and a generator emitting source should preserve.
///
/// Each is a plain `bool` defaulting to `false`, never `bool | null` — Vader has no
/// optional fields — and the dumper emits one only when `true`.
export FnDecl :: struct {
    span:                  Span
    id:                  usize = UNASSIGNED_NODE_ID
    name:                  string
    name_span:             Span
    visibility:            Visibility
    type_params:           TypeParam[]
    params:                FnParam![]!
    return_type:           TypeExpr | null
    body:                  BlockExpr | null
    decorators:            Decorator[]
    sam_synthetic:         bool
    is_expression_bodied:  bool
    /// `true` when this FnDecl was synthesised by `materialize_default_members`
    /// — i.e. cloned from a trait default body into an impl. The body's
    /// spans point at the trait's source, so re-typechecking the clone
    /// emits duplicate diagnostics at unhelpful spans. Walkers skip such
    /// methods (the trait itself already type-checked the body once).
    materialized:          bool
    /// `true` when this FnDecl is the `__comptime_NAME` helper the parser
    /// synthesises for the `NAME :: @comptime <expr>` const sugar (see
    /// `desugar_comptime_const`). The formatter skips it — the surface sugar
    /// is re-emitted from the paired `ConstDecl.comptime_body` instead.
    /// Defaults `false` : only the desugar sets it, every other constructor
    /// leaves it off.
    comptime_synthetic:    bool = false
    /// True when the source wrote a trailing comma after the last parameter.
    /// Drives the formatter's Dart-style layout: present -> one param per line.
    trailing_comma:        bool = false
}

/// One parameter of a function, lambda or trait method.
///
/// `mutable` is the `!` on the parameter's TYPE — a read-only slot by default; see
/// SPEC §"Read-only by default".
export FnParam :: struct {
    span:          Span
    id:            usize = UNASSIGNED_NODE_ID
    name:          string
    // Optional in lambdas.
    ty:            TypeExpr | null
    default_value: Expr | null
    variadic:      bool
    /// `!` suffix on the NAME (`buf: u8[]`!, `self!`) — the caller grants this
    /// parameter permission to mutate its referent. Carried on the name rather
    /// than the type so `self!`, which has no written type, reads the same way.
    /// The type-side spelling of the same notion is `FnType.params_mutable`,
    /// needed because a fn TYPE has no parameter names.
    mutable:       bool = false
    /// Decorators written before the parameter (`@c_pointer tv: TimeVal`).
    ///
    /// REQUIRED, with no default, deliberately — the same reason
    /// `StructType.immutable` carries none: three sites in
    /// `resolver/materialize.vader` rebuild a `FnParam` field by field, and a
    /// defaulted field is dropped there in silence. That is how
    /// `FnParam.mutable` was lost once already.
    decorators:    Decorator[]
}

// ---- Struct ---------------------------------------------------------------

/// A struct declaration, `Name :: struct { ... }`.
///
/// The node a generator walks most: `fields` in declaration order, each carrying its
/// written type. `name_span` covers the name alone, which is what a diagnostic about
/// the struct itself should point at.
export StructDecl :: struct {
    span:          Span
    id:            usize = UNASSIGNED_NODE_ID
    name:          string
    name_span:     Span
    visibility:    Visibility
    type_params:   TypeParam[]
    fields:        StructField![]
    decorators:    Decorator[]
}

/// One field of a struct.
///
/// `visibility` is `@internal` — fields are public by default, so this is the opt-out.
/// `default` backs `T {}` construction with the field omitted.
export StructField :: struct {
    span:       Span
    id:         usize = UNASSIGNED_NODE_ID
    name:       string
    ty:         TypeExpr
    visibility: Visibility
    // Optional default value used when a struct literal omits this field.
    default:    Expr | null
}

// ---- Enum -----------------------------------------------------------------

/// An enum declaration, `Name :: enum(u8) { A, B }`.
///
/// `repr` is the backing integer type as written, null when defaulted to `i32`.
export EnumDecl :: struct {
    span:       Span
    id:         usize = UNASSIGNED_NODE_ID
    name:       string
    name_span:  Span
    visibility: Visibility
    // `null` means default `i32` — typechecker resolves the backing type.
    repr:       TypeExpr | null
    variants:   EnumVariant![]
    decorators: Decorator[]
}

/// One variant of an enum, with its explicit value when the source gave one.
export EnumVariant :: struct {
    span:        Span
    id:          usize = UNASSIGNED_NODE_ID
    name:        string
    // `null` means "previous + 1" (or 0 for the first variant). Stored as i64
    // so the parser can carry the parsed literal verbatim until the
    // typechecker reduces it to the final integer.
    value:       i64 | null
    value_span:  Span | null
}

// ---- Trait ----------------------------------------------------------------

/// A trait declaration.
///
/// `members` are its methods, each an `FnDecl`; one with a `body` is a default
/// method.
export TraitDecl :: struct {
    span:        Span
    id:          usize = UNASSIGNED_NODE_ID
    name:        string
    name_span:   Span
    visibility:  Visibility
    type_params: TypeParam[]
    /// The supertrait bound, for either form — `Numeric :: trait<T> = Add & Sub`
    /// (alias form, `members` empty) or `Hashable :: trait<T> : Hash & Eq { … }`
    /// (methods plus composition). A parsed type expression: typically a
    /// `BinaryExpr(.BitAnd)` chain over trait names, though a single trait
    /// reference is valid too. `null` for a plain `trait { … }`.
    requires:    TypeExpr | null
    members:     FnDecl[]
    decorators:  Decorator[]
}

// ---- Impl -----------------------------------------------------------------

/// An `implements` block, or its one-method short form.
///
/// `for_type` is the implementing type as written, `trait_name` the trait — which is
/// a bare string rather than a node because a trait is always named, never computed.
export ImplDecl :: struct {
    span:             Span
    id:               usize = UNASSIGNED_NODE_ID
    type_params:      TypeParam[]
    for_type:         TypeExpr
    trait_name:       string
    trait_name_span:  Span
    trait_args:       TypeExpr[]
    members:          FnDecl![]!
    decorators:       Decorator[]
}

// ---- TypeAlias ------------------------------------------------------------

/// A type alias, `Name :: SomeType`.
///
/// A generator resolving a written type must expect to meet one of these: the alias
/// and its target are indistinguishable in an `IdentExpr`.
export TypeAliasDecl :: struct {
    span:        Span
    id:          usize = UNASSIGNED_NODE_ID
    name:        string
    name_span:   Span
    visibility:  Visibility
    type_params: TypeParam[]
    aliased:     TypeExpr
    decorators:  Decorator[]
}

// ---- Const ----------------------------------------------------------------

/// A module-level constant, `NAME :: value` or the typed `NAME: T: value`.
///
/// `comptime_body` holds the unevaluated expression for a `@comptime` const, whose
/// `value` is filled in by the comptime engine.
export ConstDecl :: struct {
    span:       Span
    id:         usize = UNASSIGNED_NODE_ID
    name:       string
    name_span:  Span
    visibility: Visibility
    ty:         TypeExpr | null
    value:      Expr
    decorators: Decorator[]
    /// Original `@comptime` operand for the `NAME :: @comptime <expr>` sugar,
    /// kept so the formatter re-emits the surface form rather than the
    /// desugared `__comptime_NAME()` call. Non-null marks this const as a
    /// desugared comptime const ; null for every other const. Holds the raw
    /// block/expression the sugar wrapped (pre-`return`-lift), so the exact
    /// source spelling round-trips. See `desugar_comptime_const`.
    comptime_body: Expr | null = null
}

/// An `@assert` at the top level — a build-time invariant.
///
/// `condition` is evaluated by the comptime VM and the build fails with C4015 when
/// it is `false`. Nothing is emitted at runtime.
export AssertDecl :: struct {
    span:       Span
    id:         usize = UNASSIGNED_NODE_ID
    condition:  Expr
    message:    string | null
    decorators: Decorator[]
}

// ============================================================================
// Statements
// ============================================================================

/// A local binding, `x :: e` or `x := e`.
///
/// `mutable` is the `:=` form. Style treats a `:=` that is never reassigned as a
/// defect, so a generator should emit `::` unless it writes to the slot.
export LetStmt :: struct {
    span:    Span
    id:      usize = UNASSIGNED_NODE_ID
    mutable: bool
    binding: LetBinding
    ty:      TypeExpr | null
    value:   Expr
}

/// A local bound to one name — a leaf of the recursive binding tree, whose other
/// leaf is `WildcardBinding` (ignores the slot) and whose only branch is
/// `TupleBinding` (matches a tuple-typed value element-wise).
///
/// `name_span` covers the name alone — the precise target a rename needs, which the
/// whole-binding `span` is too wide for.
export SimpleBinding :: struct {
    span:      Span
    id:        usize = UNASSIGNED_NODE_ID
    name:      string
    name_span: Span
}

/// A destructuring local, `[a, b] :: pair`.
export TupleBinding :: struct {
    span:     Span
    id:       usize = UNASSIGNED_NODE_ID
    elements: LetBinding[]
}

/// A discarded local, `_ :: e`.
export WildcardBinding :: struct {
    span: Span
    id: usize = UNASSIGNED_NODE_ID
}

/// The `...rest` tail of a destructuring local — collects every slot its sibling
/// `SimpleBinding`s did not consume into a fresh array.
///
/// Valid only as the LAST element of a `TupleBinding` whose source is array-typed.
export RestBinding :: struct {
    span:      Span
    id:        usize = UNASSIGNED_NODE_ID
    name:      string
    name_span: Span
}

/// An assignment to an existing place, `target = value`.
export AssignStmt :: struct {
    span:   Span
    id:     usize = UNASSIGNED_NODE_ID
    target: Expr
    value:  Expr
}

/// An expression evaluated for its effect, its value discarded.
export ExprStmt :: struct {
    span: Span
    id:   usize = UNASSIGNED_NODE_ID
    expr: Expr
}

/// A `return`, with no value for a `void` function.
export ReturnStmt :: struct {
    span:  Span
    id:    usize = UNASSIGNED_NODE_ID
    value: Expr | null
}

/// `yield expr` inside a `generator` fn body — emit one element and suspend.
/// Always carries a value (unlike `return`, which may be bare); the empty /
/// exhausted case is a bare `return` or falling off the end. `value` must
/// coerce to the `T` of the generator's `-> Iterator<T>` return.
export YieldStmt :: struct {
    span:  Span
    id:    usize = UNASSIGNED_NODE_ID
    value: Expr
}

/// A loop in any of its three forms — see `ForForm`.
///
/// `label` is the loop-jump target of `break <label>` / `continue <label>`.
export ForStmt :: struct {
    span:  Span
    id:    usize = UNASSIGNED_NODE_ID
    label: string | null
    form:  ForForm!
    body:  BlockExpr
    /// `@comptime for x in <arr> { … }` — unroll at lower time. False for
    /// every other form.
    is_comptime: bool = false
}

/// The `for { ... }` form — no condition, exited by `break` or `return`.
export InfiniteFor :: struct {}
/// The `for cond { ... }` form.
export WhileFor    :: struct { cond: Expr }
/// The `for x in xs { ... }` form.
export InFor       :: struct {
    loop_var: LoopVar
    iter:     Expr
}

/// The loop variable of a `for … in …`. A union so the mutually exclusive
/// shapes can't be miscombined and no sentinel / span-geometry heuristic is
/// needed downstream — each pass matches on the variant. Kept structural on the
/// AST (not desugared at parse) so `vader fmt` round-trips every sugar.
export LoopVar :: NamedVar | DestructureVar | DiscardVar
/// `for x in …` — and the explicit discard `for _ in coll` (name == `"_"`).
export NamedVar       :: struct { name: string, span: Span }
/// `for [k, v] in …` — the leaves bind against the iterable's element type.
export DestructureVar :: struct { pattern: LetBinding }
/// `for <range>` — no user variable is written (the iterable is the range
/// itself). Also the lower-synthesised varless `for <coll>` (while→for sugar).
export DiscardVar     :: struct {}

/// A `break`, optionally naming the loop to leave.
export BreakStmt :: struct {
    span:  Span
    id:    usize = UNASSIGNED_NODE_ID
    label: string | null
}

/// A `continue`, optionally naming the loop to resume.
export ContinueStmt :: struct {
    span:  Span
    id:    usize = UNASSIGNED_NODE_ID
    label: string | null
}

/// A `defer`, running its body when the enclosing scope exits.
export DeferStmt :: struct {
    span: Span
    id:   usize = UNASSIGNED_NODE_ID
    body: DeferBody
}

/// A `defer` deferring one statement.
export DeferStmtBody  :: struct { stmt: Stmt }
/// A `defer` deferring a block.
export DeferBlockBody :: struct { block: BlockExpr }

/// Anything that can appear as a statement in a block.
///
/// Declared AFTER its variant structs, as `DeferBody` is: the resolver collects
/// every decl name before resolving types, so either order works and this one
/// reads top-down.
export Stmt :: LetStmt | AssignStmt | ExprStmt | ReturnStmt | YieldStmt | ForStmt | BreakStmt | ContinueStmt | DeferStmt
/// What a `defer` defers: one statement, or a block.
export DeferBody :: DeferStmtBody | DeferBlockBody

// ============================================================================
// Expressions
// ============================================================================

// ---- literals -------------------------------------------------------------

/// An integer literal.
///
/// Stored as `u64` whatever the written base. The literal is FREE — it adopts the
/// surrounding concrete numeric type — so its node carries no width.
export IntLitExpr :: struct {
    span:   Span
    id:     usize = UNASSIGNED_NODE_ID
    // Unsigned magnitude, full u64 range (the snapshot format renders the
    // value as a decimal string with the trailing `n` so 0..u64.MAX all
    // round-trip losslessly). Negative
    // literals are wrapped by the parser in `UnaryExpr.neg`.
    value:  u64
}

/// A float literal.
export FloatLitExpr :: struct {
    span:   Span
    id:     usize = UNASSIGNED_NODE_ID
    value:  f64
}

/// `true` or `false`.
export BoolLitExpr :: struct {
    span:  Span
    id:    usize = UNASSIGNED_NODE_ID
    value: bool
}

/// The `null` literal.
export NullLitExpr :: struct {
    span: Span
    id:   usize = UNASSIGNED_NODE_ID
}

/// A character literal, stored as its codepoint.
///
/// Free like an integer literal: in an integer context it coerces to that width
/// carrying the codepoint.
export CharLitExpr :: struct {
    span:  Span
    id:    usize = UNASSIGNED_NODE_ID
    value: u32
}

/// A string literal, as the sequence of its parts.
///
/// Always a part list, even with no interpolation, so a reader never has to handle
/// two shapes. A generator emitting source must re-escape `$`, which opens an
/// interpolation.
export StringLitExpr :: struct {
    span:  Span
    id:    usize = UNASSIGNED_NODE_ID
    parts: StringLitPart![]
}

/// A run of literal text inside a string literal.
export StringLitText   :: struct { value: string, span: Span, id: usize = UNASSIGNED_NODE_ID }
/// An interpolated `${...}` inside a string literal.
export StringLitInterp :: struct { expr:  Expr,   span: Span, id: usize = UNASSIGNED_NODE_ID }

// ---- naming / access ------------------------------------------------------

/// A bare name, in value or type position.
///
/// `implicit_dot` marks the leading-dot spelling (`.Variant`), where resolution
/// defers to the surrounding context. `is_type_param_intro` marks a dollar-prefixed
/// name introducing a type parameter rather than referring to one.
///
/// Both are plain `bool`s defaulting to `false`, and the dumper emits their JSON
/// keys (`implicitDot` / `isTypeParamIntro`) only when `true`.
export IdentExpr :: struct {
    span:                Span
    id:                  usize = UNASSIGNED_NODE_ID
    name:                string
    implicit_dot:        bool
    is_type_param_intro: bool
}

/// A call, `callee(args)`.
///
/// `callee` is an arbitrary expression, so this covers `f(x)`, `a.f(x)` (whose callee
/// is a `FieldExpr`) and `P.f(x)` alike — UFCS is not distinguished here.
export CallExpr :: struct {
    span:   Span
    id:     usize = UNASSIGNED_NODE_ID
    callee: Expr
    args:   CallArg![]!
    /// Source wrote a trailing comma before `)` — formatter keeps it exploded.
    trailing_comma: bool = false
}

/// One argument of a call.
///
/// `name` is set for a named argument, `spread` for the `...xs` form.
export CallArg :: struct {
    span:   Span
    id:     usize = UNASSIGNED_NODE_ID
    name:   string | null
    value:  Expr
    /// Reserved for argument-spread `f(...xs)` — not parsed yet, so always
    /// `false` today. The consumers (printer / dump / ufcs) already honour it
    /// so the feature only needs `parse_call_args` to set it.
    spread: bool
}

/// A member access, `target.field`.
///
/// `is_numeric` marks a tuple index (`t.0`), whose "field" is a position.
export FieldExpr :: struct {
    span:       Span
    id:         usize = UNASSIGNED_NODE_ID
    target:     Expr
    field:      string
    field_span: Span
    // True when the field was written as an integer literal (`t.0`). Used by
    // the lowerer to map onto synthetic tuple fields `_0`, `_1`, ...
    is_numeric: bool
}

/// An index, `target[index]`.
export IndexExpr :: struct {
    span:   Span
    id:     usize = UNASSIGNED_NODE_ID
    target: Expr
    index:  Expr
}

// ---- operators ------------------------------------------------------------

/// Which prefix operator a `UnaryExpr` applies.
export UnaryOp :: enum(u8) {
    Neg,
    Not,
    BitNot,
}

/// A prefix operator applied to one operand.
export UnaryExpr :: struct {
    span:    Span
    id:      usize = UNASSIGNED_NODE_ID
    op:      UnaryOp
    operand: Expr
}

/// Which infix operator a `BinaryExpr` applies.
export BinaryOp :: enum(u8) {
    Add, Sub, Mul, Div, Mod,
    Shl, Shr, BitAnd, BitOr, BitXor,
    And, Or,
    Eq, Neq, Lt, Lte, Gt, Gte,
    Is, In, NotIn,
}

/// An infix operator applied to two operands.
///
/// `bind_as` carries the name of an `is T as name` narrowing when the test appears
/// inside a larger boolean expression.
export BinaryExpr :: struct {
    span:  Span
    id:    usize = UNASSIGNED_NODE_ID
    op:    BinaryOp
    left:  Expr
    right: Expr
    /// When `op == BinaryOp.Is`, an optional binding name parsed from
    /// `… is T as <ident>`. The binding lives in the enclosing `if`'s
    /// then-branch (mirrors match-arm semantics). Empty string when
    /// absent — `op != Is` always carries `""`.
    bind_as: string = ""
}

/// Null-coalescing `left ?? fallback`. `left` must be typed `T | null` ;
/// the expression yields `T` (null subtracted). `fallback` supplies the
/// value when `left` is null : either a value expression assignable to `T`,
/// or a divergent statement (`return` / `break` / `continue`, typed
/// `never`). Lowers to `_t :: left ; if _t is null { fallback } else { _t }`,
/// so the existing narrowing engine refines the result to `T`.
export NullCoalesceExpr :: struct {
    span:     Span
    id:       usize = UNASSIGNED_NODE_ID
    left:     Expr
    fallback: CoalesceFallback
}

// ---- control-flow expressions --------------------------------------------

/// An `if`, in statement or value position.
///
/// One node for both: in value position the blocks' trailing expressions are the
/// result, so a generator emitting a conditional value writes this.
export IfExpr :: struct {
    span:        Span
    id:          usize = UNASSIGNED_NODE_ID
    cond:        Expr
    then_block:  BlockExpr
    else_branch: IfElse | null
}

/// An `else if`, holding the next branch.
export IfElseIf    :: struct { branch: IfExpr }
/// A final `else` block.
export IfElseBlock :: struct { block:  BlockExpr }

/// A `match` over a scrutinee.
///
/// `partial` is `@partial` — the match is knowingly non-exhaustive; `unreachable` is
/// `@unreachable` — the uncovered variants are impossible and trap if reached.
export MatchExpr :: struct {
    span:      Span
    id:        usize = UNASSIGNED_NODE_ID
    scrutinee: Expr
    arms:      MatchArm![]
    // `@partial match x { … }` opts out of exhaustiveness — no T3013
    // fires for missing variants. Default `false` keeps the regular
    // exhaustive-by-default behaviour ; the dump suppresses the field
    // when `false` so old snapshots stay byte-identical.
    partial:   bool
    // `@unreachable match x { … }` likewise opts out of T3013, but asserts
    // the *uncovered* variants can never occur : they fall through to the
    // synthesised trap (`LoweredUnreachable`) instead of being handled. Use
    // it for "handle A/B/C, the rest are impossible" — no wildcard, no fake
    // value. Mutually exclusive with `partial`. Defaulted so existing
    // `MatchExpr { … }` literals and old snapshots are unaffected.
    unreachable: bool = false
    /// `match e as x { … }` — the name the scrutinee is aliased under, visible in
    /// every arm and narrowed by each one. `""` when absent. The binding is minted
    /// at the MatchExpr's own span (same convention as `IsPattern`).
    bind_as: string = ""
}

/// One arm of a `match`, with its optional `if` guard.
export MatchArm :: struct {
    span:    Span
    id:      usize = UNASSIGNED_NODE_ID
    pattern: Pattern
    guard:   Expr | null
    body:    Expr
}

/// A braced block.
///
/// `trailing` is the block's value when it ends in an expression rather than a
/// statement, which is what makes a block usable in value position.
export BlockExpr :: struct {
    span:     Span
    id:       usize = UNASSIGNED_NODE_ID
    stmts:    Stmt[]
    trailing: Expr | null
}

// ---- lambdas / literals --------------------------------------------------

/// A lambda, `(x: i32) -> x + 1`.
export LambdaExpr :: struct {
    span:        Span
    id:          usize = UNASSIGNED_NODE_ID
    params:      FnParam![]
    return_type: TypeExpr | null
    body:        BlockExpr
    /// True when the source wrote a trailing comma after the last parameter.
    trailing_comma: bool = false
}

/// A struct literal, `Point { .x = 1 }`.
///
/// `items` mixes fields and spreads in SOURCE order, which a generator must preserve
/// — a later field overrides an earlier spread.
export StructLitExpr :: struct {
    span:      Span
    id:        usize = UNASSIGNED_NODE_ID
    type_name: TypeExpr
    items:     (StructLitField! | StructLitSpread!)[]
    /// True when the source wrote a trailing comma before `}`. The formatter
    /// reads it as a "keep exploded" directive (Dart-style block layout).
    trailing_comma: bool = false
}

/// One entry of a struct literal: a field, or a spread.
export StructLitItem :: StructLitField | StructLitSpread

/// A `.name = value` entry of a struct literal.
export StructLitField :: struct {
    span:      Span
    id:        usize = UNASSIGNED_NODE_ID
    name:      string
    name_span: Span
    value:     Expr
}

/// A `...expr` entry of a struct literal.
export StructLitSpread :: struct {
    span: Span
    id:   usize = UNASSIGNED_NODE_ID
    expr: Expr
}

/// An array or tuple literal, `[a, b, c]`.
///
/// One node for both: the parser does not commit to array or tuple, and the
/// typechecker decides from context.
export SeqLitExpr :: struct {
    span:     Span
    id:       usize = UNASSIGNED_NODE_ID
    elements: Expr[]
    /// True when the source wrote a trailing comma before `]`. Drives the
    /// formatter's Dart-style layout: present -> one element per line.
    trailing_comma: bool = false
}

/// A range, `a..<b` or `a..=b`.
export RangeExpr :: struct {
    span:      Span
    id:        usize = UNASSIGNED_NODE_ID
    inclusive: bool
    lower:     Expr
    upper:     Expr
}

// ---- error / cast / generic / variant -----------------------------------

/// `await e` — suspend the enclosing `async` fn until `e`'s async result is
/// ready, then produce it. A single-operand prefix wrapper; carries no error
/// semantics of its own.
export AwaitExpr :: struct {
    span:  Span
    id:    usize = UNASSIGNED_NODE_ID
    inner: Expr
}

/// An explicit conversion, `T(value)`.
///
/// Only a genuine width or representation change needs one — a free literal adopts
/// its context, so a cast around one is a style defect.
export CastExpr :: struct {
    span:   Span
    id:     usize = UNASSIGNED_NODE_ID
    target: TypeExpr
    value:  Expr
}

/// An explicit type-argument list, `f[i32]` or `Vec[T]`.
export GenericInstExpr :: struct {
    span:      Span
    id:        usize = UNASSIGNED_NODE_ID
    callee:    Expr
    type_args: TypeExpr[]
}

/// A call to a compiler intrinsic — `@size_of(T)`, `@type_name(T)`, `@file("path")`.
///
/// `name` is the intrinsic ident WITHOUT the leading `@`. The recognised set lives
/// in `vader/parser/intrinsics.vader`, and the parser mints this node only for a
/// known name — an unknown `@name(...)` in expression position raises P1014.
export IntrinsicCallExpr :: struct {
    span:      Span
    id:        usize = UNASSIGNED_NODE_ID
    name:      string
    name_span: Span
    args:      Expr[]!
    /// Source wrote a trailing comma before `)` — formatter keeps it exploded.
    trailing_comma: bool = false
}

/// A bare `.Variant`, whose enum type comes from context.
export DotVariantExpr :: struct {
    span:         Span
    id:           usize = UNASSIGNED_NODE_ID
    variant:      string
    variant_span: Span
}

// ============================================================================
// Patterns (for `match`)
// ============================================================================

/// A type test in a pattern, `is T` — optionally binding via `as`.
///
/// `inner` nests a further pattern; `bind_as` names the narrowed value.
export IsPattern :: struct {
    span:    Span
    id:      usize = UNASSIGNED_NODE_ID
    ty:      TypeExpr
    inner:   Pattern | null
    bind_as: string | null
}

/// A struct destructuring pattern.
export StructPattern :: struct {
    span:   Span
    id:     usize = UNASSIGNED_NODE_ID
    fields: StructPatternField![]
}

/// A tuple destructuring pattern, `[p1, p2, ...]` — element-wise sub-patterns.
export TuplePattern :: struct {
    span:     Span
    id:       usize = UNASSIGNED_NODE_ID
    elements: Pattern[]
}

/// One field of a struct pattern.
export StructPatternField :: struct {
    span:      Span
    id:        usize = UNASSIGNED_NODE_ID
    name:      string
    name_span: Span
    value:     PatternFieldValue!
}

/// A struct-pattern field bound to a name.
export PatternBinding :: struct { name: string, span: Span, id: usize = UNASSIGNED_NODE_ID }
/// A struct-pattern field matched against a literal.
export PatternLiteral :: struct { value: Expr }

/// The `_` pattern.
///
/// On a closed union this silences the exhaustiveness check, which is why the style
/// guide forbids it in value position there.
export WildcardPattern :: struct { span: Span, id: usize = UNASSIGNED_NODE_ID }

/// A pattern that binds the whole scrutinee to a name.
export BindingPattern :: struct {
    span: Span
    id:   usize = UNASSIGNED_NODE_ID
    name: string
}

/// A pattern matching one enum variant, `.Variant`.
export EnumVariantPattern :: struct {
    span:    Span
    id:      usize = UNASSIGNED_NODE_ID
    variant: string
}

/// Match a literal value : `'a' -> …`, `42 -> …`, `"ok" -> …`, etc.
/// The inner `value` is the parsed literal as an Expr ; the lowerer
/// emits `scrutinee == value` as the arm predicate.
export LiteralPattern :: struct {
    span:  Span
    id:    usize = UNASSIGNED_NODE_ID
    value: Expr
}

/// Range pattern : `'a'..='z' -> …`, `0..<10 -> …`. Matches when a scalar
/// scrutinee falls in the range. `inclusive` = `..=` (upper bound included),
/// else `..<` (excluded). The bounds are literal scalar exprs (char / int) of
/// the scrutinee's type ; the lowerer emits
/// `scrutinee >= lower && scrutinee <(=) upper`. Binds nothing, and — like a
/// literal pattern over an open scalar domain — exhausts nothing.
export RangePattern :: struct {
    span:      Span
    id:        usize = UNASSIGNED_NODE_ID
    inclusive: bool
    lower:     Expr
    upper:     Expr
}

/// Or-pattern : `.A | .B -> …`, `1 | 2 | 3 -> …`. Matches when ANY alternative
/// matches. Parsed from pipe-separated patterns in a match arm. The `is A | B`
/// form does NOT produce this — there the type parser folds `A | B` into a
/// single union `IsPattern` (equivalent narrowing + exhaustiveness). The
/// alternatives are value-level (enum variants / literals) and bind nothing.
export OrPattern :: struct {
    span:     Span
    id:       usize = UNASSIGNED_NODE_ID
    patterns: Pattern[]
}

// ============================================================================
// Type expressions
// ============================================================================

/// A function type as written, `fn(i32) -> bool` — type-only, with no value-side
/// counterpart.
///
/// `params_mutable` carries the `!` of each parameter, positionally.
export FnTypeExpr :: struct {
    span:        Span
    id:          usize = UNASSIGNED_NODE_ID
    params:      TypeExpr[]
    /// `!` suffix per parameter TYPE (`fn(u8[]!) -> void`) — a fn type has no
    /// parameter names, so the mutation marker lands on the type here, where the
    /// declaration side spells it on the name (`FnParam.mutable`). Empty means no
    /// parameter is marked ; it is never a same-length all-`false` vector, so
    /// "unmarked" stays a single representation.
    params_mutable: bool[] = []
    return_type: TypeExpr | null
}

/// An array type as written, `T[]` — type-only.
///
/// The bracketed form `[T1, T2]` parses as a `SeqLitExpr` (tuple type) instead. No
/// mutability field here: that is the `MutableTypeExpr` wrapper below, which marks
/// one level of the type at a time.
export ArrayTypeExpr :: struct {
    span:    Span
    id:      usize = UNASSIGNED_NODE_ID
    element: TypeExpr
}

/// Postfix `T!` — "mutation through this slot is allowed", one level of the
/// type. Type-only AST node.
///
/// A WRAPPER rather than a `mutable` field, because there is nowhere to put such
/// a field : `TypeExpr` is an alias of `Expr`, so a named type is an `IdentExpr`
/// — a value node that must not grow a type-only flag. Wrapping also gets the
/// per-level granularity for free, which is the whole point : `Cfg![]` (mutable
/// elements in a read-only array) and `Cfg[]!` (mutable array of read-only
/// elements) are different types, and only a per-level marker can tell them
/// apart.
export MutableTypeExpr :: struct {
    span:  Span
    id:    usize = UNASSIGNED_NODE_ID
    inner: TypeExpr
}

// ============================================================================
// Helpers
// ============================================================================

/// Whether a written type grants mutation at ITS OWN level (`Cfg[]!`), or — for
/// a union — at the level of any variant (`Capture[]! | null`).
///
/// A union carries no marker of its own : the bit is DISTRIBUTED over the
/// variants, so `Capture[]! | null` means "mutable when it is an array" and
/// `null` simply can't carry one. Descending into the variants is therefore the
/// same question asked one level down, not a special case.
///
/// Markers deeper inside a composite (`Cfg![]` — mutable elements of a read-only
/// array) belong to the level they follow and are read from the lowered `Type`,
/// not here.
export type_expr_marks_mutable :: fn(ty: TypeExpr | null) -> bool {
    if ty == null { return false }
    if ty is MutableTypeExpr { return true }
    if ty is BinaryExpr {
        if ty.op == BinaryOp.BitOr {
            return type_expr_marks_mutable(ty.left) || type_expr_marks_mutable(ty.right)
        }
    }
    return false
}

/// `ty` with any top-level `!` marker peeled off — the written type's SHAPE.
///
/// Every pass that inspects a written type structurally (is it an array? does its
/// element name a type-param? does it name this impl?) must go through this, or
/// the marker makes it blind. That blindness is not a lost diagnostic : the
/// array-constructor gate in `lower_mono_fn` uses such a shape test to force
/// concrete monomorphisation, and missing it leaves the instance erased, its
/// buffer built at the wrong element width, and its reads returning null — a
/// native segfault.
///
/// Only the TOP level is peeled : a marker deeper in (`Cfg![]`) belongs to the
/// level it follows and is read from the lowered `Type`.
export strip_mut_marker :: fn(ty: TypeExpr | null) -> TypeExpr | null {
    if ty is MutableTypeExpr { return ty.inner }
    return ty
}

/// Whether `p` may be mutated by the callee — the SINGLE source of truth for
/// that question.
///
/// Two spellings reach it : the marker on the TYPE (`fn(x: Cfg[]!)`, the form
/// this chantier moves to) and the legacy marker on the NAME (`fn(x: Cfg!)`),
/// which `self!` keeps for good — `self` is the one parameter whose type is
/// never written, so its marker has nowhere else to go. Anything that asks
/// "is this parameter mutable" must come through here : the resolver's borrow
/// table and the typechecker's desugaring live in different modules and would
/// otherwise drift apart, each answering from one spelling only.
export param_is_mutable :: fn(p: FnParam) -> bool = p.mutable || type_expr_marks_mutable(p.ty)

/// Flatten a `T | U | V | …` `BitOr` BinaryExpr chain into its variant
/// list, in source order. Non-`BitOr` expressions are returned as a
/// single-element list. Used by `vader/fmt` and `vader/typecheck` to
/// avoid hand-rolling the same recursion on each side.
export collect_bitor_variants :: fn(e: Expr) -> Expr[] {
    out: Expr[]! = []
    append_bitor_variants(e, out)
    return out
}

append_bitor_variants :: fn(e: Expr, out: Expr[]!) -> void {
    match e {
        is BinaryExpr -> {
            if e.op == .BitOr {
                append_bitor_variants(e.left, out)
                append_bitor_variants(e.right, out)
                return
            }
            out.push(e)
        }
        _ -> { out.push(e) }
    }
}
