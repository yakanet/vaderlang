// system/posix: raw POSIX syscalls.

module "system/posix"

import "std/ffi"
import "std/target"

/// The runtime's own accessors (`runtime/c/rt/`): no library to open, the
/// interpreter finds them in the running process, and `vader.h` declares them.
VADER_RUNTIME :: CLibrary {
    .name = "",
    .headers = ["vader.h"],
}

// POSIX, one `CLibrary` per family of headers: a program includes the headers
// of the families it reaches, so one `write` brings `<unistd.h>` alone. No
// library to open, the process has them. Only Linux and Darwin bodies reach
// them, so a Windows build never sees `<spawn.h>` or `<termios.h>`. What ISO C
// declares is in `system/libc`.
UNISTD :: CLibrary {
    .name = "",
    .headers = ["<unistd.h>"],
}

FILE_SYSTEM :: CLibrary {
    .name = "",
    .headers = ["<dirent.h>", "<fcntl.h>", "<stdlib.h>", "<sys/stat.h>"],
}

SPAWN :: CLibrary {
    .name = "",
    .headers = ["<signal.h>", "<spawn.h>", "<string.h>", "<sys/wait.h>"],
}

TERMINAL :: CLibrary {
    .name = "",
    .headers = ["<sys/ioctl.h>", "<termios.h>"],
}

POLL :: CLibrary {
    .name = "",
    .headers = ["<poll.h>"],
}

CLOCK :: CLibrary {
    .name = "",
    .headers = ["<time.h>"],
}

RESOURCE :: CLibrary {
    .name = "",
    .headers = ["<sys/resource.h>"],
}

/// Standard output's file descriptor.
export STDOUT :: 1

/// Standard error's file descriptor.
export STDERR :: 2

/// A file descriptor: the system hands it out, a call takes it back, nothing
/// computes with it. `std/io` holds one as a `Descriptor`.
export Fd :: i32

/// A process id, as `posix_spawn` hands it out and `waitpid` takes it back.
/// `std/process` holds one as a `Process`.
export Pid :: i32

/// `write(2)`. Byte count written, or -1 with `errno` set.
///
/// `i64`, not `i32`: POSIX returns `ssize_t`, 64-bit on every target here, and
/// `cc` would narrow it to a smaller Vader result without a word, header or not.
@extern(UNISTD, "write")
export sys_write :: fn(fd: i32, buf: u8[], count: i64) -> i64

/// `CLOCK_REALTIME`: the wall clock.
export CLOCK_REALTIME :: 0

/// `CLOCK_MONOTONIC`. The value is not portable: 6 on Darwin, 1 elsewhere.
export CLOCK_MONOTONIC: i32: if VADER_OS == .Darwin { 6 } else { 1 }

/// `opendir(3)`. NULL when `path` is not a directory, does not exist, or
/// cannot be searched.
///
/// It answers "is this a directory" only for a directory the caller can READ:
/// `sys_path_kind` is what `std/fs::is_dir` asks, and says why.
///
/// @param path  the directory to open.
/// @return      a `DIR*`, or null.
@extern(FILE_SYSTEM, "opendir")
export sys_opendir :: fn(path: string) -> CPointer | null

/// `closedir(3)`. Pairs with `sys_opendir`.
///
/// @param dir  the handle `sys_opendir` returned.
@extern(FILE_SYSTEM, "closedir")
export sys_closedir :: fn(dir: CPointer) -> i32

/// `errno` values `std/io` classifies.
///
/// The low numbers are fixed by history and identical on Darwin and Linux; the
/// ones that are not say so on their own line. A raw `errno` is a PLATFORM
/// value: compare against these, never against a literal.
export EPERM: i32: 1
export ENOENT: i32: 2
export EINTR: i32: 4
export EIO: i32: 5
export EBADF: i32: 9
export EACCES: i32: 13
export EEXIST: i32: 17
export ENOTDIR: i32: 20
export EISDIR: i32: 21
export EINVAL: i32: 22
export ENOSPC: i32: 28
export EPIPE: i32: 32
/// Diverges: 35 on Darwin, 11 on Linux, where `EDEADLK` sits on the other.
export EAGAIN: i32: if VADER_OS == .Darwin { 35 } else { 11 }
/// Diverges: 66 on Darwin, 39 on Linux.
export ENOTEMPTY: i32: if VADER_OS == .Darwin { 66 } else { 39 }

/// The calling thread's `errno`, as the LAST foreign call left it.
///
/// `errno` is a macro, not a symbol: `*__error()` on Darwin,
/// `*__errno_location()` on glibc, so no `@extern` can name it directly and the
/// runtime reads it for us.
///
/// Read it IMMEDIATELY after the call that failed. Any foreign call in
/// between may overwrite it, this one included once it has returned.
///
/// @return the raw platform value ; 0 when nothing has failed.
@extern(VADER_RUNTIME, "vader_last_errno")
export sys_last_errno :: fn() -> i32

/// What KIND of thing `path` is, via `stat(2)`.
///
/// `struct stat` is NOT mirrorable, not "ambiguous between arches", genuinely
/// inexpressible. A mirror is pinned field by field to `__builtin_offsetof`, so
/// it is only valid as a contiguous LEADING prefix ; `st_mode` leads on neither
/// arch (offset 24 on linux-x86_64, 16 on linux-arm64), and the two arches also
/// disagree on field ORDER, which no width or arch axis could express. So the
/// runtime resolves the member and hands back an ordinal.
/// See `docs/adr/0013-what-the-ffi-boundary-cannot-express.md`.
///
/// `sys_opendir` is NOT a substitute: it needs READ permission where `stat`
/// needs only traverse rights on the parent, so a directory with mode 0111
/// answers "not a directory".
///
/// An `enum` would name the answer set better, but `@extern` cannot carry one
/// (T3050), and a Vader wrapper here would give this module a BODY, which the
/// seed refuses: `system/posix` would then emit a unit on POSIX targets and none
/// on Windows, and `--seed-targets` requires one module set for every target.
/// Hence four constants and a declaration-only module.
///
/// @param path  the path to classify.
/// @return      `PATH_MISSING` when `stat` fails, for any reason.
@extern(VADER_RUNTIME, "vader_path_kind")
export sys_path_kind :: fn(path: string) -> i32

/// When `path` was last modified, in nanoseconds since the Unix epoch, via
/// `stat(2)` : the runtime reads the member for the reason `sys_path_kind`
/// gives, and Darwin names it `st_mtimespec` where Linux says `st_mtim`.
///
/// @param path  the path to probe.
/// @return      -1 when `stat` fails, `errno` saying why.
@extern(VADER_RUNTIME, "vader_path_mtime")
export sys_path_mtime :: fn(path: string) -> i64

/// The size of the regular file `stream` reads, via `fstat(2)`, for the reason
/// `sys_path_kind` gives.
///
/// @param stream  an open `FILE*`.
/// @return        -1 for anything but a regular file (a pipe, a device, whose
///                size says nothing of what a read finds), or when `fstat` fails.
@extern(VADER_RUNTIME, "vader_stream_size")
export sys_stream_size :: fn(stream: CPointer) -> i64

/// The four answers `sys_path_kind` gives. Values must match `vader_path_kind`.
export PATH_MISSING: i32: 0
export PATH_REGULAR: i32: 1
export PATH_DIRECTORY: i32: 2
/// Device, FIFO, socket: anything with no size to speak of.
export PATH_OTHER: i32: 3

/// `readdir(3)`. The next entry, or null at the end of the directory.
///
/// The `struct dirent` it returns is owned and REUSED by the C library: read the
/// name out before the next call and never keep the pointer.
///
/// @param dir  the handle `sys_opendir` returned.
/// @return     a `struct dirent*`, or null at the end.
@extern(FILE_SYSTEM, "readdir")
export sys_readdir :: fn(dir: CPointer) -> CPointer | null

/// The `d_name` of a `struct dirent`, as a Vader string.
///
/// The one step a Vader FFI call cannot take for itself: reading a NAMED member
/// of a C struct. `d_name` sits at a different offset on every system, and only
/// `cc` can resolve it: from the real header, at the accessor in the runtime.
///
/// It has to be a CALL, not a read of the struct: the interpreter has no C
/// layout, but it resolves an `@extern` by name out of the running process the
/// way it reaches libc. That is what keeps `read_dir` working on both backends,
/// which anything in the stdlib has to.
///
/// The returned bytes belong to the C library and die at the next `sys_readdir`;
/// the shim interns them before then.
///
/// @param ent  a `struct dirent*` from `sys_readdir`.
/// @return     the entry name.
@extern(VADER_RUNTIME, "vader_dirent_name")
export dirent_name :: fn(ent: CPointer) -> string

/// `read(2)`. Returns the byte count, `0` at end of file, `-1` on error, and
/// a SHORT read is not an error: a pipe hands over what has arrived so far, so
/// a caller wanting `n` bytes loops until it has them.
///
/// @param fd     the descriptor; `0` is stdin.
/// @param buf    receives the bytes.
/// @param count  how many to ask for, at most `buf.len()`.
/// @return       bytes read, `0` at EOF, `-1` on error.
@extern(UNISTD, "read")
export sys_read :: fn(fd: i32, @c_out buf: u8[], count: i64) -> i64

/// `struct pollfd`: one descriptor and what to watch it for.
///
/// Field names are the C ones because a mirror copies BY NAME.
@c_struct("struct pollfd")
export Pollfd :: struct {
    fd:      i32
    events:  i16
    revents: i16
}

// ---- subprocess -----------------------------------------------------------
//
// `posix_spawn` rather than `fork` + `exec`: forking a process that owns a GC
// heap duplicates it, and everything between the fork and the exec runs in that
// copy. `posix_spawn` hands the whole sequence to the C library.

/// Bytes to reserve for a `posix_spawn_file_actions_t`.
///
/// An OPAQUE buffer: Vader never looks inside, the `spawn_file_actions_*` calls
/// fill it. Nothing checks this number, so it is taken HIGH: MEASURED at 8 on
/// Darwin (the type is a bare `void*`) and 80 on glibc: the same on x86_64,
/// aarch64 and musl.
///
/// Do NOT narrow this to what one system reports.
export SPAWN_ACTIONS_BYTES: i64: 128

/// `WNOHANG`: return immediately rather than waiting. 1 on both systems.
export WNOHANG: i32: 1

/// `SIGKILL`. 9 on both systems.
export SIGKILL: i32: 9

/// `pipe(2)`. Fills `fds` with the read end then the write end.
///
/// @param fds  a two-element array the call writes into.
/// @return     0 on success, -1 on failure.
@extern(UNISTD, "pipe")
export sys_pipe :: fn(@c_out fds: i32[]) -> i32

/// `close(2)`.
///
/// @param fd  the descriptor to close.
@extern(UNISTD, "close")
export sys_close :: fn(fd: i32) -> i32

/// `posix_spawn_file_actions_init(3)`.
///
/// @param actions  `SPAWN_ACTIONS_BYTES` of scratch.
@extern(SPAWN, "posix_spawn_file_actions_init")
export sys_spawn_actions_init :: fn(@c_out actions: u8[]) -> i32

/// `posix_spawn_file_actions_destroy(3)`. Pairs with the init.
///
/// @param actions  the buffer the init filled.
@extern(SPAWN, "posix_spawn_file_actions_destroy")
export sys_spawn_actions_destroy :: fn(@c_out actions: u8[]) -> i32

/// `posix_spawn_file_actions_addclose(3)`: close `fd` in the child.
///
/// @param actions  the actions buffer.
/// @param fd       the descriptor to close after the fork.
@extern(SPAWN, "posix_spawn_file_actions_addclose")
export sys_spawn_actions_addclose :: fn(@c_out actions: u8[], fd: i32) -> i32

/// `posix_spawn_file_actions_adddup2(3)`: `dup2(fd, newfd)` in the child.
///
/// @param actions  the actions buffer.
/// @param fd       the source descriptor.
/// @param newfd    where it lands in the child.
@extern(SPAWN, "posix_spawn_file_actions_adddup2")
export sys_spawn_actions_adddup2 :: fn(@c_out actions: u8[], fd: i32, newfd: i32) -> i32

/// `posix_spawnp(3)`: launch `file`, resolved through `PATH`.
///
/// @param pid      a one-element array receiving the child's pid.
/// @param file     the program name.
/// @param actions  the file actions, or an empty buffer for none.
/// @param attrp    null: no spawn attributes are used.
/// @param argv     a NULL-terminated vector of `char*`, as `i64` words.
/// @param envp     `sys_environ()`.
/// @return         0 on success, an errno value otherwise.
@extern(SPAWN, "posix_spawnp")
export sys_posix_spawnp :: fn(@c_out pid: i32[], file: string, actions: u8[],
                              attrp: CPointer | null, argv: u64[], envp: CPointer) -> i32

/// `waitpid(2)`.
///
/// @param pid      the child to wait for.
/// @param status   a one-element array receiving the raw wait status.
/// @param options  `WNOHANG` to poll rather than block.
/// @return         the pid when it changed state, 0 under `WNOHANG` while it
///                 still runs, -1 on error.
@extern(SPAWN, "waitpid")
export sys_waitpid :: fn(pid: i32, @c_out status: i32[], options: i32) -> i32

/// `kill(2)`.
///
/// @param pid  the process to signal.
/// @param sig  the signal number.
@extern(SPAWN, "kill")
export sys_kill :: fn(pid: i32, sig: i32) -> i32

/// `strdup(3)`: a heap copy of `s`, owned by the caller.
///
/// Used to build the `char**` a spawn wants: a `i64[]` of these lends as one.
///
/// @param s  the string to copy.
/// @return   a `char*` the caller frees with `sys_free`.
@extern(SPAWN, "strdup")
export sys_strdup :: fn(s: string) -> CPointer

/// The process environment, for `sys_posix_spawnp`.
///
/// `environ` is a VARIABLE and the FFI calls functions, so the runtime names it.
/// Passing null instead gives the child an EMPTY environment: no `PATH`, which
/// every spawned tool needs.
///
/// @return  the parent's `char**` environment.
@extern(VADER_RUNTIME, "vader_environ")
export sys_environ :: fn() -> CPointer

/// `POLLIN`: data is available to read. 1 on both systems.
export POLLIN: i16: 1

/// `poll(2)` on a SINGLE descriptor.
///
/// `poll` takes an array; one element crosses as its address, which is the same
/// thing to C. A caller watching several would need the array form.
///
/// @param fds         the descriptor to watch; `revents` is filled in.
/// @param nfds        always 1 here. `nfds_t` is 4 bytes on Darwin and 8 on
///                    Linux, and neither is spellable per target: passing the
///                    wider one is ABI-correct on both, since an `unsigned int`
///                    argument travels in the low half of its register and 1
///                    fits either way. It would not be, for a count that used
///                    the upper bits.
/// @param timeout_ms  milliseconds, negative to block.
/// @return            how many descriptors are ready, 0 on timeout, -1 on error.
@extern(POLL, "poll")
export sys_poll_one :: fn(@c_out fds: Pollfd, nfds: u64, timeout_ms: i32) -> i32

/// Bytes to reserve for a `struct termios`. The LARGER of the measured sizes,
/// deliberately, and not a per-system value.
///
/// MEASURED: 72 on Darwin, 60 on Linux, x86_64 and arm64 alike, the type being
/// built from fixed-width members. A SIZE, not an offset, which is why no
/// architecture axis is needed where a `struct stat` mirror would have wanted one.
///
/// ⚠️ Do NOT narrow this to the per-system figure. The risk is asymmetric:
/// over-reserving wastes 12 bytes on Linux, under-reserving is an out-of-bounds
/// write by `tcgetattr`, which nothing here checks. One constant, taken high, is
/// the shape that cannot be got wrong.
export TERMIOS_BYTES: i64: 72

/// `TCSAFLUSH`: apply after draining output, DISCARDING pending input. That
/// last part is why raw mode uses it: keystrokes meant for the shell must not
/// land in the prompt. 2 on both systems.
export TCSAFLUSH: i32: 2

/// `tcgetattr(3)`. Reads the terminal state into an OPAQUE buffer.
///
/// The buffer is never interpreted on the Vader side: it travels from here to
/// `sys_tcsetattr` and back, so nothing needs the layout of `struct termios`,
/// whose shape differs between systems (`c_line` is Linux-only) and whose `c_cc`
/// is an array. `buf` must hold at least `TERMIOS_BYTES`.
///
/// @param fd   the descriptor: 0 for stdin.
/// @param buf  receives the state.
/// @return     0 on success, -1 otherwise.
@extern(TERMINAL, "tcgetattr")
export sys_tcgetattr :: fn(fd: i32, @c_out buf: u8[]) -> i32

/// `tcsetattr(3)`. Applies a state read by `sys_tcgetattr`.
///
/// @param fd      the descriptor.
/// @param action  when to apply it: `TCSAFLUSH` here.
/// @param buf     the state to install.
/// @return        0 on success, -1 otherwise.
@extern(TERMINAL, "tcsetattr")
export sys_tcsetattr :: fn(fd: i32, action: i32, buf: u8[]) -> i32

/// `cfmakeraw(3)`. Turns a state into the raw one, in place.
///
/// The whole reason Vader never has to name a `termios` member: the flag surgery
/// happens in C. It is MORE aggressive than a hand-rolled raw mode: it also
/// clears `OPOST`, so `\n` no longer returns the carriage and a caller must write
/// `\r\n` itself.
@extern(TERMINAL, "cfmakeraw")
export sys_cfmakeraw :: fn(@c_out buf: u8[]) -> void

/// `struct winsize`: the terminal size `TIOCGWINSZ` fills in.
///
/// Field names are the C ones because a mirror copies BY NAME; the snake_case
/// rule does not reach across the boundary.
@c_struct("struct winsize")
export Winsize :: struct {
    ws_row:    u16
    ws_col:    u16
    ws_xpixel: u16
    ws_ypixel: u16
}

/// `TIOCGWINSZ`. A macro, and its value is not portable: it encodes the
/// direction and the payload size, which differ between the two ioctl schemes.
export TIOCGWINSZ: u64: if VADER_OS == .Darwin { 0x4008_7468 } else { 0x5413 }

/// `ioctl(2)` for `TIOCGWINSZ`. 0 on success, -1 otherwise.
///
/// `ioctl` is variadic; `<sys/ioctl.h>` brings the real prototype, so the shim's
/// three-argument call is ordinary C rather than a redeclaration.
///
/// @param fd       the descriptor to ask about: 1 for stdout.
/// @param request  always `TIOCGWINSZ` here.
/// @param ws       receives the size.
// `int ioctl(int, unsigned long, ...)`: the third argument is VARIADIC.
// Unmarked, the interpreter casts to a non-variadic prototype; on darwin-arm64
// variadic arguments travel on the STACK, so the callee reads an uninitialised
// word and the kernel writes eight bytes through it while reporting success.
@extern(TERMINAL, "ioctl")
export sys_ioctl_winsize :: fn(fd: i32, request: u64, @c_variadic @c_out ws: Winsize) -> i32

/// `_SC_NPROCESSORS_ONLN`: the processors currently online. The value is not
/// portable: 58 on Darwin, 84 on Linux.
export SC_NPROCESSORS_ONLN: i32: if VADER_OS == .Darwin { 58 } else { 84 }

/// `sysconf(3)`. The value of the configuration variable `name`, or -1 with
/// `errno` set: an unknown `name` is `EINVAL`.
///
/// @param name  one of the `SC_*` selectors.
@extern(UNISTD, "sysconf")
export sys_sysconf :: fn(name: i32) -> i64

/// `isatty(3)`. Whether `fd` refers to a terminal.
///
/// @param fd  the descriptor: 1 for stdout, 2 for stderr.
/// @return    1 when it is a terminal, 0 otherwise.
@extern(UNISTD, "isatty")
export sys_isatty :: fn(fd: i32) -> i32

/// `readlink(2)`. Bytes placed in `buf` (NOT NUL-terminated) or -1.
///
/// Linux reads the running binary's path from `/proc/self/exe`.
@extern(UNISTD, "readlink")
export sys_readlink :: fn(path: string, @c_out buf: u8[], size: i64) -> i64

/// `realpath(3)`. Writes the canonical path into `resolved` and returns it, or
/// null on failure. `resolved` must hold at least `PATH_MAX` bytes.
@extern(FILE_SYSTEM, "realpath")
export sys_realpath :: fn(path: string, @c_out resolved: u8[]) -> CPointer | null

/// `getcwd(3)`. Fills `buf` with the working directory, NUL-terminated, and
/// returns it, or null when `buf` is too small or the directory is unreadable.
/// The length is not reported: read up to the NUL.
///
/// @param buf   receives the path.
/// @param size  `buf`'s capacity in bytes.
@extern(UNISTD, "getcwd")
export sys_getcwd :: fn(@c_out buf: u8[], size: i64) -> CPointer | null

/// The bytes of `buf` before its first NUL, as a string: how a C call that
/// fills a buffer reports the length when it does not return one.
///
/// @param buf  the buffer the call filled; all of it when it holds no NUL.
export up_to_nul :: fn(buf: u8[]) -> string {
    end := buf.len()
    for i in 0..<buf.len() {
        if buf[i] == 0 {
            end = i
            break
        }
    }
    return buf[0..<end].bytes_to_string()
}

/// `chdir(2)`. 0 on success, -1 with `errno` set.
///
/// @param path  the new working directory.
@extern(UNISTD, "chdir")
export sys_chdir :: fn(path: string) -> i32

/// `mkdir(2)`. 0 on success, -1 with `errno` set: `EEXIST` included, which is
/// why the caller re-tests the path rather than reading `errno`.
///
/// @param path  directory to create.
/// @param mode  permission bits, masked by the process umask.
@extern(FILE_SYSTEM, "mkdir")
// `mode_t` is 2 bytes on Darwin and 4 on Linux, and neither is spellable per
// target: same shape as `nfds_t` on `sys_poll_one`. Passing the wider one is
// ABI-correct here because a permission mask uses the low bits and an argument
// travels in the low half of its register.
export sys_mkdir :: fn(path: string, mode: u32) -> i32

/// `access(2)` mode: does the entry exist at all.
export F_OK :: 0

/// `access(2)`. 0 when the check passes, -1 with `errno` set otherwise.
///
/// `F_OK` answers existence without a `struct stat`, which is why `exists` uses
/// it: no C struct has to be mirrored to ask the only question being asked.
@extern(UNISTD, "access")
export sys_access :: fn(path: string, mode: i32) -> i32

/// `unlink(2)`. 0 on success, -1 with `errno` set.
///
/// NOT `remove(3)`: on POSIX that falls back to `rmdir` for a directory, so an
/// empty one would vanish through a call named remove_FILE.
@extern(UNISTD, "unlink")
export sys_unlink :: fn(path: string) -> i32

/// `open(2)` access modes: exactly one of the three.
export O_RDONLY: i32: 0
/// See `O_RDONLY`.
export O_WRONLY: i32: 1
/// See `O_RDONLY`.
export O_RDWR: i32: 2

/// `open(2)` flags. The values are not portable, Darwin and Linux disagree on
/// each of them.
export O_APPEND: i32: if VADER_OS == .Darwin { 0x8 } else { 0x400 }
/// See `O_APPEND`.
export O_CREAT: i32: if VADER_OS == .Darwin { 0x200 } else { 0x40 }
/// See `O_APPEND`.
export O_TRUNC: i32: if VADER_OS == .Darwin { 0x400 } else { 0x200 }
/// See `O_APPEND`.
export O_EXCL: i32: if VADER_OS == .Darwin { 0x800 } else { 0x80 }
/// See `O_APPEND`. Closes the descriptor in a program `posix_spawn` starts.
export O_CLOEXEC: i32: if VADER_OS == .Darwin { 0x0100_0000 } else { 0x8_0000 }

/// `open(2)`. A descriptor, or -1 with `errno` set.
///
/// @param path   the file to open.
/// @param flags  one access mode, `O_RDONLY` to `O_RDWR`, and the `O_*` flags.
/// @param mode   permission bits of a file `O_CREAT` creates, masked by the
///               process umask.
// `mode_t` goes through the `...` of `int open(const char *, int, ...)`, where C
// reads it as an `int`.
@extern(FILE_SYSTEM, "open")
export sys_open :: fn(path: string, flags: i32, @c_variadic mode: i32) -> i32

/// `lseek(2)` origins: the start, the current offset, the end.
export SEEK_SET: i32: 0
/// See `SEEK_SET`.
export SEEK_CUR: i32: 1
/// See `SEEK_SET`.
export SEEK_END: i32: 2

/// `lseek(2)`. The new offset from the start, or -1 with `errno` set: `ESPIPE`
/// on a pipe, which has no offset.
///
/// @param whence  `SEEK_SET`, `SEEK_CUR` or `SEEK_END`.
@extern(UNISTD, "lseek")
export sys_lseek :: fn(fd: i32, offset: i64, whence: i32) -> i64

/// What kind of file the descriptor `fd` is open on, via `fstat(2)`, for the
/// reason `sys_path_kind` gives.
///
/// @return  one of the `PATH_*` answers; `PATH_MISSING` when `fstat` fails.
@extern(VADER_RUNTIME, "vader_fd_kind")
export sys_fd_kind :: fn(fd: i32) -> i32

/// The size of the regular file the descriptor `fd` is open on, via `fstat(2)`,
/// for the reason `sys_path_kind` gives.
///
/// @return  -1 for anything but a regular file (a pipe, a device, whose size
///          says nothing of what a read finds), or when `fstat` fails.
@extern(VADER_RUNTIME, "vader_fd_size")
export sys_fd_size :: fn(fd: i32) -> i64

/// `clock_gettime(2)`. Fills `ts`: two cells standing in for `struct timespec`,
/// both members being 64-bit here: with seconds then nanoseconds. -1 on failure.
@extern(CLOCK, "clock_gettime")
export sys_clock_gettime :: fn(clock_id: i32, @c_out ts: i64[]) -> i32

/// `nanosleep(2)`. `req` and `rem` stand in for a `struct timespec` each, as for
/// `sys_clock_gettime`. 0 once `req` has elapsed; -1 with `errno` set, and `rem`
/// holding what is left, when a signal cut the wait short (`EINTR`).
@extern(CLOCK, "nanosleep")
export sys_nanosleep :: fn(req: i64[], @c_out rem: i64[]) -> i32

// ---- resource usage -------------------------------------------------------

/// `RUSAGE_SELF`: the calling process, as `sys_getrusage`'s `who`.
export RUSAGE_SELF: i32: 0

/// The 64-bit cells of a `struct rusage`, which `sys_getrusage` fills.
export RUSAGE_CELLS: i64: 18

/// The cell of `ru_maxrss`, the peak resident set size, after the two
/// `struct timeval`. Its unit is `RU_MAXRSS_UNIT` bytes.
export RU_MAXRSS_CELL: i64: 4

/// The unit of `ru_maxrss`, in bytes: Darwin counts bytes, Linux kilobytes.
export RU_MAXRSS_UNIT: i64: if VADER_OS == .Darwin { 1 } else { 1024 }

/// `getrusage(2)`. Fills `usage` with what `who` has consumed; 0 on success, -1
/// with `errno` set.
///
/// `usage` stands in for a `struct rusage`, `RUSAGE_CELLS` long: a mirror would
/// have to start with the two `struct timeval`, whose `tv_usec` is 4 bytes on
/// Darwin and 8 on Linux, while the cells line up on both.
@extern(RESOURCE, "getrusage")
export sys_getrusage :: fn(who: i32, @c_out usage: i64[]) -> i32

/// `_SC_PAGESIZE`: the size of a memory page, in bytes. The value is not
/// portable: 29 on Darwin, 30 on Linux.
export SC_PAGESIZE: i32: if VADER_OS == .Darwin { 29 } else { 30 }
