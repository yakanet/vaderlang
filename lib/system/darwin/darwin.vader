// system/darwin: the Darwin calls and layouts the standard library needs.
//
// Split from `system/posix` because POSIX does not define these:
// `_NSGetExecutablePath` is Darwin's answer to `/proc/self/exe`, and the Mach
// calls are Darwin's own. Sibling of `system/windows`.

module "system/darwin"

import "std/ffi"

/// Darwin's own headers: no library to open, the process has them.
DARWIN :: CLibrary {
    .name = "",
    .headers = ["<mach-o/dyld.h>", "<mach/mach.h>"],
}

/// `_NSGetExecutablePath` (`<mach-o/dyld.h>`). 0 on success, non-zero when
/// `buf` was too small.
///
/// C writes the NEEDED capacity back through `size` and Vader never sees it: a
/// scalar `@c_pointer` cannot be an out-parameter (`@c_out` on one is `T3079`), the
/// shim's temporary dying at the return. A caller wanting to retry at the right size
/// must lend a one-element array instead. The one caller does not: it starts at
/// 4096, four times `PATH_MAX` on Darwin, and treats failure as "give up".
///
/// Darwin's answer to `/proc/self/exe`. The path it gives may be relative or
/// carry symlinks, so callers pass it through `realpath`.
@extern(DARWIN, "_NSGetExecutablePath")
export ns_get_executable_path :: fn(@c_out buf: u8[], @c_pointer size: u32) -> i32

/// `mach_task_self()` (`<mach/mach.h>`): the port naming the calling task. C
/// defines it as a macro over a global; the system library also exports it as a
/// function, which is what `vader run` resolves.
@extern(DARWIN, "mach_task_self")
export mach_task_self :: fn() -> u32

/// `MACH_TASK_BASIC_INFO`: the `task_info` flavor that fills a
/// `struct mach_task_basic_info`.
export MACH_TASK_BASIC_INFO: u32: 20

/// `MACH_TASK_BASIC_INFO_COUNT`: the size of `struct mach_task_basic_info`, in
/// 32-bit words.
export MACH_TASK_BASIC_INFO_COUNT: u32: 12

/// `KERN_SUCCESS`: what a Mach call returns when it succeeds.
export KERN_SUCCESS: i32: 0

/// `task_info` (`<mach/mach.h>`). Fills `info` with what `flavor` asks about
/// `task`. `count` holds `info`'s capacity in 32-bit words going in, and the
/// words written coming out. `KERN_SUCCESS` on success.
///
/// `info` stands in for the flavor's struct: for `MACH_TASK_BASIC_INFO`, six
/// 64-bit words, `resident_size` the second.
@extern(DARWIN, "task_info")
export task_info :: fn(task: u32, flavor: u32, @c_out info: u64[], @c_out count: u32[]) -> i32
