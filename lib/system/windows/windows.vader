// system/windows: the Win32 calls the standard library needs.
//
// Not the CRT: `_write` would be the shorter road, but it is an emulation layer
// over these, and going through it means inheriting its buffering and its
// descriptor table for no gain.

module "system/windows"

import "std/ffi"

/// The library the Win32 calls below come from: the interpreter opens
/// `kernel32.dll` to find them, and `<windows.h>` declares them.
KERNEL32 :: CLibrary { .name = "kernel32", .headers = ["<windows.h>"] }

/// The runtime's own accessors (`runtime/c/rt/`): no library to open, the
/// interpreter finds them in the running process, and `vader.h` declares them.
VADER_RUNTIME :: CLibrary { .name = "", .headers = ["vader.h"] }

/// A Win32 `HANDLE`: an opaque kernel object, never dereferenced.
export Handle :: CPointer

// Over `CPointer`, not `Handle`: a name over a distinct type is an alias of it,
// and the two kinds would then pass for one another and for any `Handle`.

/// The read end of a pipe `create_watched_pipe` made. `std/io` holds one as a
/// `Descriptor`.
export PipeHandle :: CPointer

/// A process `CreateProcess` started. `std/process` holds one as a `Process`.
export ProcessHandle :: CPointer

/// `nStdHandle` selectors. `DWORD` is unsigned, so the negative constants are
/// written in their two's-complement form.
export STD_OUTPUT_HANDLE: u32 : 0xFFFF_FFF5

/// See `STD_OUTPUT_HANDLE`.
export STD_ERROR_HANDLE: u32 : 0xFFFF_FFF4

/// See `STD_OUTPUT_HANDLE`.
export STD_INPUT_HANDLE: u32 : 0xFFFF_FFF6

/// `GetStdHandle`. Returns `INVALID_HANDLE_VALUE` on failure.
///
/// @param which  one of the `STD_*_HANDLE` selectors.
/// @return       the standard device's handle.
@extern(KERNEL32, "GetStdHandle")
export get_std_handle :: fn(which: u32) -> Handle

/// `ALL_PROCESSOR_GROUPS`: asks `GetActiveProcessorCount` for every group, not
/// just the caller's (a group holds at most 64 processors).
export ALL_PROCESSOR_GROUPS: u16 : 0xFFFF

/// `GetActiveProcessorCount`. Logical processors active in `group`; 0 on
/// failure.
///
/// @param group  a processor group, or `ALL_PROCESSOR_GROUPS`.
@extern(KERNEL32, "GetActiveProcessorCount")
export get_active_processor_count :: fn(group: u16) -> u32

/// `GetCurrentProcessId`. The id of the calling process; it cannot fail.
@extern(KERNEL32, "GetCurrentProcessId")
export get_current_process_id :: fn() -> u32

/// `GetModuleFileNameW`. Writes the running module's path into `buf` and
/// returns its length; 0 on failure, or `size` exactly when it was truncated.
///
/// @param module  `null` for the running executable.
@extern(KERNEL32, "GetModuleFileNameW")
export get_module_file_name :: fn(module: CPointer | null, @c_out buf: u16[], size: u32) -> u32

/// `GetCurrentDirectoryW`. Writes the working directory into `buf` and returns
/// its length; 0 on failure, or a length >= `size` when `buf` is too small.
///
/// @param size  `buf`'s capacity in UTF-16 UNITS, not bytes.
/// @param buf   receives the path, NUL-terminated.
@extern(KERNEL32, "GetCurrentDirectoryW")
export get_current_directory :: fn(size: u32, @c_out buf: u16[]) -> u32

/// `SetCurrentDirectoryW`. Zero on failure.
///
/// @param path  the new working directory, NUL-terminated UTF-16.
/// @return      non-zero on success.
@extern(KERNEL32, "SetCurrentDirectoryW")
export set_current_directory :: fn(path: u16[]) -> i32

/// `GetTempPathW`. Writes the temp directory, trailing backslash included, into
/// `buf`. Returns its length, 0 on failure, or a length >= `size` when `buf` is
/// too small: in both of which cases nothing usable was written.
///
/// @param size  `buf`'s capacity in UTF-16 UNITS, not bytes.
/// @param buf   receives the path, NUL-terminated.
/// @return      UTF-16 units written, excluding the NUL.
@extern(KERNEL32, "GetTempPathW")
export get_temp_path :: fn(size: u32, @c_out buf: u16[]) -> u32

/// `CreateDirectoryW`. False on failure, `ERROR_ALREADY_EXISTS` included: the
/// caller re-tests the path rather than reading `GetLastError`.
///
/// @param path      directory to create.
/// @param security  `lpSecurityAttributes`; `null` for the default descriptor.
@extern(KERNEL32, "CreateDirectoryW")
export create_directory :: fn(path: u16[], security: CPointer | null) -> bool

/// `FILE_ATTRIBUTE_DIRECTORY`: set when the entry is a directory.
export FILE_ATTRIBUTE_DIRECTORY: u32 : 0x10

/// `FILE_ATTRIBUTE_READONLY`: set when the entry may not be written.
export FILE_ATTRIBUTE_READONLY: u32 : 0x1

/// `FILE_ATTRIBUTE_REPARSE_POINT`: set on a reparse point read without following
/// it, a link or another kind (`IO_REPARSE_TAG_NAME_SURROGATE` tells them apart).
export FILE_ATTRIBUTE_REPARSE_POINT: u32 : 0x400

/// What `GetFileAttributesW` returns for a path it cannot query.
export INVALID_FILE_ATTRIBUTES: u32 : 0xFFFF_FFFF

/// `GetFileExInfoStandard`, the `GET_FILEEX_INFO_LEVELS` that fills a
/// `WIN32_FILE_ATTRIBUTE_DATA`.
export GET_FILE_EX_INFO_STANDARD: i32: 0

/// `GetFileAttributesExW`. False when the path cannot be queried.
///
/// `data` crosses as the nine `DWORD`s of a `WIN32_FILE_ATTRIBUTE_DATA`, which
/// has no padding : `ftLastWriteTime` is cells 5 (low half) and 6 (high half).
///
/// @param path   the path to query.
/// @param level  always `GET_FILE_EX_INFO_STANDARD`.
/// @param data   receives the attribute data ; nine cells at least.
/// @return       whether the query succeeded.
@extern(KERNEL32, "GetFileAttributesExW")
export get_file_attributes_ex :: fn(path: u16[], level: i32, @c_out data: u32[]) -> bool

/// `GetFileAttributesW`. `INVALID_FILE_ATTRIBUTES` when the path cannot be
/// queried, which is how existence is tested, there being no `access` here.
///
/// @param path  the path to query.
/// @return      the attribute bitmask, or `INVALID_FILE_ATTRIBUTES`.
@extern(KERNEL32, "GetFileAttributesW")
export get_file_attributes :: fn(path: u16[]) -> u32

/// `DeleteFileW`. Zero on failure. Refuses a directory, and a link to one.
///
/// @param path  the file to delete.
/// @return      non-zero on success.
@extern(KERNEL32, "DeleteFileW")
export delete_file :: fn(path: u16[]) -> i32

/// `RemoveDirectoryW`. False on failure: `ERROR_DIR_NOT_EMPTY` for a directory
/// that holds anything. Removes a link to a directory, not what it points to.
@extern(KERNEL32, "RemoveDirectoryW")
export remove_directory_w :: fn(path: u16[]) -> bool

/// `SetFileAttributesW`. False on failure.
///
/// @param attributes  the whole bitmask, `get_file_attributes` read first.
@extern(KERNEL32, "SetFileAttributesW")
export set_file_attributes_w :: fn(path: u16[], attributes: u32) -> bool

/// `MoveFileExW`. False on failure.
///
/// @param flags  `MOVEFILE_REPLACE_EXISTING` to take the place of a file.
@extern(KERNEL32, "MoveFileExW")
export move_file_ex_w :: fn(from: u16[], to: u16[], flags: u32) -> bool

/// See `move_file_ex_w`.
export MOVEFILE_REPLACE_EXISTING: u32 : 0x1

/// `CopyFileW`: the content and the attributes. False on failure.
///
/// @param fail_if_exists  false to replace the target.
@extern(KERNEL32, "CopyFileW")
export copy_file_w :: fn(from: u16[], to: u16[], fail_if_exists: bool) -> bool

/// `GetFileInformationByHandle`. False on failure.
///
/// @param info  `FILE_INFORMATION_CELLS` cells for a `BY_HANDLE_FILE_INFORMATION`:
///              the attributes in cell 0, the last write `FILETIME` in cells 5
///              (low) and 6 (high), the size in cells 8 (high) and 9 (low).
@extern(KERNEL32, "GetFileInformationByHandle")
export get_file_information_by_handle :: fn(h: Handle, @c_out info: u32[]) -> bool

/// The `DWORD`s of a `BY_HANDLE_FILE_INFORMATION`.
export FILE_INFORMATION_CELLS: i64 : 13

/// `GetFileInformationByHandleEx`: one record of the entry `h` opens. False on
/// failure.
///
/// @param class  the record: `FILE_ATTRIBUTE_TAG_INFO` for the attributes in
///               cell 0 and the reparse tag in cell 1.
/// @param size   the size of `info` in bytes.
@extern(KERNEL32, "GetFileInformationByHandleEx")
export get_file_information_by_handle_ex :: fn(h: Handle, class: i32, @c_out info: u32[],
                                               size: u32) -> bool

/// `FileAttributeTagInfo`, a record of two `DWORD`s.
export FILE_ATTRIBUTE_TAG_INFO: i32 : 9

/// The reparse tag bit of an entry that stands for another: a symbolic link, a
/// junction. A cloud placeholder or a deduplicated file has a tag without it.
export IO_REPARSE_TAG_NAME_SURROGATE: u32 : 0x2000_0000

/// `GetLastError`. The calling thread's last Win32 error code.
///
/// Read it IMMEDIATELY after the call that failed: any Win32 call in
/// between may overwrite it.
///
/// @return the raw Win32 code ; 0 when nothing has failed.
@extern(KERNEL32, "GetLastError")
export get_last_error :: fn() -> u32

/// Win32 error codes `std/io` classifies. Unlike `errno` these are stable
/// across Windows versions, so they are plain literals.
export ERROR_FILE_NOT_FOUND: u32: 2
export ERROR_PATH_NOT_FOUND: u32: 3
export ERROR_ACCESS_DENIED: u32: 5
export ERROR_INVALID_HANDLE: u32: 6
export ERROR_FILE_EXISTS: u32: 80
export ERROR_BROKEN_PIPE: u32: 109
export ERROR_DISK_FULL: u32: 112
export ERROR_DIR_NOT_EMPTY: u32: 145
export ERROR_ALREADY_EXISTS: u32: 183
/// A write to a pipe whose reader closed it.
export ERROR_NO_DATA: u32: 232
/// A directory was asked of a path that names a file.
export ERROR_DIRECTORY: u32: 267

/// `WriteFile`. False on failure: the caller reads `GetLastError`.
///
/// `written` is Win32's `lpNumberOfBytesWritten`, which a synchronous call may
/// NOT pass as null.
///
/// `written` is a one-element array so the count READS BACK, the same shape
/// `read_file` uses. A scalar `@c_address` would not: the callee writes through
/// it and the value is discarded.
///
/// @param h           the device handle.
/// @param buf         the bytes to write.
/// @param count       how many of them.
/// @param written     scratch the callee fills with the byte count; unread.
/// @param overlapped  always null here: this is the synchronous form.
/// @return            whether the write succeeded.
@extern(KERNEL32, "WriteFile")
export write_file :: fn(h: Handle, buf: u8[], count: u32,
                        @c_out written: u32[], overlapped: CPointer | null) -> bool


// ---- UTF-8 <-> UTF-16 -----------------------------------------------------
// UTF-16 buffers cross as `u16[]`, which is what they hold.
//
// Every LENGTH below is in UTF-16 UNITS, which for a `u16[]` is also the
// buffer's length -- not its size in bytes.

/// `CP_UTF8`: the code page identifier for UTF-8.
export CP_UTF8: u32 : 65001

/// `MultiByteToWideChar`. With `src_len` of `-1` the input is read up to its NUL
/// and the terminator is written too, so the result is usable as `LPCWSTR`.
///
/// @param dst      receives the UTF-16 units; may be empty when `dst_len` is 0.
/// @param dst_len  `dst`'s capacity in UTF-16 units, or 0 to measure.
/// @return         units written (or required, when measuring); 0 on failure.
@extern(KERNEL32, "MultiByteToWideChar")
export multi_byte_to_wide_char :: fn(code_page: u32, flags: u32, src: string, src_len: i32,
                                     @c_out dst: u16[], dst_len: i32) -> i32

/// `WideCharToMultiByte`. The two trailing `lpDefaultChar` / `lpUsedDefaultChar`
/// arguments must be null for `CP_UTF8`; Windows fails the call otherwise.
///
/// @param src_len  units to read, or `-1` for a NUL-terminated input.
/// @param dst_len  `dst`'s capacity in bytes, or 0 to measure.
/// @return         bytes written (or required, when measuring); 0 on failure.
@extern(KERNEL32, "WideCharToMultiByte")
export wide_char_to_multi_byte :: fn(code_page: u32, flags: u32, src: u16[], src_len: i32,
                                     @c_out dst: u8[], dst_len: i32,
                                     default_char: CPointer | null,
                                     used_default: CPointer | null) -> i32

/// `s` as a NUL-terminated UTF-16 buffer; empty on failure.
///
/// The `W` entry points are the exact ones: the `A` ones speak the system ANSI
/// code page, which cannot represent a path like `C:\Users\Zoé`. Vader strings
/// are UTF-8, so every path crosses through this and `from_wide`.
///
/// @param s  the text to convert.
export to_wide :: fn(s: string) -> u16[] {
    empty: u16[]: []
    // `-1` measures the NUL-terminated input AND counts the terminator, so the
    // result is directly usable as an `LPCWSTR`. The count is in UNITS; the
    // buffer that holds them is twice that in bytes.
    units :: multi_byte_to_wide_char(CP_UTF8, 0, s, -1, empty, 0)
    if units <= 0 {
        return []
    }
    out: u16[]: [0] * i64(units)
    if multi_byte_to_wide_char(CP_UTF8, 0, s, -1, out, units) <= 0 {
        return []
    }
    return out
}

/// `units` UTF-16 units back to UTF-8; empty when the conversion fails.
///
/// @param w      the UTF-16 buffer a Win32 call filled.
/// @param units  how many units to read, EXCLUDING any NUL, which is what
///               every Win32 length already reports.
export from_wide :: fn(w: u16[], units: i32) -> string = wide_to_utf8(w, units).bytes_to_string()

// `units` UTF-16 units as UTF-8 bytes; empty when the conversion fails, and for
// no units at all.
wide_to_utf8 :: fn(w: u16[], units: i32) -> u8[] {
    empty: u8[]: []
    n :: wide_char_to_multi_byte(CP_UTF8, 0, w, units, empty, 0, null, null)
    if n <= 0 {
        return []
    }
    out: u8[]: [0] * i64(n)
    if wide_char_to_multi_byte(CP_UTF8, 0, w, units, out, n, null, null) <= 0 {
        return []
    }
    return out
}

// ---- files ----------------------------------------------------------------

/// `INVALID_HANDLE_VALUE`, as the integer `i64(handle)` yields. Win32 reports a
/// failed `CreateFileW` with this and NOT with NULL, which is why the handle is
/// tested through `i64` rather than a `CPointer | null`.
export INVALID_HANDLE: i64 : -1

/// `dwDesiredAccess` bits.
export GENERIC_READ: u32 : 0x8000_0000

/// See `GENERIC_READ`.
export GENERIC_WRITE: u32 : 0x4000_0000

/// See `GENERIC_READ`: every right a write takes, `FILE_WRITE_DATA` included.
export FILE_GENERIC_WRITE: u32 : 0x0012_0116

/// See `GENERIC_READ`: the right to write anywhere in the file. A handle that
/// holds `FILE_GENERIC_WRITE` without it can only append.
export FILE_WRITE_DATA: u32 : 0x2

/// `dwShareMode`: let other readers in while we hold the file.
export FILE_SHARE_READ: u32 : 0x1

/// See `FILE_SHARE_READ`.
export FILE_SHARE_WRITE: u32 : 0x2

/// See `FILE_SHARE_READ`: let a rename or a delete in too.
export FILE_SHARE_DELETE: u32 : 0x4

/// `dwCreationDisposition`: truncate an existing file, create it otherwise.
export CREATE_ALWAYS: u32 : 2

/// See `CREATE_ALWAYS`: create a file, and fail when one exists.
export CREATE_NEW: u32 : 1

/// See `CREATE_ALWAYS`: open only what already exists.
export OPEN_EXISTING: u32 : 3

/// See `CREATE_ALWAYS`: open a file, created when missing.
export OPEN_ALWAYS: u32 : 4

/// See `CREATE_ALWAYS`: truncate an existing file, fail when it is missing.
export TRUNCATE_EXISTING: u32 : 5

/// `dwFlagsAndAttributes`: no special semantics.
export FILE_ATTRIBUTE_NORMAL: u32 : 0x80

/// `dwFlagsAndAttributes`: open a directory as well as a file.
export FILE_FLAG_BACKUP_SEMANTICS: u32 : 0x0200_0000

/// `dwFlagsAndAttributes`: open a link itself rather than what it points to.
export FILE_FLAG_OPEN_REPARSE_POINT: u32 : 0x0020_0000

/// `CreateFileW`. Returns `INVALID_HANDLE_VALUE` on failure: test it with
/// `i64(h) == INVALID_HANDLE`, never against null.
///
/// Unlike `fopen` there is no text mode, so nothing ever rewrites a `\n`.
///
/// @param path         UTF-16, NUL-terminated. Prefix `\\?\\` to pass MAX_PATH.
/// @param security     `lpSecurityAttributes`; null for the default descriptor.
/// @param template     `hTemplateFile`; always null here.
@extern(KERNEL32, "CreateFileW")
export create_file_w :: fn(path: u16[], access: u32, share: u32,
                           security: CPointer | null, disposition: u32,
                           flags: u32, template: CPointer | null) -> Handle

/// `SetFilePointer` origins: the start, the current position, the end.
export FILE_BEGIN: u32 : 0

/// See `FILE_BEGIN`.
export FILE_CURRENT: u32 : 1

/// See `FILE_BEGIN`.
export FILE_END: u32 : 2

/// What `set_file_pointer` answers on failure, and for a position whose low
/// half has every bit set: `get_last_error` is then 0 on success.
export INVALID_SET_FILE_POINTER: u32 : 0xFFFF_FFFF

/// `SetFilePointer`. Moves the position of `h` by a 64-bit distance given as
/// two halves, and gives the new position back the same way.
///
/// Not `SetFilePointerEx`, whose distance is a `LARGE_INTEGER` passed by
/// value: a union, which no `@extern` parameter can spell.
///
/// @param low     the low half of the distance.
/// @param high    the high half of the distance, in a one-element array the
///                call overwrites with the high half of the new position.
/// @param method  `FILE_BEGIN`, `FILE_CURRENT` or `FILE_END`.
/// @return        the low half of the new position.
@extern(KERNEL32, "SetFilePointer")
export set_file_pointer :: fn(h: Handle, low: i32, @c_out high: i32[], method: u32) -> u32

/// Bytes to reserve for a `WIN32_FIND_DATAW`.
///
/// An OPAQUE buffer: Vader never looks inside it, `FindFirstFileW` fills it and
/// `find_data_name` reads the one member a listing needs. Nothing checks this
/// number (the callee writes `sizeof(WIN32_FIND_DATAW)` bytes whatever it says)
/// so it is taken HIGH on purpose. The real size is 592 on x86_64 (measured
/// against the mingw headers, and it is 320 for the ANSI twin); over-reserving
/// wastes a few hundred bytes on the stack, under-reserving corrupts.
///
/// Do NOT narrow this to what one toolchain reports.
export FIND_DATA_BYTES: i64: 1024

/// `FindFirstFileW`. The pattern is a directory path with `\*` appended.
///
/// Returns `INVALID_HANDLE_VALUE` on failure: test it with
/// `i64(h) == INVALID_HANDLE`, never against null.
///
/// @param pattern  a NUL-terminated UTF-16 glob, from `to_wide`.
/// @param data     `FIND_DATA_BYTES` of scratch the callee fills.
/// @return         a search handle.
@extern(KERNEL32, "FindFirstFileW")
export find_first_file :: fn(pattern: u16[], @c_out data: u8[]) -> Handle

/// `FindNextFileW`. False once the search is exhausted.
///
/// @param handle  the search handle `find_first_file` returned.
/// @param data    the same buffer, refilled.
@extern(KERNEL32, "FindNextFileW")
export find_next_file :: fn(handle: Handle, @c_out data: u8[]) -> bool

/// `FindClose`. Pairs with `find_first_file`.
///
/// @param handle  the search handle.
@extern(KERNEL32, "FindClose")
export find_close :: fn(handle: Handle) -> bool

/// The `cFileName` of a filled `WIN32_FIND_DATAW`, as a Vader string.
///
/// The Windows twin of `system/posix::dirent_name`, and it exists for the same
/// reason: reading a NAMED member of a C struct is the one step a Vader FFI call
/// cannot take for itself. It has to be a CALL, not a read of the struct: the
/// interpreter has no C layout but resolves an `@extern` by name out of the
/// running process. It carries the UTF-16 to UTF-8 conversion with it.
///
/// The bytes are valid until the next call, which is also `cFileName`'s own
/// contract: `find_next_file` overwrites it. The shim interns before either.
///
/// @param data  the buffer `find_first_file` filled.
/// @return      the entry name.
@extern(VADER_RUNTIME, "vader_find_data_name")
export find_data_name :: fn(data: u8[]) -> string

/// The attributes of a filled `WIN32_FIND_DATAW` into `out[0]`, and its reparse
/// tag into `out[1]`, 0 when it is no reparse point.
///
/// @param data  the buffer `find_first_file` filled.
/// @param out   two cells.
@extern(VADER_RUNTIME, "vader_find_data_attributes")
export find_data_attributes :: fn(data: u8[], @c_out out: u32[]) -> void

/// The `index`-th `NAME=value` of the system's environment block, null past
/// the last. The `=C:` entries naming each drive's directory come back too.
///
/// @param index  from 0, the caller stopping at the first null.
@extern(VADER_RUNTIME, "vader_environ_entry")
export environment_entry :: fn(index: i64) -> string | null

/// `GetEnvironmentVariableW`: the value of `name` into `buf`, and its length
/// in UTF-16 units. When `buf` is too small, the size it needs, its NUL
/// included; 0 when `name` is unset.
///
/// @param size  the size of `buf` in UTF-16 units.
@extern(KERNEL32, "GetEnvironmentVariableW")
export get_environment_variable_w :: fn(name: u16[], @c_out buf: u16[], size: u32) -> u32

/// `SetEnvironmentVariableW`: `name` takes `value`. False on failure.
@extern(KERNEL32, "SetEnvironmentVariableW")
export set_environment_variable_w :: fn(name: u16[], value: u16[]) -> bool

/// `SetEnvironmentVariableW` with a null value, which unsets `name`. False on
/// failure.
@extern(KERNEL32, "SetEnvironmentVariableW")
export unset_environment_variable_w :: fn(name: u16[], value: CPointer | null) -> bool

/// Up to `max` bytes of what was typed at the console, as UTF-8. The runtime
/// reads the console, ahead of time while a task waits on it, and keeps what a
/// read has not taken.
///
/// @param buf  receives the bytes.
/// @param max  how many `buf` takes at most.
/// @return     how many bytes `buf` received: 0 at the end of the input, -1 on
///             a failure, whose error `get_last_error` then gives.
@extern(VADER_RUNTIME, "vader_console_read")
export console_read :: fn(@c_out buf: u8[], max: i64) -> i64

/// Wait for the read the runtime keeps under way on a stdin pipe once a wait
/// for stdin is given up: every peek of the pipe would wait behind it. That read
/// ends once the pipe holds data or has lost its writer; on a console, or with
/// no read under way, this returns at once.
///
/// @param timeout_ms  how long to wait at most; a negative one waits with no
///                    deadline.
/// @return            `false` at the deadline, the read still under way.
@extern(VADER_RUNTIME, "vader_stdin_await_reader")
export await_stdin_reader :: fn(timeout_ms: i32) -> bool

/// A pipe a child writes into, which `watch_readable` can follow: its read end
/// takes overlapped reads. The read end stays with this process, the write end
/// is inheritable.
///
/// @param read_end   a one-word buffer receiving the read end.
/// @param write_end  a one-word buffer receiving the write end.
@extern(VADER_RUNTIME, "vader_overlapped_pipe")
export create_watched_pipe :: fn(@c_out read_end: u64[], @c_out write_end: u64[]) -> bool

/// A pipe a child reads from: its read end is inheritable, its write end stays
/// with this process and reaches no child.
///
/// @param read_end   a one-word buffer receiving the read end.
/// @param write_end  a one-word buffer receiving the write end.
@extern(VADER_RUNTIME, "vader_input_pipe")
export create_input_pipe :: fn(@c_out read_end: u64[], @c_out write_end: u64[]) -> bool

/// `COORD`: a console cell position or size.
///
/// Field names are the C ones because a mirror copies BY NAME; the snake_case
/// rule does not reach across the boundary.
@c_struct("COORD")
export Coord :: struct { X: i16, Y: i16 }

/// `SMALL_RECT`: an inclusive rectangle of console cells.
@c_struct("SMALL_RECT")
export SmallRect :: struct { Left: i16, Top: i16, Right: i16, Bottom: i16 }

/// `CONSOLE_SCREEN_BUFFER_INFO`. Mirrored WHOLE rather than as a prefix: every
/// member but `wAttributes` is itself a struct, so a prefix would have to stop
/// before the one that matters.
@c_struct("CONSOLE_SCREEN_BUFFER_INFO")
export ScreenBufferInfo :: struct {
    dwSize:              Coord
    dwCursorPosition:    Coord
    wAttributes:         u16
    srWindow:            SmallRect
    dwMaximumWindowSize: Coord
}

/// `GetConsoleScreenBufferInfo`. False when the handle is not a console.
///
/// `srWindow` is the VISIBLE window, which is what a width should be measured
/// from: the buffer (`dwSize`) is often far wider, and wrapping follows what is
/// on screen.
@extern(KERNEL32, "GetConsoleScreenBufferInfo")
export get_console_screen_buffer_info :: fn(
    h: Handle,
    @c_out info: ScreenBufferInfo,
) -> bool

/// `PeekNamedPipe`. Reports how many bytes are readable WITHOUT consuming them.
///
/// It works on an anonymous pipe too, despite the name, which is what makes it
/// the console-less way to ask "is there input". False when the handle is not a
/// pipe (a console, a redirected file) or the peer closed it; a caller reads that
/// as "go ahead and read", never as "idle".
///
/// @param buf        always null here: we ask for the COUNT, not the bytes.
/// @param read       always null, for the same reason.
/// @param available  receives the byte count; a one-element array so it reads back.
/// @param message    always null: only a message-mode pipe uses it.
@extern(KERNEL32, "PeekNamedPipe")
export peek_named_pipe :: fn(h: Handle, buf: CPointer | null, size: u32,
                             read: CPointer | null, @c_out available: u32[],
                             message: CPointer | null) -> bool

/// `Sleep`. Milliseconds, and it is the only wait Win32 offers without a handle.
@extern(KERNEL32, "Sleep")
export sleep_ms :: fn(ms: u32) -> void

// ---- subprocess ------------------------------------------------------------

/// `STARTF_USESTDHANDLES`: `hStdInput` / `hStdOutput` / `hStdError` are used.
export STARTF_USESTDHANDLES: u32 : 0x0100

/// `WAIT_OBJECT_0`: the object is signalled, i.e. the process has exited.
export WAIT_OBJECT_0: u32 : 0

/// `INFINITE`: a wait with no timeout.
export INFINITE: u32 : 0xFFFF_FFFF

/// `CREATE_UNICODE_ENVIRONMENT`: the environment block `CreateProcessW` takes is
/// UTF-16.
export CREATE_UNICODE_ENVIRONMENT: u32 : 0x0400

/// `STARTUPINFOW`, mirrored for the members a redirected child needs.
///
/// EVERY member up to `hStdError`, in order, not a prefix of the useful ones:
/// the interpreter lays a mirror out from its declared fields alone, at natural
/// alignment from zero, so a member left out moves every later one off its C
/// offset in the interpreter's block, while native, which copies by name, works.
///
/// The reserved ones are machine words that stay zero, which is what
/// `CreateProcess` expects of a plain console child. `cb` must be
/// `sizeof(STARTUPINFOW)` (104 on x86_64) and is the one member the callee
/// validates.
@c_struct("STARTUPINFOW")
export StartupInfo :: struct {
    cb:              u32
    lpReserved:      u64
    lpDesktop:       u64
    lpTitle:         u64
    dwX:             u32
    dwY:             u32
    dwXSize:         u32
    dwYSize:         u32
    dwXCountChars:   u32
    dwYCountChars:   u32
    dwFillAttribute: u32
    dwFlags:         u32
    wShowWindow:     u16
    cbReserved2:     u16
    lpReserved2:     u64
    hStdInput:       Handle
    hStdOutput:      Handle
    hStdError:       Handle
}

/// `PROCESS_INFORMATION`: what `CreateProcess` hands back.
@c_struct("PROCESS_INFORMATION")
export ProcessInformation :: struct {
    hProcess:    Handle
    hThread:     Handle
    dwProcessId: u32
    dwThreadId:  u32
}

/// The `i`-th pointer-sized word of a lent buffer, as a handle.
///
/// `CPointer` cannot be built from an integer (T3010) and a lent array yields
/// integers, so a HANDLE an out-parameter wrote is otherwise unreachable.
///
/// @param base  the buffer the callee filled.
/// @param i     the word index.
@extern(VADER_RUNTIME, "vader_ptr_at")
export ptr_at :: fn(base: u64[], i: i64) -> Handle

/// `CreateProcessW`. Launches `command_line` in `directory`, with `environment`,
/// inheriting the handles named in `startup`.
///
/// The wide form, so that an argument, a variable or a folder outside the ANSI
/// code page reaches the child as it is.
///
/// @param application   null: the program is the first word of the line.
/// @param command_line  the whole command line, NUL-terminated UTF-16, which the
///                      callee MODIFIES.
/// @param proc_attrs    null.
/// @param thread_attrs  null.
/// @param inherit       true, so the child receives the pipe ends.
/// @param flags         `CREATE_UNICODE_ENVIRONMENT`.
/// @param environment   the whole environment: each `NAME=value` NUL-terminated
///                      UTF-16, then one more NUL. Lent as `@c_out` for the
///                      `LPVOID` of the prototype, which is not `const`; the
///                      callee only reads it.
/// @param directory     the working directory of the child, NUL-terminated
///                      UTF-16.
/// @param startup       the redirected handles.
/// @param info          filled with the child's handles and ids.
@extern(KERNEL32, "CreateProcessW")
export create_process :: fn(application: CPointer | null, @c_out command_line: u16[],
                            proc_attrs: CPointer | null, thread_attrs: CPointer | null,
                            inherit: bool, flags: u32,
                            @c_out environment: u16[], directory: u16[],
                            @c_out startup: StartupInfo,
                            @c_out info: ProcessInformation) -> bool

/// `WaitForSingleObject`. `WAIT_OBJECT_0` once the process has exited.
///
/// @param h           the process handle.
/// @param timeout_ms  0 to poll without waiting, `INFINITE` to wait for the exit.
@extern(KERNEL32, "WaitForSingleObject")
export wait_for_single_object :: fn(h: Handle, timeout_ms: u32) -> u32

/// `GetExitCodeProcess`.
///
/// @param h     the process handle.
/// @param code  a one-element array receiving the status.
@extern(KERNEL32, "GetExitCodeProcess")
export get_exit_code_process :: fn(h: Handle, @c_out code: u32[]) -> bool

/// `TerminateProcess`.
///
/// @param h     the process handle.
/// @param code  the exit status to report for the killed child.
@extern(KERNEL32, "TerminateProcess")
export terminate_process :: fn(h: Handle, code: u32) -> bool

/// Console INPUT mode bits raw mode turns off (line buffering, echo, and the
/// translation of Ctrl-C into a signal) plus the one it turns on, so escape
/// sequences arrive as bytes.
export ENABLE_PROCESSED_INPUT: u32 : 0x0001
export ENABLE_LINE_INPUT: u32 : 0x0002
export ENABLE_ECHO_INPUT: u32 : 0x0004
export ENABLE_VIRTUAL_TERMINAL_INPUT: u32 : 0x0200

/// Bit enabling ANSI escape interpretation on a console output handle. Only with
/// it set do escapes render rather than print literally.
export ENABLE_VIRTUAL_TERMINAL_PROCESSING: u32 : 0x0004

/// `GetConsoleMode`. False when the handle is not a console, which is also how
/// a caller tests for one, a redirected stream having no mode to read.
///
/// @param mode  receives the current mode; a one-element array so it reads back.
@extern(KERNEL32, "GetConsoleMode")
export get_console_mode :: fn(h: Handle, @c_out mode: u32[]) -> bool

/// `SetConsoleMode`. False on failure: an old console refusing a mode bit it
/// does not know, which is what tells a caller ANSI is unavailable.
@extern(KERNEL32, "SetConsoleMode")
export set_console_mode :: fn(h: Handle, mode: u32) -> bool

/// `WriteConsoleW`: UTF-16 text to a console, which renders it whatever its code
/// page. False on failure, and on a handle that is not a console.
///
/// @param h         a console output handle.
/// @param text      the UTF-16 units to write.
/// @param count     how many of them.
/// @param written   scratch the callee fills with the units written; unread.
/// @param reserved  always null.
/// @return          whether the write succeeded.
@extern(KERNEL32, "WriteConsoleW")
export write_console_w :: fn(h: Handle, text: u16[], count: u32,
                             @c_out written: u32[], reserved: CPointer | null) -> bool

/// `FlushConsoleInputBuffer`: drop what was typed at the console `h` and not
/// read yet. False on failure.
@extern(KERNEL32, "FlushConsoleInputBuffer")
export flush_console_input_buffer :: fn(h: Handle) -> bool

/// `ReadFile`. False on failure; a synchronous read returning true with `read`
/// short of `count` has reached end of file.
///
/// @param read        receives the byte count; a one-element array so it reads
///                    back: Win32 forbids null here on a synchronous call.
/// @param overlapped  always null: this is the synchronous form.
@extern(KERNEL32, "ReadFile")
export read_file :: fn(h: Handle, @c_out buf: u8[], count: u32, @c_out read: u32[],
                       overlapped: CPointer | null) -> bool

/// `GetFileType`. `FILE_TYPE_DISK` for a file on disk, whose size says how much
/// a read will find; another value for a pipe, a console or a device.
@extern(KERNEL32, "GetFileType")
export get_file_type :: fn(h: Handle) -> u32

/// What `get_file_type` answers for a file on disk.
export FILE_TYPE_DISK: u32 : 0x0001

/// `GetFileSizeEx`. False on failure.
///
/// @param size  receives the size in bytes; a one-element array so it reads back.
@extern(KERNEL32, "GetFileSizeEx")
export get_file_size_ex :: fn(h: Handle, @c_out size: i64[]) -> bool

/// `GetFinalPathNameByHandleW`. Writes the path of the file `h` names, links
/// followed and NUL-terminated, into `buf`.
///
/// @param size   `buf`'s capacity in UTF-16 UNITS, not bytes.
/// @param flags  `VOLUME_NAME_DOS` for a path that starts with a drive letter,
///               behind the `\\?\` prefix.
/// @return       UTF-16 units written, excluding the NUL; 0 on failure, more
///               than `size` (the capacity needed) when `buf` is too small.
@extern(KERNEL32, "GetFinalPathNameByHandleW")
export get_final_path_name_by_handle_w :: fn(h: Handle, @c_out buf: u16[], size: u32,
                                             flags: u32) -> u32

/// See `get_final_path_name_by_handle_w`: a volume named by its drive letter.
export VOLUME_NAME_DOS: u32 : 0x0

/// `CloseHandle`. False on failure, which a caller that is done with the file
/// has nothing to do about.
@extern(KERNEL32, "CloseHandle")
export close_handle :: fn(h: Handle) -> bool

// ---- clocks ---------------------------------------------------------------
//
// Both cells cross as a one-element `i64[]`: a `FILETIME` is two contiguous
// `DWORD`s, low half first, and a `LARGE_INTEGER`'s `QuadPart` is one i64.

/// `GetSystemTimePreciseAsFileTime`. Fills `ft` with 100-ns ticks since 1601.
@extern(KERNEL32, "GetSystemTimePreciseAsFileTime")
export get_system_time_precise_as_file_time :: fn(@c_out ft: i64[]) -> void

/// `QueryPerformanceCounter`. Fills `counter`; false on failure.
@extern(KERNEL32, "QueryPerformanceCounter")
export query_performance_counter :: fn(@c_out counter: i64[]) -> bool

/// `QueryPerformanceFrequency`. Fills `freq` with counts per second; false on failure.
@extern(KERNEL32, "QueryPerformanceFrequency")
export query_performance_frequency :: fn(@c_out freq: i64[]) -> bool
