// Numeric primitives implement Add/Sub/Mul/Div in std/core, each member
// the native operator on its parameters, so a call lowers as that operator
// (`i32.add`, `f64.mul`, ...): `where T: Add` works on every numeric
// primitive, and `(5).add(7)` shares the same path as `5 + 7`.

module "snippet"

double :: fn<T: Add>(x: T) -> T = x.add(x)

triple :: fn<T: Add>(x: T) -> T = x.add(x).add(x)

main :: fn() -> i32 {
    a :: double(7)              // 14
    b :: triple(8)              // 24
    c :: double(2)              // 4
    return a + b + c            // 42
}
