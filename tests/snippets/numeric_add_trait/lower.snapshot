# Lower

## snippet
  snippet.main :: fn() -> i32 {  // snippet$main
      a: i32 = snippet.double<i32>(7)
      b: i32 = snippet.triple<i32>(8)
      c: i32 = snippet.double<i32>(2)
      return (a + b) + c
  }
  snippet.double<i32> :: fn(x: i32) -> i32 {  // snippet$double__i32
      x + x
  }
  snippet.triple<i32> :: fn(x: i32) -> i32 {  // snippet$triple__i32
      (x + x) + x
  }
