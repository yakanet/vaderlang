  snippet.name: string: "world"  // snippet$name
  snippet.x: i32: 41  // snippet$x
  snippet.y: string: "deep"  // snippet$y
  snippet.simple: string: "hello world"  // snippet$simple
  snippet.expr: string: "result: 42"  // snippet$expr
  snippet.nested: string: "outer inner deep"  // snippet$nested
  snippet.main :: fn() -> i32 {  // snippet$main
      std.io.println<string>("hello world")
      std.io.println<string>("result: 42")
      std.io.println<string>("outer inner deep")
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

