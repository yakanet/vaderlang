module "snippet"

import "std/io"

// `struct timeval` is flat and its second member changes width: `suseconds_t` is
// 4 bytes on Darwin against 8 on Linux, mirrored here by the wider `i64`.
//
// That difference is the subject. `gettimeofday` WRITES through the pointer, so
// the emitted assert is `sizeof(C field) <= sizeof(Vader field)` — a C field
// narrower than the Vader one extends into it and cannot lose anything, which is
// what makes one mirror correct on both systems without stating either width.
//
// The mirror is EXHAUSTIVE, which is what lets the interpreter lay the block out
// itself from the Vader field types, pinned to `cc`'s own layout by those asserts.
@c_struct("struct timeval")
TimeVal :: struct {
    tv_sec:  i64,
    tv_usec: i64,
}

@c_header("<sys/time.h>")
@extern("gettimeofday")
sys_gettimeofday :: fn(@c_pointer tv: TimeVal!, tz: CPointer | null) -> i32

main :: fn() -> i32 {
    tv :: TimeVal { .tv_sec = 0, .tv_usec = 0 }
    rc :: sys_gettimeofday(tv, null)
    println("rc=${rc}")
    println("epoch=${tv.tv_sec > 1_600_000_000}")
    println("usec_in_range=${tv.tv_usec >= 0 && tv.tv_usec < 1_000_000}")
    return 0
}
