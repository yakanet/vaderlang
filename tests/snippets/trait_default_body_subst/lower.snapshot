  snippet.main :: fn() -> i32 {  // snippet$main
      a: A = A { .a = 1 }
      b: B = B { .b = 2 }
      ok: bool = true
      if snippet.A.boxed(a).v != 101 {
          ok = false
      }
      if snippet.B.boxed(b).v != 102 {
          ok = false
      }
      if snippet.A.wide(a) != i64(2) {
          ok = false
      }
      if snippet.B.wide(b) != i64(4) {
          ok = false
      }
      if snippet.A.label(a) != "w:1" {
          ok = false
      }
      if snippet.B.label(b) != "w:2" {
          ok = false
      }
      pa: i32[] = snippet.A.pair(a)
      if pa[0] != 1 {
          ok = false
      }
      if pa[1] != 2 {
          ok = false
      }
      pb: i32[] = snippet.B.pair(b)
      if pb[0] != 2 {
          ok = false
      }
      if pb[1] != 3 {
          ok = false
      }
      low: A = A { .a = 0 }
      high: B = B { .b = 5 }
      if !snippet.A.above(a, low) {
          ok = false
      }
      if snippet.B.above(b, high) {
          ok = false
      }
      if ok {
          std.io.println<string>("all ok")
          return 0
      }
      std.io.println<string>("FAIL")
      return 1
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
