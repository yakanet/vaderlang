// Three virtual threads take turns under the runtime's scheduler: each prints a
// step and yields, the ready threads run in the order they became ready, and a
// thread whose function returns ends. Main waits for the last one to wake it.
module "snippet"

import "std/console"
import "std/runtime/scheduler"

Joiner :: struct {
    running: i64 = 0
    main_thread: i64 = 0
}

@singleton
joiner :: fn() -> Joiner = Joiner {}

spawn :: fn(entry: fn() -> void) -> void {
    j :: joiner()
    j.running += 1
    spawn_thread(fn() {
        entry()
        j.running -= 1
        if j.running == 0 {
            wake(j.main_thread)
        }
    })
}

yield_now :: fn() -> void {
    wake(current_thread())
    park()
}

worker :: fn(name: string, steps: i64) -> void {
    for step in 0..<steps {
        println("${name} step ${step}")
        yield_now()
    }
    println("${name} done")
}

main :: fn() -> i32 {
    main_thread :: current_thread()
    joiner().main_thread = main_thread
    spawn(() -> worker("a", 2))
    spawn(() -> worker("b", 1))
    spawn(() -> println("c runs on a thread of its own: ${current_thread() != main_thread}"))
    for joiner().running > 0 {
        park()
    }
    println("main is back: ${current_thread() == main_thread}")
    return 0
}
