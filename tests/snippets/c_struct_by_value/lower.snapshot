          __off_7 = std.core.write_int(__buf_6, __off_7, snippet.texture_checksum(texture))
          std.core.finish_buffer(__buf_6, __off_7)
      } :string)
      box: Box2 = Box2 { .origin = Vec2 { .x = f32(0.0), .y = f32(0.0) }, .extent = Vec2 { .x = f32(2.0), .y = f32(3.0) } }
      grown: Box2 = snippet.box2_grow(box, f32(1.0))
      std.io.println<string>(concat_8("box2: origin ", std.core.f32.to_string(grown.origin.x), " ", std.core.f32.to_string(grown.origin.y), ", extent ", std.core.f32.to_string(grown.extent.x), " ", std.core.f32.to_string(grown.extent.y)))
      kept: Box2[] = [] :Box2[]
      {
          i: i32 = 0
          for i < 200000 {
              b: Box2 = snippet.box2_grow(box, f32((i / 1000) % 4))
              if (i % 1000) == 0 {
                  @array.push(kept, b)
              }
          } @step {
              i = i +% 1
          }
      }
      total: f64 = 0.0
      {
          __for_arr_8: Box2[] = kept
          __for_len_9: i64 = @array.len(__for_arr_8)
          __for_i_10: i64 = 0
          for __for_i_10 < __for_len_9 {
              b: Box2 = __for_arr_8[__for_i_10]
              total = total + f64(snippet.box2_area(b))
