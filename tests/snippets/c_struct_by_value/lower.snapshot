  snippet.texture_checksum :: fn(t: Texture) -> i32  // snippet$texture_checksum
  snippet.main :: fn() -> i32 {  // snippet$main
      d: Div = snippet.c_div(-7, 2)
      std.io.println<string>({
          __buf_0: Buffer = std.core.new_byte_buffer(i64(55))
          __off_1: i64 = 0
          __off_1 = std.core.write_string_at(__buf_0, __off_1, "div: quot=")
          __off_1 = std.core.write_int(__buf_0, __off_1, d.quot)
          __off_1 = std.core.write_string_at(__buf_0, __off_1, " rem=")
          __off_1 = std.core.write_int(__buf_0, __off_1, d.rem)
          std.core.finish_buffer(__buf_0, __off_1)
      } :string)
      color: Rgba = Rgba {
          .r = u8(10),
          .g = u8(20),
          .b = u8(30),
          .a = u8(255),
      }
      inverted: Rgba = snippet.rgba_invert(color)
      std.io.println<string>({
          __buf_2: Buffer = std.core.new_byte_buffer(i64(115))
          __off_3: i64 = 0
          __off_3 = std.core.write_string_at(__buf_2, __off_3, "rgba: ")
          __off_3 = std.core.write_unsigned(__buf_2, __off_3, inverted.r)
          __off_3 = std.core.write_string_at(__buf_2, __off_3, " ")
          __off_3 = std.core.write_unsigned(__buf_2, __off_3, inverted.g)
          __off_3 = std.core.write_string_at(__buf_2, __off_3, " ")
          __off_3 = std.core.write_unsigned(__buf_2, __off_3, inverted.b)
          __off_3 = std.core.write_string_at(__buf_2, __off_3, " ")
          __off_3 = std.core.write_unsigned(__buf_2, __off_3, inverted.a)
          __off_3 = std.core.write_string_at(__buf_2, __off_3, ", sum ")
          __off_3 = std.core.write_int(__buf_2, __off_3, snippet.rgba_sum(inverted))
          std.core.finish_buffer(__buf_2, __off_3)
      } :string)
      v: Vec2 = snippet.vec2_scale(Vec2 { .x = f32(1.5), .y = f32(-2.0) }, f32(2.0))
      std.io.println<string>(concat_4("vec2: ", std.core.f32.to_string(v.x), " ", std.core.f32.to_string(v.y)))
      texture: Texture = snippet.texture_load(u32(7))
      std.io.println<string>({
          __buf_4: Buffer = std.core.new_byte_buffer(i64(131))
          __off_5: i64 = 0
          __off_5 = std.core.write_string_at(__buf_4, __off_5, "texture: id=")
          __off_5 = std.core.write_unsigned(__buf_4, __off_5, texture.id)
          __off_5 = std.core.write_string_at(__buf_4, __off_5, " ")
          __off_5 = std.core.write_int(__buf_4, __off_5, texture.width)
          __off_5 = std.core.write_string_at(__buf_4, __off_5, "x")
          __off_5 = std.core.write_int(__buf_4, __off_5, texture.height)
          __off_5 = std.core.write_string_at(__buf_4, __off_5, " mipmaps=")
          __off_5 = std.core.write_int(__buf_4, __off_5, texture.mipmaps)
          __off_5 = std.core.write_string_at(__buf_4, __off_5, " format=")
          __off_5 = std.core.write_int(__buf_4, __off_5, texture.format)
          std.core.finish_buffer(__buf_4, __off_5)
      } :string)
      std.io.println<string>({
          __buf_6: Buffer = std.core.new_byte_buffer(i64(38))
          __off_7: i64 = 0
