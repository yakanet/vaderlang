// tests/snippets/string_ops: string `+`, interpolation and `==`.
//
// Strings are interned atoms (`vader_string_t`), so `==` is atom identity
// (`string.eq`). `"hello, " + name` and the interpolation `"${greeting}!"`
// both lower to a call to the same synthesised `concat_2`. Observed through
// stdout.

module "snippet"

import "std/io"

main :: fn() -> i32 {
    name :: "world"
    greeting :: "hello, " + name
    full :: "${greeting}!"
    if full == "hello, world!" {
        println(full)
        return 0
    }
    return 1
}
