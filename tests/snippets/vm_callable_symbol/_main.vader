module "snippet"

import "std/io"

// `@vm_callable` bakes the symbol's address into the binary. `hypot` is picked
// over a symbol the program would reach anyway: nothing else in the tree calls
// it, so the table is the only reason it is here.
@vm_callable
@c_header("<math.h>")
@extern("hypot")
hypot :: fn(x: f64, y: f64) -> f64

main :: fn() -> i32 {
    println("${hypot(3.0, 4.0)}")
    return 0
}
