// `defer` runs on panic unwind. Each `defer X` pushes a closure on the frame's
// defer stack (`defer.push`), and every normal exit drains them in LIFO order
// (`defer.pop_exec`). When a panic trips (here an integer division by zero),
// the runtime runs the defers still pending on the frame before propagating.
//
// The panic shows in the snapshot's `# stderr` part; the `# stdout` part holds
// the cleanup lines the defers print on the unwind path.

module "snippet"

import "std/io"

main :: fn() -> i32 {
    defer println("outer cleanup")
    defer println("middle cleanup")
    defer println("inner cleanup")
    println("starting")
    boom := 1
    boom = boom / 0
    return boom
}
