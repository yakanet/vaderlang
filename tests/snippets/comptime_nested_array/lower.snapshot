          i: i32 = 0
          for i < 3 {
              @array.push(weights, u8(i * 100))
              @array.push(rows, [i, i * 10] :i32[])
          } @step {
              i = i +% 1
          }
      }
      return Card {
          .weights = weights,
          .rows = rows,
          .either = weights,
      }
  }
