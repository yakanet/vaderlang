  snippet.Card :: struct { weights: u8[], rows: i32[][], either: null | string | u8[] }  // snippet$Card
  snippet.build_card :: fn() -> Card {  // snippet$build_card
      weights: u8[] = @array.repeat([] :u8[], i64(3))
      rows: i32[][] = @array.repeat([] :i32[][], i64(3))
