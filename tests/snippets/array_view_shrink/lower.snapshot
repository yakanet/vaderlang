# Lower

## snippet
  snippet.Node :: struct { v: i32 }  // snippet$Node
  snippet.make_nodes :: fn(n: i32) -> Node[] {  // snippet$make_nodes
      nodes: Node[] = @array.reserve(if 0 < n { n } else { i64(0) } :i64)
      {
          i: i32 = 0
          for i < n {
              @array.push(nodes, Node { .v = i * 7 })
          } @step {
              i = i +% 1
          }
      }
      return nodes
  }
  snippet.collect_and_churn :: fn() -> void {  // snippet$collect_and_churn
      std.runtime.collect()
      junk: Node[] = @array.reserve(i64(100000))
      {
          _: i32 = 0
          for _ < 100000 {
              @array.push(junk, Node { .v = -1 })
          } @step {
              _ = _ +% 1
          }
      }
      std.runtime.collect()
  }
  snippet.print_nodes :: fn(label: string, nodes: Node[]) -> void {  // snippet$print_nodes
      std.io.print<string>(label)
      {
          __for_arr_0: Node[] = nodes
          __for_len_1: i64 = @array.len(__for_arr_0)
          __for_i_2: i64 = 0
          for __for_i_2 < __for_len_1 {
              n: Node = __for_arr_0[__for_i_2]
              std.io.print<string>({
                  __buf_3: Buffer = std.core.new_byte_buffer(i64(21))
                  __off_4: i64 = 0
                  __off_4 = std.core.write_string_at(__buf_3, __off_4, " ")
                  __off_4 = std.core.write_int(__buf_3, __off_4, n.v)
                  std.core.finish_buffer(__buf_3, __off_4)
              } :string)
          } @step {
              __for_i_2 = __for_i_2 +% i64(1)
          }
      }
      std.io.println<string>("")
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      cleared: Node[] = snippet.make_nodes(10)
      whole: Node[] = cleared[0..<10]
      @array.clear(cleared)
      snippet.collect_and_churn()
      snippet.print_nodes("after clear:", whole)
      popped: Node[] = snippet.make_nodes(4)
      tail: Node[] = popped[0..<4]
      @array.remove_last(popped)
      @array.remove_last(popped)
      snippet.collect_and_churn()
      snippet.print_nodes("after remove_last:", tail)
      @array.push(popped, Node { .v = 99 })
      snippet.print_nodes("owner after push:", popped)
      snippet.print_nodes("view after push:", tail)
      owner: i32[] = [1, 2, 3] :i32[]
      whole_view: i32[] = owner[0..<3]
      @array.clear(whole_view)
      @array.push(whole_view, 9)
      std.io.println<string>(concat_4("view clear then push: ", std.core.i32[].to_string(owner), " ", std.core.i32[].to_string(whole_view)))
      other: i32[] = [1, 2, 3] :i32[]
      other_view: i32[] = other[0..<3]
      @array.remove_last(other_view)
      @array.push(other_view, 9)
      std.io.println<string>(concat_4("view remove_last then push: ", std.core.i32[].to_string(other), " ", std.core.i32[].to_string(other_view)))
      return 0
  }
  concat_4 :: fn(p0: string, p1: string, p2: string, p3: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      c2: i64 = c1 +% std.core.byte_len(p2)
      c3: i64 = c2 +% std.core.byte_len(p3)
      buf: Buffer = std.core.new_byte_buffer(c3)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.write_string(buf, c2, p3)
      std.core.Buffer.intern_string(buf, c3)
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

