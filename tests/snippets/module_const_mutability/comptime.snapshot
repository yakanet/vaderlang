# Comptime

## tests/snippets/module_const_mutability
  @comptime  COUNTS               = [0_i32, 0_i32, 0_i32]
  @comptime  DIGITS               = ["0", "1", "2"]
  @comptime  GREETING             = "hello"
  @comptime  LIMITS               = [10_i32, 20_i32, 30_i32]
  @comptime  MAX                  = 42_i32
  @comptime  PAIR                 = [i32, string] { ._0 = 7_i32, ._1 = "seven" }
  @comptime  SLOTS                = ["", ""]

