// tests/snippets/module_const_mutability — every module-const shape and the
// storage it lands in.
//
// A module const has no storage of its own: its value is inlined at each use
// site, fn-wrapped behind a synthetic accessor, or baked into the data pool. The
// pool has two classes, and `!` is what picks between them:
//
//   - unmarked  -> a `static const` blob in `.rodata`, shared process-wide.
//   - `!`       -> a writable GLOBAL, initialised once, mutable IN PLACE.
//
// A marked const behaves like any other mutable array — `push` included: a
// permanent GC frame roots it (`emit_global_const_roots`), so a reallocated buffer
// is forwarded rather than collected. Any ELEMENT type works, flat or aggregate;
// what is rejected is a marker BELOW the array level, because an aggregate's
// elements are emitted as read-only statics — T3076
// (`t3076_mutable_module_const_element`).
//
// Two regressions this pins down, both of which lost writes SILENTLY:
//   - `fold_const_symbol` inlined a mutable array's baked value at each use site,
//     so every read and every write got its own fresh array.
//   - `[0] * n`, the idiomatic fixed-size table, lowers to an `array.repeat`
//     intrinsic rather than a literal and fell out of the pool entirely.
//
// VM/native EQUIVALENCE is the point of this snippet, and both harnesses share
// `vm.snapshot` as their oracle: `vader-vm:` feeds the committed `.virt` to the
// Vader VM (which also round-trips the `mut` tag through the text-IR reader), and
// `c-emit-run:` compiles the emitted C and runs it. The two backends implement this
// storage class in genuinely different ways — a `static` global on one side, a
// shared `ArrayVal` in `VmState.data_pool` on the other — so agreement is worth
// pinning down. On the native side alone, writing through a `static const` lands in
// `.rodata`: a segfault, not a diagnostic.
//
// The `collect()` below is CALIBRATED, not decorative. A mutable global is in no
// other root set, so its buffer and its atoms used to be swept out from under it.
// Two things make the guard actually bite:
//   - an explicit `collect()` rather than allocation churn — 20k small strings sit
//     far below the default 16 MB young arena, so no collection ran at all and the
//     regression went unguarded ;
//   - ENOUGH slots that their atom ids are no longer on the C stack, which
//     `vader_atom_mark_cstack_conservative` would otherwise retain by accident.
// Measured with `vader_atom_mark_global_arrays` disabled: 18/24 slots corrupted,
// 0/24 with it. One slot and no loop reported 0 either way — a worthless guard.

module "snippet"

import "std/io"
import "std/runtime"

Spec :: struct {
    name: string
    code: i32
}

Mode :: enum(u8) { Fast, Small }

// ---- read-only : the default, annotated or not -> `.rodata` ---------------

// Primitive — inlined at each use site, no pool entry.
MAX: i32: 42
// Inferred, no annotation at all.
GREETING :: "hello"
// Enum — a value through and through, like a primitive.
MODE: Mode: .Fast
// Annotated, frozen by the read-only default -> pooled.
DIGITS: string[]: ["0", "1", "2"]
// Unannotated, frozen by the auto-pin -> same storage.
LIMITS :: [10, 20, 30]
// Struct elements pool as an aggregate.
SPECS: Spec[]: [
    Spec { .name = "alpha", .code = 1 },
    Spec { .name = "beta",  .code = 2 },
]
// A lone struct is not a pool candidate — it inlines.
ORIGIN: Spec: Spec { .name = "origin", .code = 0 }
// A tuple carries the bit per level like an array does.
PAIR: [i32, string]: [7, "seven"]

// ---- marked : a writable global, mutable in place ------------------------

COUNTS: i32[]!:    [0, 0, 0]
// The repeat form is the idiomatic fixed-size table, and it pools like a literal.
SLOTS:  string[]!: [""] * 24
FLAGS:  bool[]!:   [false] * 4
// An AGGREGATE entry is writable at the array level too. Its elements stay
// read-only statics, so a slot write replaces the whole element.
QUEUE:  Spec[]!:   [Spec { .name = "seed", .code = 0 }]

bump :: fn(i: usize) -> void {
    COUNTS[i] = COUNTS[i] + 1
}

main :: fn() -> i32 {
    println("${MAX} ${GREETING} ${MODE == Mode.Fast}")
    println("${DIGITS[1]} ${LIMITS[2]} ${SPECS[1].name} ${ORIGIN.name}")
    println("${PAIR.0}${PAIR.1}")

    // Writes through the globals persist across calls — one shared allocation.
    bump(usize(0))
    bump(usize(0))
    bump(usize(2))
    println("counts=${COUNTS[0]},${COUNTS[1]},${COUNTS[2]}")

    // RUNTIME-built strings: their atoms are not permanent, so these survive the
    // collection below only because the global is registered as an atom root.
    for i in 0..<24 {
        SLOTS[usize(i)] = "runtime-slot-${i}"
    }
    collect()
    lost := 0
    for i in 0..<24 {
        if SLOTS[usize(i)] != "runtime-slot-${i}" {
            lost = lost + 1
        }
    }
    println("slots=${SLOTS[0]}/${SLOTS[23]} lost=${lost}/24 collected=${collections() > 0}")

    FLAGS[2] = true
    println("flags=${FLAGS[0]},${FLAGS[2]} len=${FLAGS.len()}")

    // GROWTH past the initial capacity: the buffer is reallocated on the GC heap
    // and hangs off the global, which only survives because the permanent frame
    // roots the array as an object (`stack_objs`, the mechanism written for
    // stack-allocated structs — an off-arena object whose pointer fields must be
    // forwarded). The collect() below is what proves it.
    for i in 0..<40 {
        COUNTS.push(i32(i))
    }
    collect()
    grown := 0
    for i in 0..<40 {
        if COUNTS[usize(i) + 3] == i32(i) {
            grown = grown + 1
        }
    }
    println("grown=${grown}/40 len=${COUNTS.len()}")

    // Aggregate slots: replacing an element stores a HEAP object in a static
    // buffer. `vader_gc_scan_raw` forwards `.buf` but never descends into an
    // off-arena one, so the buffer is rooted alongside the array — else this
    // Spec would be collected while still reachable.
    QUEUE[0] = Spec { .name = "replaced-${1 + 1}", .code = 5 }
    for i in 0..<8 {
        QUEUE.push(Spec { .name = "q-${i}", .code = i32(i) })
    }
    collect()
    queue_ok := 0
    if QUEUE[0].name == "replaced-2" {
        queue_ok = queue_ok + 1
    }
    for i in 0..<8 {
        if QUEUE[usize(i) + 1].name == "q-${i}" {
            queue_ok = queue_ok + 1
        }
    }
    println("queue=${queue_ok}/9 len=${QUEUE.len()}")

    // Reading is always available ; only writes are gated.
    total := 0
    for v in LIMITS {
        total = total + v
    }
    println("total=${total}")
    return 0
}
