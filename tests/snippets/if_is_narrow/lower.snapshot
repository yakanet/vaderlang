# Lower

## snippet
  snippet.Cat :: struct { name: string }  // snippet$Cat
  snippet.Dog :: struct { sound: string }  // snippet$Dog
  snippet.Pig :: struct { weight: i32 }  // snippet$Pig
  snippet.direct :: fn(p: Cat | Dog) -> string {  // snippet$direct
      if p is Cat {
          return concat_2("cat ", Cat(p).name)
      }
      return concat_2("dog says ", Dog(p).sound)
  }
  snippet.negated :: fn(p: Cat | Dog) -> string {  // snippet$negated
      if !(p is Cat) {
          return concat_2("dog says ", Dog(p).sound)
      }
      return concat_2("cat ", Cat(p).name)
  }
  snippet.cascade :: fn(p: Cat | Dog | Pig) -> string {  // snippet$cascade
      if p is Cat {
          return concat_2("cat ", Cat(p).name)
      }
      if p is Dog {
          return concat_2("dog says ", Dog(p).sound)
      }
      return {
          __buf_0: Buffer = std.core.new_byte_buffer(usize(30))
          __off_1: usize = 0
          __off_1 = std.core.write_string_at(__buf_0, __off_1, "pig of ")
          __off_1 = std.core.write_int(__buf_0, __off_1, i64(Pig(p).weight))
          __off_1 = std.core.write_string_at(__buf_0, __off_1, " kg")
          std.core.finish_buffer(__buf_0, __off_1)
      } :string
  }
  snippet.primitive_is :: fn(v: i32 | string) -> string {  // snippet$primitive_is
      if v is i32 {
          return {
              __buf_0: Buffer = std.core.new_byte_buffer(usize(24))
              __off_1: usize = 0
              __off_1 = std.core.write_string_at(__buf_0, __off_1, "int ")
              __off_1 = std.core.write_int(__buf_0, __off_1, i64(i32(v)))
              std.core.finish_buffer(__buf_0, __off_1)
          } :string
      }
      return concat_2("str ", string(v))
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      std.io.println<string>(snippet.direct(Cat { .name = "felix" }))
      std.io.println<string>(snippet.direct(Dog { .sound = "woof" }))
      std.io.println<string>(snippet.negated(Cat { .name = "garfield" }))
      std.io.println<string>(snippet.negated(Dog { .sound = "bark" }))
      std.io.println<string>(snippet.cascade(Pig { .weight = 200 }))
      std.io.println<string>(snippet.primitive_is(42))
      std.io.println<string>(snippet.primitive_is("hello"))
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.usize.new_buffer(c1)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

