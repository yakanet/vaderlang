// A bound that names its trait's arguments (`T: Add<T, T>`) is met by an impl
// that leaves them to the trait's defaults (`i32 implements Add` is
// `Add<i32, i32>`), by one that writes them, and by one that writes `Self`. A bound
// naming only some of them (`T: Add<T>`) is padded the same way where it meets
// another one.
//
// The binding keeps the rights of its argument. A struct literal binds `T` to an
// owned `Money!`, which the impl `Add<Money, Money>` serves as it serves a read-only
// `Money`: the owned value is lent read-only. An array literal binds a `Money![]!`,
// read-only down to its elements when it is lent. An impl that names the type
// mutable (`Sink<Cfg!>`) serves the owned argument as it is. A UFCS receiver
// (`2.5.twice()`) is held to the bound like an argument.

module "snippet"

import "std/io"

Money :: struct {
    cents: i64
}

Money implements Add<Money, Money> {
    add :: fn(self, other: Money) -> Money = Money { .cents = self.cents + other.cents }
}

Points :: struct {
    n: i32
}

Points implements Add {
    add :: fn(self, other: Points) -> Points = Points { .n = self.n + other.n }
}

Grams :: struct {
    g: i32
}

Grams implements Add<Self, Self> {
    add :: fn(self, other: Grams) -> Grams = Grams { .g = self.g + other.g }
}

twice :: fn<T: Add<T, T>>(x: T) -> T = x + x

relay :: fn<T: Add<T>>(x: T) -> T = twice(x)

Count :: trait<E> {
    count :: fn(self, e: E) -> usize
}

Money[] implements Count<Money[]> {
    count :: fn(self, e: Money[]) -> usize = self.len() + e.len()
}

both :: fn<T: Count<T>>(x: T) -> usize = x.count(x)

Cfg :: struct {
    n: i32
}

Sink :: trait<E> {
    put :: fn(self, e: E) -> i32
}

Cfg implements Sink<Cfg> {
    put :: fn(self, e: Cfg) -> i32 {
        e.n = 9
        return e.n
    }
}

feed :: fn<T: Sink<T>>(x: T) -> i32 = x.put(x)

main :: fn() -> i32 {
    five: u64: 5
    println("primitives: ${twice(3)} ${twice(five)} ${2.5.twice()}")
    kept: Money: Money { .cents = 7 }
    println("written impl: ${twice(Money { .cents = 3 }).cents} ${twice(kept).cents}")
    println("default impl: ${twice(Points { .n = 4 }).n}")
    println("self impl: ${twice(Grams { .g = 6 }).g}")
    println("partial bound: ${relay(Points { .n = 5 }).n}")
    println("array: ${both([Money { .cents = 1 }, Money { .cents = 2 }])}")
    println("mutable impl: ${feed(Cfg { .n = 1 })}")
    return 0
}
