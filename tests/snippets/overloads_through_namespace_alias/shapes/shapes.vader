module "snippet/shapes"

/// A circle by its radius.
export Circle :: struct { radius: f64 }

/// A square by its side.
export Square :: struct { side: f64 }

/// The area of `c`, `pi` rounded to 3 unless given.
export area :: fn(c: Circle, pi: f64 = 3.0) -> f64 = pi * c.radius * c.radius

/// The area of `s`, times `scale`.
export area :: fn(s: Square, scale: f64 = 1.0) -> f64 = scale * s.side * s.side
