// `count`, `last`, `is_empty` over any iterator — a range, a user struct that
// implements `Iterator` — as free functions of std/iter: an implementation
// provides `next` and nothing else.

module "snippet"

import "std/io"
import "std/iter"

Countdown :: struct { remaining: i32 }

Countdown implements Iterator<i32> {
    next :: fn(self!) -> [i32, Continuation] {
        if self.remaining <= 0 {
            return [0, .Stop]
        }
        v :: self.remaining
        self.remaining = self.remaining - 1
        return [v, .Continue]
    }
}

main :: fn() -> i32 {
    // Range — count drains the iterator.
    println((0..<5).count())

    // Range — last yields the inclusive end.
    match (10..=15).last() as v {
        is i32  -> println(v)
        is null -> println("none")
    }

    // is_empty — the empty range ends immediately.
    println((0..<0).is_empty())
    println((0..<5).is_empty())

    // User struct — the same functions, over its `next`.
    println(Countdown { .remaining = 3 }.count())

    return 0
}
