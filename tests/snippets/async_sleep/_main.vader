// Real suspension through `sleep`: the cooperative scheduler and its timer heap.
// A coroutine parks on `sleep`; the driver blocks on the nearest timer (it never
// spins) and re-drives as the scheduler clock advances. `main` stays synchronous
// and calls `run_async_main` itself, the driver the compiler routes an awaiting
// `main` through (`async_sleep_main` covers that form). Small sleeps keep the
// test fast; the output is fixed by deadline order, not wall-clock time.
module "snippet"

import "std/io"
import "std/async"

steps :: fn() -> Async<i32> {
    println("start")
    await sleep(2)
    println("woke at 2")
    await sleep(3)
    println("woke at 5")
    return 7
}

main :: fn() -> i32 {
    code :: run_async_main(steps())
    println("exit code = ${code}")
    return 0
}
