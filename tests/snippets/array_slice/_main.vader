// Array slicing: `arr[r]` with a range index returns the elements of the
// half-open range `[r.start, r.end)`, or of the closed `[r.start, r.end]` for a
// `..=` range. The typechecker dispatches on the *type* of the index: any
// `Range<integer>` takes the slice path, so a literal range, a let-bound range
// value and `i64` bounds all work. An empty range (`arr[i..<i]`) gives a
// zero-length array.

module "snippet"

import "std/io"

main :: fn() -> i32 {
    arr: i32[]: [10, 20, 30, 40, 50]

    // half-open literal range
    s1 :: arr[1..<4]
    println("s1.len = ${s1.len()}")
    for v in s1 { println("  ${v}") }

    // inclusive literal range
    s2 :: arr[0..=2]
    println("s2.len = ${s2.len()}")
    for v in s2 { println("  ${v}") }

    // let-bound range value
    r :: 2..<5
    s3 :: arr[r]
    println("s3.len = ${s3.len()}")
    for v in s3 { println("  ${v}") }

    // i64-typed bounds
    n: i64: 3
    s4 :: arr[0..<n]
    println("s4.len = ${s4.len()}")
    for v in s4 { println("  ${v}") }

    // empty slice
    s5 :: arr[2..<2]
    println("s5.len = ${s5.len()}")

    return 0
}
