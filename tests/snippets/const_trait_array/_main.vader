module "snippet"

import "std/io"

// A const read under a trait type : its entry in the data pool holds `Circle` and
// `Square` values, while the read itself names only `Shape[]`. Each baked struct
// keeps its type for the native emit, which takes the static's layout from it.

Shape :: trait {
    area :: fn(self) -> i32
}

Circle :: struct {
    r: i32
}

Square :: struct {
    side: i32
}

Circle implements Shape {
    area :: fn(self) -> i32 = self.r * self.r * 3
}

Square implements Shape {
    area :: fn(self) -> i32 = self.side * self.side
}

SHAPES: Shape[]: [Circle { .r = 1 }, Square { .side = 2 }]

main :: fn() -> i32 {
    total := 0
    for s in SHAPES {
        total += s.area()
    }
    println("${SHAPES.len()} ${total}")
    return 0
}
