  snippet.main :: fn() -> i32 {  // snippet$main
      s: string = "  Hello, World!  "
      std.io.println<string>({
          __buf_0: Buffer = std.core.new_byte_buffer(usize(20))
          __off_1: usize = 0
          __off_1 = std.core.write_unsigned(__buf_0, __off_1, u64(@array.len(std.core.bytes(s))))
          std.core.finish_buffer(__buf_0, __off_1)
      } :string)
      std.io.println<string>(std.string.trim(s))
      std.io.println<string>(std.string.to_upper("hello"))
      std.io.println<string>(std.string.to_lower("VADER"))
      std.io.println<string>({
          __buf_2: Buffer = std.core.new_byte_buffer(usize(5))
          __off_3: usize = 0
          __off_3 = std.core.write_bool(__buf_2, __off_3, std.string.string.contains("foobar", "oba"))
          std.core.finish_buffer(__buf_2, __off_3)
      } :string)
      std.io.println<string>({
          __buf_4: Buffer = std.core.new_byte_buffer(usize(5))
          __off_5: usize = 0
          __off_5 = std.core.write_bool(__buf_4, __off_5, std.string.starts_with("foobar", "foo"))
          std.core.finish_buffer(__buf_4, __off_5)
      } :string)
      std.io.println<string>({
          __buf_6: Buffer = std.core.new_byte_buffer(usize(5))
          __off_7: usize = 0
          __off_7 = std.core.write_bool(__buf_6, __off_7, std.string.ends_with("foobar", "bar"))
          std.core.finish_buffer(__buf_6, __off_7)
      } :string)
      std.io.println<string>(std.core.bytes_to_string(std.core.bytes("hello world")[usize(6)..<usize(11)]))
      std.io.println<string>(std.core.char.to_string(std.core.string.at("hello", 1)))
      std.io.println<string>(std.core.char.to_string(std.core.string.at("你好嗎？", 0)))
      std.io.println<string>(std.core.char.to_string(std.core.string.at("你好嗎？", 1)))
      std.io.println<string>(std.core.char.to_string(std.core.string.at("你好嗎？", 3)))
      parts: string[] = std.string.split("a,b,c", ",")
      std.io.println<string>(parts[0])
      std.io.println<string>(parts[1])
      std.io.println<string>(parts[2])
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.usize.new_buffer(c1)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

