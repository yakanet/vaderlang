  snippet.fused :: fn(seed: string) -> string {  // snippet$fused
      s: string = seed
      s = concat_2(s, "bcdefghijklm")
      return s
  }
  snippet.reads_itself :: fn(seed: string) -> string {  // snippet$reads_itself
      s: string = seed
      s = concat_2(s, "-")
      s = concat_2(s, s)
      return s
  }
  snippet.observed_between :: fn(seed: string) -> string {  // snippet$observed_between
      s: string = seed
      s = concat_2(s, "x")
      t: string = s
      s = concat_2(s, t)
      return s
  }
  snippet.interleaved :: fn(a0: string, b0: string) -> string {  // snippet$interleaved
      a: string = a0
      b: string = b0
      a = concat_2(a, "1")
      b = concat_2(b, "2")
      a = concat_2(a, "3")
      return concat_2(a, b)
  }
  snippet.mixed_operands :: fn(seed: string, x: string) -> string {  // snippet$mixed_operands
      s: string = seed
      s = concat_4(s, "<", x, ">")
      return s
