  snippet.captured_local :: fn(seed: string) -> string {  // snippet$captured_local
      s: @cell<string> = @cell_new(seed)
      peek: __lambda_env_snippet_1 = __lambda_env_snippet_1 { .cap_0 = s }
      @cell(s) = concat_2(@cell(s), "m")
      mid: string = __lambda_snippet_0(peek)
      @cell(s) = concat_2(@cell(s), "n")
      return concat_3(@cell(s), "/", mid)
  }
