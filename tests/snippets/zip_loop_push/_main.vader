// Loops over `zip(a, b)`.
//   - A push in the loop keeps the array's state in locals (the push cache),
//     as the same loop written by index does: the tuple each step yields is a
//     value of two primitives, never an allocation.
//   - Over an array of structs, the element's fields are read back from the
//     yielded tuple: the struct must arrive as the reference the field read
//     expects, not as a box.

module "snippet"

import "std/io"
import "std/iter"

Point :: struct { x: i32, y: i32 }

products :: fn(a: i32[], b: i32[]) -> i64[] {
    out: i64[]: []
    for [x, y] in zip(a, b) {
        out.push(i64(x) * i64(y))
    }
    return out
}

main :: fn() -> i32 {
    p :: products([1, 2, 3, 4], [10, 20, 30])
    println("push: ${p.len()} ${p[0]} ${p[2]}")

    labels: string[]: ["a", "b", "c"]
    pts: Point[]: [
        Point { .x = 10, .y = 1 },
        Point { .x = 20, .y = 2 },
        Point { .x = 30, .y = 3 },
    ]
    for [label, pt] in zip(labels, pts) {
        println("struct field: ${label}:${pt.x},${pt.y}")
    }
    return 0
}
