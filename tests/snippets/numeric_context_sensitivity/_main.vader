// A free integer literal takes the width of the slot it flows into. Covered:
// typed locals of every integer width, arithmetic against a non-default width,
// a negated literal in a signed slot, struct field defaults, comparisons, the
// bounds of a slice range, and an annotated return value.

module "snippet"

import "std/io"

Counter :: struct {
    n: u64 = 0
    delta: i64 = -1
}

main :: fn() -> i32 {
    // (1) typed let → all integer widths
    a8: i8: 5
    b16: i16: 100
    c32: i32: 1000
    d64: i64: 9000000000
    e8: u8: 200
    f16: u16: 65000
    g32: u32: 4000000000
    h64: u64: 18446744073700000000
    signed_wide: i64: -50
    unsigned_wide: u64: 42
    println("widths: ${a8} ${b16} ${c32} ${d64} ${e8} ${f16} ${g32} ${h64} ${signed_wide} ${unsigned_wide}")

    // (2) arithmetic with a literal — the literal adopts the operand width
    signed_wide_next :: signed_wide + 1
    unsigned_wide_next :: unsigned_wide + 1
    d64_2 :: d64 + 1
    h64_2 :: h64 + 1
    println("arith: ${signed_wide_next} ${unsigned_wide_next} ${d64_2} ${h64_2}")

    // (3) negated literal into a signed slot
    neg: i64: -100
    neg2 :: neg - 1
    println("neg: ${neg} ${neg2}")

    // (4) struct field default of `u64` / `i64` adopts the type
    c :: Counter {}
    println("counter: n=${c.n} delta=${c.delta}")

    // (5) comparison with a literal on either side
    if unsigned_wide == 42 {
        println("eq ok")
    }
    if signed_wide <= 0 {
        println("signed_neg ok")
    }

    // (6) index-range bounds — the `0` and `n - 1` adopt `i64` from the
    // built-in `arr[start..<end]` slice's index context (no cast needed).
    arr: i32[]: [10, 20, 30, 40, 50]
    n: i64: arr.len()
    sub :: arr[0..<n - 1]
    println("slice_array: ${sub.len()}")

    // (7) return value with annotation
    forty_two :: fn() -> u64 { return 42 }
    println("returned: ${forty_two()}")

    return 0
}
