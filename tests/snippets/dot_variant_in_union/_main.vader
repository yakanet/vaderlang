// `.Variant` shorthand against a union expected type: `return .North` in a fn
// returning `Direction | ParseError` finds the variant in the union's enum
// member.

module "snippet"

import "std/io"
import "std/string"

Direction :: enum { North, East, South, West }

parse :: fn(c: char) -> Direction | ParseError {
    if c == 'N' { return .North }
    if c == 'E' { return .East }
    if c == 'S' { return .South }
    if c == 'W' { return .West }
    return ParseError { .msg = "unknown" }
}

dir_label :: fn(d: Direction) -> string {
    match d {
        .North -> "N"
        .East  -> "E"
        .South -> "S"
        .West  -> "W"
    }
}

main :: fn() -> i32 {
    match parse('N') as d {
        is Direction  -> println(dir_label(d))
        is ParseError -> println("err")
    }
    match parse('?') as d {
        is Direction  -> println(dir_label(d))
        is ParseError -> println("err")
    }
    return 0
}
