## snippet/days
  snippet.days.is_weekend :: fn(d: u8) -> bool {  // snippet_days$is_weekend
      d >= u8(5)
  }
  snippet.days.is_workday :: fn(d: u8) -> bool {  // snippet_days$is_workday
      if d >= u8(5) {
          return false
      }
      return true
  }
  snippet.days.is_monday :: fn(d: u8) -> bool {  // snippet_days$is_monday
      d == u8(0)
  }

