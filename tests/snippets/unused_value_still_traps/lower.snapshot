  }
  snippet.main :: fn(argv: string[]) -> i32 {  // snippet$main
      some: i32 = i32(@array.len(argv))
      zero: i32 = some >> 4
      xs: i32[] = [1, 2, 3] :i32[]
      case: string = snippet.case_of(argv)
      std.io.println<string>("before")
      if case == "index" {
          xs[some + 4]
      }
      if case == "divide" {
          some / zero
      }
      if case == "remainder" {
          some % zero
      }
      if case == "add" {
          2147483647 + some
      }
      if case == "negate" {
          -(-2147483648 + zero)
      }
      if case == "loop" {
          {
              __for_arr_0: i32[] = xs
              __for_len_1: i64 = @array.len(__for_arr_0)
              __for_i_2: i64 = 0
              for __for_i_2 < __for_len_1 {
                  _: i32 = __for_arr_0[__for_i_2]
                  @array.remove_last(xs)
              } @step {
                  __for_i_2 = __for_i_2 +% i64(1)
              }
          }
      }
      std.io.println<string>("after")
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

