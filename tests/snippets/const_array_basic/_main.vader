// A module-level array constant is frozen. Reading through it works, and it passes
// to a parameter that only reads it, as a local does.

module "snippet"

import "std/io"

DIGITS :: [10, 20, 30]

read_first :: fn(a: i32[]) -> i32 {
    return a[0]
}

main :: fn() -> i32 {
    local :: [40, 50]
    println("first=${read_first(DIGITS)} ${read_first(local)}")
    return 0
}
