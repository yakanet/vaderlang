// An `is` test on a union of arrays: the narrowed binding is the scrutinee, so
// pushing through it is legal on both sides.
//
// The run is the oracle that matters: each branch must push into the right
// buffer at the right element width.

module "snippet"

import "std/io"

fill :: fn(x: i32[] | string[]) -> usize {
    if x is i32[] {
        x.push(30)
        x.push(40)
        return x.len()
    }
    x.push("added")
    return x.len()
}

// Reading through the narrowed binding works the same way.
total :: fn(x: i32[] | string[]) -> usize {
    if x is i32[] {
        sum := 0
        for v in x {
            sum = sum + v
        }
        return usize(sum)
    }
    return x.len()
}

main :: fn() -> i32 {
    nums:  i32[]   : [10, 20]
    words: string[]: ["a", "b"]
    println("nums=${fill(nums)} words=${fill(words)}")
    println("elems=${nums[2]},${nums[3]} last=${words[2]}")
    println("total=${total(nums)} count=${total(words)}")
    return 0
}
