# Lower

## snippet
  snippet.Ints :: struct { n: i32 }  // snippet$Ints
  snippet.Strings :: struct { n: i32 }  // snippet$Strings
  snippet.Ints.name :: fn(self: Ints) -> string {  // snippet$Ints$Probe$name
      "ints"
  }
  snippet.Ints.holds :: fn(self: Ints, x: Box<i32> | Box<string>) -> string {  // snippet$Ints$Probe$holds
      {
          if x is Box<i32> { concat_2(snippet.Ints.name(self), " holds it") } else { concat_2(snippet.Ints.name(self), " does not") } :string
      } :string
  }
  snippet.Strings.name :: fn(self: Strings) -> string {  // snippet$Strings$Probe$name
      "strings"
  }
  snippet.Strings.holds :: fn(self: Strings, x: Box<i32> | Box<string>) -> string {  // snippet$Strings$Probe$holds
      {
          if x is Box<string> { concat_2(snippet.Strings.name(self), " holds it") } else { concat_2(snippet.Strings.name(self), " does not") } :string
      } :string
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      ints: Ints = Ints { .n = 1 }
      strings: Strings = Strings { .n = 2 }
      number: Box<i32> | Box<string> = Box<i32> { .v = 3 }
      text: Box<i32> | Box<string> = Box<string> { .v = "x" }
      std.io.println<string>(snippet.Ints.holds(ints, number))
      std.io.println<string>(snippet.Strings.holds(strings, number))
      std.io.println<string>(snippet.Ints.holds(ints, text))
      std.io.println<string>(snippet.Strings.holds(strings, text))
      return 0
  }
  snippet.Box<i32> :: struct { v: i32 }  // snippet$Box__i32
  snippet.Box<string> :: struct { v: string }  // snippet$Box__string
  snippet.Box<Any> :: struct { v: Any }  // snippet$Box__Any
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  vtable snippet.Probe.holds for Ints  snippet.Ints.holds  // snippet$Ints$Probe$holds
  vtable snippet.Probe.holds for Strings  snippet.Strings.holds  // snippet$Strings$Probe$holds
  vtable snippet.Probe.name for Ints  snippet.Ints.name  // snippet$Ints$Probe$name
  vtable snippet.Probe.name for Strings  snippet.Strings.name  // snippet$Strings$Probe$name

