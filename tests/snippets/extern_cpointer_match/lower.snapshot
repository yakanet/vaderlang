# Lower

## snippet
  snippet.c_fopen :: fn(path: string, mode: string) -> CPointer | null  // snippet$c_fopen
  snippet.c_fclose :: fn(f: CPointer) -> i32  // snippet$c_fclose
  snippet.main :: fn() -> i32 {  // snippet$main
      path: string = concat_2(std.env.temp_dir(), "/vader_cpointer_probe")
      wrote: IOError | null = std.fs.write_file(path, "x")
      if wrote is IOError {
          std.console.println<string>(concat_2("setup failed: ", IOError(wrote).msg))
          return 1
      }
      r: CPointer | null = snippet.c_fopen(path, "rb")
      {
          if r is CPointer {
              {
                  std.console.println<string>("matched CPointer")
                  snippet.c_fclose(CPointer(r))
              } :i32
          } else if r is null {
              std.console.println<string>("matched null")
          } else {
              @unreachable("non-exhaustive match (T3013 should have caught this)")
          } :i32 | void
      }
      std.console.println<string>("after match")
      missing: CPointer | null = snippet.c_fopen(concat_2(std.env.temp_dir(), "/vader_no_such_probe_at_all"), "rb")
      {
          if missing is CPointer {
              {
                  std.console.println<string>("unexpectedly opened")
                  snippet.c_fclose(CPointer(missing))
              } :i32
          } else if missing is null {
              std.console.println<string>("matched null")
          } else {
              @unreachable("non-exhaustive match (T3013 should have caught this)")
          } :i32 | void
      }
      std.fs.remove(path, RemoveOptions { .recursive = false, .force = false })
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  concat_3 :: fn(p0: string, p1: string, p2: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      c2: i64 = c1 +% std.core.byte_len(p2)
      buf: Buffer = std.core.new_byte_buffer(c2)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.intern_string(buf, c2)
  }

