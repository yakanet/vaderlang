// An `if` on a constant known at compile time keeps only the branch it takes: the
// other is neither lowered nor emitted, nor are the functions only it calls. The
// constant may be an enum variant however written, or computed from another
// module's constant (`VADER_OS`). It is how code that depends on the target is
// left out of a build.

module "snippet"

import "std/console"

Mode :: enum {
    Fast,
    Slow,
}

MODE: Mode: .Fast
NAMED :: Mode.Fast
OS :: VADER_OS
ON_BROWSER :: VADER_OS == .Browser
OFF_BROWSER :: !ON_BROWSER
CHOSEN :: @comptime Mode.Fast

// Called only from branches that the constants rule out.
never_called :: fn(what: string) -> void {
    println("unreachable: ${what}")
}

main :: fn() -> i32 {
    if VADER_OS == .Browser {
        never_called("browser")
    }
    if MODE == .Slow {
        never_called("slow")
    }
    if MODE != .Fast {
        never_called("not fast")
    } else {
        println("fast")
    }
    if NAMED == .Slow {
        never_called("named slow")
    }
    if OS == .Browser {
        never_called("os browser")
    }
    if ON_BROWSER {
        never_called("on browser")
    }
    if !OFF_BROWSER {
        never_called("not off browser")
    }
    if CHOSEN == .Slow {
        never_called("chosen slow")
    }
    return 0
}
