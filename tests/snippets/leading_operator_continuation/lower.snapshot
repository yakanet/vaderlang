  snippet.main :: fn() -> i32 {  // snippet$main
      std.io.println<string>(snippet.describe(3, true))
      std.io.println<string>(snippet.describe(4, false))
      std.io.println<string>(snippet.lookup(["ada", "bob"] :string[], i64(1)))
