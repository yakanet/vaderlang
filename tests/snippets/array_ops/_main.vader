// tests/snippets/array_ops: the core array operations on a heap `i32[]`.
//
// A literal (`array.new`), an index write, a `push` that grows the array, index
// reads and `len`, in a `main` the C backend gives a GC frame because it
// allocates. Elements sit in raw `i32` slots. Result via exit code:
// 10 + 99 + 40 + len(4) = 153.

module "snippet"

main :: fn() -> i32 {
    xs :: [10, 20, 30]
    xs[1] = 99
    xs.push(40)
    return xs[0] + xs[1] + xs[3] + i32(xs.len())
}
