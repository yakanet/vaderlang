# Lower

## snippet
  snippet.Cat :: struct { name: string }  // snippet$Cat
  snippet.Dog :: struct { sound: string }  // snippet$Dog
  snippet.Pig :: struct { weight: i32 }  // snippet$Pig
  snippet.describe :: fn(p: Cat | Dog) -> string {  // snippet$describe
      if !(p is Cat) {
          return concat_2("dog says ", Dog(p).sound)
      }
      return concat_2("cat ", Cat(p).name)
  }
  snippet.stringify :: fn(v: i32 | string) -> string {  // snippet$stringify
      if !(v is string) {
          return {
              __buf_0: Buffer = std.core.new_byte_buffer(usize(24))
              __off_1: usize = 0
              __off_1 = std.core.write_string_at(__buf_0, __off_1, "int ")
              __off_1 = std.core.write_int(__buf_0, __off_1, i64(i32(v)))
              std.core.finish_buffer(__buf_0, __off_1)
          } :string
      }
      return concat_2("str ", string(v))
  }
  snippet.unwrap_or :: fn(value: Cat | null, fallback: string) -> string {  // snippet$unwrap_or
      if !(value is null) {
          return concat_2("cat ", Cat(value).name)
      }
      return fallback
  }
  snippet.is_not_dog :: fn(p: Cat | Dog) -> bool {  // snippet$is_not_dog
      return !(p is Dog)
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      std.io.println<string>(snippet.describe(Cat { .name = "felix" }))
      std.io.println<string>(snippet.describe(Dog { .sound = "woof" }))
      std.io.println<string>(snippet.stringify(42))
      std.io.println<string>(snippet.stringify("hello"))
      std.io.println<string>(snippet.unwrap_or(Cat { .name = "garfield" }, "nothing"))
      std.io.println<string>(snippet.unwrap_or(null, "nothing"))
      cat: Cat = Cat { .name = "felix" }
      dog: Dog = Dog { .sound = "woof" }
      if snippet.is_not_dog(cat) {
          std.io.println<string>("cat is not a dog")
      }
      if snippet.is_not_dog(dog) {
          std.io.println<string>("dog is dog (should not print)")
      }
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.usize.new_buffer(c1)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

