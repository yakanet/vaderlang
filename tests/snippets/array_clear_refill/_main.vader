// `clear()` then refill, twice over: a local array and a singleton's.
//
// A clear must shrink the buffer's length along with the array's: otherwise the
// next `push` reads the array as a slice view and detaches into a capacity-doubled
// buffer, and the backing store doubles on every clear. `remove_last` follows the
// same rule. The array a singleton hands out is the shared instance, so a clear
// or a pop through one call is seen by the next.
//
// The counts below are the subject. `seen()` cycles 129 pushes then clears, so
// 5000 passes leave 5000 - 38 * 129 = 98.

module "snippet"

import "std/io"

@singleton
seen :: fn() -> string[] = []

main :: fn() -> i32 {
    local: i32[]: []
    for i in 0..<200 {
        local.push(i)
        if local.len() > 4 {
            local.clear()
        }
    }
    println("local=${local.len()}")

    for i in 0..<5000 {
        seen().push("step ${i}")
        if seen().len() > 128 {
            seen().clear()
        }
    }
    println("module=${seen().len()}")

    seen().push("x")
    seen().push("y")
    popped :: seen().remove_last()
    println("popped=${popped ?? "<null>"} left=${seen().len()}")

    // A clear must not disturb a genuine slice view of the same elements.
    src: i32[]: [1, 2, 3, 4, 5]
    view :: src[1..<3]
    src.clear()
    println("view=${view.len()} src=${src.len()}")
    return 0
}
