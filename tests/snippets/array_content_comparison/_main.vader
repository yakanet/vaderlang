// An array has no `==` : comparing two walks them, which the method names say.
// `content_equals` compares in order, `is_permutation_of` in any order with the
// same multiplicities, `contains_all` and `is_disjoint` compare as sets. `===`
// stays the identity test.

module "snippet"

import "std/io"

Point :: struct {
    x: i32
}

Point implements Equals -> self.x == other.x

main :: fn() -> i32 {
    a :: [1, 2, 3]
    b :: [1, 2, 3]
    println("in order    : ${a.content_equals(b)} ${a.content_equals([3, 2, 1])} ${a === b}")
    pair :: [1, 2, 2]
    println(
        "any order   : ${pair.is_permutation_of([2, 1, 2])} ${pair.is_permutation_of([1, 1, 2])}",
    )
    println("contains    : ${a.contains_all([3, 1, 3])} ${a.contains_all([2, 4])}")
    println("disjoint    : ${a.is_disjoint([4, 5])} ${a.is_disjoint([5, 3])}")
    points :: [Point { .x = 1 }, Point { .x = 2 }]
    println("through Eq  : ${points.content_equals([Point { .x = 1 }, Point { .x = 2 }])}")
    negative_zero: f64: -0.0
    println("IEEE        : ${[0.0].content_equals([negative_zero])}")
    return 0
}
