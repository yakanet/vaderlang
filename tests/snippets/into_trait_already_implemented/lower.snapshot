# Lower

## snippet
  snippet.Cat :: struct { name: string }  // snippet$Cat
  snippet.Stray :: struct {}  // snippet$Stray
  snippet.Cat.label :: fn(self: Cat) -> string {  // snippet$Cat$Named$label
      concat_2("cat ", self.name)
  }
  snippet.Stray.label :: fn(self: Stray) -> string {  // snippet$Stray$Named$label
      "stray"
  }
  snippet.Cat.into :: fn(self: Cat) -> Named {  // snippet$Cat$std_core$Into$into
      Stray {}
  }
  snippet.Holder :: struct { pet: Named }  // snippet$Holder
  snippet.show :: fn(n: Named) -> string {  // snippet$show
      @vcall(snippet.Named.label, n)
  }
  snippet.adopt :: fn(c: Cat) -> Named {  // snippet$adopt
      c
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      tom: Cat = Cat { .name = "Tom" }
      declared: Named = tom
      std.io.println<string>(@vcall(snippet.Named.label, declared))
      std.io.println<string>(snippet.show(tom))
      std.io.println<string>(@vcall(snippet.Named.label, snippet.adopt(tom)))
      std.io.println<string>(@vcall(snippet.Named.label, tom))
      converted: Named = snippet.Cat.into(tom)
      std.io.println<string>(@vcall(snippet.Named.label, converted))
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  vtable snippet.Named.label for Cat  snippet.Cat.label  // snippet$Cat$Named$label
  vtable snippet.Named.label for Stray  snippet.Stray.label  // snippet$Stray$Named$label
  vtable std.core.Into.into for Cat  snippet.Cat.into  // snippet$Cat$std_core$Into$into

