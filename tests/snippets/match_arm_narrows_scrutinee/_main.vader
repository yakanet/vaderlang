// Each arm reads the scrutinee narrowed in place to its variant: `a.x` in the
// `is P` arm is a typed field load, not a read through the union box. The arms
// cover two structs and `null`, in a `match` that yields the value. An arm
// pattern binds no name (P1037), and the narrowing needs none.

module "snippet"

import "std/io"

P :: struct { x: i32 }
Q :: struct { y: string }

show :: fn(a: P | Q | null) -> string = match a {
    is null -> "null"
    is P    -> "P.x = ${a.x}"
    is Q    -> "Q.y = ${a.y}"
}

main :: fn() -> i32 {
    println(show(P { .x = 42 }))
    println(show(Q { .y = "hello" }))
    println(show(null))
    return 0
}
