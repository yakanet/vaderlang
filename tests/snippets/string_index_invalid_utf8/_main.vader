// string_index_invalid_utf8: `s[i]` and `s[lo..<hi]` over malformed UTF-8 read
// the same codepoints on the VM as natively. A stray continuation byte counts as
// one codepoint of one byte, decoded as U+FFFD; a lead byte cut short by the end
// is one codepoint, decoded as U+0000.

module "snippet"

import "std/io"

main :: fn() -> i32 {
    s :: bytes_to_string([0x61, 0xA9, 0x62, 0x63, 0x64, 0xE2, 0x82])
    for i in 0..<6 {
        println(u32(s[i]))
    }
    println(s[1..<3].byte_len())
    println(s[2..<10].byte_len())
    println(s[4..<2].byte_len())
    return 0
}
