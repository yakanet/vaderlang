module "snippet"

import "std/io"

// Comptime tuple values — the comptime VM materialises a Tuple result
// into a `ComptimeValue.struct` (with synthetic `_0`, `_1`, … field
// names) and the lowerer re-emits it as a `LoweredStructLit` at every
// inline site, just like a regular struct const. Typed top-level const
// uses the Odin-style `name : Type : value` form so the seq-literal
// inference picks Tuple rather than the homogeneous-Array default. Each
// element takes the type of its position: `SPAN.0` keeps the bits an `i32`
// would lose, and so does `REACH.0`, a tuple named as a type of its own.

@comptime
DIM : [i32, i32] : [10, 20]

@comptime
ORIGIN : [f64, f64, string] : [0.0, 0.0, "origin"]

FAR: i64: 5_000_000_000

SPAN: [i64, i32]: [FAR, 3]

Reach :: [i64, i32]

REACH: Reach: [FAR, 4]

main :: fn() -> i32 {
    println("dim ${DIM.0}x${DIM.1}")
    println("origin (${ORIGIN.0}, ${ORIGIN.1}) = ${ORIGIN.2}")
    println("span ${SPAN.0} over ${SPAN.1}")
    [far, steps] :: REACH
    println("reach ${far} in ${steps}")
    return DIM.0
}
