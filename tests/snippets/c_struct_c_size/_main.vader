module "snippet"

import "std/io"

// `struct timeval` is flat and its second member changes width: `suseconds_t` is
// 4 bytes on Darwin against 8 on Linux. The Vader field is the wider of the two
// and `@c_size` states what C actually has, which `cc` then checks.
//
// The mirror is EXHAUSTIVE, which is what lets the interpreter lay the block out
// itself — it computes the offsets from these widths, and the emitted
// `_Static_assert`s pin that computation to what `cc` produces.
@c_struct("struct timeval")
TimeVal :: struct {
    tv_sec: i64,
    @c_size(4, .Darwin)
    @c_size(8, .Linux)
    tv_usec: i64,
}

@c_header("<sys/time.h>")
@extern("gettimeofday")
sys_gettimeofday :: fn(@c_pointer tv: TimeVal!, tz: CPointer | null) -> i32

main :: fn() -> i32 {
    tv :: TimeVal { .tv_sec = 0, .tv_usec = 0 }
    rc :: sys_gettimeofday(tv, null)
    println("rc=${rc}")
    println("epoch=${tv.tv_sec > 1_600_000_000}")
    println("usec_in_range=${tv.tv_usec >= 0 && tv.tv_usec < 1_000_000}")
    return 0
}
