// Three tasks each count themselves in on entry, sleep, and print on exit. Every
// one starts before any ends, since a task that sleeps lets the next run; they
// end in the order of their sleeps (B, C, A), and `join_all` gives their results
// back in the order of the tasks it was given. On several workers the tasks
// start in any order, hence a count rather than a line each; the sleeps are
// far enough apart that a loaded machine does not swap two ends.
module "snippet"

import "std/console"
import "std/task"
import "std/time"

nap :: fn(name: string, delay: i64, started: AtomicInt) -> i64 {
    started.fetch_add(1)
    sleep(delay.millis())
    println("${name}: end (slept ${delay}, ${started.load()} started)")
    return delay
}

main :: fn() -> i32 {
    started :: AtomicInt {}
    naps :: [
        launch(() -> nap("A", 120, started)),
        launch(() -> nap("B", 40, started)),
        launch(() -> nap("C", 80, started)),
    ]
    for r in join_all(naps) {
        println("${r}")
    }
    return 0
}
