  concat_5 :: fn(p0: string, p1: string, p2: string, p3: string, p4: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      c2: i64 = c1 +% std.core.byte_len(p2)
      c3: i64 = c2 +% std.core.byte_len(p3)
      c4: i64 = c3 +% std.core.byte_len(p4)
      buf: Buffer = std.core.usize.new_buffer(usize(c4))
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.write_string(buf, c2, p3)
      std.core.Buffer.write_string(buf, c3, p4)
      std.core.Buffer.intern_string(buf, c4)
  }
  concat_3 :: fn(p0: string, p1: string, p2: string) -> string {
