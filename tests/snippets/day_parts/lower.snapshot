  snippet.part_of_day :: fn(h: u8) -> string {  // snippet$part_of_day
      {
          if (h >= u8(0)) && (h <= u8(5)) {
              "night"
          } else if (h >= u8(6)) && (h <= u8(11)) {
              "morning"
          } else if (h >= u8(12)) && (h <= u8(17)) {
              "afternoon"
          } else if (h >= u8(18)) && (h <= u8(23)) {
              "evening"
          } else {
              @unreachable("non-exhaustive match (T3013 should have caught this)")
          } :string
      } :string
  }
  snippet.high_bit :: fn(b: u8) -> bool {  // snippet$high_bit
      {
          if (b >= u8(0)) && (b < u8(128)) {
              false
          } else if (b >= u8(128)) && (b <= u8(255)) {
              true
          } else {
              @unreachable("non-exhaustive match (T3013 should have caught this)")
          } :bool
      } :bool
  }
  snippet.sign :: fn(n: i8) -> i32 {  // snippet$sign
      {
          if (n >= i8(-128)) && (n <= i8(-1)) {
              -1
          } else if n == i8(0) {
              0
          } else if (n >= i8(1)) && (n <= i8(127)) {
              1
          } else {
              @unreachable("non-exhaustive match (T3013 should have caught this)")
          } :i32
      } :i32
  }
  snippet.plane :: fn(c: char) -> i32 {  // snippet$plane
      {
          if (c >= '\0') && (c <= '\u{ffff}') {
              0
          } else if (c >= '\u{10000}') && (c <= '\u{1ffff}') {
              1
          } else if (c >= '\u{20000}') && (c <= '\u{10ffff}') {
              2
          } else {
              @unreachable("non-exhaustive match (T3013 should have caught this)")
          } :i32
      } :i32
  }
  snippet.shift_of :: fn(h: null | u8) -> string {  // snippet$shift_of
      {
          if ((h is u8) && (u8(h) >= u8(0))) && (u8(h) <= u8(7)) {
              "night shift"
          } else if ((h is u8) && (u8(h) >= u8(8))) && (u8(h) <= u8(23)) {
              "day shift"
          } else if h == null {
              "off"
          } else {
              @unreachable("non-exhaustive match (T3013 should have caught this)")
          } :string
      } :string
  }
