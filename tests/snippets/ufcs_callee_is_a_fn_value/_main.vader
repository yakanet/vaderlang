// A UFCS call passing a fn VALUE along. The dispatch picks the callee, and the
// pick is kept — re-deriving it from the receiver type answered a different
// question and reached `midir/build`'s "argument N names X, which is not a
// function" panic on a program that is perfectly legal.
module "snippet"

import "std/io"

apply :: fn(s: i32, g: fn(i32) -> i32) -> i32 = g(s)

forwards :: fn(g: fn(i32) -> i32) -> i32 {
    s :: 20
    return s.apply(g)
}

// The same dispatch, with a trailing default the call omits.
labelled :: fn(n: i32, prefix: string = "n=") -> string = "${prefix}${n}"

main :: fn() -> i32 {
    println("forwarded: ${forwards((x: i32) -> x * 2)}")
    println("defaulted: ${7.labelled()}")
    println("explicit:  ${7.labelled("v=")}")
    return 0
}
