// A module constant laid out in the data pool is one value shared by every use, so
// a use that keeps it where a write may reach it reads a fresh value, built by an
// accessor. `start` returns `START` and `primes` returns `PRIMES`, both of a type
// some function of the program writes: each call builds a fresh value.
// `first_prime` only reads its constant and keeps the shared one. A fresh value of
// a constant whose initialiser keeps another one is fresh all the way down:
// `starts` and `alias` build `START` again, through `STARTS` and `ALIAS`.
module "snippet"

import "std/io"

Counter :: struct {
    n: i32
}

START :: Counter { .n = 1 }
PRIMES :: [2, 3, 5]
STARTS :: [START, START]
ALIAS :: START

start :: fn() -> Counter = START

first_prime :: fn() -> i32 = PRIMES[0]

primes :: fn() -> i32[] = PRIMES

starts :: fn() -> Counter[] = STARTS

alias :: fn() -> Counter = ALIAS

bump :: fn(c: Counter) -> void {
    c.n += 1
}

main :: fn() -> i32 {
    c :: Counter { .n = 5 }
    bump(c)
    println(c.n)
    println(start().n)
    println(first_prime())
    println(primes().len())
    println(starts().len())
    println(alias().n)
    return 0
}
