## snippet
  storage
    const ALIAS: Counter  inline
    const PRIMES: i32[]  data pool #1, built again by __const_snippet$PRIMES for a use that reads it fresh
    const START: Counter  data pool #0, element 0, built again by __const_snippet$START for a use that reads it fresh
    const STARTS: Counter[]  inline
  snippet.Counter :: struct { n: i32 }  // snippet$Counter
  __const_snippet$START :: fn() -> Counter {
      Counter { .n = 1 }
  }
  __const_snippet$PRIMES :: fn() -> i32[] {
      [2, 3, 5] :i32[]
  }
  snippet.STARTS: Counter[]: [@fresh(snippet.START), @fresh(snippet.START)] :Counter[]  // snippet$STARTS
  snippet.ALIAS: Counter: @fresh(snippet.START)  // snippet$ALIAS
  snippet.start :: fn() -> Counter {  // snippet$start
      @fresh(snippet.START)
  }
  snippet.first_prime :: fn() -> i32 {  // snippet$first_prime
      snippet.PRIMES[0]
  }
  snippet.primes :: fn() -> i32[] {  // snippet$primes
      @fresh(snippet.PRIMES)
  }
  snippet.starts :: fn() -> Counter[] {  // snippet$starts
      @fresh(snippet.STARTS)
  }
  snippet.alias :: fn() -> Counter {  // snippet$alias
      @fresh(snippet.ALIAS)
  }
  snippet.bump :: fn(c: Counter) -> void {  // snippet$bump
      c.n = c.n + 1
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      c: Counter = Counter { .n = 5 }
      snippet.bump(c)
      std.console.println<i32>(c.n)
      std.console.println<i32>(snippet.start().n)
      std.console.println<i32>(snippet.first_prime())
      std.console.println<i64>(@array.len(snippet.primes()))
      std.console.println<i64>(@array.len(snippet.starts()))
      std.console.println<i32>(snippet.alias().n)
      return 0
  }

