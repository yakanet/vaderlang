// Implicit `T[]` → `Iterator<T>` coercion, through the blanket
// `T[] implements<T> Into<Iterator<T>>` in `std/core`, whose `into` is a
// generator over the array. Without it, each slot below is a T3001.
// - three slot kinds: a call argument, a `let` with an explicit type
//   annotation, and a `return` from a fn typed `Iterator<T>`;
// - an argument of a method call, in both UFCS shapes: a free fn reached as
//   `recv.f(arg)`, and a real impl member. A raw array reaching an
//   `Iterator<T>` param is wrapped there as in the free call `f(recv, arg)`,
//   or it traps at the first `next()` (`vtable miss in Iterator.next`). Both
//   forms agree, argument included, so the free-fn case prints the same number
//   twice.
// `walk` drives `next()` by hand, so the call is dispatched virtually and the
// snapshots pin the step shape as well as the coercion.

module "snippet"

import "std/io"
import "std/iter"

walk :: fn(it: Iterator<i32>) -> i32 {
    sum := 0
    for {
        v :: it.next()
        if v is Stop {
            return sum
        }
        sum += v
    }
}

make_iter :: fn() -> Iterator<i32> {
    arr :: [100, 200, 300]
    return arr   // Array → Iterator return coercion
}

// Free fn: reachable as `sum_both(a, b)` and as `a.sum_both(b)`.
sum_both :: fn(a: Iterator<i32>, b: Iterator<i32>) -> i32 {
    total: i32 = 0
    for x in a {
        total += x
    }
    for y in b {
        total += y
    }
    return total
}

Adder :: trait {
    add_all :: fn(self, xs: Iterator<i32>) -> i32
}

Tally :: struct {
    base: i32
}

Tally implements Adder {
    add_all :: fn(self, xs: Iterator<i32>) -> i32 {
        out := self.base
        for x in xs {
            out += x
        }
        return out
    }
}

main :: fn() -> i32 {
    // Call-arg coercion: [i32] flows into an Iterator<i32> param.
    a :: walk([10, 20, 30])
    // Let coercion, in both spellings of the typed immutable binding.
    typed_iter: Iterator<i32>: [1, 2, 3, 4]
    typed_iter_spaced: Iterator<i32> : [5, 6, 7]
    b :: walk(typed_iter) + walk(typed_iter_spaced)
    // Return coercion: make_iter wraps its inner array on the way out.
    c :: walk(make_iter())
    println("slots: a=${a} b=${b} c=${c}")

    xs :: [1, 2, 3]
    ys :: [10, 20]
    // Free-fn UFCS: the array argument `ys` must wrap just as it does in the
    // free form.
    println("method arg, free fn: free=${sum_both(xs, ys)} ufcs=${xs.sum_both(ys)}")
    // Impl member: there is no free form to compare against (an impl member
    // isn't a top-level name), so the expected total is spelled out:
    // 100 + 1 + 2 + 3.
    t :: Tally { .base = 100 }
    println("method arg, impl member: member=${t.add_all(xs)} want=106")
    return 0
}
