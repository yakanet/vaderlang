          std.core.finish_buffer(__buf_4, __off_5)
      } :string)
      std.console.println<string>({
          __buf_6: Buffer = std_core$Intrinsic$new_byte_buffer(i64(20))
          __off_7: i64 = 0
          __off_7 = std.core.write_int(__buf_6, __off_7, snippet.pick(C { .z = 0 }, C { .z = 9 }))
          std.core.finish_buffer(__buf_6, __off_7)
