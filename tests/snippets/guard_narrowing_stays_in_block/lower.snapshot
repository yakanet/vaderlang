## snippet
  snippet.A :: struct { x: i32 }  // snippet$A
  snippet.B :: struct { y: i32 }  // snippet$B
  snippet.C :: struct { z: i32 }  // snippet$C
  snippet.pick :: fn(a: A | B | C, b: A | B | C) -> i32 {  // snippet$pick
      if a is A {
          if b is A {
              return A(a).x + A(b).x
          }
          if b is B {
              return A(a).x + B(b).y
          }
          if b is C {
              return A(a).x + C(b).z
          }
      }
      if a is B {
          if b is A {
              return B(a).y + A(b).x
          }
          if b is B {
              return B(a).y + B(b).y
          }
      }
      if b is C {
          return C(b).z
      }
      return -1
  }
  snippet.main :: fn() -> i32 {  // snippet$main
