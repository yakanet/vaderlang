# Lower

## snippet
  snippet.Cat :: struct { name: string }  // snippet$Cat
  snippet.Dog :: struct { name: string }  // snippet$Dog
  snippet.greet_wildcard :: fn(p: Cat | Dog | null) -> string {  // snippet$greet_wildcard
      return {
          if p is null { "no pet" } else { concat_2("hello ", (Cat | Dog)(p).name) } :string
      } :string
  }
  snippet.greet_binding :: fn(p: Cat | Dog | null) -> string {  // snippet$greet_binding
      return {
          pet: Cat | Dog | null = p
          if p is null { "no pet" } else { concat_2("howdy ", (Cat | Dog)(pet).name) } :string
      } :string
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      std.console.println<string>(snippet.greet_wildcard(Cat { .name = "Whiskers" }))
      std.console.println<string>(snippet.greet_wildcard(Dog { .name = "Rex" }))
      std.console.println<string>(snippet.greet_wildcard(null))
      std.console.println<string>(snippet.greet_binding(Cat { .name = "Mittens" }))
      std.console.println<string>(snippet.greet_binding(Dog { .name = "Buddy" }))
      std.console.println<string>(snippet.greet_binding(null))
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

