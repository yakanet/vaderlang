// `Decl` declared in `toolchain/ast/ast.vader` is reached through two
// different modules :
//
//   - unqualified, via the bare `import "toolchain/ast"`
//   - through an alias, via `P :: import "toolchain/ast"`
//
// The same path, in its two import FORMS. Each form collects the module's
// symbols independently, so the one source declaration gets two `Symbol` ids.
//
// Each module loads `ast.vader` independently via `collectModuleSymbols`,
// producing fresh `Symbol` ids for the SAME source declaration. Without
// the `equalsType` fallback this snippet reports T3001 with the union
// spelled identically on both sides ; with the fallback the call type-
// checks because both symbols share the same source location.

module "snippet"

import "toolchain/ast"
P :: import "toolchain/ast"

@allow_unused
via_folder :: fn(d: P.Decl) -> i32 {
    return 0
}

@allow_unused
via_file :: fn(d: Decl) -> i32 {
    return via_folder(d)
}
