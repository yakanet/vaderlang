// `Shape`, a union alias declared in the sibling module `snippet/shapes`, is
// reached through the same path in its two import forms:
//
//   - unqualified, via the bare `import "snippet/shapes"`
//   - through an alias, via `P :: import "snippet/shapes"`
//
// Both spellings name the one source declaration, so they are the same type:
// `via_bare` passes its `Shape` to `via_alias`'s `P.Shape` without a T3001
// (typecheck snapshot).

module "snippet"

import "snippet/shapes"
P :: import "snippet/shapes"

@allow_unused
via_alias :: fn(d: P.Shape) -> i32 = 0

@allow_unused
via_bare :: fn(d: Shape) -> i32 = via_alias(d)
