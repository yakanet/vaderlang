module "snippet"

import "std/console"
import "std/env"
import "std/fs"
import "std/io"

// A `File` read, sought, written after a read, then read by lines through a
// four-byte `BufferedReader`: each step prints what the file holds by then, so
// the native run and the interpreter compare byte for byte.
main :: fn() -> i32 {
    path :: "${temp_dir()}/vader_snippet_file_read_write_seek"
    w :: create(path) else {
        println("create failed: ${w.msg}")
        return 1
    }
    w.write("one\r\ntwo\nthree")
    w.close()

    f :: open(path, OpenOptions { .write = true }) else {
        println("open failed: ${f.msg}")
        return 1
    }
    first: u8[]: [0] * 2
    if f.read(first) is i64 {
        println("read: ${first.bytes_to_string()}")
    }
    println("position: ${position(f.seek(0, .Current))}")
    f.write("E")
    println("after the write: ${position(f.seek(0, .Current))}")
    println("end: ${position(f.seek(0, .End))}")
    println("size: ${position(f.size())}")
    f.seek(0, .Start)
    reader :: BufferedReader { .source = f, .capacity = 4 }
    for line in reader.lines() {
        println("line: ${line}")
    }
    println("error: ${outcome(reader.error)}")
    println("at the end: ${reader.read_line() == null}")
    println("close: ${outcome(f.close())}")
    println("close again: ${outcome(f.close())}")
    after :: f.read(first)
    if after is IOError {
        println("read after close: ${after.kind}")
    }

    missing :: open("${temp_dir()}/vader_snippet_file_absent")
    if missing is IOError {
        println("missing: ${missing.kind}")
    }
    directory :: open(temp_dir())
    if directory is IOError {
        println("directory: ${directory.kind}")
    }
    remove(path)
    return 0
}

position :: fn(at: i64 | IOError) -> string {
    if at is IOError {
        return at.msg
    }
    return "${at}"
}

outcome :: fn(failure: IOError | null) -> string {
    if failure is IOError {
        return failure.msg
    }
    return "none"
}
