  snippet.main :: fn() -> i32 {  // snippet$main
      path: string = concat_2(std.env.temp_dir(), "/vader_snippet_file_read_write_seek")
      w: File | IOError = std.fs.create(path)
      if w is IOError {
          std.console.println<string>(concat_2("create failed: ", IOError(w).msg))
          return 1
      }
      std.fs.File.write(File(w), "one\r\ntwo\nthree")
      std.fs.close(File(w))
      f: File | IOError = std.fs.open(path, OpenOptions {
          .read = true,
          .write = true,
          .append = false,
          .create = false,
          .truncate = false,
          .create_new = false,
      })
      if f is IOError {
          std.console.println<string>(concat_2("open failed: ", IOError(f).msg))
          return 1
      }
      first: u8[] = @array.repeat([u8(0)] :u8[], 2)
      if std.fs.File.read(File(f), first) is i64 {
          std.console.println<string>(concat_2("read: ", std.core.bytes_to_string(first)))
      }
      std.console.println<string>(concat_2("position: ", snippet.position(std.fs.seek(File(f), i64(0), SeekFrom(1)))))
      std.fs.File.write(File(f), "E")
      std.console.println<string>(concat_2("after the write: ", snippet.position(std.fs.seek(File(f), i64(0), SeekFrom(1)))))
      std.console.println<string>(concat_2("end: ", snippet.position(std.fs.seek(File(f), i64(0), SeekFrom(2)))))
      std.console.println<string>(concat_2("size: ", snippet.position(std.fs.size(File(f)))))
      std.fs.seek(File(f), i64(0), SeekFrom(0))
      reader: BufferedReader = BufferedReader {
          .source = File(f),
          .capacity = i64(4),
          .error = null,
          .buffer = [] :u8[],
          .next = i64(0),
          .filled = i64(0),
      }
      {
          r: BufferedReader = reader
          max: i64 = 1048576
          $exit$i10: {
              for {
                  line: IOError | string = {
                      __coalesce_0: IOError | null | string = std.io.read_line(r, max)
                      if __coalesce_0 is null {
                          break
                          @unreachable("`??` fallback diverges")
                      } else {
                          (IOError | string)(__coalesce_0)
                      } :IOError | string
                  }
                  if line is IOError {
                      r.error = IOError(line)
                      break $exit$i10
                  }
                  line: string = string(line)
                  std.console.println<string>(concat_2("line: ", line))
              }
          }
      }
      std.console.println<string>(concat_2("error: ", snippet.outcome(reader.error)))
      std.console.println<string>({
          __buf_0: Buffer = std.core.new_byte_buffer(i64(17))
          __off_1: i64 = 0
          __off_1 = std.core.write_string_at(__buf_0, __off_1, "at the end: ")
          __off_1 = std.core.write_bool(__buf_0, __off_1, std.io.read_line(reader, i64(1048576)) is null)
          std.core.finish_buffer(__buf_0, __off_1)
      } :string)
      std.console.println<string>(concat_2("close: ", snippet.outcome(std.fs.close(File(f)))))
      std.console.println<string>(concat_2("close again: ", snippet.outcome(std.fs.close(File(f)))))
      after: i64 | IOError | null = std.fs.File.read(File(f), first)
      if after is IOError {
          std.console.println<string>(concat_2("read after close: ", std.io.IOErrorKind.to_string(IOError(after).kind)))
      }
      missing: File | IOError = std.fs.open(concat_2(std.env.temp_dir(), "/vader_snippet_file_absent"), OpenOptions {
          .read = true,
          .write = false,
          .append = false,
          .create = false,
          .truncate = false,
          .create_new = false,
      })
      if missing is IOError {
          std.console.println<string>(concat_2("missing: ", std.io.IOErrorKind.to_string(IOError(missing).kind)))
      }
      directory: File | IOError = std.fs.open(std.env.temp_dir(), OpenOptions {
          .read = true,
          .write = false,
          .append = false,
          .create = false,
          .truncate = false,
          .create_new = false,
      })
      if directory is IOError {
          std.console.println<string>(concat_2("directory: ", std.io.IOErrorKind.to_string(IOError(directory).kind)))
      }
      std.fs.remove(path, RemoveOptions { .recursive = false, .force = false })
      return 0
  }
  snippet.position :: fn(at: i64 | IOError) -> string {  // snippet$position
      if at is IOError {
          return IOError(at).msg
      }
      return {
          __buf_0: Buffer = std.core.new_byte_buffer(i64(20))
          __off_1: i64 = 0
          __off_1 = std.core.write_int(__buf_0, __off_1, i64(at))
          std.core.finish_buffer(__buf_0, __off_1)
      } :string
  }
  snippet.outcome :: fn(failure: IOError | null) -> string {  // snippet$outcome
      if failure is IOError {
          return IOError(failure).msg
      }
      return "none"
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  concat_3 :: fn(p0: string, p1: string, p2: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      c2: i64 = c1 +% std.core.byte_len(p2)
      buf: Buffer = std.core.new_byte_buffer(c2)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.intern_string(buf, c2)
  }

