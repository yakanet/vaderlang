// fusion_generator_return — a `return` in an inlined generator, or in an inlined
// user stage, ends that generator and not the consuming function: the code after
// the consumer's loop still runs, and a consumer that returns a value returns it.
//
// Each line prints the chain consumed where it is written (fused), then the same
// chain bound to a local first (lazy: it runs as a state machine and is the
// reference). The two halves agree.

module "snippet"

import "std/io"
import "std/iter"

upto_stop :: fn(n: i32) -> Iterator<i32> {
    for i in 0..<10 {
        if i == n {
            return
        }
        yield i
    }
}

void_consumer :: fn() -> void {
    fused := ""
    for v in upto_stop(2) {
        fused = fused + " ${v}"
    }
    lazy := ""
    it :: upto_stop(2)
    for v in it {
        lazy = lazy + " ${v}"
    }
    println("void consumer, then after the loop:${fused} |${lazy}")
}

fused_value :: fn() -> i32 {
    total := 0
    for v in upto_stop(3) {
        total += v
    }
    return total
}

lazy_value :: fn() -> i32 {
    total := 0
    it :: upto_stop(3)
    for v in it {
        total += v
    }
    return total
}

until_negative :: fn(self: Iterator<i32>) -> Iterator<i32> {
    for x in self {
        if x < 0 {
            return
        }
        yield x
    }
}

stage_consumer :: fn() -> void {
    fused := ""
    for v in [1, 2, -1, 3].until_negative() {
        fused = fused + " ${v}"
    }
    lazy := ""
    it :: [1, 2, -1, 3].until_negative()
    for v in it {
        lazy = lazy + " ${v}"
    }
    println("stage consumer, then after the loop:${fused} |${lazy}")
}

// The `return` crosses both loops and skips everything after them.
grid_until :: fn(stop: i32) -> Iterator<i32> {
    for i in 0..<3 {
        for j in 0..<3 {
            v :: i * 10 + j
            if v == stop {
                return
            }
            yield v
        }
        yield 100 + i
    }
    yield 999
}

across_two_loops :: fn() -> void {
    fused := ""
    for v in grid_until(11) {
        fused = fused + " ${v}"
    }
    lazy := ""
    it :: grid_until(11)
    for v in it {
        lazy = lazy + " ${v}"
    }
    println("return across two loops:${fused} |${lazy}")
}

// Run lazily, this generator's state machine holds the block the inlined
// `upto_stop` leaves, with a `yield` inside it.
relay :: fn() -> Iterator<i32> {
    for v in upto_stop(3) {
        yield v * 10
    }
    yield 99
}

relayed :: fn() -> void {
    fused := ""
    for v in relay() {
        fused = fused + " ${v}"
    }
    lazy := ""
    it :: relay()
    for v in it {
        lazy = lazy + " ${v}"
    }
    println("relay of a returning generator:${fused} |${lazy}")
}

// An infinite loop whose `return` comes before its own `break`: the loop has two
// ways out, and the one to its own exit must stay the loop's.
counter :: fn(stop: i32, cap: i32) -> Iterator<i32> {
    i := 0
    for {
        if i == stop {
            return
        }
        if i == cap {
            break
        }
        yield i
        i += 1
    }
    yield 100
}

return_before_break :: fn() -> void {
    for [stop, cap] in [[2, 5], [5, 2]] {
        fused := ""
        for v in counter(stop, cap) {
            fused = fused + " ${v}"
        }
        lazy := ""
        it :: counter(stop, cap)
        for v in it {
            lazy = lazy + " ${v}"
        }
        println("stop ${stop} cap ${cap}:${fused} |${lazy}")
    }
}

// A source loop labelled `exit` around the `return`: the block the `return` leaves
// must keep a name no source label can take.
labelled_exit :: fn() -> Iterator<i32> {
    i := 0
    exit: for {
        if i == 2 {
            return
        }
        if i == 5 {
            break exit
        }
        yield i
        i += 1
    }
    yield 100
}

loop_labelled_exit :: fn() -> void {
    fused := ""
    for v in labelled_exit() {
        fused = fused + " ${v}"
    }
    lazy := ""
    it :: labelled_exit()
    for v in it {
        lazy = lazy + " ${v}"
    }
    println("a loop labelled exit:${fused} |${lazy}")
}

main :: fn() -> i32 {
    void_consumer()
    println("value consumer: ${fused_value()} | ${lazy_value()}")
    stage_consumer()
    across_two_loops()
    relayed()
    return_before_break()
    loop_labelled_exit()
    return 0
}
