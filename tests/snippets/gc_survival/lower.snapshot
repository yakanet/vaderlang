# Lower

## snippet
  snippet.Node :: struct { value: i32, next: Node | null }  // snippet$Node
  snippet.build_chain :: fn(n: i32) -> Node {  // snippet$build_chain
      head: Node = Node { .value = 0, .next = null }
      {
          i: i32 = 1
          for i < n {
              head = Node { .value = i, .next = head }
          } @step {
              i = i +% 1
          }
      }
      return head
  }
  snippet.sum_chain :: fn(head: Node) -> i32 {  // snippet$sum_chain
      sum: i32 = 0
      cur: Node | null = head
      for {
          node: Node = {
              __coalesce_0: Node | null = cur
              if __coalesce_0 is null {
                  break
                  @unreachable("`??` fallback diverges")
              } else {
                  Node(__coalesce_0)
              } :Node
          }
          sum = sum + node.value
          cur = node.next
      }
      return sum
  }
  snippet.chain_survives :: fn() -> i32 {  // snippet$chain_survives
      head: Node = snippet.build_chain(200)
      before: i32 = std.runtime.collections()
      std.runtime.collect()
      after: i32 = std.runtime.collections()
      diff: i32 = after - before
      if diff != 1 {
          std.io.println<string>({
              __buf_0: Buffer = std.core.new_byte_buffer(i64(54))
              __off_1: i64 = 0
              __off_1 = std.core.write_string_at(__buf_0, __off_1, "chain: expected 1 collection, got ")
              __off_1 = std.core.write_int(__buf_0, __off_1, diff)
              std.core.finish_buffer(__buf_0, __off_1)
          } :string)
          return 1
      }
      sum: i32 = snippet.sum_chain(head)
      expected: i32 = (200 * 199) / 2
      if sum != expected {
          std.io.println<string>({
              __buf_2: Buffer = std.core.new_byte_buffer(i64(76))
              __off_3: i64 = 0
              __off_3 = std.core.write_string_at(__buf_2, __off_3, "chain: sum mismatch: got ")
              __off_3 = std.core.write_int(__buf_2, __off_3, sum)
              __off_3 = std.core.write_string_at(__buf_2, __off_3, ", expected ")
              __off_3 = std.core.write_int(__buf_2, __off_3, expected)
              std.core.finish_buffer(__buf_2, __off_3)
          } :string)
          return 2
      }
      std.io.println<string>({
          __buf_4: Buffer = std.core.new_byte_buffer(i64(54))
          __off_5: i64 = 0
          __off_5 = std.core.write_string_at(__buf_4, __off_5, "chain: 200 nodes survived GC; sum=")
          __off_5 = std.core.write_int(__buf_4, __off_5, sum)
          std.core.finish_buffer(__buf_4, __off_5)
      } :string)
      return 0
  }
