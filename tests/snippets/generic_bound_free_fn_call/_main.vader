// A free fn reached from a type parameter : a UFCS call on it (also from inside
// a lambda, also on a receiver that only contains it), and a generic call whose
// own `T` it alone determines. All need the instance's real type, so the
// enclosing fn's instances stay concrete even for a struct `T`.

module "snippet"

import "std/io"
import "std/iter"

P :: struct {
    x: i32
}

P implements Display -> "P(${self.x})"

show :: fn(d: Display) -> string = "<${d.to_string()}>"

apply :: fn(f: fn() -> string) -> string = f()

steps :: fn<T>(it: Iterator<T>!) -> i32 {
    n := 0
    for _ in it {
        n += 1
    }
    return n
}

first_shown :: fn<U: Display>(xs: U[]) -> string = xs[0].show()

shown :: fn<T: Display>(x: T) -> string = x.show()

shown_later :: fn<T: Display>(x: T) -> string = apply(() -> x.show())

shown_first :: fn<T: Display>(xs: T[]) -> string = xs.first_shown()

summed :: fn<I: Iterator<i32>>(it: I!) -> i32 = it.sum()

counted :: fn<I: Iterator<i32>>(it: I!) -> usize = count(it)

stepped :: fn<I: Iterator<i32>>(it: I!) -> i32 = steps(it)

main :: fn() -> i32 {
    println(shown(P { .x = 2 }))
    println(shown_later(P { .x = 3 }))
    println(shown_first([P { .x = 4 }]))
    println(summed(0..<4))
    println(counted(0..<5))
    println(stepped(0..<7))
    return 0
}
