module "snippet/shapes"

/// A shape drawn as text.
export Drawable :: trait {
    /// `times` copies of the shape, ended by `ending`.
    draw :: fn(self, times: i32, ending: string) -> string
    /// The area, scaled by `factor`.
    scaled :: fn(self, factor: i64) -> i64
    /// Where the call to `locate` is written.
    locate :: fn(self, site: SourceLocation | null) -> string
    /// A shape of size `size`.
    make :: fn(size: i32) -> Self
}

/// A square of side `side`.
export Square :: struct {
    side: i32
}

COPIES :: 2

ending_mark :: fn() -> string = "."

// The defaults name what this module declares, privately: a call in another
// module fills them all the same. The types come from the trait.
Square implements Drawable {
    draw :: fn(self, times = COPIES, ending = ending_mark()) -> string =
        "[${self.side}]" * i64(times) + ending
    scaled :: fn(self, factor = 3) -> i64 = i64(self.side * self.side) * factor
    make :: fn(size = COPIES + 1) -> Square = Square { .side = size }
    locate :: fn(self, site = @call_site()) -> string {
        if site == null {
            return "nowhere"
        }
        return "line ${site.line}"
    }
}
