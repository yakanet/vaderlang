// T3070 and T3072: a module constant is frozen, it has no runtime storage a write
// could land in. Two ways in, and both must be caught: a write through the
// constant, and the constant lent to a function that writes what it is lent.

module "snippet"

DIGITS :: [10, 20, 30]

write_through_param :: fn(a: i32[]) -> void {
    a[0] = 99
}

main :: fn() -> i32 {
    DIGITS[0] = 99
    write_through_param(DIGITS)
    return 0
}
