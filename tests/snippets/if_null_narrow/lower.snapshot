# Lower

## snippet
  snippet.Cat :: struct { name: string, age: i32 }  // snippet$Cat
  snippet.Dog :: struct { name: string, age: i32 }  // snippet$Dog
  snippet.greet :: fn(a: Cat | Dog | null) -> string {  // snippet$greet
      if !(a is null) {
          return concat_2("hello ", (Cat | Dog)(a).name)
      }
      return "no animal"
  }
  snippet.greet_v2 :: fn(a: Cat | Dog | null) -> string {  // snippet$greet_v2
      if a is null {
          return "no animal"
      }
      return concat_2("hi ", (Cat | Dog)(a).name)
  }
  snippet.greet_v3 :: fn(a: Cat | Dog | null) -> string {  // snippet$greet_v3
      if !(a is null) {
          return concat_2("yo ", (Cat | Dog)(a).name)
      }
      return "nada"
  }
  snippet.greet_v4 :: fn(a: Cat | Dog | null) -> string {  // snippet$greet_v4
      out: string = ""
      if !(a is null) {
          out2: string = concat_2("ok ", (Cat | Dog)(a).name)
          return out2
      } else {
          return "missing"
      }
  }
  snippet.combine :: fn(a: Cat | Dog | null, b: Cat | Dog | null) -> string {  // snippet$combine
      if a is null {
          return "first missing"
      }
      if b is null {
          return "second missing"
      }
      return concat_3((Cat | Dog)(a).name, " & ", (Cat | Dog)(b).name)
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      cat: Cat | Dog | null = Cat { .name = "Whiskers", .age = 3 }
      dog: Cat | Dog | null = Dog { .name = "Rex", .age = 7 }
      nothing: Cat | Dog | null = null
      std.console.println<string>(snippet.greet(cat))
      std.console.println<string>(snippet.greet(nothing))
      std.console.println<string>(snippet.greet_v2(cat))
      std.console.println<string>(snippet.greet_v2(nothing))
      std.console.println<string>(snippet.greet_v3(cat))
      std.console.println<string>(snippet.greet_v3(nothing))
      std.console.println<string>(snippet.greet_v4(cat))
      std.console.println<string>(snippet.greet_v4(nothing))
      std.console.println<string>(snippet.combine(cat, dog))
      std.console.println<string>(snippet.combine(nothing, dog))
      std.console.println<string>(snippet.combine(cat, nothing))
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  concat_3 :: fn(p0: string, p1: string, p2: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      c2: i64 = c1 +% std.core.byte_len(p2)
      buf: Buffer = std.core.new_byte_buffer(c2)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.intern_string(buf, c2)
  }

## lowered in dependencies
  std/console
    fn std.console.println<string>  // std_console$println__string
    fn std.console.write  // std_console$write
    fn std.console.write_bytes  // std_console$write_bytes
    fn std.console.write_text  // std_console$write_text
  std/core
    fn std.core.Buffer.intern_string  // std_core$Buffer$ByteAccess$intern_string
    fn std.core.Buffer.write_string  // std_core$Buffer$ByteAccess$write_string
    struct std.core.Buffer  // std_core$Buffer
