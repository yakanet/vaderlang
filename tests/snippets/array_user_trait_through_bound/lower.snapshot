          __off_4 = std.core.write_string_at(__buf_3, __off_4, __p_2)
          __off_4 = std.core.write_string_at(__buf_3, __off_4, " then ")
          __off_4 = std.core.write_int(__buf_3, __off_4, @array.len(xs))
          std.core.finish_buffer(__buf_3, __off_4)
      } :string)
      snippet.drop_all<i32>(xs)
      std.io.println<string>({
          __buf_5: Buffer = std.core.new_byte_buffer(i64(35))
          __off_6: i64 = 0
          __off_6 = std.core.write_string_at(__buf_5, __off_6, "after drop_all ")
          __off_6 = std.core.write_int(__buf_5, __off_6, @array.len(xs))
          std.core.finish_buffer(__buf_5, __off_6)
      } :string)
      return 0
  }
