// Indexed reads and writes on arrays of each element kind. `i32`, `i64` and
// `f64` arrays use the typed slot loads and stores, a slice view reads at its
// offset into the array it views, and a `string[]` goes through the generic
// array get and set (bytecode snapshot).

module "snippet"

import "std/io"

main :: fn() -> i32 {
    // i32 get + set
    xs: i32[]: [1, 2, 3]
    xs[1] = xs[0] + xs[2]
    println("xs=${xs[0]},${xs[1]},${xs[2]}")

    // i64 get + set
    ls: i64[]: [10, 20, 30]
    ls[2] = ls[0] + ls[1]
    println("ls2=${ls[2]}")

    // f64 get + set
    fs: f64[]: [1.5, 2.5]
    fs[0] = fs[1] * 2.0
    println("fs0=${fs[0] == 5.0}")

    // a slice view: index 0 reads xs[1]
    view :: xs[1..<3]
    println("view=${view[0]},${view[1]}")

    // string[]: the generic array get and set
    ss: string[]: ["a", "b"]
    ss[0] = ss[1]
    println("ss0=${ss[0]}")

    return 0
}
