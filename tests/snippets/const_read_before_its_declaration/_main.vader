module "snippet"

import "std/io"

// A const is typed at its first read when that comes before its declaration : a
// const reading one declared further down, a fn reading a const that calls a fn,
// a const calling a fn declared after it whose return its body infers.
// A callback a trait types `fn(Self)` is written `fn(Inner)` by an impl.

Inner :: struct {
    n: i32
}

main :: fn() -> i32 {
    println("${INNERS[0].n} ${TOTAL} ${MADE.n} ${MADE_LIST[0].n} ${BUILT[0].n}")
    ONE.visit((x: Inner) -> {
        println("visit ${x.n}")
    })
    return 0
}

INNERS :: [ONE]

TOTAL :: ONE.n + 1

MADE_LIST :: [MADE]

MADE :: make(4)

ONE :: Inner { .n = 7 }

make :: fn(n: i32) -> Inner = Inner { .n = n }

BUILT :: build()

build :: fn() = [Inner { .n = 9 }]

Visit :: trait {
    visit :: fn(self, f: fn(Self) -> void) -> void
}

Inner implements Visit {
    visit :: fn(self, f: fn(Inner) -> void) -> void {
        f(self)
    }
}
