// A slice shares its parent's buffer, and a lend to C must not split them.
//
// Once a Vader function has escaped into C, lending an array moves its buffer
// out of the moving generation, outside any collection, and rewrites only the
// header it was handed. Emitted array accesses do not re-check where a buffer
// lives, so a second header left behind would keep reading the abandoned copy.
//
// A shared buffer is therefore never moved by a lend, and must be still before
// one: otherwise the collection `churn` runs in the middle of the lend moves the
// buffer C is writing into. `early` is sliced before any function escapes, and
// the first escape secures it; `view` is sliced after, and slicing secures it.

module "snippet"

import "std/io"
import "std/runtime"

churn :: fn(x: i32) -> void {
    collect()
}

@extern slice_set_cb :: fn(cb: fn(i32) -> void) -> void
@extern slice_fill :: fn(q: i32[]!, n: usize) -> void

main :: fn() -> i32 {
    ys: i32[]!: [5, 3, 9, 1, 7, 2, 8, 4]
    early :: ys[2..<6]
    slice_set_cb(churn)
    slice_fill(ys, 8)
    println("early=${early[0]} ${early[1]} ${early[2]} ${early[3]}")

    xs: i32[]!: [5, 3, 9, 1, 7, 2, 8, 4]
    view :: xs[2..<6]
    slice_fill(xs, 8)
    println("view=${view[0]} ${view[1]} ${view[2]} ${view[3]}")
    return 0
}
