  snippet.classify :: fn(x: i32 | string) -> i32 {  // snippet$classify
      return {
          if x is i32 {
              1
          } else if x is string {
              2
          } else {
              @unreachable("non-exhaustive match (T3013 should have caught this)")
          } :i32
      } :i32
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      n: i32 = 42
      return snippet.classify(n)
  }

