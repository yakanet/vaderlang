// tests/snippets/field_narrowing: a test on a field path narrows that path.
//
// The narrowing is keyed on the whole chain from its root symbol, so
// `o.inner.flag` narrows apart from `o.inner`. Each form reads the narrowed
// field where its declared `T | null` would not type-check (T3001): an argument
// to a fn taking `i32[]`, a field access, `+ 1`.
//
// Forms, one labelled line each: `!= null` with an else branch; `== null` and
// `is null` as a divergent guard, the narrowing holding for the rest of the body
// and a local bound from the field taking the narrowed type; `!(x.f is null)`,
// narrowing the then-block rather than guarding; `x.f is T`; a `match` on the
// field, the wildcard arm seeing the non-null type; a two-level path in a
// `match` and in a guard.

module "snippet"

import "std/io"

Bag :: struct {
    items: i32[] | null
}

Block :: struct {
    span: i32
}

Decl :: struct {
    body: Block | null
    name: string
}

Inner :: struct {
    flag: i32 | null
}

Outer :: struct {
    inner: Inner
}

count :: fn(items: i32[]) -> i32 = i32(items.len())

report :: fn(b: Bag) -> void {
    if b.items != null {
        println("not null: count=${count(b.items)}")
    } else {
        println("not null: empty")
    }
}

total :: fn(b: Bag) -> i32 {
    if b.items == null {
        return -1
    }
    return count(b.items)
}

convert :: fn(d: Decl) -> i32 {
    if d.body is null {
        return -1
    }
    body :: d.body
    return body.span
}

span_if_block :: fn(d: Decl) -> i32 {
    if d.body is Block {
        return d.body.span
    }
    return -1
}

span_if_present :: fn(d: Decl) -> i32 {
    if !(d.body is null) {
        return d.body.span
    }
    return -1
}

count_match :: fn(o: Outer) -> i32 = match o.inner.flag {
    is null -> 0
    _       -> o.inner.flag + 1
}

unwrap :: fn(o: Outer) -> i32 {
    if o.inner.flag == null {
        return -1
    }
    return o.inner.flag
}

main :: fn() -> i32 {
    full :: Bag { .items = [1, 2, 3] }
    empty :: Bag { .items = null }
    report(full)
    report(empty)
    println("guard == null: ${total(full)} ${total(empty)}")
    match full.items {
        is null -> { println("match: empty") }
        _       -> { println("match: count=${count(full.items)}") }
    }
    match empty.items {
        is null -> { println("match: empty") }
        _       -> { println("match: count=${count(empty.items)}") }
    }

    some :: Decl { .body = Block { .span = 42 }, .name = "some" }
    none :: Decl { .body = null, .name = "none" }
    println("guard is null: ${convert(some)} ${convert(none)}")
    println("is T: ${span_if_block(some)} ${span_if_block(none)}")
    println("not is null: ${span_if_present(some)} ${span_if_present(none)}")

    set :: Outer { .inner = Inner { .flag = 42 } }
    unset :: Outer { .inner = Inner { .flag = null } }
    println("nested match: ${count_match(set)} ${count_match(unset)}")
    println("nested guard: ${unwrap(set)} ${unwrap(unset)}")
    return 0
}
