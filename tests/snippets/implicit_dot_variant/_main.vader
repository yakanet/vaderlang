module "snippet"

import "std/io"

// `.Variant` shorthand resolves against the type the context expects, with no
// type prefix written: a typed enum local, the elements of a `Day[]` literal,
// the arms of a `match` on an enum, and `is .Some` / `is .None` arms, which
// name a member of the union being matched.

Day :: enum { Monday, Tuesday, Wednesday }

Some :: struct { value: i32 }
None :: struct {}
Maybe :: Some | None

show_day :: fn(d: Day) -> string {
    return match d {
        .Monday    -> "Mon"
        .Tuesday   -> "Tue"
        .Wednesday -> "Wed"
    }
}

main :: fn() -> i32 {
    // Direct assignment to enum-typed variable.
    a: Day: .Monday
    println(show_day(a))

    // Array literal of `Day`: every element uses the leading-dot form.
    days: Day[]: [.Monday, .Wednesday]
    for d in days { println(show_day(d)) }

    // Tagged union : `is .Some` / `is .None` resolves against `Maybe`.
    m: Maybe: Some { .value = 42 }
    match m {
        is .Some -> println("got=${m.value}")
        is .None -> println("nothing")
    }
    n: Maybe: None {}
    match n {
        is .Some -> println("got=${n.value}")
        is .None -> println("nothing")
    }
    return 0
}
