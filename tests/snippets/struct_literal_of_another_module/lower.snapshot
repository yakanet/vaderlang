## snippet
  snippet.main :: fn() -> i32 {  // snippet$main
      built: Config = Config {
          .level = snippet.util.make().level,
          .label = snippet.base.string.into("hi"),
          .count = i64(3),
      }
      std.io.println<string>(snippet.util.describe(built))
      copied: Config = {
          __spread_0: Config = snippet.util.make()
          Config {
              .level = __spread_0.level,
              .label = __spread_0.label,
              .count = i64(2),
          }
      }
      std.io.println<string>(snippet.util.describe(copied))
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  concat_3 :: fn(p0: string, p1: string, p2: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      c2: i64 = c1 +% std.core.byte_len(p2)
      buf: Buffer = std.core.new_byte_buffer(c2)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.intern_string(buf, c2)
  }

## snippet/base
  snippet.base.string.into :: fn(self: string) -> Label {  // snippet_base$string$std_core_Into$into
      Label { .text = concat_3("<", self, ">") }
  }
  snippet.base.Label :: struct { text: string }  // snippet_base$Label
  vtable std.core.Into.into for string  snippet.base.string.into  // snippet_base$string$std_core_Into$into

## snippet/util
  snippet.util.make :: fn() -> Config {  // snippet_util$make
      Config {
          .level = u8(2),
          .label = Label { .text = "made" },
          .count = i64(1),
      }
  }
  snippet.util.describe :: fn(c: Config) -> string {  // snippet_util$describe
      name: string = {
          __scrut_0: Level = c.level
          if __scrut_0 == u8(0) {
              "low"
          } else if __scrut_0 == u8(1) {
              "mid"
          } else if __scrut_0 == u8(2) {
              "high"
          } else {
              @unreachable("non-exhaustive match (T3013 should have caught this)")
          } :string
      }
      return {
          __p_1: string = name
          __p_2: string = c.label.text
          __buf_3: Buffer = std.core.new_byte_buffer(i64(22) +% (std.core.byte_len(__p_1) +% std.core.byte_len(__p_2)))
          __off_4: i64 = 0
          __off_4 = std.core.write_string_at(__buf_3, __off_4, __p_1)
          __off_4 = std.core.write_string_at(__buf_3, __off_4, " ")
          __off_4 = std.core.write_string_at(__buf_3, __off_4, __p_2)
          __off_4 = std.core.write_string_at(__buf_3, __off_4, " ")
          __off_4 = std.core.write_int(__buf_3, __off_4, c.count)
          std.core.finish_buffer(__buf_3, __off_4)
      } :string
  }
  snippet.util.Config :: struct { level: Level, label: Label, count: i64 }  // snippet_util$Config

