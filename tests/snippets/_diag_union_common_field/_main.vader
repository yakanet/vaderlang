module "snippet"

import "std/io"

// `u.field` on a union of structs reads the field WITHOUT narrowing, and lowers
// to one cast to the first variant plus a field read. That is only sound while
// every variant places the field at the same offset: the same position, and the
// same type for it and for every field before it.
//
// Each disagreement is a compile error naming the first difference: the
// position (`label_of`), the field's own type (`age_of`), or the type of a field
// before it (`wide_name_of`). The agreeing case still works.

Aligned :: struct { name: string, tag: i32 }
AlsoAligned :: struct { name: string, extra: bool }

// Fine — `name` is field 0 in both.
name_of :: fn(n: Aligned | AlsoAligned) -> string = n.name

Front :: struct { tag: i32, label: string }
Back :: struct { label: string, tag: i32 }

// Rejected — `label` is field 1 in `Front` and field 0 in `Back`.
label_of :: fn(n: Front | Back) -> string = n.label

Kitten :: struct { name: string, age: i32 }
Puppy :: struct { name: string, age: i64 }

// Rejected: `age` is an `i32` in `Kitten` and an `i64` in `Puppy`.
age_of :: fn(a: Kitten | Puppy) -> i64 = a.age

Narrow :: struct { tag: u8, name: string }
Wide :: struct { tag: i64, name: string }

// Rejected: `name` is field 1 in both, but field 0 differs, so its offset does.
wide_name_of :: fn(n: Narrow | Wide) -> string = n.name

main :: fn() -> i32 {
    println(name_of(Aligned { .name = "aligned-a", .tag = 1 }))
    println(name_of(AlsoAligned { .name = "aligned-b", .extra = true }))
    println(label_of(Front { .tag = 1, .label = "front" }))
    println("${age_of(Kitten { .name = "kitten", .age = 1 })}")
    println(wide_name_of(Narrow { .tag = 1, .name = "narrow" }))
    return 0
}
