## snippet
  snippet.is_vowel :: fn(c: char) -> bool {  // snippet$is_vowel
      (((c == 'a') || (c == 'e')) || (c == '\u{e9}')) || (c == 'o')
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      vowels: i32 = 0
      {
          self: string = "héllo, vader"
          i: usize = 0
          for i < std.core.byte_len(self) {
              b: u8 = std.core.byte_at(self, i)
              if b < u8(128) {
                  i = i + usize(1)
                  c: char = char(b)
                  if snippet.is_vowel(c) {
                      vowels = vowels + 1
                  }
              } else {
                  __tup_0: [char, usize] = std.core.decode_tail(self, b, i)
                  c: char = __tup_0._0
                  width: usize = __tup_0._1
                  i = i + width
                  c: char = c
                  if snippet.is_vowel(c) {
                      vowels = vowels + 1
                  }
              }
          }
      }
      std.io.println<i32>(vowels)
      return 0
  }

