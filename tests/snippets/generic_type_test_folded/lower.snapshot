  snippet.side_if_positive<Square> :: fn(x: Any, n: i32) -> i32 {  // snippet$side_if_positive__snippet_Square
      if (n > 0) && (x is Square) {
          return Square(x).side
      }
      return -1
  }
  snippet.side_unless_negative<i32> :: fn(x: i32, n: i32) -> i32 {  // snippet$side_unless_negative__i32
      {
          (n < 0) || true
