# Lower

## snippet
  snippet.Cat :: struct { name: string }  // snippet$Cat
  snippet.Dog :: struct { name: string, tricks: i32 }  // snippet$Dog
  snippet.Fish :: struct { tank: string }  // snippet$Fish
  snippet.furry_name :: fn(pet: Cat | Dog | Fish) -> string {  // snippet$furry_name
      if !((pet is Cat) || (pet is Dog)) {
          return "-"
      }
      return (Cat | Dog)(pet).name
  }
  snippet.tricks_of :: fn(pet: Cat | Dog | Fish) -> i32 {  // snippet$tricks_of
      if pet is Cat {
          return 0
      }
      if pet is Cat | Dog {
          return Dog(pet).tricks
      }
      return -1
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      cat: Cat = Cat { .name = "Tom" }
      dog: Dog = Dog { .name = "Rex", .tricks = 3 }
      fish: Fish = Fish { .tank = "blue" }
      std.console.println<string>(concat_5(snippet.furry_name(cat), " ", snippet.furry_name(dog), " ", snippet.furry_name(fish)))
      std.console.println<string>({
          __buf_0: Buffer = std.core.new_byte_buffer(i64(62))
          __off_1: i64 = 0
          __off_1 = std.core.write_int(__buf_0, __off_1, snippet.tricks_of(cat))
          __off_1 = std.core.write_string_at(__buf_0, __off_1, " ")
          __off_1 = std.core.write_int(__buf_0, __off_1, snippet.tricks_of(dog))
          __off_1 = std.core.write_string_at(__buf_0, __off_1, " ")
          __off_1 = std.core.write_int(__buf_0, __off_1, snippet.tricks_of(fish))
          std.core.finish_buffer(__buf_0, __off_1)
      } :string)
      return 0
  }
  concat_5 :: fn(p0: string, p1: string, p2: string, p3: string, p4: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      c2: i64 = c1 +% std.core.byte_len(p2)
      c3: i64 = c2 +% std.core.byte_len(p3)
      c4: i64 = c3 +% std.core.byte_len(p4)
      buf: Buffer = std.core.new_byte_buffer(c4)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.write_string(buf, c2, p3)
      std.core.Buffer.write_string(buf, c3, p4)
      std.core.Buffer.intern_string(buf, c4)
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

