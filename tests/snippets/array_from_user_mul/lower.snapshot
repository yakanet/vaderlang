      reserved: i32[] = @array.repeat([] :i32[], 4)
      std.io.println<string>({
          __buf_0: Buffer = std.core.new_byte_buffer(i64(20))
          __off_1: i64 = 0
          __off_1 = std.core.write_int(__buf_0, __off_1, @array.len(reserved))
          std.core.finish_buffer(__buf_0, __off_1)
      } :string)
      std.io.println<string>(std.core.string[].to_string(snippet.repeat_twice<string>(["a"] :string[])))
      return 0
  }
  snippet.repeat_twice<string> :: fn(xs: string[]) -> string[] {  // snippet$repeat_twice__string
      @array.repeat(xs, 2)
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
