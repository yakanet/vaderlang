  snippet.lib.pick :: fn(m: Map<i32, i32 | Wrap>, k: i32) -> null | Out {  // snippet_lib$pick
      v: i32 | null | Wrap = std.collections.Map<i32, Any>.at(m, k)
      if v is null {
          return null
      }
      if !(v is Wrap) {
          return null
      }
      return Out { .first = Wrap(v).items[0] }
