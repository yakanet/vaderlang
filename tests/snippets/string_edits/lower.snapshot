  snippet.main :: fn() -> i32 {  // snippet$main
      std.io.println<string>(std.string.replace("hello world", "o", "0"))
      std.io.println<string>(std.string.replace_all("a.b.c", ".", "-"))
      std.io.println<string>(std.string.replace("no-match", "z", "Z"))
      std.io.println<string>(std.string.repeat("ab", usize(3)))
      std.io.println<string>(std.string.repeat("x", usize(0)))
      std.io.println<string>({
          __buf_0: Buffer = std.core.new_byte_buffer(usize(5))
          __off_1: usize = 0
          __off_1 = std.core.write_bool(__buf_0, __off_1, std.string.contains_char("hello", 'e'))
          std.core.finish_buffer(__buf_0, __off_1)
      } :string)
      std.io.println<string>({
          __buf_2: Buffer = std.core.new_byte_buffer(usize(5))
          __off_3: usize = 0
          __off_3 = std.core.write_bool(__buf_2, __off_3, std.string.contains_char("hello", 'z'))
          std.core.finish_buffer(__buf_2, __off_3)
      } :string)
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.usize.new_buffer(c1)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  concat_3 :: fn(p0: string, p1: string, p2: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      c2: usize = c1 +% std.core.byte_len(p2)
      buf: Buffer = std.core.usize.new_buffer(c2)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.intern_string(buf, c2)
  }

