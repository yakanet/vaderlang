          __off_4: i64 = 0
          __off_4 = std.core.write_int(__buf_3, __off_4, __p_0)
          __off_4 = std.core.write_string_at(__buf_3, __off_4, " ")
          __off_4 = std.core.write_int(__buf_3, __off_4, __p_1)
          __off_4 = std.core.write_string_at(__buf_3, __off_4, " ")
          __off_4 = std.core.write_string_at(__buf_3, __off_4, __p_2)
          std.core.finish_buffer(__buf_3, __off_4)
      } :string)
      std.console.println<string>(concat_5(std.core.f64.to_string(snippet$Vec$std_core$Add$add(v, 2.0).x), " ", std.core.f64.to_string(snippet$Vec$std_core$Add$add$1(v, v).x), " ", snippet.Vec.hello(v)))
