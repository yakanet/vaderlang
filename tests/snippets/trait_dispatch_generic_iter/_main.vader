// Virtual trait-method dispatch over generic-struct receivers. Two generic
// iterators, `Repeat<T>` and `Once<T>`, implement `Iterator<T>`; `walk` takes
// an `Iterator<i32>` parameter and calls `.next()` on it directly. Each
// instance observed (`Repeat<i32>`, `Once<i32>`) gets its own vtable entry,
// with `next` typed by the impl's substituted `T`.

module "snippet"

import "std/io"

export Repeat :: struct<T> {
    value: T
    remaining: i32
}

Repeat<T> implements Iterator<T> {
    next :: fn(self) -> [T, Continuation] {
        if self.remaining <= 0 {
            return [self.value, .Stop]
        }
        v :: self.value
        self.remaining = self.remaining - 1
        return [v, .Continue]
    }
}

export Once :: struct<T> {
    value: T
    yielded: bool
}

Once<T> implements Iterator<T> {
    next :: fn(self) -> [T, Continuation] {
        if self.yielded {
            return [self.value, .Stop]
        }
        self.yielded = true
        return [self.value, .Continue]
    }
}

walk :: fn(it: Iterator<i32>) -> i32 {
    sum := 0
    cont := true
    for cont {
        [v, c] :: it.next()
        if c == .Stop {
            cont = false
        } else {
            sum = sum + v
        }
    }
    return sum
}

main :: fn() -> i32 {
    r :: Repeat<i32> { .value = 7, .remaining = 3 }
    o :: Once<i32>   { .value = 100, .yielded = false }
    println("repeat=${walk(r)}")
    println("once=${walk(o)}")
    return 0
}
