// Angle-bracket generics, the only accepted form for type parameters: heads
// `fn<T>` / `fn<A, B>` / `struct<T>` / `struct<A, B>`, type arguments in type
// position, and generic calls with inferred or explicit arguments, bare and
// through UFCS. A nested `Box<Box<T>>` exercises the lexer's on-demand split of
// `>>` into `> >`, and a `<` comparison in an argument list must not start a
// generic parse.
module "snippet"

import "std/io"

// fn declaration (angle form)
export identity :: fn<T>(x: T) -> T {
    return x
}

// Several type parameters, expression body.
pick_second :: fn<A, B>(a: A, b: B) -> B = b

// A type parameter inside an array parameter.
export first :: fn<T>(arr: T[], fallback: T) -> T {
    if arr.len() > 0 {
        return arr[0]
    }
    return fallback
}

// struct declaration (angle form)
export Box :: struct<T> {
    value: T
}

Pair :: struct<A, B> {
    first: A
    second: B
}

make_nested :: fn<T>(v: T) -> Box<Box<T>> {
    inner :: Box<T> { .value = v }
    return Box<Box<T>> { .value = inner }
}

make_box :: fn<T>(v: T) -> Box<T> {
    return Box<T> { .value = v }
}

demo_comparison_in_args :: fn() -> bool {
    v :: 10
    return assert_cmp(v < 20, "ok")
}

assert_cmp :: fn(cond: bool, msg: string) -> bool {
    return cond
}

main :: fn() -> i32 {
    a :: identity(10)
    println("inferred, bare = ${a}")

    n :: 42.identity()
    println("inferred, ufcs = ${n}")

    // Explicit-args generic call.
    e :: identity<i32>(42)
    println("explicit = ${e}")

    s :: pick_second(1, 2)
    println("two params = ${s}")

    arr :: [10, 20, 30]
    v :: arr.first(0)
    println("array param = ${v}")

    p :: Pair<i32, i32> { .first = 30, .second = 0 }
    println("pair = ${p.first} ${p.second}")

    b :: 7.make_box()
    println("box = ${b.value}")

    nested :: 99.make_nested()
    println("nested = ${nested.value.value}")

    c :: demo_comparison_in_args()
    println("comparison in args = ${c}")

    return 0
}
