// tests/snippets/const_fn_wrap — module-level struct-array const referenced in
// a loop, exercising the `inline_consts` fn-wrap accessor path. An array of
// ≥4 struct literals lowers to a synthetic `__const_<name>` accessor fn ; every
// reference becomes a `call` to it. Guards the Vader-emitter side of that path
// (the suite never exercises the Vader emitter outside VADER_SELF_EMIT).
//
// The `: Spec[]:` annotation is LOAD-BEARING — do not "clean it up". It opts out
// of the auto-`const` pin `orchestrate::auto_const_module_array` applies to every
// UNANNOTATED module-level array const. Without it `SPECS` is a read-only `Spec[]`, and
// `inline_consts::try_data_pool` (which refuses mutable arrays) bakes it into the
// data pool instead — a path `_diag_comptime_struct` already covers, leaving
// fn-wrap with no regression guard.

module "snippet"

import "std/io"

Spec :: struct {
    name: string
    code: i32
}

SPECS: Spec[]: [
    Spec { .name = "alpha", .code = 10 },
    Spec { .name = "beta",  .code = 20 },
    Spec { .name = "gamma", .code = 30 },
    Spec { .name = "delta", .code = 40 },
]

lookup :: fn(name: string) -> i32 {
    for s in SPECS {
        if s.name == name { return s.code }
    }
    return -1
}

main :: fn() -> i32 {
    println("gamma=${lookup("gamma")}")
    println("missing=${lookup("zeta")}")
    return 0
}
