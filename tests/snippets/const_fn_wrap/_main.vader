// tests/snippets/const_fn_wrap — module-level struct-array const referenced in
// a loop, exercising the `inline_consts` fn-wrap accessor path. An array of
// ≥4 struct literals lowers to a synthetic `__const_<name>` accessor fn ; every
// reference becomes a `call` to it. Guards the Vader-emitter side of that path
// (the suite never exercises the Vader emitter outside VADER_SELF_EMIT).
//
// The GENERIC struct element is LOAD-BEARING — do not "clean it up" to a plain
// `Spec`. Every module const is read-only (`auto_const_module_array` for the
// unannotated ones, the read-only default for the annotated ones), so the pool
// would otherwise bake this array and leave fn-wrap with no regression guard.
// `inline_consts::is_bakeable_struct` refuses a struct carrying type args
// (`st.args.len() > 0`), which is what keeps this const on the fn-wrap path.
//
// A `!` used to serve the same purpose here, but a marker on a module const is
// now T3076 unless it is an array of VALUE elements — a struct element would put
// a heap pointer in a static buffer the GC never traces.

module "snippet"

import "std/io"

// Generic on purpose : a type-arg-carrying struct is not bakeable, so the array
// takes the fn-wrap accessor instead of a data-pool entry.
Spec :: struct<T> {
    name: string
    code: T
}

SPECS: Spec<i32>[]: [
    Spec<i32> { .name = "alpha", .code = 10 },
    Spec<i32> { .name = "beta",  .code = 20 },
    Spec<i32> { .name = "gamma", .code = 30 },
    Spec<i32> { .name = "delta", .code = 40 },
]

lookup :: fn(name: string) -> i32 {
    for s in SPECS {
        if s.name == name { return s.code }
    }
    return -1
}

main :: fn() -> i32 {
    println("gamma=${lookup("gamma")}")
    println("missing=${lookup("zeta")}")
    return 0
}
