// tests/snippets/const_fn_wrap: a module-level struct-array const read in a
// loop, through the `inline_consts` fn-wrap route. An array of four or more
// literals that the data pool cannot bake is replaced by a synthetic accessor fn
// `__const_<name>`, and every reference becomes a `call` to it.
//
// The GENERIC struct element is LOAD-BEARING: `is_bakeable_struct` refuses a
// struct carrying type args, which keeps the const out of the data pool. A
// plain `Spec[]` would be pooled, and nothing would exercise fn-wrap.

module "snippet"

import "std/io"

Spec :: struct<T> {
    name: string
    code: T
}

SPECS: Spec<i32>[]: [
    Spec<i32> { .name = "alpha", .code = 10 },
    Spec<i32> { .name = "beta",  .code = 20 },
    Spec<i32> { .name = "gamma", .code = 30 },
    Spec<i32> { .name = "delta", .code = 40 },
]

lookup :: fn(name: string) -> i32 {
    for s in SPECS {
        if s.name == name { return s.code }
    }
    return -1
}

main :: fn() -> i32 {
    println("gamma=${lookup("gamma")}")
    println("missing=${lookup("zeta")}")
    return 0
}
