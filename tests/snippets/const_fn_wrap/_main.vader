// tests/snippets/const_fn_wrap — module-level struct-array const referenced in
// a loop, exercising the `inline_consts` fn-wrap accessor path. An array of
// ≥4 struct literals lowers to a synthetic `__const_<name>` accessor fn ; every
// reference becomes a `call` to it. Guards the Vader-emitter side of that path
// (the suite never exercises the Vader emitter outside VADER_SELF_EMIT).
//
// The `!` on `: Spec[]!:` is LOAD-BEARING — do not "clean it up". Every module
// const is read-only, annotated or not (`auto_const_module_array` for the
// unannotated ones, the read-only default for the annotated ones), and
// `inline_consts::try_data_pool` refuses only MUTABLE arrays. So without the `!`
// SPECS is baked into the data pool instead — a path `_diag_comptime_struct`
// already covers, leaving fn-wrap with no regression guard.
//
// The marker does NOT grant mutation here: a module const has no storage, so a
// write through it is still T3070 whatever its type says. On a module const `!`
// means exactly "keep it out of `.rodata`".

module "snippet"

import "std/io"

Spec :: struct {
    name: string
    code: i32
}

SPECS: Spec[]!: [
    Spec { .name = "alpha", .code = 10 },
    Spec { .name = "beta",  .code = 20 },
    Spec { .name = "gamma", .code = 30 },
    Spec { .name = "delta", .code = 40 },
]

lookup :: fn(name: string) -> i32 {
    for s in SPECS {
        if s.name == name { return s.code }
    }
    return -1
}

main :: fn() -> i32 {
    println("gamma=${lookup("gamma")}")
    println("missing=${lookup("zeta")}")
    return 0
}
