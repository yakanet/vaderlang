// A `Node | null` crosses calls both ways: `find` takes one and returns one,
// `cons` returns one, and `length` recurses on one. At the C ABI each is a
// `vader_box_t`. The lookups below check that the null and the non-null
// variants both come back intact.

module "snippet"

import "std/io"

Node :: struct {
    value: i32
    next:  Node | null
}

cons :: fn(head: i32, tail: Node | null) -> Node | null {
    return Node { .value = head, .next = tail }
}

find :: fn(n: Node | null, needle: i32) -> Node | null {
    match n {
        is null -> null
        is Node -> if n.value == needle { n } else { find(n.next, needle) }
    }
}

length :: fn(n: Node | null) -> i32 {
    match n {
        is null -> 0
        is Node -> 1 + length(n.next)
    }
}

main :: fn() -> i32 {
    head :: cons(1, cons(2, cons(3, null)))
    println("length=${length(head)}")
    match h :: find(head, 2) {
        is null -> { println("not found") }
        is Node -> { println("found ${h.value}") }
    }
    match h :: find(head, 42) {
        is null -> { println("not found") }
        is Node -> { println("found ${h.value}") }
    }
    return 0
}
