// _diag_fusion_return — a `return` in an inlined generator, or in an inlined
// user stage, must end that generator, not the consuming function.
//
// THE COMMITTED OUTPUT IS WRONG. The lazy consumers print their line after the
// loop; the fused ones never reach it, because the inlined `return` leaves the
// consuming function itself.

module "snippet"

import "std/io"

upto_stop :: fn(n: i32) -> Iterator<i32> {
    for i in 0..<10 {
        if i == n {
            return
        }
        yield i
    }
}

lazy_void :: fn() -> void {
    seen := ""
    it :: upto_stop(2)
    for v in it {
        seen = seen + " ${v}"
    }
    println("lazy void consumer:${seen}, then after the loop")
}

fused_void :: fn() -> void {
    seen := ""
    for v in upto_stop(2) {
        seen = seen + " ${v}"
    }
    println("fused void consumer:${seen}, then after the loop")
}

until_negative :: fn(self: Iterator<i32>) -> Iterator<i32> {
    for x in self {
        if x < 0 {
            return
        }
        yield x
    }
}

lazy_stage :: fn() -> void {
    seen := ""
    it :: [1, 2, -1, 3].until_negative()
    for v in it {
        seen = seen + " ${v}"
    }
    println("lazy stage consumer:${seen}, then after the loop")
}

fused_stage :: fn() -> void {
    seen := ""
    for v in [1, 2, -1, 3].until_negative() {
        seen = seen + " ${v}"
    }
    println("fused stage consumer:${seen}, then after the loop")
}

main :: fn() -> i32 {
    lazy_void()
    fused_void()
    lazy_stage()
    fused_stage()
    return 0
}
