# Lower

## snippet
  snippet.Sq :: struct { s: f64 }  // snippet$Sq
  snippet.Circle :: struct { r: f64 }  // snippet$Circle
  snippet.Sq.area :: fn(self: Sq) -> f64 {  // snippet$Sq$Shape$area
      self.s * self.s
  }
  snippet.Circle.area :: fn(self: Circle) -> f64 {  // snippet$Circle$Shape$area
      (3.0 * self.r) * self.r
  }
  snippet.area :: fn(u: Circle | Sq) -> f64 {  // snippet$area
      99.0
  }
  snippet.go :: fn(u: Circle | Sq) -> f64 {  // snippet$go
      snippet.area(u)
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      std.io.println<string>(concat_5(std.core.f64.to_string(snippet.go(Sq { .s = 2.0 })), " ", std.core.f64.to_string(snippet.go(Circle { .r = 1.0 })), " ", std.core.f64.to_string(snippet.area(Circle { .r = 1.0 }))))
      std.io.println<string>(std.core.f64.to_string(snippet.Sq.area(Sq { .s = 2.0 })))
      return 0
  }
  concat_5 :: fn(p0: string, p1: string, p2: string, p3: string, p4: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      c2: i64 = c1 +% std.core.byte_len(p2)
      c3: i64 = c2 +% std.core.byte_len(p3)
      c4: i64 = c3 +% std.core.byte_len(p4)
      buf: Buffer = std.core.new_byte_buffer(c4)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.write_string(buf, c2, p3)
      std.core.Buffer.write_string(buf, c3, p4)
      std.core.Buffer.intern_string(buf, c4)
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  vtable snippet.Shape.area for Circle  snippet.Circle.area  // snippet$Circle$Shape$area
  vtable snippet.Shape.area for Sq  snippet.Sq.area  // snippet$Sq$Shape$area

