      std_core$Intrinsic$buffer_write_string(buf, c2, p3)
      std_core$Intrinsic$buffer_write_string(buf, c3, p4)
      std_core$Intrinsic$buffer_intern_string(buf, c4)
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
