// Diag snippet: a `for` over an `if` whose branches are an array field and an
// array literal. The committed output is the CURRENT one, pending a decision.
//
// It used to panic the compiler (GATE B1): the literal `[one]` read as a
// one-element tuple, and the `for` over `(A | B)[] | [A | B]` reached midir as a
// call to an unmaterialised `next`. Both halves are fixed — the literal is now a
// `(A | B)[]`, and a `for` over a non-iterable is T3088.
//
// What remains is T3074: the field is read-only and the fresh literal is `!`, so
// the `if` is `(A | B)[] | (A | B)[]!`. Whether the literal should instead take
// the other branch's type — and this compile, printing `2` then `1` — is an open
// language decision (TODO, "A literal in an `if` branch …").

module "snippet"

import "std/io"

A :: struct { n: i32 }
B :: struct { m: i32 }
Shape :: A | B
Group :: struct { items: Shape[] }

count :: fn(g: Group, one: Shape, many: bool) -> i32 {
    total := 0
    for s in if many { g.items } else { [one] } {
        total += 1
    }
    return total
}

main :: fn() -> i32 {
    g :: Group { .items = [A { .n = 1 }, B { .m = 2 }] }
    println("${count(g, A { .n = 0 }, true)}")
    println("${count(g, B { .m = 0 }, false)}")
    return 0
}
