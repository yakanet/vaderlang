// tests/snippets/union_reference_compare: `===` on a union of references compares
// the objects it holds, on both backends.
//
// A baked module const is one shared object, so a value read from it is `===`
// another read of it, while a structurally identical value built elsewhere is
// not. `null` is `===` `null`. `vm.snapshot` is the oracle both harnesses share.

module "snippet"

import "std/io"

Circle :: struct {
    r: i32
}

Square :: struct {
    side: i32
}

UNIT :: Circle { .r = 1 }

pick :: fn(k: i32) -> Circle | Square | null {
    if k == 0 {
        return UNIT
    }
    if k == 1 {
        return Circle { .r = 1 }
    }
    if k == 2 {
        return Square { .side = 1 }
    }
    return null
}

main :: fn() -> i32 {
    shared: Circle | Square | null: UNIT
    println("const === const: ${pick(0) === shared}")
    println("fresh === const: ${pick(1) === shared}")
    println("null === null: ${pick(3) === pick(3)}")
    println("square !== const: ${pick(2) !== shared}")
    return 0
}
