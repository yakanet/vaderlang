// T3070: `bytes()` hands out a view of the string's own bytes, which nothing
// modifies, so a write through a name bound to it is rejected. The native
// zero-copy view is sound because no write reaches it.

module "snippet"


main :: fn() -> i32 {
    bs :: "abc".bytes()
    bs[0] = u8(120)
    return 0
}
