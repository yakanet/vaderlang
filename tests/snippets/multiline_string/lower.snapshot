# Lower

## snippet
  snippet.main :: fn() -> i32 {  // snippet$main
      s: string = "line one\nline two\n"
      std.console.print<string>(s)
      n: i32 = 42
      msg: string = {
          __buf_0: Buffer = std.core.new_byte_buffer(i64(33))
          __off_1: i64 = 0
          __off_1 = std.core.write_string_at(__buf_0, __off_1, "count: ")
          __off_1 = std.core.write_int(__buf_0, __off_1, n)
          __off_1 = std.core.write_string_at(__buf_0, __off_1, "\ndone\n")
          std.core.finish_buffer(__buf_0, __off_1)
      }
      std.console.print<string>(msg)
      escaped: string = "tab:\there\n"
      std.console.print<string>(escaped)
      prefix: string = "start"
      combined: string = concat_2(prefix, " middle\nend")
      std.console.println<string>(combined)
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

