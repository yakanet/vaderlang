// fusion_generic_generator_nested — one generic generator inlined twice, at
// `i32` then at `string`, nested: each instance keeps its own parameter `last`,
// which the trailing `yield last` reads.
//
// The lazy half, the reference, prints first; the fused half must print the
// same.

module "snippet"

import "std/io"

each_then :: fn<T>(xs: T[], last: T) -> Iterator<T> {
    for x in xs {
        yield x
    }
    yield last
}

main :: fn() -> i32 {
    lazy := ""
    outer :: each_then([1, 2], 9)
    for a in outer {
        inner :: each_then(["p"], "zz")
        for b in inner {
            lazy = lazy + " ${a}${b}"
        }
    }
    println("lazy:${lazy}")
    fused := ""
    for a in each_then([1, 2], 9) {
        for b in each_then(["p"], "zz") {
            fused = fused + " ${a}${b}"
        }
    }
    println("fused:${fused}")
    return 0
}
