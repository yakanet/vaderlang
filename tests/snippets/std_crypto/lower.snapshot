# Lower

## snippet
  snippet.main :: fn() -> i32 {  // snippet$main
      std.io.println<string>(concat_2("sha256-empty=", crypto.sha256("")))
      std.io.println<string>(concat_2("sha256-abc=", crypto.sha256("abc")))
      std.io.println<string>(concat_2("sha256-quick=", crypto.sha256("The quick brown fox jumps over the lazy dog")))
      std.io.println<string>(concat_2("sha256-long=", crypto.sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")))
      std.io.println<string>(concat_2("md5-empty=", crypto.md5("")))
      std.io.println<string>(concat_2("md5-abc=", crypto.md5("abc")))
      std.io.println<string>(concat_2("md5-quick=", crypto.md5("The quick brown fox jumps over the lazy dog")))
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.usize.new_buffer(c1)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

