  snippet.split :: fn(a: i32[]) -> i64 {  // snippet$split
      squares: i64[] = @array.reserve(@array.len(a))
      doubles: i64[] = @array.reserve(@array.len(a))
      offset: i32 = 100
      {
          __for_arr_0: i32[] = a
          __for_len_1: i64 = @array.len(__for_arr_0)
          __for_i_2: i64 = 0
          for __for_i_2 < __for_len_1 {
              x: i32 = __for_arr_0[__for_i_2]
              @array.push(squares, snippet.square(x))
              @array.push(doubles, i64((x * 2) + offset))
          } @step {
              __for_i_2 = __for_i_2 +% i64(1)
          }
      }
      return squares[@array.len(squares) - i64(1)] + doubles[0]
  }
  snippet.odd_squares :: fn(a: i32[]) -> i64[] {  // snippet$odd_squares
      out: i64[] = [] :i64[]
      {
          __for_arr_0: i32[] = a
          __for_len_1: i64 = @array.len(__for_arr_0)
          __for_i_2: i64 = 0
          for __for_i_2 < __for_len_1 {
