# Lower

## snippet
  snippet.square :: fn(x: i32) -> i64 {  // snippet$square
      i64(x) * i64(x)
  }
  snippet.odd :: fn(x: i32) -> bool {  // snippet$odd
      (x % 2) == 1
  }
  snippet.show :: fn(label: string, xs: i64[]) -> void {  // snippet$show
      out: string = concat_2(label, ":")
      {
          __for_arr_0: i64[] = xs
          __for_len_1: i64 = @array.len(__for_arr_0)
          __for_i_2: i64 = 0
          for __for_i_2 < __for_len_1 {
              x: i64 = __for_arr_0[__for_i_2]
              out = {
                  __p_3: string = out
                  __buf_4: Buffer = std.core.new_byte_buffer(i64(21) +% std.core.byte_len(__p_3))
                  __off_5: i64 = 0
                  __off_5 = std.core.write_string_at(__buf_4, __off_5, __p_3)
                  __off_5 = std.core.write_string_at(__buf_4, __off_5, " ")
                  __off_5 = std.core.write_int(__buf_4, __off_5, x)
                  std.core.finish_buffer(__buf_4, __off_5)
              }
          } @step {
              __for_i_2 = __for_i_2 +% i64(1)
          }
      }
      std.console.println<string>(out)
  }
  snippet.over_array :: fn(a: i32[]) -> i64[] {  // snippet$over_array
      out: i64[] = @array.reserve(@array.len(a))
      {
          __for_arr_0: i32[] = a
          __for_len_1: i64 = @array.len(__for_arr_0)
          __for_i_2: i64 = 0
          for __for_i_2 < __for_len_1 {
              x: i32 = __for_arr_0[__for_i_2]
              @array.push_cached(out, snippet.square(x))
          } @step {
              __for_i_2 = __for_i_2 +% i64(1)
          }
      }
      return out
  }
  snippet.over_range :: fn(lo: i32, hi: i32) -> i64[] {  // snippet$over_range
      out: i64[] = @array.reserve(if lo < hi { hi -% lo } else { i64(0) } :i64)
      {
          i: i32 = lo
          for i < hi {
              @array.push_cached(out, snippet.square(i))
          } @step {
              i = i +% 1
          }
      }
      return out
  }
  snippet.over_inclusive :: fn(lo: i32, hi: i32) -> i64[] {  // snippet$over_inclusive
      out: i64[] = @array.reserve(if lo <= hi { (hi -% lo) +% i64(1) } else { i64(0) } :i64)
      {
          i: i32 = lo
          __more_turns_0: bool = i <= hi
          for __more_turns_0 {
              @array.push_cached(out, snippet.square(i))
          } @step {
              __more_turns_0 = i < hi
              i = i +% 1
          }
      }
      return out
  }
  snippet.span_count :: fn(lo: i8, hi: i8) -> i64 {  // snippet$span_count
      out: i8[] = @array.reserve(if lo < hi { hi -% lo } else { i64(0) } :i64)
      {
          b: i8 = lo
          for b < hi {
              @array.push_cached(out, b)
          } @step {
              b = b +% i8(1)
          }
      }
      return @array.len(out)
  }
