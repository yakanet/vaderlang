  snippet.until_big :: fn(a: i32[]) -> i64[] {  // snippet$until_big
      out: i64[] = [] :i64[]
      {
          __for_arr_0: i32[] = a
          __for_len_1: i64 = @array.len(__for_arr_0)
          __for_i_2: i64 = 0
          for __for_i_2 < __for_len_1 {
              x: i32 = __for_arr_0[__for_i_2]
              if x > 3 {
                  break
              }
              @array.push_cached(out, snippet.square(x))
          } @step {
              __for_i_2 = __for_i_2 +% i64(1)
          }
      }
      return out
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      a: i32[] = [1, 2, 3, 4, 5] :i32[]
      snippet.show("array", snippet.over_array(a))
      snippet.show("range", snippet.over_range(2, 6))
      snippet.show("empty range", snippet.over_range(6, 2))
      snippet.show("collect", {
