          }
          out
      } :i64[])
      snippet.show("collect range", {
          f: fn(i32) -> i64 = snippet.square
          out: i64[] = @array.reserve(i64(4))
          {
              x: i32 = 0
              for x < 4 {
                  x: i64 = snippet.square(x)
                  @array.push(out, x)
              } @step {
                  x = x +% 1
              }
          }
          out
      } :i64[])
      snippet.show("filtered", snippet.odd_squares(a))
      snippet.show("until", snippet.until_big(a))
      empty: i32[] = [] :i32[]
      snippet.show("empty array", snippet.over_array(empty))
      snippet.show("inclusive", snippet.over_inclusive(1, 3))
      snippet.show("empty inclusive", snippet.over_inclusive(3, 1))
      std.console.println<string>({
          __buf_3: Buffer = std.core.new_byte_buffer(i64(35))
          __off_4: i64 = 0
          __off_4 = std.core.write_string_at(__buf_3, __off_4, "narrow signed: ")
          __off_4 = std.core.write_int(__buf_3, __off_4, snippet.span_count(i8(-100), i8(100)))
          std.core.finish_buffer(__buf_3, __off_4)
      } :string)
      snippet.show("field", snippet.over_field(Bag { .items = [3, 4] :i32[] }))
      std.console.println<string>({
          __buf_5: Buffer = std.core.new_byte_buffer(i64(27))
          __off_6: i64 = 0
          __off_6 = std.core.write_string_at(__buf_5, __off_6, "split: ")
          __off_6 = std.core.write_int(__buf_5, __off_6, snippet.split(a))
          std.core.finish_buffer(__buf_5, __off_6)
      } :string)
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

