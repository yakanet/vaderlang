# Lower

## snippet
  snippet.classify :: fn(c: char) -> i32 {  // snippet$classify
      {
          if (c >= '0') && (c <= '9') {
              1
          } else if (c >= 'a') && (c <= 'z') {
              2
          } else if (c >= 'A') && (c <= 'Z') {
              3
          } else {
              0
          } :i32
      } :i32
  }
  snippet.bucket :: fn(n: i32) -> i32 {  // snippet$bucket
      {
          if (n >= 0) && (n < 10) {
              1
          } else if (n >= 10) && (n <= 99) {
              2
          } else {
              3
          } :i32
      } :i32
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      c: i32 = ((snippet.classify('5') + (snippet.classify('q') * 10)) + (snippet.classify('Q') * 100)) + (snippet.classify('+') * 1000)
      b: i32 = ((snippet.bucket(9) + (snippet.bucket(10) * 10)) + (snippet.bucket(99) * 100)) + (snippet.bucket(100) * 1000)
      return c + b
  }

