# Lower

## snippet
  snippet.greet :: fn(name: string, prefix: string) -> string {  // snippet$greet
      return concat_3(prefix, ", ", name)
  }
  snippet.combine :: fn(a: i32, b: i32, c: i32) -> i32 {  // snippet$combine
      return ((a * 100) + (b * 10)) + c
  }
  snippet$pick :: fn(a: i32) -> i32 {
      return a
  }
  snippet$pick_1 :: fn(a: i32, b: i32) -> i32 {
      return (a * 10) + b
  }
  snippet.Box :: struct { v: i32 }  // snippet$Box
  snippet.scale :: fn(self: Box, by: i32, plus: i32) -> i32 {  // snippet$scale
      return (self.v * by) + plus
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      g1: string = snippet.greet("Alice", "Hello")
      g2: string = snippet.greet("Eve", "Hey")
      r: i32 = snippet.combine(1, 2, 3)
      p: i32 = snippet$pick_1(5, 4)
      b: Box = Box { .v = 6 }
      u: i32 = snippet.scale(b, 2, 1)
      return ((i32(std.core.len(g1) + std.core.len(g2)) + r) + p) + u
  }
  concat_3 :: fn(p0: string, p1: string, p2: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      c2: i64 = c1 +% std.core.byte_len(p2)
      buf: Buffer = std.core.usize.new_buffer(usize(c2))
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.intern_string(buf, c2)
  }

