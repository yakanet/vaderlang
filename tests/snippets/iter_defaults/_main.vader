// `Iterator` defaults injected via Layer 8d — `count`, `last`, `is_empty`
// derive from the user's `next`. Every Iterator impl (Range, StringChars, a
// user struct, a generator's state machine, …) inherits the three methods
// without writing a body.

module "snippet"

import "std/io"

Countdown :: struct { remaining: i32 }

Countdown implements Iterator<i32> {
    next :: fn(self!) -> [i32, Continuation] {
        if self.remaining <= 0 {
            return [0, Continuation.Stop]
        }
        v :: self.remaining
        self.remaining = self.remaining - 1
        return [v, Continuation.Continue]
    }
}

main :: fn() -> i32 {
    // Range — count drains the iterator.
    println((0..<5).count())

    // Range — last yields the inclusive end.
    match (10..=15).last() {
        is i32 as v -> println(v)
        is null     -> println("none")
    }

    // is_empty — the empty range ends immediately.
    println((0..<0).is_empty())
    println((0..<5).is_empty())

    // User struct — same machinery via the trait default.
    println(Countdown { .remaining = 3 }.count())

    return 0
}
