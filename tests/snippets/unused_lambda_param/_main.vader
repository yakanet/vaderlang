// A lambda that never reads one of its parameters still takes it: the lifted
// fn keeps every declared parameter, so it matches the closure calling
// convention (env + params) that `call.indirect` uses. The resolver records a
// lambda parameter where it is declared, not at its first use.
module "snippet"

import "std/io"

apply :: fn(x: i32, f: fn(i32) -> i32) -> i32 = f(x)

main :: fn() -> i32 {
    // `v` is never read in the body.
    println("${apply(5, fn(v: i32) { return 7 })}")   // 7
    // a lambda that reads its param, as the control.
    println("${apply(5, fn(v: i32) { return v + 1 })}") // 6
    return 0
}
