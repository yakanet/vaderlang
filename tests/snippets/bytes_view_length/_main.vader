module "snippet"

import "std/io"

main :: fn() -> i32 {
    // A string's byte length, read off the string or off its `bytes()` view.
    println("string=${"abc".byte_len()} view=${"abc".bytes().len()}")

    // A held view is a real `u8[]`: its length and its elements are the string's.
    bs :: "hello".bytes()
    println("held=${bs.len()} first=${bs[0]}")

    return 0
}
