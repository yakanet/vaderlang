# Lower

## snippet
  snippet.mk :: fn(n: i32) -> [i32, i32] {  // snippet$mk
      [n, n * 2] :[i32, i32]
  }
  snippet.read_after_join :: fn(n: i32, flag: bool) -> i32 {  // snippet$read_after_join
      p: [i32, i32] = snippet.mk(n)
      bump: i32 = 0
      if flag {
          bump = 1
      } else {
          bump = 2
      }
      return (bump + p._0) + p._1
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      total: i32 = 0
      {
          i: i32 = 0
          for i < 3 {
              total = total + snippet.read_after_join(i, i == 1)
          } @step {
              i = i +% 1
          }
      }
      return total
  }

