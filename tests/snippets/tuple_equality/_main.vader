// `==` on a tuple compares its ELEMENTS, not the two references.
//
// A tuple has no identity to observe: it cannot be mutated (`t[0] = x` is T3008)
// and a fresh one is built at every construction, so a reference compare answers
// a question nobody asked.
//
// A tuple is only as comparable as its elements, and every element form has to be
// handled where the comparison is generated — the lowerer emits them directly and
// they never go back through `lower_expr`. Hence the four shapes below.

module "snippet"

import "std/io"

Tagged :: struct { n: i32 }

Tagged implements Equals {
    equals :: fn(self, other: Tagged) -> bool = self.n == other.n
}

Pair :: [i32, i32]

pair :: fn(n: i32, s: string) -> [i32, string] = [n, s]
tagged :: fn(n: i32) -> [i32, Tagged] = [n, Tagged { .n = n }]
named :: fn(a: i32, b: i32) -> Pair = Pair([a, b])

main :: fn() -> i32 {
    // 1. primitives — the built-in `==` per element
    a :: pair(1, "x")
    b :: pair(1, "x")      // same contents, a DIFFERENT object
    println("equal contents, distinct objects: ${a == b}")
    println("different contents:               ${a == pair(2, "x")}")
    println("same object:                      ${a == a}")
    println("negation:                         ${a != pair(2, "x")}")

    // 2. nested tuple — the recursion happens in the lowerer
    println("nested equal:                     ${[1, [2, "y"]] == [1, [2, "y"]]}")
    println("nested different:                 ${[1, [2, "y"]] == [1, [3, "y"]]}")

    // 3. struct element — routed through its own `Equals` impl, NOT a reference
    //    compare; the two `Tagged` below are distinct objects.
    println("struct element via Equals:        ${tagged(3) == tagged(3)}")
    println("struct element, differing:        ${tagged(3) == tagged(4)}")

    // 4. a distinct over a tuple compares through its backing, so naming the
    //    type does not change the answer.
    println("distinct over a tuple:            ${named(2, 3) == named(2, 3)}")
    println("distinct, differing:              ${named(2, 3) == named(2, 4)}")

    // 5. each operand is evaluated EXACTLY once — that is what the two
    //    temporaries buy, and nothing else here would notice if they went.
    //    Two calls for a 2-element tuple, not four.
    calls: i32[]!: [0]
    counted :: (n: i32) -> {
        calls[0] = calls[0] + 1
        return [n, "e"]
    }
    _ :: counted(1) == counted(1)
    println("operand evaluations:              ${calls[0]}")
    return 0
}
