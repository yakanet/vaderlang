// `<chain>.count()` over a fusible lazy chain: std's `count` is a free fn with
// one `for` over its argument, so the call inlines into a single flat loop —
// `total := 0; for … { total += 1 }; total` — with NO `MappedIterator` /
// `FilterIterator` struct and NO `Iterator.next()` dispatch (see the lower
// snapshot). On a bare array, `count` is the O(1) array overload, its length.
module "snippet"

import "std/io"
import "std/iter"

main :: fn() -> i32 {
    // map + filter + count over an array source — one flat loop.
    a :: [1, 2, 3, 4, 5, 6].map((x: i32) -> x * 2).filter((x: i32) -> x > 6).count()
    println("a ${a}")                                    // 8,10,12 → 3

    // filter + count over an integer-range source.
    b :: (0..<10).filter((x: i32) -> x % 2 == 0).count()
    println("b ${b}")                                    // 0,2,4,6,8 → 5

    // a bare array: its length, no loop.
    c :: [10, 20, 30].count()
    println("c ${c}")                                    // 3

    return 0
}
