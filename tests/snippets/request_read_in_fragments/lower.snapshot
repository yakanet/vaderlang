  snippet.line_text :: fn(line: IOError | null | string) -> string {  // snippet$line_text
      if line is string {
          return string(line)
      }
      return snippet.outcome((IOError | null)(line))
  }
  snippet.bytes_text :: fn(bytes: IOError | null | u8[]) -> string {  // snippet$bytes_text
      if bytes is u8[] {
          return std.core.bytes_to_string(u8[](bytes))
      }
      return snippet.outcome((IOError | null)(bytes))
  }
  snippet.outcome :: fn(result: IOError | null) -> string {  // snippet$outcome
      if result is IOError {
          return concat_3(std.io.IOErrorKind.to_string(IOError(result).kind), ": ", IOError(result).msg)
      }
      return "nothing"
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  concat_3 :: fn(p0: string, p1: string, p2: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      c2: i64 = c1 +% std.core.byte_len(p2)
      buf: Buffer = std.core.new_byte_buffer(c2)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.intern_string(buf, c2)
  }

