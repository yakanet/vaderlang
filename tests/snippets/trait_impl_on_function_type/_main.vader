// A trait implemented on a function type: a function, a lambda and a closure
// answer its method, beside a struct that implements it too.

module "snippet"

import "std/console"

Handler :: trait {
    handle :: fn(self, x: i32) -> i32
}

(fn(i32) -> i32) implements Handler {
    handle :: fn(self, x: i32) -> i32 = self(x)
}

Doubled :: struct {}

Doubled implements Handler {
    handle :: fn(self, x: i32) -> i32 = x * 2
}

run :: fn(h: Handler) -> i32 = h.handle(2)

plus_one :: fn(x: i32) -> i32 = x + 1

main :: fn() -> i32 {
    k :: 7
    println("${run(plus_one)} ${run((x: i32) -> x * 10)} ${run((x: i32) -> x * k)}")
    println("${run(Doubled {})}")
    return 0
}
