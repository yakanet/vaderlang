# Lower

## snippet
  snippet.ParseErr :: struct { msg: string }  // snippet$ParseErr
  snippet.NetErr :: struct { reason: string }  // snippet$NetErr
  snippet.ParseErr.message :: fn(self: ParseErr) -> string {  // snippet$ParseErr$std_core$Error$message
      concat_2("parse: ", self.msg)
  }
  snippet.NetErr.message :: fn(self: NetErr) -> string {  // snippet$NetErr$std_core$Error$message
      concat_2("net: ", self.reason)
  }
  snippet.report :: fn(e: Error) -> string {  // snippet$report
      return @vcall(std.core.Error.message, e)
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      std.console.println<string>(snippet.report(ParseErr { .msg = "bad token" }))
      std.console.println<string>(snippet.report(NetErr { .reason = "timeout" }))
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  vtable std.core.Error.message for NetErr  snippet.NetErr.message  // snippet$NetErr$std_core$Error$message
  vtable std.core.Error.message for ParseErr  snippet.ParseErr.message  // snippet$ParseErr$std_core$Error$message

