// Function overloading by first-param type (SPEC *Function overloading*). Two
// free fns share the name `describe` and dispatch on the receiver, through a
// direct call and through UFCS. The stdlib `abs` overloads (`f64`, `i32`, `i64`)
// resolve the same way, and `min` / `max` / `clamp` put a generic over
// `Comparable` beside `f64` / `f32` ones: a free integer literal defaults to
// `i32`, so `abs(-7)` and `min(3, 5)` take `i32`, and a float literal `f64`.

module "snippet"

import "std/console"
import "std/math"

export Box :: struct { v: i32 }
export Bag :: struct { v: string }

export describe :: fn(b: Box) -> string { return "box ${b.v}" }
export describe :: fn(b: Bag) -> string { return "bag ${b.v}" }

main :: fn() -> i32 {
    a :: Box { .v = 42 }
    b :: Bag { .v = "hi" }
    // Direct calls.
    println(describe(a))
    println(describe(b))
    // UFCS, same dispatch.
    println(a.describe())
    println(b.describe())

    // Stdlib min / max / abs / clamp. Integer literals default to i32, so
    // `abs(-7)` and `min(3, 5)` take i32; float literals take f64.
    println("min(3, 5)     = ${min(3, 5)}")
    println("min(3.5, 5.0) = ${min(3.5, 5.0)}")
    println("max(-2, 8)    = ${max(-2, 8)}")
    println("abs(-7)       = ${abs(-7)}")
    println("abs(-7.5)     = ${abs(-7.5)}")
    println("clamp(15, 0, 10)      = ${clamp(15, 0, 10)}")
    println("clamp(1.5, 0.0, 1.0)  = ${clamp(1.5, 0.0, 1.0)}")
    return 0
}
