// A name bound to a tested value inside a scope that `closure_analysis` walks on
// its own (a lambda body, or a `defer` block) is a local of that scope, never a
// capture of the enclosing function. Three shapes: a binding narrowed by
// `if … is T` in a lambda, `match … as x` in a lambda, and the same `if` in a
// `defer` block, which carries no lambda at all. Each tested value is a call
// (`unwrap(x)`), so the binding is the only name it has.
//
// Two shapes here are load bearing rather than ceremony:
//   - every enclosing fn returns a value `main` CONSUMES. Behind a `-> void` fn,
//     a body lowered empty goes quiet: exit 0, one missing line of output.
//   - each lambda reaches its call through `apply`, as a function value. A
//     lambda called through a local is devirtualised into a direct call.

module "snippet"

import "std/io"

Leaf :: struct { v: i32 }
Pair :: struct { l: i32 }
Tree :: Leaf | Pair

unwrap :: fn(t: Tree) -> Tree = t

apply :: fn(t: Tree, visit: fn(Tree) -> void) -> void {
    visit(t)
}

if_form :: fn(t: Tree) -> i32 {
    apply(t, (x: Tree) -> {
        lf :: unwrap(x)
        if lf is Leaf {
            println("lf=${lf.v}")
        }
    })
    return 1
}

match_form :: fn(t: Tree) -> i32 {
    cb :: (x: Tree) -> {
        match unwrap(x) as s {
            is Leaf -> { println("s=${s.v}") }
            is Pair -> { println("s=${s.l}") }
        }
    }
    apply(t, cb)
    return 2
}

defer_form :: fn(t: Tree) -> i32 {
    defer {
        df :: unwrap(t)
        if df is Leaf {
            println("df=${df.v}")
        }
    }
    return 3
}

main :: fn() -> i32 {
    println("if=${if_form(Leaf { .v = 7 })}")
    println("match=${match_form(Leaf { .v = 7 })}")
    println("defer=${defer_form(Leaf { .v = 7 })}")
    return 0
}
