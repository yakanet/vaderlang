// An `as` alias bound inside a scope that `closure_analysis` walks on its own
// (a lambda body, or a `defer` block) is a local of that scope, never a capture
// of the enclosing function. Three shapes: `if … is T as x` in a lambda,
// `match … as x` in a lambda, and `if … is T as x` in a `defer` block, which
// carries no lambda at all. Each scrutinee is a call (`unwrap(x)`), so the
// alias is the only name it has.
//
// Two shapes here are load bearing rather than ceremony:
//   - every enclosing fn returns a value `main` CONSUMES. Behind a `-> void` fn,
//     a body lowered empty goes quiet: exit 0, one missing line of output.
//   - each lambda reaches its call through `apply`, as a function value. A
//     lambda called through a local is devirtualised into a direct call.

module "snippet"

import "std/io"

Leaf :: struct { v: i32 }
Pair :: struct { l: i32 }
Tree :: Leaf | Pair

unwrap :: fn(t: Tree) -> Tree = t

apply :: fn(t: Tree, visit: fn(Tree) -> void) -> void {
    visit(t)
}

if_form :: fn(t: Tree) -> i32 {
    apply(t, (x: Tree) -> {
        if unwrap(x) is Leaf as lf {
            println("lf=${lf.v}")
        }
    })
    return 1
}

match_form :: fn(t: Tree) -> i32 {
    cb :: (x: Tree) -> {
        match unwrap(x) as s {
            is Leaf -> { println("s=${s.v}") }
            is Pair -> { println("s=${s.l}") }
        }
    }
    apply(t, cb)
    return 2
}

defer_form :: fn(t: Tree) -> i32 {
    defer {
        if unwrap(t) is Leaf as df {
            println("df=${df.v}")
        }
    }
    return 3
}

main :: fn() -> i32 {
    println("if=${if_form(Leaf { .v = 7 })}")
    println("match=${match_form(Leaf { .v = 7 })}")
    println("defer=${defer_form(Leaf { .v = 7 })}")
    return 0
}
