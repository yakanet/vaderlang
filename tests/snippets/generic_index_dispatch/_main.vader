// The index operator dispatches through `Index` / `IndexSet` bounds, not only
// on a concrete receiver: `c[i]` (read) and `c[i] = v` (write) on a
// `C: Index<i64, i32>` / `C: IndexSet<i64, i32>` type parameter route to the
// impl's `at` / `set_at`, which each instance calls directly. Direct indexing
// on the concrete `Cell` is the baseline the generic form must match.

module "snippet"

import "std/io"

// A tiny cell over a backing array : `at` reads a slot, `set_at` writes one.
Cell :: struct {
    slots: i32[]
}

Cell implements Index<i64, i32> {
    at :: fn(self, i: i64) -> i32 = self.slots[i]
}

Cell implements IndexSet<i64, i32> {
    set_at :: fn(self, i: i64, v: i32) {
        self.slots[i] = v
    }
}

// Generic read through the `Index` bound.
read_nth :: fn<C: Index<i64, i32>>(c: C, i: i64) -> i32 = c[i]

// Generic write through the `IndexSet` bound.
write_nth :: fn<C: IndexSet<i64, i32>>(c: C, i: i64, v: i32) {
    c[i] = v
}

main :: fn() -> i32 {
    cell :: Cell { .slots = [10, 20, 30] }

    // Direct concrete indexing: the baseline.
    println("direct_read=${cell[1]}")
    cell[1] = 99
    println("direct_after_write=${cell[1]}")

    // Generic-bounded dispatch.
    println("generic_read=${read_nth<Cell>(cell, 2)}")
    write_nth<Cell>(cell, 2, 77)
    println("generic_after_write=${read_nth<Cell>(cell, 2)}")

    return 0
}
