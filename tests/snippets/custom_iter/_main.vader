module "snippet"

import "std/io"

// A simple countdown iterator: yields n-1, n-2, ..., 0 then null.
export Countdown :: struct {
    current: i32
}

Countdown implements Iterator<i32> {
    next :: fn(self!) -> [i32, Continuation] {
        if (self.current <= 0) {
            return [0, Continuation.Stop]
        }
        v :: self.current
        self.current = self.current - 1
        return [v, Continuation.Continue]
    }
}

main :: fn() -> i32 {
    it :: Countdown { .current = 5 }
    for x in it {
        println("${x}")
    }
    return 0
}
