module "snippet"

import "std/io"

// A countdown iterator: yields n, n-1, ..., 1, then stops.
export Countdown :: struct {
    current: i32
}

Countdown implements Iterator<i32> {
    next :: fn(self) -> [i32, Continuation] {
        if (self.current <= 0) {
            return [0, .Stop]
        }
        v :: self.current
        self.current = self.current - 1
        return [v, .Continue]
    }
}

main :: fn() -> i32 {
    it :: Countdown { .current = 5 }
    for x in it {
        println("${x}")
    }
    return 0
}
