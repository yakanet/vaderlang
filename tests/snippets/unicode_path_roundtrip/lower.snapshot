  snippet.main :: fn() -> i32 {  // snippet$main
      path: string = concat_2(std.env.temp_dir(), "/vader_héllo_zoé_日本.txt")
      written: IOError | null = std.fs.write_file_bytes(path, [u8(104), u8(101), u8(108), u8(108), u8(111)] :u8[])
      if written is Error {
          std.console.println<string>(concat_2("write failed: ", @vcall(std.core.Error.message, Error(written))))
          return 1
      }
      read_back: IOError | u8[] = std.fs.read_file_bytes(path, i64(16777216))
      if read_back is Error {
          std.console.println<string>(concat_2("read failed: ", @vcall(std.core.Error.message, Error(read_back))))
          return 1
      }
      std.console.println<string>({
          __buf_0: Buffer = std.core.new_byte_buffer(i64(15))
          __off_1: i64 = 0
          __off_1 = std.core.write_string_at(__buf_0, __off_1, "roundtrip=")
          __off_1 = std.core.write_bool(__buf_0, __off_1, @array.len(u8[](read_back)) == i64(5))
          std.core.finish_buffer(__buf_0, __off_1)
      } :string)
      std.console.println<string>({
          __buf_2: Buffer = std.core.new_byte_buffer(i64(12))
          __off_3: i64 = 0
          __off_3 = std.core.write_string_at(__buf_2, __off_3, "exists=")
          __off_3 = std.core.write_bool(__buf_2, __off_3, std.fs.exists(path))
          std.core.finish_buffer(__buf_2, __off_3)
      } :string)
      std.fs.remove_file(path)
      std.console.println<string>({
          __buf_4: Buffer = std.core.new_byte_buffer(i64(13))
          __off_5: i64 = 0
          __off_5 = std.core.write_string_at(__buf_4, __off_5, "removed=")
          __off_5 = std.core.write_bool(__buf_4, __off_5, !std.fs.exists(path))
          std.core.finish_buffer(__buf_4, __off_5)
      } :string)
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

