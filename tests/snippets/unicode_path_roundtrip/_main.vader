module "snippet"

import "std/io"

// A path whose characters do not fit the system ANSI code page. On Windows the
// `A` entry points would mangle or reject it, which is why `std/io` goes
// through `CreateFileW` and the other `W` forms there; POSIX passes UTF-8
// bytes straight down. The directory itself is NOT printed — it differs per
// machine — only that the round trip survived.
main :: fn() -> i32 {
    path :: "${temp_dir()}/vader_héllo_zoé_日本.txt"
    written :: write_file_bytes(path, [104, 101, 108, 108, 111])
    if written is Error {
        println("write failed: ${written.message()}")
        return 1
    }
    read_back :: read_file_bytes(path, READ_LIMIT_DEFAULT)
    if read_back is Error {
        println("read failed: ${read_back.message()}")
        return 1
    }
    println("roundtrip=${read_back.len() == 5}")
    println("exists=${exists(path)}")
    remove_file(path)
    println("removed=${!exists(path)}")
    return 0
}
