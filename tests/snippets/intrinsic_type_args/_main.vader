// `@type_args(T)` exposes a generic instance's type arguments as a `type[]`
// literal, sibling of `@fields(T)`; a non-generic type yields `[]`. Each
// argument is a runtime `type` value, so `@size_of` on it goes through the
// runtime `size_of.type` path: a `string` is 4 bytes, the width of its interned
// atom id, as the static fold answers (`comptime_type_alias`).

module "snippet"

import "std/io"

Pair :: struct<K, V> {
    key:   K
    value: V
}

Wrapper :: struct {
    inner: i32
}

main :: fn() -> i32 {
    for t in @type_args(Pair<string, i64>) {
        println("pair-arg size=${@size_of(t)}")
    }
    args :: @type_args(Wrapper)
    println("wrapper-arg count=${args.len()}")
    return 0
}
