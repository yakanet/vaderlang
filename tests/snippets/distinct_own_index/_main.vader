// A distinct's own `Index` / `IndexSet` impl wins over its backing, trait by trait :
// `Offset` reads through its `at` and writes through its `set_at`, `Cells` (a distinct
// over a struct) indexes through its `at`, and `Log`, which implements only `Index`,
// reads through it and writes into its backing array — a plain write, `+=` (whose
// read is `at`'s -1) and a destructuring write alike. A `Range` index slices.
module "snippet"

import "std/io"

Offset :: i32[]

Offset implements Index<usize, i32> {
    at :: fn(self, i: usize) -> i32 = i32(self.len()) * 100 + i32(i)
}

Offset implements IndexSet<usize, i32> {
    set_at :: fn(self, i: usize, v: i32) {
        println("set_at ${i} ${v}")
    }
}

Grid :: struct {
    w: i32
}

Cells :: Grid

Cells implements Index<usize, i32> {
    at :: fn(self, i: usize) -> i32 = i32(i) * 10
}

Log :: i32[]

Log implements Index<usize, i32> {
    at :: fn(self, i: usize) -> i32 = -1
}

main :: fn() -> i32 {
    o: Offset: Offset([1, 2, 3])
    println("offset read ${o[1]}")
    o[0] = 9
    c :: Cells(Grid { .w = 1 })
    println("cells read ${c[2]}")
    l: Log: Log([4, 5, 6])
    l[0] = 7
    l[1] += 100
    [l[2]] = [42]
    println("log read ${l[0]}")
    for x in l {
        println("log backing ${x}")
    }
    println("log slice ${l[1..<3].len()}")
    return 0
}
