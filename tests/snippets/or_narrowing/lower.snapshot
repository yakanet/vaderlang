# Lower

## snippet
  snippet.Dog :: struct { name: string }  // snippet$Dog
  snippet.Cat :: struct { name: string }  // snippet$Cat
  snippet.Bird :: struct { name: string }  // snippet$Bird
  snippet.pick :: fn(n: i32) -> Bird | Cat | Dog {  // snippet$pick
      if n == 0 {
          return Dog { .name = "rex" }
      }
      if n == 1 {
          return Cat { .name = "mia" }
      }
      return Bird { .name = "kiwi" }
  }
  snippet.furry_name :: fn(f: Cat | Dog) -> string {  // snippet$furry_name
      if f is Dog { Dog(f).name } else { Cat(f).name } :string
  }
  snippet.bird_name :: fn(b: Bird) -> string {  // snippet$bird_name
      b.name
  }
  snippet.describe :: fn(n: i32) -> string {  // snippet$describe
      p: Bird | Cat | Dog = snippet.pick(n)
      if (p is Dog) || (p is Cat) {
          return concat_2("furry ", snippet.furry_name((Cat | Dog)(p)))
      } else {
          return concat_2("bird ", snippet.bird_name(Bird(p)))
      }
  }
  snippet.not_dog :: fn(n: i32, flag: bool) -> string {  // snippet$not_dog
      p: Bird | Cat | Dog = snippet.pick(n)
      if (p is Dog) || flag {
          return "dog-or-flag"
      }
      return concat_2("not a dog: ", snippet.furry_or_bird((Bird | Cat)(p)))
  }
  snippet.furry_or_bird :: fn(p: Bird | Cat) -> string {  // snippet$furry_or_bird
      if p is Cat { Cat(p).name } else { Bird(p).name } :string
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      std.io.println<string>(snippet.describe(0))
      std.io.println<string>(snippet.describe(1))
      std.io.println<string>(snippet.describe(2))
      std.io.println<string>(snippet.not_dog(1, false))
      std.io.println<string>(snippet.not_dog(2, false))
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

