module "snippet"

import "std/io"

main :: fn() -> i32 {
    arr :: [10, 20, 30, 40]
    sum := 0
    for x in arr {
        sum = sum + x
    }
    println("sum = ${sum}")

    // an empty array iterates 0 times
    empty: i32[]: []
    n := 0
    for empty {
        n += 1
    }
    println("count = ${n}")
    return 0
}
