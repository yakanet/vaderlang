// _diag_fusion_return_value — the generator's `return` inlined into a consumer
// that returns a value.
//
// THE COMMITTED OUTPUT IS WRONG. The inlined bare `return` leaves `fused_value`
// with no value: the VM rejects the module when it loads it, and the native
// binary reaches `unreachable`. The lazy consumer returns 3.

module "snippet"

import "std/io"

upto_stop :: fn(n: i32) -> Iterator<i32> {
    for i in 0..<10 {
        if i == n {
            return
        }
        yield i
    }
}

lazy_value :: fn() -> i32 {
    total := 0
    it :: upto_stop(3)
    for v in it {
        total += v
    }
    return total
}

fused_value :: fn() -> i32 {
    total := 0
    for v in upto_stop(3) {
        total += v
    }
    return total
}

main :: fn() -> i32 {
    println("lazy value consumer: ${lazy_value()}")
    println("fused value consumer: ${fused_value()}")
    return 0
}
