# Lower

## snippet
  snippet.main :: fn() -> i32 {  // snippet$main
      std.console.println<string>(std.string.trim("  a  "))
      std.console.println<string>(std.string.trim(" b "))
      std.console.println<string>(snippet.third())
      std.console.println<string>(snippet.fourth())
      return snippet.twice(3) - 6
  }
  snippet.tidy :: fn(x: i32) -> i32 {  // snippet$tidy
      x * 2
  }
  snippet.twice :: fn(x: i32) -> i32 {  // snippet$twice
      snippet.tidy(x)
  }
  snippet.fourth :: fn() -> string {  // snippet$fourth
      std.string.trim(" e ")
  }
  snippet.third :: fn() -> string {  // snippet$third
      concat_2(std.string.trim(" c "), std.string.trim(" d "))
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std_core$Intrinsic$byte_len(p0)
      c1: i64 = c0 +% std_core$Intrinsic$byte_len(p1)
      buf: Buffer = std_core$Intrinsic$new_byte_buffer(c1)
      std_core$Intrinsic$buffer_write_string(buf, i64(0), p0)
      std_core$Intrinsic$buffer_write_string(buf, c0, p1)
      std_core$Intrinsic$buffer_intern_string(buf, c1)
  }

