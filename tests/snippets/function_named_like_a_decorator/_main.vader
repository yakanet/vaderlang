// The compiler's decorators are declared in `std/core`, but none of them is a
// value: a program keeps `target`, `alias` and `partial` for its own functions.

module "snippet"

import "std/console"

target :: fn() -> string = "darwin-arm64"

alias :: fn(name: string) -> string = "@${name}"

// `total > done` keeps the call to `partial` in the output: a body that applies an
// operator to the parameters in their order is lowered as the operator.
partial :: fn(done: i32, total: i32) -> bool = total > done

main :: fn() -> i32 {
    println(target())
    println(alias("vader"))
    println("${partial(1, 3)}")
    return 0
}
