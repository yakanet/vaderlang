# Lower

## snippet
  snippet.describe_char :: fn(c: char) -> string {  // snippet$describe_char
      return {
          if c == '>' {
              "right"
          } else if c == '<' {
              "left"
          } else if c == '+' {
              "plus"
          } else {
              "other"
          } :string
      } :string
  }
  snippet.describe_int :: fn(n: i32) -> string {  // snippet$describe_int
      return {
          if n == 0 {
              "zero"
          } else if n == 1 {
              "one"
          } else if n == 2 {
              "two"
          } else {
              "many"
          } :string
      } :string
  }
  snippet.flag_label :: fn(b: bool) -> string {  // snippet$flag_label
      return {
          if b == true {
              "on"
          } else if b == false {
              "off"
          } else {
              "?"
          } :string
      } :string
  }
  snippet.mode_name :: fn(s: string) -> string {  // snippet$mode_name
      return {
          if s == "r" {
              "read"
          } else if s == "w" {
              "write"
          } else if s == "rw" {
              "read-write"
          } else {
              "unknown"
          } :string
      } :string
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      std.console.println<string>(snippet.describe_char('>'))
      std.console.println<string>(snippet.describe_char('+'))
      std.console.println<string>(snippet.describe_char('x'))
      std.console.println<string>(snippet.describe_int(0))
      std.console.println<string>(snippet.describe_int(1))
      std.console.println<string>(snippet.describe_int(99))
      std.console.println<string>(snippet.flag_label(true))
      std.console.println<string>(snippet.flag_label(false))
      std.console.println<string>(snippet.mode_name("r"))
      std.console.println<string>(snippet.mode_name("rw"))
      std.console.println<string>(snippet.mode_name("nope"))
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std_core$Intrinsic$byte_len(p0)
      c1: i64 = c0 +% std_core$Intrinsic$byte_len(p1)
      buf: Buffer = std_core$Intrinsic$new_byte_buffer(c1)
      std_core$Intrinsic$buffer_write_string(buf, i64(0), p0)
      std_core$Intrinsic$buffer_write_string(buf, c0, p1)
      std_core$Intrinsic$buffer_intern_string(buf, c1)
  }

