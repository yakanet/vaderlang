## snippet
  snippet.Instant.sub :: fn(self: Instant, other: Instant) -> Duration {  // snippet$Instant$Sub$sub
      Duration(i64(self) - i64(other))
  }
  snippet.Duration.add :: fn(self: Duration, other: Duration) -> Duration {  // snippet$Duration$Add$add
      Duration(i64(self) + i64(other))
  }
  snippet.Instant.compare :: fn(self: Instant, other: Instant) -> i32 {  // snippet$Instant$Comparable$compare
      a: i64 = i64(self)
      b: i64 = i64(other)
      if a < b {
          return -1
      }
      if a > b {
          return 1
      }
      return 0
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      t0: Instant = Instant(i64(100))
      t1: Instant = Instant(i64(250))
      d: Duration = snippet.Instant.sub(t1, t0)
      if snippet.Instant.compare(t0, t1) < 0 {
          return i32(i64(d))
      }
      return -1
  }
