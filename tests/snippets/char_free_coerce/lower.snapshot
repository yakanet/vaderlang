## snippet
  snippet.main :: fn() -> i32 {  // snippet$main
      bs: u8[] = std.core.bytes("a/9")
      if bs[1] == u8(47) {
          std.io.println<string>("slash")
      }
      if (bs[2] >= u8(48)) && (bs[2] <= u8(57)) {
          std.io.println<string>("digit")
      }
      top: u32 = u32(1) << u32(31)
      if top == u32(2147483648) {
          std.io.println<string>("u32 top bit")
      }
      delta: u8 = bs[2] - u8(48)
      std.io.println<string>({
          __buf_0: Buffer = std.core.new_byte_buffer(usize(28))
          __off_1: usize = 0
          __off_1 = std.core.write_string_at(__buf_0, __off_1, "delta = ")
          __off_1 = std.core.write_unsigned(__buf_0, __off_1, u64(delta))
          std.core.finish_buffer(__buf_0, __off_1)
      } :string)
      c: char = 'A'
      if u8(c) == u8(65) {
          std.io.println<string>("A is 65")
      }
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.usize.new_buffer(c1)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

