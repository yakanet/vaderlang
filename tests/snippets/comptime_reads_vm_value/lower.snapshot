  snippet.root_of_fifty :: fn() -> i32 {  // snippet$root_of_fifty
      r: i32 = 0
      {
          i: i32 = 0
          for i < 50 {
              if (i * i) <= 50 {
                  r = i
              }
          } @step {
              i = i +% 1
          }
      }
      return r
  }
  snippet.count_to_ten :: fn() -> i32 {  // snippet$count_to_ten
      n: i32 = 0
      {
          _: i32 = 0
          for _ < 10 {
              n = n + 1
          } @step {
              _ = _ +% 1
          }
      }
      return n
  }
