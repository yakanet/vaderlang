// A fresh array literal is materialised directly into the target's element
// representation, so it may initialise a wider union-typed slot — this stays
// valid (the literal adopts the target element type; no reference aliasing).
// An argument may widen its element when its callee puts no wider element into
// it, and the wider element reads the slots the source wrote: boxed `string`
// slots read as boxed `string | null`. Guards the array invariance and the
// slot-layout rule against over-rejection.
module "snippet"

import "std/io"

first_name :: fn(names: (string | null)[]) -> string | null = names[0]

main :: fn() -> i32 {
    xs: (i32 | string)[]: [1, 2, 3]
    xs.push("hi")
    for x in xs {
        if x is string as s { println("str ${s}") }
        else if x is i32 as n { println("int ${n}") }
    }

    names: string[]: ["ten", "twenty"]
    if first_name(names) is string as n {
        println("view0 ${n}")
    }
    return 0
}
