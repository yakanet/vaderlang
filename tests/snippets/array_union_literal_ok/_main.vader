// A fresh array literal is materialised directly into the target's element
// representation, so it may initialise a wider union-typed slot — this stays
// valid (the literal adopts the target element type; no reference aliasing).
// A read-only covariant view is sound when it reads the slots the source wrote
// (no writes through it) : boxed `string` slots read as boxed `string | null`.
// Guards the mutable-array invariance and the slot-layout rule against
// over-rejection.
module "snippet"

import "std/io"

main :: fn() -> i32 {
    xs: (i32 | string)[]: [1, 2, 3]
    xs.push("hi")
    for x in xs {
        if x is string as s { println("str ${s}") }
        else if x is i32 as n { println("int ${n}") }
    }

    names: string[]: ["ten", "twenty"]
    view: (string | null)[]: names
    if view[0] is string as n { println("view0 ${n}") }
    return 0
}
