## snippet
  snippet$pick :: fn(n: i32, x: string) -> string {
      {
          __p_0: string = x
          __buf_1: Buffer = std.core.new_byte_buffer(usize(21) +% std.core.byte_len(__p_0))
          __off_2: usize = 0
          __off_2 = std.core.write_int(__buf_1, __off_2, i64(n))
          __off_2 = std.core.write_string_at(__buf_1, __off_2, ":")
          __off_2 = std.core.write_string_at(__buf_1, __off_2, __p_0)
          std.core.finish_buffer(__buf_1, __off_2)
      } :string
  }
  snippet$pick_1 :: fn(s: string, y: string) -> string {
      concat_3(s, ":", y)
  }
  snippet$tag :: fn(d: Display, prefix: string) -> string {
      concat_3(prefix, "|", @vcall(std.core.Display.to_string, d))
  }
  snippet$tag_1 :: fn(s: string, suffix: string) -> string {
      concat_3(s, "|", suffix)
  }
  snippet$tw :: fn(n: i32) -> string {
      "one"
  }
  snippet$tw_1 :: fn(s: string, t: string) -> string {
      concat_2("two:", t)
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      std.io.println<string>(concat_4(snippet$pick(7, "int"), " ", snippet$pick_1("a", "str"), " want=7:int a:str"))
      std.io.println<string>(concat_4(snippet$tag(7, ">"), " ", snippet$tag_1("abc", "!"), " want=>|7 abc|!"))
      std.io.println<string>(concat_4(snippet$tw(1), " ", snippet$tw_1("a", "d"), " want=one two:d"))
      std.io.println<string>(concat_4(snippet$pick(7, "X"), " ", snippet$pick_1("a", "Y"), " want=7:X a:Y"))
      std.io.println<string>(concat_4(snippet$tag(7, "#"), " ", snippet$tag_1("abc", "?"), " want=#|7 abc|?"))
      std.io.println<string>(concat_4(snippet$pick(7, "P"), " ", snippet$pick_1("a", "Q"), " want=7:P a:Q"))
      return 0
  }
  concat_3 :: fn(p0: string, p1: string, p2: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      c2: usize = c1 +% std.core.byte_len(p2)
      buf: Buffer = std.core.usize.new_buffer(c2)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.intern_string(buf, c2)
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.usize.new_buffer(c1)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  concat_4 :: fn(p0: string, p1: string, p2: string, p3: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      c2: usize = c1 +% std.core.byte_len(p2)
      c3: usize = c2 +% std.core.byte_len(p3)
      buf: Buffer = std.core.usize.new_buffer(c3)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.write_string(buf, c2, p3)
      std.core.Buffer.intern_string(buf, c3)
  }

