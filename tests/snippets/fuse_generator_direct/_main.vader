// A generator (a fn that `yield`s) consumed directly by a `for` inlines into it:
// the generator body becomes the fused loop, and each `yield e` binds the
// consumer's loop variable and runs its body. `main` keeps no generator state,
// no boxed `Iterator` and no `next()`, only flat index loops (the lower
// snapshot is the guard). Each generator still lowers to its
// `__genstate_<name>` state machine, the fallback for a generator value that
// escapes; nothing uses it here, and it is gone by the bytecode stage.
module "snippet"

import "std/io"

// map shape.
doubled :: fn(xs: i32[]) -> Iterator<i32> {
    for x in xs { yield x * 2 }
}

// filter shape (yield inside an if).
evens :: fn(xs: i32[]) -> Iterator<i32> {
    for x in xs { if x % 2 == 0 { yield x } }
}

// flatten shape (nested loops, resume mid-inner-loop when boxed — here fully inlined).
flatten :: fn(xss: i32[][]) -> Iterator<i32> {
    for row in xss {
        for x in row { yield x }
    }
}

main :: fn() -> i32 {
    for v in doubled([1, 2, 3]) { println("d ${v}") }
    for v in evens([1, 2, 3, 4, 5, 6]) { println("e ${v}") }
    for v in flatten([[1, 2], [3], [4, 5]]) { println("f ${v}") }
    return 0
}
