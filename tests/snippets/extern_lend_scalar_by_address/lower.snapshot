# Lower

## snippet
  snippet.copy_f64 :: fn(into: u8[], x: f64, count: u64) -> void  // snippet$copy_f64
  snippet.copy_f32 :: fn(into: u8[], x: f32, count: u64) -> void  // snippet$copy_f32
  snippet.copy_bool :: fn(into: u8[], x: bool, count: u64) -> void  // snippet$copy_bool
  snippet.copy_char :: fn(into: u8[], x: char, count: u64) -> void  // snippet$copy_char
  snippet.utc_time :: fn(seconds: i64) -> CPointer  // snippet$utc_time
  snippet.format_time :: fn(time: CPointer) -> string  // snippet$format_time
  snippet.main :: fn() -> i32 {  // snippet$main
      wide: u8[] = [u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0), u8(0)] :u8[]
      snippet.copy_f64(wide, -1.5, u64(8))
      std.console.println<string>(concat_2("f64 ", std.core.u8[].to_string(wide)))
      narrow: u8[] = [u8(0), u8(0), u8(0), u8(0)] :u8[]
      snippet.copy_f32(narrow, f32(1.5), u64(4))
      std.console.println<string>(concat_2("f32 ", std.core.u8[].to_string(narrow)))
      flag: u8[] = [u8(7)] :u8[]
      snippet.copy_bool(flag, true, u64(1))
      std.console.println<string>(concat_2("bool ", std.core.u8[].to_string(flag)))
      letter: u8[] = [u8(0), u8(0), u8(0), u8(0)] :u8[]
      snippet.copy_char(letter, '\u{e9}', u64(4))
      std.console.println<string>(concat_2("char ", std.core.u8[].to_string(letter)))
      std.console.print<string>(concat_2("time ", snippet.format_time(snippet.utc_time(i64(0)))))
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

