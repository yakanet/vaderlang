  snippet.main :: fn() -> i32 {  // snippet$main
      xs: f64[] = [0.0, 1.0, 3.0, 100.0, 1234567.0, 0.1, 0.5, 1.5, 2.5, 0.0001, 3.141592653589793, 123456789.12345679, 9.999999999999998, 100000000000000000000.0, 1e+21, 1e-7, 6.022e+23, 5e-324, 1.7976931348623157e+308, -0.0, -2.5] :f64[]
      {
          __for_arr_0: f64[] = xs
          __for_len_1: usize = @array.len(__for_arr_0)
          __for_i_2: usize = 0
          for __for_i_2 < __for_len_1 {
              x: f64 = __for_arr_0[__for_i_2]
              std.io.println<string>(std.core.f64.to_string(x))
          } @step {
              __for_i_2 = __for_i_2 +% usize(1)
          }
      }
      pi: f64 = 3.141592653589793
      std.io.println<string>(concat_4("pi = ", std.core.f64.to_string(pi), ", sci = ", std.core.f64.to_string(2.5e-8 * 1.0)))
      inf: f64 = 1.0 / 0.0
      std.io.println<string>(concat_5(std.core.f64.to_string(inf), " ", std.core.f64.to_string(-inf), " ", std.core.f64.to_string(0.0 / 0.0)))
      return 0
  }
  concat_4 :: fn(p0: string, p1: string, p2: string, p3: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      c2: usize = c1 +% std.core.byte_len(p2)
      c3: usize = c2 +% std.core.byte_len(p3)
      buf: Buffer = std.core.usize.new_buffer(c3)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.write_string(buf, c2, p3)
      std.core.Buffer.intern_string(buf, c3)
  }
  concat_5 :: fn(p0: string, p1: string, p2: string, p3: string, p4: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      c2: usize = c1 +% std.core.byte_len(p2)
      c3: usize = c2 +% std.core.byte_len(p3)
      c4: usize = c3 +% std.core.byte_len(p4)
      buf: Buffer = std.core.usize.new_buffer(c4)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.write_string(buf, c2, p3)
      std.core.Buffer.write_string(buf, c3, p4)
      std.core.Buffer.intern_string(buf, c4)
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.usize.new_buffer(c1)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

