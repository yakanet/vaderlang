  snippet.main :: fn() -> i32 {  // snippet$main
      path: string = concat_2(std.env.temp_dir(), "/vader_io_roundtrip.txt")
      std.fs.write_file(path, "hello from vader")
      std.console.println<string>({
          __buf_0: Buffer = std.core.new_byte_buffer(i64(13))
          __off_1: i64 = 0
          __off_1 = std.core.write_string_at(__buf_0, __off_1, "exists: ")
          __off_1 = std.core.write_bool(__buf_0, __off_1, std.fs.exists(path))
          std.core.finish_buffer(__buf_0, __off_1)
      } :string)
      contents: IOError | string = std.fs.read_file_string(path, i64(16777216))
      {
          if contents is string {
              std.console.println<string>(concat_2("read: ", string(contents)))
          } else if contents is Error {
              std.console.println<string>("read failed")
          } else {
              @unreachable("non-exhaustive match (T3013 should have caught this)")
          }
      }
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

