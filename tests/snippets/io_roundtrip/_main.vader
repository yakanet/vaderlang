module "snippet"

import "std/console"
import "std/env"
import "std/fs"
import "std/testing"

main :: fn() -> i32 {
    path :: "${temp_dir()}/vader_io_roundtrip.txt"

    // Ignore the `void | IOError` result: the side effect (file written) is what we test.
    assert_succeeds(write_file(path, "hello from vader"))

    println("exists: ${exists(path)}")

    contents :: read_file_string(path)
    match contents {
        is string -> println("read: ${contents}")
        is Error  -> println("read failed")
    }

    return 0
}
