# Lower

## snippet
  snippet.day_kind :: fn(d: Day) -> string {  // snippet$day_kind
      {
          if d == Day(5) {
              "weekend"
          } else if d == Day(6) {
              "weekend"
          } else if d == Day(0) {
              "weekday"
          } else {
              @unreachable("non-exhaustive match (T3013 should have caught this)")
          } :string
      } :string
  }
  snippet.weekend_or_not :: fn(d: Day) -> string {  // snippet$weekend_or_not
      {
          if (d == Day(5)) || (d == Day(6)) { "weekend" } else { "weekday" } :string
      } :string
  }
  snippet.label :: fn(c: Color) -> string {  // snippet$label
      {
          if c == Color(0) {
              "red"
          } else if c == Color(1) {
              "green"
          } else {
              @unreachable("@unreachable match: a variant the arms assert cannot occur was reached")
          } :string
      } :string
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      std.console.println<string>(concat_4("partial, uncovered variants: ", snippet.day_kind(Day(5)), " ", snippet.day_kind(Day(0))))
      std.console.println<string>(concat_4("partial, wildcard: ", snippet.weekend_or_not(Day(6)), " ", snippet.weekend_or_not(Day(2))))
      std.console.println<string>(concat_4("unreachable: ", snippet.label(Color(0)), " ", snippet.label(Color(1))))
      return 0
  }
  concat_4 :: fn(p0: string, p1: string, p2: string, p3: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      c2: i64 = c1 +% std.core.byte_len(p2)
      c3: i64 = c2 +% std.core.byte_len(p3)
      buf: Buffer = std.core.new_byte_buffer(c3)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.write_string(buf, c2, p3)
      std.core.Buffer.intern_string(buf, c3)
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

