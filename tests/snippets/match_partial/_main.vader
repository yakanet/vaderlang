// The `match` decorators that opt out of exhaustiveness checking.
//   - `@partial` on a match that leaves variants uncovered: no T3013, and an
//     input outside the listed arms reaches the lowerer's non-exhaustive trap,
//     so the caller narrows the input set first
//   - `@partial` with a `_` arm, the intended "everything else does X": the
//     wildcard on a closed union raises no W0005
//   - `@unreachable` suppresses T3013 the same way, but asserts the omitted
//     variants are impossible: an uncovered variant traps (`reached
//     unreachable`) under its own message, with no wildcard arm and no fake
//     value
// Only covered variants flow in, so no trap is taken and the program exits
// cleanly; each trap branch shows in the lowered program.

module "snippet"

import "std/io"

Day :: enum { Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday }

Color :: enum { Red, Green, Blue }

// Tuesday to Friday are left uncovered.
day_kind :: fn(d: Day) -> string = @partial match d {
    .Saturday -> "weekend"
    .Sunday   -> "weekend"
    .Monday   -> "weekday"
}

weekend_or_not :: fn(d: Day) -> string = @partial match d {
    .Saturday | .Sunday -> "weekend"
    _                   -> "weekday"
}

// Blue is asserted impossible.
label :: fn(c: Color) -> string = @unreachable match c {
    .Red   -> "red"
    .Green -> "green"
}

main :: fn() -> i32 {
    println("partial, uncovered variants: ${day_kind(.Saturday)} ${day_kind(.Monday)}")
    println("partial, wildcard: ${weekend_or_not(.Sunday)} ${weekend_or_not(.Wednesday)}")
    println("unreachable: ${label(.Red)} ${label(.Green)}")
    return 0
}
