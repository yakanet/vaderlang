// An `as` alias — `is T as a` or `match e as a` — lowers the ENCLOSING function
// to an EMPTY body whenever it is bound inside a scope `closure_analysis` walks
// on its own: a lambda body, or a `defer` block. The `defer` case has no lambda
// in sight, so the fault is the re-walked scope, not closures.
//
// Native traps on its `unreachable return`, the VM underflows its operand stack.
// Both backends, so the defect is in lowering: `vader/lower/closure_analysis.vader`
// never reads `BinaryExpr.bind_as` / `MatchExpr.bind_as`, so it files the alias as
// a CAPTURE ; `midir` then finds no local for it and `build.vader:789` turns that
// unresolved ident into a SILENT `unreachable` that swallows the whole body.
// Record: `.claude/plans/2026-09-06-as-expression-alias.md`.
//
// ⚠️ THE COMMITTED OUTPUT IS WRONG. This must print `if=1`, `match=2`, `defer=3`.
// Only the VM path is pinned: `c.snapshot` is opt-in through `C_PARITY`, and the
// two backends abort differently, which that oracle rejects.
//
// Two shapes here are load bearing, not ceremony:
//   - each enclosing fn returns a value `main` CONSUMES. Make one `-> void` and
//     the collapse goes quiet — exit 0, one missing line of output.
//   - the lambda travels through `apply`. Bind it to a local instead and it
//     devirtualises (no `LoweredMakeClosure`), so it would stop exercising the
//     closure path the day this is fixed.

module "snippet"

import "std/io"

Leaf :: struct { v: i32 }
Pair :: struct { l: i32 }
Tree :: Leaf | Pair

unwrap :: fn(t: Tree) -> Tree = t

apply :: fn(t: Tree, visit: fn(Tree) -> void) -> void {
    visit(t)
}

if_form :: fn(t: Tree) -> i32 {
    apply(t, (x: Tree) -> {
        if unwrap(x) is Leaf as lf {
            println("lf=${lf.v}")
        }
    })
    return 1
}

match_form :: fn(t: Tree) -> i32 {
    cb :: (x: Tree) -> {
        match unwrap(x) as s {
            is Leaf -> { println("s=${s.v}") }
            is Pair -> { println("s=${s.l}") }
        }
    }
    apply(t, cb)
    return 2
}

defer_form :: fn(t: Tree) -> i32 {
    defer {
        if unwrap(t) is Leaf as df {
            println("df=${df.v}")
        }
    }
    return 3
}

main :: fn() -> i32 {
    println("if=${if_form(Leaf { .v = 7 })}")
    println("match=${match_form(Leaf { .v = 7 })}")
    println("defer=${defer_form(Leaf { .v = 7 })}")
    return 0
}
