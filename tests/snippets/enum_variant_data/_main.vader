// Enum variant data: each variant carries a constant `StatusInfo`, read back
// as a field (`s.reason`) or whole (`StatusInfo(s)`).
//
// `HttpStatus` carries its protocol code in a field, `Level` starts at 1, and
// `retry` falls back to the struct's default. Expected: prints the five lines
// below, exits 0.

module "snippet"

import "std/io"

StatusInfo :: struct {
    code:   i32 = 0
    reason: string
    retry:  bool = false
}

HttpStatus :: enum(StatusInfo) {
    Ok { .code = 200, .reason = "OK" },
    NotFound { .code = 404, .reason = "Not Found" },
    Unavailable { .code = 503, .reason = "Service Unavailable", .retry = true },
}

Level :: enum(StatusInfo) {
    Error { .reason = "error" } = 1,
    Warning { .reason = "warning" } = 2,
}

describe :: fn(s: HttpStatus) -> string = "${s.code} ${s.reason} retry=${s.retry}"

main :: fn() -> i32 {
    for s in [HttpStatus.Ok, HttpStatus.NotFound, HttpStatus.Unavailable] {
        println(describe(s))
    }
    info :: StatusInfo(HttpStatus.NotFound)
    println("${info.reason} / ${Level.Warning.reason} ${i32(Level.Warning)}")
    println("${@size_of(HttpStatus)} ${@size_of(Level)}")
    return 0
}
