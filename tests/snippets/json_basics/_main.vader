// `json` parse then stringify, for every value kind and three parse errors.

module "snippet"

import "std/io"
import "json"

export show :: fn(label: string, src: string) -> void {
    parsed :: parse(src)
    if parsed is JsonError {
        println("${label}: error: ${parsed.msg}")
    } else {
        // Narrowed to `JsonValue`, the union of the six value kinds.
        println("${label}: ${stringify(parsed)}")
    }
}

main :: fn() -> i32 {
    // Raw strings (`r"..."`) skip backslash escapes. A raw string cannot hold
    // a `"`, so inputs with embedded quotes use an escaped string.
    show("null",   r"null")
    show("true",   r"true")
    show("false",  r"false")
    show("number", r"42")
    show("neg",    r"-3.14")
    show("expo",   r"1.5e2")
    show("string",  "\"hello\"")
    show("escaped", "\"a\\nb\\tc\\\"d\"")
    show("array",  r"[1, 2, 3]")
    show("nested",  "[[1, 2], [\"x\", \"y\"]]")
    show("object",  "{\"a\": 1, \"b\": true}")
    show("mixed",   "{\"name\": \"vader\", \"version\": 0.1, \"flags\": [\"-O0\", \"-g\"]}")

    show("err: trailing", r"42 garbage")
    show("err: bad bool", r"tru")
    show("err: bad escape", "\"\\q\"")

    return 0
}
