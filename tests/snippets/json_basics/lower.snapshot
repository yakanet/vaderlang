# Lower

## snippet
  snippet.show :: fn(label: string, src: string) -> void {  // snippet$show
      parsed: JsonArray | JsonBool | JsonError | JsonNull | JsonNumber | JsonObject | JsonString = json.parse(src)
      if parsed is JsonError {
          std.io.println<string>(concat_3(label, ": error: ", JsonError(parsed).msg))
      } else {
          std.io.println<string>(concat_3(label, ": ", json.stringify((JsonArray | JsonBool | JsonNull | JsonNumber | JsonObject | JsonString)(parsed), 0)))
      }
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      snippet.show("null", "null")
      snippet.show("true", "true")
      snippet.show("false", "false")
      snippet.show("number", "42")
      snippet.show("neg", "-3.14")
      snippet.show("expo", "1.5e2")
      snippet.show("string", "\"hello\"")
      snippet.show("escaped", "\"a\\nb\\tc\\\"d\"")
      snippet.show("array", "[1, 2, 3]")
      snippet.show("nested", "[[1, 2], [\"x\", \"y\"]]")
      snippet.show("object", "{\"a\": 1, \"b\": true}")
      snippet.show("mixed", "{\"name\": \"vader\", \"version\": 0.1, \"flags\": [\"-O0\", \"-g\"]}")
      snippet.show("err: trailing", "42 garbage")
      snippet.show("err: bad bool", "tru")
      snippet.show("err: bad escape", "\"\\q\"")
      return 0
  }
  concat_3 :: fn(p0: string, p1: string, p2: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      c2: i64 = c1 +% std.core.byte_len(p2)
      buf: Buffer = std.core.new_byte_buffer(c2)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.intern_string(buf, c2)
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

