// A narrowed integer is a value of its range, and a local takes the type of its
// first value, a range included : past `n in Hour` with `n: i64`, `micros` must
// write the type it will hold (`micros: i64 = n * 3_600_000`), or `micros * 1000`
// would not fit the range of its first value. The same holds past a guard's
// narrowing (`is_morning`) and for a `u8` narrowed into `0..=10`. A bitwise
// operation names its width (`i64(n) << 40`). Values narrowed out of a `u32` and an
// `i32` add up as their ranges. A declared range follows the same rule :
// `next: i32 = h + 1` may later hold `next % 24`.

module "snippet"

import "std/io"

Hour :: Int in 0..=23

is_morning :: fn(h: Hour) -> bool = h < 12

main :: fn(argv: string[]) -> i32 {
    n: i64: argv.len() + 4
    if n !in Hour {
        return 1
    }
    micros: i64 = n * 3_600_000
    micros = micros * 1000
    if is_morning(n) {
        early: i64 = n * 1000
        early = early * 1_000_000
        println("early ${early}")
    }
    shifted :: i64(n) << 40
    b: u8: u8(argv.len()) + 7
    if b !in 0..=10 {
        return 2
    }
    count: u8 = b
    count += 1
    scaled: i32 = b * 1000
    scaled += 1
    wide: u32: u32(argv.len()) + 3
    signed: i32: i32(argv.len()) + 2
    if wide !in 0..=9 || signed !in 0..=9 {
        return 3
    }
    forward: i64 = wide + signed
    forward = forward * 1_000_000_000
    h: Hour: 23
    next: i32 = h + 1
    next = next % 24
    println("micros ${micros}, shifted ${shifted}, count ${count}, scaled ${scaled}")
    println("forward ${forward}, next ${next}")
    return 0
}
