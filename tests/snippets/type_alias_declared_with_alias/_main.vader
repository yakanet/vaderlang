// `@alias name :: <type>` declares a transparent type alias (without `@alias`, a
// primitive on the right makes a distinct type), and `@size_of` on the alias
// reads the aliased type.
//
// SPEC gives `@size_of(string)` as 4, the width of an interned atom id, and the
// comptime fold answers 4.

module "snippet"

import "std/console"

@alias byte_int    :: i32
@alias byte_long   :: i64
@alias byte_string :: string

main :: fn() -> i32 {
    println("size i32     = ${@size_of(byte_int)}")
    println("size i64     = ${@size_of(byte_long)}")
    println("size string  = ${@size_of(byte_string)}")
    return 0
}
