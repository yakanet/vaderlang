// _diag_fusion_recursive_generator — a generator that consumes itself.
//
// THE COMMITTED OUTPUT IS WRONG. The outer call is inlined; the recursive call,
// met inside its own inlined body, is not, and takes the lazy path. That path
// loses a local declared in an `if` after a `yield` — its own defect — and traps
// after `v=3 v=2`. The expected output is `v=3 v=2 v=1 done`.

module "snippet"

import "std/io"

countdown :: fn(n: i32) -> Iterator<i32> {
    if n > 0 {
        yield n
        for x in countdown(n - 1) {
            yield x
        }
    }
}

main :: fn() -> i32 {
    for v in countdown(3) {
        println("v=${v}")
    }
    println("done")
    return 0
}
