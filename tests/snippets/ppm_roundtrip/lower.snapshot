# Lower

## snippet
  snippet.main :: fn() -> i32 {  // snippet$main
      path: string = concat_2(std.io.temp_dir(), "/vader_ppm_roundtrip.ppm")
      px: u8[] = [u8(0), u8(128), u8(255), u8(16), u8(32), u8(48), u8(195), u8(40), u8(169), u8(127), u8(1), u8(254)] :u8[]
      img: Ppm = Ppm {
          .width = u32(2),
          .height = u32(2),
          .maxval = u32(255),
          .pixels = px,
      }
      enc: PpmError | u8[] = images.ppm.encode(img)
      if enc is PpmError {
          std.io.println<string>("encode failed")
          return 1
      }
      wr: IOError | null = std.io.write_file_bytes(path, u8[](enc))
      if wr is Error {
          std.io.println<string>(concat_5("write failed: ", @vcall(std.core.Error.message, Error(wr)), " path=[", path, "]"))
          return 1
      }
      raw: IOError | u8[] = std.io.read_file_bytes(path, i64(16777216))
      if raw is Error {
          std.io.println<string>(concat_2("read failed: ", @vcall(std.core.Error.message, Error(raw))))
          return 1
      }
      dec: Ppm | PpmError = images.ppm.decode(u8[](raw))
      if dec is PpmError {
          std.io.println<string>("decode failed")
          return 1
      }
      ok: bool = (((Ppm(dec).width == u32(2)) && (Ppm(dec).height == u32(2))) && (Ppm(dec).maxval == u32(255))) && (@array.len(Ppm(dec).pixels) == i64(12))
      {
          i: i64 = 0
          __for_hi_0: i64 = @array.len(Ppm(dec).pixels)
          for i < __for_hi_0 {
              if Ppm(dec).pixels[i] != px[i] {
                  ok = false
              }
          } @step {
              i = i +% i64(1)
          }
      }
      std.io.println<string>(images.ppm.Ppm.to_string(Ppm(dec)))
      if ok {
          std.io.println<string>("OK")
      } else {
          std.io.println<string>("MISMATCH")
      }
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  concat_5 :: fn(p0: string, p1: string, p2: string, p3: string, p4: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      c2: i64 = c1 +% std.core.byte_len(p2)
      c3: i64 = c2 +% std.core.byte_len(p3)
      c4: i64 = c3 +% std.core.byte_len(p4)
      buf: Buffer = std.core.new_byte_buffer(c4)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.write_string(buf, c2, p3)
      std.core.Buffer.write_string(buf, c3, p4)
      std.core.Buffer.intern_string(buf, c4)
  }

