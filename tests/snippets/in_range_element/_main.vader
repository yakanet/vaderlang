// `x in lo..=hi` types a literal range's bounds as `x`: over an `i64` they reach
// past `i32`, over a `u8` a char bound lands as a byte, over a distinct they are
// its backing's. A literal array takes the element's type the same way. A free
// element takes the container's type, an `i64` on a `Range<i64>` or an `i64[]`.
module "snippet"

import "std/io"

Meters :: i64

wide :: fn(n: i64) -> bool = n in 5_000_000_000..=6_000_000_000

byte :: fn(b: u8) -> bool = b in 'a'..='z' || b in 200..=255

near :: fn(m: Meters) -> bool = m in 0..=9 && m !in 10..<20

blank :: fn(b: u8) -> bool = b in [' ', '\t']

listed :: fn(n: usize, m: Meters) -> bool = n in [1, 2] && m in [3, 4]

main :: fn() -> i32 {
    r: Range<i64>: 0..<5_000_000_000
    xs: i64[]: [5_000_000_000, 7]
    println("${wide(5_500_000_000)} ${wide(1_500_000_000)}")
    println("${byte('q')} ${byte(255)} ${byte(100)}")
    println("${near(Meters(5))} ${near(Meters(15))}")
    println("${blank(' ')} ${blank('x')} ${listed(2, Meters(3))} ${listed(3, Meters(3))}")
    println("${4_000_000_000 in r} ${6_000_000_000 in r} ${5_000_000_000 in xs} ${7 in xs}")
    return 0
}
