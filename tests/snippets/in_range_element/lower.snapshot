  snippet.wide :: fn(n: i64) -> bool {  // snippet$wide
      (i64(5000000000) <= n) && (n <= i64(6000000000))
  }
  snippet.byte :: fn(b: u8) -> bool {  // snippet$byte
      ((u8(97) <= b) && (b <= u8(122))) || ((u8(200) <= b) && (b <= u8(255)))
  }
  snippet.near :: fn(m: Meters) -> bool {  // snippet$near
      ((i64(0) <= m) && (m <= i64(9))) && (!((i64(10) <= m) && (m < i64(20))))
  }
  snippet.blank :: fn(b: u8) -> bool {  // snippet$blank
      std.core.u8[].contains([u8(32), u8(9)] :u8[], b)
  }
  snippet.is_digit :: fn(c: char) -> bool {  // snippet$is_digit
      ('0' <= c) && (c <= '9')
  }
  snippet.is_alpha :: fn(c: char) -> bool {  // snippet$is_alpha
      (('a' <= c) && (c <= 'z')) || (('A' <= c) && (c <= 'Z'))
  }
  snippet.Bag :: struct { items: i64[] }  // snippet$Bag
  snippet.Bag.contains :: fn(self: Bag, value: i64) -> bool {  // snippet$Bag$std_core$Contains$contains
      std.core.i64[].contains(self.items, value)
  }
  snippet.DigitSet :: struct { bits: i32 }  // snippet$DigitSet
  snippet.DigitSet.contains :: fn(self: DigitSet, value: i32) -> bool {  // snippet$DigitSet$std_core$Contains$contains
      if (value < 0) || (value > 9) {
          return false
      }
      mask: i32 = 1 << value
      return (self.bits & mask) != 0
  }
  snippet.has_big_value :: fn(c: Contains<i64>) -> bool {  // snippet$has_big_value
      @vcall(std.core.Contains.contains, c, i64(4000000000))
  }
  snippet.listed :: fn(n: i64, m: Meters) -> bool {  // snippet$listed
      std.core.i64[].contains([i64(1), i64(2)] :i64[], n) && std.core.i64[].contains([i64(3), i64(4)] :i64[], m)
  }
