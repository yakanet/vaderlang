// fusion_consumer_break — a `break` in the consumer abandons every inlined
// instance: `flat_map` and `chain` under `find`, `flat_map` and `chain` under a
// `break`, `take`'s own `break` over `flat_map`, user generators with two
// `yield`s, a tail `yield`, a generator of a generator — and `break <var>` from an
// inner loop, out of `chain`, out of a user generator, and out of a fused loop
// around another one.
//
// Each line prints the chain consumed where it is written (fused), then the same
// chain bound to a local first (lazy: it runs as a state machine and is the
// reference). The two halves agree.

module "snippet"

import "std/io"
import "std/iter"

spread :: fn(x: i32) -> i32[] = [10 * x, 10 * x + 1]

over_ten :: fn(v: i32) -> bool = v > 10

above_one :: fn(v: i32) -> bool = v > 1

flat_map_find :: fn() -> void {
    fused :: [1, 2].flat_map(spread).find(over_ten) ?? -1
    it :: [1, 2].flat_map(spread)
    lazy :: it.find(over_ten) ?? -1
    println("flat_map.find: ${fused} | ${lazy}")
}

chain_find :: fn() -> void {
    fused :: [1, 2].chain([3, 4]).find(above_one) ?? -1
    it :: [1, 2].chain([3, 4])
    lazy :: it.find(above_one) ?? -1
    println("chain.find: ${fused} | ${lazy}")
}

flat_map_break :: fn() -> void {
    fused := 0
    for v in [1, 2].flat_map(spread) {
        fused += 1
        if v > 10 {
            break
        }
    }
    lazy := 0
    it :: [1, 2].flat_map(spread)
    for v in it {
        lazy += 1
        if v > 10 {
            break
        }
    }
    println("flat_map + break, visits: ${fused} | ${lazy}")
}

flat_map_take_calls :: fn() -> void {
    calls := 0
    counted :: (x: i32) -> {
        calls += 1
        return spread(x)
    }
    for _ in [1, 2, 3].flat_map(counted).take(1) {
    }
    fused :: calls
    calls = 0
    it :: [1, 2, 3].flat_map(counted).take(1)
    for _ in it {
    }
    println("flat_map.take(1), calls: ${fused} | ${calls}")
}

pairs :: fn(xs: i32[], ys: i32[]) -> Iterator<i32> {
    for i in 0..<xs.len() {
        yield xs[i]
        yield ys[i]
    }
}

two_yields_break :: fn() -> void {
    fused := 0
    for v in pairs([1, 2], [3, 4]) {
        fused += 1
        break
    }
    lazy := 0
    it :: pairs([1, 2], [3, 4])
    for v in it {
        lazy += 1
        break
    }
    println("two yields + break, visits: ${fused} | ${lazy}")
}

loop_then_tail :: fn() -> Iterator<i32> {
    for i in 0..<3 {
        yield i
    }
    yield 99
}

tail_yield_break :: fn() -> void {
    fused := ""
    for v in loop_then_tail() {
        fused = fused + " ${v}"
        break
    }
    lazy := ""
    it :: loop_then_tail()
    for v in it {
        lazy = lazy + " ${v}"
        break
    }
    println("loop then tail yield + break:${fused} |${lazy}")
}

inner_counts :: fn() -> Iterator<i32> {
    for i in 0..<3 {
        yield i
        println("  inner resumed after ${i}")
    }
}

outer_counts :: fn() -> Iterator<i32> {
    for y in inner_counts() {
        yield y * 10
    }
    yield 99
}

generator_of_generator :: fn() -> void {
    println("generator of generator, fused:")
    for v in outer_counts() {
        if v == 0 {
            continue
        }
        if v == 10 {
            break
        }
        println("  v=${v}")
    }
    println("generator of generator, lazy:")
    it :: outer_counts()
    for v in it {
        if v == 0 {
            continue
        }
        if v == 10 {
            break
        }
        println("  v=${v}")
    }
}

chain_break :: fn() -> void {
    fused := 0
    for x in [1, 2].chain([3, 4]) {
        if x == 2 {
            break
        }
        fused += x
    }
    lazy := 0
    it :: [1, 2].chain([3, 4])
    for x in it {
        if x == 2 {
            break
        }
        lazy += x
    }
    println("chain + break, sum: ${fused} | ${lazy}")
}

chain_break_by_name :: fn() -> void {
    fused := 0
    for x in [1, 2].chain([3, 4]) {
        for y in [10, 20] {
            if x == 2 {
                break x
            }
            fused += y
        }
    }
    lazy := 0
    it :: [1, 2].chain([3, 4])
    for x in it {
        for y in [10, 20] {
            if x == 2 {
                break x
            }
            lazy += y
        }
    }
    println("chain + break x from an inner loop: ${fused} | ${lazy}")
}

nested_break_outer :: fn() -> void {
    fused := ""
    for a in [1, 2, 3].flat_map(spread) {
        for b in [7, 8, 9].take(2) {
            if a == 11 {
                break a
            }
            fused = fused + " ${a}:${b}"
        }
    }
    lazy := ""
    outer :: [1, 2, 3].flat_map(spread)
    for a in outer {
        inner :: [7, 8, 9].take(2)
        for b in inner {
            if a == 11 {
                break a
            }
            lazy = lazy + " ${a}:${b}"
        }
    }
    println("flat_map, then take(2) inside, break a:${fused} |${lazy}")
}

generator_break_by_name :: fn() -> void {
    fused := 0
    for v in pairs([1, 2], [3, 4]) {
        for w in [0, 1] {
            if v == 3 {
                break v
            }
            fused += 1
        }
    }
    lazy := 0
    it :: pairs([1, 2], [3, 4])
    for v in it {
        for w in [0, 1] {
            if v == 3 {
                break v
            }
            lazy += 1
        }
    }
    println("two yields + break v from an inner loop: ${fused} | ${lazy}")
}

main :: fn() -> i32 {
    flat_map_find()
    chain_find()
    flat_map_break()
    flat_map_take_calls()
    two_yields_break()
    tail_yield_break()
    generator_of_generator()
    chain_break()
    chain_break_by_name()
    nested_break_outer()
    generator_break_by_name()
    return 0
}
