# Lower

## snippet
  snippet.is_digit :: fn(c: char) -> bool {  // snippet$is_digit
      return ('0' <= c) && (c <= '9')
  }
  snippet.is_lower :: fn(c: char) -> bool {  // snippet$is_lower
      return ('a' <= c) && (c <= 'z')
  }
  snippet.is_alpha :: fn(c: char) -> bool {  // snippet$is_alpha
      return (('a' <= c) && (c <= 'z')) || (('A' <= c) && (c <= 'Z'))
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      if snippet.is_digit('5') {
          std.io.println<string>("5 is digit")
      }
      if !snippet.is_digit('a') {
          std.io.println<string>("a is not digit")
      }
      if snippet.is_digit('0') {
          std.io.println<string>("0 is digit")
      }
      if snippet.is_digit('9') {
          std.io.println<string>("9 is digit")
      }
      if !snippet.is_digit(':') {
          std.io.println<string>(": is not digit")
      }
      if snippet.is_lower('m') {
          std.io.println<string>("m is lower")
      }
      if !snippet.is_lower('M') {
          std.io.println<string>("M is not lower")
      }
      if snippet.is_alpha('z') {
          std.io.println<string>("z is alpha")
      }
      if snippet.is_alpha('Z') {
          std.io.println<string>("Z is alpha")
      }
      if !snippet.is_alpha('5') {
          std.io.println<string>("5 is not alpha")
      }
      n: i32 = 0
      {
          c: char = 'a'
          for c <= 'e' {
              n = n + 1
          } @step {
              c = c + char(1)
          }
      }
      std.io.println<string>({
          __buf_0: Buffer = std.core.new_byte_buffer(usize(34))
          __off_1: usize = 0
          __off_1 = std.core.write_string_at(__buf_0, __off_1, "a..=e count = ")
          __off_1 = std.core.write_int(__buf_0, __off_1, i64(n))
          std.core.finish_buffer(__buf_0, __off_1)
      } :string)
      m: i32 = 0
      {
          c: char = '0'
          for c < '5' {
              m = m + 1
          } @step {
              c = c + char(1)
          }
      }
      std.io.println<string>({
          __buf_2: Buffer = std.core.new_byte_buffer(usize(34))
          __off_3: usize = 0
          __off_3 = std.core.write_string_at(__buf_2, __off_3, "0..<5 count = ")
          __off_3 = std.core.write_int(__buf_2, __off_3, i64(m))
          std.core.finish_buffer(__buf_2, __off_3)
      } :string)
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.usize.new_buffer(c1)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

