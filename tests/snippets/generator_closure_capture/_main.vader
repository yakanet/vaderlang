// A generator local captured by a closure, read at every yield point : `base`
// is captured by the nested `addbase`. Nothing reassigns it, so the closure's
// env holds its value and the frame carries the closure across suspension (a
// reassigned one keeps a cell — `closure_sees_rebound_capture`). This used to be rejected
// with M5007 — now lifted; see `vader/lower/coroutine.vader::gb_add_field`.
module "snippet"

import "std/io"

gen :: fn(seed: i32) -> Iterator<i32> {
    base :: seed * 10
    addbase :: fn(x: i32) -> i32 { return x + base }
    for i in 0..<3 { yield addbase(i) }
}

main :: fn() -> i32 {
    it :: gen(1)
    total := 0
    for v in it { total = total + v }
    println("${total}")     // (0+10) + (1+10) + (2+10) = 33
    return 0
}
