// `break` out of a for-in over a MULTI-SOURCE combinator (`chain`).
//
// Fusion is push: each `yield` site gets its own copy of the consumer body, and
// `chain` has one loop per source. A `break` lowered as written leaves only the
// loop holding that copy, and the second source runs anyway — 61 (1 + 10 + 20 +
// 30) where the lazy iterator stops at 1 ; a labelled `break <var>` reaches only
// the loop carrying the label, and fails the same way. So such a `break` leaves
// the block around the whole `chain` instead. A `continue` is right as written:
// advancing the current source is what it means.

module "snippet"

import "std/io"
import "std/iter"

main :: fn() -> i32 {
    a :: [1, 2, 3]
    b :: [10, 20, 30]

    // break while still in the FIRST source: nothing after it may run.
    first := 0
    for x in a.chain(b) {
        if x == 2 {
            break
        }
        first += x
    }
    println("break in 1st source=${first} want=1")

    // break in the SECOND source: the first source is fully consumed.
    second := 0
    for x in a.chain(b) {
        if x == 20 {
            break
        }
        second += x
    }
    println("break in 2nd source=${second} want=16")

    // Labelled break by iteration variable — same requirement.
    labelled := 0
    for y in a.chain(b) {
        if y == 2 {
            break y
        }
        labelled += y
    }
    println("labelled break=${labelled} want=1")

    // `continue` never needed the guard: advancing the current source is right.
    kept := 0
    for x in a.chain(b) {
        if x == 2 || x == 20 {
            continue
        }
        kept += x
    }
    println("continue=${kept} want=44")

    // No break: no block around the chain.
    whole := 0
    for x in a.chain(b) {
        whole += x
    }
    println("no break=${whole} want=66")

    // A single-source combinator: the `break` lands on its one loop, as written.
    mapped := 0
    for x in a.map(v -> v * 10) {
        if x == 30 {
            break
        }
        mapped += x
    }
    println("map+break=${mapped} want=30")

    // A break in a NESTED loop targets that loop: the chain needs no block.
    nested := 0
    for x in a.chain(b) {
        for y in a {
            if y == 2 {
                break
            }
            nested += y
        }
    }
    println("nested break=${nested} want=6")
    return 0
}
