# Lower

## snippet
  snippet.all_literals :: fn() -> string {  // snippet$all_literals
      "abcdefghijklm"
  }
  snippet.mixed :: fn(x: string) -> string {  // snippet$mixed
      concat_3("ab", x, "cd")
  }
  snippet.with_empties :: fn(x: string) -> string {  // snippet$with_empties
      x
  }
  snippet.empty_inside_run :: fn() -> string {  // snippet$empty_inside_run
      "ef"
  }
  snippet.all_empty :: fn() -> string {  // snippet$all_empty
      ""
  }
  snippet.interpolated :: fn(x: string) -> string {  // snippet$interpolated
      concat_3("<", x, ">")
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      x: string = "Z"
      std.console.println<string>(snippet.all_literals())
      std.console.println<string>(snippet.mixed(x))
      std.console.println<string>(snippet.with_empties(x))
      std.console.println<string>(snippet.empty_inside_run())
      std.console.println<string>(concat_3("[", snippet.all_empty(), "]"))
      std.console.println<string>(snippet.interpolated(x))
      return 0
  }
  concat_3 :: fn(p0: string, p1: string, p2: string) -> string {
      c0: i64 = std_core$Intrinsic$byte_len(p0)
      c1: i64 = c0 +% std_core$Intrinsic$byte_len(p1)
      c2: i64 = c1 +% std_core$Intrinsic$byte_len(p2)
      buf: Buffer = std_core$Intrinsic$new_byte_buffer(c2)
      std_core$Intrinsic$buffer_write_string(buf, i64(0), p0)
      std_core$Intrinsic$buffer_write_string(buf, c0, p1)
      std_core$Intrinsic$buffer_write_string(buf, c1, p2)
      std_core$Intrinsic$buffer_intern_string(buf, c2)
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std_core$Intrinsic$byte_len(p0)
      c1: i64 = c0 +% std_core$Intrinsic$byte_len(p1)
      buf: Buffer = std_core$Intrinsic$new_byte_buffer(c1)
      std_core$Intrinsic$buffer_write_string(buf, i64(0), p0)
      std_core$Intrinsic$buffer_write_string(buf, c0, p1)
      std_core$Intrinsic$buffer_intern_string(buf, c1)
  }

