// Scalar locals: a local read twice, and one folded into a later expression,
// each through i32 add / sub / mul.

module "snippet"

import "std/io"

// A local read twice.
export tee_reuse :: fn(x: i32) -> i32 {
    total :: x + 1
    return total + total
}

// A local folded into the final expression, through i32 mul / sub.
export fold_chain :: fn(a: i32, b: i32) -> i32 {
    sum :: a + b
    return sum * 2 - a
}

main :: fn() -> i32 {
    println("${tee_reuse(4)} ${fold_chain(3, 5)}")
    return 0
}
