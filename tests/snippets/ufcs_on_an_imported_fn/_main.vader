// A UFCS call to a fn from another module, omitting its defaulted argument.
//
// The dispatch has to keep the declaration it picked: the imported table used to
// carry signatures only, so nothing at the call site could see that a parameter
// had a default, and the arity check reported T3003 on a call that was fine.
module "snippet"

import "std/io"

main :: fn() -> i32 {
    path :: "${temp_dir()}/vader_ufcs_import_probe"
    wrote :: write_file_string(path, "0123456789")
    if wrote is IOError {
        println("setup failed: ${wrote.msg}")
        return 1
    }
    // Defaulted: the ceiling comes from the declaration, in the other module.
    r :: path.read_file_string()
    if r is string {
        println("defaulted: ${r.len()} bytes")
    }
    // Explicit, then named: both through the same dispatch.
    bound :: path.read_file_string(4)
    if bound is IOError {
        println("bound 4:   ${bound.msg}")
    }
    named :: path.read_file_string(max_bytes = 4)
    if named is IOError {
        println("named 4:   ${named.msg}")
    }
    removed :: remove_file(path)
    if removed is IOError {
        println("cleanup failed: ${removed.msg}")
    }
    return 0
}
