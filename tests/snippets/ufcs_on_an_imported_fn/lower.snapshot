  snippet.main :: fn() -> i32 {  // snippet$main
      path: string = concat_2(std.env.temp_dir(), "/vader_ufcs_import_probe")
      wrote: IOError | null = std.fs.write_file(path, "0123456789")
      if wrote is IOError {
          std.console.println<string>(concat_2("setup failed: ", IOError(wrote).msg))
          return 1
      }
      r: IOError | string = std.fs.read_file_string(path, i64(16777216))
      if r is string {
          std.console.println<string>({
              __buf_0: Buffer = std.core.new_byte_buffer(i64(37))
              __off_1: i64 = 0
              __off_1 = std.core.write_string_at(__buf_0, __off_1, "defaulted: ")
              __off_1 = std.core.write_int(__buf_0, __off_1, std.core.len(string(r)))
              __off_1 = std.core.write_string_at(__buf_0, __off_1, " bytes")
              std.core.finish_buffer(__buf_0, __off_1)
          } :string)
      }
      bound: IOError | string = std.fs.read_file_string(path, i64(4))
      if bound is IOError {
          std.console.println<string>(concat_2("bound 4:   ", IOError(bound).msg))
      }
      named: IOError | string = std.fs.read_file_string(path, i64(4))
      if named is IOError {
          std.console.println<string>(concat_2("named 4:   ", IOError(named).msg))
      }
      removed: IOError | null = std.fs.remove(path, RemoveOptions { .recursive = false, .force = false })
      if removed is IOError {
          std.console.println<string>(concat_2("cleanup failed: ", IOError(removed).msg))
      }
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  concat_3 :: fn(p0: string, p1: string, p2: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      c2: i64 = c1 +% std.core.byte_len(p2)
      buf: Buffer = std.core.new_byte_buffer(c2)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.intern_string(buf, c2)
  }

