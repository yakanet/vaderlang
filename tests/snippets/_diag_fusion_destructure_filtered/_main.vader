// _diag_fusion_destructure_filtered — `for [i, x] in xs.enumerate().filter(p)`:
// the fused loop destructures an element whose type fell back to the erased one.
//
// THE COMMITTED OUTPUT IS WRONG. The lazy line runs first; the fused loop
// then reaches `unreachable`, the destructure of an element typed `Any`.
// Natively the lazy half crashes too, the lazy path's own defect, so only the
// VM output is pinned.

module "snippet"

import "std/io"
import "std/iter"

not_twenty :: fn(p: [usize, i32]) -> bool {
    [_, x] :: p
    return x != 20
}

main :: fn() -> i32 {
    lazy := ""
    it :: [10, 20, 30].enumerate().filter(not_twenty)
    for [i, x] in it {
        lazy = lazy + " ${i}:${x}"
    }
    println("lazy enumerate.filter:${lazy}")
    fused := ""
    for [i, x] in [10, 20, 30].enumerate().filter(not_twenty) {
        fused = fused + " ${i}:${x}"
    }
    println("fused enumerate.filter:${fused}")
    return 0
}
