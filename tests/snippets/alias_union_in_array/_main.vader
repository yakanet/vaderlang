// Cross-module type-alias unions in array slots. `V[]` in a fn-param or
// local-let position must expand the alias outside the defining module
// too: a consumer module sees `?[]` if the implicit-type-alias
// `Pet :: Cat | Dog` is declared in the same typecheck phase as the
// consumer's fn signatures, since the alias is then not registered yet
// when the param type is lowered.
//
// The typecheck registers the aliases first (`register_aliases`): every
// `T :: …` is registered project-wide before any fn signature gets
// lowered.

module "snippet"

import "std/io"
import "snippet/types"

push_pet :: fn(arr: Pet[], p: Pet) -> void {
    arr.push(p)
}

describe :: fn(p: Pet) -> string {
    return match p {
        is Cat -> "cat ${p.name}"
        is Dog -> "dog ${p.name}"
    }
}

main :: fn() -> i32 {
    pets: Pet[]: []
    push_pet(pets, Cat { .name = "Whiskers" })
    push_pet(pets, Dog { .name = "Rex" })
    for p in pets {
        println(describe(p))
    }
    return 0
}
