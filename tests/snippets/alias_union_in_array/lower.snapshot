# Lower

## snippet
  snippet.push_pet :: fn(arr: (Cat | Dog)[], p: Cat | Dog) -> void {  // snippet$push_pet
      @array.push(arr, p)
  }
  snippet.describe :: fn(p: Cat | Dog) -> string {  // snippet$describe
      return {
          if p is Cat {
              concat_2("cat ", Cat(p).name)
          } else if p is Dog {
              concat_2("dog ", Dog(p).name)
          } else {
              @unreachable("non-exhaustive match (T3013 should have caught this)")
          } :string
      } :string
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      pets: (Cat | Dog)[] = [] :(Cat | Dog)[]
      snippet.push_pet(pets, Cat { .name = "Whiskers" })
      snippet.push_pet(pets, Dog { .name = "Rex" })
      {
          __for_arr_0: (Cat | Dog)[] = pets
          __for_len_1: i64 = @array.len(__for_arr_0)
          __for_i_2: i64 = 0
          for __for_i_2 < __for_len_1 {
              p: Cat | Dog = __for_arr_0[__for_i_2]
              std.io.println<string>(snippet.describe(p))
          } @step {
              __for_i_2 = __for_i_2 +% i64(1)
          }
      }
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.usize.new_buffer(usize(c1))
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

