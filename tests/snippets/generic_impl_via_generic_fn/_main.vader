// Regression guard: a generic struct's trait impl must be materialised even
// when the struct is constructed ONLY inside a generic fn's body. Such an
// instance (`Box<i32>` from `viagen<i32>`) isn't seen by the comptime harvest
// (which only saw the source-level `Box<T>`), so `lower_struct_lit` must queue
// it for impl-member materialisation: else `Source.pull` misses its vtable row
// at runtime.
module "snippet"

import "std/console"

Source :: trait<T> {
    pull :: fn(self) -> T
}

Box :: struct<T> { v: T }
Box<T> implements Source<T> {
    pull :: fn(self) -> T { return self.v }
}

viagen :: fn<T>(x: T) -> Source<T> = Box<T> { .v = x }

main :: fn() -> i32 {
    v :: viagen(5).pull()
    println("${v}")
    return v
}
