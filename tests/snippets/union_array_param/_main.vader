// An array element is valid ANYWHERE in a type union, not only as the first
// member. Regression: a member after `|` used to be parsed by a narrower path
// than the head, so `string | u8[]` failed to parse. The `is`-narrowing on the
// union works too.
module "snippet"

import "std/io"

byte_count :: fn(x: string | u8[]) -> usize {
    if x is string { return x.bytes().len() }
    return x.len()
}

main :: fn() -> i32 {
    a: u8[] = [1, 2, 3, 4]
    println("${byte_count("hi")} ${byte_count("hi".bytes())} ${byte_count(a)}")
    return 0
}
