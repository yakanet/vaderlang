    fn std.console.write_text  // std_console$write_text
  std/core
    fn std.core.Buffer.intern_string  // std_core$Buffer$ByteAccess$intern_string
    fn std.core.Buffer.write_string  // std_core$Buffer$ByteAccess$write_string
    struct std.core.Buffer  // std_core$Buffer
