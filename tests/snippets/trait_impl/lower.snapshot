# Lower

## snippet
  snippet.Point :: struct { x: f64, y: f64 }  // snippet$Point
  snippet.Point.to_string :: fn(self: Point) -> string {  // snippet$Point$Display$to_string
      return "point"
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      p: Point = Point { .x = 0.0, .y = 0.0 }
      std.console.println<string>(snippet.Point.to_string(p))
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  vtable snippet.Display.to_string for Point  snippet.Point.to_string  // snippet$Point$Display$to_string

## lowered in dependencies
  std/console
    fn std.console.println<string>  // std_console$println__string
    fn std.console.write  // std_console$write
