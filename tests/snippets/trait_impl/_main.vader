module "snippet"

import "std/io"

export Display :: trait {
    to_string :: fn(self) -> string
}

export Point :: struct {
    x: f64
    y: f64
}

Point implements Display {
    to_string :: fn(self) -> string {
        return "point"
    }
}

main :: fn() -> i32 {
    p :: Point { .x = 0.0, .y = 0.0 }
    println(p.to_string())
    return 0
}
