# Lower

## snippet
  snippet.is_non_id :: fn(c: char) -> bool {  // snippet$is_non_id
      if (c >= '0') && (c <= '9') {
          return false
      }
      if (c >= 'a') && (c <= 'z') {
          return false
      }
      if (c >= 'A') && (c <= 'Z') {
          return false
      }
      if c == '_' {
          return false
      }
      return true
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      std.io.println<string>(std.string.trim_suffix("foo.vader", ".vader"))
      std.io.println<string>(std.string.trim_suffix("foo.bar", ".vader"))
      std.io.println<string>(std.string.trim_prefix("std/io", "std/"))
      std.io.println<string>(std.string.trim_prefix("foo", "std/"))
      std.io.println<string>(std.string.replace_chars_where("std::io.print!", snippet.is_non_id, "_"))
      parts: string[] = std.string.split_where("  hello  world\tfoo\n bar  ", std.char.is_white_char)
      std.io.println<string>({
          __buf_0: Buffer = std.core.new_byte_buffer(i64(26))
          __off_1: i64 = 0
          __off_1 = std.core.write_string_at(__buf_0, __off_1, "count=")
          __off_1 = std.core.write_int(__buf_0, __off_1, @array.len(parts))
          std.core.finish_buffer(__buf_0, __off_1)
      } :string)
      n: i64 = @array.len(parts)
      i: i64 = 0
      for i < n {
          std.io.println<string>(parts[i])
          i = i + i64(1)
      }
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.usize.new_buffer(usize(c1))
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

