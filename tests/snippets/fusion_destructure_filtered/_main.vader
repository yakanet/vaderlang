// fusion_destructure_filtered — `for [i, x] in xs.enumerate().filter(p)`: the
// fused loop destructures each element of a layered chain, against the same
// chain bound lazily to a local first.

module "snippet"

import "std/io"
import "std/iter"

not_twenty :: fn(p: [usize, i32]) -> bool {
    [_, x] :: p
    return x != 20
}

main :: fn() -> i32 {
    lazy := ""
    it :: [10, 20, 30].enumerate().filter(not_twenty)
    for [i, x] in it {
        lazy = lazy + " ${i}:${x}"
    }
    println("lazy enumerate.filter:${lazy}")
    fused := ""
    for [i, x] in [10, 20, 30].enumerate().filter(not_twenty) {
        fused = fused + " ${i}:${x}"
    }
    println("fused enumerate.filter:${fused}")
    return 0
}
