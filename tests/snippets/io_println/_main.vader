// tests/snippets/io_println: `println` down to the host.
//
// Both instances (`println<string>`, `println<i32>`) are ordinary stdlib code
// that reaches the host through `call.import`: the `byte_len` and `bytes`
// intrinsics and the `write` extern from `<unistd.h>`. The native run must
// print what the VM prints.

module "snippet"

import "std/io"

main :: fn() -> i32 {
    println("hello")
    println(42)
    return 0
}
