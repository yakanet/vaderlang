  snippet.Square :: struct { side: i32 }  // snippet$Square
  snippet.classify :: fn(shape: Circle | Square) -> string {  // snippet$classify
      if (shape is Circle) && (Circle(shape).radius > 0) {
          return {
              __buf_0: Buffer = std.core.new_byte_buffer(i64(29))
              __off_1: i64 = 0
