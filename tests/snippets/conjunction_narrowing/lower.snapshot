              __off_1 = std.core.write_int(__buf_0, __off_1, i64(Circle(shape).radius))
              std.core.finish_buffer(__buf_0, __off_1)
          } :string
      }
      return "other"
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      std.io.println<string>(snippet.classify(Circle { .radius = 5 }))
      std.io.println<string>(snippet.classify(Square { .side = 3 }))
      std.io.println<string>(snippet.classify(Circle { .radius = 0 }))
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
