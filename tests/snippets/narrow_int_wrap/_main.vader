// A value of an integer class narrower than 32 bits is cut to its width wherever
// it is read — formatted, compared, pushed into a union, stored — on both
// backends: a narrowing cast, and an arithmetic result in the class
// (`u8 200 + 100` is 44). The values that must not fold come from `argv`.

module "snippet"

import "std/io"

add_u8 :: fn(a: u8, b: u8) -> u8 = a + b

main :: fn(argv: string[]) -> i32 {
    a :: u8(argv.len() + 199)
    b: u8: 100
    println("u8 sum: ${a + b}")
    println("u8 difference: ${b - a}")
    println("u8 product: ${a * 2}")
    println("u8 shift: ${a << 1}")
    println("u8 complement: ${~a}")
    println(if a + b == 44 { "compared sum: cut" } else { "compared sum: wide" })
    c: u8 = 200
    c += 100
    println("compound: ${c}")
    println("returned: ${add_u8(a, b)}")
    s :: i8(argv.len() + 126)
    println("i8 sum: ${s + 1}")
    println("i8 negation: ${-(s + 1)}")
    min :: s + 1
    println("i8 quotient: ${min / i8(argv.len() - 2)}")
    h :: u16(argv.len() + 65534)
    println("u16 sum: ${h + 1}")

    n :: i32(argv.len()) + 299
    stored :: u8(n)
    println("stored cast: ${stored}")
    println("u8 cast: ${u8(n)}")
    println("i8 cast: ${i8(n)}")
    println("u16 cast: ${u16(n + 65536)}")
    println("i16 cast: ${i16(n + 32768)}")
    wide :: i64(n) + 4294967296
    println("u32 of i64: ${u32(wide)}")
    println("u8 of i64: ${u8(wide)}")
    println("i8 of u8: ${i8(u8(n + 100))}")
    println("u16 of i8: ${u16(i8(n - 301))}")
    println(if u8(n) == 44 { "compared cast: cut" } else { "compared cast: wide" })
    cells: (u8 | string)[]!: []
    cells.push(u8(n))
    println("cast in a union: ${cells[0]}")
    return 0
}
