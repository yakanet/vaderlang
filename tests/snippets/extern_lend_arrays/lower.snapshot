  snippet.copy_bools :: fn(to: bool[], from: bool[], bytes: u64) -> CPointer  // snippet$copy_bools
  snippet.copy_chars :: fn(to: char[], from: char[], bytes: u64) -> CPointer  // snippet$copy_chars
  snippet.copy_f32s :: fn(to: f32[], from: f32[], bytes: u64) -> CPointer  // snippet$copy_f32s
  snippet.copy_f64s :: fn(to: f64[], from: f64[], bytes: u64) -> CPointer  // snippet$copy_f64s
  snippet.to_wide :: fn(to: u32[], from: string, count: u64) -> u64  // snippet$to_wide
  snippet.main :: fn() -> i32 {  // snippet$main
      bools: bool[] = [false, false, false] :bool[]
      snippet.copy_bools(bools, [true, false, true] :bool[], u64(3))
      std.console.println<string>(std.core.bool[].to_string(bools))
      chars: char[] = ['-', '-'] :char[]
      snippet.copy_chars(chars, ['\u{e9}', 'z'] :char[], u64(8))
      std.console.println<string>(std.core.char[].to_string(chars))
      singles: f32[] = [f32(0.0), f32(0.0)] :f32[]
      snippet.copy_f32s(singles, [f32(1.5), f32(-2.25)] :f32[], u64(8))
      std.console.println<string>(std.core.f32[].to_string(singles))
      doubles: f64[] = [0.0, 0.0] :f64[]
      snippet.copy_f64s(doubles, [3.5, -0.125] :f64[], u64(16))
      std.console.println<string>(std.core.f64[].to_string(doubles))
      std.console.println<string>({
          __buf_0: Buffer = std.core.new_byte_buffer(i64(20))
          __off_1: i64 = 0
          __off_1 = std.core.write_unsigned(__buf_0, __off_1, snippet.to_wide([] :u32[], "abc", u64(0)))
          std.core.finish_buffer(__buf_0, __off_1)
      } :string)
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

