module "snippet"

import "std/io"

export classify :: fn(x: i32 | string | null) -> string {
    return match x {
        is i32 if x > 0 -> "positive"
        is i32 -> "non-positive"
        is string -> x
        is null -> "nothing"
    }
}

main :: fn() -> i32 {
    println("${classify(5)} ${classify(-1)} ${classify("hi")} ${classify(null)}")
    return 0
}
