// An `if` condition that STARTS with `(` but continues with an infix operator
// parses as the whole expression: `(n + 1) % 4 == 0` is one condition, not the
// group `(n + 1)` followed by stray tokens. A leading `(` is an ordinary
// parenthesised primary, and a struct literal is allowed inside it.
module "snippet"

import "std/io"

Point :: struct { x: i32 }

main :: fn() -> i32 {
    n :: 7
    if (n + 1) % 4 == 0 { println("paren subexpr cond") }   // (7+1)%4 == 0 -> true
    if (n > 3) { println("c-style paren cond") }            // still works
    if n > 3 { println("bare cond") }                       // still works
    if (Point { .x = 5 }).x > 0 { println("struct-lit-in-paren cond") }
    return 0
}
