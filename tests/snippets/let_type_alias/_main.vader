// `t :: <type-expr>` inside a fn body is a local type alias: it takes no
// runtime slot, and type-position uses (`@size_of(t)`) read the aliased type.
// A primitive, a union and an array type are covered. A type picked by a
// conditional (`t :: if c { i32 } else { i64 }`) is T3035.

module "snippet"

import "std/io"

main :: fn() -> i32 {
    t          :: i32
    big_t      :: i64
    union_t    :: i32 | string
    array_t    :: i32[]

    println("size i32      = ${@size_of(t)}")
    println("size i64      = ${@size_of(big_t)}")
    println("size union    = ${@size_of(union_t)}")
    println("size array    = ${@size_of(array_t)}")
    return 0
}
