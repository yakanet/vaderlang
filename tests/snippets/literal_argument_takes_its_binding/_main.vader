// A free literal handed to a generic fn takes the type the call binds its
// parameter to, whichever argument binds it and whatever the call's spelling:
// with `x: i64`, `pick(1, x)` and `1.pick(x)` both instantiate `pick` at `i64`,
// so `x` comes back whole. A method-syntax call binds like the free call, from
// the receiver and the arguments together.
module "snippet"

import "std/io"

Cfg :: struct {
    n: i32
}

CFG :: Cfg { .n = 1 }

pick :: fn<T>(a: T, b: T) -> T = b

first :: fn<T>(a: T, b: T) -> T = a

main :: fn() -> i32 {
    x: i64: 9000000000
    println("${pick(1, x)} ${1.pick(x)} ${x.pick(2)} ${first(3, x)}")
    local: Cfg!: Cfg { .n = 2 }
    println("${local.pick(CFG).n} ${CFG.pick(local).n} ${pick(local, CFG).n}")
    return 0
}
