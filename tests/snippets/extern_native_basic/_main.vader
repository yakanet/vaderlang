/// `@extern` ABI smoke test — wires Vader signatures to real C symbols.
/// Three foreign symbols : `add_i32` from the adjacent `helper.c`, and `strlen`
/// and `strnlen` from libc (overridden via the decorator string arg). Neither
/// libc one names its header, so its prototype is synthesised, its `size_t`
/// spelled with `@c_type` on the result and on the parameter. The
/// native test runner pre-compiles `helper.c` → `helper.o` and links
/// it into the binary ; the VM reaches both symbols through `dlsym` on the
/// running process instead, so it exercises a different path to the same call.
module "snippet"

import "std/io"

@extern add_i32 :: fn(a: i32, b: i32) -> i32
@c_type("size_t")
@extern("strlen")
c_strlen :: fn(s: string) -> u64

@c_type("size_t")
@extern("strnlen")
c_strnlen :: fn(s: string, @c_type("size_t") max: u64) -> u64

main :: fn() -> i32 {
    sum :: add_i32(40, 2)
    n :: c_strlen("hello, world")
    bounded :: c_strnlen("hello, world", 5)
    println("add=${sum} strlen=${n} strnlen=${bounded}")
    return 0
}
