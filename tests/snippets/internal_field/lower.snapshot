      c: Counter = Counter { .label = "hits", .count = 0 }
      snippet.bump(c)
      snippet.bump(c)
      snippet.bump(c)
      std.io.println<string>({
          __p_0: string = c.label
          __buf_1: Buffer = std.core.new_byte_buffer(i64(22) +% std.core.byte_len(__p_0))
          __off_2: i64 = 0
          __off_2 = std.core.write_string_at(__buf_1, __off_2, __p_0)
          __off_2 = std.core.write_string_at(__buf_1, __off_2, ": ")
          __off_2 = std.core.write_int(__buf_1, __off_2, c.count)
          std.core.finish_buffer(__buf_1, __off_2)
      } :string)
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
