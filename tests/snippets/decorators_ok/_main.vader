module "snippet"

@extern("env", "console_log")
export log :: fn(ptr: i32, len: i32)

@test
export test_log :: fn() {
    log(0, 0)
}

// `log` binds `console_log` of library `env`, which no native build links, so
// `main` does not call it: running shows the decorated declarations build.
main :: fn() -> i32 = 0
