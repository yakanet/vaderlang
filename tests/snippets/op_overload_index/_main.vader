// `a[i]` (read) and `a[i] = v` (write) on a struct dispatch through its
// `Index<I, T>` / `IndexSet<I, T>` impls, here with a `string` key: `Cell` is
// a tiny key-value store. Both forms lower to direct calls to `at` / `set_at`.

module "snippet"

import "std/io"

Cell :: struct { keys: string[], vals: i32[] }

Cell implements Index<string, i32> {
    at :: fn(self, key: string) -> i32 {
        i := 0
        for k in self.keys {
            if k == key { return self.vals[i] }
            i += 1
        }
        return 0
    }
}

Cell implements IndexSet<string, i32> {
    set_at :: fn(self, key: string, v: i32) {
        i := 0
        for k in self.keys {
            if k == key {
                self.vals[i] = v
                return
            }
            i += 1
        }
        self.keys.push(key)
        self.vals.push(v)
    }
}

main :: fn() -> i32 {
    c :: Cell { .keys = [], .vals = [] }
    c["a"] = 10
    c["b"] = 20
    c["a"] = 100   // overwrite
    println("a=${c["a"]} b=${c["b"]} c=${c["c"]}")
    return 0
}
