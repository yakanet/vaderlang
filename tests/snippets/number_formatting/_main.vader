// Integers and floats written through the formats of `std/numbers`: one `NumberFormat`
// value fills both an `IntFormat` and a `DecimalFormat`, which spread it. A float is
// rounded on the digits its `Display` shows, so 2.675 rounds up.
module "snippet"

import "std/io"
import "std/numbers"

main :: fn() -> i32 {
    common :: NumberFormat { .separator = "_", .sign = .Always }
    println(1234567.format(IntFormat { ...common }))
    println(-42.format(IntFormat { .digits = 4 }))
    println(0xdeadbeef.format(IntFormat { .base = 16, .prefix = true, .uppercase = true }))
    println(@min(i64).format(IntFormat { .separator = "," }))
    println(@max(u64).format_unsigned(IntFormat { .base = 2, .separator = " ", .group = 8 }))
    println(1234.5.format(DecimalFormat { ...common, .decimals = 2 }))
    println(2.675.format(DecimalFormat { .decimals = 2 }))
    println(123456.0.format(DecimalFormat { .notation = .Scientific }))
    println(-0.04.format(DecimalFormat { .decimals = 1 }))
    println(1.0e16.to_fixed(2))
    return 0
}
