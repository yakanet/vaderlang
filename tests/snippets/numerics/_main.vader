module "snippet"

import "std/console"

a :: 42
b :: 1_000_000
c :: 0xFF
d :: 0xFF_FF
e :: 0b1010
f :: 0o755
g: i64: 42
h: u32: 100
i :: 3.14
j :: 1.5e-10
k: f32: 3.14
l: f64: 0.5

main :: fn() -> i32 {
    println("${a} ${b} ${c} ${d} ${e} ${f}")
    println("${g} ${h} ${i} ${j} ${k} ${l}")
    return 0
}
