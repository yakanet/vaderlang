module "snippet"

import "std/io"

// What a condition implies flows through `!`, `&&` and `||` at any depth :
// the right operand of `||` sees the left's FALSE outcome, a `||` nested in a
// `&&` still narrows the then-block, and `!(a || b)` narrows to what neither
// operand matched.

P :: struct { a: i32 }

A :: struct { n: i32 }
B :: struct { n: i32 }
C :: struct { s: string }

// `y.a` type-checks : the right operand runs only when `y == null` was false.
null_or_positive :: fn(y: P | null) -> bool = y == null || y.a > 0

// The then-block sees `y` as `A | B`.
first_two :: fn(y: A | B | C, p: bool) -> i32 {
    if (y is A || y is B) && p {
        return y.n
    }
    return 0
}

// The then-block sees `y` as `C`.
neither :: fn(y: A | B | C) -> string {
    if !(y is A || y is B) {
        return y.s
    }
    return "-"
}

main :: fn() -> i32 {
    println("${null_or_positive(null)} ${null_or_positive(P { .a = 2 })} ${null_or_positive(P { .a = -1 })}")
    println("${first_two(A { .n = 7 }, true)} ${first_two(B { .n = 8 }, true)} ${first_two(C { .s = "c" }, true)}")
    println("${neither(C { .s = "c" })} ${neither(A { .n = 1 })}")
    return 0
}
