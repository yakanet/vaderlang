// Codepoint indexing past the end of a string traps on BOTH backends: the walk
// behind `s[i]` (`std/core/utf8.vader`) stops at the string's length, and reading
// the byte there raises `byte index out of bounds`. The VM once baked U+0000 on an
// out-of-range index, silently diverging from native code.

module "snippet"

import "std/io"

main :: fn() -> i32 {
    word :: "abc"
    idx: usize: 10
    ch :: word[idx]
    println("${i32(ch)}")
    return 0
}
