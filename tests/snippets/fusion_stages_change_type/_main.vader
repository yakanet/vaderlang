// fusion_stages_change_type — two inlined `map`s whose elements have different
// types, `[1, 22, 333].map(to_text).map(text_len)`: each keeps its own slots.
//
// The lazy half, the reference, prints first; the fused half must print the
// same.

module "snippet"

import "std/io"
import "std/iter"

to_text :: fn(x: i32) -> string = "${x}"

text_len :: fn(s: string) -> usize = s.byte_len()

main :: fn() -> i32 {
    lazy := ""
    it :: [1, 22, 333].map(to_text).map(text_len)
    for n in it {
        lazy = lazy + " ${n}"
    }
    println("lazy:${lazy}")
    fused := ""
    for n in [1, 22, 333].map(to_text).map(text_len) {
        fused = fused + " ${n}"
    }
    println("fused:${fused}")
    return 0
}
