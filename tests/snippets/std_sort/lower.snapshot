## snippet
  snippet.i32_lt :: fn(a: i32, b: i32) -> bool {  // snippet$i32_lt
      return a < b
  }
  snippet.i32_gt :: fn(a: i32, b: i32) -> bool {  // snippet$i32_gt
      return a > b
  }
  snippet.print_ints :: fn(arr: i32[]) -> void {  // snippet$print_ints
      sb: string = ""
      i: i32 = 0
      {
          __for_arr_0: i32[] = arr
          __for_len_1: i64 = @array.len(__for_arr_0)
          __for_i_2: i64 = 0
          for __for_i_2 < __for_len_1 {
              x: i32 = __for_arr_0[__for_i_2]
              if i > 0 {
                  sb = concat_2(sb, ", ")
              }
              sb = {
                  __p_3: string = sb
                  __buf_4: Buffer = std.core.new_byte_buffer(i64(20) +% std.core.byte_len(__p_3))
                  __off_5: i64 = 0
                  __off_5 = std.core.write_string_at(__buf_4, __off_5, __p_3)
                  __off_5 = std.core.write_int(__buf_4, __off_5, i64(x))
                  std.core.finish_buffer(__buf_4, __off_5)
              }
              i = i + 1
          } @step {
              __for_i_2 = __for_i_2 +% i64(1)
          }
      }
      std.io.println<string>(sb)
  }
  snippet.print_strings :: fn(arr: string[]) -> void {  // snippet$print_strings
      sb: string = ""
      i: i32 = 0
      {
          __for_arr_0: string[] = arr
          __for_len_1: i64 = @array.len(__for_arr_0)
          __for_i_2: i64 = 0
          for __for_i_2 < __for_len_1 {
              s: string = __for_arr_0[__for_i_2]
              if i > 0 {
                  sb = concat_2(sb, ", ")
              }
              sb = concat_2(sb, s)
              i = i + 1
          } @step {
              __for_i_2 = __for_i_2 +% i64(1)
          }
      }
      std.io.println<string>(sb)
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      one: i32[] = std.sort.sort<i32>([42] :i32[], snippet.i32_lt)
      snippet.print_ints(one)
      asc: i32[] = std.sort.sort<i32>([1, 2, 3, 4, 5] :i32[], snippet.i32_lt)
      snippet.print_ints(asc)
      desc: i32[] = std.sort.sort<i32>([5, 4, 3, 2, 1] :i32[], snippet.i32_lt)
      snippet.print_ints(desc)
      rand: i32[] = std.sort.sort<i32>([3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5] :i32[], snippet.i32_lt)
      snippet.print_ints(rand)
      descending: i32[] = std.sort.sort<i32>([1, 2, 3, 4, 5] :i32[], snippet.i32_gt)
      snippet.print_ints(descending)
      big: i32[] = std.sort.sort<i32>([10, 20, 5, 15, 25, 1, 30, 8, 12, 18, 3, 27, 22, 7, 14, 11, 19, 6, 24, 16, 9, 21, 13, 4, 26, 2, 17, 23, 28, 29] :i32[], snippet.i32_lt)
      snippet.print_ints(big)
      strs: string[] = std.sort.sort<string>(["banana", "apple", "cherry", "date"] :string[], std.string.compare_ascending)
      snippet.print_strings(strs)
      input: i32[] = [3, 1, 2] :i32[]
      out: i32[] = std.sort.sort<i32>(input, snippet.i32_lt)
      snippet.print_ints(input)
      snippet.print_ints(out)
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

