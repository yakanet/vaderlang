  storage
    const NEG_INF: f64  inline
    const NOT_A_NUM: f64  inline
    const POS_INF: f64  inline
  snippet.POS_INF: f64: inf  // snippet$POS_INF
  snippet.NEG_INF: f64: -inf  // snippet$NEG_INF
  snippet.NOT_A_NUM: f64: nan  // snippet$NOT_A_NUM
  snippet.main :: fn() -> i32 {  // snippet$main
      arr: f64[] = [inf, -inf] :f64[]
      std.console.println<string>(concat_9(std.core.f64.to_string(inf), " ", std.core.f64.to_string(-inf), " ", std.core.f64.to_string(nan), " ", std.core.f64.to_string(arr[0]), " ", std.core.f64.to_string(arr[1])))
      return 0
  }
  concat_9 :: fn(p0: string, p1: string, p2: string, p3: string, p4: string, p5: string, p6: string, p7: string, p8: string) -> string {
      c0: i64 = std_core$Intrinsic$byte_len(p0)
      c1: i64 = c0 +% std_core$Intrinsic$byte_len(p1)
      c2: i64 = c1 +% std_core$Intrinsic$byte_len(p2)
      c3: i64 = c2 +% std_core$Intrinsic$byte_len(p3)
      c4: i64 = c3 +% std_core$Intrinsic$byte_len(p4)
      c5: i64 = c4 +% std_core$Intrinsic$byte_len(p5)
      c6: i64 = c5 +% std_core$Intrinsic$byte_len(p6)
      c7: i64 = c6 +% std_core$Intrinsic$byte_len(p7)
      c8: i64 = c7 +% std_core$Intrinsic$byte_len(p8)
      buf: Buffer = std_core$Intrinsic$new_byte_buffer(c8)
      std_core$Intrinsic$buffer_write_string(buf, i64(0), p0)
      std_core$Intrinsic$buffer_write_string(buf, c0, p1)
      std_core$Intrinsic$buffer_write_string(buf, c1, p2)
      std_core$Intrinsic$buffer_write_string(buf, c2, p3)
      std_core$Intrinsic$buffer_write_string(buf, c3, p4)
      std_core$Intrinsic$buffer_write_string(buf, c4, p5)
      std_core$Intrinsic$buffer_write_string(buf, c5, p6)
      std_core$Intrinsic$buffer_write_string(buf, c6, p7)
      std_core$Intrinsic$buffer_write_string(buf, c7, p8)
      std_core$Intrinsic$buffer_intern_string(buf, c8)
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std_core$Intrinsic$byte_len(p0)
      c1: i64 = c0 +% std_core$Intrinsic$byte_len(p1)
      buf: Buffer = std_core$Intrinsic$new_byte_buffer(c1)
      std_core$Intrinsic$buffer_write_string(buf, i64(0), p0)
      std_core$Intrinsic$buffer_write_string(buf, c0, p1)
      std_core$Intrinsic$buffer_intern_string(buf, c1)
  }

