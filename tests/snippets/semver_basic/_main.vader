// Smoke snippet for std/semver: exercises `parse`, `parse_range`,
// Display via `${v}` interpolation, `>` through `Comparable`, and
// the infix `in` operator dispatched through `Contains<Version>`.

module "snippet"

import "semver"
import "std/string"
import "std/io"

main :: fn() -> i32 {
    match ver :: parse("1.2.3-rc.1") {
        is Version    -> {
            println("${ver}")
            base :: parse_one("1.0.0")
            if ver > base { println("after 1.0.0") }
            match rg :: parse_range("^1.0.0") {
                is VersionRange -> {
                    target :: parse_one("1.5.0")
                    if target in rg { println("1.5.0 in ^1.0.0") }
                }
                is ParseError   -> {
                    eprintln("range err: ${rg.message()}")
                    return 1
                }
            }
        }
        is ParseError -> {
            eprintln("err: ${ver.message()}")
            return 1
        }
    }
    return 0
}

parse_one :: fn(s: string) -> Version {
    match v :: parse(s) {
        is Version    -> { return v }
        is ParseError -> {
            return Version { .major = 0, .minor = 0, .patch = 0 }
        }
    }
}
