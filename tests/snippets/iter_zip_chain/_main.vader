// `std/iter` combinators over arrays. `zip`, `chain` and `indexed` consumed by
// a `for` fuse into index loops (`chain` into two, one per array); `flat_map`
// bound to a local first runs as its state machine.

module "snippet"

import "std/io"
import "std/iter"

main :: fn() -> i32 {
    // `len` and `clone` on an array.
    nums :: [10, 20, 30]
    println("count=${nums.len()}")
    cloned :: nums.clone()
    println("clone[0]=${cloned[0]}")

    // zip — parallel arrays paired into tuples, stops at shorter length.
    keys :: ["a", "b", "c", "d"]
    vals :: [1, 2, 3]
    for [k, v] in zip(keys, vals) {
        println("${k}=${v}")
    }

    // chain — concatenate two streams, consumed directly (fuses to two loops).
    head :: [1, 2, 3]
    tail :: [4, 5]
    for x in chain(head, tail) {
        println("j=${x}")
    }

    // indexed — value + index pairs.
    fruits :: ["apple", "banana", "cherry"]
    for [f, i] in fruits.indexed() {
        println("${i}: ${f}")
    }

    // flat_map — each input expands to a sub-array.
    bursts :: flat_map([1, 2, 3], (x: i32) -> [x, x * 10])
    for n in bursts {
        println("b=${n}")
    }

    return 0
}
