// A C callback: the foreign callee receives the ADDRESS of a Vader function and
// calls it.
//
// What crosses is `&snippet_double_it`, the function's own emitted symbol, and
// not the `vader_fn_t` a fn VALUE would be (see `vader/core/bytecode/op::FnAddr`).
//
// A callback that is NOT the only argument (`apply_twice`) has its address land
// in a local SLOT rather than a C expression temp. That slot is a GC root: a
// fn-typed slot is a `ValType.Ref`, and `c_emit` puts every `Ref` slot in the
// frame's `raw[]`, where `vader_gc_scan_raw` reads the pointee's object header
// with no heap-membership check. A `.text` address has no header (its
// `hdr->forward` is machine code, never NULL), so the collector would
// overwrite the slot with garbage and the NEXT call would jump to it. `bump`
// therefore forces a collection from INSIDE the foreign call, and the loop runs
// the whole shape twice so a poisoned slot is used after it is clobbered.
//
// `helper.c` CALLS each callback and combines the results, so the committed
// `vm.snapshot` fails on a wrong address instead of passing quietly.

module "snippet"

import "std/io"
import "std/runtime"

double_it :: fn(x: i32) -> i32 = x * 2

bump :: fn(x: i32) -> i32 {
    collect()
    return x + 1
}

@extern call_twice :: fn(f: fn(i32) -> i32) -> i32

@extern apply_twice :: fn(base: i32, f: fn(i32) -> i32, scale: i32) -> i32

main :: fn() -> i32 {
    println("only argument: ${call_twice(double_it)}")
    total: i32 = 0
    for _r in 0..<2 {
        total += apply_twice(10, bump, 3)
    }
    println("argument in a slot, GC inside: ${total}")
    return 0
}
