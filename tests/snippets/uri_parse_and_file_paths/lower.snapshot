# Lower

## snippet
  snippet.main :: fn() -> i32 {  // snippet$main
      web: Uri | UriError = std.uri.parse_uri("HTTPS://Example.com:8443/a%7eb/c%2fd?q=1#top")
      if web is Uri {
          std.console.println<string>(std.uri.Uri.to_string(Uri(web)))
          std.console.println<string>(concat_4("path ", Uri(web).path, " decoded ", std.uri.decoded_path(Uri(web))))
      }
      file: Uri | UriError = std.uri.parse_uri("file:///tmp/100%25%20sure/%C3%A9t%C3%A9.txt")
      if file is Uri {
          std.console.println<string>(std.uri.Uri.to_string(Uri(file)))
          back: string | UriError = std.uri.to_path(Uri(file))
          if back is string {
              std.console.println<string>(concat_2("back ", string(back)))
          }
      }
      remote: Uri | UriError = std.uri.parse_uri("https://example.com/x")
      if remote is Uri {
          refused: string | UriError = std.uri.to_path(Uri(remote))
          if refused is UriError {
              std.console.println<string>(concat_2("refused: ", UriError(refused).msg))
          }
      }
      return 0
  }
  concat_4 :: fn(p0: string, p1: string, p2: string, p3: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      c2: i64 = c1 +% std.core.byte_len(p2)
      c3: i64 = c2 +% std.core.byte_len(p3)
      buf: Buffer = std.core.new_byte_buffer(c3)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.write_string(buf, c2, p3)
      std.core.Buffer.intern_string(buf, c3)
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  concat_3 :: fn(p0: string, p1: string, p2: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      c2: i64 = c1 +% std.core.byte_len(p2)
      buf: Buffer = std.core.new_byte_buffer(c2)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.intern_string(buf, c2)
  }

