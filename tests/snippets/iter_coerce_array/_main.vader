// Implicit `T[]` -> `Iterator<T>` coercion at three slot kinds: a call
// argument, a `let` with an explicit type annotation, and a `return` from a fn
// typed `Iterator<T>`. Without it the typecheck emits T3001.
//
// The coercion goes through the blanket `T[] implements<T> Into<Iterator<T>>`
// in `std/core`, whose `into` hands back the `array_iter` generator. `walk`
// below drives `next()` by hand, so the snapshots pin the step shape as well as
// the coercion.

module "snippet"

import "std/io"

walk :: fn(it: Iterator<i32>) -> i32 {
    sum := 0
    cont := true
    for cont {
        [v, c] :: it.next()
        if c == .Stop {
            cont = false
        } else {
            sum = sum + v
        }
    }
    return sum
}

make_iter :: fn() -> Iterator<i32> {
    arr :: [100, 200, 300]
    return arr   // Array → Iterator return coercion
}

main :: fn() -> i32 {
    // Call-arg coercion: [i32] flows into Iterator(i32) param.
    a :: walk([10, 20, 30])

    // Let coercion — both binding forms : `:` (immutable) and `=` (mutable).
    typed_iter_mut: Iterator<i32>: [1, 2, 3, 4]
    typed_iter_immut: Iterator<i32> : [5, 6, 7]
    b :: walk(typed_iter_mut) + walk(typed_iter_immut)

    // Return coercion: make_iter wraps its inner array on the way out.
    c :: walk(make_iter())

    println("a=${a} b=${b} c=${c}")
    return 0
}
