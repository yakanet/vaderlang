      } :string)
  }
  snippet.run_find :: fn(label: string, p: Pattern, input: string) -> void {  // snippet$run_find
      r: Match | null = regex.find(p, input)
      if r is Match {
          std.io.println<string>({
              __p_0: string = label
              __p_1: string = Match(r).groups[0]
              __buf_2: Buffer = std.core.new_byte_buffer(usize(44) +% (std.core.byte_len(__p_0) +% std.core.byte_len(__p_1)))
              __off_3: usize = 0
              __off_3 = std.core.write_string_at(__buf_2, __off_3, __p_0)
              __off_3 = std.core.write_string_at(__buf_2, __off_3, "=")
              __off_3 = std.core.write_unsigned(__buf_2, __off_3, u64(Match(r).start))
              __off_3 = std.core.write_string_at(__buf_2, __off_3, "..")
              __off_3 = std.core.write_unsigned(__buf_2, __off_3, u64(Match(r).end))
              __off_3 = std.core.write_string_at(__buf_2, __off_3, ":")
              __off_3 = std.core.write_string_at(__buf_2, __off_3, __p_1)
              std.core.finish_buffer(__buf_2, __off_3)
          } :string)
      } else {
