  snippet.run_match :: fn(label: string, p: Pattern, input: string) -> void {  // snippet$run_match
      std.io.println<string>({
          __p_0: string = label
          __buf_1: Buffer = std.core.new_byte_buffer(usize(6) +% std.core.byte_len(__p_0))
          __off_2: usize = 0
          __off_2 = std.core.write_string_at(__buf_1, __off_2, __p_0)
          __off_2 = std.core.write_string_at(__buf_1, __off_2, "=")
