  snippet.main :: fn() -> i32 {  // snippet$main
      p_lit: Pattern | RegexError = regex.compile("hello")
      if p_lit is Pattern {
          snippet.run_match("lit-exact", Pattern(p_lit), "hello")
          snippet.run_match("lit-partial", Pattern(p_lit), "hellox")
      }
      p_digits: Pattern | RegexError = regex.compile("\\d{3}-\\d{4}")
      if p_digits is Pattern {
          snippet.run_match("phone-good", Pattern(p_digits), "555-1234")
          snippet.run_match("phone-bad", Pattern(p_digits), "55-1234")
      }
      p_word: Pattern | RegexError = regex.compile("[a-z]+")
      if p_word is Pattern {
          snippet.run_find("first-word", Pattern(p_word), "abc def ghi")
          all: Match[] = regex.find_all(Pattern(p_word), "abc def ghi")
          std.io.println<string>({
              __buf_0: Buffer = std.core.new_byte_buffer(usize(31))
              __off_1: usize = 0
              __off_1 = std.core.write_string_at(__buf_0, __off_1, "word-count=")
              __off_1 = std.core.write_unsigned(__buf_0, __off_1, u64(@array.len(all)))
              std.core.finish_buffer(__buf_0, __off_1)
          } :string)
          i: usize = 0
          for i < @array.len(all) {
              std.io.println<string>({
                  __p_2: string = all[i].groups[0]
                  __buf_3: Buffer = std.core.new_byte_buffer(usize(27) +% std.core.byte_len(__p_2))
                  __off_4: usize = 0
                  __off_4 = std.core.write_string_at(__buf_3, __off_4, "word[")
                  __off_4 = std.core.write_unsigned(__buf_3, __off_4, u64(i))
                  __off_4 = std.core.write_string_at(__buf_3, __off_4, "]=")
                  __off_4 = std.core.write_string_at(__buf_3, __off_4, __p_2)
                  std.core.finish_buffer(__buf_3, __off_4)
              } :string)
              i = i + usize(1)
          }
      }
      p_anchor: Pattern | RegexError = regex.compile("^foo")
      if p_anchor is Pattern {
          snippet.run_find("anchor-hit", Pattern(p_anchor), "foo bar")
          snippet.run_find("anchor-miss", Pattern(p_anchor), "bar foo")
      }
      p_email: Pattern | RegexError = regex.compile("(\\w+)@(\\w+)\\.(\\w+)")
      if p_email is Pattern {
          r: Match | null = regex.find(Pattern(p_email), "contact user@domain.com please")
          if r is Match {
              std.io.println<string>(concat_2("email-match=", Match(r).groups[0]))
              std.io.println<string>(concat_2("email-user=", Match(r).groups[1]))
              std.io.println<string>(concat_2("email-host=", Match(r).groups[2]))
              std.io.println<string>(concat_2("email-tld=", Match(r).groups[3]))
          }
      }
      p_alt: Pattern | RegexError = regex.compile("cat|dog|bird")
      if p_alt is Pattern {
          snippet.run_match("alt-cat", Pattern(p_alt), "cat")
          snippet.run_match("alt-dog", Pattern(p_alt), "dog")
          snippet.run_match("alt-bird", Pattern(p_alt), "bird")
          snippet.run_match("alt-fish", Pattern(p_alt), "fish")
      }
      p_3a: Pattern | RegexError = regex.compile("a{3}")
      if p_3a is Pattern {
          snippet.run_match("3a-yes", Pattern(p_3a), "aaa")
          snippet.run_match("3a-no", Pattern(p_3a), "aa")
      }
      p_2to4: Pattern | RegexError = regex.compile("a{2,4}")
      if p_2to4 is Pattern {
          snippet.run_match("2to4-1", Pattern(p_2to4), "a")
          snippet.run_match("2to4-3", Pattern(p_2to4), "aaa")
          snippet.run_match("2to4-5", Pattern(p_2to4), "aaaaa")
      }
      p_swap: Pattern | RegexError = regex.compile("(\\w+) (\\w+)")
      if p_swap is Pattern {
          std.io.println<string>(concat_2("swap=", regex.replace_all(Pattern(p_swap), "Mathieu Broutin", "\$2 \$1")))
      }
      p_redact: Pattern | RegexError = regex.compile("\\d+")
      if p_redact is Pattern {
          std.io.println<string>(concat_2("redact=", regex.replace_all(Pattern(p_redact), "a1b22c333", "X")))
      }
      bad: Pattern | RegexError = regex.compile("[abc")
      if bad is RegexError {
          std.io.println<string>("bad-compile=caught")
      }
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.usize.new_buffer(c1)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  concat_3 :: fn(p0: string, p1: string, p2: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      c2: usize = c1 +% std.core.byte_len(p2)
      buf: Buffer = std.core.usize.new_buffer(c2)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.write_string(buf, c1, p2)
      std.core.Buffer.intern_string(buf, c2)
  }

