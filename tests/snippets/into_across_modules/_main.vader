// An impl declared in another module applies like a local one: the external
// impls go through the same registration as the module's own, which is what
// records the target-keyed `Into` entry and answers `+` on `Celsius`, a distinct
// type declared, extended and consumed over there.
module "snippet"

import "snippet/units"
import "std/io"

take :: fn(x: i32) -> i32 = x + 1

main :: fn() -> i32 {
    m :: Meters { .v = 41 }
    println("${take(m)}")
    println("${f64(warmer(Celsius(30.0)) + Celsius(0.5))}")
    return 0
}
