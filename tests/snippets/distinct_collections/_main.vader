// A newtype in collections and unions: an array of `UserId` stored as its
// backing, and a `UserId | null` narrowed by a null test. 10 + 20 + 12.

module "snippet"

UserId :: i64

sum_ids :: fn(ids: UserId[]) -> i32 {
    total := 0
    for id in ids {
        total = total + i32(i64(id))
    }
    return total
}

unwrap_or :: fn(x: UserId | null, fallback: i32) -> i32 {
    if x == null {
        return fallback
    }
    return i32(i64(x))
}

main :: fn() -> i32 {
    ids: UserId[]: [UserId(10), UserId(20)]
    present :: unwrap_or(UserId(12), -1)
    return sum_ids(ids) + present
}
