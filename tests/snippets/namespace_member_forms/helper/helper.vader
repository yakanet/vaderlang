// helper for the namespace_member_forms snippet: one export of each kind the
// caller reaches through its namespace alias (`H :: import "snippet/helper"`).

module "snippet/helper"

export MAX_RETRIES: i64: 3
export GREETING    :: "hi"

export Color :: enum {
    Red,
    Green,
    Blue,
}

export Meters :: i32

export triple :: fn(x: i32) -> i32 = x * 3
