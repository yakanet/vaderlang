// An integer type goes into any integer type holding every value it has, with no
// conversion written : a `u8` reading into an `i32` total, a `u32` timestamp into
// an `i64`, a byte into an `i64 | null` slot. Mixed operands compute
// in the integer holding the other, two branches join in it, and `min` on bytes
// takes the `i32` overload, the tightest holding them. The conversion holds on
// every path to a slot : a generic `T` bound to `i64`, an operator's impl, a
// destructuring assignment.
module "snippet"

import "std/io"
import "std/math"

Reading :: struct {
    level: i64
    at:    i64
}

total :: fn(readings: u8[]) -> i32 {
    sum: i32 = 0
    for r in readings {
        sum += r
    }
    return sum
}

offset :: fn(level: u8, base: i32) -> i32 = level - base

louder :: fn(a: u8, b: i32, first: bool) -> i32 {
    picked :: if first { a } else { b }
    return picked
}

last_seen :: fn(readings: u8[]) -> i64 | null {
    if readings.len() == 0 {
        return null
    }
    return readings[readings.len() - 1]
}

Tally :: struct {
    sum: i64
}

Tally implements Add<i64, Tally> {
    add :: fn(self, more: i64) -> Tally = Tally { .sum = self.sum + more }
}

later :: fn<T>(a: T, b: T) -> T = b

window :: fn(readings: u8[], stamp: u32) -> [u32, u8] = [stamp, readings[0]]

main :: fn(argv: string[]) -> i32 {
    readings: u8[]: [12, 250, 7]
    stamp: u32: 4_000_000_000
    println("total ${total(readings)}, offset ${offset(readings[1], 300)}")
    println("louder ${louder(readings[0], -3, true)} ${louder(readings[0], -3, false)}")
    r :: Reading { .level = readings[2], .at = stamp }
    println("reading ${r.level} at ${r.at}")
    slot: i64: stamp
    println("slot ${slot + readings.len()}")
    println("quietest ${min(readings[0], readings[2])}")
    println("later ${later(r.at, stamp)}, tally ${(Tally { .sum = 1 } + stamp).sum}")
    since: i64 = 0
    level: i32 = 0
    [since, level] = window(readings, stamp)
    println("window ${since} ${level}")
    seen :: last_seen(readings)
    if seen is i64 {
        println("last ${seen}")
    }
    return 0
}
