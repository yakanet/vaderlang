// Char literals and their escapes: plain ASCII (`'{'`, `'='`), `\n`, `\\` and
// `\'`, each read back as its codepoint through `i32(c)`, and `==` between two
// chars.

module "snippet"

import "std/io"

main :: fn() -> i32 {
    a :: '{'
    nl :: '\n'
    bs :: '\\'
    sq :: '\''
    println("a=${i32(a)}")          // 123
    println("nl=${i32(nl)}")        // 10
    println("bs=${i32(bs)}")        // 92
    println("sq=${i32(sq)}")        // 39
    b :: '='
    println("eq=${b == '='}")      // true
    return 0
}
