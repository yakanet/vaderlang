// `@fields(T)` exposes a struct's fields as a `Field[]` literal at lower time.
// Each entry carries the field name and its declared type reified as a runtime
// `type` value, which `@size_of` reads through the runtime `size_of.type` path.
// Two shapes: a non-generic struct, and a generic instance, whose substitution
// flows so that `Pair<string, i64>` reports `value` as 8 bytes, and each
// `string` field as 4, the width of its interned atom id, as the static fold
// answers (`comptime_type_alias`).

module "snippet"

import "std/io"

Point :: struct {
    x:     i32
    y:     i32
    label: string
}

Pair :: struct<K, V> {
    key:   K
    value: V
}

main :: fn() -> i32 {
    for f in @fields(Point) {
        println("${f.name} size=${@size_of(f.type)}")
    }
    for f in @fields(Pair<string, i64>) {
        println("pair.${f.name} size=${@size_of(f.type)}")
    }
    return 0
}
