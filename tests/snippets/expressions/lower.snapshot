          __off_1 = std.core.write_string_at(__buf_0, __off_1, " ")
          __off_1 = std.core.write_int(__buf_0, __off_1, h)
          __off_1 = std.core.write_string_at(__buf_0, __off_1, " ")
          __off_1 = std.core.write_int(__buf_0, __off_1, i)
          __off_1 = std.core.write_string_at(__buf_0, __off_1, " ")
          __off_1 = std.core.write_int(__buf_0, __off_1, j)
