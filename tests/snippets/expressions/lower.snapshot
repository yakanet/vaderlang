  }
  snippet.main :: fn() -> i32 {  // snippet$main
      std.io.println<string>({
          __p_0: string = snippet.demo()
          __buf_1: Buffer = std.core.new_byte_buffer(i64(21) +% std.core.byte_len(__p_0))
          __off_2: i64 = 0
