          __off_1 = std.core.write_string_at(__buf_0, __off_1, " ")
          __off_1 = std.core.write_bool(__buf_0, __off_1, std.core.Range<i32>.contains(e, 9))
          __off_1 = std.core.write_string_at(__buf_0, __off_1, " ")
          __off_1 = std.core.write_bool(__buf_0, __off_1, std.core.Range<i32>.contains(e, 10))
          __off_1 = std.core.write_string_at(__buf_0, __off_1, " ")
