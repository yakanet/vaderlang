// Integer division by zero at run time traps on both backends with the same
// message, `i32.div by zero`: the VM raises it itself (vader/vm/reg_exec.vader),
// and the C backend routes the divide through the `vader_div_i32` guard
// (runtime/c/vader.h) instead of a raw divide, which gives 0 on arm64 and
// SIGFPE on x86. Outside `@comptime` nothing folds the divide; the `@comptime`
// form is C4005 (diag fixture `c4005_division_by_zero`).

module "snippet"

main :: fn() -> i32 {
    numerator :: 100
    divisor :: 0
    return numerator / divisor
}
