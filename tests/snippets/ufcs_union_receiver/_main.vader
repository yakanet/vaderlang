// UFCS on a union receiver (SPEC *UFCS*): `a.describe()` with `a: Shape`
// calls the free fn `describe(s: Shape)`, whose first parameter takes the
// whole union, with no `match` at the call site.

module "snippet"

import "std/io"

Circle :: struct { radius: i32 }
Square :: struct { side: i32 }

Shape :: Circle | Square

describe :: fn(s: Shape) -> string {
    return match s {
        is Circle -> "circle(${s.radius})"
        is Square -> "square(${s.side})"
    }
}

area :: fn(s: Shape) -> i32 {
    return match s {
        is Circle -> s.radius * s.radius * 3
        is Square -> s.side * s.side
    }
}

main :: fn() -> i32 {
    a: Shape: Circle { .radius = 5 }
    b: Shape: Square { .side = 4 }
    println(a.describe())
    println(b.describe())
    println("a.area = ${a.area()}")
    println("b.area = ${b.area()}")
    return 0
}
