# Lower

## snippet
  snippet.Circle :: struct { name: string, r: i32 }  // snippet$Circle
  snippet.Square :: struct { name: string, s: i32 }  // snippet$Square
  snippet.name :: fn(u: Circle | Square) -> string {  // snippet$name
      "free fn"
  }
  snippet.Pick :: struct { pick: fn() -> string, w: i32 }  // snippet$Pick
  snippet.Pass :: struct { pick: fn() -> string, h: i32 }  // snippet$Pass
  snippet.pick :: fn(u: Pass | Pick) -> string {  // snippet$pick
      "free pick"
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      u: Circle | Square = Square { .name = "sq", .s = 4 }
      std.console.println<string>(concat_2("field read ", u.name))
      std.console.println<string>(concat_2("fn call ", snippet.name(u)))
      v: Pass | Pick = Pass { .pick = __lambda_snippet_0, .h = 1 }
      std.console.println<string>(concat_2("field call ", v.pick()))
      return 0
  }
  __lambda_snippet_0 :: fn() -> string {
      "field pick"
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

## lowered in dependencies
  std/console
    fn std.console.println<string>  // std_console$println__string
    fn std.console.write  // std_console$write
    fn std.console.write_bytes  // std_console$write_bytes
    fn std.console.write_text  // std_console$write_text
  std/core
    fn std.core.Buffer.intern_string  // std_core$Buffer$ByteAccess$intern_string
    fn std.core.Buffer.write_string  // std_core$Buffer$ByteAccess$write_string
    struct std.core.Buffer  // std_core$Buffer
