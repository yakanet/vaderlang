  snippet.main :: fn() -> i32 {  // snippet$main
      arr: i32[] = [10, 20, 30, 40, 50] :i32[]
      x: Foo = Foo { .v = 7 }
      r: i32 = snippet.leaf(x, arr)
      expected: i32 = 5000 * (7 + 3)
      if r == expected {
          std.io.println<string>("OK")
