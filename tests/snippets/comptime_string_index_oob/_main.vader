// A comptime string index past the end surfaces a clean C4002 diagnostic instead
// of silently baking U+0000 into the program. The VM-backed comptime evaluator
// runs `oob()` in the interpreter, where the walk behind `s[i]` reads the byte at
// the string's length and traps; the comptime pass routes the trap to C4002.

module "snippet"

oob :: fn() -> char = "abc"[10]

@comptime
export BAD :: oob()

main :: fn() -> i32 {
    return i32(BAD)
}
