// Trait-object boxing: a generic fn whose parameter is a trait type
// (`it: Iterator<T>`) infers the trait's `T` from a concrete argument through
// that argument's impl, then calls through the trait's vtable. Call shapes:
//   - `Iterator<T>` from a `Range`               → `0..<5`
//   - `Iterator<T>` from an array (via `into`)   → `[10, 20, 30]`
//   - user `Greeter<T>` from a user struct       → `Hello {}`
//   - user `Doubler<T>` from a primitive (i32)   → `7`
// Result via exit code: 5 + 3 + 100 + 14 = 122.

module "snippet"

count :: fn<T>(it: Iterator<T>) -> i32 {
    n := 0
    cont := true
    for cont {
        [_, c] :: it.next()
        if c == .Stop {
            cont = false
        } else {
            n = n + 1
        }
    }
    return n
}

Greeter :: trait<T> {
    greet :: fn(self) -> T
}
Hello :: struct {}
Hello implements Greeter<i32> {
    greet :: fn(self) -> i32 { return 100 }
}

Doubler :: trait<T> {
    doubled :: fn(self) -> T
}
i32 implements Doubler<i32> {
    doubled :: fn(self) -> i32 { return self + self }
}

invoke :: fn<T>(g: Greeter<T>) -> T {
    return g.greet()
}

twice :: fn<T>(x: Doubler<T>) -> T {
    return x.doubled()
}

main :: fn() -> i32 {
    a :: count(0..<5)
    b :: count([10, 20, 30])
    c :: invoke(Hello {})
    d :: twice(7)
    return a + b + c + d
}
