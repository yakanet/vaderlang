# Lower

## snippet
  snippet.DigitSet :: struct { bits: i32 }  // snippet$DigitSet
  snippet.DigitSet.contains :: fn(self: DigitSet, value: i32) -> bool {  // snippet$DigitSet$Contains$contains
      if (value < 0) || (value > 9) {
          return false
      }
      mask: i32 = 1 << value
      return (self.bits & mask) != 0
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      if std.core.Range<i32>.contains(Range<i32> {
          .start = 0,
          .end = 10,
          .inclusive = false,
          .done = false,
          .cursor = 0,
      }, 5) {
          std.io.println<string>("range yes")
      }
      if !std.core.Range<i32>.contains(Range<i32> {
          .start = 0,
          .end = 10,
          .inclusive = false,
          .done = false,
          .cursor = 0,
      }, 10) {
          std.io.println<string>("range !in yes")
      }
      if std.core.Range<i32>.contains(Range<i32> {
          .start = 0,
          .end = 10,
          .inclusive = true,
          .done = false,
          .cursor = 0,
      }, 10) {
          std.io.println<string>("range incl yes")
      }
      s: DigitSet = DigitSet { .bits = ((1 << 1) | (1 << 4)) | (1 << 7) }
      if snippet.DigitSet.contains(s, 4) {
          std.io.println<string>("set has 4")
      }
      if !snippet.DigitSet.contains(s, 5) {
          std.io.println<string>("set lacks 5")
      }
      if snippet.DigitSet.contains(s, 7) {
          std.io.println<string>("set has 7")
      }
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: usize = std.core.byte_len(p0)
      c1: usize = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.usize.new_buffer(c1)
      std.core.Buffer.write_string(buf, usize(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }
  vtable std.core.Contains.contains for DigitSet  snippet.DigitSet.contains  // snippet$DigitSet$Contains$contains

