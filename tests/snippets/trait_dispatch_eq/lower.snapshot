  snippet.both_equal<i32> :: fn(a: i32, b: i32, c: i32) -> i32 {  // snippet$both_equal__i32
      n: i32 = 0
      if a == b {
          n = n + 1
      }
      if a == c {
          n = n + 10
      }
      if b == c {
          n = n + 100
      }
      return n
  }

