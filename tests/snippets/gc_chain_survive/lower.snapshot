  snippet.Node :: struct { value: i32, next: Node | null }  // snippet$Node
  snippet.main :: fn() -> i32 {  // snippet$main
      head: Node | null = Node { .value = 0, .next = null }
      i: i32 = 1
      for i < 200 {
          head = Node { .value = i, .next = head }
          i = i + 1
      }
      before: i32 = std.runtime.collections()
      std.runtime.collect()
      after: i32 = std.runtime.collections()
      diff: i32 = after - before
      if diff != 1 {
          std.io.println<string>({
              __buf_0: Buffer = std.core.new_byte_buffer(i64(47))
              __off_1: i64 = 0
              __off_1 = std.core.write_string_at(__buf_0, __off_1, "expected 1 collection, got ")
              __off_1 = std.core.write_int(__buf_0, __off_1, i64(diff))
              std.core.finish_buffer(__buf_0, __off_1)
          } :string)
          return 1
      }
      sum: i32 = 0
      cur: Node | null = head
      done: bool = false
      for !done {
          {
              if cur is null {
                  {
                      done = true
                  }
              } else if cur is Node {
                  {
                      sum = sum + Node(cur).value
                      cur = Node(cur).next
                  }
              } else {
                  @unreachable("non-exhaustive match (T3013 should have caught this)")
              }
          }
      }
      expected: i32 = (200 * 199) / 2
      if sum != expected {
          std.io.println<string>({
              __buf_2: Buffer = std.core.new_byte_buffer(i64(69))
              __off_3: i64 = 0
              __off_3 = std.core.write_string_at(__buf_2, __off_3, "sum mismatch: got ")
              __off_3 = std.core.write_int(__buf_2, __off_3, i64(sum))
              __off_3 = std.core.write_string_at(__buf_2, __off_3, ", expected ")
              __off_3 = std.core.write_int(__buf_2, __off_3, i64(expected))
              std.core.finish_buffer(__buf_2, __off_3)
          } :string)
          return 2
      }
      std.io.println<string>({
          __buf_4: Buffer = std.core.new_byte_buffer(i64(51))
          __off_5: i64 = 0
          __off_5 = std.core.write_string_at(__buf_4, __off_5, "ok: 200 nodes survived GC; sum=")
          __off_5 = std.core.write_int(__buf_4, __off_5, i64(sum))
          std.core.finish_buffer(__buf_4, __off_5)
      } :string)
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

