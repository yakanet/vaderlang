# Lower

## snippet
  snippet.describe :: fn(r: Celsius | Tag) -> string {  // snippet$describe
      {
          if r is Celsius {
              concat_2(std.core.f64.to_string(f64(Celsius(r))), " C")
          } else if r is Tag {
              concat_2("tag ", string(Tag(r)))
          } else {
              @unreachable("non-exhaustive match (T3013 should have caught this)")
          } :string
      } :string
  }
  snippet.annotate :: fn(r: f64 | Note) -> string {  // snippet$annotate
      {
          if r is f64 {
              concat_2(std.core.f64.to_string(f64(r)), " C")
          } else if r is Note {
              concat_2("note ", string(Note(r)))
          } else {
              @unreachable("non-exhaustive match (T3013 should have caught this)")
          } :string
      } :string
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      std.console.println<string>(snippet.describe(Celsius(21.5)))
      std.console.println<string>(snippet.describe(Tag("cold")))
      std.console.println<string>(snippet.annotate(18.0))
      std.console.println<string>(snippet.annotate(Note("windy")))
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std_core$Intrinsic$byte_len(p0)
      c1: i64 = c0 +% std_core$Intrinsic$byte_len(p1)
      buf: Buffer = std_core$Intrinsic$new_byte_buffer(c1)
      std_core$Intrinsic$buffer_write_string(buf, i64(0), p0)
      std_core$Intrinsic$buffer_write_string(buf, c0, p1)
      std_core$Intrinsic$buffer_intern_string(buf, c1)
  }

