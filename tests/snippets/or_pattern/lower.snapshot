              false
          } else {
              @unreachable("non-exhaustive match (T3013 should have caught this)")
          } :bool
      } :bool
  }
  snippet.points :: fn(roll: i32) -> i32 {  // snippet$points
      {
          if (roll == 1) || (roll == 6) {
              10
          } else if ((roll == 2) || (roll == 3)) || (roll == 4) {
              5
          } else {
              0
          } :i32
      } :i32
  }
  snippet.kind :: fn(s: bool | i32 | string) -> i32 {  // snippet$kind
      {
          if s is bool | i32 {
              1
          } else if s is string {
              2
          } else {
              @unreachable("non-exhaustive match (T3013 should have caught this)")
          } :i32
      } :i32
  }
  snippet.main :: fn() -> i32 {  // snippet$main
      go: i32 = if snippet.can_go(u8(2)) { 100 } else { 0 } :{integer}
      stop: i32 = if snippet.can_go(u8(0)) { 0 } else { 10 } :{integer}
      return ((((go + stop) + snippet.points(6)) + snippet.points(3)) + snippet.kind(true)) + snippet.kind("x")
  }

