// `return <value>` computes its value before the pending defers run: a call in
// the value runs first, and a defer that writes a local the value reads cannot
// change what is returned. Covers a void value, a return that leaves two scopes'
// defers, and an async return, whose `await` already runs before the drain.
module "snippet"

import "std/async"
import "std/io"

work :: fn(tag: string) -> i32 {
    println("work ${tag}")
    return 1
}

note :: fn(tag: string) -> void {
    println("note ${tag}")
}

returns_a_call :: fn() -> i32 {
    defer println("defer call")
    return work("call")
}

returns_a_local :: fn() -> i32 {
    n := 1
    defer n = 2
    return n
}

returns_a_void_call :: fn() -> void {
    defer println("defer void")
    return note("void")
}

returns_from_a_nested_block :: fn(go: bool) -> i32 {
    defer println("defer outer")
    if go {
        defer println("defer inner")
        return work("nested")
    }
    return 0
}

later :: fn(tag: string) -> Async<i32> {
    await sleep(1)
    println("await ${tag}")
    return 3
}

returns_an_await :: fn() -> Async<i32> {
    defer println("defer async")
    return await later("async")
}

main :: fn() -> i32 {
    println("${returns_a_call()}")
    println("${returns_a_local()}")
    returns_a_void_call()
    println("${returns_from_a_nested_block(true)}")
    awaited :: await returns_an_await()
    println("${awaited}")
    return 0
}
