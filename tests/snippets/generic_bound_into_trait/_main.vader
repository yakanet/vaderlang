// A type parameter is opaque in its generic body, but it IS the traits its bound
// names : `x: T` with `T: Display` fits a `Display` argument and a `Display`
// return.

module "snippet"

import "std/io"

P :: struct {
    x: i32
}

P implements Display -> "P(${self.x})"

show :: fn(d: Display) -> string = "<${d.to_string()}>"

passed :: fn<T: Display>(x: T) -> string = show(x)

returned :: fn<T: Display>(x: T) -> Display {
    return x
}

main :: fn() -> i32 {
    println(passed(P { .x = 1 }))
    println(passed(7))
    println(show(returned(P { .x = 3 })))
    return 0
}
