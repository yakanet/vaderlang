module "snippet"

import "std/io"

// A generic "repeat" iterator: yields the same value `count` times.
export Repeat :: struct<T> {
    value:     T
    remaining: i32
}

Repeat<T> implements Iterator<T> {
    next :: fn(self!) -> [T, Continuation] {
        // `self.value` doubles as the stop filler: a `T` already at hand, where
        // an unconstrained `T` offers no way to build one.
        if (self.remaining <= 0) {
            return [self.value, .Stop]
        }
        v :: self.value
        self.remaining = self.remaining - 1
        return [v, .Continue]
    }
}

main :: fn() -> i32 {
    // Repeat i32 value 3 times
    it :: Repeat<i32> { .value = 42, .remaining = 3 }
    sum := 0
    for x in it {
        sum = sum + x
    }
    // 42 * 3 = 126
    println("${sum}")
    return 0
}
