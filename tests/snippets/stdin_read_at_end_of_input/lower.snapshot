# Lower

## snippet
  snippet.main :: fn() -> i32 {  // snippet$main
      line: IOError | string = std.console.read_line()
      if line is IOError {
          std.console.println<bool>(IOError(line).kind == IOErrorKind(13))
      }
      rest: IOError | string = std.console.read_stdin_to_end()
      if rest is string {
          std.console.println<i64>(std.core.byte_len(string(rest)))
      }
      return 0
  }

