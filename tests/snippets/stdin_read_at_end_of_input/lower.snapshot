# Lower

## snippet
  snippet.main :: fn() -> i32 {  // snippet$main
      line: IOError | string = std.console.read_line()
      if line is IOError {
          std.console.println<bool>(IOError(line).kind == IOErrorKind(13))
      } else {
          std.console.println<string>(concat_2("a line: ", string(line)))
      }
      rest: IOError | string = std.console.read_stdin_to_end()
      if rest is string {
          std.console.println<i64>(std.core.byte_len(string(rest)))
      } else {
          std.console.println<string>(concat_2("an error: ", IOError(rest).msg))
      }
      return 0
  }
  concat_2 :: fn(p0: string, p1: string) -> string {
      c0: i64 = std.core.byte_len(p0)
      c1: i64 = c0 +% std.core.byte_len(p1)
      buf: Buffer = std.core.new_byte_buffer(c1)
      std.core.Buffer.write_string(buf, i64(0), p0)
      std.core.Buffer.write_string(buf, c0, p1)
      std.core.Buffer.intern_string(buf, c1)
  }

