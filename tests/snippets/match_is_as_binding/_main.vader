module "snippet"

import "std/io"

// Each arm reads the scrutinee narrowed in place to its variant: `a.x` in the
// `is P` arm is a typed field load, not a read through the union box. Arms
// used to need an `as` binder to get there, and that binder once lowered to
// `unreachable`; the form is gone (P1036), the narrowing it provided is not.
P :: struct { x: i32 }
Q :: struct { y: string }

show :: fn(a: P | Q | null) -> string {
    return match a {
        is null -> "null"
        is P    -> "P.x = ${a.x}"
        is Q    -> "Q.y = ${a.y}"
    }
}

main :: fn() -> i32 {
    println(show(P { .x = 42 }))
    println(show(Q { .y = "hello" }))
    println(show(null))
    return 0
}
