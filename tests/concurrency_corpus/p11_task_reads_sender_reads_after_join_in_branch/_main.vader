// P11: each write follows a join in its own block.
//
// corpus: probe
// expect: accepted

module "snippet"

import "std/task"

State :: struct {
    n: i64 = 0
}

look :: fn(s: State) -> i64 = s.n

main :: fn() -> i32 {
    state :: State {}
    t :: launch(() -> look(state))
    if state.n > 0 {
        t.join()
        state.n = 2
        return 0
    }
    t.join()
    state.n = 1
    return 0
}
