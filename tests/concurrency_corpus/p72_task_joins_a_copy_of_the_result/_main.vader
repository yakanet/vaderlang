// P72: the task that writes the index joins a copy of it, as the help of C21 says:
// the other task reads the index alone.
//
// corpus: probe
// expect: accepted

module "snippet"

import "std/abort"
import "std/task"

Index :: struct {
    words: string[] = []
}

build_index :: fn(files: string[]) -> Index = Index { .words = ["vader"] }

// Writes the index.
add_synonyms :: fn(index: Index) -> i64 {
    index.words.push("lang")
    return 1
}

// Reads the index only.
search :: fn(index: Index, word: string) -> i64 = index.words.len()

main :: fn() -> i32 {
    files: string[]: ["a"]
    index :: launch(() -> build_index(files))
    a :: launch(() -> add_synonyms((index.join() else panic("the task was cancelled")).deep_copy()))
    b :: launch(() -> search(index.join() else panic("the task was cancelled"), "vader"))
    synonyms :: a.join() else panic(synonyms.message())
    found :: b.join() else panic(found.message())
    return i32(synonyms + found) - 2
}
