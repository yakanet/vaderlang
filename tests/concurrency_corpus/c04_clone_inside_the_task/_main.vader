// C04: the copy made inside the task reads the level while `update` writes it.
//
// corpus: refused E1
// expect: T3128

module "snippet"

import "std/abort"
import "std/task"

Bot :: struct {
    x: i64 = 0
}

Level :: struct {
    bots: Bot[] = []
}

Player :: struct {
    x: i64 = 0
}

Plan :: struct {
    moves: i64 = 0
}

// Reads the level only.
think :: fn(level: Level) -> Plan = Plan { .moves = level.bots.len() }

// Writes `level.bots[i].x`.
update :: fn(level: Level, player: Player) -> void {
    for i in 0..<level.bots.len() {
        level.bots[i].x = player.x
    }
}

// Writes the first bot.
apply :: fn(level: Level, plan: Plan) -> void {
    if plan.moves > 0 {
        level.bots[0].x += 1
    }
}

spawn_bot :: fn() -> Bot = Bot {}

clone :: fn(level: Level) -> Level {
    bots: Bot[]: []
    for b in level.bots {
        bots.push(Bot { .x = b.x })
    }
    return Level { .bots = bots }
}

main :: fn() -> i32 {
    level :: Level { .bots = [Bot {}] }
    player :: Player { .x = 3 }
    ai :: launch(() -> think(level.clone()))
    update(level, player)
    plan :: ai.join() else panic(plan.message())
    return i32(plan.moves) - 1
}
