// P102: a handler reached through a field of another trait writes under the lock
// of a shared cell.
//
// corpus: probe
// expect: accepted

module "snippet"

import "std/task"

Handler :: trait {
    handle :: fn(self, path: string) -> i32
}

App :: struct { hits: Shared<i32[]> }

Inner :: trait {
    handle :: fn(self, path: string) -> i32
}

App implements Inner {
    handle :: fn(self, path: string) -> i32 {
        self.hits.locked(fn(counts) {
            counts[0] += 1
        })
        return 200
    }
}

Logged :: struct { next: Inner }

Logged implements Handler {
    handle :: fn(self, path: string) -> i32 = self.next.handle(path) + 1000
}

serve :: fn(handler: Handler) -> i32 {
    tasks: Task<i32>[]: []
    for id in 0..<3 {
        tasks.push(launch(() -> handler.handle("/${id}")))
    }
    total := 0
    for t in tasks {
        total += t.join() else 0
    }
    return total
}

main :: fn() -> i32 {
    app :: App { .hits = shared([0]) }
    return serve(Logged { .next = app })
}
