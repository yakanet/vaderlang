// P115: what the loop receives it sends on, then writes: the task it went to may
// be writing it.
//
// corpus: probe
// expect: T3129

module "snippet"

import "std/task"

Node :: struct {
    value: i64
}

main :: fn() -> i32 {
    channel :: Channel<Node> { .capacity = 1 }
    channel.send(Node { .value = 1 })
    for 0..<3 {
        got :: channel.receive()
        if got is Closed {
            break
        }
        channel.send(got)
        got.value = 5
    }
    return 0
}
