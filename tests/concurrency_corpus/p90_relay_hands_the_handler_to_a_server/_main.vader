// P90: a function hands the handler it is given on to a server: its
// callers see the several tasks.
//
// corpus: probe
// expect: T3129

module "snippet"

import "std/task"

State :: struct {
    hits: i32 = 0
}

Handler :: fn(i64) -> i32

// Runs `handler` in three tasks at once, then joins them.
serve :: fn(handler: Handler) -> i32 {
    tasks: Task<i32>[]: []
    for id in 0..<3 {
        tasks.push(launch(() -> handler(id)))
    }
    total := 0
    for t in tasks {
        total += t.join() else 0
    }
    return total
}

// Hands `handler` to the server.
relay :: fn(handler: Handler) -> i32 = serve(handler)

main :: fn() -> i32 {
    state :: State {}
    return relay((id) -> {
        state.hits += 1
        return 0
    })
}
