// P110: the loop rebinds `held` only when it received a message: on the other path
// the next crossing sends the same value again.
//
// corpus: probe
// expect: T3129

module "snippet"

import "std/task"

Node :: struct {
    value: i64
}

main :: fn() -> i32 {
    channel :: Channel<Node> { .capacity = 1 }
    held: Node = Node { .value = 1 }
    for 0..<3 {
        channel.send(held)
        got :: channel.receive()
        if got is Node {
            held = got
        }
    }
    return 0
}
