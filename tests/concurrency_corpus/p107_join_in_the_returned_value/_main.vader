// P107: a function returns the value of the join of the task it launched: the
// task has ended once the call returns, so the caller writes what it lent.
//
// corpus: probe
// expect: accepted

module "snippet"

import "std/console"
import "std/task"

State :: struct { hits: i32 = 0 }

once :: fn(handler: fn(i32) -> i32) -> i32 {
    t :: launch(() -> handler(1))
    return t.join() else 0
}

main :: fn() -> i32 {
    state :: State {}
    once(fn(id: i32) -> i32 {
        state.hits += 1
        return 0
    })
    state.hits += 1
    println("${state.hits}")
    return 0
}
