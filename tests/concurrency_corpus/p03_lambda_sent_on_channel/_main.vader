// P03: a lambda sent on a channel writes `level`, which main writes too.
//
// corpus: probe
// expect: T3129

module "snippet"

import "std/task"

Level :: struct {
    n: i64 = 0
}

bump :: fn(level: Level) -> void {
    level.n += 1
}

worker :: fn(jobs: Channel<fn() -> void>) -> void {
    job :: jobs.receive()
    if job is fn() -> void {
        job()
    }
}

main :: fn() -> i32 {
    level :: Level {}
    jobs :: Channel<fn() -> void> { .capacity = 16 }
    jobs.send(() -> bump(level))
    t :: launch(() -> worker(jobs))
    level.n = 3
    t.join()
    return 0
}
