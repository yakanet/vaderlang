// C05: writes before the launch and after the join, none while the task runs.
//
// corpus: accepted
// expect: accepted

module "snippet"

import "std/abort"
import "std/task"

Bot :: struct {
    x: i64 = 0
}

Level :: struct {
    bots: Bot[] = []
}

Player :: struct {
    x: i64 = 0
}

Plan :: struct {
    moves: i64 = 0
}

// Reads the level only.
think :: fn(level: Level) -> Plan = Plan { .moves = level.bots.len() }

// Writes `level.bots[i].x`.
update :: fn(level: Level, player: Player) -> void {
    for i in 0..<level.bots.len() {
        level.bots[i].x = player.x
    }
}

// Writes the first bot.
apply :: fn(level: Level, plan: Plan) -> void {
    if plan.moves > 0 {
        level.bots[0].x += 1
    }
}

spawn_bot :: fn() -> Bot = Bot {}

main :: fn() -> i32 {
    level :: Level {}
    level.bots.push(spawn_bot())
    ai :: launch(() -> think(level))
    plan :: ai.join() else panic(plan.message())
    apply(level, plan)
    return i32(level.bots[0].x) - 1
}
