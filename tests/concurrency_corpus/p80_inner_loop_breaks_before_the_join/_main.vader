// P80: a loop between the launch and the join breaks, which leaves that loop
// alone: the join still ends the task before the code after the outer loop.
//
// corpus: probe
// expect: accepted

module "snippet"

import "std/task"

Count :: struct {
    n: i32 = 0
}

main :: fn() -> i32 {
    count :: Count {}
    for _ in 0..<2 {
        t :: launch(fn() {
            count.n += 1
        })
        for i in 0..<3 {
            if i == 1 {
                break
            }
        }
        t.join()
    }
    return count.n
}
