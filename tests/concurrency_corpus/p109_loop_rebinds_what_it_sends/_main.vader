// P109: a loop sends `held`, then rebinds it on every path to what it receives:
// each crossing hands another value, and the one it receives is its own.
//
// corpus: probe
// expect: accepted

module "snippet"

import "std/task"

Node :: struct {
    value: i64
}

main :: fn() -> i32 {
    channel :: Channel<Node> { .capacity = 1 }
    held: Node = Node { .value = 1 }
    for 0..<3 {
        channel.send(held)
        got :: channel.receive()
        if got is Closed {
            break
        }
        held = got
    }
    return 0
}
