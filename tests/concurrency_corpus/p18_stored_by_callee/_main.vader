// P18: `register` stores `level` into `registry`, written through it while a task
// reads `level`.
//
// corpus: probe
// expect: T3128

module "snippet"

import "std/task"

Level :: struct {
    n: i64 = 0
}

Registry :: struct {
    levels: Level[] = []
}

register :: fn(r: Registry, l: Level) -> void {
    r.levels.push(l)
}

look :: fn(l: Level) -> i64 = l.n

main :: fn() -> i32 {
    registry :: Registry {}
    level :: Level {}
    register(registry, level)
    t :: launch(() -> look(level))
    registry.levels[0].n = 3
    return i32(t.join())
}
