// P112: `held` is written after the `send` gave it away, before the loop rebinds it.
//
// corpus: probe
// expect: T3129

module "snippet"

import "std/task"

Node :: struct {
    value: i64
}

main :: fn() -> i32 {
    channel :: Channel<Node> { .capacity = 1 }
    held: Node = Node { .value = 1 }
    for 0..<3 {
        channel.send(held)
        held.value = 2
        got :: channel.receive()
        if got is Closed {
            break
        }
        held = got
    }
    return 0
}
