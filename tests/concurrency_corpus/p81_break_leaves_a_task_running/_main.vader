// P81: a turn breaks out of the loop before it joins its task, which the code
// after the loop reads beside.
//
// corpus: probe
// expect: T3128

module "snippet"

import "std/task"

Count :: struct {
    n: i32 = 0
}

main :: fn() -> i32 {
    count :: Count {}
    for i in 0..<3 {
        t :: launch(fn() {
            count.n += 1
        })
        if i == 1 {
            break
        }
        t.join()
    }
    return count.n
}
