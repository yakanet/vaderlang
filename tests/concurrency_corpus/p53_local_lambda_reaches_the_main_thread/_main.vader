// P53: the task calls a lambda of main, which calls a C function bound to the
// main thread.
//
// corpus: probe
// expect: T3133

module "snippet"

import "std/task"

// The GPU takes uploads from the main thread only.
@extern
@main_thread
gpu_upload :: fn(size: i64) -> i64

main :: fn() -> i32 {
    upload :: () -> gpu_upload(4)
    t :: launch(() -> upload())
    return i32(t.join()) - 1
}
