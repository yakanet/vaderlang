// P114: `alias`, bound before the loop, still holds the value the first crossing
// sent, and the loop writes it.
//
// corpus: probe
// expect: T3129

module "snippet"

import "std/task"

Node :: struct {
    value: i64
}

main :: fn() -> i32 {
    channel :: Channel<Node> { .capacity = 1 }
    held: Node = Node { .value = 1 }
    alias :: held
    for 0..<3 {
        alias.value = 3
        channel.send(held)
        got :: channel.receive()
        if got is Closed {
            break
        }
        held = got
    }
    return 0
}
