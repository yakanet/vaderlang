// P01: a task per element of `level.bots`, launched from a `map` lambda, writes its
// bot while main writes one.
//
// corpus: probe
// expect: T3129
// gap: the first fault is P12's: two elements of an array may be one value, so the
//   tasks may write the same bot.

module "snippet"

import "std/iter"
import "std/task"

Bot :: struct {
    x: i64 = 0
}

Level :: struct {
    bots: Bot[] = []
}

nudge :: fn(b: Bot) -> void {
    b.x += 1
}

main :: fn() -> i32 {
    level :: Level { .bots = [Bot {}, Bot {}] }
    tasks :: level.bots.map(b -> launch(() -> nudge(b))).collect()
    level.bots[0].x = 5
    for t in tasks {
        t.join()
    }
    return 0
}
