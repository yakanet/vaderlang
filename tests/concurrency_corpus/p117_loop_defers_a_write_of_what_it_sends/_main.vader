// P117: a `defer` of the loop body writes `held`, and runs on the `break` too,
// while `held` still holds the value sent.
//
// corpus: probe
// expect: T3129

module "snippet"

import "std/task"

Node :: struct {
    value: i64
}

main :: fn() -> i32 {
    channel :: Channel<Node> { .capacity = 1 }
    held: Node = Node { .value = 1 }
    for 0..<3 {
        defer held.value = 7
        channel.send(held)
        got :: channel.receive()
        if got is Closed {
            break
        }
        held = got
    }
    return 0
}
