// P67: main writes `hits` before the loop that joins the named tasks, through a
// constant local bound to a literal: the help moves the write past that loop.
//
// corpus: probe
// expect: T3129

module "snippet"

import "std/task"

Counter :: struct {
    n: i32 = 0
}

main :: fn() -> i32 {
    hits :: Counter {}
    misses :: Counter {}
    a :: launch(() -> { hits.n += 1 })
    b :: launch(() -> { misses.n += 1 })
    tasks :: [a, b]
    hits.n += 1
    for t in tasks {
        t.join()
    }
    return hits.n + misses.n
}
