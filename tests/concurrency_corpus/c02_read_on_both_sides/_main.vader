// C02: three readers of one value, no writer.
//
// corpus: accepted
// expect: accepted

module "snippet"

import "std/abort"
import "std/console"
import "std/task"

Config :: struct {
    port: i64 = 8080
    name: string = "server"
}

load_config :: fn(path: string) -> Config = Config { .name = path }

// Reads its config only.
run_worker :: fn(config: Config) -> i64 = config.port

main :: fn() -> i32 {
    config :: load_config("server.toml")
    a :: launch(() -> run_worker(config))
    b :: launch(() -> run_worker(config))
    println("port ${config.port}")
    first :: a.join() else panic(first.message())
    second :: b.join() else panic(second.message())
    return i32(first + second - 2 * config.port)
}
