// P37: the lambda main hands `each` writes each bot, while a task reads the level:
// what `each` does with its parameter is what the lambda does.
//
// corpus: probe
// expect: T3128

module "snippet"

import "std/task"

Bot :: struct {
    x: i64 = 0
}

Level :: struct {
    bots: Bot[] = []
}

each :: fn(bots: Bot[], f: fn(Bot) -> void) -> void {
    for b in bots {
        f(b)
    }
}

count :: fn(level: Level) -> i64 {
    n: i64 = 0
    for b in level.bots {
        n += b.x
    }
    return n
}

main :: fn() -> i32 {
    level :: Level { .bots = [Bot {}, Bot {}] }
    t :: launch(() -> count(level))
    each(level.bots, b -> {
        b.x += 1
    })
    return i32(t.join())
}
