// M5011: two `@extern` declarations, in two modules, claim the C symbol `abs`
// and neither names a header that would own its prototype. `labs` is declared
// twice too, but both declarations name a header, through a `CLibrary`: that
// pair passes.
module "snippet"

import "snippet/other"
import "std/ffi"

LIBC :: CLibrary { .name = "c", .header = "<stdlib.h>" }

@extern("abs")
c_abs :: fn(x: i32) -> i32

@extern(LIBC, "labs")
c_labs :: fn(x: i64) -> i64

main :: fn() -> i32 { return c_abs(-1) + other_abs(1) + i32(c_labs(-1) + other_labs(1)) }
