module "snippet"

Ready :: struct<T> { v: T }
Ready<T> implements Async<T> {
    resume :: fn(self) -> T | Suspended { return self.v }
}

flag_of :: fn() -> Async<bool> = Ready<bool> { .v = true }

// `await` in a `&&` RHS runs conditionally — hoisting it to a statement would
// run it unconditionally. v1 diagnoses M5009. `combine` awaits, so it is
// inferred async and returns `Async<bool>`.
combine :: fn(a: bool) -> Async<bool> {
    r :: a && await flag_of()
    return r
}

count_of :: fn() -> Async<i32> = Ready<i32> { .v = 1 }

// The fallback of a `??` runs only when the left side is null: same rule.
fallback :: fn(a: i32 | null) -> Async<i32> {
    r :: a ?? await count_of()
    return r
}

// A match guard is the right operand of its arm's `&&`: same rule.
guarded :: fn(x: i32) -> Async<i32> {
    r :: match x {
        1 if await flag_of() -> 10
        _ -> 20
    }
    return r
}
