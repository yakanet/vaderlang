// `@returns` states what a free function returns, `@ensures` what holds once it has
// returned ; on a struct either would do nothing.
module "snippet"

@returns(x > 0)
export Bag :: struct {
    x: i32
}

@ensures(x > 0)
export Sack :: struct {
    x: i32
}

export main :: fn() -> i32 {
    return 0
}
