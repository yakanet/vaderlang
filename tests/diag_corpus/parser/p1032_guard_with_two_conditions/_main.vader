// `@returns` and `@ensures` state one condition.
module "snippet"

export Weekday :: Int in 0..=6
export Weekend :: Int in 5..=6

@returns(d in Weekend, d > 5)
export two :: fn(d: Weekday) -> bool = d >= 5

@ensures(d in Weekend, d > 5)
export both :: fn(d: Weekday) -> void {}

export main :: fn() -> i32 {
    return 0
}
