// A bound names traits, joined by `&` : a union in it is R2042, also under an `&`
// and in a trait's `requires`. `poke`'s body is checked against `Bump!`, the bound
// without its `null`, so R2042 is its only error.
module "snippet"

Bump :: trait {
    bump :: fn(self!) -> void
}

export poke :: fn<T: Bump! | null>(x: T) -> void {
    x.bump()
}

export either :: fn<T: Display & (Bump | Hash)>(x: T) -> void {}

export Bumpable :: trait : Bump | Display {
    level :: fn(self) -> i32
}

main :: fn() -> i32 {
    return 0
}
