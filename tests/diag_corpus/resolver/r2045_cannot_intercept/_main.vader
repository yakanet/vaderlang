// An intercepted function passes its arguments and its written result to one
// interceptor, and keeps one state for the program: a generic function, one
// without parameters, one whose result is not written, one marked twice by one
// interceptor, which reads its site from one decorator, and one whose parameter
// takes its type from its default are R2045.
module "snippet"

Count :: struct<A, R> {
    calls: i64 = 0
}

@interceptor(around = counted)
Counted :: decorator(.Function) {}

@interceptor(around = timed)
Timed :: decorator(.Function, repeatable = true) {}

counted :: fn<A, R>(
    state: Count<A, R>,
    site: Site<Counted>,
    args: A,
    proceed: fn(A) -> R,
) -> R {
    state.calls += 1
    return proceed(args)
}

timed :: fn<A, R>(state: Count<A, R>, site: Site<Timed>, args: A, proceed: fn(A) -> R) -> R =
    proceed(args)

@Counted
identity :: fn<T>(x: T) -> T = x

@Counted
zero :: fn() -> i32 = 0

@Counted
twice :: fn(x: i32) = x * 2

@Timed
@Timed
again :: fn(x: i32) -> i32 = x

@Counted
offset :: fn(x = 0) -> i32 = x

main :: fn() -> i32 = identity(0) + zero() + twice(1) + again(2) + offset()
