// An intercepted function passes its arguments and its written result to one
// interceptor, and keeps one state for the program: a generic function, one
// without parameters, one whose result is not written and one marked by two
// interceptors are R2045.
module "snippet"

Count :: struct<A, R> {
    calls: i64 = 0
}

@interceptor(around = "counted")
Counted :: decorator(.Function) {}

@interceptor(around = "counted")
Timed :: decorator(.Function) {}

counted :: fn<A, R>(state: Count<A, R>, args: A, proceed: fn(A) -> R) -> R {
    state.calls += 1
    return proceed(args)
}

@Counted
identity :: fn<T>(x: T) -> T = x

@Counted
zero :: fn() -> i32 = 0

@Counted
twice :: fn(x: i32) = x * 2

@Counted
@Timed
both :: fn(x: i32) -> i32 = x

main :: fn() -> i32 = identity(0) + zero() + twice(1) + both(2)
