// Two renames from different modules claim the same local name `p` — a genuine
// collision. R2011 rejects it: the SPEC forbids silent first-wins across import
// lines in one file.
module "snippet"

import "std/io" { println as p }
import "std/string" { split as p }

main :: fn() -> i32 {
    p("hi")
    return 0
}
