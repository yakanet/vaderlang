// Through a mutable array the elements' rights are invariant : `fill` may store
// a read-only point in `held`, which its owner then writes as a `Point!`. T3001.
module "snippet"

Point :: struct {
    x: i32
}

ORIGIN :: Point { .x = 1 }

fill :: fn(dst: Point[]!) -> void {
    dst.push(ORIGIN)
}

main :: fn() -> i32 {
    held: Point![]!: []
    fill(held)
    held[0].x = 9
    return ORIGIN.x
}
