// Through a mutable array the elements' rights are invariant : a callee taking a
// `Point[]!` may store a read-only point in `held`, which its owner then writes as a
// `Point!`. The callee is a callback's type, a contract no body widens. T3001.
module "snippet"

Point :: struct {
    x: i32
}

ORIGIN :: Point { .x = 1 }

fill :: fn(dst: Point[]) -> void {
    dst.push(ORIGIN)
}

refill :: fn(f: fn(Point[]!) -> void) -> i32 {
    held: Point[]: []
    f(held)
    held[0].x = 9
    return ORIGIN.x
}

main :: fn() -> i32 = refill(fill)
