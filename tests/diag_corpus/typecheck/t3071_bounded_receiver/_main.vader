// T3071 on `poke`, whose `x` is read-only, and on `poke_through_read_only_bound`,
// whose bound grants no mutation : a call may bind `T` to a read-only type.
// `for` over an `I: Iterator<i32>` is refused the same way, since it calls `next`.
// `poke_mutable`, through `T!` and a bound marked `!`, is accepted.
module "snippet"

Bump :: trait {
    bump :: fn(self!) -> void
}

poke :: fn<T: Bump!>(x: T) -> void {
    x.bump()
}

poke_through_read_only_bound :: fn<T: Bump>(x: T!) -> void {
    x.bump()
}

poke_mutable :: fn<T: Bump!>(x: T!) -> void {
    x.bump()
}

walk :: fn<I: Iterator<i32>>(it: I!) -> void {
    for _ in it {}
}

main :: fn() -> i32 {
    return 0
}
