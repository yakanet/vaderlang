// `Box![]` freezes the ARRAY and hands out mutable elements, so a callee taking it
// may write through them. A `Box[]` therefore cannot fill that slot — the widening
// would let `mutate`, whose body makes it `Box![]`, reach read-only elements.
//
// `equals_type` treats the two as ONE type (a struct's read-only bit is outside type
// identity, so caches and monomorphisation keys stay stable), which is why the guard
// runs ahead of the equality short-circuit rather than through it. T3077, on a
// callback's parameter : its type lends `Box[]`, which no body widens.

module "snippet"

Box :: struct {
    n: i32
}

mutate :: fn(xs: Box[]) -> void {
    xs[0].n = 999
}

each :: fn(xs: Box[], f: fn(Box[]) -> void) -> void = f(xs)

main :: fn() -> i32 {
    boxes :: [Box { .n = 1 }]
    each(boxes, (xs: Box[]) -> {
        mutate(xs)
    })
    return boxes[0].n
}
