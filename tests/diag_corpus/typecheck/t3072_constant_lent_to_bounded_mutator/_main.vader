// A call through a bound lends its argument as a direct one does: `poke` bumps what
// it is lent through `Bump`, directly or by way of `relay`, so the constant cannot
// fill either call. A fresh value is accepted. T3072, twice.
module "snippet"

Bump :: trait {
    bump :: fn(self) -> void
}

Cfg :: struct {
    n: i32
}

Cfg implements Bump {
    bump :: fn(self) -> void {
        self.n += 1
    }
}

CFG :: Cfg { .n = 1 }

poke :: fn<T: Bump>(x: T) -> void {
    x.bump()
}

relay :: fn<T: Bump>(x: T) -> void {
    poke(x)
}

main :: fn() -> i32 {
    poke(CFG)
    relay(CFG)
    poke(Cfg { .n = 2 })
    return 0
}
