// T3086 — an enum with variant data keeps one table slot per variant, read at
// `value - smallest`, so its values must be consecutive. A value known only
// to a protocol goes in a field instead.
//
// `Shifted` starts at 1 and stays quiet ; `Sparse` jumps from 200 to 404.

module "snippet"

Info :: struct {
    label: string
}

Shifted :: enum(Info) {
    Error { .label = "error" } = 1,
    Warning { .label = "warning" },
}

Sparse :: enum(Info) {
    Ok { .label = "ok" } = 200,
    NotFound { .label = "not found" } = 404,
}

main :: fn() -> i32 = i32(Shifted.Warning) + i32(Sparse.NotFound)
