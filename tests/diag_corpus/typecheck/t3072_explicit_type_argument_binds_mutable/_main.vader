// `pick<Cfg!>` takes `b` as a `Cfg!` : a parameter written `T` and bound to a type
// granting mutation grants it too. The read-only `CFG` would come back mutable. T3072.
module "snippet"

Cfg :: struct {
    n: i32
}

CFG :: Cfg { .n = 1 }

pick :: fn<T>(a: T, b: T) -> T = b

main :: fn() -> i32 {
    local :: Cfg { .n = 1 }
    r :: pick<Cfg!>(local, CFG)
    r.n = 5
    return CFG.n
}
