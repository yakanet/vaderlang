// A distinct with its own `Index` but no `IndexSet` writes into its backing array :
// the slot is the backing's `i32`, not the `string` its `at` reads, so storing a
// string is T3063, and the index of an array store must be an integer.
module "snippet"

Names :: i32[]

Names implements Index<usize, string> {
    at :: fn(self, i: usize) -> string = "n${i}"
}

main :: fn() -> i32 {
    n: Names: Names([1, 2])
    n[0] = "oops"
    n[1] = 5
    return 0
}
