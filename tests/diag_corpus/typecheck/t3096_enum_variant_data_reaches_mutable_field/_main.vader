// An enum's variant data is a constant table every read shares, as a module const's
// value is : a field its struct declares `!` would hand that table out to be written.
// T3096, at the enum.
module "snippet"

Info :: struct {
    xs: i32[]!
}

Kind :: enum(Info) {
    A { .xs = [1, 2] },
}

main :: fn() -> i32 {
    Info(Kind.A).xs[0] = 9
    return Info(Kind.A).xs[0]
}
