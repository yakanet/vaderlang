// T3070: `local.pick(CFG)` binds `T` as `pick(local, CFG)` does, to the rights both
// arguments hold — a read-only `Cfg`. The result is read-only, so writing through
// it is refused; the call itself is not.
module "snippet"

Cfg :: struct {
    n: i32
}

CFG :: Cfg { .n = 1 }

pick :: fn<T>(a: T, b: T) -> T = b

main :: fn() -> i32 {
    local :: Cfg { .n = 1 }
    r :: local.pick(CFG)
    r.n = 5
    return CFG.n
}
