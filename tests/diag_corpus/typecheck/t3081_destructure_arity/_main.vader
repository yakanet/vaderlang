module "snippet"

triple :: fn() -> [i32, string, bool] = [1, "x", true]

main :: fn() -> i32 {
    a := 0
    b := ""
    // A tuple's arity is known, so a pattern of a different length is refused.
    // An ARRAY source is not checked — its length is dynamic (SPEC §Array sources).
    [a, b] = triple()
    return 0
}
