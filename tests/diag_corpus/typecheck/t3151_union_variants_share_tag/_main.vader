// Two variants of a union carrying one run-time type (a distinct its backing, an
// integer range its integer) could not be told apart; `kept_apart` mixes those
// that can, enums included: an enum is carried as itself.
module "snippet"

export Fruit :: enum { Apple, Pear }
export Color :: enum { Red, Green, Blue }
export Wide :: enum(u16) { A, B }
export Path :: string
export Hour :: Int in 0..=23
export Point :: struct { x: i32 }

export distinct_and_backing :: fn(v: Path | string) -> void {}
export range_and_integer :: fn(v: Hour | u8) -> void {}

export kept_apart :: fn(v: Fruit | Color | Wide | u8 | Point | string | null) -> void {}

main :: fn() -> i32 {
    return 0
}
