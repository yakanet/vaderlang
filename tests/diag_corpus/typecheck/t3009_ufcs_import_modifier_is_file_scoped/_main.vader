// Imports are FILE-scoped (SPEC §"Modules"), and UFCS follows them: a modifier
// list's exclusion binds the file that wrote it, and only that file.
//
// This file wildcard-imports `snippet/provider` with no modifiers, so `bump` is
// in scope here, in both call forms. Its sibling `other.vader` drops `bump` from
// its own wildcard, and the T3009 in the snapshot is that sibling's `c.bump()` —
// not this file's, which resolves.

module "snippet"

import "snippet/provider"

main :: fn() -> i32 {
    c :: Counter { .n = 0 }
    _ :: c.bump()
    _ :: bump(c)
    return from_sibling()
}
