// `@displayable` generates an enum's `Display`, one variant name per variant,
// and is declared for an enum: anywhere else it is refused, an impl member
// included.

module "main"

@displayable
Point :: struct { x: i32 }

@displayable
Named :: trait { name :: fn(self) -> string }

Point implements Named {
    @displayable
    name :: fn(self) -> string = "point"
}

main :: fn() -> i32 = 0
