// A value widening into a trait value keeps its own rights : a read-only `Cfg`
// does not fill a `Bump!`, whose holder calls its `self!` members, nor the `Bump!`
// variant of a union. T3077, twice.
module "snippet"

Bump :: trait {
    bump :: fn(self!) -> void
}

Cfg :: struct {
    n: i32
}

Cfg implements Bump {
    bump :: fn(self!) -> void {
        self.n += 1
    }
}

keep :: fn(c: Cfg) -> Bump! = c

keep_optional :: fn(c: Cfg) -> Bump! | null = c

main :: fn() -> i32 {
    b :: keep(Cfg { .n = 1 })
    b.bump()
    o :: keep_optional(Cfg { .n = 2 })
    if o != null {
        o.bump()
    }
    return 0
}
