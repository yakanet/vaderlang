// `await` drives its operand through `resume`, declared `self!` : a read-only
// awaitable cannot be awaited — here a factory's unmarked return, and a slot
// annotated without `!`. A factory returning `Async<i32>!` is accepted.
module "snippet"

Ready :: struct {
    v: i32
}

Ready implements Async<i32> {
    resume :: fn(self) -> i32 | Suspended = self.v
}

view :: fn() -> Async<i32> = Ready { .v = 1 }

fresh :: fn() -> Async<i32>! = Ready { .v = 2 }

run :: fn() -> Async<i32> {
    a :: await view()
    r: Async<i32>: Ready { .v = 3 }
    b :: await r
    c :: await fresh()
    return a + b + c
}

main :: fn() -> i32 {
    v :: await run()
    return v
}
