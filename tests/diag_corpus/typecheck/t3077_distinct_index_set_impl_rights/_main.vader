// A distinct with an `IndexSet` of its own is written through that impl, and the
// value is held to its `V` : `Cfg!` takes no read-only `ORIGIN`. T3077.
module "snippet"

Cfg :: struct {
    n: i32
}

Holder :: struct {
    c: Cfg!
}

Wrap :: Holder

Wrap implements IndexSet<usize, Cfg!> {
    set_at :: fn(self!, i: usize, v: Cfg!) -> void {
        self.c = v
    }
}

ORIGIN :: Cfg { .n = 1 }

main :: fn() -> i32 {
    w :: Wrap(Holder { .c = Cfg { .n = 2 } })
    w[0] = ORIGIN
    w.c.n = 9
    return w.c.n
}
