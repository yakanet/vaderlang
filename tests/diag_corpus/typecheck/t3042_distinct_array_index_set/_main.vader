// An index write into an array-backed distinct stores into its backing, and is
// held to the backing's rights : `view()` hands out `TABLE` read-only. T3042.
module "snippet"

Ids :: i32[]

TABLE: i32[]: [1, 2, 3]

view :: fn() -> Ids = Ids(TABLE)

main :: fn() -> i32 {
    view()[0] = 9
    return TABLE[0]
}
