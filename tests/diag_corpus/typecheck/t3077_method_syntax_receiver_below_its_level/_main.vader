// T3077: below its own level, the receiver of `p.poke()` is held to `poke`'s
// parameter as `poke(p)` holds it — a `Pair` holding a read-only `Cfg` cannot fill
// a `Pair<T, Cfg!>`, which `poke` writes through. The receiver alone binds `T`.
module "snippet"

Cfg :: struct {
    n: i32
}

Pair :: struct<A, B> {
    a: A
    b: B
}

poke :: fn<T>(p: Pair<T, Cfg!>) -> void {
    p.b.n = 9
}

main :: fn() -> i32 {
    ro :: Cfg { .n = 1 }
    p :: Pair<i32, Cfg> { .a = 1, .b = ro }
    p.poke()
    return ro.n
}
