// A module const is frozen at every level its type spells out, but a level its
// declarations mark `!` keeps its rights — a struct field, a type argument, the
// fields of a writable array's elements — and so does a trait value, which a `self!`
// member mutates through. The const's value may be shared by every read : through
// `CFG.items` the path refuses a write, but `view()` hands the const out and loses
// that path. Each const is refused : T3096, four times. A fn that builds a fresh
// value is the form to use.
module "snippet"

Cfg :: struct {
    items: i32[]!
}

Inner :: struct {
    n: i32
}

Box :: struct<T> {
    item: T
}

Bump :: trait {
    bump :: fn(self!) -> void
}

Inner implements Bump {
    bump :: fn(self!) -> void {
        self.n += 1
    }
}

Holder :: struct {
    bag: Bump
}

CFG :: Cfg { .items = [1, 2] }

HELD :: Box<Inner!> { .item = Inner { .n = 1 } }

SPECS: Cfg[]!: [Cfg { .items = [3] }]

BAG :: Holder { .bag = Inner { .n = 1 } }

view :: fn() -> Cfg = CFG

fresh :: fn() -> Cfg! = Cfg { .items = [1, 2] }

held_by :: fn(h: Holder) -> i32 = 1

main :: fn() -> i32 {
    v :: view()
    v.items[0] = 9
    h :: Cfg { ...fresh() }
    h.items.push(3)
    return v.items[0] + i32(h.items.len()) + HELD.item.n + i32(SPECS.len()) + held_by(BAG)
}
