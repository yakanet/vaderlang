// T3050: a function of a component interface is declared by the module of its
// WIT, which an import writes; an `@extern` written by hand cannot name one.
module "snippet"

CLOCK :: WasmInterface {
    .package = "wasi:clocks",
    .name = "monotonic-clock",
    .version = "0.3.0",
}

@extern(CLOCK, "now")
now :: fn() -> u64

main :: fn() -> i32 { return 0 }
