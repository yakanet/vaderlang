// An index write calls `set_at`, a `self!` member, as `c.by_name.set_at(k, v)`
// would : a field written without `!` is read-only, so it cannot take the write,
// though the struct holding it is mutable — assigned directly or as a
// destructuring target. T3071 twice.
module "snippet"

import "std/collections"

Counts :: struct {
    by_name: MutableMap<string, i32>
}

main :: fn() -> i32 {
    c :: Counts { .by_name = MutableMap<string, i32> {} }
    c.by_name["x"] = 7
    total := 0
    [total, c.by_name["y"]] = [1, 2]
    return total
}
