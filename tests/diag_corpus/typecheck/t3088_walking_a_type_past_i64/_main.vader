// `for x in T` walks a range, an integer type within `i64` or an enum without
// variant data : `u64` reaches past `i64`, a `string` has no values to walk.
module "snippet"

export main :: fn() -> i32 {
    count: u64 = 0
    for x in u64 {
        count += 1
    }
    for s in string {
        count += 1
    }
    for b in u8 {
        count += 1
    }
    return 0
}
