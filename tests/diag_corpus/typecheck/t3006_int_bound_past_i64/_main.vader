// A type parameter bounded by `Int` is computed on as an `i64` : its argument is an
// integer type within `i64`. `u64` goes past it, a `string` is no integer.
module "snippet"

export lowest :: fn<T: Int>(a: T, b: T) -> i64 {
    if a < b {
        return a
    }
    return b
}

export main :: fn() -> i32 {
    big: u64: 5
    x :: lowest(big, big)
    z :: lowest("a", "b")
    return 0
}
