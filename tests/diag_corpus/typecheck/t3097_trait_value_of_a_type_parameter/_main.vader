// A trait value dispatches by the instance its arguments name. `Mon` implements
// `Into` toward two targets, and an `Into<T>` value names its target by a type
// parameter, which singles out neither impl. T3097, at the value.
module "snippet"

Label :: struct {
    s: string
}

Tag :: struct {
    n: i32
}

Mon :: struct {
    v: i32
}

Mon implements Into<Label> {
    into :: fn(self) -> Label = Label { .s = "m" }
}

Mon implements Into<Tag> {
    into :: fn(self) -> Tag = Tag { .n = self.v }
}

held :: fn<T>(m: Mon) -> Into<T> = m

main :: fn() -> i32 {
    v :: held<Tag>(Mon { .v = 3 })
    return 0
}
