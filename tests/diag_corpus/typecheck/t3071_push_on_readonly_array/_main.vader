// Through a read-only array neither `arr[i] = v` nor `arr.push(v)` compiles.
// Only the first half was enforced (T3042, keyed on the array type in
// `check_assign`); the method path never tested the receiver against `self`, so
// `a.push(9)` compiled silently. `ArrayOps`' mutators declare `self!`, and
// dispatch rejects them on a read-only receiver. T3071.
//
// The callback's parameter carries no marker — that IS the read-only default its
// type lends, and it is what `push` runs into.
module "snippet"

each :: fn(xs: i32[], f: fn(i32[]) -> void) -> void = f(xs)

main :: fn() -> i32 {
    xs :: [1, 2]
    each(xs, (a: i32[]) -> {
        a.push(9)
    })
    return 0
}
