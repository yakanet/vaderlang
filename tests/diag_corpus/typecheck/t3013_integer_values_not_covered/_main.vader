// A `match` over an integer type covers it with its literal and range arms : a
// value no arm takes is T3013, a gap in a range, the far end of a primitive, a code
// point of `char`, the integer variant of a union alike. A guarded arm covers
// nothing.
module "snippet"

export Hour :: Int in 0..=23

export part :: fn(h: Hour) -> i32 = match h {
    0..=11  -> 1
    13..=23 -> 2
}

export sign :: fn(b: i8) -> i32 = match b {
    -128..=-1 -> -1
    0         -> 0
    1..<127   -> 1
}

export ascii :: fn(c: char) -> bool = match c {
    '\0'..='\u{7F}' -> true
}

export guarded :: fn(h: Hour, late: bool) -> i32 = match h {
    0..=11            -> 1
    12..=23 if late   -> 2
}

export optional :: fn(h: Hour | null) -> i32 = match h {
    0..=20 -> 1
    null   -> 0
}

export main :: fn() -> i32 = part(3) + sign(-2)
