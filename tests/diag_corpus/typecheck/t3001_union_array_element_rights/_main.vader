// The invariance of array elements under a mutable spine holds inside a union
// too : `fill` would store a read-only point that `held`'s owner writes. T3001.
module "snippet"

Point :: struct {
    x: i32
}

ORIGIN :: Point { .x = 1 }

fill :: fn(dst: Point[] | null) -> void {
    if dst != null {
        dst.push(ORIGIN)
    }
}

main :: fn() -> i32 {
    held: Point![]!: []
    opt: Point![]! | null: held
    fill(opt)
    held[0].x = 9
    return ORIGIN.x
}
