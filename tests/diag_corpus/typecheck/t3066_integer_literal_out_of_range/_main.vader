// An integer literal must fit the type it lands in, checked at its exact bounds:
// `-128` is one literal and fits an `i8`, `128` does not. A literal no context
// pins must fit the `i32` it defaults to wherever it sits, a range pattern's
// bounds the scrutinee's type, the bounds of `x in lo..=hi` the type of `x`, a free
// literal a `match` arm or an `if` branch gives the type its siblings settle the
// result to (a shift's amount included), and a free argument or UFCS receiver the
// parameter type its call settles it at.
module "snippet"

export LEAST: i8: -128
export PAST_MAX: i8: 128
export PAST_MIN: i8: -129
export TOO_WIDE: i32: 2147483648
export NEGATIVE_UNSIGNED: u32: -1
export DEFAULTED         :: 9000000000
export DEFAULTED_ELEMENT :: [9000000000]
export DEFAULTED_OPERAND :: 9000000000 + 1

export bucket :: fn(b: u8) -> i32 = match b {
    -1..=3  -> 1
    4..=300 -> 2
    _       -> 3
}

export small :: fn(b: u8) -> bool = b in -1..=3

export turns :: fn() -> i32 {
    n := 0
    for i in 0..<9000000000 {
        n += 1
    }
    return n
}

export arm :: fn(s: string | null) -> u8 {
    k :: match s {
        is string -> u8(7)
        is null   -> 300
    }
    return k
}

export branch :: fn(flag: bool) -> u8 {
    k :: if flag { u8(7) } else { 300 }
    return k
}

export shifted :: fn(flag: bool) -> u8 {
    k :: if flag { u8(7) } else { 1 << 300 }
    return k
}

pick :: fn<T>(a: T, b: T) -> T = a

same :: fn(x: u8) -> u8 = x

either :: fn<T>(a: T | string, b: T) -> bool = a is string

export calls :: fn() -> void {
    _ :: pick(300, u8(1))
    _ :: 300.same()
    _ :: 300.pick(u8(1))
    _ :: either(300, u8(1))
    _ :: 300.either(u8(1))
}

main :: fn() -> i32 {
    return 0
}
