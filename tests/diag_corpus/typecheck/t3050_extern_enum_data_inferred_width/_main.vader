// An `@extern` parameter of an enum with variant data and no written width:
// T3050. It would cross as its written value, at a width that moves when a
// variant is added, so C cannot be told it.
module "snippet"

StatusInfo :: struct { reason: string }

HttpStatus :: enum(StatusInfo) {
    Ok       { .reason = "OK" }        = 200,
    NotFound { .reason = "Not Found" } = 404,
}

@extern send_status :: fn(status: HttpStatus) -> i32

main :: fn() -> i32 { return 0 }
