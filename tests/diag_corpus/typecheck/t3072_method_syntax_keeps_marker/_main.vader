// A call through method syntax lends its arguments as a bare call does:
// `c.absorb(CFG)` is `absorb(c, CFG)`, and `absorb` writes `other`, so the constant
// cannot fill it. T3072.
module "snippet"

Cfg :: struct {
    count: i32
}

CFG :: Cfg { .count = 1 }

Merges :: trait {
    absorb :: fn(self!, other: Cfg!) -> void
}

Cfg implements Merges {
    absorb :: fn(self, other: Cfg) -> void {
        self.count += other.count
        other.count = 0
    }
}

main :: fn() -> i32 {
    c :: Cfg { .count = 0 }
    c.absorb(CFG)
    return c.count
}
