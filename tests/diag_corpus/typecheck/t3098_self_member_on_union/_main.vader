// A union dispatches a member through the trait its variants share, by the
// receiver's tag alone : `compare` takes another `Self`, which the other operand
// may fill with the other variant. T3098, at the operator.
module "snippet"

A :: struct {
    n: i32
}

B :: struct {
    n: i32
}

A implements Comparable {
    compare :: fn(self, other: A) -> i32 = self.n - other.n
}

B implements Comparable {
    compare :: fn(self, other: B) -> i32 = self.n - other.n
}

less :: fn(x: A | B, y: A | B) -> bool = x < y

main :: fn() -> i32 {
    ordered :: less(A { .n = 1 }, A { .n = 2 })
    return if ordered { 0 } else { 1 }
}
