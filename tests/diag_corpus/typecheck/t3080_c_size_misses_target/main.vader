module "main"

// The widths are declared for WASI alone, so any real host is a target the
// mirror says nothing about — which is the point: a system nobody described
// must not read as a system that was checked.
@c_struct("struct timespec")
Ts :: struct {
    @c_size(8, .Wasi)
    tv_sec: i64,
}

@c_header("<time.h>")
@extern("clock_gettime")
sys_clock_gettime :: fn(clock_id: i32, @c_pointer ts: Ts!) -> i32

main :: fn() -> i32 {
    t :: Ts { .tv_sec = 0 }
    return sys_clock_gettime(0, t)
}
