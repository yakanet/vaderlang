module "snippet"

Foo :: struct { a: i32 }
Bar :: struct { b: i32 }
Box :: struct<T> { value: T }

// `Box<Foo>` and `Box<Bar>` share one body — a reference type argument is
// erased — so their values cannot be told apart by an `is` test.
is_foo :: fn(x: Box<Foo> | Box<Bar>) -> bool = x is Box<Foo>

main :: fn() -> i32 {
    b :: Box<Foo> { .value = Foo { .a = 1 } }
    return if is_foo(b) { 1 } else { 0 }
}
