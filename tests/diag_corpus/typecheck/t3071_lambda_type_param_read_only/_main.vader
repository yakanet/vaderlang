// A lambda parameter not written `!` is read-only, a `T` one included, as the
// callback's type lends it. T3071. A lambda bound with `::` is a local fn instead,
// whose parameters take the `!` their body needs.
module "snippet"

Bump :: trait {
    bump :: fn(self!) -> void
}

apply :: fn<T>(x: T, f: fn(T) -> void) -> void = f(x)

poke :: fn<T: Bump!>(x: T) -> void {
    apply(x, (y: T) -> {
        y.bump()
    })
}

main :: fn() -> i32 {
    return 0
}
