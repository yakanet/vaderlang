// `break` in a lambda written inside a loop — T3015: the lambda is a fn of its
// own, so the loop around it is not one its jumps can reach.
module "snippet"

main :: fn() -> i32 {
    for x in [1, 2, 3] {
        g :: () -> {
            if x > 1 {
                break
            }
        }
        g()
    }
    return 0
}
