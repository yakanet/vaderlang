// T3090 — an array impl whose element is built from a type parameter without
// being one (`T[][]`) is refused: it would be a second generic impl on arrays,
// overlapping `T[]`. An impl on arrays is on `T[]` or on a concrete array.
module "snippet"

Tag :: trait {
    tag :: fn(self) -> i32
}

T[][] implements<T> Tag {
    tag :: fn(self) -> i32 = i32(self.len())
}
