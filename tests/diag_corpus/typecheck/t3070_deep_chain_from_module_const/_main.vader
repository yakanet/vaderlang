// A module constant is frozen all the way down: a write reaches it through any
// path from the constant, not just its first hop. `child` is a plain struct; what
// makes the write an error is only how it is reached. T3070.
module "snippet"

Child :: struct { count: i32 }
Cfg :: struct { child: Child }

CFG :: Cfg { .child = Child { .count = 2 } }

main :: fn() -> i32 {
    CFG.child.count = 0
    return 0
}
