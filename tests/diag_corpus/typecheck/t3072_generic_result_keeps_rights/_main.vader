// A type parameter is bound with the argument's rights : what a generic hands back
// from a read-only source is read-only, so neither result may be lent to a
// parameter that mutates it. T3072, twice.
module "snippet"

Point :: struct {
    x: i32
}

Box :: struct<T> {
    v: T
}

ORIGIN :: Point { .x = 1 }
TABLE :: [Point { .x = 1 }]

wrap :: fn<T>(v: T) -> Box<T>! = Box<T> { .v = v }

peek :: fn<T>(xs: T[]) -> T = xs[0]

bump :: fn(p: Point!) -> void {
    p.x = 9
}

main :: fn() -> i32 {
    bump(peek(TABLE))
    b :: wrap(ORIGIN)
    bump(b.v)
    return ORIGIN.x
}
