// A `(i32 | string)[]` slot must NOT take an `i32[]` reference: arrays are
// reference-aliased (SPEC §Arrays), so a write through the wider alias
// (`b[0] = "hello"`) would store a string into the shared i32 buffer: corruption
// on native, a VM trap. A slot's element type is invariant; only an argument
// widens, for a callee that does not write it.
module "snippet"

main :: fn() -> i32 {
    a: i32[]: [1, 2, 3]
    b: (i32 | string)[]: a
    b[0] = "hello"
    return 0
}
