// A `type`-valued local whose value is chosen at run time is rejected at
// typecheck (T3035): no type value reaches the VM. The immutable form with a
// constant type, `t: type: i32`, is an in-fn alias and is accepted.

module "snippet"

main :: fn() -> i32 {
    t: type: i32
    runtime_typed: type: if 1 == 1 { i32 } else { i64 }
    return 0
}
