// Two wildcard imports each export `describe` and `label` for an `i32` : the method
// form and the bare call `describe(3)` are both ambiguous. A declaration of this
// module wins the tie, as `label` shows.
module "snippet"

import "snippet/farm"
import "snippet/zoo"

label :: fn(n: i32) -> string = "here"

export shown :: fn() -> string = 3.describe() + describe(3) + 3.label()
