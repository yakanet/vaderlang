// A receiver is read-only by its TYPE as well as by its access path : a call to an
// unmarked return, a value bound from one, a read-only field. T3071 on
// `a.bump()`, `make().bump()` and `h.p.bump()` ; `fresh().bump()` and `h.q.bump()`
// are accepted.
module "snippet"

export Point :: struct {
    x: i32
}

export bump :: fn(self: Point!) -> void {
    self.x += 1
}

export make :: fn() -> Point = Point { .x = 1 }

export fresh :: fn() -> Point! = Point { .x = 1 }

export Holder :: struct {
    p: Point
    q: Point!
}

export through_local :: fn() -> i32 {
    a: Point: make()
    a.bump()
    return a.x
}

export through_call :: fn() -> void {
    make().bump()
    fresh().bump()
}

export through_field :: fn(h: Holder!) -> void {
    h.p.bump()
    h.q.bump()
}

main :: fn() -> i32 {
    return 0
}
