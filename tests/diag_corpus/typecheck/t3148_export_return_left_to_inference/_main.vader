// T3148: an exported function that leaves its return type to inference.
//
// Its type is what other modules read, and would change with its body. Only an
// expression body can leave the type out, and only an `export` is public, so a
// private helper, a written `->`, a block body and a `@no_return` function pass.
// One that never returns without `@no_return` is refused too: `never` has no
// spelling, the decorator says it. A default of an exported trait is refused ; one
// of a private trait passes.

module "snippet"

import "std/abort"
import "std/console"

// Exported, expression body, no `->`: refused, naming the type to write.
export double :: fn(x: i32) = x * 2

// The type written: passes.
export triple :: fn(x: i32) -> i32 = x * 3

// Private: passes.
halve :: fn(x: i32) = x / 2

// `@no_return` fixes the type itself: passes.
@no_return export give_up :: fn(msg: string) = panic(msg)

// Never returns, without `@no_return`: refused, naming the decorator.
export stop :: fn(msg: string) = panic(msg)

// A block body without `->` returns nothing: passes.
export greet :: fn(name: string) {
    println("hello ${name}")
}

// A default of an exported trait, expression body, no `->`: refused.
export Sized :: trait {
    size :: fn(self) -> i32
    twice :: fn(self) = self.size() * 2
}

// The same default in a private trait: passes.
Counted :: trait {
    count :: fn(self) -> i32
    twice :: fn(self) = self.count() * 2
}

Bag :: struct {
    n: i32
}

Bag implements Counted {
    count :: fn(self) -> i32 = self.n
}

main :: fn() -> i32 {
    greet("w")
    return double(1) + triple(1) + halve(4) + Bag { .n = 1 }.twice() - 7
}
