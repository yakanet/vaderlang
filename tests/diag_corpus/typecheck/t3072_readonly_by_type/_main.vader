// An argument is read-only by its TYPE as well as by its access path. T3072 on
// `poke(make())` and `poke(h.p)` ; a fresh value, a `!` field, and the element of a
// `Cell![]` are accepted — `i32`, a value, carries no marker to withhold.
module "snippet"

export Point :: struct {
    x: i32
}

export Cell :: Point | i32

export poke :: fn(p: Point) -> void {
    p.x += 1
}

export poke_cell :: fn(c: Cell) -> void {
    if c is Point {
        c.x += 1
    }
}

export make :: fn() -> Point = Point { .x = 1 }

export fresh :: fn() -> Point! = Point { .x = 1 }

export Holder :: struct {
    p: Point
    q: Point!
}

export calls :: fn() -> void {
    poke(make())
    poke(fresh())
}

export fields :: fn(h: Holder) -> void {
    poke(h.p)
    poke(h.q)
}

export cells :: fn(cs: Cell[]) -> void {
    poke_cell(cs[0])
}

main :: fn() -> i32 {
    return 0
}
