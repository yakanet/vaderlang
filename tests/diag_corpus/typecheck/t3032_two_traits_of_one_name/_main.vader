// Two traits of one name, each implemented for `Point`: the message names
// them by module, since their bare names would read the same. This file sees
// both, the second under another name; `other.vader` implements it.
module "snippet"

import "std/console"
import "snippet/tr_a"
import "snippet/tr_b" { Describe as DescribeB }

Point :: struct { x: i32 }

Point implements Describe {
    describe :: fn(self) -> string = "a ${self.x}"
}

main :: fn() -> i32 {
    p :: Point { .x = 1 }
    println(p.describe())
    return 0
}
