// A `T` has the rights of its bound : `T: Bump` fills a `Bump` but not a `Bump!`,
// whether bound, reassigned or passed — an argument is T3072's alone — nor, as a
// `T | null`, a `Bump! | null`. `T: Bump!` fills a `Bump!`.
module "snippet"

Bump :: trait {
    bump :: fn(self!) -> void
}

store :: fn(b: Bump!) -> void {
    b.bump()
}

hold :: fn<T: Bump>(x: T!, y: T!, z: T! | null) -> void {
    b: Bump! = x
    b = y
    store(x)
    view: Bump: x
    maybe: Bump! | null: z
}

hold_mutable :: fn<T: Bump!>(x: T!) -> void {
    b: Bump!: x
    store(b)
}

main :: fn() -> i32 {
    return 0
}
