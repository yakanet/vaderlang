module "snippet"

// A value combinator (`or`) handles ONE unhappy variant. A union carrying BOTH
// `null` AND an `Error` (`i32 | Error | null`) fits the `T | null` and the
// `T | Error` overload equally well — `T` takes the other two variants either
// way — so `.or(d)` is a compile error (T3032) that points at narrowing, not a
// pick of whichever overload was declared first, which would let the other
// unhappy variant through.
import "std/option"

Boom :: struct {}
Boom implements Error { message :: fn(self) -> string = "boom" }

tri :: fn(k: i32) -> i32 | Error | null {
    if k == 0 { return 42 }
    if k == 1 { return Boom {} }
    return null
}

export probe :: fn() -> void {
    _ :: tri(0).or(-1)
}
