// A `Self` the trait lends read-only stays read-only behind a `T`, even under
// `T: Bump!` : the impl may hand out a module const. T3071, through a callback and
// through a `-> Self` return.
module "snippet"

Inner :: struct {
    n: i32
}

FROZEN :: Inner { .n = 1 }

Bump :: trait {
    bump :: fn(self!) -> void
}

Inner implements Bump {
    bump :: fn(self) -> void {
        self.n = self.n + 1
    }
}

Visit :: trait {
    visit :: fn(self, f: fn(Self) -> void) -> void
    get :: fn(self) -> Self
}

Inner implements Visit {
    visit :: fn(self, f: fn(Self) -> void) -> void {
        f(FROZEN)
    }
    get :: fn(self) -> Inner = FROZEN
}

run :: fn<T: Visit & Bump!>(t: T) -> void {
    t.visit((x) -> {
        x.bump()
    })
    t.get().bump()
}

main :: fn() -> i32 {
    w :: Inner { .n = 0 }
    run(w)
    return 0
}
