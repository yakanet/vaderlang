// An impl member its trait does not declare: T3094. `a != b` is already
// `!a.equals(b)` : drop `not_equals`.
module "snippet"

Money :: struct {
    cents: i64
}

Money implements Equals {
    equals :: fn(self, other: Self) -> bool = self.cents == other.cents
    not_equals :: fn(self, other: Self) -> bool = false
}

main :: fn() -> i32 {
    a :: Money { .cents = 1 }
    b :: Money { .cents = 1 }
    return if a == b { 0 } else { 1 }
}
