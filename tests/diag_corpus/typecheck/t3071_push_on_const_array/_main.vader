// SPEC.md §"const T[]" has always promised that through a `const T[]` value
// "neither `arr[i] = v` nor `arr.push(v)` compiles". Only the first half was
// enforced (T3042, keyed on the array type in `check_assign`); the method path
// never tested the receiver against `self`, so `a.push(9)` compiled silently.
// `ArrayOps`' mutators now declare `self!`, and dispatch rejects them on an
// immutable receiver. T3071.
module "snippet"

grow :: fn(a: const i32[]) -> void {
    a.push(9)
}

main :: fn() -> i32 {
    xs :: [1, 2]
    grow(xs)
    return 0
}
