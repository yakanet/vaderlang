// A distinct type holds its backing's rights : `Color(ORIGIN)` is the const under
// another name, so writing a field through it is T3070, as through `ORIGIN`.
module "snippet"

Rgb :: struct {
    r: i32
}

Color :: Rgb

ORIGIN :: Rgb { .r = 1 }

main :: fn() -> i32 {
    c :: Color(ORIGIN)
    c.r = 5
    return c.r
}
