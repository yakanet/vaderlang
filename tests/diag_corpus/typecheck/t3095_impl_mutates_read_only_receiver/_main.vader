// A call through the trait lends the receiver with the TRAIT's rights : an impl
// declaring `self!` where the trait says `self` would mutate a module const
// reached as a `Bump`. T3095.
module "snippet"

Bump :: trait {
    peek :: fn(self) -> i32
}

Point :: struct {
    x: i32
}

Point implements Bump {
    peek :: fn(self) -> i32 {
        self.x = 9
        return self.x
    }
}

ORIGIN :: Point { .x = 1 }

look :: fn(b: Bump) -> i32 = b.peek()

main :: fn() -> i32 = look(ORIGIN)
