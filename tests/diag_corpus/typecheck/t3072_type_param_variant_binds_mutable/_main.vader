// `pick<Cfg!>` takes `b` as a `Cfg! | null` : a type parameter that is a variant of
// its parameter's union grants what it is bound to, as a bare one does. The
// read-only `CFG` would come back mutable. T3072.
module "snippet"

Cfg :: struct {
    n: i32
}

CFG :: Cfg { .n = 1 }

pick :: fn<T>(a: T, b: T | null) -> T = b ?? a

main :: fn() -> i32 {
    local :: Cfg { .n = 1 }
    r :: pick<Cfg!>(local, CFG)
    r.n = 5
    return CFG.n
}
