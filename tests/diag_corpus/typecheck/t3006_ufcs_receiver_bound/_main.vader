// T3006: a UFCS call binds the callee's type parameter through its receiver
// alone: `m.same()` leaves no type parameter in the curried signature, and the
// bound is still checked.
module "snippet"

Meters :: struct {
    v: i32
}

same :: fn<T: Equals>(self: T) -> bool = self == self

main :: fn() -> i32 {
    m :: Meters { .v = 2 }
    return if m.same() { 0 } else { 1 }
}
