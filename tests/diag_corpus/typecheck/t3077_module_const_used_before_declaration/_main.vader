// A struct-literal const is typed before the bodies, so a body declared above it
// sees its frozen type and cannot store it in a field that promises mutation.
// T3077.
module "snippet"

Inner :: struct {
    n: i32
}

Box :: struct {
    inner: Inner!
}

main :: fn() -> i32 {
    b :: Box { .inner = INNER }
    b.inner.n = 9
    return INNER.n
}

INNER :: Inner { .n = 1 }
