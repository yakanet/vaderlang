// T3043: a union compares by variant, so every variant but `null` needs a `==` of
// its own. `Square` has no `Equals`, so `Circle | Square` has no `==` either:
// the diagnostic names the variant, which is what needs the impl.
module "snippet"

Circle :: struct {
    r: i32
}

Circle implements Equals -> self.r == other.r

Square :: struct {
    side: i32
}

main :: fn() -> i32 {
    a: Circle | Square: Circle { .r = 1 }
    b: Circle | Square: Circle { .r = 1 }
    return if a == b { 0 } else { 1 }
}
