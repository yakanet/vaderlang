// A guard's contract speaks of the argument : a body writing the parameter, in
// place or from a lambda, would hide it. So does an `@ensures`.
module "snippet"

import "std/abort"

export Weekday :: Int in 0..=6
export Weekend :: Int in 5..=6

@returns(d in Weekend)
export always :: fn(d: Weekday) -> bool {
    d = 6
    return d >= 5
}

@returns(d in Weekend)
export through_a_lambda :: fn(d: Weekday) -> bool {
    move :: () -> void
    {
        d = 6
    }
    move()
    return d >= 5
}

@ensures(d in Weekend)
export forces :: fn(d: Weekday) -> void {
    d = 6
    if d !in Weekend {
        panic("not a weekend day")
    }
}

export main :: fn() -> i32 {
    return 0
}
