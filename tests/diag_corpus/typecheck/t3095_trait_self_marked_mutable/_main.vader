// `Self` in a trait's signature carries the marker written on it. `-> Self!`
// promises a value the caller may mutate, so an impl handing back the read-only
// `ORIGIN` breaks the promise (T3095) — `relay` would write into it. A member that
// copies a written `Self!` parameter is the trait's own signature, and passes.
module "snippet"

Holder :: struct {
    n: i32
}

ORIGIN :: Holder { .n = 1 }

Make :: trait {
    make :: fn(self) -> Self!
    take :: fn(self, other: Self!) -> void
    poke :: fn(self!) -> void
}

Holder implements Make {
    make :: fn(self) -> Holder = ORIGIN
    take :: fn(self, other: Self!) -> void {
        other.n = 9
    }
    poke :: fn(self!) -> void {
        self.n = 9
    }
}

relay :: fn<M: Make>(m: M) -> void {
    x :: m.make()
    x.poke()
}

main :: fn() -> i32 {
    relay(Holder { .n = 2 })
    return ORIGIN.n
}
