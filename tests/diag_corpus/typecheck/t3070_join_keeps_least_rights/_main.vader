// A join of `Box<Cfg>` and `Box<Cfg!>` holds a `Box<Cfg>` : the value is either box,
// and `b1` holds the read-only `CFG`. Through `get`, its `Cfg` is read-only, whether
// joined by an `if` or by an array literal, and the join itself, whose contents'
// rights differ, is read-only. A join of `fn() -> Cfg!` and `fn() -> Cfg` returns a
// read-only `Cfg` the same way. T3070 four times.
module "snippet"

Cfg :: struct {
    n: i32
}

CFG :: Cfg { .n = 1 }

Box :: struct<T> {
    v: T
}

get :: fn<T>(b: Box<T>) -> T = b.v

wrap :: fn(c: Cfg) -> Box<Cfg!> = Box<Cfg!> { .v = c }

fresh :: fn() -> Cfg! = Cfg { .n = 1 }

shared :: fn() -> Cfg = CFG

main :: fn() -> i32 {
    b1: Box<Cfg>: Box<Cfg> { .v = CFG }
    b2 :: wrap(Cfg { .n = 1 })
    joined :: if b1.v.n == 1 { b1 } else { b2 }
    get(joined).n = 5
    joined.v = CFG
    listed :: [b1, b2]
    get(listed[0]).n = 5
    make :: if CFG.n == 1 { shared } else { fresh }
    make().n = 5
    return CFG.n
}
