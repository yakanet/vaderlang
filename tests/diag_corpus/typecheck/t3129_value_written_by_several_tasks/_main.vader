// T3129 : two tasks write the same counter, neither joined before the other starts.
module "snippet"

import "std/task"

Stats :: struct {
    lines: i64 = 0
}

count_into :: fn(stats: Stats) -> void {
    stats.lines += 1
}

main :: fn() -> i32 {
    stats :: Stats {}
    a :: launch(() -> count_into(stats))
    b :: launch(() -> count_into(stats))
    a.join()
    b.join()
    return i32(stats.lines) - 2
}
