// `@singleton` shares what a top-level function builds, and is declared for
// one: on a trait or an impl member it is refused.
module "snippet"

Box :: struct {
    n: i32
}

@singleton
Shape :: trait {
    area :: fn(self) -> i32
}

Box implements Shape {
    @singleton
    area :: fn(self) -> i32 = self.n
}

main :: fn() -> i32 = 0
