// An expression-bodied lambda's trailing value is its return, held to the type the
// slot promised — rights included, as a named fn's is : handing out a module const
// where a mutable `Cfg` is promised is T3077.
module "snippet"

Cfg :: struct {
    n: i32
}

ORIGIN :: Cfg { .n = 1 }

make :: fn<T>(f: fn() -> T) -> T = f()

main :: fn() -> i32 {
    x: Cfg!: make(() -> ORIGIN)
    x.n = 99
    return ORIGIN.n
}
