// An `@extern` parameter of an enum with variant data: T3050, even with a
// written width. Such an enum stores its variant's rank, so C would read 1
// where the source says 404.
module "snippet"

StatusInfo :: struct { reason: string }

HttpStatus :: enum(StatusInfo, i32) {
    Ok       { .reason = "OK" }        = 200,
    NotFound { .reason = "Not Found" } = 404,
}

@extern send_status :: fn(status: HttpStatus) -> i32

main :: fn() -> i32 { return 0 }
