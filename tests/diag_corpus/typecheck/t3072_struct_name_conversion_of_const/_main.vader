// A struct's name called on one value converts it, and a conversion hands out
// what it was lent : `Point(ORIGIN)` is the const, not a copy. T3072.
module "snippet"

Point :: struct {
    x: i32
}

ORIGIN :: Point { .x = 1 }

bump :: fn(p: Point!) -> void {
    p.x = 9
}

main :: fn() -> i32 {
    bump(Point(ORIGIN))
    return ORIGIN.x
}
