// A UFCS receiver is the call's first argument, held to the parameter's rights
// below its own level as `poke(h)` would be : `h.poke()` would hand the read-only
// `ORIGIN` inside `h` to a callee that writes through it. T3077.
module "snippet"

Cfg :: struct {
    n: i32
}

Box :: struct<T> {
    v: T
}

ORIGIN :: Cfg { .n = 1 }

poke :: fn(b: Box<Cfg!>) -> void {
    b.v.n = 9
}

main :: fn() -> i32 {
    h :: Box<Cfg> { .v = ORIGIN }
    h.poke()
    return ORIGIN.n
}
