// A `!` on a module const asks for real storage: a writable global that grows like
// any other array. The marker belongs on the array level: a marker below it, or on a
// const that is no array, has no storage to make writable. An aggregate element type
// starts empty, whatever its initialiser: the elements of a value the compiler bakes
// are emitted as `static const` objects, so a write into one would land in
// `.rodata`. T3076, six times.
module "snippet"

Spec :: struct { code: i32 }

TPL:    Spec![]:  [Spec { .code = 1 }]
TPL2:   Spec![]!: [Spec { .code = 2 }]
INNER:  i32[]![]: [[3]]
ORIGIN: Spec!:    Spec { .code = 0 }
QUEUE:  Spec[]!:  [Spec { .code = 4 }]
BASE:   Spec[]:   [Spec { .code = 6 }]
FROM:   Spec[]!:  BASE
EMPTY:  Spec[]!:  []

main :: fn() -> i32 {
    EMPTY.push(Spec { .code = 5 })
    return TPL[0].code + TPL2[0].code + INNER[0][0] + ORIGIN.code + QUEUE[0].code + FROM[0].code
}
