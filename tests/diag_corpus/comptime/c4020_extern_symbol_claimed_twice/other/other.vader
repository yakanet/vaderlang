// The second declarations of `abs`, `labs` and `llabs`.
module "snippet/other"

import "std/ffi"

LIBC :: CLibrary { .name = "c", .headers = ["<stdlib.h>"] }

@extern("abs")
export other_abs :: fn(x: i32) -> i32

@extern(LIBC, "labs")
export other_labs :: fn(x: i64) -> i64

@extern(LIBC, "llabs")
export other_llabs :: fn(x: i64) -> i64
