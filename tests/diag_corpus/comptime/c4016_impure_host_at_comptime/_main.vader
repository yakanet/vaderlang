// A `@comptime` const that reaches an impure INTRINSIC host (here `current_os`, via
// the VM-backed comptime pass) is refused with C4016 : running it at build time
// would bake a non-reproducible value and break the byte-identical bootstrap.
//
// The gate judges an intrinsic by IDENTITY, which is why it can tell a pure host
// from an impure one. An `@extern` is known only by its symbol name and is NOT
// refused — reproducibility is then the caller's business, and this tree's own
// is checked by `bootstrap/verify.sh`.
module "snippet"

import "std/target"

@comptime
export INTERACTIVE_AT_BUILD :: read_tty()

// `current_os` will never leave the intrinsics: it answers for the machine the
// COMPILER runs on, and baking that would make a macOS emit differ from a Linux
// one for the same source — which `seed.sh check` compares byte for byte.
read_tty :: fn() -> string {
    if current_os() == Os.Darwin { return "mac" }
    return "other"
}

main :: fn() -> i32 {
    // Reference the const so its RHS is inlined and the VM-backed comptime pass
    // actually evaluates `read_tty` (an unused const is skipped silently).
    return i32(INTERACTIVE_AT_BUILD.byte_len())
}
