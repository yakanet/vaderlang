// W0017 — the body mutates the parameter or the annotated local at the level the `!`
// is written on, so the compiler deduces the marker anyway. Quiet on a contract : a
// trait member and a callback's type have no body to deduce from.

module "snippet"

Box :: struct { n: i32 }

// The warning, at the top level and at the element.
bump :: fn(b: Box!) -> void {
    b.n += 1
}
bump_first :: fn(xs: Box![]) -> void {
    xs[0].n += 1
}

// The warning through a call : `twice` mutates `b` by handing it to `bump`.
twice :: fn(b: Box!) -> void {
    bump(b)
    bump(b)
}

// The warning on an annotated local, and on a local fn's parameter.
fill :: fn() -> Box[] {
    out: Box[]!: []
    out.push(Box { .n = 1 })
    return out
}
poke_local :: fn() -> i32 {
    poke :: fn(b: Box!) -> void {
        b.n = 2
    }
    b :: Box { .n = 1 }
    poke(b)
    return b.n
}

// Quiet — a trait member is a contract.
Bump :: trait {
    poke :: fn(self!) -> void
}

// Quiet — a callback's type is a contract too.
each :: fn(xs: Box[], f: fn(Box!) -> void) -> void {
    for x in xs {
        f(x)
    }
}

// The warning through a static member : `through_static` hands `b` to `reset`.
Resetter :: trait {
    reset :: fn(b: Self!) -> void
}

Box implements Resetter {
    reset :: fn(b: Box) -> void {
        b.n = 3
    }
}

through_static :: fn(b: Box!) -> void {
    Box.reset(b)
}
