// The property this whole mechanism rests on: a body whose `@target` does not
// match the compilation target is NEVER TYPED — not merely dropped from the
// artefact. `main-windows.vader` carries a deliberate type error; it must be
// invisible everywhere except on Windows.

module "main"

import "std/io"

@target
export platform_tag :: fn() -> string = "posix"

@target
export platform_kind :: fn() -> string = "posix"

main :: fn() -> i32 {
    println(platform_tag())
    return 0
}
