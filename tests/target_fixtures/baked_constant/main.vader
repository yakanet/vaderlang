// `VADER_OS` — the compilation target as a VALUE, generated per build and seeded
// into the prelude beside `std/core`, so a file that imports nothing can still
// branch on it at comptime.
//
// The distinction it exists for: this is the target the build is FOR.
// `std/target::current_os()` answers the other question — the platform the
// program is RUNNING on — and the two differ whenever a build is cross-compiled.

module "main"

import "std/target"

SEP :: if VADER_OS == Os.Windows { "BACKSLASH" } else { "SLASH" }

main :: fn() -> i32 {
    if SEP == "" {
        return 1
    }
    return 0
}
