module "src"

import "std/io"

// Deliberately violates the driver's rule — the fixture's whole point.
badlyNamed :: struct { x: i32 }

// Satisfies it, so the rule is shown to discriminate rather than fire always.
WellNamed :: struct { y: i32 }

main :: fn() -> i32 {
    // Both used, so the only diagnostic is the driver's own rule.
    a :: badlyNamed { .x = 1 }
    b :: WellNamed { .y = 2 }
    println("hello ${a.x + b.y}")
    return 0
}
