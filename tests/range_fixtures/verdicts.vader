// tests/range_fixtures/verdicts — one function per case `vader dump --stage=ranges`
// must judge; `tests/range_analysis.test.ts` holds the expected verdicts.

module "verdicts"

import "std/io"
import "std/iter"

/// An index below the length the loop compares against: proven.
export indexed_loop :: fn(xs: i32[]) -> i32 {
    total := 0
    for i in 0..<xs.len() {
        total += xs[i]
    }
    return total
}

/// Indices below a length an early return bounds from below: proven.
export early_exit :: fn(xs: i32[]) -> i32 {
    if xs.len() < 2 {
        return 0
    }
    return xs[0] + xs[1]
}

/// A counter stepped while below an `i32` bound cannot overflow: proven.
export counter_below_bound :: fn(n: i32) -> i32 {
    i := 0
    for i < n {
        i += 1
    }
    return i
}

/// A push only grows the array, so the length fact survives it: proven.
export push_keeps_length :: fn(xs: i32[]) -> i32 {
    total := 0
    for i in 0..<xs.len() {
        xs.push(1)
        total += xs[i]
    }
    return total
}

/// `println` ends in foreign code, lent a buffer, never its length: proven.
export println_keeps_length :: fn(xs: i32[]) -> i32 {
    total := 0
    for i in 0..<xs.len() {
        println("step")
        total += xs[i]
    }
    return total
}

/// A callee that shortens no array keeps the length fact: proven.
export call_keeps_length :: fn(xs: i32[]) -> i32 {
    total := 0
    for i in 0..<xs.len() {
        total = scramble(total)
        total += xs[i]
    }
    return total
}

// Shortens nothing and calls nothing.
scramble :: fn(x: i32) -> i32 = x *% 31

/// A callee that shortens an array, another one here, drops every length fact:
/// unproven.
export callee_shortens :: fn(xs: i32[], stack: i32[]) -> i32 {
    total := 0
    for i in 0..<xs.len() {
        pop(stack)
        total += xs[i]
    }
    return total
}

pop :: fn(stack: i32[]) -> void {
    _ :: stack.remove_last()
}

/// A recursive callee that shortens no array keeps the length fact: proven.
export recursive_callee_keeps_length :: fn(xs: i32[]) -> i32 {
    total := 0
    for i in 0..<xs.len() {
        total = countdown(total)
        total += xs[i]
    }
    return total
}

countdown :: fn(n: i32) -> i32 {
    if n <= 0 {
        return 0
    }
    return countdown(n -% 1)
}

/// Something with an area.
export Shape :: trait {
    area :: fn(self) -> i32
}

Square :: struct {
    side: i32
}

Square implements Shape {
    area :: fn(self) -> i32 = self.side *% self.side
}

/// A virtual call none of whose implementations shortens an array keeps the
/// length fact: proven.
export virtual_call_keeps_length :: fn(xs: i32[], s: Shape) -> i32 {
    total := 0
    for i in 0..<xs.len() {
        total = s.area()
        total += xs[i]
    }
    return total
}

/// Hands a `Square` out as a `Shape`, so the virtual call has an implementation
/// to land on.
export unit_square :: fn() -> Shape = Square { .side = 1 }

/// An indirect call may run any function a value is taken of, `pop` among them:
/// unproven.
export indirect_call_drops_length :: fn(xs: i32[], f: fn(i32) -> i32) -> i32 {
    total := 0
    for i in 0..<xs.len() {
        total = f(total)
        total += xs[i]
    }
    return total
}

/// Takes `pop` as a value.
export shortening_callback :: fn() -> fn(i32[]) -> void = pop

/// An unsigned decrement behind `n > 0`: proven.
export guarded_decrement :: fn(n: usize) -> usize {
    if n > 0 {
        return n - 1
    }
    return 0
}

/// An unsigned decrement of any value: unproven.
export unguarded_decrement :: fn(n: usize) -> usize = n - 1

/// `255 + 1` in `u8`, whenever it runs: a certain fault.
export always_overflows :: fn(x: u8) -> u8 {
    if x == 255 {
        return x + 1
    }
    return x
}

/// An access behind `n < 0` on a `usize`: unreachable.
export impossible_branch :: fn(xs: i32[], n: usize) -> i32 {
    if n < 0 {
        return xs[n]
    }
    return 0
}

/// An index that is always `-1`: a certain fault.
export negative_index :: fn(xs: i32[]) -> i32 {
    i: i32: -1
    return xs[i]
}

/// The last index of an array that may be empty: unproven, and so is the
/// `len - 1` that computes it.
export last_element :: fn(xs: i32[]) -> i32 = xs[xs.len() - 1]

/// The last index of an array known not to be empty: proven, and so is the
/// `len - 1`, a second read of the length being at least the first.
export guarded_last :: fn(xs: i32[]) -> i32 {
    if xs.len() > 0 {
        return xs[xs.len() - 1]
    }
    return 0
}

/// The element a foreach reads: proven.
export foreach_element :: fn(xs: i32[]) -> i32 {
    total := 0
    for x in xs {
        total += x
    }
    return total
}

/// The element a fused `map` reads, its callback a call: proven.
export fused_map_element :: fn(xs: i32[]) -> i32 {
    total := 0
    for y in xs.map(double) {
        total += y
    }
    return total
}

double :: fn(x: i32) -> i32 = x + x

/// The elements of both arrays a fused `chain` reads: proven.
export fused_chain_elements :: fn(xs: i32[], ys: i32[]) -> i32 {
    total := 0
    for z in xs.chain(ys) {
        total += z
    }
    return total
}
