// tests/fixtures/virtual_threads: virtual threads under the collector, past the
// end of their stack, through a panic, inside a call to C, asleep, cancelled,
// deadlocked, and alive when `main` returns. `tests/virtual_threads.test.ts`
// builds it once and runs each case, which `THREADS_CASE` names.

module "main"

import "std/abort"
import "std/env"
import "std/io"
import "std/runtime"
import "std/runtime/scheduler"
import "std/time"

// The threads `spawn` started, which `join_all` waits for.
Threads :: struct {
    running: i64 = 0
    /// The thread waiting in `join_all`, or -1.
    joiner: i64 = -1
    /// The threads waiting in `wait_for_release`.
    waiting: i64[] = []
    released: bool = false
}

@singleton
threads :: fn() -> Threads = Threads {}

spawn :: fn(entry: fn() -> void) -> i64 {
    t :: threads()
    t.running += 1
    return spawn_thread(fn() {
        defer finished()
        entry()
    })
}

finished :: fn() -> void {
    t :: threads()
    t.running -= 1
    if t.running == 0 && t.joiner >= 0 {
        wake(t.joiner)
    }
}

join_all :: fn() -> void {
    t :: threads()
    t.joiner = current_thread()
    for t.running > 0 {
        park()
    }
    t.joiner = -1
}

yield_now :: fn() -> void {
    wake(current_thread())
    park()
}

wait_for_release :: fn() -> void {
    t :: threads()
    t.waiting.push(current_thread())
    for !t.released {
        park()
    }
}

release_all :: fn() -> void {
    t :: threads()
    t.released = true
    for thread in t.waiting {
        wake(thread)
    }
    t.waiting.clear()
}

park_forever :: fn() -> void {
    for {
        park()
    }
}

// ---- parked threads stay rooted -------------------------------------------

Node :: struct {
    value: i64
    next: Node | null = null
}

// Never leaves the frame that builds it, so it lives on that frame's stack.
Holder :: struct {
    nodes: Node
}

chain :: fn(n: i64, base: i64) -> Node {
    head := Node { .value = base }
    for i in 1..<n {
        head = Node { .value = base + i, .next = head }
    }
    return head
}

sum :: fn(head: Node) -> i64 {
    total: i64 = 0
    cur: Node | null = head
    for cur != null {
        total += cur.value
        cur = cur.next
    }
    return total
}

// Park holding a chain of nodes, the same chain through an object on the
// stack, a string made at run time and a pending defer, then check them all.
worker :: fn(id: i64) -> void {
    nodes :: chain(50, id * 1000)
    holder :: Holder { .nodes = chain(50, id * 1000) }
    label :: "thread-${id}"
    defer println("defer of ${label}")
    wait_for_release()
    expected: i64: 50 * id * 1000 + 49 * 50 / 2
    if sum(nodes) != expected || sum(holder.nodes) != expected {
        println("${label}: expected ${expected}, got ${sum(nodes)} and ${sum(holder.nodes)}")
        return
    }
    println("${label} ok")
}

// Three threads park, main makes garbage and collects, then wakes them.
parked_roots :: fn() -> void {
    for id in 0..<3 {
        spawn(() -> worker(id))
    }
    yield_now()
    garbage: i64 = 0
    for k in 0..<20000 {
        garbage += sum(chain(10, k))
    }
    collect()
    release_all()
    join_all()
    println("garbage ${garbage}")
}

// ---- a thread past the end of its stack -----------------------------------

depth :: fn(n: i64, label: string) -> i64 {
    if n == 0 {
        return 0
    }
    s :: "${label}${n}"
    return depth(n - 1, label) + s.byte_len()
}

// The first thread returns, the second stops on the guard zone of its stack.
overflow :: fn() -> void {
    spawn(() -> println("depth 1000: ${depth(1000, "x")}"))
    spawn(() -> println("depth 1000000: ${depth(1000000, "x")}"))
    join_all()
    println("not reached")
}

// ---- a panic in each of two threads ---------------------------------------

unwind_first :: fn() -> void {
    println("defer of first, before the yield")
    yield_now()
    println("defer of first, after the yield")
}

// The first thread panics, and its defer yields while it runs, which runs the
// second, which panics too: each thread runs its own defers.
two_panics :: fn() -> void {
    spawn(fn() {
        defer unwind_first()
        panic("first")
    })
    spawn(fn() {
        defer println("defer of second")
        panic("second")
    })
    join_all()
    println("not reached")
}

// ---- a switch inside a call to C ------------------------------------------

@c_header("<stdlib.h>")
@extern("qsort")
c_qsort :: fn(
    @c_out base: i32[],
    count: u64,
    size: u64,
    compare: fn(CPointer, CPointer) -> i32,
) -> void

compare_nothing :: fn(a: CPointer, b: CPointer) -> i32 = 0

// Yields from inside `qsort`: another thread would run over its frames.
compare_and_yield :: fn(a: CPointer, b: CPointer) -> i32 {
    yield_now()
    return 0
}

// A switch after the call is free; one inside it stops the program.
switch_in_callback :: fn() -> void {
    values: i32[]: [3, 1, 2]
    c_qsort(values, 3, 4, compare_nothing)
    yield_now()
    println("back from qsort")
    c_qsort(values, 3, 4, compare_and_yield)
    println("not reached")
}

// ---- the order of the ready threads ---------------------------------------

// Each thread yields between its steps: the ready ones run in turn.
take_turns :: fn() -> void {
    for name in ["a", "b", "c"] {
        spawn(fn() {
            for step in 0..<2 {
                println("${name}${step}")
                yield_now()
            }
        })
    }
    join_all()
    println("joined")
}

// ---- sleeps ---------------------------------------------------------------

// Under the virtual clock: the shortest sleep ends first, whatever the order
// the threads fell asleep in.
sleep_order :: fn() -> void {
    durations: i64[]: [30, 10, 20]
    for ms in durations {
        spawn(fn() {
            sleep_for(ms * 1_000_000)
            println("slept ${ms} ms")
        })
    }
    join_all()
}

// A thread sleeps while main wakes it: a wake does not end a sleep.
real_sleep :: fn() -> void {
    started :: monotonic()
    sleeper :: spawn(() -> sleep_for(20_000_000))
    yield_now()
    wake(sleeper)
    join_all()
    elapsed :: started.since().to_millis()
    if elapsed < 20 {
        println("woke after ${elapsed} ms")
        return
    }
    println("slept at least 20 ms")
}

// ---- cancellation ---------------------------------------------------------

// A parked thread runs its defers once cancelled.
cancel_parked :: fn() -> void {
    parked :: spawn(fn() {
        defer println("defer of the parked thread")
        park_forever()
    })
    yield_now()
    cancel_thread(parked)
    join_all()
    println("joined")
}

// A thread cancelled before it ran runs nothing, and main returns with no
// thread left.
cancel_unstarted :: fn() -> void {
    unstarted :: spawn_thread(() -> println("not reached"))
    cancel_thread(unstarted)
    yield_now()
    println("cancelled before it ran")
}

// A thread that cancels itself does not come back from it.
cancel_self :: fn() -> void {
    spawn(fn() {
        defer println("defer of the thread")
        cancel_thread(current_thread())
        println("not reached")
    })
    join_all()
    println("joined")
}

unwind_cancelled :: fn() -> void {
    println("defer starts")
    yield_now()
    println("defer ends")
}

// The defer of a cancelled thread yields: main runs meanwhile, then the defer
// goes on.
cancel_defer_parks :: fn() -> void {
    parked :: spawn(fn() {
        defer unwind_cancelled()
        park_forever()
    })
    yield_now()
    cancel_thread(parked)
    yield_now()
    println("main between")
    join_all()
    println("joined")
}

cancel_main :: fn() -> void {
    cancel_thread(current_thread())
    println("not reached")
}

// ---- nothing left to run --------------------------------------------------

// Main waits for a thread that waits for nothing that will come.
deadlock :: fn() -> void {
    spawn(park_forever)
    join_all()
    println("not reached")
}

// Main returns while a thread waits: the thread is cancelled and runs its
// defers, and the exit code says so.
exit_with_live_thread :: fn() -> void {
    spawn(fn() {
        defer println("defer of the forgotten thread")
        park_forever()
    })
    yield_now()
    println("main returns")
}

// Main cancels a thread and returns before the thread's defers ran: main waits
// for them, and names nothing.
exit_after_cancel :: fn() -> void {
    parked :: spawn(fn() {
        defer println("defer of the cancelled thread")
        park_forever()
    })
    yield_now()
    cancel_thread(parked)
    println("main returns")
}

// Three bursts of threads, more than the stacks kept warm, with a sleep
// between them: the stacks freed during a sleep go back to the OS, and the
// next burst reserves them again.
bursts :: fn() -> void {
    for _ in 0..<3 {
        for _ in 0..<200 {
            spawn(yield_now)
        }
        join_all()
        sleep_for(1_000_000)
    }
    println("three bursts of 200 threads")
}

main :: fn() -> i32 {
    case :: get_env("THREADS_CASE") ?? ""
    match case {
        "parked_roots"          -> parked_roots()
        "overflow"              -> overflow()
        "two_panics"            -> two_panics()
        "switch_in_callback"    -> switch_in_callback()
        "take_turns"            -> take_turns()
        "sleep_order"           -> sleep_order()
        "real_sleep"            -> real_sleep()
        "cancel_parked"         -> cancel_parked()
        "cancel_unstarted"      -> cancel_unstarted()
        "cancel_self"           -> cancel_self()
        "cancel_defer_parks"    -> cancel_defer_parks()
        "cancel_main"           -> cancel_main()
        "deadlock"              -> deadlock()
        "exit_with_live_thread" -> exit_with_live_thread()
        "exit_after_cancel"     -> exit_after_cancel()
        "bursts"                -> bursts()
        _                       -> {
            eprintln("THREADS_CASE: `${case}` names no case")
            return 2
        }
    }
    return 0
}
