// tests/fixtures/virtual_threads: virtual threads under the collector, past the
// end of their stack, through a panic, inside a call to C, asleep, waiting for
// stdin or a child, cancelled with the threads they launched, before they start
// or not, deadlocked, and alive when `main` returns.
// `tools/cli_tests/threads` builds it once per profile and runs each case,
// which `THREADS_CASE` names.

module "main"

Process :: import "std/process"
Win :: import "system/windows"
import "std/abort"
import "std/env"
import "std/ffi"
import "std/console"
import "std/io"
import "std/runtime"
import "std/runtime/scheduler"
import "std/task"
import "std/time"

// The threads `spawn` started, which `join_all` waits for.
Threads :: struct {
    running: i64 = 0
    /// The thread waiting in `join_all`, or -1.
    joiner: i64 = -1
    /// The threads waiting in `wait_for_release`.
    waiting: i64[] = []
    released: bool = false
}

@singleton
threads :: fn() -> Threads = Threads {}

// Start `entry` on a thread `join_all` waits for. One cancelled before it starts
// runs nothing.
spawn :: fn(entry: fn() -> void) -> i64 {
    t :: threads()
    t.running += 1
    return spawn_thread(fn() {
        defer finished()
        if is_cancelled() {
            return
        }
        entry()
    })
}

finished :: fn() -> void {
    t :: threads()
    t.running -= 1
    if t.running == 0 && t.joiner >= 0 {
        wake(t.joiner)
    }
}

join_all :: fn() -> void {
    t :: threads()
    t.joiner = current_thread()
    for t.running > 0 {
        park()
    }
    t.joiner = -1
}

yield_now :: fn() -> void {
    wake(current_thread())
    park()
}

wait_for_release :: fn() -> void {
    t :: threads()
    t.waiting.push(current_thread())
    for !t.released {
        park()
    }
}

release_all :: fn() -> void {
    t :: threads()
    t.released = true
    for thread in t.waiting {
        wake(thread)
    }
    t.waiting.clear()
}

park_forever :: fn() -> void {
    for {
        park()
    }
}

// ---- parked threads stay rooted -------------------------------------------

Node :: struct {
    value: i64
    next: Node | null = null
}

// Never leaves the frame that builds it, so it lives on that frame's stack.
Holder :: struct {
    nodes: Node
}

chain :: fn(n: i64, base: i64) -> Node {
    head := Node { .value = base }
    for i in 1..<n {
        head = Node { .value = base + i, .next = head }
    }
    return head
}

sum :: fn(head: Node) -> i64 {
    total: i64 = 0
    cur: Node | null = head
    for cur != null {
        total += cur.value
        cur = cur.next
    }
    return total
}

// Park holding a chain of nodes, the same chain through an object on the
// stack, a string made at run time and a pending defer, then check them all.
worker :: fn(id: i64) -> void {
    nodes :: chain(50, id * 1000)
    holder :: Holder { .nodes = chain(50, id * 1000) }
    label :: "thread-${id}"
    defer println("defer of ${label}")
    wait_for_release()
    expected: i64: 50 * id * 1000 + 49 * 50 / 2
    if sum(nodes) != expected || sum(holder.nodes) != expected {
        println("${label}: expected ${expected}, got ${sum(nodes)} and ${sum(holder.nodes)}")
        return
    }
    println("${label} ok")
}

// Three threads park, main makes garbage and collects, then wakes them.
parked_roots :: fn() -> void {
    for id in 0..<3 {
        spawn(() -> worker(id))
    }
    yield_now()
    garbage: i64 = 0
    for k in 0..<20000 {
        garbage += sum(chain(10, k))
    }
    collect()
    release_all()
    join_all()
    println("garbage ${garbage}")
}

// ---- a thread past the end of its stack -----------------------------------

depth :: fn(n: i64, label: string) -> i64 {
    if n == 0 {
        return 0
    }
    s :: "${label}${n}"
    return depth(n - 1, label) + s.byte_len()
}

// The first thread returns, the second stops on the guard zone of its stack.
overflow :: fn() -> void {
    spawn(() -> println("depth 1000: ${depth(1000, "x")}"))
    spawn(() -> println("depth 1000000: ${depth(1000000, "x")}"))
    join_all()
    println("not reached")
}

// ---- a panic in each of two threads ---------------------------------------

unwind_first :: fn() -> void {
    println("defer of first, before the yield")
    yield_now()
    println("defer of first, after the yield")
}

// The first thread panics, and its defer yields while it runs, which runs the
// second, which panics too: each thread runs its own defers.
two_panics :: fn() -> void {
    spawn(fn() {
        defer unwind_first()
        panic("first")
    })
    spawn(fn() {
        defer println("defer of second")
        panic("second")
    })
    join_all()
    println("not reached")
}

// ---- a switch inside a call to C ------------------------------------------

@c_header("<stdlib.h>")
@extern("qsort")
c_qsort :: fn(
    @c_out base: i32[],
    count: u64,
    size: u64,
    compare: fn(CPointer, CPointer) -> i32,
) -> void

compare_nothing :: fn(a: CPointer, b: CPointer) -> i32 = 0

// Yields from inside `qsort`: another thread would run over its frames.
compare_and_yield :: fn(a: CPointer, b: CPointer) -> i32 {
    yield_now()
    return 0
}

// A switch after the call is free; one inside it stops the program.
switch_in_callback :: fn() -> void {
    values: i32[]: [3, 1, 2]
    c_qsort(values, 3, 4, compare_nothing)
    yield_now()
    println("back from qsort")
    c_qsort(values, 3, 4, compare_and_yield)
    println("not reached")
}

// ---- the order of the ready threads ---------------------------------------

// Each thread yields between its steps: the ready ones run in turn.
take_turns :: fn() -> void {
    for name in ["a", "b", "c"] {
        spawn(fn() {
            for step in 0..<2 {
                println("${name}${step}")
                yield_now()
            }
        })
    }
    join_all()
    println("joined")
}

// ---- sleeps ---------------------------------------------------------------

// Under the virtual clock: the shortest sleep ends first, whatever the order
// the threads fell asleep in.
sleep_order :: fn() -> void {
    durations: i64[]: [30, 10, 20]
    for ms in durations {
        spawn(fn() {
            sleep_for(ms * 1_000_000)
            println("slept ${ms} ms")
        })
    }
    join_all()
}

// Under the virtual clock: sleeps that end together end in the order they
// began.
sleep_ties :: fn() -> void {
    for name in ["a", "b", "c"] {
        spawn(fn() {
            sleep_for(10_000_000)
            println("${name} woke")
        })
    }
    join_all()
}

// A thread sleeps while main wakes it: a wake does not end a sleep.
real_sleep :: fn() -> void {
    started :: monotonic()
    sleeper :: spawn(() -> sleep_for(20_000_000))
    yield_now()
    wake(sleeper)
    join_all()
    elapsed :: started.since().to_millis()
    if elapsed < 20 {
        println("woke after ${elapsed} ms")
        return
    }
    println("slept at least 20 ms")
}

// ---- descriptors and children ---------------------------------------------

// A thread ticks while main waits for a line of stdin, which the harness writes
// once it reads the last tick.
stdin_parks :: fn() -> void {
    spawn(fn() {
        for i in 0..<3 {
            println("tick ${i}")
            yield_now()
        }
    })
    print_line_read()
    join_all()
}

// Read a line of stdin and say what came.
print_line_read :: fn() -> void {
    line :: read_line()
    if line is IOError {
        println("stdin: ${line.msg}")
    } else {
        println("read ${line}")
    }
}

// A thread ticks while main polls stdin: a first poll ends at its deadline,
// before the next tick, and a second one once the harness writes the line it
// waits for, on reading the last tick.
stdin_polls :: fn() -> void {
    spawn(fn() {
        for i in 0..<3 {
            println("tick ${i}")
            sleep(40.millis())
        }
    })
    if !poll_stdin(10.millis()) {
        println("a first poll gives up")
    }
    if poll_stdin(5000.millis()) {
        println("a second poll finds the line")
    }
    print_line_read()
    join_all()
}

// Main gives up a poll of stdin while a thread runs, then polls again once
// alone: the second poll ends at its deadline too, though nothing came. It then
// reads the line the harness writes on that message: exiting first would close
// the pipe under the write.
stdin_polls_alone :: fn() -> void {
    spawn(fn() {
        sleep(20.millis())
    })
    if !poll_stdin(5.millis()) {
        println("a poll beside a thread gives up")
    }
    join_all()
    if !poll_stdin(50.millis()) {
        println("a poll alone gives up")
    }
    print_line_read()
}

// Main, alone, waits for a child that writes more than a pipe holds before it
// ends: the wait drains the pipe as it fills.
spawn_drains :: fn() -> void {
    r :: Process.spawn(chatty_child())
    if r is Process.ProcessError {
        println("spawn: ${r.msg}")
        return
    }
    println("the child wrote ${r.stdout.byte_len()} bytes and exited with ${r.exit}")
}

// A child that writes 100 000 bytes on its stdout.
@target
chatty_child :: fn() -> string[] = ["sh", "-c", "yes | head -c 100000"]

@target(.Windows)
chatty_child :: fn() -> string[] = [
    "powershell", "-NoProfile", "-Command", "[Console]::Out.Write('y' * 100000)",
]

// A pipe `create_watched_pipe` made is watched: the park ends once a thread
// writes. An anonymous pipe takes no overlapped read, so its watch is refused,
// and the park ends every few milliseconds instead, without ever blocking.
@target
pipe_watches :: fn() -> void = println("a pipe of Windows")

@target(.Windows)
pipe_watches :: fn() -> void {
    r: u64[]: [0]
    w: u64[]: [0]
    if !Win.create_watched_pipe(r, w) {
        println("create_watched_pipe failed")
        return
    }
    watched :: parks_until_written(Win.ptr_at(r, 0), Win.ptr_at(w, 0), i64(r[0]))
    println("a watched pipe wakes its reader at once: ${watched < 3}")
    ar: u64[]: [0]
    aw: u64[]: [0]
    if !create_anonymous_pipe(ar, aw, null, 0) {
        println("CreatePipe failed")
        return
    }
    polled :: parks_until_written(Win.ptr_at(ar, 0), Win.ptr_at(aw, 0), i64(ar[0]))
    println("an anonymous pipe is polled: ${polled >= 3}")
}

KERNEL32 :: CLibrary { .name = "kernel32", .headers = ["<windows.h>"] }

@extern(KERNEL32, "CreatePipe")
create_anonymous_pipe :: fn(@c_out read_end: u64[], @c_out write_end: u64[],
                            attrs: CPointer | null, size: u32) -> bool

// How many parks main makes, watching `id`, before the pipe `r` holds the byte a
// thread writes on `w` after 300 ms.
parks_until_written :: fn(r: Win.Handle, w: Win.Handle, id: i64) -> i64 {
    spawn(fn() {
        sleep(300.millis())
        written: u32[]: [0]
        Win.write_file(w, [0x79], 1, written, null)
    })
    parks := 0
    for !pipe_holds_data(r) {
        watch_readable(id)
        park()
        parks += 1
    }
    join_all()
    return parks
}

pipe_holds_data :: fn(h: Win.Handle) -> bool {
    available: u32[]: [0]
    return Win.peek_named_pipe(h, null, 0, null, available, null) && available[0] > 0
}

// ---- cancellation ---------------------------------------------------------

// A parked thread runs its defers once cancelled.
cancel_parked :: fn() -> void {
    parked :: spawn(fn() {
        defer println("defer of the parked thread")
        park_forever()
    })
    yield_now()
    cancel_thread(parked)
    join_all()
    println("joined")
}

// A thread cancelled before it ran runs its entry, which knows, and main
// returns with no thread left.
cancel_unstarted :: fn() -> void {
    unstarted :: spawn_thread(fn() {
        if is_cancelled() {
            println("cancelled before it ran")
        }
    })
    cancel_thread(unstarted)
    yield_now()
    println("main returns")
}

// A thread that cancels itself does not come back from it.
cancel_self :: fn() -> void {
    spawn(fn() {
        defer println("defer of the thread")
        cancel_thread(current_thread())
        println("not reached")
    })
    join_all()
    println("joined")
}

unwind_cancelled :: fn() -> void {
    println("defer starts")
    yield_now()
    println("defer ends")
}

// The defer of a cancelled thread yields: main runs meanwhile, then the defer
// goes on.
cancel_defer_parks :: fn() -> void {
    parked :: spawn(fn() {
        defer unwind_cancelled()
        park_forever()
    })
    yield_now()
    cancel_thread(parked)
    yield_now()
    println("main between")
    join_all()
    println("joined")
}

cancel_main :: fn() -> void {
    cancel_thread(current_thread())
    println("not reached")
}

// A thread that launches another, each parked until cancelled.
spawn_launcher :: fn() -> i64 = spawn(fn() {
    defer println("defer of the launcher")
    spawn(fn() {
        defer println("defer of the launched")
        park_forever()
    })
    park_forever()
})

// Cancelling a thread cancels the one it launched, whose defers run first.
cancel_cascades :: fn() -> void {
    launcher :: spawn_launcher()
    yield_now()
    cancel_thread(launcher)
    join_all()
    println("joined")
}

// A thread cancels itself once it launched another, which has not started: both
// end.
cascade_unstarted :: fn() -> void {
    spawn(fn() {
        spawn(() -> println("not reached"))
        cancel_thread(current_thread())
    })
    join_all()
    println("joined")
}

// ---- nothing left to run --------------------------------------------------

// Main waits for a thread that waits for nothing that will come.
deadlock :: fn() -> void {
    spawn(park_forever)
    join_all()
    println("not reached")
}

// Main returns while a thread waits: the thread is cancelled and runs its
// defers, and the exit code says so.
exit_with_live_thread :: fn() -> void {
    spawn(fn() {
        defer println("defer of the forgotten thread")
        park_forever()
    })
    yield_now()
    println("main returns")
}

// Main cancels a thread and returns before the thread's defers ran: main waits
// for them, and names nothing.
exit_after_cancel :: fn() -> void {
    parked :: spawn(fn() {
        defer println("defer of the cancelled thread")
        park_forever()
    })
    yield_now()
    cancel_thread(parked)
    println("main returns")
}

// Main cancels a thread and returns once both threads have started: the one it
// launched is cancelled with it, and neither is named.
exit_after_cascade :: fn() -> void {
    launcher :: spawn_launcher()
    yield_now()
    yield_now()
    cancel_thread(launcher)
    println("main returns")
}

// A defer of a cancelled thread launches a thread, then yields.
launch_and_yield :: fn() -> void {
    spawn_thread(fn() {
        defer println("defer of the launched")
        park_forever()
    })
    yield_now()
}

// Main returns while a thread it cancelled runs a defer that launched a thread:
// the launched one outlives its launcher, and is named alone.
exit_defer_launches :: fn() -> void {
    parked :: spawn_thread(fn() {
        defer launch_and_yield()
        park_forever()
    })
    yield_now()
    cancel_thread(parked)
    yield_now()
    println("main returns")
}

// Main returns while two threads wait, after a third, started before them,
// ended: the report names the two in the order they started.
exit_names_in_order :: fn() -> void {
    spawn_thread(() -> println("the first thread ends"))
    spawn_thread(park_forever)
    spawn_thread(park_forever)
    yield_now()
    println("main returns")
}

// Three bursts of threads, more than the stacks kept warm, with a sleep
// between them: the stacks freed during a sleep go back to the OS, and the
// next burst reserves them again.
bursts :: fn() -> void {
    for _ in 0..<3 {
        for _ in 0..<200 {
            spawn(yield_now)
        }
        join_all()
        sleep_for(1_000_000)
    }
    println("three bursts of 200 threads")
}

main :: fn() -> i32 {
    case :: get_env("THREADS_CASE") else ""
    match case {
        "parked_roots"          -> parked_roots()
        "overflow"              -> overflow()
        "two_panics"            -> two_panics()
        "switch_in_callback"    -> switch_in_callback()
        "take_turns"            -> take_turns()
        "sleep_order"           -> sleep_order()
        "sleep_ties"            -> sleep_ties()
        "real_sleep"            -> real_sleep()
        "stdin_parks"           -> stdin_parks()
        "stdin_polls"           -> stdin_polls()
        "stdin_polls_alone"     -> stdin_polls_alone()
        "spawn_drains"          -> spawn_drains()
        "pipe_watches"          -> pipe_watches()
        "cancel_parked"         -> cancel_parked()
        "cancel_unstarted"      -> cancel_unstarted()
        "cancel_self"           -> cancel_self()
        "cancel_defer_parks"    -> cancel_defer_parks()
        "cancel_main"           -> cancel_main()
        "cancel_cascades"       -> cancel_cascades()
        "cascade_unstarted"     -> cascade_unstarted()
        "deadlock"              -> deadlock()
        "exit_with_live_thread" -> exit_with_live_thread()
        "exit_after_cancel"     -> exit_after_cancel()
        "exit_after_cascade"    -> exit_after_cascade()
        "exit_defer_launches"   -> exit_defer_launches()
        "exit_names_in_order"   -> exit_names_in_order()
        "bursts"                -> bursts()
        _                       -> {
            eprintln("THREADS_CASE: `${case}` names no case")
            return 2
        }
    }
    return 0
}
