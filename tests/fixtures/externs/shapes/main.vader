// One `@extern` of each shape, for `vader dump --stage=externs`, which lists each
// as the C prototype it is called through (`externs.snapshot.c`).
//
// The program calls one of the nine: the listing holds the eight it never calls
// too, which a native build drops. One line per shape: a scalar lent by address
// (`const`), a lent array C writes (`void*`), a mirror lent and written, a lent
// array whose elements `@c_type` names, a `@c_type` on a parameter and on the
// result, a string with no header, a `string | null` result with no header
// (`const char*`), and a variadic, whose variadic argument the comment names
// after the mangle.

module "main"

import "std/ffi"

DEMO :: CLibrary { .name = "demo", .headers = ["<demo.h>"] }

@c_struct("struct timespec")
Timespec :: struct { tv_sec: i64, tv_nsec: i64 }

@extern("puts")
c_puts :: fn(s: string) -> i32

@extern("ttyname")
terminal_name :: fn(fd: i32) -> string | null

@c_header("<fcntl.h>")
@extern("fcntl")
set_flags :: fn(fd: i32, command: i32, @c_variadic flags: i32) -> i32

@extern(DEMO, "demo_fill")
demo_fill :: fn(@c_out buf: u8[], size: u64) -> i64

@extern(DEMO, "demo_now")
demo_now :: fn(@c_out t: Timespec) -> i32

@extern(DEMO, "demo_count")
demo_count :: fn(@c_address n: u32) -> void

@extern(DEMO, "demo_read")
demo_read :: fn(@c_type("unsigned int") cells: u32[]) -> void

@c_type("size_t")
@extern(DEMO, "demo_size")
demo_size :: fn(@c_type("size_t") n: u64) -> u64

main :: fn() -> i32 {
    return c_puts("hi")
}
