// What a driver receives of the decorators a module writes, those above its
// `module` line included: the module that declares each, which the build
// resolved, and its value, one named argument per field holding a literal. A
// `@comptime` argument arrives computed, a default left out filled in.

module "build"

import "std/console"
import "std/string"
import "toolchain/build"
AST :: import "toolchain/ast"

build :: fn(args: string[]) -> i32 {
    ctx :: new_build_context(args)
    ctx.add_entry("app", "src/main.vader")
    exit := 0
    for msg in ctx.messages() {
        if msg is TypecheckedMessage && msg.module_name == "app" {
            for dec in msg.decorators {
                println("driver: ${described(dec)} on the module")
            }
            for d in msg.declarations {
                show_decorators(d)
            }
        }
        if msg is CompleteMessage {
            exit = msg.code
        }
    }
    return exit
}

show_decorators :: fn(d: AST.Decl) -> void {
    for dec in AST.decl_decorators(d) {
        println("driver: ${described(dec)} on ${named(d)}")
    }
    if d is AST.StructDecl {
        for f in d.fields {
            for dec in f.decorators {
                println("driver: ${described(dec)} on ${d.name}.${f.name}")
            }
        }
    }
}

// @partial: the module decorates only functions and fields.
named :: fn(d: AST.Decl) -> string = @partial match d {
    is AST.FnDecl -> d.name
    _             -> "another declaration"
}

described :: fn(dec: AST.Decorator) -> string =
    "@${dec.name} of `${dec.module_name}` (${arguments(dec.args)})"

arguments :: fn(args: AST.CallArg[]) -> string {
    shown: string[]: []
    for a in args {
        name :: a.name else "_"
        shown.push("${name} = ${shape(a.value)}")
    }
    return shown.join(", ")
}

// The string `e` holds, quoted, or what else it is.
shape :: fn(e: AST.Expr) -> string {
    text :: AST.string_literal_text(e) else return "not a string"
    return "\"${text}\""
}
