// A project whose JSON serialisers are written by a build plugin.
//
// There is no `to_json` anywhere in this tree: `build.vader` plugs `json/derive`
// in, which reads the typed declarations, walks each struct's FIELD TYPES, and
// generates one serialiser per struct marked `@json` into the struct's own
// module. So `to_json` below resolves to generated code, and it can take `Person`
// by type because the generated file is a module sibling, not an imported module.

module "app"

import "json"
import "std/console"

@json
Address :: struct {
    city: string
    zip:  i32
}

@json
Person :: struct {
    @json_name("full_name")
    name:   string
    age:    i32
    active: bool
    home:   Address
    tags:   string[]
    @json_skip
    token:  string = "secret"
}

main :: fn() -> i32 {
    p :: Person {
        .name   = "A\"B",
        .age    = 41,
        .active = true,
        .home   = Address { .city = "Lyon", .zip = 69001 },
        .tags   = ["x", "y"],
    }
    println(to_json(p))
    return 0
}

// ---- tests ----------------------------------------------------------------
//
// These are the assertions this fixture makes, and they are Vader rather than
// TypeScript on purpose: what they call (`to_json`, written by `json/derive`)
// exists only because the driven build produced it. `build/generated/` is a merge
// root for the resolver, so a hand-written test reaches generated declarations
// like any other. Before a build they are `R2006`, which is what makes them a
// proof that generation worked rather than a test of hand-written code.
//
// The consequence, so it is not mistaken for a bug: an EDITOR flags `to_json`
// below as unresolved. Resolving it needs the generated tree on disk, and nothing
// that comes out of a build is committed: `generated.snapshot` beside this file
// is what carries the generator's text for review instead.

import "std/testing"

@test
test_nested_struct_has_its_own_serialiser :: fn() -> void {
    // One serialiser per struct, so `Address` is serialisable on its own, not
    // only as a field of `Person`.
    assert_eq(to_json(Address { .city = "Lyon", .zip = 69001 }),
              "{\"city\":\"Lyon\",\"zip\":69001}")
}

@test
test_every_field_kind_maps :: fn() -> void {
    // Every mapping the generator makes, in one value: a string carrying a quote
    // (escaped by `json`, not by hand), an i32 as a bare number, a bool, a
    // NESTED struct recursed through its own generated overload, and an array.
    p :: Person {
        .name   = "A\"B",
        .age    = 41,
        .active = true,
        .home   = Address { .city = "Lyon", .zip = 69001 },
        .tags   = ["x", "y"],
    }
    assert_eq(to_json(p),
              "{\"full_name\":\"A\\\"B\",\"age\":41,\"active\":true,\"home\":{\"city\":\"Lyon\",\"zip\":69001},\"tags\":[\"x\",\"y\"]}")
}

@test
test_a_field_is_renamed_or_skipped_as_its_decorator_says :: fn() -> void {
    p :: Person {
        .name   = "Ada",
        .age    = 36,
        .active = false,
        .home   = Address { .city = "London", .zip = 1 },
        .tags   = [],
    }
    text :: to_json(p)
    assert(text.contains("\"full_name\":\"Ada\""), text)
    assert(!text.contains("secret"), text)
}
