// A project whose JSON serialisers are written by a source stage.
//
// There is no `to_json` anywhere in this tree: `build.vader` plugs `json/derive`
// in, which reads the declarations, walks each struct's FIELD TYPES, and writes
// an impl of `ToJson` (`json`) per struct marked `@json` into the struct's own
// module. So `to_json` below is the trait's, reached through that impl, which can
// take `Person` by type because the written file joins the module, not an
// imported one. The impl's body comes once the comptime has run, so the key of
// `zip` is the value `postal` computes.

module "app"

import "geo"
import "json"
import "std/console"

// The key of a postal field.
postal :: fn(name: string) -> string = "postal_${name}"

@json
Address :: struct {
    city: string
    @json_name(@comptime postal("code"))
    zip:  i32
}

@json
Person :: struct {
    @json_name("full_name")
    name:   string
    age:    i32
    active: bool
    home:   Address
    tags:   string[]
    @json_skip
    token:  string = "secret"
}

main :: fn() -> i32 {
    p :: Person {
        .name   = "A\"B",
        .age    = 41,
        .active = true,
        .home   = Address { .city = "Lyon", .zip = 69001 },
        .tags   = ["x", "y"],
    }
    println(p.to_json())
    return 0
}

// ---- tests ----------------------------------------------------------------
//
// These are the assertions this fixture makes: what they call (`to_json`, written
// by `json/derive`) exists only because the driven build ran the stage. `vader
// test` loads the project once the driver is done, and replays what the stage
// wrote in that build (`build/stages/`). Before a build they are `R2006`, which
// is what makes them a proof that the stage ran rather than a test of
// hand-written code. `expanded.snapshot` beside this file carries the text the
// stage writes, for review.

import "std/testing"

@test
test_nested_struct_has_its_own_serialiser :: fn() -> void {
    // One impl per struct, so `Address` is serialisable on its own, not
    // only as a field of `Person`.
    assert_eq(Address { .city = "Lyon", .zip = 69001 }.to_json(),
              "{\"city\":\"Lyon\",\"postal_code\":69001}")
}

@test
test_every_field_kind_maps :: fn() -> void {
    // Every mapping the generator makes, in one value: a string carrying a quote
    // (escaped by `json`, not by hand), an i32 as a bare number, a bool, a
    // NESTED struct recursed through its own generated impl, and an array.
    p :: Person {
        .name   = "A\"B",
        .age    = 41,
        .active = true,
        .home   = Address { .city = "Lyon", .zip = 69001 },
        .tags   = ["x", "y"],
    }
    assert_eq(p.to_json(),
              "{\"full_name\":\"A\\\"B\",\"age\":41,\"active\":true,\"home\":{\"city\":\"Lyon\",\"postal_code\":69001},\"tags\":[\"x\",\"y\"]}")
}

@test
test_a_field_is_renamed_or_skipped_as_its_decorator_says :: fn() -> void {
    p :: Person {
        .name   = "Ada",
        .age    = 36,
        .active = false,
        .home   = Address { .city = "London", .zip = 1 },
        .tags   = [],
    }
    text :: p.to_json()
    assert(text.contains("\"full_name\":\"Ada\""), text)
    assert(!text.contains("secret"), text)
}

@test
test_a_struct_of_another_module_is_serialised_by_its_own_impl :: fn() -> void {
    assert_eq(Point { .lat = 45.5, .lon = 4.0 }.to_json(), "{\"lat\":45.5,\"lon\":4}")
}
