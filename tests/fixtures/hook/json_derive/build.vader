// A driver whose JSON serialisers come from a source stage shipped as a library:
// `json/derive` reads each struct of the project marked `@json` and writes its
// `to_json` into the struct's module, while the build loads the project.

module "build"

import "json/derive"
import "toolchain/build"

build :: fn(args: string[]) -> i32 {
    ctx :: new_build_context(args)
    ctx.add_entry("app", "src/main.vader")
    ctx.use(JsonDerive {})
    return ctx.emit_native()
}
