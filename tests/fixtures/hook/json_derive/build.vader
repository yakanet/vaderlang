// A driver whose JSON serialisers come from a plugin shipped as a library:
// `json/derive` reads each struct of `app` and writes its `to_json` into `app`.

module "build"

import "json/derive"
import "toolchain/build"

build :: fn(args: string[]) -> i32 {
    ctx :: new_build_context(args)
    ctx.add_entry("app", "src/main.vader")
    ctx.use(JsonDerive { .modules = ["app"] })
    return ctx.emit_native()
}
