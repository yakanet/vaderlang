// A driver that only observes: it leaves the stream at `BeforeEmit`, so nothing
// is written. That phase is the last point where declining is clean — after it,
// a `break` would leave a partial binary.

module "build"

import "std/io"
import "toolchain/build"

build :: fn(args: string[]) -> i32 {
    ctx :: new_build_context(args)
    ctx.add_build_file("src/main.vader")
    // A canary, not a name: if emission ever moved above `BeforeEmit`, the build
    // would print `wrote <project>/should-not-exist` and the committed
    // expectation would fail on that line.
    ctx.out = "should-not-exist"

    seen := 0
    for msg in ctx.messages() {
        if msg is TypecheckedMessage {
            seen += 1
        }
        if msg is PhaseMessage as p {
            if p.phase == .BeforeEmit {
                break
            }
        }
    }
    println("observed ${seen} module(s), built nothing")
    return 0
}
