// A project driving its own build: one house rule, checked at compile time.
//
// `vader build` with no file argument finds this file, compiles it, and runs
// `build` — which then decides what to compile. See vader/cli/driver.vader.
//
// Draining `messages()` IS the build: the front end runs once and the back end
// reuses it. A driver that only wanted to lint would leave the loop at
// `BeforeEmit`, which writes nothing.

module "build"

import "std/io"
import "std/string"
import "toolchain/build"
AST :: import "toolchain/ast"

build :: fn(args: string[]) -> i32 {
    ctx :: new_build_context(args)
    ctx.add_entry("hello", "src/main.vader")

    exit := 0
    for msg in ctx.messages() {
        if msg is TypecheckedMessage {
            // Every typed module is yielded, stdlib included — which modules
            // are "this project" is the driver's call.
            //
            // The filter is on the DECLARED module name. When `module_name`
            // carried the loader's filesystem key instead, this matched nothing
            // and the rule ran over the stdlib too — so the committed
            // expectation showing no `std/…` report is what pins that fix.
            if msg.module_name.starts_with("std/") {
                continue
            }
            for d in msg.declarations {
                if d is AST.StructDecl {
                    first :: d.name[0..<1]
                    if first.to_upper() != first {
                        ctx.report(d.name_span, "struct `${d.name}` should be PascalCase")
                    }
                }
            }
        }
        if msg is CompleteMessage {
            exit = msg.code
        }
    }

    // A reported rule violation fails the build — that is the point of a house
    // rule. Without this the driver would report and still exit 0.
    if ctx.flush_reports() {
        println("driver: ${ctx.reports_of().len()} report(s) — build failed")
        return 1
    }
    return exit
}
