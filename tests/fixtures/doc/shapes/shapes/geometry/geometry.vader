// shapes/geometry: the `vader doc` fixture's main module, over two files.
//
// The plane, its points and its quadrants.

module "shapes/geometry"

/// A point of the plane.
///
/// Both coordinates are in the same unit.
export Point :: struct {
    /// The abscissa.
    x: f64
    y: f64
    /// Kept by the module: no member of the data.
    @internal
    cache: f64 = 0.0
}

/// The distance between `a` and `b`. Always positive or zero.
///
/// @param a  the first point.
/// @param b  the second point,
///           possibly `a` itself.
/// @return   the distance, in the unit of the points.
/// @example
///   # o :: Point { .x = 0.0, .y = 0.0 }
///   distance(o, Point { .x = 3.0, .y = 4.0 })   // 5.0
export distance :: fn(a: Point, b: Point) -> f64 = 0.0

/// `p`, `k` times as far from the origin.
export scaled :: fn(p: Point, k: f64) -> Point = Point { .x = p.x * k, .y = p.y * k }

/// `p`, `k` times as far from the origin, `k` whole.
export scaled :: fn(p: Point, k: i32) -> Point = Point { .x = p.x * f64(k), .y = p.y * f64(k) }

export Quadrant :: enum {
    /// Both coordinates positive.
    First,
    Second,
}

/// The origin of the plane.
export ORIGIN :: Point { .x = 0.0, .y = 0.0 }

/// `n`, twice: its return type is left to inference.
export twice :: fn(n: i32) = n * 2

// Private: left out of the data.
mirror :: fn(p: Point) -> Point = Point { .x = -p.x, .y = -p.y }
