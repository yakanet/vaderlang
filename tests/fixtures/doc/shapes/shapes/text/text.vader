// shapes/text: a second module of the `vader doc` fixture.

module "shapes/text"

/// What can name itself.
export Named :: trait {
    /// The name, as a reader sees it.
    name :: fn(self) -> string
}

/// A label: some text.
export Label :: string

/// A tag on a shape.
export Tag :: struct {
    text: string
}

/// A tag is named by its text.
Tag implements Named {
    /// The text of the tag, its return type left to inference.
    name :: fn(self) = self.text
}

// No caller can name a mark, nor reach its impl: the data leaves both out.
Mark :: struct {
    text: string
}

Mark implements Named {
    name :: fn(self) = "mark ${self.text}"
}

/// The name of a mark on `text`, the impl of `Named` for a private type.
///
/// @param text  what the mark says.
export mark_name :: fn(text: string) -> string = Mark { .text = text }.name()
