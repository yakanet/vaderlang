// tests/fixtures/callee/sites: one function per shape of site `vader dump
// --stage=callees` must settle, a call expression or an operator or index that
// calls through a trait; `tests/callee_sites.test.ts` holds what each one invokes.

module "sites"

import "std/io"
import "std/string"

M :: import "std/math"

double :: fn(x: i32) -> i32 = x *% 2

describe :: fn(x: i32) -> string = "i32"
describe :: fn(x: string) -> string = "string"

tag :: fn(s: string) -> string = s

same :: fn<T>(x: T) -> T = x

export Shape :: trait {
    area :: fn(self) -> i32
    twice :: fn(self) -> i32 = self.area()
}

export Origin :: trait {
    origin :: fn() -> Self
}

export Square :: struct {
    side: i32
}

Square implements Shape {
    area :: fn(self) -> i32 = self.side
}

export Circle :: struct {
    radius: i32
}

Circle implements Shape {
    area :: fn(self) -> i32 = self.radius
}

i64 implements Origin {
    origin :: fn() -> i64 = 0
}

export Scale :: trait<By> {
    scaled :: fn(self, by: By) -> Square
}

Square implements Scale<i32> {
    scaled :: fn(self, by: i32) -> Square = Square { .side = self.side *% by }
}

Square implements Scale<Square> {
    scaled :: fn(self, by: Square) -> Square = Square { .side = self.side *% by.side }
}

make :: fn() -> fn(i32) -> i32 = double

export Money :: struct {
    cents: i64
}

Money implements Add {
    add :: fn(self, other: Money) -> Money = Money { .cents = self.cents +% other.cents }
}

Money implements Comparable {
    compare :: fn(self, other: Money) -> i32 = if self.cents < other.cents { -1 } else { 0 }
}

Money implements Display {
    to_string :: fn(self) -> string = "${self.cents}"
}

Money implements Equals {
    equals :: fn(self, other: Money) -> bool = self.cents == other.cents
}

export Grid :: struct {
    cells: i32[]
}

Grid implements Index<i64, i32> {
    at :: fn(self, i: i64) -> i32 = self.cells[i]
}

Grid implements IndexSet<i64, i32> {
    set_at :: fn(self, i: i64, v: i32) -> void {
        self.cells[i] = v
    }
}

export Bag :: struct {
    items: i32[]
}

Bag implements Contains<i32> {
    contains :: fn(self, value: i32) -> bool = value in self.items
}

Bag implements Equals {
    equals :: fn(self, other: Bag) -> bool = self.items.len() == other.items.len()
}

export Meters :: struct {
    v: i32
}

Meters implements Into<i64> {
    into :: fn(self) -> i64 = i64(self.v)
}

export Ticks :: i64

Ticks implements Into<i64> {
    into :: fn(self) -> i64 = i64(self)
}

export Countdown :: struct {
    n: i32
}

Countdown implements Iterator<i32> {
    next :: fn(self) -> [i32, Continuation] {
        if self.n == 0 {
            return [0, .Stop]
        }
        self.n = self.n -% 1
        return [self.n, .Continue]
    }
}

export Deck :: struct {
    size: i32
}

Deck implements Into<Iterator<i32>> {
    into :: fn(self) -> Iterator<i32> = Countdown { .n = self.size }
}

evens :: fn(limit: i32) -> Iterator<i32> {
    for i in 0..<limit {
        yield i *% 2
    }
}

walk :: fn(it: Iterator<i32>) -> i64 {
    n: i64 = 0
    for _ in it {
        n += 1
    }
    return n
}

export Holder :: struct {
    f: fn(i32) -> i32
}

export Color :: enum {
    Red,
    Green,
}

export plain :: fn() -> i32 = double(1)

export overloaded :: fn() -> string = describe("s")

export ufcs_free :: fn() -> string = "s".tag()

export impl_member :: fn(s: Square) -> i32 = s.area()

export default_member :: fn(s: Square) -> i32 = s.twice()

export bounded :: fn<T: Shape>(x: T) -> i32 = x.area()

export trait_value :: fn(s: Shape) -> i32 = s.area()

export union_dispatch :: fn(u: Square | Circle) -> i32 = u.area()

export static_member :: fn() -> i64 = i64.origin()

export bounded_static :: fn<T: Origin>() -> void {
    _ :: T.origin()
}

export namespace_member :: fn(x: f64) -> f64 = M.sqrt(x)

export value_param :: fn(f: fn(i32) -> i32) -> i32 = f(1)

export field_value :: fn(h: Holder) -> i32 = h.f(1)

export cast :: fn(x: i32) -> i64 = i64(x)

export enum_equals :: fn(c: Color) -> bool = c.equals(.Red)

export array_op :: fn(xs: i32[]) -> i64 = xs.len()

export generic_ufcs :: fn<T>(x: T) -> T = x.same()

export library :: fn() -> void = println("x")

export overloaded_member :: fn(s: Square) -> Square = s.scaled(s.scaled(2))

export returned_value :: fn() -> i32 = make()(1)

export struct_operator :: fn(a: Money, b: Money) -> Money = a + b

export struct_ordering :: fn(a: Money, b: Money) -> bool = a < b

export bounded_operator :: fn<T: Add>(a: T, b: T) -> T = a + b

export struct_equality :: fn(a: Money, b: Money) -> bool = a == b

export tuple_equality :: fn(a: [Money, i32], b: [Money, i32]) -> bool = a == b

export union_equality :: fn(a: Money | i32, b: Money | i32) -> bool = a == b

export union_against_variant :: fn(a: Money | Bag, b: Money) -> bool = a == b

export tuple_of_structs :: fn(a: [Money, Bag], b: [Money, Bag]) -> bool = a == b

export bounded_equality :: fn<T: Equals>(a: T, b: T) -> bool = a == b

export bounded_null :: fn<T>(x: T | null) -> bool = x == null

export bare_bounded_null :: fn<T: Equals>(x: T) -> bool = x == null

export custom_in :: fn(b: Bag) -> bool = 1 in b

export index_read :: fn(g: Grid) -> i32 = g[0]

export index_write :: fn(g: Grid) -> void {
    g[0] = 1
}

export index_update :: fn(g: Grid) -> void {
    g[0] += 1
}

export string_index :: fn(s: string) -> char = s[0]

export array_index :: fn(xs: i32[]) -> i32 = xs[0]

export cast_through_into :: fn(m: Meters) -> i64 = i64(m)

export implicit_into :: fn(m: Meters) -> i64 {
    x: i64: m
    return x
}

export array_into_iterator :: fn() -> i64 = walk([1, 2])

export distinct_backing :: fn(t: Ticks) -> i64 {
    x: i64: t
    return x
}

export for_array :: fn(xs: i32[]) -> i64 {
    n: i64 = 0
    for _ in xs {
        n += 1
    }
    return n
}

export for_range :: fn() -> i64 {
    n: i64 = 0
    for _ in 0..<3 {
        n += 1
    }
    return n
}

export for_iterator :: fn(c: Countdown) -> i64 {
    n: i64 = 0
    for _ in c {
        n += 1
    }
    return n
}

export for_into_iterator :: fn(d: Deck) -> i64 {
    n: i64 = 0
    for _ in d {
        n += 1
    }
    return n
}

export for_generator :: fn() -> i64 {
    n: i64 = 0
    for _ in evens(4) {
        n += 1
    }
    return n
}

export for_string :: fn(s: string) -> i64 {
    n: i64 = 0
    for _ in s {
        n += 1
    }
    return n
}

export for_char_range :: fn() -> i64 {
    n: i64 = 0
    for _ in 'a'..='e' {
        n += 1
    }
    return n
}

export for_bounded :: fn<T: Iterator<i32>>(t: T) -> i64 {
    n: i64 = 0
    for _ in t {
        n += 1
    }
    return n
}

export for_array_sugar :: fn(xs: i32[]) -> i64 {
    n: i64 = 0
    for xs {
        n += 1
    }
    return n
}

export Label :: string

export interpolations :: fn(n: i32, s: string, x: f64, m: Money, l: Label) -> string =
    "${n} ${s} ${x} ${m} ${l}"

export bounded_interpolation :: fn<T: Display>(t: T) -> string = "${t}"

export trait_value_interpolation :: fn(d: Display) -> string = "${d}"

export assigned_into :: fn(m: Meters) -> i64 {
    x: i64 = 0
    x = m
    return x
}

export coalesced_into :: fn(found: i64 | null, m: Meters) -> i64 = found ?? m
