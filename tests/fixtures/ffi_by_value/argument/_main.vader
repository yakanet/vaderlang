// A struct PASSED by value, to a function nothing defines: the adapter `vader
// run` compiles for it does not link, and the run stops naming the extern and
// `vader build`. The program is never built natively.

module "main"

import "std/io"

@c_struct("div_t")
Div :: struct {
    quot: i32
    rem: i32
}

@extern
takes_div :: fn(d: Div) -> i32

main :: fn() -> i32 {
    println("${takes_div(Div { .quot = 7, .rem = 2 })}")
    return 0
}
