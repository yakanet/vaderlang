// tests/fixtures/format/coalesce_too_wide_explodes_the_call: a call before `??
// return ...` fits counting what follows it on the line: 110 columns as one
// line, its arguments go one per line.

module "coalesce_too_wide_explodes_the_call"

f :: fn(a: i32, b: i32, c: i32) -> i32 | null = null

g :: fn(first_parameter: i32, second_parameter: i32, third_parameter: i32) -> i32 | null {
    long_result_name :: f(
        first_parameter,
        second_parameter + third_parameter,
        third_parameter,
    ) ?? return null
    return long_result_name
}
