// tests/fixtures/format/text_block_exploded_call_collapses: a call written
// exploded around a text block, without a trailing comma, collapses onto it.

module "text_block_exploded_call_collapses"

emit :: fn(parts: string[]) -> void {
    parts.push(
        """
        local.get 0
        local.get 1
        array.get 1
        i32.const 0
        i32.eq
        """
    )
}
