// tests/fixtures/effect/frozen: one function per outcome of the frozen checks.
//
// `tests/effect_summary.test.ts` reads the `# frozen` section of `vader dump
// --stage=effects` on this file, and the errors the faults and the kept views
// are.

module "frozen"

import "std/iter"

export Cfg :: struct {
    n: i32
}

/// A struct no function of the program writes: a copy of one is left out.
export Untouched :: struct {
    n: i32
}

export Holder :: struct {
    cfg: Cfg
}

export CFG :: Cfg { .n = 1 }
export TABLE :: [Cfg { .n = 1 }]
export UNTOUCHED :: Untouched { .n = 1 }

export writes_a_field :: fn() -> void {
    CFG.n = 2
}

export pushes_onto_a_table :: fn() -> void {
    TABLE.push(Cfg { .n = 2 })
}

export bump :: fn(c: Cfg) -> void {
    c.n += 1
}

export bumps_a_constant :: fn() -> void {
    bump(CFG)
}

export lends_to_a_callback :: fn(f: fn(Cfg) -> void) -> void {
    f(CFG)
}

export binds_a_constant :: fn() -> i32 {
    c :: CFG
    return c.n
}

export binds_an_untouched_constant :: fn() -> i32 {
    u :: UNTOUCHED
    return u.n
}

export stores_a_constant :: fn() -> Holder = Holder { .cfg = CFG }

export returns_a_constant :: fn() -> Cfg = CFG

export reads_a_constant :: fn() -> i32 = CFG.n

export binds_a_view :: fn(s: string) -> u8 {
    bs :: s.bytes()
    return bs[0]
}

export iterates_a_table :: fn() -> i32 {
    total := 0
    for c in TABLE {
        total += c.n
    }
    return total
}

export UntouchedHolder :: struct {
    untouched: Untouched
}

export stores_an_untouched_constant :: fn() -> UntouchedHolder =
    UntouchedHolder { .untouched = UNTOUCHED }

export writes_a_copy :: fn() -> i32 {
    c :: CFG
    c.n = 2
    return c.n
}

export hands_back :: fn(c: Cfg) -> Cfg = c

export bumps_what_a_call_returns :: fn() -> void {
    bump(hands_back(CFG))
}

export set :: fn(c: Cfg) -> void {
    c.n = 0
}

// A recursive call lends the value on before the write: its chain still ends at it.
export fill :: fn(c: Cfg, k: i32) -> void {
    if k > 0 {
        fill(c, k - 1)
    }
    set(c)
}

export fills_a_constant :: fn() -> void {
    fill(CFG, 3)
}

export Node :: struct {
    v: i32
    kids: Node[]
}

export TREE :: Node { .v = 0, .kids = [Node { .v = 1, .kids = [] }] }

// A recursive walk lends a part of the value on: the cut path that stands for the
// tree keeps the chain to the write.
export clear :: fn(n: Node) -> void {
    for c in n.kids {
        c.v = 0
        clear(c)
    }
}

export clears_a_constant :: fn() -> void {
    clear(TREE)
}

// A view of a string's bytes is never copied: written, it is a fault ; kept, an
// error ; returned, its function hands views out, as `bytes()` does.
export writes_a_view :: fn(s: string) -> void {
    bs :: s.bytes()
    bs[0] = 1
}

export Bytes :: struct {
    b: u8[]
}

export keeps_a_view :: fn(s: string) -> Bytes = Bytes { .b = s.bytes() }

export hands_a_view :: fn(s: string) -> u8[] = s.bytes()

export grows_a_handed_view :: fn(s: string) -> void {
    hands_a_view(s).push(0)
}

// A copy is the way out: its bytes are its own.
export writes_a_copy_of_a_view :: fn(s: string) -> u8[] {
    c :: s.bytes().clone()
    c[0] = 1
    return c
}

export Failure :: struct {
    msg: string
}

export view_or_failure :: fn(s: string, fail: bool) -> u8[] | Failure {
    if fail {
        return Failure { .msg = "no" }
    }
    return s.bytes()
}

// A read narrowed to a type no byte array is: what it does is not done to the view
// the name may hold.
export keeps_a_failure :: fn(s: string, out: Failure[]) -> void {
    r :: view_or_failure(s, true)
    if r is Failure {
        r.msg = "kept"
        out.push(r)
    }
}
