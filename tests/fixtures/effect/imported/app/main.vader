// tests/fixtures/effect/imported — constants and singletons another module
// declares.
//
// `tests/effect_summary.test.ts` reads the `# frozen` section of `vader dump
// --stage=effects` on this project, then runs it. A constant reached through a
// namespace alias, or renamed by its import, is a use like a bare one: `hands_out`
// returns `L.CFG` and `limits` returns `CAPS`, each a copy. A singleton's instance
// is no constant: a name bound to `L.counts()` or `sums()` shares it, so its
// pushes show in the lengths.

module "app"

import "std/io"
import "vars" { LIMITS as CAPS, totals as sums }

L :: import "lib"

bump :: fn(c: L.Cfg) -> void {
    c.n += 1
}

hands_out :: fn() -> L.Cfg = L.CFG

limits :: fn() -> i32[] = CAPS

main :: fn() -> i32 {
    c :: L.Cfg { .n = 9 }
    bump(c)
    counts :: L.counts()
    counts.push(4)
    totals :: sums()
    totals.push(5)
    println(hands_out().n)
    println(limits().len())
    println(L.counts().len())
    println(sums().len())
    return 0
}
