// A program calling a C library through a `CLibrary` constant: the build adds
// the library's headers, its archive and its platform libraries by itself.

module "main"

import "greeter"
import "std/io"

main :: fn() -> i32 {
    println("${name()}: ${add(40, 2)}")
    scaled :: scale(Point { .x = 1.5, .y = -2.0 }, 2.0)
    println("scaled: ${scaled.x} ${scaled.y}")
    println("unboxed: ${unbox(box(7))}")
    return 0
}
