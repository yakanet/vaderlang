/// plb2 `sudoku` (https://github.com/attractivechaos/plb2): solve 20 hard
/// puzzles 200 times over with an exact-cover search. Each of the 729 rows (a
/// digit in a cell) covers four of the 324 constraints, and the search always
/// branches on the constraint with the fewest rows left.
///
/// Ported from plb2's Go version: the two cover tables are flat arrays laid out
/// as Go's fixed-size `[324][9]` and `[729][4]` arrays are, and the counters keep
/// Go's widths. As in the siblings, every solution is folded into a rolling
/// checksum instead of printed. The Go, Java and JavaScript siblings are plb2's
/// own programs.

module "main"

import "std/io"

REPEATS: i64: 200
CHECKSUM_MODULUS: i64: 1_000_000_007

HARD20: string[]: [
    "..............3.85..1.2.......5.7.....4...1...9.......5......73..2.1........4...9",
    ".......12........3..23..4....18....5.6..7.8.......9.....85.....9...4.5..47...6...",
    ".2..5.7..4..1....68....3...2....8..3.4..2.5.....6...1...2.9.....9......57.4...9..",
    "........3..1..56...9..4..7......9.5.7.......8.5.4.2....8..2..9...35..1..6........",
    "12.3....435....1....4........54..2..6...7.........8.9...31..5.......9.7.....6...8",
    "1.......2.9.4...5...6...7...5.9.3.......7.......85..4.7.....6...3...9.8...2.....1",
    ".......39.....1..5..3.5.8....8.9...6.7...2...1..4.......9.8..5..2....6..4..7.....",
    "12.3.....4.....3....3.5......42..5......8...9.6...5.7...15..2......9..6......7..8",
    "..3..6.8....1..2......7...4..9..8.6..3..4...1.7.2.....3....5.....5...6..98.....5.",
    "1.......9..67...2..8....4......75.3...5..2....6.3......9....8..6...4...1..25...6.",
    "..9...4...7.3...2.8...6...71..8....6....1..7.....56...3....5..1.4.....9...2...7..",
    "....9..5..1.....3...23..7....45...7.8.....2.......64...9..1.....8..6......54....7",
    "4...3.......6..8..........1....5..9..8....6...7.2........1.27..5.3....4.9........",
    "7.8...3.....2.1...5.........4.....263...8.......1...9..9.6....4....7.5...........",
    "3.7.4...........918........4.....7.....16.......25..........38..9....5...2.6.....",
    "........8..3...4...9..2..6.....79.......612...6.5.2.7...8...5...1.....2.4.5.....3",
    ".......1.4.........2...........5.4.7..8...3....1.9....3..4..2...5.1........8.6...",
    ".......12....35......6...7.7.....3.....4..8..1...........12.....8.....4..5....6..",
    "1.......2.9.4...5...6...7...5.3.4.......6........58.4...2...6...3...9.8.7.......1",
    ".....1.2.3...4.5.....6....7..2.....1.8..9..3.4.....8..5....2....9..3.4....67.....",
]

/// The exact-cover tables, built once and shared by every solve.
SdAux :: struct {
    /// The nine rows covering each constraint, at `constraint * 9 + k`.
    r: u16[]
    /// The four constraints each row covers, at `row * 4 + k`.
    c: u16[]
}

/// What the solves found: the solution count and the digits folded together.
Tally :: struct {
    solutions: i64
    checksum: i64
}

sd_genmat :: fn() -> SdAux {
    r_table: u16[]: [0] * (324 * 9)
    c_table: u16[]: [0] * (729 * 4)
    nr: i8[]: [0] * 324
    r: i64 = 0
    for i in 0..<9 {
        for j in 0..<9 {
            for k in 0..<9 {
                c_table[r * 4] = u16(9 * i + j)
                c_table[r * 4 + 1] = u16((i / 3 * 3 + j / 3) * 9 + k + 81)
                c_table[r * 4 + 2] = u16(9 * i + k + 162)
                c_table[r * 4 + 3] = u16(9 * j + k + 243)
                r += 1
            }
        }
    }
    for c in 0..<324 {
        nr[c] = 0
    }
    for row in 0..<729 {
        for c2 in 0..<4 {
            k :: i64(c_table[row * 4 + c2])
            r_table[k * 9 + i64(nr[k])] = u16(row)
            nr[k] += 1
        }
    }
    return SdAux { .r = r_table, .c = c_table }
}

sd_update_forward :: fn(aux: SdAux, sr: i8[], sc: u8[], r: u16) -> i64 {
    c_table :: aux.c
    r_table :: aux.r
    min: u8 = 10
    min_c: u16 = 0
    rows :: i64(r) * 4
    for c2 in 0..<4 {
        c :: i64(c_table[rows + c2])
        sc[c] = sc[c] | 0x80
    }
    for c2 in 0..<4 {
        c :: i64(c_table[rows + c2])
        for r2 in 0..<9 {
            rr :: i64(r_table[c * 9 + r2])
            sr[rr] += 1
            if sr[rr] != 1 {
                continue
            }
            for cc2 in 0..<4 {
                cc :: c_table[rr * 4 + cc2]
                v :: sc[cc] - 1
                sc[cc] = v
                if v < min {
                    min = v
                    min_c = cc
                }
            }
        }
    }
    return (i64(min) << 16) | i64(min_c)
}

sd_update_revert :: fn(aux: SdAux, sr: i8[], sc: u8[], r: u16) -> void {
    c_table :: aux.c
    r_table :: aux.r
    rows :: i64(r) * 4
    for c2 in 0..<4 {
        c :: i64(c_table[rows + c2])
        sc[c] = sc[c] & 0x7f
    }
    for c2 in 0..<4 {
        c :: i64(c_table[rows + c2])
        for r2 in 0..<9 {
            rr :: i64(r_table[c * 9 + r2])
            sr[rr] -= 1
            if sr[rr] != 0 {
                continue
            }
            for cc2 in 0..<4 {
                cc :: c_table[rr * 4 + cc2]
                sc[cc] += 1
            }
        }
    }
}

sd_solve :: fn(aux: SdAux, s: u8[], tally: Tally) -> void {
    r_table :: aux.r
    sr: i8[]: [0] * 729
    cr: i8[]: [0] * 81
    sc: u8[]: [0] * 324
    cc: i16[]: [0] * 81
    out: u8[]: [0] * 81
    hints: i64 = 0
    for c in 0..<324 {
        sc[c] = 9
    }
    for i in 0..<81 {
        a: i64 = -1
        if s[i] >= '1' && s[i] <= '9' {
            a = i64(s[i] - '1')
        }
        if a >= 0 {
            sd_update_forward(aux, sr, sc, u16(i * 9 + a))
            hints += 1
        }
        cr[i] = -1
        cc[i] = -1
        out[i] = s[i]
    }
    i: i64 = 0
    dir: i64 = 1
    cand: i64 = 10 << 16
    for {
        for i >= 0 && i < 81 - hints {
            if dir == 1 {
                min := u8(cand >> 16)
                cc[i] = i16(cand & 0xffff)
                if min > 1 {
                    for c in 0..<324 {
                        scc :: sc[c]
                        if scc < min {
                            min = scc
                            cc[i] = i16(c)
                            if min <= 1 {
                                break
                            }
                        }
                    }
                }
                if min == 0 || min == 10 {
                    cr[i] = -1
                    dir = -1
                    i -= 1
                }
            }
            c :: i64(cc[i])
            if dir == -1 && cr[i] >= 0 {
                sd_update_revert(aux, sr, sc, r_table[c * 9 + i64(cr[i])])
            }
            r2_found: i64 = 9
            for r2 in i64(cr[i]) + 1..<9 {
                if sr[r_table[c * 9 + r2]] == 0 {
                    r2_found = r2
                    break
                }
            }
            if r2_found < 9 {
                cand = sd_update_forward(aux, sr, sc, r_table[c * 9 + r2_found])
                cr[i] = i8(r2_found)
                dir = 1
                i += 1
            } else {
                cr[i] = -1
                dir = -1
                i -= 1
            }
        }
        if i < 0 {
            break
        }
        for j in 0..<i {
            r :: r_table[i64(cc[j]) * 9 + i64(cr[j])]
            out[r / 9] = u8(r % 9) + '1'
        }
        for ch in out {
            tally.checksum = (tally.checksum * 31 + i64(ch - '0')) % CHECKSUM_MODULUS
        }
        tally.solutions += 1
        i -= 1
        dir = -1
    }
}

main :: fn() -> i32 {
    aux :: sd_genmat()
    tally :: Tally { .solutions = 0, .checksum = 0 }
    puzzles: i64 = 0
    for 0..<REPEATS {
        for puzzle in HARD20 {
            if puzzle.byte_len() >= 81 {
                sd_solve(aux, puzzle.bytes(), tally)
                puzzles += 1
            }
        }
    }
    println(
        "plb2_sudoku puzzles=${puzzles} solutions=${tally.solutions} checksum=${tally.checksum}",
    )
    return 0
}
