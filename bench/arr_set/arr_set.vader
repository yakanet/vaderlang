/// Indexed read-modify-write hot loop bounded by `a.len()` — the counterpart to
/// `arr_rw` (which bounds on a separate `n`). Same computation and checksum as
/// `arr_rw`.

module "main"

import "std/io"

main :: fn() -> i32 {
    a: i32[]!: []
    for i in 0..<1024 { a.push(i32(i)) }
    sum: i64 = 0
    for 0..<100000 {
        for i in 0..<a.len() {
            a[i] = a[i] + 1
            sum = sum + i64(a[i])
        }
    }
    println("arr_set ${sum}")
    return 0
}
