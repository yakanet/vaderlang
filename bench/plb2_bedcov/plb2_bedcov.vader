/// plb2 `bedcov` (https://github.com/attractivechaos/plb2): sort 1 000 000
/// random intervals into an implicit interval tree, then measure how much of
/// each of another 1 000 000 intervals the tree covers. The tree is the sorted
/// array itself, each node recording the largest end below it, so a query
/// walks it with array reads in a binary-search pattern.
///
/// Ported from plb2's Go version, sort and all: an in-place radix sort one bit
/// at a time, then the tree walk with an explicit stack. Go keeps its intervals
/// and stack cells as values; here an interval is a struct reached through the
/// array, and the stack is 64 cells allocated once and rewritten in place, so
/// a query allocates nothing, as in Go. The Go, Java and JavaScript siblings
/// are plb2's own programs.

module "main"

import "std/io"

NUM_INTERVALS: i64: 1_000_000
INTERVAL_START_BITS: u64: 28
INTERVAL_LENGTH_BITS: u64: 14
STACK_DEPTH: i64: 64

/// SplitMix32: pseudo-random 32-bit numbers from a fixed seed.
SplitMix32 :: struct {
    state: u32
}

next_random :: fn(s: SplitMix32) -> u32 {
    s.state = s.state +% 0x9e3779b9
    z := s.state
    z = (z ^ (z >> 16)) *% 0x21f0aaad
    z = (z ^ (z >> 15)) *% 0x735a2d97
    return z ^ (z >> 15)
}

Interval :: struct {
    start: u64
    end: u64
    /// The largest `end` in the subtree this node roots, set when the tree is built.
    max: u64
    data: i64
}

/// One pending step of a tree walk: node `x` at level `k`, `w` set once its
/// left child has been pushed.
StackCell :: struct {
    x: i64
    k: i64
    w: i64
}

/// The sorted intervals, their tree depth, and the walk's reusable stack.
ImplicitIntervalTree :: struct {
    intervals: Interval[]
    depth: i64
    stack: StackCell[]
}

larger :: fn(a: u64, b: u64) = if a > b { a } else { b }

smaller :: fn(a: u64, b: u64) = if a < b { a } else { b }

/// The index of the highest set bit of `x`, -1 when `x` is 0.
highest_bit :: fn(x: u64) -> i64 {
    bit: i64 = -1
    rest := x
    for rest != 0 {
        bit += 1
        rest = rest >> 1
    }
    return bit
}

generate_intervals :: fn(num: i64, rng: SplitMix32, start_bits: u64, len_bits: u64) -> Interval[] {
    intervals: Interval[]: [] * num
    start_mask :: (1 << start_bits) - 1
    len_mask :: (1 << len_bits) - 1
    for ii in 0..<num {
        start :: u64(rng.next_random()) & start_mask
        end :: start + (u64(rng.next_random()) & len_mask)
        intervals.push(Interval {
            .start = start,
            .end = end,
            .max = 0,
            .data = ii,
        })
    }
    return intervals
}

inplace_radix_sort :: fn(intervals: Interval[]) -> void {
    max_start := intervals[0].start
    for interval in intervals {
        max_start = larger(max_start, interval.start)
    }
    max_bit :: highest_bit(max_start)
    if max_bit < 0 {
        return
    }
    radix_sort_recursive(intervals, 0, intervals.len(), u64(max_bit))
}

// Sorts `intervals[lo, hi)` on `bit`, then each half on the bits below it.
radix_sort_recursive :: fn(intervals: Interval[], lo: i64, hi: i64, bit: u64) -> void {
    if hi - lo <= 1 {
        return
    }
    mask :: 1 << bit
    index_bit0 := lo
    index_bit1 := hi - 1
    for {
        for intervals[index_bit0].start & mask == 0 && index_bit0 < index_bit1 {
            index_bit0 += 1
        }
        for intervals[index_bit1].start & mask > 0 && index_bit1 > index_bit0 {
            index_bit1 -= 1
        }
        if index_bit0 >= index_bit1 {
            if intervals[index_bit0].start & mask == 0 {
                index_bit0 += 1
            }
            break
        }
        swapped :: intervals[index_bit0]
        intervals[index_bit0] = intervals[index_bit1]
        intervals[index_bit1] = swapped
        index_bit0 += 1
        index_bit1 -= 1
    }
    if bit == 0 {
        return
    }
    if index_bit0 > lo {
        radix_sort_recursive(intervals, lo, index_bit0, bit - 1)
    }
    if index_bit0 < hi {
        radix_sort_recursive(intervals, index_bit0, hi, bit - 1)
    }
}

make_implicit_interval_tree :: fn(intervals: Interval[]) -> ImplicitIntervalTree {
    inplace_radix_sort(intervals)
    stack :: STACK_DEPTH.filled(() -> StackCell { .x = 0, .k = 0, .w = 0 })
    n :: intervals.len()
    last_index: i64 = 0
    last: u64 = 0
    i: i64 = 0
    for i < n {
        last_index = i
        intervals[i].max = intervals[i].end
        last = intervals[i].max
        i += 2
    }
    k: i64 = 1
    for 1 << k <= n {
        x :: 1 << (k - 1)
        i0 :: (x << 1) - 1
        step :: x << 2
        node := i0
        for node < n {
            left :: intervals[node - x].max
            right := last
            if node + x < n {
                right = intervals[node + x].max
            }
            e := intervals[node].end
            if e < left {
                e = left
            }
            if e < right {
                e = right
            }
            intervals[node].max = e
            node += step
        }
        last_index += x
        if (last_index >> k) & 1 != 0 {
            last_index -= x
        }
        if last_index < n && intervals[last_index].max > last {
            last = intervals[last_index].max
        }
        k += 1
    }
    return ImplicitIntervalTree {
        .intervals = intervals,
        .depth = k - 1,
        .stack = stack,
    }
}

set_cell :: fn(cell: StackCell, x: i64, k: i64, w: i64) -> void {
    cell.x = x
    cell.k = k
    cell.w = w
}

// Collects into `overlaps` every interval of the tree overlapping `[start, end)`,
// in tree order.
find_overlaps :: fn(tree: ImplicitIntervalTree, start: u64, end: u64, overlaps: Interval[]) -> void {
    max_depth :: tree.depth
    intervals :: tree.intervals
    stack :: tree.stack
    n :: intervals.len()
    overlaps.clear()
    set_cell(stack[0], (1 << max_depth) - 1, max_depth, 0)
    t: i64 = 1
    for t > 0 {
        t -= 1
        cell :: stack[t]
        x :: cell.x
        k :: cell.k
        if k <= 3 {
            i0 :: x >> k << k
            i1 := i0 + ((1 << (k + 1)) - 1)
            if i1 >= n {
                i1 = n
            }
            i := i0
            for i < i1 && intervals[i].start < end {
                if start < intervals[i].end {
                    overlaps.push(intervals[i])
                }
                i += 1
            }
        } else if cell.w == 0 {
            y :: x - (1 << (k - 1))
            cell.w = 1
            t += 1
            if y >= n || intervals[y].max > start {
                set_cell(stack[t], y, k - 1, 0)
                t += 1
            }
        } else if x < n && intervals[x].start < end {
            if start < intervals[x].end {
                overlaps.push(intervals[x])
            }
            set_cell(cell, x + (1 << (k - 1)), k - 1, 0)
            t += 1
        }
    }
}

main :: fn() -> i32 {
    rng :: SplitMix32 { .state = 11 }
    intervals :: generate_intervals(NUM_INTERVALS, rng, INTERVAL_START_BITS, INTERVAL_LENGTH_BITS)
    tree :: make_implicit_interval_tree(intervals)
    intervals_to_check :: generate_intervals(
        NUM_INTERVALS,
        rng,
        INTERVAL_START_BITS,
        INTERVAL_LENGTH_BITS,
    )
    total_coverage: u64 = 0
    overlaps: Interval[]: [] * i64(1 << INTERVAL_LENGTH_BITS)
    for interval in intervals_to_check {
        current_start :: interval.start
        current_end :: interval.end
        find_overlaps(tree, current_start, current_end, overlaps)
        if overlaps.len() == 0 {
            continue
        }
        coverage: u64 = 0
        covered_start := larger(current_start, overlaps[0].start)
        covered_end := smaller(current_end, overlaps[0].end)
        for overlap in overlaps {
            new_start :: larger(current_start, overlap.start)
            new_end :: smaller(current_end, overlap.end)
            if new_start > covered_end {
                coverage += covered_end - covered_start
                covered_start = new_start
                covered_end = new_end
            } else if covered_end < new_end {
                covered_end = new_end
            }
        }
        coverage += covered_end - covered_start
        total_coverage += coverage
    }
    println("plb2_bedcov n=${NUM_INTERVALS} coverage=${total_coverage}")
    return 0
}
