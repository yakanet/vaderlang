/// Map iteration micro-bench: exercises `for [k, v] in m` on a small map
/// iterated repeatedly: the `Into<Iterator<[K, V]>!>` impl on `MutableMap`,
/// a generator whose walk of the compact dict the `for` inlines, over 1 M
/// entries.

module "main"

import "std/io"
import "std/collections"

INNER_KEYS  :: 1_000
OUTER_LOOPS :: 1_000

main :: fn() -> i32 {
    m :: MutableMap<i32, i32> {}
    for i in 0..<INNER_KEYS {
        m[i] = i
    }
    total: i64 = 0
    for 0..<OUTER_LOOPS {
        for [_, value] in m {
            total = total + i64(value)
        }
    }
    println("map_iter inner=${INNER_KEYS} outer=${OUTER_LOOPS} total=${total}")
    return 0
}
