/// Map iteration micro-bench — exercises the `for entry in m` desugar
/// path on a small map iterated repeatedly. Stresses the `Into<Iterator
/// <Entry<K, V>>>` impl on `MutableMap`, the `for entry in m` desugar and its
/// compact-dict bucket-walk fast path, and the GC under 1 M
/// `Entry<K, V>` visits.

module "main"

import "std/io"
import "std/collections"

INNER_KEYS  :: 1_000
OUTER_LOOPS :: 1_000

main :: fn() -> i32 {
    m :: MutableMap<i32, i32> {}
    for i in 0..<INNER_KEYS {
        m[i] = i
    }
    total: i64 = 0
    for 0..<OUTER_LOOPS {
        for [_, value] in m {
            total = total + i64(value)
        }
    }
    println("map_iter inner=${INNER_KEYS} outer=${OUTER_LOOPS} total=${total}")
    return 0
}
