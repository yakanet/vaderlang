/// Closures — a captured environment on the heap, and an indirect call through
/// a fn value. Neither is measured anywhere else: `iter_chain` and `arr_map`
/// both exist to show the lowerer DELETING the indirection, and `shapes`
/// measures a trait witness rather than a captured frame.
///
/// Two halves, because a closure costs in two separate places. A mutating
/// capture forces the local into a heap CELL, so every read and write goes
/// through a pointer — `counter += 1` under a lambda is not the same store it
/// was outside one. And a factory called many times mints one environment per
/// closure, which is an allocation the call site cannot see.
///
/// The Java peer cannot mutate a captured local at all, so it captures a
/// one-element array instead — that is what Java code writes, and it pays the
/// same indirection.
///
/// Totals stay inside an f64 mantissa so the Bun-TS peer needs no BigInt, and
/// `CALLS` divides `ADDERS` exactly — `CALLS / ADDERS` is a FLOAT division in
/// JS, so a remainder buys the Bun-TS peer one extra pass and a checksum of its
/// own. Caught by the checksum, which is what it is for.
///
/// Sized so the natively compiled binary runs in ~30-70 ms.

module "main"

import "std/io"

CALLS  :: 6_000_000
ADDERS :: 500

make_adder :: fn(n: i64) -> fn(i64) -> i64 = (x: i64) -> x + n

main :: fn() -> i32 {
    // A mutating capture : `counter` lives in a heap cell from here on.
    counter: i64 = 0
    bump :: fn() {
        counter = counter + 1
    }
    for 0..<CALLS {
        bump()
    }
    // One environment per closure, then called round-robin so no single
    // callee stays in an inline cache.
    adders: (fn(i64) -> i64)[]! = []
    for index in 0..<ADDERS {
        adders.push(make_adder(i64(index)))
    }
    total: i64 = 0
    for 0..<CALLS / ADDERS {
        for adder in adders {
            total = adder(total)
        }
    }
    println("closures counter=${counter} total=${total}")
    return 0
}
