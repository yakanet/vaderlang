/// Array read-modify-write hot loop — indexes a 1024-element `i32[]` with
/// `a[i] = a[i] + 1` and re-reads `a[i]`, 100 000 passes over the array. The
/// get and the set lower to a typed load and store over the array buffer, and
/// nothing allocates in the loop, so it measures the element access, not the GC.

module "main"

import "std/io"

main :: fn() -> i32 {
    n: i64: 1024
    a: i32[]: []
    for i in 0..<n {
        a.push(i32(i))
    }
    sum: i64 = 0
    for 0..<100000 {
        for i in 0..<n {
            a[i] = a[i] + 1
            sum = sum + i64(a[i])
        }
    }
    println("arr_rw ${sum}")
    return 0
}
