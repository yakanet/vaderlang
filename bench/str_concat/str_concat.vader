/// String concatenation hot loop — builds a 13-byte string by repeated `+`
/// (`s = s + "..."`), 300 000 times. On `feat/target-abi` the `+` lowers to the
/// pure-Vader Buffer-backed concat rather than `main`'s `vader_string_concat`
/// host intrinsic, so this measures the off-runtime concat path.
///
/// The checksum sums `byte_len()` rather than the codepoint count `len()`: the
/// loop measures the concatenation, not a walk over its result. For ASCII the
/// two are equal.

module "main"

import "std/io"

main :: fn() -> i32 {
    total: usize = 0
    for _ in 0..<300000 {
        s := "a"
        s = s + "bcd"
        s = s + "efgh"
        s = s + "ijklm"
        total = total + s.byte_len()
    }
    println("str_concat ${total}")
    return 0
}
