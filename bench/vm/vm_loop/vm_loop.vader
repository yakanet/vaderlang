// bench/vm/vm_loop/vm_loop.vader — A tight integer loop: arithmetic and local traffic, nothing else.
//
// Sized for the VM (`bun bench/run.ts --vm`), not for native code.

module "main"

import "std/io"

main :: fn() -> i32 {
    acc: i32 = 0
    i: i32 = 0
    for i < 30000000 {
        acc = (acc + i * 3) & 1048575
        i += 1
    }
    println("vm_loop ${acc}")
    return 0
}
