// tools/testrunner/build: the driver that builds the test runner.
//
// The runner embeds the compiler, whose sources it imports from the repository
// root.

module "build"

import "toolchain/build"

build :: fn(args: string[]) -> i32 {
    ctx :: new_build_context(args)
    ctx.include_paths.push("../..")
    ctx.add_entry("testrunner", "src/main.vader")
    return ctx.emit_native()
}
