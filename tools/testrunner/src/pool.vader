// tools/testrunner/src/pool: K workers, each driven by a task.
//
// Each task takes case indices from one channel, runs each case on its worker, a
// `testrunner --worker` child it starts on first use, and tells the reporter what
// happens (`report.vader`). A worker that dies, or overruns the deadline of a
// case, is replaced on the stages of the case it had not reported, the one it
// stopped on counted as a crash. A worker that dies running a program on a stop
// line has ended with the program, as the process of `vader run` would: that is
// the program's run, compared as any other.

module "tools/testrunner/src"

import "std/console"
import "std/iter"
import "std/process"
import "std/string"
import "std/string_builder"
import "std/task"
import "std/time"

// The longest a case may take before its worker is killed.
CASE_TIMEOUT_SECONDS: i64: 300

// A worker child, what it wrote on stderr since it started, and the start of an
// event it has not finished writing.
Worker :: struct {
    child: ChildProcess
    err: u8[] = []
    pending: u8[] = []
}

// What a worker reported on one case.
Reports :: struct {
    stages: StageReport[] = []
    errors: string[] = []
    done: bool = false
    /// What the program the worker runs wrote.
    output: Streams = Streams {}
}

// A task's worker, started on first use and after each crash.
Slot :: struct {
    /// The argv a worker starts with.
    command: string[]
    /// Write each snapshot that differs or is missing, as the workers do.
    update: bool
    worker: Worker | null = null
}

// Take indices of `cases` from `queue` until it is closed, run each case on the
// slot's worker, and tell `events` what happens.
serve :: fn(slot: Slot, cases: Case[], queue: Channel<i64>, events: Channel<Progress>) -> void {
    for i in queue {
        run_case(slot, cases[i], events)
    }
    stop_worker(slot)
}

// Run the stages of `case`, on a new worker for those left after a crash. The
// reporter knows a case by its path, which names it in full.
run_case :: fn(slot: Slot, case: Case, events: Channel<Progress>) -> void {
    key :: case_path(case)
    events.send(CaseStarted { .case = key })
    defer events.send(CaseEnded { .case = key })
    todo := case.phases
    for todo.len() > 0 {
        worker :: worker_of(slot) ?? return
        from :: worker.err.len()
        reports :: run_on(worker, Case { ...case, .phases = todo })
        for report in reports.stages {
            // A copy: what a task sends is its receiver's to write, and `report` is
            // still an element of this task's `reports` (T3129).
            events.send(StageNoted { .case = key, .report = StageReport { ...report } })
        }
        for message in reports.errors {
            events.send(CaseError { .case = key, .message = message })
        }
        if reports.done {
            return
        }
        code :: exit_of(worker.child)
        slot.worker = null
        reported :: reports.stages.map((r) -> r.phase).collect()
        left :: todo.filter((phase) -> !reported.contains(phase)).collect()
        // Dead after its last stage, the worker crashed on none.
        if left.len() == 0 {
            return
        }
        died :: worker.err[from..<worker.err.len()].bytes_to_string()
        ended :: if left[0] == VM_PHASE { program_end(slot, case, reports, died) } else { null }
        if ended != null {
            events.send(StageNoted { .case = key, .report = ended })
        } else {
            events.send(
                Crash {
                    .case = key,
                    .phase = left[0],
                    .exit = code,
                    .stderr = worker.err.bytes_to_string(),
                },
            )
        }
        todo = left[1..<left.len()]
    }
}

// The `vm` stage of `case` when its worker died running the program, on the stop
// line it wrote on its stderr (`died`, what it wrote there on this case): the
// program's run, ended with its process. Null for a death without one, which the
// program did not cause.
program_end :: fn(slot: Slot, case: Case, reports: Reports, died: string) -> StageReport | null {
    began :: monotonic()
    stderr :: "${reports.output.stderr.to_string()}${died}"
    if !has_stop_line(stderr) {
        return null
    }
    actual :: run_text(reports.output.stdout.to_string(), stderr, STOPPED_EXIT)
    return report_of(case, VM_STAGE, actual, slot.update, began)
}

// Send `case` to `worker` and read its reports until the end of the case or of
// the worker, or until `CASE_TIMEOUT_SECONDS` runs out, which kills it.
run_on :: fn(worker: Worker, case: Case) -> Reports {
    reports :: Reports {}
    if worker.child.write_input(request_record(case).bytes()) != null {
        return reports
    }
    // Bound before the test: the task analysis sees `timeout` join its task
    // only then.
    read :: launch(() -> read_case(worker, reports)).timeout(CASE_TIMEOUT_SECONDS.seconds())
    if read is TimeoutError {
        worker.child.kill()
    }
    return reports
}

// Read the events `worker` writes into `reports`, until the end of the case or
// its own.
read_case :: fn(worker: Worker, reports: Reports) -> void {
    for !reports.done {
        chunk :: worker.child.read_output()
        worker.err.push_all(chunk.err)
        from :: worker.pending.len()
        worker.pending.push_all(chunk.out)
        take_events(worker, from, reports)
        if chunk.ended {
            return
        }
    }
}

// Move the events `worker.pending` completes into `reports`, its bytes before
// `from` known to hold no line end.
take_events :: fn(worker: Worker, from: i64, reports: Reports) -> void {
    pending :: worker.pending
    start: i64 = 0
    for i in from..<pending.len() {
        if pending[i] == '\n' {
            line :: pending[start..<i].bytes_to_string()
            reports.add(read_event(line), line)
            start = i + 1
        }
    }
    if start > 0 {
        rest: u8[]: []
        rest.push_all(pending[start..<pending.len()])
        worker.pending = rest
    }
}

add :: fn(reports: Reports, event: Event | null, line: string) -> void {
    match event {
        is StageReport   -> reports.stages.push(event)
        is CaseFailure   -> reports.errors.push(event.message)
        is CaseDone      -> { reports.done = true }
        is ProgramOutput -> reports.output.keep(event.stream, event.text)
        is null          -> reports.errors.push("not an event: ${line}")
    }
}

// The exit code of a child that ended, -1 for a signal.
exit_of :: fn(child: ChildProcess) -> i32 {
    for {
        ended :: child.poll()
        if ended is ProcessResult {
            return ended.exit
        }
        if ended is ProcessError {
            return -1
        }
        child.read_output()
    }
}

worker_of :: fn(slot: Slot) -> Worker | null {
    current :: slot.worker
    if current != null {
        return current
    }
    child :: spawn_interactive(slot.command)
    if child is ProcessError {
        eprintln("testrunner: ${child.msg}")
        return null
    }
    started :: Worker { .child = child }
    slot.worker = started
    return started
}

// Close the stdin of the slot's worker, which then exits, and wait for it.
stop_worker :: fn(slot: Slot) -> void {
    worker :: slot.worker ?? return
    worker.child.close_input()
    exit_of(worker.child)
}
