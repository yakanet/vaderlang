// tools/testrunner/src/report: what the runner prints while the cases run, and
// once they have.
//
// The tasks of the pool tell one reporter task what happens (`Progress`), in the
// order it happens. Each case gets one line when it ends: `(pass)` and the stages
// it checked, unless only the failures are asked for, or `(fail)` and below it,
// indented, what failed. Every
// `PROGRESS_SECONDS`, a line names the cases running for longer than that, so
// that a run that seems to stall says on what. The reporter alone writes the
// tally, which the tasks share no other way.

module "tools/testrunner/src"

import "std/collections"
import "std/console"
import "std/iter"
import "std/string"
import "std/task"
import "std/time"

// How often the reporter names the cases that run for long.
PROGRESS_SECONDS: i64: 10

// What a task of the pool tells the reporter.
Progress :: CaseStarted | StageNoted | Crash | CaseError | RunError | CaseEnded | Tick

CaseStarted :: struct {
    case: string
}

// A stage a worker reported, or the runner formed for it (`program_end`).
StageNoted :: struct {
    case: string
    report: StageReport
}

// A stage a worker stopped on.
Crash :: struct {
    case: string
    phase: string
    exit: i32
    stderr: string
    /// The worker was killed for running past `CASE_TIMEOUT_SECONDS`.
    timed_out: bool = false
}

// What a worker could not run of a case.
CaseError :: struct {
    case: string
    message: string
}

// A problem of the discovery, which belongs to no case.
RunError :: struct {
    message: string
}

CaseEnded :: struct {
    case: string
}

// Time to name the cases that run for long.
Tick :: struct {}

// What the run found.
Tally :: struct {
    same: i64 = 0
    written: string[] = []
    /// The stages that differ from their snapshot, have none, or failed.
    failures: i64 = 0
    crashes: i64 = 0
    errors: i64 = 0
    /// The line of each case that failed and of each problem of the discovery,
    /// which the tally prints again at the end.
    failed: string[] = []
}

// What the reporter knows of a case that runs.
CaseRun :: struct {
    began: Monotonic
    /// The stages that passed, in the order they ended.
    passed: string[] = []
    /// What failed, each a label line and what shows it.
    problems: string[] = []
}

// Take what the tasks tell on `events` until it is closed, and print it as it
// comes, the cases that pass left out when `only_failures`: the tally of the run.
report :: fn(events: Channel<Progress>, only_failures: bool) -> Tally {
    tally :: Tally {}
    running :: Map<string, CaseRun> {}
    for event in events {
        match event {
            is CaseStarted -> {
                running[event.case] = CaseRun { .began = monotonic() }
            }
            is StageNoted  -> tally.note(running.run_of(event.case), event.case, event.report)
            is Crash       -> {
                tally.crashes += 1
                running.run_of(event.case).problems.push(crash_problem(event))
            }
            is CaseError   -> {
                tally.errors += 1
                running.run_of(event.case).problems.push("error: ${event.message}")
            }
            is RunError    -> {
                tally.errors += 1
                line :: "(error) ${event.message}"
                tally.failed.push(line)
                println(line)
            }
            is CaseEnded   -> {
                tally.print_case(event.case, running.run_of(event.case), only_failures)
                running.remove(event.case)
            }
            is Tick        -> {
                line :: long_running_line(running)
                if line != null {
                    println(line)
                }
            }
        }
    }
    return tally
}

// Send a `Tick` on `events` every `PROGRESS_SECONDS`, until cancelled.
tick :: fn(events: Channel<Progress>) -> void {
    for {
        sleep(PROGRESS_SECONDS.seconds())
        events.send(Tick {})
    }
}

// The run of `case`, begun now when nothing said it started.
run_of :: fn(running: Map<string, CaseRun>, case: string) -> CaseRun =
    running.get_or_put_with(case, () -> CaseRun { .began = monotonic() })

note :: fn(tally: Tally, run: CaseRun, case: string, report: StageReport) -> void {
    match report.result {
        .Same                        -> {
            tally.same += 1
            run.passed.push(report.phase)
        }
        .Written                     -> {
            tally.written.push("${case}/${report.phase}")
            run.passed.push(report.phase)
        }
        .Differ | .Missing | .Failed -> {
            tally.failures += 1
            label :: "${failure_label(report.result)}: ${report.phase}"
            run.problems.push("${label}\n${report.detail ?? ""}")
        }
    }
}

failure_label :: fn(result: Verdict) -> string = match result {
    .Differ          -> "!= snapshot"
    .Missing         -> "no snapshot"
    .Failed          -> "failed"
    .Same | .Written -> verdict_name(result)
}

// Print the line of `case`, which ended, and below it what failed on it; nothing
// for a case that passed when `only_failures`.
print_case :: fn(tally: Tally, case: string, run: CaseRun, only_failures: bool) -> void {
    took :: "[${run.began.since().format()}]"
    if run.problems.len() == 0 {
        if !only_failures {
            println("(pass) ${case} > ${run.passed.join(", ")} ${took}")
        }
        return
    }
    line :: "(fail) ${case} ${took}"
    tally.failed.push(line)
    println(line)
    for problem in run.problems {
        println(indented(problem.trim_suffix("\n")))
    }
}

// `text`, each of its lines indented by two spaces.
indented :: fn(text: string) -> string = "  ${text.replace_all("\n", "\n  ")}"

// The cases of `running` that started more than `PROGRESS_SECONDS` ago, with how
// long they have run; null when none has.
long_running_line :: fn(running: Map<string, CaseRun>) -> string | null {
    long: string[]: []
    for [case, run] in running {
        seconds :: run.began.since().to_seconds()
        if seconds >= PROGRESS_SECONDS {
            long.push("${case} for ${seconds} s")
        }
    }
    if long.len() == 0 {
        return null
    }
    return "(still running) ${long.join(", ")}"
}

// Print the tally of a run of `cases` cases on `k` workers, which took `took`:
// the failed cases again, the snapshots written, and the counts.
print_tally :: fn(total: Tally, cases: i64, k: i32, took: Duration) -> void {
    if total.failed.len() > 0 {
        println("")
        println("${total.failed.len()} failed:")
        for line in total.failed {
            println(line)
        }
    }
    for name in total.written {
        println("written: ${name}")
    }
    println("")
    println(" ${total.same + total.written.len()} pass")
    println(" ${total.failures} fail")
    if total.written.len() > 0 {
        println(" ${total.written.len()} written")
    }
    if total.crashes > 0 {
        println(" ${total.crashes} crash")
    }
    if total.errors > 0 {
        println(" ${total.errors} error")
    }
    stages :: total.same + total.written.len() + total.failures + total.crashes
    println("Ran ${stages} stages across ${cases} cases on ${k} workers. [${took.format()}]")
}

// Why the worker of a case stopped on a stage, and what it wrote on its stderr.
crash_problem :: fn(crash: Crash) -> string {
    if crash.timed_out {
        return "timed out: ${crash.phase}, killed after ${CASE_TIMEOUT_SECONDS} s\n${crash.stderr}"
    }
    return "crash: ${crash.phase} exit ${crash.exit}\n${crash.stderr}"
}

// ---- tests ------------------------------------------------------------------

import "std/testing"

@test
test_a_case_that_runs_for_long_is_named :: fn() -> void {
    running :: Map<string, CaseRun> {}
    running["quick"] = CaseRun { .began = monotonic() }
    assert(long_running_line(running) == null, "no case runs for long")
}

@test
test_what_failed_is_indented_below_its_case :: fn() -> void {
    assert_eq(
        indented("!= snapshot: vm\n--- a\n+++ actual"),
        "  != snapshot: vm\n  --- a\n  +++ actual",
    )
}

@test
test_a_missing_snapshot_is_labelled_apart :: fn() -> void {
    assert_eq(failure_label(.Missing), "no snapshot")
    assert_eq(failure_label(.Differ), "!= snapshot")
    assert_eq(failure_label(.Failed), "failed")
}

@test
test_a_case_past_its_deadline_reads_as_timed_out :: fn() -> void {
    crash :: Crash {
        .case = "tools/x",
        .phase = "tests",
        .exit = 137,
        .stderr = "",
    }
    assert_eq(crash_problem(crash), "crash: tests exit 137\n")
    late :: Crash { ...crash, .timed_out = true }
    assert_eq(crash_problem(late), "timed out: tests, killed after ${CASE_TIMEOUT_SECONDS} s\n")
}
