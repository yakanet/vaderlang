// tools/testrunner/src/protocol: what the runner and its workers say to each other.
//
// Every message is an entry of a JSON text sequence (RFC 7464), as `vader test
// --reporter=json` writes its events: a record separator (0x1E), one JSON
// object, a newline. The runner writes one request per case on the stdin of a
// worker:
//
// ```
// {"case": "hello", "modules": [], "stages": ["lexer", "parser", "...", "vm"], "vm_from": "build"}
// ```
//
// `vm_from` comes with a run on the VM of the image a build links. The worker
// answers on its stdout with one `stage` event per stage of the request, then
// `done`; a program it runs adds an `output` event for each of its writes, as it
// writes:
//
// ```
// {"event": "stage", "case": "hello", "stage": "lexer", "result": "same", "duration_us": 812}
// {"event": "stage", "case": "hello", "stage": "emit_c", "result": "differ", "duration_us": 53,
//  "detail": "--- tests/snippets/hello/emit-c.snapshot.c\n+++ actual\n@@ -1 +1 @@\n..."}
// {"event": "output", "case": "hello", "stream": "stdout", "text": "Hello\n"}
// {"event": "error", "case": "hello", "message": "..."}
// {"event": "done", "case": "hello", "duration_us": 61234}
// ```
//
// A `result` is `same`, `differ`, `missing` (no snapshot file) or `written`
// (under `--update`); `detail` shows a failure: the unified diff from the snapshot
// to the text under `differ`, the whole text under `missing`. A worker whose
// stdout ends before `done` crashed on the first stage it did not report; the
// `output` events of a program it was running are what that program wrote
// before.

module "tools/testrunner/src"

import "json"
import "std/collections"
import "std/console"
import "std/string"

// How the text of a stage compares with its snapshot.
Verdict :: enum { Same, Differ, Missing, Written }

// Whether a stage of this verdict fails the run.
is_failure :: fn(verdict: Verdict) -> bool = verdict == .Differ || verdict == .Missing

verdict_name :: fn(verdict: Verdict) -> string = match verdict {
    .Same    -> "same"
    .Differ  -> "differ"
    .Missing -> "missing"
    .Written -> "written"
}

verdict_named :: fn(name: string) -> Verdict | null = match name {
    "same"    -> .Same
    "differ"  -> .Differ
    "missing" -> .Missing
    "written" -> .Written
    _         -> null
}

// What a worker reports on one stage.
StageReport :: struct {
    phase: string
    result: Verdict
    duration_us: i64
    /// What shows a failure: the unified diff from the snapshot to the text when
    /// they differ, the whole text when there is no snapshot.
    detail: string | null = null
}

// A request the worker could not run, or a stage it does not know.
CaseFailure :: struct {
    message: string
}

// The end of a case.
CaseDone :: struct {
    duration_us: i64
}

// A write of the program a worker runs.
ProgramOutput :: struct {
    stream: Stream
    text: string
}

Event :: StageReport | CaseFailure | CaseDone | ProgramOutput

// ---- writing ----------------------------------------------------------------

// The request for `case`.
request_record :: fn(case: Case) -> string {
    entries :: Map<string, JsonValue> {}
    entries["case"] = JsonString { .value = case.name }
    entries["modules"] = json_strings(case.modules)
    entries["stages"] = json_strings(case.phases)
    if case.vm_from_build {
        entries["vm_from"] = JsonString { .value = "build" }
    }
    return record(entries)
}

stage_record :: fn(case: string, report: StageReport) -> string {
    entries :: event_entries("stage", case)
    entries["stage"] = JsonString { .value = report.phase }
    entries["result"] = JsonString { .value = verdict_name(report.result) }
    entries["duration_us"] = JsonNumber { .value = f64(report.duration_us) }
    detail :: report.detail
    if detail != null {
        entries["detail"] = JsonString { .value = detail }
    }
    return record(entries)
}

error_record :: fn(case: string, message: string) -> string {
    entries :: event_entries("error", case)
    entries["message"] = JsonString { .value = message }
    return record(entries)
}

output_record :: fn(case: string, stream: Stream, text: string) -> string {
    entries :: event_entries("output", case)
    entries["stream"] = JsonString { .value = stream_name(stream) }
    entries["text"] = JsonString { .value = text }
    return record(entries)
}

done_record :: fn(case: string, duration_us: i64) -> string {
    entries :: event_entries("done", case)
    entries["duration_us"] = JsonNumber { .value = f64(duration_us) }
    return record(entries)
}

event_entries :: fn(event: string, case: string) -> Map<string, JsonValue> {
    entries :: Map<string, JsonValue> {}
    entries["event"] = JsonString { .value = event }
    entries["case"] = JsonString { .value = case }
    return entries
}

json_strings :: fn(values: string[]) -> JsonArray {
    items: JsonValue[]: []
    for value in values {
        items.push(JsonString { .value = value })
    }
    return JsonArray { .items = items }
}

record :: fn(entries: Map<string, JsonValue>) -> string =
    sequence_entry(JsonObject { .entries = entries })

// ---- reading ----------------------------------------------------------------

// The case a request line asks for, null for a line that is not one.
read_request :: fn(line: string) -> Case | null {
    message :: message_of(line) ?? return null
    name :: string_member(message, "case") ?? return null
    return Case {
        .name = name,
        .phases = strings_member(message, "stages"),
        .modules = strings_member(message, "modules"),
        .vm_from_build = string_member(message, "vm_from") == "build",
    }
}

// The event an event line holds, null for a line that is not one.
read_event :: fn(line: string) -> Event | null {
    message :: message_of(line) ?? return null
    event :: string_member(message, "event") ?? return null
    if event == "stage" {
        return StageReport {
            .phase = string_member(message, "stage") ?? return null,
            .result = verdict_named(string_member(message, "result") ?? "") ?? return null,
            .duration_us = micros_of(message),
            .detail = string_member(message, "detail"),
        }
    }
    if event == "error" {
        return CaseFailure { .message = string_member(message, "message") ?? "" }
    }
    if event == "done" {
        return CaseDone { .duration_us = micros_of(message) }
    }
    if event == "output" {
        return ProgramOutput {
            .stream = stream_named(string_member(message, "stream") ?? "") ?? return null,
            .text = string_member(message, "text") ?? "",
        }
    }
    return null
}

stream_name :: fn(stream: Stream) -> string = match stream {
    .Stdout -> "stdout"
    .Stderr -> "stderr"
}

stream_named :: fn(name: string) -> Stream | null = match name {
    "stdout" -> .Stdout
    "stderr" -> .Stderr
    _        -> null
}

// The JSON object of a message line, its record separator dropped.
message_of :: fn(line: string) -> JsonValue | null {
    parsed :: parse(line.trim_prefix("\u{1e}"))
    if parsed is JsonObject {
        return parsed
    }
    return null
}

micros_of :: fn(message: JsonValue) -> i64 = i64(number_member(message, "duration_us") ?? 0.0)

// ---- tests ------------------------------------------------------------------

import "std/testing"

// The line a reader gets for `record`: the record without its line end.
line_of :: fn(record: string) -> string = record.trim_suffix("\n")

@test
test_a_request_reads_back_as_its_case :: fn() -> void {
    case :: Case {
        .name = "hello",
        .phases = ["lexer", "vm"],
        .modules = ["helper"],
        .vm_from_build = true,
    }
    sent :: request_record(case)
    nothing :: Case { .name = "", .phases = [], .modules = [] }
    assert_eq(request_record(read_request(line_of(sent)) ?? nothing), sent)
}

@test
test_a_stage_event_reads_back_with_its_detail :: fn() -> void {
    report :: StageReport {
        .phase = "vm",
        .result = .Differ,
        .duration_us = 12,
        .detail = "--- a\n+++ actual\n",
    }
    sent :: stage_record("hello", report)
    back :: read_event(line_of(sent))
    if back is StageReport {
        assert_eq(stage_record("hello", back), sent)
    } else {
        assert(false, "a stage event reads back as a stage report")
    }
}

@test
test_an_output_event_keeps_its_stream :: fn() -> void {
    back :: read_event(line_of(output_record("hello", .Stderr, "oops\n")))
    if back is ProgramOutput {
        assert(back.stream == .Stderr, "the stream written to")
        assert_eq(back.text, "oops\n")
    } else {
        assert(false, "an output event reads back as a program's output")
    }
}

@test
test_a_line_that_is_no_event_reads_as_null :: fn() -> void {
    assert(read_event("not json") == null, "a line that is not JSON")
    assert(read_event("{\"event\": \"other\"}") == null, "an event the runner does not know")
}
