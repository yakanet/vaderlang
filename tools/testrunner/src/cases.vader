// tools/testrunner/src/cases: the snippets and the stages checked on each.
//
// A snippet is a folder of `tests/snippets` holding a `_main.vader`. Its
// `_config.json` may name the phases its snapshots cover (`phases`), the modules
// the module-scoped dumps show (`modules`) and how its run on the VM is checked
// (`vm`). A `_config.json` that is not a JSON object is a problem, never a reason
// to run every phase.

module "tools/testrunner/src"

import "json"
import "std/collections"
import "std/fs"
import "std/io"
import "std/sort"
import "std/string"
import "vader/support/target"

// One stage of a snippet: the phase the corpus names it by, the stage of
// `vader dump` that renders it, and the snapshot file it is compared with.
Stage :: struct {
    phase: string
    /// Null for the run on the VM, which no dump renders.
    dump: string | null
    snapshot: string
}

STAGES: Stage[]: [
    Stage {
        .phase = "lexer",
        .dump = "lexer",
        .snapshot = "lexer.snapshot",
    },
    Stage {
        .phase = "parser",
        .dump = "ast",
        .snapshot = "parser.snapshot.json",
    },
    Stage {
        .phase = "typecheck",
        .dump = "typed-ast",
        .snapshot = "typecheck.snapshot",
    },
    Stage {
        .phase = "comptime",
        .dump = "evaluated-ast",
        .snapshot = "comptime.snapshot.md",
    },
    Stage {
        .phase = "lower",
        .dump = "lowered-ast",
        .snapshot = "lower.snapshot",
    },
    Stage {
        .phase = "bytecode",
        .dump = "bytecode",
        .snapshot = BYTECODE_SNAPSHOT,
    },
    Stage {
        .phase = "emit_c",
        .dump = "c",
        .snapshot = "emit-c.snapshot.c",
    },
    VM_STAGE,
]

// The run of a snippet on the VM, and what it is compared with.
VM_PHASE    :: "vm"
VM_SNAPSHOT :: "vm.snapshot"
VM_STAGE: Stage: Stage {
    .phase = VM_PHASE,
    .dump = null,
    .snapshot = VM_SNAPSHOT,
}

// The bytecode snapshot, which the VM runs on the host it is taken for.
BYTECODE_SNAPSHOT :: "bytecode.snapshot.virt"

SNIPPETS :: "tests/snippets"

// The target the snapshots are taken for, whatever the host.
SNAPSHOT_TARGET :: Target { .os = .Linux, .arch = .X86_64 }

// A snippet and the phases to check on it.
Case :: struct {
    name: string
    phases: string[]
    modules: string[]
    /// Whether its run on the VM runs the image `vader build --emit=bytecode-text`
    /// links from source: its `_config.json` says so, or it has no bytecode
    /// snapshot.
    vm_from_build: bool = false
}

case_dir :: fn(name: string) -> string = "${SNIPPETS}/${name}"

// The stage the corpus names `phase`, null for a name it does not know.
stage_named :: fn(phase: string) -> Stage | null {
    for stage in STAGES {
        if stage.phase == phase {
            return stage
        }
    }
    return null
}

// The snippets of a run, and the folders that could not be read as one.
Discovery :: struct {
    cases: Case[] = []
    problems: string[] = []
}

// The snippets under `SNIPPETS`, in name order, with the phases of `phases`
// their `_config.json` lets run.
find_cases :: fn(phases: string[]) -> Discovery {
    found :: Discovery {}
    listed :: read_dir(SNIPPETS)
    if listed is IOError {
        found.problems.push("${SNIPPETS}: ${listed.msg}")
        return found
    }
    for name in sort(listed, (a, b) -> a < b) {
        dir :: case_dir(name)
        if !exists("${dir}/_main.vader") {
            continue
        }
        config :: read_config(dir)
        if config is string {
            found.problems.push("${name}: ${config}")
            continue
        }
        kept :: phases_of(config, phases)
        if phases.contains(VM_PHASE) && runs_on_vm(dir, config) {
            kept.push(VM_PHASE)
        }
        if kept.len() > 0 {
            found.cases.push(
                Case {
                    .name = name,
                    .phases = kept,
                    .modules = strings_member(config, "modules"),
                    .vm_from_build = vm_from_build(dir, config),
                },
            )
        }
    }
    return found
}

// The dump phases of `phases` the snippet's `config` lets run, in the order of
// `STAGES`: all of them when it names none.
phases_of :: fn(config: JsonValue, phases: string[]) -> string[] {
    every :: member(config, "phases") == null
    listed :: strings_member(config, "phases")
    kept: string[]: []
    for stage in STAGES {
        allowed :: every || listed.contains(stage.phase)
        if stage.dump != null && phases.contains(stage.phase) && allowed {
            kept.push(stage.phase)
        }
    }
    return kept
}

// Whether the run of the snippet in `dir` is checked on the VM, as
// `tests/vader_vm.test.ts` decides: it has a run to check or a bytecode snapshot
// to run, its `_config.json` does not exclude the run on this host, and it brings
// no C of its own (`helper*.c`), which only a native binary links.
runs_on_vm :: fn(dir: string, config: JsonValue) -> bool {
    if !exists("${dir}/${VM_SNAPSHOT}") && !exists("${dir}/${BYTECODE_SNAPSHOT}") {
        return false
    }
    vm :: member(config, "vm")
    if vm != null && excludes_this_host(vm) {
        return false
    }
    return !has_helper_c(dir)
}

// Whether the `vm` entry of a `_config.json` excludes the run here: everywhere
// (`skip`), or on the host's platform (`skip_on`).
excludes_this_host :: fn(vm: JsonValue) -> bool {
    if member(vm, "skip") != null {
        return true
    }
    skip_on :: member(vm, "skip_on") ?? return false
    return member(skip_on, host_platform()) != null
}

// The name `skip_on` gives the host's platform, Node's `process.platform`.
host_platform :: fn() -> string = match host_target().os {
    .Linux           -> "linux"
    .Darwin          -> "darwin"
    .Windows         -> "win32"
    .Wasi | .Browser -> ""
}

has_helper_c :: fn(dir: string) -> bool {
    listed :: read_dir(dir)
    if listed is IOError {
        return false
    }
    for name in listed {
        if name.starts_with("helper") && name.ends_with(".c") {
            return true
        }
    }
    return false
}

// Whether the snippet in `dir` runs on the VM from the image a build links: its
// `_config.json` says `"vm": { "from": "build" }`, or it has no bytecode snapshot.
vm_from_build :: fn(dir: string, config: JsonValue) -> bool {
    vm :: member(config, "vm")
    if vm != null && string_member(vm, "from") == "build" {
        return true
    }
    return !exists("${dir}/${BYTECODE_SNAPSHOT}")
}

// The `_config.json` of the snippet in `dir`, an empty object when it has none,
// or why it cannot be read as an object.
read_config :: fn(dir: string) -> JsonValue | string {
    text :: read_file_string("${dir}/_config.json")
    if text is IOError {
        if text.kind == .NotFound {
            return JsonObject { .entries = Map<string, JsonValue> {} }
        }
        return "`_config.json`: ${text.msg}"
    }
    parsed :: parse(text)
    if parsed is JsonObject {
        return parsed
    }
    if parsed is JsonError {
        return "`_config.json`: ${parsed.msg} at byte ${parsed.pos}"
    }
    return "`_config.json` is not an object"
}

// ---- tests ------------------------------------------------------------------

import "std/option"
import "std/testing"

json_of :: fn(text: string) -> JsonValue = parse(text).or_null() ?? JsonNull {}

@test
test_a_skip_excludes_the_run_everywhere :: fn() -> void {
    assert(excludes_this_host(json_of("{\"skip\": \"why\"}")), "`skip`")
}

@test
test_a_skip_on_excludes_the_run_on_the_platforms_it_names :: fn() -> void {
    here :: json_of("{\"skip_on\": {\"${host_platform()}\": \"why\"}}")
    assert(excludes_this_host(here), "this host's platform")
    elsewhere :: json_of("{\"skip_on\": {\"plan9\": \"why\"}}")
    assert(!excludes_this_host(elsewhere), "another platform")
}

@test
test_a_case_checks_the_dumps_its_config_allows :: fn() -> void {
    asked :: ["lexer", "parser", "vm"]
    assert_eq(phases_of(json_of("{}"), asked).join(","), "lexer,parser")
    assert_eq(phases_of(json_of("{\"phases\": [\"parser\"]}"), asked).join(","), "parser")
}
