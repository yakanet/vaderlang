// tools/testrunner/src/cases: the cases of a run and the stages checked on each.
//
// A snippet is a folder of `tests/snippets` holding a `_main.vader`. Its
// `_config.json` (`config.vader`) may narrow the stages checked on it. A snippet
// whose `_config.json` has a problem is reported, never checked. The fixtures of
// the diagnostics corpora have a stage of their own (`fixtures.vader`), and so do
// the modules that hold `@test` functions (`module_tests.vader`).

module "tools/testrunner/src"

import "std/fs"
import "std/io"
import "std/iter"
import "std/sort"
import "std/string"
import "vader/support/target"

// One stage of a snippet: the phase the corpus names it by, the stage of
// `vader dump` that renders it, and the snapshot file it is compared with.
Stage :: struct {
    phase: string
    /// Null for the runs of the program, which no dump renders.
    dump: string | null
    snapshot: string
}

STAGES: Stage[]: [
    Stage {
        .phase = "lexer",
        .dump = "lexer",
        .snapshot = "lexer.snapshot",
    },
    Stage {
        .phase = "parser",
        .dump = "ast",
        .snapshot = "parser.snapshot.json",
    },
    Stage {
        .phase = "typecheck",
        .dump = "typed-ast",
        .snapshot = "typecheck.snapshot",
    },
    Stage {
        .phase = "comptime",
        .dump = "evaluated-ast",
        .snapshot = "comptime.snapshot.md",
    },
    Stage {
        .phase = LOWER_PHASE,
        .dump = "lowered-ast",
        .snapshot = "lower.snapshot",
    },
    Stage {
        .phase = "bytecode",
        .dump = "bytecode",
        .snapshot = BYTECODE_SNAPSHOT,
    },
    Stage {
        .phase = C_PHASE,
        .dump = "c",
        .snapshot = C_SNAPSHOT,
    },
    VM_STAGE,
    NATIVE_STAGE,
    DIAGNOSTICS_STAGE,
    TESTS_STAGE,
    TARGETS_STAGE,
    EXTERNS_STAGE,
    CALLEES_STAGE,
    RANGES_STAGE,
    EFFECTS_STAGE,
    EXAMPLE_STAGE,
    NATIVE_EXAMPLE_STAGE,
    HOOK_STAGE,
    DOC_STAGE,
    FORMAT_STAGE,
]

// The run of a snippet on the VM, and what it is compared with.
VM_PHASE    :: "vm"
VM_SNAPSHOT :: "vm.snapshot"
VM_STAGE: Stage: Stage {
    .phase = VM_PHASE,
    .dump = null,
    .snapshot = VM_SNAPSHOT,
}

// The run of a snippet built natively, compared with its run on the VM.
NATIVE_PHASE :: "native"
NATIVE_STAGE: Stage: Stage {
    .phase = NATIVE_PHASE,
    .dump = null,
    .snapshot = VM_SNAPSHOT,
}

// The diagnostics of a fixture (`diagnostics_run.vader`).
DIAGNOSTICS_PHASE :: "diagnostics"
DIAGNOSTICS_STAGE: Stage: Stage {
    .phase = DIAGNOSTICS_PHASE,
    .dump = null,
    .snapshot = "diagnostics.snapshot",
}

// The `@test` functions of a module (`tests_run.vader`), which pass or fail with
// no snapshot to compare.
TESTS_PHASE :: "tests"
TESTS_STAGE: Stage: Stage {
    .phase = TESTS_PHASE,
    .dump = null,
    .snapshot = "",
}

// The bodies each target selects, in a fixture of `TARGET_CORPUS`
// (`dump_fixtures.vader`), whose snapshot is named after its target.
TARGETS_PHASE :: "targets"
TARGETS_STAGE: Stage: Stage {
    .phase = TARGETS_PHASE,
    .dump = null,
    .snapshot = "",
}

// The C prototype of each `@extern`, in a fixture of `EXTERNS_CORPUS`.
EXTERNS_PHASE :: "externs"
EXTERNS_STAGE: Stage: Stage {
    .phase = EXTERNS_PHASE,
    .dump = null,
    .snapshot = "externs.snapshot.c",
}

// The stages a corpus of `STAGE_CORPORA` pins (`dump_fixtures.vader`), each
// named after the stage of the dump it renders, a fixture naming its snapshot.
CALLEES_PHASE :: "callees"
CALLEES_STAGE: Stage: Stage {
    .phase = CALLEES_PHASE,
    .dump = null,
    .snapshot = "",
}
RANGES_PHASE  :: "ranges"
RANGES_STAGE: Stage: Stage {
    .phase = RANGES_PHASE,
    .dump = null,
    .snapshot = "",
}
EFFECTS_PHASE :: "effects"
EFFECTS_STAGE: Stage: Stage {
    .phase = EFFECTS_PHASE,
    .dump = null,
    .snapshot = "",
}

// The run of an example by `vader run` (`examples.vader`), compared with the
// snapshot of its case.
EXAMPLE_PHASE :: "example"
EXAMPLE_STAGE: Stage: Stage {
    .phase = EXAMPLE_PHASE,
    .dump = null,
    .snapshot = "",
}

// The run of an example built natively, compared with the same snapshot.
NATIVE_EXAMPLE_PHASE :: "example_native"
NATIVE_EXAMPLE_STAGE: Stage: Stage {
    .phase = NATIVE_EXAMPLE_PHASE,
    .dump = null,
    .snapshot = "",
}

// The build of a fixture of `HOOK_CORPUS` by its driver (`hook_fixtures.vader`).
HOOK_PHASE :: "hook"
HOOK_STAGE: Stage: Stage {
    .phase = HOOK_PHASE,
    .dump = null,
    .snapshot = "build.snapshot",
}

// The data `vader doc` writes for a fixture of `DOC_CORPUS` (`doc_fixtures.vader`).
DOC_PHASE :: "doc"
DOC_STAGE: Stage: Stage {
    .phase = DOC_PHASE,
    .dump = null,
    .snapshot = "",
}

// What `vader fmt` makes of a source (`format_run.vader`).
FORMAT_PHASE :: "format"
FORMAT_STAGE: Stage: Stage {
    .phase = FORMAT_PHASE,
    .dump = null,
    .snapshot = "",
}

// The lowered form of a program.
LOWER_PHASE :: "lower"

// The C a native build compiles.
C_PHASE    :: "emit_c"
C_SNAPSHOT :: "emit-c.snapshot.c"

// The bytecode snapshot, which the VM runs on the host it is taken for.
BYTECODE_SNAPSHOT :: "bytecode.snapshot.virt"

SNIPPETS :: "tests/snippets"

// The entry of a snippet, and of a fixture of the diagnostics corpora.
SNIPPET_ENTRY :: "_main.vader"

// The target the snapshots are taken for, whatever the host.
SNAPSHOT_TARGET :: Target { .os = .Linux, .arch = .X86_64 }

// A snippet or a fixture, and the phases to check on it.
Case :: struct {
    /// The folder under its corpus, the corpus named first for a fixture.
    name: string
    /// The folder of its `entry`; for the tests of a module, the entry `vader
    /// test` compiles, the folder of the module or its one file.
    dir: string
    /// The file of `dir` its stages compile.
    entry: string = SNIPPET_ENTRY
    /// The snapshot of `dir` it checks when `dir` holds one per case, which then
    /// names it in the report; null elsewhere.
    snapshot: string | null = null
    phases: string[]
    modules: string[] = []
    /// The platform it is compiled for.
    target: Target = SNAPSHOT_TARGET
    /// Whether its run on the VM runs the image `vader build --emit=bytecode-text`
    /// links from source: its `_config.json` says so, or it has no bytecode
    /// snapshot.
    vm_from_build: bool = false
    /// What the task check answers on it, `accepted` or its codes (`T3128 T3129`),
    /// as the header of a fixture of the concurrency corpus says; null elsewhere.
    expected_tasks: string | null = null
}

// The stage the corpus names `phase`, null for a name it does not know.
stage_named :: fn(phase: string) -> Stage | null {
    for stage in STAGES {
        if stage.phase == phase {
            return stage
        }
    }
    return null
}

// The snippets of a run, and the folders that could not be read as one.
Discovery :: struct {
    cases: Case[] = []
    problems: string[] = []
}

// The modules, the driven projects, the examples, the snippets, then the
// fixtures, each with the phases of `phases` it runs. The first three come
// first: a module is compiled whole with what it imports, a project by its
// driver, and an example by a `vader` of its own, the longest cases of a run,
// which a pool should not start last.
find_cases :: fn(phases: string[]) -> Discovery {
    found :: Discovery {}
    if phases.contains(TESTS_PHASE) {
        find_module_tests(found)
    }
    if phases.contains(HOOK_PHASE) {
        find_hook_fixtures(found)
    }
    find_examples(found, phases)
    find_snippets(found, phases)
    if phases.contains(DIAGNOSTICS_PHASE) {
        find_fixtures(found)
    }
    if phases.contains(TARGETS_PHASE) {
        find_target_fixtures(found)
    }
    if phases.contains(EXTERNS_PHASE) {
        find_extern_fixtures(found)
    }
    for corpus in STAGE_CORPORA {
        if phases.contains(corpus.phase) {
            find_stage_fixtures(found, corpus)
        }
    }
    if phases.contains(DOC_PHASE) {
        find_doc_fixtures(found)
    }
    if phases.contains(FORMAT_PHASE) {
        find_format_cases(found)
    }
    return found
}

// The folders under `root` holding a `_main.vader`, in name order.
case_folders :: fn(found: Discovery, root: string) -> string[] =
    entry_folders(found, root, SNIPPET_ENTRY)

// The folders under `root` holding a file named `entry`, in name order.
entry_folders :: fn(found: Discovery, root: string, entry: string) -> string[] =
    entries_where(found, root, (path) -> exists("${path}/${entry}"))

// The file of `case` its stages compile.
entry_path :: fn(case: Case) -> string = "${case.dir}/${case.entry}"

// The path the report names `case` by: the snapshot it checks when its folder
// holds one per case, its folder otherwise.
case_path :: fn(case: Case) -> string {
    snapshot :: case.snapshot else return case.dir
    return "${case.dir}/${snapshot}"
}

// The entries of `root` whose path `keep` takes, in name order; the problem of a
// `root` that cannot be read goes to `found`.
entries_where :: fn(found: Discovery, root: string, keep: fn(string) -> bool) -> string[] {
    listed :: read_dir(root)
    if listed is IOError {
        found.problems.push("${root}: ${listed.msg}")
        return []
    }
    kept :: listed.filter((name) -> keep("${root}/${name}"))
    return sort(kept.collect(), (a, b) -> a < b)
}

// The snippets under `SNIPPETS`, with the phases of `phases` their `_config.json`
// lets run.
find_snippets :: fn(found: Discovery, phases: string[]) -> void {
    for name in case_folders(found, SNIPPETS) {
        dir :: "${SNIPPETS}/${name}"
        config :: read_config(dir)
        if config is ConfigProblems {
            for message in config.messages {
                found.problems.push("${dir}/${CONFIG_FILE}: ${message}")
            }
            continue
        }
        kept :: phases_of(config, phases)
        if phases.contains(VM_PHASE) && runs_on_vm(dir, config) {
            kept.push(VM_PHASE)
        }
        if phases.contains(NATIVE_PHASE) && runs_natively(dir, config) {
            kept.push(NATIVE_PHASE)
        }
        if phases.contains(FORMAT_PHASE) {
            kept.push(FORMAT_PHASE)
        }
        if kept.len() > 0 {
            found.cases.push(
                Case {
                    .name = name,
                    .dir = dir,
                    .phases = kept,
                    .modules = config.modules,
                    .vm_from_build = vm_from_build(dir, config),
                },
            )
        }
    }
}

// The dump phases of `phases` the snippet's `config` lets run, in the order of
// `STAGES`: all of them when it names none.
phases_of :: fn(config: SnippetConfig, phases: string[]) -> string[] {
    kept: string[]: []
    for stage in STAGES {
        if stage.dump != null && phases.contains(stage.phase) && covers(config, stage.phase) {
            kept.push(stage.phase)
        }
    }
    return kept
}

// Whether the snapshots of a snippet whose config is `config` cover `phase`.
covers :: fn(config: SnippetConfig, phase: string) -> bool {
    listed :: config.phases else return true
    return listed.contains(phase)
}

// Whether the run of the snippet in `dir` is checked on the VM: it has a run to
// check or a bytecode snapshot to run, its `_config.json` does not exclude the
// run on this host, and it brings no C of its own (`helper*.c`), which only a
// native binary links.
runs_on_vm :: fn(dir: string, config: SnippetConfig) -> bool {
    if !exists("${dir}/${VM_SNAPSHOT}") && !exists("${dir}/${BYTECODE_SNAPSHOT}") {
        return false
    }
    if excludes_this_host(config.vm) {
        return false
    }
    return helper_c_files(dir).len() == 0
}

// Whether the snippet in `dir` is built and run natively: it has a run to compare
// with, and its `_config.json` does not exclude the native run on this host.
runs_natively :: fn(dir: string, config: SnippetConfig) -> bool =
    exists("${dir}/${VM_SNAPSHOT}") && !excludes_this_host(config.native)

// Whether `run` is not checked here: everywhere (`skip`), or on the host's
// platform (`skip_on`).
excludes_this_host :: fn(run: RunConfig) -> bool =
    run.skipped || run.skipped_on.contains(host_platform())

// The name `skip_on` gives the host's platform, Node's `process.platform`.
host_platform :: fn() -> string = match host_target().os {
    .Linux           -> "linux"
    .Darwin          -> "darwin"
    .Windows         -> "win32"
    .Wasi | .Browser -> ""
}

// The C files beside the snippet in `dir` that define the foreign symbols of its
// `@extern` declarations, in name order.
helper_c_files :: fn(dir: string) -> string[] {
    listed :: read_dir(dir)
    if listed is IOError {
        return []
    }
    helpers :: listed.filter(is_helper_c)
    return sort(helpers.map((name) -> "${dir}/${name}").collect(), (a, b) -> a < b)
}

// Whether the file `name` of a snippet is a helper, `helper*.c`. Every other `.c`
// there is an output, a build's or the C snapshot: taken for a helper, it would
// skip the run of its snippet on the VM in silence.
is_helper_c :: fn(name: string) -> bool = name.starts_with("helper") && name.ends_with(".c")

// Whether the snippet in `dir` runs on the VM from the image a build links: its
// `_config.json` says `"vm": { "from": "build" }`, or it has no bytecode snapshot.
vm_from_build :: fn(dir: string, config: SnippetConfig) -> bool =
    config.vm.from_build || !exists("${dir}/${BYTECODE_SNAPSHOT}")

// ---- tests ------------------------------------------------------------------

import "std/testing"

@test
test_a_skip_excludes_the_run_everywhere :: fn() -> void {
    assert(excludes_this_host(RunConfig { .skipped = true }), "`skip`")
}

@test
test_a_skip_on_excludes_the_run_on_the_platforms_it_names :: fn() -> void {
    here :: RunConfig { .skipped_on = [host_platform()] }
    assert(excludes_this_host(here), "this host's platform")
    assert(!excludes_this_host(RunConfig { .skipped_on = ["plan9"] }), "another platform")
}

@test
test_a_helper_is_named_helper :: fn() -> void {
    assert(is_helper_c("helper.c"), "`helper.c`")
    assert(is_helper_c("helper_math.c"), "`helper_math.c`")
}

@test
test_the_outputs_beside_a_snippet_are_no_helpers :: fn() -> void {
    outputs :: [
        "native.c",
        "_main.c",
        "_main-_glue.c",
        "_main-_root.c",
        "_main-snippet.c",
        "_main.split.g.c",
        C_SNAPSHOT,
    ]
    for name in outputs {
        assert(!is_helper_c(name), "`${name}`")
    }
}

@test
test_a_case_checks_the_dumps_its_config_allows :: fn() -> void {
    asked :: ["lexer", "parser", "vm"]
    assert_eq(phases_of(SnippetConfig {}, asked).join(","), "lexer,parser")
    assert_eq(phases_of(SnippetConfig { .phases = ["parser"] }, asked).join(","), "parser")
}
