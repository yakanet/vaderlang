// tools/testrunner/src/worker: `testrunner --worker`, which runs the cases it reads.
//
// It reads one request per line on stdin, until stdin ends (`protocol.vader`).
// Each stage of a case is rendered by `vader/tools/dump` as `vader dump
// --target=linux-x86_64` renders it, the bytecode annotated, then turned into
// the text the snapshot holds and compared with it; under `--update`, a snapshot
// that differs is written. The stages of a case share one front end, its run on
// the VM is the `vm` stage (`vm_run.vader`), its native build and run the
// `native` stage (`native_run.vader`), the `@test` functions of a module the
// `tests` stage (`tests_run.vader`), the runs of an example its two stages
// (`examples.vader`), and the build of a driven project the `hook` stage
// (`hook_fixtures.vader`). Each case has a folder of its own under the worker's, kept
// when the case fails (`enter_case`). Nothing but the protocol goes to stdout.

module "tools/testrunner/src"

import "json"
import "std/console"
import "std/diff"
import "std/env"
import "std/fs"
import "std/io"
import "std/path"
import "std/string"
import "std/time"
import "vader/pipeline"
import "vader/tools/dump"

// Where a program looks for its temporary folder: `TMPDIR` on POSIX, `TMP` then
// `TEMP` on Windows.
TEMP_VARIABLES: string[]: ["TMPDIR", "TMP", "TEMP"]

// What the cases a worker runs share.
WorkerContext :: struct {
    /// Write each snapshot that differs or is missing.
    update: bool
    /// The folder each case gets its own folder under (`enter_case`).
    scratch: string
    /// The C compiler of the native builds.
    cc: string
}

// Run the cases read on stdin until it ends.
//
// @param update   write each snapshot that differs or is missing.
// @param scratch  the folder each case gets its own folder under, absolute.
run_worker :: fn(update: bool, scratch: string) -> i32 {
    ctx :: WorkerContext {
        .update = update,
        .scratch = scratch,
        .cc = cc_or_default(""),
    }
    for {
        line :: read_line()
        if line is IOError {
            return 0
        }
        if line == "" {
            continue
        }
        case :: read_request(line)
        if case == null {
            // A runner waits for the `done` of what it sent.
            print(error_record("", "not a request: ${line}"))
            print(done_record("", 0))
            continue
        }
        run_request(ctx, case)
    }
}

run_request :: fn(ctx: WorkerContext, case: Case) -> void {
    began :: monotonic()
    dir :: enter_case(ctx, case)
    if dir is CaseFailure {
        print(error_record(case.name, dir.message))
        print(done_record(case.name, began.since().to_micros()))
        return
    }
    input :: DumpInput {
        .file = Path(entry_path(case)),
        .modules = case.modules,
        .target = case.target,
        .annotate = true,
    }
    failed := false
    for phase in case.phases {
        checked :: check_phase(ctx, case, phase, input, dir)
        if checked is CaseFailure {
            print(error_record(case.name, checked.message))
            failed = true
        } else {
            print(stage_record(case.name, checked))
            failed = failed || is_failure(checked.result)
        }
    }
    if !failed {
        remove_tree(dir)
    }
    print(done_record(case.name, began.since().to_micros()))
}

// Check the stage of `case` named `phase`, in the case's folder `dir`.
check_phase :: fn(
    ctx: WorkerContext,
    case: Case,
    phase: string,
    input: DumpInput,
    dir: string,
) -> StageReport | CaseFailure {
    stage :: stage_named(phase) ?? return CaseFailure { .message = "no stage `${phase}`" }
    dump :: stage.dump
    if dump != null {
        return check_stage(case, stage, dump, input, ctx.update)
    }
    if phase == NATIVE_PHASE {
        return check_native(ctx, case, dir)
    }
    if phase == DIAGNOSTICS_PHASE {
        return check_diagnostics(case, input, ctx.update)
    }
    if phase == TESTS_PHASE {
        return check_tests(case)
    }
    if phase == TARGETS_PHASE {
        return check_targets(case, input, ctx.update)
    }
    if is_dump_named(phase) {
        return check_stage(case, stage, phase, input, ctx.update)
    }
    if phase == EXAMPLE_PHASE || phase == NATIVE_EXAMPLE_PHASE {
        return check_example(case, stage, dir, ctx.update)
    }
    if phase == HOOK_PHASE {
        return check_hook(case, dir, ctx.update)
    }
    return check_run(case, ctx.update)
}

// The folder of `case` under the worker's, made anew, with the temporary folder
// its programs are given: on the VM, they read this process's environment, and
// built natively, the child inherits it.
enter_case :: fn(ctx: WorkerContext, case: Case) -> string | CaseFailure {
    dir :: "${ctx.scratch}/${case.name}"
    temp :: "${dir}/tmp"
    remove_tree(dir)
    made :: create_dir(temp)
    if made is IOError {
        return CaseFailure { .message = "`${temp}`: ${made.msg}" }
    }
    for name in TEMP_VARIABLES {
        exported :: set_env(name, temp)
        if exported is IOError {
            return CaseFailure { .message = "`${name}`: ${exported.msg}" }
        }
    }
    return dir
}

// Remove the folder at `path` and what it holds, when it exists.
remove_tree :: fn(path: string) -> void {
    remove(path, RemoveOptions { .recursive = true, .force = true })
}

// Render `stage` of `case`, the stage `dump` of `vader dump`, and compare it with
// its snapshot, which `update` writes when it differs; or say which rule its text
// breaks (`rules.vader`), and write nothing.
check_stage :: fn(
    case: Case,
    stage: Stage,
    dump: string,
    input: DumpInput,
    update: bool,
) -> StageReport | CaseFailure {
    began :: monotonic()
    actual :: snapshot_text(stage, input.dump_stage(dump))
    broken :: stage_problem(case, stage, actual)
    if broken != null {
        return CaseFailure { .message = "${stage.phase}: ${broken}" }
    }
    return report_of(case, stage, actual, update, began)
}

// What `stage` of `case`, begun at `began`, reports for its text `actual`,
// compared with its snapshot, which `update` writes when it differs: the one the
// case names, the stage's otherwise.
report_of :: fn(
    case: Case,
    stage: Stage,
    actual: string,
    update: bool,
    began: Monotonic,
) -> StageReport {
    path :: "${case.dir}/${case.snapshot ?? stage.snapshot}"
    expected :: read_file_string(path)
    result :: verdict_of(expected, actual, path, update)
    return StageReport {
        .phase = stage.phase,
        .result = result,
        .duration_us = began.since().to_micros(),
        .detail = failure_detail(result, expected, actual, path),
    }
}

// What shows a stage that fails: the unified diff from its snapshot, at `path`,
// to its text, or the whole text when it has no snapshot. Null for one that does
// not fail.
failure_detail :: fn(
    result: Verdict,
    expected: string | IOError,
    actual: string,
    path: string,
) -> string | null {
    if result == .Missing {
        return actual
    }
    if result != .Differ || expected is IOError {
        return null
    }
    return "--- ${path}\n+++ actual\n${unified_diff(expected, actual)}"
}

verdict_of :: fn(
    expected: string | IOError,
    actual: string,
    path: string,
    update: bool,
) -> Verdict {
    if expected is string && expected == actual {
        return .Same
    }
    if update && write_file(path, actual) == null {
        return .Written
    }
    if expected is IOError {
        return .Missing
    }
    return .Differ
}

// ---- the text of a snapshot -------------------------------------------------

// The text the snapshot of `stage` holds for what the stage rendered: its
// stdout, the JSON form for the parser, and the stderr ahead of a failure.
snapshot_text :: fn(stage: Stage, output: StageOutput) -> string {
    text :: if output.code == 0 { output.out } else {
        failed_text(output.code, output.err, output.out)
    }
    if stage.phase == "parser" {
        return ast_as_json(text)
    }
    return text
}

// The dump of the `ast` stage as the JSON the parser snapshot holds.
ast_as_json :: fn(dump: string) -> string {
    head :: "# AST\n"
    if !dump.starts_with(head) {
        return dump
    }
    body :: dump.trim_prefix(head)
    halves :: body.split_first("\n# Diagnostics\n") ?? [body, ""]
    lines: JsonValue[]: []
    for line in halves.1.split("\n") {
        if line != "" {
            lines.push(JsonString { .value = line })
        }
    }
    ast :: nested(halves.0.trim())
    diagnostics :: nested(stringify(JsonArray { .items = lines }, 2))
    return "{\n  \"ast\": ${ast},\n  \"diagnostics\": ${diagnostics}\n}\n"
}

nested :: fn(text: string) -> string = text.replace_all("\n", "\n  ")

// What opens the text of a stage whose dump failed.
CLI_FAILED_PREFIX :: "# vader CLI failed"

failed_text :: fn(code: i32, stderr: string, stdout: string) -> string =
    "${CLI_FAILED_PREFIX} (exit ${code})\n${stderr}${stdout}"

// ---- tests ------------------------------------------------------------------

import "std/testing"

@test
test_a_differing_stage_shows_its_diff :: fn() -> void {
    detail :: failure_detail(.Differ, "a\n", "b\n", "s/lexer.snapshot")
    assert_eq(detail ?? "", "--- s/lexer.snapshot\n+++ actual\n@@ -1 +1 @@\n-a\n+b\n")
}

@test
test_a_stage_without_snapshot_shows_its_text :: fn() -> void {
    assert_eq(failure_detail(.Missing, "", "text\n", "s/vm.snapshot") ?? "", "text\n")
}

@test
test_a_passing_stage_shows_nothing :: fn() -> void {
    assert(failure_detail(.Same, "a\n", "a\n", "s/vm.snapshot") == null, "a stage that passes")
}

@test
test_a_stage_compares_its_text_with_its_snapshot :: fn() -> void {
    assert(verdict_of("a\n", "a\n", "unused", false) == .Same, "the same text")
    assert(verdict_of("a\n", "b\n", "unused", false) == .Differ, "another text")
}
