// tools/testrunner/src/main: check the stage dumps of the snippets against their snapshots.
//
// The runner drives K workers, each a `testrunner --worker` child of the same
// binary that compiles the cases in its own process (`worker.vader`), K being
// the number of cores by default. It hands them the snippets of
// `tests/snippets` one case at a time (`pool.vader`) and adds up what they
// report (`protocol.vader`).
//
// The binary embeds the compiler from its sources, so it refuses to run when a
// source under `vader/`, `lib/` or `tools/testrunner/` is newer than itself.
// `vader build --release` in `tools/testrunner` builds it. Run it from the
// repository root:
//
//   testrunner [--update] [--jobs=N] [--phases=lexer,parser,...]

module "tools/testrunner/src"

import "cli"
import "std/console"
import "std/env"
import "std/fs"
import "std/io"
import "std/iter"
import "std/process"
import "std/string"
import "std/task"
import "std/time"

FLAGS: FlagSpec[]: [
    FlagSpec {
        .name = "worker",
        .help = "Run the cases a runner writes on stdin",
        .kind = .Bool,
    },
    FlagSpec {
        .name = "update",
        .help = "Write the snapshots that differ or are missing",
        .kind = .Bool,
    },
    FlagSpec {
        .name = "jobs",
        .alias = "j",
        .help = "Run N workers",
        .value_name = "N",
        .kind = .Int,
    },
    FlagSpec {
        .name = "phases",
        .help = "Check these phases only",
        .value_name = "a,b",
    },
]

// The folders the binary is built from.
SOURCES: string[]: ["vader", "lib", "tools/testrunner"]

main :: fn(argv: string[]) -> i32 {
    parsed :: parse(argv[1..<argv.len()], FLAGS)
    for problem in parsed.errors {
        eprintln("testrunner: ${problem}")
    }
    if parsed.errors.len() > 0 {
        return 2
    }
    if parsed.positionals.len() > 0 {
        eprintln("testrunner: unexpected argument `${parsed.positionals[0]}`")
        return 2
    }
    update :: parsed.bool_flag("update")
    if parsed.bool_flag("worker") {
        return run_worker(update)
    }
    newer :: newer_source()
    if newer != null {
        eprintln("testrunner: `${newer}` is newer than this binary: rebuild it with")
        eprintln("  (cd tools/testrunner && ../../build/vader build --release)")
        return 2
    }
    phases_arg :: parsed.string_flag("phases", "")
    phases :: if phases_arg == "" { STAGES.map((s) -> s.phase).collect() } else {
        phases_arg.split(",")
    }
    for phase in phases {
        if stage_named(phase) == null {
            eprintln("testrunner: no phase `${phase}`")
            return 2
        }
    }
    command :: worker_command(update)
    k :: worker_count(parsed.int_flag("jobs", 0))
    found :: find_cases(phases)
    return run_all(found.cases, found.problems, command, k)
}

// Run `cases` on `k` workers started with `command`, and print what they found
// with the `problems` of the discovery.
run_all :: fn(cases: Case[], problems: string[], command: string[], k: i32) -> i32 {
    // The workers inherit this environment, and a `VADER_HOME` moves the modules
    // of the toolchain in the dumps: the snapshots are taken without one.
    unset_env("VADER_HOME")
    // Indices rather than the cases: a task that reads an array of a `Case` it
    // received is taken for one that writes it.
    // Counted before the tasks start: the task analysis does not see `join_all`
    // end them, and takes a later read for one that races them.
    count :: cases.len()
    queue :: Channel<i64> { .capacity = UNBOUNDED }
    for i in 0..<count {
        queue.send(i)
    }
    queue.close()
    began :: monotonic()
    tasks: Task<Tally>[]: []
    for _ in 0..<k {
        slot :: Slot { .command = command }
        tasks.push(launch(() -> serve(slot, cases, queue)))
    }
    total :: Tally {}
    for result in join_all(tasks) {
        if result is Tally {
            total.same += result.same
            total.written.push_all(result.written)
            total.failures.push_all(result.failures)
            total.crashes.push_all(result.crashes)
            total.errors.push_all(result.errors)
        }
    }
    total.errors.push_all(problems)
    print_tally(total, count, k, began.since().to_millis())
    if total.failures.len() + total.crashes.len() + total.errors.len() > 0 {
        return 1
    }
    return 0
}

print_tally :: fn(total: Tally, cases: i64, k: i32, millis: i64) -> void {
    for name in total.failures {
        println("  != snapshot: ${name}")
    }
    for crash in total.crashes {
        println("  crash: ${crash.case}/${crash.phase} exit ${crash.exit}")
        print(crash.stderr)
    }
    for message in total.errors {
        println("  error: ${message}")
    }
    for name in total.written {
        println("  written: ${name}")
    }
    checked :: total.same + total.written.len() + total.failures.len()
    println("${cases} cases, ${checked} stages in ${millis} ms on ${k} workers")
    println(
        "same ${total.same}, written ${total.written.len()}, differ ${total.failures.len()}, "
            + "crashes ${total.crashes.len()}, errors ${total.errors.len()}",
    )
}

// The argv of a worker: this binary, as a worker.
worker_command :: fn(update: bool) -> string[] {
    command :: [current_executable_location(), "--worker"]
    if update {
        command.push("--update")
    }
    return command
}

worker_count :: fn(asked: i32) -> i32 = if asked > 0 { asked } else { processor_count() }

// A `.vader` file of `SOURCES` modified after this binary, null when none is.
newer_source :: fn() -> string | null {
    built :: modification_time(current_executable_location())
    if built is IOError {
        return null
    }
    for root in SOURCES {
        walker :: walk(root)
        if walker is IOError {
            continue
        }
        for entry in walker {
            if !entry.name.ends_with(".vader") {
                continue
            }
            changed :: modification_time(entry.path)
            if changed is i64 && changed > built {
                return entry.path
            }
        }
    }
    return null
}
