// tools/testrunner/src/main: check the snippets against their snapshots, the
// stage dumps, the run on the VM and the native run; the diagnostics corpora; and
// the `@test` functions of the modules of `lib/`, `vader/` and `tools/`.
//
// The runner drives K workers, each a `testrunner --worker` child of the same
// binary that compiles the cases in its own process (`worker.vader`), K being
// the number of cores by default. Each worker runs its cases under a folder of
// its own, `SCRATCH/<i>`, which keeps the files of a case that fails until the
// next run. It hands them the cases one at a time (`pool.vader`), over JSON
// lines (`protocol.vader`), and prints what they report as it comes, then the
// tally (`report.vader`).
//
// The binary embeds the compiler from its sources, so it refuses to run when a
// source under `vader/`, `lib/` or `tools/testrunner/` is newer than itself.
// `vader build --release` in `tools/testrunner` builds it. Run it from the
// repository root:
//
//   testrunner [--update] [--jobs=N] [--phases=lexer,parser,...]

module "tools/testrunner/src"

import "cli"
import "std/console"
import "std/env"
import "std/fs"
import "std/io"
import "std/iter"
import "std/process"
import "std/string"
import "std/task"
import "std/time"

FLAGS: FlagSpec[]: [
    FlagSpec {
        .name = "worker",
        .help = "Run the cases a runner writes on stdin",
        .kind = .Bool,
    },
    FlagSpec {
        .name = "update",
        .help = "Write the snapshots that differ or are missing",
        .kind = .Bool,
    },
    FlagSpec {
        .name = "jobs",
        .alias = "j",
        .help = "Run N workers",
        .value_name = "N",
        .kind = .Int,
    },
    FlagSpec {
        .name = "phases",
        .help = "Check these phases only",
        .value_name = "a,b",
    },
    FlagSpec {
        .name = "scratch",
        .help = "Run the cases under the folder DIR (a worker)",
        .value_name = "DIR",
    },
]

// The folder the workers run the cases under, emptied at the start of a run.
SCRATCH :: "build/testrunner"

// The folders the binary is built from.
SOURCES: string[]: ["vader", "lib", "tools/testrunner"]

main :: fn(argv: string[]) -> i32 {
    parsed :: parse(argv[1..<argv.len()], FLAGS)
    for problem in parsed.errors {
        eprintln("testrunner: ${problem}")
    }
    if parsed.errors.len() > 0 {
        return 2
    }
    if parsed.positionals.len() > 0 {
        eprintln("testrunner: unexpected argument `${parsed.positionals[0]}`")
        return 2
    }
    update :: parsed.bool_flag("update")
    if parsed.bool_flag("worker") {
        scratch :: parsed.string_flag("scratch", "${current_working_directory()}/${SCRATCH}/worker")
        return run_worker(update, scratch)
    }
    newer :: newer_source()
    if newer != null {
        eprintln("testrunner: `${newer}` is newer than this binary: rebuild it with")
        eprintln("  (cd tools/testrunner && ../../build/vader build --release)")
        return 2
    }
    phases_arg :: parsed.string_flag("phases", "")
    phases :: if phases_arg == "" { STAGES.map((s) -> s.phase).collect() } else {
        phases_arg.split(",")
    }
    for phase in phases {
        if stage_named(phase) == null {
            eprintln("testrunner: no phase `${phase}`")
            return 2
        }
    }
    command :: worker_command(update)
    k :: worker_count(parsed.int_flag("jobs", 0))
    found :: find_cases(phases)
    return run_all(found.cases, found.problems, command, update, k)
}

// Run `cases` on `k` workers started with `command`, which `update` the snapshots
// that differ, and print what they found with the `problems` of the discovery.
run_all :: fn(
    cases: Case[],
    problems: string[],
    command: string[],
    update: bool,
    k: i32,
) -> i32 {
    // The workers inherit this environment, and a `VADER_HOME` moves the modules
    // of the toolchain in the dumps: the snapshots are taken without one.
    unset_env("VADER_HOME")
    remove_tree(SCRATCH)
    scratch :: "${current_working_directory()}/${SCRATCH}"
    // Indices rather than the cases: a task that reads an array of a `Case` it
    // received is taken for one that writes it.
    // Counted before the tasks start: the task analysis does not see `join_all`
    // end them, and takes a later read for one that races them.
    count :: cases.len()
    queue :: Channel<i64> { .capacity = UNBOUNDED }
    for i in 0..<count {
        queue.send(i)
    }
    queue.close()
    began :: monotonic()
    events :: Channel<Progress> { .capacity = UNBOUNDED }
    for problem in problems {
        events.send(RunError { .message = problem })
    }
    println("testrunner: ${count} cases on ${k} workers")
    reporter :: launch(() -> report(events))
    ticker :: launch(() -> tick(events))
    tasks: Task<void>[]: []
    for i in 0..<k {
        slot :: Slot { .command = command + ["--scratch=${scratch}/${i}"], .update = update }
        tasks.push(launch(() -> serve(slot, cases, queue, events)))
    }
    join_all(tasks)
    ticker.cancel()
    ticker.join()
    events.close()
    total :: reporter.join()
    if total is Cancelled {
        return 1
    }
    print_tally(total, count, k, began.since())
    if total.failed.len() > 0 {
        return 1
    }
    return 0
}

// The argv of a worker: this binary, as a worker.
worker_command :: fn(update: bool) -> string[] {
    command :: [current_executable_location(), "--worker"]
    if update {
        command.push("--update")
    }
    return command
}

worker_count :: fn(asked: i32) -> i32 = if asked > 0 { asked } else { processor_count() }

// A `.vader` file of `SOURCES` modified after this binary, null when none is.
newer_source :: fn() -> string | null {
    built :: modification_time(current_executable_location())
    if built is IOError {
        return null
    }
    for root in SOURCES {
        walker :: walk(root)
        if walker is IOError {
            continue
        }
        for entry in walker {
            if !entry.name.ends_with(".vader") {
                continue
            }
            changed :: modification_time(entry.path)
            if changed is i64 && changed > built {
                return entry.path
            }
        }
    }
    return null
}
