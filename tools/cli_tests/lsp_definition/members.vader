// tools/cli_tests/lsp_definition/members: where a click lands on what sits
// after a dot, behind an alias or a `match` header, and on the operand of a
// bytecode dump.
//
// Each test opens one document of a fresh project (`drive` of
// `tools/cli_tests/lsp`). The helpers `range_at` and `file_name` are those of
// `definition.vader`.

module "tools/cli_tests/lsp_definition"

import "json"
import "std/collections"
import "std/iter"
import "std/string"
import "tools/cli_tests/lsp"
import "tools/cli_tests/rpc"

// The line of the range at `path` in `value`, -1 when there is none.
start_line :: fn(value: JsonValue) -> i64 = int_at(value, ["range", "start", "line"])

// ---- tests ----------------------------------------------------------------

import "std/testing"

// A `match` header's binding is declared by its name token.
HEADER_BINDING_SOURCE :: r"""
    module "lsptest"

    A :: struct { n: i32 }
    B :: struct { s: string }

    make :: fn() -> A | B = A { .n = 1 }

    via_match :: fn() -> i32 = match x :: make() {
        is A -> x.n
        is B -> 0
    }
    """

@test
test_a_match_headers_binding_is_declared_renamed_and_hovered_at_its_name :: fn() -> void {
    results :: drive(
        "definition_header_binding",
        HEADER_BINDING_SOURCE,
        [
            ask("textDocument/definition", 8, 12),
            ask("textDocument/rename", 8, 12),
            ask("textDocument/hover", 8, 12),
        ],
    )
    // The `x` of `match x :: make()`.
    assert_eq(range_at(results[0], ["range"]).split("-")[0], "7:33")
    changes :: member(results[1], "changes") else JsonNull {}
    assert(changes is JsonObject, stringify(results[1]))
    if changes is JsonObject {
        files :: changes.entries.keys().collect()
        assert_eq(files.len(), 1)
        edits :: array_at(changes, [files[0]])
        // The declaration and one use, every range covering the name itself.
        assert_eq(edits.len(), 2)
        for edit in edits {
            assert_eq(text_at(HEADER_BINDING_SOURCE, member(edit, "range") else JsonNull {}), "x")
        }
    }
    // A use reads the binding at the type its arm narrowed it to.
    assert_eq(string_at(results[2], ["contents", "value"]) else "", "```\nx: A\n```")
}

// The alias `S` leads to `std/string`; the local `trim` is a decoy that would
// answer with this very file.
ALIAS_SOURCE :: r"""
    module "lsptest"

    S :: import "std/string"

    trim :: fn(x: string) -> string = x

    use :: fn(a: string) -> string = S.trim(a)
    """

@test
test_definition_follows_a_namespace_alias :: fn() -> void {
    results :: drive(
        "definition_namespace_alias",
        ALIAS_SOURCE,
        [ask("textDocument/definition", 6, 36)],
    )
    assert(results[0] is JsonObject, stringify(results[0]))
    assert(file_name(results[0]).ends_with("string.vader"), stringify(results[0]))
}

// `std/core` is the prelude, so no import table leads to the declarations of
// its array trait: the jump has to land there anyway.
BUILTIN_METHOD_SOURCE :: r"""
    module "lsptest"

    main :: fn() -> i32 {
        xs: i32[]: []
        xs.push(1)
        return i32(xs.len())
    }
    """

@test
test_definition_reaches_a_method_on_a_built_in_receiver :: fn() -> void {
    results :: drive(
        "definition_built_in_method",
        BUILTIN_METHOD_SOURCE,
        [
            ask("textDocument/definition", 4, 8),
            ask("textDocument/definition", 5, 19),
        ],
    )
    landed :: [file_name(results[0]), file_name(results[1])].join(" ")
    assert_eq(landed, "array.vader array.vader")
}

// `len(s: string)` is a free fn reached by UFCS, not a member of a trait: of the
// four `len` the stdlib declares, the receiver picks the one for a string.
BUILTIN_FREE_FN_SOURCE :: r"""
    module "lsptest"

    main :: fn() -> i32 {
        s :: "hello"
        return i32(s.len())
    }
    """

@test
test_definition_on_a_string_receiver_reaches_the_free_fn_not_the_array_trait :: fn() -> void {
    results :: drive(
        "definition_string_receiver",
        BUILTIN_FREE_FN_SOURCE,
        [ask("textDocument/definition", 4, 18)],
    )
    assert(results[0] is JsonObject, stringify(results[0]))
    assert_eq(file_name(results[0]), "utf8.vader")
}

// Two structs declare `cond`: the type of the receiver tells them apart, not the
// name.
FIELD_PRECISION_SOURCE :: r"""
    module "lsptest"

    Alpha :: struct { cond: i32 }
    Bravo :: struct { cond: i32 }

    read_alpha :: fn(a: Alpha) -> i32 = a.cond
    read_bravo :: fn(b: Bravo) -> i32 = b.cond
    """

@test
test_definition_picks_the_field_of_the_receivers_type :: fn() -> void {
    results :: drive(
        "definition_field_of_receiver",
        FIELD_PRECISION_SOURCE,
        [
            ask("textDocument/definition", 5, 38),
            ask("textDocument/definition", 6, 38),
        ],
    )
    assert_eq(start_line(results[0]), 2)
    assert_eq(start_line(results[1]), 3)
}

// Two enums declare `Two`: only the type of the slot the variant is assigned to
// picks one.
ENUM_VARIANT_SOURCE :: r"""
    module "lsptest"

    Decoy :: enum(u8) {
        One,
        Two,
    }

    Choice :: enum(u8) {
        One,
        Two,
    }

    pick :: fn() -> Choice = .Two
    """

@test
test_definition_reaches_an_enum_variant :: fn() -> void {
    results :: drive(
        "definition_enum_variant",
        ENUM_VARIANT_SOURCE,
        [ask("textDocument/definition", 12, 26)],
    )
    assert(results[0] is JsonObject, stringify(results[0]))
    assert_eq(start_line(results[0]), 9)
}

STRUCT_FIELD_SOURCE :: r"""
    module "lsptest"

    Image :: struct {
        width:  i32
        pixels: i32[]
    }

    area :: fn(img: Image) -> i32 = img.width * i32(img.pixels.len())
    """

// `img.pixels` on the last line reaches the field, not the struct.
@test
test_definition_reaches_a_struct_field :: fn() -> void {
    results :: drive(
        "definition_struct_field",
        STRUCT_FIELD_SOURCE,
        [ask("textDocument/definition", 7, 54)],
    )
    assert(results[0] is JsonObject, stringify(results[0]))
    assert_eq(start_line(results[0]), 4)
}

// `Derived` receives `width` from `...Base`, so the field is declared in `Base`.
// `Decoy` declares a `width` too and comes first: a lookup by name alone lands
// there.
RECEIVED_FIELD_SOURCE :: r"""
    module "lsptest"

    Decoy :: struct {
        width: i32 = 1
    }

    Base :: struct {
        width: i32 = 0
    }

    Derived :: struct {
        ...Base
        depth: i32 = 0
    }

    read :: fn(d: Derived) -> i32 = d.width
    """

@test
test_a_field_received_through_a_spread_is_declared_by_its_base :: fn() -> void {
    results :: drive(
        "definition_received_field",
        RECEIVED_FIELD_SOURCE,
        [
            ask("textDocument/definition", 15, 35),
            ask("textDocument/hover", 15, 35),
            ask("textDocument/hover", 10, 2),
        ],
    )
    assert(results[0] is JsonObject, stringify(results[0]))
    assert_eq(start_line(results[0]), 7)
    field_hover :: string_at(results[1], ["contents", "value"]) else ""
    assert(
        field_hover.starts_with("lsptest \u{203a} Base\n\n```\nwidth: i32 = 0\n```"),
        field_hover,
    )
    struct_hover :: string_at(results[2], ["contents", "value"]) else ""
    expected :: "lsptest\n\n```\nDerived :: struct {\n    ...Base\n    depth: i32 = 0\n}\n```"
    assert(struct_hover.starts_with(expected), struct_hover)
}

// `count` is a field of `Holder` and a top-level fn, the field declared first:
// the call reaches the fn. `.Two` in a match pattern is not an expression, so
// the smallest expression holding the cursor is the whole `match`, whose type
// names no enum: the pattern reaches `Pick.Two`, not the decoy's.
MEMBER_RANK_SOURCE :: r"""
    module "lsptest"

    Holder :: struct {
        count: i32
    }

    Decoy :: enum(u8) { One, Two }
    Pick  :: enum(u8) { One, Two }

    count :: fn() -> i32 = 7

    classify :: fn(p: Pick) -> i32 = match p {
        .One -> 1
        .Two -> 2
    }

    use :: fn() -> i32 = count() + classify(.One)
    """

@test
test_a_field_never_masks_a_top_level_fn_of_the_same_name :: fn() -> void {
    results :: drive(
        "definition_field_rank",
        MEMBER_RANK_SOURCE,
        [
            ask("textDocument/definition", 16, 23),
            ask("textDocument/definition", 13, 6),
        ],
    )
    assert(results[0] is JsonObject, stringify(results[0]))
    assert(results[1] is JsonObject, stringify(results[1]))
    assert_eq(start_line(results[0]), 9)
    assert_eq(start_line(results[1]), 7)
}

// ---- a bytecode dump ------------------------------------------------------

// An operand of a dump, the line it sits on and the line it names.
Jump :: struct {
    line: i64
    operand: string
    target: i64
}

// The index of the first line of `lines` from `from` that `matches`, -1 when none.
first_line :: fn(lines: string[], from: i64, matches: fn(string) -> bool) -> i64 {
    for i in from..<lines.len() {
        if matches(lines[i]) {
            return i
        }
    }
    return -1
}

// The index of the last line of `lines` at or before `before` that `matches`, -1
// when none.
last_line :: fn(lines: string[], before: i64, matches: fn(string) -> bool) -> i64 {
    for back in 0..=before {
        i :: before - back
        if matches(lines[i]) {
            return i
        }
    }
    return -1
}

// Whether `text` is made of digits only, and not empty.
is_number :: fn(text: string) -> bool {
    if text.byte_len() == 0 {
        return false
    }
    for c in text {
        if c < '0' || c > '9' {
            return false
        }
    }
    return true
}

// The operand of an indented line `<op> <digits>`, null for any other line.
operand_of :: fn(line: string, op: string) -> string | null {
    if !line.starts_with(" ") {
        return null
    }
    text :: line.trim()
    if !text.starts_with("${op} ") {
        return null
    }
    rest :: text.byte_slice(op.byte_len() + 1, text.byte_len())
    if !is_number(rest) {
        return null
    }
    return rest
}

// The jump of the first line `<op> <n>`, its target the first line `<directive> <n> `.
indexed :: fn(lines: string[], op: string, directive: string) -> Jump {
    at :: first_line(lines, 0, (l) -> operand_of(l, op) != null)
    n :: operand_of(lines[at], op) else ""
    target :: first_line(lines, 0, (l) -> l.starts_with("${directive} ${n} "))
    return Jump { .line = at, .operand = n, .target = target }
}

// The offset of the last `needle` in `text`, -1 when there is none.
last_offset :: fn(text: string, needle: string) -> i64 {
    found: i64 = -1
    width :: needle.byte_len()
    for i in 0..=text.byte_len() - width {
        if text.byte_slice(i, i + width) == needle {
            found = i
        }
    }
    return found
}

// Whether `line` opens a scope `label` names: `block`, `loop` or `if`.
opens_scope :: fn(line: string, label: string) -> bool {
    words :: line.trim().split(" ")
    if words.len() < 2 {
        return false
    }
    return (words[0] == "block" || words[0] == "loop" || words[0] == "if") && words[1] == label
}

// The label of a `br` or `br_if` line, null for any other line.
branch_label :: fn(line: string) -> string | null {
    words :: line.trim().split(" ")
    if words.len() != 2 || !line.starts_with(" ") {
        return null
    }
    if (words[0] == "br" || words[0] == "br_if") && words[1].starts_with("\$L") {
        return words[1]
    }
    return null
}

// An operand that is a table index jumps to the line declaring what it names; a
// label after `br` / `br_if` jumps to the scope opening it.
@test
test_a_virt_operand_jumps_to_what_it_names :: fn() -> void {
    dump :: bytecode_dump("tests/snippets/json_basics/_main.vader")
    lines :: dump.split("\n")
    jumps: Jump[]: [
        indexed(lines, "call", "fn"),
        indexed(lines, "string.const", "string"),
        indexed(lines, "ref.cast", "type"),
        indexed(lines, "call.import", "import"),
    ]
    // `fn 0 ...`: slot 1 is a parameter, slot 2 its first local.
    show :: first_line(lines, 0, (l) -> l.starts_with("fn 0 "))
    get_line :: first_line(lines, show, (l) -> l.starts_with(" ") && l.trim() == "local.get 1")
    tee_line :: first_line(lines, show, (l) -> l.starts_with(" ") && l.trim() == "local.tee 2")
    first_local :: first_line(
        lines,
        show,
        (l) -> l.starts_with(" ") && l.trim().starts_with("local "),
    )
    jumps.push(Jump { .line = get_line, .operand = "1", .target = show })
    jumps.push(Jump { .line = tee_line, .operand = "2", .target = first_local })
    branch :: first_line(lines, 0, (l) -> branch_label(l) != null)
    label :: branch_label(lines[branch]) else ""
    opening :: last_line(lines, branch, (l) -> opens_scope(l, label))
    jumps.push(Jump { .line = branch, .operand = label, .target = opening })
    queries: Query[]: []
    for jump in jumps {
        assert(jump.line >= 0, "no line for the operand ${jump.operand}")
        assert(jump.target >= 0, "no target for the operand ${jump.operand}")
        character :: last_offset(lines[jump.line], jump.operand)
        queries.push(ask("textDocument/definition", jump.line, character))
    }
    // The op's own name names nothing.
    queries.push(ask("textDocument/definition", jumps[0].line, 3))
    results :: drive(
        "definition_virt_operand",
        dump,
        queries,
        Project { .name = "dump.virt" },
    )
    targets: string[]: []
    expected: string[]: []
    for i in 0..<jumps.len() {
        targets.push("${start_line(results[i])}")
        expected.push("${jumps[i].target}")
    }
    assert_eq(targets.join(" "), expected.join(" "))
    assert(results[jumps.len()] is JsonNull, stringify(results[jumps.len()]))
}
