// tools/cli_tests/ranges/ranges: what the range analysis reports, and which
// index checks the C of a build keeps once it has run.
//
// The verdicts on each site of the fixtures of `tests/fixtures/range` are the
// `ranges` snapshots of a family of the test runner. These check the report
// `VADER_OPT_REPORT` prints, and the checks the C keeps: a release build drops
// the check of an access proven in bounds, a debug build keeps it, and
// `VADER_VERIFY_BOUNDS` keeps it under a message of its own.

module "tools/cli_tests/ranges"

import "regex"
import "std/abort"
import "std/iter"
import "std/string"
import "tools/cli_tests/cli"

VERDICTS :: "tests/fixtures/range/verdicts.vader"
ELISION  :: "tests/fixtures/range/elision/elision.vader"

// What names an index check in the C.
INDEX_CHECK :: r"VADER_ARRAY_CHECK_[A-Z]+"

// The index checks of the C definition of `elision$<name>` in `c`, in order.
checks_in :: fn(c: string, name: string) -> string {
    head :: " elision\$${name}("
    lines :: c.split("\n")
    for i in 0..<lines.len() {
        line :: lines[i]
        if line.starts_with("static ") && head in line && line.ends_with(") {") {
            body: string[]: []
            for j in i + 1..<lines.len() {
                if lines[j] == "}" {
                    break
                }
                body.push(lines[j])
            }
            pattern :: compile(INDEX_CHECK) else panic(pattern.message())
            found :: pattern.find_all(body.join("\n"))
            return found.map((m) -> m.groups[0]).collect().join(" ")
        }
    }
    return "no definition of `elision\$${name}`"
}

// The C a native build of `ELISION` with `flags` emits, streamed.
native_c :: fn(flags: string[], env: [string, string | null][] = []) -> string {
    argv :: ["build"] + flags + ["--emit=c", "--out=-", ELISION]
    built :: succeeded(run_vader(argv, RunOptions { .env = env })) else panic(built.message())
    return built.stdout
}

// The environment that keeps the check of a proven access.
VERIFY_BOUNDS: [string, string | null][]: [["VADER_VERIFY_BOUNDS", "1"]]

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_the_optimisation_report_totals_the_verdicts_and_lists_each_certain_fault :: fn() -> void {
    options :: RunOptions { .env = [["VADER_OPT_REPORT", "1"]] }
    dumped :: succeeded(run_vader(["dump", "--stage=ranges", VERDICTS], options))
        else panic(dumped.message())
    for said in [
        "[VADER_OPT_REPORT] range analysis",
        "x + \$k_3 in verdicts\$always_overflows",
        "xs[i] in verdicts\$negative_index",
        "without call summaries:",
        "functions may shorten an array",
    ] {
        assert(said in dumped.stderr, "`${said}` in ${dumped.stderr}")
    }
}

@test
test_a_release_build_drops_the_index_check_of_a_proven_access_only :: fn() -> void {
    c :: native_c(["--release"])
    assert_eq(checks_in(c, "proven_access"), "")
    assert_eq(checks_in(c, "unproven_access"), "VADER_ARRAY_CHECK_INDEX")
    assert_eq(
        checks_in(c, "proven_by_an_access"),
        "VADER_ARRAY_CHECK_INDEX VADER_ARRAY_CHECK_INDEX",
    )
}

@test
test_a_debug_build_keeps_the_check_of_an_access_the_analysis_proves :: fn() -> void {
    c :: native_c([])
    assert_eq(checks_in(c, "proven_access"), "VADER_ARRAY_CHECK_INDEX")
    assert_eq(checks_in(c, "unproven_access"), "VADER_ARRAY_CHECK_INDEX")
}

@test
test_verify_bounds_keeps_the_check_of_a_proven_access_under_a_message_of_its_own :: fn() -> void {
    modes: string[][]: [[], ["--release"]]
    for flags in modes {
        c :: native_c(flags, VERIFY_BOUNDS)
        assert_eq(checks_in(c, "proven_access"), "VADER_ARRAY_CHECK_PROVEN")
        assert_eq(checks_in(c, "unproven_access"), "VADER_ARRAY_CHECK_INDEX")
    }
    // The path of the C stage of the dump.
    options :: RunOptions { .env = VERIFY_BOUNDS }
    dumped :: succeeded(run_vader(["dump", "--stage=c", ELISION], options))
        else panic(dumped.message())
    assert_eq(checks_in(dumped.stdout, "proven_access"), "VADER_ARRAY_CHECK_PROVEN")
}
