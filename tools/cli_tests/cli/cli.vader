// tools/cli_tests/cli/cli: the `vader` command, as a test of the repository runs
// it.
//
// A test of the command line, and a stage of the test runner that drives it, run
// the `vader` the repository builds (`build/vader`), from the root of the
// repository. The command sees the environment of the process that runs the
// test, but for `VADER_HOME`: it outranks every other way the command finds its
// library, so one exported in a shell would run the tests against another `lib/`.
// A test that wants one names it (`toolchain_home`).

module "tools/cli_tests/cli"

import "std/abort"
import "std/env"
import "std/fs"
import "std/io"
import "std/path"
import "std/process"
import "std/string"
import "std/target"
import "std/task"
import "std/time"

/// How a test runs a command.
export RunOptions :: struct {
    /// The working directory of the command; the test's when null.
    cwd: string | null = null
    /// Changes to its environment, made once `VADER_HOME` is left out.
    env: [string, string | null][] = []
    /// What it reads on its stdin, which is closed after; nothing when null.
    stdin: string | null = null
    /// A line its stdin holds once its stdout shows a cue, which a program that
    /// waits for its input at a given point needs; null for none.
    feed: Feed | null = null
    /// How long the test waits for it before it kills it.
    timeout: Duration = DEFAULT_TIMEOUT
}

/// A line a command reads on its stdin, written once its stdout holds `cue`:
/// what it printed then is what it did before it waited for the line.
export Feed :: struct {
    cue: string
    line: string
}

/// The wait for a command, by default: a check or a build of a small program.
export DEFAULT_TIMEOUT :: 30.seconds()

/// The wait for a command that builds a large program, the compiler included.
export LONG_TIMEOUT :: 120.seconds()

/// The wait for a driven build, which compiles its driver first.
export HEAVY_TIMEOUT :: 600.seconds()

// Where the command finds its library when nothing else says.
HOME_VARIABLE :: "VADER_HOME"

/// The `vader` the repository builds, absolute: a command that runs in another
/// folder finds it all the same.
export vader_binary :: fn() -> string = "${toolchain_home()}/${executable_path("build/vader")}"

/// The root of the repository, the toolchain a test points `VADER_HOME` at when
/// it builds a project outside it.
export toolchain_home :: fn() -> string = current_working_directory()

/// The change to the environment of a command that points it at the toolchain
/// of the repository: what a project outside it builds against.
export toolchain_env :: fn() -> [string, string | null][] = [[HOME_VARIABLE, toolchain_home()]]

/// The path of the executable a linker writes for `base`: `.exe` on Windows.
///
/// @param base  the path without the suffix.
@target
export executable_path :: fn(base: string) -> string = base

@target(.Windows)
executable_path :: fn(base: string) -> string = "${base}.exe"

/// Run `vader` with `args`.
///
/// @param args     what follows `vader` on its command line.
/// @param options  where it runs, what it reads and how long it may take.
/// @return         what it wrote and its exit code.
/// @error          `ProcessError` when it cannot be launched, a signal ends it
///                 or it outlives `options.timeout`.
export run_vader :: fn(
    args: string[],
    options: RunOptions = RunOptions {},
) -> ProcessResult | ProcessError = run_command([vader_binary()] + args, options)

/// Run `vader` with `args` in `dir`, against the toolchain of the repository
/// (`toolchain_env`), as a project outside it is built; a command that cannot be
/// run fails the test.
///
/// @param dir      the working directory of the command.
/// @param args     what follows `vader` on its command line.
/// @param env      changes to its environment, on top of `toolchain_env`.
/// @param timeout  how long the test waits for it.
/// @return         what it wrote and its exit code.
export vader_in :: fn(
    dir: string,
    args: string[],
    env: [string, string | null][] = [],
    timeout: Duration = DEFAULT_TIMEOUT,
) -> ProcessResult {
    options :: RunOptions {
        .cwd = dir,
        .env = toolchain_env() + env,
        .timeout = timeout,
    }
    ran :: run_vader(args, options) else panic(ran.message())
    return ran
}

/// Start `vader` with `args` as a child the test writes to and reads from as it
/// goes: a server of the toolchain.
///
/// @param args     what follows `vader` on its command line.
/// @param options  where it runs and the changes to its environment; its
///                 `stdin`, `feed` and `timeout` are the test's to handle.
/// @error          `ProcessError` when it cannot be launched.
export spawn_vader :: fn(
    args: string[],
    options: RunOptions = RunOptions {},
) -> ChildProcess | ProcessError = spawn_command([vader_binary()] + args, options)

// Start `argv` where `options` says, its environment without `VADER_HOME` but
// for the changes of `options`.
spawn_command :: fn(argv: string[], options: RunOptions) -> ChildProcess | ProcessError {
    changes: [string, string | null][]: [[HOME_VARIABLE, null]]
    spawned :: SpawnOptions { .cwd = options.cwd, .env = changes + options.env }
    return spawn_interactive(argv, spawned)
}

/// Run the command `argv`, a program the test built or one of the system.
///
/// @param argv     the command line, the program first.
/// @param options  where it runs, what it reads and how long it may take.
/// @return         what it wrote and its exit code.
/// @error          `ProcessError` when it cannot be launched, a signal ends it
///                 or it outlives `options.timeout`.
export run_command :: fn(
    argv: string[],
    options: RunOptions = RunOptions {},
) -> ProcessResult | ProcessError {
    child :: spawn_command(argv, options) else return child
    defer child.kill()
    input :: options.stdin
    if input != null {
        child.write_input(input.bytes())
    }
    feed :: options.feed
    if feed == null {
        child.close_input()
    }
    ended :: launch(() -> fed_and_waited(child, feed)).timeout(options.timeout)
    if ended is ProcessResult || ended is ProcessError {
        return ended
    }
    return ProcessError { .msg = "`${argv[0]}`: gave up after ${options.timeout.format()}" }
}

// Wait for `child` to end, writing the line of `feed` to its stdin, then closing
// it, once its stdout holds the cue.
fed_and_waited :: fn(child: ChildProcess, feed: Feed | null) -> ProcessResult | ProcessError {
    if feed == null {
        return child.wait()
    }
    out: u8[]: []
    err: u8[]: []
    for feed.cue !in out.bytes_to_string() {
        taken :: child.read_output()
        out.push_all(taken.out)
        err.push_all(taken.err)
        if taken.ended {
            break
        }
    }
    child.write_input(feed.line.bytes())
    child.close_input()
    ended :: child.wait()
    // What `read_output` took is no longer in what the wait answers.
    before :: out.bytes_to_string()
    errors :: err.bytes_to_string()
    if ended is ProcessError {
        return ProcessError {
            ...ended,
            .stdout = before + ended.stdout,
            .stderr = errors + ended.stderr,
        }
    }
    return ProcessResult {
        ...ended,
        .stdout = before + ended.stdout,
        .stderr = errors + ended.stderr,
    }
}

/// The run of a command that exited with 0; an error otherwise.
///
/// @param ran  what `run_command` or `run_vader` answered.
/// @error      `ProcessError` when the command did not run to its end, or when
///             it exited with another code, its stderr in the message.
export succeeded :: fn(ran: ProcessResult | ProcessError) -> ProcessResult | ProcessError {
    if ran is ProcessResult && ran.exit != 0 {
        return ProcessError {
            .msg = "exited with ${ran.exit}:\n${ran.stderr}",
            .stdout = ran.stdout,
            .stderr = ran.stderr,
        }
    }
    return ran
}

/// A fresh, empty folder for a test, under the temporary folder: what a run
/// before left there is removed first.
///
/// @param name  tells the folder apart from those of the other tests.
export scratch_dir :: fn(name: string) -> string {
    dir :: "${temp_dir()}/vader_cli_${name}"
    remove(dir, RemoveOptions { .recursive = true, .force = true })
    create_dir(dir)
    return dir
}

/// Copy the folder `from` to `to`, without the `build/` a command run in `from`
/// would have left there: what runs on the copy starts from the sources alone.
///
/// @param from  the folder copied, a fixture.
/// @param to    where the copy goes, a path that does not exist yet.
/// @error       `IOError` when a file cannot be copied.
export copy_sources :: fn(from: string, to: string) -> null | IOError {
    copied :: copy_tree(from, to) else is IOError { return copied }
    return remove("${to}/build", RemoveOptions { .recursive = true, .force = true })
}

/// A copy of the folder `from` in a fresh folder for a test (`copy_sources`). A
/// copy that fails fails the test.
///
/// @param from  the folder copied, a fixture.
/// @param name  tells the folder apart from those of the other tests.
/// @return      the copy.
export staged_copy :: fn(from: string, name: string) -> string {
    dir :: "${scratch_dir(name)}/${Path(from).filename()}"
    copied :: copy_sources(from, dir) else is Error { panic(copied.message()) }
    return dir
}

/// What a program wrote, and how it ended.
export Ran :: struct {
    stdout: string
    stderr: string
    /// Its exit code; null when a signal ended it.
    exit: i32 | null
}

/// What a run did: a signal that ended it rides in a `ProcessError`, with what
/// it wrote.
///
/// @param ran  what `run_command` or `run_vader` answered.
export ran_of :: fn(ran: ProcessResult | ProcessError) -> Ran {
    if ran is ProcessResult {
        return Ran {
            .stdout = ran.stdout,
            .stderr = ran.stderr,
            .exit = ran.exit,
        }
    }
    return Ran {
        .stdout = ran.stdout,
        .stderr = ran.stderr,
        .exit = null,
    }
}

/// Build `source` with `flags` into a fresh folder `name`, the binary named
/// after it.
///
/// @param name    tells the folder apart from those of the other tests.
/// @param flags   what `vader build` takes before the source.
/// @param source  the program built.
/// @return        the path of the binary.
/// @error         `ProcessError` when the build fails, its stderr in the message.
export build_binary :: fn(name: string, flags: string[], source: string) -> string | ProcessError {
    binary :: executable_path("${scratch_dir(name)}/${name}")
    argv :: ["build"] + flags + ["--out=${binary}", source]
    built :: succeeded(run_vader(argv, RunOptions { .timeout = LONG_TIMEOUT }))
        else return built
    return binary
}

/// A fresh folder whose `lib/` holds `std/` and `system/`, copied from the
/// repository, beside the namespace `namespace`, whose one file holds `source`:
/// a library root of its own, which a command run in the folder searches. A
/// copy that fails fails the test.
///
/// @param name       tells the folder apart from those of the other tests.
/// @param namespace  the namespace staged beside the copies.
/// @param source     the text of `lib/<namespace>/<namespace>.vader`.
/// @return           the folder.
export staged_library_root :: fn(name: string, namespace: string, source: string) -> string {
    dir :: scratch_dir(name)
    create_dir("${dir}/lib/${namespace}")
    write_file("${dir}/lib/${namespace}/${namespace}.vader", source)
    for copied in ["std", "system"] {
        tree :: copy_tree("lib/${copied}", "${dir}/lib/${copied}") else is Error {
            panic(tree.message())
        }
    }
    return dir
}

/// The `main.vader` of a fresh folder for a test, holding `source`.
///
/// @param name  tells the folder apart from those of the other tests.
export scratch_source :: fn(name: string, source: string) -> string {
    file :: "${scratch_dir(name)}/main.vader"
    write_file(file, source)
    return file
}

/// The folder of this host in the `lib/` of a library that ships archives:
/// `<os>-<arch>`, as `darwin-arm64`.
export host_folder :: fn() -> string = "${current_os()}-${current_arch()}"

/// A platform other than this host's, whose executables a native build here
/// cannot run.
export other_platform :: fn() -> string {
    if current_os() == .Windows {
        return "linux-x86_64"
    }
    return "windows-x86_64"
}

// ---- what the command is given --------------------------------------------

/// The entry of the compiler, the broadest program of the tree: every lowering,
/// every kind of generic, and a body for each target.
export COMPILER_ENTRY :: "vader/tools/cli/main.vader"

/// The folder of the examples the repository ships, one folder each.
export EXAMPLES :: "examples"

/// What a command is given to work on the example `name`: its folder when a
/// `vader.json` makes it a project, its entry otherwise.
export example_input :: fn(name: string) -> string {
    dir :: "${EXAMPLES}/${name}"
    if exists("${dir}/vader.json") {
        return dir
    }
    return "${dir}/${name}.vader"
}

/// The C compiler a native build runs on this host, as `vader build` picks it: a
/// non-empty `CC`, else `gcc` on Windows and `cc` elsewhere.
///
/// The rule is `default_cc` of `vader/pipeline`, not imported from there: the
/// import would compile the compiler into every test of the command line.
export host_cc :: fn() -> string {
    named :: get_env("CC") else ""
    if named != "" {
        return named
    }
    return default_host_cc()
}

@target
default_host_cc :: fn() -> string = "cc"

@target(.Windows)
default_host_cc :: fn() -> string = "gcc"

/// Whether the C compiler of this host runs: a test of a native build has
/// nothing to check without one.
export has_cc :: fn() -> bool {
    probed :: run_command([host_cc(), "--version"])
    return probed is ProcessResult && probed.exit == 0
}

// How `build/vader` is built from the sources.
REBUILD :: "build it with `bash bootstrap/build.sh`"

// The folders `vader` is built from.
SOURCES: string[]: ["vader", "lib"]

/// Why `vader` cannot be run as the repository's: it is missing, or older than
/// one of its sources; null when it can.
export stale_vader :: fn() -> string | null {
    if !exists(vader_binary()) {
        return "`build/vader` is missing: ${REBUILD}"
    }
    newer :: newer_source(vader_binary(), SOURCES) else return null
    return "`build/vader` is older than `${newer}`: ${REBUILD}"
}

/// The first `.vader` file under `roots` modified after the file at `binary`.
///
/// @param binary  a program built from what `roots` hold.
/// @param roots   the folders it is built from, those of them that exist.
/// @return        the path of that file; null when none is newer, or when
///                `binary` cannot be read.
export newer_source :: fn(binary: string, roots: string[]) -> string | null {
    built :: modification_time(binary) else return null
    for root in roots {
        walker :: walk(root) else continue
        for entry in walker {
            if !entry.name.ends_with(".vader") {
                continue
            }
            changed :: modification_time(entry.path)
            if changed is i64 && changed > built {
                return entry.path
            }
        }
    }
    return null
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_the_vader_of_the_repository_is_found_from_any_folder :: fn() -> void {
    assert(vader_binary().ends_with(executable_path("/build/vader")), "the path of the build")
    assert(vader_binary().starts_with(toolchain_home()), "an absolute path")
}

@test
test_a_command_reads_what_it_is_given_and_reports_its_exit :: fn() -> void {
    // `sort` of Windows reads lines that end with CRLF.
    ran :: run_command(["sort"], RunOptions { .stdin = "b\r\na\r\n" }) else {
        fail(ran.msg)
        return
    }
    assert_eq(ran.stdout.replace_all("\r", ""), "a\nb\n")
    assert_eq(ran.exit, 0)
}

@test
test_a_ci_host_has_a_c_compiler :: fn() -> void {
    // Without one, the tests of a native build check nothing, and pass.
    if get_env("CI") == null {
        return
    }
    assert(has_cc(), "`${host_cc()}` runs on this host")
}

@test
test_a_failed_command_is_an_error_saying_its_exit :: fn() -> void {
    failed :: succeeded(ProcessResult { .exit = 3, .stdout = "", .stderr = "no" })
    assert(failed is ProcessError && failed.msg == "exited with 3:\nno", "the exit and the stderr")
}

@test
test_a_command_that_outlives_its_timeout_is_given_up :: fn() -> void {
    waits :: RunOptions { .timeout = 200.millis() }
    ran :: run_command(sleep_command(), waits)
    assert(ran is ProcessError && "gave up" in ran.msg, "a command given up")
}

// A command that runs for longer than a test waits.
@target
sleep_command :: fn() -> string[] = ["sleep", "5"]

@target(.Windows)
sleep_command :: fn() -> string[] = ["ping", "-n", "6", "127.0.0.1"]
