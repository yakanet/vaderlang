// tools/cli_tests/build_run/build_run: `vader build --run` builds, then runs the
// program on the command's own standard streams, hands it what follows the path,
// and exits with its code; a build for another platform asks for its C
// compiler, and one for WASM writes the module itself.
//
// The test reads the streams through pipes: what it reads is what the program
// wrote to the streams it inherited from the command. The builds of a project
// folder are tested with the other project commands.

module "tools/cli_tests/build_run"

import "std/fs"
import "std/path"
import "std/string"
import "tools/cli_tests/cli"

// A program that prints `says`, each of its arguments on a line, a line on its
// stderr, and exits with `code`.
program :: fn(says: string, code: i32) -> string = """
    module "main"

    import "std/console"

    main :: fn(argv: string[]) -> i32 {
        println("${says}")
        for i in 1..<argv.len() {
            println(argv[i])
        }
        eprintln("${says} on stderr")
        return ${code}
    }
    """

// A program that does not type-check.
ILL_TYPED :: "module \"main\"\n\nmain :: fn() -> i32 {\n    return \"no\"\n}\n"

// A program whose interceptor's wrapper does not type-check: the wrapper hands
// `Opaque`, which has no `Display`, to `logged`.
INTERCEPTED_ILL_TYPED :: """
    module "main"

    import "std/console"

    Log :: struct<A, R> {}

    @interceptor(around = logged)
    Logged :: decorator(.Function) {}

    logged :: fn<A, R: Display>(state: Log<A, R>, site: Site<Logged>, args: A, proceed: fn(A) -> R) -> R {
        result :: proceed(args)
        println("\${result}")
        return result
    }

    Opaque :: struct {
        x: i32
    }

    @Logged
    make :: fn(x: i32) -> Opaque = Opaque { .x = x }

    main :: fn() -> i32 = make(1).x
    """

// A fresh folder named after `name`, holding `source` as its `main.vader`.
staged :: fn(name: string, source: string) -> string {
    dir :: scratch_dir("build_run_${name}")
    assert_succeeds(write_file("${dir}/main.vader", source))
    return dir
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_a_file_built_runs_with_what_follows_its_path_and_exits_with_its_code :: fn() -> void {
    if !has_cc() {
        return
    }
    dir :: staged("arguments", program("app", 7))
    ran :: vader_in(dir, ["build", "--run", "main.vader", "--verbose", "two words"])
    assert_eq(ran.stdout, "app\n--verbose\ntwo words\n")
    assert("app on stderr" in ran.stderr, ran.stderr)
    assert_eq(ran.exit, 7)
}

@test
test_a_build_says_how_long_it_took_and_verbose_how_long_each_step :: fn() -> void {
    if !has_cc() {
        return
    }
    dir :: staged("timings", program("app", 0))
    quiet :: vader_in(dir, ["build", "main.vader"])
    assert("vader build: built `main` (debug) in " in quiet.stderr, quiet.stderr)
    assert("front end" !in quiet.stderr, quiet.stderr)
    verbose :: vader_in(dir, ["build", "--verbose", "main.vader"])
    for step in ["front end ", "lowering ", "C ", " units", "cc ", " objects on ", "link "] {
        assert(step in verbose.stderr, verbose.stderr)
    }
    assert_eq(verbose.exit, 0)
}

@test
test_a_build_that_fails_runs_nothing :: fn() -> void {
    ran :: vader_in(staged("failed", ILL_TYPED), ["build", "--run", "main.vader"])
    assert_eq(ran.stdout, "")
    assert("error[" in ran.stderr, ran.stderr)
    assert_eq(ran.exit, 1)
}

@test
test_an_error_in_the_code_the_compiler_wrote_names_where_it_is_and_what_asked_for_it :: fn() -> void {
    dir :: staged("expanded", INTERCEPTED_ILL_TYPED)
    ran :: vader_in(dir, ["build", "main.vader"])
    assert_eq(ran.exit, 1)
    written :: "build/expanded/intercept/main.vader"
    assert("[${written.to_native()}:" in ran.stderr, ran.stderr)
    assert("main.vader:21:1] the code `@Logged` writes for `make`" in ran.stderr, ran.stderr)
    wrapper :: read_file_string("${dir}/${written}") else ""
    assert("make :: fn(x: i32) -> Opaque" in wrapper, wrapper)
}

@test
test_a_build_removes_the_code_it_no_longer_writes_and_nothing_else :: fn() -> void {
    dir :: staged("stale", INTERCEPTED_ILL_TYPED)
    vader_in(dir, ["build", "main.vader"])
    wrapper :: "${dir}/build/expanded/intercept/main.vader"
    assert(exists(wrapper), "the build writes the wrapper")
    // Under a name the build owns, but not written by the compiler.
    kept :: "${dir}/build/expanded/other/main.vader"
    assert_succeeds(create_dir("${dir}/build/expanded/other"))
    assert_succeeds(write_file(kept, "// mine\n"))
    assert_succeeds(
        write_file("${dir}/main.vader", INTERCEPTED_ILL_TYPED.replace_all("@Logged\n", "")),
    )
    vader_in(dir, ["build", "main.vader"])
    assert(!exists(wrapper), "the wrapper no longer written is removed")
    assert(!exists("${dir}/build/expanded/intercept"), "its emptied folder too")
    assert(exists(kept), "a file the compiler did not write stays")
}

@test
test_expand_prints_the_code_the_compiler_writes_even_when_it_does_not_check :: fn() -> void {
    dir :: staged("expand", INTERCEPTED_ILL_TYPED)
    ran :: vader_in(dir, ["expand", "main.vader"])
    assert_eq(ran.exit, 0)
    assert(ran.stdout.starts_with("// build/expanded/intercept/main.vader\n// Generated by vader"), ran.stdout)
    assert("make :: fn(x: i32) -> Opaque" in ran.stdout, ran.stdout)
}

@test
test_an_executable_for_another_platform_needs_a_c_compiler_for_it :: fn() -> void {
    // `CC` emptied: a host that exports one, as the CI of Windows does, would
    // pass the check.
    dir :: staged("cross", program("app", 0))
    no_cc: [string, string | null][]: [["CC", ""]]
    cross :: vader_in(dir, ["build", "--target=${other_platform()}", "main.vader"], no_cc)
    assert(cross.exit == 2, "`${other_platform()}` exits with 2: ${cross.stderr}")
    said :: "name a compiler for `${other_platform()}` with `--cc`"
    assert(said in cross.stderr, cross.stderr)
    // The C needs no compiler, whatever the target.
    argv :: [
        "build",
        "--emit=c",
        "--target=${other_platform()}",
        "--out=${dir}/main.c",
        "main.vader",
    ]
    emitted :: vader_in(dir, argv, no_cc)
    assert(emitted.exit == 0, emitted.stderr)
}

// A WASM executable is a module the compiler writes itself (ADR 0175).
@test
test_an_executable_for_wasm_is_a_component_that_needs_no_c_compiler :: fn() -> void {
    dir :: staged(
        "wasm",
        """
        module "main"

        main :: fn() -> i32 {
            return 42
        }
        """,
    )
    no_cc: [string, string | null][]: [["CC", ""]]
    argv :: ["build", "--target=wasi-wasm32", "--out=${dir}/main.wasm", "main.vader"]
    built :: vader_in(dir, argv, no_cc)
    assert(built.exit == 0, built.stderr)
    bytes :: read_file_bytes("${dir}/main.wasm") else {
        fail("no component written: ${bytes.message()}")
        return
    }
    // The magic, then the version and the layer of a component.
    assert(
        bytes.len() > 8 && bytes[1] == 'a' && bytes[2] == 's' && bytes[3] == 'm' && bytes[4] == 0x0D
            && bytes[6] == 0x01,
        "a WASM component",
    )
}

// A function of an imported WIT interface takes its type from the interface: a
// `list<string>` the Vader signature alone would not say.
@test
test_a_wasm_build_calls_a_function_of_an_imported_interface :: fn() -> void {
    dir :: staged(
        "wasm_interface",
        """
        module "main"

        Env :: import "wasi:cli/environment@0.3.0"

        main :: fn() -> i32 {
            return i32(Env.get_arguments().len())
        }
        """,
    )
    no_cc: [string, string | null][]: [["CC", ""]]
    argv :: ["build", "--target=wasi-wasm32", "--out=${dir}/main.wasm", "main.vader"]
    built :: vader_in(dir, argv, no_cc)
    assert(built.exit == 0, built.stderr)
}

// Two interfaces may each declare a function of one name: each keeps its own type,
// a `u64` here, where the `now` of `system-clock` returns a record. Of the modules
// of the interfaces, `build/expanded/` holds those whose functions the program
// calls.
@test
test_a_wasm_build_keeps_apart_two_functions_of_one_name :: fn() -> void {
    dir :: staged(
        "wasm_interfaces_one_name",
        """
        module "main"

        Clock :: import "wasi:clocks/monotonic-clock@0.3.0"
        Wall :: import "wasi:clocks/system-clock@0.3.0"

        main :: fn() -> i32 {
            start :: Wall.Instant { .seconds = 0, .nanoseconds = 0 }
            return i32(Clock.now() % 2) + i32(start.nanoseconds)
        }
        """,
    )
    no_cc: [string, string | null][]: [["CC", ""]]
    argv :: ["build", "--target=wasi-wasm32", "--out=${dir}/main.wasm", "main.vader"]
    built :: vader_in(dir, argv, no_cc)
    assert(built.exit == 0, built.stderr)
    copies :: "${dir}/build/expanded/wit/wasi_0clocks"
    assert(exists("${copies}/monotonic-clock@0.3.0.vader"), "the module of a called interface")
    assert(!exists("${copies}/system-clock@0.3.0.vader"), "no module whose functions go uncalled")
}

// `--run` runs a `wasi-wasm32` build under wasmtime: the arguments reach the
// program, and a failed run is the host's exit code, 1.
@test
test_run_runs_a_wasm_build_under_wasmtime :: fn() -> void {
    if !has_wasmtime() {
        return
    }
    dir :: staged(
        "wasm_run",
        """
        module "main"

        import "std/console"

        main :: fn(args: string[]) -> i32 {
            println(args[1])
            return i32(args.len()) - 2
        }
        """,
    )
    no_cc: [string, string | null][]: [["CC", ""]]
    once :: vader_in(dir, ["build", "--target=wasi-wasm32", "--run", "main.vader", "hello"], no_cc)
    assert_eq(once.exit, 0)
    assert_eq(once.stdout, "hello\n")
    twice :: vader_in(
        dir,
        ["build", "--target=wasi-wasm32", "--run", "main.vader", "a", "b"],
        no_cc,
    )
    assert_eq(twice.exit, 1)
    assert_eq(twice.stdout, "a\n")
}

@test
test_run_refuses_a_build_that_makes_no_program_for_this_host :: fn() -> void {
    dir :: staged("nothing_to_run", program("app", 0))
    c :: vader_in(dir, ["build", "--run", "--emit=c", "main.vader"])
    assert_eq(c.exit, 2)
    assert("`--emit=c` produces no program to run" in c.stderr, c.stderr)
    cross :: vader_in(dir, ["build", "--run", "--target=${other_platform()}", "main.vader"])
    assert_eq(cross.exit, 2)
    said :: "a program built for `${other_platform()}` does not run on this"
    assert(said in cross.stderr, cross.stderr)
}
