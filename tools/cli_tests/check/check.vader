// tools/cli_tests/check/check: `vader check`, what makes up for the selection of
// a target at compile time.
//
// A body whose `@target` does not match is never resolved nor typed, so on one
// machine the code of every other platform goes unchecked. `check` closes that
// gap without a toolchain: these tests type-check Windows code from whatever
// machine runs them.

module "tools/cli_tests/check"

import "std/option"
import "std/string"
import "tools/cli_tests/cli"

// A program whose body for Windows does not type-check.
BROKEN_ON_WINDOWS :: "tests/fixtures/target/discarded_body_not_typed/main.vader"

// A program that reads `VADER_OS`, a value a file reaches with no import.
BAKED_CONSTANT :: "tests/fixtures/target/baked_constant/main.vader"

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_check_reports_an_error_in_the_body_of_another_target :: fn() -> void {
    checked :: run_vader(["check", "--target=windows-x86_64", BROKEN_ON_WINDOWS]).unwrap()
    assert_eq(checked.exit, 1)
    assert("T3020" in checked.stderr, checked.stderr)
    assert("main-windows.vader" in checked.stderr, checked.stderr)
}

@test
test_check_is_silent_and_succeeds_for_a_target_whose_bodies_are_sound :: fn() -> void {
    checked :: run_vader(["check", "--target=darwin-arm64", BROKEN_ON_WINDOWS]).unwrap()
    assert_eq(checked.exit, 0)
    // A script reads a gate before a person does.
    assert_eq(checked.stdout.trim(), "")
}

@test
test_check_refuses_a_malformed_target_and_names_the_fragment :: fn() -> void {
    checked :: run_vader(["check", "--target=drawin-arm64", BROKEN_ON_WINDOWS]).unwrap()
    assert_eq(checked.exit, 2)
    assert("drawin" in checked.stderr, checked.stderr)
}

@test
test_vader_os_resolves_and_folds_under_a_target_given :: fn() -> void {
    for target in ["windows-x86_64", "darwin-arm64"] {
        checked :: run_vader(["check", "--target=${target}", BAKED_CONSTANT]).unwrap()
        assert(checked.exit == 0, "`${target}`: ${checked.stderr}")
    }
}

@test
test_vader_os_is_baked_from_the_host_with_no_target_given :: fn() -> void {
    checked :: run_vader(["check", BAKED_CONSTANT]).unwrap()
    assert_eq(checked.exit, 0)
    assert_eq(checked.stderr.trim(), "")
}

@test
test_the_compiler_checks_clean_for_every_os :: fn() -> void {
    // A Windows body broken on a Mac would otherwise show only on Windows. An
    // `Arch` selects no code, so one target per OS reaches every body.
    for target in ["windows-x86_64", "linux-x86_64", "darwin-arm64"] {
        argv :: ["check", "--target=${target}", COMPILER_ENTRY]
        checked :: run_vader(argv, RunOptions { .timeout = LONG_TIMEOUT }).unwrap()
        assert(checked.exit == 0 && checked.stderr == "", "`${target}`: ${checked.stderr}")
    }
}

@test
test_a_file_with_no_module_declaration_is_told_which_line_to_add :: fn() -> void {
    // The loader reports both, before anything resolves `std/...`: R2020 names
    // the cause, R2001 says what to write. No `vader dump` shows them, so no
    // diagnostics fixture pins them.
    entry :: scratch_source(
        "check_no_module",
        "import \"std/io\"\n\nmain :: fn() -> i32 {\n    return 0\n}\n",
    )
    checked :: run_vader(["check", entry]).unwrap()
    assert_eq(checked.exit, 1)
    assert("R2020" in checked.stderr && "R2001" in checked.stderr, checked.stderr)
    assert("module \"main\"" in checked.stderr, checked.stderr)
}
