// tools/cli_tests/lsp/generated_code: an error in code the compiler wrote shows
// on the code that asked for it, and says so; the copy of that code a build
// writes under `build/expanded/` is analysed as that code when opened; and the
// lens that leads from an interceptor to a declaration opens it from the server.

module "tools/cli_tests/lsp"

import "json"
import "std/fs"
import "std/iter"
import "std/string"
import "tools/cli_tests/cli"
import "tools/cli_tests/rpc"

// A program whose interceptor's wrapper does not type-check: the wrapper hands
// `Opaque`, which has no `Display`, to `logged`. `make` is on line 20.
WRAPPED_ILL_TYPED :: """
    module "main"

    import "std/console"

    Log :: struct<A, R> {}

    @interceptor(around = logged)
    Logged :: decorator(.Function) {}

    logged :: fn<A, R: Display>(state: Log<A, R>, site: Site<Logged>, args: A, proceed: fn(A) -> R) -> R {
        result :: proceed(args)
        println("\${result}")
        return result
    }

    Opaque :: struct {
        x: i32
    }

    @Logged
    make :: fn(x: i32) -> Opaque = Opaque { .x = x }

    main :: fn() -> i32 = make(1).x
    """

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_an_error_in_an_interceptor_wrapper_shows_on_the_function_it_wraps :: fn() -> void {
    dir :: project("generated", [["main.vader", WRAPPED_ILL_TYPED]])
    client :: start_client(dir)
    uri :: file_uri("${dir}/main.vader")
    client.send(did_open(uri, WRAPPED_ILL_TYPED))
    found :: coded(diagnostics_of(client, uri), "T3006")
    assert_eq(error_places(found), "T3006@20")
    message :: string_member(found[0], "message") else ""
    assert("in the code `@Logged` writes for `make`" in message, message)
    close_client(client)
}

@test
test_a_copy_of_code_the_compiler_wrote_is_analysed_as_that_code :: fn() -> void {
    dir :: project("expanded_copy", [["main.vader", WRAPPED_ILL_TYPED]])
    assert_succeeds(create_dir("${dir}/build/expanded/intercept"))
    copy :: "${dir}/build/expanded/intercept/main.vader"
    // What an older build wrote: the server writes the code again.
    stale :: "// Generated by vader (intercept) for `./main.vader`: do not edit\nmodule \"main\"\n"
    assert_succeeds(write_file(copy, stale))
    client :: start_client(dir)
    uri :: file_uri(copy)
    client.send(did_open(uri, stale))
    diagnostics_of(client, uri)
    written :: read_file_string(copy) else ""
    assert("make\$\$Layer" in written, written)
    // The editor reads the file again.
    changed :: mark(client)
    document :: """{"uri":${quoted(uri)},"version":2}"""
    params :: """{"textDocument":${document},"contentChanges":[{"text":${quoted(written)}}]}"""
    client.send(notification("textDocument/didChange", params))
    assert_eq(error_places(coded(diagnostics_of(client, uri, changed), "T3006")), "T3006@21")
    // `Log` in `state: Log<i32, Opaque>`.
    position :: r""","position":{"line":4,"character":11}"""
    found :: request(client, "textDocument/definition", on_document(uri, position))
    assert_eq(string_member(found, "uri") else "", file_uri("${dir}/main.vader"))
    assert_eq(int_at(found, ["range", "start", "line"]), 4)
    context :: ",\"context\":{\"includeDeclaration\":false}"
    uses :: request(client, "textDocument/references", on_document(uri, "${position}${context}"))
    in_copy :: array_at(uses, []).filter((u) -> string_member(u, "uri") == uri).collect()
    assert(!in_copy.is_empty(), "a use of `Log` in the copy")
    close_client(client)
}

@test
test_the_command_of_a_lens_that_leads_to_a_declaration_asks_the_client_to_show_it :: fn() -> void {
    dir :: project("go_to", [["main.vader", "module \"main\"\n"]])
    client :: start_client(dir)
    uri :: file_uri("${dir}/main.vader")
    range :: """{"start":{"line":3,"character":0},"end":{"line":3,"character":6}}"""
    arguments :: "[${quoted(uri)},${range}]"
    params :: """{"command":"vader.goTo","arguments":${arguments}}"""
    request(client, "workspace/executeCommand", params)
    shown :: client.awaited(
        (m) -> string_member(m, "method") == "window/showDocument",
        "a request to show the document",
    )
    assert_eq(string_at(shown, ["params", "uri"]) else "", uri)
    assert_eq(int_at(shown, ["params", "selection", "start", "line"]), 3)
    close_client(client)
}

WIT_IMPORT :: """
    module "main"

    Clocks :: import "wasi:clocks/system-clock@0.3.0"

    main :: fn() -> i32 {
        at :: Clocks.Instant { .seconds = 1, .nanoseconds = 2 }
        return at.missing
    }
    """

// The module of an interface the toolchain ships is analysed with the program,
// and a type of it leads to its copy under `build/expanded/`.
@test
test_a_type_of_an_imported_wit_interface_leads_to_its_module :: fn() -> void {
    dir :: project("wit_import", [["main.vader", WIT_IMPORT]])
    client :: start_client(dir)
    uri :: file_uri("${dir}/main.vader")
    client.send(did_open(uri, WIT_IMPORT))
    assert_eq(error_places(diagnostics_of(client, uri)), "T3009@6")
    // `Instant` in `Clocks.Instant { ... }`.
    position :: r""","position":{"line":5,"character":17}"""
    found :: request(client, "textDocument/definition", on_document(uri, position))
    copy :: "${dir}/build/expanded/wit/wasi_0clocks/system-clock@0.3.0.vader"
    assert_eq(string_member(found, "uri") else "", file_uri(copy))
    // The path of the import links to the same copy.
    links :: request(client, "textDocument/documentLink", on_document(uri, ""))
    targets :: array_at(links, []).map((l) -> string_member(l, "target") else "").collect()
    assert_eq(targets.join(" "), file_uri(copy))
    close_client(client)
}
