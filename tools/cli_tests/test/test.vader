// tools/cli_tests/test/test: `vader test --reporter=json`, `--list` and
// `--filter`.
//
// The JSON report is a JSON text sequence (RFC 7464): each event is led by RS and
// ends its line. A test writes to the same stream, so the fixture holds one that
// prints with no newline: a reader cutting on newlines would glue that output to
// the next event.

module "tools/cli_tests/test"

import "json"
import "std/abort"
import "std/fs"
import "std/iter"
import "std/path"
import "std/process"
import "std/string"
import "tools/cli_tests/cli"

// A module holding a test that prints with no newline, and one that fails.
REPORT :: "tests/fixtures/test_cmd/report/report.vader"

// How the report spells the path of `REPORT`: absolute, with `/` on every host.
report_path :: fn() -> string = to_posix("${toolchain_home()}/${REPORT}")

// The filter that keeps each of its tests alone.
PRINTS_FILTER :: "test_cmd_report:report.vader:test_prints"
FAILS_FILTER  :: "test_cmd_report:report.vader:test_fails"

// What leads an event of a JSON text sequence.
RECORD_SEPARATOR :: "\u{1e}"

// What a run of the JSON report wrote: its events, and the output of the tests
// around them.
Sequence :: struct {
    events: JsonValue[]
    output: string
}

// The events of `stdout` and the output around them: what follows an RS up to
// the newline is an event, the rest is output.
read_sequence :: fn(stdout: string) -> Sequence {
    chunks :: stdout.split(RECORD_SEPARATOR)
    read :: Sequence { .events = [], .output = chunks[0] }
    for i in 1..<chunks.len() {
        line :: chunks[i].split_first("\n") else [chunks[i], ""]
        event :: parse(line.0) else panic(event.message())
        read.events.push(event)
        read.output = read.output + line.1
    }
    return read
}

// The `event` of each of `events`.
kinds :: fn(events: JsonValue[]) -> string =
    events.map((event) -> string_member(event, "event") else "?").collect().join(" ")

// The lines `vader test` with `args` printed, which must succeed.
listed :: fn(args: string[], options: RunOptions = RunOptions {}) -> string {
    ran :: succeeded(run_vader(["test"] + args, options)) else panic(ran.message())
    return ran.stdout.trim()
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_the_json_report_gives_each_step_of_a_run_as_an_event :: fn() -> void {
    ran :: run_vader(["test", "--reporter=json", REPORT]) else panic(ran.message())
    assert_eq(ran.exit, 1)
    read :: read_sequence(ran.stdout)
    assert_eq(kinds(read.events), "module start pass start fail summary")
    assert_eq(read.output, "no newline")
    module_event :: read.events[0]
    assert_eq(string_member(module_event, "module") else "", "test_cmd_report")
    assert_eq(string_member(module_event, "path") else "", report_path())
    start :: read.events[1]
    assert_eq(string_member(start, "test") else "", "test_prints")
    assert_eq(string_member(start, "file") else "", report_path())
    assert_eq(number_member(start, "line") else 0.0, 10.0)
    assert_eq(string_member(start, "filter") else "", PRINTS_FILTER)
    failed :: read.events[4]
    assert_eq(string_member(failed, "test") else "", "test_fails")
    assert("boom" in (string_member(failed, "message") else ""), "the message of the failure")
    assert(number_member(failed, "duration_ms") != null, "its duration")
    summary :: read.events[5]
    assert_eq(number_member(summary, "total") else 0.0, 2.0)
    assert_eq(number_member(summary, "pass") else 0.0, 1.0)
    assert_eq(number_member(summary, "fail") else 0.0, 1.0)
}

@test
test_list_names_each_test_as_the_filter_that_keeps_it_alone_and_runs_none :: fn() -> void {
    assert_eq(listed(["--list", REPORT]), "${PRINTS_FILTER}\n${FAILS_FILTER}")
}

@test
test_list_with_the_json_report_gives_the_module_and_its_tests :: fn() -> void {
    ran :: succeeded(run_vader(["test", "--list", "--reporter=json", REPORT]))
        else panic(ran.message())
    read :: read_sequence(ran.stdout)
    assert_eq(read.output, "")
    assert_eq(kinds(read.events), "module test test")
    assert_eq(string_member(read.events[1], "test") else "", "test_prints")
    assert_eq(number_member(read.events[1], "line") else 0.0, 10.0)
    assert_eq(string_member(read.events[2], "test") else "", "test_fails")
    assert_eq(number_member(read.events[2], "line") else 0.0, 15.0)
}

@test
test_a_module_is_tested_without_the_tests_of_the_modules_it_imports :: fn() -> void {
    // The test of `helper` does not compile: it stops the run of `helper`, and
    // is not loaded for the run of `app`.
    dir :: scratch_dir("test_other_modules")
    assert_succeeds(create_dir("${dir}/app"))
    assert_succeeds(create_dir("${dir}/helper"))
    assert_succeeds(write_file("${dir}/vader.json", r"""{"entries": {"app": "app/app.vader"}}"""))
    assert_succeeds(write_file(
        "${dir}/helper/helper.vader",
        r"""
        module "helper"

        export one :: fn() -> i32 = 1

        import "std/testing"

        @test
        test_one :: fn() -> void {
            wrong: i32: "text"
            assert_eq(one(), wrong)
        }
        """,
    ))
    assert_succeeds(write_file(
        "${dir}/app/app.vader",
        r"""
        module "app"

        import "helper"

        main :: fn() -> i32 = one()

        import "std/testing"

        @test
        test_main :: fn() -> void {
            assert_eq(main(), 1)
        }
        """,
    ))
    own :: vader_in(dir, ["test", "app"])
    assert(own.exit == 0 && "1 pass" in own.stdout, own.stdout + own.stderr)
    other :: vader_in(dir, ["test", "helper"])
    assert(other.exit == 1 && "T3001" in other.stdout + other.stderr, other.stdout + other.stderr)
}

@test
test_a_test_is_checked_by_vader_test_alone :: fn() -> void {
    // Every other command loads the module without its tests: neither the error
    // nor an import only they use shows, `std/string` included, which serves
    // through `in` alone.
    dir :: scratch_dir("test_checked_alone")
    assert_succeeds(write_file(
        "${dir}/app.vader",
        r"""
        module "app"

        main :: fn() -> i32 = 0

        import "std/string"
        import "std/testing"

        @test
        test_main :: fn() -> void {
            assert("a" in "abc", "a substring")
            wrong: i32: "text"
            assert_eq(main(), wrong)
        }
        """,
    ))
    checked :: vader_in(dir, ["check", "app.vader"])
    assert(checked.exit == 0 && checked.stderr == "", checked.stdout + checked.stderr)
    tested :: vader_in(dir, ["test", "app.vader"])
    reported :: tested.stdout + tested.stderr
    assert(tested.exit == 1 && "T3001" in reported, reported)
}

@test
test_list_names_the_tests_of_a_module_that_does_not_type_check :: fn() -> void {
    // Listing compiles nothing: the error waits for the run.
    dir :: scratch_dir("test_list_unchecked")
    assert_succeeds(write_file(
        "${dir}/app.vader",
        r"""
        module "app"

        main :: fn() -> i32 = 0

        import "std/testing"

        @test
        test_main :: fn() -> void {
            wrong: i32: "text"
            assert_eq(main(), wrong)
        }
        """,
    ))
    listing :: vader_in(dir, ["test", "--list", "app.vader"])
    assert(listing.exit == 0, listing.stdout + listing.stderr)
    assert_eq(listing.stdout.trim(), "app:app.vader:test_main")
}

@test
test_a_folder_is_tested_within_the_project_above_it :: fn() -> void {
    // Run from inside `app`, which holds no `vader.json`: `helper` is found from
    // the project above.
    dir :: scratch_dir("test_project_above")
    assert_succeeds(create_dir("${dir}/app"))
    assert_succeeds(create_dir("${dir}/helper"))
    assert_succeeds(write_file("${dir}/vader.json", r"""{"entries": {"app": "app/app.vader"}}"""))
    assert_succeeds(
        write_file("${dir}/helper/helper.vader", "module \"helper\"\n\nexport one :: fn() -> i32 = 1\n"),
    )
    assert_succeeds(write_file(
        "${dir}/app/app.vader",
        r"""
        module "app"

        import "helper"

        main :: fn() -> i32 = one()

        import "std/testing"

        @test
        test_main :: fn() -> void {
            assert_eq(main(), 1)
        }
        """,
    ))
    inside :: vader_in("${dir}/app", ["test", "."])
    assert(inside.exit == 0 && "1 pass" in inside.stdout, inside.stdout + inside.stderr)
}

@test
test_filters_repeated_keep_the_tests_one_of_them_keeps :: fn() -> void {
    args :: ["--list", "--filter", "*:*:test_prints", "--filter", "test_fails", REPORT]
    assert_eq(listed(args), "${PRINTS_FILTER}\n${FAILS_FILTER}")
}

@test
test_the_filter_dash_reads_the_filters_from_stdin_one_per_line :: fn() -> void {
    options :: RunOptions { .stdin = "${FAILS_FILTER}\n\n" }
    assert_eq(listed(["--list", "--filter", "-", REPORT], options), FAILS_FILTER)
}
