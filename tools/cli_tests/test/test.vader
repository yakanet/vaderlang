// tools/cli_tests/test/test: `vader test --reporter=json`, `--list` and
// `--filter`.
//
// The JSON report is a JSON text sequence (RFC 7464): each event is led by RS and
// ends its line. A test writes to the same stream, so the fixture holds one that
// prints with no newline: a reader cutting on newlines would glue that output to
// the next event.

module "tools/cli_tests/test"

import "json"
import "std/fs"
import "std/iter"
import "std/option"
import "std/path"
import "std/process"
import "std/string"
import "tools/cli_tests/cli"

// A module holding a test that prints with no newline, and one that fails.
REPORT :: "tests/fixtures/test_cmd/report/report.vader"

// How the report spells the path of `REPORT`: absolute, with `/` on every host.
report_path :: fn() -> string = to_posix("${toolchain_home()}/${REPORT}")

// The filter that keeps each of its tests alone.
PRINTS_FILTER :: "test_cmd_report:report.vader:test_prints"
FAILS_FILTER  :: "test_cmd_report:report.vader:test_fails"

// What leads an event of a JSON text sequence.
RECORD_SEPARATOR :: "\u{1e}"

// What a run of the JSON report wrote: its events, and the output of the tests
// around them.
Sequence :: struct {
    events: JsonValue[]
    output: string
}

// The events of `stdout` and the output around them: what follows an RS up to
// the newline is an event, the rest is output.
read_sequence :: fn(stdout: string) -> Sequence {
    chunks :: stdout.split(RECORD_SEPARATOR)
    read :: Sequence { .events = [], .output = chunks[0] }
    for i in 1..<chunks.len() {
        line :: chunks[i].split_first("\n") ?? [chunks[i], ""]
        read.events.push(parse(line.0).unwrap())
        read.output = read.output + line.1
    }
    return read
}

// The `event` of each of `events`.
kinds :: fn(events: JsonValue[]) -> string =
    events.map((event) -> string_member(event, "event") ?? "?").collect().join(" ")

// The lines `vader test` with `args` printed, which must succeed.
listed :: fn(args: string[], options: RunOptions = RunOptions {}) -> string {
    ran :: succeeded(run_vader(["test"] + args, options)).unwrap()
    return ran.stdout.trim()
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_the_json_report_gives_each_step_of_a_run_as_an_event :: fn() -> void {
    ran :: run_vader(["test", "--reporter=json", REPORT]).unwrap()
    assert_eq(ran.exit, 1)
    read :: read_sequence(ran.stdout)
    assert_eq(kinds(read.events), "module start pass start fail summary")
    assert_eq(read.output, "no newline")
    module_event :: read.events[0]
    assert_eq(string_member(module_event, "module") ?? "", "test_cmd_report")
    assert_eq(string_member(module_event, "path") ?? "", report_path())
    start :: read.events[1]
    assert_eq(string_member(start, "test") ?? "", "test_prints")
    assert_eq(string_member(start, "file") ?? "", report_path())
    assert_eq(number_member(start, "line") ?? 0.0, 10.0)
    assert_eq(string_member(start, "filter") ?? "", PRINTS_FILTER)
    failed :: read.events[4]
    assert_eq(string_member(failed, "test") ?? "", "test_fails")
    assert("boom" in (string_member(failed, "message") ?? ""), "the message of the failure")
    assert(number_member(failed, "duration_ms") != null, "its duration")
    summary :: read.events[5]
    assert_eq(number_member(summary, "total") ?? 0.0, 2.0)
    assert_eq(number_member(summary, "pass") ?? 0.0, 1.0)
    assert_eq(number_member(summary, "fail") ?? 0.0, 1.0)
}

@test
test_list_names_each_test_as_the_filter_that_keeps_it_alone_and_runs_none :: fn() -> void {
    assert_eq(listed(["--list", REPORT]), "${PRINTS_FILTER}\n${FAILS_FILTER}")
}

@test
test_list_with_the_json_report_gives_the_module_and_its_tests :: fn() -> void {
    ran :: succeeded(run_vader(["test", "--list", "--reporter=json", REPORT])).unwrap()
    read :: read_sequence(ran.stdout)
    assert_eq(read.output, "")
    assert_eq(kinds(read.events), "module test test")
    assert_eq(string_member(read.events[1], "test") ?? "", "test_prints")
    assert_eq(number_member(read.events[1], "line") ?? 0.0, 10.0)
    assert_eq(string_member(read.events[2], "test") ?? "", "test_fails")
    assert_eq(number_member(read.events[2], "line") ?? 0.0, 15.0)
}

@test
test_a_module_is_tested_without_the_tests_of_the_modules_it_imports :: fn() -> void {
    // The test of `helper` does not compile: it stops the run of `helper`, and
    // is not loaded for the run of `app`.
    dir :: scratch_dir("test_other_modules")
    create_dir("${dir}/app")
    create_dir("${dir}/helper")
    write_file("${dir}/vader.json", r"""{"entries": {"app": "app/app.vader"}}""")
    write_file(
        "${dir}/helper/helper.vader",
        r"""
        module "helper"

        export one :: fn() -> i32 = 1

        import "std/testing"

        @test
        test_one :: fn() -> void {
            wrong: i32: "text"
            assert_eq(one(), wrong)
        }
        """,
    )
    write_file(
        "${dir}/app/app.vader",
        r"""
        module "app"

        import "helper"

        main :: fn() -> i32 = one()

        import "std/testing"

        @test
        test_main :: fn() -> void {
            assert_eq(main(), 1)
        }
        """,
    )
    own :: vader_in(dir, ["test", "app"])
    assert(own.exit == 0 && "1 pass" in own.stdout, own.stdout + own.stderr)
    other :: vader_in(dir, ["test", "helper"])
    assert(other.exit == 1 && "T3001" in other.stdout + other.stderr, other.stdout + other.stderr)
}

@test
test_filters_repeated_keep_the_tests_one_of_them_keeps :: fn() -> void {
    args :: ["--list", "--filter", "*:*:test_prints", "--filter", "test_fails", REPORT]
    assert_eq(listed(args), "${PRINTS_FILTER}\n${FAILS_FILTER}")
}

@test
test_the_filter_dash_reads_the_filters_from_stdin_one_per_line :: fn() -> void {
    options :: RunOptions { .stdin = "${FAILS_FILTER}\n\n" }
    assert_eq(listed(["--list", "--filter", "-", REPORT], options), FAILS_FILTER)
}
