// tools/codemod/as_alias — the symbol table the `is T as x` migration needs.
//
// Step 3 of `.claude/plans/2026-09-06-as-expression-alias.md`. One-shot ; goes
// away with step 4.
//
// Dropping `as s` means rewriting every `s` in the body to the scrutinee's name,
// and only the resolver knows which `s` those are — a body may declare its own.
// So this prints what only the compiler can know, and the rewriting itself is
// text:
//
//   B <file> <line> <col> <symbol-id> <name>     a narrowing binding's DECL span
//   U <file> <start> <end> <symbol-id>           one use, as a byte range
//
// A `B` line's (line, col) is the span the resolver minted the binding at — the
// TYPE expression of `x is T as s`, and the whole `is T as s` pattern in a match
// arm. That is the join key: find `is … as …` in the source, compute the same
// position, and the symbol falls out. A miss is a site to leave alone, never a
// site to guess at.

module "codemod"

import "std/collections"
import "std/io"
import "std/string_builder"
import "vader/lsp/analysis"
import "vader/resolver/symbol"
import "vader/typecheck"
import "toolchain/span"

main :: fn(args: string[]) -> i32 {
    // args[0] is this program's own path.
    if args.len() < 2 {
        eprintln("usage: as_alias <entry.vader>")
        return 1
    }
    fc :: check_file(args[1], MutableMap<string, string> {}, [], false)
    out :: StringBuilder {}

    seen :: MutableMap<i32, bool> {}
    for [_, typed] in fc.result.all_modules {
        for [_, sym] in typed.resolved.idents {
            if sym.kind != SymbolKind.Binding {
                continue
            }
            if seen[sym.id] != null {
                continue
            }
            seen[sym.id] = true
            at :: sym.defined_at ?? continue
            out.append("B\t${at.start.file}\t${at.start.line}\t${at.start.column}\t${sym.id}\t${sym.name}\n")
        }
    }

    index :: build_reference_index(fc.project, fc.result)
    for s in index.sites {
        out.append("U\t${s.span.start.file}\t${s.span.start.offset}\t${s.span.end.offset}\t${s.symbol_id}\n")
    }
    println(out.to_string())
    return 0
}
