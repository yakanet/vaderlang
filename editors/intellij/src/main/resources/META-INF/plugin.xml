<idea-plugin>
    <id>dev.vaderlang.vader</id>
    <name>Vader</name>
    <vendor email="yakanet@gmail.com" url="https://github.com/vaderlang">vaderlang</vendor>

    <description><![CDATA[
        Syntax highlighting plus full LSP-driven editor features for the
        <a href="https://github.com/vaderlang">Vader</a> programming language.<br>
        TextMate grammar is shared with the official VS Code extension.
        Semantic features — goto-definition, hover with VaderDoc, semantic
        tokens, diagnostics — are delivered by the Vader Language Server,
        spawned via the <code>vader lsp</code> subcommand and wired through
        <a href="https://plugins.jetbrains.com/plugin/23257-lsp4ij">LSP4IJ</a>.
        Works on IntelliJ IDEA Community and Ultimate (as well as every
        other IntelliJ-based IDE that supports LSP4IJ).
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <textmate.bundleProvider implementation="dev.vaderlang.intellij.VaderBundleProvider"/>
        <fileIconProvider implementation="dev.vaderlang.intellij.VaderFileIconProvider"/>
        <configurationType implementation="dev.vaderlang.intellij.VaderRunConfigurationType"/>
        <runConfigurationProducer implementation="dev.vaderlang.intellij.VaderRunConfigurationProducer"/>
        <!-- Green ▶ gutter icon on a top-level `main ::` in a .vader file.
             Was a `runLineMarkerContributor` and never fired: registering it for
             `TEXT` too changed nothing, which left only its `element.text ==
             "main"` test — a `.vader` PSI does not give one leaf per identifier.
             Now a provider using the same recipe as the `(I)` marker below,
             which does fire: read the file text, carry an explicit range. -->
        <codeInsight.lineMarkerProvider language="textmate"
                                        implementationClass="dev.vaderlang.intellij.VaderRunLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="TEXT"
                                        implementationClass="dev.vaderlang.intellij.VaderRunLineMarkerProvider"/>
        <!-- `(I)` gutter icon on a bare `@target` declaration, like Java's
             "is implemented by". CONFIRMED WORKING 2026-08-29. The bodies are
             found by scanning the folder, since a Vader module IS a folder
             (R2022) and every body of a group lives in it. -->
        <codeInsight.lineMarkerProvider language="textmate"
                                        implementationClass="dev.vaderlang.intellij.VaderImplementationLineMarkerProvider"/>
        <!-- AND plain text. Which language a `.vader` file resolves to is not
             answerable outside a running IDE — "no PSI Language registered"
             (see the LSP block below) means it is whatever IntelliJ falls back
             to. Registering both costs one no-op call; guessing wrong costs
             silence, which is how the ▶ above went unnoticed. -->
        <codeInsight.lineMarkerProvider language="TEXT"
                                        implementationClass="dev.vaderlang.intellij.VaderImplementationLineMarkerProvider"/>
        <!-- Ctrl+click on `[path:line:col]` in the Run console. The compiler
             prints paths relative to its working directory, and IntelliJ's
             built-in filters only link absolute ones — so shortening them cost
             navigation until this landed. -->
        <consoleFilterProvider implementation="dev.vaderlang.intellij.VaderConsoleFilterProvider"/>
        <applicationConfigurable
            instance="dev.vaderlang.intellij.VaderConfigurable"
            id="dev.vaderlang.intellij.config"
            displayName="Vader"
            parentId="tools"/>
        <!-- Values for the plugin's own colour keys — see VaderColors.kt for why
             they have to exist at all. -->
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/VaderDarcula.xml"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/VaderDefault.xml"/>
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="dev.vaderlang.vader-lsp"
                name="Vader Language Server"
                factoryClass="dev.vaderlang.intellij.VaderLanguageServerFactory">
            <description><![CDATA[
                LSP server backing the Vader plugin. Spawned via the
                <code>vader lsp</code> subcommand ; binary path is
                configurable under <i>Settings → Tools → Vader</i>.
            ]]></description>
        </server>
        <!-- TextMate-only language — no PSI Language registered, so we
             map by filename glob. `languageId="vader"` is what the
             server receives in `textDocument/didOpen`'s `languageId`
             field ; downstream code uses it for diagnostics filtering
             but the LSP server itself doesn't gate on it today. -->
        <fileNamePatternMapping patterns="*.vader"
                                serverId="dev.vaderlang.vader-lsp"
                                languageId="vader"/>

        <!-- Debug Adapter : `vader dap` (see vader/dap/). LSP4IJ drives the DAP
             client (breakpoints, stepping, variables) ; we only spawn the
             adapter. Users debug via a "Debug Adapter Protocol" run
             configuration selecting this server + a `.vader` file. -->
        <debugAdapterServer id="dev.vaderlang.vader-dap"
                            name="Vader Debug Adapter"
                            factoryClass="dev.vaderlang.intellij.VaderDebugAdapterServerFactory"/>
    </extensions>
</idea-plugin>
