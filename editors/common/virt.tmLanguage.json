{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vader IR (text)",
  "scopeName": "source.virt",
  "fileTypes": [
    "virt"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#fn-header"
    },
    {
      "include": "#type"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#structured"
    },
    {
      "include": "#local"
    },
    {
      "include": "#op"
    },
    {
      "include": "#label"
    },
    {
      "include": "#number"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.virt",
      "match": ";.*$"
    },
    "string": {
      "name": "string.quoted.double.virt",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.virt",
          "match": "\\\\."
        }
      ]
    },
    "fn-header": {
      "match": "^(fn)\\s+([0-9]+)\\s+(\\S+)",
      "captures": {
        "1": {
          "name": "keyword.declaration.function.virt"
        },
        "2": {
          "name": "constant.numeric.index.virt"
        },
        "3": {
          "name": "entity.name.function.virt"
        }
      }
    },
    "type": {
      "match": "^(type)\\s+([0-9]+)\\s+(\\w+)(?:\\s+([A-Za-z_]\\S*))?",
      "captures": {
        "1": {
          "name": "keyword.control.directive.virt"
        },
        "2": {
          "name": "constant.numeric.index.virt"
        },
        "3": {
          "name": "storage.type.virt"
        },
        "4": {
          "name": "entity.name.type.virt"
        }
      }
    },
    "directive": {
      "name": "keyword.control.directive.virt",
      "match": "^(?:module|string|data|import|impl|vtable|export)\\b"
    },
    "structured": {
      "match": "^\\s*(block|loop|if|else|end)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.virt"
        }
      }
    },
    "local": {
      "match": "^\\s*(local)\\s+(\\S+)\\s+(\\S+)",
      "captures": {
        "1": {
          "name": "storage.type.local.virt"
        },
        "2": {
          "name": "variable.other.local.virt"
        },
        "3": {
          "name": "entity.name.type.virt"
        }
      }
    },
    "op": {
      "match": "^\\s+([a-z_][a-z0-9_]*(?:\\.[a-z0-9_]+)*)\\b",
      "captures": {
        "1": {
          "name": "support.function.op.virt"
        }
      }
    },
    "label": {
      "name": "entity.name.label.virt",
      "match": "(?<![\\w$])\\$L[0-9]+\\b"
    },
    "number": {
      "name": "constant.numeric.virt",
      "match": "(?<![\\w$])-?[0-9]+(?:\\.[0-9]+)?\\b"
    }
  }
}
