// std/path — filesystem path manipulation.
//
// Paths are immutable string-backed values. Every operation returns a fresh
// Path rather than mutating. POSIX-style `/` separator only in MVP — Windows
// support deferred (will replace the constant with a runtime-determined value).

module "std/path"

import "std/string" {
    starts_with as str_starts_with, ends_with as str_ends_with,
}
import "std/string_builder"

/// Path separator codepoint. POSIX-only in MVP (`/`).
export SEP :: '/'
/// Path separator as a string — useful for direct concatenation.
export SEP_STR :: "/"

/// Rewrite OS-native path separators to the canonical `/`. The compiler keeps
/// `/` as its single internal separator — module discovery, the module index,
/// and `vader/resolver::join_path` are all `/`-based — so a path entering from
/// an OS boundary that may carry `\` (Windows CLI arguments, env vars) must be
/// funnelled through here first, otherwise `parent` / `filename` (which split
/// on `SEP`) silently return empty. POSIX paths pass through unchanged.
/// @param s  a path string, possibly using `\` separators.
/// @return   the same path with every `\` rewritten to `/`.
export to_posix :: fn(s: string) -> string = s.replace_chars_where((c: char) -> c == '\\', SEP_STR)

/// An immutable filesystem path — a nominal newtype over `string`. Zero-cost:
/// at runtime a `Path` *is* its UTF-8 string, with no wrapper box. Nominal at
/// typecheck so a `Path` never silently mixes with a raw `string` ; every
/// combinator returns a fresh `Path` rather than mutating in place.
export Path :: string

// ---- constructors ---------------------------------------------------------

/// Wrap an existing string as a `Path`. No validation — assumes the caller
/// has produced a syntactically valid path.
/// @param s  the path string.
export to_path :: fn(s: string) -> Path = Path(s)

/// The empty path (`""`). Useful as an identity for `join` / as a default.
export empty_path :: fn() -> Path = Path("")

// ---- accessors ------------------------------------------------------------

/// Return the underlying string representation. Inverse of `to_path`.
export as_string :: fn(self: Path) -> string = string(self)

/// True iff the path starts with the separator (`/foo`). Empty paths are
/// considered NOT absolute.
export is_absolute :: fn(self: Path) -> bool = self.as_string().str_starts_with(SEP_STR)


/// Parent directory — everything before the last separator. Returns the
/// empty path when there's no separator, or `/` when the path is at the
/// filesystem root.
/// @param self  the path receiver.
/// @return      the parent path.
export parent :: fn(self: Path) -> Path {
    s :: string(self)
    idx :: s.last_index_of(SEP, 0)
    if idx < 0 {
        return Path("")
    }
    if idx == 0 {
        // Root: keep the leading "/" so parent of "/foo" is "/".
        return Path(SEP_STR)
    }
    return Path(s.bytes()[0..<usize(idx)].bytes_to_string())
}

/// Last segment (filename or directory name). For a path with no
/// separator, returns the whole path's string.
/// @param self  the path receiver.
/// @return      the filename string (no leading separator).
export filename :: fn(self: Path) -> string {
    s :: string(self)
    idx :: s.last_index_of(SEP, 0)
    if idx < 0 {
        return s
    }
    rb :: s.bytes()
    return rb[usize(idx) + 1..<rb.len()].bytes_to_string()
}

/// The two halves of a filename, as returned by `basename`.
///
/// RETAINED against its own redundancy: `filename()` / `name()` / `extension()`
/// cover every use, and this should have gone with them — but removing it makes
/// `vader test stdlib/std/path` panic in `to_posix`, a function it never touched
/// (`no field replace_chars_where on Path`). Bisected: ADDING the three views is
/// fine, REMOVING this is what breaks, so it is a materialisation bug the removal
/// merely exposes. `tests/vader_e2e.test.ts` runs that isolated mode per stdlib
/// module, so the panic is CI-visible. See TODO.md; delete this once fixed.
export Basename :: struct {
    /// The filename without its final extension — `"archive.tar"`.
    name:      string
    /// The final extension without the leading dot — `"gz"`.
    extension: string
}

/// Both halves of the final segment at once. Prefer `name()` / `extension()`.
/// @param self  the path receiver.
/// @return      `{ name, extension }`, split at the last dot of the filename.
export basename :: fn(self: Path) -> Basename =
    Basename { .name = self.name(), .extension = self.extension() }

// Byte offset of the extension-separating dot inside a FILENAME (never a full
// path), or -1 when there is none. The `min_index` of 1 is the whole subtlety: a
// leading dot marks a hidden file rather than an extension, and it only means
// that at the start of the filename — which is why callers must have narrowed to
// `filename()` first. `last_index_of` returns a BYTE offset, so every caller
// slices `bytes()` and not the codepoint-indexed `s[a..<b]`; mixing the two turns
// `café.vader` into `ader`.
extension_dot :: fn(fname: string) -> isize = fname.last_index_of('.', 1)

/// The final segment without its extension.
///
/// One of three views on the last segment, none of them overlapping:
/// `filename()` gives `toto.zip`, `name()` gives `toto`, `extension()` gives
/// `zip`.
///
/// @param self  the path receiver.
/// @return      the filename with its extension and dot removed, or the filename
///              unchanged when it has no extension — a dotfile keeps its full
///              name (`.gitignore` → `.gitignore`), since its leading dot is not
///              an extension separator.
/// @example
///   "src/archive.tar.gz".to_path().name()  // "archive.tar"
///   "dir/.gitignore".to_path().name()      // ".gitignore"
export name :: fn(self: Path) -> string {
    fname :: self.filename()
    idx :: extension_dot(fname)
    if idx < 0 {
        return fname
    }
    return fname.bytes()[0..<usize(idx)].bytes_to_string()
}

/// The final segment's extension, without the dot.
///
/// One of three views on the last segment, none of them overlapping:
/// `filename()` gives `toto.zip`, `name()` gives `toto`, `extension()` gives
/// `zip`. Kept separate rather than returning both halves at once, so a caller
/// wanting one doesn't pay for the other being built.
///
/// @param self  the path receiver.
/// @return      the extension without its dot, or `""` when the final segment
///              has none — a dotfile and a trailing dot both count as none.
/// @example
///   "src/archive.tar.gz".to_path().extension()  // "gz"
///   "dir/.gitignore".to_path().extension()      // ""
export extension :: fn(self: Path) -> string {
    fname :: self.filename()
    idx :: extension_dot(fname)
    if idx < 0 {
        return ""
    }
    fb :: fname.bytes()
    return fb[usize(idx) + 1..<fb.len()].bytes_to_string()
}

// ---- combinators ----------------------------------------------------------

/// Append a sub-path. Adds a separator between segments unless one is
/// already present. If `other` is absolute (starts with `/`), it
/// REPLACES `self` (Java `Path.resolve` semantics).
/// @param self   the base path.
/// @param other  the segment to append (may itself contain separators).
/// @return       a fresh `Path`.
export join :: fn(self: Path, other: string) -> Path {
    if other.is_empty() {
        return self
    }
    if other[0] == SEP {
        return Path(other)
    }
    s :: string(self)
    if s.is_empty() {
        return Path(other)
    }
    if s[s.bytes().len() - 1] == SEP {
        return Path(s + other)
    }
    return Path(s + SEP_STR + other)
}

// `path / "child"` — operator sugar for `join`. The `/` mirrors the path
// separator and reads naturally when building child paths.
Path implements Div<string> {
    div :: fn(self, other: string) -> Path = self.join(other)
}

// ---- predicates -----------------------------------------------------------

/// True when `self` starts with `prefix` on a segment boundary — so
/// `/foo/bar` starts with `/foo` but `/foobar` does NOT. Useful for
/// "is this under that directory" checks.
/// @param self    the path receiver.
/// @param prefix  the candidate prefix path.
export starts_with :: fn(self: Path, prefix: Path) -> bool {
    s :: string(self)
    pfx :: string(prefix)
    if !s.str_starts_with(pfx) {
        return false
    }
    self_len :: s.bytes().len()
    prefix_len :: pfx.bytes().len()
    if self_len == prefix_len {
        return true
    }
    // Boundary check: next char in self must be a separator, or prefix must
    // itself end on one.
    if !pfx.is_empty() && pfx[prefix_len - 1] == SEP {
        return true
    }
    return s[prefix_len] == SEP
}

/// True when `self` ends with `suffix` on a segment boundary. Same
/// segment-aware rule as `starts_with`.
/// @param self    the path receiver.
/// @param suffix  the candidate suffix path.
export ends_with :: fn(self: Path, suffix: Path) -> bool {
    s :: string(self)
    sfx :: string(suffix)
    if !s.str_ends_with(sfx) {
        return false
    }
    self_len :: s.bytes().len()
    suffix_len :: sfx.bytes().len()
    if self_len == suffix_len {
        return true
    }
    cut :: self_len - suffix_len
    if !sfx.is_empty() && sfx[0] == SEP {
        return true
    }
    return s[cut - 1] == SEP
}

// ---- normalization --------------------------------------------------------

/// Collapse `.` and `..` segments. Purely lexical — does NOT touch the
/// filesystem (no symlink resolution, no existence check). Preserves an
/// absolute prefix when present.
///
/// Examples :
///   `"a/./b".to_path().normalize()       → "a/b"`
///   `"a/b/..".to_path().normalize()      → "a"`
///   `"/a/../b".to_path().normalize()     → "/b"`
///   `"../foo".to_path().normalize()      → "../foo"` (can't escape rel root)
///
/// @param self  the path receiver.
/// @return      a fresh, lexically-normalised `Path`.
export normalize :: fn(self: Path) -> Path {
    s :: string(self)
    if s.is_empty() {
        return self
    }
    abs :: self.is_absolute()
    segments: string[]! = []
    count: usize = 0
    rb :: s.bytes()
    n :: rb.len()
    i: usize = if abs { 1 } else { 0 }
    seg_start := i
    for i <= n {
        at_end :: i == n
        is_sep :: !at_end && s[i] == SEP
        if is_sep || at_end {
            seg :: rb[seg_start..<i].bytes_to_string()
            if seg.is_empty() || seg == "." {
                // skip
            } else if seg == ".." {
                can_pop :: count > 0 && segments[count - 1] != ".."
                if can_pop {
                    count = count - 1
                } else if !abs {
                    if count < segments.len() {
                        segments[count] = seg
                    } else {
                        segments.push(seg)
                    }
                    count = count + 1
                }
            } else {
                if count < segments.len() {
                    segments[count] = seg
                } else {
                    segments.push(seg)
                }
                count = count + 1
            }
            seg_start = i + 1
        }
        i = i + 1
    }
    sb := StringBuilder {}
    if abs {
        sb.append(SEP_STR)
    }
    for j in 0..<count {
        if j > 0 {
            sb.append(SEP_STR)
        }
        sb.append(segments[j])
    }
    out :: sb.to_string()
    if out.is_empty() && !abs {
        return Path(".")
    }
    return Path(out)
}

// ---------------------------------------------------------------------- tests

import "std/testing"

@test test_to_path :: fn() -> void {
    p :: "a/b/c".to_path()
    assert_eq(p.as_string(), "a/b/c")
}

@test test_empty_path :: fn() -> void {
    p :: empty_path()
    assert_eq(p.as_string(), "")
}

@test test_is_absolute :: fn() -> void {
    assert("/usr/bin".to_path().is_absolute(), "/usr/bin is absolute")
    assert(!"relative/path".to_path().is_absolute(), "relative/path is not absolute")
    assert(!empty_path().is_absolute(), "empty path is not absolute")
}

@test test_parent :: fn() -> void {
    assert_eq("a/b/c".to_path().parent().as_string(), "a/b")
    assert_eq("a".to_path().parent().as_string(), "")
    assert_eq("/usr/bin/cat".to_path().parent().as_string(), "/usr/bin")
}

@test test_filename :: fn() -> void {
    assert_eq("a/b/c".to_path().filename(), "c")
    assert_eq("file.txt".to_path().filename(), "file.txt")
    assert_eq("a/b/".to_path().filename(), "")
}

// The three views on a final segment, checked together so they can't drift:
// `filename` = `name` + `.` + `extension` whenever an extension is present.
@test test_name_and_extension :: fn() -> void {
    assert_eq("file.txt".to_path().name(), "file")
    assert_eq("file.txt".to_path().extension(), "txt")

    // The LAST dot splits, so a double extension keeps the first half in `name`.
    assert_eq("a/b/c.tar.gz".to_path().name(), "c.tar")
    assert_eq("a/b/c.tar.gz".to_path().extension(), "gz")

    // No extension: `name` is the whole filename, `extension` empty.
    assert_eq("README".to_path().name(), "README")
    assert_eq("README".to_path().extension(), "")

    // A leading dot marks a hidden file, it is not an extension separator —
    // and that holds in a subdirectory too, which is why the search runs on
    // `filename()` rather than on the whole path.
    assert_eq(".gitignore".to_path().name(), ".gitignore")
    assert_eq(".gitignore".to_path().extension(), "")
    assert_eq("dir/.gitignore".to_path().name(), ".gitignore")
    assert_eq("dir/.gitignore".to_path().extension(), "")

    // A trailing dot leaves nothing after it.
    assert_eq("trailing.".to_path().name(), "trailing")
    assert_eq("trailing.".to_path().extension(), "")

    // Multi-byte characters before the dot: the cut is on bytes, so it lands
    // where the dot actually is. A codepoint-indexed slice yields `ader` here.
    assert_eq("café.vader".to_path().name(), "café")
    assert_eq("café.vader".to_path().extension(), "vader")
    assert_eq("données/café.tar.gz".to_path().extension(), "gz")
}

@test test_join :: fn() -> void {
    assert_eq("a".to_path().join("b").as_string(), "a/b")
    assert_eq("a/".to_path().join("b").as_string(), "a/b")
    assert_eq(empty_path().join("b").as_string(), "b")
}

@test test_starts_ends_with :: fn() -> void {
    assert("a/b/c".to_path().starts_with("a/b".to_path()), "a/b/c starts with a/b")
    assert("a/b/c".to_path().ends_with("b/c".to_path()), "a/b/c ends with b/c")
    assert(!"a/b/c".to_path().starts_with("x".to_path()), "a/b/c does not start with x")
}
