// examples/raycaster/engine/render: one frame of the view, into a pixel buffer.
//
// A frame is drawn in passes, back to front. The floor and the ceiling
// first, a row at a time: every pixel of a row lies at the same distance, so a
// row is one step along the floor per pixel. Then the walls, a column at a time:
// one ray per column, a vertical strip of texture scaled by the distance, and the
// distance kept per column. Then the sprites, the things and the zombies,
// farthest first, each column of a sprite drawn only where it is nearer than
// that column's wall. Last, the player's pistol, and the red of a hit.
//
// The light is coloured. Each cell has an ambient level per channel, raised by
// the glow of the lamps, light columns and torches around it (`light_map`, once
// per level), and the distance dims it all. The textures are read in place, out
// of the constants the build computed, and reach the drawing functions as
// arguments, which share them: a texture stored in a struct, or returned, would
// be a copy.

module "engine"

import "std/math"
import "std/sort"

/// A frame being drawn: its pixels, and per column, how far the wall is.
export Frame :: struct {
    width: i32
    height: i32
    /// Row-major, `width * height` pixels, the layout raylib's texture takes.
    pixels: u32[]
    /// Per column, the distance of the wall drawn there.
    depth: f64[]
}

/// A frame of `width` by `height` pixels, all `TRANSPARENT` until drawn.
export new_frame :: fn(width: i32, height: i32) -> Frame = Frame {
    .width = width,
    .height = height,
    .pixels = [0] * i64(width * height),
    .depth = [0.0] * i64(width),
}

// The light every cell gets with no lamp near, per channel, as a share of
// `FULL_LIGHT`: a little blue, as in a dim hangar.
AMBIENT_RED :: 0.62
AMBIENT_GREEN :: 0.64
AMBIENT_BLUE :: 0.75

// How fast the light falls off with the distance from the eye (`dimming`).
FALLOFF :: 0.12

// How fast a thing's glow falls off with the distance from it, in cells.
GLOW_SPREAD :: 0.6

// Faces that run north to south are lit this share of the others.
SIDE_LIGHT :: 0.8

/// The light of a level: per cell and per channel, the share of `FULL_LIGHT` the
/// ambient light and the glow of the things around it give.
export LightMap :: struct {
    width: i32
    height: i32
    /// Row-major, one level per cell.
    red: f64[]
    green: f64[]
    blue: f64[]
}

/// Compute how each cell of `level` is lit: the ambient light, plus the glow of
/// every thing that sheds one, falling off with the square of the distance.
export light_map :: fn(level: Level) -> LightMap {
    count :: i64(level.width * level.height)
    lights :: LightMap {
        .width = level.width,
        .height = level.height,
        .red = [AMBIENT_RED] * count,
        .green = [AMBIENT_GREEN] * count,
        .blue = [AMBIENT_BLUE] * count,
    }
    for thing in level.things {
        for y in 0..<level.height {
            for x in 0..<level.width {
                spread :: squared_distance(thing.x, thing.y, f64(x) + 0.5, f64(y) + 0.5)
                share :: 1.0 / (1.0 + GLOW_SPREAD * spread)
                cell :: level.index_of(x, y)
                lights.red[cell] += thing.kind.glow_red * share
                lights.green[cell] += thing.kind.glow_green * share
                lights.blue[cell] += thing.kind.glow_blue * share
            }
        }
    }
    return lights
}

// How much of the light reaches the eye from `distance` cells away: all of it
// close to, a third at nine cells.
dimming :: fn(distance: f64) -> f64 = 1.0 / (1.0 + distance * FALLOFF * (1.0 + distance * 0.1))

// The light at `(x, y)` dimmed by `dim` (`dimming`), packed for `lit`. Each cell's
// level holds at its centre, and a point between centres mixes the four around
// it, so that the light shades smoothly from cell to cell instead of in squares.
light_at :: fn(lights: LightMap, x: f64, y: f64, dim: f64) -> u32 {
    from_x :: x - 0.5
    from_y :: y - 0.5
    left :: floor(from_x)
    top :: floor(from_y)
    across :: from_x - left
    down :: from_y - top
    west :: clamp(i32(left), 0, lights.width - 1)
    east :: clamp(i32(left) + 1, 0, lights.width - 1)
    north :: clamp(i32(top), 0, lights.height - 1)
    south :: clamp(i32(top) + 1, 0, lights.height - 1)
    north_west :: i64(north * lights.width + west)
    north_east :: i64(north * lights.width + east)
    south_west :: i64(south * lights.width + west)
    south_east :: i64(south * lights.width + east)
    scale :: f64(FULL_LIGHT) * dim
    red :: mix_four(lights.red, north_west, north_east, south_west, south_east, across, down)
    green :: mix_four(lights.green, north_west, north_east, south_west, south_east, across, down)
    blue :: mix_four(lights.blue, north_west, north_east, south_west, south_east, across, down)
    return pack_light(u32(red * scale), u32(green * scale), u32(blue * scale))
}

// The levels of four cells mixed bilinearly: `across` from west to east, `down`
// from north to south, each in `0.0..<1.0`.
mix_four :: fn(
    levels: f64[],
    north_west: i64,
    north_east: i64,
    south_west: i64,
    south_east: i64,
    across: f64,
    down: f64,
) -> f64 {
    north :: levels[north_west] + (levels[north_east] - levels[north_west]) * across
    south :: levels[south_west] + (levels[south_east] - levels[south_west]) * across
    return north + (south - north) * down
}

// How tall the walls are, and how high the eye: in cells, the floor at 0.
WALL_HEIGHT :: 1.6
EYE_HEIGHT :: 0.55

// How many pixels one cell of height spans at a distance of one cell: as many as
// one cell of width at the centre of the view, so that a pixel covers as much of
// a wall upwards as sideways whatever the frame's shape.
projection :: fn(frame: Frame) -> f64 = f64(frame.width) / 2.0 / PLANE_LENGTH

// How many texels of a full-size texture, laid once per cell, one pixel spans at
// `distance`: up a wall, and along a row of the floor.
texel_footprint :: fn(frame: Frame, distance: f64) -> f64 =
    f64(TEXTURE_SIZE) * distance / frame.projection()

/// Draw what `player` sees of `level` into `frame`.
///
/// @param lights  how `level` is lit: its `light_map`.
export render :: fn(frame: Frame, level: Level, player: Player, lights: LightMap) -> void {
    draw_floor_and_ceiling(frame, player, lights)
    draw_walls(frame, level, player, lights)
    draw_billboards(frame, player, lights, billboards(level))
    draw_weapon(frame, player, lights)
    if player.hurt > 0.0 {
        frame.redden(player.hurt)
    }
}

// ---- floor and ceiling ----------------------------------------------------

// Every row below the horizon shows the floor at one distance, every row above
// it the ceiling: the farther from the horizon, the nearer. Walking a row is one
// step along the plane per pixel, from the left ray's point to the right ray's.
draw_floor_and_ceiling :: fn(frame: Frame, player: Player, lights: LightMap) -> void {
    half :: frame.height / 2
    below :: EYE_HEIGHT * frame.projection()
    above :: (WALL_HEIGHT - EYE_HEIGHT) * frame.projection()
    // A row's distance is taken at the centre of its pixels, so that the row at the
    // horizon is not infinitely far.
    for y in half..<frame.height {
        draw_plane_row(frame, player, lights, y, below / (f64(y - half) + 0.5), FLOOR_TEXTURE)
    }
    for y in 0..<half {
        draw_plane_row(frame, player, lights, y, above / (f64(half - y) - 0.5), CEILING_TEXTURE)
    }
}

// Draw row `y` of the frame as the floor or the ceiling `distance` away, in
// `texture` (mipmapped).
draw_plane_row :: fn(
    frame: Frame,
    player: Player,
    lights: LightMap,
    y: i32,
    distance: f64,
    texture: u32[],
) -> void {
    width :: frame.width
    texels :: f64(TEXTURE_SIZE)
    step_x :: distance * 2.0 * player.plane_x / f64(width)
    step_y :: distance * 2.0 * player.plane_y / f64(width)
    plane_x := player.x + distance * (player.direction_x - player.plane_x)
    plane_y := player.y + distance * (player.direction_y - player.plane_y)
    dim :: dimming(distance)
    mip :: mip_level(frame.texel_footprint(distance))
    row :: i64(y * width)
    for x in 0..<i64(width) {
        texel_x :: i32(plane_x * texels) & TEXTURE_MASK
        texel_y :: i32(plane_y * texels) & TEXTURE_MASK
        light :: light_at(lights, plane_x, plane_y, dim)
        frame.pixels[row + x] = lit(texture[mip_index(mip, texel_x, texel_y)], light)
        plane_x += step_x
        plane_y += step_y
    }
}

// ---- walls ----------------------------------------------------------------

// One ray per column: the wall it meets is drawn as a strip of its texture, lit
// by the light just in front of the face.
draw_walls :: fn(frame: Frame, level: Level, player: Player, lights: LightMap) -> void {
    for column in 0..<frame.width {
        camera :: 2.0 * f64(column) / f64(frame.width) - 1.0
        ray_x :: player.direction_x + player.plane_x * camera
        ray_y :: player.direction_y + player.plane_y * camera
        hit :: cast_ray(level, player.x, player.y, ray_x, ray_y)
        frame.depth[i64(column)] = hit.distance
        // In the cell the ray came from.
        lit_x :: player.x + ray_x * (hit.distance - 0.01)
        lit_y :: player.y + ray_y * (hit.distance - 0.01)
        dim :: dimming(hit.distance) * side_dimming(hit.faces_east_west)
        light :: light_at(lights, lit_x, lit_y, dim)
        draw_wall_strip(frame, column, hit, light, WALL_TEXTURES[i64(hit.cell.texture)])
    }
}

// Draw the wall `hit` in column `column`, out of `texture` (mipmapped), lit by
// `light`.
draw_wall_strip :: fn(frame: Frame, column: i32, hit: Hit, light: u32, texture: u32[]) -> void {
    width :: frame.width
    half :: frame.height / 2
    // Pixels per cell of height, at this distance.
    scale :: frame.projection() / hit.distance
    top :: half - i32((WALL_HEIGHT - EYE_HEIGHT) * scale)
    bottom :: half + i32(EYE_HEIGHT * scale)
    first :: max(top, 0)
    footprint :: frame.texel_footprint(hit.distance)
    mip :: mip_level(footprint)
    // Texel rows per pixel, down the strip.
    step :: footprint / hit.cell.texture_height
    texel_x :: i32(hit.across * f64(TEXTURE_SIZE)) & TEXTURE_MASK
    texel_y := f64(first - top) * step
    for y in first..<min(bottom, frame.height) {
        texel :: mip_index(mip, texel_x, i32(texel_y) & TEXTURE_MASK)
        frame.pixels[i64(y * width + column)] = lit(texture[texel], light)
        texel_y += step
    }
}

// The share of the light a face gets for the way it faces.
side_dimming :: fn(faces_east_west: bool) -> f64 {
    if faces_east_west {
        return SIDE_LIGHT
    }
    return 1.0
}

// ---- sprites --------------------------------------------------------------

// A picture standing on the floor this frame: a thing, or a zombie.
Billboard :: struct {
    x: f64
    y: f64
    // Its picture in `SPRITE_TEXTURES`.
    sprite: i32
    // Whether it lights itself, whatever the light around it.
    glows: bool
}

// The things and the zombies of `level`, as pictures to draw. A zombie firing
// is lit by its own flash.
billboards :: fn(level: Level) -> Billboard[] {
    out: Billboard[]: [] * (level.things.len() + level.enemies.len())
    for thing in level.things {
        out.push(Billboard {
            .x = thing.x,
            .y = thing.y,
            .sprite = thing.kind.sprite,
            .glows = thing.kind.glows(),
        })
    }
    for enemy in level.enemies {
        out.push(Billboard {
            .x = enemy.x,
            .y = enemy.y,
            .sprite = enemy_sprite(enemy),
            .glows = enemy.state == .Firing,
        })
    }
    return out
}

// Draw `pictures`, farthest first, each standing on the floor.
draw_billboards :: fn(
    frame: Frame,
    player: Player,
    lights: LightMap,
    pictures: Billboard[],
) -> void {
    far_first :: sort(pictures, (a, b) -> player.is_farther(a, b))
    // Undo the camera: a point `offset` from the player is
    // `plane * across + direction * depth`.
    inverse :: 1.0 / (player.plane_x * player.direction_y - player.direction_x * player.plane_y)
    for picture in far_first {
        offset_x :: picture.x - player.x
        offset_y :: picture.y - player.y
        across :: inverse * (player.direction_y * offset_x - player.direction_x * offset_y)
        depth :: inverse * (player.plane_x * offset_y - player.plane_y * offset_x)
        if depth < 0.2 {
            continue
        }
        centre :: i32(f64(frame.width) / 2.0 * (1.0 + across / depth))
        light :: billboard_light(lights, picture, depth)
        draw_sprite(frame, centre, depth, light, SPRITE_TEXTURES[i64(picture.sprite)])
    }
}

// Draw `texture`, lit by `light`, as a thing one cell tall standing on the floor
// `depth` away, centred on column `centre`: only in the columns where it is
// nearer than the wall.
draw_sprite :: fn(frame: Frame, centre: i32, depth: f64, light: u32, texture: u32[]) -> void {
    size :: i32(frame.projection() / depth)
    top :: frame.height / 2 + i32(EYE_HEIGHT * frame.projection() / depth) - size
    draw_picture(frame, centre - size / 2, top, size, depth, light, texture)
}

// Draw the picture `texture`, `size` pixels square and lit by `light`, its
// top-left corner at `(left, top)`, clipped to the frame: only in the columns
// where it is nearer than the wall, at `depth`.
draw_picture :: fn(
    frame: Frame,
    left: i32,
    top: i32,
    size: i32,
    depth: f64,
    light: u32,
    texture: u32[],
) -> void {
    width :: frame.width
    step :: f64(TEXTURE_SIZE) / f64(size)
    for column in max(left, 0)..<min(left + size, width) {
        if depth >= frame.depth[i64(column)] {
            continue
        }
        texel_x :: i32(f64(column - left) * step)
        texel_y := f64(max(top, 0) - top) * step
        for y in max(top, 0)..<min(top + size, frame.height) {
            pixel :: texture[i64(i32(texel_y) * TEXTURE_SIZE + texel_x)]
            if is_opaque(pixel) {
                frame.pixels[i64(y * width + column)] = lit(pixel, light)
            }
            texel_y += step
        }
    }
}

// The light `picture` is drawn in, `depth` away.
billboard_light :: fn(lights: LightMap, picture: Billboard, depth: f64) -> u32 {
    if picture.glows {
        return grey_light(FULL_LIGHT)
    }
    return light_at(lights, picture.x, picture.y, dimming(depth))
}

// Whether `a` stands farther from `player` than `b`.
is_farther :: fn(player: Player, a: Billboard, b: Billboard) -> bool =
    player.squared_distance_to(a) > player.squared_distance_to(b)

// How far `picture` is from `player`, squared: enough to compare distances.
squared_distance_to :: fn(player: Player, picture: Billboard) -> f64 =
    squared_distance(player.x, player.y, picture.x, picture.y)

// ---- overlay --------------------------------------------------------------

// The gap between the map and the frame's corner, in pixels.
MAP_MARGIN: i32: 6

/// Draw the map in the frame's top-left corner: walls, doors, things, and the
/// player with the direction they face.
///
/// @param cell_size  the side of a cell on the map, in pixels.
export draw_minimap :: fn(frame: Frame, level: Level, player: Player, cell_size: i32) -> void {
    for y in 0..<level.height {
        for x in 0..<level.width {
            colour :: minimap_colour(level.cell_at(x, y))
            if colour != TRANSPARENT {
                left :: MAP_MARGIN + x * cell_size
                frame.fill(left, MAP_MARGIN + y * cell_size, cell_size, cell_size, colour)
            }
        }
    }
    for thing in level.things {
        thing_x :: MAP_MARGIN + i32(thing.x * f64(cell_size)) - 1
        thing_y :: MAP_MARGIN + i32(thing.y * f64(cell_size)) - 1
        frame.fill(thing_x, thing_y, 2, 2, rgb(220, 180, 60))
    }
    player_x :: MAP_MARGIN + i32(player.x * f64(cell_size))
    player_y :: MAP_MARGIN + i32(player.y * f64(cell_size))
    for step in 1..=6 {
        ahead_x :: player_x + i32(player.direction_x * f64(step))
        ahead_y :: player_y + i32(player.direction_y * f64(step))
        frame.fill(ahead_x, ahead_y, 1, 1, rgb(255, 255, 255))
    }
    frame.fill(player_x - 1, player_y - 1, 3, 3, rgb(240, 60, 40))
}

// The colour of a cell on the map, `TRANSPARENT` for floor, which lets the view
// show through.
minimap_colour :: fn(cell: Cell) -> u32 = match cell {
    .Empty -> TRANSPARENT
    .Door  -> rgb(200, 110, 50)
    .Stone | .Brick | .Rust | .Steel | .Green | .Red | .Concrete | .Corrugated -> rgb(150, 150, 160)
}

// Fill a rectangle of `frame` with `colour`, clipped to the frame.
fill :: fn(frame: Frame, left: i32, top: i32, width: i32, height: i32, colour: u32) -> void {
    for y in max(top, 0)..<min(top + height, frame.height) {
        for x in max(left, 0)..<min(left + width, frame.width) {
            frame.pixels[i64(y * frame.width + x)] = colour
        }
    }
}

// The red a hit tints the view with, and how far towards it the view goes at
// its strongest, out of `FULL_LIGHT`.
RED: u32: rgb(208, 0, 0)
RED_TINT: u32: 110

// Tint the whole frame red, by `amount` from none to `RED_TINT` of the way.
redden :: fn(frame: Frame, amount: f64) -> void {
    share :: u32(f64(RED_TINT) * min(amount, 1.0))
    for i in 0..<frame.pixels.len() {
        frame.pixels[i] = blend(frame.pixels[i], RED, share)
    }
}

/// Draw a small cross at the centre of the frame.
export draw_crosshair :: fn(frame: Frame) -> void {
    centre_x :: frame.width / 2
    centre_y :: frame.height / 2
    frame.fill(centre_x - 4, centre_y, 9, 1, rgb(230, 230, 230))
    frame.fill(centre_x, centre_y - 4, 1, 9, rgb(230, 230, 230))
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_render_fills_every_pixel :: fn() -> void {
    level :: tiny()
    frame :: new_frame(32, 20)
    render(frame, level, new_player(level), light_map(level))
    for pixel in frame.pixels {
        assert(is_opaque(pixel), "every pixel is drawn")
    }
}

@test
test_render_depth_is_the_wall_distance :: fn() -> void {
    level :: tiny()
    frame :: new_frame(32, 20)
    render(frame, level, new_player(level), light_map(level))
    // The centre column looks east, at the wall 2.5 cells away.
    assert_eq(frame.depth[16], 2.5)
}

@test
test_render_light_falls_off_with_distance :: fn() -> void {
    lights :: light_map(tiny())
    near :: light_at(lights, 3.5, 3.5, dimming(1.0))
    far :: light_at(lights, 3.5, 3.5, dimming(5.0))
    assert((near & 0x3FF) > (far & 0x3FF), "farther is darker")
}
