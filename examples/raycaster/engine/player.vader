// examples/raycaster/engine/player: where the player stands, where they look,
// and how they move through the level.
//
// The view is a direction and a camera plane at right angles to it, as in
// Lode Vandevenne's raycasting tutorial: a screen column at `camera` in
// `-1.0..=1.0` casts the ray `direction + plane * camera`, so the plane's length
// sets the field of view. With `y` growing to the south, the plane points to the
// player's right.

module "engine"

import "std/math"

// Half the width of the camera plane: the tangent of half the field of view,
// about 66 degrees in all.
PLANE_LENGTH :: 0.66

// How far the player's body reaches around their centre, in cells.
BODY_RADIUS :: 0.22

// How far ahead the player reaches for a door, in cells.
REACH :: 1.2

// The health the player starts with, and the most a pickup heals them up to.
FULL_HEALTH: i32: 100

// The most bullets the player carries.
MAX_AMMO: i32: 200

// How near the player must come to a pickup to take it, in cells: near enough
// for their bodies to touch.
PICKUP_REACH :: BODY_RADIUS + THING_RADIUS

// How fast the red of a hit fades from the view, in shares per second.
HURT_FADE :: 2.5

/// Where the player stands and looks.
export Player :: struct {
    x: f64
    y: f64
    /// The direction they face, a unit vector.
    direction_x: f64
    direction_y: f64
    /// The camera plane, `PLANE_LENGTH` long, pointing to their right.
    plane_x: f64
    plane_y: f64
    /// What is left of their health, `0` once they fall.
    health: i32 = FULL_HEALTH
    /// The bullets left in their pistol.
    ammo: i32 = START_AMMO
    /// Seconds since the pistol last fired: its picture follows the recoil.
    since_shot: f64 = FIRE_INTERVAL
    /// How red the view is from the last hit: `1.0` just hit, fading to `0.0`.
    hurt: f64 = 0.0
}

/// The player at `level`'s start, facing east.
export new_player :: fn(level: Level) -> Player = Player {
    .x = level.start_x,
    .y = level.start_y,
    .direction_x = 1.0,
    .direction_y = 0.0,
    .plane_x = 0.0,
    .plane_y = PLANE_LENGTH,
}

/// Turn the player by `angle` radians; a positive angle turns right.
export turn :: fn(player: Player, angle: f64) -> void {
    cosine :: cos(angle)
    sine :: sin(angle)
    direction_x :: player.direction_x * cosine - player.direction_y * sine
    player.direction_y = player.direction_x * sine + player.direction_y * cosine
    player.direction_x = direction_x
    plane_x :: player.plane_x * cosine - player.plane_y * sine
    player.plane_y = player.plane_x * sine + player.plane_y * cosine
    player.plane_x = plane_x
}

/// Move the player `forward` cells along their direction and `right` cells to
/// their right, sliding along what blocks them: each axis moves only when the
/// body fits there, so a wall met at an angle stops one axis and not the other.
export walk :: fn(player: Player, level: Level, forward: f64, right: f64) -> void {
    step_x :: player.direction_x * forward - player.direction_y * right
    step_y :: player.direction_y * forward + player.direction_x * right
    if level.has_room(player.x + step_x, player.y, BODY_RADIUS, null) {
        player.x += step_x
    }
    if level.has_room(player.x, player.y + step_y, BODY_RADIUS, null) {
        player.y += step_y
    }
}

/// Move the player's clocks on by `seconds`: the pistol's recoil, the red of a
/// hit.
export update_player :: fn(player: Player, seconds: f64) -> void {
    player.since_shot += seconds
    player.hurt = max(player.hurt - seconds * HURT_FADE, 0.0)
}

/// Pick up what lies within reach of `player` and does them good: a clip below
/// `MAX_AMMO` bullets, a stimpack or a medikit below `FULL_HEALTH`.
///
/// @param noises  what the player hears, appended to.
export collect :: fn(player: Player, level: Level, noises: Noise[]) -> void {
    if player.health <= 0 {
        return
    }
    for thing in level.things {
        if thing.taken || !player.needs(thing.kind) {
            continue
        }
        if squared_distance(thing.x, thing.y, player.x, player.y) < PICKUP_REACH * PICKUP_REACH {
            player.ammo = min(player.ammo + thing.kind.ammo, MAX_AMMO)
            player.health = min(player.health + thing.kind.health, FULL_HEALTH)
            thing.taken = true
            noises.push(.PickUp)
        }
    }
}

// Whether a pickup of `kind` would give `player` anything.
needs :: fn(player: Player, kind: ThingKind) -> bool =
    (kind.ammo > 0 && player.ammo < MAX_AMMO) || (kind.health > 0 && player.health < FULL_HEALTH)

// Take `damage` from the player's health; with none left, they fall.
take_damage :: fn(player: Player, damage: i32, noises: Noise[]) -> void {
    if player.health <= 0 {
        return
    }
    player.health = max(player.health - damage, 0)
    player.hurt = 1.0
    if player.health > 0 {
        noises.push(.PlayerHurt)
        return
    }
    noises.push(.PlayerDies)
}

/// The door in front of the player, within reach, or `null` when none is.
export door_ahead :: fn(player: Player, level: Level) -> Door | null {
    cell_x :: i32(floor(player.x + player.direction_x * REACH))
    cell_y :: i32(floor(player.y + player.direction_y * REACH))
    return level.door_at(cell_x, cell_y)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_player_starts_facing_east :: fn() -> void {
    player :: new_player(tiny())
    assert_eq(player.direction_x, 1.0)
    assert_eq(player.plane_y, PLANE_LENGTH)
}

@test
test_player_turn_right_faces_south :: fn() -> void {
    player :: new_player(tiny())
    player.turn(pi / 2.0)
    assert(abs(player.direction_y - 1.0) < 0.000001, "a quarter turn right faces south")
    assert(abs(player.plane_x + PLANE_LENGTH) < 0.000001, "the plane follows, to the west")
}

@test
test_player_walk_stops_at_a_wall :: fn() -> void {
    level :: tiny()
    player :: new_player(level)
    player.walk(level, -2.0, 0.0)
    assert_eq(player.x, 1.5)
}

@test
test_player_walk_slides_along_a_wall :: fn() -> void {
    level :: tiny()
    player :: new_player(level)
    // Backwards into the west wall and right into the open: only the south part moves.
    player.walk(level, -0.4, 0.25)
    assert_eq(player.x, 1.5)
    assert_eq(player.y, 1.75)
}

@test
test_player_walk_stops_at_a_zombie :: fn() -> void {
    level :: parsed(["######", "#@.Z.#", "######"])
    player :: new_player(level)
    player.walk(level, 2.0, 0.0)
    assert_eq(player.x, 1.5)
}

@test
test_player_falls_at_no_health :: fn() -> void {
    player :: new_player(tiny())
    noises: Noise[]: []
    player.take_damage(FULL_HEALTH - 1, noises)
    player.take_damage(5, noises)
    assert_eq(player.health, 0)
    assert(noises[0] == .PlayerHurt && noises[1] == .PlayerDies, "hurt, then dead")
}

@test
test_player_picks_up_what_they_need :: fn() -> void {
    level :: parsed(["#####", "#@AH#", "#####"])
    player :: new_player(level)
    noises: Noise[]: []
    player.x = 2.5
    player.collect(level, noises)
    assert_eq(player.ammo, START_AMMO + 10)
    player.x = 3.5
    player.collect(level, noises)
    assert(!level.things[1].taken, "a medikit is left at full health")
    assert_eq(noises.len(), 1)
}

@test
test_player_heals_up_to_full_health :: fn() -> void {
    level :: parsed(["####", "#@H#", "####"])
    player :: new_player(level)
    player.health = 90
    noises: Noise[]: []
    player.x = 2.5
    player.collect(level, noises)
    assert_eq(player.health, FULL_HEALTH)
    assert(level.things[0].taken && noises[0] == .PickUp, "the medikit is taken")
}

@test
test_player_door_ahead_finds_the_door :: fn() -> void {
    level :: tiny()
    player :: new_player(level)
    player.x = 2.5
    player.turn(pi / 2.0)
    assert(player.door_ahead(level) != null, "the door is south of the player")
}
