// Brainfuck → Vader VM compiler.
//
// Reads a `.bf` source file, builds an in-memory `bc.BytecodeModule` via the
// `vader/vm/builder` API, and runs it through `exec_fn_value()` — no .virt
// text intermediate, no subprocess.
//
// Memory model :
//   - One i32[] local holds the cell tape, grown lazily : it starts as a
//     single zero cell and `>` appends a fresh zero whenever the pointer
//     walks past the current end. BF's tape is conceptually infinite, so
//     there's no point materialising a fixed 30000 cells up front — only the
//     cells a program actually visits get allocated.
//   - One i32 local holds the data pointer (cell index).
//   - BF cells are i32-wide (no wrap at 256) — matches the VM's native int.
//
// Output (`.`) never leaves the VM : it appends the cell to an `i32[]` that
// `bf_main` returns, and the host program prints those bytes with `std/io`
// once the run is over. The generated bytecode therefore needs no host import
// at all, and printing goes through whatever `std/io` does on the platform.
//
// Input (`,`) is **not** wired (no `read_byte` host today) — the compiler
// emits a "store 0" sequence and the BF program sees end-of-stream as 0.
//
// Usage :
//   vader run examples/brainfuck/brainfuck.vader              # runs examples/brainfuck/hello.bf
//   vader run examples/brainfuck/brainfuck.vader path/to.bf   # arbitrary BF source
//   vader build --out=bf examples/brainfuck/brainfuck.vader   # then ./bf path/to.bf
//
// Built natively or run by `vader run`, this program embeds the VM : the
// Brainfuck module always runs on it.

module "main"

import "std/io"
import "std/string"
import "std/testing"
bc :: import "vader/bytecode"
import "vader/vm"

DEFAULT_PATH :: "examples/brainfuck/hello.bf"

// ---- BF lexer ------------------------------------------------------------

// True for the eight Brainfuck characters. UTF-8 codepoints outside this
// set count as comments and get filtered away by `tokenize_bf`.
is_bf_char :: fn(c: char) -> bool {
    return c == '>' || c == '<' ||
           c == '+' || c == '-' ||
           c == '.' || c == ',' ||
           c == '[' || c == ']'
}

// Decode codepoints from `source` and keep the eight BF characters.
//
// Written as an explicit accumulator loop rather than
// `source.chars().filter(is_bf_char).collect()` : the lazy-iterator chain
// miscompiles on the self-host backend (the `collect()` result stays a
// `FilterIterator` struct instead of a `char[]`, so `tokens.len()` traps with
// "array.len receiver: expected array, got struct"). Captured as a regression
// in `tests/snippets/_diag_iter_collect/`.
tokenize_bf :: fn(source: string) -> char[] {
    out: char[]!: []
    for c in source.chars() {
        if is_bf_char(c) {
            out.push(c)
        }
    }
    return out
}

// ---- bracket matcher -----------------------------------------------------

// For every `[` / `]` token, partner[i] is the index of its match.
// Non-bracket tokens get -1. Mismatched brackets return an empty array
// (caller detects and bails). One linear pass — each entry is pushed as
// `-1` then overwritten on the matching `]`.
match_brackets :: fn(tokens: char[]) -> i32[] {
    partner: i32[]!: []
    open_stack: usize[]!: []      // grow-only ; `sp` is the logical top
    sp: usize = 0
    for j in 0..<tokens.len() {
        partner.push(-1)
        if tokens[j] == '[' {
            if sp == open_stack.len() {
                open_stack.push(j)
            } else {
                open_stack[sp] = j
            }
            sp += 1
        } else if tokens[j] == ']' {
            if sp == 0 {
                return []
            }
            sp -= 1
            open_idx :: open_stack[sp]
            partner[open_idx] = i32(j)
            partner[j]        = i32(open_idx)
        }
    }
    if sp != 0 {
        return []
    }
    return partner
}

// ---- module emitter ------------------------------------------------------

// Slot layout for `bf_main` (parameter_count = 0, local_count = 3) :
//   slot 0 = __mem  (i32[], the lazily-grown cell tape)
//   slot 1 = __ptr  (i32,    the current data pointer / cell index)
//   slot 2 = __out  (i32[], the bytes `.` produced, returned at the end)

emit_bf_char :: fn(
    fb: FunctionBuilder!,
    c: char,
    idx: usize,
    partner: i32[],
    cells_type_id: i32,
) -> void {
    match c {
        '>' -> { // move right ; grow the tape lazily if we step past the end.
            fb.push(bc.LocalGet { .slot = 1 })
            fb.push(bc.I32Const { .value = 1 })
            fb.push(bc.I32Add {})
            fb.push(bc.LocalSet { .slot = 1 })
            // The pointer only moves one cell at a time, so it reaches the
            // tape end exactly when a new cell is due : if __ptr < the tape
            // length the cell already exists, otherwise append a fresh zero.
            grow_label :: "bf_grow_${idx}"
            fb.block(grow_label)
            fb.push(bc.LocalGet { .slot = 1 })   // __ptr
            fb.push(bc.LocalGet { .slot = 0 })   // __mem
            fb.push(bc.ArrayLen {})              // current tape length
            fb.push(bc.I32Lt {})
            fb.br_if(grow_label)                 // __ptr < length → cell exists, skip grow
            fb.push(bc.LocalGet { .slot = 0 })
            fb.push(bc.I32Const { .value = 0 })
            fb.push(bc.ArrayPush { .type_id = cells_type_id })
            fb.end()
        }
        '<' -> { // move the data pointer one cell to the left.
            fb.push(bc.LocalGet { .slot = 1 })
            fb.push(bc.I32Const { .value = 1 })
            fb.push(bc.I32Sub {})
            fb.push(bc.LocalSet { .slot = 1 })
        }
        '+' -> { // increment the cell under the pointer.
            fb.push(bc.LocalGet { .slot = 0 })
            fb.push(bc.LocalGet { .slot = 1 })
            fb.push(bc.LocalGet { .slot = 0 })
            fb.push(bc.LocalGet { .slot = 1 })
            fb.push(bc.ArrayGet { .type_id = cells_type_id })
            fb.push(bc.I32Const { .value = 1 })
            fb.push(bc.I32Add {})
            fb.push(bc.ArraySet { .type_id = cells_type_id })
        }
        '-' -> { // decrement the cell under the pointer.
            fb.push(bc.LocalGet { .slot = 0 })
            fb.push(bc.LocalGet { .slot = 1 })
            fb.push(bc.LocalGet { .slot = 0 })
            fb.push(bc.LocalGet { .slot = 1 })
            fb.push(bc.ArrayGet { .type_id = cells_type_id })
            fb.push(bc.I32Const { .value = 1 })
            fb.push(bc.I32Sub {})
            fb.push(bc.ArraySet { .type_id = cells_type_id })
        }
        '.' -> { // append the cell under the pointer to the output.
            fb.push(bc.LocalGet { .slot = 2 })
            fb.push(bc.LocalGet { .slot = 0 })
            fb.push(bc.LocalGet { .slot = 1 })
            fb.push(bc.ArrayGet { .type_id = cells_type_id })
            fb.push(bc.ArrayPush { .type_id = cells_type_id })
        }
        ',' -> { // read a byte into the current cell.
            fb.push(bc.LocalGet { .slot = 0 })
            fb.push(bc.LocalGet { .slot = 1 })
            fb.push(bc.I32Const { .value = 0 })
            fb.push(bc.ArraySet { .type_id = cells_type_id })
        }
        '[' -> { // open a loop
            block_label :: "bf_block_${idx}"
            loop_label  :: "bf_loop_${idx}"
            fb.block(block_label)
            fb.loop_(loop_label)
            fb.push(bc.LocalGet { .slot = 0 })
            fb.push(bc.LocalGet { .slot = 1 })
            fb.push(bc.ArrayGet { .type_id = cells_type_id })
            fb.push(bc.I32Const { .value = 0 })
            fb.push(bc.I32Eq {})
            fb.br_if(block_label)
        }
        ']' -> { // jump back to the matching `[`
            open_idx   :: partner[idx]
            loop_label :: "bf_loop_${open_idx}"
            fb.br(loop_label)
            fb.end()  // close loop
            fb.end()  // close block
        }
        // Any other char : not a BF instruction (tokenize_bf already filters
        // these out, so reaching this arm signals a contract violation).
        _ -> assert(false, "char '${c}' not handled by emit_bf_char")
    }
}

// Compile a Brainfuck program into a runnable `bc.BytecodeModule`.
//
// `tokens` are the program's instructions and `partner` their bracket pairing
// (`match_brackets`), which must be complete.
compile_brainfuck :: fn(tokens: char[], partner: i32[]) -> bc.BytecodeModule {
    module_builder :: new_module_builder()
    primitive_i32_type_id :: module_builder.add_type(bc.BcPrimitive { .val = .I32 })
    cells_type_id :: module_builder.add_type(bc.BcArray { .element = primitive_i32_type_id })

    // ---- fn bf_main() -> i32[] -------------------------------------------
    bf_main :: new_function_builder("bf_main", 0, 3)

    // __mem = [0] — start with a single zero cell ; the tape grows on demand
    // as `>` walks past the current end (see emit_bf_char). No 30000-cell
    // pre-fill : only the cells a program touches ever get allocated.
    bf_main.push(bc.ArrayNew { .type_id = cells_type_id })
    bf_main.push(bc.LocalSet { .slot = 0 })
    bf_main.push(bc.LocalGet { .slot = 0 })
    bf_main.push(bc.I32Const { .value = 0 })
    bf_main.push(bc.ArrayPush { .type_id = cells_type_id })
    // __ptr = 0
    bf_main.push(bc.I32Const { .value = 0 })
    bf_main.push(bc.LocalSet { .slot = 1 })
    // __out = []
    bf_main.push(bc.ArrayNew { .type_id = cells_type_id })
    bf_main.push(bc.LocalSet { .slot = 2 })

    // BF body
    token_index: usize = 0
    token_count :: tokens.len()
    for token_index < token_count {
        emit_bf_char(bf_main, tokens[token_index], token_index, partner, cells_type_id)
        token_index += 1
    }

    // return __out
    bf_main.push(bc.LocalGet { .slot = 2 })
    bf_main.push(bc.Return {})

    main_index :: module_builder.add_function(bf_main)
    module_builder.set_main(main_index)
    return module_builder.finish()
}

// ---- output --------------------------------------------------------------

// The bytes a run produced : each cell `.` appended, kept to its low byte.
bytes_of :: fn(output: ArrayVal) -> u8[] {
    bytes: u8[]!: []
    for k in 0..<output.length {
        cell :: output.elements[output.offset + k]
        if cell is I32Val {
            bytes.push(u8(cell.value & 0xFF))
        }
    }
    return bytes
}

// ---- entry point ---------------------------------------------------------

main :: fn(argv: string[]) -> i32 {
    path :: if argv.len() > 1 { argv[1] } else { DEFAULT_PATH }
    src :: read_file_string(path)
    if src is Error {
        eprintln("brainfuck: cannot read ${path}")
        return 1
    }
    tokens :: tokenize_bf(src)
    partner :: match_brackets(tokens)
    if tokens.len() > 0 && partner.len() == 0 {
        eprintln("brainfuck: ${path} has unmatched `[` or `]`")
        return 1
    }
    result :: exec_fn_value(prepare(compile_brainfuck(tokens, partner)), "bf_main")
    if result is Trap {
        eprintln("brainfuck: vm trap — ${result.message}")
        return 1
    }
    output :: result.value
    if output !is ArrayVal {
        eprintln("brainfuck: bf_main returned no output array")
        return 1
    }
    print(bytes_of(output).bytes_to_string())
    return 0
}
