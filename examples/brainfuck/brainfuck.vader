// Brainfuck → Vader VM compiler.
//
// Reads a `.bf` source file, writes the program as `.virt` text (the bytecode's
// textual form, with named labels for its loops), reads it back into a module
// with `parse_virt_bc`, and runs it through `exec_fn_value()`, all in memory: no
// intermediate file, no subprocess.
//
// Memory model :
//   - One i32[] local holds the cell tape, grown lazily : it starts as a
//     single zero cell and `>` appends a fresh zero whenever the pointer
//     walks past the current end. BF's tape is conceptually infinite, so
//     there's no point materialising a fixed 30000 cells up front — only the
//     cells a program actually visits get allocated.
//   - One i32 local holds the data pointer (cell index).
//   - BF cells are i32-wide (no wrap at 256) — matches the VM's native int.
//
// Output (`.`) never leaves the VM : it appends the cell to an `i32[]` that
// `bf_main` returns, and the host program prints those bytes with `std/io`
// once the run is over. The generated bytecode therefore needs no host import
// at all, and printing goes through whatever `std/io` does on the platform.
//
// Input (`,`) is **not** wired (no `read_byte` host today) — the compiler
// emits a "store 0" sequence and the BF program sees end-of-stream as 0.
//
// Usage :
//   vader run examples/brainfuck              # runs examples/brainfuck/hello.bf
//   vader run examples/brainfuck path/to.bf   # arbitrary BF source
//   vader build --out=bf examples/brainfuck   # then ./bf path/to.bf
//
// The folder is a project: its `vader.json` reaches the compiler's own modules
// (`vader/vm`, `vader/front/virt`) at the root of the checkout.
//
// Built natively or run by `vader run`, this program embeds the VM : the
// Brainfuck module always runs on it.

module "main"

import "std/io"
import "std/iter"
import "std/string"
import "std/string_builder"
import "std/testing"
import "vader/front/virt"
import "vader/vm"

DEFAULT_PATH :: "examples/brainfuck/hello.bf"

// ---- BF lexer ------------------------------------------------------------

// True for the eight Brainfuck characters. UTF-8 codepoints outside this
// set count as comments and get filtered away by `tokenize_bf`.
is_bf_char :: fn(c: char) -> bool {
    return c == '>' || c == '<' ||
           c == '+' || c == '-' ||
           c == '.' || c == ',' ||
           c == '[' || c == ']'
}

// Decode codepoints from `source` and keep the eight BF characters.
tokenize_bf :: fn(source: string) -> char[] = source.chars().filter(is_bf_char).collect()

// ---- bracket matcher -----------------------------------------------------

// For every `[` / `]` token, partner[i] is the index of its match.
// Non-bracket tokens get -1. Mismatched brackets return an empty array
// (caller detects and bails). One linear pass — each entry is pushed as
// `-1` then overwritten on the matching `]`.
match_brackets :: fn(tokens: char[]) -> i32[] {
    partner: i32[]: []
    open_stack: i64[]: []      // grow-only ; `sp` is the logical top
    sp: i64 = 0
    for j in 0..<tokens.len() {
        partner.push(-1)
        if tokens[j] == '[' {
            if sp == open_stack.len() {
                open_stack.push(j)
            } else {
                open_stack[sp] = j
            }
            sp += 1
        } else if tokens[j] == ']' {
            if sp == 0 {
                return []
            }
            sp -= 1
            open_idx :: open_stack[sp]
            partner[open_idx] = i32(j)
            partner[j]        = i32(open_idx)
        }
    }
    if sp != 0 {
        return []
    }
    return partner
}

// ---- module emitter ------------------------------------------------------

// The program is written as `.virt` text : the module declares the cell type
// (`type 0`, an `i32`) and the tape type (`type 1`, an array of it), and one
// function `bf_main` whose locals are
//   0 = mem  (the lazily-grown cell tape)
//   1 = ptr  (the current data pointer / cell index)
//   2 = out  (the bytes `.` produced, returned at the end)

// Append the `.virt` lines of one Brainfuck instruction, the `idx`-th of the
// program, to `sb`. `partner` pairs each bracket with its match.
emit_bf_char :: fn(sb: StringBuilder, c: char, idx: i64, partner: i32[]) -> void {
    match c {
        '>' -> { // move right ; grow the tape lazily if we step past the end.
            sb.append(move_pointer(1))
            // The pointer only moves one cell at a time, so it reaches the
            // tape end exactly when a new cell is due : if ptr < the tape
            // length the cell already exists, otherwise append a fresh zero.
            sb.append("  block \$grow_${idx} void\n")
            sb.append("  local.get 1\n  local.get 0\n  array.len\n  i32.lt\n")
            sb.append("  br_if \$grow_${idx}\n")
            sb.append("  local.get 0\n  i32.const 0\n  array.push 1\n")
            sb.append("  end \$grow_${idx}\n")
        }
        '<' -> sb.append(move_pointer(-1))
        '+' -> sb.append(add_to_cell(1))
        '-' -> sb.append(add_to_cell(-1))
        '.' -> { // append the cell under the pointer to the output.
            sb.append("  local.get 2\n  local.get 0\n  local.get 1\n")
            sb.append("  array.get 1\n  array.push 1\n")
        }
        // Read a byte : no input is wired, so the cell reads end-of-stream, 0.
        ',' -> sb.append("  local.get 0\n  local.get 1\n  i32.const 0\n  array.set 1\n")
        '[' -> { // open a loop, left at once when the cell is zero.
            sb.append("  block \$exit_${idx} void\n  loop \$back_${idx} void\n")
            sb.append("  local.get 0\n  local.get 1\n  array.get 1\n")
            sb.append("  i32.const 0\n  i32.eq\n  br_if \$exit_${idx}\n")
        }
        ']' -> { // jump back to the matching `[`
            open_idx :: partner[idx]
            sb.append("  br \$back_${open_idx}\n")
            sb.append("  end \$back_${open_idx}\n  end \$exit_${open_idx}\n")
        }
        // Any other char : not a BF instruction (tokenize_bf already filters
        // these out, so reaching this arm signals a contract violation).
        _ -> assert(false, "char '${c}' not handled by emit_bf_char")
    }
}

// The lines that move the data pointer by `delta` cells.
move_pointer :: fn(delta: i32) -> string =
    "  local.get 1\n  i32.const ${delta}\n  i32.add\n  local.set 1\n"

// The lines that add `delta` to the cell under the pointer.
add_to_cell :: fn(delta: i32) -> string =
    "  local.get 0\n  local.get 1\n  local.get 0\n  local.get 1\n  array.get 1\n"
        + "  i32.const ${delta}\n  i32.add\n  array.set 1\n"

// Compile a Brainfuck program into the `.virt` text of a runnable module.
//
// `tokens` are the program's instructions and `partner` their bracket pairing
// (`match_brackets`), which must be complete.
compile_brainfuck :: fn(tokens: char[], partner: i32[]) -> string {
    sb :: StringBuilder {}
    sb.append("module brainfuck\ntype 0 scalar i32\ntype 1 array 0\nexport main 0\n\n")
    sb.append("fn 0 bf_main () -> ref\n  local mem ref\n  local ptr i32\n  local out ref\n")
    // mem = [0] : the tape starts as a single zero cell and grows on demand as
    // `>` walks past its end (see emit_bf_char), so only the cells a program
    // touches are ever allocated. ptr = 0, out = [].
    sb.append("  array.new 1 0\n  local.set 0\n  local.get 0\n  i32.const 0\n  array.push 1\n")
    sb.append("  i32.const 0\n  local.set 1\n  array.new 1 0\n  local.set 2\n")
    for idx in 0..<tokens.len() {
        emit_bf_char(sb, tokens[idx], idx, partner)
    }
    sb.append("  local.get 2\n  return\nend\n")
    return sb.to_string()
}

// ---- output --------------------------------------------------------------

// The bytes a run produced : each cell `.` appended, kept to its low byte.
bytes_of :: fn(output: ArrayVal) -> u8[] {
    bytes: u8[]: []
    for k in 0..<output.length {
        cell :: output.elements[output.offset + k]
        if cell is I32Val {
            bytes.push(u8(cell & 0xFF))
        }
    }
    return bytes
}

// ---- entry point ---------------------------------------------------------

main :: fn(argv: string[]) -> i32 {
    path :: if argv.len() > 1 { argv[1] } else { DEFAULT_PATH }
    src :: read_file_string(path)
    if src is Error {
        eprintln("brainfuck: cannot read ${path}")
        return 1
    }
    tokens :: tokenize_bf(src)
    partner :: match_brackets(tokens)
    if tokens.len() > 0 && partner.len() == 0 {
        eprintln("brainfuck: ${path} has unmatched `[` or `]`")
        return 1
    }
    module :: parse_virt_bc(compile_brainfuck(tokens, partner))
    if module is VirtParseError {
        where :: "line ${module.line_number}: ${module.reason}"
        eprintln("brainfuck: the compiled program does not parse, ${where}")
        return 1
    }
    state :: prepare(module)
    if state is VerifyError {
        eprintln("brainfuck: the compiled program is malformed — ${display_verify_error(state)}")
        return 1
    }
    result :: exec_fn_value(state, "bf_main")
    if result is Trap {
        eprintln("brainfuck: vm trap — ${result.message}")
        return 1
    }
    output :: result.value
    if output !is ArrayVal {
        eprintln("brainfuck: bf_main returned no output array")
        return 1
    }
    print(bytes_of(output).bytes_to_string())
    return 0
}
