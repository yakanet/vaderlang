node_modules/
dist/
build/
*.wasm
*.tsbuildinfo

# Scratch / throwaway POC + run dirs (not part of the tree)
tmp_mappoc/
tmp_vrun/

# Self-host CLI build artefacts (binary + generated C from `vader build vader/cli/main.vader`).
# Split is the default emission, so one `vader build` writes `main.split.h`,
# `main.split.g.c` and one `main-<module>.c` per module beside the binary.
vader/cli/main
vader/cli/main.c
vader/cli/main-*.c
vader/cli/main.split.*
vader/cli/main.dSYM/
.DS_Store
.env
.env.*
!.env.example
*.log
coverage/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Bench artifacts — native binaries + generated C/Go/class from `bench/run.ts`.
# Every workload lives in `bench/<name>/` with all its language sources
# colocated (`<name>.vader`, `.ts`, `.go`, `.java`) ; the compiled outputs land
# alongside as `bench/<name>/<name>` (Vader binary), `.c` (transient C),
# `<name>_go` (Go binary) and `<name>.class` (Java, incl. nested `$X.class`).
bench/*/*.c
# A driven build writes its C beside the fixture when `--out` names the fixture
# directory ; one such file (14 MB) reached main before this rule existed.
tests/hook_fixtures/*.c
tests/hook_fixtures/*/build/
bench/*/*.o
bench/*/*.h
bench/*/*_go
bench/*/*.class
bench/binary_trees/binary_trees
bench/iter_chain/iter_chain
bench/mandelbrot/mandelbrot
bench/map_iter/map_iter
bench/primes/primes
bench/string_builder/string_builder
bench/arr_rw/arr_rw
bench/arr_set/arr_set
bench/arr_map/arr_map
bench/arr_push/arr_push
bench/str_concat/str_concat
bench/interp/interp
bench/hashmap/hashmap
bench/ackermann/ackermann
bench/wordcount/wordcount
bench/quicksort/quicksort
*.dSYM/

## POCs
poc/

# Snippet artefacts — left behind when a dev runs `vader build` directly on
# a `tests/snippets/<name>/_main.vader` to inspect the native output. The
# C emitter writes `_main.c` next to the source and the linker emits a
# `_main` binary ; a `--split` build writes one `_main-<module>.c` per module
# plus its own header and objects. `tests/native.test.ts` uses `native.c` /
# `native[.exe]` for its own runs and those are listed separately just below.
tests/snippets/*/_main
tests/snippets/*/_main.c
tests/snippets/*/_main.imports.h
tests/snippets/*/_main.split.*
tests/snippets/*/_main-*.c
tests/snippets/*/_main-*.o
tests/snippets/*/_main.dSYM/
tests/snippets/*/native
tests/snippets/*/native.c

# Hook-fixture artefacts — left behind when a dev, or the IDE, runs `vader build`
# inside `tests/hook_fixtures/<name>/`. The driver's own binary and its 12 MB of C
# sit under `build/` and are covered at the top of this file ; a driven build ALSO
# writes the PROJECT's binary and C at the fixture root, named by that fixture's
# `ctx.out`. `observe_only`'s `should-not-exist` is deliberately NOT listed: it is
# a canary, and it appearing in `git status` is the point.
tests/hook_fixtures/*/app
tests/hook_fixtures/*/hello
tests/hook_fixtures/*/*.c
tests/hook_fixtures/*/*.h
tests/hook_fixtures/*/*.exe

# The `is T as x` migration tool builds beside its source (`tools/codemod/`).
# One-shot; it goes away with step 4 of the `as`-alias plan.
tools/codemod/as_alias
tools/codemod/as_alias.imports.h
tools/codemod/as_alias.split.*
tools/codemod/as_alias-*.c
tools/codemod/as_alias-*.o
tools/codemod/as_alias.dSYM/
