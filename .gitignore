node_modules/
dist/
build/
*.wasm
*.tsbuildinfo

# Scratch / throwaway POC + run dirs (not part of the tree)
tmp_mappoc/
tmp_vrun/

# Self-host CLI build artefacts (binary + generated C from `vader build vader/tools/cli/main.vader`).
# A native build writes its C, headers and objects to `c/` beside the binary.
vader/tools/cli/main
vader/tools/cli/c/
vader/tools/cli/main.dSYM/

# An example built in place leaves its binary beside it and its C in `c/`. No
# example ships C.
examples/*/c/
examples/*/*.exe
examples/raylib_sprite/raylib_sprite
.DS_Store
.env
.env.*
!.env.example
*.log
coverage/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/

*.dSYM/

## POCs
poc/

# Snippet artefacts: left behind when a dev runs `vader build` directly on
# a `tests/snippets/<name>/_main.vader` to inspect the native output: the
# `_main` binary, and its C, headers and objects in `c/`.
# `tests/native.test.ts` uses `native.c` / `native[.exe]` for its own runs and
# those are listed separately just below.
tests/snippets/*/_main
tests/snippets/*/c/
tests/snippets/*/_main.dSYM/
tests/snippets/*/native
tests/snippets/*/native.c

