// vader/resolver/resolve — orchestrator of the resolver passes.
//
// Two passes compose into one `ResolvedModule` :
//   1. Top-level minting (`vader/resolver/collect.vader`) — one Symbol
//      per top-level decl, indexed by name in a `MutableMap` so the body
//      walker can use it as the root scope seed.
//   2. Body walking (`vader/resolver/body.vader`) — descends every fn
//      body, lambda, match arm and pattern, stamping a span-keyed
//      `IdentExpr → Symbol` map.
//
// CLI consumers (`dump --stage=resolved-ast`) read `.symbols` ; LSP
// consumers read `.idents`. Both views come out of one call.

module "vader/resolver"

import "std/collections"
import "std/string"
import "std/sort"
import "toolchain/ast"
import "vader/resolver/symbol"
import "vader/types"

import "vader/diagnostics"
import "vader/parser"

/// One resolver output entry per source module.
///
/// `symbols` is sorted by name so the dump is stable regardless of decl
/// order. `idents` is span-keyed via `Span.hash()` (the file's FNV hash folded
/// with the start line/column) so body-walk consumers can index per-`IdentExpr`
/// lookups without re-walking the AST.
export ResolvedModule :: struct {
    path:    string
    /// Module's user-declared name (`module "..."`). Used by the lower /
    /// comptime mangling so `## snippet` / `snippet$add` dump stable.
    /// `path` keeps the filesystem identity (folder), since it's the
    /// stable key for cross-module side-tables.
    display_path: string
    /// The module's declarations ; a file's import bindings are in
    /// `import_bindings`.
    symbols: Symbol[]
    /// Every file's import bindings — namespace aliases and renames — in file
    /// order. Two files may each bind the same name ; a binding's span names its
    /// file.
    import_bindings: Symbol[] = []
    idents:  MutableMap<u64, Symbol>
    /// Local Symbol ids minted from `name :: ...` bindings (no `:=`).
    /// Consumed by stmt.vader::check_assign to surface T3041.
    immutable_locals: MutableMap<i32, bool>
    /// Symbols that are an immutable BORROW root: a parameter declared without
    /// `!` once `params_immutable_default` is on, and loop variables over an
    /// immutable iterable. Sibling of `immutable_locals`, which tracks the
    /// orthogonal axis (`::` freezes the binding, not the referent).
    /// Module-level consts are NOT here — they are recognised from
    /// `SymbolKind.Const`, so they need no table and work cross-module.
    immutable_borrows: MutableMap<i32, bool>
    /// Locals and parameters no assignment rebinds (see `ResolvedFile`). Empty
    /// for a module that was not body-walked, which claims nothing.
    rebind_free: MutableSet<i32> = MutableSet<i32> {}
    /// `fn_overloads[name]` carries every Symbol minted for a given
    /// fn name — only one of which lands in `symbols`. The typecheck
    /// dump iterates this to surface every overload.
    fn_overloads: MutableMap<string, Symbol[]!>
    /// `imports_to[sym.id]` follows an ImportBinding symbol to its
    /// concrete exported counterpart. Lets `type_from_expr` resolve
    /// `ParseError` to the real struct symbol on the std/string side
    /// instead of the local import binding. Populated by the
    /// typecheck orchestrator after `wire_imports`.
    imports_to: MutableMap<i32, Symbol>
    /// `alias_types[sym.id]` carries the resolved Type for any
    /// `TypeAlias` symbol (local or imported). Lets `type_from_expr`
    /// expand `Maybe<T>` to `T | null` instead of leaving it as a
    /// placeholder StructType. Populated by the typecheck orchestrator.
    alias_types: MutableMap<i32, Type>
    /// `alias_decls[sym.id]` carries the `TypeAliasDecl` AST node so
    /// `type_from_expr` can substitute the alias's type-params when
    /// instantiated (e.g. `Maybe(i32)` → `i32 | null`).
    alias_decls: MutableMap<i32, TypeAliasDecl>
    /// `type_param_bounds[type_param_sym.id]` → bound TypeExpr (e.g.
    /// `fn[T: Add]` records the `Add` ident here). Consumed by
    /// `field.vader` so `x.method()` on a bounded TypeParam can
    /// dispatch to the trait's declared method.
    type_param_bounds: MutableMap<i32, Expr>
    /// R-code diagnostics emitted during body resolution.
    /// Forwarded to the typecheck CLI's `# Diagnostics` block.
    diags: Diagnostic[]!
    /// `Symbol.id → message` for every decl annotated with
    /// `@deprecated("...")`. `expr.vader` reads this when an
    /// IdentExpr references a deprecated decl and emits W0001.
    deprecated_messages: MutableMap<i32, string>
    /// `namespace_sym.id → field_name → Type` for every `P :: import
    /// "..."` namespace binding. Lets `type_from_expr`'s FieldExpr
    /// arm resolve `P.Decl` in type position without needing
    /// TypedProgram. Populated by the typecheck orchestrator after
    /// `namespace_exports` builds. Holds EXPORTED members only.
    namespace_member_types: MutableMap<i32, MutableMap<string, Type>>
    /// `namespace_sym.id → private-member-name → true` for every
    /// `P :: import "..."` binding : the PRIVATE (non-`export`) members
    /// of the target module. Lets a `P.private` access fire R2008 —
    /// matching the destructured-import check in `wire.vader` — instead
    /// of silently degrading to unresolved. Populated alongside
    /// `namespace_member_types`.
    namespace_private_members: MutableMap<i32, MutableMap<string, bool>>
}

export ResolvedProject :: struct {
    modules: ResolvedModule[]
}

/// Resolve a one-file module on its own : its declarations and the builtins,
/// no prelude and no import followed — the entry unit tests use.
///
/// @param program      the file's program.
/// @param module_path  the module's id, also its display path.
/// @param factory      mints the module's symbols.
export resolve_module :: fn(program: Program, module_path: string, factory: SymbolFactory!) -> ResolvedModule {
    collected :: collect_module_no_index(program, module_path, factory)
    file :: SourceFile {
        .path       = program.file,
        .content    = "",
        .program    = program,
        .id_factory = new_node_id_factory(),
    }
    return resolve_module_files(
        [file],
        module_path,
        module_path,
        factory,
        collected,
        MutableMap<string, LoadedModule> {},
        MutableMap<string, Symbol> {},
    )
}

/// Resolve every file of a module, each in its own scope. The module's
/// declarations are shared by all its files, but a file sees only the imports it
/// wrote (SPEC §"Modules") : its own bindings, and the exports its own wildcard
/// imports bring — R2031 is judged on those alone.
///
/// @param files         the module's source files.
/// @param module_path   the module's id in the project.
/// @param display_path  the module's path as diagnostics show it.
/// @param factory       mints the builtin symbols.
/// @param collected     the module's collected view, one `FileImports` per file.
/// @param name_index    module name → loaded module, to read wildcard targets.
/// @param core_seed     the shared core-prelude seed from `build_core_seed`.
/// @return              the module's resolution, every file's merged.
export resolve_module_files :: fn(
    files: SourceFile[], module_path: string, display_path: string, factory: SymbolFactory!,
    collected: CollectedModule, name_index: MutableMap<string, LoadedModule>,
    core_seed: MutableMap<string, Symbol>,
) -> ResolvedModule {
    builtins :: make_builtin_scope(factory)
    scopes :: MutableMap<string, FileScope> {}
    programs: Program[]!: []
    bindings: Symbol[]!: []
    clashes: Diagnostic[]!: []
    for file in files {
        imports :: file_imports(collected, file.program.file)
        scopes[file.program.file] = FileScope {
            .root      = file_root_scope(builtins, collected, imports, name_index, core_seed),
            .ambiguous = wildcard_ambiguities(name_index, imports.paths, imports.excludes, core_seed),
        }
        programs.push(file.program)
        for [_, binding] in imports.bindings {
            bindings.push(binding)
        }
        clashes.push_all(binding_clashes(collected, imports))
    }
    resolved :: resolve_module_programs(programs, scopes, module_path, factory)
    resolved.diags.push_all(clashes)
    return ResolvedModule {
        .path             = module_path,
        .display_path     = display_path,
        .symbols          = sort_by_name(collected.symbols.values()),
        .import_bindings  = bindings,
        .idents           = resolved.idents,
        .immutable_locals = resolved.immutable_locals,
        .immutable_borrows = resolved.immutable_borrows,
        .rebind_free      = resolved.rebind_free,
        .fn_overloads     = collected.fn_overloads,
        .imports_to       = MutableMap<i32, Symbol> {},
        .alias_types      = MutableMap<i32, Type> {},
        .alias_decls      = MutableMap<i32, TypeAliasDecl> {},
        .type_param_bounds = resolved.type_param_bounds,
        .diags            = resolved.diags,
        .deprecated_messages = MutableMap<i32, string> {},
        .namespace_member_types = MutableMap<i32, MutableMap<string, Type>> {},
        .namespace_private_members = MutableMap<i32, MutableMap<string, bool>> {},
    }
}

/// The imports `file` of the module wrote ; none when the module did not
/// collect that file.
///
/// @param collected  the module's collected view.
/// @param file       a file's path, as its `Program.file` carries it.
export file_imports :: fn(collected: CollectedModule, file: string) -> FileImports {
    for imports in collected.files {
        if imports.file == file {
            return imports
        }
    }
    return FileImports { .file = file }
}

/// The unqualified names a file of the module sees at its top level, each layer
/// over the one before : the builtins, the file's import bindings, the module's
/// own declarations, then — only where nothing else answers — the core prelude
/// and the exports of the file's wildcard imports. A binding never takes the
/// name of a declaration : a module fn keeps it, the import staying an overload
/// reachable by UFCS, and any other clash is R2011 (`binding_clashes`).
///
/// @param builtins    the builtin scope, shared by the module's files.
/// @param collected   the module's collected view.
/// @param imports     the file's imports.
/// @param name_index  module name → loaded module, to read wildcard targets.
/// @param core_seed   the shared core-prelude seed.
export file_root_scope :: fn(
    builtins: MutableMap<string, Symbol>, collected: CollectedModule, imports: FileImports,
    name_index: MutableMap<string, LoadedModule>, core_seed: MutableMap<string, Symbol>,
) -> MutableMap<string, Symbol> {
    root :: MutableMap<string, Symbol> {}
    for [name, sym] in builtins { root[name] = sym }
    for [name, sym] in imports.bindings { root[name] = sym }
    for [name, sym] in collected.symbols { root[name] = sym }
    for [name, sym] in core_seed {
        if root[name] == null {
            root[name] = sym
        }
    }
    seed_wildcard_exports(root, name_index, imports.paths, imports.excludes)
    return root
}

// R2011 for each import binding of a file that takes the name of a module
// declaration other than a fn, in whichever file the declaration sits.
binding_clashes :: fn(collected: CollectedModule, imports: FileImports) -> Diagnostic[] {
    out: Diagnostic[]!: []
    for [name, binding] in imports.bindings {
        declared :: collected.symbols[name] ?? continue
        span :: binding.defined_at ?? continue
        if declared.kind != .Fn {
            out.push(resolver_error(.DuplicateImportBinding, span, "`${name}`"))
        }
    }
    return out
}

sort_by_name :: fn(syms: Symbol[]) -> Symbol[] {
    return sort(syms, (a: Symbol, b: Symbol) -> compare_ascending(a.name, b.name))
}
