// vader/resolver/core_seed — std/core symbol seed for body-walker scopes.
//
// The body-walker (`body.vader`) fires R2006 (unresolved identifier) at
// resolve time. Auto-imported `std/core` names (`Range`, `Display`,
// `Iterator`, `Hash`, …) aren't in any per-module scope unless seeded
// up-front — without this helper, every reference to `Hash` in a generic
// bound would over-fire R2006.
//
// Callers (typecheck orchestrator + CLI resolver-stage) build the seed
// once per project, then pass it to `resolve_module_files`, which folds it
// into the root scope of every file (`file_root_scope`).

module "vader/resolver"

import "std/collections"
import "std/string"
import "vader/resolver/symbol"
import "vader/parser"
import "vader/target"

/// Build the std/core symbol seed once per project. Returns an empty map
/// when std/core isn't part of the load (single-file snippets without
/// stdlib). The seed is merged into the root scope on a "don't shadow
/// user symbols" basis — see `file_root_scope`.
export build_core_seed :: fn(project: LoadedProject) -> MutableMap<string, Symbol> {
    out :: MutableMap<string, Symbol> {}
    // The baked target constants ride in the same seed as `std/core`, and for the
    // same reason: `VADER_OS` has to be reachable from a file that imports
    // nothing, or the "lightweight" half of the target model is a lie. Since the
    // default target landed there is always something to bake, so this is absent
    // only where `std/target` itself is unreachable — a stdlib-less snippet,
    // exactly as `std/core` is. Both leave the seed smaller rather than failing.
    //
    // This puts the NAME in scope. Its TYPE arrives separately, through
    // `typecheck/orchestrate.vader::populate_baked_symbols` — seeding one
    // without the other is what let `VADER_OS` assign to a `string`.
    baked :: project.modules[BAKED_FOLDER]
    if baked is LoadedModule {
        for [name, sym] in baked.collected.symbols {
            out[name] = sym
        }
    }
    core_id :: find_core_module_id(project) ?? return out
    core_loaded :: project.modules[core_id] ?? return out
    for [name, sym] in core_loaded.collected.symbols {
        out[name] = sym
    }
    return out
}

/// Locate `std/core` in the loaded project. Conservative ends-with match
/// so both single-file (`std/core.vader`) and folder-module
/// (`std/core/`) layouts resolve.
export find_core_module_id :: fn(project: LoadedProject) -> string | null {
    for [id, _] in project.modules {
        if id.ends_with("std/core.vader") || id.ends_with("std/core") {
            return id
        }
    }
    return null
}

/// The loaded `std/async` module's id, or null when the program never imports
/// it. Used to resolve `run_async_main` for the implicit async-`main` driver —
/// present exactly when the program pulls in `std/async` (which it must to
/// `sleep`), so a `main` that suspends always finds it.
export find_async_module_id :: fn(project: LoadedProject) -> string | null {
    for [id, _] in project.modules {
        if id.ends_with("std/async.vader") || id.ends_with("std/async") {
            return id
        }
    }
    return null
}

/// Add to `root` the public exports of each module named in `wildcard_paths` —
/// the bare `import "..."` form — so a bare reference to one resolves instead of
/// firing R2006. Fill-empty : a name `root` already binds (a declaration, an
/// import binding, the prelude) keeps its symbol.
///
/// @param root            the file's root scope, filled in place.
/// @param name_index      module-name → LoadedModule, from `module_index_by_name`
///                        (built once per project, so this stays O(1) per path).
/// @param wildcard_paths  the file's wildcard imports (`FileImports.paths`).
/// @param excludes        per-path names dropped by a `{ x as _, y as z }` modifier
///                        list (`FileImports.excludes`) — skipped here.
export seed_wildcard_exports :: fn(
    root: MutableMap<string, Symbol>!, name_index: MutableMap<string, LoadedModule>,
    wildcard_paths: string[], excludes: MutableMap<string, string[]!>,
) -> void {
    for path in wildcard_paths {
        target :: name_index[path] ?? continue
        ex :: excludes[path]
        for [_, sym] in target.collected.symbols {
            if wildcard_exposes(sym, ex) && root[sym.name] == null {
                root[sym.name] = sym
            }
        }
    }
}

/// A wildcard `import "p"` exposes every nameable public export of `p` — fns
/// AND types (struct / enum / trait / alias) AND consts — so `p`'s `Foo` type
/// and `BAR` const land in scope unqualified, not just its functions. The other
/// kinds (import bindings, params, locals, impls, builtins) are never a module's
/// re-exportable surface.
export wildcard_exposable :: fn(k: SymbolKind) = k == .Fn || k == .Struct
    || k == .Enum || k == .Trait || k == .TypeAlias
    || k == .Const

/// True when a wildcard import of `sym`'s module brings `sym` into scope : a
/// public, wildcard-exposable export its modifier list does not drop.
///
/// @param sym      an export of the wildcard-imported module.
/// @param dropped  the names the import's modifier list drops ; null for none.
export wildcard_exposes :: fn(sym: Symbol, dropped: string[] | null) -> bool {
    if !wildcard_exposable(sym.kind) || sym.visibility != .Public {
        return false
    }
    if dropped == null {
        return true
    }
    return !(sym.name in dropped)
}

/// Names that two or more of `wildcard_paths`'s modules both export — the
/// genuine collisions a bare `import "p1"` + `import "p2"` would create. Returns
/// `name -> [module names]` for each such name (≥ 2 providers). The `base` /
/// core prelude is intentionally NOT considered: a core name always wins and is
/// never ambiguous. Consumed by the body-walker, which fires R2031 only when an
/// unqualified reference actually resolves to one of these ambiguous names.
export wildcard_ambiguities :: fn(
    name_index: MutableMap<string, LoadedModule>, wildcard_paths: string[],
    excludes: MutableMap<string, string[]!>,
    base: MutableMap<string, Symbol>,
) -> MutableMap<string, string[]!> {
    providers :: MutableMap<string, string[]!> {}
    if wildcard_paths.len() < 2 {
        return providers
    }
    for path in wildcard_paths {
        target :: name_index[path] ?? continue
        ex :: excludes[path]
        for [_, sym] in target.collected.symbols {
            // A name a `{ x as _ }` / rename modifier dropped isn't provided by
            // this path, so it can't be an ambiguity source here.
            if !wildcard_exposes(sym, ex) { continue }
            // A name the prelude also owns is never ambiguous: the seed is
            // prelude-first fill-empty, so an unqualified reference always binds
            // the core symbol — the wildcard exports are dropped. Skip it so R2031
            // doesn't fire on a reference that unambiguously resolves to the core.
            if base[sym.name] != null { continue }
            lst :: providers[sym.name]
            if lst is null {
                providers[sym.name] = [path]
            } else {
                seen := false
                for p in lst {
                    if p == path { seen = true }
                }
                if !seen {
                    lst.push(path)
                    providers[sym.name] = lst
                }
            }
        }
    }
    out :: MutableMap<string, string[]!> {}
    for [name, mods] in providers {
        if mods.len() >= 2 { out[name] = mods }
    }
    return out
}

/// Index every loaded module by its declared name (`module "..."`) for O(1)
/// import-path → module lookup. Built once per project — mirrors the
/// `module_name -> id` map `wire_imports` hoists, so a per-module
/// `seed_wildcard_exports` doesn't re-scan `project.modules` each call.
export module_index_by_name :: fn(project: LoadedProject) -> MutableMap<string, LoadedModule> {
    out :: MutableMap<string, LoadedModule> {}
    for [_, m] in project.modules { out[m.module.module_name] = m }
    return out
}
