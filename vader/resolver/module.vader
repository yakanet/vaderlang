// vader/resolver/module — module discovery + path resolution.
//
// A `Module` represents one resolved-on-disk unit. Imports resolve by
// *name* against an ordered set of include-path roots (GCC `-I` style),
// never relative to the importing file. SPEC §11 disavows relative imports :
// `import "./foo"` / `import "../foo"` are not a language form and are
// rejected (R2025).
//
//   - `import "std/foo"`  — resolves against the library root `lib/`, which
//     hosts every namespace the toolchain ships (probed next to the
//     executable, then `<cwd>/lib` — see `resolve_sidecar`).
//   - `import "vader/parser"` — a bare name resolved against the project
//     root and each `includePaths` entry, first match wins.
//
// Each candidate path is probed first as a directory (multi-file
// module : every `*.vader` inside contributes), then as a single
// `*.vader` file. The `displayPath` is what shows up in diagnostics
// and dumps — for stdlib this is the raw `std/...` text ; for a project
// module it's the module's declared `module "..."` name.

module "vader/resolver"

import "std/io"
import "std/path"
import "std/sort"
import "std/string"
import "toolchain/ast"
import "vader/parser"

/// `import "std/..."` and stdlib display paths share this prefix.
///
/// ⚠️ A NAME test, and the wrong question for policy: `lib/` hosts every namespace
/// the toolchain ships, so "is this the toolchain's code?" is answered by
/// `library_roots` / `module_from_library` below, which ask where the module came
/// FROM. This constant survives for the places that genuinely mean the `std/`
/// namespace itself.
export STDLIB_PREFIX :: "std/"

/// Project-root marker file. `find_manifest_root` walks up looking
/// for this name to anchor bare-name imports.
export MANIFEST_FILENAME :: "vader.json"

/// Module a project's build driver declares, and the entry shim shares.
///
/// Lives here, not in `vader/cli`, because two passes need it and only one of
/// them may import a front-end: the CLI writes the shim, and the dead-code lint
/// has to know that `DRIVER_ENTRY` in this module is an ENTRY POINT. Without
/// that, `build` reads as unreachable — nothing in the project calls it, since
/// its only caller is a shim that exists solely during a driven build.
export DRIVER_MODULE :: "build"

/// Function a build driver must declare — reserved in `DRIVER_MODULE` the way
/// `main` is reserved in a program, with no decorator involved.
export DRIVER_ENTRY :: "build"

/// Where a driven build's generated modules live, relative to the project root.
///
/// Owned by the resolver because the resolver is what READS them: when this
/// directory exists under the project root, it becomes a merge root
/// (`lazy::IncludePath.merge`), so `vader run` / `test` / `lint` / `dump` and the
/// LSP see generated code exactly as `vader build` does. A build driver writes
/// here (`toolchain/build`), it does not decide the location — the two halves have to
/// agree, and only one of them can be authoritative.
///
/// Under `build/` so a checkout's existing ignore rules already cover it.
export GENERATED_ROOT_DIR :: "build/generated"

/// True when `display_path` falls within the dump scope `scope` — it equals a
/// scope entry or is a submodule of one (`M` or `M/...`). The IR dumps
/// (`dump --stage=…`) render only in-scope modules ; the scope defaults to the
/// entry module's subtree and is overridable with `--module`. This replaced the
/// stdlib-vs-user heuristic : a dump now shows the modules under inspection,
/// treating stdlib and any other dependency uniformly (out of scope by default).
///
/// @param display_path  the module's user-declared name (`module "..."`).
/// @param scope         the in-scope module ids / prefixes.
export module_in_scope :: fn(display_path: string, scope: string[]) -> bool {
    for m in scope {
        if display_path == m { return true }
        if display_path.starts_with("${m}/") { return true }
    }
    return false
}

/// A loaded source file in a module — raw text plus its parsed AST.
/// `id_factory` is the post-parse factory state for this file, threaded
/// to `LoadedModule` so cloned default-method bodies inserted by
/// `materialize.vader` mint IDs in the same namespace as parse-time IDs.
export SourceFile :: struct {
    path:       string
    content:    string
    program:    Program
    id_factory: NodeIdFactory
}

/// Concatenate every file's top-level decls of a (possibly multi-file) module
/// into one `Decl[]`. Single-file modules (the common case) return the file's
/// decls directly — zero-copy, no concat allocation. Shared by the typecheck /
/// lower / comptime "decls of a module" accessors so the concat lives once.
///
/// @param files  the module's source files (`Module.files`).
/// @return       every file's decls in file order ; the sole file's decls
///               verbatim for a single-file module.
export concat_file_decls :: fn(files: SourceFile[]) -> Decl[] {
    if files.len() == 1 { return files[0].program.decls }
    out: Decl[]! = []
    for f in files {
        for d in f.program.decls { out.push(d) }
    }
    return out
}

/// A resolved module : `id` is its canonical absolute root path,
/// `display_path` is what users see in the dump, `module_name` is
/// the declared `module "..."` identifier used as the key for
/// `import "..."` lookups, `files` is every file participating in
/// the module (one for single-file, N for folders).
export Module :: struct {
    id:           string
    display_path: string
    module_name:  string
    root_dir:     string
    files:        SourceFile[]
}

// ---------------------------------------------------------------- discovery

/// Walk up from `start` looking for `MANIFEST_FILENAME`. Returns
/// the containing directory, or null if no manifest is found up to
/// the filesystem root. Used to anchor `import "vader/parser"`
/// style bare-name imports.
export find_manifest_root :: fn(start: string) -> string | null {
    // Accept either a file or a directory as the start point ; for
    // a file, walk-up begins at its parent.
    dir := start
    if exists(dir) {
        if !is_dir(dir) { dir = dir_of(dir) }
    } else {
        dir = dir_of(dir)
    }
    for {
        candidate :: join_path(dir, MANIFEST_FILENAME)
        if exists(candidate) { return dir }
        parent_dir :: dir_of(dir)
        if parent_dir == dir { return null }
        dir = parent_dir
    }
}


// ----------------------------------------------------- source-file loading

export list_vader_files :: fn(root_path: string) -> string[] {
    if !exists(root_path) { return [] }
    if !is_dir(root_path) {
        if root_path.ends_with(".vader") { return [root_path] }
        return []
    }
    raw :: try_read_dir(root_path) ?? return []
    files: string[]! = []
    for name in raw {
        if !name.ends_with(".vader") { continue }
        files.push(join_path(root_path, name))
    }
    return sort(files, (a: string, b: string) -> compare_ascending(a, b))
}

try_read :: fn(path: string) -> string | null {
    result :: read_file_string(path)
    if result is string as s { return s }
    return null
}

try_read_dir :: fn(path: string) -> string[] | null {
    result :: read_dir(path)
    if result is string[] as ss { return ss }
    return null
}

// ---------------------------------------------------------------- path utils

/// Join two path segments with a `/` separator (no normalization).
/// `base` "" yields `seg` unchanged. Doesn't strip trailing `/` from
/// `base` ; callers are expected to pass clean inputs.
export join_path :: fn(base: string, seg: string) -> string {
    // Strip a leading `./` from the relative segment so module ids
    // stay normalised — `from/./mod_a` would render as `## from/./mod_a`
    // in the typecheck dump.
    s :: trim_prefix(seg, "./")
    if base == "" { return s }
    baseb :: base.bytes()
    if baseb[baseb.len() - 1] == '/' {
        return "${base}${s}"
    }
    return "${base}/${s}"
}

/// Directory portion of `path` (everything before the last `/`).
/// Returns "" when no separator is present. Uses `std/path::parent`.
export dir_of :: fn(path: string) -> string { return path.to_path().parent().as_string() }

/// Resolve a resource directory `<base>/subdir` next to the executable, falling
/// back to the bare cwd-relative `subdir`. The sidecar candidate wins only when
/// it holds `marker`. Lets a `dist/` bundle find its stdlib + C runtime next to
/// the binary, while a repo checkout still resolves via the cwd.
///
/// The fallback returns the *relative* `subdir`, never an absolutised cwd path:
/// the resolved root becomes a module-id prefix, and an absolute root reshuffles
/// map-keyed insertion order (the comptime generic-instance collection), drifting
/// snapshots. Relative keeps the historical cwd-relative ids.
export resolve_sidecar :: fn(subdir: string, marker: string) -> string =
    sidecar_root(subdir, marker) ?? subdir

/// The executable-adjacent `<base>/subdir`, or null when it does not hold
/// `marker` — i.e. when the running binary is not part of a bundle.
///
/// Separate from `resolve_sidecar` because the distinction is load-bearing for
/// namespace reservation: a bundle's library root is AUTHORITATIVE (the toolchain
/// put it there, verified by the marker), so it is searched before the project;
/// the bare cwd-relative fallback is a guess, and a project that happens to have
/// its own `lib/` must not have it searched ahead of its own modules. See
/// `loader::project_include_paths`.
export sidecar_root :: fn(subdir: string, marker: string) -> string | null {
    exe_root :: join_path(current_executable_location().dir_of(), subdir)
    if exists(join_path(exe_root, marker)) { return exe_root }
    return null
}

/// Library root, resolved next to the executable (then cwd) — see `resolve_sidecar`.
///
/// `lib/` hosts every namespace the toolchain ships, `std/` among them — it is not
/// the stdlib's own directory, which is why the name says library and not stdlib.
/// The marker is `std/io/io.vader` : `std/io` is a folder module, so the bare
/// `std/io.vader` file no longer exists — a stale marker silently defeated the
/// exe-sidecar branch, forcing every binary onto the `<cwd>/lib` fallback
/// (so a `dist/` bundle could never find its own stdlib unless run from a dir
/// that happened to hold one).
export default_library_root :: fn() = resolve_sidecar("lib", LIBRARY_ROOT_MARKER)

/// Marker proving a candidate directory really is a library root.
export LIBRARY_ROOT_MARKER :: "std/io/io.vader"

/// The bundled library root, or null when the running binary is not bundled.
/// The authoritative half of `default_library_root` — see `sidecar_root`.
export bundled_library_root :: fn() = sidecar_root("lib", LIBRARY_ROOT_MARKER)

/// Every root under which a toolchain-shipped namespace can live, in the order
/// `loader::project_include_paths` searches them.
///
/// Two, not one: a bundle's authoritative `<exe>/lib` and the cwd-relative `lib`
/// a checkout resolves through. A module reached through either is the
/// toolchain's, not the project's.
export library_roots :: fn() -> string[] {
    roots: string[]! = []
    bundled :: bundled_library_root()
    if bundled != null {
        roots.push(bundled)
    }
    roots.push("lib")
    return roots
}

/// True when `m` was loaded from a toolchain-shipped namespace.
///
/// Asks where the module CAME FROM, not what it is called — the question every
/// policy site actually means. `starts_with("std/")` was the old proxy, and it
/// answers "no" for `json` / `toolchain` / `regex` once the library split lands,
/// which would put the toolchain's own code inside a project's lint scope.
///
/// `Module.root_dir` is the providing root joined with the module name, so it
/// carries that root's own form — relative in a checkout, absolute in a bundle,
/// matching `library_roots` on both sides.
///
/// @param m      the loaded module.
/// @param roots  from `library_roots()`, hoisted by callers that loop.
export module_from_library :: fn(m: Module, roots: string[]) -> bool =
    path_from_library(m.root_dir, roots)

/// True when `path` sits under one of `roots`.
///
/// The same question as `module_from_library`, asked of a bare path — which is
/// what an import site has: a `Span` carries its file, but no `Module`.
///
/// @param path   a file or directory path, in the same form as the roots
///               (relative in a checkout, absolute in a bundle).
/// @param roots  from `library_roots()`.
export path_from_library :: fn(path: string, roots: string[]) -> bool {
    for r in roots {
        if r == "" { continue }
        if path == r { return true }
        if path.starts_with("${r}/") { return true }
    }
    return false
}

/// The one module under the library root allowed to import `vader/**` — the
/// build-driver contract, which exists to drive the compiler.
///
/// A driver LINKS the compiler (a hook shares its compilation unit: type indices
/// and atom ids are per-unit), so this cannot be a library that merely reads the
/// language's shapes. `toolchain/span` and `toolchain/ast` are those, and they
/// import nothing from `vader/` — which is what lets a library depend on them.
export DRIVER_CONTRACT_MODULE :: "toolchain/build"

import "json"

/// The loader-relevant fields of a project `vader.json`, read in one pass.
export Manifest :: struct {
    /// Extra module search roots (`includePaths` key), each relative to the
    /// project root. Joined onto the project root and searched (after the
    /// manifest dir itself) by lazy resolution — GCC `-I` style. E.g.
    /// `["lib"]` makes `module "std/io"` resolve at `<root>/lib/std/io`.
    include_paths: string[]
}

/// Read `vader.json` at `project_root` and extract its `includePaths` in one
/// read + parse. Returns an empty `Manifest` when the file is missing /
/// malformed / lacks the field.
///
/// One pass matters : the LSP re-loads the project on every didOpen / didChange,
/// so re-reading + re-parsing the manifest per field would double the I/O.
export read_manifest :: fn(project_root: string) -> Manifest {
    include_paths: string[]! = []
    manifest_path :: join_path(project_root, MANIFEST_FILENAME)
    if !exists(manifest_path) { return Manifest { .include_paths = include_paths } }
    content :: try_read(manifest_path)
    raw :: if content == null { "" } else { content }
    if raw == "" { return Manifest { .include_paths = include_paths } }
    parsed :: parse(raw)
    if parsed is JsonObject as obj {
        entry :: obj.entries["includePaths"]
        if entry is JsonArray as arr {
            for item in arr.items {
                if item is JsonString as s { include_paths.push(s.value) }
            }
        }
    }
    return Manifest { .include_paths = include_paths }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_read_manifest_reads_repo_include_paths :: fn() -> void {
    // Tests run with the repo root as cwd, so `""` joins to `"vader.json"`.
    // The Vader repo declares its library root via `"includePaths": ["lib"]`
    // — guards against a renamed key or a regressed parse silently dropping the
    // search roots (which would break every `std/*` import). It is also the
    // BRIDGE that lets a seed-built binary, whose sidecar probe is baked to the
    // previous layout, resolve against a renamed tree; see docs/BOOTSTRAP.md.
    m :: read_manifest("")
    assert(m.include_paths.len() > 0, "repo manifest lists includePaths")
    found_lib := false
    for p in m.include_paths {
        if p == "lib" { found_lib = true }
    }
    assert(found_lib, "repo includePaths contains `lib`")
}

@test
test_read_manifest_missing_is_empty :: fn() -> void {
    m :: read_manifest("/no/such/project/root")
    assert(m.include_paths.len() == 0, "absent manifest yields no include-paths")
}

@test
test_path_from_library_matches_a_root_and_its_subtree :: fn() -> void {
    roots :: ["lib"]
    assert(path_from_library("lib", roots), "the root itself is the library")
    assert(path_from_library("lib/std/io", roots), "so is anything under it")
    assert(path_from_library("lib/json", roots), "including a namespace beside std/")
}

@test
test_path_from_library_rejects_a_name_that_merely_starts_the_same :: fn() -> void {
    // The trap a bare `starts_with` would fall into: `libre/` is not under `lib/`.
    // The predicate compares PATH segments, so the separator is load-bearing.
    assert(!path_from_library("libre/json", ["lib"]), "`libre/` is a different directory")
    assert(!path_from_library("mylib", ["lib"]), "and so is `mylib`")
}

@test
test_path_from_library_rejects_a_project_path :: fn() -> void {
    // The whole point: a module the PROJECT provides is not the toolchain's, even
    // when it is called something the toolchain also ships.
    assert(!path_from_library("myproject/json", ["lib"]), "a project module is the project's")
}

@test
test_path_from_library_tries_every_root :: fn() -> void {
    // A bundle has two: its own authoritative `<exe>/lib` and the cwd-relative
    // fallback. A module reached through either is the toolchain's.
    roots :: ["/opt/vader/lib", "lib"]
    assert(path_from_library("/opt/vader/lib/std/io", roots), "the bundled root counts")
    assert(path_from_library("lib/std/io", roots), "and so does the fallback")
    assert(!path_from_library("/opt/other/lib/std/io", roots), "an unrelated one does not")
}

@test
test_module_from_library_reads_the_providing_root :: fn() -> void {
    // `Module.root_dir` is the providing root joined with the module name, which
    // is why the predicate can ask where a module came from at all.
    shipped :: Module {
        .id = "lib/json", .display_path = "json", .module_name = "json",
        .root_dir = "lib/json", .files = [],
    }
    theirs :: Module {
        .id = "app/json", .display_path = "json", .module_name = "json",
        .root_dir = "app/json", .files = [],
    }
    assert(module_from_library(shipped, ["lib"]), "loaded from the library root")
    assert(!module_from_library(theirs, ["lib"]), "same NAME, different provenance")
}
