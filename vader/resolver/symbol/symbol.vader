// vader/resolver/symbol — symbol table primitives.
//
// Symbols are minted by the resolver as
// it walks the AST and consumed by every later phase. The MVP carries the
// kind, name, visibility and the source span ; the AST-decl back-reference
// is deferred until typecheck/lower needs it.

module "vader/resolver/symbol"

import "vader/diagnostics"
import "toolchain/ast"
import "toolchain/span"

// SymbolKind values are kept as i32 (rather than an enum) so an empty list
// of new variants can be added without touching every match site. Each kind
// has a stable display name returned by `kind_name`.
export SymbolKind :: enum(i32) {
    Fn,
    Struct,
    Enum,
    Trait,
    Impl,
    TypeAlias,
    Const,
    ImportBinding,
    Param,
    TypeParam,
    Local,
    Binding,
    BuiltinType,
    BuiltinFn,
    Synthetic,
}

export kind_name :: fn(k: SymbolKind) -> string = match k {
    .Fn            -> "fn"
    .Struct        -> "struct"
    .Enum          -> "enum"
    .Trait         -> "trait"
    .Impl          -> "impl"
    .TypeAlias     -> "type-alias"
    .Const         -> "const"
    .ImportBinding -> "import-binding"
    .Param         -> "param"
    .TypeParam     -> "type-param"
    .Local         -> "local"
    .Binding       -> "binding"
    .BuiltinType   -> "builtin-type"
    .BuiltinFn     -> "builtin-fn"
    .Synthetic     -> "synthetic"
}

export Symbol :: struct {
    id:          i32
    kind:        SymbolKind
    name:        string
    /// The module's IDENTITY — its physical folder. Compared for "same module"
    /// tests, and NOT usable as a stable key: it is an absolute path, so it
    /// differs between a checkout, a `dist/` bundle and a staged temp dir.
    module:      string
    /// The module's DECLARED name (`module "vader/types"`). One module resolves
    /// to exactly one folder, so this identifies the same thing as `module`
    /// while staying identical everywhere — which is what a type-intern key
    /// needs. Same split as `Module.id` vs `Module.display_path`.
    module_name: string
    visibility:  Visibility
    defined_at:  Span | null
}

// IDs start at 1 so dumps keyed on the id stay stable.
export SymbolFactory :: struct {
    next: i32 = 1
}

export make :: fn(
        self: SymbolFactory!,
        kind: SymbolKind,
        name: string,
        module: string,
        module_name: string,
        visibility: Visibility,
        defined_at: Span | null
    ) -> Symbol {
    id :: self.next
    self.next = id + 1
    return Symbol {
        .id         = id,
        .kind       = kind,
        .name       = name,
        .module      = module,
        .module_name = module_name,
        .visibility = visibility,
        .defined_at = defined_at,
    }
}
