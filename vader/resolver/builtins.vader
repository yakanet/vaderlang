// vader/resolver/builtins — primitive type symbols + builtin module id.
//
// Primitive type names, but the integers `std/core` declares, are minted as
// `.BuiltinType` symbols in a synthetic `<builtin>` module so the resolver can
// place them at the root of every per-file scope without special-casing a "if
// name is a primitive" branch through the walker.
//
// Order is load-bearing : downstream snapshots embed symbol IDs, and IDs
// are assigned by the factory's `next` counter in the order seen here.
// New primitives append at the end.

module "vader/resolver"

import "std/collections"
import "vader/resolver/symbol"
import "vader/types"

/// Synthetic module id every builtin symbol carries in its `.module` field.
export BUILTIN_MODULE_ID :: "<builtin>"

/// Non-primitive builtin names, minted after the primitives. `Self` is the trait
/// self-type; `type` is the metatype; `Int` the base of a range type
/// (`Int in 0..=23`), never the type of a value.
BUILTIN_EXTRA_NAMES :: ["Self", "type", INT_BASE_NAME]

/// Every builtin type name in mint order: the primitives (`PRIMITIVE_META`), then
/// `Self` / `type` / `Int`; the integers are `std/core`'s. Order is load-bearing:
/// symbol IDs mint in this sequence and are embedded in snapshots, so the two
/// sources are concatenated in a fixed order rather than re-listed here.
builtin_type_names :: fn() -> string[] {
    out: string[]: []
    for m in PRIMITIVE_META {
        out.push(m.name)
    }
    for e in BUILTIN_EXTRA_NAMES { out.push(e) }
    return out
}

/// Build the root scope seed every per-file resolution starts from.
/// Mints one `.BuiltinType` symbol per name, in declaration order so
/// the resulting IDs are stable across implementations.
export make_builtin_scope :: fn(factory: SymbolFactory) -> MutableMap<string, Symbol> {
    out :: MutableMap<string, Symbol> {}
    for name in builtin_type_names() {
        sym :: factory.make(.BuiltinType, name, BUILTIN_MODULE_ID, BUILTIN_MODULE_ID, .Public, null)
        out[name] = sym
    }
    return out
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_builtin_scope_includes_string :: fn() -> void {
    factory :: SymbolFactory {}
    scope :: make_builtin_scope(factory)
    sym :: scope["string"]
    match sym {
        is Symbol -> {
            assert_eq(sym.name, "string")
            assert(sym.kind == .BuiltinType, "string must be BuiltinType")
            assert_eq(sym.module, BUILTIN_MODULE_ID)
        }
        is null -> { assert(false, "string should be in builtin scope") }
    }
}

@test
test_builtin_scope_first_id_is_one :: fn() -> void {
    factory :: SymbolFactory {}
    scope :: make_builtin_scope(factory)
    first :: scope[builtin_type_names()[0]]
    match first {
        is Symbol -> { assert_eq(first.id, 1) }
        is null   -> { assert(false, "the first name should be minted first") }
    }
}

@test
test_builtin_type_names_leave_the_integers_to_std_core :: fn() -> void {
    names :: builtin_type_names()
    assert(!("i32" in names), "std/core declares the integers")
    assert("string" in names && "Self" in names, "the other primitives are builtin")
    assert(!("int" in names), "a numeric type has one name")
}
