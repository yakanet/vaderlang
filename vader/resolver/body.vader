// vader/resolver/body — body-walking resolution.
//
// Extends the top-level decl walker in `resolve.vader` with a full
// scope-tracking walk over fn bodies, blocks, lambdas, for-loops,
// if-is-as bindings, and match patterns. Produces a span-keyed
// `AST.IdentExpr → Symbol` map that downstream consumers (the LSP today,
// the self-host typechecker tomorrow) read instead of re-walking the
// AST themselves.
//
// Scope: only what the LSP semantic-tokens classifier needs. Type
// resolution, generic substitution, impl-block dispatch, and
// decorator validation live in the compiler-grade resolver /
// typechecker, not here. The output here is intentionally a flat
// AST.IdentExpr → Symbol map ; richer per-expr metadata stays in the
// compiler-grade resolver.

module "vader/resolver"

import "std/abort"
import "std/collections"
import "vader/diagnostics"
AST :: import "toolchain/ast"
import "vader/parser"
import "std/string"
import "vader/resolver/symbol"
import "vader/target"
import "toolchain/span"

/// What one file of a module sees at its top level : its root scope, and the
/// names two of its wildcard imports both export (R2031).
export FileScope :: struct {
    root:      MutableMap<string, Symbol>
    ambiguous: MutableMap<string, string[]>
}

/// Why a local may not be rebound (T3041).
export ConstLocal :: enum {
    /// Declared with `::`.
    Declared
    /// The variable of a `for … in`, bound anew each turn.
    LoopVariable
}

/// Resolution output. `idents` keys every resolved `AST.IdentExpr`
/// by its span via `Span.hash()` (the file's FNV hash folded with the start
/// line/column, unique per node). Consumers look up a span to get
/// the bound symbol's kind ; `Variable` is the fallback for un-resolvable
/// idents (the resolver is intentionally lenient — diagnostics are
/// the compiler-grade resolver's job).
export ResolvedFile :: struct {
    /// Every `AST.IdentExpr` reached during the body walk, span-keyed
    /// via `Span.hash()`.
    idents:    MutableMap<u64, Symbol>
    /// Locals nothing may rebind, and why : a `name :: ...` binding, or the
    /// variable of a `for … in`. `name :=` ones don't appear here. Read by
    /// typecheck's check_assign for T3041.
    immutable_locals: MutableMap<i32, ConstLocal>
    /// Locals and parameters no assignment of the file rebinds, `::` or not. Two
    /// reads of one yield the same value — within one iteration, for a `for`
    /// loop variable, which the loop itself advances. A symbol missing here may be
    /// rebound, so an empty set claims nothing.
    rebind_free: MutableSet<i32>
    /// Per `for` statement (keyed by its span's hash), the locals and parameters
    /// an assignment in its body rebinds. A narrowing made before the loop does
    /// not hold inside it for these: the next iteration reads them after the
    /// rebind.
    loop_rebinds: MutableMap<u64, MutableSet<i32>>
    /// Locals and parameters a lambda rebinds while they are declared outside
    /// it. Any call may run that lambda, so a narrowing of one does not survive
    /// a call.
    closure_rebound: MutableSet<i32>
    /// `Symbol.id → bound TypeExpr` for every TypeParam minted with
    /// an explicit `T: Trait` clause. Lets downstream consumers
    /// dispatch trait methods on bounded type parameters.
    type_param_bounds: MutableMap<i32, AST.Expr>
    /// R-code diagnostics emitted during body resolution
    /// (unresolved ident, reserved name, …).
    diags: Diagnostic[]
}

/// Build a `ResolvedFile` for `program`. `top_level_seed` provides
/// names that should resolve in the root scope — typically the
/// module's own top-level symbols + any auto-imported std/core names.
/// Caller-owned so multi-module projects can extend the root scope
/// before walking.
export resolve_program :: fn(
    program: AST.Program, top_level_seed: MutableMap<string, Symbol>,
    module_path: string, factory: SymbolFactory,
) -> ResolvedFile {
    scopes :: MutableMap<string, FileScope> {}
    scopes[program.file] = FileScope {
        .root      = top_level_seed,
        .ambiguous = MutableMap<string, string[]> {},
    }
    return resolve_module_programs([program], scopes, module_path, factory)
}

/// Resolve the files of one module, each against its own scope, since imports
/// are file-scoped. A fn body written in another file — a `@target` body grafted
/// onto a declaration — resolves in the scope of the file it was written in ; its
/// signature stays the declaration's.
///
/// @param programs     the module's files.
/// @param file_scopes  every file of the module, by `Program.file`, → its scope.
/// @param module_path  the module's id in the project.
/// @param factory      mints the locals.
export resolve_module_programs :: fn(
    programs: AST.Program[], file_scopes: MutableMap<string, FileScope>,
    module_path: string, factory: SymbolFactory,
) -> ResolvedFile {
    state :: ResolveState {
        .file_scopes = file_scopes,
        .idents = MutableMap<u64, Symbol> {},
        .immutable_locals = MutableMap<i32, ConstLocal> {},
        .type_param_bounds = MutableMap<i32, AST.Expr> {},
        .mutable_decls = [],
        .reassigned = MutableSet<i32> {},
        .diags = [],
        .scope = new_scope(MutableMap<string, Symbol> {}),
        .module_path = module_path,
        .factory = factory,
        .ambiguous = MutableMap<string, string[]> {},
    }
    for program in programs {
        scope :: file_scopes[program.file] ?? panic("resolver: no scope for `${program.file}`")
        _ :: state.enter_file(scope)
        for d in program.decls {
            state.walk_decl(d)
        }
    }
    state.report_unreassigned_mutables()
    return ResolvedFile {
        .idents = state.idents,
        .immutable_locals = state.immutable_locals,
        .rebind_free = state.rebind_free_locals(),
        .loop_rebinds = state.loop_rebinds,
        .closure_rebound = state.closure_rebound,
        .type_param_bounds = state.type_param_bounds,
        .diags = state.diags,
    }
}

// ---- internal state -------------------------------------------------------

ResolveState :: struct {
    idents:           MutableMap<u64, Symbol>
    immutable_locals: MutableMap<i32, ConstLocal>
    type_param_bounds: MutableMap<i32, AST.Expr>
    /// W0015 candidates, in declaration order — one entry per `:=` statement.
    mutable_decls:    MutableDecl[]
    /// Symbol ids an assignment rebinds. Read once the file is walked.
    reassigned:       MutableSet<i32>
    /// Every local and parameter the walk declared, for `rebind_free_locals`.
    declared_locals:  i32[] = []
    /// The rebinds made inside the `for` statements being walked, in walk order,
    /// so each loop reads the ones its body made. Emptied when the outermost ends.
    rebind_log:       i32[] = []
    loop_depth:       i32 = 0
    loop_rebinds:     MutableMap<u64, MutableSet<i32>> = MutableMap<u64, MutableSet<i32>> {}
    /// The scope's frame count when the walk entered the innermost enclosing
    /// lambda : a name bound below it is declared outside. Null outside any lambda.
    lambda_frame:     i32 | null = null
    closure_rebound:  MutableSet<i32> = MutableSet<i32> {}
    diags:            Diagnostic[]
    scope:            Scope
    module_path:      string
    factory:          SymbolFactory
    /// Names two+ wildcard imports of the file being walked both export
    /// (`name -> modules`). Consulted by `walk_expr` to fire R2031 on an
    /// unqualified reference that resolves to one of them.
    ambiguous:        MutableMap<string, string[]>
    /// Every file of the module → its scope.
    file_scopes:      MutableMap<string, FileScope>
}

// Walk on in `scope`'s file — its root, its ambiguities ; return the scope it
// replaces.
enter_file :: fn(self: ResolveState, scope: FileScope) -> FileScope {
    previous :: FileScope {
        .root      = self.scope.swap_root(scope.root),
        .ambiguous = self.ambiguous,
    }
    self.ambiguous = scope.ambiguous
    return previous
}

mint_local :: fn(self: ResolveState, kind: SymbolKind, name: string, span: Span) -> Symbol {
    if name == "void" {
        self.diags.push(resolver_error(.ReservedName, span, "`${name}`"))
    }
    return self.factory.make(kind, name, self.module_path, self.module_path, .Private, span)
}

// Mint a value binding (`.Local` / `.Param`), warn if it collides with a name
// already in scope, then bind it. Two collisions are flagged (warnings for now,
// per the phased rollout — a later pass may promote them to errors):
//   W0009 — the name is already bound in the CURRENT block (redeclaration).
//   W0008 — it shadows an outer LOCAL or PARAMETER (an enclosing non-root frame).
// A top-level name (root frame, index 0) is intentionally NOT flagged — a local
// may legitimately share a name with a module-level fn/type/const. Narrowing
// binds (`is T as x`, patterns) don't route here : reusing the scrutinee's name
// there is idiomatic, not problematic shadowing.
bind_local_checked :: fn(self: ResolveState, kind: SymbolKind, name: string, span: Span) -> Symbol {
    // `_` is the discard wildcard — many `_` bindings coexist by design
    // (`for _ in …`, `_ :: expr`), so never flag it as a shadow / redeclaration.
    idx :: if name == "_" { -1 } else { self.scope.lookup_frame_index(name) }
    if idx > 0 {
        if idx == self.scope.frame_count() - 1 {
            self.diags.push(warning(.LocalRedeclaration, span, "`${name}`"))
        } else {
            self.diags.push(warning(.LocalShadowsOuter, span, "`${name}`"))
        }
    }
    sym :: self.mint_local(kind, name, span)
    self.scope.bind(name, sym)
    if kind == .Local || kind == .Param {
        self.declared_locals.push(sym.id)
    }
    return sym
}

// ---- decl walkers ---------------------------------------------------------

walk_decl :: fn(self: ResolveState, d: AST.Decl) -> void {
    match d {
        is AST.ImportDecl    -> {}
        is AST.FnDecl        -> { self.walk_fn_decl(d) }
        is AST.StructDecl    -> { self.walk_struct_decl(d) }
        is AST.EnumDecl      -> { self.walk_enum_decl(d) }
        is AST.TraitDecl     -> { self.walk_trait_decl(d) }
        is AST.ImplDecl      -> { self.walk_impl_decl(d) }
        is AST.TypeAliasDecl -> {
            self.scope.push()
            // An alias's bounds are checked, not recorded : nothing enforces them.
            for tp in d.type_params {
                _ :: self.bind_type_param(tp)
                if tp.bound !is null {
                    _ :: self.checked_bound(tp, tp.bound)
                }
            }
            self.walk_opt_expr(d.aliased)
            self.scope.pop()
        }
        is AST.ConstDecl -> {
            self.walk_opt_expr(d.ty)
            self.walk_expr(d.value)
        }
        is AST.AssertDecl -> { self.walk_expr(d.condition) }
    }
}

walk_enum_decl :: fn(self: ResolveState, d: AST.EnumDecl) -> void {
    self.walk_decorators(d.decorators)
    for h in d.header { self.walk_expr(h) }
    for v in d.variants {
        if v.data !is null {
            self.walk_struct_lit_items(v.data)
        }
    }
}

// Bind `tp` in the current scope and walk its bound.
// Bind `tp` in the current scope. Its declaration site is recorded in `idents` : the
// typecheck reads every declared type parameter's symbol from there
// (`record_type_param_symbols`), and so do explicit type arguments and bounds.
bind_type_param :: fn(self: ResolveState, tp: AST.TypeParam) -> Symbol {
    sym :: self.mint_local(.TypeParam, tp.name, tp.span)
    self.idents[tp.span.hash()] = sym
    self.scope.bind(tp.name, sym)
    self.walk_opt_expr(tp.bound)
    return sym
}

// `bind_type_param`, then record the bound the typecheck holds `tp` to.
declare_type_param :: fn(self: ResolveState, tp: AST.TypeParam) -> Symbol {
    sym :: self.bind_type_param(tp)
    bound :: tp.bound ?? return sym
    self.type_param_bounds[sym.id] = self.checked_bound(tp, bound)
    return sym
}

// R2042 on a union in `tp`'s bound : a `null` member belongs where `T` is used, not
// on the bound. Returns the bound to record — the union's other member when `null`
// is all it adds, so the body is checked against what was meant. A comptime value
// parameter's `:` gives its type, not a bound.
checked_bound :: fn(self: ResolveState, tp: AST.TypeParam, bound: AST.Expr) -> AST.Expr {
    if tp.is_comptime_value {
        return bound
    }
    union :: union_in_bound(bound) ?? return bound
    variants :: AST.collect_bitor_variants(union)
    others: AST.Expr[]: []
    for v in variants {
        // A bound spells `null` as a name, not as the literal.
        if v !is AST.IdentExpr || v.name != "null" {
            others.push(v)
        }
    }
    names_null :: others.len() < variants.len()
    hint :: if names_null {
        "put `null` where `${tp.name}` is used instead: `x: ${tp.name} | null`"
    } else {
        "a bound names traits, joined by `&`"
    }
    self.diags.push(resolver_error(.UnionInBound, union.span, "`${tp.name}` — ${hint}"))
    // A union has two members at least : one left means `null` was the other.
    if others.len() == 1 && bound is AST.BinaryExpr && bound.op == .BitOr {
        return others[0]
    }
    return bound
}

// The first `A | B` in `bound`, looking through its `&` chain : `&` binds tighter
// than `|`, so a union sits under an `&` only when parenthesised, `A & (B | C)`.
union_in_bound :: fn(bound: AST.Expr | null) -> AST.BinaryExpr | null {
    if bound !is AST.BinaryExpr {
        return null
    }
    if bound.op == .BitOr {
        return bound
    }
    if bound.op != .BitAnd {
        return null
    }
    left :: union_in_bound(bound.left)
    return if left != null { left } else { union_in_bound(bound.right) }
}

walk_fn_decl :: fn(self: ResolveState, d: AST.FnDecl) -> void {
    self.walk_decorators(d.decorators)
    self.scope.push()
    // Type-params first so the rest of the signature + body sees them.
    for tp in d.type_params {
        self.declare_type_param(tp)
    }
    for p in d.params {
        self.walk_opt_expr(p.ty)
        self.walk_opt_expr(p.default_value)
        sym :: self.bind_local_checked(.Param, p.name, p.span)
        // Persist the param's minted Symbol in `idents` keyed by the
        // param's own span so downstream passes (e.g. comptime fn-body
        // interpreter) can recover the Symbol.id without re-walking
        // the body to find a use-site.
        self.idents[p.span.hash()] = sym
    }
    for contract in d.decorators {
        if !is_contract_decorator(contract.name) {
            continue
        }
        for a in contract.args {
            self.walk_expr(a)
        }
    }
    self.walk_opt_expr(d.return_type)
    match d.body as b {
        is null          -> {}
        is AST.BlockExpr -> { self.walk_body(b) }
    }
    self.scope.pop()
}

// A fn body, in the scope of the file it was written in : a `@target` body
// grafted from a sibling file sees that file's imports, not the declaration's.
// A body whose spans name no file of the module — a trait default cloned into an
// impl, stamped `<clone>:<impl file>` — belongs to the file being walked.
walk_body :: fn(self: ResolveState, body: AST.BlockExpr) -> void {
    written_in :: self.file_scopes[body.span.start.file]
    if written_in == null {
        self.walk_block(body)
        return
    }
    outer :: self.enter_file(written_in)
    self.walk_block(body)
    _ :: self.enter_file(outer)
}

walk_struct_decl :: fn(self: ResolveState, d: AST.StructDecl) -> void {
    self.walk_decorators(d.decorators)
    self.scope.push()
    for tp in d.type_params {
        self.declare_type_param(tp)
    }
    for f in d.fields {
        self.walk_expr(f.ty)
        self.walk_opt_expr(f.default)
    }
    self.scope.pop()
}

walk_trait_decl :: fn(self: ResolveState, d: AST.TraitDecl) -> void {
    self.walk_decorators(d.decorators)
    self.scope.push()
    for tp in d.type_params {
        self.declare_type_param(tp)
    }
    self.walk_opt_expr(d.requires)
    union :: union_in_bound(d.requires)
    if union != null {
        detail :: "`${d.name}` — a trait requires traits, joined by `&`"
        self.diags.push(resolver_error(.UnionInBound, union.span, detail))
    }
    for m in d.members { self.walk_fn_decl(m) }
    self.scope.pop()
}

walk_impl_decl :: fn(self: ResolveState, d: AST.ImplDecl) -> void {
    self.walk_decorators(d.decorators)
    self.scope.push()
    for tp in d.type_params {
        self.declare_type_param(tp)
    }
    // Auto-bind type params from `for_type` when the impl head
    // omits the explicit `[T]` block (e.g. `Stack<T> implements
    // Trait<T>` without `implements<T> Trait<T>`). The args of a
    // generic for_type that look like fresh idents become TypeParams.
    self.auto_bind_for_type_params(d.for_type)
    self.walk_expr(d.for_type)
    for ta in d.trait_args { self.walk_expr(ta) }
    // The symbol the trait name binds to — a local trait, or an import — so later
    // passes follow the binding instead of looking the name up again. A name the
    // scope doesn't bind stays unrecorded: R2007 / R2009 on it come from the
    // short-impl pass that runs before this walk
    // (`vader/typecheck/orchestrate.vader::materialize_all_sams_pre_resolve`).
    trait_sym :: self.scope.lookup(d.trait_name)
    if trait_sym != null {
        self.idents[d.trait_name_span.hash()] = trait_sym
        self.check_wildcard_ambiguity(d.trait_name, d.trait_name_span, trait_sym)
    }
    // Skip only SAM short-impl synthetics — their body is the user's
    // expression and their params never got minted, so walking would
    // cascade R2006 on `self`. Default-method clones are also
    // `materialized` but carry proper substituted params, so the
    // resolver must walk them to bind `self` and resolve `self.next()`.
    for m in d.members {
        if m.materialized && m.sam_synthetic { continue }
        self.walk_fn_decl(m)
    }
    self.scope.pop()
}

auto_bind_for_type_params :: fn(self: ResolveState, t: AST.TypeExpr) -> void {
    if !(t is AST.GenericInstExpr) { return }
    for arg in t.type_args {
        if arg is AST.IdentExpr {
            if self.scope.lookup(arg.name) is null {
                sym :: self.mint_local(.TypeParam, arg.name, arg.span)
                self.scope.bind(arg.name, sym)
            }
        }
    }
}

walk_decorators :: fn(self: ResolveState, decs: AST.Decorator[]) -> void {
    for d in decs {
        if !is_known_decorator(d.name) {
            self.diags.push(resolver_error(.UnknownDecorator, d.span, "`@${d.name}`"))
        }
        // `@target`'s arguments are TARGET SELECTORS, not expressions. They name
        // an OS from a closed set and are compared syntactically — the selection
        // happens before any name resolution, so there is no scope in which
        // `.Windows` could be looked up, and walking it as an expression would
        // report "cannot infer enum type from context" for a construct that is
        // not an enum literal at all.
        if d.name == "target" {
            self.check_target_selectors(d)
            continue
        }
        // The condition of `@returns` and `@ensures` reads the parameters :
        // `walk_fn_decl` walks it once they are bound.
        if is_contract_decorator(d.name) {
            continue
        }
        for a in d.args { self.walk_expr(a) }
    }
}

// Each argument must be `.Os` for a known OS. Anything else — a misspelling, an
// expression, a bare identifier — is R2035, named rather than left to surface as
// an unresolved identifier three passes later.
check_target_selectors :: fn(self: ResolveState, d: AST.Decorator) -> void {
    for a in d.args {
        match a {
            is AST.DotVariantExpr -> {
                if parse_os(a.variant.to_lower()) == null {
                    self.diags.push(resolver_error(.UnknownTargetSelector, a.span,
                        "`.${a.variant}` names no operating system"))
                }
            }
            _ -> {
                self.diags.push(resolver_error(.UnknownTargetSelector, a.span,
                    "expected a target selector such as `.Windows`"))
            }
        }
    }
}

// Whether `name` is a decorator stating a contract over a fn's parameters.
is_contract_decorator :: fn(name: string) -> bool = name == "returns" || name == "ensures"

/// Whitelist of known decorators.
/// Update when SPEC §12 grows a new decorator.
is_known_decorator :: fn(name: string) -> bool {
    return name == "comptime"
        || name == "extern"
        || name == "export"
        || name == "test"
        || name == "intrinsic"
        || name == "deprecated"
        || name == "assert"
        || name == "no_return"
        || name == "allow_unused"
        || name == "target"
        || name == "c_header"
        || name == "c_pointer"
        || name == "c_out"
        || name == "c_struct"
        || name == "c_variadic"
        || name == "displayable"
        || name == "singleton"
        || name == "returns"
        || name == "ensures"
}

walk_opt_expr :: fn(self: ResolveState, e: AST.Expr | null) -> void {
    if e !is null {
        self.walk_expr(e)
    }
}

// ---- stmt + block walkers -------------------------------------------------

walk_block :: fn(self: ResolveState, b: AST.BlockExpr) -> void {
    self.scope.push()
    for s in b.stmts { self.walk_stmt(s) }
    self.walk_opt_expr(b.trailing)
    self.scope.pop()
}

walk_stmt :: fn(self: ResolveState, s: AST.Stmt) -> void {
    match s {
        is AST.LetStmt               -> { self.walk_let(s) }
        is AST.AssignStmt            -> {
            self.walk_expr(s.target)
            self.walk_expr(s.value)
            self.note_rebind(s.target)
        }
        is AST.DestructureAssignStmt -> {
            for place in AST.assign_places(s) {
                self.walk_expr(place)
                self.note_rebind(place)
            }
            self.walk_expr(s.value)
        }
        is AST.ExprStmt              -> { self.walk_expr(s.expr) }
        is AST.ReturnStmt            -> { self.walk_opt_expr(s.value) }
        is AST.YieldStmt             -> { self.walk_expr(s.value) }
        is AST.ForStmt               -> { self.walk_for(s) }
        is AST.BreakStmt             -> {}
        is AST.ContinueStmt          -> {}
        is AST.DeferStmt             -> { self.walk_defer(s) }
    }
}

walk_let :: fn(self: ResolveState, s: AST.LetStmt) -> void {
    self.walk_opt_expr(s.ty)
    self.walk_expr(s.value)
    bound: Symbol[]: []
    self.bind_let_binding(s.binding, bound)
    if !s.mutable {
        for sym in bound {
            self.immutable_locals[sym.id] = .Declared
        }
    } else if bound.len() > 0 {
        // `_ := f()` binds nothing, so there is no name to name.
        self.mutable_decls.push(MutableDecl { .syms = bound, .span = binding_span(s.binding) })
    }
}

// A `for … in` variable : a constant binding the loop alone gives a value each
// turn, declared by no operator, so never a W0015 candidate.
declare_loop_local :: fn(self: ResolveState, sym: Symbol) -> void {
    self.immutable_locals[sym.id] = .LoopVariable
}

walk_defer :: fn(self: ResolveState, d: AST.DeferStmt) -> void {
    match d.body as x {
        is AST.DeferStmtBody  -> { self.walk_stmt(x.stmt) }
        is AST.DeferBlockBody -> { self.walk_block(x.block) }
    }
}

// `out` receives every Symbol minted, in binding order. `walk_let` marks them
// immutable (`::`) or groups them into one W0015 candidate (`:=`), and `walk_for`
// marks them loop variables, so no caller walks the binding tree a second time to
// look the names back up.
bind_let_binding :: fn(self: ResolveState, b: AST.LetBinding, out: Symbol[]) -> void {
    match b {
        is AST.SimpleBinding -> {
            sym :: self.bind_local_checked(.Local, b.name, b.name_span)
            // Park the Symbol against the binding's name_span so
            // downstream passes (typecheck → let_type_aliases stash,
            // lower → ident-to-binding lookup) can recover the
            // local's Symbol.id without re-walking the body's scope.
            // Mirrors the Param / TypeParam pattern at the top of
            // this file (mint then index into `idents`).
            self.idents[b.name_span.hash()] = sym
            out.push(sym)
        }
        is AST.TupleBinding -> {
            for e in b.elements { self.bind_let_binding(e, out) }
        }
        is AST.WildcardBinding -> {}
        is AST.RestBinding -> {
            sym :: self.bind_local_checked(.Local, b.name, b.span)
            self.idents[b.span.hash()] = sym
            out.push(sym)
        }
    }
}

walk_for :: fn(self: ResolveState, s: AST.ForStmt) -> void {
    match s.form as form {
        is AST.InfiniteFor -> {}
        is AST.WhileFor    -> { self.walk_expr(form.cond) }
        is AST.InFor       -> { self.walk_expr(form.iter) }
    }
    self.scope.push()
    match s.form as f {
        is AST.InFor                      -> {
            match f.loop_var as nv {
                // `for [k, v] in …` binds each pattern leaf ; `for x in …` binds
                // the single var ; `for <range>` (DiscardVar) binds nothing.
                // The minted Symbol is recorded in `idents` under the loop var's own
                // span, as a fn param's is, so a later pass reaches it without
                // re-walking the body to find a use site.
                is AST.NamedVar       -> {
                    sym :: self.bind_local_checked(.Local, nv.name, nv.span)
                    self.idents[nv.span.hash()] = sym
                    self.declare_loop_local(sym)
                }
                is AST.DestructureVar -> {
                    bound: Symbol[]: []
                    self.bind_let_binding(nv.pattern, bound)
                    for sym in bound {
                        self.declare_loop_local(sym)
                    }
                }
                is AST.DiscardVar     -> {}
            }
        }
        // Neither header form binds a name; only `for x in …` does.
        is AST.InfiniteFor | AST.WhileFor -> {}
    }
    first_rebind :: self.rebind_log.len()
    self.loop_depth += 1
    self.walk_block(s.body)
    self.loop_depth -= 1
    self.scope.pop()
    if self.rebind_log.len() > first_rebind {
        rebinds :: MutableSet<i32> {}
        for i in first_rebind..<self.rebind_log.len() {
            rebinds.add(self.rebind_log[i])
        }
        self.loop_rebinds[s.span.hash()] = rebinds
    }
    if self.loop_depth == 0 {
        self.rebind_log.clear()
    }
}

// ---- W0015 : a `:=` nothing reassigns -------------------------------------

/// One `name := …` declaration awaiting proof that it is ever reassigned.
///
/// The unit is the DECLARATION, not the name: `[a, b] := pair` carries a single
/// `:=` for both, so reassigning either one justifies it.
MutableDecl :: struct {
    syms: Symbol[]
    span: Span
}

// Record what an assignment target rebinds : for W0015, for the loops around it
// (`loop_rebinds`) and for the lambda it sits in (`closure_rebound`).
//
// A bare name as the WHOLE target is the form that rebinds it; `x.f = 1` and
// `x[0] = 1` mutate what `x` designates, which a `::` local allows, so counting
// them would demand `:=` where `::` is right. Each place of a `[a, ...b] = v`
// goes through here too, so a destructuring assignment rebinds its bare names.
//
// The mirror check reads the same `idents` table the same way, one pass later:
// `typecheck/stmt.vader::const_reassign_detail`, which rejects rebinding a `::`
// local or a module constant.
note_rebind :: fn(self: ResolveState, target: AST.Expr) -> void {
    if target is AST.IdentExpr {
        sym :: self.idents[target.span.hash()] ?? return
        _ :: self.reassigned.add(sym.id)
        if self.loop_depth > 0 {
            self.rebind_log.push(sym.id)
        }
        // `add` reports whether the id was new; as the `if`'s last expression a
        // bare call would make this `void` body return `bool | void`.
        if self.declared_outside_lambda(target.name) {
            _ :: self.closure_rebound.add(sym.id)
        }
    }
}

// Whether the walk is inside a lambda that did not declare `name`.
declared_outside_lambda :: fn(self: ResolveState, name: string) -> bool {
    frame :: self.lambda_frame ?? return false
    return self.scope.lookup_frame_index(name) < frame
}

// Where W0015 points: the whole `[a, b]` for a destructure, since the warning's
// unit is the declaration. That is what `Symbol.defined_at` cannot give — it
// carets the first leaf — so this is not a re-derivation of it. Each variant
// names the field the mint site used, and is spelled out because a common-field
// read on a bare union takes a FIXED offset.
binding_span :: fn(b: AST.LetBinding) -> Span = match b {
    is AST.SimpleBinding   -> b.name_span
    is AST.TupleBinding    -> b.span
    is AST.RestBinding     -> b.span
    is AST.WildcardBinding -> b.span
}

// Every local and parameter the file declares that no assignment rebinds.
rebind_free_locals :: fn(self: ResolveState) -> MutableSet<i32> {
    out :: MutableSet<i32> {}
    for id in self.declared_locals {
        if !(id in self.reassigned) {
            _ :: out.add(id)
        }
    }
    return out
}

// W0015 — every `:=` nothing ever reassigned. Reported at the end of the file
// rather than at each `scope.pop()`, which the scope stack would also allow:
// it is the cheaper seam, and `render_diagnostics` sorts by offset, so push
// order never reaches the user.
report_unreassigned_mutables :: fn(self: ResolveState) -> void {
    for d in self.mutable_decls {
        if self.has_reassignment(d.syms) {
            continue
        }
        names: string[]: []
        for sym in d.syms {
            names.push(sym.name)
        }
        joined :: names.join("`, `")
        self.diags.push(warning(.MutableNeverReassigned, d.span, "`${joined}`"))
    }
}

has_reassignment :: fn(self: ResolveState, syms: Symbol[]) -> bool {
    for sym in syms {
        if sym.id in self.reassigned {
            return true
        }
    }
    return false
}

// ---- expr walkers ---------------------------------------------------------

// R2031 — an unqualified reference `x` that resolves, through the wildcard seed,
// to a name TWO+ bare-imported modules both export. `s.module == module_path`
// means the reference bound to a local / param / this module's own decl / a
// destructure import (all same-module) — those shadow the wildcard and are
// unambiguous. A cross-module `s` whose name is in `ambiguous` is the real clash.
check_wildcard_ambiguity :: fn(self: ResolveState, name: string, span: Span, s: Symbol) -> void {
    if s.module == self.module_path { return }
    mods :: self.ambiguous[name] ?? return
    list := ""
    for i in 0..<mods.len() {
        if i > 0 { list = list + ", " }
        list = list + mods[i]
    }
    self.diags.push(resolver_error(.AmbiguousWildcardImport, span,
        "`${name}` is exported by ${list} — qualify it with a namespace import (`Ns :: import \"…\"` then `Ns.${name}`) or destructure the one you mean"))
}

walk_expr :: fn(self: ResolveState, e: AST.Expr) -> void {
    match e {
        is AST.IdentExpr -> {
            v :: self.scope.lookup(e.name)
            match v {
                is Symbol -> {
                    self.idents[e.span.hash()] = v
                    self.check_wildcard_ambiguity(e.name, e.span, v)
                }
                // R2006 — the root scope must carry the core prelude
                // (`build_core_seed`, folded in by `file_root_scope`) ;
                // otherwise bare references to `Range`, `Display`,
                // `Iterator`, … would over-fire here.
                is null   -> {
                    self.diags.push(resolver_error(.UnresolvedIdent, e.span, "`${e.name}`"))
                }
            }
        }
        is AST.CallExpr -> {
            self.walk_expr(e.callee)
            for t in e.type_args { self.walk_expr(t) }
            for a in e.args { self.walk_expr(a.value) }
        }
        is AST.FieldExpr -> { self.walk_expr(e.target) }
        is AST.IndexExpr -> {
            self.walk_expr(e.target)
            self.walk_expr(e.index)
        }
        is AST.UnaryExpr -> { self.walk_expr(e.operand) }
        is AST.BinaryExpr -> {
            self.walk_expr(e.left)
            self.walk_expr(e.right)
        }
        is AST.NullCoalesceExpr -> {
            self.walk_expr(e.left)
            match e.fallback as fallback {
                is AST.ReturnStmt | AST.BreakStmt | AST.ContinueStmt -> { self.walk_stmt(fallback) }
                is AST.Expr -> { self.walk_expr(fallback) }
            }
        }
        is AST.IfExpr -> { self.walk_if(e) }
        is AST.MatchExpr -> { self.walk_match(e) }
        is AST.BlockExpr -> { self.walk_block(e) }
        is AST.LambdaExpr -> { self.walk_lambda(e) }
        is AST.StructLitExpr -> { self.walk_struct_lit(e) }
        is AST.SeqLitExpr -> { for it in e.elements { self.walk_expr(it) } }
        is AST.RangeExpr -> {
            self.walk_expr(e.lower)
            self.walk_expr(e.upper)
        }
        is AST.AwaitExpr -> { self.walk_expr(e.inner) }
        is AST.CastExpr -> {
            self.walk_expr(e.value)
            self.walk_expr(e.target)
        }
        is AST.GenericInstExpr -> {
            self.walk_expr(e.callee)
            for a in e.type_args { self.walk_expr(a) }
        }
        is AST.IntrinsicCallExpr -> { for a in e.args { self.walk_expr(a) } }
        is AST.DotVariantExpr -> {}
        is AST.FnTypeExpr -> {
            for p in e.params { self.walk_expr(p) }
            self.walk_opt_expr(e.return_type)
        }
        is AST.ArrayTypeExpr -> { self.walk_expr(e.element) }
        is AST.IntLitExpr -> {}
        is AST.FloatLitExpr -> {}
        is AST.BoolLitExpr -> {}
        is AST.NullLitExpr -> {}
        is AST.CharLitExpr -> {}
        is AST.StringLitExpr -> {
            for part in e.parts {
                match part {
                    is AST.StringLitInterp -> { self.walk_expr(part.expr) }
                    _ -> {}
                }
            }
        }
    }
}

walk_if :: fn(self: ResolveState, e: AST.IfExpr) -> void {
    // Push a scope spanning the condition + then-block so `is T as a`
    // bindings — minted left-to-right by `bind_cond_is_as` — resolve in any
    // later `&&` operand and in the then-block. The else / post-if scopes
    // don't see them (the bind only holds when the test is true). Mirrors
    // `bind_pattern`'s IsPattern path.
    self.scope.push()
    self.bind_cond_is_as(e.cond, false)
    self.walk_block(e.then_block)
    self.scope.pop()
    match e.else_branch as x {
        is null            -> {}
        is AST.IfElseIf    -> { self.walk_if(x.branch) }
        is AST.IfElseBlock -> { self.walk_block(x.block) }
    }
}

// Walk an if-condition, resolving its sub-expressions and minting any
// `is T as a` binding into the current scope BEFORE the parts that use it
// (later `&&` operands, the then-block). An `as` binding inside a `&&` is
// rejected (R2029) — its scope across short-circuit operands is ambiguous —
// but still minted so the use doesn't cascade into a spurious R2006.
bind_cond_is_as :: fn(self: ResolveState, cond: AST.Expr, in_conjunction: bool) -> void {
    if cond is AST.BinaryExpr {
        if cond.op == .And {
            self.bind_cond_is_as(cond.left, true)
            self.bind_cond_is_as(cond.right, true)
            return
        }
        if cond.op == .Is {
            self.walk_expr(cond.left)
            self.walk_expr(cond.right)
            alias :: cond.bind_as
            if alias != null {
                if in_conjunction {
                    self.diags.push(resolver_error(.AsBindingInConjunction, alias.span,
                        "an `as` binding cannot appear in a `&&` condition ; narrow the variable in place (`if x is T && …`) or nest the checks (`if x is T as a { if … }`)"))
                }
                sym :: self.mint_local(.Binding, alias.name, alias.span)
                self.scope.bind(alias.name, sym)
                self.idents[alias.span.hash()] = sym
            }
            return
        }
    }
    self.walk_expr(cond)
}

walk_match :: fn(self: ResolveState, e: AST.MatchExpr) -> void {
    self.walk_expr(e.scrutinee)
    // `match e as x { … }` — one scope around every arm, minted AFTER the
    // scrutinee is walked so `x` cannot refer to itself. Registered in `idents`
    // at the `x` token so the type-checker can find the symbol from the
    // MatchExpr alone (mirrors the param / type-param declarations above).
    self.scope.push()
    alias :: e.bind_as
    if alias != null {
        sym :: self.mint_local(.Binding, alias.name, alias.span)
        self.scope.bind(alias.name, sym)
        self.idents[alias.span.hash()] = sym
    }
    for arm in e.arms {
        self.scope.push()
        self.bind_pattern(arm.pattern)
        self.walk_opt_expr(arm.guard)
        self.walk_expr(arm.body)
        self.scope.pop()
    }
    self.scope.pop()
}

bind_pattern :: fn(self: ResolveState, p: AST.Pattern) -> void {
    match p {
        is AST.IsPattern -> {
            self.walk_expr(p.ty)
            if p.inner !is null {
                self.bind_pattern(p.inner)
            }
        }
        is AST.StructPattern -> {
            for f in p.fields {
                match f.value as lit {
                    is AST.PatternBinding -> {
                        sym :: self.mint_local(.Binding, f.name, f.name_span)
                        self.scope.bind(f.name, sym)
                        self.idents[f.name_span.hash()] = sym
                    }
                    is AST.PatternLiteral -> { self.walk_expr(lit.value) }
                }
            }
        }
        is AST.WildcardPattern -> {}
        is AST.EnumVariantPattern -> {}
        is AST.LiteralPattern -> { self.walk_expr(p.value) }
        is AST.RangePattern -> {
            self.walk_expr(p.lower)
            self.walk_expr(p.upper)
        }
        is AST.OrPattern -> { for alt in p.patterns { self.bind_pattern(alt) } }
    }
}

walk_lambda :: fn(self: ResolveState, l: AST.LambdaExpr) -> void {
    enclosing_lambda_frame :: self.lambda_frame
    self.lambda_frame = self.scope.frame_count()
    self.scope.push()
    for p in l.params {
        self.walk_opt_expr(p.ty)
        sym :: self.bind_local_checked(.Param, p.name, p.span)
        // Persist the param's Symbol in `idents` at its def-site (mirror
        // `walk_fn_decl`) so the lambda-lifter (`lambda_params`) recovers
        // it even when the body never references the param. Without this, an
        // unused lambda param is dropped from the lifted fn, whose arity then
        // mismatches the closure's `[env +] params` calling convention at
        // `call.indirect` (VM trap ; native miscompile).
        self.idents[p.span.hash()] = sym
    }
    self.walk_opt_expr(l.return_type)
    self.walk_block(l.body)
    self.scope.pop()
    self.lambda_frame = enclosing_lambda_frame
}

walk_struct_lit :: fn(self: ResolveState, s: AST.StructLitExpr) -> void {
    self.walk_expr(s.type_name)
    self.walk_struct_lit_items(s.items)
}

walk_struct_lit_items :: fn(self: ResolveState, items: AST.StructLitItem[]) -> void {
    for it in items {
        if it is AST.StructLitField {
            self.walk_expr(it.value)
        } else {
            self.walk_expr(it.expr)
        }
    }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// A zero-width span at `(line, column)` in `file` — enough for `Span.hash()`,
// which reads only `start.file` / `start.line` / `start.column`.
span_at :: fn(file: string, line: i32, column: i32) -> Span {
    pos :: Position { .file = file, .offset = 0, .line = line, .column = column }
    return Span { .start = pos, .end = pos }
}

@test
test_resolver_resolves_local :: fn() -> void {
    src :: """
main :: fn() -> i32 {
    x :: 42
    return x
}
"""
    parsed :: parse_source(src, "test.vader")
    factory :: SymbolFactory {}
    seed :: MutableMap<string, Symbol> {}
    resolved :: resolve_program(parsed.program, seed, "test", factory)
    hit :: resolved.idents[span_at("test.vader", 3, 12).hash()]
    match hit {
        is Symbol -> {
            assert_eq(hit.name, "x")
            assert(hit.kind == .Local, "should resolve to a Local")
        }
        is null -> {
            assert(false, "expected to find resolution for x at 3:12")
        }
    }
}

@test
test_resolver_resolves_param :: fn() -> void {
    //language=vader
    src :: """
f :: fn(x: i32) -> i32 {
    return x
}
"""
    parsed :: parse_source(src, "test.vader")
    factory :: SymbolFactory {}
    seed :: MutableMap<string, Symbol> {}
    resolved :: resolve_program(parsed.program, seed, "test", factory)
    hit :: resolved.idents[span_at("test.vader", 2, 12).hash()]
    match hit {
        is Symbol -> {
            assert(hit.kind == .Param, "should resolve to a Param")
        }
        is null -> {
            assert(false, "expected to find resolution for x at 2:12")
        }
    }
}
