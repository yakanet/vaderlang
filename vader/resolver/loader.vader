// vader/resolver/loader — module graph loader.
//
// Seeds the entry module from its own folder, then BFS-walks the import graph,
// resolving each import lazily by path-mapping against the include-paths
// (`lazy.vader`) — no up-front filesystem scan. Each visited module pays a full
// `parse_source` once. Load order is the import BFS, so symbol-id assignment is
// independent of discovery.
//
// Include-paths (search order, first match wins ; GCC `-I` style) :
//   - the entry folder, rooted at its declared module name ;
//   - the manifest dir + each `vader.json includePaths` entry (project modules
//     + stdlib) when a manifest is found ;
//   - the binary-adjacent stdlib default (so a deployed binary finds its
//     bundled stdlib).

module "vader/resolver"

import "std/collections"
import "std/io"
import "std/path"
import "vader/diagnostics"
import "toolchain/ast"
import "vader/parser"
import "vader/resolver/symbol"
import "vader/target"
import "toolchain/span"

/// Synthetic 1:1 span anchored on a file path. Used by R2001 when the
/// entry folder lies outside every scoped root — there is no source-
/// level token to point at, so the span just records the file.
///
/// TODO consolidate with `vader/lexer/token::empty_span(file)` and
/// `vader/diagnostics::empty_span()` (no-arg, synthetic file). Same
/// shape, three callers, no shared definition — Vader's overload
/// resolution picks the no-arg variant when both are in scope which
/// blocks naive reuse. Land a single `empty_span(file: string)` in
/// `vader/diagnostics/` and migrate every caller.
zero_span :: fn(path: string) = Span {
    .start = Position { .file = path, .offset = 0, .line = 1, .column = 1 },
    .end   = Position { .file = path, .offset = 0, .line = 1, .column = 1 },
}

/// Output of one project load : the entry module's id, the full set
/// of modules keyed by id, and the shared symbol factory used to
/// mint every Symbol across modules (so ids stay globally unique).
///
/// `diags` collects loader-time diagnostics : R2020/R2022/R2023 from
/// discover, R2001/R2024/R2025/R2028 from import-path resolution,
/// R2002/R2004/R2011 from collect, R2005 from cycle detection. CLI
/// consumers merge these into their `# Diagnostics` block.
export LoadedProject :: struct {
    entry:        string
    modules:      MutableMap<string, LoadedModule>
    factory:      SymbolFactory
    project_root: string | null
    diags:        Diagnostic[]!
}

/// Empty placeholder — used by test fixtures that construct downstream
/// project contexts without going through `load_project`.
export empty_loaded_project :: fn() -> LoadedProject {
    return LoadedProject {
        .entry        = "",
        .modules      = MutableMap<string, LoadedModule> {},
        .factory      = SymbolFactory {},
        .project_root = null,
        .diags        = [],
    }
}

/// One module after parse + collect (top-level symbols minted but
/// body-walker / typecheck haven't run yet). `node_id_factory` is
/// shared with `materialize.vader` so cloned default-method bodies
/// inserted into this module's impls get IDs that don't collide
/// with the IDs minted at parse time.
export LoadedModule :: struct {
    module:          Module
    collected:       CollectedModule
    node_id_factory: NodeIdFactory
    /// Bodies target selection dropped. Kept so W0007 can still see what they
    /// referenced: a helper called only from another platform's body is not dead
    /// code, and reporting it as such is a false positive on exactly the code
    /// this mechanism exists to enable.
    discarded_bodies: AST.FnDecl[] = []
}

/// Build the module graph rooted at `entry_path`. Returns the loaded
/// project ; callers feed it to `resolve_project` / `check_project`.
/// Reads every module from disk.
export load_project :: fn(
    entry_path: string, include_path_flags: string[], selection: Selection | null = null,
) -> LoadedProject {
    return load_project_with_overlay(
        entry_path, MutableMap<string, string> {}, include_path_flags, selection)
}

/// Like `load_project`, but consults an in-memory `overlay` (filesystem path
/// → current source text) before the disk for every module file. The LSP
/// passes its didOpen/didChange buffer so typed features (hover, diagnostics,
/// …) reflect unsaved edits instead of the last-saved file ; the CLI calls
/// `load_project` (empty overlay, disk-only).
///
/// Scope: the overlay is consulted only by the loader's *content* read
/// (`parse_module_files`), NOT by module *discovery* (`discover.vader`, which
/// scans the disk via `read_dir` + a header-only `read_file`). So an unsaved
/// edit to a SAVED file's body is reflected, but (a) a never-saved file is not
/// enumerated, and (b) an unsaved edit to a file's `module "..."` header is
/// bucketed by the stale on-disk header. Threading the overlay into discovery
/// (both the dir enumeration and the header read) is a follow-up.
///
/// @param entry_path  the entry file's path.
/// @param overlay     filesystem path → current source text ; consulted
///                    before the disk in `parse_module_files`.
export load_project_with_overlay :: fn(
    entry_path: string, overlay: MutableMap<string, string>,
    include_path_flags: string[], selection: Selection | null = null,
) -> LoadedProject {
    factory :: SymbolFactory {}
    // ONE node-id factory for the whole project so AST node ids are globally
    // unique across modules (see `parse_module_files`). Threaded into every
    // module's parse + carried as each module's `node_id_factory`.
    node_factory :: new_node_id_factory()
    // Windows hands the entry path with `\` separators ; the resolver keeps `/`
    // as its single internal separator (join_path, the module index, std/path
    // are all `/`-based), so normalise once at this boundary. POSIX paths are
    // unchanged. Everything downstream derives the entry folder + manifest root
    // from this normalised form.
    entry :: entry_path.to_posix()
    // Resolved ONCE, here, before anything loads: selection has to see the same
    // target in every module, and defaulting at each entry point instead would
    // mean every command remembering to ask. `host_target()` reads the running
    // platform, which is the right default — a build with no `--target=` is a
    // build for this machine.
    view :: selection ?? host_target()
    // The baked constants need a CONCRETE target either way: `VADER_OS` has to
    // exist in the union view too, where it takes the host's value. Only the
    // FILTERING is switched off there.
    bake_target :: if view is AllTargets {
        host_target()
    } else {
        view
    }
    // Null here means "keep every body" — `select_target_bodies` returns its
    // input unchanged. That is the union view, and the ONLY thing that reaches
    // it is navigation.
    effective_target: Target | null = if view is AllTargets {
        null
    } else {
        view
    }
    modules :: MutableMap<string, LoadedModule> {}
    loader_diags: Diagnostic[]! = []
    project_root :: find_manifest_root(entry)
    // Read the project manifest once (the LSP re-loads on every didOpen).
    manifest :: match project_root {
        is string as pr -> read_manifest(pr)
        is null          -> Manifest { .include_paths = [] }
    }
    entry_folder :: entry_folder_of(entry)
    plain_roots :: project_include_paths(project_root, manifest, include_path_flags)
    // Generated modules are a property of the PROJECT, not of whoever asked for
    // the load: derived here, every command sees them — `run`, `test`, `lint`,
    // `dump` and the LSP, not only the `vader build` that produced them.
    generated_root :: generated_root_for(project_root)

    // Lazy import-driven resolution (see `lazy.vader`). No eager scan : `index`
    // is a cache filled on demand by `resolve_lazy`, which path-maps each module
    // name to a folder under the include-paths. Load ORDER — and thus symbol-id
    // assignment — is driven solely by the import BFS in `drain_load_queue`, not
    // by discovery, so the self-compile is byte-identical regardless of how the
    // include-paths are sourced. The include-paths (built once the entry's
    // namespace is known) are : the entry folder rooted at its declared module
    // name, then `plain_roots` (manifest dir + `vader.json includePaths` +
    // binary-adjacent stdlib default ; GCC `-I` style, first match wins).
    index: MutableMap<string, DiscoveredModule> = MutableMap<string, DiscoveredModule> {}

    entry_module :: seed_entry(entry_folder, loader_diags)
    match entry_module {
        is null -> {
            loader_diags.push(resolver_error(.ModuleNotFound, zero_span(entry),
                "entry file's folder declares no module"))
            return LoadedProject {
                .entry = entry_folder, .modules = modules, .factory = factory,
                .project_root = project_root,
                .diags = loader_diags,
            }
        }
        is DiscoveredModule as em -> {
            bases :: include_paths(em.name, em.folder, plain_roots, generated_root)
            // Re-resolve the entry through the generic path now that the roots
            // exist. `paths[0]` is the entry's own folder rooted at its declared
            // name, so this finds the same primary — and then applies the merge
            // rule, so a generated file can join the ENTRY module without
            // `seed_entry` re-implementing the rule. Falls back to the discovered
            // module if resolution somehow misses, which it cannot: `paths[0]`
            // matches by construction.
            entry_resolved :: resolve_lazy(em.name, bases, index, loader_diags) ?? em
            queue: DiscoveredModule[]! = [entry_resolved]
            core :: resolve_lazy("std/core", bases, index, loader_diags)
            match core {
                is DiscoveredModule as cm -> {
                    if cm.folder != em.folder { queue.push(cm) }
                }
                _ -> {}
            }
            drain_load_queue(queue, bases, modules, factory, index, loader_diags, overlay, node_factory, effective_target)
            // Force-load `std/string_builder`: the lowerer resolves
            // `StringBuilder {}` + `append`/`to_string` for `${sb}` interpolation,
            // a dependency no source import makes visible. DCE'd when unused.
            //
            // It MUST come after the natural BFS, not be seeded early, so module
            // load order — and thus symbol-id assignment — stays identical to a
            // build that never asked for it. Seeding it early strands `build_stmt`
            // in bootstrap.vader.
            string_builder :: resolve_lazy("std/string_builder", bases, index, loader_diags)
            match string_builder {
                is DiscoveredModule as sbm -> {
                    if !has_module(modules, sbm.folder) {
                        sb_queue: DiscoveredModule[]! = [sbm]
                        drain_load_queue(sb_queue, bases, modules, factory, index, loader_diags, overlay, node_factory, effective_target)
                    }
                }
                _ -> {}
            }
            // The baked target constants (`VADER_OS` / `VADER_ARCH`), appended
            // after the natural BFS for the same order-preserving reason as
            // `std/string_builder` above. The module is VIRTUAL — generated per
            // build and served through the overlay, never written to disk, which
            // would be a second source of truth and wrong on the first
            // cross-compile. Skipped without `std/target`, since the constants
            // name `Os` and `Arch` and there would be no module to name them from.
            //
            // `bake_target`, NOT `effective_target`: the constants must exist in
            // the union view too, where selection is off but `VADER_OS` is still a
            // name any file may use. Defaulting here rather than per entry point
            // is what makes `run` / `test` / `lint` / `dump` / the LSP consistent.
            load_baked_target(modules, bases, index, loader_diags, overlay,
                factory, node_factory, bake_target)
            detect_import_cycles(modules, index, loader_diags)
            return LoadedProject {
                .entry = em.folder, .modules = modules, .factory = factory,
                .project_root = project_root,
                .diags = loader_diags,
            }
        }
    }
}

// Generate and ingest the baked-constants module. Requires `std/target`, which
// declares the enums the constants name; loads it first if the natural BFS did
// not, so that `VADER_OS` is available to a program that never imported anything.
load_baked_target :: fn(
    modules: MutableMap<string, LoadedModule>!, bases: IncludePath[],
    index: MutableMap<string, DiscoveredModule>!, diags: Diagnostic[]!,
    overlay: MutableMap<string, string>, factory: SymbolFactory!,
    node_factory: NodeIdFactory!, target: Target,
) -> void {
    std_target :: resolve_lazy("std/target", bases, index, diags)
    if std_target is null { return }
    if !has_module(modules, std_target.folder) {
        pre: DiscoveredModule[]! = [std_target]
        drain_load_queue(pre, bases, modules, factory, index, diags, overlay, node_factory, target)
    }
    // A COPY of the overlay: the parameter is read-only, and the baked source is
    // this call's business, not the caller's.
    with_baked :: MutableMap<string, string> {}
    for [path, text] in overlay { with_baked[path] = text }
    with_baked[BAKED_PATH] = baked_module_source(target)
    baked :: DiscoveredModule {
        .name = BAKED_MODULE,
        .folder = BAKED_FOLDER,
        .files = [BAKED_PATH],
        .origin = .Toolchain,
    }
    queue: DiscoveredModule[]! = [baked]
    drain_load_queue(queue, bases, modules, factory, index, diags, with_baked, node_factory, target)
}

// BFS-drain a work-queue of discovered modules: ingest each not-yet-loaded
// module, then enqueue its imports. Shared by the entry BFS and the
// `std/string_builder` force-load, so the force-load runs as a separate pass
// without diverging from the ingestion logic.
drain_load_queue :: fn(
    queue: DiscoveredModule[]!, bases: IncludePath[],
    modules: MutableMap<string, LoadedModule>!, factory: SymbolFactory!,
    index: MutableMap<string, DiscoveredModule>!, diags: Diagnostic[]!,
    overlay: MutableMap<string, string>, node_factory: NodeIdFactory!,
    // NO default: it would make "I forgot" and "I mean no target" the same
    // keystroke. A call site that takes it silently runs with selection
    // DISABLED and lets every `@target` body through to the type checker.
    target: Target | null,
) -> void {
    cursor: usize = 0
    for cursor < queue.len() {
        m :: queue[cursor]
        cursor = cursor + 1
        id :: m.folder
        if has_module(modules, id) { continue }
        ingest_module(m, bases, modules, factory, index, diags, overlay, node_factory, target)
        ingested :: modules[id]
        match ingested {
            is null -> {}
            is LoadedModule as lm -> {
                for raw in lm.collected.import_paths {
                    dep :: index[raw]
                    match dep {
                        is DiscoveredModule as t -> {
                            if !has_module(modules, t.folder) { queue.push(t) }
                        }
                        _ -> {}
                    }
                }
            }
        }
    }
}

// Detect import cycles once every module is loaded — R2005. The load BFS only
// dedupes (a back-edge to an already-loaded module is silently dropped), so the
// cycle is invisible there ; a separate three-colour DFS over the resolved
// import graph surfaces it. SPEC §11 forbids cyclic imports.
detect_import_cycles :: fn(
    modules: MutableMap<string, LoadedModule>,
    index: MutableMap<string, DiscoveredModule>,
    diags: Diagnostic[]!,
) -> void {
    // Per module : absent = unvisited, 1 = on the current DFS stack, 2 = done.
    state :: MutableMap<string, i32> {}
    for [id, _] in modules {
        if state[id] == null { walk_import_cycle(id, modules, index, state, diags) }
    }
}

walk_import_cycle :: fn(
    id: string, modules: MutableMap<string, LoadedModule>,
    index: MutableMap<string, DiscoveredModule>,
    state: MutableMap<string, i32>!, diags: Diagnostic[]!,
) -> void {
    state[id] = 1
    lm :: modules[id]
    if lm is LoadedModule as m {
        for raw in m.collected.import_paths {
            target :: index[raw]
            if target is DiscoveredModule as t {
                st :: state[t.folder]
                if st == null {
                    walk_import_cycle(t.folder, modules, index, state, diags)
                } else if st == 1 {
                    diags.push(resolver_error(.ImportCycle, zero_span(m.module.display_path),
                        "`${m.module.display_path}` imports `${raw}`, closing an import cycle"))
                }
            }
        }
    }
    state[id] = 2
}

// Full-parse + collect one module's files. The index is header-only and records
// the file *paths*, so the files are re-read and re-parsed here to produce the
// SourceFile + CollectedModule downstream expects. `index` is what lets
// `collect_files` resolve each import path and emit R2001/R2024/R2025/R2028 with
// the right span.
ingest_module :: fn(
    m: DiscoveredModule, bases: IncludePath[],
    modules: MutableMap<string, LoadedModule>!, factory: SymbolFactory!,
    index: MutableMap<string, DiscoveredModule>!, diags: Diagnostic[]!,
    overlay: MutableMap<string, string>, node_factory: NodeIdFactory!,
    target: Target | null,
) -> void {
    if m.files.len() == 0 { return }
    parsed :: parse_module_files(m.files, diags, overlay, node_factory)
    if parsed.len() == 0 { return }
    // Target selection happens HERE — after parsing, before collection. Every
    // pass downstream then sees one declaration per name and needs to know
    // nothing about targets: a losing body does not reach them at all.
    dropped_bodies :: discarded_bodies(parsed, target)
    sources :: select_target_bodies(parsed, target, diags)
    // Pre-resolve this module's imports into the cache so `collect_files`'
    // `diagnose_import_path` finds them instead of firing a spurious R2001 —
    // the failure mode that reverted the earlier lazy attempt.
    preresolve_imports(sources, bases, index, diags)
    collected :: collect_files(sources, m.folder, m.name, factory, index, bases, diags)
    modules[m.folder] = LoadedModule {
        .discarded_bodies = dropped_bodies,
        .module = Module {
            .id           = m.folder,
            // Display path is the module's declared name (`module "..."`),
            // NOT the filesystem folder. Keeps `# Lower` / `# Comptime` /
            // `# Typecheck` dumps stable.
            .display_path = m.name,
            .module_name  = m.name,
            .origin       = m.origin,
            .files        = sources,
        },
        .collected       = collected,
        // Same project-global factory every module's parse used (each
        // `SourceFile.id_factory` is `node_factory`) ; carried here so
        // materialised clones mint past the project-global max.
        .node_id_factory = node_factory,
    }
}

// Read `path`'s source, consulting the in-memory `overlay` (filesystem path →
// current text) before the disk. The LSP populates the overlay from its
// didChange buffer so unsaved edits are parsed ; an empty overlay falls
// straight through to `read_file`. Returns "" when neither the overlay nor
// the disk has the file (the caller skips empty content) — same handling the
// pre-overlay code gave `read_file`'s error case.
read_with_overlay :: fn(overlay: MutableMap<string, string>, path: string) -> string {
    buffered :: overlay[path]
    if buffered != null { return buffered }
    disk :: read_file_string(path, READ_LIMIT_DEFAULT)
    if disk is string { return disk }
    return ""
}

parse_module_files :: fn(paths: string[], diags: Diagnostic[]!, overlay: MutableMap<string, string>, node_factory: NodeIdFactory!) -> SourceFile[] {
    // ONE factory threaded across the WHOLE project, so AST node ids are
    // globally unique — not just module-unique. Per-module factories (each
    // restarting at 1) overlapped, and the side-tables keyed by raw node id
    // (`expr_types` / `expr_kinds` / `node_spans`) then collided whenever one
    // module's typecheck recorded a FOREIGN node — e.g. std/core's primitive
    // `Comparable` default-method clones, materialised via `node_id_factory`
    // and typed into a consumer module (the `expand_tilde` return-array
    // miscompile). A global factory makes that collision impossible (mirrors
    // globally-unique Symbol ids).
    out: SourceFile[]! = []
    for path in paths {
        content :: read_with_overlay(overlay, path)
        if content == "" { continue }
        parsed :: parse_source(content, path)
        for e in parsed.errors { diags.push(e) }
        assign_program_ids(parsed.program, node_factory)
        out.push(SourceFile {
            .path       = path,
            .content    = content,
            .program    = parsed.program,
            .id_factory = node_factory,
        })
    }
    return out
}

// Assemble the plain (unrooted) include-paths for a project — GCC `-I` style,
// first-match-wins: the `--include-paths` flag entries (a driven build injects the
// compiler's own sources through these), then a BUNDLED library root when the
// binary is part of one, then the manifest dir itself, then each `vader.json
// includePaths` entry joined onto it, then the cwd-relative library fallback.
//
// The bundled root outranks the project to RESERVE the namespaces `lib/` ships,
// which are ordinary directory names (`std`, and in time `json`, `cli`, …).
// Project-first, a project declaring `module "cli"` wins over the shipped `cli` —
// and in a DRIVEN build, where the compiler's sources compile in the same unit,
// `vader/cli` would then be built against the user's module.
//
// Only the BUNDLED root is promoted, never the cwd-relative fallback: a bundle's
// root is authoritative (the marker proves the toolchain planted it) where a bare
// `<cwd>/lib` is a guess, and a project keeping its own code under `lib/` must not
// have that searched ahead of its own modules.
//
// The ORIGIN travels with each root because this is the only place that knows it:
// a flag came from the caller, the sidecar probe found a planted root, a manifest
// entry may be either. See `ModuleOrigin`.
project_include_paths :: fn(
    project_root: string | null, manifest: Manifest, flag_paths: string[],
) -> IncludePath[] {
    roots: IncludePath[]! = []
    // A flag is probed exactly like a manifest entry — the marker decides, never
    // where the path came from. Hard-coding `.Build` here bought nothing (an
    // importer under `vader/` is already exempt from R2034 by NAME) and cost an
    // inconsistency: `--include-paths lib` and `vader.json includePaths: ["lib"]`
    // name the same directory and would answer differently.
    for p in flag_paths { roots.push(plain_root(p, origin_of_root(p))) }
    // One probe, read twice. `default_library_root()` is `sidecar_root()` with a
    // cwd fallback, so calling both listed the SAME bundled root twice — position 1
    // and last. Not a cost worth naming (one syscall); it is that a duplicate root
    // is a duplicate answer, and the fallback below must fire only when there is no
    // bundle to fall back from.
    bundled :: sidecar_root(LIBRARY_ROOT_DIR, LIBRARY_ROOT_MARKER)
    if bundled != null {
        roots.push(plain_root(bundled, .Toolchain))
    }
    match project_root {
        is string as pr -> {
            roots.push(plain_root(pr, .Build))
            // A manifest entry can be either, and the MARKER is what says which —
            // never the spelling. This repo's own `includePaths: ["lib"]` is how a
            // checkout reaches the shipped namespaces, while a project keeping its
            // own code under a directory of any name is its own. One probe per
            // entry, once per load.
            for p in manifest.include_paths {
                dir :: join_path(pr, p)
                roots.push(plain_root(dir, origin_of_root(dir)))
            }
        }
        is null -> {}
    }
    if bundled == null {
        roots.push(plain_root(LIBRARY_ROOT_DIR, origin_of_root(LIBRARY_ROOT_DIR)))
    }
    return roots
}

// An unrooted include-path — no `prefix`, so it serves every module name.
plain_root :: fn(dir: string, origin: ModuleOrigin) = IncludePath {
    .dir = dir, .prefix = "", .origin = origin,
}

/// The project's generated-module tree, or "" when it has none.
///
/// Gated on the directory EXISTING rather than on a manifest declaration: nothing
/// has to be configured for a driver's output to be found. That makes it a
/// filesystem probe, which module resolution otherwise avoids (SPEC §11) — but
/// what is probed is where a build ARTEFACT lives, not what a module is called:
/// the generated files still declare their own `module`, and an absent or empty
/// directory contributes nothing.
///
/// Anchored on the manifest root when the project has one, and on the invocation
/// directory otherwise — the same shape as `resolve_sidecar`'s stdlib fallback,
/// and for the same reason: `find_manifest_root` returns null for a project with
/// no `vader.json`, which is most small projects and every test fixture. It also
/// matches the anchor the DRIVER writes the tree against: the CLI hands it the
/// invocation directory as `args[1]`. The consequence to know is that compiling a
/// manifest-less project from a different directory will not find its generated
/// tree — exactly the existing limitation on finding its stdlib.
///
/// Exported so `vader doctor` reports the tree the LOADER will actually use,
/// rather than re-deriving the same anchor-and-join and being able to drift
/// from it.
///
/// @param project_root  the manifest root, or null for a project without one.
/// @return              the generated tree's directory, or `""` when none exists.
export generated_root_for :: fn(project_root: string | null) -> string {
    anchor :: match project_root {
        is string as pr -> pr
        is null         -> current_working_directory()
    }
    candidate :: join_path(anchor, GENERATED_ROOT_DIR)
    if !is_dir(candidate) {
        return ""
    }
    return candidate
}

entry_folder_of :: fn(path: string) -> string {
    if exists(path) && is_dir(path) { return path }
    folder :: dir_of(path)
    // A bare filename ("main.vader", no separator) has no parent, and `read_dir`
    // of "" fails — surfacing as `entry file's folder declares no module`, a
    // message pointing at the module declaration rather than at the path. The
    // invocation directory is what the user meant.
    if folder == "" { return "." }
    return folder
}

has_module :: fn(modules: MutableMap<string, LoadedModule>, id: string) -> bool {
    return !(modules[id] is null)
}

collect_files :: fn(
    files: SourceFile[], module_id: string, module_name: string,
    factory: SymbolFactory!,
    index: MutableMap<string, DiscoveredModule>, paths: IncludePath[], diags: Diagnostic[]!,
) -> CollectedModule {
    // Multi-file collect : merge every file's collected view into one
    // module-wide table. Each file mints fresh Symbol ids through the
    // shared factory, so the maps just need their entries union'd.
    merged :: collect_module(files[0].program, module_id, module_name, factory, index, paths, diags)
    for i in 1..<files.len() {
        per_file :: collect_module(files[i].program, module_id, module_name, factory, index, paths, diags)
        merge_collected(merged, per_file, diags)
    }
    return merged
}

merge_collected :: fn(dst: CollectedModule!, src: CollectedModule, diags: Diagnostic[]!) -> void {
    for [name, sym] in src.symbols {
        existing :: dst.symbols[name]
        match existing {
            is null -> { dst.symbols[name] = sym }
            is Symbol as e -> {
                // Two cross-file collisions are legitimate. Fn-vs-fn goes
                // to `fn_overloads` below — the primary slot keeps its
                // first-wins binding (`add_fn_symbol`'s policy), the
                // overloads land in the bucket. ImportBinding-vs-Import-
                // Binding is normal usage (two files of one module each
                // importing `MutableMap`); `bind_import` checks the per-file
                // scope, so the module-wide table only needs one slot to
                // carry the binding to the wire pass.
                //
                // Every other non-fn kind duplicated across files breaks the
                // one-module-owns-one-declaration invariant: R2026 (module
                // redesign, decision #28).
                fn_pair     :: e.kind == SymbolKind.Fn && sym.kind == SymbolKind.Fn
                import_pair :: e.kind == SymbolKind.ImportBinding && sym.kind == SymbolKind.ImportBinding
                if !fn_pair && !import_pair {
                    span :: match sym.defined_at {
                        is Span as s -> s
                        is null      -> zero_span("")
                    }
                    diags.push(resolver_error(.DuplicateNonFnDeclInModule, span,
                        "`${name}` already declared in a sibling file of this module"))
                }
            }
        }
    }
    // Not `merge_bucket_map` : `CollectedModule.fn_overloads` is declared
    // read-only at the map level, so it cannot fill that helper's `!` slot
    // (T3077). Widening the field's type reaches well past this pass.
    for [name, bucket] in src.fn_overloads {
        existing :: dst.fn_overloads[name]
        match existing {
            is null -> { dst.fn_overloads[name] = bucket }
            _ -> {
                for s in bucket { existing.push(s) }
                dst.fn_overloads[name] = existing
            }
        }
    }
    for [id, info] in src.imports {
        dst.imports[id] = info
    }
    for p in src.import_paths { dst.import_paths.push(p) }
    // APPENDED, not unioned : each entry stays attached to the file that wrote
    // those imports, because imports are file-scoped (SPEC §"Modules"). Merging
    // them would let one file's `{ x as _ }` silence a sibling's plain wildcard
    // of the same path.
    dst.wildcards.push_all(src.wildcards)
}


// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_project_include_paths_labels_a_manifest_library_root :: fn() -> void {
    // A manifest entry can be either, and this repo is the case that matters: its
    // `includePaths: ["lib"]` is how a checkout reaches the shipped namespaces, so
    // that entry must come back `.Toolchain` — the classification the deleted
    // path-matching got wrong in both directions.
    paths :: project_include_paths("", Manifest { .include_paths = ["lib"] }, [])
    for p in paths {
        if p.dir == LIBRARY_ROOT_DIR {
            assert_eq(p.origin, ModuleOrigin.Toolchain)
            return
        }
    }
    assert(false, "the manifest's `lib` never reached the include-paths")
}

@test
test_project_include_paths_calls_a_flag_the_builds_own :: fn() -> void {
    // A `--include-paths` flag is whatever the caller pointed at — including, in a
    // driven build, the compiler's own sources. Never the toolchain's, so R2034
    // does not fire on the compiler importing itself through that root.
    paths :: project_include_paths(null, Manifest { .include_paths = [] }, ["some/where"])
    assert(paths.len() >= 1, "the flag is a root")
    assert_eq(paths[0].dir, "some/where")
    assert_eq(paths[0].origin, ModuleOrigin.Build)
}
