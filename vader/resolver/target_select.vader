// vader/resolver/target_select — choosing one body per `@target` group.
//
// The model, in one line: a function has ONE declaration and several candidate
// bodies, and a build selects one. `@target` bare names the declaration (and may
// carry the general body); `@target(.Os, …)` names a body for those systems.
//
// This runs between parsing and collection, and that placement is the whole
// point: everything downstream — `add_fn`, T3053, overload resolution, the
// comptime evaluator, the typechecker — then sees a module with exactly one
// declaration per name, and needs no knowledge of targets at all. A body that
// loses is not "skipped later"; it never reaches them.
//
// When a specialised body wins, the bare declaration is not discarded: its
// ENVELOPE is kept and the winning body grafted onto it. The envelope is the
// name, the signature, the visibility and the decorators — everything a caller
// and a reader depend on — so an exported function stays exported on every
// target. Dropping the declaration whole (the first cut) made the group PRIVATE
// wherever a specialisation won, which surfaced as `R2006 unresolved identifier`
// at the call site of a perfectly good export.
//
// Spans are NOT rewritten. The merged node carries the declaration's own span as
// its identity — what `rename` and `references` must target — while the grafted
// body keeps the spans it was parsed with, so a diagnostic inside it names the
// file it was written in. That is also what keeps the mechanism correct once the
// resolver moves to file-scoped imports (TODO §1.13d): the body resolves against
// its own file, not against the declaration's.

module "vader/resolver"

import "std/collections"
import "std/string"
import "toolchain/ast"
import "std/target"
import "vader/target"

/// Filter every file's declarations down to the ones this target selects.
///
/// Returns the files unchanged when `target` is null — no `--target=` was given,
/// so nothing selects and the module keeps every declaration, which is exactly
/// today's behaviour for a tree that contains no `@target` at all.
///
/// @param files   the module's parsed files.
/// @param target  the compilation target, or null to disable selection.
/// @return        files whose programs hold only the selected declarations.
export select_target_bodies :: fn(files: SourceFile[], target: Target | null) -> SourceFile[] {
    if target == null {
        return files
    }
    // First pass, across the WHOLE module: which names have a specialised body
    // that matches? A bare declaration is only displaced by a body that actually
    // wins, so this cannot be decided file by file — the declaration and its
    // specialisation are routinely written in different files.
    winners :: MutableMap<string, AST.FnDecl> {}
    bare :: MutableMap<string, bool> {}
    for f in files {
        for d in f.program.decls {
            if d is AST.FnDecl as fd {
                sel :: target_selectors(fd.decorators)
                if sel == null {
                    continue
                }
                if sel.len() == 0 {
                    bare[fd.name] = true
                } else if matches_target(sel, target) {
                    winners[fd.name] = fd
                }
            }
        }
    }
    out: SourceFile[]! = []
    for f in files {
        kept: AST.Decl[]! = []
        for d in f.program.decls {
            kept_decl :: resolve_decl(d, target, winners, bare)
            if kept_decl != null {
                kept.push(kept_decl)
            }
        }
        out.push(
            SourceFile {
                .path = f.path,
                .content = f.content,
                .program = Program {
                    .file = f.program.file,
                    .span = f.program.span,
                    .id = f.program.id,
                    .module = f.program.module,
                    .decls = kept,
                },
                .id_factory = f.id_factory,
            },
        )        // Spans are NOT rewritten — each declaration keeps the ones it was
        // parsed with, so diagnostics name the file it was written in and
        // file-scoped import resolution stays correct once the resolver
        // moves to file scope (TODO §1.13d).

    }
    return out
}

// What a declaration becomes for this target: itself, a merge, or nothing.
resolve_decl :: fn(
    d: AST.Decl,
    target: Target,
    winners: MutableMap<string, AST.FnDecl>,
    bare: MutableMap<string, bool>,
) -> AST.Decl | null {
    if d is AST.FnDecl as fd {
        sel :: target_selectors(fd.decorators)
        if sel == null {
            return d
        }
        if sel.len() == 0 {
            // The bare declaration. It carries the envelope either way: on its own
            // when nothing specialised matches, or with the winner's body grafted
            // on when one does.
            w :: winners[fd.name]
            if w == null {
                return d
            }
            return graft_body(fd, w)
        }
        // A specialised body. The winner has already been folded into the
        // declaration above, so it must not appear a second time; a loser is
        // simply gone. The only case where one survives on its own is a group
        // with NO bare declaration, where the body IS the declaration.
        if !matches_target(sel, target) { return null }
        if bare[fd.name] != null        { return null }
        return d
    }
    return d
}

// Build the merged node: the declaration's envelope, the winner's body.
//
// `@extern` / `@intrinsic` ride along from the body, because they say WHO
// provides it and that is a property of the body, not of the group. Every other
// decorator comes from the declaration — a `@no_return` on one body only would
// make the group's TYPE depend on the target, through a channel nothing checks.
graft_body :: fn(decl: AST.FnDecl, body: AST.FnDecl) -> AST.FnDecl {
    // `@target` is KEPT on the merged node. It is what marks the declaration as
    // the head of a group — `dump --stage=targets` reads it, and a reader opening
    // the file still sees that this function has other bodies elsewhere. Nothing
    // downstream acts on it: selection has already happened by the time anything
    // else looks.
    decorators: AST.Decorator[]! = []
    for dec in decl.decorators {
        decorators.push(dec)
    }
    for dec in body.decorators {
        if dec.name == "extern" || dec.name == "intrinsic" {
            decorators.push(dec)
        }
    }
    return AST.FnDecl {
        .span = decl.span,
        .id = decl.id,
        .name = decl.name,
        .name_span = decl.name_span,
        .visibility = decl.visibility,
        .type_params = decl.type_params,
        .params = decl.params,
        .return_type = decl.return_type,
        .body = body.body,
        .decorators = decorators,
        .sam_synthetic = decl.sam_synthetic,
        .is_expression_bodied = body.is_expression_bodied,
        .materialized = decl.materialized,
    }
}

// The OS list a `@target` carries, or null when the decl has no `@target` at
// all. An empty (non-null) list is the bare form.
target_selectors :: fn(decorators: AST.Decorator[]) -> Os[] | null {
    for d in decorators {
        if d.name != "target" {
            continue
        }
        out: Os[]! = []
        for a in d.args {
            if a is AST.DotVariantExpr as dv {
                os :: parse_os(dv.variant.to_lower())
                if os != null {
                    out.push(os)
                }
            }
        }
        return out
    }
    return null
}

matches_target :: fn(selectors: Os[], target: Target) -> bool {
    for os in selectors {
        if os == target.os {
            return true
        }
    }
    return false
}
