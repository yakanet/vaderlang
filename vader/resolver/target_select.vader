// vader/resolver/target_select — choosing one body per `@target` group.
//
// The surface `@target` presents is SPEC.md §17 *Target selection*; this file
// implements the choice. Three invariants govern it.
//
// It runs between parsing and collection. Everything downstream — `add_fn`,
// T3053, overload resolution, the comptime evaluator, the typechecker — sees a
// module with exactly one declaration per name and needs no knowledge of targets.
// A body that loses never reaches them; it is not "skipped later".
//
// The bare declaration's ENVELOPE survives a specialised body winning: the name,
// the signature, the visibility, the decorators. Graft the body onto it rather
// than replacing the node whole, or an exported function stops being exported
// wherever a specialisation wins.
//
// Spans are NOT rewritten. The merged node keeps the declaration's own span as
// its identity — what `rename` and `references` target — while the grafted body
// keeps the spans it was parsed with, so a diagnostic inside it names the file it
// was written in, and it resolves against that file's imports once the resolver
// moves to file-scoped ones (TODO §1.13d).

module "vader/resolver"

import "std/collections"
import "std/string"
import "toolchain/ast"
import "toolchain/span"
import "vader/diagnostics"
import "std/target"
import "vader/target"

// Whether THIS body's code is still present anywhere in the selected files. The
// merged node keeps the winner's body verbatim, spans included, so the body's own
// span is what identifies it — the declaration's name does not.
body_survives :: fn(fd: AST.FnDecl, kept: SourceFile[]) -> bool {
    b :: fd.body
    if b == null {
        return false
    }
    for f in kept {
        for d in f.program.decls {
            if d is AST.FnDecl as k {
                kb :: k.body
                if kb != null {
                    if kb.span == b.span {
                        return true
                    }
                }
            }
        }
    }
    return false
}

/// The bodies this selection discarded.
///
/// A private helper called ONLY from a `@target(.Windows)` body has no referencer
/// left once that body is dropped, so W0007 reports it dead on every other
/// platform — a false positive landing squarely on multi-platform code, which is
/// where the lint should help most. Worse, the natural fix (`@allow_unused`
/// everywhere) would blind the lint to code that really is dead.
///
/// So the discarded bodies still get a vote: `check_dead_code` walks them for
/// references and treats those as extra roots. They are returned as AST rather
/// than as a list of names on purpose — the reference walker already exists in
/// `vader/typecheck`, and reimplementing it here would put the resolver above the
/// type-checker in the import graph for no gain.
///
/// @param files   the module's parsed files, before selection.
/// @param target  the compilation target, or null when nothing selects.
export discarded_bodies :: fn(files: SourceFile[], target: Target | null) -> AST.FnDecl[] {
    out: AST.FnDecl[]! = []
    if target == null {
        return out
    }
    kept :: select_target_bodies(files, target, [])
    for f in files {
        for d in f.program.decls {
            if d is AST.FnDecl as fd {
                if target_selectors(fd.decorators) == null {
                    continue
                }
                // Compared by BODY span, not by name: after merging, the bare
                // declaration carries the winner's body under its own name, so a
                // name test reports every loser as surviving — which is exactly
                // the bug this function exists to prevent.
                if body_survives(fd, kept) {
                    continue
                }
                out.push(fd)
            }
        }
    }
    return out
}

/// Filter every file's declarations down to the ones this target selects.
///
/// Returns the files unchanged when `target` is null — no `--target=` was given,
/// so nothing selects and the module keeps every declaration, which is the
/// behaviour a tree containing no `@target` already has.
///
/// @param files   the module's parsed files.
/// @param target  the compilation target, or null to disable selection.
/// @param diags   accumulates the group well-formedness diagnostics, which are
///                raised for every target rather than only the one being built.
/// @return        files whose programs hold only the selected declarations.
export select_target_bodies :: fn(
    files: SourceFile[],
    target: Target | null,
    diags: Diagnostic[]!,
) -> SourceFile[] {
    // Group well-formedness is checked BEFORE any filtering, and therefore for
    // every target rather than only the one being built. That is what makes a
    // misspelled body an error on the machine that wrote it instead of a surprise
    // on whichever platform compiles it next — the matcher sees all the
    // candidates, so it may as well judge them all.
    check_selectors(files, diags)
    check_groups(files, diags)
    if target == null {
        return files
    }
    // First pass, across the WHOLE module: which names have a specialised body
    // that matches? A bare declaration is only displaced by a body that actually
    // wins, so this cannot be decided file by file — the declaration and its
    // specialisation are routinely written in different files.
    winners :: MutableMap<string, AST.FnDecl> {}
    bare :: MutableMap<string, bool> {}
    // What each group's bodies DO cover, for the diagnostic below: a reader told
    // only "nothing covers darwin" still has to go read the group to learn what
    // it covers instead.
    covered :: MutableMap<string, string> {}
    for f in files {
        for d in f.program.decls {
            if d is AST.FnDecl as fd {
                sel :: target_selectors(fd.decorators)
                if sel == null {
                    continue
                }
                if sel.is_bare {
                    bare[fd.name] = true
                } else {
                    for os in sel.os {
                        prev :: covered[fd.name]
                        covered[fd.name] = if prev == null {
                            ".${os.to_string()}"
                        } else {
                            "${prev}, .${os.to_string()}"
                        }
                    }
                    if matches_target(sel.os, target) {
                        winners[fd.name] = fd
                    }
                }
            }
        }
    }
    report_uncovered(files, target, winners, covered, diags)
    out: SourceFile[]! = []
    for f in files {
        kept: AST.Decl[]! = []
        for d in f.program.decls {
            kept_decl :: resolve_decl(d, target, winners, bare)
            if kept_decl != null {
                kept.push(kept_decl)
            }
        }
        // Spans are NOT rewritten — each declaration keeps the ones it was parsed
        // with, so diagnostics name the file it was written in and file-scoped
        // import resolution stays correct once the resolver moves to file scope
        // (TODO §1.13d).
        out.push(
            SourceFile {
                .path = f.path,
                .content = f.content,
                .program = Program {
                    .file = f.program.file,
                    .span = f.program.span,
                    .id = f.program.id,
                    .module = f.program.module,
                    .decls = kept,
                },
                .id_factory = f.id_factory,
            },
        )
    }
    return out
}

// Every `@target(.X)` body must belong to a group: a bare `@target` declaration
// of the same name must exist to carry the envelope. Without that rule,
// `@target(.X)` would be a body in one file and a declaration in another, and
// telling which would mean looking elsewhere in the module — the one non-local
// question the model otherwise avoids.
//
// A body may not carry `export` for the same reason: the declaration owns the
// visibility, so a body carrying its own would make a group's public surface
// depend on which target you built.
check_groups :: fn(files: SourceFile[], diags: Diagnostic[]!) -> void {
    // Where each name's bare declaration is, and which platforms its bodies have
    // already claimed. Both carry a SPAN rather than a flag: a conflict
    // diagnostic that cannot name the other side leaves the reader to find it.
    bare :: MutableMap<string, AST.FnDecl> {}
    claimed :: MutableMap<string, Span> {}
    for f in files {
        for d in f.program.decls {
            if d is AST.FnDecl as fd {
                sel :: target_selectors(fd.decorators)
                if sel == null {
                    continue
                }
                if !sel.is_bare {
                    continue
                }
                prev :: bare[fd.name]
                if prev != null {
                    // A group is keyed by NAME ALONE, so two overloads each
                    // wanting their own per-platform bodies land here. Saying
                    // only "already declared" sends the author looking for a
                    // duplicate they did not write — the signatures differ, and
                    // it is `@target` that cannot tell them apart.
                    overloaded :: prev.params.len() != fd.params.len()
                    why :: if overloaded {
                        " — `@target` groups are keyed by name alone, so a name cannot carry two overloads"
                    } else {
                        ""
                    }
                    diags.push(
                        resolver_error(
                            .DuplicateTargetDeclaration,
                            fd.name_span,
                            "`${fd.name}` is already declared at ${span_origin(prev.name_span)}${why}",
                        ),
                    )
                    continue
                }
                bare[fd.name] = fd
            }
        }
    }
    for f in files {
        for d in f.program.decls {
            if d is AST.FnDecl as fd {
                sel :: target_selectors(fd.decorators)
                // Two statements, not `sel == null || sel.is_bare`: narrowing
                // crosses `&&` but NOT `||` (TODO), so the second operand would
                // still see `Os[] | null` and fail with T3008.
                if sel == null {
                    continue
                }
                if sel.is_bare {
                    continue
                }
                decl :: bare[fd.name]
                if decl == null {
                    diags.push(
                        resolver_error(
                            .TargetBodyWithoutDeclaration,
                            fd.name_span,
                            "`${fd.name}` has no bare `@target` declaration in this module",
                        ),
                    )
                } else {
                    check_signature(decl, fd, diags)
                }
                if fd.visibility == .Public {
                    diags.push(
                        resolver_error(
                            .TargetBodyCarriesExport,
                            fd.name_span,
                            "`${fd.name}` is a body ; the bare `@target` declaration carries `export`",
                        ),
                    )
                }
                // Overlap. Two bodies covering one platform makes the winner
                // depend on declaration ORDER — the arbitrary silence the rest of
                // this mechanism exists to avoid.
                for os in sel.os {
                    key :: "${fd.name}|${os.to_string()}"
                    taken :: claimed[key]
                    if taken != null {
                        // Same span on both sides means the OS is listed twice
                        // in THIS list. Pointing the reader at "the other body"
                        // would send them looking for one that does not exist.
                        detail :: if taken == fd.name_span {
                            "`${fd.name}` lists `.${os.to_string()}` twice in the same `@target`"
                        } else {
                            "`${fd.name}` already has a body for `.${os.to_string()}` at ${span_origin(taken)}"
                        }
                        diags.push(resolver_error(.TargetBodiesOverlap, fd.name_span, detail))
                    } else {
                        claimed[key] = fd.name_span
                    }
                }
            }
        }
    }
}

// `graft_body` keeps the DECLARATION's params and return type — it carries the
// contract — so the body's own signature is parsed and thrown away. A divergent
// body is therefore silently wrong rather than rejected, and this check exists to
// catch the two shapes where the silence is total:
//
//   - a different ARITY — the body cannot mention the params it dropped, so
//     nothing downstream notices;
//   - the same names in a different ORDER — the body resolves against the
//     declaration's slots, so `fn(b, a) = a - b` computes `a - b` at the
//     DECLARATION's positions and returns the negation of what was written.
//
// Types are deliberately NOT compared. The grafted node keeps the declaration's
// types, so a body written against different ones fails to type-check against
// them downstream (T3020 on the return, an ordinary mismatch inside) with a better
// message than this pass could give. Comparing them needs a structural TypeExpr
// comparator, and the tree's only one (`signature_help::render_type_expr`) falls
// back to `"?"` — which makes two unrelated types compare EQUAL. A wrong
// comparator here is worse than none.
check_signature :: fn(decl: AST.FnDecl, body: AST.FnDecl, diags: Diagnostic[]!) -> void {
    if decl.params.len() != body.params.len() {
        diags.push(
            resolver_error(
                .TargetBodySignatureDiffers,
                body.name_span,
                "`${body.name}` takes ${decl.params.len()} parameter(s) at ${span_origin(decl.name_span)}, "
                    + "this body takes ${body.params.len()}",
            ),
        )
        return
    }
    for i in 0..<decl.params.len() {
        want :: decl.params[i].name
        got :: body.params[i].name
        if want != got {
            diags.push(
                resolver_error(
                    .TargetBodySignatureDiffers,
                    body.params[i].span,
                    "parameter ${i + 1} of `${body.name}` is `${want}` at ${span_origin(decl.name_span)}, "
                        + "`${got}` here — the body binds by POSITION, so a reordered name silently "
                        + "computes something else",
                ),
            )
        }
    }
}

// A bare declaration with NO general body, whose group covers other platforms but
// not this one. Left alone it reaches the type checker as an ordinary bodyless
// fn and comes out as T3062, whose advice — "must be `@intrinsic` or `@extern`"
// — is exactly the wrong thing to do here, and which names neither the target
// nor the group. Reported before selection hands anything on.
report_uncovered :: fn(
    files: SourceFile[],
    target: Target,
    winners: MutableMap<string, AST.FnDecl>,
    covered: MutableMap<string, string>,
    diags: Diagnostic[]!,
) -> void {
    for f in files {
        for d in f.program.decls {
            if d is AST.FnDecl as fd {
                sel :: target_selectors(fd.decorators)
                if sel == null {
                    continue
                }
                if !sel.is_bare {
                    continue
                }
                // A general body on the declaration IS the fallback — that is the
                // whole point of the bare form carrying one.
                if fd.body != null {
                    continue
                }
                if winners[fd.name] != null {
                    continue
                }
                // `@intrinsic` / `@extern` on the declaration means the host
                // binds it; bodylessness is then intended, not a coverage hole.
                if is_host_bound(fd) {
                    continue
                }
                have :: covered[fd.name] ?? "(none)"
                diags.push(
                    resolver_error(
                        .NoTargetBodyCoversTarget,
                        fd.name_span,
                        "`${fd.name}` has no body for `${display_target(target)}` and no general body ; "
                            + "its `@target` bodies cover ${have}",
                    ),
                )
            }
        }
    }
}

is_host_bound :: fn(fd: AST.FnDecl) -> bool {
    for d in fd.decorators {
        if d.name == "intrinsic" {
            return true
        }
        if d.name == "extern" {
            return true
        }
    }
    return false
}

// `file:line` of a span, for a diagnostic that points at a SECOND location. The
// diagnostic's own span names the offending declaration; this names the one it
// conflicts with, which is the half that makes the message actionable.
span_origin :: fn(s: Span) -> string = "${s.start.file}:${s.start.line}"

// What a declaration becomes for this target: itself, a merge, or nothing.
/// Drop every `@c_size` a field declares for another system, keeping the one
/// written for the build target.
///
/// A field with none is left alone: downstream then checks its width against the
/// C field exactly. A field that declares some but none for THIS target keeps an
/// empty list, which is what the typechecker reports — a system nobody thought
/// about must not read as a system that was checked.
///
/// @param sd      the struct declaration, mutated in place.
/// @param target  the system being built for.
keep_target_c_sizes :: fn(sd: AST.StructDecl, target: Target) -> void {
    for f in sd.fields {
        if f.c_sizes.len() == 0 {
            continue
        }
        kept: AST.CSizeSelector[]! = []
        for sel in f.c_sizes {
            os :: parse_os(sel.os.to_lower())
            if os != null && os == target.os {
                kept.push(sel)
            }
        }
        f.c_sizes = kept
        f.c_size_missing = kept.len() == 0
    }
}

resolve_decl :: fn(
    d: AST.Decl,
    target: Target,
    winners: MutableMap<string, AST.FnDecl>,
    bare: MutableMap<string, bool>,
) -> AST.Decl | null {
    if d is AST.StructDecl as sd {
        keep_target_c_sizes(sd, target)
        return d
    }
    if d is AST.FnDecl as fd {
        sel :: target_selectors(fd.decorators)
        if sel == null {
            return d
        }
        if sel.is_bare {
            // The bare declaration. It carries the envelope either way: on its own
            // when nothing specialised matches, or with the winner's body grafted
            // on when one does.
            w :: winners[fd.name]
            if w == null {
                return d
            }
            return graft_body(fd, w)
        }
        // A specialised body never survives on its own: the winner was folded
        // into the declaration above, a loser is simply gone, and an orphan was
        // already reported by `check_groups`. Keeping one would mean a group
        // whose public surface changes with the target.
        return null
    }
    return d
}

// Build the merged node: the declaration's envelope, the winner's body.
//
// `@extern` / `@intrinsic` ride along from the body, because they say WHO
// provides it and that is a property of the body, not of the group. Every other
// decorator comes from the declaration — a `@no_return` on one body only would
// make the group's TYPE depend on the target, through a channel nothing checks.
graft_body :: fn(decl: AST.FnDecl, body: AST.FnDecl) -> AST.FnDecl {
    // `@target` is KEPT on the merged node. It is what marks the declaration as
    // the head of a group — `dump --stage=targets` reads it, and a reader opening
    // the file still sees that this function has other bodies elsewhere. Nothing
    // downstream acts on it: selection has already happened by the time anything
    // else looks.
    decorators: AST.Decorator[]! = []
    for dec in decl.decorators {
        decorators.push(dec)
    }
    for dec in body.decorators {
        if dec.name == "extern" || dec.name == "intrinsic" {
            decorators.push(dec)
        }
    }
    return AST.FnDecl {
        .span = decl.span,
        .id = decl.id,
        .name = decl.name,
        .name_span = decl.name_span,
        .visibility = decl.visibility,
        .type_params = decl.type_params,
        .params = decl.params,
        .return_type = decl.return_type,
        .body = body.body,
        .decorators = decorators,
        .sam_synthetic = decl.sam_synthetic,
        .is_expression_bodied = body.is_expression_bodied,
        .materialized = decl.materialized,
    }
}

/// A `@target`'s parsed selectors, plus whether it was written bare.
///
/// The two are NOT the same question, and one empty list cannot answer both.
/// Fold `is_bare` into it and an empty `os` means "written bare" as much as
/// "every selector failed to parse", so a single typo — `@target(.Drawin)` —
/// reads as a second bare declaration and is reported as `R2039` plus `T3053`,
/// neither of which names the typo. `is_bare` answers the form; `os` answers the
/// content.
TargetSelectors :: struct {
    os:      Os[]
    /// `true` for `@target` written with no argument list — THE declaration.
    is_bare: bool
}

// The `@target` a declaration carries, or null when it has none.
target_selectors :: fn(decorators: AST.Decorator[]) -> TargetSelectors | null {
    for d in decorators {
        if d.name != "target" {
            continue
        }
        out: Os[]! = []
        for a in d.args {
            if a is AST.DotVariantExpr as dv {
                os :: parse_os(dv.variant.to_lower())
                if os != null {
                    out.push(os)
                }
            }
        }
        return TargetSelectors { .os = out, .is_bare = d.args.len() == 0 }
    }
    return null
}

// Every unrecognised selector, named one by one. Reported from HERE rather than
// from the resolver's decorator walker (`body.vader`), which only ever sees the
// declarations selection KEPT: a body's `@target` is dropped by `graft_body`
// when it wins and the body itself is gone when it loses, so a typo inside one
// reached no check at all. A wrong selector on any body is an error on the
// machine that wrote it, whichever platform is being built.
check_selectors :: fn(files: SourceFile[], diags: Diagnostic[]!) -> void {
    for f in files {
        for d in f.program.decls {
            if d is AST.FnDecl as fd {
                for dec in fd.decorators {
                    if dec.name != "target" {
                        continue
                    }
                    for a in dec.args {
                        if a is AST.DotVariantExpr as dv {
                            if parse_os(dv.variant.to_lower()) == null {
                                diags.push(
                                    resolver_error(
                                        .UnknownTargetSelector,
                                        a.span,
                                        "`.${dv.variant}` names no operating system",
                                    ),
                                )
                            }
                        } else {
                            diags.push(
                                resolver_error(
                                    .UnknownTargetSelector,
                                    a.span,
                                    "a `@target` selector must be an operating-system variant, "
                                        + "written `.Linux`, `.Darwin`, `.Windows`, `.Wasi` or `.Browser`",
                                ),
                            )
                        }
                    }
                }
            }
        }
    }
}

matches_target :: fn(selectors: Os[], target: Target) -> bool {
    for os in selectors {
        if os == target.os {
            return true
        }
    }
    return false
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// A module with one platform-specific test, seen from two targets. The point is
// not the count but that the answer is DIFFERENT per target: a report that says
// nothing here is a report that hides half its coverage.
@test test_nothing_is_discarded_without_a_target :: fn() -> void {
    // No target, nothing selects, nothing is discarded — the case that must not
    // guess rather than the case that matters.
    assert_eq(discarded_bodies([], null).len(), 0)
}
