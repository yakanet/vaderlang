// vader/typecheck/generator_iter — Direction A: a `generator`'s call result is a
// CONCRETE nominal type implementing `Iterator<U>`, not the erased trait.
//
// A `generator fn -> Iterator<U>` returns the honest erased `Iterator<U>` in
// source, but a call to it is typed as the concrete synthesized state struct
// `<fn>$State` (which `implements Iterator<U>`), erased to `Iterator<U>` only at
// boundaries. This makes a combinator chain `arr.map(f).filter(p)` resolve
// field/UFCS on a CONCRETE nominal receiver, instead of the erased trait
// receiver that mis-resolves to a virtual dispatch.
// Each generator DECLARATION has its own state struct — two overloads of a name
// are two generators — recorded in `generator_states`, which the lowerer
// (`lower_generator.vader`) reads to build that same struct.

module "vader/typecheck"

AST :: import "toolchain/ast"
import "vader/diagnostics"
import "vader/resolver/symbol"
import "vader/types"
import "std/collections"

// The `<fn>$State` naming convention — one source of truth shared by the symbol
// mint (`gen_state_symbol`) and the lower-side recognition
// (`is_gen_state_struct`).
GEN_STATE_PREFIX :: "__genstate_"

// Reserved synthetic-id range for generator state structs — a large negative
// offset distinct from the lowerer's small-magnitude `next_synthetic_id` pool
// (which starts at -1 and decrements). Self-compile is nowhere near 1M synthetic
// ids, so the two pools cannot meet ; the offset is a stopgap for resolver-minting
// (see the plan's CLEANUP entry).
GEN_STATE_ID_BASE :: -1000000

// The state-struct symbol of the `generator` `decl`, whose symbol is `fn_id` in
// `owner`. Its name carries the overload suffix the fn's own mangled name does,
// so two overloads of one name get two state structs.
gen_state_symbol :: fn(fn_id: i32, decl: AST.FnDecl, owner: TypedProgram) -> Symbol {
    suffix :: overload_suffix(owner.resolved, decl.name, decl.name_span)
    // `display_path` (the DECLARED name), not `path`: this feeds `module_name`,
    // which `symbol_key` folds into a type-intern key and from there into
    // emitted C names. `path` is the filesystem identity and is absolute
    // whenever the entry was named absolutely.
    module :: owner.resolved.display_path
    return Symbol {
        .id = GEN_STATE_ID_BASE - fn_id,
        .kind = .Struct,
        .name = "${GEN_STATE_PREFIX}${decl.name}${suffix}",
        .module = module,
        .module_name = module,
        .visibility = .Private,
        .defined_at = null,
    }
}

/// True when `t` is a `generator`'s synthetic `<fn>$State` iterator struct.
/// Recognises by the `gen_state_symbol` name (not user-derived).
export is_gen_state_struct :: fn(t: Type) -> bool {
    if t is StructType { return starts_with(t.symbol.name, GEN_STATE_PREFIX) }
    return false
}

/// One `generator` declaration's state struct and what it yields.
export GeneratorState :: struct {
    /// The state struct: a call to the generator types as it, and its
    /// lowering builds it.
    symbol:  Symbol
    /// The yielded element, in the declaration's own type parameters.
    element: Type
}

/// The state of the `generator` declared by `decl` ; null when `decl` declares
/// no generator, or one whose element did not resolve.
///
/// @param decl   a fn declaration, from any module.
/// @param typed  any module's typechecked program: every one holds the registry.
export generator_state_of :: fn(decl: AST.FnDecl, typed: TypedProgram) -> GeneratorState | null =
    typed.generator_states[decl.name_span.hash()]

/// Register every `generator` fn's synthetic state struct as `implements
/// Iterator<U>` — into EVERY module's registry — so a call to it types as a
/// concrete iterator (chains resolve) regardless of which module consumes it.
/// Runs before any body walk so `try_trait_widen` sees `<fn>$State → Iterator`
/// while typing chained receivers.
///
/// Each generator registers from the module that declares it: `fn_decls` also
/// holds the declarations other modules publish into it (`cross_publish_fn_decls`),
/// and a signature resolves only in its owner — read from a consumer declaring a
/// fn of the same name, it would take that fn's.
export register_generator_iter_impls :: fn(per_module: MutableMap<string, TypedProgram!>) -> void {
    states :: MutableMap<u64, GeneratorState> {}
    for [_, owner] in per_module {
        sink: Diagnostic[]!: []
        for [sym_id, fn_decl] in owner.fn_decls {
            if !fn_is_generator(fn_decl) || !declares_fn(owner, sym_id, fn_decl.name) { continue }
            elem :: generator_element_type(fn_decl, lookup_return_type(fn_decl, owner), sink)
            if elem is null { continue }
            states[fn_decl.name_span.hash()] = GeneratorState {
                .symbol = gen_state_symbol(sym_id, fn_decl, owner),
                .element = elem,
            }
        }
    }
    for [_, tp] in per_module {
        tp.generator_states = states
        for [_, state] in states {
            state_ty :: mk_struct(state.symbol, [], immutable = false)
            record_struct_trait(tp, state_ty, TRAIT_ITERATOR)
            record_struct_trait_args(tp, state_ty, TRAIT_ITERATOR, [state.element])
        }
    }
}

// Whether `owner` itself declares the fn whose symbol is `sym_id`.
declares_fn :: fn(owner: TypedProgram, sym_id: i32, name: string) -> bool {
    bucket :: owner.resolved.fn_overloads[name] ?? return false
    for sym in bucket {
        if sym.id == sym_id {
            return true
        }
    }
    return false
}

/// The concrete result type for a call whose callee is a `generator`, or null.
/// `mk_struct(<fn>$State, [element])` — a nominal type that `implements
/// Iterator<element>`. The concrete element (from the call's substituted return
/// `Iterator<i32>`) is carried as the sole type arg so a terminal returning the
/// element (`collect -> element[]`, `find -> element | null`) on a chain of these
/// concretises instead of erasing to `T[]` (the `<fn>$State<E> implements
/// Iterator<E>` convention that `resolve_struct_trait_args` reads).
export generator_call_result_type :: fn(c: AST.CallExpr, typed: TypedProgram, concrete_ret: Type) -> Type | null {
    // Cheap program-level bail: a generator-free program skips the per-call
    // callee probe entirely.
    if typed.generator_states.is_empty() { return null }
    decl :: callee_decl(c, typed) ?? return null
    state :: generator_state_of(decl, typed) ?? return null
    elem :: iterator_element_of(concrete_ret) ?? return mk_struct(state.symbol, [], false)
    return mk_struct(state.symbol, [elem], false)
}

/// The element `E` of an `Iterator<E>`, or null when `t` isn't a single-arg
/// `Iterator`. The `generator`'s declared return is `Iterator<E>`, so the call's
/// substituted return yields the concrete element.
iterator_element_of :: fn(t: Type) -> Type | null {
    if t is TraitType {
        if t.symbol.name == TRAIT_ITERATOR && t.args.len() > 0 { return t.args[0] }
    }
    return null
}

// The declaration `c` calls, as typecheck chose it: the fn a UFCS call
// dispatched to, the overload a direct call picked — else the one its callee
// names.
callee_decl :: fn(c: AST.CallExpr, typed: TypedProgram) -> AST.FnDecl | null {
    chosen :: typed.chosen_decls[c.callee.id]
    if chosen != null {
        return chosen
    }
    return lookup_callee_fn_decl(c.callee, typed)
}
