// vader/typecheck/expr_cast — CastExpr inference (`T(x)`).
//
// A cast `T(x)` resolves to the target type `T`, but the (value → target) pair
// must be a conversion the backends actually implement, else the cast lowers to
// a `Convert` op that traps (VM) or reinterprets garbage (native). `infer_cast`
// validates the pair and emits T3010 for an illegal cast (`i32("hello")`,
// `bool(someStruct)`), rather than accepting it and miscompiling.

module "vader/typecheck"

import "vader/diagnostics"
import "vader/integer"
import "vader/types"
// `display_type` and `is_numeric` live in sibling files of this module and are
// referenced directly (a re-import would trip R2026 duplicate-declaration).
AST :: import "toolchain/ast"

/// Type-check a `CastExpr`. Returns the cast's target type.
///
/// @error T3010 when the (value → target) pair is not a legal conversion —
///        scalar↔scalar (numeric / char / enum), a distinct newtype
///        construct / unwrap, an assignable/subtype pair, or an `Into<T>` impl.
infer_cast :: fn(e: AST.CastExpr, typed: TypedProgram, diags: Diagnostic[]) -> Type {
    target :: type_from_expr(e.target, typed.resolved, diags)
    // Cast target flows as expected to the value so `i64(-250)`'s
    // operand narrows to i64 instead of staying FreeInt.
    src :: check_expr(e.value, cast_operand_expected(target), typed, diags)
    if !cast_allowed(src, target, typed) {
        diags.push(typecheck_error(.InvalidCast, e.span,
            "cannot cast ${display_type(src)} to ${display_type(target)}"))
    }
    return target
}

/// The type a cast `T(x)` hands its operand as expected : the target, an `i64` for
/// an enum, or the primitive under a primitive-backed distinct, unwrapped through
/// every level.
/// `Wide(4000000000)` with `Wide :: i64` must see an `i64` slot — a distinct is
/// no slot for a free literal, which would then default to `i32` and wrap before
/// the conversion. A composite-backed distinct stays : it already forwards its
/// literal coercion (`Pair([1, 2])`).
///
/// @param target  the cast's target type.
cast_operand_expected :: fn(target: Type) -> Type {
    if is_valued_enum(target) {
        return TY_I64
    }
    if target is DistinctType {
        backing :: cast_operand_expected(target.backing)
        if primitive_name(backing) != "" {
            return backing
        }
    }
    return target
}

/// True when `T(x)` is a conversion the lowerer / backends implement.
cast_allowed :: fn(src: Type, target: Type, typed: TypedProgram) -> bool {
    // `T(x)` into a type parameter bounded by `Int` converts an integer.
    if is_integer_param(target, typed) {
        return is_integer_type(src, typed)
    }
    // Undecidable operands (an earlier error, an unbound type param, a metatype)
    // opt out — never pile a T3010 on top of a cascade.
    if not_decidable(src) || not_decidable(target) { return true }
    // A machine integer converts as any primitive : `i32(x)` is no checked conversion.
    refined :: refinement_of(target)
    if refined != null {
        return range_conversion_allowed(src, refined)
    }
    if enum_data_of(src, target) != null { return true }
    // The `Convert` op domain — numeric / char / enum conversions (`u64(i32)`,
    // `f64(u64)`, `u8(char)`, `i32(enum)`) and distinct newtype construct / unwrap
    // (`BlockId(-1)`, `i32(blockId)`). These are cheap tag-test gates and cover
    // the dominant cast case, so they run before the heavier `is_assignable` walk
    // (which, for a genuine conversion, fails both directions anyway).
    if scalar_castable(src) && scalar_castable(target) { return true }
    if src is DistinctType || target is DistinctType { return true }
    // Reading a foreign pointer as an integer. A Win32 `HANDLE` reports
    // failure as `INVALID_HANDLE_VALUE` (-1) and `mmap` as `MAP_FAILED` (-1),
    // so a sentinel that is not NULL cannot be tested at all while the pointer
    // stays opaque -- `CPointer | null` only ever sees zero.
    //
    // ONE direction: fabricating a pointer from an integer stays refused, and
    // nothing needs it. A sentinel is RETURNED and compared, never passed, so
    // the handle keeps travelling as a `CPointer` and no call site has to
    // launder it back.
    if is_c_pointer(src) && holds_an_address(target) { return true }
    // Identity / compatible either direction : `i32(x: i32)`, a free literal
    // narrowed to the target, a subtype widen (`Animal(cat)`).
    if is_assignable(src, target) || is_assignable(target, src) { return true }
    // Explicit `Into<Target>` conversion — last resort.
    into_impl :: into_impl_method(typed, src, target)
    if into_impl !is null && into_impl.ty is FnType { return true }
    return false
}

/// The data `src` carries when it is an enum whose header declares `target` as
/// its variant data (`Info(variant)`) ; null otherwise.
export enum_data_of :: fn(src: Type, target: Type) -> StructType | null {
    if src is EnumType {
        data :: src.data ?? return null
        if is_assignable(data, target) { return data }
    }
    return null
}

/// Whether `t` is the opaque foreign pointer `CPointer`.
is_c_pointer :: fn(t: Type) -> bool {
    if t is PrimitiveType {
        return t.name == "CPointer"
    }
    return false
}

/// Whether `t` is an integer at least as wide as a `CPointer`, so it holds an
/// address on every target. A narrower one would drop address bits.
holds_an_address :: fn(t: Type) -> bool {
    name :: primitive_name(t)
    return is_int_name(name) && primitive_size(name) >= primitive_size("CPointer")
}

not_decidable :: fn(t: Type) = t is UnresolvedType | TypeParamType | InferVar | TypeMetaType

// A conversion into a range takes an integer some value of which is in it ; the
// rest are stopped at run time. A float goes through an integer first.
range_conversion_allowed :: fn(src: Type, target: RangeType) -> bool {
    if is_free_numeric(src) {
        return src is FreeIntType
    }
    values :: integer_values(src) ?? return false
    return interval_meet(values, target.bounds) != null
}

// Numeric (int / float, free or concrete), `char`, or an enum — everything the
// `Convert` op can move between. `is_numeric` already covers the free / numeric
// cases ; `char` is NOT numeric so it is added explicitly, as is `enum` (↔ its
// repr int). `bool` and `string` are deliberately absent (no scalar cast).
scalar_castable :: fn(t: Type) -> bool {
    if is_numeric(t) || t is EnumType { return true }
    if t is PrimitiveType { return t.name == "char" }
    return false
}
