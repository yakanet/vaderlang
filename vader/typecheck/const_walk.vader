// vader/typecheck/const_walk — when each module const is typed, within a walk.
//
// `walk_bodies` types an un-annotated const's value to infer its type. A read that
// comes before the const's turn types it then (`settle_const_read`), whatever the
// order of declarations ; a read inside the const's own value is a cycle (T3099).
// Each const is typed once per walk, after the consts its value reads
// (`settle_with_reads`) : a long chain of consts each reading one declared further
// down then settles without nesting one typing per link.

module "vader/typecheck"

import "std/collections"
import "toolchain/span"
import "vader/support/diagnostics"
import "vader/resolver/symbol"
AST :: import "toolchain/ast"

/// Start the const bookkeeping of a walk over `decls` (`TypedProgram.const_walk`).
///
/// @param decls  the module's declarations, as the walk holds them.
/// @param diags  the walk's diagnostics, where every const reports.
open_const_walk :: fn(decls: AST.Decl[], typed: TypedProgram, diags: Diagnostic[]) -> void {
    walk :: ConstWalk { .diags = diags }
    for decl in decls {
        if decl is AST.ConstDecl {
            walk.decls[decl.span.hash()] = decl
        }
    }
    typed.const_walk = walk
}

// Type the const `cd`, the consts its value reads first, in dependency order.
// `deferred` when a read inside a fn body reached it.
settle_with_reads :: fn(cd: AST.ConstDecl, typed: TypedProgram, deferred: bool = false) -> void {
    for c in consts_in_dependency_order(cd, typed) {
        settle_const(c, typed, deferred)
    }
}

// Type the const `cd` unless this walk already has, or is typing it : checking one
// twice is not idempotent (the second check reads the type the first wrote as its
// expected type). It reports into the walk's
// diagnostics, wherever it was reached from.
settle_const :: fn(cd: AST.ConstDecl, typed: TypedProgram, deferred: bool = false) -> void {
    walk :: typed.const_walk
    key :: cd.span.hash()
    if key in walk.states {
        return
    }
    walk.states[key] = .Typing
    walk.typing.push(ConstTyping { .decl = cd, .deferred = deferred })
    check_const_value(cd, typed, walk.diags)
    walk.typing.remove_last()
    walk.states[key] = .Typed
}

// Type the module const `sym` at a read of it (`settle_decl_read`).
settle_const_read :: fn(sym: Symbol, span: Span, typed: TypedProgram) -> void {
    cd :: walk_decl_of(sym, typed) ?? return
    settle_decl_read(cd, span, typed)
}

// The walk's declaration of the module const `sym`.
walk_decl_of :: fn(sym: Symbol, typed: TypedProgram) -> AST.ConstDecl | null {
    declared :: typed.const_decls[sym.id] ?? return null
    return typed.const_walk.decls[declared.span.hash()]
}

// Type the const `cd` at a read of it, unless the walk already has : a read before
// the const's turn — a const declared further down, a fn read before a const it
// calls into — would otherwise see no type. The value is typed as at module level,
// the reading fn's state set aside. A read inside the const's own value, directly
// or through other consts, is a cycle : T3099.
settle_decl_read :: fn(cd: AST.ConstDecl, span: Span, typed: TypedProgram) -> void {
    walk :: typed.const_walk
    key :: cd.span.hash()
    // A read inside a fn body runs once every const is set : it needs only the
    // const's type, which an annotation writes.
    deferred :: typed.current_fn_ctx != null
    if deferred && cd.ty != null {
        return
    }
    state :: walk.states[key]
    if state != null {
        if state == .Typing && closes_reported_cycle(key, cd, walk) {
            walk.states[key] = .CycleReported
            detail :: "`${cd.name}` is read while its own value is typed"
            walk.diags.push(typecheck_error(.ConstDependsOnItself, span, detail))
        }
        return
    }
    // The reading fn's own position, which a module-level value must not see.
    position :: set_walk_aside(typed)
    settle_with_reads(cd, typed, deferred)
    resume_walk(typed, position)
}

/// Where a walk stands inside a fn body : what a value typed apart from it — a
/// const read before its turn, a guard's body checked ahead of its own walk —
/// must not see, and gets back once that value is typed. One list, so that a new
/// piece of walk state is set aside everywhere or nowhere.
WalkPosition :: struct {
    /// The fn being walked.
    fn_ctx: FnContext | null
    /// The callee being typed (`TypedProgram.callee_field_id`).
    callee_field_id: i64
    /// The impl, and its type parameters, whose members are walked.
    enclosing_impl: u64
    enclosing_impl_params: MutableSet<i32>
    /// How deep in an overloaded call's arguments the walk is.
    overloaded_arg_depth: i32
    /// The loops around the walk.
    loop_stack: EnclosingLoop[]
    /// The narrowings in force.
    narrow: NarrowState
}

/// Set the walk's position aside, the walk then standing at module level ;
/// `resume_walk` puts it back.
///
/// @return  the position set aside.
set_walk_aside :: fn(typed: TypedProgram) -> WalkPosition {
    position :: WalkPosition {
        .fn_ctx = typed.current_fn_ctx,
        .callee_field_id = typed.callee_field_id,
        .enclosing_impl = typed.enclosing_impl,
        .enclosing_impl_params = typed.enclosing_impl_params,
        .overloaded_arg_depth = typed.overloaded_arg_depth,
        .loop_stack = typed.loop_stack,
        .narrow = typed.narrow,
    }
    typed.current_fn_ctx = null
    typed.callee_field_id = AST.UNASSIGNED_NODE_ID
    typed.enclosing_impl = 0
    typed.enclosing_impl_params = MutableSet<i32> {}
    typed.overloaded_arg_depth = 0
    typed.loop_stack = []
    typed.narrow = NarrowState {}
    return position
}

/// Put back the walk's position `set_walk_aside` set aside.
///
/// @param position  what `set_walk_aside` returned.
resume_walk :: fn(typed: TypedProgram, position: WalkPosition) -> void {
    typed.current_fn_ctx = position.fn_ctx
    typed.callee_field_id = position.callee_field_id
    typed.enclosing_impl = position.enclosing_impl
    typed.enclosing_impl_params = position.enclosing_impl_params
    typed.overloaded_arg_depth = position.overloaded_arg_depth
    typed.loop_stack = position.loop_stack
    typed.narrow = position.narrow
}

// Whether a read of the const `cd` (`key`), which is being typed, closes a cycle
// reported here. Not one through a `@comptime` const : its evaluator reports it
// (C4009). Nor one through a fn body back to an annotated `cd` : its type is written,
// and the body runs once every const is set (`HANDLERS: (fn() -> i32)[] :
// [() -> CONFIG.n]` with `CONFIG :: Holder { .fs = HANDLERS }`).
closes_reported_cycle :: fn(key: u64, cd: AST.ConstDecl, walk: ConstWalk) -> bool {
    in_cycle := false
    through_body := false
    for frame in walk.typing {
        if frame.decl.span.hash() == key {
            in_cycle = true
        } else if in_cycle {
            through_body = through_body || frame.deferred
        }
        if in_cycle && AST.decorators_have(frame.decl.decorators, "comptime") {
            return false
        }
    }
    return !through_body || cd.ty == null
}

// One const of the depth-first walk below, with the next of its reads to visit.
DependencyFrame :: struct {
    decl: AST.ConstDecl
    reads: AST.ConstDecl[]
    next: i64 = 0
}

// `root` and the consts of this walk it reads, not yet typed, each after the ones it
// reads : a depth-first post-order, kept on an explicit stack so a long chain costs
// no call depth. In a cycle, the read that closes it reports it (T3099).
consts_in_dependency_order :: fn(root: AST.ConstDecl, typed: TypedProgram) -> AST.ConstDecl[] {
    out: AST.ConstDecl[]: []
    walk :: typed.const_walk
    if root.span.hash() in walk.states {
        return out
    }
    seen :: MutableSet<u64> {}
    seen.add(root.span.hash())
    stack: DependencyFrame[]: [frame_of(root, typed)]
    for stack.len() > 0 {
        top :: stack[stack.len() - 1]
        if top.next == top.reads.len() {
            out.push(top.decl)
            stack.remove_last()
            continue
        }
        read :: top.reads[top.next]
        top.next += 1
        key :: read.span.hash()
        if !(key in walk.states) && seen.add(key) {
            stack.push(frame_of(read, typed))
        }
    }
    return out
}

frame_of :: fn(decl: AST.ConstDecl, typed: TypedProgram) -> DependencyFrame =
    DependencyFrame { .decl = decl, .reads = const_reads(decl.value, typed) }

// The consts of this walk the value `e` names directly (`value_reads`).
const_reads :: fn(e: AST.Expr, typed: TypedProgram) -> AST.ConstDecl[] =
    value_reads(e, typed).consts

// What a value names directly, through operators, field and index reads, calls,
// literals and `??` : the consts of this walk, and the struct literals, whose
// omitted fields take their defaults (`field_defaults.vader`). A read under any
// other form is typed on demand instead (`settle_const_read`).
ValueReads :: struct {
    consts: AST.ConstDecl[] = []
    literals: AST.StructLitExpr[] = []
}

value_reads :: fn(e: AST.Expr, typed: TypedProgram) -> ValueReads {
    out :: ValueReads {}
    work: AST.Expr[]: [e]
    for work.len() > 0 {
        x :: work.remove_last() ?? break
        match x {
            is AST.IdentExpr -> {
                sym :: typed.resolved.idents[x.span.hash()] ?? continue
                if sym.kind != .Const {
                    continue
                }
                found :: walk_decl_of(sym, typed) ?? continue
                out.consts.push(found)
            }
            is AST.BinaryExpr -> {
                work.push(x.left)
                work.push(x.right)
            }
            is AST.UnaryExpr -> { work.push(x.operand) }
            is AST.FieldExpr -> { work.push(x.target) }
            is AST.IndexExpr -> {
                work.push(x.target)
                work.push(x.index)
            }
            is AST.CallExpr -> {
                work.push(x.callee)
                for a in x.args {
                    work.push(a.value)
                }
            }
            is AST.SeqLitExpr -> { work.push_all(x.elements) }
            is AST.StructLitExpr -> {
                out.literals.push(x)
                for item in x.items {
                    if item is AST.StructLitField {
                        work.push(item.value)
                    } else {
                        work.push(item.expr)
                    }
                }
            }
            is AST.StringLitExpr -> {
                for part in x.parts {
                    if part is AST.StringLitInterp {
                        work.push(part.expr)
                    }
                }
            }
            is AST.NullCoalesceExpr -> {
                work.push(x.left)
                fallback :: AST.coalesce_fallback_expr(x.fallback) ?? continue
                work.push(fallback)
            }
            _ -> {}
        }
    }
    return out
}
