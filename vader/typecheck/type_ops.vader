// vader/typecheck/type_ops — equality, union canonicalisation, trait membership.
//
// Nothing here touches the `ImplRegistry` (`impls.vader`) — trait questions are
// answered only from the precomputed side-tables on `TypedProgram`
// (`struct_implemented_traits` / `struct_trait_args`), which is why
// `struct_implements_trait` can live here while the registry-driven widening
// stays with its callers — `field.vader::receiver_fits_first_param` via
// `try_trait_widen`. `is_assignable` and its per-variant helpers are in
// `type_assign.vader` (see its header).

module "vader/typecheck"

import "std/collections"
import "std/iter"
import "std/string"
import "std/sort"
import "vader/integer"
AST :: import "toolchain/ast"

/// True when `t` is the `void` primitive — by name, so a `void` built anywhere
/// passes, not only the `TY_VOID` singleton.
export is_void :: fn(t: Type) -> bool {
    if t is PrimitiveType { return t.name == "void" }
    return false
}

// ---- numeric registries (used by Free* defaulting + assignable) -----------
//
// The int/signed/float partition is the single source of truth in
// `vader/types::PRIMITIVE_META`. These thin re-exports keep the ~40 call sites
// that import the predicates from `vader/typecheck` unchanged.


/// Whether a Unicode codepoint fits the integer primitive `type_name`. A char
/// literal coerces to an integer only when its codepoint is representable —
/// `b == '💩'` (u8) is rejected. Delegates to the authoritative per-repr range
/// table (`repr_range` / `contains`), so the byte/short bounds stay in one place.
/// Non-integer names return false (a char never coerces to e.g. f64).
char_fits :: fn(codepoint: u32, type_name: string) -> bool {
    if !is_int_name(type_name) { return false }
    return contains(repr_range(type_name), i64(codepoint))
}

/// Whether an integer literal fits the integer primitive `type_name`. Mirrors
/// `char_fits` : a free integer literal pinned to a concrete width must be
/// representable, so `x: i32 = 9000000000`, `x: u8 = 300`, `x: i8 = 128` and
/// `z: u32 = -1` are rejected (T3066).
///
/// @param value     the literal's magnitude, the `u64` the AST carries.
/// @param negative  whether the literal is written with a `-` (`IntLitExpr.negative`).
/// @param type_name the integer primitive the literal lands in.
int_fits :: fn(value: u64, negative: bool, type_name: string) -> bool {
    if !is_int_name(type_name) {
        return false
    }
    // The range table holds `i64` bounds: a negative magnitude reaches 2^63 at most
    // (the least `i64`), a positive one past `i64.MAX` fits only the 64-bit unsigned.
    if negative {
        return value <= 0x8000_0000_0000_0000 && contains(repr_range(type_name), 0 -% i64(value))
    }
    if type_name == "u64" || type_name == "usize" {
        return true
    }
    return value <= 0x7FFF_FFFF_FFFF_FFFF && contains(repr_range(type_name), i64(value))
}

// True when `target` is one of `names`. A small shared membership helper.
contains_name :: fn(names: string[], target: string) -> bool {
    for n in names { if n == target { return true } }
    return false
}

// ---- equality -------------------------------------------------------------

/// Structural equality. Recursive on unions / fns / arrays / tuples ; for
/// nominal types (Struct / Trait / Enum / TypeParam) we compare symbol ids.
export equals_type :: fn(a: Type, b: Type) -> bool = match a {
    is TypeMetaType   -> b is TypeMetaType
    is SelfType       -> b is SelfType
    is UnresolvedType -> b is UnresolvedType
    is NeverType      -> b is NeverType
    is FreeIntType    -> b is FreeIntType
    is FreeFloatType  -> b is FreeFloatType
    is FreeCharType   -> b is FreeCharType
    is AnyType        -> b is AnyType
    is RangeType | PrimitiveType -> equals_scalar(a, b)
    is TypeParamType  -> if b is TypeParamType as bx { a.symbol.id == bx.symbol.id } else { false }
    is InferVar       -> if b is InferVar as bx { a.id == bx.id } else { false }
    // `StructType<EnumSym>` is the placeholder `type_from_expr` returns
    // for enum names ; treat it as equivalent to the real `EnumType` so
    // body-time assignability (annotation vs inferred) doesn't fight the
    // placeholder/proper distinction.
    is EnumType  -> if b is EnumType as bx {
        a.symbol.id == bx.symbol.id
    } else if b is StructType {
        b.symbol.id == a.symbol.id
    } else { false }
    is StructType  -> if b is StructType as bx {
        nominal_eq(a.symbol.id, a.args, bx.symbol.id, bx.args)
    } else if b is EnumType {
        a.symbol.id == b.symbol.id
    } else { false }
    is TraitType -> if b is TraitType as bx { nominal_eq(a.symbol.id, a.args, bx.symbol.id, bx.args) } else { false }
    is ArrayType -> if b is ArrayType as bx { equals_type(a.element, bx.element) } else { false }
    is TupleType -> if b is TupleType as bx { type_list_equals(a.elements, bx.elements) } else { false }
    is FnType    -> if b is FnType as bx { type_list_equals(a.params, bx.params) && equals_type(a.return_type, bx.return_type) } else { false }
    is UnionType -> if b is UnionType as bx { type_list_equals(a.variants, bx.variants) } else { false }
    // Distinct (newtype) types : nominal identity by symbol id. A distinct
    // type equals only itself, never its backing primitive nor another
    // distinct over the same backing — that's the whole point.
    is DistinctType  -> if b is DistinctType as bx { a.symbol.id == bx.symbol.id } else { false }
}

// Two ranges are equal by their bounds. A machine integer is the range of its
// values, held as a range or as the primitive the lowering reads it as : `i32`
// either way (`primitive_name`).
equals_scalar :: fn(a: Type, b: Type) -> bool {
    if a is PrimitiveType && b is PrimitiveType {
        return a.name == b.name
    }
    if a is RangeType && b is RangeType {
        return same_interval(a.bounds, b.bounds)
    }
    name :: primitive_name(a)
    return name != "" && name == primitive_name(b)
}

nominal_eq :: fn(a_id: i32, a_args: Type[], b_id: i32, b_args: Type[]) -> bool {
    if a_id != b_id { return false }
    return type_list_equals(a_args, b_args)
}

/// Element-wise structural equality of two type lists (params, tuple
/// elements, union variants). Companion to `equals_type` — same per-element
/// `equals_type` comparison, length-checked first.
export type_list_equals :: fn(a: Type[], b: Type[]) -> bool {
    if a.len() != b.len() { return false }
    for i in 0..<a.len() {
        if !equals_type(a[i], b[i]) { return false }
    }
    return true
}

// ---- canonical union ------------------------------------------------------

/// Build a union from `variants`. Flattens nested unions, drops `Never`
/// (absorbed — a value of that type doesn't exist), dedups, sorts by
/// `display_type` output, then, for two that print alike, by their
/// module-qualified name, then by `canonical_key`. Empty / all-Never input
/// collapses to `Never`.
export union_of :: fn(variants: Type[]) -> Type {
    dedup: Type[]: []
    for v in variants {
        v.collect_variant(dedup)
    }
    if dedup.len() == 0 { return TY_NEVER }
    if dedup.len() == 1 { return dedup[0] }
    return mk_union(sort_by_display_key(dedup))
}

/// The type of a value one of several paths gave, of the types `reached` : their
/// union, the ranges among them joined into the one range holding them all, since
/// a range has no hole (`if h < 12 { h } else { h }` is an `Hour`, not two halves
/// on which no arithmetic is defined), and each integer type a path gives bare into
/// another among the paths holding it (`0..=9` or a `u8` beside an `i32` or an
/// `i32 | null` is an `i32`, an `i32 | null`). A union written in the source keeps
/// its ranges apart (`union_of`).
///
/// @param reached  the type of the value on each path.
union_of_paths :: fn(reached: Type[]) -> Type {
    hull: RangeType | null = null
    rest: Type[]: []
    for t in reached {
        refined :: refinement_of(t)
        if refined != null {
            hull = joined_ranges(hull, refined)
        } else {
            rest.push(t)
        }
    }
    // Flattened and deduplicated : a `match` of many arms gives one type many times.
    variants: Type[]: []
    for t in rest {
        t.collect_variant(variants)
    }
    if hull != null && !held_by_another(variants, hull) {
        variants.push(hull)
    }
    kept: Type[]: []
    for v in variants {
        if !absorbed(v, variants, rest) {
            kept.push(v)
        }
    }
    return union_of(kept)
}

// Whether the integer primitive `v`, one of `variants`, goes into another of them
// holding it. Only a value a path gives bare does : one inside a union keeps its
// tag, which nothing converts (`u8 | null` is no `i32 | null`).
absorbed :: fn(v: Type, variants: Type[], paths: Type[]) -> bool {
    if primitive_name(v) == "" || !held_by_another(variants, v) {
        return false
    }
    for path in paths {
        if path is UnionType && path.variants.any_match((inner) -> equals_type(inner, v)) {
            return false
        }
    }
    return true
}

// Whether one of `types` holds every value of the integer type `t` (`holds_integer`) :
// `t` goes into it there, as an operand into the integer beside it.
held_by_another :: fn(types: Type[], t: Type) -> bool {
    for other in types {
        if holds_integer(other, t) {
            return true
        }
    }
    return false
}

// The one range holding `a` and `b`, `b` alone when `a` is null ; either of them,
// named, when it holds the other. It keeps the wider origin of the two.
joined_ranges :: fn(a: RangeType | null, b: RangeType) -> RangeType {
    if a == null {
        return b
    }
    joined :: interval_join(a.bounds, b.bounds)
    origin :: wider_origin(a.origin, b.origin)
    if same_interval(joined, a.bounds) {
        return with_origin(a, origin)
    }
    if same_interval(joined, b.bounds) {
        return with_origin(b, origin)
    }
    return RangeType { .bounds = joined, .origin = origin }
}

/// `t` with every range in it replaced by its representation (`Hour` by `u8`,
/// `Hour[]` by `u8[]`) : what the lowering and every pass after it see, for which
/// a range is the integer it is held in. A union is rebuilt canonical, so
/// `Hour | u8` is `u8`.
///
/// A range narrowed out of an integer type is held in it only as a value of its
/// own (`range_representation`) : inside another type, an array's element, a type
/// argument, a union's variant, every range is held in the narrowest integer
/// holding it, so that two types equal but for that origin share one layout.
///
/// @param t  a type the typecheck recorded.
export erase_ranges :: fn(t: Type) -> Type {
    if t is RangeType {
        return range_representation(t)
    }
    return erase_nested(t)
}

// `t` erased where it sits inside another type : a range in the narrowest integer
// holding it, whatever it was narrowed out of.
erase_nested :: fn(t: Type) -> Type {
    if t is PrimitiveType || !contains_range(t) {
        return t
    }
    return match t {
        is RangeType    -> narrowest_integer(t.bounds)
        is DistinctType -> mk_distinct(t.symbol, erase_nested(t.backing))
        is StructType   -> mk_struct(t.symbol, erase_nested_each(t.args))
        is TraitType    -> TraitType { ...t, .args = erase_nested_each(t.args) }
        is ArrayType    -> mk_array(erase_nested(t.element))
        is TupleType    -> mk_tuple(erase_nested_each(t.elements))
        is FnType       -> FnType {
            ...t,
            .params = erase_nested_each(t.params),
            .return_type = erase_nested(t.return_type),
        }
        is UnionType    -> erase_union(t)
        is PrimitiveType | EnumType | TypeParamType | InferVar | TypeMetaType | SelfType
         | UnresolvedType | FreeIntType | FreeFloatType | FreeCharType | NeverType
         | AnyType -> t
    }
}

// `u` erased : variant by variant where its only ranges are machine integers, each
// then the primitive it is, of the same name and so the same place ; else rebuilt
// canonical, two ranges erasing to one integer (`Hour | u8`).
erase_union :: fn(u: UnionType) -> Type {
    if contains_range(u, true) {
        return union_of(erase_nested_each(u.variants))
    }
    return UnionType { .variants = erase_nested_each(u.variants) }
}

erase_nested_each :: fn(types: Type[]) -> Type[] {
    out: Type[]: []
    for t in types {
        out.push(erase_nested(t))
    }
    return out
}

/// Whether a range sits anywhere in `t`, or with `refinements` a range of exact
/// arithmetic (`is_refinement`). Read on every type the lowering reads : a plain
/// walk, no iterator.
///
/// @param t            a type the typecheck recorded.
/// @param refinements  whether a machine integer goes unseen.
export contains_range :: fn(t: Type, refinements: bool = false) -> bool = match t {
    is RangeType    -> !refinements || !is_machine_range(t)
    is DistinctType -> contains_range(t.backing, refinements)
    is StructType | TraitType -> any_contains_range(t.args, refinements)
    is ArrayType    -> contains_range(t.element, refinements)
    is TupleType    -> any_contains_range(t.elements, refinements)
    is FnType       -> (any_contains_range(t.params, refinements)
        || contains_range(t.return_type, refinements))
    is UnionType    -> any_contains_range(t.variants, refinements)
    is PrimitiveType | EnumType | TypeParamType | InferVar | TypeMetaType | SelfType
     | UnresolvedType | FreeIntType | FreeFloatType | FreeCharType | NeverType | AnyType -> false
}

any_contains_range :: fn(types: Type[], refinements: bool) -> bool {
    for t in types {
        if contains_range(t, refinements) {
            return true
        }
    }
    return false
}

// Order `types` by their `display_type`, rendering each key ONCE: the
// comparator reads a key already in hand rather than rendering its operands. Two
// types that print alike (same-named types of two modules) are ordered by their
// module-qualified name, then by `canonical_key` : a union's order never depends
// on the order its variants arrived in, and on symbol ids, which an unrelated edit
// shifts, only between two that qualify alike.
sort_by_display_key :: fn(types: Type[]) -> Type[] {
    // `T | null` and its kind are most of the unions built here ; at two
    // variants the index detour buys nothing.
    //
    // The no-swap branch may ALIAS `types`, which `mk_union` keeps. Sound
    // because `union_of` builds `dedup` fresh and never writes to it again ; a
    // second caller would have to honour that. Both paths hand `mk_union` an
    // array grown by `push`, so it carries up to twice its used slots — a few
    // bytes here, more as arity grows.
    if types.len() == 2 {
        if comes_before(types[1], display_type(types[1]), types[0], display_type(types[0])) {
            return [types[1], types[0]]
        }
        return types
    }
    keys: string[]: []
    order: usize[]: []
    for i in 0..<types.len() {
        keys.push(display_type(types[i]))
        order.push(i)
    }
    out: Type[]: []
    in_union_order :: (a: usize, b: usize) -> comes_before(types[a], keys[a], types[b], keys[b])
    for i in sort(order, in_union_order) {
        out.push(types[i])
    }
    return out
}

// Whether `a`, printed `a_key`, goes before `b`, printed `b_key`, in a union.
comes_before :: fn(a: Type, a_key: string, b: Type, b_key: string) -> bool {
    if a_key != b_key {
        return compare_ascending_ci(a_key, b_key)
    }
    a_qualified :: qualified_display_type(a)
    b_qualified :: qualified_display_type(b)
    if a_qualified != b_qualified {
        return a_qualified < b_qualified
    }
    return canonical_key(a) < canonical_key(b)
}

collect_variant :: fn(v: Type, into: Type[]) -> void {
    if v is NeverType { return }
    match v {
        is UnionType -> {
            for inner in v.variants { inner.collect_variant(into) }
        }
        _ -> {
            for existing in into {
                if equals_type(existing, v) {
                    return
                }
            }
            into.push(v)
        }
    }
}

// ---- free-type defaulting -------------------------------------------------

/// Replace FreeInt with `i32`, FreeFloat with `f64`, FreeChar with `char`.
/// Used when a free literal escapes its bidirectional context and needs a
/// concrete type to flow into downstream phases.
export default_if_free :: fn(t: Type) -> Type {
    // @partial: only the three Free* literal variants default to a concrete
    // primitive; every other type is already concrete → returned unchanged.
    @partial match t {
        is FreeIntType   -> { return TY_I32 }
        is FreeFloatType -> { return mk_primitive("f64") }
        is FreeCharType  -> { return mk_primitive("char") }
        _ -> { return t }
    }
}

// `t` when it is a free literal, the first free member of a union ; null otherwise.
free_member :: fn(t: Type) -> Type | null {
    if is_free_numeric(t) {
        return t
    }
    variants :: union_variants(t) ?? return null
    for v in variants {
        if is_free_numeric(v) {
            return v
        }
    }
    return null
}

/// `t` with each free literal defaulted, a union's members included: what a binding
/// no annotation pins holds (`if a { 300 } else { null }` is a `null | i32`), as its
/// literals lower at their default.
///
/// @param t  the type the binding's value was given.
default_free_members :: fn(t: Type) -> Type {
    variants :: union_variants(t) ?? return default_if_free(t)
    if free_member(t) == null {
        return t
    }
    out: Type[]: []
    for v in variants {
        out.push(default_if_free(v))
    }
    return union_of(out)
}

/// Dispatch key for trait-impl side-tables (`struct_implemented_traits`,
/// `struct_trait_args`). Defaults Free* first so a `7` literal keys the
/// same as `i32` for impls like `i32 implements Doubler`.
dispatch_key :: fn(t: Type) -> string = impl_base_key(default_if_free(t))

/// Whether `t` is a tuple, a fn or a union : a target keyed by its shape, having no
/// declaration of its own.
///
/// @param t  a type.
export is_structural :: fn(t: Type) -> bool = t is TupleType || t is FnType || t is UnionType

/// The impl tables' key for a type itself, arguments included (`Wrapper<i32>`).
impl_type_key :: fn(t: Type) -> string = canonical_key(t)

/// Whether an impl for `t` covers one instance of a generic base — `Wrapper<MonType>`,
/// `MonType[]` — and so wins over the base's generic impl for that instance alone.
///
/// @param t  an impl's receiver.
is_instance_receiver :: fn(t: Type) -> bool =
    (t is ArrayType || (t is StructType && t.args.len() > 0)) && !type_contains_type_param(t)

/// The key an impl's side tables register it under : its own type for an impl on
/// one instance (`is_instance_receiver`), its base otherwise, shared by every
/// instance the impl covers.
///
/// @param for_ty  the impl's receiver.
impl_side_key :: fn(for_ty: Type) -> string =
    if is_instance_receiver(for_ty) { impl_type_key(for_ty) } else { impl_base_key(for_ty) }

// The key `t`'s own impls register under, or null when no impl on one instance
// can cover `t` : it is no instance, or its base has none.
own_impl_key :: fn(typed: TypedProgram, t: Type) -> string | null {
    key_ty :: default_if_free(t)
    if typed.impl_tables.instance_impl_bases.is_empty() || !is_instance_receiver(key_ty) {
        return null
    }
    if !(impl_base_key(key_ty) in typed.impl_tables.instance_impl_bases) {
        return null
    }
    return impl_type_key(key_ty)
}

/// What an impl side table holds for `t` : the entry of an impl on `t` itself,
/// which wins, else its base's.
///
/// @param typed   a module of the project, whose impl tables `table` is one of.
/// @param table   a table keyed by `impl_side_key`, followed by `suffix`.
/// @param t       the receiver asked about.
/// @param suffix  appended to both keys : `"::member"` for `impl_methods`, `""` for
///                a table keyed by the type alone.
impl_side :: fn<V>(
    typed: TypedProgram, table: MutableMap<string, V>, t: Type, suffix: string,
) -> V | null {
    own_key :: own_impl_key(typed, t)
    if own_key != null {
        own :: table["${own_key}${suffix}"]
        if own != null {
            return own
        }
    }
    return table["${dispatch_key(t)}${suffix}"]
}

/// The entries `t`'s own instance impls and its base's gather — for tables that list
/// several under one key (`struct_implemented_traits`, `impl_method_traits`).
///
/// @param typed   a module of the project, whose impl tables `table` is one of.
/// @param table   a table keyed by `impl_side_key`, followed by `suffix`.
/// @param t       the receiver asked about.
/// @param suffix  appended to both keys : `"::member"`, or `""` for a key alone.
impl_side_list :: fn(
    typed: TypedProgram, table: MutableMap<string, string[]>, t: Type, suffix: string,
) -> string[] {
    base :: table["${dispatch_key(t)}${suffix}"] ?? []
    own_key :: own_impl_key(typed, t) ?? return base
    own :: table["${own_key}${suffix}"] ?? return base
    out: string[]: []
    out.push_all(own)
    for name in base {
        if !(name in own) {
            out.push(name)
        }
    }
    return out
}

/// The members named by `suffix` that the impls covering `t` offer, every impl of a
/// trait included (`Add<f64>` beside `Add<Vec2>`) : those written for `t` itself
/// first, then its base's, less those an impl on `t` hides. An impl on one instance
/// hides its base's impl of the same trait instance (`Wrapper<MonType> implements
/// Poke` hides `Wrapper<T> implements<T> Poke`), not of another one
/// (`MonType[] implements Into<Label>` leaves `T[] implements<T> Into<Iterator<T>>`).
///
/// @param typed   a module of the project, whose impl tables it reads.
/// @param t       the receiver.
/// @param suffix  `"::<member>"`.
export impl_candidates :: fn(typed: TypedProgram, t: Type, suffix: string) -> ImplMethod[] {
    // A member access on a value of a union (an AST node, a `Type`) asks here
    // first : with no impl for such a target, its key is not worth building.
    if !typed.impl_tables.has_structural_target && is_structural(t) {
        return NO_IMPL_METHODS
    }
    found :: typed.impl_tables.impl_methods["${dispatch_key(t)}${suffix}"]
    base: ImplMethod[]: if found == null { NO_IMPL_METHODS } else { found }
    own_key :: own_impl_key(typed, t) ?? return base
    own :: typed.impl_tables.impl_methods["${own_key}${suffix}"] ?? return base
    out: ImplMethod[]: []
    out.push_all(own)
    for member in base {
        if !hides_trait_instance(own, member, t, typed) {
            out.push(member)
        }
    }
    return out
}

NO_IMPL_METHODS: ImplMethod[]: []

/// The members named `method` of `t`'s impls of `trait_key` : `a + b` reaches
/// `Add`'s `add`, never another trait's member of that name.
///
/// @param t          the receiver.
/// @param trait_key  the trait the use site dispatches through.
/// @param method     the member's name.
trait_members :: fn(
    typed: TypedProgram,
    t: Type,
    trait_key: string,
    method: string,
) -> ImplMethod[] {
    out: ImplMethod[]: []
    for m in impl_candidates(typed, t, "::${method}") {
        if m.trait_key == trait_key {
            out.push(m)
        }
    }
    return out
}

// Whether one of `own` implements the trait instance `member`'s impl implements at
// `t` : the same trait, at arguments some instantiation makes equal once the generic
// impl's own parameters take `t`'s (`Into<Iterator<T>>` at `MonType[]`).
hides_trait_instance :: fn(
    own: ImplMethod[],
    member: ImplMethod,
    t: Type,
    typed: TypedProgram,
) -> bool {
    args :: resolve_trait_args_for(t, member.trait_args, typed)
    for o in own {
        if o.trait_key == member.trait_key && may_coincide_each(o.trait_args, args) {
            return true
        }
    }
    return false
}

/// Whether an impl written for `t` itself — one instance, `Wrapper<MonType>` —
/// implements `trait_key` : it wins over the base's generic impl, bounds unasked.
///
/// @param t          the receiver.
/// @param trait_key  the trait asked about.
export has_instance_impl :: fn(t: Type, trait_key: string, typed: TypedProgram) -> bool {
    own_key :: own_impl_key(typed, t) ?? return false
    own :: typed.impl_tables.struct_implemented_traits[own_key] ?? return false
    return trait_key in own
}

/// The `impl_methods` key of a `source implements Into<target>` impl, so several
/// `Into` impls of one source don't collide.
///
/// @param source  the implementing type.
/// @param target  the `Into` argument.
into_impl_key :: fn(source: Type, target: Type) -> string =
    "${impl_type_key(source)}::into::${impl_type_key(target)}"

// The suffix a generic impl's `into` is keyed under after its side key : the base
// of the type it converts into (`"[]::into::<Iterator>"`).
into_toward_suffix :: fn(target: Type) -> string = "::${METHOD_INTO}::${impl_base_key(target)}"

/// The `into` member registered for converting `source` into `target` — the
/// impl a coercion between the two goes through. Null when none converts them.
///
/// @param typed   the module the coercion is written in ; its table carries the
///                impls of every module it sees.
/// @param source  the converted value's type.
/// @param target  the type it converts into.
into_impl_method :: fn(
    typed: TypedProgram,
    source: Type,
    target: Type,
) -> ImplMethod | null {
    // One impl per (source, target) pair : a second is R2030.
    found :: typed.impl_tables.impl_methods[into_impl_key(source, target)] ?? return null
    return found[0]
}

/// The `into` an implicit conversion of `source` toward `target` goes through : the
/// impl of that exact pair, else the generic impl of `source`'s base toward
/// `target`'s base (`T[] implements<T> Into<Iterator<T>>`). Null when neither.
///
/// @param typed   the module the conversion is written in.
/// @param source  the converted value's type.
/// @param target  the slot's type.
into_method_toward :: fn(
    typed: TypedProgram, source: Type, target: Type,
) -> ImplMethod | null {
    exact :: into_impl_method(typed, source, target)
    if exact != null {
        return exact
    }
    // One generic impl per target base : two would overlap (R2030).
    key :: "${dispatch_key(source)}${into_toward_suffix(target)}"
    found :: typed.impl_tables.impl_methods[key] ?? return null
    return found[0]
}

/// True iff an impl on `t` itself or on its base registers `trait_key` in
/// `ImplTables.struct_implemented_traits`, every argument of a generic impl
/// included, whatever its bounds.
base_implements_trait :: fn(t: Type, trait_key: string, typed: TypedProgram) -> bool =
    trait_key in impl_side_list(typed, typed.impl_tables.struct_implemented_traits, t, "")

/// True iff `t` implements `trait_key` : it has the impl built in
/// (`has_builtin_impl`), or its nominal carrier
/// has an impl of it (`base_implements_trait`), and a generic impl counts only
/// for the arguments its bounds admit — `Box<T> implements<T: Display>
/// Display` makes `Box<i32>` implement `Display`, not `Box<Point>` when `Point`
/// has none (`ImplTables.impl_bounds`). Shared by trait widening, the T3006 /
/// T3018 checks and UFCS dispatch.
export struct_implements_trait :: fn(t: Type, trait_key: string, typed: TypedProgram) -> bool {
    if has_builtin_impl(t, trait_key) {
        return true
    }
    if !base_implements_trait(t, trait_key, typed) {
        return false
    }
    return blocking_bound(t, trait_key, typed) == null
}

/// True iff `t` implements `wanted` at `wanted`'s own arguments, not merely some
/// instance of it : `Cell<i64>` implements `Source<i64>`, which is no
/// `Source<i32>`. Arguments either side leaves to the trait's defaults are filled in,
/// `Self` read as `t`, before comparing (`i32 implements Add` is `Add<i32, i32>`).
/// A trait asked without arguments is decided by `struct_implements_trait` alone.
///
/// @param t       the implementing type.
/// @param wanted  the trait instance a slot asks for.
/// @param typed   the module asking ; its tables carry every impl it sees.
implements_trait_instance :: fn(t: Type, wanted: TraitType, typed: TypedProgram) -> bool {
    key :: trait_key_of(wanted.symbol)
    if !struct_implements_trait(t, key, typed) {
        return false
    }
    if wanted.args.len() == 0 {
        return true
    }
    // Any impl of the trait at the arguments asked (`Into<Label>` beside `Into<Tag>`).
    asked :: with_trait_defaults(t, wanted.args, wanted.symbol, typed)
    lists :: struct_trait_arg_lists(t, key, typed)
    if lists.len() > 1 && !is_gen_state_struct(t) {
        for raw in lists {
            args :: resolve_trait_args_for(t, raw, typed)
            have :: with_trait_defaults(t, args, wanted.symbol, typed)
            if struct_args_compatible(have, asked) {
                return true
            }
        }
        return false
    }
    impl_args :: resolve_struct_trait_args(t, key, typed) ?? return true
    have :: with_trait_defaults(t, impl_args, wanted.symbol, typed)
    return struct_args_compatible(have, asked)
}

// `args`, arguments given to the trait `sym`, with the defaults the trait declares
// where they are left out and `Self` read as `self_ty`: `i32 implements Add` and a
// bound `Add<i32>` are both `Add<i32, i32>`.
with_trait_defaults :: fn(
    self_ty: Type,
    args: Type[],
    sym: Symbol,
    typed: TypedProgram,
) -> Type[] {
    decl :: typed.trait_decls[sym.id] ?? return args
    owner :: typed.trait_decl_owners[sym.id] ?? typed.resolved
    out: Type[]: []
    for a in pad_trait_default_args(args, decl.type_params, owner) {
        out.push(substitute_self(a, self_ty))
    }
    return out
}

/// Why `t` does not implement `trait_key` although an impl of it exists for `t`'s
/// base : the bound its arguments leave unmet, as a detail suffix. Empty when no
/// impl's bound is what fails.
///
/// @param t          the type that failed the check.
/// @param trait_key  the trait it was checked against.
unmet_impl_bound_note :: fn(t: Type, trait_key: string, typed: TypedProgram) -> string {
    unmet :: blocking_bound(t, trait_key, typed) ?? return ""
    return impl_bound_note(unmet)
}

// " ; its impl requires `T: Bump`, and `Plain` does not implement it".
impl_bound_note :: fn(unmet: UnmetBound) -> string {
    required :: display_type(unmet.required)
    return " ; its impl requires `${unmet.bound.name}: ${required}`, and ${unmet.reason}"
}

/// Why `arg` does not meet the bound trait `required`, or null when it does: it
/// must implement the trait at its arguments. The one rule a generic call, a struct
/// literal and a bounded impl's member are held to.
///
/// @param arg       the type bound to the parameter.
/// @param required  one trait of the parameter's bound ; arguments naming a type
///                  parameter are left undecided.
/// @return          the end of a sentence (`` `Cfg` does not implement it ``), or null.
unmet_bound_reason :: fn(
    arg: Type, required: TraitType, typed: TypedProgram,
) -> string | null {
    key :: trait_key_of(required.symbol)
    if !satisfies_bound(arg, key, typed) || !meets_trait_args(arg, required, typed) {
        return "`${display_type(arg)}` does not implement it"
    }
    return null
}

/// The type arguments a generic impl's bounds speak of : a struct's arguments,
/// an array's element. Empty for any other type.
///
/// @param t  the implementing type.
export type_arguments :: fn(t: Type) -> Type[] {
    if t is StructType {
        return t.args
    }
    if t is ArrayType {
        return [t.element]
    }
    no_arguments: Type[]: []
    return no_arguments
}

// A bound of a generic impl or struct that one of `t`'s arguments leaves unmet.
UnmetBound :: struct {
    bound: ArgBound
    required: TraitType
    arg: Type
    /// `unmet_bound_reason`'s answer.
    reason: string
}

// What keeps every generic impl of `trait_key` for `t`'s base from holding for
// `t`'s arguments : the first impl's first unmet bound. Null when an impl holds,
// when `t` has an impl of its own, or when no generic impl of the trait is
// recorded for the base.
blocking_bound :: fn(t: Type, trait_key: string, typed: TypedProgram) -> UnmetBound | null {
    args :: type_arguments(t)
    if args.len() == 0 || has_instance_impl(t, trait_key, typed) {
        return null
    }
    impls :: typed.impl_tables.impl_bounds[dispatch_key(t)] ?? return null
    first: UnmetBound | null = null
    for impl_ in impls {
        if impl_.trait_key != trait_key {
            continue
        }
        unmet :: first_unmet_bound(args, impl_.bounds, typed) ?? return null
        if first == null {
            first = unmet
        }
    }
    return first
}

// The first of `bounds`, by position, that `args` leave unmet.
first_unmet_bound :: fn(
    args: Type[], bounds: ArgBound[], typed: TypedProgram,
) -> UnmetBound | null {
    for bound in bounds {
        if bound.position >= args.len() {
            continue
        }
        arg :: args[bound.position]
        for required in bound.traits {
            reason :: unmet_bound_reason(arg, required, typed) ?? continue
            return UnmetBound {
                .bound = bound,
                .required = required,
                .arg = arg,
                .reason = reason,
            }
        }
    }
    return null
}

/// The detail of a T3006 on a type parameter's bound : ``type parameter `T` of
/// `owner` requires `Add`, and `Cfg` does not implement it``.
///
/// @param param     the type parameter's name.
/// @param owner     the generic fn or struct that declares it.
/// @param required  the bound trait it fails.
/// @param reason    `unmet_bound_reason`'s answer.
unmet_bound_detail :: fn(
    param: string, owner: string, required: TraitType, reason: string,
) -> string =
    "type parameter `${param}` of `${owner}` requires `${display_type(required)}`, and ${reason}"

// Whether `arg` satisfies the bound trait `trait_key` — at a bounded position of a
// generic impl, or bound to a callee's type parameter (T3006). An erased instance
// dispatches on the boxed value, so what counts is what that dispatch reaches : a
// type parameter through its own bound, a union through every variant, a distinct
// through its own impl or its backing's — and an array not for `Display`, which
// no vtable carries.
// A type still unknown here is not held against the bound.
satisfies_bound :: fn(arg: Type, trait_key: string, typed: TypedProgram) -> bool = match arg {
    is TypeParamType -> bound_names_trait(arg, trait_key, typed)
    is UnionType     -> (all_satisfy_bound(arg.variants, trait_key, typed)
        && (trait_key != core_trait_key(TRAIT_EQUALS) || untagged_beside_variant(arg) == null))
    is TraitType     -> trait_key_of(arg.symbol) == trait_key || struct_implements_trait(arg, trait_key, typed)
    is DistinctType  -> (struct_implements_trait(arg, trait_key, typed)
        || satisfies_bound(arg.backing, trait_key, typed))
    is ArrayType     -> trait_key != core_trait_key(TRAIT_DISPLAY) && struct_implements_trait(arg, trait_key, typed)
    // A range is its integer to every impl.
    is RangeType     -> satisfies_bound(range_representation(arg), trait_key, typed)
    is AnyType | UnresolvedType | FreeIntType | FreeFloatType | FreeCharType | NeverType
        | SelfType | InferVar -> true
    is PrimitiveType | StructType | EnumType | TupleType | FnType | TypeMetaType -> {
        struct_implements_trait(arg, trait_key, typed)
    }
}

// Whether `t`'s bound names `trait_key`, read from the project table, where a
// parameter an impl borrows from its struct also carries the struct's bound.
bound_names_trait :: fn(t: TypeParamType, trait_key: string, typed: TypedProgram) -> bool {
    bound :: typed.type_param_bound_traits[t.symbol.id] ?? return false
    for trait_ty in bound.traits {
        if trait_key_of(trait_ty.symbol) == trait_key {
            return true
        }
    }
    return false
}

// A variant of `u` with no tag of its own (`is_untagged`) that sits beside another
// non-null one : an `Equals` comparison, which tests which variant each side
// holds, can tell it only from `null`. Null when there is none.
untagged_beside_variant :: fn(u: UnionType) -> Type | null {
    held: usize = 0
    untagged: Type | null = null
    for v in u.variants {
        if !is_null_type(v) {
            held += 1
            if is_untagged(v) {
                untagged = v
            }
        }
    }
    return if held > 1 { untagged } else { null }
}

all_satisfy_bound :: fn(types: Type[], trait_key: string, typed: TypedProgram) -> bool {
    for t in types {
        if !satisfies_bound(t, trait_key, typed) {
            return false
        }
    }
    return true
}

/// The trait args recorded for `t implements <trait_key>` in
/// `struct_trait_args` (`Hello implements Greeter(i32)` →
/// `[i32]`), or `null` when no concrete impl is registered for `t`'s
/// nominal carrier. Shared by the typecheck's `unify_struct_to_trait_infer`
/// and the lowerer's trait-param monomorphisation.
export lookup_struct_trait_args :: fn(t: Type, trait_key: string, typed: TypedProgram) -> Type[] | null {
    // Several impls of the trait give `t` several argument lists : nothing single
    // to bind (`struct_trait_arg_lists` has them all).
    lists :: struct_trait_arg_lists(t, trait_key, typed)
    return if lists.len() == 1 { lists[0] } else { null }
}

/// Every argument list the impls of `trait_key` covering `t` record, one per impl
/// (`Vec2 implements Add<f64>` beside `Add<Vec2>` gives two) : those written for
/// `t` itself first, then its base's, less those an impl on `t` hides — the same
/// arguments, as `impl_candidates` hides members.
///
/// @param t          the implementing type.
/// @param trait_key  the trait.
struct_trait_arg_lists :: fn(t: Type, trait_key: string, typed: TypedProgram) -> Type[][] {
    base :: trait_arg_lists_at(typed, dispatch_key(t), trait_key)
    own_key :: own_impl_key(typed, t) ?? return base
    own :: trait_arg_lists_at(typed, own_key, trait_key)
    if own.len() == 0 {
        return base
    }
    out: Type[][]: []
    out.push_all(own)
    for args in base {
        if !coincides_with_any(own, resolve_trait_args_for(t, args, typed)) {
            out.push(args)
        }
    }
    return out
}

NO_ARG_LISTS: Type[][]: []

/// Whether several impls of `trait_key` cover `t` (`Iterator<A>` beside
/// `Iterator<B>`) : a use that does not name the trait's arguments cannot pick one.
///
/// @param t          the type asked about.
/// @param trait_key  the trait.
implements_more_than_once :: fn(t: Type, trait_key: string, typed: TypedProgram) -> bool =
    struct_trait_arg_lists(t, trait_key, typed).len() > 1

trait_arg_lists_at :: fn(typed: TypedProgram, key: string, trait_key: string) -> Type[][] {
    per_type :: typed.impl_tables.struct_trait_args[key] ?? return NO_ARG_LISTS
    lists :: per_type[trait_key] ?? return NO_ARG_LISTS
    return lists
}

coincides_with_any :: fn(lists: Type[][], args: Type[]) -> bool {
    for l in lists {
        if may_coincide_each(l, args) {
            return true
        }
    }
    return false
}

/// The trait args for `t implements <trait>`, with a GENERIC impl's recorded
/// args resolved against `t`'s concrete instance args. A generic impl records the
/// impl's own type-params (`FilterIterator<T> implements Iterator<T>` → `[T]`), so
/// a concrete `FilterIterator<i32>` needs `[T]` substituted by `[i32]` (via the
/// struct decl's `type_params` ↔ the instance's `.args`). Returns the raw args
/// when `t` isn't a struct instance or its decl is unavailable. Mirrors
/// `field.vader::substitute_trait_typeparams`; the source of truth for binding a
/// combinator/terminal's `Iterator<T>` param `T` from a concrete receiver.
resolve_struct_trait_args :: fn(t: Type, trait_key: string, typed: TypedProgram) -> Type[] | null {
    // A `generator`'s `<fn>$State<E>` implements `Iterator<E>` — its trait args ARE
    // its own type args (the concrete element carried per instance). The synthetic
    // struct has no `struct_decl`, so the generic-substitution path below can't apply.
    if trait_key == core_trait_key(TRAIT_ITERATOR) {
        if is_gen_state_struct(t) {
            if t is StructType { return t.args }
        }
    }
    raw :: lookup_struct_trait_args(t, trait_key, typed) ?? return null
    return resolve_trait_args_for(t, raw, typed)
}

// `raw`, an impl's recorded trait arguments, with a generic impl's own parameters
// resolved against `t`'s.
resolve_trait_args_for :: fn(t: Type, raw: Type[], typed: TypedProgram) -> Type[] {
    if t is StructType {
        out: Type[]: []
        for a in raw {
            out.push(substitute_struct_args(a, t, typed))
        }
        return out
    }
    if t is ArrayType {
        // `T[] implements<T: Equals> Contains<T>` gives `i32[]` the argument `i32`.
        out: Type[]: []
        for a in raw {
            out.push(substitute_array_element(a, t.element))
        }
        return out
    }
    return raw
}


/// Bidirectional narrowing : when a Free* literal flows into a slot that
/// wants a concrete numeric of the matching family, fold the literal to
/// the concrete primitive — into a union, to the member it settles on
/// (`union_literal_member`). Used by every check_expr-style call site.
narrow_for_expected :: fn(got: Type, expected: Type | null) -> Type {
    if expected is UnionType {
        member :: union_literal_member(got, expected) ?? return got
        return member
    }
    if expected == null || !literal_takes(got, expected) {
        return got
    }
    return expected
}

/// The member of `u` a free literal of kind `got` settles on : its family's
/// default (`i32`, `f64`, `char`) when the union has it, else its only member of
/// that family — `5` into `u8 | string` is a `u8`. `null` when `got` is not a
/// free literal, or the union has none, or several with no default among them
/// (T3089 at the literal).
///
/// @param got  the literal's free type.
/// @param u    the union it flows into.
export union_literal_member :: fn(got: Type, u: UnionType) -> Type | null {
    if !is_free_numeric(got) {
        return null
    }
    candidates :: union_literal_candidates(got, u)
    preferred :: default_if_free(got)
    for c in candidates {
        if equals_type(c, preferred) {
            return c
        }
    }
    return if candidates.len() == 1 { candidates[0] } else { null }
}

/// The members of `u` a free literal of kind `got` could take : the integer
/// widths and ranges for `5`, the float widths for `2.5`, the integers and `char`
/// for `'a'`. Empty when `got` is not a free literal.
///
/// @param got  the literal's free type.
/// @param u    the union it flows into.
union_literal_candidates :: fn(got: Type, u: UnionType) -> Type[] {
    out: Type[]: []
    for v in u.variants {
        if literal_takes(got, v) {
            out.push(v)
        }
    }
    return out
}

// Whether a free literal of kind `got` can be a value of `t` : of a primitive of
// its family (`literal_family_holds`), and for an integer one of any range, its
// value checked where it is pinned (T3066).
literal_takes :: fn(got: Type, t: Type) -> bool =
    literal_family_holds(got, primitive_name(t)) || (got is FreeIntType && is_refinement(t))

// A free literal of kind `got` can be a value of the primitive `name` : an
// integer width for `5`, a float width for `2.5`, an integer width or `char` for
// `'a'` (its codepoint, bounds-checked where it is pinned).
literal_family_holds :: fn(got: Type, name: string) -> bool = match got {
    is FreeIntType   -> is_int_name(name)
    is FreeFloatType -> is_float_name(name)
    is FreeCharType  -> is_int_name(name) || name == "char"
    is PrimitiveType | EnumType | DistinctType | RangeType | ArrayType | StructType | TraitType
     | UnionType | TupleType | FnType | TypeParamType | InferVar | TypeMetaType | SelfType
     | UnresolvedType | NeverType | AnyType -> false
}

/// Do `a` and `b` share any concrete runtime value ? Powers T3040
/// ("test can never match") and the match-arm overlap check.
/// UnionType on either side recurses into its variants.
types_overlap :: fn(a: Type, b: Type) -> bool {
    av :: union_variants(a)
    if !(av is null) {
        for v in av { if types_overlap(v, b) { return true } }
        return false
    }
    bv :: union_variants(b)
    if !(bv is null) {
        for v in bv { if types_overlap(a, v) { return true } }
        return false
    }
    return equals_type(a, b)
}

/// Whether a value of `a` and one of `b` are the same variant to `==` : one type,
/// or a free literal the other type takes. A union compares a
/// variant only with its counterpart on the other side.
///
/// @param a  a variant of one operand, or the operand itself.
/// @param b  a variant of the other operand, or the operand itself.
same_variant :: fn(a: Type, b: Type) -> bool =
    equals_type(a, b)
        || (is_free_numeric(a) && is_assignable(a, b))
        || (is_free_numeric(b) && is_assignable(b, a))

/// The variant of `t` that is the same as `variant` (`same_variant`) — `t` itself
/// when it is no union and matches. Null when none is.
///
/// @param t        an operand's type.
/// @param variant  a variant of the other operand.
export counterpart :: fn(t: Type, variant: Type) -> Type | null {
    for v in union_variants(t) ?? [t] {
        if same_variant(v, variant) {
            return v
        }
    }
    return null
}

/// The variants of `t` when it is a union, `null` otherwise —
/// `union_variants(t) ?? [t]` reads any type as its list of variants.
///
/// @param t  the type to read.
export union_variants :: fn(t: Type) -> Type[] | null {
    if t is UnionType { return t.variants }
    return null
}

/// Subtract a single variant from a type. Returns the remaining type
/// (or `Never` if nothing remains). For non-union sources subtracting
/// the same shape yields `Never` ; subtracting a different shape is a
/// no-op. Used by flow narrowing — `if x is T` widens to "not T" on
/// the false side / in code after a divergent guard.
export subtract_type :: fn(from: Type, removed: Type) -> Type {
    if from is UnionType {
        kept: Type[]: []
        for v in from.variants {
            if !removed_covers(removed, v) { kept.push(v) }
        }
        if kept.len() == 0 { return TY_NEVER }
        if kept.len() == 1 { return kept[0] }
        return mk_union(kept)
    }
    if removed_covers(removed, from) { return TY_NEVER }
    return from
}

/// `subtract_type` extended for a trait `removed` : a runtime trait test
/// matches every union variant whose nominal carrier implements the trait
/// (mirroring `c_emit/walker.vader::trait_check_expr` and the VM's
/// `ref_type_matches`), so those variants leave the remainder too —
/// `match x: IOError | string { is string …, is Error … }` is exhaustive.
/// A non-trait `removed` delegates to plain `subtract_type`.
subtract_type_with_impls :: fn(from: Type, removed: Type, typed: TypedProgram) -> Type {
    if !(removed is TraitType) { return subtract_type(from, removed) }
    trait_key :: trait_key_of(removed.symbol)
    if from is UnionType {
        kept: Type[]: []
        for v in from.variants {
            if removed_covers(removed, v) { continue }
            if base_implements_trait(v, trait_key, typed) { continue }
            kept.push(v)
        }
        if kept.len() == 0 { return TY_NEVER }
        if kept.len() == 1 { return kept[0] }
        return mk_union(kept)
    }
    if removed_covers(removed, from) { return TY_NEVER }
    if base_implements_trait(from, trait_key, typed) { return TY_NEVER }
    return from
}

// True when `removed` covers `t` — either `removed` IS `t`, or `removed`
// is a union that lists `t` among its variants. Without the union case,
// subtracting a union (e.g. the `!(x is T)` divergent-guard's inner
// complement) removes nothing — the double-complement `subtract(NU,
// (N-1)U)` then yields the full union instead of the single `T`, so the
// negated guard fails to narrow and downstream field-gets degrade.
removed_covers :: fn(removed: Type, t: Type) -> bool {
    if removed is UnionType {
        for v in removed.variants { if equals_type(v, t) { return true } }
        return false
    }
    return equals_type(removed, t)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "vader/resolver/symbol"
import "vader/types"

@test
test_equals_primitive :: fn() -> void {
    assert(equals_type(mk_primitive("i32"), mk_primitive("i32")), "i32 == i32")
    assert(!equals_type(mk_primitive("i32"), mk_primitive("i64")), "i32 != i64")
}

@test
test_equals_array :: fn() -> void {
    a1: Type: mk_array(mk_primitive("i32"))
    a2: Type: mk_array(mk_primitive("i32"))
    a3: Type: mk_array(mk_primitive("string"))
    assert(equals_type(a1, a2), "i32[] == i32[]")
    assert(!equals_type(a1, a3), "i32[] != string[]")
}

// `is_assignable` tests live in `type_assign.vader` alongside the impl.

@test
test_union_of_dedup :: fn() -> void {
    i32_t: Type: mk_primitive("i32")
    str_t: Type: mk_primitive("string")
    // A | B | A should collapse to A | B
    u :: union_of([i32_t, str_t, i32_t])
    match u {
        is UnionType -> { assert_eq(u.variants.len(), 2) }
        _ -> { assert(false, "expected a Union after dedup") }
    }
}

@test
test_union_of_drops_never :: fn() -> void {
    i32_t: Type: mk_primitive("i32")
    never_t: Type: TY_NEVER
    // i32 | Never should collapse to i32
    u :: union_of([i32_t, never_t])
    match u {
        is PrimitiveType -> { assert_eq(u.name, "i32") }
        _ -> { assert(false, "Never should be absorbed") }
    }
}

@test
test_union_of_flattens :: fn() -> void {
    i32_t: Type: mk_primitive("i32")
    str_t: Type: mk_primitive("string")
    bool_t: Type: mk_primitive("bool")
    inner :: mk_union([i32_t, str_t])
    u :: union_of([inner, bool_t])
    match u {
        is UnionType -> { assert_eq(u.variants.len(), 3) }
        _ -> { assert(false, "flattened union should have 3 variants") }
    }
}

@test
test_machine_integer_is_its_primitive :: fn() -> void {
    assert(equals_type(TY_I32, mk_primitive("i32")), "the range `i32` is the primitive")
    assert(!equals_type(TY_I32, mk_primitive("i64")), "`i32` is no `i64`")
    assert(!equals_type(mk_integer("u64"), mk_primitive("usize")), "`u64` is no `usize`")
}

@test
test_union_of_orders_same_named_types_by_identity :: fn() -> void {
    factory :: SymbolFactory {}
    first: Type: mk_struct(factory.make(.Struct, "Point", "pa", "pa", .Public, null), [])
    second: Type: mk_struct(factory.make(.Struct, "Point", "pb", "pb", .Public, null), [])
    one_way :: union_of([first, second])
    other_way :: union_of([second, first])
    assert(equals_type(one_way, other_way), "the order the variants arrive in does not matter")
}

@test
test_default_if_free :: fn() -> void {
    assert_eq(display_type(default_if_free(TY_FREE_INT)), "i32")
    assert(default_if_free(TY_FREE_INT) is RangeType, "FreeInt defaults to the range `i32`")
    match default_if_free(TY_FREE_FLOAT) as p {
        is PrimitiveType -> { assert_eq(p.name, "f64") }
        _                -> { assert(false, "FreeFloat defaults to f64") }
    }
    // Non-free types pass through.
    i32_t :: mk_primitive("i32")
    match default_if_free(i32_t) as p {
        is PrimitiveType -> { assert_eq(p.name, "i32") }
        _                -> { assert(false, "i32 should pass through") }
    }
}

@test
test_int_fits_bounds :: fn() -> void {
    // Out of range → rejected (T3066 at the pin site).
    assert(!int_fits(9000000000, false, "i32"), "9e9 does not fit i32")
    assert(!int_fits(300, false, "u8"), "300 does not fit u8")
    assert(!int_fits(0xFFFF_FFFF_FFFF_FFFF, false, "i64"), "u64.MAX does not fit i64")
    assert(!int_fits(128, false, "i8"), "128 does not fit i8")
    assert(!int_fits(0x8000_0000, false, "i32"), "2^31 does not fit i32")
    assert(!int_fits(0x8000_0000_0000_0000, false, "i64"), "2^63 does not fit i64")
    // In-range values and maxima → accepted.
    assert(int_fits(0x7FFF_FFFF, false, "i32"), "i32.MAX fits i32")
    assert(int_fits(255, false, "u8"), "u8.MAX fits u8")
    assert(int_fits(0xFFFF_FFFF_FFFF_FFFF, false, "u64"), "u64.MAX fits u64")
    assert(int_fits(0xFFFF_FFFF_FFFF_FFFF, false, "usize"), "u64.MAX fits usize")
    // A non-integer target never accepts an integer literal via this path.
    assert(!int_fits(0, false, "f64"), "int literal never fits f64")
    assert(!int_fits(0, false, "bool"), "int literal never fits bool")
}

@test
test_int_fits_negative_literals :: fn() -> void {
    assert(int_fits(128, true, "i8"), "-128 fits i8")
    assert(!int_fits(129, true, "i8"), "-129 does not fit i8")
    assert(int_fits(0x8000_0000, true, "i32"), "i32.MIN fits i32")
    assert(int_fits(0x8000_0000_0000_0000, true, "i64"), "i64.MIN fits i64")
    assert(!int_fits(0x8000_0000_0000_0001, true, "isize"), "past isize.MIN")
    assert(!int_fits(1, true, "u32"), "-1 does not fit u32")
    assert(int_fits(0, true, "u8"), "-0 fits u8")
}
