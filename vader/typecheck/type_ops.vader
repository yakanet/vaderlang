// vader/typecheck/type_ops — equality, union canonicalisation, immutability bits.
//
// Nothing here touches the `ImplRegistry` (`impls.vader`) — trait questions are
// answered only from the precomputed side-tables on `TypedProgram`
// (`struct_implemented_traits` / `struct_trait_args`), which is why
// `struct_implements_trait` can live here while the registry-driven widening
// stays with its callers — `field.vader::receiver_fits_first_param` via
// `try_trait_widen`. `is_assignable`
// and its per-variant helpers are in `type_assign.vader`, split out so each
// variant compiles to a small dedicated C fn rather than one monster cascade.

module "vader/typecheck"

import "std/collections"
import "std/string"
import "std/sort"
AST :: import "toolchain/ast"

/// True when `t` is the `void` primitive — by name, so a `void` built anywhere
/// passes, not only the `TY_VOID` singleton.
export is_void :: fn(t: Type) -> bool {
    if t is PrimitiveType { return t.name == "void" }
    return false
}

// ---- numeric registries (used by Free* defaulting + assignable) -----------
//
// The int/signed/float partition is the single source of truth in
// `vader/types::PRIMITIVE_META`. These thin re-exports keep the ~40 call sites
// that import the predicates from `vader/typecheck` unchanged.


/// Whether a Unicode codepoint fits the integer primitive `type_name`. A char
/// literal coerces to an integer only when its codepoint is representable —
/// `b == '💩'` (u8) is rejected. Delegates to the authoritative per-repr range
/// table (`repr_range` / `contains`), so the byte/short bounds stay in one place.
/// Non-integer names return false (a char never coerces to e.g. f64).
export char_fits :: fn(codepoint: u32, type_name: string) -> bool {
    if !is_int_name(type_name) { return false }
    return contains(repr_range(type_name), i64(codepoint))
}

/// Whether the (non-negative) magnitude of an integer literal fits the integer
/// primitive `type_name`. `value` is the `u64` the AST carries — the sign of a
/// negated literal is handled separately by the caller. Mirrors `char_fits` :
/// a free integer literal pinned to a concrete width must be representable, so
/// `x: i32 = 9000000000` / `x: u8 = 300` are rejected (T3066). `u64` / `usize`
/// carry any magnitude the AST can hold ; `i64` / `isize` cap at `i64.MAX` (the
/// AST can't carry a larger positive) ; narrower widths defer to `repr_range`.
export int_fits :: fn(value: u64, type_name: string) -> bool {
    if !is_int_name(type_name) { return false }
    if type_name == "u64" || type_name == "usize" { return true }
    // Signed 64-bit : allow up to 2^63 so the negated minimum
    // (`-9223372036854775808`, i64.MIN) type-checks. The bare positive 2^63 is
    // one past i64.MAX, but its only reachable use is as the negated MIN.
    if type_name == "i64" || type_name == "isize" { return value <= 9223372036854775808 }
    // Narrower widths : any value above `i64.MAX` overflows the range table's
    // `i64` domain, so reject up front ; otherwise consult the [min, max] table.
    if value > 9223372036854775807 { return false }
    r :: repr_range(type_name)
    if !r.has_bounds { return true }
    // `value` is a non-negative magnitude. For a signed width permit `max + 1`
    // (= 2^(n-1)) so the negated minimum `-2^(n-1)` fits ; unsigned caps at max.
    if is_signed_int_name(type_name) { return i64(value) <= r.max + 1 }
    return i64(value) <= r.max
}

// True when `target` is one of `names`. A small shared membership helper.
contains_name :: fn(names: string[], target: string) -> bool {
    for n in names { if n == target { return true } }
    return false
}

// ---- equality -------------------------------------------------------------

/// Structural equality. Recursive on unions / fns / arrays / tuples ; for
/// nominal types (Struct / Trait / Enum / TypeParam) we compare symbol ids.
export equals_type :: fn(a: Type, b: Type) -> bool = match a {
    is TypeMetaType   -> b is TypeMetaType
    is SelfType       -> b is SelfType
    is UnresolvedType -> b is UnresolvedType
    is NeverType      -> b is NeverType
    is FreeIntType    -> b is FreeIntType
    is FreeFloatType  -> b is FreeFloatType
    is FreeCharType   -> b is FreeCharType
    is AnyType        -> b is AnyType
    is PrimitiveType  -> if b is PrimitiveType as bx { a.name == bx.name } else { false }
    is TypeParamType  -> if b is TypeParamType as bx { a.symbol.id == bx.symbol.id } else { false }
    // `StructType<EnumSym>` is the placeholder `type_from_expr` returns
    // for enum names ; treat it as equivalent to the real `EnumType` so
    // body-time assignability (annotation vs inferred) doesn't fight the
    // placeholder/proper distinction.
    is EnumType  -> if b is EnumType as bx {
        a.symbol.id == bx.symbol.id
    } else if b is StructType {
        b.symbol.id == a.symbol.id
    } else { false }
    // Immutability is NOT part of struct / tuple identity : the bit records a
    // promise made by one function about one parameter, not a different type.
    // Two `Cfg` are one type whether or not a borrow is read-only, so caches,
    // union dedup, monomorphisation keys and overlap tests all keep working
    // unchanged. `ArrayType` below is the exception — read-only `T[]` is a written
    // annotation that freezes the referent, hence a genuinely distinct type.
    is StructType  -> if b is StructType as bx {
        nominal_eq(a.symbol.id, a.args, bx.symbol.id, bx.args)
    } else if b is EnumType {
        a.symbol.id == b.symbol.id
    } else { false }
    is TraitType -> if b is TraitType as bx { nominal_eq(a.symbol.id, a.args, bx.symbol.id, bx.args) } else { false }
    is ArrayType -> if b is ArrayType as bx { a.immutable == bx.immutable && equals_type(a.element, bx.element) } else { false }
    is TupleType -> if b is TupleType as bx { type_list_equals(a.elements, bx.elements) } else { false }
    is FnType    -> if b is FnType as bx { type_list_equals(a.params, bx.params) && equals_type(a.return_type, bx.return_type) } else { false }
    is UnionType -> if b is UnionType as bx { type_list_equals(a.variants, bx.variants) } else { false }
    // Distinct (newtype) types : nominal identity by symbol id. A distinct
    // type equals only itself, never its backing primitive nor another
    // distinct over the same backing — that's the whole point.
    is DistinctType  -> if b is DistinctType as bx { a.symbol.id == bx.symbol.id } else { false }
}

nominal_eq :: fn(a_id: i32, a_args: Type[], b_id: i32, b_args: Type[]) -> bool {
    if a_id != b_id { return false }
    return type_list_equals(a_args, b_args)
}

/// Element-wise structural equality of two type lists (params, tuple
/// elements, union variants). Companion to `equals_type` — same per-element
/// `equals_type` comparison, length-checked first.
export type_list_equals :: fn(a: Type[], b: Type[]) -> bool {
    if a.len() != b.len() { return false }
    for i in 0..<a.len() {
        if !equals_type(a[i], b[i]) { return false }
    }
    return true
}

// ---- immutability ---------------------------------------------------------

/// `t` with its top-level immutability bit set to `immutable`.
///
/// On a union the bit is **distributed over the variants** — `UnionType` itself
/// never carries one — so a later `x is Cfg` narrowing finds the bit already on
/// the variant it selects. Shapes that can't carry the bit (`type_is_immutable`
/// answers false for them) come back unchanged, and so does a type that already
/// has the requested bit.
export with_immutable :: fn(t: Type, immutable: bool) -> Type = match t {
    is ArrayType    -> if t.immutable == immutable { t } else { mk_array(t.element, immutable) }
    is StructType   -> if t.immutable == immutable { t } else { mk_struct(t.symbol, t.args, immutable) }
    is TupleType    -> if t.immutable == immutable { t } else { mk_tuple(t.elements, immutable) }
    is UnionType    -> union_of(with_immutable_each(t.variants, immutable))
    is TraitType    -> if t.immutable == immutable {
        t
    } else {
        TraitType { ...t, .immutable = immutable }
    }
    is DistinctType -> if !carries_mutability_bit(t) || type_is_immutable(t) == immutable {
        t
    } else {
        mk_distinct(t.symbol, with_immutable(t.backing, immutable))
    }
    is PrimitiveType | EnumType | FnType | TypeParamType | TypeMetaType
     | SelfType | UnresolvedType | FreeIntType | FreeFloatType | FreeCharType
     | NeverType | AnyType -> t
}

with_immutable_each :: fn(variants: Type[], immutable: bool) -> Type[] {
    out: Type[]!: []
    for v in variants { out.push(with_immutable(v, immutable)) }
    return out
}

// `a` and `b` at the rights both hold : the same type, each level read-only when
// either is. Null when they differ by more than their rights. It is what a type
// parameter bound by two arguments keeps (`unify_type_param`), and what a join of
// two such variants keeps (`collect_variant`), so neither lends rights the other
// lacks.
least_permissive :: fn(a: Type, b: Type) -> Type | null = bound_rights(a, b, true)

// `a` and `b` with each level read-only when either is (`read_only_wins`), or only
// when both are — the other bound, which a fn type's parameters take, since a fn
// accepting what both accept demands what either demands. `a` itself comes back when
// no level of it changes.
bound_rights :: fn(a: Type, b: Type, read_only_wins: bool) -> Type | null {
    match a {
        is ArrayType -> {
            if b is ArrayType {
                element :: bound_rights(a.element, b.element, read_only_wins) ?? return null
                immutable :: container_bit(a, b, [a.element], [b.element], read_only_wins) ??
                    return TY_NEVER
                if element === a.element && immutable == a.immutable {
                    return a
                }
                return mk_array(element, immutable)
            }
        }
        is StructType -> {
            if b is StructType && b.symbol.id == a.symbol.id {
                args :: bound_rights_each(a.args, b.args, read_only_wins) ?? return null
                immutable :: container_bit(a, b, a.args, b.args, read_only_wins) ??
                    return TY_NEVER
                if args === a.args && immutable == a.immutable {
                    return a
                }
                return mk_struct(a.symbol, args, immutable)
            }
        }
        is TupleType -> {
            if b is TupleType {
                elements :: bound_rights_each(a.elements, b.elements, read_only_wins) ?? return null
                immutable :: container_bit(a, b, a.elements, b.elements, read_only_wins) ??
                    return TY_NEVER
                if elements === a.elements && immutable == a.immutable {
                    return a
                }
                return mk_tuple(elements, immutable)
            }
        }
        is TraitType -> {
            if b is TraitType && b.symbol.id == a.symbol.id {
                args :: bound_rights_each(a.args, b.args, read_only_wins) ?? return null
                immutable :: container_bit(a, b, a.args, b.args, read_only_wins) ??
                    return TY_NEVER
                if args === a.args && immutable == a.immutable {
                    return a
                }
                return TraitType { ...a, .args = args, .immutable = immutable }
            }
        }
        is DistinctType -> {
            if b is DistinctType && b.symbol.id == a.symbol.id {
                backing :: bound_rights(a.backing, b.backing, read_only_wins) ?? return null
                return if backing === a.backing { a } else { mk_distinct(a.symbol, backing) }
            }
        }
        // Variants pair by index : `union_of` sorts them on a key blind to the marker.
        is UnionType -> {
            if b is UnionType {
                variants :: bound_rights_each(a.variants, b.variants, read_only_wins) ?? return null
                return if variants === a.variants { a } else { union_of(variants) }
            }
        }
        is FnType -> {
            if b is FnType {
                return bound_fn_rights(a, b, read_only_wins)
            }
        }
        _ -> {}
    }
    // Any other pair agrees only with itself.
    return if equals_type(a, b) { a } else { null }
}

// The return and the `!` marks take the bound asked for — the least rights keep a
// mark either fn carries ; the parameters' types take the other one.
bound_fn_rights :: fn(a: FnType, b: FnType, read_only_wins: bool) -> Type | null {
    params :: bound_rights_each(a.params, b.params, !read_only_wins) ?? return null
    ret :: bound_rights(a.return_type, b.return_type, read_only_wins) ?? return null
    marks: bool[]!: []
    kept := params === a.params && ret === a.return_type
    for i in 0..<a.params.len() {
        mark :: merged_bit(param_mutable_at(a, i), param_mutable_at(b, i), read_only_wins)
        marks.push(mark)
        kept = kept && mark == param_mutable_at(a, i)
    }
    if kept {
        return a
    }
    return FnType {
        .params         = params,
        .params_mutable = if true in marks { marks } else { [] },
        .return_type    = ret,
    }
}

merged_bit :: fn(a: bool, b: bool, read_only_wins: bool) -> bool =
    if read_only_wins { a || b } else { a && b }

// A container's bit in the bound of `a` and `b`, whose contents are `a_inner` and
// `b_inner`. A mutable container holds its contents at the rights written, so
// contents whose rights differ need a read-only one. Under the other bound a
// read-only container fits neither side : null, and the caller answers `never`,
// the parameter no argument fills.
container_bit :: fn(
    a: Type, b: Type, a_inner: Type[], b_inner: Type[], read_only_wins: bool,
) -> bool | null {
    immutable :: merged_bit(type_is_immutable(a), type_is_immutable(b), read_only_wins)
    if immutable || same_rights_each(a_inner, b_inner) {
        return immutable
    }
    return if read_only_wins { true } else { null }
}

same_rights_each :: fn(a: Type[], b: Type[]) -> bool {
    for i in 0..<a.len() {
        if bound_rights(a[i], b[i], true) !== a[i] || bound_rights(b[i], a[i], true) !== b[i] {
            return false
        }
    }
    return true
}

// Pairwise ; `a` itself when no element changes.
bound_rights_each :: fn(a: Type[], b: Type[], read_only_wins: bool) -> Type[] | null {
    if a.len() != b.len() {
        return null
    }
    out: Type[]!: []
    kept := true
    for i in 0..<a.len() {
        met :: bound_rights(a[i], b[i], read_only_wins) ?? return null
        kept = kept && met === a[i]
        out.push(met)
    }
    return if kept { a } else { out }
}

/// The type of a parameter once its `!` marker is desugared onto the type.
///
/// An unmarked parameter is a read-only borrow. A `!` grants mutation — but only
/// when the WRITTEN type doesn't already forbid it : a read-only `i32[]` slot stays
/// read-only. `const` is a property of the TYPE (the referent is frozen, e.g. a
/// module const), `!` a property of the SLOT ; they are orthogonal and the
/// stricter of the two wins. Without this the marker would silently launder a
/// frozen referent into a mutable one.
export desugared_param_type :: fn(t: Type, mutable: bool) -> Type {
    if type_is_immutable(t) { return t }
    return with_immutable(t, !mutable)
}

/// `t` with every level the writer did NOT mark turned read-only.
///
/// The default has to be RECURSIVE or `Cfg![]` means nothing — it would be
/// indistinguishable from a plain `Cfg[]`. So `x: Cfg[]` freezes the array AND
/// its elements, and only a written `!` reopens a level.
///
/// It descends through STRUCTURAL children (array element, tuple elements) and
/// stops at NOMINAL boundaries : the args of `Map<K, V>` describe what is stored,
/// not slots of the program, so the default does not reach into them.
///
/// `written` is walked ALONGSIDE `t` because, once lowered, an explicit `!` and
/// the default are indistinguishable : both leave `immutable = false`. Only the
/// written form still knows which levels the author marked.
///
/// @param t        the lowered type.
/// @param written  the type as written, or null when there is none.
export apply_readonly_default :: fn(t: Type, written: AST.TypeExpr | null) -> Type {
    // A union carries no marker of its own — the bit is DISTRIBUTED over its
    // variants, each taking the marker of the written variant it came from
    // (`written_variant_for`). The variant's CHILDREN take the default too, exactly
    // as they do outside a union : `Box[] | null` is not `Box![] | null`.
    if t is UnionType {
        wv :: written_union_variants(written)
        lowered_names :: nominal_names(t.variants)
        out: Type[]!: []
        for v in t.variants {
            w :: written_variant_for(wv, v, lowered_names)
            children :: readonly_children(v, AST.strip_mut_marker(w))
            out.push(with_immutable(children, w !is AST.MutableTypeExpr))
        }
        return union_of(out)
    }
    if written is AST.MutableTypeExpr {
        // A type that arrives ALREADY read-only (an alias, a side-table entry) is
        // not un-frozen by a marker : the stricter side wins, here as everywhere.
        // A belt rather than a live path now that `const` is gone — the surface has
        // no way left to write a frozen type under a `!`.
        inner :: readonly_children(t, written.inner)
        if type_is_immutable(inner) { return inner }
        // This level is explicitly mutable ; deeper levels still take the default.
        return with_immutable(inner, false)
    }
    // Already read-only : the stricter side wins, but the children still take the
    // default.
    if type_is_immutable(t) { return readonly_children(t, written) }
    return with_immutable(readonly_children(t, written), true)
}

// The written variants of a union, or an empty list when there is no written form.
// Hoisted out of the per-variant loop: `collect_bitor_variants` allocates.
written_union_variants :: fn(written: AST.TypeExpr | null) -> AST.TypeExpr[] {
    if written == null {
        return []
    }
    return AST.collect_bitor_variants(written)
}

same_written_shape :: fn(w: AST.TypeExpr, v: Type) -> bool {
    if w is AST.ArrayTypeExpr { return v is ArrayType }
    if w is AST.SeqLitExpr    { return v is TupleType }
    return v is StructType | TraitType | EnumType | DistinctType | PrimitiveType
}

// The written variant `v` came from, marker INTACT — the caller reads the marker for
// `v`'s own level and the form under it for `v`'s children.
//
// Not by position : `union_of` sorts the lowered variants by `display_type`, so the
// two lists do not line up. A nominal variant pairs by NAME first — `i64 | Trap!`
// holds two nominals — then by SHAPE, skipping a written nominal that names a
// lowered variant : what is left is an alias, whose marker its nominal variants take
// (`Value! | Trap` marks the `Value` structs, not `Trap`). Shape is what keeps the
// mark on `u8[]!` in `u8[]! | Err` off the `Err` nobody marked. Two variants of one
// shape and one name — `Box<i32>! | Box<string>`, two array variants — still pair
// with the first.
written_variant_for :: fn(
    written: AST.TypeExpr[], v: Type, lowered_names: string[],
) -> AST.TypeExpr | null {
    name :: nominal_name(v)
    if name != "" {
        for w in written {
            if written_name(w) == name {
                return w
            }
        }
    }
    for w in written {
        inner :: AST.strip_mut_marker(w) ?? continue
        if same_written_shape(inner, v) && written_name(w) !in lowered_names {
            return w
        }
    }
    return null
}

// The names of `variants`' nominal variants.
nominal_names :: fn(variants: Type[]) -> string[] {
    out: string[]!: []
    for v in variants {
        name :: nominal_name(v)
        if name != "" {
            out.push(name)
        }
    }
    return out
}

// The name a nominal variant is written with : `Trap` for `Trap`, `M.Trap!`, `Box<T>`.
written_name :: fn(w: AST.TypeExpr) -> string = callee_name(AST.strip_mut_marker(w) ?? w)

// @partial: only a nominal type has a name to pair a written variant with.
nominal_name :: fn(t: Type) -> string = @partial match t {
    is PrimitiveType -> t.name
    is StructType    -> t.symbol.name
    is TraitType     -> t.symbol.name
    is EnumType      -> t.symbol.name
    is DistinctType  -> t.symbol.name
    _                -> ""
}

// Rebuild `t`'s structural children under the default, pairing each with the
// matching node of the written type when the shapes line up. A mismatch (an
// alias, an inferred type) passes `null` — the child then takes the plain
// default, the conservative answer.
readonly_children :: fn(t: Type, written: AST.TypeExpr | null) -> Type {
    if t is ArrayType {
        elem_written :: if written is AST.ArrayTypeExpr as ae { ae.element } else { null }
        return mk_array(apply_readonly_default(t.element, elem_written), t.immutable)
    }
    if t is TupleType {
        elems: Type[]!: []
        for i in 0..<t.elements.len() {
            el_written: AST.TypeExpr | null = null
            if written is AST.SeqLitExpr {
                if i < written.elements.len() { el_written = written.elements[i] }
            }
            elems.push(apply_readonly_default(t.elements[i], el_written))
        }
        return mk_tuple(elems, t.immutable)
    }
    return t
}

/// The immutability a value narrowed to `narrowed` inherits from `scrutinee`.
///
/// `x is Cfg` writes only a type NAME, which carries no mutability of its own —
/// without this the narrowing would hand back a mutable `Cfg` and launder a
/// read-only borrow in one line. Since the bit is distributed over a union's
/// variants, the answer is the matching variant's bit ; failing a nominal match
/// (trait / subtype narrowing) it is read-only when any variant is — the narrowing
/// may select that one — so it never grants more than the scrutinee had. A `T`
/// grants what its bound does.
///
/// @param bounds  the type-parameter bounds (`type_param_bound_traits`).
export narrowing_immutability :: fn(
    scrutinee: Type, narrowed: Type, bounds: MutableMap<i32, TypeParamBound>,
) -> bool {
    if scrutinee is UnionType {
        for v in scrutinee.variants {
            if equals_type_shape(v, narrowed) { return type_is_immutable(v) }
        }
    }
    return withholds_mutation(scrutinee, bounds)
}

// ---- canonical union ------------------------------------------------------

/// Build a union from `variants`. Flattens nested unions, drops `Never`
/// (absorbed — a value of that type doesn't exist), dedups, sorts by
/// `display_type` output for stability. Empty / all-Never input
/// collapses to `Never`.
export union_of :: fn(variants: Type[]) -> Type {
    dedup: Type[]!: []
    for v in variants {
        v.collect_variant(dedup)
    }
    if dedup.len() == 0 { return TY_NEVER }
    if dedup.len() == 1 { return dedup[0] }
    return mk_union(sort_by_display_key(dedup))
}

// Order `types` by their `display_type_key`, rendering each key ONCE — the
// comparator reads a key already in hand rather than rendering its operands.
//
// Sorting the INDICES preserves `sort`'s stability, which is load bearing : two
// types can share a key (it erases `!`, `equals_type` does not) and must keep
// the order they arrived in. Do not swap this for an unstable sort.
sort_by_display_key :: fn(types: Type[]) -> Type[] {
    // `T | null` and its kind are most of the unions built here ; at two
    // variants the index detour buys nothing. Same key and the same STRICT
    // comparator as the general path below — the two must move together, and
    // swapping on a tie would break the stability above.
    //
    // The no-swap branch may ALIAS `types`, which `mk_union` keeps. Sound
    // because `union_of` builds `dedup` fresh and never writes to it again ; a
    // second caller would have to honour that. Both paths hand `mk_union` an
    // array grown by `push`, so it carries up to twice its used slots — a few
    // bytes here, more as arity grows.
    if types.len() == 2 {
        if compare_ascending_ci(display_type_key(types[1]), display_type_key(types[0])) {
            return [types[1], types[0]]
        }
        return types
    }
    keys: string[]!: []
    order: usize[]!: []
    for i in 0..<types.len() {
        keys.push(display_type_key(types[i]))
        order.push(i)
    }
    out: Type[]!: []
    for i in sort(order, (a: usize, b: usize) -> compare_ascending_ci(keys[a], keys[b])) {
        out.push(types[i])
    }
    return out
}

// Two arrays that differ ONLY by their own mutability bit. Nested bits still
// count : `Cfg[][]` and `Cfg[]![]` are genuinely different element types.
same_array_modulo_mutability :: fn(a: Type, b: Type) -> bool {
    if a is ArrayType {
        if b is ArrayType {
            return a.immutable != b.immutable && equals_type(a.element, b.element)
        }
    }
    return false
}

/// The array type a union carries at two different mutabilities, or null.
///
/// `i32[] | i32[]!` is not a type worth inventing : reading it is fine, mutating it
/// is only safe for one of the two, and collapsing it either way changes the type
/// behind the author's back. It is reported (T3074) so the author picks — and since
/// a read-only array cannot flow into a mutable slot, the fix is to pin the slot,
/// not to widen the union.
export union_mixed_mutability :: fn(t: Type) -> Type | null {
    if t is UnionType {
        for i in 0..<t.variants.len() {
            for j in i + 1..<t.variants.len() {
                if same_array_modulo_mutability(t.variants[i], t.variants[j]) {
                    return t.variants[i]
                }
            }
        }
    }
    return null
}

collect_variant :: fn(v: Type, into: Type[]!) -> void {
    if v is NeverType { return }
    match v {
        is UnionType -> {
            for inner in v.variants { inner.collect_variant(into) }
        }
        _ -> {
            for i in 0..<into.len() {
                existing :: into[i]
                if equals_type(existing, v) {
                    // Same type under two mutabilities — reachable on struct / tuple /
                    // trait / fn, where `equals_type` ignores the bit or the marks, at
                    // any level. Keep the rights both hold (`least_permissive`) : a value
                    // that is "either a read-only or a mutable T" can't be mutated
                    // without knowing which.
                    if existing !== v {
                        into[i] = least_permissive(existing, v) ?? existing
                    }
                    return
                }
            }
            into.push(v)
        }
    }
}

// ---- free-type defaulting -------------------------------------------------

/// Replace FreeInt with `i32`, FreeFloat with `f64`, FreeChar with `char`.
/// Used when a free literal escapes its bidirectional context and needs a
/// concrete type to flow into downstream phases.
export default_if_free :: fn(t: Type) -> Type {
    // @partial: only the three Free* literal variants default to a concrete
    // primitive; every other type is already concrete → returned unchanged.
    @partial match t {
        is FreeIntType   -> { return mk_primitive("i32") }
        is FreeFloatType -> { return mk_primitive("f64") }
        is FreeCharType  -> { return mk_primitive("char") }
        _ -> { return t }
    }
}

/// Dispatch key for trait-impl side-tables (`struct_implemented_traits`,
/// `struct_trait_args`). Defaults Free* first so a `7` literal keys the
/// same as `i32` for impls like `i32 implements Doubler`.
export dispatch_key :: fn(t: Type) -> string = impl_base_key(default_if_free(t))

/// The impl tables' key for a type itself, arguments included (`Wrapper<i32>`) —
/// its `canonical_key` without the mutability an impl is not registered under.
export impl_type_key :: fn(t: Type) -> string = canonical_key(strip_mutability(t))

/// The `impl_methods` key of a `source implements Into<target>` impl, so several
/// `Into` impls of one source don't collide.
///
/// @param source  the implementing type.
/// @param target  the `Into` argument.
into_impl_key :: fn(source: Type, target: Type) -> string =
    "${impl_type_key(source)}::into::${impl_type_key(target)}"

/// The `into` member registered for converting `source` into `target` — the
/// impl a coercion between the two goes through. Null when none converts them.
///
/// @param typed   the module the coercion is written in ; its table carries the
///                impls of every module it sees.
/// @param source  the converted value's type.
/// @param target  the type it converts into.
export into_impl_method :: fn(typed: TypedProgram, source: Type, target: Type) -> ImplMethod | null =
    typed.impl_methods[into_impl_key(source, target)]

/// True iff the base of `t` is registered as implementing `trait_key` in
/// `typed.struct_implemented_traits` — every argument of a
/// generic impl included, which is what the run-time `is Trait` test sees.
export base_implements_trait :: fn(t: Type, trait_key: string, typed: TypedProgram) -> bool {
    bucket :: typed.struct_implemented_traits[dispatch_key(t)] ?? return false
    return trait_key in bucket
}

/// True iff `t` implements `trait_key` : it has the impl built in
/// (`has_builtin_impl`), or its nominal carrier
/// has an impl of it (`base_implements_trait`), and a generic impl counts only
/// for the arguments its bounds admit — `Box<T> implements<T: Display>
/// Display` makes `Box<i32>` implement `Display`, not `Box<Point>` when `Point`
/// has none (`TypedProgram.impl_bounds`). Shared by trait widening, the T3006 /
/// T3018 checks and UFCS dispatch.
export struct_implements_trait :: fn(t: Type, trait_key: string, typed: TypedProgram) -> bool {
    if has_builtin_impl(t, trait_key) {
        return true
    }
    if !base_implements_trait(t, trait_key, typed) {
        return false
    }
    return blocking_bound(t, trait_key, typed) == null
}

/// True iff `t` implements `wanted` at `wanted`'s own arguments, not merely some
/// instance of it : `Cell<i64>` implements `Source<i64>`, which is no
/// `Source<i32>`. The arguments compare with their rights, both ways : an impl of
/// `Sink<Cfg!>` stores what it is handed, so it serves no slot lending read-only
/// `Cfg`s. A trait written without arguments, or an impl with none recorded, is
/// decided by `struct_implements_trait` alone.
///
/// @param t       the implementing type.
/// @param wanted  the trait instance a slot asks for.
/// @param typed   the module asking ; its tables carry every impl it sees.
export implements_trait_instance :: fn(t: Type, wanted: TraitType, typed: TypedProgram) -> bool {
    key :: trait_key_of(wanted.symbol)
    if !struct_implements_trait(t, key, typed) {
        return false
    }
    if wanted.args.len() == 0 {
        return true
    }
    impl_args :: resolve_struct_trait_args(t, key, typed) ?? return true
    return trait_args_match(impl_args, wanted.args)
}

/// Why `t` does not implement `trait_key` although an impl of it exists for `t`'s
/// base : the bound its arguments leave unmet, as a detail suffix. Empty when no
/// impl's bound is what fails.
///
/// @param t          the type that failed the check.
/// @param trait_key  the trait it was checked against.
export unmet_impl_bound_note :: fn(t: Type, trait_key: string, typed: TypedProgram) -> string {
    unmet :: blocking_bound(t, trait_key, typed) ?? return ""
    return impl_bound_note(unmet)
}

// " ; its impl requires `T: Bump`, and `Plain` does not implement it".
impl_bound_note :: fn(unmet: UnmetBound) -> string {
    required :: display_type(unmet.required)
    return " ; its impl requires `${unmet.bound.name}: ${required}`, and ${unmet.reason}"
}

/// Why `arg` does not meet the bound trait `required`, or null when it does. It
/// must implement the trait at its arguments, and grant mutation when the bound is
/// marked `!` (`T: Bump!`). The one rule a generic call, a struct literal and a
/// bounded impl's member are held to.
///
/// @param arg       the type bound to the parameter.
/// @param required  one trait of the parameter's bound, with its rights ; arguments
///                  naming a type parameter are left undecided.
/// @return          the end of a sentence (`` `Cfg` grants no mutation ``), or null.
export unmet_bound_reason :: fn(
    arg: Type, required: TraitType, typed: TypedProgram,
) -> string | null {
    key :: trait_key_of(required.symbol)
    if !satisfies_bound(arg, key, typed) || !meets_trait_args(arg, required, typed) {
        return "`${display_type(arg)}` does not implement it"
    }
    if !required.immutable && withholds_mutation(arg, typed.type_param_bound_traits) {
        return "`${display_type(arg)}` grants no mutation"
    }
    return null
}

/// The type arguments a generic impl's bounds speak of : a struct's arguments,
/// an array's element. Empty for any other type.
///
/// @param t  the implementing type.
export type_arguments :: fn(t: Type) -> Type[] {
    if t is StructType {
        return t.args
    }
    if t is ArrayType {
        return [t.element]
    }
    no_arguments: Type[]: []
    return no_arguments
}

// A bound of a generic impl or struct that one of `t`'s arguments leaves unmet.
UnmetBound :: struct {
    bound: ArgBound
    required: TraitType
    arg: Type
    /// `unmet_bound_reason`'s answer.
    reason: string
}

// What keeps every generic impl of `trait_key` for `t`'s base from holding for
// `t`'s arguments : the first impl's first unmet bound. Null when an impl holds,
// or when no generic impl of the trait is recorded for the base.
blocking_bound :: fn(t: Type, trait_key: string, typed: TypedProgram) -> UnmetBound | null {
    args :: type_arguments(t)
    if args.len() == 0 {
        return null
    }
    impls :: typed.impl_bounds[dispatch_key(t)] ?? return null
    first: UnmetBound | null = null
    for [_, impl_] in impls {
        if impl_.trait_key != trait_key {
            continue
        }
        unmet :: first_unmet_bound(args, impl_.bounds, typed) ?? return null
        if first == null {
            first = unmet
        }
    }
    return first
}

// The first of `bounds`, by position, that `args` leave unmet in shape or in rights.
first_unmet_bound :: fn(
    args: Type[], bounds: ArgBound[], typed: TypedProgram,
) -> UnmetBound | null {
    for bound in bounds {
        if bound.position >= args.len() {
            continue
        }
        arg :: args[bound.position]
        for required in bound.traits {
            reason :: unmet_bound_reason(arg, required, typed) ?? continue
            return UnmetBound {
                .bound = bound,
                .required = required,
                .arg = arg,
                .reason = reason,
            }
        }
    }
    return null
}

/// The detail of a T3006 on a type parameter's bound : ``type parameter `T` of
/// `owner` requires `Bump!`, and `Cfg` grants no mutation``.
///
/// @param param     the type parameter's name.
/// @param owner     the generic fn or struct that declares it.
/// @param required  the bound trait it fails.
/// @param reason    `unmet_bound_reason`'s answer.
export unmet_bound_detail :: fn(
    param: string, owner: string, required: TraitType, reason: string,
) -> string =
    "type parameter `${param}` of `${owner}` requires `${display_type(required)}`, and ${reason}"

// Whether `arg` satisfies the bound trait `trait_key` — at a bounded position of a
// generic impl, or bound to a callee's type parameter (T3006). An erased instance
// dispatches on the boxed value, so what counts is what that dispatch reaches : a
// type parameter through its own bound, a union through every variant, a distinct
// through its own impl or its backing's — and an array not for `Display`, which
// no vtable carries.
// A type still unknown here is not held against the bound.
satisfies_bound :: fn(arg: Type, trait_key: string, typed: TypedProgram) -> bool = match arg {
    is TypeParamType -> bound_names_trait(arg, trait_key, typed)
    is UnionType     -> (all_satisfy_bound(arg.variants, trait_key, typed)
        && (trait_key != core_trait_key(TRAIT_EQUALS) || untagged_beside_variant(arg) == null))
    is TraitType     -> trait_key_of(arg.symbol) == trait_key || struct_implements_trait(arg, trait_key, typed)
    is DistinctType  -> (struct_implements_trait(arg, trait_key, typed)
        || satisfies_bound(arg.backing, trait_key, typed))
    is ArrayType     -> trait_key != core_trait_key(TRAIT_DISPLAY) && struct_implements_trait(arg, trait_key, typed)
    is AnyType | UnresolvedType | FreeIntType | FreeFloatType | FreeCharType | NeverType
        | SelfType -> true
    is PrimitiveType | StructType | EnumType | TupleType | FnType | TypeMetaType -> {
        struct_implements_trait(arg, trait_key, typed)
    }
}

// Whether `t`'s bound names `trait_key`, read from the project table, where a
// parameter an impl borrows from its struct also carries the struct's bound.
bound_names_trait :: fn(t: TypeParamType, trait_key: string, typed: TypedProgram) -> bool {
    bound :: typed.type_param_bound_traits[t.symbol.id] ?? return false
    for trait_ty in bound.traits {
        if trait_key_of(trait_ty.symbol) == trait_key {
            return true
        }
    }
    return false
}

// A variant of `u` with no tag of its own (`is_untagged`) that sits beside another
// non-null one : an `Equals` comparison, which tests which variant each side
// holds, can tell it only from `null`. Null when there is none.
untagged_beside_variant :: fn(u: UnionType) -> Type | null {
    held: usize = 0
    untagged: Type | null = null
    for v in u.variants {
        if !is_null_type(v) {
            held += 1
            if is_untagged(v) {
                untagged = v
            }
        }
    }
    return if held > 1 { untagged } else { null }
}

all_satisfy_bound :: fn(types: Type[], trait_key: string, typed: TypedProgram) -> bool {
    for t in types {
        if !satisfies_bound(t, trait_key, typed) {
            return false
        }
    }
    return true
}

/// The trait args recorded for `t implements <trait_key>` in
/// `struct_trait_args` (`Hello implements Greeter(i32)` →
/// `[i32]`), or `null` when no concrete impl is registered for `t`'s
/// nominal carrier. Shared by the typecheck's `unify_struct_to_trait_args`
/// and the lowerer's trait-param monomorphisation.
export lookup_struct_trait_args :: fn(t: Type, trait_key: string, typed: TypedProgram) -> Type[] | null {
    per_struct :: typed.struct_trait_args[dispatch_key(t)] ?? return null
    return per_struct[trait_key]
}

/// The trait args for `t implements <trait>`, with a GENERIC impl's recorded
/// args resolved against `t`'s concrete instance args. A generic impl records the
/// impl's own type-params (`FilterIterator<T> implements Iterator<T>` → `[T]`), so
/// a concrete `FilterIterator<i32>` needs `[T]` substituted by `[i32]` (via the
/// struct decl's `type_params` ↔ the instance's `.args`). Returns the raw args
/// when `t` isn't a struct instance or its decl is unavailable. Mirrors
/// `field.vader::substitute_trait_typeparams`; the source of truth for binding a
/// combinator/terminal's `Iterator<T>` param `T` from a concrete receiver.
export resolve_struct_trait_args :: fn(t: Type, trait_key: string, typed: TypedProgram) -> Type[] | null {
    // A `generator`'s `<fn>$State<E>` implements `Iterator<E>` — its trait args ARE
    // its own type args (the concrete element carried per instance). The synthetic
    // struct has no `struct_decl`, so the generic-substitution path below can't apply.
    if trait_key == core_trait_key(TRAIT_ITERATOR) {
        if is_gen_state_struct(t) {
            if t is StructType { return t.args }
        }
    }
    raw :: lookup_struct_trait_args(t, trait_key, typed) ?? return null
    if t is StructType {
        struct_decl :: typed.struct_decls[t.symbol.id] ?? return raw
        out: Type[]!: []
        for a in raw { out.push(substitute_by_name(a, struct_decl.type_params, t.args)) }
        return out
    }
    if t is ArrayType {
        // `T[] implements<T: Equals> Contains<T>` gives `i32[]` the argument `i32`.
        out: Type[]!: []
        for a in raw {
            out.push(substitute_array_element(a, t.element))
        }
        return out
    }
    return raw
}


/// Bidirectional narrowing : when a Free* literal flows into a slot that
/// wants a concrete numeric of the matching family, fold the literal to
/// the concrete primitive — into a union, to the member it settles on
/// (`union_literal_member`). Used by every check_expr-style call site.
export narrow_for_expected :: fn(got: Type, expected: Type | null) -> Type {
    if expected is UnionType {
        member :: union_literal_member(got, expected) ?? return got
        return member
    }
    if expected is PrimitiveType && literal_family_holds(got, expected.name) {
        return expected
    }
    return got
}

/// The member of `u` a free literal of kind `got` settles on : its family's
/// default (`i32`, `f64`, `char`) when the union has it, else its only member of
/// that family — `5` into `u8 | string` is a `u8`. `null` when `got` is not a
/// free literal, or the union has none, or several with no default among them
/// (T3089 at the literal).
///
/// @param got  the literal's free type.
/// @param u    the union it flows into.
export union_literal_member :: fn(got: Type, u: UnionType) -> PrimitiveType | null {
    if !is_free_numeric(got) {
        return null
    }
    candidates :: union_literal_candidates(got, u)
    preferred :: default_if_free(got)
    for c in candidates {
        if equals_type(c, preferred) {
            return c
        }
    }
    return if candidates.len() == 1 { candidates[0] } else { null }
}

/// The primitive members of `u` a free literal of kind `got` could take : the
/// integer widths for `5`, the float widths for `2.5`, the integers and `char`
/// for `'a'`. Empty when `got` is not a free literal.
///
/// @param got  the literal's free type.
/// @param u    the union it flows into.
union_literal_candidates :: fn(got: Type, u: UnionType) -> PrimitiveType[] {
    out: PrimitiveType[]!: []
    for v in u.variants {
        if v is PrimitiveType && literal_family_holds(got, v.name) {
            out.push(v)
        }
    }
    return out
}

// A free literal of kind `got` can be a value of the primitive `name` : an
// integer width for `5`, a float width for `2.5`, an integer width or `char` for
// `'a'` (its codepoint, bounds-checked where it is pinned).
literal_family_holds :: fn(got: Type, name: string) -> bool = match got {
    is FreeIntType   -> is_int_name(name)
    is FreeFloatType -> is_float_name(name)
    is FreeCharType  -> is_int_name(name) || name == "char"
    is PrimitiveType | EnumType | DistinctType | ArrayType | StructType | TraitType | UnionType
     | TupleType | FnType | TypeParamType | TypeMetaType | SelfType | UnresolvedType | NeverType
     | AnyType -> false
}

/// `t` with mutability erased at every level — the SHAPE of the type.
///
/// Two callers, both asking a question mutability has no business answering:
///   - a runtime `is` test (an array header carries length, capacity and element
///     kind, never a read-only bit, so `x is i32[]` and `x is i32[]!` name the same
///     runtime values and must select the same variant) ;
///   - UFCS receiver currying, where the method is picked by shape and T3071 is
///     what rejects a `self!` method on a read-only receiver.
///
/// @param t  the type to reduce to its shape.
/// @return   `t` itself when nothing inside it carries a mutability bit.
export strip_mutability :: fn(t: Type) -> Type = match t {
    is ArrayType    -> mk_array(strip_mutability(t.element), true)
    is TupleType    -> mk_tuple(strip_mutability_each(t.elements), true)
    is StructType   -> mk_struct(t.symbol, strip_mutability_each(t.args), true)
    is TraitType    -> TraitType {
        ...t,
        .args = strip_mutability_each(t.args),
        .immutable = true,
    }
    is UnionType    -> mk_union(strip_mutability_each(t.variants))
    is DistinctType -> if carries_mutability_bit(t) {
        mk_distinct(t.symbol, strip_mutability(t.backing))
    } else {
        t
    }
    is FnType       -> FnType {
        .params         = strip_mutability_each(t.params),
        .params_mutable = t.params_mutable,
        .return_type    = strip_mutability(t.return_type),
    }
    is PrimitiveType | EnumType | TypeParamType | TypeMetaType | SelfType
     | UnresolvedType | FreeIntType | FreeFloatType | FreeCharType
     | NeverType | AnyType -> t
}

strip_mutability_each :: fn(ts: Type[]) -> Type[] {
    out: Type[]!: [] * ts.len()
    for t in ts { out.push(strip_mutability(t)) }
    return out
}

/// Structural equality modulo mutability — `equals_type` on the two SHAPES.
/// The comparison a runtime test needs: `i32[]` and `i32[]!` are one shape.
export equals_type_shape :: fn(a: Type, b: Type) = equals_type(strip_mutability(a), strip_mutability(b))

/// Do `a` and `b` share any concrete runtime value ? Powers T3040
/// ("test can never match") and the match-arm overlap check.
/// UnionType on either side recurses into its variants. Otherwise
/// compares SHAPES — mutability is a static discipline with no runtime
/// representation, so it can never make two types fail to overlap.
export types_overlap :: fn(a: Type, b: Type) -> bool {
    av :: union_variants(a)
    if !(av is null) {
        for v in av { if types_overlap(v, b) { return true } }
        return false
    }
    bv :: union_variants(b)
    if !(bv is null) {
        for v in bv { if types_overlap(a, v) { return true } }
        return false
    }
    return equals_type_shape(a, b)
}

/// Whether a value of `a` and one of `b` are the same variant to `==` : one shape,
/// mutability aside, or a free literal the other type takes. A union compares a
/// variant only with its counterpart on the other side.
///
/// @param a  a variant of one operand, or the operand itself.
/// @param b  a variant of the other operand, or the operand itself.
export same_variant :: fn(a: Type, b: Type) -> bool =
    equals_type_shape(a, b)
        || (is_free_numeric(a) && is_assignable(a, b))
        || (is_free_numeric(b) && is_assignable(b, a))

/// The variant of `t` that is the same as `variant` (`same_variant`) — `t` itself
/// when it is no union and matches. Null when none is.
///
/// @param t        an operand's type.
/// @param variant  a variant of the other operand.
export counterpart :: fn(t: Type, variant: Type) -> Type | null {
    for v in union_variants(t) ?? [t] {
        if same_variant(v, variant) {
            return v
        }
    }
    return null
}

/// The variants of `t` when it is a union, `null` otherwise —
/// `union_variants(t) ?? [t]` reads any type as its list of variants.
///
/// @param t  the type to read.
export union_variants :: fn(t: Type) -> Type[] | null {
    if t is UnionType { return t.variants }
    return null
}

/// Subtract a single variant from a type. Returns the remaining type
/// (or `Never` if nothing remains). For non-union sources subtracting
/// the same shape yields `Never` ; subtracting a different shape is a
/// no-op. Used by flow narrowing — `if x is T` widens to "not T" on
/// the false side / in code after a divergent guard.
export subtract_type :: fn(from: Type, removed: Type) -> Type {
    if from is UnionType {
        kept: Type[]!: []
        for v in from.variants {
            if !removed_covers(removed, v) { kept.push(v) }
        }
        if kept.len() == 0 { return TY_NEVER }
        if kept.len() == 1 { return kept[0] }
        return mk_union(kept)
    }
    if removed_covers(removed, from) { return TY_NEVER }
    return from
}

/// `subtract_type` extended for a trait `removed` : a runtime trait test
/// matches every union variant whose nominal carrier implements the trait
/// (mirroring `c_emit/walker.vader::trait_check_expr` and the VM's
/// `ref_type_matches`), so those variants leave the remainder too —
/// `match x: IOError | string { is string …, is Error … }` is exhaustive.
/// A non-trait `removed` delegates to plain `subtract_type`.
export subtract_type_with_impls :: fn(from: Type, removed: Type, typed: TypedProgram) -> Type {
    if !(removed is TraitType) { return subtract_type(from, removed) }
    trait_key :: trait_key_of(removed.symbol)
    if from is UnionType {
        kept: Type[]!: []
        for v in from.variants {
            if removed_covers(removed, v) { continue }
            if base_implements_trait(v, trait_key, typed) { continue }
            kept.push(v)
        }
        if kept.len() == 0 { return TY_NEVER }
        if kept.len() == 1 { return kept[0] }
        return mk_union(kept)
    }
    if removed_covers(removed, from) { return TY_NEVER }
    if base_implements_trait(from, trait_key, typed) { return TY_NEVER }
    return from
}

// True when `removed` covers `t` — either `removed` IS `t`, or `removed`
// is a union that lists `t` among its variants. Without the union case,
// subtracting a union (e.g. the `!(x is T)` divergent-guard's inner
// complement) removes nothing — the double-complement `subtract(NU,
// (N-1)U)` then yields the full union instead of the single `T`, so the
// negated guard fails to narrow and downstream field-gets degrade.
removed_covers :: fn(removed: Type, t: Type) -> bool {
    if removed is UnionType {
        for v in removed.variants { if equals_type(v, t) { return true } }
        return false
    }
    return equals_type(removed, t)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "vader/resolver/symbol"
import "vader/types"

@test
test_equals_primitive :: fn() -> void {
    assert(equals_type(mk_primitive("i32"), mk_primitive("i32")), "i32 == i32")
    assert(!equals_type(mk_primitive("i32"), mk_primitive("i64")), "i32 != i64")
}

@test
test_equals_array :: fn() -> void {
    a1: Type: mk_array(mk_primitive("i32"), false)
    a2: Type: mk_array(mk_primitive("i32"), false)
    a3: Type: mk_array(mk_primitive("i32"), true)
    assert(equals_type(a1, a2), "i32[] == i32[]")
    assert(!equals_type(a1, a3), "i32[]! != i32[]")
}

// `is_assignable` tests live in `type_assign.vader` alongside the impl.

@test
test_union_of_dedup :: fn() -> void {
    i32_t: Type: mk_primitive("i32")
    str_t: Type: mk_primitive("string")
    // A | B | A should collapse to A | B
    u :: union_of([i32_t, str_t, i32_t])
    match u {
        is UnionType -> { assert_eq(u.variants.len(), 2) }
        _ -> { assert(false, "expected a Union after dedup") }
    }
}

@test
test_union_of_drops_never :: fn() -> void {
    i32_t: Type: mk_primitive("i32")
    never_t: Type: TY_NEVER
    // i32 | Never should collapse to i32
    u :: union_of([i32_t, never_t])
    match u {
        is PrimitiveType -> { assert_eq(u.name, "i32") }
        _ -> { assert(false, "Never should be absorbed") }
    }
}

@test
test_union_of_flattens :: fn() -> void {
    i32_t: Type: mk_primitive("i32")
    str_t: Type: mk_primitive("string")
    bool_t: Type: mk_primitive("bool")
    inner :: mk_union([i32_t, str_t])
    u :: union_of([inner, bool_t])
    match u {
        is UnionType -> { assert_eq(u.variants.len(), 3) }
        _ -> { assert(false, "flattened union should have 3 variants") }
    }
}

@test
test_default_if_free :: fn() -> void {
    match default_if_free(TY_FREE_INT) as p {
        is PrimitiveType -> { assert_eq(p.name, "i32") }
        _                -> { assert(false, "FreeInt defaults to i32") }
    }
    match default_if_free(TY_FREE_FLOAT) as p {
        is PrimitiveType -> { assert_eq(p.name, "f64") }
        _                -> { assert(false, "FreeFloat defaults to f64") }
    }
    // Non-free types pass through.
    i32_t :: mk_primitive("i32")
    match default_if_free(i32_t) as p {
        is PrimitiveType -> { assert_eq(p.name, "i32") }
        _                -> { assert(false, "i32 should pass through") }
    }
}

@test
test_int_fits_bounds :: fn() -> void {
    // Positive magnitude out of range → rejected (T3066 at the pin site).
    assert(!int_fits(9000000000, "i32"), "9e9 does not fit i32")
    assert(!int_fits(300, "u8"), "300 does not fit u8")
    assert(!int_fits(18446744073709551615, "i64"), "u64.MAX does not fit i64")
    // In-range values and maxima → accepted.
    assert(int_fits(2147483647, "i32"), "i32.MAX fits i32")
    assert(int_fits(255, "u8"), "u8.MAX fits u8")
    assert(int_fits(18446744073709551615, "u64"), "u64.MAX fits u64")
    assert(int_fits(18446744073709551615, "usize"), "u64.MAX fits usize")
    // Signed minimum magnitude (`2^(n-1)`) passes so the negated `-2^(n-1)` fits.
    assert(int_fits(9223372036854775808, "i64"), "i64.MIN magnitude fits i64")
    assert(int_fits(2147483648, "i32"), "i32.MIN magnitude fits i32")
    // A non-integer target never accepts an integer literal via this path.
    assert(!int_fits(0, "f64"), "int literal never fits f64")
    assert(!int_fits(0, "bool"), "int literal never fits bool")
}

struct_symbol :: fn(name: string) -> Symbol =
    SymbolFactory {}.make(.Struct, name, "test", "test", .Public, null)

display_least_permissive :: fn(a: Type, b: Type) -> string {
    met :: least_permissive(a, b) ?? return "null"
    return display_type(met)
}

@test
test_least_permissive_lowers_each_level :: fn() -> void {
    i32_ty :: mk_primitive("i32")
    outer_frozen :: mk_array(mk_array(i32_ty, false), true)
    inner_frozen :: mk_array(mk_array(i32_ty, true), false)
    assert_eq(display_least_permissive(outer_frozen, inner_frozen), "i32[][]")
}

@test
test_least_permissive_lowers_a_struct_and_its_arguments :: fn() -> void {
    box :: struct_symbol("Box")
    i32_ty :: mk_primitive("i32")
    mutable :: mk_struct(box, [mk_array(i32_ty, false)], false)
    frozen :: mk_struct(box, [mk_array(i32_ty, true)], true)
    met :: least_permissive(mutable, frozen) ?? return assert(false, "no least permissive struct")
    assert_eq(display_type(met), "Box<i32[]>")
    assert(type_is_immutable(met), "the struct level keeps the read-only bit")
}

@test
test_least_permissive_refuses_another_shape :: fn() -> void {
    i32_array :: mk_array(mk_primitive("i32"), true)
    assert_eq(display_least_permissive(i32_array, mk_array(TY_STRING, true)), "null")
}

@test
test_union_of_keeps_the_least_rights_at_every_level :: fn() -> void {
    box :: struct_symbol("Box")
    cfg :: struct_symbol("Cfg")
    frozen_inside :: mk_struct(box, [mk_struct(cfg, [], true)], false)
    frozen_outside :: mk_struct(box, [mk_struct(cfg, [], false)], true)
    assert_eq(display_type(union_of([frozen_inside, frozen_outside])), "Box<Cfg>")
}

@test
test_union_of_fns_demands_either_mark :: fn() -> void {
    cfg :: mk_struct(struct_symbol("Cfg"), [], true)
    reader :: mk_fn([cfg], TY_VOID)
    writer :: FnType {
        .params         = [cfg],
        .params_mutable = [true],
        .return_type    = TY_VOID,
    }
    assert_eq(display_type(union_of([reader, writer])), display_type(writer))
}

@test
test_union_of_fns_keeps_the_least_rights_on_return :: fn() -> void {
    cfg :: struct_symbol("Cfg")
    fresh :: mk_fn([], mk_struct(cfg, [], false))
    shared :: mk_fn([], mk_struct(cfg, [], true))
    assert_eq(display_type(union_of([fresh, shared])), display_type(shared))
}

@test
test_union_of_containers_with_other_contents_is_read_only :: fn() -> void {
    cfg :: struct_symbol("Cfg")
    writable :: mk_array(mk_struct(cfg, [], false), false)
    readable :: mk_array(mk_struct(cfg, [], true), false)
    assert_eq(display_type(union_of([writable, readable])), "Cfg[]")
}
