// vader/typecheck/param_inference — the `!` a slot takes, deduced from what its fn
// does with it. A slot is a parameter of a fn with a body, or an annotated local.
//
// A slot is mutable at a level of its type when the body mutates it there, or hands it
// at that level to a slot that is. The compiler deduces it in rounds over the whole
// project (`check_project_with_bodies`) :
//
//   1. `begin_param_inference` lists the parameters it deduces for and takes the `!`
//      their source writes off the AST ; a local, and a local fn's parameters, are
//      listed when the first round reaches their binding (`register_local_slot`) ;
//   2. a round types the project. A rights refusal whose lever is such a slot is a
//      NEED (`note_slot_need`, `note_widening_need`), and a value rooted at one and
//      handed to another — an argument, a value filling a local — is an EDGE
//      (`note_arg_edge`, `note_receiver_edge`, `note_fill_edge`) ;
//   3. `settle_param_marks` marks every level the needs, the written `!` and the edges
//      close over, in the AST, so the next round reads them as written. A round that
//      marks nothing new is the result, and `end_param_inference` closes the deduction.
//
// An edge is recorded only where it is exact — the value's type is the slot's up to
// the `!`, with no conversion — so a level it marks is one a refusal would demand.
// What it misses, the next round's refusals report : no round ends on a need it could
// have met.

module "vader/typecheck"

import "std/collections"
import "std/math"
import "std/string_builder"
AST :: import "toolchain/ast"
import "toolchain/span"
import "vader/diagnostics"
import "vader/resolver"
import "vader/resolver/symbol"
import "vader/types"

// ---- state ----------------------------------------------------------------

// A level of a parameter's written type, as a path from the type down : `ELEMENT`
// steps into an array's element, `k >= 0` into the k-th variant of a union written
// `A | B | …`, in source order. A union carries no `!` of its own — its variants do.
ELEMENT :: -1

/// A slot whose `!` is deduced — a parameter, or an annotated local — as the AST
/// holds it.
export InferableSlot :: struct {
    /// Where its type is written.
    owner: AST.FnParam! | AST.LetStmt!
    name: string
    /// The parameter's span, or the local's name : its hash keys the slot.
    span: Span
    /// The module declaring it : a level's type is read with that module's names.
    module: string
    /// The fn a parameter belongs to, as a cause names it ; "" for a local.
    fn_name: string
    /// The `!` its source writes at a deduced level.
    written: WrittenMark[]
}

/// A `!` the source writes on a parameter, at a level the compiler deduces.
export WrittenMark :: struct {
    path: i32[]
    /// The `!` itself, which `vader fix` removes.
    bang: Span
}

/// Why a level of a parameter is marked `!`.
export MarkCause :: struct {
    span: Span
    /// What happens at `span`, as a sentence fragment : "it is written through here".
    what: string
    /// The level whose mark this one follows (`level_key`) — the callee's, for an
    /// argument handed on — or "" when `span` is the mutation itself.
    via: string = ""
}

/// One marked level : the parameter (its span's hash), the path, the cause.
export MarkedLevel :: struct {
    key: u64
    path: i32[]
    cause: MarkCause
}

/// An argument rooted at a deduced parameter, handed to another one ; or a value
/// stored into an element of one (`from` > 0).
export ArgEdge :: struct {
    /// The argument's root parameter. Null when it has none : the edge then carries
    /// only the `!` of the elements the argument hands in.
    root: u64 | null = null
    /// Array levels from the root down to the argument.
    elements: i32 = 0
    /// The first level of the argument the root stands for (`SlotRoot.floor`).
    floor: i32 = 0
    /// Array levels of the marked parameter above what the argument fills : 0 for a
    /// call's argument, which fills the parameter itself.
    from: i32 = 0
    /// The argument's type : what the callee's own levels stand for at the root.
    arg_ty: Type
    call: Span
    /// The fn the argument is handed to, or the local the value fills.
    callee: string
}

/// An argument's edge, with the parameter whose mark it carries.
export RootedEdge :: struct {
    callee: u64
    edge: ArgEdge
}

/// What the deduction knows, shared by every module of a round and kept across rounds.
export ParamInference :: struct {
    slots: MutableMap<u64, InferableSlot!>! = MutableMap<u64, InferableSlot!> {}
    /// This round's needs, read into `needs` between rounds.
    pending: PendingNeed[]! = []
    /// Levels the rounds so far found a need at, by `level_key`.
    needs: MutableMap<string, MarkedLevel>! = MutableMap<string, MarkedLevel> {}
    /// The first round's edges, by the key of the parameter whose mark they carry. A
    /// later round has the same calls ; only their rights differ.
    edges: MutableMap<u64, ArgEdge[]!>! = MutableMap<u64, ArgEdge[]!> {}
    /// The arguments' edges by the key of their root, once the first round is over.
    by_root: MutableMap<u64, RootedEdge[]!>! = MutableMap<u64, RootedEdge[]!> {}
    /// Whether the round under way is the first, the one that records edges.
    first_round: bool = true
    /// How many needs the last settle closed over.
    settled_needs: usize = 0
    /// The levels marked in the AST, by `level_key`.
    marks: MutableMap<string, MarkedLevel>! = MutableMap<string, MarkedLevel> {}
}

level_key :: fn(key: u64, path: i32[]) -> string {
    sb :: StringBuilder {}
    sb.append("${key}")
    for step in path {
        sb.append(if step == ELEMENT { "/e" } else { "/${step}" })
    }
    return sb.to_string()
}

element_steps :: fn(path: i32[]) -> i32 {
    n := 0
    for step in path {
        if step == ELEMENT {
            n += 1
        }
    }
    return n
}

all_elements :: fn(path: i32[]) -> bool = element_steps(path) == i32(path.len())

elements_path :: fn(n: i32) -> i32[] = [ELEMENT] * usize(n)

// ---- before the first round -----------------------------------------------

/// List the parameters whose `!` is deduced and take the `!` their source writes off
/// the AST, so the first round sees what the bodies alone demand.
///
/// A parameter of a fn with a body is deduced : a free fn, an impl member, a generic.
/// A trait member is a contract, a lambda takes its rights from its slot, and a fn
/// the compiler cloned or synthesised copies a contract's signature.
///
/// @param project  the loaded project, whose AST this edits.
/// @return         the deduction state the rounds share.
begin_param_inference :: fn(project: LoadedProject) -> ParamInference! {
    inference :: ParamInference {}
    for [id, lm] in project.modules {
        for file in lm.module.files {
            for decl in file.program.decls {
                if decl is AST.FnDecl {
                    register_fn_params(inference, decl, id)
                } else if decl is AST.ImplDecl {
                    for member in decl.members {
                        register_fn_params(inference, member, id)
                    }
                }
            }
        }
    }
    return inference
}

register_fn_params :: fn(inference: ParamInference, fd: AST.FnDecl, module: string) -> void {
    if fd.body == null || fd.materialized || fd.sam_synthetic {
        return
    }
    for p in fd.params {
        register_param(inference, p, fd.name, module)
    }
}

/// Deduce the `!` of a local fn's parameters (`f :: fn(x: T) { … }` in a body).
///
/// Registered when the first round reaches the binding, before the lambda is typed :
/// its written `!` come off then.
///
/// @param lambda  the local fn's value.
/// @param name    the local it is bound to.
register_local_fn :: fn(lambda: AST.LambdaExpr, name: string, typed: TypedProgram) -> void {
    inference :: typed.param_inference ?? return
    for p in lambda.params {
        if p.ty != null {
            register_param(inference, p, name, typed.resolved.path)
        }
    }
}

/// Deduce the `!` of an annotated local (`out: Stmt[]: []`) : its annotation gives the
/// shape, the body the rights.
///
/// Registered when the first round reaches the binding, before its annotation is
/// typed : its written `!` come off then.
///
/// @param s  the binding, annotated with a single name.
register_local_slot :: fn(s: AST.LetStmt, typed: TypedProgram) -> void {
    inference :: typed.param_inference ?? return
    binding :: s.binding
    if binding !is AST.SimpleBinding {
        return
    }
    ty :: s.ty ?? return
    // The local's symbol is minted at its name : the key a read of it reaches.
    at :: binding.name_span
    if at.hash() in inference.slots {
        return
    }
    written: WrittenMark[]: []
    s.ty = strip_levels(ty, [], written)
    inference.slots[at.hash()] = InferableSlot {
        .owner = s,
        .name = binding.name,
        .span = at,
        .module = typed.resolved.path,
        .fn_name = "",
        .written = written,
    }
}

register_param :: fn(
    inference: ParamInference, p: AST.FnParam, fn_name: string, module: string,
) -> void {
    key :: p.span.hash()
    if key in inference.slots {
        return
    }
    written: WrittenMark[]: []
    ty :: p.ty
    if ty == null {
        if p.mutable {
            // `self!` : the name's span ends on the marker.
            written.push(WrittenMark { .path = [], .bang = last_char(p.span) })
            p.mutable = false
        }
    } else {
        p.ty = strip_levels(ty, [], written)
    }
    inference.slots[key] = InferableSlot {
        .owner = p,
        .name = p.name,
        .span = p.span,
        .module = module,
        .fn_name = fn_name,
        .written = written,
    }
}

// The type a slot's source writes, its deduced `!` included. Two branches, one per
// owner : a field common to a union's variants is read at a fixed offset, which the
// two owners do not share.
slot_type :: fn(slot: InferableSlot) -> AST.TypeExpr | null {
    owner :: slot.owner
    return if owner is AST.FnParam { owner.ty } else { owner.ty }
}

// `t` without the `!` it writes at a deducible level, each recorded in `written`.
strip_levels :: fn(t: AST.TypeExpr, path: i32[], written: WrittenMark[]) -> AST.TypeExpr! {
    if t is AST.MutableTypeExpr {
        // A marker's span runs from its level's start to the `!` it ends on.
        written.push(WrittenMark { .path = path, .bang = last_char(t.span) })
        return strip_levels(t.inner, path, written)
    }
    if t is AST.ArrayTypeExpr {
        t.element = strip_levels(t.element, path + [ELEMENT], written)
        return t
    }
    if t is AST.BinaryExpr && t.op == .BitOr {
        _ :: rewrite_variants(
            t, 0, (v: AST.Expr!, k: i32) -> strip_levels(v, path + [k], written),
        )
    }
    return t
}

// Replace each variant of the union chain `u` by `rewrite` of it and its number, the
// first numbered `first` ; the number after its last variant.
rewrite_variants :: fn(
    u: AST.BinaryExpr, first: i32, rewrite: fn(AST.Expr!, i32) -> AST.Expr!,
) -> i32 {
    next := first
    left :: u.left
    if left is AST.BinaryExpr && left.op == .BitOr {
        next = rewrite_variants(left, next, rewrite)
    } else {
        u.left = rewrite(left, next)
        next += 1
    }
    right :: u.right
    if right is AST.BinaryExpr && right.op == .BitOr {
        next = rewrite_variants(right, next, rewrite)
    } else {
        u.right = rewrite(right, next)
        next += 1
    }
    return next
}

// The span of the last character of `s`.
last_char :: fn(s: Span) -> Span {
    end :: s.end
    start :: Position {
        .file = end.file,
        .offset = end.offset - 1,
        .line = end.line,
        .column = end.column - 1,
    }
    return Span { .start = start, .end = end }
}

// ---- during a round : needs -----------------------------------------------

// A deduced slot a value is reached from, and how many array levels down.
SlotRoot :: struct {
    key: u64
    elements: i32
    /// The first level of the walked value the root stands for : above it, the value
    /// is a fresh literal's (`[x]`).
    floor: i32 = 0
    /// The type the root has where a field of it is read : reached through a field,
    /// the root is needed at its own level, as that type.
    holder: Type | null = null
}

/// A level a refusal demands of a deduced parameter, read from its written type
/// between rounds (`resolve_pending_needs`) : the parameter may belong to a module the
/// round is not walking.
export PendingNeed :: struct {
    key: u64
    /// Array levels down from the parameter's type.
    elements: i32
    /// The type the value has there : picks a union's variants.
    want: Type
    cause: MarkCause
}

/// Record that `value` must grant mutation, when its lever is a deduced parameter :
/// the level of that parameter's type it is reached at takes `!` next round.
///
/// Called where a rights refusal is about to be reported. A value reached through a
/// call's result, a module const or a field whose declared type withholds the level
/// has a written contract for a lever, and stays an error.
///
/// @param value  the value the refusal is about.
/// @param span   where the refusal is reported, the mark's cause.
/// @param what   what happens there, as the cause words it.
/// @return       whether the refusal is ABSORBED : the need marks a level the AST
///               does not have yet, so this round runs again and the refusal need not
///               be reported.
note_slot_need :: fn(value: AST.Expr, span: Span, what: string, typed: TypedProgram) -> bool {
    inference :: typed.param_inference ?? return false
    want :: typed.expr_types[value.id] ?? return false
    cause :: MarkCause { .span = span, .what = what }
    return note_needs(inference, roots_of(value, 0, true, typed), want, cause, typed.resolved)
}

/// Record the need behind a mismatch about mutability : the level of `got` that
/// `expected` grants and it does not.
///
/// @param value     the value that failed to fit.
/// @param got       its type.
/// @param expected  the slot's type.
/// @return          whether the mismatch is absorbed, as for `note_slot_need`.
note_widening_need :: fn(
    value: AST.Expr, got: Type, expected: Type, span: Span, typed: TypedProgram,
) -> bool {
    inference :: typed.param_inference ?? return false
    levels: LevelGap[]: []
    widening_levels(got, expected, 0, typed.type_param_bound_traits, levels)
    cause :: MarkCause { .span = span, .what = "it is stored where a mutable value is expected" }
    absorbed := false
    for level in levels {
        roots :: roots_of(value, level.elements, true, typed)
        noted :: note_needs(inference, roots, level.want, cause, typed.resolved)
        absorbed = noted || absorbed
    }
    return absorbed
}

/// Record that argument `i` of `c` grants more than its deduced parameter, under a
/// mutable array spine whose holder could store a read-only value the caller then
/// writes : the parameter's level takes the argument's `!`.
///
/// @param got       the argument's type.
/// @param expected  the parameter's type as the call's instance has it.
note_gaining_need :: fn(
    c: AST.CallExpr, i: usize, got: Type, expected: Type, typed: TypedProgram,
) -> void {
    inference :: typed.param_inference ?? return
    level :: gaining_level(got, expected, 0) ?? return
    param :: param_for_arg(c, i, typed) ?? return
    what :: "it is handed mutable elements here"
    inference.pending.push(PendingNeed {
        .key = param.span.hash(),
        .elements = level.elements,
        .want = level.want,
        .cause = MarkCause { .span = c.args[i].span, .what = what },
    })
}

// Record that each of `roots` must grant what `want` lacks ; whether a level that
// takes it is not marked yet. A root is a parameter of the fn being walked, so of this
// module : its levels are read with `resolved`.
note_needs :: fn(
    inference: ParamInference, roots: SlotRoot[], want: Type, cause: MarkCause,
    resolved: ResolvedModule,
) -> bool {
    fresh := false
    for root in roots {
        if root.elements < 0 {
            continue
        }
        slot :: inference.slots[root.key] ?? continue
        paths :: levels_for(slot, root.elements, root.holder ?? want, resolved)
        fresh = add_needs(inference, root.key, paths, cause) || fresh
    }
    return fresh
}

// A need at each of `paths` of the parameter `key` ; whether one is not marked yet.
add_needs :: fn(inference: ParamInference, key: u64, paths: i32[][], cause: MarkCause) -> bool {
    fresh := false
    for path in paths {
        k :: level_key(key, path)
        fresh = fresh || !(k in inference.marks)
        if !(k in inference.needs) {
            inference.needs[k] = MarkedLevel {
                .key = key,
                .path = path,
                .cause = cause,
            }
        }
    }
    return fresh
}

// A level of a type that grants less than the slot it fills, or more.
LevelGap :: struct {
    elements: i32
    /// The type at that level : the value's for a widening, the slot's for a gain.
    want: Type
}

// Every level, counted in array steps, where `expected` grants mutation and `got` does
// not, into `out`.
widening_levels :: fn(
    got: Type, expected: Type, elements: i32, bounds: MutableMap<i32, TypeParamBound>,
    out: LevelGap[],
) -> void {
    if expected is UnionType && got !is UnionType {
        filled :: filled_by(expected, got, bounds) ?? return
        widening_levels(got, filled, elements, bounds, out)
        return
    }
    if got is UnionType && expected is UnionType {
        for v in got.variants {
            found: LevelGap[]: []
            widening_levels(v, expected, elements, bounds, found)
            for gap in found {
                // At the union's own level the value is the whole union.
                at_union :: gap.elements == elements
                out.push(if at_union { LevelGap { ...gap, .want = got } } else { gap })
            }
        }
        return
    }
    if got is ArrayType && expected is ArrayType {
        if got.immutable && !expected.immutable {
            out.push(LevelGap { .elements = elements, .want = got })
        }
        widening_levels(got.element, expected.element, elements + 1, bounds, out)
        return
    }
    if type_grants_mutation(expected) && !type_grants_mutation(got) && carries_mutability_bit(got) {
        out.push(LevelGap { .elements = elements, .want = got })
    }
}

// The variant of `u` a value of type `got` fills : its own shape's, else the trait
// value it widens into.
filled_by :: fn(u: UnionType, got: Type, bounds: MutableMap<i32, TypeParamBound>) -> Type | null {
    shaped :: counterpart(u, got)
    if shaped != null {
        return shaped
    }
    return widened_trait_variant(got, u.variants, true, bounds)
}

// The first level under a mutable array spine where `got` grants mutation and the slot
// `expected` does not.
gaining_level :: fn(got: Type, expected: Type, elements: i32) -> LevelGap | null {
    if got !is ArrayType || expected !is ArrayType || expected.immutable {
        return null
    }
    if type_grants_mutation(got.element) && !type_grants_mutation(expected.element) {
        return LevelGap { .elements = elements + 1, .want = expected.element }
    }
    return gaining_level(got.element, expected.element, elements + 1)
}

// A walk for the deduced parameters a value is reached from.
LeverWalk :: struct {
    typed: TypedProgram
    /// Whether a field leads to its struct. A need takes it : a field is as read-only
    /// as its struct. An edge does not : the field's declared levels are its own.
    fields: bool
    roots: SlotRoot[]!
}

// The deduced parameters `e`, `elements` array levels below it, is reached from
// (`levers_of`). `fields` as for `LeverWalk`.
roots_of :: fn(e: AST.Expr, elements: i32, fields: bool, typed: TypedProgram) -> SlotRoot[] {
    walk :: LeverWalk {
        .typed = typed,
        .fields = fields,
        .roots = [],
    }
    levers_of(e, elements, NARROW_BORROW_BUDGET, walk)
    return walk.roots
}

// The roots an edge from `e` follows.
edge_roots_of :: fn(e: AST.Expr, typed: TypedProgram) -> SlotRoot[] = roots_of(e, 0, false, typed)

// The deduced parameters `e` is reached from, into `walk` : the parameter itself, an
// element or a field of it, a conversion of it, a loop variable over it, a local bound
// to it or to one of its elements, an `is T as x` over it, the elements of an array
// literal, either side of a `??`, each branch of a value-position `if` or `match`.
// `elements` counts the array levels already stepped down.
levers_of :: fn(e: AST.Expr, elements: i32, budget: i32, walk: LeverWalk) -> void {
    if budget <= 0 {
        return
    }
    typed :: walk.typed
    match e {
        is AST.IndexExpr -> {
            target_ty :: typed.expr_types[e.target.id] ?? return
            index_ty :: typed.expr_types[e.index.id] ?? return
            if array_shape_in(target_ty) != null {
                // A slice is a view of the same array, an element one level down.
                step :: if is_range_type(index_ty) { 0 } else { 1 }
                levers_of(e.target, elements + step, budget, walk)
            }
        }
        is AST.FieldExpr -> { field_levers(e, elements, budget, walk) }
        // A conversion `T(x)` re-types the same reference (`converted_is_immutable`).
        is AST.CallExpr -> {
            if retypes_reference(e, typed) {
                levers_of(e.args[0].value, elements, budget - 1, walk)
            }
        }
        // An element of a fresh literal is one level below it, and the literal's own
        // level is fresh : a need there has no root, and an edge reaches its elements'
        // roots only from the walked value's level that stands for them (`floor`).
        is AST.SeqLitExpr -> {
            if walk.fields && elements < 1 {
                return
            }
            literal_ty :: typed.expr_types[e.id] ?? return
            if array_shape_in(literal_ty) == null {
                return
            }
            first :: walk.roots.len()
            for element in e.elements {
                levers_of(element, elements - 1, budget - 1, walk)
            }
            for i in first..<walk.roots.len() {
                root :: walk.roots[i]
                walk.roots[i] = SlotRoot { ...root, .floor = max(root.floor, 1 - elements) }
            }
        }
        is AST.NullCoalesceExpr -> {
            levers_of(e.left, elements, budget - 1, walk)
            if e.fallback is AST.Expr {
                levers_of(e.fallback, elements, budget - 1, walk)
            }
        }
        is AST.IdentExpr -> { ident_levers(e, elements, budget, walk) }
        // A value-position `if`, `match` or block is whichever branch ran.
        is AST.BlockExpr -> {
            trailing :: e.trailing ?? return
            levers_of(trailing, elements, budget - 1, walk)
        }
        is AST.IfExpr -> {
            levers_of(e.then_block, elements, budget - 1, walk)
            match e.else_branch as other {
                is AST.IfElseIf    -> { levers_of(other.branch, elements, budget - 1, walk) }
                is AST.IfElseBlock -> { levers_of(other.block, elements, budget - 1, walk) }
                is null            -> {}
            }
        }
        is AST.MatchExpr -> {
            for arm in e.arms {
                levers_of(arm.body, elements, budget - 1, walk)
            }
        }
        _ -> {}
    }
}

// A field is as read-only as its struct (`walk_levels`) and as its declared type : the
// struct's own level is the lever only where the declared type grants the level the
// value is reached at.
field_levers :: fn(e: AST.FieldExpr, elements: i32, budget: i32, walk: LeverWalk) -> void {
    if !walk.fields || elements < 0 {
        return
    }
    typed :: walk.typed
    holder :: typed.expr_types[e.target.id] ?? return
    declared :: declared_struct_field_type(holder, e.field, typed) ?? return
    reached :: type_at_level(declared, elements_path(elements)) ?? return
    if withholds_mutation(reached) {
        return
    }
    first :: walk.roots.len()
    levers_of(e.target, 0, budget - 1, walk)
    // The innermost field names the root's level.
    for i in first..<walk.roots.len() {
        root :: walk.roots[i]
        if root.holder == null {
            walk.roots[i] = SlotRoot { ...root, .holder = holder }
        }
    }
}

// Whether a field's declared level `t` withholds mutation, whatever its holder's
// rights : a read-only reference, a read-only view of `T`, or a union with one such
// variant. A `T` the instance binds has the rights of its binding.
withholds_mutation :: fn(t: Type) -> bool {
    if t is UnionType {
        for v in t.variants {
            if type_is_immutable(v) {
                return true
            }
        }
        return false
    }
    return type_is_immutable(t)
}

ident_levers :: fn(e: AST.IdentExpr, elements: i32, budget: i32, walk: LeverWalk) -> void {
    typed :: walk.typed
    sym :: typed.resolved.idents[e.span.hash()] ?? return
    at :: sym.defined_at ?? return
    inference :: typed.param_inference ?? return
    // A deduced slot is its own lever, whatever it was bound to.
    if at.hash() in inference.slots {
        walk.roots.push(SlotRoot { .key = at.hash(), .elements = elements })
        return
    }
    if sym.kind == .Param {
        return
    }
    iterable :: typed.loop_var_iterable[sym.id]
    if iterable != null {
        iterable_ty :: typed.expr_types[iterable.id] ?? return
        if array_shape_in(iterable_ty) != null {
            levers_of(iterable, elements + 1, budget - 1, walk)
        }
        return
    }
    bound_to :: typed.local_bound_to[sym.id]
    if bound_to != null {
        levers_of(bound_to, elements, budget - 1, walk)
        return
    }
    scrutinee :: typed.narrow.binding_scrutinee[at.hash()] ?? return
    levers_of(scrutinee, elements, budget - 1, walk)
}

// The levels of `slot`'s written type a need reaches : `elements` array levels down,
// then the variant(s) of a union that `want` stands for. Empty when the type does not
// spell that level out — an alias, a nominal type's argument — or it has no interior.
levels_for :: fn(
    slot: InferableSlot, elements: i32, want: Type, resolved: ResolvedModule,
) -> i32[][] {
    out: i32[][]: []
    ty :: slot_type(slot)
    if ty == null {
        if elements == 0 {
            out.push([])
        }
        return out
    }
    walk_levels_for(ty, [], elements, want, resolved, out)
    return out
}

walk_levels_for :: fn(
    t: AST.TypeExpr, path: i32[], elements: i32, want: Type, resolved: ResolvedModule,
    out: i32[][],
) -> void {
    if t is AST.MutableTypeExpr {
        walk_levels_for(t.inner, path, elements, want, resolved, out)
        return
    }
    if t is AST.BinaryExpr && t.op == .BitOr {
        variants :: AST.collect_bitor_variants(t)
        for k in 0..<variants.len() {
            v :: variants[k]
            vt :: type_from_expr(v, resolved, [])
            fits :: if elements > 0 { array_shape_in(vt) != null } else { types_overlap(vt, want) }
            if fits {
                walk_levels_for(v, path + [i32(k)], elements, want, resolved, out)
            }
        }
        return
    }
    if elements > 0 {
        if t is AST.ArrayTypeExpr {
            walk_levels_for(t.element, path + [ELEMENT], elements - 1, want, resolved, out)
        }
        return
    }
    if is_value_only_type(type_from_expr(t, resolved, [])) {
        return
    }
    out.push(path)
}

// ---- during a round : edges -----------------------------------------------

/// Record that argument `i` of the call `c` is handed to a deduced parameter : when
/// that parameter is marked, the argument's own lever is too.
///
/// Recorded only where exact — the argument's type is the parameter's, up to the `!`,
/// and nothing converts it on the way in — so the mark it carries is one the call's
/// check would demand.
///
/// @param arg_ty    the argument's type.
/// @param param_ty  the parameter's type as the call's instance has it.
note_arg_edge :: fn(
    c: AST.CallExpr, i: usize, arg_ty: Type, param_ty: Type, typed: TypedProgram,
) -> void {
    inference :: recording_edges(typed) ?? return
    // A value has no level a mark could reach.
    if is_value_only_type(arg_ty) {
        return
    }
    roots :: edge_roots_of(c.args[i].value, typed)
    if roots.len() == 0 && !has_mutable_element(arg_ty) {
        return
    }
    param :: param_for_arg(c, i, typed) ?? return
    key :: param.span.hash()
    if !(key in inference.slots) {
        return
    }
    if fits_shape(arg_ty, param_ty) && !converts_to_owned(arg_ty, param_ty, typed) {
        add_arg_edges(inference, key, roots, arg_ty, c.span)
    }
}

/// Record that the receiver of the method call `e` is handed to the deduced first
/// parameter of the fn it reaches : an impl member's `self`, or a free fn's.
///
/// @param im       the member the call reaches.
/// @param recv_ty  the receiver's type.
note_method_receiver_edge :: fn(
    im: ImplMethod, e: AST.FieldExpr, recv_ty: Type, typed: TypedProgram,
) -> void {
    inference :: recording_edges(typed) ?? return
    member :: im.decl
    if member != null {
        note_receiver_edge(inference, member, e, recv_ty, null, typed)
        return
    }
    // A free fn the receiver fills the first parameter of.
    decl :: noted_decl(typed, e) ?? return
    first :: typed.ufcs_receiver_types[e.id] ?? return
    note_receiver_edge(inference, decl, e, recv_ty, first, typed)
}

// `first_ty` is the first parameter's type, or null for an impl member's `self`,
// which stands for the receiver's own type.
note_receiver_edge :: fn(
    inference: ParamInference, decl: AST.FnDecl, e: AST.FieldExpr, recv_ty: Type,
    first_ty: Type | null, typed: TypedProgram,
) -> void {
    if decl.params.len() == 0 || is_value_only_type(recv_ty) {
        return
    }
    key :: decl.params[0].span.hash()
    if !(key in inference.slots) {
        return
    }
    roots :: edge_roots_of(e.target, typed)
    if roots.len() == 0 && !has_mutable_element(recv_ty) {
        return
    }
    if first_ty == null || fits_shape(recv_ty, first_ty) {
        add_arg_edges(inference, key, roots, recv_ty, e.span)
    }
}

/// Record that `value` fills the deduced local `name` — its initializer, or a value
/// assigned to it : when the local is marked, the value's lever is too, as an
/// argument's is for its parameter. Exact under the same terms.
///
/// @param name      the local's name, as written at the binding or the assignment.
/// @param value_ty  the value's type.
/// @param slot_ty   the local's declared type.
/// @param at        the binding or the assignment.
note_fill_edge :: fn(
    name: Span, value: AST.Expr, value_ty: Type, slot_ty: Type, at: Span, typed: TypedProgram,
) -> void {
    inference :: recording_edges(typed) ?? return
    if is_value_only_type(value_ty) {
        return
    }
    sym :: typed.resolved.idents[name.hash()] ?? return
    defined :: sym.defined_at ?? return
    key :: defined.hash()
    slot :: inference.slots[key] ?? return
    if slot.owner !is AST.LetStmt {
        return
    }
    roots :: edge_roots_of(value, typed)
    if roots.len() == 0 && !has_mutable_element(value_ty) {
        return
    }
    if fits_shape(value_ty, slot_ty) && !converts_to_owned(value_ty, slot_ty, typed) {
        add_arg_edges(inference, key, roots, value_ty, at)
    }
}

// The edges of a value of type `arg_ty`, handed at `call` to the deduced slot `key` :
// an argument to its parameter, or a value to the local it fills.
add_arg_edges :: fn(
    inference: ParamInference, key: u64, roots: SlotRoot[], arg_ty: Type, call: Span,
) -> void {
    slot :: inference.slots[key] ?? return
    edge :: ArgEdge {
        .arg_ty = arg_ty,
        .call = call,
        .callee = if slot.owner is AST.LetStmt { slot.name } else { slot.fn_name },
    }
    add_edges(inference, key, edge, roots)
}

// The deduction, while its first round records edges.
recording_edges :: fn(typed: TypedProgram) -> ParamInference! | null {
    inference :: typed.param_inference ?? return null
    return if inference.first_round { inference } else { null }
}

// The declared parameter that argument `i` of `c` fills, in the fn the typecheck
// recorded for the call : past the receiver of a method-form call.
param_for_arg :: fn(c: AST.CallExpr, i: usize, typed: TypedProgram) -> AST.FnParam | null {
    decl :: recorded_decl(typed, c) ?? return null
    at :: i + receiver_offset(c, decl, typed)
    return if at < decl.params.len() { decl.params[at] } else { null }
}

// How many of `decl`'s parameters a method-form call `c` fills with its receiver.
receiver_offset :: fn(c: AST.CallExpr, decl: AST.FnDecl, typed: TypedProgram) -> usize {
    if c.callee !is AST.FieldExpr {
        return 0
    }
    if typed.ufcs_receiver_types[c.callee.id] != null {
        return 1
    }
    return if chosen_impl_decl(typed, c.callee.id) != null { receiver_count(decl) } else { 0 }
}

// `edge` from the parameter `key`, once per root of its argument — or once, rootless,
// when it has none.
add_edges :: fn(inference: ParamInference, key: u64, edge: ArgEdge, roots: SlotRoot[]) -> void {
    edges: ArgEdge[]: inference.edges[key] ?? []
    if roots.len() == 0 {
        edges.push(edge)
    }
    for root in roots {
        edges.push(ArgEdge {
            ...edge,
            .root = root.key,
            .elements = root.elements,
            .floor = root.floor,
        })
    }
    inference.edges[key] = edges
}

// Whether an argument of type `arg` fills a parameter of type `param` level for level,
// the `!` aside : a level a mark reaches on the parameter is then the argument's own.
// A type parameter takes anything, and a narrowed union fills a wider one.
fits_shape :: fn(arg: Type, param: Type) -> bool {
    if param is TypeParamType {
        return true
    }
    if param is UnionType {
        if arg !is UnionType {
            return fills_a_variant(arg, param.variants)
        }
        for a in arg.variants {
            if !fills_a_variant(a, param.variants) {
                return false
            }
        }
        return true
    }
    // @partial: any other type fills only its own shape.
    return @partial match arg {
        is ArrayType    -> param is ArrayType && fits_shape(arg.element, param.element)
        // A nominal type is matched by its declaration : its arguments are no level of
        // a parameter's written type.
        is StructType   -> param is StructType && arg.symbol.id == param.symbol.id
        is TraitType    -> param is TraitType && arg.symbol.id == param.symbol.id
        is DistinctType -> param is DistinctType && arg.symbol.id == param.symbol.id
        _               -> equals_type_shape(arg, param)
    }
}

fills_a_variant :: fn(arg: Type, variants: Type[]) -> bool {
    for v in variants {
        if fits_shape(arg, v) {
            return true
        }
    }
    return false
}

has_mutable_element :: fn(t: Type) -> bool {
    arr :: array_shape_in(t) ?? return false
    return type_grants_mutation(arr.element) || has_mutable_element(arr.element)
}

/// Record that a method call on an array stores what its argument `i` holds into an
/// element of its receiver. The receiver binds the member's `T` : a parameter that is
/// `T` under k arrays takes the receiver's element rights at the argument's levels k
/// down, as `push_all`'s `other: T[]` ; at k = 0, only a parameter that grants
/// mutation demands them, as `push`'s `value: T!`.
note_element_store :: fn(c: AST.CallExpr, i: usize, arg_ty: Type, typed: TypedProgram) -> void {
    inference :: recording_edges(typed) ?? return
    callee :: c.callee
    if callee !is AST.FieldExpr {
        return
    }
    member :: typed.chosen_impl_methods[callee.id] ?? return
    signature :: member.ty
    if signature !is FnType || i >= signature.params.len() {
        return
    }
    depth :: type_param_depth(signature.params[i]) ?? return
    if depth == 0 && !param_mutable_at(signature, i) {
        return
    }
    receiver :: callee.target
    recv_ty :: typed.expr_types[receiver.id] ?? return
    arr :: array_shape_in(recv_ty) ?? return
    stored_ty :: type_at_level(arg_ty, elements_path(depth)) ?? return
    if !fits_shape(stored_ty, arr.element) {
        return
    }
    containers :: edge_roots_of(receiver, typed)
    store_edges(inference, containers, c.args[i].value, stored_ty, depth, c.args[i].span, typed)
}

// How many arrays down `t` is a type parameter ; null when it is none.
type_param_depth :: fn(t: Type) -> i32 | null {
    if t is TypeParamType {
        return 0
    }
    arr :: array_shape_in(t) ?? return null
    below :: type_param_depth(arr.element) ?? return null
    return below + 1
}

/// Record that `value` is stored into an element of `container` : when the container's
/// element is marked, what is stored there must grant as much.
///
/// @param value_ty  the stored value's type.
/// @param at        where it is stored.
note_store_edge :: fn(
    container: AST.Expr, value: AST.Expr, value_ty: Type, at: Span, typed: TypedProgram,
) -> void {
    inference :: recording_edges(typed) ?? return
    store_edges(inference, edge_roots_of(container, typed), value, value_ty, 0, at, typed)
}

// An edge from the element of each of `containers` to the roots of what is stored
// there : `value`'s levels `depth` arrays down, of type `stored_ty`.
store_edges :: fn(
    inference: ParamInference, containers: SlotRoot[], value: AST.Expr, stored_ty: Type,
    depth: i32, at: Span, typed: TypedProgram,
) -> void {
    if containers.len() == 0 {
        return
    }
    stored :: roots_of(value, depth, false, typed)
    if stored.len() == 0 {
        return
    }
    for container in containers {
        if container.elements < 0 {
            continue
        }
        edge :: ArgEdge {
            .from = container.elements + 1,
            .arg_ty = stored_ty,
            .call = at,
            .callee = "",
        }
        add_edges(inference, container.key, edge, stored)
    }
}

// ---- between rounds -------------------------------------------------------

/// Mark, in the AST, every level the needs, the written `!` and the edges close over,
/// and say whether any is new — in which case the round must run again.
///
/// @param modules  every module's typed program from the round, to read a level's
///                 type with its module's names.
/// @return         true when a level was marked that the round did not see.
settle_param_marks :: fn(
    inference: ParamInference, modules: MutableMap<string, TypedProgram>,
) -> bool {
    resolve_pending_needs(inference, modules)
    if inference.first_round {
        index_edges_by_root(inference)
        inference.first_round = false
    } else if inference.needs.len() == inference.settled_needs {
        // The edges and the written `!` are fixed after the first round : without a new
        // need, the closure is the one already marked.
        return false
    }
    inference.settled_needs = inference.needs.len()
    // The needs only grow and the edges are fixed : the closure holds every level
    // marked so far.
    seeds :: need_seeds(inference)
    for [key, slot] in inference.slots {
        for mark in slot.written {
            seeds.push(MarkedLevel {
                .key = key,
                .path = mark.path,
                .cause = written_cause(slot),
            })
        }
    }
    grew := false
    for [k, level] in closure_of(seeds, inference, modules) {
        if k in inference.marks {
            continue
        }
        slot :: inference.slots[level.key] ?? continue
        mark_slot_level(slot, level.path)
        inference.marks[k] = level
        grew = true
    }
    return grew
}

// Read this round's needs into levels of their parameters' written types.
resolve_pending_needs :: fn(
    inference: ParamInference, modules: MutableMap<string, TypedProgram>,
) -> void {
    for need in inference.pending {
        slot :: inference.slots[need.key] ?? continue
        typed :: modules[slot.module] ?? continue
        paths :: levels_for(slot, need.elements, need.want, typed.resolved)
        _ :: add_needs(inference, need.key, paths, need.cause)
    }
    inference.pending = []
}

// Index the arguments' edges by their root, once the first round has recorded them.
index_edges_by_root :: fn(inference: ParamInference) -> void {
    for [callee, edges] in inference.edges {
        for edge in edges {
            root :: edge.root ?? continue
            if edge.from > 0 {
                continue
            }
            rooted :: RootedEdge { .callee = callee, .edge = edge }
            existing :: inference.by_root[root]
            if existing == null {
                inference.by_root[root] = [rooted]
            } else {
                existing.push(rooted)
            }
        }
    }
}

// The levels the bodies alone demand : the needs, closed over the edges, without the
// written `!`.
deduced_levels :: fn(
    inference: ParamInference, modules: MutableMap<string, TypedProgram>,
) -> MutableMap<string, MarkedLevel> {
    return closure_of(need_seeds(inference), inference, modules)
}

// The needs, as the seeds of a closure.
need_seeds :: fn(inference: ParamInference) -> MarkedLevel[]! {
    seeds: MarkedLevel[]: []
    for [_, level] in inference.needs {
        seeds.push(level)
    }
    return seeds
}

// The levels `seeds` reach along the edges, by `level_key`.
//
// Along an edge, a mark of the callee's level reaches the argument's root at the same
// level (`propagated`). Under a spine the callee may grow, the element is invariant
// both ways : a mutable element the argument hands in marks the callee's, whether the
// argument's type writes it (`align_element`) or its root's mark does.
closure_of :: fn(
    seeds: MarkedLevel[], inference: ParamInference, modules: MutableMap<string, TypedProgram>,
) -> MutableMap<string, MarkedLevel> {
    closed :: MutableMap<string, MarkedLevel> {}
    for seeds.len() > 0 {
        level :: seeds.remove_last() ?? break
        k :: level_key(level.key, level.path)
        if k in closed {
            continue
        }
        closed[k] = level
        for edge in inference.edges[level.key] ?? [] {
            propagate(edge, level, k, inference, modules, seeds)
            if edge.from == 0 {
                align_element(level, edge, closed, seeds)
            }
        }
        if !all_elements(level.path) {
            continue
        }
        // The root's elements are marked : the callee's element under a spine it
        // grows takes them.
        for rooted in inference.by_root[level.key] ?? [] {
            spine :: i32(level.path.len()) - rooted.edge.elements - 1
            if spine < 0 || spine + 1 < rooted.edge.floor {
                continue
            }
            element :: elements_path(spine + 1)
            if level_key(rooted.callee, element) in closed {
                continue
            }
            if level_key(rooted.callee, elements_path(spine)) in closed {
                seeds.push(MarkedLevel {
                    .key = rooted.callee,
                    .path = element,
                    .cause = handed_cause(rooted.edge),
                })
            }
        }
    }
    return closed
}

// The callee was just marked at `level` along `edge` : when that is a spine, its
// element takes the `!` the argument's element has — written in the argument's type,
// or marked on its root.
align_element :: fn(
    level: MarkedLevel, edge: ArgEdge, closed: MutableMap<string, MarkedLevel>,
    seeds: MarkedLevel[],
) -> void {
    if !all_elements(level.path) {
        return
    }
    spine :: i32(level.path.len())
    path :: elements_path(spine + 1)
    if level_key(level.key, path) in closed {
        return
    }
    element :: type_at_level(edge.arg_ty, path) ?? return
    if type_grants_mutation(element) || root_marked_at(edge, spine + 1, closed) {
        seeds.push(MarkedLevel {
            .key = level.key,
            .path = path,
            .cause = handed_cause(edge),
        })
    }
}

// Whether the root of `edge` is marked at the level standing for the argument's
// level `arg_level`.
root_marked_at :: fn(
    edge: ArgEdge, arg_level: i32, closed: MutableMap<string, MarkedLevel>,
) -> bool {
    root :: edge.root ?? return false
    elements :: edge.elements + arg_level
    return arg_level >= edge.floor && elements >= 0 &&
        level_key(root, elements_path(elements)) in closed
}

handed_cause :: fn(edge: ArgEdge) -> MarkCause =
    MarkCause { .span = edge.call, .what = "`${edge.callee}` is handed mutable elements here" }

// Push the levels of an edge's root that a mark of the callee's `level`, keyed `via`,
// reaches.
propagate :: fn(
    edge: ArgEdge, level: MarkedLevel, via: string, inference: ParamInference,
    modules: MutableMap<string, TypedProgram>, seeds: MarkedLevel[],
) -> void {
    root_key :: edge.root ?? return
    if edge.from > 0 && (!all_elements(level.path) || element_steps(level.path) < edge.from) {
        return
    }
    root :: inference.slots[root_key] ?? return
    callee :: inference.slots[level.key] ?? return
    typed :: modules[root.module] ?? return
    below :: level.path[usize(edge.from)..<level.path.len()]
    if element_steps(below) < edge.floor {
        return
    }
    elements :: edge.elements + element_steps(below)
    if elements < 0 || !fills_variants(edge.arg_ty, callee, level.path, edge.from, modules) {
        return
    }
    at_root :: type_at_level(edge.arg_ty, below)
    want :: if at_root != null {
        at_root
    } else {
        written_type_at(callee, level.path, modules) ?? return
    }
    paths :: levels_for(root, elements, want, typed.resolved)
    if paths.len() == 0 {
        return
    }
    what :: if edge.from > 0 {
        "it is stored into an element that grants mutation"
    } else if callee.owner is AST.LetStmt {
        "it fills `${edge.callee}`, which is mutated"
    } else {
        "it is passed to `${edge.callee}`, which mutates it"
    }
    cause :: MarkCause {
        .span = edge.call,
        .what = what,
        .via = via,
    }
    for path in paths {
        seeds.push(MarkedLevel {
            .key = root_key,
            .path = path,
            .cause = cause,
        })
    }
}

// Whether a value of type `arg`, standing for the callee's level `path` from step
// `from` down, fills each variant the path steps into : a value of one shape fills
// one variant of the callee's written union, and a mark of another is none of its.
fills_variants :: fn(
    arg: Type, callee: InferableSlot, path: i32[], from: i32,
    modules: MutableMap<string, TypedProgram>,
) -> bool {
    at := arg
    for i in usize(from)..<path.len() {
        if path[i] == ELEMENT {
            arr :: array_shape_in(at) ?? return true
            at = arr.element
            continue
        }
        if at is UnionType {
            return true
        }
        variant :: written_type_at(callee, path[0..<i + 1], modules) ?? return true
        if !fits_shape(at, variant) {
            return false
        }
    }
    return true
}

// The type at `path` inside `t`, when the path steps through arrays alone : a variant
// step names the callee's written union, which `t` need not order alike.
type_at_level :: fn(t: Type, path: i32[]) -> Type | null {
    at := t
    for step in path {
        if step != ELEMENT {
            return null
        }
        arr :: array_shape_in(at) ?? return null
        at = arr.element
    }
    return at
}

// The type `slot`'s written type names at `path`, read with its module's names.
written_type_at :: fn(
    slot: InferableSlot, path: i32[], modules: MutableMap<string, TypedProgram>,
) -> Type | null {
    typed :: modules[slot.module] ?? return null
    written :: slot_type(slot) ?? return null
    node :: node_at(written, path) ?? return null
    return type_from_expr(node, typed.resolved, [])
}

// Write the `!` of `path` into the slot's type — on the name of a `self`, which has
// none.
mark_slot_level :: fn(slot: InferableSlot, path: i32[]) -> void {
    owner :: slot.owner
    // A `!` the source writes is put back as written : a printer keeps it.
    deduced :: !is_written(slot, path)
    if owner is AST.LetStmt {
        written :: owner.ty ?? return
        owner.ty = marked_at(written, path, 0, deduced)
        return
    }
    written :: owner.ty
    if written == null {
        owner.mutable = true
        return
    }
    owner.ty = marked_at(written, path, 0, deduced)
}

marked_at :: fn(t: AST.TypeExpr, path: i32[], depth: usize, deduced: bool) -> AST.TypeExpr! {
    if t is AST.MutableTypeExpr {
        if depth < path.len() {
            t.inner = marked_at(t.inner, path, depth, deduced)
        }
        return t
    }
    if depth == path.len() {
        return AST.MutableTypeExpr {
            .span = t.span,
            .inner = t,
            .deduced = deduced,
        }
    }
    step :: path[depth]
    if step == ELEMENT {
        if t is AST.ArrayTypeExpr {
            t.element = marked_at(t.element, path, depth + 1, deduced)
        }
    } else if t is AST.BinaryExpr && t.op == .BitOr {
        _ :: rewrite_variants(t, 0, (v: AST.Expr!, k: i32) -> {
            if k == step {
                return marked_at(v, path, depth + 1, deduced)
            }
            return v
        })
    }
    return t
}

// ---- once a round marks nothing new ---------------------------------------

/// Close the deduction : the warnings on the `!` the source writes on deduced
/// parameters, then the round state dropped. The marks stay, for a refusal's cause
/// and the editor.
///
/// Each written `!` is either deduced anyway (W0017) or demanded by nothing (W0018) ;
/// `vader fix` removes both.
///
/// @param modules  every module's typed program from the last round.
end_param_inference :: fn(
    inference: ParamInference, modules: MutableMap<string, TypedProgram>,
) -> Diagnostic[] {
    warnings :: written_mark_warnings(inference, modules)
    inference.pending = []
    inference.needs.clear()
    inference.edges.clear()
    inference.by_root.clear()
    return warnings
}

written_mark_warnings :: fn(
    inference: ParamInference, modules: MutableMap<string, TypedProgram>,
) -> Diagnostic[] {
    out: Diagnostic[]: []
    if !writes_a_mark(inference) {
        return out
    }
    deduced :: deduced_levels(inference, modules)
    for [key, slot] in inference.slots {
        name :: slot.name
        for mark in slot.written {
            // A `!` on a type with no interior is T3075's, reported where it is written.
            level_ty :: written_type_at(slot, mark.path, modules)
            if level_ty != null && is_value_only_type(level_ty) {
                continue
            }
            level :: deduced[level_key(key, mark.path)]
            if level == null {
                out.push(warning(.NeedlessMutabilityMarker, mark.bang, "`${name}`"))
            } else {
                why :: "${level.cause.what} at ${where_of(level.cause.span)}"
                out.push(warning(.DeducedMutabilityMarker, mark.bang, "`${name}` : ${why}"))
            }
        }
    }
    return out
}

writes_a_mark :: fn(inference: ParamInference) -> bool {
    for [_, slot] in inference.slots {
        if slot.written.len() > 0 {
            return true
        }
    }
    return false
}

written_cause :: fn(slot: InferableSlot) -> MarkCause =
    MarkCause { .span = slot.span, .what = "its source writes the `!`" }

// ---- reading the marks ----------------------------------------------------

/// Why the deduced top level of the parameter `p` grants mutation, as a refusal at a
/// call names it : the chain of calls down to the mutation itself. Null when `p`'s
/// `!` is written — the author's word needs no reason — or not deduced.
///
/// @param p  a parameter of the fn a call reaches.
deduced_mutation_why :: fn(p: AST.FnParam, typed: TypedProgram) -> string | null {
    inference :: typed.param_inference ?? return null
    key :: p.span.hash()
    slot :: inference.slots[key] ?? return null
    if is_written(slot, []) {
        return null
    }
    level :: inference.marks[level_key(key, [])] ?? return null
    return "`${slot.fn_name}` mutates `${p.name}` : ${level_why(level, inference)}"
}

/// A deduced `!` of a slot, as an editor shows it : where the marker would be
/// written, and why the compiler puts it there.
export DeducedMark :: struct {
    /// The slot's name.
    name: string
    /// The slot's span : the parameter, or the local's name.
    span: Span
    /// Just past the level's written type, where its `!` would go.
    at: Position
    why: string
}

/// Every `!` deduced on the slots `keep` selects that their source does not write.
///
/// @param keep  whether a slot's marks are wanted ; asked before their cause is
///              worded.
export deduced_marks :: fn(
    inference: ParamInference, keep: fn(InferableSlot) -> bool,
) -> DeducedMark[] {
    out: DeducedMark[]: []
    for [_, level] in inference.marks {
        slot :: inference.slots[level.key] ?? continue
        if !keep(slot) || is_written(slot, level.path) {
            continue
        }
        at :: level_end(slot, level.path) ?? continue
        out.push(DeducedMark {
            .name = slot.name,
            .span = slot.span,
            .at = at,
            .why = level_why(level, inference),
        })
    }
    return out
}

is_written :: fn(slot: InferableSlot, path: i32[]) -> bool {
    for mark in slot.written {
        if mark.path.content_equals(path) {
            return true
        }
    }
    return false
}

// Where the `!` of `path` would be written in `slot` : past the level's type, or past
// the name of a `self`.
level_end :: fn(slot: InferableSlot, path: i32[]) -> Position | null {
    written :: slot_type(slot) ?? return slot.span.end
    node :: node_at(written, path) ?? return null
    // A deduced marker spans its level's type alone.
    return node.span.end
}

// The node of the written type `t` at `path`, its markers peeled on the way down.
node_at :: fn(t: AST.TypeExpr, path: i32[]) -> AST.TypeExpr | null {
    at: AST.TypeExpr = t
    for step in path {
        at = AST.strip_mut_marker(at) ?? at
        if step == ELEMENT {
            if at !is AST.ArrayTypeExpr {
                return null
            }
            at = at.element
        } else {
            variants :: AST.collect_bitor_variants(at)
            if usize(step) >= variants.len() {
                return null
            }
            at = variants[usize(step)]
        }
    }
    return at
}

// Why `level` is marked : the chain of calls down to the mutation itself.
level_why :: fn(level: MarkedLevel, inference: ParamInference) -> string {
    sb :: StringBuilder {}
    at := level
    // Bounded : a recursive fn hands its parameter back to itself.
    for step in 0..<CAUSE_CHAIN_LIMIT {
        cause :: at.cause
        if step > 0 {
            slot :: inference.slots[at.key] ?? break
            // A local is filled in the fn the chain is already in.
            sb.append(if slot.fn_name == "" { " ; " } else { " ; in `${slot.fn_name}`, " })
        }
        sb.append("${cause.what} at ${where_of(cause.span)}")
        if cause.via == "" {
            break
        }
        at = inference.marks[cause.via] ?? break
    }
    return sb.to_string()
}

CAUSE_CHAIN_LIMIT :: 4

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_level_key_spells_each_step :: fn() -> void {
    assert_eq(level_key(7, [ELEMENT, 1, ELEMENT]), "7/e/1/e")
}
