// vader/typecheck/expr_index — IndexExpr inference (`x[i]`), and `index_route`, the
// dispatch decision the typecheck and the lowerings share.

module "vader/typecheck"

import "std/collections"
import "vader/diagnostics"
import "vader/types"
AST :: import "toolchain/ast"

/// Type-check the read `target[index]` : an array's element, a bound's or an impl's
/// `Index` result, a string's `char`, a slice for a `Range` index.
export infer_index :: fn(
    e: AST.IndexExpr, typed: TypedProgram, diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> Type {
    target :: check_expr_fn(e.target, null, typed, diags)
    index_trait :: core_trait_key(TRAIT_INDEX)
    dispatched :: dispatched_index_args(e, target, index_trait, typed, diags)
    // Pin a free-literal index key to the key type K so `m[9000000000]` on a
    // `MutableMap<i64, _>` doesn't default to i32 and silently truncate. `null` for
    // arrays/strings — the index there is just an integer.
    key_ty :: if dispatched != null {
        dispatched[0]
    } else {
        index_key_expected(target, index_trait, typed)
    }
    index :: check_expr_fn(e.index, key_ty, typed, diags)
    if target is UnresolvedType { return TY_UNRESOLVED }
    // `"hello"[1]` — codepoint indexing on string returns char.
    // `"hello"[r]` where `r: Range<T>` — codepoint slice returning string.
    if target is PrimitiveType {
        if target.name == "string" {
            if is_range_type(index) { return TY_STRING }
            if !is_integer_index(index) {
                diags.push(typecheck_error(.TypeMismatch, e.index.span,
                    "string index must be an integer, got ${display_type(index)}"))
            }
            return mk_primitive("char")
        }
    }
    // A `Range` index on an array, or on an array-backed distinct, slices it : no
    // impl of a distinct's own takes a `Range` key.
    arr_view :: array_backing(target)
    if arr_view != null && is_range_type(index) {
        // A slice is a zero-copy VIEW sharing the parent's buffer (SPEC §Arrays),
        // so it inherits the parent's mutability. Hard-wiring it mutable
        // laundered the freeze : `frozen[0..<1]` handed back a writable alias
        // onto the very buffer that was frozen.
        return mk_array(arr_view.element, arr_view.immutable)
    }
    if dispatched != null {
        reject_index_key(e.index, index, key_ty, typed, diags)
        return dispatched[1]
    }
    picked :: pick_index_member(e, target, index_trait, index, typed, diags)
    if picked != null {
        _ :: reject_unmet_impl_bounds(target, index_trait, .TraitNotSatisfied, e.span, typed, diags)
        return picked.return_type
    }
    route :: index_route(target, index_trait, typed)
    // Arrays — and array-backed distinct newtypes (`BigInt :: u32[]`) with no `Index`
    // of their own — index by element.
    if route == .Array && arr_view != null {
        if !is_integer_index(index) {
            diags.push(typecheck_error(.TypeMismatch, e.index.span,
                "array index must be an integer, got ${display_type(index)}"))
        }
        return arr_view.element
    }
    // A struct or a distinct indexes by its own `Index` impl.
    result_ty :: if route == .Impl {
        index_param(target, typed.index_target_types, typed)
    } else {
        null
    }
    if result_ty == null {
        diags.push(
            typecheck_error(.NotIndexable, e.span, "${display_type(target)} is not indexable"),
        )
        return TY_UNRESOLVED
    }
    _ :: reject_unmet_impl_bounds(target, index_trait, .TraitNotSatisfied, e.span, typed, diags)
    reject_index_key(e.index, index, key_ty, typed, diags)
    return result_ty
}

// T3001 when the key of `x[k]` is no `key`, the key type the receiver's `Index` /
// `IndexSet` takes ; a null `key` (an array, a string) asks nothing more.
reject_index_key :: fn(
    index: AST.Expr, index_ty: Type, key: Type | null, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    if key == null || index_ty is UnresolvedType || is_assignable(index_ty, key) {
        return
    }
    diags.push(typecheck_error(
        .TypeMismatch, index.span,
        "expected key `${display_type(key)}`, got `${display_type(index_ty)}`",
    ))
}

/// The `trait_key` arguments (`Index<I, T>`, `IndexSet<I, V>`) of a receiver that
/// dispatches `x[i]` through the trait at run time — a type parameter bounded by it,
/// a value of the trait itself, a union every variant of which implements it —
/// exactly like the method form (`c.at(i)`, `c.set_at(i, v)`). The dispatch is
/// recorded on `e`, so the lowering emits a virtual call on the receiver. Null for
/// any other receiver.
///
/// @param e          the index expression.
/// @param target     its receiver's type.
/// @param trait_key  `Index` for a read, `IndexSet` for a write.
/// @error            as `union_trait_member`, on a union.
dispatched_index_args :: fn(
    e: AST.IndexExpr,
    target: Type,
    trait_key: string,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type[] | null {
    if target is UnionType {
        method :: index_method(trait_key)
        span :: e.target.span
        member :: union_trait_member(target, trait_key, method, span, typed, diags) ?? return null
        record_bounded_dispatch(typed, e.id, trait_key, member.trait_args)
        return member.trait_args
    }
    args :: trait_dispatch_args(target, trait_key, typed) ?? return null
    record_bounded_dispatch(typed, e.id, trait_key, args)
    if target is TypeParamType {
        keep_instances_concrete(typed)
    }
    return args
}

// The `<key, value>` arguments of `trait_key` when `target` dispatches through it.
trait_dispatch_args :: fn(target: Type, trait_key: string, typed: TypedProgram) -> Type[] | null {
    if target is TypeParamType {
        bound :: typed.resolved.type_param_bounds[target.symbol.id] ?? return null
        args :: bounded_trait_args(bound, trait_key, typed) ?? return null
        return if args.len() < 2 { null } else { args }
    }
    if target is TraitType && trait_key_of(target.symbol) == trait_key && target.args.len() >= 2 {
        return target.args
    }
    if target is UnionType {
        traits :: union_dispatch_traits(target, trait_key, index_method(trait_key), typed)
        return if traits.len() == 0 { null } else { traits[0].args }
    }
    return null
}

/// Where `x[i]` goes for one of `Index` / `IndexSet`.
export IndexRoute :: enum {
    /// Through the type's own impl of the trait — a struct, a distinct, `string`.
    Impl
    /// Into an array, or the array backing a distinct with no impl of its own.
    Array
    /// Nowhere, for that trait.
    None
}

/// The route `target[i]` takes for `trait_key` : `Index` for a read, `IndexSet` for
/// a write. The one decision the typecheck and both lowerings read, so they never
/// dispatch one `x[i]` two ways. A type's own impl of the trait wins over the array
/// it may be backed by, trait by trait. A bounded type parameter, a trait value and a
/// union of the trait's implementors are `None` here : they dispatch through the
/// trait (`dispatched_index_args`).
///
/// @param target     the indexed value's type.
/// @param trait_key  `Index` for a read, `IndexSet` for a write.
export index_route :: fn(target: Type, trait_key: string, typed: TypedProgram) -> IndexRoute {
    // Indexing an array is built in : an `Index` impl written on `T[]` never takes
    // it over, so a bare array needs no lookup.
    if target is ArrayType {
        return .Array
    }
    if base_implements_trait(target, trait_key, typed) {
        return .Impl
    }
    return if array_backing(target) != null { .Array } else { .None }
}

/// The type args of a named trait carried by a TypeParam's bound (e.g.
/// `Index<I, T>` / `IndexSet<I, V>` in `[C: Index<usize, T>]`), or null when the
/// bound names no such trait. Walks `A & B` intersections the same way
/// `bound_trait_declaring` (field.vader) does.
export bounded_trait_args :: fn(bound: AST.Expr, trait_key: string, typed: TypedProgram) -> Type[] | null {
    if bound is AST.BinaryExpr {
        if bound.op == .BitAnd {
            l :: bounded_trait_args(bound.left, trait_key, typed)
            if l != null {
                return l
            }
            return bounded_trait_args(bound.right, trait_key, typed)
        }
    }
    bound_ty :: type_from_expr(bound, typed.resolved, [])
    if bound_ty is TraitType {
        if trait_key_of(bound_ty.symbol) == trait_key {
            return bound_ty.args
        }
    }
    return null
}

/// The key type K `target[k]` takes through its own impl of `trait_key`, or null for
/// an array or a string, which take an integer, and a receiver with none. A receiver
/// dispatching through the trait takes the trait's key (`dispatched_index_args`).
/// It pins a free-literal key and judges any other (`reject_index_key`).
index_key_expected :: fn(target: Type, trait_key: string, typed: TypedProgram) -> Type | null {
    // Several impls take several keys : the key picks one (`pick_index_member`).
    if trait_members(typed, target, trait_key, index_method(trait_key)).len() > 1 {
        return null
    }
    keys :: if trait_key == core_trait_key(TRAIT_INDEX_SET) {
        typed.index_set_key_types
    } else {
        typed.index_key_types
    }
    return index_param(target, keys, typed)
}

// The member `x[i]` calls through `trait_key` : `at` for `Index`, `set_at` for
// `IndexSet`.
index_method :: fn(trait_key: string) -> string =
    if trait_key == core_trait_key(TRAIT_INDEX_SET) { METHOD_SET_AT } else { METHOD_AT }

/// The member several impls of `trait_key` on `receiver` offer that the key `key_ty`
/// picks (`Index<i32, Row>` beside `Index<Point, Cell>`), its signature on
/// `receiver` without the receiver ; the pick is recorded for the lowering, in
/// `picked_index_writes` for an `IndexSet`. Null when at most one impl offers it, or
/// none takes the key (T3001) or two do (T3032).
///
/// @param trait_key  `Index` for a read, `IndexSet` for a write.
pick_index_member :: fn(
    e: AST.IndexExpr,
    receiver: Type,
    trait_key: string,
    key_ty: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> FnType | null {
    members :: trait_members(typed, receiver, trait_key, index_method(trait_key))
    if members.len() < 2 {
        return null
    }
    sigs: Type[]: []
    for m in members {
        sigs.push(impl_member_type(m, receiver, typed))
    }
    pick :: pick_by_first_arg(sigs, key_ty, 1)
    impls :: "`${trait_key_name(trait_key)}` on ${display_type(receiver)}"
    key :: "`${display_type(key_ty)}`"
    if pick.rival != null {
        diags.push(typecheck_error(
            .AmbiguousOverload, e.index.span, "several impls of ${impls} take a key ${key}",
        ))
        return null
    }
    index :: pick.best
    if index == null {
        diags.push(typecheck_error(
            .TypeMismatch, e.index.span, "no impl of ${impls} takes a key ${key}",
        ))
        return null
    }
    if trait_key == core_trait_key(TRAIT_INDEX_SET) {
        typed.picked_index_writes[e.id] = members[index]
    } else {
        typed.picked_impl_members[e.id] = members[index]
    }
    sig :: sigs[index]
    return if sig is FnType { sig } else { null }
}

/// Resolved write-value type V for an `m[k] = v` target, or null when
/// the target isn't a struct or a distinct with a recorded `IndexSet` impl.
index_set_value_expected :: fn(target: Type, typed: TypedProgram) -> Type | null =
    index_param(target, typed.index_set_value_types, typed)

/// What `receiver[k] = v` stores — an array's element, else the `IndexSet` value
/// of a receiver dispatching through the trait or of its own impl — or null when
/// no write goes through.
index_write_type :: fn(receiver: Type, typed: TypedProgram) -> Type | null {
    arr :: stored_array(receiver, typed)
    if arr != null {
        return arr.element
    }
    dispatched :: trait_dispatch_args(receiver, core_trait_key(TRAIT_INDEX_SET), typed)
    if dispatched != null {
        return dispatched[1]
    }
    return index_set_value_expected(receiver, typed)
}

// The array an `a[i] = v` stores into : `a` itself, or the backing of an
// array-backed distinct (`Ids :: i32[]`) that does not implement `IndexSet` of
// its own (`index_route`). Null when the write goes through an `IndexSet` impl.
stored_array :: fn(t: Type, typed: TypedProgram) -> ArrayType | null {
    if index_route(t, core_trait_key(TRAIT_INDEX_SET), typed) != .Array {
        return null
    }
    return array_backing(t)
}

// The `Index` / `IndexSet` parameter `table` records for `target` — the read
// target, K or V — with a struct's concrete arguments substituted into the
// template. A distinct takes no arguments, so its entry is the type. Null when
// `target` is neither, or records no impl ; the template unchanged when the
// struct decl is unavailable.
index_param :: fn(target: Type, table: MutableMap<string, Type>, typed: TypedProgram) -> Type | null {
    if target is DistinctType {
        return impl_side(typed, table, target, "")
    }
    if target !is StructType {
        return null
    }
    tmpl :: impl_side(typed, table, target, "") ?? return null
    decl :: typed.struct_decls[target.symbol.id] ?? return tmpl
    return substitute_by_name(tmpl, decl.type_params, target.args)
}

is_integer_index :: fn(t: Type) -> bool {
    if t is FreeIntType { return true }
    if t is PrimitiveType { return is_int_name(t.name) }
    return false
}

is_range_type :: fn(t: Type) -> bool {
    if t is StructType { return t.symbol.name == STRUCT_RANGE }
    return false
}
