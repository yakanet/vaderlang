// vader/typecheck/coerce — `Into` trait dispatch.
//
// Consults `typed.impl_methods` (populated by `orchestrate.vader`
// per-impl) for an `into` method registered on `got` whose return
// type unifies with `expected`. Lets the typechecker suppress
// T3001/T3020 when a valid coercion exists. Auto-array-to-Iterator
// coercion lands once the resolver indexes core's Iterator trait.

module "vader/typecheck"

import "vader/types"

AST :: import "toolchain/ast"

/// Look up `${got}::into::${expected}` in the impl-method index. The
/// per-target keying lets a source type carry multiple `Into<T>`
/// impls (e.g. `Into<i32>` AND `Into<string>`) without collision.
/// Union targets never coerce — the typer can't pick a variant —
/// so they fall through to the standard T3001 mismatch.
///
/// @param value  the coerced value. On a real `.into()` coercion (a matched
///               `Into` impl or the `T[] → Iterator` blanket) the target type is
///               recorded under its id in `typed.into_coercions` (the LSP's ghost
///               `.into()` hint, the lowering where the slot type is not at hand),
///               and the `into` is filed as its site ; trait widening records
///               nothing.
export try_into :: fn(got: Type, expected: Type, typed: TypedProgram, value: AST.Expr) -> bool {
    targeted :: into_impl_method(typed, got, expected)
    if targeted !is null {
        if targeted.ty is FnType as f {
            if is_assignable(f.return_type, expected) {
                note_into(typed, value, got, expected)
                return true
            }
            return false
        }
    }
    // Trait widening : `Cat → Animal` when `Cat implements Animal`. This
    // is a subtype widen, not an `.into()` call: record nothing.
    if try_trait_widen(got, expected, typed) {
        return true
    }
    // `T[] → Iterator<T>` : lowerer materialises the `array_iter` generator
    // at the call site. Lives in `try_into` (not `is_assignable`) to
    // keep the recursive assignability check small enough that
    // c-emit doesn't monomorphise a 3× larger main.c.
    if try_array_to_iter(got, expected) {
        note_into(typed, value, got, expected)
        return true
    }
    return false
}

/// Record that `value` converts from `source` into `target` through `Into`: the
/// target under its id for the LSP's `.into()` hint, and the `into` it runs as its
/// site, `Builtin` when the conversion runs none (a distinct's own backing).
///
/// @param value   the converted value.
/// @param source  its type.
/// @param target  the slot's type.
note_into :: fn(typed: TypedProgram, value: AST.Expr, source: Type, target: Type) -> void {
    typed.into_coercions[value.id] = target
    record_site(typed, value, .Into, conversion_callee(typed, source, target) ?? BUILTIN_CALLEE)
}

export try_array_to_iter :: fn(got: Type, expected: Type) -> bool {
    if got !is ArrayType                      { return false }
    if expected !is TraitType                 { return false }
    if expected.symbol.name != TRAIT_ITERATOR { return false }
    if expected.args.len() != 1               { return false }
    // An erased parameter (`erase_type_params`) accepts any element ; anything
    // else, a type parameter included, must be the array's own.
    if expected.args[0] is UnresolvedType     { return true }
    return equals_type(got.element, expected.args[0])
}

/// True when `got` implements the trait `expected`, at `expected`'s arguments
/// (or a variant of `expected` if it's a union). Handles struct receivers AND primitives
/// — `i32 implements Doubler(i32)` is a valid impl whose receiver name
/// is "i32" in `struct_implemented_traits`. Free* gets defaulted first.
export try_trait_widen :: fn(got: Type, expected: Type, typed: TypedProgram) -> bool {
    // Union SOURCE : `A | B` widens into `expected` iff *every* variant does —
    // each via plain assignability or its own trait widen. This is subtyping
    // (no runtime coercion), mirroring `is_assignable_union` but through the
    // impl-index widening path `is_assignable` has no registry to reach.
    // Lets `MyErr | string` flow into `Error | string` (MyErr <: Error via its
    // `implements Error`, string == string) instead of failing per-variant.
    if got is UnionType {
        for v in got.variants {
            if !fits_or_implements(v, expected, typed) {
                return false
            }
        }
        return true
    }
    if expected is UnionType {
        for v in expected.variants {
            if try_trait_widen(got, v, typed) {
                return true
            }
        }
        return false
    }
    if expected !is TraitType {
        return false
    }
    if got is TypeParamType {
        return bound_widens_into(got, expected, typed)
    }
    // A trait value dispatches by the trait alone : it cannot tell several impls of
    // it apart (`mismatch_diagnostic` says so, T3097).
    if implements_more_than_once(got, trait_key_of(expected.symbol), typed) {
        return false
    }
    return implements_trait_instance(got, expected, typed)
}

/// Whether a value of type `got` fits a slot of type `expected` as it is, or
/// through a trait it implements (`try_trait_widen`).
///
/// @param got       the value's type.
/// @param expected  the slot's type.
/// @param typed     the module checking it, whose impls a trait slot needs.
export fits_or_implements :: fn(got: Type, expected: Type, typed: TypedProgram) -> bool =
    is_assignable(got, expected) || try_trait_widen(got, expected, typed)

// A type parameter is the traits its bound names : `x: T` with `T: Display` fits a
// `Display` slot, `T: Iterator<i32>` an `Iterator<i32>` one, as an impl's
// (`implements_trait_instance`).
bound_widens_into :: fn(param: TypeParamType, wanted: TraitType, typed: TypedProgram) -> bool {
    bound :: typed.resolved.type_param_bounds[param.symbol.id] ?? return false
    bound_args :: bounded_trait_args(bound, trait_key_of(wanted.symbol), typed) ?? return false
    if wanted.args.len() == 0 || bound_args.len() == 0 {
        return true
    }
    have :: with_trait_defaults(param, bound_args, wanted.symbol, typed)
    asked :: with_trait_defaults(param, wanted.args, wanted.symbol, typed)
    return struct_args_compatible(have, asked)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "toolchain/span"
import "vader/resolver/symbol"

// A minimal `Iterator<elem>` trait type — `try_array_to_iter` only reads
// `symbol.name` and `args`, so the other Symbol fields are placeholders.
iter_trait_for_test :: fn(elem: Type) -> Type {
    sym :: Symbol {
        .id = 0,
        .kind = .Trait,
        .name = "Iterator",
        .module = "std/core",
        .module_name = "std/core",
        .visibility = .Public,
        .defined_at = null,
    }
    return mk_trait(sym, [elem])
}

// A converted value numbered `id`.
value_for_test :: fn(id: usize) -> AST.Expr = AST.IntLitExpr {
    .span = empty_span(),
    .id = id,
    .value = 0,
}

// `T[] → Iterator<T>` is a real `.into()` coercion : `try_into` records the
// target type under the value's node id so the LSP can surface a `.into()`
// hint (the array-into-Iterator param case from the feature request).
@test
test_try_into_records_array_to_iter :: fn() -> void {
    typed :: empty_typed_program()
    arr :: mk_array(mk_primitive("i32"))
    iter :: iter_trait_for_test(mk_primitive("i32"))
    assert(try_into(arr, iter, typed, value_for_test(7)), "i32[] should coerce into Iterator<i32>")
    assert(typed.into_coercions[7] !is null, "coercion must be recorded under node id 7")
}

// A plain mismatch (no `Into` impl, no trait widen, not an array→iter) coerces
// to nothing and must leave the into-coercion table untouched — otherwise the
// LSP would paint a spurious `.into()` hint on a value that never coerces.
@test
test_try_into_no_coercion_records_nothing :: fn() -> void {
    typed :: empty_typed_program()
    assert(
        !try_into(mk_primitive("i32"), mk_primitive("string"), typed, value_for_test(9)),
        "i32 does not coerce into string",
    )
    assert(typed.into_coercions[9] is null, "no coercion recorded when none applies")
}
