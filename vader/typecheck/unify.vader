// vader/typecheck/unify — structural unification of `TypeParam` binders.
//
// Walks the shape of a parameter type against a concrete argument type
// and extracts the `TypeParam.symbol.id → concrete Type` bindings that
// make the param match. Consumed by generic fn dispatch in `call.vader`
// (and UFCS receiver re-unification in `field.vader`) to infer a call's
// type-args from its positional args.
//
// A `TraitType` param binds only against a value of that same trait :
// binding it from a concrete argument would need the impl registry,
// which this module does not see.

module "vader/typecheck"

import "std/collections"
import "std/iter"
import "std/math"
import "vader/types"

/// Whether `t` is the type of a free literal : an integer, a float or a `char` one,
/// which takes the type of the slot it fills.
///
/// @param t  any type.
export is_free_numeric :: fn(t: Type) -> bool {
    // @partial: only the three Free* literal variants are free numerics; every
    // other type (concrete or composite) is not.
    @partial match t {
        is FreeIntType -> { return true }
        is FreeCharType -> { return true }
        is FreeFloatType -> { return true }
        _ -> { return false }
    }
}

/// Walk `param_type` against `arg_type` and record any TypeParam
/// binding into `out`. The first binding wins. Matches a declaration's own
/// pattern (an impl's target, a UFCS first parameter) ; a call binds through
/// `unify_infer` instead.
unify_type_param :: fn(
    param_type: Type,
    arg_type: Type,
    out: MutableMap<i32, Type>,
) -> void {
    match param_type {
        is TypeParamType -> {
            // An unresolved argument carries no information (`bind_infer_var`).
            if type_contains_unresolved(arg_type) {
                return
            }
            existing :: out[param_type.symbol.id]
            if existing is null { out[param_type.symbol.id] = arg_type  return }
            if is_free_numeric(existing) && !is_free_numeric(arg_type) {
                out[param_type.symbol.id] = arg_type
            }
            return
        }
        is ArrayType -> {
            match arg_type {
                is ArrayType -> {
                    unify_type_param(param_type.element, arg_type.element, out)
                }
                _ -> {}
            }
            return
        }
        is TupleType -> {
            match arg_type {
                is TupleType -> {
                    if param_type.elements.len() == arg_type.elements.len() {
                        for i in 0..<param_type.elements.len() {
                            unify_type_param(
                                param_type.elements[i],
                                arg_type.elements[i],
                                out,
                            )
                        }
                    }
                }
                _ -> {}
            }
            return
        }
        is StructType -> {
            match arg_type {
                is StructType -> {
                    if param_type.symbol.id == arg_type.symbol.id {
                        unify_args(param_type.args, arg_type.args, out)
                    }
                }
                _ -> {}
            }
            return
        }
        is TraitType -> {
            match arg_type {
                is TraitType -> {
                    if param_type.symbol.id == arg_type.symbol.id {
                        unify_args(param_type.args, arg_type.args, out)
                    }
                }
                // An array argument satisfies an `Iterator<T>` parameter through
                // the blanket `T[] -> Iterator<T>` `into` coercion. That coercion
                // is applied later (`try_into`), but the element type must be
                // unified with `T` *here* or the type param stays unbound — the
                // callee then infers `Iterator<T>` (T3008 downstream) and the
                // generic body is never specialised. Bind `T = element`.
                is ArrayType -> {
                    element :: core_trait_arg(param_type, TRAIT_ITERATOR)
                    if element != null {
                        unify_type_param(element, arg_type.element, out)
                    }
                }
                _ -> {}
            }
            return
        }
        is FnType -> {
            match arg_type {
                is FnType -> {
                    n :: min(param_type.params.len(), arg_type.params.len())
                    for i in 0..<n {
                        unify_type_param(param_type.params[i], arg_type.params[i], out)
                    }
                    unify_type_param(param_type.return_type, arg_type.return_type, out)
                }
                _ -> {}
            }
            return
        }
        is UnionType -> {
            for pair in union_leftovers(param_type.variants, union_variants(arg_type) ?? [arg_type]) {
                unify_type_param(pair.pattern, pair.actual, out)
            }
            return
        }
        _ -> {}
    }
}

/// True when `t` carries an `UnresolvedType` anywhere in its tree — i.e. the
/// checker failed to work out part of it, so the type says nothing. Used by
/// `unify_type_param` to refuse a binding that would freeze a type-param at `?`.
type_contains_unresolved :: fn(t: Type) -> bool {
    // @partial: only these variants have inner types to walk ; every scalar /
    // primitive variant carries nothing unresolved.
    @partial match t {
        is UnresolvedType -> { return true }
        is ArrayType -> { return type_contains_unresolved(t.element) }
        is TupleType -> {
            for el in t.elements { if type_contains_unresolved(el) { return true } }
            return false
        }
        is StructType -> {
            for a in t.args { if type_contains_unresolved(a) { return true } }
            return false
        }
        is TraitType -> {
            for a in t.args { if type_contains_unresolved(a) { return true } }
            return false
        }
        is FnType -> {
            for p in t.params { if type_contains_unresolved(p) { return true } }
            return type_contains_unresolved(t.return_type)
        }
        is UnionType -> {
            for v in t.variants { if type_contains_unresolved(v) { return true } }
            return false
        }
        is DistinctType -> { return type_contains_unresolved(t.backing) }
        _ -> { return false }
    }
}

/// True if `t` contains at least one `TypeParam`, or an inference variable,
/// anywhere in its shape : a slot that still waits on a type parameter.
export type_contains_type_param :: fn(t: Type) -> bool {
    // @partial: only TypeParam and the composite variants can hold a type-param;
    // every scalar / primitive variant has no inner type → false.
    @partial match t {
        is TypeParamType | InferVar -> { return true }
        is ArrayType -> { return type_contains_type_param(t.element) }
        is TupleType -> {
            for el in t.elements { if type_contains_type_param(el) { return true } }
            return false
        }
        is StructType -> { return any_contains(t.args) }
        is TraitType -> { return any_contains(t.args) }
        is FnType -> {
            for p in t.params { if type_contains_type_param(p) { return true } }
            return type_contains_type_param(t.return_type)
        }
        is UnionType -> {
            for v in t.variants { if type_contains_type_param(v) { return true } }
            return false
        }
        _ -> { return false }
    }
}

// ---- helpers --------------------------------------------------------------

any_contains :: fn(ts: Type[]) -> bool {
    for t in ts { if type_contains_type_param(t) { return true } }
    return false
}

unify_args :: fn(p_args: Type[], a_args: Type[], out: MutableMap<i32, Type>) -> void {
    n :: min(p_args.len(), a_args.len())
    for i in 0..<n { unify_type_param(p_args[i], a_args[i], out) }
}

/// A variant of a union pattern left unmatched, and the argument type it unifies
/// with.
export UnionLeftover :: struct {
    pattern: Type
    actual:  Type
}

/// What is left to unify of a union pattern against a union argument, once the
/// variants they share are paired off. Shared by the typer (`unify_type_param`) and
/// the lowerer (`unify_params`) so the two bind a type parameter alike.
///
/// The shared variants go first so that `T | null` never binds `T = null`. A
/// pattern variant with no type parameter that the argument lacks binds nothing,
/// and is dropped rather than paired: the argument is narrower than the pattern
/// (`T | null` against a narrowed `i32`). A lone type parameter left over stands
/// for EVERY argument variant left — `T | null` against `i32 | string | null`
/// binds `T = i32 | string`. Several leftovers on both sides pair by position.
///
/// @param pattern  the pattern's variants.
/// @param actual   the argument's variants — a single one for an argument that is
///                 not a union (`union_variants(t) ?? [t]`).
/// @return         the pairs to unify, in pattern order.
export union_leftovers :: fn(pattern: Type[], actual: Type[]) -> UnionLeftover[] {
    used :: actual.len().filled(() -> false)
    left_pattern: Type[]: []
    for pv in pattern {
        idx :: find_unused_equal(actual, used, pv)
        if idx >= 0 {
            used[idx] = true
        } else if type_contains_type_param(pv) {
            left_pattern.push(pv)
        }
    }
    if left_pattern.len() == 0 {
        return []
    }
    left_actual: Type[]: []
    for i in 0..<actual.len() {
        if !used[i] {
            left_actual.push(actual[i])
        }
    }
    one_param :: left_pattern.len() == 1 && left_pattern[0] is TypeParamType | InferVar
    if one_param && left_actual.len() > 1 {
        return [UnionLeftover { .pattern = left_pattern[0], .actual = union_of(left_actual) }]
    }
    out: UnionLeftover[]: []
    for i in 0..<min(left_pattern.len(), left_actual.len()) {
        out.push(UnionLeftover { .pattern = left_pattern[i], .actual = left_actual[i] })
    }
    return out
}

/// Index of the first not-yet-used entry in `types` structurally equal to
/// `target`, or -1. Drives the "concrete first" union-variant pairing of
/// `union_leftovers`.
///
/// @param types   the candidate variants to scan.
/// @param used    parallel flags — entries already paired off are skipped.
/// @param target  the variant to find a structural match for.
/// @return        the matching index, or -1 when none is free + equal.
find_unused_equal :: fn(types: Type[], used: bool[], target: Type) -> i32 {
    for i in 0..<types.len() {
        if !used[i] && equals_type(types[i], target) { return i32(i) }
    }
    return i32(-1)
}

/// Walk `t` and replace each `TypeParam` whose symbol id appears in
/// `subst` with the bound concrete type. The `_map` suffix distinguishes
/// this fn from the `Substitution`-arg version exported by
/// `substitution.vader` — both share the same first-param type so the
/// resolver's UFCS dispatch can't tell them apart in an overload set.
export substitute_map :: fn(t: Type, subst: MutableMap<i32, Type>) -> Type {
    // @partial: only TypeParam and the composite variants can carry a binding to
    // substitute; every scalar / primitive variant is returned unchanged.
    @partial match t {
        is TypeParamType -> {
            repl :: subst[t.symbol.id] ?? return t
            return repl
        }
        is ArrayType -> { return mk_array(substitute_map(t.element, subst)) }
        is TupleType -> { return mk_tuple(substitute_each_map(t.elements, subst)) }
        is StructType -> { return mk_struct(t.symbol, substitute_each_map(t.args, subst)) }
        is TraitType -> { return TraitType { ...t, .args = substitute_each_map(t.args, subst) } }
        is FnType -> { return substitute_fn_map(t, subst) }
        is UnionType -> { return union_of(substitute_each_map(t.variants, subst)) }
        _ -> { return t }
    }
}

// ---- inference variables --------------------------------------------------

/// A fresh inference variable instantiating `tp` for one use.
///
/// @param typed  the module, which numbers the variables it mints.
/// @param tp     the declared parameter the variable stands for.
fresh_infer_var :: fn(typed: TypedProgram, tp: TypeParamType) -> InferVar {
    id :: typed.next_infer_id
    typed.next_infer_id = id + 1
    return InferVar { .id = id, .origin = tp.symbol }
}

/// Bind the inference variables of `pattern` so that it matches `actual`. A type
/// parameter in either is rigid : it binds nothing and is bound by nothing. The
/// first binding of a variable wins, save the refinements of `bind_infer_var`.
///
/// @param pattern    an instantiated signature, its quantified parameters turned
///                   into inference variables.
/// @param actual     the type the argument (or the result slot) has.
/// @param solutions  the bindings so far, by variable id ; extended in place.
/// @param held       the variables an explicit `<…>` fixed. Null holds none.
unify_infer :: fn(
    pattern: Type,
    actual: Type,
    solutions: MutableMap<i32, Type>,
    held: MutableSet<i32> | null = null,
) -> void {
    // @partial: only a variable binds, and only the composite variants nest one.
    @partial match pattern {
        is InferVar -> { bind_infer_var(pattern, actual, solutions, held) }
        is ArrayType -> {
            if actual is ArrayType {
                unify_infer(pattern.element, actual.element, solutions, held)
            }
        }
        is TupleType -> {
            if actual is TupleType && pattern.elements.len() == actual.elements.len() {
                for i in 0..<pattern.elements.len() {
                    unify_infer(pattern.elements[i], actual.elements[i], solutions, held)
                }
            }
        }
        is StructType -> {
            if actual is StructType && pattern.symbol.id == actual.symbol.id {
                unify_infer_each(pattern.args, actual.args, solutions, held)
            }
        }
        is TraitType -> {
            if actual is TraitType && pattern.symbol.id == actual.symbol.id {
                unify_infer_each(pattern.args, actual.args, solutions, held)
            } else if actual is ArrayType {
                // An array reaches an `Iterator<T>` parameter through the blanket
                // `T[] -> Iterator<T>` conversion : its element binds `T`.
                element :: core_trait_arg(pattern, TRAIT_ITERATOR)
                if element != null {
                    unify_infer(element, actual.element, solutions, held)
                }
            }
        }
        is FnType -> {
            if actual is FnType {
                unify_infer_each(pattern.params, actual.params, solutions, held)
                unify_infer(pattern.return_type, actual.return_type, solutions, held)
            }
        }
        is UnionType -> {
            for pair in union_leftovers(pattern.variants, union_variants(actual) ?? [actual]) {
                unify_infer(pair.pattern, pair.actual, solutions, held)
            }
        }
        _ -> {}
    }
}

unify_infer_each :: fn(
    patterns: Type[],
    actuals: Type[],
    solutions: MutableMap<i32, Type>,
    held: MutableSet<i32> | null,
) -> void {
    for i in 0..<min(patterns.len(), actuals.len()) {
        unify_infer(patterns[i], actuals[i], solutions, held)
    }
}

// Bind `v` to `actual`, unless the binding would say nothing or one already
// stands. An unresolved argument says nothing : bound to it, the variable would
// freeze at `?` and lock out the argument that knows, as a lambda checked before
// its siblings types (`zip_with(() -> [], (s: string) -> s.len())` types the first
// `?[]`, the second binds `T`). Nor does one that mentions `v` itself. A standing
// binding yields only to a concrete numeric over a free literal :
// `fold([1, 2, 3], 1, (a, b) -> a + b)` binds `U` to `{integer}` from `1`, then to
// the `i32` the lambda returns.
bind_infer_var :: fn(
    v: InferVar,
    actual: Type,
    solutions: MutableMap<i32, Type>,
    held: MutableSet<i32> | null,
) -> void {
    if type_contains_unresolved(actual) || mentions_infer_var(actual, v.id) {
        return
    }
    existing :: solutions[v.id]
    if existing == null {
        solutions[v.id] = actual
        return
    }
    if held != null && v.id in held {
        return
    }
    if is_free_numeric(existing) && !is_free_numeric(actual) {
        solutions[v.id] = actual
    }
}

/// Whether `t` mentions the inference variable `id`.
mentions_infer_var :: fn(t: Type, id: i32) -> bool = holds_infer_var(t, id)

/// Whether `t` mentions any inference variable.
type_contains_infer_var :: fn(t: Type) -> bool = holds_infer_var(t, ANY_INFER_VAR)

// Matches every variable in `holds_infer_var` : the ids start at 0.
ANY_INFER_VAR: i32: -1

// Whether `t` holds the variable `id`, or any variable for `ANY_INFER_VAR`. A walk
// written out rather than `any_type`, whose predicate would be a closure built on
// every argument of every generic call.
holds_infer_var :: fn(t: Type, id: i32) -> bool {
    // @partial: only a variable answers yes, and only the composite variants nest one.
    @partial match t {
        is InferVar     -> { return id == ANY_INFER_VAR || t.id == id }
        is ArrayType    -> { return holds_infer_var(t.element, id) }
        is TupleType    -> { return any_holds_infer_var(t.elements, id) }
        is StructType   -> { return any_holds_infer_var(t.args, id) }
        is TraitType    -> { return any_holds_infer_var(t.args, id) }
        is UnionType    -> { return any_holds_infer_var(t.variants, id) }
        is DistinctType -> { return holds_infer_var(t.backing, id) }
        is FnType       -> {
            return any_holds_infer_var(t.params, id) || holds_infer_var(t.return_type, id)
        }
        _ -> { return false }
    }
}

any_holds_infer_var :: fn(ts: Type[], id: i32) -> bool {
    for t in ts {
        if holds_infer_var(t, id) {
            return true
        }
    }
    return false
}

/// `t` with every solved inference variable replaced by its solution, followed
/// through ; an unsolved one is kept.
///
/// @param t          the type to resolve.
/// @param solutions  the bindings, by variable id.
zonk :: fn(t: Type, solutions: MutableMap<i32, Type>) -> Type {
    if !type_contains_infer_var(t) {
        return t
    }
    return zonk_in(t, solutions)
}

// @partial: only a variable resolves, and only the composite variants nest one.
zonk_in :: fn(t: Type, solutions: MutableMap<i32, Type>) -> Type = @partial match t {
    is InferVar   -> zonk_var(t, solutions)
    is ArrayType  -> mk_array(zonk_in(t.element, solutions))
    is TupleType  -> mk_tuple(zonk_each(t.elements, solutions))
    is StructType -> mk_struct(t.symbol, zonk_each(t.args, solutions))
    is TraitType  -> TraitType { ...t, .args = zonk_each(t.args, solutions) }
    is FnType     -> FnType {
        ...t,
        .params = zonk_each(t.params, solutions),
        .return_type = zonk_in(t.return_type, solutions),
    }
    is UnionType  -> union_of(zonk_each(t.variants, solutions))
    _             -> t
}

zonk_var :: fn(v: InferVar, solutions: MutableMap<i32, Type>) -> Type {
    solved :: solutions[v.id] ?? return v
    return zonk_in(solved, solutions)
}

zonk_each :: fn(types: Type[], solutions: MutableMap<i32, Type>) -> Type[] {
    out: Type[]: []
    for t in types {
        out.push(zonk_in(t, solutions))
    }
    return out
}

/// `t` with every type parameter replaced by a wildcard — the shape to match an
/// argument against when nothing has bound the parameters yet : picking an
/// overload, fitting a UFCS receiver, inferring a generic struct literal's
/// arguments from its fields. `is_assignable` holds a type parameter opaque, so
/// those questions ask it about this shape instead of the declared one.
///
/// @param t  a type from a generic signature or declaration.
/// @return   `t`, its type parameters turned into `TY_UNRESOLVED`.
erase_type_params :: fn(t: Type) -> Type =
    if type_contains_type_param(t) { erase_params_in(t) } else { t }

// The rebuilt shape is only ever an `is_assignable` target, so a union keeps its
// variants as they are (`mk_union`) rather than being re-normalised.
// @partial: only TypeParam and the composite variants can hold a type-param; every
// scalar / primitive variant is returned unchanged.
erase_params_in :: fn(t: Type) -> Type = @partial match t {
    is TypeParamType -> TY_UNRESOLVED
    is InferVar      -> TY_UNRESOLVED
    is ArrayType     -> mk_array(erase_params_in(t.element))
    is TupleType     -> mk_tuple(erase_each(t.elements))
    is StructType    -> mk_struct(t.symbol, erase_each(t.args))
    is TraitType     -> TraitType { ...t, .args = erase_each(t.args) }
    is FnType        -> mk_fn(erase_each(t.params), erase_params_in(t.return_type))
    is UnionType     -> mk_union(erase_each(t.variants))
    _                -> t
}

// `f` with every bound type parameter replaced — `substitute_map` on a fn type,
// typed as one: the instance's signature.
substitute_fn_map :: fn(f: FnType, subst: MutableMap<i32, Type>) -> FnType =
    mk_fn(
        substitute_each_map(f.params, subst),
        substitute_map(f.return_type, subst),
        unbound_quantifier(f.type_params, subst),
    )

// The parameters of `quantifier` that `subst` leaves unbound.
unbound_quantifier :: fn(
    quantifier: TypeParamType[], subst: MutableMap<i32, Type>,
) -> TypeParamType[] {
    if quantifier.len() == 0 || !quantifier.any_match((tp) -> subst[tp.symbol.id] != null) {
        return quantifier
    }
    out: TypeParamType[]: []
    for tp in quantifier {
        if subst[tp.symbol.id] == null {
            out.push(tp)
        }
    }
    return out
}

erase_each :: fn(types: Type[]) -> Type[] {
    out: Type[]: []
    for t in types {
        out.push(erase_params_in(t))
    }
    return out
}

substitute_each_map :: fn(types: Type[], subst: MutableMap<i32, Type>) -> Type[] {
    out: Type[]: []
    for t in types { out.push(substitute_map(t, subst)) }
    return out
}

// ---- tests ----------------------------------------------------------------

import "std/string"
import "std/testing"

display_leftovers :: fn(pairs: UnionLeftover[]) -> string {
    parts: string[]: []
    for p in pairs {
        parts.push("${display_type(p.pattern)} <- ${display_type(p.actual)}")
    }
    return parts.join(", ")
}

@test
test_union_leftovers_param_takes_every_other_variant :: fn() -> void {
    t :: mk_type_param(fresh_type_param(1, "T"))
    pairs :: union_leftovers([t, TY_NULL], [TY_I32, TY_STRING, TY_NULL])
    assert_eq(display_leftovers(pairs), "T <- i32 | string")
}

@test
test_union_leftovers_drops_a_concrete_variant_the_argument_lacks :: fn() -> void {
    t :: mk_type_param(fresh_type_param(1, "T"))
    assert_eq(display_leftovers(union_leftovers([t, TY_NULL], [TY_I32])), "T <- i32")
}

@test
test_union_leftovers_pairs_several_params_by_position :: fn() -> void {
    t :: mk_type_param(fresh_type_param(1, "T"))
    u :: mk_type_param(fresh_type_param(2, "U"))
    pairs :: union_leftovers([t, u, TY_NULL], [TY_I32, TY_STRING, TY_NULL])
    assert_eq(display_leftovers(pairs), "T <- i32, U <- string")
}

@test
test_unify_infer_keeps_a_held_binding :: fn() -> void {
    v :: InferVar { .id = 0, .origin = fresh_type_param(1, "T") }
    solutions :: MutableMap<i32, Type> {}
    held :: MutableSet<i32> {}
    held.add(0)
    solutions[0] = mk_array(TY_I64)
    unify_infer(v, mk_array(TY_I32), solutions, held)
    assert_eq(display_type(solutions[0] ?? TY_UNRESOLVED), "i64[]")
}

@test
test_unify_infer_leaves_a_rigid_parameter_unbound :: fn() -> void {
    rigid :: mk_type_param(fresh_type_param(1, "T"))
    solutions :: MutableMap<i32, Type> {}
    unify_infer(rigid, TY_I32, solutions)
    assert(solutions.is_empty(), "a type parameter binds nothing")
}

@test
test_zonk_follows_a_chain_of_solutions :: fn() -> void {
    a :: InferVar { .id = 0, .origin = fresh_type_param(1, "A") }
    b :: InferVar { .id = 1, .origin = fresh_type_param(2, "B") }
    solutions :: MutableMap<i32, Type> {}
    solutions[0] = mk_array(b)
    solutions[1] = TY_I32
    assert_eq(display_type(zonk(mk_array(a), solutions)), "i32[][]")
}
