// vader/typecheck/type_expr — lower a TypeExpr (AST.Expr in type position)
// to a `Type`.
//
// Since `TypeExpr` aliases
// `Expr` after Layer 1.D, the parser produces both type-shaped and value-
// shaped nodes from the same grammar — dispatch happens on `expr.kind`.
// Resolves named types via the resolver's idents map, builds Primitive /
// Struct / Trait / TypeParam / Union / Fn / Array / Tuple. Unresolvable
// shapes surface T3002 ("expected an expression of a known type").
//
// Resolves const-as-type-alias bindings (`Maybe :: i32 | null`) through
// the resolver's `alias_types` table and qualified `namespace.Type` refs
// through the per-namespace exports table (`namespace_member_type`).
//
// Still trimmed :
//   - Struct / Trait / Enum return fresh constructor calls — they don't
//     route through `decl_types` for a canonical shared instance.

module "vader/typecheck"

import "std/collections"
import "std/math"
import "vader/diagnostics"
import "vader/integer"
import "vader/resolver"
import "vader/resolver/symbol"
AST :: import "toolchain/ast"
import "vader/types"

/// Lower `expr` from type position to a `Type`. Unresolvable shapes
/// surface T3002 and return `TY_UNRESOLVED` ; downstream passes treat
/// unresolved as compatible with anything to dodge cascading errors.
export type_from_expr :: fn(
    expr: AST.Expr, resolved: ResolvedModule, diags: Diagnostic[],
) -> Type {
    // @partial: only the type-shaped expr kinds below denote a type; every other
    // (value-position) Expr is illegal in a type slot → T3002, handled by `_`.
    @partial match expr {
        is AST.IdentExpr -> {
            if names_int_base(expr, resolved) {
                diags.push(typecheck_error(.IntIsNoValueType, expr.span,
                    "write a range over it: `Int in 0..=255`"))
                return TY_UNRESOLVED
            }
            ty :: lower_ident(expr, resolved)
            // A bound ident that degrades to unresolved is a VALUE symbol (const /
            // fn / local) used in a type slot — e.g. `b: SomeValueConst`, or a
            // `Name :: [value, i32]` bracket that stayed a value const. Surface
            // T3002 rather than letting the `?` reach emit (`no field _N on ?`).
            // An unbound ident is already the resolver's R2006, and a primitive
            // never degrades — so gate on "resolved to a symbol, not a primitive".
            if ty is UnresolvedType {
                if primitive_from_name(expr.name) is null {
                    if resolved.idents[expr.span.hash()] !is null {
                        diags.push(typecheck_error(.ExpectedKnownType, expr.span,
                            "`${expr.name}` is not a type"))
                    }
                }
            }
            return ty
        }
        is AST.GenericInstExpr -> { return lower_generic_inst(expr, resolved, diags) }
        // `Iterator(i32)` / `Pair<K, V>` parsed as CallExpr in type
        // position : lower the callee to a Type and apply its args.
        is AST.CallExpr -> { return lower_call_in_type_position(expr, resolved, diags) }
        is AST.BinaryExpr -> { return lower_binary(expr, resolved, diags) }
        is AST.RangeExpr -> { return range_type(expr, diags) }
        is AST.FnTypeExpr -> {
            params :: written_type_args(expr.params, resolved, diags)
            return mk_fn(params, opt_or_void(expr.return_type, resolved, diags))
        }
        is AST.ArrayTypeExpr -> {
            return mk_array(type_from_expr(expr.element, resolved, diags))
        }
        is AST.NullLitExpr -> { return TY_NULL }
        is AST.SeqLitExpr -> {
            elements: Type[]: []
            for el in expr.elements { elements.push(type_from_expr(el, resolved, diags)) }
            return mk_tuple(elements)
        }
        // `P.Decl` — namespace field access in type position.
        // `resolved.idents` is start-only-keyed, so a lookup on the
        // FieldExpr's span would collide with the inner IdentExpr's
        // key and return the wrong symbol ; the namespace-member
        // table sidesteps that collision.
        is AST.FieldExpr -> { return namespace_member_type(expr, resolved, diags) }
        _ -> {
            diags.push(typecheck_error(.ExpectedKnownType, expr.span,
                "value-position expression not allowed in a type slot"))
            return TY_UNRESOLVED
        }
    }
}

/// Resolve `P.Decl` in type position via the per-namespace exports
/// side-table on `ResolvedModule`. Returns `TY_UNRESOLVED` when the
/// target isn't a namespace ImportBinding or the field isn't exported.
/// @error R2008 when `P.Decl` names a PRIVATE (non-`export`) type of the
///        target module — visibility enforcement, mirroring the
///        destructured-import check in `wire.vader`.
namespace_member_type :: fn(e: AST.FieldExpr, resolved: ResolvedModule, diags: Diagnostic[]) -> Type {
    if !(e.target is AST.IdentExpr) { return TY_UNRESOLVED }
    target_sym :: resolved.idents[e.target.span.hash()] ?? return TY_UNRESOLVED
    members :: resolved.namespace_member_types[target_sym.id] ?? return TY_UNRESOLVED
    ty :: members[e.field]
    if ty is null {
        // A PRIVATE member is R2008 ; a genuinely ABSENT one is R2007, the same
        // answer the unqualified form gives. The miss must be reported : an
        // unresolved type in `is Alias.Nope` interns as `ref _`, which matches
        // every erased value under the VM.
        if !namespace_private_member_reported(target_sym.id, e.field, e.field_span, resolved, diags) {
            diags.push(resolver_error(.UnresolvedTypeName, e.field_span, "`${e.field}`"))
        }
        return TY_UNRESOLVED
    }
    return ty
}

/// Fire R2008 when `field` names a PRIVATE member of the namespace binding
/// `binding_id` points at — so `P.private` is rejected (matching the
/// destructured-import check in `wire.vader`) instead of silently degrading to
/// unresolved. Returns true when it fired. Shared by the value path
/// (`field.vader::try_namespace_field`) and the type path above.
namespace_private_member_reported :: fn(
    binding_id: i32, field: string, span: Span,
    resolved: ResolvedModule, diags: Diagnostic[],
) -> bool {
    priv :: resolved.namespace_private_members[binding_id] ?? return false
    if priv[field] is null { return false }
    diags.push(resolver_error(.SymbolNotExported, span, "`${field}`"))
    return true
}

lower_ident :: fn(e: AST.IdentExpr, resolved: ResolvedModule) -> Type {
    // Builtin name takes precedence — even when the resolver also bound the
    // ident (e.g. user-shadowed `i32` would still resolve to the primitive).
    builtin :: primitive_from_name(e.name)
    if builtin !is null {
        return builtin
    }
    bound :: resolved.idents[e.span.hash()]
    if !(bound is null) { return resolve_named_type(bound, resolved) }
    return TY_UNRESOLVED
}

/// Map a symbol to its value-as-type form : follow ImportBinding
/// redirects, expand TypeAlias bodies, then fall back to a fresh
/// constructor via `type_from_symbol`. Shared by `lower_ident`'s
/// `idents` lookup and `lower_generic_inst`'s callee resolution.
resolve_named_type :: fn(sym: Symbol, resolved: ResolvedModule) -> Type {
    redirected :: redirect_import(sym, resolved)
    aliased :: resolved.alias_types[redirected.id]
    if !(aliased is null) { return aliased }
    return type_from_symbol(redirected, [])
}

// Substitute an alias's type-params with the call-site's args.
// `Maybe<T> :: T | null` instantiated as `Maybe(i32)` walks the
// alias body and replaces every `TypeParam<T>` with `i32`.
substitute_alias_args :: fn(t: Type, params: TypeParamType[], args: Type[]) -> Type {
    bindings :: MutableMap<i32, Type> {}
    for i in 0..<min(params.len(), args.len()) {
        bindings[params[i].symbol.id] = args[i]
    }
    return substitute_map(t, bindings)
}

// `target` instantiated with `args` : an alias's body with its parameters
// substituted, any other type built from its symbol.
instantiate_named :: fn(target: Symbol, args: Type[], resolved: ResolvedModule) -> Type {
    aliased :: resolved.alias_types[target.id] ?? return type_from_symbol(target, args)
    params :: resolved.alias_params[target.id] ?? return aliased
    return substitute_alias_args(aliased, params, args)
}

// Follow an `ImportBinding` symbol to its concrete exported
// counterpart via `resolved.imports_to`. Other symbol kinds pass
// through unchanged.
redirect_import :: fn(sym: Symbol, resolved: ResolvedModule) -> Symbol {
    if sym.kind != .ImportBinding { return sym }
    target :: resolved.imports_to[sym.id]
    match target {
        is null -> { return sym }
        is Symbol -> { return target }
    }
}


lower_call_in_type_position :: fn(
    e: AST.CallExpr, resolved: ResolvedModule, diags: Diagnostic[],
) -> Type {
    args: Type[]: []
    for a in e.args { args.push(type_from_expr(a.value, resolved, diags)) }
    if e.callee is AST.IdentExpr as id {
        target :: lookup_type_name(id, resolved) ?? return TY_UNRESOLVED
        return instantiate_named(target, args, resolved)
    }
    return TY_UNRESOLVED
}

// Written type arguments: a generic instance's, an impl clause's trait arguments.
written_type_args :: fn(
    written: AST.TypeExpr[], resolved: ResolvedModule, diags: Diagnostic[],
) -> Type[] {
    out: Type[]: []
    for a in written {
        out.push(type_from_expr(a, resolved, diags))
    }
    return out
}

lower_generic_inst :: fn(
    e: AST.GenericInstExpr, resolved: ResolvedModule, diags: Diagnostic[],
) -> Type {
    args :: written_type_args(e.type_args, resolved, diags)
    if e.callee is AST.IdentExpr as id {
        target :: lookup_type_name(id, resolved) ?? return TY_UNRESOLVED
        return instantiate_named(target, args, resolved)
    }
    return TY_UNRESOLVED
}

/// Resolve a type-position ident to its Symbol via the resolver's span-keyed
/// `idents` table (authoritative — the by-name / core fallbacks were removed
/// once `idents` covered every type-position ref, see the symbol-id-tracking
/// chantier). Returns `null` when the span isn't bound.
lookup_type_name :: fn(id: AST.IdentExpr, resolved: ResolvedModule) -> Symbol | null {
    bound :: resolved.idents[id.span.hash()]
    if !(bound is null) { return redirect_import(bound, resolved) }
    return null
}

lower_binary :: fn(
    e: AST.BinaryExpr, resolved: ResolvedModule, diags: Diagnostic[],
) -> Type {
    if e.op == .In {
        return range_over_int(e, resolved, diags)
    }
    if u8(e.op) != u8(AST.BinaryOp.BitOr) {
        diags.push(typecheck_error(.ExpectedKnownType, e.span,
            "binary op not allowed in type position"))
        return TY_UNRESOLVED
    }
    variants: Type[]: []
    for v in AST.collect_bitor_variants(e) {
        variants.push(type_from_expr(v, resolved, diags))
    }
    return union_of(variants)
}

// `Int in lo..=hi` : the range over the abstract integer, the only base a range
// is written over today.
range_over_int :: fn(e: AST.BinaryExpr, resolved: ResolvedModule, diags: Diagnostic[]) -> Type {
    if !names_int_base(e.left, resolved) {
        diags.push(typecheck_error(.MalformedRangeType, e.left.span,
            "a range is written over `Int`: `Int in 0..=255`"))
        return TY_UNRESOLVED
    }
    if e.right !is AST.RangeExpr {
        diags.push(typecheck_error(.MalformedRangeType, e.right.span,
            "`Int in` takes a range: `Int in 0..=255`"))
        return TY_UNRESOLVED
    }
    return range_type(e.right, diags)
}

// Whether `e` names the builtin `Int`, the base of a range type.
names_int_base :: fn(e: AST.Expr, resolved: ResolvedModule) -> bool {
    if e !is AST.IdentExpr || e.name != INT_BASE_NAME {
        return false
    }
    sym :: resolved.idents[e.span.hash()] ?? return false
    return sym.kind == .BuiltinType && sym.name == INT_BASE_NAME
}

// The range type `lo..=hi` or `lo..<hi` : its bounds integer literals within
// `i64`, the least first.
range_type :: fn(e: AST.RangeExpr, diags: Diagnostic[]) -> Type {
    lo :: range_bound(e.lower, diags) ?? return TY_UNRESOLVED
    written_hi :: range_bound(e.upper, diags) ?? return TY_UNRESOLVED
    hi :: greatest_below(written_hi, e.inclusive)
    if hi == null || lo > hi {
        diags.push(typecheck_error(.MalformedRangeType, e.span, "the range holds no integer"))
        return TY_UNRESOLVED
    }
    return RangeType { .bounds = interval(lo, hi) }
}

// The greatest integer of a range ending at `end` ; null for one ending below
// every `i64` (`..<i64.min`).
greatest_below :: fn(end: i64, inclusive: bool) -> i64 | null {
    if inclusive {
        return end
    }
    if end == I64_MIN {
        return null
    }
    return end - 1
}

// The value of a range type's bound `e`, an integer literal within `i64`.
range_bound :: fn(e: AST.Expr, diags: Diagnostic[]) -> i64 | null {
    if e !is AST.IntLitExpr {
        diags.push(typecheck_error(.MalformedRangeType, e.span, "a bound is an integer literal"))
        return null
    }
    if !int_fits(e.value, e.negative, "i64") {
        diags.push(typecheck_error(.MalformedRangeType, e.span,
            "`${AST.int_literal_text(e)}` is past `i64`"))
        return null
    }
    return AST.int_literal_value(e)
}

// Whether the integer literal `e`, its sign as written, is a value of the range `r`.
literal_in_range :: fn(e: AST.IntLitExpr, r: RangeType) -> bool {
    value :: int_literal_i64(e) ?? return false
    return interval_within(interval(value, value), r.bounds)
}

/// The value of the integer literal `e`, its sign as written ; null for any other
/// expression, and for a literal past `i64`.
int_literal_i64 :: fn(e: AST.Expr) -> i64 | null {
    if e !is AST.IntLitExpr || !int_fits(e.value, e.negative, "i64") {
        return null
    }
    return AST.int_literal_value(e)
}

opt_or_void :: fn(
    ret: AST.TypeExpr | null, resolved: ResolvedModule, diags: Diagnostic[],
) -> Type {
    if ret == null { return TY_VOID }
    return type_from_expr(ret, resolved, diags)
}

/// Whether a value of type `t` has no interior a function could change: a
/// primitive (a string included), an enum, a function value. A union answers yes
/// only when no variant has an interior.
///
/// @param t  the value's type.
export is_value_only_type :: fn(t: Type) -> bool {
    if t is UnionType {
        for v in t.variants {
            if !is_value_only_type(v) { return false }
        }
        return true
    }
    return t is PrimitiveType | EnumType | FnType | NeverType
}

/// Map a resolved symbol to the type it names, built fresh at each call.
///
/// @param sym   the resolved symbol.
/// @param args  the type arguments written after it.
/// @return      unresolved when the symbol names a value, not a type ; for an
///              enum or a type alias, a `StructType` standing for its name, which
///              the declaration's own type replaces.
type_from_symbol :: fn(sym: Symbol, args: Type[]) -> Type {
    // @partial: only the type-introducing kinds below map to a Type; every other
    // SymbolKind (Fn, Local, Param, …) names a value, not a type → unresolved.
    @partial match sym.kind {
        .BuiltinType -> {
            builtin :: primitive_from_name(sym.name) ?? return TY_UNRESOLVED
            return builtin
        }
        .Struct    -> { return mk_struct(sym, args) }
        .Trait     -> { return mk_trait(sym, args) }
        .TypeParam -> { return mk_type_param(sym) }
        .Enum      -> { return mk_struct(sym, args) }   // placeholder until enum_pass plumbs declTypes
        // TypeAlias / Const-as-type-alias fall through to a marker
        // StructType so display_type renders the alias name. Proper
        // expansion needs decl_types (threaded via the typechecker).
        .TypeAlias -> { return mk_struct(sym, args) }
        _          -> { return TY_UNRESOLVED }
    }
}


/// Map a builtin type name to a Type, or null when the name isn't a
/// primitive (caller falls back to symbol-driven resolution). Covers :
///   - canonical primitives — every `is_primitive_name`
///   - `type` / `Self` — dedicated singletons (not Primitive)
///   - friendly aliases — `int` / `long` / `float` / `double` / `byte`
export primitive_from_name :: fn(name: string) -> Type | null {
    if is_primitive_name(name) { return mk_primitive(name) }
    if name == "type" { return TY_TYPE }
    if name == "Self" { return TY_SELF }
    canonical :: resolve_primitive_alias(name)
    if canonical != name { return mk_primitive(canonical) }
    return null
}

/// Whether `fd` takes a receiver — its first parameter is `self`. A trait or impl
/// member without one is STATIC : called on a type (`T.zero()`), never on a value.
///
/// @param fd  a trait or impl member.
export has_self_param :: fn(fd: AST.FnDecl) -> bool =
    fd.params.len() > 0 && fd.params[0].name == "self"

/// Index of `fd`'s first parameter past its receiver : 1 when it takes `self`, 0
/// for a static member.
receiver_count :: fn(fd: AST.FnDecl) -> usize = if has_self_param(fd) { 1 } else { 0 }

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "vader/parser"
import "toolchain/span"

resolve_test_module :: fn(src: string) -> ResolvedModule {
    parsed :: parse_source(src, "t.vader")
    factory :: SymbolFactory {}
    return resolve_module(parsed.program, "t", factory)
}

// Test helper : parse `src`, resolve, then lower the first parameter's
// type annotation. The 3 ArrayType / Union / FnType tests share the same
// scaffolding ; this collapses each to a single `assert_eq` call.
lower_first_param_type :: fn(src: string) -> string {
    rm :: resolve_test_module(src)
    parsed :: parse_source(src, "t.vader")
    fn_decl :: parsed.program.decls[0]
    if fn_decl is AST.FnDecl {
        ty :: fn_decl.params[0].ty ?? return "<no annotation>"
        diags: Diagnostic[]: []
        return display_type(type_from_expr(ty, rm, diags))
    }
    return "<not a FnDecl>"
}

@test
test_primitive_from_name_recognises_canonical :: fn() -> void {
    match primitive_from_name("i32") as p {
        is PrimitiveType -> { assert_eq(p.name, "i32") }
        _                -> { assert(false, "i32 should be primitive") }
    }
    match primitive_from_name("string") as p {
        is PrimitiveType -> { assert_eq(p.name, "string") }
        _                -> { assert(false, "string should be primitive") }
    }
}

@test
test_primitive_from_name_recognises_aliases :: fn() -> void {
    match primitive_from_name("int") as p {
        is PrimitiveType -> { assert_eq(p.name, "i32") }
        _                -> { assert(false, "int aliases i32") }
    }
    match primitive_from_name("byte") as p {
        is PrimitiveType -> { assert_eq(p.name, "u8") }
        _                -> { assert(false, "byte aliases u8") }
    }
}

@test
test_primitive_from_name_returns_null_for_user_types :: fn() -> void {
    if primitive_from_name("MyStruct") !is null {
        assert(false, "user types should not be primitives")
    }
}

@test
test_array_type_expr_lowers_to_array :: fn() -> void {
    assert_eq(lower_first_param_type("f :: fn(x: i32[]) -> void {}"), "i32[]")
}

@test
test_union_lowers_to_union_type :: fn() -> void {
    // union_of sorts by display ; i32 < string lex.
    assert_eq(lower_first_param_type("f :: fn(x: i32 | string) -> void {}"), "i32 | string")
}

@test
test_fn_type_expr_lowers_to_fn :: fn() -> void {
    assert_eq(lower_first_param_type("f :: fn(cb: fn(i32) -> bool) -> void {}"), "fn(i32) -> bool")
}


@test
test_value_position_expr_emits_T3002 :: fn() -> void {
    // Synthesise a literal in a type slot via the AST — there's no parser
    // path that puts an IntLitExpr in a type position, so build one by hand.
    span :: Span {
        .start = Position { .file = "t", .offset = 0, .line = 1, .column = 1 },
        .end   = Position { .file = "t", .offset = 1, .line = 1, .column = 2 },
    }
    int_lit :: AST.IntLitExpr {
        .span = span,
        .id = AST.UNASSIGNED_NODE_ID,
        .value = 42,
    }
    rm :: resolve_test_module("")
    diags: Diagnostic[]: []
    type_from_expr(int_lit, rm, diags)
    assert_eq(diags.len(), 1)
    assert_eq(diags[0].code.id, "T3002")
}

@test
test_value_const_in_type_position_emits_T3002 :: fn() -> void {
    // A value const (`PI`) named in a type slot resolves to a non-type symbol —
    // it must surface T3002, not degrade to `?` and reach emit.
    src :: "PI :: 3\nuse :: fn(x: PI) -> void {}"
    rm :: resolve_test_module(src)
    parsed :: parse_source(src, "t.vader")
    diags: Diagnostic[]: []
    for decl in parsed.program.decls {
        if decl is AST.FnDecl {
            pty :: decl.params[0].ty
            if pty !is null { type_from_expr(pty, rm, diags) }
        }
    }
    found := false
    for d in diags { if d.code.id == "T3002" { found = true } }
    assert(found, "expected T3002 for a value const used as a type")
}
