// vader/typecheck/field — FieldExpr inference (`obj.f`).
//
// `infer_field` recursively checks the target, then runs a priority-ordered
// chain of `try_*` dispatchers and returns the first non-null result :
//   - namespace-import field access (`mod.foo`),
//   - array methods ; impl-method / free-fn / trait-method UFCS dispatch ;
//     bounded-TypeParam trait dispatch ; an enum's built-in `Equals`,
//   - tuple positional index ; discriminated-union common-field access ;
//     enum-variant dot access (`Color.Red`),
//   - struct field lookup (the terminal fallback), with generic-arg
//     substitution so a field typed `T` resolves to the receiver's
//     concrete arg (`substitute_struct_args`).
// `resolve_struct_field` emits T3009 (missing field) / T3008 (non-struct
// target) when nothing matches.

module "vader/typecheck"

import "std/collections"
import "std/iter"
import "std/math"
import "std/string"
AST :: import "toolchain/ast"
import "vader/diagnostics"
import "vader/resolver"
import "vader/resolver/symbol"
import "vader/types"

/// Type-check a `FieldExpr`. Chains the per-target-shape attempts in
/// priority order ; each `try_*` returns `Type | null` (null = "not
/// my case"). `try_struct_field` is the terminal fallback that emits
/// T3008/T3009 when nothing matches.
infer_field :: fn(
    e: AST.FieldExpr,
    expected: Type | null,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type {
    // Namespace-import field access — `mod.foo` where `mod` is an
    // import binding. Runs before the recursive target check.
    ns_lookup :: try_namespace_field(e, typed, diags)
    if ns_lookup !is null {
        return ns_lookup
    }
    target_ty :: check_expr(e.target, null, typed, diags)
    if target_ty is UnresolvedType {
        return TY_UNRESOLVED
    }
    static_member :: try_static_member(e, target_ty, typed, diags)
    if static_member !is null {
        return static_member
    }
    // Built-in array methods (`len`/`push`/…) resolve as members of the
    // `@intrinsic T[] implements ArrayOps` blanket (std/core/array.vader), through
    // `try_impl_method_ufcs`'s `[]`-keyed lookup + `substitute_array_element`.
    candidate:= try_impl_method_ufcs(target_ty, e, typed, diags)
    if candidate !is null {
        return candidate
    }
    // Bounded TypeParam dispatch runs BEFORE free-fn UFCS : a free fn whose first
    // param is a bare `T` fits any receiver, and would otherwise hijack the
    // dispatch instead of routing through the type-param's trait bound.
    candidate = try_typeparam_bound_method(target_ty, e, typed, diags)
    if candidate !is null {
        return candidate
    }
    candidate = try_builtin_equals_method(target_ty, e, typed)
    if candidate !is null {
        return candidate
    }
    candidate = try_free_fn_ufcs_dispatch(target_ty, e, typed, diags)
    if candidate !is null {
        repin_free_ufcs_receiver(e, typed, diags)
        return candidate
    }
    candidate = try_dispatched_method(target_ty, e, typed, diags)
    if candidate !is null {
        return candidate
    }
    candidate = try_default_trait_method_dispatch(target_ty, e, typed)
    if candidate !is null {
        return candidate
    }
    // A field from here on : calling it calls the value it holds.
    note_callee(typed, e, FN_VALUE_CALLEE)
    candidate = try_tuple_index_dispatch(target_ty, e, diags)
    if candidate !is null {
        return candidate
    }
    candidate = try_union_common_field_dispatch(target_ty, e, typed, diags)
    if candidate !is null {
        return candidate
    }
    candidate = try_enum_variant_dispatch(target_ty, e, expected, typed, diags)
    if candidate !is null {
        return candidate
    }
    return resolve_struct_field(target_ty, e, typed, diags)
}

// ---- per-target-shape dispatch fns ---------------------------------------
//
// Each `try_*` returns null when the target_ty kind doesn't match its
// shape, or when the shape matches but the lookup yielded nothing.
// Keep the cascade split : folded back into `infer_field`, it compiles
// to one oversized C function.

// `x.method()` where `<x-type> implements <Trait> { method :: ... }`.
// Indexed by orchestrate.vader at impl-load time (`impl_candidates`). A member
// several impls of one trait offer (`Add<f64>`, `Add<Vec2>`) is left to the call,
// which picks it by its arguments (`pick_member_overload`).
try_impl_method_ufcs :: fn(
    target_ty: Type,
    e: AST.FieldExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type | null {
    // A free numeric literal receiver (`42.to_string()`) carries no impl methods
    // of its own — every impl is keyed on the concrete default (`i32`/`f64`/`char`,
    // e.g. `i32 implements Display`). Default the free type before building the
    // lookup key so a literal resolves the same impl a pinned variable (`x :: 42`)
    // would. `default_if_free` is the identity on concrete types, so concrete
    // receivers are unaffected.
    key_ty :: default_if_free(target_ty)
    candidates :: receiver_impl_members(key_ty, e.field, typed)
    if candidates.len() == 0 {
        return null
    }
    // Members of several traits are ambiguous whatever the call (`check_trait_ambiguity`).
    if candidates.len() > 1 && of_one_trait(candidates) {
        // A body of one of these impls reaches its own impl's member.
        for m in candidates {
            if m.impl_key == typed.enclosing_impl {
                return settle_impl_member(m, e, target_ty, typed, diags)
            }
        }
        if typed.callee_field_id != e.id {
            sigs: Type[]: []
            for m in candidates {
                sigs.push(m.ty)
            }
            hint :: "are offered ; call it so its arguments pick one"
            diags.push(member_ambiguity_error(e, sigs, hint))
            return TY_UNRESOLVED
        }
        typed.overloaded_members[e.id] = candidates
        return impl_member_type(candidates[0], target_ty, typed)
    }
    return settle_impl_member(candidates[0], e, target_ty, typed, diags)
}

// Whether `members` all come from impls of one trait.
of_one_trait :: fn(members: ImplMethod[]) -> bool {
    for m in members {
        if m.trait_key != members[0].trait_key {
            return false
        }
    }
    return true
}

// The members named `field` the impls covering `key_ty` offer. An array-backed
// distinct newtype (`BigInt :: i32[]`) takes the array's : its base name is the
// newtype's, not `[]`, so `bigint.push(x)` forwards to `T[] implements ArrayOps`.
receiver_impl_members :: fn(key_ty: Type, field: string, typed: TypedProgram) -> ImplMethod[] {
    suffix :: "::${field}"
    own :: impl_candidates(typed, key_ty, suffix)
    if own.len() > 0 || array_backing(key_ty) !is ArrayType {
        return own
    }
    found :: typed.impl_tables.impl_methods["[]${suffix}"] ?? return own
    return found
}

/// The member `chosen` a call `e` reaches on `target_ty`, typed for that receiver and
/// checked as the call's : a static member, a trait ambiguity, the bounds of a
/// generic impl. Records it for tooling.
///
/// @param chosen     the impl member the call goes to.
/// @param e          the call's callee.
/// @param target_ty  the receiver's type.
/// @return           the member's signature without its receiver.
settle_impl_member :: fn(
    chosen: ImplMethod,
    e: AST.FieldExpr,
    target_ty: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type {
    if rejects_static_member(chosen.decl, e, typed, diags) {
        return TY_UNRESOLVED
    }
    check_trait_ambiguity(e, target_ty, typed, diags)
    typed.chosen_impl_methods[e.id] = chosen
    note_callee(typed, e, member_callee(chosen.decl, target_ty))
    if chosen.generic {
        _ :: reject_unmet_impl_bounds(
            default_if_free(target_ty), chosen.trait_key, .TraitNotSatisfied, e.field_span,
            typed, diags,
        )
    }
    return impl_member_type(chosen, target_ty, typed)
}

// `chosen`'s signature on `target_ty` : a generic impl's parameters take the
// receiver's arguments ; any other impl already names them.
impl_member_type :: fn(chosen: ImplMethod, target_ty: Type, typed: TypedProgram) -> Type {
    if !chosen.generic {
        return chosen.ty
    }
    return substitute_impl_method(chosen.ty, default_if_free(target_ty), typed)
}

// T3032 : the members `sigs` several impls offer as `field` all `what`.
member_ambiguity_error :: fn(field: AST.FieldExpr, sigs: Type[], what: string) -> Diagnostic {
    names: string[]: []
    for s in sigs {
        names.push("`${display_type(s)}`")
    }
    return typecheck_error(
        .AmbiguousOverload,
        field.field_span,
        "several impls' `${field.field}` ${what}: ${names.join(", ")}",
    )
}

/// The diagnostic for a value reaching a member of a bounded impl whose bounds its
/// arguments do not meet : `Wrapper<T> implements<T: Bump> Poke` gives a
/// `Wrapper<Plain>` no `poke`, no `+`, no `for`. Every form that dispatches
/// through an impl by its base asks here.
///
/// @param receiver   the value's type.
/// @param trait_key  the trait whose impl the form dispatches through.
/// @param code       T3006, or T3043 for an operator.
/// @return           true when reported.
reject_unmet_impl_bounds :: fn(
    receiver: Type, trait_key: string, code: TypecheckCode, span: Span,
    typed: TypedProgram, diags: Diagnostic[],
) -> bool {
    unmet :: blocking_bound(receiver, trait_key, typed) ?? return false
    diags.push(
        typecheck_error(
            code, span,
            "`${display_type(receiver)}` does not implement `${trait_key_name(trait_key)}`"
                + impl_bound_note(unmet),
        ),
    )
    return true
}

try_typeparam_bound_method :: fn(
    target_ty: Type,
    e: AST.FieldExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type | null {
    if target_ty !is TypeParamType {
        return null
    }
    member :: type_member(target_ty, e.field, typed) ?? return null
    ty :: settle_dispatched_member(member, e, typed, diags)
    if ty is UnresolvedType {
        return ty
    }
    // The lowering emits `vcall <trait_key>.method` once the receiver gets erased
    // to Any, the impl of the trait at the bound's arguments otherwise.
    callee :: dispatched_callee(target_ty, member.trait_key, e.field, member.trait_args)
    note_callee(typed, e, callee)
    keep_instances_concrete(typed)
    return ty
}

// The type of `e`, a call of `member` on a receiver dispatching through the
// member's trait : a static member is called on a type (T3091).
settle_dispatched_member :: fn(
    member: TypeMember,
    e: AST.FieldExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type {
    if rejects_static_member(member.decl, e, typed, diags) {
        return TY_UNRESOLVED
    }
    return member.ty
}

// The member `name` an operator reaches on a receiver dispatching through a trait at
// run time : a bounded `T`'s, a trait value's (`trait_value_member`), or the one a
// union's variants share (`union_trait_member`, through `trait_key`).
dispatched_member :: fn(
    recv: Type,
    trait_key: string,
    name: string,
    span: Span,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> TypeMember | null =
    // @partial: only these three receivers dispatch through a trait at run time.
    @partial match recv {
        is TypeParamType -> type_member(recv, name, typed)
        is TraitType     -> trait_value_member(recv, name, span, typed, diags)
        is UnionType     -> union_trait_member(recv, trait_key, name, span, typed, diags)
        _                -> null
    }

// `c.equals(d)` on an enum, whose `Equals` is built in (`builtin_equals_member`) :
// recorded as no call, the lowering emits the comparison itself.
try_builtin_equals_method :: fn(
    target_ty: Type,
    e: AST.FieldExpr,
    typed: TypedProgram,
) -> Type | null {
    member :: builtin_equals_member(target_ty, e.field, typed) ?? return null
    note_callee(typed, e, BUILTIN_CALLEE)
    return member.ty
}

// ---- static trait members -------------------------------------------------

/// A trait member reached through a type : its signature (`Self` substituted, no
/// receiver), its declaration and the trait declaring it.
TypeMember :: struct {
    ty: Type
    decl: AST.FnDecl
    trait_key: string
    /// The trait's arguments : the bound's for a type parameter, the impl's else.
    trait_args: Type[] = []
    /// A union's dispatch through the trait was refused, and reported
    /// (`union_trait_member`) : the use site says nothing more about it.
    refused: bool = false
}

/// `Type.member` on a static trait member — `T.zero()` with `T: Zero`,
/// `i64.zero()`, `ns.Sq.unit(3)` — typed as the member, and recorded in
/// `static_members` for the lowerer, which calls the owner's impl member with no
/// receiver.
///
/// @param e          the field access ; its target must name a type.
/// @param target_ty  the target's type, as `infer_field` typed it.
/// @return           the member's type ; null when the target names no type, or
///                   the type has no member by that name (`Direction.North` then
///                   resolves as a variant).
/// @error            T3092 when the member takes `self` : it is called on a value.
/// @error            T3093 when the member is taken as a value instead of called.
try_static_member :: fn(
    e: AST.FieldExpr,
    target_ty: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type | null {
    owner :: static_owner(e.target, target_ty, typed) ?? return null
    member :: type_member(owner, e.field, typed) ?? return null
    if has_self_param(member.decl) {
        diags.push(
            typecheck_error(
                .InstanceMemberOnType,
                e.field_span,
                "`${e.field}` takes `self` ; call it on a value of ${display_type(owner)}",
            ),
        )
        return TY_UNRESOLVED
    }
    if typed.callee_field_id != e.id {
        diags.push(
            typecheck_error(
                .StaticMemberNotCalled,
                e.field_span,
                "write `${display_type(owner)}.${e.field}(…)`",
            ),
        )
        return TY_UNRESOLVED
    }
    if owner is TypeParamType {
        keep_instances_concrete(typed)
        // An instance whose `T` implements the trait more than once calls the impl
        // at the bound's arguments.
        callee :: dispatched_callee(owner, member.trait_key, e.field, member.trait_args)
        note_callee(typed, e, callee)
    } else {
        check_trait_ambiguity(e, owner, typed, diags)
        candidates :: impl_candidates(typed, owner, "::${e.field}")
        if candidates.len() > 1 && of_one_trait(candidates) {
            typed.overloaded_members[e.id] = candidates
        }
        // Several candidates wait for the call's arguments (`pick_member_overload`).
        if candidates.len() == 1 {
            note_callee(typed, e, member_callee(candidates[0].decl, owner))
        }
    }
    typed.static_members[e.id] = StaticMember { .owner = owner }
    // Written with its arguments (`Bag<f64>.make`), the owner binds the type's
    // parameters, all of them ; written bare, the call infers them.
    if e.target is AST.GenericInstExpr && owner is StructType {
        reject_partial_type_args(e.target, owner, typed, diags)
        return substitute_struct_args(member.ty, owner, typed)
    }
    return member.ty
}

// The type a field access's target names : a bare type name, or a namespace member
// that is a type (`ns.Sq`) ; null for a value.
static_owner :: fn(target: AST.Expr, target_ty: Type, typed: TypedProgram) -> Type | null {
    // A generic type with its arguments written (`Bag<f64>.make(1)`) : that instance,
    // which is the target's type.
    if target is AST.GenericInstExpr {
        callee_ty :: typed.expr_types[target.callee.id] ?? return null
        _ :: static_owner(target.callee, callee_ty, typed) ?? return null
        return target_ty
    }
    if target is AST.FieldExpr {
        if target.target !is AST.IdentExpr {
            return null
        }
        alias :: typed.resolved.idents[target.target.span.hash()] ?? return null
        types :: typed.resolved.namespace_member_types[alias.id] ?? return null
        if types[target.field] == null {
            return null
        }
        return target_ty
    }
    sym :: bare_name_symbol(target, typed) ?? return null
    return denoted_type(sym, target_ty, typed)
}

// The type a type name stands for ; null for a name bound to anything else, a trait
// included : a trait owns no impl to call. `target_ty` is the name's own type, which
// for a declared type or a type parameter is the type itself.
denoted_type :: fn(sym: Symbol, target_ty: Type, typed: TypedProgram) -> Type | null {
    if sym.kind == .Trait {
        return null
    }
    if sym.kind == .BuiltinType {
        return primitive_from_name(sym.name)
    }
    if is_type_kind(sym.kind) {
        return target_ty
    }
    return typed.resolved.alias_types[sym.id]
}

// The member `name` of `owner` : through its bound for a type parameter, through
// its impls otherwise, or the impl it has built in.
type_member :: fn(owner: Type, name: string, typed: TypedProgram) -> TypeMember | null {
    if owner is TypeParamType {
        bound :: typed.resolved.type_param_bounds[owner.symbol.id] ?? return null
        trait_ty :: bound_trait_declaring(bound, name, typed) ?? return null
        return trait_type_member(trait_ty, owner, name, typed)
    }
    candidates :: impl_candidates(typed, owner, "::${name}")
    if candidates.len() == 0 {
        return builtin_equals_member(owner, name, typed)
    }
    // Several impls of one trait : the call picks among them (`pick_member_overload`).
    found :: candidates[0]
    decl :: found.decl ?? return null
    return TypeMember {
        .ty = found.ty,
        .decl = decl,
        .trait_key = found.trait_key,
        .trait_args = found.trait_args,
    }
}

// The member `name` of `trait_ty`, `Self` standing for `owner`.
trait_type_member :: fn(
    trait_ty: TraitType,
    owner: Type,
    name: string,
    typed: TypedProgram,
) -> TypeMember | null {
    decl :: trait_member_decl(trait_ty, name, typed) ?? return null
    method :: try_trait_method(trait_ty, name, typed, owner) ?? return null
    return TypeMember {
        .ty = method,
        .decl = decl,
        .trait_key = trait_key_of(trait_ty.symbol),
        .trait_args = trait_ty.args,
    }
}

// The member `name` of the `Equals` `owner` has built in (`has_builtin_impl`) : an
// enum's `equals`. Every variant access (`Color.Red`) asks here, so the name is
// looked up before anything is built.
builtin_equals_member :: fn(owner: Type, name: string, typed: TypedProgram) -> TypeMember | null {
    sym :: typed.equals_symbol ?? return null
    if lookup_trait_method(typed.trait_decls[sym.id], name) == null {
        return null
    }
    if !has_builtin_impl(owner, trait_key_of(sym)) {
        return null
    }
    owner_trait :: TraitType { .symbol = sym, .args = [] }
    return trait_type_member(owner_trait, owner, name, typed)
}

// The trait of `bound` (an `A & B` walked left first) that declares `name`.
bound_trait_declaring :: fn(
    bound: AST.Expr,
    name: string,
    typed: TypedProgram,
) -> TraitType | null {
    if bound is AST.BinaryExpr {
        if bound.op == .BitAnd {
            left :: bound_trait_declaring(bound.left, name, typed)
            if left != null {
                return left
            }
            return bound_trait_declaring(bound.right, name, typed)
        }
    }
    bound_ty :: type_from_expr(bound, typed.resolved, [])
    if bound_ty is TraitType && trait_member_decl(bound_ty, name, typed) !is null {
        return bound_ty
    }
    return null
}

// The declaration of `trait_ty`'s member `name`.
trait_member_decl :: fn(trait_ty: TraitType, name: string, typed: TypedProgram) -> AST.FnDecl | null =
    lookup_trait_method(typed.trait_decls[trait_ty.symbol.id], name)

// T3091 when `x.<name>` reaches a static member — one taking no `self`, called on
// a type instead. `x` may be the trait itself, which types as a trait value.
rejects_static_member :: fn(
    decl: AST.FnDecl | null,
    e: AST.FieldExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> bool {
    if decl is null || has_self_param(decl) {
        return false
    }
    owner :: bare_name_symbol(e.target, typed)
    detail :: if owner != null && owner.kind == .Trait {
        "`${owner.name}` is a trait ; call `${e.field}` on a type that implements it"
    } else {
        "`${e.field}` takes no `self` ; call it on the type"
    }
    diags.push(typecheck_error(.StaticMemberOnValue, e.field_span, detail))
    return true
}

// `x.foo()` dispatching to a free fn `foo` whose first param accepts
// `target_ty`. Walks the local module's `fn_overloads` bucket and
// returns the curried fn type (receiver stripped). Records the
// receiver type in `ufcs_receiver_types` for the call-site lowerer.
try_free_fn_ufcs_dispatch :: fn(
    target_ty: Type,
    e: AST.FieldExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type | null {
    free_ufcs :: try_free_fn_ufcs_with_first(e.field, target_ty, e.span.start.file, typed) ?? return null
    if free_ufcs.rival != null {
        diags.push(ambiguous_overload_error(e.field, target_ty, free_ufcs.winner, free_ufcs.rival, e.field_span))
    }
    first_param :: free_ufcs.winner.ty.params[0]
    typed.ufcs_receiver_types[e.id] = first_param
    // The chosen fn is instantiated at the receiver's own type at each instance
    // (`harvest_ufcs_fn_instance`, lower_ufcs.vader) ; erased to `Any` the receiver
    // names none, so the enclosing fn's instances stay concrete.
    if type_contains_type_param(target_ty) {
        keep_instances_concrete(typed)
    }
    typed.chosen_fns[e.id] = free_ufcs.winner
    note_callee(typed, e, direct_callee(free_ufcs.winner.decl, false))
    // A `T[]` receiver fitting an `Iterator` first param coerces through the very
    // `.into()` the lowerer synthesizes at `lower_ufcs`, whatever the element : the
    // dispatch already accepted the receiver. Record it on the receiver expr so the
    // LSP surfaces the `.into()` hint here too. The receiver decision goes through
    // `receiver_fits_first_param`, not `try_into`, so without this `arr.method()`
    // would miss the hint that `method(arr)` gets. Trait widening isn't an
    // `.into()`, so (as in `try_into`) it's excluded : only the array→iterator
    // blanket records.
    if converts_array_to_iterator(target_ty, first_param) {
        note_into(typed, e.target, target_ty, first_param)
    }
    // Matched by shape, the receiver may have widened an array as an argument does
    // (`receiver_fits_first_param`). A parameter naming the callee's type parameters
    // waits for the call, which binds them.
    if target_ty is ArrayType && !type_contains_type_param(first_param) {
        _ :: fits_by_widening(typed, e.target, target_ty, first_param)
    }
    return free_ufcs.curried
}

// Settle a free-numeric receiver of a free-fn UFCS call at the fn's first
// parameter (just recorded in `ufcs_receiver_types`), as a call settles its
// arguments: `50.millis()` lowers its receiver as the `i64` `millis` takes.
repin_free_ufcs_receiver :: fn(e: AST.FieldExpr, typed: TypedProgram, diags: Diagnostic[]) -> void {
    first_param :: typed.ufcs_receiver_types[e.id] ?? return
    settle_free_at_slot(e.target, first_param, typed, diags)
}

// Settle the checked free value `e` at a parameter of type `slot`, as an argument:
// a union slot settles it on one member first (`union_member_for_free`).
settle_free_at_slot :: fn(
    e: AST.Expr,
    slot: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    recorded :: typed.expr_types[e.id] ?? return
    if !is_free_numeric(recorded) {
        return
    }
    settle_free_value(e, union_member_for_free(recorded, slot, e, diags), typed, diags)
}

// The concrete type to pin a free-literal UFCS receiver to. A concrete first param
// IS the pin. A UNION first param settles the literal on one member by the same
// rule as an argument (`union_literal_member`), T3089 included : `42.0.f()` into
// `i32 | f32` is the `f32`.
union_member_for_free :: fn(
    free_ty: Type, first_param: Type, receiver: AST.Expr, diags: Diagnostic[],
) -> Type {
    if first_param !is UnionType {
        return first_param
    }
    member :: union_literal_member(free_ty, first_param)
    if member == null {
        return settle_ambiguous_literal(receiver, free_ty, first_param, diags)
    }
    return member
}

// `c.m()` on a value of a trait, and `u.area()` on a union every variant of which
// implements the trait declaring the member (`tag_dispatch`) : dispatched through
// the trait by the value's tag. The lowering reads the union's trait from the
// recorded dispatch ; a trait value names its own.
try_dispatched_method :: fn(
    target_ty: Type,
    e: AST.FieldExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type | null {
    if target_ty !is TraitType && target_ty !is UnionType {
        return null
    }
    if target_ty is TraitType {
        member :: trait_type_member(target_ty, target_ty, e.field, typed) ?? return null
        note_callee(typed, e, TraitMember { .trait_key = member.trait_key, .member = e.field })
        return settle_dispatched_member(member, e, typed, diags)
    }
    // A union's member taken as a value has no instance to name : left to the field
    // forms.
    if target_ty !is UnionType || typed.callee_field_id != e.id {
        return null
    }
    member :: union_trait_member(target_ty, "", e.field, e.field_span, typed, diags) ?? return null
    ty :: settle_dispatched_member(member, e, typed, diags)
    if ty !is UnresolvedType {
        note_callee(typed, e, TraitMember { .trait_key = member.trait_key, .member = e.field })
    }
    return ty
}

// Struct that implements a trait carrying a same-named method WITH a default body
// (`Async.cancel`) — synthesise the dispatch from the trait method's signature.
try_default_trait_method_dispatch :: fn(
    target_ty: Type,
    e: AST.FieldExpr,
    typed: TypedProgram,
) -> Type | null {
    if target_ty !is StructType {
        return null
    }
    return try_default_trait_method(target_ty, e.field, typed)
}

// `tup.0` — positional access on tuples. Out-of-range raises T3009.
try_tuple_index_dispatch :: fn(
    target_ty: Type,
    e: AST.FieldExpr,
    diags: Diagnostic[],
) -> Type | null {
    // `tuple_backing` accepts a tuple-backed distinct newtype too, so `coord.0`
    // forwards to the backing tuple's positional slots while the distinct keeps
    // its nominal identity.
    tup :: tuple_backing(target_ty) ?? return null
    idx :: parse_tuple_index(e.field)
    if idx < 0 || idx >= i32(tup.elements.len()) {
        diags.push(
            typecheck_error(
                .FieldDoesNotExist,
                e.field_span,
                "`${e.field}` on ${display_type(target_ty)}",
            ),
        )
        return TY_UNRESOLVED
    }
    return tup.elements[idx]
}

try_union_common_field_dispatch :: fn(
    target_ty: Type,
    e: AST.FieldExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type | null {
    if target_ty !is UnionType {
        return null
    }
    read :: union_field_read(target_ty, e.field, typed) ?? return null
    if read is LayoutClash {
        diags.push(
            typecheck_error(
                .NotIndexable,
                e.span,
                "`.${e.field}` does not read the same in every variant of "
                    + "`${display_type(target_ty)}` (${read.detail}); "
                    + "narrow with `if`/`match` first",
            ),
        )
        return TY_UNRESOLVED
    }
    check_internal_union_field(target_ty, e, typed, diags)
    return narrow_field_if_active(e, read, typed)
}

// T3054, once, when a variant of `u` holds `e.field` as `@internal` : reading the
// union reads that variant's field.
check_internal_union_field :: fn(
    u: UnionType,
    e: AST.FieldExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    for v in u.variants {
        if v !is StructType {
            continue
        }
        decl :: typed.struct_decls[v.symbol.id] ?? continue
        if check_internal_field(v, decl, e.field, e.field_span, typed, diags) {
            return
        }
    }
}

// A field access on an enum-typed receiver : `Direction.North` on the enum type
// is a variant, `v.code` on a value is a field of its variant data (T3009 when
// there is none).
try_enum_variant_dispatch :: fn(
    target_ty: Type,
    e: AST.FieldExpr,
    expected: Type | null,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type | null {
    if target_ty !is EnumType {
        return null
    }
    // A variant is looked up on the enum TYPE only ; on a value, `v.x` is a
    // field of its variant data or nothing.
    if !names_enum_type(e.target, typed) {
        data_field :: enum_data_field(target_ty, e, typed, diags)
        if data_field != null {
            typed.enum_data_reads[e.id] = true
            return data_field
        }
        hint :: if target_ty.indices[e.field] != null {
            " — a variant is named on the enum type"
        } else {
            ""
        }
        diags.push(
            typecheck_error(
                .FieldDoesNotExist,
                e.field_span,
                "`${e.field}` on ${display_type(target_ty)}${hint}",
            ),
        )
        return TY_UNRESOLVED
    }
    idx :: target_ty.indices[e.field]
    if idx is null {
        diags.push(
            typecheck_error(
                .UnknownEnumVariant,
                e.field_span,
                "`${e.field}` is not a variant of ${display_type(target_ty)}",
            ),
        )
        return TY_UNRESOLVED
    }
    // W0016 — the slot already pins this enum, so the name in front of the dot
    // is dead weight. Only when the shorthand would land on the SAME enum: a
    // slot whose union carries two enums sharing this variant name resolves the
    // bare form to the first, and there the prefix is what disambiguates.
    inferred :: enum_for_bare_variant(expected, e.field, typed)
    if inferred !is null && typed.overloaded_arg_depth == 0 && equals_type(inferred, target_ty) {
        diags.push(warning(.NeedlessEnumTypePrefix, e.span, "write `.${e.field}`"))
    }
    return target_ty
}

// `v.field` on an enum VALUE whose header declares variant data : the type of
// that field of the data struct. Null when the enum carries no data or when the
// struct has no such field.
enum_data_field :: fn(target_ty: EnumType, e: AST.FieldExpr, typed: TypedProgram, diags: Diagnostic[]) -> Type | null {
    data :: target_ty.data ?? return null
    found :: declared_struct_field_type(data, e.field, typed) ?? return null
    decl :: typed.struct_decls[data.symbol.id] ?? return null
    check_internal_field(data, decl, e.field, e.field_span, typed, diags)
    return found
}

/// Whether `target` names an enum-typed TYPE rather than a value of it — the
/// receiver `Enum.Variant` needs : a name bound to a type, including through an
/// import, or a namespace member `alias.Enum`.
///
/// @param target  the receiver of a field access whose type is an enum.
/// @param typed   the module's typed program, for the name's symbol.
names_enum_type :: fn(target: AST.Expr, typed: TypedProgram) -> bool {
    if target is AST.FieldExpr {
        return namespace_base_mod_id(target.target, typed) != null
    }
    sym :: bare_name_symbol(target, typed) ?? return false
    return is_type_kind(sym.kind)
}

// The declaration a bare name is bound to, followed through an import ; null
// for any other expression.
bare_name_symbol :: fn(target: AST.Expr, typed: TypedProgram) -> Symbol | null {
    if target !is AST.IdentExpr {
        return null
    }
    sym :: typed.resolved.idents[target.span.hash()] ?? return null
    return declared_symbol(sym, typed)
}

/// Whether `target` is a bare name bound to a declaration of `kind`, through
/// an import (`{ Info as I }`) included.
names_symbol_of_kind :: fn(target: AST.Expr, kind: SymbolKind, typed: TypedProgram) -> bool {
    sym :: bare_name_symbol(target, typed) ?? return false
    return sym.kind == kind
}

// True when `name` has UFCS free-fn candidates visible in `file` (declared by
// the module, or imported by that file) — i.e. a method by that name exists, so
// a failed dispatch is "no overload fit the receiver", not "unknown method".
// Drives the tailored union-receiver hint.
ufcs_name_has_candidates :: fn(name: string, file: string, typed: TypedProgram) -> bool {
    if typed.resolved.fn_overloads[name] != null {
        return true
    }
    imported :: imported_overloads_table_in(typed, file) ?? return false
    return imported[name] != null
}

// T3078 — the receiver has no such member, but a module imported under a
// NAMESPACE ALIAS exports a free fn by that name whose first param accepts it.
// An alias binds one name and qualifies the rest, so the fn is out of
// unqualified scope in both call forms (`f(x)` is R2006, `x.f()` lands here) —
// SPEC §UFCS, "resolves … exactly as `foo(x)` would". Point at the qualified
// form instead of leaving the reader with a bare "no such field".
//
// Returns true when it reported, so the caller skips the generic diagnostic.
report_namespace_alias_method :: fn(
    e: AST.FieldExpr,
    target_ty: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> bool {
    targets :: typed.import_targets ?? return false
    for [sym_id, mod_id] in targets.namespace_targets {
        exports :: typed.namespace_exports[mod_id] ?? continue
        ft :: exports[e.field] ?? continue
        if ft !is FnType {
            continue
        }
        if ft.params.len() == 0 {
            continue
        }
        // Same receiver test the UFCS dispatch itself runs — an alias exporting
        // an unrelated `f(i32)` explains nothing about `recv.f()`.
        if try_curry_receiver(ft, target_ty, typed) == null {
            continue
        }
        alias :: import_binding_by_id(sym_id, typed) ?? continue
        // The alias, not the module: `mod_id` is the target's FOLDER, which is
        // not what the import spelled (R2008 on a namespace member is likewise
        // module-free). The repair is the qualified call, so that is the detail.
        diags.push(
            typecheck_error(
                .MethodOnlyBehindNamespaceAlias,
                e.field_span,
                "write `${alias.name}.${e.field}(${path_name(e.target, "…")})`",
            ),
        )
        return true
    }
    return false
}

// Terminal struct-field lookup + the catch-all diagnostics for any
// other unsupported shape. Returns a real Type (not Type | null)
// since this is the last fallthrough.
resolve_struct_field :: fn(
    target_ty: Type,
    e: AST.FieldExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type {
    // `struct_backing` accepts a struct-backed distinct newtype (`Color :: Rgb`)
    // too : `color.r` forwards to the backing struct's fields while the distinct
    // keeps its nominal identity for trait-impl dispatch.
    st :: struct_backing(target_ty)
    if st == null {
        // Checked before the shape-based diagnostics: "the name is behind an
        // alias" explains the miss, where "non-struct type" only describes it.
        if report_namespace_alias_method(e, target_ty, typed, diags) {
            return TY_UNRESOLVED
        }
        // A UFCS method by this name exists, but no overload's first param
        // accepts this union receiver — the common case being a value combinator
        // (`or` / `map` / …) fed a union with more than one "unhappy" variant
        // (e.g. `T | Error | null` fits neither the `T | null` nor the `T | Error`
        // overload). Point at narrowing rather than the bare "not indexable".
        if target_ty is UnionType && ufcs_name_has_candidates(e.field, e.span.start.file, typed) {
            diags.push(
                typecheck_error(
                    .NotIndexable,
                    e.span,
                    "no `${e.field}` overload accepts a receiver of type `${display_type(target_ty)}` — narrow the union with `if`/`match` first (a value combinator handles a single unhappy variant, `T | null` or `T | Error`, not both)",
                ),
            )
            return TY_UNRESOLVED
        }
        diags.push(
            typecheck_error(
                .NotIndexable,
                e.span,
                "`.${e.field}` on non-struct type ${display_type(target_ty)}",
            ),
        )
        return TY_UNRESOLVED
    }
    decl :: typed.struct_decls[st.symbol.id]
    if decl is null {
        // A generator's state struct has no declaration and no field the source
        // can name : a member that reached here is a method no overload took.
        if is_gen_state_struct(st) {
            report_gen_state_member(e, st, typed, diags)
        }
        // Otherwise a placeholder struct for an enum or a type alias
        // (`type_from_symbol`), whose misses are reported on their own path.
        return TY_UNRESOLVED
    }
    // T3054 : reject reads (and assignment LHS, which types through here too)
    // of an `@internal` field from outside its declaring module.
    check_internal_field(st, decl, e.field, e.field_span, typed, diags)
    found :: resolved_field_type(st.symbol.id, decl, e.field, typed, diags)
    if found == null {
        if report_namespace_alias_method(e, target_ty, typed, diags) {
            return TY_UNRESOLVED
        }
        diags.push(
            typecheck_error(
                .FieldDoesNotExist,
                e.field_span,
                "`${e.field}` on ${display_type(target_ty)}",
            ),
        )
        return TY_UNRESOLVED
    }
    substituted :: substitute_struct_args(found, st, typed)
    return narrow_field_if_active(e, substituted, typed)
}

// A member no overload took on a generator's result, named for the
// `Iterator<E>` the source declared rather than the synthetic state struct.
report_gen_state_member :: fn(
    e: AST.FieldExpr,
    st: StructType,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    receiver := display_type(st)
    if st.args.len() == 1 {
        receiver = "Iterator<${display_type(st.args[0])}>"
    }
    if ufcs_name_has_candidates(e.field, e.span.start.file, typed) {
        diags.push(
            typecheck_error(
                .NotIndexable,
                e.span,
                "no `${e.field}` overload accepts a receiver of type `${receiver}`",
            ),
        )
        return
    }
    diags.push(typecheck_error(.FieldDoesNotExist, e.field_span, "`${e.field}` on `${receiver}`"))
}

/// Declared (pre-narrow, type-arg-substituted) type of a struct-field
/// lvalue `recv.field`, given `recv`'s already-checked type. This is the
/// slot type an assignment `recv.field = v` must be assignable to :
/// `resolve_struct_field` layers `narrow_field_if_active` on top for
/// *reads*, but a write targets the *declared* field, not its narrowing
/// (mirrors `invalidate_narrow_on_assign`, which retires — not rejects —
/// a write outside the current narrowing).
///
/// @param recv_ty  the receiver's checked type : a struct, a struct-backed
///                 newtype, or a union of structs read through a common field.
/// @param field    the field name being written.
/// @return         the substituted field type, or `null` when `recv_ty`
///                 is none of those, its decl isn't indexed, or the field
///                 doesn't resolve — the caller then skips the write check
///                 (the read-side typing already surfaced any field error).
export declared_struct_field_type :: fn(
    recv_ty: Type,
    field: string,
    typed: TypedProgram,
) -> Type | null {
    if recv_ty is UnionType {
        return union_common_field_type(recv_ty, field, typed)
    }
    st :: struct_backing(recv_ty) ?? return null
    decl :: typed.struct_decls[st.symbol.id] ?? return null
    // Discard sink : the read-side check already emitted any field error.
    discard: Diagnostic[]: []
    found :: resolved_field_type(st.symbol.id, decl, field, typed, discard) ?? return null
    return substitute_struct_args(found, st, typed)
}

/// Enforce `@internal` field visibility (T3054). A field parsed as
/// `Visibility.Private` (the `@internal` decorator) is readable, writable,
/// constructible, and pattern-bindable only from its declaring module. Fields
/// are public by default, so this fires only for the rare opt-in field.
///
/// Same-module access is always allowed — the test mirrors the established
/// cross-module comparison `sym.module != typed.resolved.path`
/// (`vader/typecheck/expr_ident.vader`). Shared by the read sites (a struct's
/// field, a union's common one, an enum's variant data), the construction site
/// (`struct_lit.vader`), and the pattern site (`match_expr.vader`).
///
/// @param st          the struct type whose field is being accessed.
/// @param decl        the struct's AST decl, carrying per-field visibility
///                    (present even for imported structs via
///                    `broadcast_struct_decls`).
/// @param field_name  the field being touched.
/// @param span        where to point the diagnostic.
/// @return            true when it reported.
/// @error             T3054 when `field_name` is `@internal` and the access is
///                    from a different module than `st.symbol.module`.
check_internal_field :: fn(
    st: StructType,
    decl: AST.StructDecl,
    field_name: string,
    span: Span,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> bool {
    if st.symbol.module == typed.resolved.path {
        return false
    }
    for field in decl.fields {
        if field.name == field_name {
            if field.visibility != .Private {
                return false
            }
            diags.push(
                typecheck_error(
                    .InternalFieldAccess,
                    span,
                    "`${field_name}` is `@internal` to module `${st.symbol.module}`",
                ),
            )
            return true
        }
    }
    return false
}

/// Look up `${root_sym.id}#path` for this FieldExpr's chain in
/// `narrowed_fields` and return that type ; falls through to `declared`
/// when no chain narrowing is active.
narrow_field_if_active :: fn(
    e: AST.FieldExpr,
    declared: Type,
    typed: TypedProgram,
) -> Type {
    // Fast path : the common case is no live field narrowings at all,
    // so dodge the chain walk + key build entirely.
    if typed.narrow.fields.is_empty() {
        return declared
    }
    key :: field_chain_key(e, typed)
    if key == "" {
        return declared
    }
    return narrow_for_field(typed, key, declared)
}

/// The type of field `name` of the struct `struct_id`, as resolved in the
/// struct's own module when it was declared ; type parameters stay as written.
///
/// @param struct_id  the struct's symbol id.
/// @param name       the field.
/// @param typed      any module's typed program : the table is shared by the project.
/// @return           null when the struct or the field has no entry.
export lookup_pre_resolved_field :: fn(
    struct_id: i32, name: string, typed: TypedProgram,
) -> Type | null {
    fmap :: typed.struct_field_types[struct_id] ?? return null
    return fmap[name]
}

/// Resolve field `name`'s type on the struct with symbol id `struct_id` — the
/// owner-resolved `struct_field_types` cache first (authoritative cross-module),
/// else a local AST re-walk of `decl` (same-module cold path). The
/// cache-before-walk ordering lives HERE so no field-type consumer can reorder
/// or skip it ; callers keep their own post-lookup substitution / narrowing.
resolved_field_type :: fn(
    struct_id: i32,
    decl: AST.StructDecl,
    name: string,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type | null {
    cached :: lookup_pre_resolved_field(struct_id, name, typed)
    if cached !is null {
        return cached
    }
    return find_struct_field_type(decl, name, typed.resolved, diags)
}

/// Substitute `st`'s declared type parameters by its arguments in `t` : a field
/// `value: T` of `Box :: struct<T>` reads as `i32` on a `Box<i32>`.
///
/// @param t      a type written with the struct's own parameters.
/// @param st     an instance of the struct.
/// @param typed  the program whose struct and parameter tables are read.
/// @return       `t` as is when `st` names no struct of the project.
substitute_struct_args :: fn(t: Type, st: StructType, typed: TypedProgram) -> Type {
    decl :: typed.struct_decls[st.symbol.id] ?? return t
    return substitute_type_params(t, decl.type_params, st.args, typed)
}

/// Substitute the type parameters `tps` declares by `args`, in order.
///
/// @param t      the type written with the parameters.
/// @param tps    the declaration's type parameters.
/// @param args   the arguments, one per parameter ; fewer leaves the rest.
/// @param typed  the program whose shared parameter table is read.
substitute_type_params :: fn(
    t: Type, tps: AST.TypeParam[], args: Type[], typed: TypedProgram,
) -> Type {
    // A function type's quantifier may name the parameters its signature does not.
    if tps.len() == 0 || args.len() == 0 || (t !is FnType && !type_contains_type_param(t)) {
        return t
    }
    return substitute_map(t, type_param_bindings(tps, args, typed))
}

/// The type each of `tps` takes : `args[i]` for the `i`-th, keyed by the symbol the
/// resolver gave it (`type_param_symbols`), so the parameters of an imported
/// declaration are reached too.
///
/// @param tps    a declaration's type parameters.
/// @param args   the arguments, one per parameter ; a parameter past the last is left
///               out.
/// @param typed  the program whose shared parameter table is read.
export type_param_bindings :: fn(
    tps: AST.TypeParam[], args: Type[], typed: TypedProgram,
) -> MutableMap<i32, Type> {
    bindings :: MutableMap<i32, Type> {}
    for i in 0..<min(tps.len(), args.len()) {
        sym :: typed.type_param_symbols[tps[i].span.hash()] ?? continue
        bindings[sym.id] = args[i]
    }
    return bindings
}

// Emit T3032 when two distinct traits both provide `e.field` on
// `target_ty`. The impl_method dispatch picks one silently ; this
// hook surfaces the ambiguity instead of letting it bite later.
check_trait_ambiguity :: fn(
    e: AST.FieldExpr,
    target_ty: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    traits :: impl_side_list(typed, typed.impl_tables.impl_method_traits, target_ty, "::${e.field}")
    if traits.len() < 2 {
        return
    }
    names :: trait_names_apart(traits, typed)
    diags.push(
        typecheck_error(
            .AmbiguousOverload,
            e.field_span,
            "`${e.field}` on ${display_type(target_ty)} is ambiguous between traits: ${names.join(", ")}",
        ),
    )
}

// The traits of `keys` by name, a name two of them share qualified by its module
// (`snippet/tr_a.Describe`), so the message tells homonymous traits apart.
trait_names_apart :: fn(keys: string[], typed: TypedProgram) -> string[] {
    short: string[]: []
    for key in keys {
        short.push(trait_key_name(key))
    }
    out: string[]: []
    for i in 0..<keys.len() {
        if short_name_count(short, short[i]) > 1 {
            out.push(qualified_trait_name(keys[i], typed) ?? short[i])
        } else {
            out.push(short[i])
        }
    }
    return out
}

short_name_count :: fn(names: string[], name: string) -> usize =
    names.filter((candidate) -> candidate == name).count()

// `module.Name` of the trait whose key is `key`. The key's module segment is
// mangled, so the module path comes from the declaring module itself.
qualified_trait_name :: fn(key: string, typed: TypedProgram) -> string | null {
    id :: find_trait_id(key, typed) ?? return null
    owner :: typed.trait_decl_owners[id] ?? typed.resolved
    return "${owner.display_path}.${trait_key_name(key)}"
}

// Bind a blanket array impl's type param to the concrete element. A blanket
// array impl (`T[] implements<T> ArrayOps<T>`) carries exactly one type param =
// the element, so every `TypeParamType` leaf in the resolved member IS that
// element. Struct receivers bind by parameter symbol (`substitute_type_params`,
// keyed on `decl.type_params` × `target.args`) ; an array carries no `.args`, so
// bind every param leaf to `element` instead.
substitute_array_element :: fn(t: Type, element: Type) -> Type {
    // @partial: only TypeParam + the composite variants carry a param to rewrite;
    // scalars have no inner type → return as-is.
    @partial match t {
        is TypeParamType -> { return element }
        is ArrayType -> { return mk_array(substitute_array_element(t.element, element)) }
        is TupleType -> {
            els: Type[]: []
            for el in t.elements { els.push(substitute_array_element(el, element)) }
            return mk_tuple(els)
        }
        is StructType -> {
            sargs: Type[]: []
            for a in t.args { sargs.push(substitute_array_element(a, element)) }
            return mk_struct(t.symbol, sargs)
        }
        is TraitType -> {
            rargs: Type[]: []
            for a in t.args { rargs.push(substitute_array_element(a, element)) }
            return TraitType { ...t, .args = rargs }
        }
        is UnionType -> {
            vs: Type[]: []
            for v in t.variants { vs.push(substitute_array_element(v, element)) }
            return union_of(vs)
        }
        is FnType -> {
            ps: Type[]: []
            for p in t.params { ps.push(substitute_array_element(p, element)) }
            return mk_fn(ps, substitute_array_element(t.return_type, element))
        }
        _ -> { return t }
    }
}

// Substitute the impl method's TypeParams against the receiver's
// concrete type args. Lets `MutableSet<T> implements ... { contains
// :: fn(self, value: T) -> bool }` produce `fn(i32) -> bool` when
// called on `MutableSet<i32>`.
substitute_impl_method :: fn(impl_ty: Type, target_ty: Type, typed: TypedProgram) -> Type {
    // Blanket array impl (`T[] implements<T> ArrayOps<T>` / `Index` / `IndexSet`) :
    // the receiver carries its element in `.element`, not `.args`, so bind the
    // single param to the element. Also covers array-backed distinct newtypes.
    if array_backing(target_ty) is ArrayType as arr {
        return substitute_array_element(impl_ty, arr.element)
    }
    if target_ty !is StructType {
        return impl_ty
    }
    return substitute_struct_args(impl_ty, target_ty, typed)
}

/// Declared type of the field `name` every variant of `u` places at one offset.
///
/// @param u      a union.
/// @param name   the field name.
/// @param typed  the program whose struct tables are read.
/// @return       `null` when a variant is no struct, lacks the field, or places it
///               elsewhere : the field is no common one.
export union_common_field_type :: fn(
    u: UnionType,
    name: string,
    typed: TypedProgram,
) -> Type | null {
    read :: union_field_read(u, name, typed)
    if read is LayoutClash {
        return null
    }
    return read
}

// Why `u.name` does not read the same in every variant of `u`, for T3008.
LayoutClash :: struct {
    detail: string
}

// How `u.name` reads : the field's type when every variant places it at one
// offset, a `LayoutClash` when every variant declares it but not at one offset,
// null when a variant is no struct or lacks the field.
//
// The access reads the field at its offset in the first variant (`LoweredUnionField`).
// The variants must therefore agree on the field's position, on its type, and on
// the type of every field before it, since those types are what place it. The
// names before it may differ.
union_field_read :: fn(
    u: UnionType,
    name: string,
    typed: TypedProgram,
) -> Type | LayoutClash | null {
    if u.variants.len() == 0 {
        return null
    }
    first :: u.variants[0]
    if first !is StructType {
        return null
    }
    // The declaration's own check reports a field type that does not resolve.
    discard: Diagnostic[]: []
    shared :: field_layout(first, name, typed, discard) ?? return null
    clash: LayoutClash | null = null
    for i in 1..<u.variants.len() {
        v :: u.variants[i]
        if v !is StructType {
            return null
        }
        layout :: field_layout(v, name, typed, discard) ?? return null
        if clash == null {
            clash = layout_clash(first, shared, v, layout)
        }
    }
    if clash is LayoutClash {
        return clash
    }
    return shared[shared.len() - 1]
}

// The types of `st`'s fields up to and including `name`, as `st`'s arguments
// make them ; null when `st` has no field `name`.
field_layout :: fn(
    st: StructType,
    name: string,
    typed: TypedProgram,
    discard: Diagnostic[],
) -> Type[] | null {
    decl :: typed.struct_decls[st.symbol.id] ?? return null
    at :: field_position(decl, name)
    if at < 0 {
        return null
    }
    out: Type[]: []
    for i in 0..=at {
        field :: decl.fields[i]
        ty :: resolved_field_type(st.symbol.id, decl, field.name, typed, discard) ?? return null
        out.push(substitute_struct_args(ty, st, typed))
    }
    return out
}

// The first disagreement between two variants' layouts up to the field they both
// declare, the field being last in each ; null when they agree.
layout_clash :: fn(
    a: StructType,
    a_types: Type[],
    b: StructType,
    b_types: Type[],
) -> LayoutClash | null {
    last :: a_types.len() - 1
    if b_types.len() != a_types.len() {
        return LayoutClash {
            .detail = "`${display_type(a)}` declares it at ${last}, "
                + "`${display_type(b)}` at ${b_types.len() - 1}",
        }
    }
    for i in 0..<a_types.len() {
        if equals_type(a_types[i], b_types[i]) {
            continue
        }
        a_shown :: "`${display_type(a_types[i])}` in `${display_type(a)}`"
        b_shown :: "`${display_type(b_types[i])}` in `${display_type(b)}`"
        if i == last {
            return LayoutClash { .detail = "it is ${a_shown}, ${b_shown}" }
        }
        return LayoutClash {
            .detail = "field ${i}, before it, is ${a_shown} and ${b_shown}",
        }
    }
    return null
}

// Where `name` sits among `decl`'s fields, or `-1` when it has none.
field_position :: fn(decl: AST.StructDecl, name: string) -> i32 {
    for i in 0..<decl.fields.len() {
        if decl.fields[i].name == name { return i32(i) }
    }
    return -1
}

// Replace every `SelfType` in `t` with `self_ty`. Used to specialise
// trait-method signatures at the receiver's type (`fn(Self) -> Self` → `fn(T) -> T`
// when called on a `T`).
substitute_self :: fn(t: Type, self_ty: Type) -> Type {
    // @partial: only SelfType and the composite variants can contain a `Self`
    // leaf; every scalar / primitive variant has no `Self` to replace.
    @partial match t {
        is SelfType -> { return self_ty }
        is ArrayType -> { return mk_array(substitute_self(t.element, self_ty)) }
        is StructType -> {
            args: Type[]: []
            for a in t.args {
                args.push(substitute_self(a, self_ty))
            }
            return mk_struct(t.symbol, args)
        }
        is FnType -> {
            ps: Type[]: []
            for p in t.params {
                ps.push(substitute_self(p, self_ty))
            }
            return FnType {
                ...t,
                .params = ps,
                .return_type = substitute_self(t.return_type, self_ty),
            }
        }
        is UnionType -> {
            vs: Type[]: []
            for v in t.variants {
                vs.push(substitute_self(v, self_ty))
            }
            return union_of(vs)
        }
        is TupleType -> {
            els: Type[]: []
            for el in t.elements {
                els.push(substitute_self(el, self_ty))
            }
            return mk_tuple(els)
        }
        _ -> { return t }
    }
}

/// For a struct receiver, find a trait it implements whose method by
/// the given name has a default (non-empty) body, and return the
/// curried signature with `Self → struct_ty` and the trait's type
/// parameters → the impl's recorded arguments.
try_default_trait_method :: fn(
    target_ty: StructType,
    name: string,
    typed: TypedProgram,
) -> Type | null {
    implemented :: typed.impl_tables.struct_implemented_traits
    for trait_key in impl_side_list(typed, implemented, target_ty, "") {
        trait_id :: find_trait_id(trait_key, typed) ?? continue
        decl :: typed.trait_decls[trait_id] ?? continue
        for m in decl.members {
            // A default needs a body ; a static member is reached through its
            // type, never through a value.
            if m.name != name     { continue }
            if m.body is null     { continue }
            if !has_self_param(m) { continue }
            // Substitute Self → struct, then trait type-params →
            // recorded impl args, so a default naming the trait's `T`
            // reports the impl's argument instead.
            sub_self :: substitute_self(trait_member_type(trait_id, m, typed), target_ty)
            return substitute_trait_typeparams(sub_self, decl, trait_key, target_ty, typed)
        }
    }
    return null
}

substitute_trait_typeparams :: fn(
    t: Type,
    trait_decl: AST.TraitDecl,
    trait_key: string,
    target_ty: StructType,
    typed: TypedProgram,
) -> Type {
    if trait_decl.type_params.len() == 0 {
        return t
    }
    impl_args :: lookup_struct_trait_args(target_ty, trait_key, typed) ?? return t
    // The impl args are recorded in the implementing struct's own parameters
    // (`Range<T> implements Iterator<T>` records `[T]`, Range's). Resolve those
    // against the receiver's concrete args first, so `Range<i32>` gives `i32`.
    resolved_args: Type[]: []
    for a in impl_args {
        resolved_args.push(substitute_struct_args(a, target_ty, typed))
    }
    return substitute_type_params(t, trait_decl.type_params, resolved_args, typed)
}

// The symbol id of the trait whose `trait_key` is `key`, searched in the
// project-wide `trait_decls` (cross-published : core and every imported module).
find_trait_id :: fn(key: string, typed: TypedProgram) -> i32 | null {
    name :: trait_key_name(key)
    for [id, decl] in typed.trait_decls {
        if decl.name != name {
            continue
        }
        owner :: typed.trait_decl_owners[id] ?? typed.resolved
        if "${mangle_module_id(owner.display_path)}\$${decl.name}" == key {
            return id
        }
    }
    return null
}

// Pad a trait's use-site args with declared `<T = Default>` defaults when the
// site (e.g. a `T: Add` bound, which carries no explicit trait-args) supplies
// fewer than the trait declares. A `Self` default resolves to `TY_SELF` here ;
// the caller's `substitute_self(target_ty)` then maps it to the receiver type.
pad_trait_default_args :: fn(
    args: Type[],
    tps: AST.TypeParam[],
    resolved: ResolvedModule,
) -> Type[] {
    if args.len() >= tps.len() {
        return args
    }
    out: Type[]: [] * tps.len()
    // final size is args + filled defaults, ≤ tps.len()
    out.push_all(args)
    for i in args.len()..<tps.len() {
        d :: tps[i].default ?? break
        out.push(type_from_expr(d, resolved, []))
    }
    return out
}

// `t.method()` where `t: <SomeTrait>`. Looks up the method on the
// trait decl, drops the `self` param, and returns the curried fn
// type. Null when the trait isn't indexed or the method is missing.
//
// With `self_ty`, `Self` reads as that type: the impl's, when its members are held
// to the trait.
try_trait_method :: fn(
    t: TraitType, name: string, typed: TypedProgram, self_ty: Type | null = null,
) -> Type | null {
    decl :: typed.trait_decls[t.symbol.id] ?? return null
    m :: lookup_trait_method(decl, name) ?? return null
    owner_resolved :: typed.trait_decl_owners[t.symbol.id] ?? typed.resolved
    padded :: pad_trait_default_args(t.args, decl.type_params, owner_resolved)
    member :: trait_member_type(t.symbol.id, m, typed)
    bound :: substitute_type_params(member, decl.type_params, padded, typed)
    if self_ty == null {
        return bound
    }
    return substitute_self(bound, self_ty)
}

// The type of `m`, a member of the trait `trait_id`, with its receiver dropped.
// Its signature is read in the trait's own module : std/core's `Iterator<T>.next`
// names a `T` minted there, which the entry's idents would leave unresolved.
trait_member_type :: fn(trait_id: i32, m: AST.FnDecl, typed: TypedProgram) -> FnType {
    owner_resolved :: typed.trait_decl_owners[trait_id] ?? typed.resolved
    params: Type[]: []
    for i in receiver_count(m)..<m.params.len() {
        params.push(opt_or_void(m.params[i].ty, owner_resolved, []))
    }
    return mk_fn(
        params,
        opt_or_void(m.return_type, owner_resolved, []),
        quantifier_of(m.type_params, owner_resolved),
    )
}

// A written type with `Self` read as `self_ty`.
type_with_self :: fn(
    written: AST.TypeExpr, self_ty: Type, resolved: ResolvedModule, diags: Diagnostic[],
) -> Type = substitute_self(type_from_expr(written, resolved, diags), self_ty)

UfcsResult :: struct {
    curried: Type
    /// The winning overload, in the module that declares it.
    winner: FnCandidate
    /// An overload ranked level with `winner` — see `is_level_rival`.
    rival: FnCandidate | null = null
}

try_free_fn_ufcs_with_first :: fn(
    name: string,
    target_ty: Type,
    file: string,
    typed: TypedProgram,
) -> UfcsResult | null {
    // Gather every overload whose first param accepts the receiver (curry
    // succeeds), then keep the one with the highest `overload_rank` (call.vader,
    // same module). Local and imported overloads rank together ; a strict `>`
    // keeps the first among equals, so a local overload wins a tie over an
    // imported one (locals come first). The imported half is the call site's
    // FILE's, not the module's : two files of one module import different things
    // (SPEC §"Modules").
    best: UfcsResult | null = null
    rival: FnCandidate | null = null
    best_rank: i32 = -1
    for candidate in collect_overload_candidates(name, file, typed) {
        ft :: candidate.ty
        if ft.params.len() == 0 {
            continue
        }
        curried :: try_curry_receiver(ft, target_ty, typed) ?? continue
        // The call's argument count is not known at the field: no arity rank, and
        // overloads of different arity are not reported as rivals.
        rank :: overload_rank(target_ty, ft.params[0], false)
        same_arity :: best != null && best.winner.ty.params.len() == ft.params.len()
        if rank > best_rank {
            best = UfcsResult { .curried = curried, .winner = candidate }
            best_rank = rank
            rival = null
        } else if rank == best_rank && same_arity && best != null && is_level_rival(best.winner, candidate) {
            rival = candidate
        }
    }
    found :: best ?? return null
    return UfcsResult { ...found, .rival = rival }
}

/// A free function callable on a receiver type via UFCS — its name plus the
/// curried signature (the type after the receiver is bound). Powers LSP member
/// completion, which lists these alongside struct fields and impl methods.
export UfcsMethod :: struct {
    name: string
    curried: Type
}

/// Every free function callable on `target_ty` via UFCS (first param fits the
/// receiver), deduplicated by name. Enumerates the module's own overloads then
/// the imported ones — the same two buckets `try_free_fn_ufcs_with_first`
/// resolves a single call against, but surfaced as a list for completion.
///
/// @param target_ty  the receiver type the completion is being offered on.
/// @param file       the file the completion fires in — imports are file-scoped,
///                   so a sibling file's imports must not be offered here.
/// @param typed      the module's typechecked program.
export ufcs_methods_for :: fn(target_ty: Type, file: string, typed: TypedProgram) -> UfcsMethod[] {
    out: UfcsMethod[]: []
    seen :: MutableMap<string, bool> {}
    for [name, bucket] in typed.resolved.fn_overloads {
        for sym in bucket {
            ft :: typed.decl_types[sym.id] ?? continue
            if ft !is FnType {
                continue
            }
            curried :: try_curry_receiver(ft, target_ty, typed) ?? continue
            if seen[name] != null {
                continue
            }
            seen[name] = true
            out.push(UfcsMethod { .name = name, .curried = curried })
            break
        }
    }
    imported :: imported_overloads_table_in(typed, file)
    if imported !is null {
        for [name, fts] in imported {
            if seen[name] != null {
                continue
            }
            for candidate in fts {
                curried :: try_curry_receiver(candidate.ty, target_ty, typed) ?? continue
                seen[name] = true
                out.push(UfcsMethod { .name = name, .curried = curried })
                break
            }
        }
    }
    return out
}

try_curry_receiver :: fn(ft: FnType, target_ty: Type, typed: TypedProgram) -> Type | null {
    if ft.params.len() == 0 {
        return null
    }
    // Non-generic fast path : skip the unify+substitute walk for
    // overloads whose first param has no TypeParam (the vast majority
    // of stdlib fns), since `try_free_fn_ufcs_with_first` calls this
    // for every overload in the bucket on every UFCS site.
    if !type_contains_type_param(ft.params[0]) {
        if !receiver_fits_first_param(target_ty, ft.params[0], typed) {
            return null
        }
        return mk_fn_drop_self(ft)
    }
    bindings :: MutableMap<i32, Type> {}
    unify_type_param(ft.params[0], target_ty, bindings)
    // Default Free* bindings so the curried return type comes back as
    // `i32`/`f64` instead of `{integer}`/`{float}`.
    default_free_bindings(bindings)
    fitted_first :: substitute_map(ft.params[0], bindings)
    if !receiver_fits_first_param(target_ty, fitted_first, typed) {
        return null
    }
    return mk_fn_drop_self(substitute_fn_map(ft, bindings))
}

// A receiver fits a UFCS first-param when (a) it is assignable to the param with
// the param's type parameters erased — nothing has bound them yet, so a bare `T`
// fits anything — or (b) the param is a trait the receiver implements.
// Trait widening here covers user `T implements Trait` impls AND
// `Array<T> implements Iterator<T>` (which is hardcoded via `try_array_to_iter`
// because adding it to `is_assignable` bloats c-emit).
receiver_fits_first_param :: fn(target_ty: Type, first: Type, typed: TypedProgram) -> bool {
    pattern :: erase_type_params(first)
    if accepts_argument(target_ty, pattern, typed) {
        return true
    }
    if first is TraitType {
        if try_trait_widen(target_ty, pattern, typed) {
            return true
        }
        if try_array_to_iter(target_ty, pattern) {
            return true
        }
    }
    return false
}

// Parse `0`, `1`, … from a tuple `.N` field name. Returns -1 when
// the name isn't a non-negative integer literal — `.foo` on a tuple
// then falls through to T3009 via the bounds check.
parse_tuple_index :: fn(s: string) -> i32 {
    len :: s.byte_len()
    if len == 0 {
        return -1
    }
    n: i32 = 0
    for i in 0..<len {
        c :: s.byte_at(i)
        if c < u8('0') || c > u8('9') {
            return -1
        }
        n = n * 10 + i32(c - u8('0'))
    }
    return n
}

try_namespace_field :: fn(e: AST.FieldExpr, typed: TypedProgram, diags: Diagnostic[]) -> Type | null {
    mod_id :: namespace_call_mod_id(e, typed) ?? return null
    exports :: typed.namespace_exports[mod_id] ?? return null
    result :: exports[e.field]
    if result != null {
        return result
    }
    // Exported miss : if the base binding names a PRIVATE member, fire R2008 and
    // return TY_UNRESOLVED (suppresses the cascade). Otherwise fall through with
    // null to the ordinary "no such field" handling. The base is a namespace
    // ImportBinding here (namespace_call_mod_id succeeded), so re-resolve its sym.
    if e.target is AST.IdentExpr {
        binding :: typed.resolved.idents[e.target.span.hash()]
        if binding != null {
            if namespace_private_member_reported(
                binding.id,
                e.field,
                e.field_span,
                typed.resolved,
                diags,
            ) {
                return TY_UNRESOLVED
            }
        }
    }
    return null
}

// Resolve a `mod.field` FieldExpr's base to the imported module id, or null
// when the base isn't a namespace import binding. Shared by `try_namespace_field`
// (value type) and `call.vader::namespace_member_params` (decl params).
namespace_call_mod_id :: fn(e: AST.FieldExpr, typed: TypedProgram) = namespace_base_mod_id(
    e.target,
    typed,
)

/// Module id behind a namespace base expr — the `mod` in a `mod.field` access,
/// where `mod` is an `import "p"` namespace binding. Null when `base` isn't such
/// a binding. Exported so the LSP can list a namespace alias's exports on
/// `mod.<member>` completion (shared with `namespace_call_mod_id`).
export namespace_base_mod_id :: fn(base: AST.Expr, typed: TypedProgram) -> string | null {
    if base !is AST.IdentExpr {
        return null
    }
    sym :: typed.resolved.idents[base.span.hash()] ?? return null
    if sym.kind != .ImportBinding {
        return null
    }
    targets :: typed.import_targets ?? return null
    return targets.namespace_targets[sym.id]
}

/// Method names declared by a type parameter's bound trait(s) — a single trait
/// or an `A & B` chain. For LSP completion on a `t.<member>` receiver typed as
/// that param (`t: T` where `T: Display` → `to_string`). Empty when the param is
/// unbound or its bound doesn't resolve to a trait.
export typeparam_bound_method_names :: fn(tp: TypeParamType, typed: TypedProgram) -> string[] {
    bound :: typed.resolved.type_param_bounds[tp.symbol.id] ?? return []
    out: string[]: []
    collect_bound_method_names(bound, typed, out)
    return out
}

// Append every trait-method name reachable through `bound` (single trait or
// `A & B`) into `out`. Mirrors `bound_trait_declaring`'s bound walk.
collect_bound_method_names :: fn(bound: AST.Expr, typed: TypedProgram, out: string[]) -> void {
    if bound is AST.BinaryExpr {
        if bound.op == .BitAnd {
            collect_bound_method_names(bound.left, typed, out)
            collect_bound_method_names(bound.right, typed, out)
            return
        }
    }
    bound_ty :: type_from_expr(bound, typed.resolved, [])
    if bound_ty is TraitType {
        decl :: typed.trait_decls[bound_ty.symbol.id] ?? return
        for m in decl.members {
            out.push(m.name)
        }
    }
}

/// Walk a struct's fields for `name` and return the resolved field type,
/// or `null` if the field doesn't exist. Shared with `struct_lit.vader`
/// so the lookup convention stays in one place — generic substitution,
/// when it lands, plugs in here.
find_struct_field_type :: fn(
    decl: AST.StructDecl,
    name: string,
    resolved: ResolvedModule,
    diags: Diagnostic[],
) -> Type | null {
    for field in decl.fields {
        if field.name == name {
            return type_from_expr(field.ty, resolved, diags)
        }
    }
    return null
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "toolchain/span"
import "vader/parser"

accept_field :: fn(e: AST.Expr) -> AST.Expr | null {
    if e is AST.FieldExpr {
        return e
    }
    return null
}

FieldFixture :: struct {
    typed: TypedProgram
    field: AST.FieldExpr | null
}

first_field_in_last_fn :: fn(src: string) -> FieldFixture {
    parsed :: parse_source(src, "t.vader")
    factory :: SymbolFactory {}
    rm :: resolve_module(parsed.program, "t", factory)
    diags: Diagnostic[]: []
    result :: check_module(parsed.program, rm, diags)
    last :: parsed.program.decls[parsed.program.decls.len() - 1]
    if last is AST.FnDecl {
        match last.body as b {
            is null          -> {
                return FieldFixture { .typed = result.typed, .field = null }
            }
            is AST.BlockExpr -> {
                hit :: find_first_in_block(b, accept_field)
                field: AST.FieldExpr | null = null
                if hit is AST.FieldExpr {
                    field = hit
                }
                return FieldFixture { .typed = result.typed, .field = field }
            }
        }
    }
    return FieldFixture { .typed = result.typed, .field = null }
}

@test
test_field_on_struct_returns_field_type :: fn() -> void {
    src :: """
Point :: struct {
    x: i32
    y: i32
}
get_x :: fn(p: Point) -> i32 { return p.x }
"""
    fx :: first_field_in_last_fn(src)
    match fx.field as f {
        is null          -> { assert(false, "expected a field expr") }
        is AST.FieldExpr -> {
            diags: Diagnostic[]: []
            assert_eq(display_type(infer_field(f, null, fx.typed, diags)), "i32")
            assert_eq(diags.len(), 0)
        }
    }
}

@test
test_field_missing_emits_T3009 :: fn() -> void {
    src :: """
Point :: struct {
    x: i32
}
get_z :: fn(p: Point) -> i32 { return p.z }
"""
    fx :: first_field_in_last_fn(src)
    match fx.field as f {
        is null          -> { assert(false, "expected a field expr") }
        is AST.FieldExpr -> {
            diags: Diagnostic[]: []
            infer_field(f, null, fx.typed, diags)
            assert(diags.len() >= 1, "expected a diagnostic")
            assert_eq(diags[0].code.id, "T3009")
        }
    }
}

@test
test_field_on_non_struct_emits_T3008 :: fn() -> void {
    src :: """
f :: fn(n: i32) -> i32 { return n.x }
"""
    fx :: first_field_in_last_fn(src)
    match fx.field as f {
        is null          -> { assert(false, "expected a field expr") }
        is AST.FieldExpr -> {
            diags: Diagnostic[]: []
            infer_field(f, null, fx.typed, diags)
            assert(diags.len() >= 1, "expected a diagnostic")
            assert_eq(diags[0].code.id, "T3008")
        }
    }
}
