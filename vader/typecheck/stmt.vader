// vader/typecheck/stmt — statement + block + fn-body checking.
//
// Walks every statement of a fn body, types each one, tracks loop
// depth + return type via `FnContext`, and writes results into
// `local_types` / `expr_types`. Stops short of W0002 dead-code
// detection, T3041 mutate-`::`-local, IndexSet dispatch, custom
// Iterator trait lookup, `comptime for` unrolling, and `Self`
// substitution — those land with later phases.

module "vader/typecheck"

import "std/collections"
import "vader/diagnostics"
AST :: import "toolchain/ast"
import "vader/types"

/// Check every statement in `block`, then type the trailing expression
/// (or `void` when none). Writes the block's type into `expr_types`.
/// `ctx` carries the surrounding fn's return type + loop depth ;
/// pass `null` for stand-alone block exprs.
export check_block :: fn(
    block: AST.BlockExpr,
    expected: Type | null,
    typed: TypedProgram,
    diags: Diagnostic[],
    ctx: FnContext | null,
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> Type {
    // Track flow-narrowing pushed by divergent guards (`if x is T
    // { return … }`) so subsequent stmts see the complement type ; each
    // entry holds what to restore on block exit.
    divergent_narrows: PushedNarrow[]: []
    // W0002 — track the first stmt past a divergent guard so we can
    // warn once per block.
    first_unreachable_span: Span | null = null
    diverged := false
    for stmt in block.stmts {
        if diverged && first_unreachable_span is null {
            first_unreachable_span = stmt_span(stmt)
        }
        check_stmt(stmt, typed, diags, ctx, check_expr_fn)
        if !diverged && is_divergent_stmt(stmt, typed) {
            diverged = true
        }
        push_divergent_narrow_if(stmt, typed, divergent_narrows)
    }
    if diverged && first_unreachable_span is null {
        if block.trailing !is null {
            first_unreachable_span = block.trailing.span
        }
    }
    if first_unreachable_span !is null {
        diags.push(
            warning(.UnreachableCode, first_unreachable_span, "code after a divergent statement"),
        )
    }
    result: Type = TY_VOID
    match block.trailing {
        is null -> {
            // Diverged block (last stmt is `return` / `break` /
            // `continue`) carries `Never` so callers (`infer_if`,
            // `infer_match`) collapse the union arm cleanly.
            if block.stmts.len() > 0 {
                last :: block.stmts[block.stmts.len() - 1]
                if is_divergent_stmt(last, typed) { result = TY_NEVER }
            }
        }
        _       -> { result = check_expr_fn(block.trailing, expected, typed, diags) }
    }
    // Restore the binding's static type on block exit so outer scopes don't see
    // the narrowed shape. In reverse: a binding several guards narrowed gets back
    // what it had before the first, not what a later guard found.
    pop_narrows(divergent_narrows, typed)
    // Don't clobber the trailing expression's `expr_kinds` entry —
    // expression-bodied fns synthesise a BlockExpr around the trailing
    // with overlapping spans, and the trailing's true kind (BinaryExpr
    // / CallExpr / …) is what callers want to see in the dump.
    // Now keyed by AST id, so the block's id and the trailing expr's
    // id are distinct ; the null-guard remains a defence in depth.
    if typed.dump_types && typed.expr_kinds[block.id] is null {
        typed.expr_kinds[block.id] = "BlockExpr"
    }
    if typed.expr_types[block.id] is null {
        typed.expr_types[block.id] = result
        if typed.dump_types {
            typed.node_spans[block.id] = block.span
        }
    }
    return result
}

/// Type-check a single statement. Reads `ctx` for `return` / `break` /
/// `continue` validation ; writes `local_types` for let-bindings.
export check_stmt :: fn(
    stmt: AST.Stmt,
    typed: TypedProgram,
    diags: Diagnostic[],
    ctx: FnContext | null,
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> void {
    match stmt {
        is AST.LetStmt               -> { check_let(stmt, typed, diags, check_expr_fn) }
        is AST.AssignStmt            -> { check_assign(stmt, typed, diags, check_expr_fn) }
        is AST.DestructureAssignStmt -> {
            check_destructuring_assign(stmt, typed, diags, check_expr_fn)
        }
        is AST.ExprStmt              -> { check_expr_fn(stmt.expr, null, typed, diags) }
        is AST.ReturnStmt            -> { check_return(stmt, typed, diags, ctx, check_expr_fn) }
        is AST.YieldStmt             -> {
            check_yield(stmt, typed, diags, ctx, check_expr_fn)
            retire_narrowings_across_call(typed)
        }
        is AST.ForStmt               -> { check_for(stmt, typed, diags, ctx, check_expr_fn) }
        is AST.BreakStmt             -> {
            check_loop_jump(stmt.span, stmt.id, stmt.label, typed, ctx, diags)
        }
        is AST.ContinueStmt          -> {
            check_loop_jump(stmt.span, stmt.id, stmt.label, typed, ctx, diags)
        }
        is AST.DeferStmt             -> { check_defer(stmt, typed, diags, ctx, check_expr_fn) }
    }
    return
}

/// True when `fn_decl` is a generator — i.e. it lexically `yield`s. Generator-ness
/// is INFERRED from `yield` (no annotation needed, mirror of `fn_is_async`) ; a
/// generator expresses it in the signature by returning `Iterator<T>` (T3056).
/// Local + syntactic, so it resolves the same at a definition and at a call site.
export fn_is_generator :: fn(fn_decl: AST.FnDecl) -> bool {
    b :: fn_decl.body ?? return false
    return block_has_yield(b)
}

/// True when `fn_decl` is an async coroutine — i.e. it lexically `await`s.
/// Async-ness is INFERRED from `await` (no annotation needed) ; a coroutine
/// expresses it in the signature by returning `Async<T>`. Local + syntactic, so
/// it resolves the same at a definition and at a cross-module call site.
export fn_is_async :: fn(fn_decl: AST.FnDecl) -> bool {
    b :: fn_decl.body ?? return false
    return block_has_await(b)
}

// Whether a block lexically contains an `await` (recursively, but NOT descending
// into nested lambdas — a lambda's own `await` doesn't color the enclosing fn).
block_has_await :: fn(b: AST.BlockExpr) -> bool {
    for s in b.stmts {
        if stmt_has_await(s) {
            return true
        }
    }
    trailing :: b.trailing ?? return false
    return expr_has_await(trailing)
}

stmt_has_await :: fn(s: AST.Stmt) -> bool = @partial match s {
    is AST.LetStmt               -> { return expr_has_await(s.value) }
    is AST.AssignStmt            -> { return expr_has_await(s.target) || expr_has_await(s.value) }
    is AST.DestructureAssignStmt -> {
        for place in AST.assign_places(s) {
            if expr_has_await(place) {
                return true
            }
        }
        return expr_has_await(s.value)
    }
    is AST.ExprStmt              -> { return expr_has_await(s.expr) }
    is AST.ReturnStmt            -> {
        // @partial: only expr-carrying statements can hold an `await`; break /
        // continue / defer / yield can't reach one in a coroutine body.

        rv :: s.value ?? return false
        return expr_has_await(rv)
    }
    is AST.ForStmt               -> { return for_form_has_await(s.form) || block_has_await(s.body) }
    _                            -> { return false }
}

// Whether a for-form's iterable / condition expr carries an `await` (the
// infinite form has neither).
for_form_has_await :: fn(form: AST.ForForm) -> bool = match form {
    is AST.InFor       -> { return expr_has_await(form.iter) }
    is AST.WhileFor    -> { return expr_has_await(form.cond) }
    is AST.InfiniteFor -> { return false }
}

expr_has_await :: fn(e: AST.Expr) -> bool = @partial match e {
    is AST.AwaitExpr  -> { return true }
    is AST.BinaryExpr -> { return expr_has_await(e.left) || expr_has_await(e.right) }
    is AST.UnaryExpr  -> { return expr_has_await(e.operand) }
    is AST.CastExpr   -> { return expr_has_await(e.value) }
    is AST.IndexExpr  -> { return expr_has_await(e.target) || expr_has_await(e.index) }
    is AST.FieldExpr  -> { return expr_has_await(e.target) }
    is AST.RangeExpr  -> { return expr_has_await(e.lower) || expr_has_await(e.upper) }
    is AST.BlockExpr  -> { return block_has_await(e) }
    is AST.CallExpr   -> {
        // @partial: leaf/type-position exprs can't carry a top-level `await`, and
        // LambdaExpr is deliberately NOT descended (a lambda can't be async in v1,
        // and an await inside it doesn't color the enclosing fn).

        if expr_has_await(e.callee) {
            return true
        }
        for a in e.args {
            if expr_has_await(a.value) {
                return true
            }
        }
        return false
    }
    is AST.IfExpr        -> {
        if expr_has_await(e.cond)        { return true }
        if block_has_await(e.then_block) { return true }
        match e.else_branch as ei {
            is AST.IfElseIf    -> { return expr_has_await(ei.branch) }
            is AST.IfElseBlock -> { return block_has_await(ei.block) }
            is null            -> { return false }
        }
    }
    is AST.MatchExpr     -> {
        if expr_has_await(e.scrutinee) {
            return true
        }
        for a in e.arms {
            if expr_has_await(a.body) {
                return true
            }
        }
        return false
    }
    is AST.StructLitExpr -> {
        for item in e.items {
            match item {
                is AST.StructLitField -> {
                    if expr_has_await(item.value) {
                        return true
                    }
                }
                is AST.StructLitSpread -> {
                    if expr_has_await(item.expr) {
                        return true
                    }
                }
            }
        }
        return false
    }
    is AST.SeqLitExpr    -> {
        for el in e.elements {
            if expr_has_await(el) {
                return true
            }
        }
        return false
    }
    _                         -> { return false }
}

/// Element type `T` of a generator's `-> Iterator<T>` return, or `null`
/// (plus a T3056 diagnostic) when the return type isn't a valid
/// `Iterator<T>`. A function that `yield`s must honour it with an
/// `Iterator<T>` return.
generator_element_type :: fn(fn_decl: AST.FnDecl, return_type: Type, diags: Diagnostic[]) -> Type | null {
    if return_type is TraitType {
        if return_type.symbol.name == TRAIT_ITERATOR && return_type.args.len() > 0 {
            return return_type.args[0]
        }
    }
    diags.push(
        typecheck_error(
            .GeneratorReturnMustBeIterator,
            fn_decl.name_span,
            "`${fn_decl.name}` yields but returns ${display_type(return_type)}",
        ),
    )
    return null
}

/// True when any statement in `block` (recursively, through nested
/// blocks / loops / ifs / matches / defers) is a `yield`. Nested lambdas
/// are NOT descended into — a `yield` there is illegal anyway.
block_has_yield :: fn(block: AST.BlockExpr) -> bool {
    for s in block.stmts {
        if stmt_has_yield(s) {
            return true
        }
    }
    // A trailing `if` / `match` / nested block (e.g. a for-body whose only
    // item is `if p { yield x }`) parses as the block's trailing expr, not a
    // stmt — descend it too.
    if block.trailing !is null {
        if expr_has_yield(block.trailing) {
            return true
        }
    }
    return false
}

/// True when `s` is, or holds, a `yield` — through nested blocks, loops, ifs,
/// matches and defers, not lambdas.
///
/// @param s  the statement to scan.
export stmt_has_yield :: fn(s: AST.Stmt) -> bool = match s {
    is AST.YieldStmt             -> { return true }
    is AST.ForStmt               -> { return block_has_yield(s.body) }
    is AST.DeferStmt             -> {
        match s.body as b {
            is AST.DeferStmtBody  -> { return stmt_has_yield(b.stmt) }
            is AST.DeferBlockBody -> { return block_has_yield(b.block) }
        }
    }
    is AST.LetStmt               -> { return false }
    is AST.AssignStmt            -> { return false }
    is AST.DestructureAssignStmt -> { return false }
    is AST.ExprStmt              -> { return expr_has_yield(s.expr) }
    is AST.ReturnStmt            -> {
        if s.value == null {
            return false
        }
        return expr_has_yield(s.value)
    }
    is AST.BreakStmt             -> { return false }
    is AST.ContinueStmt          -> { return false }
}

/// True when `e` holds a `yield` — inside a block / if / match used in statement
/// position (`yield` is a statement, so it only appears in a block's stmt list),
/// not inside a lambda.
///
/// @param e  the expression to scan.
export expr_has_yield :: fn(e: AST.Expr) -> bool = match e {
    is AST.BlockExpr -> { return block_has_yield(e) }
    is AST.IfExpr -> { return if_has_yield(e) }
    is AST.MatchExpr -> {
        for arm in e.arms {
            if expr_has_yield(arm.body) {
                return true
            }
        }
        return false
    }
    is AST.NullCoalesceExpr -> {
        if expr_has_yield(e.left) {
            return true
        }
        inner :: AST.coalesce_fallback_expr(e.fallback) ?? return false
        return expr_has_yield(inner)
    }
    is AST.IntLitExpr | AST.FloatLitExpr | AST.BoolLitExpr | AST.NullLitExpr | AST.CharLitExpr | AST.StringLitExpr | AST.IdentExpr | AST.CallExpr | AST.FieldExpr | AST.IndexExpr | AST.UnaryExpr | AST.BinaryExpr | AST.LambdaExpr | AST.StructLitExpr | AST.SeqLitExpr | AST.RangeExpr | AST.CastExpr | AST.GenericInstExpr | AST.IntrinsicCallExpr | AST.DotVariantExpr | AST.FnTypeExpr | AST.ArrayTypeExpr | AST.MutableTypeExpr | AST.AwaitExpr -> { return false }
}
// No other expression form carries a statement block a `yield` could
// live in ; a LambdaExpr body is deliberately NOT descended (a `yield`
// there is illegal — T3059 — so it must not count for the enclosing
// generator's yield check). Exhaustive so a new block-bearing Expr
// variant trips T3013 here rather than being silently missed.

if_has_yield :: fn(i: AST.IfExpr) -> bool {
    if block_has_yield(i.then_block) {
        return true
    }
    match i.else_branch as e {
        is null            -> { return false }
        is AST.IfElseIf    -> { return if_has_yield(e.branch) }
        is AST.IfElseBlock -> { return block_has_yield(e.block) }
    }
}

// The symbol ids of the type parameters `params` declares.
type_param_ids :: fn(params: AST.TypeParam[], typed: TypedProgram) -> i32[]! {
    ids: i32[]: []
    for tp in params {
        sym :: typed.resolved.idents[tp.span.hash()] ?? continue
        ids.push(sym.id)
    }
    return ids
}

/// Type-check a fn body. Reads the fn's declared return type from
/// `decl_types`, builds an initial `FnContext`, then walks the body.
/// Final-expression / implicit-return type-checking happens through
/// the trailing-expr arm of `check_block`. `impl_type_params` are the enclosing
/// impl's, fixed in the body like the fn's own (`FnContext.type_params_in_scope`).
export check_fn_body :: fn(
    fn_decl: AST.FnDecl,
    body: AST.BlockExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
    impl_type_params: i32[] = [],
) -> void {
    return_type :: lookup_return_type(fn_decl, typed)
    is_generator :: fn_is_generator(fn_decl)
    is_async :: fn_is_async(fn_decl)
    // Generators are inferred from a body `yield` (`is_generator`), so the
    // signature must honour it with an `Iterator<T>` return : extract that
    // element type (T3056 if the return isn't `Iterator<T>`). The body yields
    // rather than returning the iterator, so the missing-return / trailing-return
    // check below is suppressed.
    yield_type: Type | null = null
    if is_generator {
        yield_type = generator_element_type(fn_decl, return_type, diags)
    }
    // Expression-bodied without explicit return type : infer from
    // the trailing expression. `declare_fn_return` leaves this as
    // TY_UNRESOLVED ; we resolve it here and patch `decl_types` so
    // call sites see the inferred type.
    inferred_return :: fn_decl.is_expression_bodied && return_type is UnresolvedType
    // An async coroutine's body produces the inner `T` of `Async<T>` (the frame
    // wraps it), so check its returns / trailing against `T`, not the erased
    // return. Transitional `async fn -> T` has inner == T (no-op) ; generators
    // keep the raw return (they yield, never return the stream).
    effective_return :: if is_async && !is_generator { async_inner_type(return_type) } else { return_type }
    expected: Type | null = effective_return
    if inferred_return {
        expected = null
    }
    ctx :: FnContext {
        .return_type = effective_return,
        .self_type = null,
        .loop_depth = 0,
        .fn_id = fn_decl.id,
        .type_params_in_scope = impl_type_params + type_param_ids(fn_decl.type_params, typed),
        .is_generator = is_generator,
        .yield_type = yield_type,
        .is_async = is_async,
    }
    prev :: typed.current_fn_ctx
    typed.current_fn_ctx = ctx
    got :: check_block(body, expected, typed, diags, ctx, check_expr_fn)
    if is_generator {
        // A generator returns its stream via `yield`, not the trailing
        // expression — skip the implicit-return obligation entirely.
    } else if inferred_return {
        // Recursive fns leave their return as `?` — the body's
        // inferred type contains an Unresolved leaf (the recursive
        // call) so substituting would just amplify the unresolved-
        // ness. Surface T3034 instead.
        if contains_unresolved(got) {
            diags.push(
                typecheck_error(.RecursiveExprBodiedFn, fn_decl.name_span, "`${fn_decl.name}`"),
            )
        } else {
            defaulted :: default_free_members(got)
            patch_fn_return_type(fn_decl, defaulted, typed)
        }
    } else {
        // Implicit-return : a trailing expression substitutes for an
        // explicit `return`. Surface T3020 against the trailing's span.
        if body.trailing !is null {
            emit_return_mismatch_if(
                got,
                effective_return,
                body.trailing.span,
                body.trailing,
                typed,
                diags,
            )
        } else if got !is NeverType {
            // T3083 — no trailing expression, and the body does not diverge, so
            // control reaches the closing brace with nothing to hand back. The
            // sibling case (a value of the WRONG type) is T3020 just above;
            // without this arm the two halves disagreed, since `if c { return 7 }`
            // was already an error while a body with no `return` at all was not.
            //
            // `got` is `never` exactly when `check_block` saw the last statement
            // diverge — a `return` / `break` / `continue`, a `@no_return` call, or
            // a loop nothing can leave.
            if !is_void(effective_return) && effective_return !is UnresolvedType {
                diags.push(
                    typecheck_error(
                        .BodyFallsOffEnd, fn_decl.name_span,
                        "`${fn_decl.name}` promises ${display_type(effective_return)}",
                    ),
                )
            }
        }
    }
    typed.current_fn_ctx = prev
}

patch_fn_return_type :: fn(fn_decl: AST.FnDecl, ret: Type, typed: TypedProgram) -> void {
    sym :: lookup_decl_symbol_stmt(typed.resolved, fn_decl)
    match sym {
        is Symbol -> {
            cur :: typed.decl_types[sym.id]
            match cur {
                is FnType -> { typed.decl_types[sym.id] = mk_fn_like(cur, cur.params, ret) }
                _         -> {}
            }
        }
        is null        -> {
            // Impl method — patch the span-keyed table.
            sp_key :: fn_decl.name_span.hash()
            cur :: typed.impl_method_decl_types[sp_key]
            match cur {
                is FnType -> { typed.impl_method_decl_types[sp_key] = mk_fn_like(cur, cur.params, ret) }
                _         -> {}
            }
        }
    }
}

lookup_decl_symbol_stmt :: fn(resolved: ResolvedModule, fd: AST.FnDecl) -> Symbol | null {
    // Match by span to support overloaded fns.
    bucket :: resolved.fn_overloads[fd.name]
    if bucket !is null {
        for s in bucket {
            sp :: s.defined_at ?? continue
            if sp.start.line == fd.name_span.start.line && sp.start.column == fd.name_span.start.column {
                return s
            }
        }
    }
    for s in resolved.symbols {
        if s.name == fd.name {
            return s
        }
    }
    return null
}

contains_unresolved :: fn(t: Type) -> bool = @partial match t {
    is UnresolvedType -> { return true }
    is UnionType      -> {
        // @partial: only the composite type variants can carry an Unresolved leaf;
        // every scalar / primitive variant is unresolved-free, so `false` is right.

        for v in t.variants {
            if contains_unresolved(v) {
                return true
            }
        }
        return false
    }
    is ArrayType -> { return contains_unresolved(t.element) }
    is FnType    -> {
        for p in t.params {
            if contains_unresolved(p) {
                return true
            }
        }
        return contains_unresolved(t.return_type)
    }
    is TupleType  -> {
        for el in t.elements {
            if contains_unresolved(el) {
                return true
            }
        }
        return false
    }
    is StructType -> {
        for a in t.args {
            if contains_unresolved(a) {
                return true
            }
        }
        return false
    }
    _                  -> { return false }
}

// Push T3020 when `got` doesn't flow into `expected`. Shared between
// `check_return` and the implicit-return check in `check_fn_body` so
// wording / arity stay in sync.
emit_return_mismatch_if :: fn(
    got: Type,
    expected: Type,
    span: Span,
    value: AST.Expr | null,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void = emit_mismatch_if(got, expected, span, value, .BodyReturnIncompatible, typed, diags)

// The one coercion gate shared by let / return / yield / assign : `got` flows
// into `expected` when it is assignable, or `Into`-coercible. `is_assignable`
// runs first so `try_into`'s LSP into-hint side effect stays off the already-
// assignable path. `value` is the value expr, where that hint and the `into` site
// are recorded.
//
// Kept brace-bodied on purpose: the equivalent single-expr form
// (`= is_assignable(...) || try_into(...)`) is inlined by the single-expr
// inliner, and the committed bootstrap seed mis-interns a type through that
// inline (an unrelated array element collapses to `?` in
// `check_block`, tripping the emit-time field-access panic). The current
// compiler handles the single-expr form fine; the seed does not. Leave it
// brace-bodied until the seed is advanced past that inliner/interning bug.
flows_into :: fn(got: Type, expected: Type, value: AST.Expr, typed: TypedProgram) -> bool {
    if is_assignable(got, expected) {
        return true
    }
    return try_into(got, expected, typed, value)
}

// Push `code` when `got` doesn't flow into `expected` — neither assignable nor
// `Into`-coercible. Shared by the return / yield mismatch checks and by field
// defaults so wording stays in sync ; only the diagnostic code differs. `value` is the coerced
// expression — its id feeds `try_into`'s LSP into-hint table, and it names the
// declaration to reopen on a mutability-only mismatch. Null for a bare `return`.
emit_mismatch_if :: fn(
    got: Type,
    expected: Type,
    span: Span,
    value: AST.Expr | null,
    code: TypecheckCode,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    fits :: if value == null {
        is_assignable(got, expected)
    } else {
        flows_into(got, expected, value, typed)
    }
    if fits {
        return
    }
    if value == null {
        diags.push(mismatch_diagnostic(got, expected, span, code, "", typed))
        return
    }
    push_level_mismatch(got, expected, span, code, value, typed, diags)
}

/// Report `value`, of type `got`, failing its slot `expected` — unless the mismatch is a
/// level a deduced `!` grants next round (`note_widening_need`).
///
/// @param code  the code the mismatch takes when it is not about mutability.
export push_level_mismatch :: fn(
    got: Type, expected: Type, span: Span, code: TypecheckCode, value: AST.Expr,
    typed: TypedProgram, diags: Diagnostic[],
) -> void {
    if note_widening_need(value, got, expected, span, typed) {
        return
    }
    hint :: mutability_level_hint(value, got, expected, typed)
    diags.push(mismatch_diagnostic(got, expected, span, code, hint, typed))
}

// Resolve the effective fn-context: the arg-side `ctx` when present, else the
// walk-global `current_fn_ctx` (the recursive `infer_if` / `infer_match` paths
// pass `ctx = null`, so the body's return / yield targets need this fallback).
resolve_ctx :: fn(ctx: FnContext | null, typed: TypedProgram) -> FnContext! | null {
    if ctx != null {
        return ctx
    }
    return typed.current_fn_ctx
}

// ---- per-stmt helpers -----------------------------------------------------

check_let :: fn(
    s: AST.LetStmt,
    typed: TypedProgram,
    diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> void {
    ann: Type | null = null
    written_ty :: s.ty
    if written_ty !is null {
        // An ANNOTATED local takes the read-only default like every other written
        // slot, so `i32[]` means one thing wherever it appears : the marker is what
        // grants mutation (`out: i32[]! = []`), deduced from the body
        // (`register_local_slot`). An UNANNOTATED local keeps the inferred type —
        // nothing was written, and a local is owned.
        register_local_slot(s, typed)
        // `register_local_slot` rewrites `s.ty` : the annotation is read after it.
        rewritten :: s.ty ?? written_ty
        ann = apply_readonly_default(type_from_expr(rewritten, typed.resolved, diags), rewritten)
    } else if s.value is AST.LambdaExpr && s.binding is AST.SimpleBinding {
        register_local_fn(s.value, s.binding.name, typed)
    }
    got :: check_expr_fn(s.value, ann, typed, diags)
    if ann != null && s.binding is AST.SimpleBinding {
        note_fill_edge(s.binding.name_span, s.value, got, ann, s.span, typed)
    }
    record_local_producer(s, typed)
    declared: Type = TY_UNRESOLVED
    if ann == null {
        declared = default_free_members(got)
    } else {
        declared = ann
        if !flows_into(got, ann, s.value, typed) {
            push_level_mismatch(got, ann, s.span, .TypeMismatch, s.value, typed, diags)
        }
    }
    // Layer 5b — `t :: <type-expr>` inside a fn body is an in-fn type
    // alias : pre-resolve the underlying Type and stash it in
    // `typed.let_type_aliases` keyed by the binding's Symbol.id.
    // Downstream type-position references (e.g. `@size_of(t)`) read
    // through this map at lower time. Detection mirrors the
    // top-level `register_alias_const` path.
    is_let_type_alias := false
    if !s.mutable && declared is TypeMetaType {
        if s.binding is AST.SimpleBinding as sb {
            if is_type_expr(s.value, typed.resolved) {
                sym_or_null :: typed.resolved.idents[sb.name_span.hash()]
                if sym_or_null is Symbol {
                    resolved_type :: type_from_expr(s.value, typed.resolved, diag_sink_stmt())
                    typed.let_type_aliases[sym_or_null.id] = resolved_type
                    is_let_type_alias = true
                }
            }
        }
    }
    // T3035 : reject `type`-valued slots that aren't in-fn type aliases.
    // The mutable form (`name := <type-expr>`) always fails since
    // it implies a runtime Type value — Layer 4 milestone B.1 doesn't
    // ship those yet. The immutable form fails only when the RHS
    // isn't a structural type expression (e.g. a fn call returning
    // type), since we can't pre-resolve it without VM execution.
    if declared is TypeMetaType && !is_let_type_alias {
        diags.push(
            typecheck_error(
                .TypeValuedSlotNotYetSupported,
                s.span,
                "`type`-valued locals are not yet supported (Layer 4 milestone B.1) ; use the immutable form `name :: <type-expr>` for an in-fn type alias, or a top-level alias `Name :: type[T] ...`",
            ),
        )
    }
    assign_binding_types(s.binding, declared, typed, diags)
    // `buf: Iterator<i32>!: xs` walks a fresh iterator : `buf` borrows nothing of `xs`.
    if !converts_to_owned(got, declared, typed) {
        record_binding_value(s.binding, s.value, typed)
    }
    record_empty_array_init(s, declared, typed)
}

// Record the value a local bound to a single name stands for (`local_bound_to`), and
// keep a local initialised FROM an immutable borrow borrowing — `m := a` shares
// `a`'s reference, so letting `m` be owned would make the whole read-only default
// decorative: `m[0] = 9` would reach the caller's array through a one-line detour.
//
// This is the local counterpart of `mark_loop_var_borrow`, and the same reason it
// lives in typecheck rather than the resolver: deciding it needs
// `expr_is_immutable`, hence the types.
//
// Only a WHOLE-value rebind propagates. A tuple destructure takes elements APART,
// and an element of an immutable aggregate is reached through the path predicate
// already, so nothing is lost by not marking the leaves here.
record_binding_value :: fn(b: AST.LetBinding, value: AST.Expr, typed: TypedProgram) -> void {
    if b !is AST.SimpleBinding {
        return
    }
    sym :: typed.resolved.idents[b.name_span.hash()] ?? return
    typed.local_bound_to[sym.id] = value
    if expr_is_immutable(value, typed) {
        typed.resolved.immutable_borrows[sym.id] = true
    }
}

// `x := []` : remember which expression the `?[]` came from, so the first
// `x.push(elem)` can widen the LITERAL as well as the local (see
// `TypedProgram.empty_array_inits`).
record_empty_array_init :: fn(s: AST.LetStmt, declared: Type, typed: TypedProgram) -> void {
    if declared !is ArrayType {
        return
    }
    if declared.element !is UnresolvedType {
        return
    }
    if s.binding !is AST.SimpleBinding {
        return
    }
    typed.empty_array_inits[s.binding.name_span.hash()] = s.value.id
}

import "vader/resolver/symbol"

check_assign :: fn(
    s: AST.AssignStmt,
    typed: TypedProgram,
    diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> void {
    // T3041 : bare-ident assignment to a `::`-bound local or a module constant.
    // Surface the diag and skip the value-side typing so the dump doesn't carry
    // extra expr_types for a rejected write.
    target :: s.target
    if target is AST.IdentExpr && reject_const_reassign(target, typed, diags) {
        return
    }
    // T3082 : a name, a field or an element is a place ; a call, a literal or what
    // an operator computes is not (`get() = 3`, `xs.len() = 5`, `1 = 2`).
    if target !is AST.IdentExpr && target !is AST.FieldExpr && target !is AST.IndexExpr {
        diags.push(typecheck_error(.InvalidAssignTarget, target.span,
            "an assignment writes to a name, a field or an element, not to this"))
        return
    }
    // T3070 : `p.x = v` reached through an immutable access path — today a
    // module-level const, whose write would otherwise be silently discarded
    // (it has no storage). Deep by construction : `CFG.child.count = 0` is
    // rejected because the predicate walks back to the root.
    if s.target is AST.FieldExpr as fe {
        if reject_field_write(fe, typed, diags, check_expr_fn) {
            return
        }
    }
    if target is AST.IndexExpr {
        // Pin a free-literal write value to the slot (`m[k] = 9000000000`) and check
        // the write fits it.
        slot :: index_write_slot(target, typed, diags, check_expr_fn) ?? return
        value_ty :: check_expr_fn(s.value, slot, typed, diags)
        note_store_edge(target.target, s.value, value_ty, s.span, typed)
        emit_assign_mismatch_if(value_ty, slot, s.span, s.value, typed, diags)
        // Past an array, the write runs a user `IndexSet`'s `set_at` : a call.
        if typed.expr_types[target.target.id] !is ArrayType {
            retire_narrowings_across_call(typed)
        }
        return
    }
    target_ty :: check_expr_fn(s.target, null, typed, diags)
    value_hint: Type | null = null
    if target_ty !is UnresolvedType {
        value_hint = target_ty
    }
    value_ty :: check_expr_fn(s.value, value_hint, typed, diags)
    // Enforce the slot's *declared* type — not `target_ty`, which may be a
    // flow-narrowing. `x: A|B = a ; if x is A { x = b_value }` is legal (the
    // write retires the narrowing, per `invalidate_narrow_on_assign`), so the
    // assignability check must target the declaration, not the narrowed view.
    declared :: declared_lvalue_type(s.target, target_ty, typed)
    if s.target is AST.IdentExpr {
        note_fill_edge(s.target.span, s.value, value_ty, declared, s.span, typed)
    }
    emit_assign_mismatch_if(value_ty, declared, s.span, s.value, typed, diags)
    // A write to a narrowed binding / field chain retires its stale
    // narrowings — see `narrow.vader::invalidate_narrow_on_assign`.
    invalidate_narrow_on_assign(s.target, value_ty, typed)
    return
}

// Declared (pre-narrow) type of an assignment LHS — the slot type a write
// must be assignable to. `type_of_symbol` skips the narrowing that
// `infer_ident` layers on ; `declared_struct_field_type` skips
// `narrow_field_if_active`. Any other lvalue shape (or an unresolved
// lookup) falls back to `fallback` — the checked target type — which
// already equals the declared type whenever no narrowing is active.
//
// Narrowing attaches to *only* `IdentExpr` and `FieldExpr` — the exact two
// shapes handled explicitly — so `fallback` diverges from the declaration
// only for those, and only while a narrowing is live. When the relevant
// table is empty the fast path returns `fallback` and dodges the re-resolve
// (and, for fields, the `declared_struct_field_type` sink allocation)
// entirely. This must stay in lockstep with `invalidate_narrow_on_assign`
// (`narrow.vader`) — a new narrowable lvalue shape has to be added to both.
declared_lvalue_type :: fn(target: AST.Expr, fallback: Type, typed: TypedProgram) -> Type {
    if target is AST.IdentExpr {
        if typed.narrow.bindings.is_empty() {
            return fallback
        }
        sym :: typed.resolved.idents[target.span.hash()] ?? return fallback
        return type_of_symbol(sym, typed)
    }
    if target is AST.FieldExpr {
        if typed.narrow.fields.is_empty() {
            return fallback
        }
        recv :: typed.expr_types[target.target.id] ?? return fallback
        d :: declared_struct_field_type(recv, target.field, typed) ?? return fallback
        return d
    }
    return fallback
}

// Push T3063 when `got` doesn't flow into the declared slot type `expected`.
// Same gate as `emit_mismatch_if` (via `flows_into`), only the wording and the
// dedicated code differ. A `null` `expected` — e.g. a receiver with no recorded
// `IndexSet` impl — has no declared slot to enforce (the read side already
// surfaced any error), so it no-ops.
emit_assign_mismatch_if :: fn(
    got: Type,
    expected: Type | null,
    span: Span,
    value: AST.Expr,
    typed: TypedProgram,
    diags: Diagnostic[],
    source: AST.Expr | null = null,
) -> void {
    if expected == null                        { return }
    if flows_into(got, expected, value, typed) { return }
    // The value a destructuring writes is an element of its `source`, the lever.
    lever :: if source != null { source } else { value }
    if note_widening_need(lever, got, expected, span, typed) { return }
    // Both mutability families take the dedicated wording — "cannot assign A to a
    // slot of type B" says nothing when A and B differ only by a marker.
    bounds :: typed.type_param_bound_traits
    if fn_mutability_widens(got, expected) || mutability_widens(got, expected, true, bounds) {
        diags.push(mismatch_diagnostic(
            got, expected, span, .AssignTypeMismatch,
            mutability_level_hint(value, got, expected, typed), typed,
        ))
        return
    }
    diags.push(
        typecheck_error(
            .AssignTypeMismatch,
            span,
            "cannot assign a value of type ${display_type(got)} to a slot of type ${display_type(expected)}",
        ),
    )
}

/// Check `[t0, _, ...rest] = value` — one assignment per place, against the
/// element types of a tuple or array `value`.
///
/// Arity is fixed for a tuple and unknown for an array, so only the tuple case
/// can be counted here ; an array too short for its places is a runtime trap on
/// the element read, exactly as `arr[i]` is elsewhere. A `...rest` target
/// receives a fresh array, so it asks for an array source.
check_destructuring_assign :: fn(
    s: AST.DestructureAssignStmt,
    typed: TypedProgram,
    diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> void {
    // `[] = v` — P1023 already reported it.
    if s.targets.len() == 0 {
        return
    }
    // The places are typed FIRST so their slots can be handed to the source as
    // the expected shape : without it a free literal defaults to `i32` and
    // `[u, v] = [1, 2]` over two `usize` slots fails on both elements, where
    // `u = 1` passes. With a rest, the rest's own array type is that shape.
    rest_slot: Type | null = null
    for t in s.targets {
        if t is AST.RestTarget {
            rest_slot = check_expr_fn(t.place, null, typed, diags)
        }
    }
    if rest_slot != null {
        for t in s.targets {
            if t is AST.PlaceTarget {
                _ :: place_slot(t.place, typed, diags, check_expr_fn)
            }
        }
        value_ty :: check_expr_fn(s.value, rest_slot, typed, diags)
        arr :: array_backing(value_ty)
        if arr == null {
            if value_ty !is UnresolvedType {
                got :: display_type(default_if_free(value_ty))
                diags.push(typecheck_error(
                    .TypeMismatch, s.value.span,
                    "a `...rest` target collects from an array, got `${got}`"))
            }
            return
        }
        for t in s.targets {
            match t {
                is AST.PlaceTarget    -> {
                    check_destructure_target(
                        t.place, arr.element, null, typed, diags, check_expr_fn,
                    )
                }
                // The tail is a fresh array, so it is mutable whatever the source.
                is AST.RestTarget     -> {
                    tail :: mk_array(arr.element, false)
                    check_destructure_target(t.place, tail, null, typed, diags, check_expr_fn)
                }
                is AST.WildcardTarget -> {}
            }
        }
        return
    }
    slot_types: Type[]: []
    for t in s.targets {
        match t {
            is AST.PlaceTarget    -> {
                slot_types.push(place_slot(t.place, typed, diags, check_expr_fn))
            }
            is AST.WildcardTarget -> {
                slot_types.push(TY_UNRESOLVED)
            }
            is AST.RestTarget     -> {}
        }
    }
    // A literal of the wrong length is refused on its count alone : checked
    // against the targets' shape it would fail once per element, and read as
    // an array it would lose its arity.
    if s.value is AST.SeqLitExpr as lit {
        if lit.elements.len() != s.targets.len() {
            _ :: check_expr_fn(s.value, null, typed, diags)
            diags.push(typecheck_error(
                .CannotDestructure, s.value.span,
                "a literal of ${lit.elements.len()} elements into ${s.targets.len()} targets"))
            return
        }
    }
    value_ty :: check_expr_fn(s.value, mk_tuple(slot_types, true), typed, diags)
    elem_types :: destructure_element_types(value_ty, s.targets.len())
    if elem_types == null {
        diags.push(typecheck_error(
            .CannotDestructure, s.value.span,
            "cannot destructure `${display_type(value_ty)}` into ${s.targets.len()} elements"))
        return
    }
    for i in 0..<s.targets.len() {
        if s.targets[i] is AST.PlaceTarget as t {
            source :: destructured_element(s.value, i)
            check_destructure_target(t.place, elem_types[i], source, typed, diags, check_expr_fn)
        }
    }
}

// The slot a destructuring place offers, typed before the source so the source
// takes its shape. An index place is a write : it offers what its receiver stores,
// never what an `Index` read gives back — `check_destructure_target` judges it.
place_slot :: fn(
    place: AST.Expr,
    typed: TypedProgram,
    diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> Type {
    if place !is AST.IndexExpr {
        return check_expr_fn(place, null, typed, diags)
    }
    receiver :: check_expr_fn(place.target, null, typed, diags)
    return index_write_type(receiver, typed) ?? TY_UNRESOLVED
}

/// Element types a destructuring target of `count` elements would read, or null
/// when `value_ty` cannot be destructured that way. A tuple answers per position
/// and must match `count` exactly ; an array answers its element type for every
/// position.
destructure_element_types :: fn(value_ty: Type, count: usize) -> Type[] | null {
    backing :: tuple_backing(value_ty)
    if backing is TupleType {
        if backing.elements.len() != count {
            return null
        }
        return backing.elements
    }
    arr :: array_backing(value_ty)
    if arr is ArrayType {
        out: Type[]: []
        for _ in 0..<count {
            out.push(arr.element)
        }
        return out
    }
    return null
}

// What a write into `ix` must fit, for every write form : its receiver judged
// (`reject_index_write_receiver`) and its key too (`reject_index_key`), an array's
// element, else the `IndexSet` value of a receiver dispatching through the trait
// (`dispatched_index_args`) or of its own impl. Null when the receiver is
// unresolved or the write is refused — reported.
index_write_slot :: fn(
    ix: AST.IndexExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> Type | null {
    set_trait :: core_trait_key(TRAIT_INDEX_SET)
    receiver_ty :: check_expr_fn(ix.target, null, typed, diags)
    // Each route below files what it runs.
    record_site(typed, ix, .IndexWrite, UNSETTLED_CALLEE)
    dispatched :: dispatched_index_args(ix, receiver_ty, set_trait, typed, diags)
    key_ty :: if dispatched != null {
        dispatched[0]
    } else {
        index_key_expected(ix.index, receiver_ty, set_trait, typed)
    }
    index_ty :: check_expr_fn(ix.index, key_ty, typed, diags)
    arr :: stored_array(receiver_ty, typed)
    if reject_index_write_receiver(ix.target, receiver_ty, arr, ix.span, typed, diags) {
        record_site(typed, ix, .IndexWrite, ERRONEOUS_CALLEE)
        return null
    }
    if arr != null {
        record_site(typed, ix, .IndexWrite, BUILTIN_CALLEE)
        // Array elements are never flow-narrowed, so it is the declared slot type
        // the write must fit.
        return array_write_slot(ix, arr, index_ty, typed, diags)
    }
    if dispatched != null {
        reject_index_key(ix.index, index_ty, key_ty, typed, diags)
        return dispatched[1]
    }
    if receiver_ty is UnresolvedType {
        record_site(typed, ix, .IndexWrite, ERRONEOUS_CALLEE)
        return null
    }
    // Nothing stores into a receiver with no `IndexSet` and no array to fall back
    // on : the write would reach its `Index` read, a call.
    if index_route(receiver_ty, set_trait, typed) != .Impl {
        diags.push(
            typecheck_error(
                .NotIndexable, ix.target.span,
                "`${display_type(receiver_ty)}` has no `IndexSet` to write through",
            ),
        )
        record_site(typed, ix, .IndexWrite, ERRONEOUS_CALLEE)
        return null
    }
    if reject_unmet_impl_bounds(
        receiver_ty, set_trait, .TraitNotSatisfied, ix.target.span, typed, diags,
    ) {
        record_site(typed, ix, .IndexWrite, ERRONEOUS_CALLEE)
        return null
    }
    // Files the member, the only one or the one the key picks.
    picked :: pick_index_member(ix, receiver_ty, set_trait, index_ty, typed, diags)
    if picked is UnresolvedType {
        return null
    }
    if picked != null && picked.params.len() > 1 {
        return picked.params[1]
    }
    reject_index_key(ix.index, index_ty, key_ty, typed, diags)
    return index_set_value_expected(receiver_ty, typed) ?? TY_UNRESOLVED
}

// The slot an element write into an array fills : the backing's element, recorded
// on `ix` — never what a distinct's own `Index` would read there (`index_route`).
array_write_slot :: fn(
    ix: AST.IndexExpr, arr: ArrayType, index_ty: Type, typed: TypedProgram, diags: Diagnostic[],
) -> Type {
    if !is_integer_index(index_ty) && index_ty !is UnresolvedType {
        diags.push(typecheck_error(.TypeMismatch, ix.index.span,
            "array index must be an integer, got ${display_type(index_ty)}"))
    }
    record_expr(typed, ix, arr.element)
    return arr.element
}

/// What every write to a field is held to before its value is: T3101 for a
/// tuple's element, then T3070 for a field reached through an immutable path.
/// Checking the CONTAINER first records its type: the level that decides is the
/// field's OWNER, and `expr_types` is empty for it until something checks it.
///
/// @return  whether one reported, the write then going no further.
reject_field_write :: fn(
    field: AST.FieldExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> bool {
    _ :: check_expr_fn(field.target, null, typed, diags)
    // `Color.Red = v`, `Point.x = v` : what a type names is no place (T3082).
    base :: bare_name_symbol(field.target, typed)
    if base != null && is_type_kind(base.kind) {
        diags.push(typecheck_error(.InvalidAssignTarget, field.span,
            "`${field.field}` is reached through the type `${base.name}`, not a value"))
        return true
    }
    // `M.NAME = v` would rebind a declaration of the module `M` names: T3041.
    if namespace_base_mod_id(field.target, typed) != null {
        diags.push(typecheck_error(.CannotReassignConst, field.span,
            "`${field.field}` is declared in an imported module"))
        return true
    }
    if report_tuple_element_write(field, typed, diags) {
        return true
    }
    return push_immutability_diag_for(
        container_is_immutable(field.target, typed), .CannotMutateImmutableBinding,
        field.span, "`${field.field}` is reached through an immutable path",
        field.target, typed, diags,
    )
}

/// T3101 : a tuple's element is never written, whatever the path to the tuple
/// and whatever `!` it carries. A field no position names is left to T3009.
///
/// @return  whether it reported.
report_tuple_element_write :: fn(
    field: AST.FieldExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> bool {
    owner :: typed.expr_types[field.target.id] ?? return false
    tuple :: tuple_backing(owner) ?? return false
    position :: parse_tuple_index(field.field)
    if position < 0 || position >= i32(tuple.elements.len()) {
        return false
    }
    detail :: "build a new `${display_type(owner)}` instead"
    diags.push(typecheck_error(.CannotWriteTupleElement, field.span, detail))
    return true
}

/// One element of a destructuring target. Holds it to the same rules a bare
/// assignment would: a `::` local is still frozen, an immutable path is still
/// closed, and the element type must fit the slot.
check_destructure_target :: fn(
    target: AST.Expr,
    elem_ty: Type,
    source: AST.Expr | null,
    typed: TypedProgram,
    diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> void {
    if target is AST.IdentExpr {
        if reject_const_reassign(target, typed, diags) {
            return
        }
    } else if target is AST.FieldExpr {
        // The same rules a bare `p.x = v` is held to.
        if reject_field_write(target, typed, diags, check_expr_fn) {
            return
        }
    } else if target is AST.IndexExpr {
        // Judged as `m[k] = v` is : skipping it would let a destructuring assignment
        // write through a read-only borrow.
        slot :: index_write_slot(target, typed, diags, check_expr_fn) ?? return
        // The lowering types the element it writes by the target's own type.
        record_expr(typed, target, slot)
        emit_assign_mismatch_if(elem_ty, slot, target.span, target, typed, diags, source)
        return
    } else {
        diags.push(typecheck_error(
            .InvalidAssignTarget, target.span,
            "a destructuring assignment writes to names, fields and indices — not to this"))
        return
    }
    slot_ty :: check_expr_fn(target, elem_ty, typed, diags)
    if source != null && target is AST.IdentExpr {
        note_fill_edge(target.span, source, elem_ty, slot_ty, target.span, typed)
    }
    emit_assign_mismatch_if(elem_ty, slot_ty, target.span, target, typed, diags, source)
}

// The element of a destructured `value` that fills target `i`, when the source is a
// literal that writes one ; null otherwise.
destructured_element :: fn(value: AST.Expr, i: usize) -> AST.Expr | null {
    if value is AST.SeqLitExpr && i < value.elements.len() {
        return value.elements[i]
    }
    return null
}

// T3041 when `ident` names a binding nothing may rebind ; whether it was reported.
reject_const_reassign :: fn(
    ident: AST.IdentExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> bool {
    detail :: const_reassign_detail(ident, typed) ?? return false
    diags.push(typecheck_error(.CannotReassignConst, ident.span, detail))
    return true
}

// T3041's detail for `ident`, null when it may be rebound: a parameter, a binding a
// pattern or an `as` makes, a local declared with `:=`. A `::` local gets the `:=`
// hint. Any other name is a declaration, a module variable included: its `!` frees
// the elements, not the binding.
const_reassign_detail :: fn(ident: AST.IdentExpr, typed: TypedProgram) -> string | null {
    sym :: bare_name_symbol(ident, typed) ?? return null
    return match sym.kind {
        .Param | .Binding -> null
        .Local            -> local_rebind_detail(ident, sym, typed)
        .Const            -> "`${ident.name}` is a module constant"
        .ImportBinding    -> "`${ident.name}` names an imported module"
        .Fn | .Struct | .Enum | .Trait | .Impl | .TypeAlias | .TypeParam | .BuiltinType
            | .BuiltinFn | .Synthetic -> "`${ident.name}` names a ${sym.kind.label}"
    }
}

// T3041's detail for the local `sym`, null when `:=` declared it.
local_rebind_detail :: fn(ident: AST.IdentExpr, sym: Symbol, typed: TypedProgram) -> string | null {
    if typed.resolved.immutable_locals[sym.id] == null {
        return null
    }
    return "`${ident.name}` is declared with `::` ; `:=` allows rebinding"
}

// Immutability of an access path, in detail. Immutability is a property of
// the ACCESS PATH, not of the value : reading a field or element of an immutable
// root yields something immutable too, so this recurses into the target instead
// of consulting a type. That is what catches `CFG.child.count = 0` and
// `CFG.tags[0] = 9` — where the leaf's own type is perfectly mutable.
//
// Roots : a module-level const (NO runtime storage — `lower/inline_consts` rebuilds
// its value at every read site, so a write lands on a throwaway copy and is silently
// discarded), a parameter without `!`, a loop variable over an immutable iterable,
// and an `is T as x` binding whose scrutinee is any of those.
//
// NOT a root : a `::` local. `::` freezes the binding, not the referent — a local
// is OWNED, so `x :: i32[] ; x.push(1)` stays legal. Reassignment is T3041's job.

/// Report a write through an immutable access path, naming the fix.
///
/// The write and the declaration to fix usually sit in different functions, so the
/// message carries `annotate `x!` at file:line:col` — actionable for a reader, and
/// what made the tree-wide migration mechanical.
///
/// Takes `value` rather than a rendered hint because `mutation_fix_hint` is not
/// cheap — half a dozen side-table probes and two root walks — and the answer is
/// discarded on every call that reports nothing, which is nearly all of them.
///
/// @param immutable  whether the path is immutable ; false reports nothing.
/// @param value      the rejected expression, for the fix hint.
/// @return           whether the caller must ABANDON the statement. A rejected write
///                   has no meaningful value left to type.
push_immutability_diag_for :: fn(
    immutable: bool, code: TypecheckCode, span: Span, message: string,
    value: AST.Expr, typed: TypedProgram, diags: Diagnostic[],
) -> bool {
    if !immutable {
        return false
    }
    return refuse_rights(code, span, message, value, "it is written through here", typed, diags)
}

/// Report that `value` lacks the rights it needs here — T3042, T3070, T3071, T3072 —
/// unless a `!` the next round deduces lifts the refusal (`note_slot_need`). A lifted
/// refusal is reported by no round : the caller goes on as if allowed, and the next
/// round checks the rest against the marked parameter.
///
/// @param detail  what is refused ; the fix hint follows it.
/// @param value   the value whose rights fall short.
/// @param what    what happens to `value` here, as a deduced mark's cause words it.
/// @return        whether the refusal is reported.
refuse_rights :: fn(
    code: TypecheckCode, span: Span, detail: string, value: AST.Expr, what: string,
    typed: TypedProgram, diags: Diagnostic[],
) -> bool {
    if note_slot_need(value, span, what, typed) {
        return false
    }
    report_refusal(code, span, detail, value, typed, diags)
    return true
}

// Report a rights refusal no deduced `!` lifts — `refuse_rights`' second half, for a
// caller whose detail is worth building only once `note_slot_need` has said no.
report_refusal :: fn(
    code: TypecheckCode, span: Span, detail: string, value: AST.Expr, typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    diags.push(typecheck_error(code, span, detail + mutation_fix_hint(value, typed)))
}

/// `annotate \`<field>!\` at <where its type is written>` when `e` reaches through
/// a struct FIELD whose declaration is the thing to reopen.
///
/// The parameter hint (`annotate_hint`) can't cover this : the reader holds
/// `ctx.blocks`, and no `!` on `ctx` unfreezes `blocks` — the level that needs
/// reopening is the field's own type. Only the typechecker can say which struct a
/// field belongs to, so pointing at it is its job, not the reader's to work out.
export field_annotate_hint :: fn(e: AST.Expr, typed: TypedProgram) -> string {
    if e is AST.FieldExpr {
        // A field already marked `!` is not the level that withholds mutation.
        reached :: typed.expr_types[e.id]
        if reached != null && type_grants_mutation(reached) {
            return ""
        }
        owner :: typed.expr_types[e.target.id] ?? return ""
        st :: struct_backing(owner) ?? return ""
        sd :: typed.struct_decls[st.symbol.id] ?? return ""
        for f in sd.fields {
            if f.name != e.field { continue }
            at :: f.ty.span
            return " — annotate `${f.name}!` at ${at.start.file}:${at.start.line}:${at.start.column}"
        }
    }
    return ""
}

// " — annotate `name!` at file:line:col", empty when the root isn't an annotatable
// parameter. The position is machine-readable on purpose: the migration sweep reads
// it to place the `!` itself.
annotate_hint :: fn(root_param: Symbol | null) -> string {
    if root_param is null {
        return ""
    }
    at :: root_param.defined_at ?? return " — annotate `${root_param.name}!`"
    return " — annotate `${root_param.name}!` at ${at.start.file}:${at.start.line}:${at.start.column}"
}

// Remember what produced a local's value — a call, a field path, an element — so a
// fix hint can name the declaration that hands it out.
record_local_producer :: fn(s: AST.LetStmt, typed: TypedProgram) -> void {
    // Positive form throughout : an `as` binding does not survive a negated `is`.
    if s.binding is AST.SimpleBinding as sb {
        local_sym :: typed.resolved.idents[sb.name_span.hash()] ?? return
        ann :: s.ty
        if ann !is null {
            typed.local_annotation[local_sym.id] = ann
        }
        if s.value is AST.CallExpr || s.value is AST.FieldExpr {
            typed.local_init_source[local_sym.id] = s.value
        }
    }
}

/// The fix for a mismatch that is ONLY about mutability, named by the compiler.
///
/// Two types that print almost alike (`X![]` vs `X[]!`) differ at a LEVEL, and the
/// reader has to work out which — so the compiler says it. The lever is the value's
/// own declaration when it is an annotated local, else its producer ; for a `T`, its
/// bound.
///
/// Empty when the mismatch is not mutability-only: then "expected A, got B" is the
/// whole story and a hint would mislead.
///
/// @param value     the expression that failed to fit.
/// @param got       its type.
/// @param expected  the slot's type.
export mutability_level_hint :: fn(
    value: AST.Expr, got: Type, expected: Type, typed: TypedProgram,
) -> string {
    bound :: bound_hint(got, typed)
    if bound != "" && mutability_widens(got, expected, false, typed.type_param_bound_traits) {
        return bound
    }
    slot :: same_shape_slot(got, expected) ?? return ""
    ann :: ident_annotation(value, typed)
    if ann !is null {
        level :: if type_is_immutable(got) && !type_is_immutable(slot) {
            "the top level"
        } else {
            mutability_level_name(got)
        }
        return level_differs_at(path_name(value, "the value"), got, ann.span, level)
    }
    return mutation_fix_hint(value, typed)
}

// `expected`, or the variant of it `got` is meant for (`X` into `X! | null`), when
// the two differ by mutability alone. Null when they differ in shape.
same_shape_slot :: fn(got: Type, expected: Type) -> Type | null {
    if !is_assignable(strip_mutability(got), strip_mutability(expected)) {
        return null
    }
    return counterpart(expected, got) ?? expected
}

// The written type of the local or parameter `e` NAMES, when it is a bare name and
// carries one. A field or element path has no annotation of its own — its lever is
// the field's declaration, which `field_annotate_hint` reads.
ident_annotation :: fn(e: AST.Expr, typed: TypedProgram) -> AST.TypeExpr | null {
    if !(e is AST.IdentExpr) {
        return null
    }
    sym :: typed.resolved.idents[e.span.hash()] ?? return null
    return typed.local_annotation[sym.id]
}

level_differs_at :: fn(
    name: string, written: Type, at: Span, level: string,
) -> string = " — `${name}` is declared `${display_type(written)}` at ${where_of(at)} : the level that differs is ${level}"

// What to call the level a mutability mismatch sits at, in the reader's own words.
// `annotate `xs!`` names the ROOT, which is never the answer here — the reader tries
// it and the diagnostic does not move.
mutability_level_name :: fn(t: Type) -> string = match t {
    is ArrayType | TupleType   -> "the element"
    is StructType | TraitType  -> "the type argument"
    is UnionType               -> "the variant"
    is PrimitiveType | EnumType | FnType | TypeParamType | TypeMetaType | SelfType
     | UnresolvedType | FreeIntType | FreeFloatType | FreeCharType | NeverType
     | AnyType | DistinctType  -> "the element"
}

// A write through `xs[0]` where `xs: Box[]` is fixed at the ELEMENT, never at the
// root: `annotate `xs!`` produces `Box[]!`, which reopens the spine and leaves the
// element frozen — the reader tries it and the diagnostic does not move.
//
// `sym` is the caller's own root symbol, so the two cannot disagree on which root
// they judged.
element_level_hint :: fn(value: AST.Expr, sym: Symbol, typed: TypedProgram) -> string {
    if !(value is AST.IndexExpr) {
        return ""
    }
    ann :: ident_annotation(value.target, typed) ?? return ""
    // The DECLARED type, not the flow-narrowed one : the message quotes it next to
    // the span where it is written, and `Box[] | null` narrowed to `Box[]` would
    // quote a type the reader cannot find at that position.
    at  :: sym.defined_at ?? return ""
    ty  :: typed.param_types[at.hash()] ?? return ""
    arr :: array_shape_in(ty) ?? return ""
    if type_grants_mutation(arr.element) {
        return ""
    }
    return level_differs_at(sym.name, ty, ann.span, mutability_level_name(ty))
}

// The array shape inside `t` — itself, the array a distinct newtype backs, or the
// one array variant of a union. A declared `Box[] | null` is the shape an
// option-typed slot is indexed through.
array_shape_in :: fn(t: Type) -> ArrayType | null {
    direct :: array_backing(t)
    if direct !is null {
        return direct
    }
    if t is UnionType {
        for v in t.variants {
            backing :: array_backing(v)
            if backing !is null {
                return backing
            }
        }
    }
    return null
}

/// The one actionable fix for a rejected write, named by the compiler.
///
/// Ordered from the most specific lever to the least, because a reader following the
/// wrong one hits a wall: marking a local bound from a factory is a STRENGTHENING
/// (gaining rights from a read-only value), which assignability refuses, and a loop
/// variable takes no marker at all (`for x! in` is not syntax).
///
///   0. the BOUND of a type parameter — `T: Bump!` is what lets a `T` be mutated ;
///   1. the producing fn's RETURN — a factory hands out ownership ;
///   2. the iterated collection's ELEMENT type, following `is T as x` bindings back
///      to their scrutinee ;
///   3. the module const's own type — reopenable since a mutable one gets storage ;
///   4. the written ELEMENT of an indexed root — `annotate `xs!`` on a `xs: Box[]`
///      gives `Box[]!`, reopens the spine and does not move the diagnostic ;
///   5. the annotatable root (parameter / annotated local), the pre-existing hint.
///
/// @param value  the expression whose write was rejected.
/// @return       " — …" ready to append to a message, or "" when nothing is nameable.
export mutation_fix_hint :: fn(value: AST.Expr, typed: TypedProgram) -> string =
    mutation_fix_hint_within(value, typed, NARROW_BORROW_BUDGET)

// `budget` bounds the narrowing recursion — `is A as a` nests, and a malformed table
// could otherwise cycle.
mutation_fix_hint_within :: fn(value: AST.Expr, typed: TypedProgram, budget: i32) -> string {
    if budget <= 0 {
        return ""
    }
    ty :: typed.expr_types[value.id]
    if ty != null {
        bound :: bound_hint(ty, typed)
        if bound != "" {
            return bound
        }
    }
    // A read-only FIELD is the lever whenever the value is reached through one :
    // marking it `!` stops every walk at that level, whatever the root.
    field :: field_annotate_hint(value, typed)
    if field != "" {
        return field
    }
    sym :: immutable_root_symbol(value, typed) ?? return source_hint(path_root(value), typed, budget)
    prod :: producer_hint_for(sym, typed, budget)
    if prod != "" {
        return prod
    }
    elem :: element_hint_for(sym, typed)
    if elem != "" {
        return elem
    }
    konst :: module_const_hint_for(sym, typed)
    if konst != "" {
        return konst
    }
    elem_level :: element_level_hint(value, sym, typed)
    if elem_level != "" {
        return elem_level
    }
    root :: annotate_hint(reopenable_root(value, typed))
    if root != "" {
        return root
    }
    // An `is T as x` binding is not itself annotatable, and its lever is whatever its
    // SCRUTINEE's lever is — which may be a parameter, a field, another binding.
    // Recursing here is what covers a write inside a match arm over a borrowed value.
    at :: sym.defined_at ?? return ""
    scrut :: typed.narrow.binding_scrutinee[at.hash()] ?? return ""
    return mutation_fix_hint_within(scrut, typed, budget - 1)
}

// The lever of a value whose type is, or holds as a variant, a `T` whose bound
// grants no mutation : the bound.
bound_hint :: fn(ty: Type, typed: TypedProgram) -> string {
    tp :: unmarked_bound_type_param(ty, typed.type_param_bound_traits) ?? return ""
    name :: tp.symbol.name
    bound :: typed.resolved.type_param_bounds[tp.symbol.id]
    if bound == null {
        return " — a `${name}` is mutable only through a bound marked `!`"
    }
    return " — mark the bound of `${name}` `!` at ${where_of(bound.span)}"
}

// `ty`, or its first variant, when it is a type parameter whose bound grants no
// mutation. A read-only view is skipped : its fix is `Self!` on the member that
// handed it out, not the bound.
unmarked_bound_type_param :: fn(
    ty: Type, bounds: MutableMap<i32, TypeParamBound>,
) -> TypeParamType | null {
    if ty is TypeParamType {
        return if !ty.immutable && !bound_grants_mutation(ty, bounds) { ty } else { null }
    }
    if ty is UnionType {
        for v in ty.variants {
            found :: unmarked_bound_type_param(v, bounds)
            if found != null {
                return found
            }
        }
    }
    return null
}

// The lever of a local that holds what a call or a field path produced.
producer_hint_for :: fn(sym: Symbol, typed: TypedProgram, budget: i32) -> string {
    source :: typed.local_init_source[sym.id] ?? return ""
    return mutation_fix_hint_within(source, typed, budget - 1)
}

// The hint for a value with no root name : a call's result, or what an array
// literal or a `??` was built from.
// @partial: no other expression hands out a value it did not make itself.
source_hint :: fn(root: AST.Expr, typed: TypedProgram, budget: i32) -> string = @partial match root {
    is AST.CallExpr         -> call_return_hint(root, typed)
    is AST.SeqLitExpr       -> first_element_hint(root.elements, typed, budget)
    is AST.NullCoalesceExpr -> mutation_fix_hint_within(root.left, typed, budget - 1)
    _                       -> ""
}

first_element_hint :: fn(elements: AST.Expr[], typed: TypedProgram, budget: i32) -> string {
    for element in elements {
        hint :: mutation_fix_hint_within(element, typed, budget - 1)
        if hint != "" {
            return hint
        }
    }
    return ""
}

// The call's read-only result is the level to reopen : the return written in the
// callee's declaration, or in the fn type of the parameter it was called through.
call_return_hint :: fn(call: AST.CallExpr, typed: TypedProgram) -> string {
    // A return already marked `!` is not the level that withholds mutation.
    result :: typed.expr_types[call.id]
    if result != null && type_grants_mutation(result) {
        return ""
    }
    decl :: recorded_decl(typed, call)
    if decl != null {
        rt :: decl.return_type ?? return ""
        return " — annotate the return of `${decl.name}` at ${where_of(rt.span)}"
    }
    ann :: ident_annotation(call.callee, typed) ?? return ""
    if ann !is AST.FnTypeExpr {
        return ""
    }
    rt :: ann.return_type ?? return ""
    name :: path_name(call.callee, "the callback")
    return " — annotate the return in `${name}`'s type at ${where_of(rt.span)}"
}

// The start of an access path : `f()` for `f().a[0]`.
// @partial: only a field or an element continues a path.
path_root :: fn(e: AST.Expr) -> AST.Expr = @partial match e {
    is AST.FieldExpr -> path_root(e.target)
    is AST.IndexExpr -> path_root(e.target)
    _                -> e
}

// The annotatable root, when annotating it would change something : it is borrowed, or
// its own type is read-only. `self: S!` reaching a read-only field is neither — the
// field is the lever. A local with no written type (a loop variable, an inferred
// local) has nothing to mark.
reopenable_root :: fn(e: AST.Expr, typed: TypedProgram) -> Symbol | null {
    sym :: immutable_root_symbol(e, typed) ?? return null
    if sym.kind != .Param && sym.kind != .Local {
        return null
    }
    if sym.kind == .Local && typed.local_annotation[sym.id] == null {
        return null
    }
    if typed.resolved.immutable_borrows[sym.id] != null {
        return sym
    }
    root_ty :: typed.expr_types[path_root(e).id] ?? return sym
    return if type_grants_mutation(root_ty) { null } else { sym }
}

// Follows `is T as x` bindings back to their scrutinee before asking about the
// iterable, so a write through a narrowed element still names the collection.
element_hint_for :: fn(sym: Symbol, typed: TypedProgram) -> string {
    iter :: iterable_behind(sym, typed, NARROW_BORROW_BUDGET) ?? return ""
    at :: iterable_type_span(iter, typed) ?? return ""
    return " — its elements come from `${path_name(iter, "the collection")}` : annotate that element type at ${where_of(at)}"
}

// `budget` bounds the narrowing chain : `is A as a` inside `is B as b` nests, and a
// cycle would otherwise be reachable through a malformed table.
iterable_behind :: fn(sym: Symbol, typed: TypedProgram, budget: i32) -> AST.Expr | null {
    if budget <= 0 {
        return null
    }
    direct :: typed.loop_var_iterable[sym.id]
    if direct !is null {
        return direct
    }
    // `top :: stack[i]` — the local IS an element, so its lever is the collection's
    // element type, exactly as for a loop variable.
    bound :: typed.local_bound_to[sym.id]
    if bound is AST.IndexExpr {
        return bound.target
    }
    at :: sym.defined_at ?? return null
    scrut :: typed.narrow.binding_scrutinee[at.hash()] ?? return null
    next :: immutable_root_symbol(scrut, typed) ?? return null
    if next.id == sym.id {
        return null
    }
    return iterable_behind(next, typed, budget - 1)
}

module_const_hint_for :: fn(sym: Symbol, typed: TypedProgram) -> string {
    if sym.kind != .Const {
        return ""
    }
    // Its elements are frozen whatever is written (T3076): only a whole element can
    // be replaced.
    if sym.module_variable {
        return "; the elements of module variable `${sym.name}` are frozen: replace a whole one"
    }
    decl :: typed.const_decls[sym.id] ?? return ""
    // Only an array has storage a marker can make writable (T3076, T3096) ; any
    // other const is a value every read shares.
    if typed.decl_types[sym.id] !is ArrayType {
        return (" — `${sym.name}` is a module const at ${where_of(decl.name_span)}"
            + " : hand out a fresh value from a fn instead")
    }
    ty :: decl.ty
    if ty !is null {
        return " — annotate `${sym.name}!` at ${where_of(ty.span)}"
    }
    // Unannotated (`WORDS :: [...]`) : there is no written type to reopen, so the
    // advice is to WRITE one. Most module consts are in this shape, and the auto-pin
    // is what froze them — invisible in the source, hence worth spelling out.
    at :: where_of(decl.name_span)
    return " — `${sym.name}` is frozen by the module-const default at ${at} : give it a marked type (`${sym.name}: T[]!: …`)"
}

// Where the iterable's type is WRITTEN : a struct field's declared type. A bare
// ident falls through to `annotate_hint`, which already points at such a root.
iterable_type_span :: fn(iter: AST.Expr, typed: TypedProgram) -> Span | null {
    if iter is AST.FieldExpr {
        owner :: typed.expr_types[iter.target.id] ?? return null
        st :: struct_backing(owner) ?? return null
        sd :: typed.struct_decls[st.symbol.id] ?? return null
        for f in sd.fields {
            if f.name == iter.field { return f.ty.span }
        }
    }
    // A bare `xs` : the written type is the lever, and it is the ELEMENT of it that
    // needs the marker. `annotate `x!`` on the loop variable is not syntax.
    ann :: ident_annotation(iter, typed) ?? return null
    return ann.span
}

// An access path rendered back to source, for a diagnostic that wants to name
// the value the user wrote. Only ident + field chains are reproducible from the
// AST ; anything else takes `fallback`, which each caller phrases for its own
// sentence ("the collection", a placeholder in a suggested rewrite, …).
path_name :: fn(e: AST.Expr, fallback: string) -> string {
    if e is AST.FieldExpr { return "${path_name(e.target, fallback)}.${e.field}" }
    if e is AST.IdentExpr { return e.name }
    return fallback
}

where_of :: fn(s: Span) -> string = "${s.start.file}:${s.start.line}:${s.start.column}"

// The symbol an access path starts from, when it starts from a name.
immutable_root_symbol :: fn(e: AST.Expr, typed: TypedProgram) -> Symbol | null {
    root :: path_root(e)
    if root is AST.IdentExpr {
        return typed.resolved.idents[root.span.hash()]
    }
    return null
}

/// Whether the CONTAINER of a write is read-only, asked of its TYPE.
///
/// The type carries the answer per LEVEL, which is the whole point of putting the
/// marker there: `rows: Cfg![]` hands out mutable elements through a read-only
/// array, `rows: Cfg[]!` the reverse. A root-based walk gets both wrong — the first
/// over-strictly (nothing below an unmarked root is writable), the second
/// over-permissively (everything below a marked root is, so a signature promising
/// "I may push but won't touch your elements" could lie).
///
/// Falls back to the access-path walk when the container's type wasn't recorded,
/// which keeps the conservative answer rather than silently allowing a write.
///
/// @param container  the expression the written field belongs to.
export container_is_immutable :: fn(container: AST.Expr, typed: TypedProgram) -> bool {
    ty :: typed.expr_types[container.id] ?? return expr_is_immutable(container, typed)
    return type_is_immutable(ty)
}

/// True when mutating the value `e` must be rejected : its type withholds mutation (a
/// frozen array or struct, a value an unmarked return handed out, a `T` whose bound
/// is unmarked), or its access path does (`expr_is_immutable`).
///
/// @param e   the value about to be mutated.
/// @param ty  its type.
export value_is_read_only :: fn(e: AST.Expr, ty: Type, typed: TypedProgram) -> bool =
    withholds_mutation(ty, typed.type_param_bound_traits) || expr_is_immutable(e, typed)

/// True when writing THROUGH `e` must be rejected, judged on the ACCESS PATH.
///
/// @param e  the path being written through.
export expr_is_immutable :: fn(
    e: AST.Expr, typed: TypedProgram,
) -> bool = walk_levels(e, typed, NARROW_BORROW_BUDGET)

// Bounds every walk of the `is T as x` chain — the mutation check and both hint
// paths. Bindings nest (`is A as a` inside `is B as b`), and a malformed table could
// otherwise close a cycle. One chain, one bound.
NARROW_BORROW_BUDGET :: 8

// The per-LEVEL walk behind `expr_is_immutable`. A module const needs no guard of
// its own : its value reaches no level that grants mutation (T3096), so the walk
// always arrives at its root.
//
// @partial: only an access path can be immutable — an ident, a field / element
// reached from one, or a conversion re-typing one. Every other expression form
// yields a fresh owned value.
walk_levels :: fn(e: AST.Expr, typed: TypedProgram, budget: i32) -> bool {
    // A level that declares `!` STOPS the walk. `xs: Box![]` says the elements are
    // mutable whatever the path that reached them, exactly as `Wrap { b: Box! }` says
    // it of `b` — and the write-side rule (`container_is_immutable`) has always read
    // it that way. Without this the two rules disagree on one expression: `xs[0].n = 1`
    // passes and `bump(xs[0])` is T3072.
    ty :: typed.expr_types[e.id]
    if ty !is null && type_grants_mutation(ty) {
        return false
    }
    return @partial match e {
        is AST.IdentExpr -> ident_is_immutable(e, typed, budget)
        is AST.FieldExpr -> walk_levels(e.target, typed, budget)
        is AST.IndexExpr -> walk_levels(e.target, typed, budget)
        // `Ids(xs)` re-types the SAME value : it is as read-only as `xs`.
        is AST.CallExpr  -> converted_is_immutable(e, typed, budget)
        _                -> false
    }
}

// A conversion `T(x)` of a value that holds a reference re-types that same
// reference, so it is as read-only as `x`.
converted_is_immutable :: fn(c: AST.CallExpr, typed: TypedProgram, budget: i32) -> bool =
    retypes_reference(c, typed) && walk_levels(c.args[0].value, typed, budget)

// Whether `c` is a conversion `T(x)` of a value that holds a reference : it re-types
// that same reference. A scalar converts to a copy, which no path can freeze.
retypes_reference :: fn(c: AST.CallExpr, typed: TypedProgram) -> bool {
    if c.args.len() != 1 {
        return false
    }
    callee_ty :: typed.expr_types[c.callee.id] ?? return false
    if !converts_by_name(c, callee_ty, typed) {
        return false
    }
    converted :: typed.expr_types[c.args[0].value.id] ?? return false
    return carries_mutability_bit(strip_distinct(converted))
}

ident_is_immutable :: fn(ident: AST.IdentExpr, typed: TypedProgram, budget: i32) -> bool {
    sym :: bare_name_symbol(ident, typed) ?? return false
    // A module-level const needs no table, and holds cross-module for free:
    // `seed_wildcard_exports` seeds the ORIGINAL symbol, kind included.
    if sym.kind == .Const {
        // A module variable has storage of its own ; every other module const is
        // frozen, its value shared by every read, `.rodata` included.
        return !sym.module_variable
    }
    // A parameter without `!`, or a loop variable over an immutable iterable.
    if typed.resolved.immutable_borrows[sym.id] !is null {
        return true
    }
    // An `is T as x` binding BORROWS its scrutinee — same storage, narrower type — so
    // it inherits its scrutinee's answer. Without this hop the alias LAUNDERS the
    // borrow at every path-judged gate : `if w is Wrap as x { bump(x.b) }` passes
    // where `if w is Wrap { bump(w.b) }` is T3072. The type-judged gate (T3070) never
    // leaked, since `narrowed_with_scrutinee_immutability` already carries the bit
    // into the binding's TYPE. `Symbol.defined_at` is the bridge to the table.
    if budget <= 0 {
        return false
    }
    at :: sym.defined_at ?? return false
    scrut :: typed.narrow.binding_scrutinee[at.hash()] ?? return false
    return walk_levels(scrut, typed, budget - 1)
}


// Iterating an immutable value lends out immutable elements: `for it in CFG.items`
// where `CFG` is a module-level const must not allow `it.n = 99`. Without this the
// loop is a laundering path around the whole check — and a silent one, since a
// module const has no storage, so the write is simply discarded.
//
// Marked HERE rather than in the resolver on purpose: deciding it needs
// `expr_is_immutable`, hence the types, which the resolver does not have. Doing it
// there would mean a second, weaker copy of the predicate. The resolver's only
// contribution is recording the loop var's Symbol in `idents` so it can be reached
// from here. Runs before the body is checked, so uses inside see the mark.
mark_loop_var_borrow :: fn(
    nv: AST.NamedVar, iter: AST.Expr, elem: Type, typed: TypedProgram,
) -> void {
    sym :: typed.resolved.idents[nv.span.hash()] ?? return
    // Recorded for EVERY loop variable — see `loop_var_iterable`'s doc for why the
    // interesting case never reaches the borrow marking below.
    typed.loop_var_iterable[sym.id] = iter
    // `for x in xs` only strips the `[]` — over `Box![]` the loop variable IS typed
    // `Box!`. Stamping it read-only anyway contradicts its own type and leaves the
    // reader nothing to annotate (`for x! in` is not syntax).
    if type_grants_mutation(elem) {
        return
    }
    if !expr_is_immutable(iter, typed) {
        return
    }
    typed.resolved.immutable_borrows[sym.id] = true
}



// What forbids writing an element of `receiver`, for every write form (`check_assign`,
// a destructuring target). True when reported.
//   - T3042 : a read-only array.
//   - T3070 : a mutable array reached through a read-only path (`CFG.tags[0] = 9`).
//   - T3071 : a receiver that cannot take `IndexSet.set_at`, a `self!` member, which
//     the write calls — a field written without `!`, a read-only parameter.
reject_index_write_receiver :: fn(
    receiver: AST.Expr,
    receiver_ty: Type,
    arr: ArrayType | null,
    write_span: Span,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> bool {
    if arr == null {
        return reject_driving_immutable(
            receiver, receiver_ty, TRAIT_INDEX_SET, INDEX_WRITE_DETAIL, typed, diags,
        )
    }
    if arr.immutable {
        if note_slot_need(receiver, receiver.span, "an element of it is written here", typed) {
            return false
        }
        detail :: "cannot mutate `${display_type(receiver_ty)}`"
        report_refusal(.CannotMutateImmutableArray, receiver.span, detail, receiver, typed, diags)
        return true
    }
    return push_immutable_path_write(receiver, write_span, typed, diags)
}

// T3070 for an element write (`CFG.tags[0] = 9`) whose container is mutable but
// reached through an immutable path ; the read-only `T[]` case keeps T3042's more
// specific wording.
push_immutable_path_write :: fn(
    target: AST.Expr, span: Span, typed: TypedProgram, diags: Diagnostic[],
) -> bool = push_immutability_diag_for(
    expr_is_immutable(target, typed), .CannotMutateImmutableBinding, span,
    "this element is reached through an immutable path", target, typed, diags,
)

check_return :: fn(
    s: AST.ReturnStmt,
    typed: TypedProgram,
    diags: Diagnostic[],
    ctx: FnContext | null,
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> void {
    effective :: resolve_ctx(ctx, typed)
    // Generator: `return <value>` is a mistake (produce via `yield` — T3058);
    // a bare `return` stops the stream and needs no return-type check.
    if effective != null && effective.is_generator {
        if s.value !is null {
            check_expr_fn(s.value, null, typed, diags)
            diags.push(typecheck_error(.ReturnValueInGenerator, s.span, ""))
        }
        return
    }
    v :: s.value
    if v is null {
        match effective {
            is null -> {}
            _       -> {
                emit_return_mismatch_if(
                    TY_VOID,
                    effective.return_type,
                    s.span,
                    null,
                    typed,
                    diags,
                )
            }
        }
        // Empty `return` : no value expr, so no coercion / hint site.

        return
    }
    expected: Type | null = null
    if effective !is null {
        expected = effective.return_type
    }
    got :: check_expr_fn(v, expected, typed, diags)
    if effective !is null {
        // Accumulate the returned value's type so a divergent block-body
        // lambda can recover its real return type (see `pick_final_return`).
        prev :: effective.inferred_return
        if prev == null {
            effective.inferred_return = got
        } else {
            effective.inferred_return = union_of([prev, got])
        }
        emit_return_mismatch_if(got, effective.return_type, s.span, v, typed, diags)
    }
}

check_yield :: fn(
    s: AST.YieldStmt,
    typed: TypedProgram,
    diags: Diagnostic[],
    ctx: FnContext | null,
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> void {
    effective :: resolve_ctx(ctx, typed)
    if effective != null && effective.is_generator {
        // `yield e` must coerce to the generator's element type `T` (T3061).
        yt :: effective.yield_type
        got :: check_expr_fn(s.value, yt, typed, diags)
        if yt != null {
            emit_mismatch_if(
                got,
                yt,
                s.value.span,
                s.value,
                .GeneratorYieldIncompatible,
                typed,
                diags,
            )
        }
        return
    }
    // A `yield` in the body makes a fn a generator by inference, so the only
    // illegal position left is a nested lambda (its own ctx is never a generator
    // — `new_fn_context` defaults `is_generator = false`, and `block_has_yield`
    // doesn't descend lambdas), which trips T3059. Still type the value so
    // downstream passes see its type.
    check_expr_fn(s.value, null, typed, diags)
    diags.push(typecheck_error(.YieldOutsideGenerator, s.span, ""))
}

check_for :: fn(
    s: AST.ForStmt,
    typed: TypedProgram,
    diags: Diagnostic[],
    ctx: FnContext | null,
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> void {
    binding: string | null = null
    // What the loop repeats (a condition, the body) runs after the body's own
    // writes, so the narrowings they may falsify retire first ; an `in`
    // iterable runs once, before them.
    match s.form as w {
        is AST.InfiniteFor -> { retire_narrowings_entering_loop(s, typed) }
        is AST.WhileFor    -> {
            retire_narrowings_entering_loop(s, typed)
            got :: check_expr_fn(w.cond, null, typed, diags)
            // `for X { ... }` desugars to `for _ in X { ... }` when X
            // is iterable (array today ; custom Iterator impls land
            // with coerce.vader). Skip T3019 in that case.
            if got is ArrayType {
                record_site(typed, w.cond, .IterNext, BUILTIN_CALLEE)
            } else if !is_assignable(got, TY_BOOL) {
                /* iterable — no diag */

                diags.push(
                    typecheck_error(
                        .ConditionMustBeBool,
                        w.cond.span,
                        "while condition must be `bool`, got ${display_type(got)}",
                    ),
                )
            }
        }
        is AST.InFor       -> {
            iter_ty :: check_expr_fn(w.iter, null, typed, diags)
            retire_narrowings_entering_loop(s, typed)
            _ :: reject_driving_immutable(
                w.iter, iter_ty, TRAIT_ITERATOR, "`for` advances this iterator through `next`",
                typed, diags,
            )
            elem :: for_in_element(iter_ty, typed)
            // A `for` reaches `Iterator`, or the `Into` toward one, without its
            // argument (T3097).
            several :: several_iterators_trait(iter_ty, typed)
            if several != null {
                diags.push(several_impls_error(iter_ty, several, "`for`", w.iter.span))
                record_site(typed, w.iter, .IterNext, ERRONEOUS_CALLEE)
            } else {
                record_for_sites(typed, w.iter, iter_ty)
            }
            _ :: reject_unmet_impl_bounds(
                iter_ty, core_trait_key(TRAIT_ITERATOR), .TraitNotSatisfied, w.iter.span,
                typed, diags,
            )
            if elem is UnresolvedType && is_known_non_iterable(iter_ty) {
                got :: display_type(iter_ty)
                diags.push(typecheck_error(
                    .NotIterable, w.iter.span,
                    "a `for` walks an array, a string or an `Iterator`, got `${got}`"))
                record_site(typed, w.iter, .IterNext, ERRONEOUS_CALLEE)
            }
            match w.loop_var as nv {
                is AST.NamedVar       -> {
                    typed.local_types[nv.span.hash()] = elem
                    mark_loop_var_borrow(nv, w.iter, elem, typed)
                    // A real user name is var-targetable ; the `_` wildcard is not.
                    if nv.name != "_" { binding = nv.name }
                }
                is AST.DestructureVar -> {
                    assign_binding_types(
                        nv.pattern,
                        elem,
                        typed,
                        diags,
                    )
                }
                is AST.DiscardVar     -> {}
            }            // `for [k, v] in …` — type each pattern leaf against the element
            // (a tuple / array, or a struct that implements `Into<[...]>`),
            // reusing the destructuring-let machinery. Not var-targetable.

            // `for <range>` — no binding, no target variable (label only).

        }
    }
    // W0010 — a label on a for-in loop is redundant : it already has an iteration
    // variable to target it by (`break <var>`). A label is only needed for a
    // `while` / infinite loop, which has no variable.
    if s.label != null && binding != null {
        diags.push(
            warning(
                .PreferLoopVariableOverLabel,
                s.span,
                "target this loop by its variable `${binding}` instead of a label",
            ),
        )
    }
    // Push this loop onto the walk-global stack (survives `if`/`match` nesting)
    // so a `break <name>` / `continue <name>` in the body resolves against its
    // iteration variable (or label). Balanced push / remove_last.
    typed.loop_stack.push(EnclosingLoop { .for_id = s.id, .binding = binding, .label = s.label })
    inner_ctx :: bump_loop_depth(ctx)
    check_block(s.body, null, typed, diags, inner_ctx, check_expr_fn)
    typed.loop_stack.remove_last()
    return
}

check_loop_jump :: fn(
    span: Span,
    jump_id: usize,
    label: string | null,
    typed: TypedProgram,
    ctx: FnContext | null,
    diags: Diagnostic[],
) -> void {
    // A bare `break`/`continue` targets the innermost loop (no diagnostic — reader
    // clarity is served by the LSP go-to-loop). A `break <name>` must resolve to an
    // enclosing loop by its iteration variable (preferred) or its label ; the walk-
    // global `loop_stack` survives `if`/`match` nesting, mirroring `loop_depth`.
    if label == null {
        if typed.loop_stack.len() > 0 {
            typed.jump_targets[jump_id] = typed.loop_stack[typed.loop_stack.len() - 1].for_id
        }
    } else {
        name :: label
        target :: resolve_loop_target(typed.loop_stack, name)
        if target == null {
            // A local, an unknown name, or a jump outside any loop — never a valid
            // target. `break`ing a non-loop makes no sense → hard error (T3067).
            diags.push(
                typecheck_error(
                    .LoopTargetNotLoopVariable,
                    span,
                    "`${name}` is not an enclosing loop's iteration variable or label",
                ),
            )
        } else {
            typed.jump_targets[jump_id] = target.for_id
            // A VARIABLE match records the resolution for the lowerer: an unlabelled
            // loop is lowered under the variable's name (`LoweredLoop.label`), a
            // labelled one keeps its label and the jump takes it instead. A label
            // match already carries the name its loop is lowered under.
            tb :: target.binding
            if tb != null && tb == name {
                target_label :: target.label
                if target_label == null {
                    typed.loop_target_labels[target.for_id] = name
                } else {
                    typed.jump_labels[jump_id] = target_label
                }
            }
        }
    }
    // T3015 — `break`/`continue` outside any loop. Kept on `ctx.loop_depth`. A null
    // ctx is an expression-nested block (`x ?? break`), where the walk-global loop
    // stack answers instead ; lambdas do not reset that stack, so it can miss a
    // jump written in a lambda inside a loop.
    if ctx is null {
        if label == null && typed.loop_stack.len() == 0 {
            diags.push(
                typecheck_error(
                    .BreakContinueOutsideLoop,
                    span,
                    "`break` / `continue` only allowed inside a loop",
                ),
            )
        }
        return
    }
    if ctx.loop_depth == 0 {
        diags.push(
            typecheck_error(
                .BreakContinueOutsideLoop,
                span,
                "`break` / `continue` only allowed inside a loop",
            ),
        )
    }
}

// The nearest enclosing loop whose iteration variable OR label is `name`
// (innermost-first), or null. Mirrors the backward loop-stack scan of
// `resolve_loop_frame` (midir) / `gb_resolve_loop_frame` (lower_coroutine).
resolve_loop_target :: fn(stack: EnclosingLoop[], name: string) -> EnclosingLoop | null {
    i := stack.len()
    for i > 0 {
        i = i - 1
        frame :: stack[i]
        fb :: frame.binding
        if fb != null && fb == name {
            return frame
        }
        fl :: frame.label
        if fl != null && fl == name {
            return frame
        }
    }
    return null
}

check_defer :: fn(
    s: AST.DeferStmt,
    typed: TypedProgram,
    diags: Diagnostic[],
    ctx: FnContext | null,
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> void {
    // `defer` inside a generator is still forbidden in v1 — a generator can be
    // abandoned mid-iteration, and the runtime has no drop hook to fire pending
    // defers on teardown (T3060 ; lifted with async cancellation, 4c). `defer`
    // inside an async coroutine IS supported : the coroutine always runs to
    // completion in v1, and its pending defers live in the per-frame `__defers`
    // stack, drained LIFO at each structured exit (`lower_coroutine`).
    effective :: resolve_ctx(ctx, typed)
    if effective != null && effective.is_generator {
        diags.push(typecheck_error(.DeferInGenerator, s.span, ""))
    }
    // The body runs at scope exit, lowered as a fn of its own: no enclosing loop
    // is one its jumps can reach.
    body_ctx :: outside_loops(ctx)
    prev_loops :: typed.loop_stack
    typed.loop_stack = []
    match s.body as b {
        is AST.DeferStmtBody  -> { check_stmt(b.stmt, typed, diags, body_ctx, check_expr_fn) }
        is AST.DeferBlockBody -> { check_block(b.block, null, typed, diags, body_ctx, check_expr_fn) }
    }
    typed.loop_stack = prev_loops
    return
}

outside_loops :: fn(ctx: FnContext | null) -> FnContext! | null {
    if ctx is null {
        return null
    }
    return FnContext { ...ctx, .loop_depth = 0 }
}

// ---- support --------------------------------------------------------------

bump_loop_depth :: fn(ctx: FnContext | null) -> FnContext! | null {
    if ctx is null {
        return null
    }
    return FnContext { ...ctx, .loop_depth = ctx.loop_depth + 1 }
}

// Detect `if x is T { return ... }` pattern and push the complement
// narrowing for the rest of the block. The then-branch must end in a
// divergent statement (return / break / continue) — we approximate
// this by requiring the then-block's last stmt to be a `ReturnStmt`.
push_divergent_narrow_if :: fn(
    stmt: AST.Stmt,
    typed: TypedProgram,
    stack: PushedNarrow[],
) -> void {
    if stmt !is AST.ExprStmt    { return }
    if stmt.expr !is AST.IfExpr { return }
    if_expr :: stmt.expr
    if if_expr.else_branch !is null                  { return }
    if !then_is_divergent(if_expr.then_block, typed) { return }
    push_guard_narrows(if_expr.cond, typed, stack)
}

// Push the complement narrowing(s) a guard condition leaves for the rest of the
// block. A `||` contributes one per operand : reaching the fall-through means
// EVERY operand was false. Subtraction composes — pushing them in sequence, each
// detected against the narrowing the previous one left, lands on the same type as
// subtracting their union at once — so no grouping is needed.
push_guard_narrows :: fn(cond: AST.Expr, typed: TypedProgram, stack: PushedNarrow[]) -> void {
    if cond is AST.BinaryExpr {
        if cond.op == .Or {
            push_guard_narrows(cond.left, typed, stack)
            push_guard_narrows(cond.right, typed, stack)
            return
        }
    }
    narrowing :: detect_is_narrow_for_block(cond, typed) ?? return
    stack.push(push_one_narrow(typed, narrowing.sym_id, narrowing.field_key, narrowing.else_ty))
}

then_is_divergent :: fn(b: AST.BlockExpr, typed: TypedProgram) -> bool {
    // A guard block whose sole (or final) content is a `@no_return` call —
    // `{ panic(...) }` — parses that call as the block's trailing expression,
    // not a statement, so `b.stmts` is empty. Honor a `never`-typed trailing
    // expr as divergent, mirroring the `is_divergent_stmt` ExprStmt arm ;
    // otherwise the complement narrowing is dropped and the guarded binding
    // keeps its union type (T3008 on the post-guard use).
    if b.trailing !is null {
        if typed.expr_types[b.trailing.id] is NeverType {
            return true
        }
    }
    if b.stmts.len() == 0 {
        return false
    }
    return is_divergent_stmt(b.stmts[b.stmts.len() - 1], typed)
}

is_divergent_stmt :: fn(s: AST.Stmt, typed: TypedProgram) -> bool {
    if s is AST.ReturnStmt   { return true }
    if s is AST.BreakStmt    { return true }
    if s is AST.ContinueStmt { return true }
    // An expression statement that evaluates to `never` (a call to a
    // `@no_return` fn — `panic` / `todo` / `unreachable`) terminates the
    // flow : code after it is unreachable, and it discharges a non-`void`
    // fn's return obligation.
    if s is AST.ExprStmt {
        if typed.expr_types[s.expr.id] is NeverType {
            return true
        }
    }
    // A `for { … }` no `break` can leave has no exit edge, so whatever follows
    // it cannot run. A `return` in the body doesn't reopen one — it leaves the
    // fn, not the loop.
    if s is AST.ForStmt {
        return loop_never_exits(s)
    }
    return false
}

/// True when `s` is an infinite `for { … }` that no `break` can leave.
///
/// Only the `InfiniteFor` form qualifies. `for cond` and `for x in xs` both
/// carry an exit edge, and deciding that one is never taken would need
/// value-range reasoning the checker does not do — so `for true { }` is
/// deliberately NOT divergent here.
loop_never_exits :: fn(s: AST.ForStmt) -> bool {
    if s.form !is AST.InfiniteFor {
        return false
    }
    return !block_breaks_loop(s.body, s.label, true)
}

/// True when `block` holds a `break` that leaves the loop it is the body of.
///
/// `label` is that loop's label, and `bare_counts` says whether an unlabelled
/// `break` still targets it — false once the walk has entered a NESTED loop,
/// which swallows bare `break`s. A labelled `break` is followed at any depth
/// since it can name an outer loop ; an infinite `for` has no iteration
/// variable, so its label is the only name that reaches it (see
/// `resolve_loop_target`). Lambda bodies are not descended — a `break` there is
/// illegal anyway.
block_breaks_loop :: fn(block: AST.BlockExpr, label: string | null, bare_counts: bool) -> bool {
    for s in block.stmts {
        if stmt_breaks_loop(s, label, bare_counts) {
            return true
        }
    }
    // A body whose only item is `if p { break }` parses as the block's trailing
    // expression, not a statement — descend it too.
    if block.trailing !is null {
        if expr_breaks_loop(block.trailing, label, bare_counts) {
            return true
        }
    }
    return false
}

// Does this `break` leave the loop being judged ? A bare one targets the
// innermost loop, so `bare_counts` says whether that is still the one at hand ;
// a labelled one reaches any enclosing loop carrying that label.
break_targets_loop :: fn(b: AST.BreakStmt, label: string | null, bare_counts: bool) -> bool {
    named :: b.label ?? return bare_counts
    return label != null && named == label
}

stmt_breaks_loop :: fn(s: AST.Stmt, label: string | null, bare_counts: bool) -> bool = match s {
    is AST.BreakStmt             -> { return break_targets_loop(s, label, bare_counts) }
    is AST.ForStmt               -> { return block_breaks_loop(s.body, label, false) }
    is AST.ExprStmt              -> { return expr_breaks_loop(s.expr, label, bare_counts) }
    is AST.DeferStmt             -> {
        match s.body as b {
            is AST.DeferStmtBody  -> { return stmt_breaks_loop(b.stmt, label, bare_counts) }
            is AST.DeferBlockBody -> { return block_breaks_loop(b.block, label, bare_counts) }
        }
    }
    // `p :: next() ?? break` puts the exit inside a bound VALUE, not a stmt of
    // its own — the shape `std/io::read_dir` drains a directory with. Every
    // value-carrying stmt is descended for that reason.
    is AST.LetStmt               -> { return expr_breaks_loop(s.value, label, bare_counts) }
    is AST.AssignStmt            -> {
        if expr_breaks_loop(s.target, label, bare_counts) {
            return true
        }
        return expr_breaks_loop(s.value, label, bare_counts)
    }
    is AST.DestructureAssignStmt -> {
        for place in AST.assign_places(s) {
            if expr_breaks_loop(place, label, bare_counts) {
                return true
            }
        }
        return expr_breaks_loop(s.value, label, bare_counts)
    }
    is AST.YieldStmt             -> { return expr_breaks_loop(s.value, label, bare_counts) }
    is AST.ReturnStmt            -> {
        v :: s.value ?? return false
        return expr_breaks_loop(v, label, bare_counts)
    }
    is AST.ContinueStmt          -> { return false }
}

// A `break` is a statement, so it only appears in a block's stmt list — but a
// `?? break` fallback rides inside an expression, so the expression forms that
// carry blocks or fallbacks are descended too, skipping lambdas. Exhaustive so
// a new block-bearing Expr variant trips T3013 here rather than being silently
// missed.
expr_breaks_loop :: fn(e: AST.Expr, label: string | null, bare_counts: bool) -> bool = match e {
    is AST.BlockExpr -> { return block_breaks_loop(e, label, bare_counts) }
    is AST.IfExpr    -> { return if_breaks_loop(e, label, bare_counts) }
    is AST.MatchExpr -> {
        for arm in e.arms {
            if expr_breaks_loop(arm.body, label, bare_counts) {
                return true
            }
        }
        return false
    }
    is AST.NullCoalesceExpr -> {
        if expr_breaks_loop(e.left, label, bare_counts) {
            return true
        }
        // `?? break` — the fallback IS the jump, and `coalesce_fallback_expr`
        // hands back null for it, there being no expression to return.
        if e.fallback is AST.BreakStmt as jump {
            return break_targets_loop(jump, label, bare_counts)
        }
        inner :: AST.coalesce_fallback_expr(e.fallback) ?? return false
        return expr_breaks_loop(inner, label, bare_counts)
    }
    is AST.IntLitExpr | AST.FloatLitExpr | AST.BoolLitExpr | AST.NullLitExpr | AST.CharLitExpr | AST.StringLitExpr | AST.IdentExpr | AST.CallExpr | AST.FieldExpr | AST.IndexExpr | AST.UnaryExpr | AST.BinaryExpr | AST.LambdaExpr | AST.StructLitExpr | AST.SeqLitExpr | AST.RangeExpr | AST.CastExpr | AST.GenericInstExpr | AST.IntrinsicCallExpr | AST.DotVariantExpr | AST.FnTypeExpr | AST.ArrayTypeExpr | AST.MutableTypeExpr | AST.AwaitExpr -> { return false }
}

if_breaks_loop :: fn(i: AST.IfExpr, label: string | null, bare_counts: bool) -> bool {
    if block_breaks_loop(i.then_block, label, bare_counts) {
        return true
    }
    match i.else_branch as e {
        is null            -> { return false }
        is AST.IfElseIf    -> { return if_breaks_loop(e.branch, label, bare_counts) }
        is AST.IfElseBlock -> { return block_breaks_loop(e.block, label, bare_counts) }
    }
}

stmt_span :: fn(s: AST.Stmt) -> Span {
    match s {
        is AST.LetStmt               -> { return s.span }
        is AST.AssignStmt            -> { return s.span }
        is AST.DestructureAssignStmt -> { return s.span }
        is AST.ExprStmt              -> { return s.span }
        is AST.ReturnStmt            -> { return s.span }
        is AST.YieldStmt             -> { return s.span }
        is AST.ForStmt               -> { return s.span }
        is AST.BreakStmt             -> { return s.span }
        is AST.ContinueStmt          -> { return s.span }
        is AST.DeferStmt             -> { return s.span }
    }
}

BlockNarrow :: struct {
    sym_id: i32
    static_ty: Type
    else_ty: Type
    field_key: string = ""
}

detect_is_narrow_for_block :: fn(cond: AST.Expr, typed: TypedProgram) -> BlockNarrow | null {
    // Mirrors `expr_if.vader::detect_is_narrow` at a narrower result shape —
    // the divergent-guard case only needs the else-type.
    if cond is AST.UnaryExpr {
        if cond.op == .Not {
            inner :: detect_is_narrow_for_block(cond.operand, typed) ?? return null
            // Compose `!(x is T)`'s fall-through from the CURRENT narrowing
            // (after prior guards), not `inner.static_ty` (declared) — which
            // would RE-WIDEN and undo earlier guards, leaving a chain
            // `if x is A{return} if !(x is B){return}` as `A | B` not `B`, so a
            // later `x.<B-field>` drops (infer_call's `callee_ty.params` after
            // its TypeMetaType / UnresolvedType / !FnType guards). Carry field_key.
            current :: if inner.field_key == "" {
                narrow_for_binding(typed, inner.sym_id, inner.static_ty)
            } else {
                narrow_for_field(typed, inner.field_key, inner.static_ty)
            }
            return BlockNarrow { ...inner, .else_ty = subtract_type(current, inner.else_ty) }
        }
    }
    if cond !is AST.BinaryExpr {
        return null
    }
    // `x == null` / `x != null` / `null == x` / `null != x` — both
    // orderings flip the same way ; divergent guard pushes the
    // complement narrowing for the rest of the block.
    if cond.op == .Eq || cond.op == .Neq {
        ident_side :: pick_ident_vs_null(cond.left, cond.right)
        if ident_side !is null {
            sym :: typed.resolved.idents[ident_side.span.hash()] ?? return null
            base :: type_of_symbol(sym, typed)
            // Don't record a narrowing off an unresolved base — mirrors
            // `detect_is_narrow` (expr_if.vader). The premature imported-body
            // walk in `settle_external_expr_bodied_returns` runs before the
            // module's `MutableMap.at` &c are wired, so an `m[k]`-bound local
            // is `?` there ; a `?`-based divergent narrow persists (divergent
            // narrows aren't popped) and poisons the authoritative re-walk.
            if base is UnresolvedType {
                return null
            }
            current :: narrow_for_binding(typed, sym.id, base)
            null_ty :: TY_NULL
            if cond.op == .Eq {
                return BlockNarrow {
                    .sym_id = sym.id,
                    .static_ty = base,
                    .else_ty = subtract_type(current, null_ty),
                }
            }
            return BlockNarrow { .sym_id = sym.id, .static_ty = base, .else_ty = null_ty }
        }
        field_side :: pick_field_vs_null(cond.left, cond.right)
        if field_side !is null {
            target :: resolve_field_chain_static(field_side, typed)
            if target !is null {
                null_ty :: TY_NULL
                current :: narrow_for_field(typed, target.field_key, target.static_ty)
                if cond.op == .Eq {
                    return BlockNarrow {
                        .sym_id = 0,
                        .static_ty = target.static_ty,
                        .else_ty = subtract_type(current, null_ty),
                        .field_key = target.field_key,
                    }
                }
                return BlockNarrow {
                    .sym_id = 0,
                    .static_ty = target.static_ty,
                    .else_ty = null_ty,
                    .field_key = target.field_key,
                }
            }
        }
        return null
    }
    if cond.op != .Is {
        return null
    }
    // Bare-ident scrutinee : narrow the symbol slot for the complement.
    if cond.left is AST.IdentExpr {
        sym :: typed.resolved.idents[cond.left.span.hash()] ?? return null
        base :: type_of_symbol(sym, typed)
        // Same `?`-base guard as the `== null` path above : the settle
        // pre-walk sees an `m[k]`-bound scrutinee as `?` and would persist a
        // poisoned divergent narrow into the authoritative walk.
        if base is UnresolvedType {
            return null
        }
        current :: narrow_for_binding(typed, sym.id, base)
        // The written type name carries no mutability : take the scrutinee's, or
        // `subtract_type` no longer recognises the variant it is meant to remove
        // and the divergent guard stops narrowing (see `pattern_type_of`).
        narrowed :: complement_narrowed_type(cond.right, current, typed)
        return BlockNarrow {
            .sym_id = sym.id,
            .static_ty = base,
            .else_ty = subtract_type_with_impls(current, narrowed, typed),
        }
    }
    // Field-chain scrutinee : `x.y is T` complement-narrows the `x.y` slot,
    // mirroring the `x.y == null` field path above. The divergent guard
    // `if d.body is null { return }` then flows `Block` (not `Block | null`)
    // to `body :: d.body` — the `convert_function` drop this closes.
    if cond.left is AST.FieldExpr as field_lhs {
        field_info :: resolve_field_chain_static(field_lhs, typed) ?? return null
        current :: narrow_for_field(typed, field_info.field_key, field_info.static_ty)
        narrowed :: complement_narrowed_type(cond.right, current, typed)
        return BlockNarrow {
            .sym_id = 0,
            .static_ty = field_info.static_ty,
            .else_ty = subtract_type_with_impls(current, narrowed, typed),
            .field_key = field_info.field_key,
        }
    }
    return null
}

diag_sink_stmt :: fn() -> Diagnostic[]! { return [] }

// The type written on the right of an `is`, carrying the immutability of the
// slot it is subtracted from. Same rationale as `match_expr::pattern_type_of`.
complement_narrowed_type :: fn(ty: AST.Expr, current: Type, typed: TypedProgram) -> Type {
    narrowed :: type_from_expr(ty, typed.resolved, diag_sink_stmt())
    return narrowed_with_rights(narrowed, current, typed.type_param_bound_traits)
}

INDEX_WRITE_DETAIL :: "an index write mutates this receiver through `set_at`"

// T3071 — a form that drives `e` through a `self!` member of `trait_name` : `for`
// through `Iterator.next`, `await` through `Async.resume`, an index write through
// `IndexSet.set_at`. A read-only value cannot be driven. True when reported.
reject_driving_immutable :: fn(
    e: AST.Expr, ty: Type, trait_name: string, detail: string,
    typed: TypedProgram, diags: Diagnostic[],
) -> bool {
    if !drives_in_place(ty, trait_name, typed) || !value_is_read_only(e, ty, typed) {
        return false
    }
    return push_mutating_on_immutable(e, e.span, detail, typed, diags)
}

// Whether the form calls the member on `t` itself : an array is walked by index and
// a string through its chars, never through a `self!` member of theirs.
drives_in_place :: fn(t: Type, trait_name: string, typed: TypedProgram) -> bool = match t {
    is ArrayType | PrimitiveType | AnyType | UnresolvedType | NeverType | SelfType
        | FreeIntType | FreeFloatType | FreeCharType -> false
    is TraitType | TypeParamType | StructType | DistinctType | UnionType | EnumType
        | TupleType | FnType | TypeMetaType -> {
        satisfies_bound(t, core_trait_key(trait_name), typed)
    }
}

// Pull the iterator's element type. `T[]` yields `T` directly ;
// generic `StructType` falls back to first type arg (covers Range and
// Iterator<T> wrappers). Otherwise probes `typed.iter_element_types`
// for the indexed `X implements Iterator<T>` impl.
for_in_element :: fn(iter_ty: Type, typed: TypedProgram) -> Type {
    // Arrays — and array-backed distinct newtypes — yield their element type.
    ab :: array_backing(iter_ty)
    if ab != null {
        return ab.element
    }
    // @partial: only structs (Range, Iterator<T> wrappers), distincts, enums and
    // `Iterator` trait values remain iterable here — `array_backing` already
    // returned for every array ; other types yield an unresolved element.
    @partial match iter_ty {
        is StructType -> {
            // A `generator`'s `<fn>$State<E>` carries the concrete element as its
            // sole type arg (`<fn>$State<E> implements Iterator<E>`) — the synthetic
            // struct has no `struct_decl` for the generic-substitution path below, so
            // read the arg directly (else a captured loop var over a generator chain
            // erases to the impl's generic `E`).
            if is_gen_state_struct(iter_ty) {
                if iter_ty.args.len() >= 1 {
                    return iter_ty.args[0]
                }
                return TY_UNRESOLVED
            }
            elem :: impl_side(typed, typed.iter_element_types, iter_ty, "")
            if elem == null {
                if iter_ty.args.len() >= 1 {
                    return iter_ty.args[0]
                }
                return TY_UNRESOLVED
            }
            // Substitute the impl's TypeParam against the
            // struct's declared type_params + concrete args
            // (`Range<T> implements Iterator<T>` records the
            // impl-side `T` — substitute_by_name swaps it
            // for the call-site's concrete arg by name).
            decl :: typed.struct_decls[iter_ty.symbol.id] ?? return elem
            return substitute_by_name(elem, decl.type_params, iter_ty.args)
        }
        // A distinct or an enum keeps its own `Iterator` impl, recorded under its
        // declaration ; a distinct without one iterates through its backing.
        is DistinctType -> {
            own :: impl_side(typed, typed.iter_element_types, iter_ty, "")
            if own != null {
                return own
            }
            return for_in_element(iter_ty.backing, typed)
        }
        is EnumType -> {
            elements :: typed.iter_element_types
            element :: impl_side(typed, elements, iter_ty, "") ?? return TY_UNRESOLVED
            return element
        }
        is TraitType  -> {
            // An erased `Iterator<E>` trait value (a boxed generator / a `.into()`
            // result stored as the trait) carries its element as the sole type arg.
            // Without this a `for x in it` over such a value leaves the loop var
            // unresolved → it defaults to `i32`, which happens to match an i32
            // element but mis-types every other (e.g. `Iterator<string>` → `i32.add`).
            //
            // A type-param-bearing element — a bare `T` inside a generic combinator
            // (`my_map<T, U>(self: Iterator<T>, …)`), or a composite like `[K, V]` /
            // `T[]` — is returned AS WRITTEN. It is the honest type of the loop var
            // in that body, and it is what LSP hover and the typecheck snapshots
            // read. Concretising it is the LOWERER's job, per instance: the entry's
            // `Substitution` binds `T`, and `resolve_element_type` applies it.
            return iterator_element_of(iter_ty) ?? TY_UNRESOLVED
        }
        _                   -> { return TY_UNRESOLVED }
    }
}

// A receiver `for_in_element` found no element for, that is not merely a type
// still to be decided — an unresolved one carries its own diagnostic, a type
// parameter or `Self` is iterated per instance, an erased `Any` is not ours to
// judge, `never` is dead code — nor a string, which the lowering walks by
// codepoint without an element type here.
is_known_non_iterable :: fn(t: Type) -> bool {
    if t is UnresolvedType | TypeParamType | SelfType | AnyType | NeverType {
        return false
    }
    if t is PrimitiveType {
        return t.name != "string"
    }
    return true
}

lookup_return_type :: fn(fn_decl: AST.FnDecl, typed: TypedProgram) -> Type {
    sym :: lookup_decl_symbol_stmt(typed.resolved, fn_decl)
    decl_ty :: match sym {
        is Symbol -> typed.decl_types[sym.id]
        is null   -> typed.impl_method_decl_types[fn_decl.name_span.hash()]
    }
    if decl_ty is null   { return TY_UNRESOLVED }
    if decl_ty is FnType { return decl_ty.return_type }
    return TY_UNRESOLVED
}

/// Walk a let-binding tree and write the inferred / declared type into
/// `typed.local_types` keyed by the binding span (the same span the
/// resolver passed to `mint_local`). Wildcards are skipped — they
/// don't introduce a Symbol.
export assign_binding_types :: fn(
    b: AST.LetBinding,
    declared: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    match b {
        is AST.SimpleBinding   -> { typed.local_types[b.name_span.hash()] = declared }
        is AST.RestBinding     -> { typed.local_types[b.span.hash()] = declared }
        is AST.WildcardBinding -> {}
        is AST.TupleBinding    -> { assign_tuple(b, declared, typed, diags) }
    }
}

assign_tuple :: fn(
    tb: AST.TupleBinding,
    declared: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    // A tuple- or array-backed distinct newtype (`Coord :: [i32, i32]`,
    // `BigInt :: u32[]`) destructures through its backing composite — the
    // shape checks are identical, only the nominal wrapper is stripped.
    tup :: tuple_backing(declared)
    if tup != null {
        for leaf in tb.elements {
            if leaf is AST.RestBinding {
                diags.push(typecheck_error(
                    .TypeMismatch, leaf.span,
                    "a `...rest` binding collects from an array, got `${display_type(declared)}`"))
                for each in tb.elements {
                    assign_binding_types(each, TY_UNRESOLVED, typed, diags)
                }
                return
            }
        }
        if tup.elements.len() != tb.elements.len() {
            // Best-effort : Unresolved on each leaf, the resolver-
            // emitted shape error already surfaces upstream.
            for leaf in tb.elements {
                assign_binding_types(leaf, TY_UNRESOLVED, typed, diags)
            }
            return
        }
        for i in 0..<tb.elements.len() {
            assign_binding_types(tb.elements[i], tup.elements[i], typed, diags)
        }
        return
    }
    // Array destructuring : `[first, …rest] := arr` binds every simple/wildcard
    // slot to the element type and the `RestBinding` to a fresh backing array
    // (the raw slice, not the nominal newtype).
    arr :: array_backing(declared)
    if arr != null {
        for leaf in tb.elements {
            if leaf is AST.RestBinding {
                assign_binding_types(leaf, arr, typed, diags)
            } else {
                assign_binding_types(leaf, arr.element, typed, diags)
            }
        }
        return
    }
    // A `[...]` pattern against a value that is neither a tuple nor an
    // array — a struct that implements `Into<[...]>` of the same arity.
    // The value destructures by binding each leaf to the coerced tuple's
    // element type. (Maps no longer take this path : they yield `[K, V]`
    // tuples, an ordinary tuple destructure.)
    coerced :: into_tuple_target(declared, tb.elements.len(), typed)
    if coerced is TupleType {
        for i in 0..<tb.elements.len() {
            assign_binding_types(tb.elements[i], coerced.elements[i], typed, diags)
        }
        return
    }
    // Skip the diagnostic when the value type is unresolved (upstream
    // error already fired).
    if declared !is UnresolvedType {
        diags.push(
            typecheck_error(
                .TypeMismatch,
                tb.span,
                "cannot destructure a value of type ${display_type(declared)} ; a `[...]` pattern requires a tuple or array",
            ),
        )
    }
    for leaf in tb.elements {
        assign_binding_types(leaf, TY_UNRESOLVED, typed, diags)
    }
}

// The trait a `for` over `iter_ty` would reach through several impls : `Iterator`,
// or, for a struct that is no `Iterator` itself, the `Into` toward one
// (`Into<Iterator<i32>!>` beside `Into<Iterator<string>!>`). Null when one serves.
several_iterators_trait :: fn(iter_ty: Type, typed: TypedProgram) -> string | null {
    iterator :: core_trait_key(TRAIT_ITERATOR)
    if implements_more_than_once(iter_ty, iterator, typed) {
        return iterator
    }
    if iter_ty !is StructType || struct_implements_trait(iter_ty, iterator, typed) {
        return null
    }
    into :: core_trait_key(TRAIT_INTO)
    n := 0
    for args in struct_trait_arg_lists(iter_ty, into, typed) {
        if args.len() == 1 && iterator_element_of(args[0]) != null {
            n += 1
        }
    }
    return if n > 1 { into } else { null }
}

// Resolve the `[...]` destructure coercion for a non-tuple / non-array
// value : when `declared` is a struct implementing `Into<[...]>` of
// `arity` elements, return that target tuple with the impl's type params
// substituted by the concrete instance args (so a `Pair<string, i32>`
// implementing `Into<[string, i32]>` yields `[string, i32]`). Returns null
// when no such coercion applies.
// The lowerer resolves the matching `into` member's field names from the
// impl body (`into_tuple_fields`) to bind each leaf zero-alloc.
into_tuple_target :: fn(declared: Type, arity: usize, typed: TypedProgram) -> Type | null {
    if declared !is StructType {
        return null
    }
    decl :: typed.struct_decls[declared.symbol.id] ?? return null
    // Among its `Into` impls (`Into<[string, i32]>` beside `Into<Label>`), the one
    // toward a tuple of that arity.
    for into_args in struct_trait_arg_lists(declared, core_trait_key(TRAIT_INTO), typed) {
        if into_args.len() != 1 {
            continue
        }
        target :: substitute_by_name(into_args[0], decl.type_params, declared.args)
        if target is TupleType {
            if target.elements.len() == arity {
                return target
            }
        }
    }
    return null
}

// ---- tests ----------------------------------------------------------------
//
// Local `stmt_check_stub` avoids importing `expr.vader` (would create a
// load-time cycle through `expr → stmt`). Full end-to-end coverage runs
// via `check_module_with_bodies` in `orchestrate.vader`.

import "std/testing"
import "vader/parser"
import "vader/resolver"
import "toolchain/span"
// Bundles parse + resolve + declare + walks fn bodies with the stub.
// Returns both `typed` and `diags` so test sites can assert on either.
StubResult :: struct {
    typed: TypedProgram
    diags: Diagnostic[]
}

stub_check_module :: fn(src: string) -> StubResult {
    parsed :: parse_source(src, "t.vader")
    factory :: SymbolFactory {}
    rm :: resolve_module(parsed.program, "t", factory)
    typed :: new_typed_program(rm)
    diags: Diagnostic[]: []
    declare_module(parsed.program.decls, rm, typed, factory, diags)
    for decl in parsed.program.decls {
        if decl is AST.FnDecl {
            match decl.body as body {
                is AST.BlockExpr -> {
                    check_fn_body(decl, body, typed, diags, stmt_check_stub)
                }
                is null          -> {}
            }
        }
    }
    return StubResult { .typed = typed, .diags = diags }
}

// Tiny check_expr replacement — only the variants the inline tests
// exercise (int / string literals + idents). FreeInt narrowing reuses
// the shared `narrow_for_expected` so the stub matches the real
// orchestrator's behavior.
stmt_check_stub :: fn(
    e: AST.Expr,
    expected: Type | null,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type {
    // @partial: test stub — only the literal / ident expr kinds the inline
    // tests build are typed; every other Expr is irrelevant here → unresolved.
    @partial match e {
        is AST.IntLitExpr    -> { return narrow_for_expected(TY_FREE_INT, expected) }
        is AST.StringLitExpr -> { return TY_STRING }
        is AST.IdentExpr     -> { return infer_ident(e, typed) }
        _                    -> { return TY_UNRESOLVED }
    }
}

has_code :: fn(diags: Diagnostic[], code: string) -> bool {
    for d in diags {
        if d.code.id == code {
            return true
        }
    }
    return false
}

@test
test_let_simple_binding_records_local_type :: fn() -> void {
    src :: "f :: fn() -> i32 { x :: 42 }"
    out :: stub_check_module(src)
    sb :: first_simple_binding(src)
    if sb is null {
        assert(false, "expected SimpleBinding")
        return
    }
    ty :: out.typed.local_types[sb.name_span.hash()]
    if ty is null {
        assert(false, "binding should have a type")
        return
    }
    // Bare `42` defaults to i32 via `default_if_free`.
    assert_eq(display_type(ty), "i32")
}

@test
test_let_with_annotation_narrows_free_int :: fn() -> void {
    src :: "f :: fn() -> i64 { x: i64 = 5 }"
    out :: stub_check_module(src)
    sb :: first_simple_binding(src)
    if sb is null {
        assert(false, "expected SimpleBinding")
        return
    }
    ty :: out.typed.local_types[sb.name_span.hash()]
    if ty is null {
        assert(false, "binding should have a type")
        return
    }
    assert_eq(display_type(ty), "i64")
}

@test
test_let_annotation_mismatch_emits_T3001 :: fn() -> void {
    out :: stub_check_module("f :: fn() -> void { x: i32 = \"hello\" }")
    assert(has_code(out.diags, "T3001"), "expected T3001 on annotation mismatch")
}

@test
test_assign_incompatible_emits_T3063 :: fn() -> void {
    out :: stub_check_module("f :: fn() -> void { y := 5\n    y = \"nope\" }")
    assert(has_code(out.diags, "T3063"), "expected T3063 on incompatible reassignment")
}

@test
test_assign_compatible_no_T3063 :: fn() -> void {
    out :: stub_check_module("f :: fn() -> void { y := 5\n    y = 6 }")
    assert(!has_code(out.diags, "T3063"), "compatible reassignment must not emit T3063")
}

@test
test_return_value_mismatch_emits_T3020 :: fn() -> void {
    out :: stub_check_module("f :: fn() -> i32 { return \"hello\" }")
    assert(has_code(out.diags, "T3020"), "expected T3020 on return-type mismatch")
}

@test
test_return_bare_in_non_void_emits_T3020 :: fn() -> void {
    out :: stub_check_module("f :: fn() -> i32 { return }")
    assert(has_code(out.diags, "T3020"), "expected T3020 on bare return in non-void fn")
}

@test
test_for_in_array_narrows_binding :: fn() -> void {
    src :: "f :: fn(xs: i32[]) -> void { for x in xs { } }"
    out :: stub_check_module(src)
    sp :: first_for_in_binding_span(src)
    if sp is null {
        assert(false, "expected a for-in")
        return
    }
    ty :: out.typed.local_types[sp.hash()]
    if ty is null {
        assert(false, "for-in binding should have a type")
        return
    }
    assert_eq(display_type(ty), "i32")
}

// ---- test walkers ---------------------------------------------------------

first_simple_binding :: fn(src: string) -> AST.SimpleBinding | null {
    parsed :: parse_source(src, "t.vader")
    if parsed.program.decls[0] is AST.FnDecl as f {
        if f.body is AST.BlockExpr as b {
            for s in b.stmts {
                if s is AST.LetStmt {
                    if s.binding is AST.SimpleBinding {
                        return s.binding
                    }
                }
            }
        }
    }
    return null
}

first_for_in_binding_span :: fn(src: string) -> Span | null {
    parsed :: parse_source(src, "t.vader")
    if parsed.program.decls[0] is AST.FnDecl as f {
        if f.body is AST.BlockExpr as b {
            for s in b.stmts {
                if s !is AST.ForStmt {
                    continue
                }
                if s.form is AST.InFor as inf {
                    if inf.loop_var is AST.NamedVar as nv {
                        return nv.span
                    }
                }
            }
        }
    }
    return null
}
