// Assignability dispatch + per-variant fns. The dispatcher does the
// symmetric pre-checks (Unresolved, Never, equals, opaque TypeParam),
// then routes to one of the per-variant fns via a single `match from`.
//
// All variants pass through `check_common` last : `to is Union` element-wise
// widening. Several "no implicit widening" variants (Primitive, Enum, TypeMeta,
// Self, …) have no logic beyond the common path and skip the dedicated fn
// entirely.
//
// Why the split : a single fn matching `from × to` over 15 × 15
// variants compiles to a ~50 k-line C monster ; splitting into one
// fn per `from` variant bounds each at ~50 C lines and lets cc's
// per-fn passes scale.

module "vader/typecheck"

import "std/collections"
import "vader/types"
import "toolchain/span"
import "vader/diagnostics"

/// Whether `from` can flow into a slot expecting `to` without explicit coercion.
///
/// Answers NO for a `to` that is a trait, even when `from` implements it: this
/// module sees types only, never the impl registry. Trait widening is therefore
/// somebody else's question — `field.vader::receiver_fits_first_param` asks it
/// through `try_trait_widen`, which does have the registry. (A callback parameter
/// for that purpose was once threaded through every fn here; no caller ever
/// supplied one, so the branch it guarded never ran, and both are gone.)
export is_assignable :: fn(from: Type, to: Type) -> bool {
    if from is UnresolvedType { return true }
    if to   is UnresolvedType { return true }
    if from is NeverType      { return true }
    // Mutation markers are deliberately OUTSIDE type identity: `equals_type`
    // ignores `params_mutable`, so two fn types differing only by a `!` stay one
    // type for monomorphisation, erasure and the bytecode — no duplicated monos.
    // That makes the equality short-circuit below blind to the marker, hence this
    // guard ahead of it. Assignability is a different question from identity.
    if fn_mutability_widens(from, to) { return false }
    if mutability_widens(from, to) { return false }
    if equals_type(from, to) { return true }

    // A type parameter is opaque : the body must hold for every instance, so only
    // the same parameter fits it (`y: i64` returned as a `T` is a `T = string`
    // instance returning an integer), and it fits nothing but a union naming it
    // (`check_common` below). Matching an argument against a signature nothing has
    // instantiated yet is another question, asked on `erase_type_params(param)`.
    if to is TypeParamType { return false }

    // @partial: variants with a bespoke rule are listed; everything else shares check_common.
    return @partial match from {
        is StructType    -> is_assignable_struct(from, from, to)
        is TraitType     -> is_assignable_trait_from(from, from, to)
        is TupleType     -> is_assignable_tuple(from, from, to)
        is ArrayType     -> is_assignable_array(from, from, to)
        is FnType        -> is_assignable_fn(from, from, to)
        is UnionType     -> is_assignable_union(from, from, to)
        is FreeIntType | FreeCharType | FreeFloatType -> is_assignable_free_literal(from, to)
        _                -> check_common(from, to)
    }
}

/// The widening every variant falls through to when its own dispatch found
/// nothing : `to is Union`, walked element-wise. A `to` that is a TRAIT is not
/// handled — see `is_assignable`'s note on why that answer lives elsewhere.
export check_common :: fn(from: Type, to: Type) -> bool {
    match to {
        is UnionType -> {
            for v in to.variants {
                if is_assignable(from, v) { return true }
            }
        }
        _ -> {}
    }
    return false
}

/// `from is StructType`. Nominal match with TypeParam-bearing args.
///
/// **Immutability is deliberately NOT part of assignability here.** The bit a
/// parameter gets from the `!` desugaring says "THIS FUNCTION won't mutate it",
/// a promise about the body — not "this value is frozen". Making it travel with
/// the value would ban every factory (`FnState { .ctx = ctx }`), passthrough
/// (`fn(f: BcFunction) -> BcFunction`) and registry insert in the tree, and the
/// surface has no way to write the read-only form of a struct field or return
/// type anyway. The bit is read by the MUTATION checks instead, which is where
/// the promise actually bites.
///
/// `ArrayType` is the exception, and on purpose : read-only `T[]` is an explicit,
/// writable annotation that freezes the REFERENT (module consts, `.bytes()`
/// views), so it stays covariant in `is_assignable_array`.
export is_assignable_struct :: fn(from: Type, self: StructType, to: Type) -> bool {
    match to {
        is StructType -> {
            if self.symbol.id == to.symbol.id {
                if struct_args_compatible(self.args, to.args) { return true }
            }
        }
        _ -> {}
    }
    return check_common(from, to)
}

/// `from is TraitType`. Same nominal-with-args shape as StructType.
export is_assignable_trait_from :: fn(from: Type, self: TraitType, to: Type) -> bool {
    match to {
        is TraitType -> {
            if self.symbol.id == to.symbol.id {
                if struct_args_compatible(self.args, to.args) { return true }
            }
        }
        _ -> {}
    }
    return check_common(from, to)
}

/// `from is TupleType`. Element-wise and **invariant** : a tuple's fields are
/// laid out by their types and read with no test, so `[i32, i32]` read as
/// `[i32 | string, i32]` would take a raw word for a box. A fresh literal adopts
/// the target's element types instead. No Array ↔ Tuple by design.
/// Immutability is not part of assignability — see `is_assignable_struct`.
export is_assignable_tuple :: fn(from: Type, self: TupleType, to: Type) -> bool {
    match to {
        is TupleType -> {
            if self.elements.len() != to.elements.len() { return false }
            for i in 0..<self.elements.len() {
                if !fits_tuple_field(self.elements[i], to.elements[i]) {
                    return false
                }
            }
            return true
        }
        _ -> {}
    }
    return check_common(from, to)
}

/// `from is ArrayType`. `T[]! <: T[]` (mutable into read-only ; reverse
/// forbidden). The element is **covariant** into a `const` (read-only) target
/// whose reads take the source's slots as they are laid out (`reads_slots_of`),
/// but **invariant** into a mutable one : covariance on a mutable array is
/// unsound (arrays are reference-aliased — SPEC §Arrays — so a write through a
/// widened alias would violate the source element type). Unresolved elements
/// stay wildcards (accepted both ways by `is_assignable`).
export is_assignable_array :: fn(from: Type, self: ArrayType, to: Type) -> bool {
    if to is ArrayType {
        if self.immutable && !to.immutable { return false }
        // read-only `T[]` (read-only) target : element is covariant — reading a
        // narrower array through a wider read-only view is sound (no write can
        // violate the source element type), as long as the view reads the
        // buffer the source wrote.
        if to.immutable {
            return fn_param_compatible(self.element, to.element)
                && reads_slots_of(to.element, self.element)
        }
        // Mutable target : element must be INVARIANT. Bidirectional
        // assignability = invariance for concrete types, while the
        // Unresolved wildcard (true both ways in `is_assignable`) survives.
        // A covariant `i32[]` → `(i32 | string)[]` is rejected here —
        // a write `b[0] = "hi"` through the alias would corrupt the shared i32
        // buffer. Fresh literals sidestep this : they adopt the target element
        // type in `infer_against_array`, so the init is reflexive.
        // Fast-path the dominant equal-element case (`equals_type` ⟹ assignable
        // both ways) so `T[] → T[]` skips the two `is_assignable` passes.
        if equals_type(self.element, to.element) { return true }
        return fn_param_compatible(self.element, to.element)
            && fn_param_compatible(to.element, self.element)
    }
    return check_common(from, to)
}

/// How many arrays deep `from` fits `to` only by widening an element: 1 for
/// `Circle[]` into `(Circle | null)[]`, 2 for `Circle[][]` into
/// `(Circle | null)[][]`. Null when `from` is no array, or when its elements
/// differ from the slot's by their `!` alone.
///
/// @param from  the argument's type.
/// @param to    the parameter's type: an array, or a union holding one.
export widening_depth :: fn(from: Type, to: Type) -> i32 | null {
    if from !is ArrayType {
        return null
    }
    slot :: array_slot(from, to) ?? return null
    if equals_type(from.element, slot.element) || equals_type_shape(from.element, slot.element) {
        return null
    }
    deeper :: widening_depth(from.element, slot.element) ?? return 1
    return deeper + 1
}

// The array `to` offers `from`: `to` itself, or the first array of a union that
// takes it.
array_slot :: fn(from: ArrayType, to: Type) -> ArrayType | null {
    if to is ArrayType {
        return to
    }
    for v in union_variants(to) ?? [] {
        if v is ArrayType && is_assignable(from, v) {
            return v
        }
    }
    return null
}

/// `from is FnType`. Params contravariant, return covariant.
export is_assignable_fn :: fn(from: Type, self: FnType, to: Type) -> bool {
    match to {
        is FnType -> {
            if self.params.len() != to.params.len() { return false }
            for i in 0..<self.params.len() {
                if !fn_param_compatible(to.params[i], self.params[i]) { return false }
                // `!` markers are contravariant, like the param types around them:
                // a fn that does NOT mutate fits a slot that would allow it (it
                // simply promises less), while one that DOES mutate cannot be
                // handed to a caller expecting a read-only borrow.
                if param_mutable_at(self, i) && !param_mutable_at(to, i) { return false }
            }
            return fn_param_compatible(self.return_type, to.return_type)
        }
        _ -> {}
    }
    return check_common(from, to)
}

/// Diagnostic for a value of type `got` that does not fit a slot of type
/// `expected`, picking the message that explains the actual cause.
///
/// A `!` mismatch between two fn types otherwise renders as a plain type mismatch
/// whose two sides differ by a single character (`fn(T)` vs `fn(T!)`) — easy to
/// stare past. T3073 says what is wrong instead of leaving it to be spotted.
///
/// @param got       the value's type.
/// @param expected  the slot's type.
/// @param span      where to anchor the diagnostic.
/// @param fallback  the code to use when the cause is an ordinary mismatch.
/// @param hint      `mutability_level_hint`'s output, empty unless the two types
///                  differ by mutability alone ; "" when the caller has no value
///                  expression to reason from.
/// @param typed     reads the bound of a type parameter in `got`.
/// T3097 : `t` implements `trait_key` more than once, and `what` reaches the trait
/// without naming its arguments.
///
/// @param what  the use, as the detail names it (`` `for` ``).
export several_impls_error :: fn(
    t: Type,
    trait_key: string,
    what: string,
    span: Span,
) -> Diagnostic {
    // The impls are the type's, whatever the slot's rights.
    shown :: display_type(strip_mutability(t))
    implemented :: "`${shown}` implements `${trait_key_name(trait_key)}` more than once"
    return typecheck_error(
        .TraitImplementedSeveralTimes,
        span,
        "${implemented} ; ${what} cannot tell its impls apart",
    )
}

export mismatch_diagnostic :: fn(
    got: Type, expected: Type, span: Span, fallback: TypecheckCode, hint: string,
    typed: TypedProgram,
) -> Diagnostic {
    // A trait value of a trait `got` implements several times : nothing it dispatches
    // through can tell the impls apart (`try_trait_widen` refuses it).
    if expected is TraitType {
        trait_key :: trait_key_of(expected.symbol)
        if implements_more_than_once(got, trait_key, typed) {
            what :: "a `${display_type(expected)}` value, which dispatches by the trait alone,"
            return several_impls_error(got, trait_key, what, span)
        }
    }
    // A read-only value into a slot promising mutation, at any level. Same treatment
    // as the fn case below : a dedicated wording, because "expected Cfg!, got Cfg"
    // says nothing about WHY they differ nor where to fix it.
    bounds :: typed.type_param_bound_traits
    if mutability_widens(got, expected, false, bounds) {
        what :: if got is FnType { "returns a read-only value" } else { "is read-only" }
        return typecheck_error(
            .ImmutableValueIntoMutableSlot,
            span,
            "`${display_type(got)}` ${what}, but this slot is declared `${display_type(expected)}`${hint}",
        )
    }
    // The other way round : a level that holds MORE rights than the slot's, where
    // the slot's holder could store a read-only value its owner then writes.
    if mutability_widens(got, expected, true, bounds) {
        return typecheck_error(
            fallback,
            span,
            "expected ${display_type(expected)}, got ${display_type(got)}${hint} — through a mutable array or struct, and in a trait's arguments, the `!` must match ; a fn cannot take a parameter with other rights than its slot hands it",
        )
    }
    if fn_mutability_widens(got, expected) {
        return typecheck_error(
            .FnValueMutabilityMismatch,
            span,
            "`${display_type(got)}` mutates a parameter that `${display_type(expected)}` lends out read-only — drop the `!`, or mark the slot's parameter `!` to allow it",
        )
    }
    return typecheck_error(
        fallback,
        span,
        "expected ${display_type(expected)}, got ${display_type(got)}${hint}",
    )
}

/// True when `from` would GAIN mutation rights that `to` grants and it does not —
/// the one direction the marker forbids, at every structural level. Under a mutable
/// array spine the element must not LOSE rights either, nor a mutable struct's type
/// arguments, nor a trait's ; a distinct answers for its backing, and a fn's
/// parameters are compared the other way round.
///
/// It has to run ahead of `is_assignable`'s equality short-circuit, because
/// `equals_type` leaves the struct / tuple bit out of type identity ON PURPOSE (two
/// `Cfg` are one type whether or not a borrow is read-only, which is what keeps
/// caches, union dedup and monomorphisation keys stable). That makes the
/// short-circuit blind to the marker at every level, so a guard built one shape at a
/// time can never catch up — this walks the positions `strip_mutability` does. The
/// `!` on a fn parameter's NAME is the one position left to `fn_mutability_widens`.
///
/// Without this a read-only borrow launders through any slot promising mutation, a
/// struct-literal field being the reachable one :
/// `steal :: fn(c: Cfg) -> Holder! = Holder { .cfg = c }` where `cfg: Cfg!`, then
/// `h.cfg.n = 99` writes the CALLER's value. T3072 only ever covered a call
/// argument, hand-written at that one site.
///
/// @param from    the value's type.
/// @param to      the slot's type.
/// @param strict  false leaves out the positions where a value LOSING rights is the
///                fault — a mutable array's element, a mutable struct's or a trait's
///                arguments, a fn's parameters — for the caller that only words a
///                diagnostic.
/// @param bounds  the type-parameter bounds (`type_param_bound_traits`), to judge a
///                `T` widening into a trait value ; null for `is_assignable`, which
///                never widens one.
mutability_widens :: fn(
    from: Type, to: Type, strict: bool = true,
    bounds: MutableMap<i32, TypeParamBound> | null = null,
) -> bool {
    // A value widening into a trait value keeps its own rights : a read-only `Cfg`
    // does not fill a `Bump!`, whose holder calls its `self!` members, nor does a `T`
    // whose bound is unmarked. A trait's arguments are invariant — its methods may
    // store what they are handed (`put :: fn(self!, v: T)`), so a `Sink<Cfg!>` lent
    // as a `Sink<Cfg>` would take in a read-only `Cfg`.
    if to is TraitType {
        if !to.immutable && withholds_mutation(from, bounds) {
            return true
        }
        return from is TraitType && any_widens(from.args, to.args, strict, true, bounds)
    }
    if to is UnionType && from !is UnionType {
        if from is TypeParamType && view_widens_into_any(from, to.variants) {
            return true
        }
        return widens_into_trait_variant(from, to.variants, strict, bounds)
    }
    if from is TypeParamType {
        return view_widens_into(from, to)
    }
    if from is StructType {
        if to is StructType {
            // The SAME struct at two mutabilities — without the symbol check this fired
            // on any read-only struct against any mutable one (`Subst` vs `Scope!`),
            // turning an ordinary type mismatch into a mutability story.
            if from.symbol.id != to.symbol.id {
                return false
            }
            if from.immutable && !to.immutable {
                return true
            }
            // Through a mutable struct its type arguments are invariant, as an
            // array's element is : a `Box<Cfg>!` slot could store a read-only `Cfg`
            // in the `Box<Cfg!>` its owner then writes through.
            return any_widens(from.args, to.args, strict, !to.immutable, bounds)
        }
        return false
    }
    if from is TupleType {
        if to is TupleType {
            if from.elements.len() != to.elements.len() {
                return false
            }
            if from.immutable && !to.immutable {
                return true
            }
            return any_widens(from.elements, to.elements, strict, false, bounds)
        }
        return false
    }
    // The array's own spine bit is `is_assignable_array`'s, which sees it. Its
    // ELEMENT is what nothing else looks at — in both directions under a mutable
    // spine, whose holder may store an element of the slot's rights : a `Cfg![]!`
    // handed to a `Cfg[]!` would take in a read-only `Cfg` its owner then writes.
    if from is ArrayType {
        if to is ArrayType {
            loses :: strict && !to.immutable
            if loses && mutability_widens(to.element, from.element, true, bounds) {
                return true
            }
            return mutability_widens(from.element, to.element, strict, bounds)
        }
        return false
    }
    // A distinct type's bit is its backing's, spine included : `equals_type` matches
    // two distincts on their symbol alone, so no `is_assignable_array` sees it.
    if from is DistinctType {
        if to is DistinctType {
            if from.symbol.id != to.symbol.id {
                return false
            }
            if type_is_immutable(from) && !type_is_immutable(to) {
                return true
            }
            return mutability_widens(from.backing, to.backing, strict, bounds)
        }
        return false
    }
    // A fn's parameters are contravariant — the slot's caller hands its arguments to
    // `from` — and its return covariant : a fn handing out a read-only value cannot
    // fill a slot promising a mutable one, or `g().x = 9` writes through it. The
    // `!` on a parameter's NAME is `fn_mutability_widens`'s.
    if from is FnType {
        if to is FnType {
            if strict && any_widens(to.params, from.params, true, false, bounds) {
                return true
            }
            return mutability_widens(from.return_type, to.return_type, strict, bounds)
        }
        return false
    }
    // A union's variants pair by INDEX, and the pairing is EXACT : `union_of` sorts
    // on `display_type_key`, which drops the marker at every level, and dedups with
    // the marker-blind `equals_type` — so two unions of the same variants sort the
    // same way whatever their markers, and one union can never hold both `Box` and
    // `Box!`. The single key-tie, `T[] | T[]!`, is T3074 before it reaches here.
    if from is UnionType {
        if to is UnionType {
            if any_widens(from.variants, to.variants, strict, false, bounds) {
                return true
            }
            // The pairing matches variants of one shape ; a variant of another shape
            // fills a trait value (`T | null` into `Bump! | null`).
            for f in from.variants {
                if widens_into_trait_variant(f, to.variants, strict, bounds) {
                    return true
                }
            }
        }
        return false
    }
    return false
}

// Element-wise `mutability_widens`, for the positions that pair by INDEX — nominal
// args, tuple elements and union variants. A length mismatch is an ordinary type
// mismatch, not a mutability story, so it is left to the shape check. `invariant`
// also refuses an element that LOSES rights, under `strict` : the arguments of a
// mutable struct or of a trait, which their holder may store into.
any_widens :: fn(
    from: Type[], to: Type[], strict: bool = true, invariant: bool = false,
    bounds: MutableMap<i32, TypeParamBound> | null = null,
) -> bool {
    if from.len() != to.len() {
        return false
    }
    for i in 0..<from.len() {
        if mutability_widens(from[i], to[i], strict, bounds) {
            return true
        }
        if strict && invariant && mutability_widens(to[i], from[i], true, bounds) {
            return true
        }
    }
    return false
}

// A value fills ONE variant of a union slot. A variant of its own shape is
// `is_assignable_union`'s to judge ; otherwise it is a trait value it widens into, so
// a read-only `Cfg` does not fill a `Bump! | null`.
widens_into_trait_variant :: fn(
    from: Type, variants: Type[], strict: bool,
    bounds: MutableMap<i32, TypeParamBound> | null,
) -> bool = widened_trait_variant(from, variants, strict, bounds) != null

// The trait value among `variants` that a value of `from` fills and widens — null when
// it widens none, or a variant has its own shape.
widened_trait_variant :: fn(
    from: Type, variants: Type[], strict: bool,
    bounds: MutableMap<i32, TypeParamBound> | null,
) -> Type | null {
    for v in variants {
        if v is TraitType && mutability_widens(from, v, strict, bounds) {
            for w in variants {
                if equals_type_shape(w, from) {
                    return null
                }
            }
            return v
        }
    }
    return null
}

// Whether `from`, a read-only view of a `T` — a `Self` lent read-only — would fill
// that `T`, which stands at its instance's rights.
view_widens_into :: fn(from: TypeParamType, to: Type) -> bool =
    from.immutable && to is TypeParamType && to.symbol.id == from.symbol.id && !to.immutable

view_widens_into_any :: fn(from: TypeParamType, variants: Type[]) -> bool {
    for v in variants {
        if view_widens_into(from, v) {
            return true
        }
    }
    return false
}

// Whether `arg` hands a read-only view of a `T` to a `slot` standing for that `T`.
lends_view :: fn(arg: Type, slot: Type) -> bool {
    if arg is UnionType {
        for v in arg.variants {
            if lends_view(v, slot) {
                return true
            }
        }
        return false
    }
    if arg !is TypeParamType {
        return false
    }
    if slot is UnionType {
        return view_widens_into_any(arg, slot.variants)
    }
    return view_widens_into(arg, slot)
}

// Whether a slot of type `t` may hand what fills it to a mutation : a type that may
// grant one, or a `T` whose bound lets a body mutate through it. A `T` under an
// unmarked bound is stored as it came, since nothing can mutate it there.
slot_may_grant_mutation :: fn(t: Type, bounds: MutableMap<i32, TypeParamBound>) -> bool {
    if t is TypeParamType {
        return !t.immutable && bound_grants_mutation(t, bounds)
    }
    if t is UnionType {
        for v in t.variants {
            if slot_may_grant_mutation(v, bounds) {
                return true
            }
        }
        return false
    }
    return type_may_grant_mutation(t)
}

// `type_withholds_mutation`, with a type parameter judged through its bound : a `T`
// grants mutation only when a trait of its bound is marked `!` (`T: Bump!`), since a
// call may bind it to a read-only type otherwise. Without `bounds` a `T` withholds
// nothing, as `type_withholds_mutation` answers.
withholds_mutation :: fn(t: Type, bounds: MutableMap<i32, TypeParamBound> | null) -> bool {
    if bounds == null {
        return type_withholds_mutation(t)
    }
    if t is TypeParamType {
        return t.immutable || !bound_grants_mutation(t, bounds)
    }
    // `union_of` flattens, so a variant is never a union itself.
    if t is UnionType {
        for v in t.variants {
            if withholds_mutation(v, bounds) {
                return true
            }
        }
        return false
    }
    return type_is_immutable(t)
}

// Whether a trait of `t`'s bound is marked `!` : the call binding `t` must then grant
// mutation (`check_typeparam_bounds`), and the generic body may use it.
bound_grants_mutation :: fn(t: TypeParamType, bounds: MutableMap<i32, TypeParamBound>) -> bool {
    bound :: bounds[t.symbol.id] ?? return false
    for trait_ty in bound.traits {
        if !trait_ty.immutable {
            return true
        }
    }
    return false
}

// Whether a trait's arguments as a type implements them, or a bound names them
// (`have`), match the ones a slot asks for — same shape, and the same rights at
// every position, since the trait's methods may store what they are handed.
trait_args_match :: fn(have: Type[], wanted: Type[]) -> bool =
    struct_args_compatible(have, wanted) && !any_widens(have, wanted, true, true)

/// True when `from` would grant mutation permission that `to` does not — the one
/// direction the `!` marker forbids between two fn types.
///
/// Handing a `fn(T!)` to a slot typed `fn(T)` lets the callee mutate a value its
/// caller lent out read-only, so it is rejected. The reverse is fine: a fn that
/// doesn't mutate simply promises less than the slot allows.
///
/// Answers false for anything that is not a pair of fn types, and for equal
/// arities only — a genuine arity or param-type mismatch is reported by the
/// ordinary assignability rules, not attributed to the marker.
///
/// @return `true` when the ONLY thing to say is "this fn mutates and the slot
///         forbids it" — used both to reject and to pick the T3073 message.
export fn_mutability_widens :: fn(from: Type, to: Type) -> bool {
    if from is FnType {
        if to is FnType {
            if from.params.len() != to.params.len() {
                return false
            }
            for i in 0..<from.params.len() {
                if param_mutable_at(from, i) && !param_mutable_at(to, i) {
                    return true
                }
            }
        }
    }
    return false
}

/// `from is UnionType`. Every variant must be assignable to `to`.
export is_assignable_union :: fn(from: Type, self: UnionType, to: Type) -> bool {
    match to {
        is UnionType -> {
            for v in self.variants {
                if !is_assignable(v, to) { return false }
            }
            return true
        }
        _ -> {}
    }
    return check_common(from, to)
}

// `from` is a free literal : it widens to any primitive of its family
// (`literal_family_holds`), or to a union holding one.
is_assignable_free_literal :: fn(from: Type, to: Type) -> bool {
    if to is PrimitiveType && literal_family_holds(from, to.name) {
        return true
    }
    return check_common(from, to)
}

// ---- helpers shared by struct/fn/array variants ---------------------------

/// Single-arg compatibility used by Fn → Fn and Array → Array. An alias of
/// `is_assignable` that documents the variance intent at the call site.
export fn_param_compatible :: fn(a: Type, b: Type) -> bool {
    return is_assignable(a, b)
}

/// Element-wise compatibility for the args list carried by StructType /
/// TraitType. Length must match ; then each type arg must be **invariant**.
///
/// Invariance (bidirectional `fn_param_compatible`) is the sound default until a
/// declaration-site variance model exists : covariance is unsound for a *mutable*
/// generic container — `MutableMap<i32, i32>` → `MutableMap<i32, i32 | string>`
/// would let a write through the widened alias corrupt the shared `i32` backing,
/// the exact reference-aliasing hole `is_assignable_array` closes for a mutable
/// array element. Unresolved args stay wildcards (true both ways in
/// `is_assignable`) ; a type parameter matches only itself. The equal-arg fast
/// path keeps the dominant `Foo<T>` → `Foo<T>` case single-pass.
export struct_args_compatible :: fn(a: Type[], b: Type[]) -> bool {
    if a.len() != b.len() { return false }
    for i in 0..<a.len() {
        if equals_type(a[i], b[i]) { continue }
        if !fn_param_compatible(a[i], b[i]) { return false }
        if !fn_param_compatible(b[i], a[i]) { return false }
    }
    return true
}

// Whether a tuple field of type `from` reads as one of type `to` : a literal
// that takes `to`, or the same type both ways.
fits_tuple_field :: fn(from: Type, to: Type) -> bool {
    if adopts_any_layout(from) {
        return is_assignable(from, to)
    }
    return equals_type(from, to) || (is_assignable(from, to) && is_assignable(to, from))
}

// ---- array slot layout ----------------------------------------------------

// How an array of a given element type lays out its slots, as far as a read
// through a covariant view can tell. Must agree with `array_kind_of`
// (`vader/bytecode/types.vader`), which fixes the layout once types are
// lowered, and with `ref_carrying_element` (`vader/c_emit/walker.vader`), which
// picks the reads that test it : a view whose reads expect another layout reads
// garbage natively.
SlotLayout :: enum {
    // A raw value of the element's own width, or a layout this module cannot
    // tell (a type parameter) : only an array of the same type reads it.
    Raw
    // A heap reference or a box : the reader tests the buffer's kind on every
    // access, so it takes either.
    Dispatched
    // Always a box : the reader takes every slot as one.
    Boxed
}

// Whether a read-only `wide[]` view reads the slots of a `narrow[]` buffer.
reads_slots_of :: fn(wide: Type, narrow: Type) -> bool {
    if equals_type(wide, narrow) || adopts_any_layout(narrow) || wide is UnresolvedType {
        return true
    }
    return match slot_layout(wide) {
        .Dispatched -> slot_layout(narrow) != .Raw
        .Boxed      -> slot_layout(narrow) == .Boxed
        .Raw        -> false
    }
}

// An element with no layout of its own yet : the wildcard, a literal that takes
// the target's type, or `never`.
adopts_any_layout :: fn(t: Type) -> bool = t is UnresolvedType || t is NeverType || is_free_numeric(t)

slot_layout :: fn(t: Type) -> SlotLayout = match t {
    is PrimitiveType -> primitive_slot_layout(t)
    is StructType | ArrayType | FnType | TupleType | TraitType | AnyType -> .Dispatched
    is UnionType -> union_slot_layout(t)
    is DistinctType -> slot_layout(t.backing)
    is EnumType | TypeParamType | SelfType | TypeMetaType -> .Raw
    is NeverType | UnresolvedType | FreeIntType | FreeFloatType | FreeCharType -> .Raw
}

// An array boxes `string` (an atom id), `null` and `void` ; it stores every other
// primitive raw.
primitive_slot_layout :: fn(t: PrimitiveType) -> SlotLayout = match t.name {
    "string" | "null" | "void" -> .Boxed
    _                          -> .Raw
}

// A union of heap references and `null` is stored as raw references ; any other
// union is boxed. A variant whose layout depends on the instance (a type
// parameter) leaves the union's undecided.
union_slot_layout :: fn(t: UnionType) -> SlotLayout {
    layout: SlotLayout = .Dispatched
    for v in t.variants {
        variant :: strip_distinct(v)
        if variant is TypeParamType || variant is SelfType {
            return .Raw
        }
        if !is_heap_reference(variant) && !is_null_type(variant) {
            layout = .Boxed
        }
    }
    return layout
}

// A tuple is a heap object like a struct.
is_heap_reference :: fn(t: Type) = t is StructType || t is ArrayType || t is FnType || t is TupleType

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "vader/resolver/symbol"

@test
test_assignable_identity :: fn() -> void {
    assert(is_assignable(mk_primitive("i32"), mk_primitive("i32")), "i32 → i32")
}

@test
test_assignable_free_int_to_primitive :: fn() -> void {
    assert(is_assignable(TY_FREE_INT, mk_primitive("i64")), "FreeInt → i64")
    assert(!is_assignable(TY_FREE_INT, mk_primitive("string")), "FreeInt → string forbidden")
}

@test
test_assignable_never_to_anything :: fn() -> void {
    assert(is_assignable(TY_NEVER, mk_primitive("i32")), "Never → i32")
    assert(is_assignable(TY_NEVER, mk_primitive("string")), "Never → string")
}

@test
test_assignable_into_union :: fn() -> void {
    i32_t: Type: mk_primitive("i32")
    str_t: Type: mk_primitive("string")
    u :: mk_union([i32_t, str_t])
    assert(is_assignable(mk_primitive("i32"), u), "i32 → i32 | string")
    assert(!is_assignable(mk_primitive("bool"), u), "bool → i32 | string forbidden")
}

@test
test_assignable_array_mut_into_const :: fn() -> void {
    mut_arr: Type: mk_array(mk_primitive("i32"), false)
    const_arr: Type: mk_array(mk_primitive("i32"), true)
    assert(is_assignable(mut_arr, const_arr), "T[]! → T[]")
    assert(!is_assignable(const_arr, mut_arr), "T[] ↛ T[]!")
}

@test
test_array_mutable_element_invariant :: fn() -> void {
    // Covariance into a MUTABLE array is unsound (reference aliasing) — reject
    // both directions ; only an exact element type flows.
    i32_arr:        Type: mk_array(mk_primitive("i32"), false)
    union_arr_mut:  Type: mk_array(mk_union([mk_primitive("i32"), mk_primitive("string")]), false)
    union_arr_mut2: Type: mk_array(mk_union([mk_primitive("i32"), mk_primitive("string")]), false)
    assert(!is_assignable(i32_arr, union_arr_mut),
        "i32[] ↛ (i32 | string)[] (mutable — invariant)")
    assert(!is_assignable(union_arr_mut, i32_arr), "(i32 | string)[] ↛ i32[] (mutable)")
    assert(is_assignable(union_arr_mut, union_arr_mut2),
        "(i32 | string)[] → (i32 | string)[] (equal element)")
}

@test
test_struct_args_invariant :: fn() -> void {
    // Generic container type-args are invariant : the covariant widen of a
    // mutable container (`MutableMap<i32, i32>` → `MutableMap<i32, i32 | string>`)
    // is the reference-aliasing hole rejected here — same as the mutable array.
    i32_t: Type: mk_primitive("i32")
    wide:  Type: mk_union([mk_primitive("i32"), mk_primitive("string")])
    assert(struct_args_compatible([i32_t], [i32_t]), "[i32] → [i32] (equal args)")
    assert(!struct_args_compatible([i32_t], [wide]), "[i32] ↛ [i32 | string] (invariant)")
    assert(!struct_args_compatible([wide], [i32_t]), "[i32 | string] ↛ [i32] (invariant)")
}

@test
test_array_const_element_raw_into_boxed :: fn() -> void {
    // An `i32[]` stores raw words ; a `(i32 | string)[]` view reads boxes.
    i32_arr:         Type: mk_array(mk_primitive("i32"), false)
    union_arr_const: Type: mk_array(mk_union([mk_primitive("i32"), mk_primitive("string")]), true)
    assert(!is_assignable(i32_arr, union_arr_const), "i32[] ↛ const (i32 | string)[]")
}

@test
test_array_const_element_boxed_into_boxed :: fn() -> void {
    string_arr:    Type: mk_array(mk_primitive("string"), false)
    nullable_arr:  Type: mk_array(mk_union([mk_primitive("string"), mk_primitive("null")]), true)
    assert(is_assignable(string_arr, nullable_arr), "string[] → const (string | null)[]")
}

circle_type :: fn() -> Type {
    factory :: SymbolFactory {}
    return mk_struct(factory.make(.Struct, "Circle", "test", "test", .Private, null), [], false)
}

@test
test_array_const_element_reference_into_reference_union :: fn() -> void {
    // A union of references and `null` reads the source's references as they are.
    circles:  Type: mk_array(circle_type(), false)
    nullable: Type: mk_array(mk_union([circle_type(), mk_primitive("null")]), true)
    assert(is_assignable(circles, nullable), "Circle[] → const (Circle | null)[]")
}

@test
test_array_const_element_reference_into_boxed_union :: fn() -> void {
    circles: Type: mk_array(circle_type(), false)
    mixed:   Type: mk_array(mk_union([circle_type(), mk_primitive("string")]), true)
    assert(!is_assignable(circles, mixed), "Circle[] ↛ const (Circle | string)[]")
}

@test
test_array_const_element_tuple_is_a_reference :: fn() -> void {
    pair:     Type: mk_tuple([mk_primitive("i32"), mk_primitive("i32")], false)
    nullable: Type: mk_array(mk_union([pair, mk_primitive("null")]), false)
    mixed:    Type: mk_array(mk_union([pair, mk_primitive("null"), mk_primitive("string")]), true)
    assert(!is_assignable(nullable, mixed), "([i32, i32] | null)[] ↛ const ([i32, i32] | null | string)[]")
}

@test
test_tuple_elements_invariant :: fn() -> void {
    pair: Type: mk_tuple([mk_primitive("i32"), mk_primitive("i32")], false)
    wide: Type: mk_tuple([mk_union([mk_primitive("i32"), mk_primitive("string")]), mk_primitive("i32")], false)
    assert(!is_assignable(pair, wide), "[i32, i32] ↛ [i32 | string, i32]")
}

@test
test_array_unresolved_element_wildcard :: fn() -> void {
    // An Unresolved element (what an empty `[]` literal carries) stays a
    // wildcard both ways, so invariance never rejects it.
    unresolved_arr: Type: mk_array(TY_UNRESOLVED, false)
    i32_arr:        Type: mk_array(mk_primitive("i32"), false)
    assert(is_assignable(unresolved_arr, i32_arr), "?[] → i32[] (mutable — wildcard)")
    assert(is_assignable(i32_arr, unresolved_arr), "i32[] → ?[] (mutable — wildcard)")
}

type_param_named :: fn(name: string) -> Type {
    factory :: SymbolFactory {}
    return mk_type_param(factory.make(.TypeParam, name, "test", "test", .Private, null))
}

@test
test_type_param_is_opaque :: fn() -> void {
    // A generic body holds for every instance at once : only `T` fits a `T`, and a
    // `T` fits only a slot that names it.
    t :: type_param_named("T")
    i64_t: Type: mk_primitive("i64")
    assert(is_assignable(t, t), "T → T")
    assert(!is_assignable(i64_t, t), "i64 ↛ T")
    assert(!is_assignable(t, i64_t), "T ↛ i64")
    assert(!is_assignable(TY_FREE_INT, t), "{integer} ↛ T")
    assert(is_assignable(t, mk_union([t, TY_NULL])), "T → T | null")
}

@test
test_erased_type_param_fits_any_argument :: fn() -> void {
    // Matching against a signature nothing has instantiated yet erases its
    // parameters first.
    t :: type_param_named("T")
    i32_arr: Type: mk_array(mk_primitive("i32"), false)
    assert(!is_assignable(i32_arr, mk_array(t, false)), "i32[] ↛ T[]")
    assert(is_assignable(i32_arr, erase_type_params(mk_array(t, false))), "i32[] → erased T[]")
}

@test
test_widening_depth_of_an_element_into_a_union :: fn() -> void {
    circles: Type: mk_array(circle_type(), false)
    nullable: Type: mk_array(mk_union([circle_type(), TY_NULL]), true)
    assert(widening_depth(circles, nullable) == 1, "Circle[] → (Circle | null)[] widens 1 deep")
}

@test
test_widening_depth_of_rows :: fn() -> void {
    rows: Type: mk_array(mk_array(circle_type(), false), false)
    nullable_rows: Type: mk_array(mk_array(mk_union([circle_type(), TY_NULL]), true), true)
    assert(widening_depth(rows, nullable_rows) == 2, "Circle[][] widens 2 deep")
}

@test
test_widening_depth_ignores_a_mutability_marker :: fn() -> void {
    mutable: Type: mk_array(mk_primitive("i32"), false)
    read_only: Type: mk_array(mk_primitive("i32"), true)
    assert(widening_depth(mutable, read_only) == null, "i32[]! → i32[] widens nothing")
}

@test
test_widening_depth_through_a_nullable_parameter :: fn() -> void {
    circles: Type: mk_array(circle_type(), false)
    slot :: mk_union([mk_array(mk_union([circle_type(), TY_NULL]), true), TY_NULL])
    assert(widening_depth(circles, slot) == 1, "a nullable array slot widens 1 deep")
}
