// vader/typecheck/decl — top-level type collection.
//
// Walks every
// top-level decl in source order, mints its declared `Type`, and stores
// the result in `typed.decl_types` keyed by the decl's `name_span`.
// Later passes (body checking, ImplRegistry building) read this side
// table without re-walking the AST.
//
// Handled here :
//   - `@extern` ABI validation (T3050 / T3051) via `validate_extern`.
//   - Layer 4-sugar const-as-type-alias detection : an un-annotated const
//     whose value is in type position registers an alias / distinct type
//     (`is_type_expr` → `alias_for`) ; an annotated const gets
//     its annotated type ; an un-annotated value const stays un-typed at
//     decl level (its literal type lands in `expr_types` at body time).
//
// Not handled here :
//   - ImplDecls are registered into `ImplRegistry` (`impls.vader`), not here.
//   - AssertDecl is a no-op (handled by comptime).

module "vader/typecheck"

import "std/collections"
import "vader/diagnostics"
import "vader/resolver"
import "vader/resolver/symbol"
AST :: import "toolchain/ast"
import "vader/parser"
import "vader/types"
import "toolchain/span"

/// Walk every top-level decl in `program.decls` and mint its `Type` into
/// `typed.decl_types`. The pass is single-shot — re-running it is
/// idempotent if `decl_types` is cleared first.
///
/// Builds a `name → Symbol` map up front so per-decl lookups don't scan
/// the sorted `resolved.symbols` array N times.
export declare_module :: fn(
    program_decls: AST.Decl[],
    resolved: ResolvedModule!,
    typed: TypedProgram!,
    factory: SymbolFactory!,
    diags: Diagnostic[]!,
) -> void {
    by_name :: MutableMap<string, Symbol> {}
    for s in resolved.symbols {
        by_name[s.name] = s
    }
    for decl in program_decls {
        declare_decl(decl, by_name, resolved, typed, factory, diags)
        register_deprecated(decl, by_name, resolved)
    }
}

register_deprecated :: fn(
    decl: AST.Decl,
    by_name: MutableMap<string, Symbol>,
    resolved: ResolvedModule!,
) -> void {
    name :: decorated_decl_name(decl)
    if name == "" {
        return
    }
    msg :: deprecated_message(decorated_decl_decorators(decl)) ?? return
    sym :: by_name[name] ?? return
    resolved.deprecated_messages[sym.id] = msg
}

decorated_decl_name :: fn(d: AST.Decl) -> string {
    // Only the named decl kinds carry a name; Impl / Assert / Import are
    // anonymous → "" (no symbol to attach a deprecation message to).
    return match d {
        is AST.FnDecl -> { d.name }
        is AST.StructDecl -> { d.name }
        is AST.EnumDecl -> { d.name }
        is AST.TraitDecl -> { d.name }
        is AST.TypeAliasDecl -> { d.name }
        is AST.ConstDecl -> { d.name }
        is AST.ImportDecl | AST.ImplDecl | AST.AssertDecl -> { "" }
    }
}

decorated_decl_decorators :: fn(d: AST.Decl) -> AST.Decorator[] {
    // Only the named decl kinds carry decorators we read here; Impl / Assert /
    // Import contribute none → empty list.
    return match d {
        is AST.FnDecl -> { d.decorators }
        is AST.StructDecl -> { d.decorators }
        is AST.EnumDecl -> { d.decorators }
        is AST.TraitDecl -> { d.decorators }
        is AST.TypeAliasDecl -> { d.decorators }
        is AST.ConstDecl -> { d.decorators }
        is AST.ImportDecl | AST.ImplDecl | AST.AssertDecl -> { [] }
    }
}

deprecated_message :: fn(decs: AST.Decorator[]) -> string | null {
    for d in decs {
        if d.name != "deprecated" {
            continue
        }
        if d.args.len() == 0 {
            return ""
        }
        a :: d.args[0]
        if a is AST.StringLitExpr && a.parts.len() == 1 {
            p :: a.parts[0]
            if p is AST.StringLitText {
                return p.value
            }
        }
        return ""
    }
    return null
}

declare_decl :: fn(
    decl: AST.Decl,
    by_name: MutableMap<string, Symbol>,
    resolved: ResolvedModule!,
    typed: TypedProgram!,
    factory: SymbolFactory!,
    diags: Diagnostic[]!,
) -> void {
    match decl {
        is AST.FnDecl as fn_decl   -> { declare_fn(fn_decl, by_name, resolved, typed, diags) }
        is AST.StructDecl as sd    -> {
            declare_named_with_args(
                sd.name,
                sd.name_span,
                sd.type_params,
                by_name,
                typed,
                resolved.path,
                factory,
                // A declared type is the mutable form ; immutability is a property
                // of a SLOT (a parameter without `!`), never of the declaration.
                (sym: Symbol, args: Type[]) -> mk_struct(sym, args, false),
            )
            // Index the struct decl by symbol id so `field.vader` can
            // walk fields without re-traversing the program AST.
            sym :: by_name[sd.name]
            if sym is Symbol {
                typed.struct_decls[sym.id] = sd
                // Pre-resolve every field's type using THIS module's
                // resolved.idents. Cross-module field lookups (entry
                // struct lives in `std/collections` but `entry.value`
                // is read from main) consult these directly via the
                // owner module's bindings.
                fields_map :: MutableMap<string, Type> {}
                // A private field (`@internal`) is invisible across the module
                // boundary, so it never leaks — only public fields of an
                // exported struct expose their type through the interface.
                struct_public :: sd.visibility == Visibility.Public
                for f in sd.fields {
                    // A field is read-only unless its type says otherwise — same
                    // default as a parameter, and for the same reason : a field is
                    // a slot others reach through. `!` reopens the level that needs
                    // it (`stmts: LoweredStmt![]` = rewrite the elements in place,
                    // `buf: u8[]!` = append to the array itself).
                    fty :: apply_readonly_default(type_from_expr(f.ty, resolved, diags), f.ty)
                    fields_map[f.name] = fty
                    if struct_public && f.visibility == Visibility.Public {
                        report_private_leak(fty, f.ty.span, sd.name, "exposes a field of type", diags)
                    }
                }
                typed.struct_field_types[sym.id] = fields_map
            }
        }
        is AST.EnumDecl as ed      -> { declare_enum(ed, by_name, resolved, typed, diags) }
        is AST.TraitDecl as td     -> {
            declare_named_with_args(
                td.name,
                td.name_span,
                td.type_params,
                by_name,
                typed,
                resolved.path,
                factory,
                mk_trait,
            )
            sym :: by_name[td.name]
            if sym is Symbol {
                typed.trait_decls[sym.id] = td
                typed.trait_decl_owners[sym.id] = resolved
            }
        }
        is AST.TypeAliasDecl as ta -> { declare_type_alias(ta, resolved, typed, diags) }
        is AST.ConstDecl as cd     -> { declare_const(cd, resolved, typed, diags) }
        is AST.ImplDecl            -> {}
        is AST.AssertDecl          -> {}
        is AST.ImportDecl          -> {}
    }
}
// ImplDecl → ImplRegistry (impls.vader). AssertDecl → comptime only.
// ImportDecl was wired by the resolver. No-op here for all three.

/// Shared minter for Struct / Trait decls — they only differ in the
/// `Type` constructor (`mk_struct` vs `mk_trait`). Mints one fresh
/// TypeParam Symbol per declared `[T]` so the resulting Type renders
/// as `Foo<T>` rather than `Foo(?)`. The resolver mints type-params in
/// the body-walker scope ; we re-mint here because they're not exposed
/// at the top-level symbol table.
declare_named_with_args :: fn(
    name: string,
    name_span: Span,
    type_params: AST.TypeParam[],
    by_name: MutableMap<string, Symbol>,
    typed: TypedProgram!,
    module_path: string,
    factory: SymbolFactory!,
    mk: fn(Symbol, Type[]) -> Type,
) -> void {
    sym :: by_name[name] ?? return
    args: Type[]! = []
    for tp in type_params {
        tp_sym :: factory.make(.TypeParam, tp.name, module_path, module_path, .Private, tp.span)
        args.push(mk_type_param(tp_sym))
    }
    typed.decl_types[sym.id] = mk(sym, args)
}

// ---- per-decl declarers ---------------------------------------------------

declare_fn :: fn(
    decl: AST.FnDecl,
    by_name: MutableMap<string, Symbol>,
    resolved: ResolvedModule,
    typed: TypedProgram!,
    diags: Diagnostic[]!,
) -> void {
    params: Type[]! = []
    for p in decl.params {
        params.push(declare_fn_param(p, resolved, typed, diags))
    }
    return_type :: declare_fn_return(decl, resolved, diags)
    // For overloaded fns, `by_name[fn_name]` returns only ONE symbol.
    // Match by span so each overload gets its own decl_types entry.
    sym :: lookup_fn_symbol_by_span(decl, resolved, by_name)
    if sym is Symbol {
        typed.decl_types[sym.id] = FnType {
            .params         = params,
            .params_mutable = params_mutable_of(decl.params),
            .return_type    = return_type,
        }
        typed.fn_decls[sym.id] = decl
    }
    if decl.name == "main" {
        check_main_signature(decl, params, return_type, diags)
    }
    if has_extern_decorator(decl.decorators) {
        validate_extern(decl, params, return_type, typed, diags)
    } else {
        // `validate_extern` checks them for an `@extern`; every other fn has to
        // be checked here, or `@c_pointer` would pass unnoticed on a Vader body
        // where it means nothing.
        validate_param_decorators(decl, false, diags)
    }
    // A bodyless top-level free fn becomes a host import (`lower_decl.vader`
    // returns a null body → `call.import`). Host-ness must be *declared* :
    // `@intrinsic` for a stdlib host binding, `@extern` for a foreign C symbol.
    // Without either, the import is unbound and traps at runtime — so require
    // the annotation here. Impl members (`impl_is_intrinsic`) and trait-method
    // signatures go through other declarers and never reach `declare_fn`.
    //
    // A `@target` declaration is exempt: bodyless here means the group had no
    // body for the target being built, which the resolver already reported as
    // R2041 — naming the target and what the group DOES cover. Emitting this too
    // would answer the same question a second time with the opposite advice
    // ("make it `@intrinsic`"), which is the wrong fix for a coverage hole.
    if decl.body == null && !has_intrinsic_decorator(decl.decorators) && !has_extern_decorator(
        decl.decorators,
    ) && !has_target_decorator(decl.decorators) {
        diags.push(
            typecheck_error(
                .BodylessFnMustBeIntrinsic,
                decl.name_span,
                "`${decl.name}` is bodyless and otherwise unbound at runtime ; for a function-*type*, spell the `fn(...)` type inline at its use sites rather than as a named bodyless declaration",
            ),
        )
    }
    check_public_fn_visibility(decl, params, return_type, diags)
}

has_target_decorator :: fn(decorators: AST.Decorator[]) -> bool {
    for d in decorators {
        if d.name == "target" {
            return true
        }
    }
    return false
}

// ---- T3052 : private type in a public interface ---------------------------

// Fire T3052 when a private user type leaks through the public interface of
// `owner_name`. `role` completes the sentence : "returns", "takes a parameter
// of type", "exposes a field of type". Mirrors Rust's E0446
// (`private_interfaces`) — a caller in another module can neither name such a
// type nor construct a value of it, so the export is unusable across the
// boundary. No-op when the interface names only exported types.
report_private_leak :: fn(
    ty: Type,
    span: Span,
    owner_name: string,
    role: string,
    diags: Diagnostic[]!,
) -> void {
    leak :: first_unexported_type(ty) ?? return
    diags.push(
        typecheck_error(
            .PrivateTypeInPublicInterface,
            span,
            "exported `${owner_name}` ${role} `${leak.name}`, which is not exported from its module ; export `${leak.name}` or make `${owner_name}` private",
        ),
    )
}

// Check both halves of an exported fn's signature — its return type and every
// parameter type. Params cover `@extern` / `@intrinsic` host bindings too : a
// public foreign ABI over a private type is the same leak. `params[i]`
// corresponds to `decl.params[i]` (built in the same order by `declare_fn`).
check_public_fn_visibility :: fn(
    decl: AST.FnDecl,
    params: Type[],
    return_type: Type,
    diags: Diagnostic[]!,
) -> void {
    if decl.visibility != Visibility.Public {
        return
    }
    ret_span :: if decl.return_type != null { decl.return_type.span } else { decl.span }
    report_private_leak(return_type, ret_span, decl.name, "returns", diags)
    for i in 0..<decl.params.len() {
        p :: decl.params[i]
        span :: if p.ty != null { p.ty.span } else { p.span }
        report_private_leak(params[i], span, decl.name, "takes a parameter of type", diags)
    }
}

// First non-exported user type referenced anywhere in `t`, or null when the
// whole type is nameable across the module boundary. Exhaustive over the
// closed `Type` union (no `_` fall-through) so adding a new symbol-carrying
// variant trips T3013 here and forces a conscious decision ; every type that
// carries no nameable symbol (primitives, type-params, `Self`, the
// erasure/inference synthetics) is a leaf that contributes nothing → null.
first_unexported_type :: fn(t: Type) -> Symbol | null {
    match t {
        is StructType as s   -> {
            if is_private_user_type(s.symbol) {
                return s.symbol
            }
            return first_unexported_in(s.args)
        }
        is EnumType as e     -> {
            // EnumType carries no generic args today ; if parametric enums land,
            // recurse into them here like StructType / TraitType.
            if is_private_user_type(e.symbol) {
                return e.symbol
            }
            return null
        }
        is DistinctType as d -> {
            // A private distinct leaking through an exported signature is an
            // error just like a private struct ; the backing is a primitive
            // (always public) but recurse for generality.
            if is_private_user_type(d.symbol) {
                return d.symbol
            }
            return first_unexported_type(d.backing)
        }
        is TraitType as tr   -> {
            if is_private_user_type(tr.symbol) {
                return tr.symbol
            }
            return first_unexported_in(tr.args)
        }
        is UnionType as u    -> {
            return first_unexported_in(u.variants)
        }
        is ArrayType as a    -> {
            return first_unexported_type(a.element)
        }
        is TupleType as p    -> {
            return first_unexported_in(p.elements)
        }
        is FnType as f       -> {
            in_params :: first_unexported_in(f.params)
            if in_params != null {
                return in_params
            }
            return first_unexported_type(f.return_type)
        }
        is PrimitiveType     -> { return null }
        is TypeParamType     -> { return null }
        is TypeMetaType      -> { return null }
        is SelfType          -> { return null }
        is UnresolvedType    -> { return null }
        is FreeIntType       -> { return null }
        is FreeCharType      -> { return null }
        is FreeFloatType     -> { return null }
        is NeverType         -> { return null }
        is AnyType           -> { return null }
    }
}

first_unexported_in :: fn(types: Type[]) -> Symbol | null {
    for t in types {
        r :: first_unexported_type(t)
        if r != null {
            return r
        }
    }
    return null
}

is_private_user_type :: fn(sym: Symbol) -> bool {
    if sym.visibility != .Private {
        return false
    }
    return is_user_type_kind(sym.kind)
}

is_user_type_kind :: fn(k: SymbolKind) -> bool {
    if k == .Struct    { return true }
    if k == .Enum      { return true }
    if k == .Trait     { return true }
    if k == .TypeAlias { return true }
    return false
}

// ---- @extern ABI validation -----------------------------------------------

/// Whether `t` is a struct declaring the C type it mirrors (`@c_struct`).
///
/// @param t      the candidate parameter type.
/// @param typed  the module, for `struct_decls`.
/// @return       whether the struct carries a C spelling.
mirrors_a_c_struct :: fn(t: Type, typed: TypedProgram) -> bool = c_struct_spelling_of(t, typed) != ""

/// The C type spelling a struct mirrors, or `""`.
///
/// @param t      the candidate type.
/// @param typed  the module, for `struct_decls`.
/// @return       e.g. `"struct timespec"`, or `""` for anything else.
c_struct_spelling_of :: fn(t: Type, typed: TypedProgram) -> string {
    if t !is StructType {
        return ""
    }
    sd :: typed.struct_decls[t.symbol.id] ?? return ""
    for d in sd.decorators {
        if d.name == "c_struct" && d.args.len() == 1 {
            a :: d.args[0]
            if a is AST.StringLitExpr && a.parts.len() == 1 {
                pt :: a.parts[0]
                if pt is AST.StringLitText {
                    return pt.value
                }
            }
        }
    }
    return ""
}

/// Whether the declaration names the header that owns its prototype.
///
/// @param d  the `@extern` declaration.
declares_c_header :: fn(d: AST.FnDecl) -> bool {
    for dec in d.decorators {
        if dec.name == "c_header" {
            return true
        }
    }
    return false
}

/// Whether the parameter carries `@c_pointer`.
///
/// @param pm  the parameter.
/// @return    whether it crosses as an address.
param_has_c_pointer :: fn(pm: AST.FnParam) -> bool {
    for d in pm.decorators {
        if d.name == "c_pointer" {
            return true
        }
    }
    return false
}

/// Check the decorators written on each of `decl`'s parameters.
///
/// `@c_pointer` is the only one a parameter may carry, and only on an `@extern`
/// declaration: it says the foreign callee receives the parameter's ADDRESS
/// rather than its value, which has no meaning for a Vader-bodied fn.
///
/// Direction is NOT part of the decorator — the `!` already carries it. Without
/// one, C reads through the pointer and the caller supplies the value; with one,
/// C writes through it.
///
/// @param decl       the fn whose parameters to check.
/// @param is_extern  whether the declaration carries `@extern`.
/// @param diags      accumulator for T3079.
validate_param_decorators :: fn(decl: AST.FnDecl, is_extern: bool, diags: Diagnostic[]!) -> void {
    for pm in decl.params {
        for d in pm.decorators {
            if d.name != "c_pointer" {
                diags.push(typecheck_error(
                    .InvalidParameterDecorator, pm.span,
                    "`@${d.name}` cannot decorate a parameter — only `@c_pointer` can"))
            } else if !is_extern {
                diags.push(typecheck_error(
                    .InvalidParameterDecorator, pm.span,
                    "`@c_pointer` only means something on an `@extern` declaration"))
            } else if d.args.len() != 0 {
                diags.push(typecheck_error(
                    .InvalidParameterDecorator, pm.span,
                    "`@c_pointer` takes no argument — the `!` on the type says whether C writes"))
            }
        }
    }
}

/// Check the field types of a `@c_struct` mirror that is about to cross to C.
///
/// The shim copies a mirror one field at a time into a real C struct, so every
/// field needs a C representation of its own: an unmarshalled scalar, an enum
/// (which crosses as its repr), or another mirror. Nothing else has one, and
/// nothing downstream notices — a `string` field hands C the atom ID and an
/// array field the Vader array header, both through a cast `cc` accepts. The
/// value is wrong at run time and no build ever says so, which is why this is
/// a typecheck gate rather than something left to the C compiler.
///
/// The diagnostic points at the PARAMETER, not the field: the mirror may be
/// declared in another module, and a span from there would be attributed to
/// this file. The detail names the field instead.
///
/// @param t      the mirror type reached from the parameter; a non-struct is a
///               no-op, so callers need not narrow first.
/// @param span   the parameter — where the struct crosses.
/// @param typed  the module, for `struct_decls` and `struct_field_types`.
/// @param seen   struct symbol ids already walked, so a cycle terminates.
/// @param diags  accumulator for T3050.
validate_mirror_fields :: fn(
    t: Type,
    span: Span,
    typed: TypedProgram,
    seen: MutableSet<i32>!,
    diags: Diagnostic[]!,
) -> void {
    if t !is StructType {
        return
    }
    if t.symbol.id in seen {
        return
    }
    seen.add(t.symbol.id)
    sd :: typed.struct_decls[t.symbol.id] ?? return
    fmap :: typed.struct_field_types[t.symbol.id] ?? return
    for f in sd.fields {
        fty :: fmap[f.name] ?? continue
        if fty is StructType {
            if mirrors_a_c_struct(fty, typed) {
                validate_mirror_fields(fty, span, typed, seen, diags)
            } else {
                diags.push(typecheck_error(
                    .InvalidExternDecl, span,
                    "field `${f.name}` of `@c_struct` `${sd.name}` is a plain struct — a struct member needs its own `@c_struct` naming the C type it mirrors",
                ))
            }
            continue
        }
        // An enum crosses as its repr, which the shim assigns like any integer.
        if fty is EnumType {
            continue
        }
        if !is_unmarshalled_scalar(fty, false) {
            diags.push(typecheck_error(
                .InvalidExternDecl, span,
                "field `${f.name}` of `@c_struct` `${sd.name}` has no C representation: `${display_type(fty)}` — a mirrored field must be a numeric scalar, `bool`, `char`, `CPointer`, an enum, or another `@c_struct`",
            ))
        }
    }
}

validate_extern :: fn(
    decl: AST.FnDecl,
    params: Type[],
    return_type: Type,
    typed: TypedProgram!,
    diags: Diagnostic[]!,
) -> void {
    if decl.body !is null {
        diags.push(
            typecheck_error(
                .ExternMustNotHaveBody,
                decl.body.span,
                "`@extern` fn `${decl.name}` cannot have a body — drop the `= ...` / `{ ... }`",
            ),
        )
    }
    validate_param_decorators(decl, true, diags)
    args :: extern_decorator_args(decl.decorators)
    if args.len() > 2 {
        diags.push(
            typecheck_error(
                .InvalidExternDecl,
                decl.span,
                "`@extern` accepts 0, 1, or 2 string arguments — got ${args.len()}",
            ),
        )
        return
    }
    for a in args {
        if !is_plain_string_literal(a) {
            diags.push(
                typecheck_error(
                    .InvalidExternDecl,
                    a.span,
                    "`@extern` arguments must be plain string literals (no interpolation)",
                ),
            )
        }
    }
    for i in 0..<decl.params.len() {
        pt :: params[i]
        // A struct crosses ONLY as `@c_pointer` on a type that declares which C
        // type it mirrors. The shim then declares a real one and marshals field
        // by field, so the C compiler computes the offsets from the real header
        // — an undeclared struct has no C spelling to declare and would have to
        // guess a layout instead.
        if mirrors_a_c_struct(pt, typed) {
            if param_has_c_pointer(decl.params[i]) {
                validate_mirror_fields(pt, decl.params[i].span, typed, MutableSet<i32> {}, diags)
                continue
            }
            diags.push(
                typecheck_error(
                    .InvalidExternDecl,
                    decl.params[i].span,
                    "`@c_struct` type `${display_type(pt)}` crosses as an address — mark the parameter `@c_pointer`",
                ),
            )
            continue
        }
        // `@c_pointer` spills the argument to a stack temporary and hands over
        // its address. That only means something for a value C can receive a
        // pointer TO: a scalar, or a mirror (handled above). On anything else
        // the shim takes the address of the Vader representation — a `string`
        // parameter would pass a `const char**` aimed at an atom ID, an array
        // one a pointer to the array header — and the `(void*)` cast the shim
        // emits hides the mismatch from `cc`.
        if param_has_c_pointer(decl.params[i]) && !is_unmarshalled_scalar(pt, false) {
            diags.push(
                typecheck_error(
                    .InvalidParameterDecorator,
                    decl.params[i].span,
                    "`@c_pointer` needs a scalar or a `@c_struct` to take the address of, got `${display_type(pt)}` — a `string` and an array already cross as pointers, so drop the decorator",
                ),
            )
            continue
        }
        if !is_extern_abi_type(pt, false) {
            diags.push(
                typecheck_error(
                    .InvalidExternDecl,
                    decl.params[i].span,
                    "`@extern` parameter type must be a primitive, `string`, or a primitive-element array, got `${display_type(pt)}`",
                ),
            )
        }
    }
    if !is_extern_abi_type(return_type, true) {
        ret_span: Span = decl.span
        if decl.return_type !is null {
            ret_span = decl.return_type.span
        }
        diags.push(
            typecheck_error(
                .InvalidExternDecl,
                ret_span,
                "`@extern` return type must be a primitive, `string`, `CPointer | null`, or `void`, got `${display_type(return_type)}`",
            ),
        )
    }
    // Keyed on the SYMBOL alone, because that is what the C side can tell apart:
    // `emit_import_shims` dedupes on `extern_name` and emits ONE prototype per
    // symbol, and the declared library reaches no `-l` — it is read by the VM's
    // `ffi_open` and nowhere else. Keying on library + symbol would let two
    // declarations through that the native backend then collapses into one
    // prototype, the second shim calling the first's.
    //
    // The cost is that a stdlib `@extern` reserves its C name project-wide:
    // since `std/math` names `pow`, a program importing it cannot declare its
    // own — unless both name a header, see below.
    sym_name :: extern_symbol_name_for(decl)
    prior :: typed.extern_symbols[sym_name]
    if prior is AST.FnDecl {
        // Unless BOTH name a header. The clash above is about the SYNTHESISED
        // prototype, and `@c_header` emits none — each shim calls the symbol
        // with its own types, which `cc` checks against the real declaration. It
        // is what lets `stat` be declared once per system, the way every FFI
        // does: the mirror it fills differs, so the signature does too.
        if prior.id != decl.id && !(declares_c_header(decl) && declares_c_header(prior)) {
            diags.push(
                typecheck_error(
                    .InvalidExternDecl,
                    decl.span,
                    "duplicate `@extern` C symbol `${sym_name}` — already declared on `${prior.name}`",
                ),
            )
        }
    } else {
        typed.extern_symbols[sym_name] = decl
    }
}

has_extern_decorator :: fn(decs: AST.Decorator[]) -> bool {
    for d in decs {
        if d.name == "extern" {
            return true
        }
    }
    return false
}

has_intrinsic_decorator :: fn(decs: AST.Decorator[]) -> bool {
    for d in decs {
        if d.name == "intrinsic" {
            return true
        }
    }
    return false
}

extern_decorator_args :: fn(decs: AST.Decorator[]) -> AST.Expr[] {
    for d in decs {
        if d.name == "extern" {
            return d.args
        }
    }
    return []
}

is_plain_string_literal :: fn(e: AST.Expr) -> bool {
    if e !is AST.StringLitExpr {
        return false
    }
    if e.parts.len() != 1 {
        return false
    }
    return e.parts[0] is AST.StringLitText
}

/// `@extern("c_name")` override reader — falls back to the source fn
/// name. Last string arg is the C symbol (2-arg form reserves the
/// first slot for a future WASM module hint).
///
/// `vader/midir/build.vader::extern_symbol_name` is the post-lowering twin
/// (it runs on the `LoweredFnDecl` shape) and follows the same last-arg
/// convention, so the linked C symbol stays consistent across stages.
extern_symbol_name_for :: fn(decl: AST.FnDecl) -> string {
    for d in decl.decorators {
        if d.name != "extern" {
            continue
        }
        if d.args.len() == 0 {
            continue
        }
        last :: d.args[d.args.len() - 1]
        if last is AST.StringLitExpr {
            if last.parts.len() == 1 {
                if last.parts[0] is AST.StringLitText as t {
                    return t.value
                }
            }
        }
    }
    return decl.name
}

/// C-ABI type whitelist. Primitives and `string`; a distinct type over one; two
/// union shapes (a nullable foreign pointer anywhere, `string | null` as a
/// result); a primitive-element array as an argument; and a FUNCTION TYPE as an
/// argument — a callback. `void` is allowed in return position only, `null`
/// nowhere. Each arm below states its own reason.
is_extern_abi_type :: fn(t: Type, is_return: bool) -> bool {
    // @partial: primitives (`string` included, itself a PrimitiveType) and
    // primitive-element arrays cross the C ABI; every other aggregate / ref /
    // synthetic variant is rejected.
    @partial match t {
        is UnresolvedType     -> { return true }
        is PrimitiveType as p -> {
            if p.name == "void" { return is_return }
            if p.name == "null" { return false }
            return true
        }
        is DistinctType as d  -> {
            // A newtype is zero-cost and stripped at lowering, so its ABI is
            // its backing's. `Handle :: CPointer` is the recommended idiom for
            // a foreign handle — it must cross.
            return is_extern_abi_type(d.backing, is_return)
        }
        is UnionType          -> {
            // Two union shapes cross. A nullable foreign pointer, because C has
            // no other nullable scalar. And `string | null` as a RESULT: a C
            // function returning a `char*` says "absent" with NULL, and folding
            // that onto `""` would lose the distinction `getenv` rests on.
            return is_nullable_pointer(t) || (is_return && is_nullable_string(t))
        }
        is ArrayType as a     -> {
            // A borrowed array crosses as ONE bare pointer; a length, when the
            // callee wants one, is a parameter of its own. That shape only
            // exists on the way IN — C cannot fabricate a `vader_array_t`, so
            // an array return stays rejected.
            if is_return {
                return false
            }
            return is_extern_abi_element(a.element)
        }
        is FnType as f        -> {
            // A CALLBACK, in parameter position only. What crosses is the
            // function's ADDRESS (`bytecode/op::FnAddr`), so every part of its
            // signature has to cross too — C will call it with those very types.
            //
            // A return is rejected: a C function handing back code Vader would
            // call has no representation here.
            if is_return {
                return false
            }
            // A callback's own signature is NARROWER than an extern's. An
            // `@extern` parameter gets a shim that marshals — `string` becomes a
            // `const char*`, an array becomes its data pointer — but C calls a
            // callback DIRECTLY, with no shim anywhere. So only the types that
            // need no marshalling may appear in one; a `string` parameter would
            // hand the Vader body a `const char*` where it expects an atom id.
            if !is_unmarshalled_scalar(f.return_type, true) {
                return false
            }
            for pt in f.params {
                if !is_unmarshalled_scalar(pt, false) {
                    return false
                }
            }
            return true
        }
        _                     -> { return false }
    }
}

/// Whether `t` crosses the C boundary with no marshalling at all.
///
/// The subset a CALLBACK signature may use: C calls it directly, so every type
/// in it has to have the same representation on both sides. `string` and arrays
/// are excluded — an `@extern` parameter gets them through a shim that converts,
/// and a callback has no shim.
///
/// @param t          the candidate type.
/// @param is_return  whether it sits in return position (`void` is allowed there).
is_unmarshalled_scalar :: fn(t: Type, is_return: bool) -> bool {
    if t is DistinctType {
        return is_unmarshalled_scalar(t.backing, is_return)
    }
    if t is UnresolvedType {
        return true
    }
    if t !is PrimitiveType {
        return false
    }
    if t.name == "void"   { return is_return }
    if t.name == "string" { return false }
    if t.name == "null"   { return false }
    return true
}

/// True when `t` is `string | null` — the shape a C function returning a
/// `char*` needs to say "absent" rather than "empty".
///
/// @param t  the candidate type.
/// @return   whether it is exactly `string | null`.
is_nullable_string :: fn(t: Type) -> bool {
    if t !is UnionType {
        return false
    }
    if t.variants.len() != 2 {
        return false
    }
    has_null := false
    has_str := false
    for v in t.variants {
        bare :: strip_distinct(v)
        if bare is PrimitiveType {
            if bare.name == "null"   { has_null = true }
            if bare.name == "string" { has_str = true }
        }
    }
    return has_null && has_str
}

/// True when `t` is exactly `CPointer | null` — the ABI shape of a nullable
/// foreign pointer, and the only union that crosses the C boundary.
///
/// The union keeps its ordinary in-Vader representation (a boxed `Any`); the
/// shim converts it at the boundary, exactly as it already converts a
/// `vader_string_t` atom id to a `const char*`. Nothing about how Vader
/// represents unions changes.
///
/// @param t  the candidate slot type.
/// @return   whether it is the nullable-pointer shape.
is_nullable_pointer :: fn(t: Type) -> bool {
    if t is UnionType {
        if t.variants.len() != 2 {
            return false
        }
        has_null := false
        has_ptr := false
        for v in t.variants {
            // `Handle | null` with `Handle :: CPointer` is the same ABI shape as
            // `CPointer | null` — see through the newtype.
            bare :: strip_distinct(v)
            if bare is PrimitiveType {
                if bare.name == "null" {
                    has_null = true
                }
                if bare.name == "CPointer" {
                    has_ptr = true
                }
            }
        }
        return has_null && has_ptr
    }
    return false
}

/// True when `t` may be the element of an `@extern` array parameter — a
/// numeric / `bool` / `char` primitive, i.e. one whose array storage is dense
/// and whose slots the GC never scans.
///
/// `string` is excluded: its dense storage is a table of atom ids, which is
/// meaningless to a C callee. `void` / `null` have no storage at all.
///
/// @param t  the array's element type.
/// @return   whether a `T[]` of it can be lent across the C ABI.
is_extern_abi_element :: fn(t: Type) -> bool {
    @partial match t {
        is UnresolvedType     -> { return true }
        is PrimitiveType as p -> {
            return p.name != "void" && p.name != "null" && p.name != "string"
        }
        _                     -> { return false }
    }
}

lookup_fn_symbol_by_span :: fn(
    decl: AST.FnDecl,
    resolved: ResolvedModule,
    by_name: MutableMap<string, Symbol>,
) -> Symbol | null {
    bucket :: resolved.fn_overloads[decl.name]
    if bucket !is null {
        for s in bucket {
            sp :: s.defined_at ?? continue
            // Match the file too : two overloads at the same (line, column)
            // in DIFFERENT sibling files of a module would otherwise collide,
            // and the second's decl_types entry would never be written (the
            // file-blind hazard `Span.hash()` already folds the file hash for).
            if sp.start.line == decl.name_span.start.line && sp.start.column == decl.name_span.start.column && sp.start.file == decl.name_span.start.file {
                return s
            }
        }
    }
    return by_name[decl.name]
}

// `main` must return i32 and either take no params or a single
// `[string]` arg — emitters wire the entry point assuming both.
check_main_signature :: fn(
    decl: AST.FnDecl,
    params: Type[],
    return_type: Type,
    diags: Diagnostic[]!,
) -> void {
    if !is_primitive_named(return_type, "i32") {
        diags.push(typecheck_error(.InvalidMainSignature, decl.span, "main must return i32"))
        return
    }
    if params.len() == 0 {
        return
    }
    if params.len() == 1 {
        if params[0] is ArrayType as a {
            if is_primitive_named(a.element, "string") {
                return
            }
        }
    }
    diags.push(
        typecheck_error(
            .InvalidMainSignature,
            decl.span,
            "main takes either no parameters or a single `[string]` argument",
        ),
    )
}

is_primitive_named :: fn(t: Type, name: string) -> bool {
    if t is PrimitiveType {
        return t.name == name
    }
    return false
}

declare_fn_param :: fn(
    p: AST.FnParam,
    resolved: ResolvedModule,
    typed: TypedProgram!,
    diags: Diagnostic[]!,
) -> Type {
    ty :: p.ty
    if ty == null {
        // SPEC §4 : top-level fn signatures must be fully annotated, except
        // `self` which carries the implicit `Self` type, bound at body time.
        if p.name == "self" {
            return TY_UNRESOLVED
        }
        diags.push(
            typecheck_error(.FnSignatureMustBeAnnotated, p.span, "parameter ${p.name} lacks a type"),
        )
        return TY_UNRESOLVED
    }
    resolved_ty :: apply_readonly_default(type_from_expr(ty, resolved, diags), ty)
    typed.param_types[p.span.hash()] = resolved_ty
    return resolved_ty
}

declare_fn_return :: fn(
    decl: AST.FnDecl,
    resolved: ResolvedModule,
    diags: Diagnostic[]!,
) -> Type {
    rt :: decl.return_type
    if rt == null {
        // Expression-bodied without annotation : inference defers to body
        // checking. Block-bodied without annotation : default to void.
        if decl.is_expression_bodied {
            return TY_UNRESOLVED
        }
        return TY_VOID
    }
    // A return hands the caller a slot too, so it takes the same default : the value
    // handed back is read-only unless the type says `!`. That is what makes `const`
    // unnecessary in return position — it WAS the default all along.
    // A return hands the caller a slot too, so it takes the same default : the value
    // handed back is read-only unless the type says `!`. That is what makes `const`
    // unnecessary in return position — it WAS the default all along.
    return apply_readonly_default(type_from_expr(rt, resolved, diags), rt)
}

declare_enum :: fn(
    decl: AST.EnumDecl,
    by_name: MutableMap<string, Symbol>,
    resolved: ResolvedModule!,
    typed: TypedProgram!,
    diags: Diagnostic[]!,
) -> void {
    sym :: by_name[decl.name]
    repr :: resolve_repr(decl.repr, resolved, diags)
    indices :: resolve_enum_indices(decl, repr, diags)
    if sym is Symbol {
        enum_type :: mk_enum(sym, repr, indices)
        typed.decl_types[sym.id] = enum_type
        resolved.alias_types[sym.id] = enum_type
    }
}

declare_type_alias :: fn(
    decl: AST.TypeAliasDecl,
    resolved: ResolvedModule!,
    typed: TypedProgram!,
    diags: Diagnostic[]!,
) -> void {
    aliased :: type_from_expr(decl.aliased, resolved, diags)
    // Index by alias symbol id ; `decl_types` and `alias_types` share
    // the key so use sites get the expanded union.
    for s in resolved.symbols {
        if s.name == decl.name {
            typed.decl_types[s.id] = aliased
            resolved.alias_types[s.id] = aliased
            resolved.alias_decls[s.id] = decl
        }
    }
}

declare_const :: fn(
    decl: AST.ConstDecl,
    resolved: ResolvedModule!,
    typed: TypedProgram!,
    diags: Diagnostic[]!,
) -> void {
    sym :: lookup_sym_by_name(resolved, decl.name) ?? return
    typed.const_decls[sym.id] = decl
    annotation :: decl.ty
    match annotation {
        is null -> {
            if is_type_expr(decl.value, resolved) {
                alias_ty :: type_from_expr(decl.value, resolved, diags)
                resolved.alias_types[sym.id] = alias_for(sym, alias_ty, decl.decorators)
                typed.decl_types[sym.id] = TY_TYPE
            }
        }
        // A module const's ANNOTATION is a written slot, so it takes the read-only
        // default like any other — `X: u32[]: [...]` is frozen, `X: u32[]!: [...]`
        // asks for a shared mutable global. Skipping the default here is what
        // silently un-pooled
        // `DECIMAL_DIGITS`: `inline_consts` routes an array into `.rodata` only when
        // its type is read-only, so the const went back to being rebuilt op-by-op at
        // every read site (10 `string.const` + `array.new` instead of one
        // `data.const`). The UNANNOTATED path gets the same result through
        // `auto_const_module_array`.
        _       -> {
            ty :: apply_readonly_default(type_from_expr(annotation, resolved, diags), annotation)
            reject_mutable_module_const(ty, annotation, diags)
            typed.decl_types[sym.id] = ty
        }
    }
}

// A `!` on a module const asks for real storage: a writable global, initialised
// once, that grows like any other array (`emit_global_const_roots` roots it, so a
// reallocated buffer is forwarded, not collected). Any element type qualifies —
// the pool emits a flat buffer for primitives / enums and an aggregate for struct,
// tuple and nested-array elements, and both carry a storage class.
//
// What does NOT qualify is a marker BELOW the array level. The element objects of an
// aggregate entry are emitted as separate `static const`s, so `SPECS[0].code = 9`
// would write into `.rodata`. Keeping the element type read-only is what makes the
// writable slots safe — `SPECS[0] = other` reaches a slot, the deeper write is
// T3070 — so a marked element is rejected rather than silently unsound. Same for a
// non-array const: a bare struct or map isn't pooled at all, so there is no storage
// to make writable. T3076.
reject_mutable_module_const :: fn(
    ty: Type, annotation: AST.TypeExpr, diags: Diagnostic[]!,
) -> void {
    // Keyed on the WRITTEN marker, never on `type_is_immutable` : a primitive
    // carries no mutability bit, so `type_is_immutable(i32)` is false and every
    // ordinary `MAX: i32: 42` would look mutable. Scanned at EVERY level, because
    // `Spec![]` is as misleading as `Spec[]!` — writing through it is T3070 either
    // way (a module const's path root is frozen), so the marker promises nothing.
    if !marks_mutable_anywhere(annotation) {
        return
    }
    // The one storable shape : the marker on the ARRAY level and nowhere deeper.
    if annotation is AST.MutableTypeExpr {
        if annotation.inner is AST.ArrayTypeExpr {
            if !marks_mutable_anywhere(annotation.inner) {
                return
            }
            diags.push(typecheck_error(
                .ModuleConstMutableElement, annotation.span,
                "`${display_type(ty)}` — the marker belongs on the ARRAY level only : its "
                + "elements are emitted as read-only statics, and keeping the element type "
                + "read-only is what makes the writable slots safe"))
            return
        }
    }
    // A scalar marker is T3075's business (`i32!` grants nothing anywhere, not
    // just here) — don't double-report.
    if is_value_only_type(ty) {
        return
    }
    if ty is ArrayType {
        diags.push(typecheck_error(
            .ModuleConstMutableElement, annotation.span,
            "`${display_type(ty)}` — the marker belongs on the ARRAY level, which is the "
            + "level the data pool can make writable"))
        return
    }
    diags.push(typecheck_error(
        .ModuleConstMutableElement, annotation.span,
        "`${display_type(ty)}` — only an ARRAY of value elements can be a mutable "
        + "module const ; drop the `!` to get the read-only form"))
}

// Whether the written type carries a `!` at ANY level. `type_expr_marks_mutable`
// only answers for the level it is handed, and a module const has to be judged on
// the whole annotation.
marks_mutable_anywhere :: fn(w: AST.TypeExpr) -> bool {
    if w is AST.MutableTypeExpr { return true }
    if w is AST.ArrayTypeExpr { return marks_mutable_anywhere(w.element) }
    if w is AST.SeqLitExpr {
        for el in w.elements {
            if marks_mutable_anywhere(el) { return true }
        }
        return false
    }
    if w is AST.BinaryExpr {
        if w.op == BinaryOp.BitOr {
            return marks_mutable_anywhere(w.left) || marks_mutable_anywhere(w.right)
        }
    }
    return false
}



/// Resolve the type a `Name :: <type-expr>` declaration registers. A
/// **primitive** RHS (`Name :: i64`) becomes a zero-cost `DistinctType`
/// (nominal newtype) ; a composite RHS (union / struct / array / fn) stays a
/// transparent alias.
alias_for :: fn(sym: Symbol, alias_ty: Type, decorators: AST.Decorator[]) -> Type {
    if distinct_backing(alias_ty, decorators) {
        return mk_distinct(sym, alias_ty)
    }
    return alias_ty
}

/// True when a `Name :: <type>` const should become a `DistinctType` rather
/// than a transparent alias : iff the RHS is a real primitive (not void/null)
/// AND the decl is not `@comptime`. `@comptime Name :: <type>` is the existing
/// compile-time TYPE ALIAS (resolves through `constTypeAliases`, e.g. used by
/// `@size_of`) — it stays transparent, never a newtype. Shared by the three
/// `alias_types` writers — `declare_const` (here), `register_alias_const`, and
/// `check_const_value` (both in orchestrate.vader).
distinct_backing :: fn(alias_ty: Type, decorators: AST.Decorator[]) -> bool {
    for d in decorators {
        if d.name == "comptime" {
            return false
        }
    }
    if alias_ty is PrimitiveType {
        return alias_ty.name != "void" && alias_ty.name != "null"
    }
    // Composite-backed newtypes (`BigInt :: u32[]`, `Color :: Rgb`,
    // `Coord :: [i32, i32]`) are nominal too, so they can carry their own trait
    // impls (operator overloads) on the distinct's own key instead of colliding
    // with the array blankets (`"[]"`) or aliasing the backing struct/tuple.
    // Structural ops (index / field / `.N` / len / push / for-in / literal
    // coercion / destructure) forward to the backing via `array_backing` /
    // `struct_backing` / `tuple_backing`.
    if alias_ty is ArrayType | StructType | TupleType {
        return true
    }
    return false
}

lookup_sym_by_name :: fn(resolved: ResolvedModule, name: string) -> Symbol | null {
    for s in resolved.symbols {
        if s.name == name {
            return s
        }
    }
    return null
}

// ---- helpers --------------------------------------------------------------

resolve_repr :: fn(
    repr: AST.TypeExpr | null,
    resolved: ResolvedModule,
    diags: Diagnostic[]!,
) -> string {
    if repr is null {
        return "i32"
    }
    repr_ty :: type_from_expr(repr, resolved, diags)
    if repr_ty is PrimitiveType {
        if is_int_name(repr_ty.name) {
            return repr_ty.name
        }
        diags.push(typecheck_error(.EnumReprMustBePrimitiveInt, repr.span, "got ${repr_ty.name}"))
        return "i32"
    }
    diags.push(
        typecheck_error(.EnumReprMustBePrimitiveInt, repr.span, "got ${display_type(repr_ty)}"),
    )
    return "i32"
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// Resolve `src`, declare-types, then look up the type of the decl
// named `name` by rendering its `display_type`. Returns `<missing>` if
// the decl never landed in `decl_types`.
declared_type :: fn(src: string, name: string) -> string {
    parsed :: parse_source(src, "t.vader")
    factory :: SymbolFactory {}
    rm :: resolve_module(parsed.program, "t", factory)
    typed :: new_typed_program(rm)
    diags: Diagnostic[]! = []
    declare_module(parsed.program.decls, rm, typed, factory, diags)
    for s in rm.symbols {
        if s.name != name {
            continue
        }
        ty :: typed.decl_types[s.id] ?? return "<missing>"
        return display_type(ty)
    }
    return "<unknown name>"
}

@test
test_declare_fn_records_signature :: fn() -> void {
    assert_eq(
        declared_type("add :: fn(a: i32, b: i32) -> i32 { return a + b }", "add"),
        "fn(i32, i32) -> i32",
    )
}

@test
test_declare_fn_void_return_when_no_annotation :: fn() -> void {
    assert_eq(declared_type("greet :: fn(name: string) { }", "greet"), "fn(string) -> void")
}

@test
test_declare_struct_records_struct_type :: fn() -> void {
    src :: """
Point :: struct {
    x: i32
    y: i32
}
"""
    assert_eq(declared_type(src, "Point"), "Point!")
}

@test
test_declare_generic_struct_records_args :: fn() -> void {
    src :: """
Wrap :: struct<T> {
    value: T
}
"""
    assert_eq(declared_type(src, "Wrap"), "Wrap<T>!")
}

@test
test_declare_enum_records_enum_type :: fn() -> void {
    src :: """
Color :: enum {
    Red
    Green
    Blue
}
"""
    assert_eq(declared_type(src, "Color"), "Color")
}

@test
test_declare_type_alias_records_aliased :: fn() -> void {
    // Resolver binds the alias's `<T>` type-params before walking the
    // body, so `T` resolves to its TypeParam symbol. The
    // canonical-union sort puts `null` before `T` alphabetically.
    assert_eq(declared_type("Maybe<T> :: T | null", "Maybe"), "null | T")
}

@test
test_declare_const_with_annotation_records_type :: fn() -> void {
    assert_eq(declared_type("PI: f64 :: 3.14", "PI"), "f64")
}
