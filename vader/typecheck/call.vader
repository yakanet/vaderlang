// vader/typecheck/call — CallExpr inference (`f(args)`).
//
// Call checking :
//   1. Recursively check the callee — its type must be `Fn(params,
//      return)`. Anything else surfaces T3007 ("not callable").
//   2. Arg-count check : positional arity must match `params.len()`.
//      T3003 ("wrong number of arguments") on mismatch.
//   3. Per-arg check : each arg recurses through `check_expr` with the
//      corresponding param type as `expected` (drives literal
//      narrowing). Assignability check surfaces T3001.
//   4. The CallExpr's static type is the fn's `return_type`.
//
// Layered on top : overload dispatch (`pick_overload` over the
// `fn_overloads` buckets), named-arg + default-value normalisation
// (`normalize_call_args`), and generic-fn type-arg inference
// (`seed_explicit_type_args` + `unify_type_param`, substituting the
// resolved bindings into the return type).
//
// Not handled :
//   - Spread-arg handling (`f(...rest)`) ; a variadic param also bails
//     `normalize_call_args`.

module "vader/typecheck"

import "std/collections"
import "std/math"
import "vader/diagnostics"
AST :: import "toolchain/ast"
import "vader/types"
import "vader/resolver/symbol"
import "toolchain/span"

// Inspect the callee : when it's a bare ident whose `fn_overloads`
// bucket has 2+ entries, pre-walk arg[0] and pick the overload whose
// first param accepts it. Falls back to the initial type when no
// overload bucket exists or none match.
// True when the callee names a free fn with 2+ overloads — the only shape where
// an argument's enum prefix is load-bearing. Mirrors `pick_overload`'s own gate,
// which is where the candidates come from.
callee_has_overloads :: fn(c: AST.CallExpr, typed: TypedProgram) -> bool {
    if c.callee !is AST.IdentExpr {
        return false
    }
    name :: c.callee.name
    return collect_overload_candidates(name, c.callee.span.start.file, typed).len() >= 2
}

pick_overload :: fn(
    c: AST.CallExpr,
    initial: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> Type {
    callee :: c.callee
    if callee !is AST.IdentExpr {
        return initial
    }
    // A call through a LOCAL binding (param / local / pattern binding) invokes a
    // fn-VALUE that SHADOWS any same-named free-fn overloads. It must not be
    // overload-resolved — and crucially its callee type must NOT be patched
    // with a global overload's signature : `compare(a, b)` over a
    // `compare: fn(T, T) -> bool` PARAM would otherwise pick up an imported
    // free `compare` overload and overwrite `expr_types[callee]` with that
    // foreign fn-type (seen self-hosting : std/sort's comparator call picking
    // up vader_comptime's `compare`, breaking the later `call.indirect`). Only
    // a bare free-fn reference (Fn kind) carries overloads worth resolving.
    callee_sym :: typed.resolved.idents[callee.span.hash()]
    if callee_sym is Symbol {
        match callee_sym.kind {
            .Param   -> {
                return initial
            }
            .Local   -> {
                return initial
            }
            .Binding -> {
                return initial
            }
            _        -> {}
        }
    }
    name :: callee.name
    candidates :: collect_overload_candidates(name, callee.span.start.file, typed)
    if candidates.len() < 2 {
        return initial
    }
    if c.args.len() == 0 {
        return initial
    }
    arg0_ty :: check_expr_fn(c.args[0].value, null, typed, [])
    // The resolver bound `c.callee` to a primary overload ; its
    // signature is what a non-overloaded display would show.
    primary_ft :: primary_overload_ft(callee, typed)
    // Among candidates whose first param accepts arg0, pick the one with the
    // highest `overload_rank`. Eligibility is unchanged : only the
    // `is_assignable` gate below. Ties keep the first declared, unless
    // `is_level_rival` says the order is all that separates them.
    best: FnCandidate | null = null
    rival: FnCandidate | null = null
    best_rank: i32 = -1
    for candidate in candidates {
        ft :: candidate.ty
        if ft.params.len() == 0 {
            continue
        }
        // A type parameter argument fits through its bound (`it: I` with
        // `I: Iterator<i32>` against `Iterator<T>`).
        pattern :: erase_type_params(ft.params[0])
        fits_bound :: arg0_ty is TypeParamType && try_trait_widen(arg0_ty, pattern, typed)
        if !is_assignable(arg0_ty, pattern) && !fits_bound {
            continue
        }
        rank :: overload_rank(arg0_ty, ft.params[0], ft.params.len() == c.args.len())
        if rank > best_rank {
            best = candidate
            best_rank = rank
            rival = null
        } else if rank == best_rank && best != null && is_level_rival(best, candidate) {
            rival = candidate
        }
    }
    if best == null {
        return initial
    }
    if rival != null {
        diags.push(ambiguous_overload_error(callee.name, arg0_ty, best, rival, callee.span))
    }
    return commit_overload_pick(best, c, typed, primary_ft)
}

// A callee several impls of one trait offer (`v.add(…)` with `Add<f64>` beside
// `Add<Vec2>`, `w.into()` with `Into<Label>` beside `Into<Tag>`) : the member the
// call's first argument picks, or, for a member without one, the one whose result
// fits `expected`. The pick is recorded for the lowering.
pick_member_overload :: fn(
    c: AST.CallExpr,
    initial: Type,
    expected: Type | null,
    typed: TypedProgram,
    diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> Type {
    field :: c.callee
    if field !is AST.FieldExpr {
        return initial
    }
    candidates :: typed.overloaded_members[field.id] ?? return initial
    is_static :: typed.static_members[field.id] != null
    receiver :: typed.expr_types[field.target.id] ?? TY_UNRESOLVED
    sigs: Type[]: []
    for m in candidates {
        sigs.push(if is_static { m.ty } else { impl_member_type(m, receiver, typed) })
    }
    // An ambiguity is reported : nothing more to say about this call.
    index :: pick_member_index(
        c,
        field,
        sigs,
        expected,
        typed,
        diags,
        check_expr_fn,
    ) ?? return TY_UNRESOLVED
    chosen :: candidates[index]
    typed.picked_impl_members[field.id] = chosen
    typed.callees[field.id] = direct_callee(chosen.decl, false)
    ty :: if is_static {
        chosen.ty
    } else {
        settle_impl_member(chosen, field, receiver, typed, diags)
    }
    typed.expr_types[field.id] = ty
    return ty
}

// The index of the member `c` picks among `sigs` (each without its receiver) ; the
// first when none fits, so the call's own checks report the mismatch against it ;
// null once an ambiguity is reported.
pick_member_index :: fn(
    c: AST.CallExpr,
    field: AST.FieldExpr,
    sigs: Type[],
    expected: Type | null,
    typed: TypedProgram,
    diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> usize | null {
    if c.args.len() > 0 {
        arg0 :: check_expr_fn(c.args[0].value, null, typed, [])
        pick :: pick_by_first_arg(sigs, arg0, c.args.len())
        if pick.rival != null {
            diags.push(member_ambiguity_error(field, sigs, "accept ${display_type(arg0)}"))
            return null
        }
        return pick.best ?? 0
    }
    // The pick reads the result's shape ; its rights are judged against the slot
    // once picked (`Iterator<Mon!>!` from an owned array fits an `Iterator<Mon>!`
    // conversion as surely as the call that follows reports it).
    fits: usize[]: []
    if expected != null {
        want :: strip_mutability(expected)
        for i in 0..<sigs.len() {
            sig :: sigs[i]
            if sig is FnType && is_assignable(strip_mutability(sig.return_type), want) {
                fits.push(i)
            }
        }
    }
    if fits.len() == 1 {
        return fits[0]
    }
    if expected != null && fits.len() == 0 {
        return 0
    }
    hint :: if expected == null {
        "fit ; give the call's result a type"
    } else {
        "return a `${display_type(expected)}`"
    }
    diags.push(member_ambiguity_error(field, sigs, hint))
    return null
}

/// Which of several members a first argument picks (`overload_rank`).
ArgPick :: struct {
    /// The best-ranked member's index ; null when none takes the argument.
    best:  usize | null = null
    /// Another member that ranks the same : the use site is ambiguous.
    rival: usize | null = null
}

/// The member whose first parameter takes `arg` best, among `sigs` — each a member's
/// signature without its receiver, already specialised for the use site.
///
/// @param sigs   the members' signatures ; one that is no `FnType` is skipped.
/// @param arg    the type of the use site's first argument.
/// @param arity  the use site's argument count, which an exact arity ranks above.
pick_by_first_arg :: fn(sigs: Type[], arg: Type, arity: usize) -> ArgPick {
    pick := ArgPick {}
    best_rank: i32 = -1
    for i in 0..<sigs.len() {
        sig :: sigs[i]
        if sig !is FnType || sig.params.len() == 0 {
            continue
        }
        if !is_assignable(arg, erase_type_params(sig.params[0])) {
            continue
        }
        rank :: overload_rank(arg, sig.params[0], sig.params.len() == arity)
        if rank > best_rank {
            pick = ArgPick { .best = i }
            best_rank = rank
        } else if rank == best_rank {
            pick = ArgPick { .best = pick.best, .rival = i }
        }
    }
    return pick
}

// How well a candidate whose first param accepts `arg0` fits, highest wins:
// receiver specificity (a concrete union member beats a bare `T` wildcard — see
// `overload_specificity`), then an exact arity (`size(a = 1, b = 2)` against
// `size(a = 1)`), then, for a free literal, the param that is its default type —
// the rule a literal follows into a union (`union_literal_member`), so `abs(-5)`
// reaches the `i32` overload whatever the declaration order.
overload_rank :: fn(arg0: Type, param0: Type, exact_arity: bool) -> i32 {
    arity: i32: if exact_arity { 2 } else { 0 }
    is_default :: is_free_numeric(arg0) && equals_type(default_if_free(arg0), param0)
    literal_default: i32: if is_default { 1 } else { 0 }
    return overload_specificity(arg0, param0) * 4 + arity + literal_default
}

// Two candidates of one rank, declared in one module: neither shadows the other,
// so keeping the first declared would choose for the user without saying so. Two
// identical signatures are a redefinition, already T3053 at the declaration.
is_level_rival :: fn(best: FnCandidate, other: FnCandidate) -> bool =
    best.symbol.module == other.symbol.module && !equals_type(best.ty, other.ty)

ambiguous_overload_error :: fn(
    name: string,
    arg0: Type,
    first: FnCandidate,
    other: FnCandidate,
    span: Span,
) -> Diagnostic = typecheck_error(
    .AmbiguousOverload,
    span,
    "`${display_type(first.ty)}` and `${display_type(other.ty)}` both accept ${display_type(arg0)} for `${name}` — narrow it with `if`/`match` first",
)

/// Specificity of `param0` for a receiver `arg0` : the count of `arg0`'s (union)
/// variants that match a CONCRETE (non-type-param) variant of `param0`. A bare `T`
/// scores 0 ; each union member pinned to a concrete receiver variant scores 1, so
/// `T | Boom` ranks above `T | null` for an `i32 | Boom` receiver. The lowerer's
/// UFCS resolution ranks with it too, so both passes pick the same candidate.
///
/// @param arg0    the receiver's, or the first argument's, type.
/// @param param0  a candidate's declared first parameter.
/// @return        the score ; the highest wins.
export overload_specificity :: fn(arg0: Type, param0: Type) -> i32 {
    if param0 is TypeParamType {
        return 0
    }
    if param0 is UnionType {
        // `const` earns its keep here : the two branches join a read-only field and
        // a fresh literal, and an inferred `::` join is not a plain array — the
        // for-in below then falls to the iterator path and the lowerer panics on an
        // unresolved `next`. Pinning the slot read-only keeps it one array type.
        arg_vars: Type[]: if arg0 is UnionType as au { au.variants } else { [arg0] }
        score: i32 = 0
        for av in arg_vars {
            for pv in param0.variants {
                if pv is TypeParamType {
                    continue
                }
                if is_assignable(av, erase_type_params(pv)) {
                    score = score + 1
                    break
                }
            }
        }
        return score
    }
    if is_assignable(arg0, erase_type_params(param0)) {
        return 1
    }
    return 0
}

// Record a chosen overload : patch the callee IdentExpr's type so the dump
// shows the picked signature, keep the fn it runs, and mark
// non-primary picks so the lowerer emits the call's result type on the callee
// ident.
commit_overload_pick :: fn(
    picked: FnCandidate,
    c: AST.CallExpr,
    typed: TypedProgram,
    primary_ft: Type | null,
) -> FnType {
    ft :: picked.ty
    typed.expr_types[c.callee.id] = ft
    typed.chosen_fns[c.callee.id] = picked
    typed.callees[c.callee.id] = direct_callee(picked.decl, false)
    if is_nonprimary_pick(ft, primary_ft) {
        typed.overload_result_callees[c.callee.id] = true
    }
    return ft
}

// True when `picked` differs from the resolver-bound primary. An
// imported overload (`primary == null`) is always non-primary.
is_nonprimary_pick :: fn(picked: FnType, primary: Type | null) -> bool {
    if primary is null {
        return true
    }
    return !equals_type(picked, primary)
}

// Signature of the overload the resolver bound `callee` to. For a
// local overload that's the symbol the resolver picked (first declared
// by convention). For an imported overload the binding carries no
// fn-type, so fall back to the first entry of `imported_fn_overloads`
// — declaration order is preserved, so `[0]` is the primary the bare
// import name resolves to. Returns null only when nothing is found.
primary_overload_ft :: fn(callee: AST.Expr, typed: TypedProgram) -> Type | null {
    if callee !is AST.IdentExpr {
        return null
    }
    sym :: typed.resolved.idents[callee.span.hash()]
    if sym != null {
        ft :: typed.decl_types[sym.id]
        if ft is FnType {
            return ft
        }
    }
    imported :: imported_overloads_in(typed, callee.span.start.file, callee.name)
    if imported.len() > 0 {
        return imported[0].ty
    }
    return null
}

collect_overload_candidates :: fn(
    name: string, file: string, typed: TypedProgram,
) -> FnCandidate[] {
    out: FnCandidate[]: []
    bucket :: typed.resolved.fn_overloads[name]
    if bucket !is null {
        for sym in bucket {
            ft :: typed.decl_types[sym.id] ?? continue
            if ft is FnType {
                out.push(FnCandidate {
                    .ty = ft,
                    .symbol = sym,
                    .decl = typed.fn_decls[sym.id],
                })
            }
        }
    }
    // Scoped to the call site's file — imports are file-scoped (SPEC §"Modules").
    for imported in imported_overloads_in(typed, file, name) {
        out.push(imported)
    }
    return out
}

// Re-unify a UFCS-curried fn's original first param (the receiver
// type, stashed in `ufcs_receiver_types` at FieldExpr time) against
// the receiver itself so type-params from the dispatched fn (e.g.
// `fn<T>(x: T) -> T` called as `42.identity()`) get their bindings
// before arg unification.
seed_ufcs_bindings :: fn(
    callee: AST.Expr,
    typed: TypedProgram,
    bindings: MutableMap<i32, Type>,
    held: MutableSet<i32> | null,
) -> void {
    if callee !is AST.FieldExpr {
        return
    }
    receiver_ty :: typed.ufcs_receiver_types[callee.id] ?? return
    target_ty :: typed.expr_types[callee.target.id] ?? return
    unify_type_param(receiver_ty, target_ty, bindings, held)
    // A struct receiver impl'ing the trait the first param expects (a concrete
    // `FilterIterator<i32>` / a generator state struct curried into `self: Iterator<T>`)
    // binds `T` from the impl args — `unify_type_param` can't (different nominal
    // heads). Without this a lazy combinator/terminal's SOURCE `T` stays unbound, so
    // `filter`/`take`/`skip` (element = `T`) and `collect` (`-> T[]`) erase.
    unify_struct_to_trait_args(receiver_ty, target_ty, typed, bindings, held)
}

// Seed `bindings` from a `f<T1, T2>(…)` callee's explicit type args.
// Zips the resolved fn-decl's ordered type-params (recovered from
// `idents` by their decl-site span) with the resolved
// `<…>` argument types. No-op when the callee isn't an explicit generic
// instantiation. Lets a free-literal arg pin to the named concrete type.
// Returns the type params it seeded, whose rights no argument may lower.
seed_explicit_type_args :: fn(
    callee: AST.Expr,
    typed: TypedProgram,
    bindings: MutableMap<i32, Type>,
    diags: Diagnostic[],
) -> MutableSet<i32> | null {
    if callee !is AST.GenericInstExpr {
        return null
    }
    decl :: lookup_callee_fn_decl(callee, typed) ?? return null
    held :: MutableSet<i32> {}
    n :: min(decl.type_params.len(), callee.type_args.len())
    for i in 0..<n {
        tp_sym :: typed.resolved.idents[decl.type_params[i].span.hash()] ?? continue
        written :: callee.type_args[i]
        bindings[tp_sym.id] = apply_readonly_default(
            type_from_expr(written, typed.resolved, diags), written,
        )
        held.add(tp_sym.id)
    }
    return held
}

// ---- named-arg + default-value normalisation -----------------------------

// Reorder `c`'s args into positional parameter order, filling omitted params
// from their `default_value`. The result replaces `c.args` in place (see
// `infer_call`), so a reordered / defaulted call flows positionally through
// every downstream pass — the lowerer needs no special handling.
//
// Returns null (leaving `c.args` untouched) when there is nothing to reorder, or
// when the call can't be normalised : a variadic param (the slot model can't
// express `...rest`), or an error —
// T3003 too many / positional-after-named, T3004 unknown name, T3005 missing
// required, T3025 a named arg duplicating a filled slot.
normalize_call_args :: fn(params: AST.FnParam[], c: AST.CallExpr, diags: Diagnostic[]) -> AST.CallArg[]! | null {
    for pr in params {
        if pr.variadic {
            return null
        }
    }
    // Already in parameter order at full arity → nothing to reorder. A list this
    // function produced is in that shape, named arguments included : a call checked
    // again, as each round of the `!` deduction does, keeps its arguments.
    if c.args.len() == params.len() && in_parameter_order(params, c.args) {
        return null
    }
    slots: (AST.CallArg | null)[]: [null] * params.len()
    seen_named := false
    next_pos: usize = 0
    ok := true
    for a in c.args {
        arg_name :: a.name
        if arg_name == null {
            if seen_named {
                diags.push(
                    typecheck_error(
                        .WrongArgCount,
                        a.span,
                        "positional argument after a named argument",
                    ),
                )
                ok = false
            } else if next_pos >= params.len() {
                diags.push(
                    typecheck_error(
                        .WrongArgCount,
                        a.span,
                        "too many arguments : expected ${params.len()}",
                    ),
                )
                ok = false
            } else {
                slots[next_pos] = a
                next_pos = next_pos + 1
            }
        } else {
            seen_named = true
            idx :: param_index_by_name(params, arg_name)
            if idx < 0 {
                diags.push(
                    typecheck_error(.UnknownNamedArg, a.span, "no parameter named `${arg_name}`"),
                )
                ok = false
            } else if slots[usize(idx)] != null {
                diags.push(
                    typecheck_error(
                        .NamedArgDuplicatesPositional,
                        a.span,
                        "argument for `${arg_name}` was already supplied",
                    ),
                )
                ok = false
            } else {
                slots[usize(idx)] = a
            }
        }
    }
    out: AST.CallArg[]: []
    for i in 0..<params.len() {
        slot :: slots[i]
        if slot is AST.CallArg {
            out.push(slot)
        } else {
            dv :: params[i].default_value
            if dv != null {
                out.push(
                    AST.CallArg {
                        .span = dv.span,
                        .name = null,
                        .value = dv,
                        .spread = false,
                    },
                )
            } else {
                diags.push(
                    typecheck_error(
                        .MissingRequiredArg,
                        c.span,
                        "`${params[i].name}`",
                    ),
                )
                ok = false
            }
        }
    }
    if !ok {
        return null
    }
    return out
}

// Whether every argument of `args` sits at its parameter's position : unnamed, or
// named after the parameter at its index.
in_parameter_order :: fn(params: AST.FnParam[], args: AST.CallArg[]) -> bool {
    for i in 0..<args.len() {
        name :: args[i].name
        if name != null && name != params[i].name {
            return false
        }
    }
    return true
}

param_index_by_name :: fn(params: AST.FnParam[], name: string) -> isize {
    for i in 0..<params.len() {
        if params[i].name == name {
            return isize(i)
        }
    }
    return -1
}

// A purely-positional, full-arity call needs no reordering or default fill —
// cheap check so the common call path skips the callee-decl lookup entirely.
call_needs_arg_normalisation :: fn(c: AST.CallExpr, callee_ty: FnType) -> bool {
    if c.args.len() != callee_ty.params.len() {
        return true
    }
    for a in c.args {
        if a.name != null {
            return true
        }
    }
    return false
}

// Find the declared parameters that line up positionally with `callee_ty`'s
// params, so `normalize_call_args` can reorder named args + fill defaults.
// Covers every call shape that carries param names :
//   - direct call : the resolved symbol's decl (arity must match) ;
//   - overloaded name : the bucket candidate whose signature is the one
//     `pick_overload` chose ;
//   - UFCS free-fn method (`x.m(args)`) : the method's decl minus its `self`
//     param, which lines up with the curried callee type.
// Returns null when no decl is reachable (fn-values, imported overloads,
// impl-block methods) — those stay positional.
callee_param_decls :: fn(c: AST.CallExpr, callee_ty: FnType, typed: TypedProgram) -> AST.FnParam[] | null {
    if c.callee is AST.IdentExpr as ie {
        sym :: typed.resolved.idents[ie.span.hash()]
        // Params of the resolved declaration — but matching ARITY is not enough to
        // trust them. On an overloaded name the resolver binds the ident to the
        // PRIMARY (first-declared) sibling while `pick_overload` may have retained
        // another one of the same arity, and handing back the primary's params then
        // mis-fills the call: `pick("a")` took `pick(n: i32, x = "int")`'s default
        // instead of `pick(s: string, y = "str")`'s, silently, and a named arg
        // legal for the picked overload was rejected as T3004. So confirm the
        // resolved decl carries the PICKED signature ; when it doesn't, its params
        // are kept only as a last resort, after the bucket scan below.
        arity_match: AST.FnParam[] | null = null
        if sym is Symbol {
            decl :: typed.fn_decls[sym.id]
            if decl is AST.FnDecl && decl.params.len() == callee_ty.params.len() {
                declared :: typed.decl_types[sym.id]
                if declared is FnType {
                    if equals_type(declared, callee_ty) {
                        return decl.params
                    }
                    arity_match = decl.params
                } else {
                    // No recorded signature to compare against — this decl is the
                    // only candidate this path knows of, so keep the old behaviour.
                    return decl.params
                }
            }
        }
        picked :: overload_params_matching(ie.name, callee_ty, typed)
        if picked != null {
            return picked
        }
        return arity_match
    }
    if c.callee is AST.FieldExpr as fe {
        // Genuine UFCS dispatch (the dispatched fn's own first param was stashed
        // when the FieldExpr was typed) curries away `self`.
        // The pick itself, when the dispatch could keep it: its params minus the
        // receiver, which is what lines up with the curried callee type. Beats
        // re-deriving the winner from the receiver type — the same answer, and
        // one the imported half cannot give at all.
        chosen :: chosen_decl(typed, fe.id)
        if chosen is AST.FnDecl {
            return ufcs_tail_params(chosen)
        }
        // Otherwise a namespace member call (`mod.foo(...)`) : reach the
        // export's declared params so named args + defaults fill, same as the
        // IdentExpr path above.
        return namespace_member_params(fe, callee_ty, typed)
    }
    return null
}

// Declared params of a namespace-qualified callee `mod.foo`. Mirrors
// `field.vader::try_namespace_field`'s base→module resolution but reads the
// decl table populated by `build_namespace_export_decls`. Returns null
// unless `fe` is a namespace member fn call whose arity matches `callee_ty`
// (a mismatch stays positional rather than mis-filling).
namespace_member_params :: fn(fe: AST.FieldExpr, callee_ty: FnType, typed: TypedProgram) -> AST.FnParam[] | null {
    mod_id :: namespace_call_mod_id(fe, typed) ?? return null
    by_name :: typed.namespace_export_decls[mod_id] ?? return null
    fd :: by_name[fe.field] ?? return null
    ps :: fd.params
    if ps.len() != callee_ty.params.len() {
        return null
    }
    return ps
}

// Scan the local overload bucket for the candidate whose fn-type the
// resolver picked, returning its declared params (arity-aligned with the
// pick). Prefers an exact type match, falling back to the first same-arity
// candidate so a substituted generic pick still lands.
overload_params_matching :: fn(name: string, callee_ty: FnType, typed: TypedProgram) -> AST.FnParam[] | null {
    bucket :: typed.resolved.fn_overloads[name] ?? return null
    fallback: AST.FnParam[] | null = null
    for sym in bucket {
        decl :: typed.fn_decls[sym.id]
        if decl is AST.FnDecl {
            if decl.params.len() != callee_ty.params.len() {
                continue
            }
            ft :: typed.decl_types[sym.id]
            if ft is FnType {
                if equals_type(ft, callee_ty) {
                    return decl.params
                }
            }
            if fallback == null {
                fallback = decl.params
            }
        }
    }
    return fallback
}

// A UFCS method's parameters as the CALL SITE writes them: the declaration's,
// minus the receiver the dispatch curried away.
ufcs_tail_params :: fn(fd: AST.FnDecl) -> AST.FnParam[] | null {
    if fd.params.len() == 0 {
        return null
    }
    tail: AST.FnParam[]: []
    for i in 1..<fd.params.len() {
        tail.push(fd.params[i])
    }
    return tail
}



/// T3069 for every type-param of `callee_ty` that nothing at this call site
/// bound — no argument, no explicit `<…>`, no result slot.
///
/// Left unreported, an unbound type-param doesn't fail : `substitute_map`
/// returns it unchanged and the call flows on erased, so the failure lands far
/// downstream and unrecognisably — a vtable miss at runtime, or the lowerer's
/// GATE B1 "unresolved callee" panic.
///
/// Deliberately silent in two cases, both of which would be noise :
///   - an arity mismatch (a T3003 / T3005 already names the real problem, and
///     the missing argument is exactly why the binding is missing) ;
///   - an `expected` that still mentions a type-param — inside a generic body
///     the enclosing fn's own params are legitimately abstract, so nothing can
///     be concluded about what the call should have bound.
report_unbound_type_args :: fn(
    c: AST.CallExpr,
    callee_ty: FnType,
    bindings: MutableMap<i32, Type>,
    arg_types: Type[],
    expected: Type | null,
    checked_arg_count: usize,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    if checked_arg_count != callee_ty.params.len() {
        return
    }
    // Calling a fn-VALUE (a local or pattern binding whose type happens
    // to mention type-params, e.g. `f: fn(T) -> U[]` inside a generic body):
    // there is nothing to infer and no syntax to pass a type argument through.
    if callee_is_kind(c, .Local, typed) || callee_is_kind(c, .Binding, typed) {
        return
    }
    if expected != null && type_contains_type_param(expected) {
        return
    }
    // Inside a generic body every abstract type in scope is legitimately
    // unbound, so an abstract argument — or an abstract UFCS receiver, as in
    // `arr.clone()` on a `T[]` — means nothing can be concluded here. This also
    // under-reports a lambda argument typed against its own still-abstract
    // signature (`a :: build(1, () -> [])` stays silent, and surfaces as a T3008
    // downstream instead) : distinguishing the two costs more false positives
    // than the extra coverage is worth — 35 of them across the tree when tried.
    for at in arg_types {
        if type_contains_type_param(at) {
            return
        }
    }
    if c.callee is AST.FieldExpr as fe {
        receiver :: typed.expr_types[fe.target.id]
        if receiver != null && type_contains_type_param(receiver) {
            return
        }
    }
    unbound: Symbol[]: []
    for p in callee_ty.params {
        collect_unbound_type_params(p, bindings, unbound)
    }
    collect_unbound_type_params(callee_ty.return_type, bindings, unbound)
    for tp in unbound {
        diags.push(
            typecheck_error(
                .TypeArgumentNotInferable,
                c.span,
                "`${tp.name}` — annotate the result slot, or pass the type argument explicitly",
            ),
        )
    }
}

// Hold each type parameter in scope (`FnContext.type_params_in_scope`) that
// `callee_ty` names and nothing bound yet to itself, and add it to `held`. A static
// member called on a type name (`Bag.make(5)`) binds that type's parameters at each
// call, as a receiver would, even inside the type's own impl.
hold_type_params_in_scope :: fn(
    c: AST.CallExpr,
    callee_ty: FnType,
    typed: TypedProgram,
    bindings: MutableMap<i32, Type>,
    held: MutableSet<i32> | null,
) -> MutableSet<i32> | null {
    ctx :: typed.current_fn_ctx ?? return held
    if ctx.type_params_in_scope.len() == 0 || calls_static_member_on_type_name(c, typed) {
        return held
    }
    named: Symbol[]: []
    collect_unbound_type_params(callee_ty, bindings, named)
    out := held
    for sym in named {
        if sym.id in ctx.type_params_in_scope {
            bindings[sym.id] = TypeParamType { .symbol = sym }
            out = with_held(out, sym.id)
        }
    }
    return out
}

// `held` with `id` added, created for the first one.
with_held :: fn(held: MutableSet<i32> | null, id: i32) -> MutableSet<i32> {
    out :: held ?? MutableSet<i32> {}
    out.add(id)
    return out
}

// Whether `c` calls a static member on a named type rather than on a type parameter.
calls_static_member_on_type_name :: fn(c: AST.CallExpr, typed: TypedProgram) -> bool {
    if c.callee !is AST.FieldExpr {
        return false
    }
    member :: typed.static_members[c.callee.id] ?? return false
    return member.owner !is TypeParamType
}

// Record that the body being checked hands its own type parameters to the fn `c`
// calls (`type_param_forwards`) : should that fn observe them, the body keeps
// concrete instances too (`propagate_type_param_observation`).
note_type_param_forward :: fn(
    c: AST.CallExpr, bindings: MutableMap<i32, Type>, typed: TypedProgram,
) -> void {
    ctx :: typed.current_fn_ctx ?? return
    if ctx.fn_id == 0 || !binds_a_type_param(bindings) {
        return
    }
    callee :: called_fn_ref(c, typed) ?? return
    forwards :: typed.type_param_forwards[ctx.fn_id]
    if forwards != null {
        forwards.push(callee)
        return
    }
    typed.type_param_forwards[ctx.fn_id] = [callee]
}

// Whether a call bound some type parameter to a type naming one in turn : inside a
// generic body, one of the body's own.
binds_a_type_param :: fn(bindings: MutableMap<i32, Type>) -> bool {
    for [_, bound] in bindings {
        if type_contains_type_param(bound) {
            return true
        }
    }
    return false
}

// The fn declaration `c` runs : the overload or UFCS pick, else the one its
// callee names (`resolve_callee_fn`). Null for a fn value.
called_fn_ref :: fn(c: AST.CallExpr, typed: TypedProgram) -> FnDeclRef | null {
    picked :: typed.chosen_fns[c.callee.id]
    if picked != null {
        decl :: picked.decl ?? return null
        return FnDeclRef { .module = picked.symbol.module, .decl = decl }
    }
    return resolve_callee_fn(c.callee, typed)
}

// Whether `c` calls a name that resolves to a symbol of `kind`.
callee_is_kind :: fn(c: AST.CallExpr, kind: SymbolKind, typed: TypedProgram) -> bool {
    if c.callee !is AST.IdentExpr {
        return false
    }
    callee_sym :: typed.resolved.idents[c.callee.span.hash()]
    return callee_sym is Symbol && callee_sym.kind == kind
}

// Whether `t` names a type parameter `bindings` has no entry for.
mentions_unbound_type_param :: fn(t: Type, bindings: MutableMap<i32, Type>) -> bool {
    unbound: Symbol[]: []
    collect_unbound_type_params(t, bindings, unbound)
    return unbound.len() > 0
}

// Walk `t` and append every type-param `bindings` has no entry for, skipping
// ones already collected. Mirrors `type_contains_type_param`'s traversal rather
// than threading a closure through `for_each_type`.
collect_unbound_type_params :: fn(t: Type, bindings: MutableMap<i32, Type>, out: Symbol[]) -> void {
    // @partial: only these variants can hold a type-param ; every scalar /
    // primitive variant has no inner type to walk.
    @partial match t {
        is TypeParamType -> {
            if bindings[t.symbol.id] != null {
                return
            }
            for seen in out {
                if seen.id == t.symbol.id {
                    return
                }
            }
            out.push(t.symbol)
        }
        is ArrayType -> { collect_unbound_type_params(t.element, bindings, out) }
        is TupleType -> {
            for el in t.elements { collect_unbound_type_params(el, bindings, out) }
        }
        is StructType -> {
            for a in t.args { collect_unbound_type_params(a, bindings, out) }
        }
        is TraitType -> {
            for a in t.args { collect_unbound_type_params(a, bindings, out) }
        }
        is FnType -> {
            for p in t.params { collect_unbound_type_params(p, bindings, out) }
            collect_unbound_type_params(t.return_type, bindings, out)
        }
        is UnionType -> {
            for v in t.variants { collect_unbound_type_params(v, bindings, out) }
        }
        is DistinctType -> { collect_unbound_type_params(t.backing, bindings, out) }
        _ -> {}
    }
}

// Check ONE argument of a generic call against its substituted param type, then
// feed both unifiers from what came back. Shared by the eager pass and the
// deferred-lambda pass so a future unify step can't land in only one of them.
check_generic_arg :: fn(
    c: AST.CallExpr,
    i: usize,
    callee_ty: FnType,
    bindings: MutableMap<i32, Type>,
    held: MutableSet<i32> | null,
    typed: TypedProgram,
    diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> Type {
    param_ty :: substitute_map(callee_ty.params[i], bindings)
    arg_ty :: check_expr_fn(c.args[i].value, param_ty, typed, diags)
    unify_type_param(callee_ty.params[i], arg_ty, bindings, held)
    // `fn<T>(g: Greeter<T>)` called with `Hello{}` (where `Hello implements
    // Greeter(i32)`) : unify can't recover T from a struct→trait dispatch —
    // read it from the recorded impl args.
    unify_struct_to_trait_args(callee_ty.params[i], arg_ty, typed, bindings, held)
    return arg_ty
}

/// Type-check a `CallExpr`. `check_expr_fn` is threaded the same way as in
/// `binary.vader::infer_binary`, standing in for `expr.vader::check_expr`.
///
/// @param expected  the slot the call's result flows into, when there is one.
///                  Only a generic callee reads it : a type-param no argument
///                  binds takes its binding from the return type (see the
///                  deferred-lambda pass below).
export infer_call :: fn(
    c: AST.CallExpr,
    expected: Type | null,
    typed: TypedProgram,
    diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> Type {
    // The calls nested in the callee's target and in the arguments each set
    // `callee_field_id` in turn : each puts back the one it found, so the member
    // this call settles after typing its arguments is still known as its callee.
    enclosing :: typed.callee_field_id
    ty :: type_call(c, expected, typed, diags, check_expr_fn)
    typed.callee_field_id = enclosing
    return ty
}

type_call :: fn(
    c: AST.CallExpr,
    expected: Type | null,
    typed: TypedProgram,
    diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> Type {
    if c.callee is AST.FieldExpr {
        typed.callee_field_id = c.callee.id
    }
    initial_callee_ty :: check_expr_fn(c.callee, null, typed, diags)
    // Overload dispatch : when the callee is a bare ident whose name
    // has multiple fn overloads (`describe :: fn(Box) -> ... ;
    // describe :: fn(Bag) -> ...`), pre-walk the args and pick the
    // overload whose first param accepts the first arg. A member several impls
    // of one trait offer is picked the same way.
    member_ty :: pick_member_overload(c, initial_callee_ty, expected, typed, diags, check_expr_fn)
    callee_ty :: ufcs_generic_signature(
        c.callee, pick_overload(c, member_ty, typed, diags, check_expr_fn), typed,
    )
    // `T(x)` cast-style call : treat the call as a conversion and return the target
    // type. Folded before reaching the not-callable arm.
    if converts_by_name(c, callee_ty, typed) {
        record_call_site(typed, c, BUILTIN_CALLEE)
        return cast_call_target(c, typed, diags, check_expr_fn)
    }
    named :: resolve_callee_fn(c.callee, typed)
    record_call_site(typed, c, callee_of_call(typed, c, callee_ty, named))
    // Unresolved callee : upstream error already reported, fall through
    // to keep checking args (drives narrowing in their inner literals).
    if callee_ty is UnresolvedType {
        check_args_no_expected(c, typed, diags, check_expr_fn)
        return TY_UNRESOLVED
    }
    if callee_ty !is FnType {
        diags.push(
            typecheck_error(
                .NotCallable,
                c.span,
                "callee has type ${display_type(callee_ty)}, not a function",
            ),
        )
        check_args_no_expected(c, typed, diags, check_expr_fn)
        return TY_UNRESOLVED
    }
    // Reorder named args + fill defaults in place, so the positional checks
    // below and the lowerer both see a normalised call. Only calls that carry
    // a name or whose arity differs need this — a purely-positional full-arity
    // call skips the decl lookup entirely (the common path). `callee_param_decls`
    // returns the declared params (arity-aligned with the picked callee type)
    // for direct / overloaded / UFCS calls ; fn-values + imported overloads
    // have no decl and stay positional.
    normalised := false
    if call_needs_arg_normalisation(c, callee_ty) {
        decl_params :: callee_param_decls(c, callee_ty, typed)
        if decl_params != null {
            norm :: normalize_call_args(decl_params, c, diags)
            // normalize_call_args owns arity/named diagnostics here ; skip the
            // positional check below to avoid double-reporting. A null result
            // (nothing to reorder, variadic, error) leaves `c.args` as it is.
            normalised = true
            if norm is AST.CallArg[] as na {
                c.args = na
            }
        }
    }
    if !normalised && c.args.len() != callee_ty.params.len() {
        diags.push(
            typecheck_error(
                .WrongArgCount,
                c.span,
                "expected ${callee_ty.params.len()}, got ${c.args.len()}",
            ),
        )
    }
    reject_indirect_callbacks(c, callee_ty, typed, diags)
    // `@no_return` callees (`panic` / `todo` / `unreachable`) yield `never`.
    // Resolved once here, applied at each return below — args are still
    // type-checked first so a bad argument to `todo(...)` is still flagged.
    diverges :: named != null && AST.decorators_have(named.decl.decorators, "no_return")
    n :: min(c.args.len(), callee_ty.params.len())
    if fn_has_type_params(callee_ty) {
        bindings :: MutableMap<i32, Type> {}
        // Explicit type args `f<i64>(…)` : seed bindings from the
        // callee's `<…>` BEFORE arg-checking so each param substitutes
        // to its concrete type and a free-literal arg pins to it (e.g.
        // `9000000000` → i64) instead of defaulting to i32 and
        // truncating. Authoritative — seeded first so arg-unify can't
        // loosen it.
        held := seed_explicit_type_args(c.callee, typed, bindings, diags)
        // UFCS dispatch : seed bindings from the receiver's type so
        // type-params bound by the (curried-away) first param
        // (`fn<T>(x: T) -> T` called as `42.identity()`) still
        // substitute through the return type.
        seed_ufcs_bindings(c.callee, typed, bindings, held)
        // After the receiver, which still binds an impl's own parameters at the
        // instance it names (`other.m()` with `other: Box<i32>` inside `Box<T>`'s).
        held = hold_type_params_in_scope(c, callee_ty, typed, bindings, held)
        arg_types: Type[]: []
        // Lambda arguments are checked LAST. Their param type may mention a
        // type-param that nothing has bound yet — one a later argument, or the
        // call's `expected`, resolves. Checking `() -> []` against an
        // unsubstituted `fn() -> T` types the body under erasure (`?[]`), and a
        // `?[]` array literal lowers to a BOXED buffer that the concrete
        // call-site then reads back as packed elements — silent corruption, not
        // a diagnostic.
        has_lambda := false
        for i in 0..<n {
            if c.args[i].value is AST.LambdaExpr {
                arg_types.push(TY_UNRESOLVED)
                has_lambda = true
                continue
            }
            arg_types.push(
                check_generic_arg(c, i, callee_ty, bindings, held, typed, diags, check_expr_fn),
            )
        }
        // Whatever the arguments left unbound, the result slot may pin :
        // `out: i32[][] = filled(n, () -> [])` binds `T = i32[]` through
        // `T[]` ↔ `i32[][]`, and `rows: i32[] = empty()` is a type-param NO
        // argument can reach. Arguments keep priority — `unify_type_param` only
        // fills a type-param that has no binding yet. An `expected` that still
        // mentions a type-param is NOT a pin : nested inside another generic
        // call (`my_filter(my_map(xs, f), p)`), the inner call's expected is the
        // outer's still-unbound `Iterator<T>`, and binding to it would carry
        // that foreign type-param into the result instead of a concrete type.
        if expected != null && !type_contains_type_param(expected) {
            unify_type_param(callee_ty.return_type, expected, bindings, held, lowers_rights = false)
        }
        if has_lambda {
            // Run the deferred lambdas to a FIXPOINT, not once : within the
            // group, an earlier lambda can need a type-param a later one binds
            // (`zip_with(() -> [], (s: string) -> s.len())` — the second binds
            // `T`, the first consumes it), and a single ordered pass would type
            // the first one under erasure. Diagnostics from these rounds go to a
            // scratch sink so a lambda that reports twice isn't counted twice ;
            // the authoritative pass below re-runs them against `diags`.
            // Bounded by the argument count : every round that continues has
            // bound at least one more type-param. Skipped when every lambda's
            // slot is bound already : the rounds could bind nothing, and nested
            // lambdas would be checked twice per level.
            if lambda_slot_unbound(c, callee_ty, bindings, n) {
                scratch: Diagnostic[]: []
                for 0..<n {
                    before :: bindings.len()
                    for i in 0..<n {
                        if c.args[i].value !is AST.LambdaExpr {
                            continue
                        }
                        check_generic_arg(
                            c, i, callee_ty, bindings, held, typed, scratch, check_expr_fn,
                        )
                    }
                    if bindings.len() == before {
                        break
                    }
                }
            }
            for i in 0..<n {
                if c.args[i].value !is AST.LambdaExpr {
                    continue
                }
                arg_types[i] = check_generic_arg(
                    c, i, callee_ty, bindings, held, typed, diags, check_expr_fn,
                )
            }
        }
        report_unbound_type_args(c, callee_ty, bindings, arg_types, expected, n, typed, diags)
        reject_ufcs_receiver_at_instance(c, bindings, typed, diags)
        instance :: substitute_fn_map(callee_ty, bindings)
        for i in 0..<n {
            want :: instance.params[i]
            if reject_immutable_into_mutable_param(instance, i, arg_types[i], c, typed, diags) {
                continue
            }
            // A parameter still naming a type parameter of the callee that nothing
            // bound has nothing to check against. One bound to the enclosing fn's
            // `T` does : `pick(x, 0)` hands a literal to that `T`.
            if mentions_unbound_type_param(callee_ty.params[i], bindings) {
                // `count(it)` with `it: I` and `I: Iterator<i32>` : the callee's `T`
                // is only knowable from the instance's concrete `I`, which an erased
                // instance does not keep.
                if arg_types[i] is TypeParamType {
                    keep_instances_concrete(typed)
                }
                continue
            }
            // T3072 owns the argument's own top-level bit, as on the plain path below.
            cleared :: arg_mutability_cleared(arg_types[i])
            slot :: param_shape_slot(arg_types[i], want)
            if is_assignable(cleared, slot)                       { continue }
            if try_into(cleared, slot, typed, c.args[i].value.id) { continue }
            note_gaining_need(c, i, arg_types[i], want, typed)
            push_level_mismatch(
                arg_types[i], want, c.args[i].span, .TypeMismatch, c.args[i].value, typed, diags,
            )
        }
        // Default any FreeInt/FreeFloat bound to a typeParam before
        // substituting, so the return type comes back concrete
        // (`i32` / `f64`) instead of `{integer}` / `{float}`.
        for k in bindings.keys() {
            v :: bindings[k] ?? continue
            bindings[k] = default_if_free(v)
        }
        note_type_param_forward(c, bindings, typed)
        // A method-form callee reads as the call binds it, receiver and arguments
        // together, not as the receiver alone did (`local.pick(CFG)` reads
        // `fn(Cfg) -> Cfg`, `cfg.wrap("s")` reads `fn(string) -> string`) : what
        // tooling shows.
        if c.callee is AST.FieldExpr && typed.ufcs_receiver_types[c.callee.id] != null {
            typed.expr_types[c.callee.id] = substitute_fn_map(callee_ty, bindings)
        }
        // A Free* numeric arg takes what its parameter was bound to. Into a
        // trait-typed param it is boxed : when `7` flows into `Doubler<T>` and
        // `i32 implements Doubler(i32)`, the arg expr records the substituted trait
        // type so the lowerer emits `int(7) :Doubler(i32)`. Into a primitive it is
        // re-checked against it, nested literals included : `pick(1, x)` with
        // `x: i64` binds `T = i64`, and the lowerer instantiates `pick` from the
        // types recorded on the arguments.
        for i in 0..<n {
            got :: arg_types[i]
            if got !is FreeIntType && got !is FreeFloatType {
                continue
            }
            want :: substitute_map(callee_ty.params[i], bindings)
            if want is TraitType {
                if struct_implements_trait(default_if_free(got), trait_key_of(want.symbol), typed) {
                    typed.expr_types[c.args[i].value.id] = want
                }
            } else if want is PrimitiveType {
                _ :: check_expr_fn(c.args[i].value, want, typed, [])
            }
        }
        repin_free_ufcs_receiver_at_instance(c, bindings, typed, check_expr_fn)
        // T3006 : enforce `T: Trait` bounds on the callee's fn-decl
        // type-params against the bindings we ended up with.
        check_typeparam_bounds(c, bindings, typed, diags)
        if diverges {
            return TY_NEVER
        }
        // Direction A : a `generator` call is typed as its concrete `<fn>$State`
        // iterator (chains resolve on a concrete receiver), not the erased return.
        // The substituted return (`Iterator<i32>`) carries the concrete element so
        // `<fn>$State<i32>` implements `Iterator<i32>` (collect/find concretise).
        concrete_ret :: substitute_map(callee_ty.return_type, bindings)
        gen_res :: generator_call_result_type(c, typed, concrete_ret)
        if gen_res != null {
            return gen_res
        }
        async_res :: async_call_result_type(c, typed, concrete_ret)
        if async_res != null {
            return async_res
        }
        return concrete_ret
    }
    // See `TypedProgram.overloaded_arg_depth`. Raised around the ARGUMENTS only:
    // the callee was typed above, and the loop below has no early return.
    overloaded :: callee_has_overloads(c, typed)
    if overloaded {
        typed.overloaded_arg_depth = typed.overloaded_arg_depth + 1
    }
    for i in 0..<n {
        param_ty :: callee_ty.params[i]
        arg_ty :: check_expr_fn(c.args[i].value, param_ty, typed, diags)
        if reject_immutable_into_mutable_param(callee_ty, i, arg_ty, c, typed, diags) {
            continue
        }
        // T3072 above owns struct mutability at an argument, and says it better (it
        // names the parameter and the annotatable root). Clear the top-level struct
        // bit so the generic assignability check doesn't double-report the same
        // problem as T3077 — measured, that double-report alone was 424 of 535 sites.
        // Array mutability still flows through : nothing else checks it here.
        cleared :: arg_mutability_cleared(arg_ty)
        slot :: param_shape_slot(arg_ty, param_ty)
        if is_assignable(cleared, slot) { continue }
        if try_into(cleared, slot, typed, c.args[i].value.id) { continue }
        note_gaining_need(c, i, arg_ty, param_ty, typed)
        push_level_mismatch(
            arg_ty, param_ty, c.args[i].span, .TypeMismatch, c.args[i].value, typed, diags,
        )
    }
    if overloaded {
        typed.overloaded_arg_depth = typed.overloaded_arg_depth - 1
    }
    widen_empty_array_on_push(c, typed)
    check_receiver_alone(c, typed, diags)
    if diverges {
        return TY_NEVER
    }
    gen_res :: generator_call_result_type(c, typed, callee_ty.return_type)
    if gen_res != null {
        return gen_res
    }
    async_res :: async_call_result_type(c, typed, callee_ty.return_type)
    if async_res != null {
        return async_res
    }
    return callee_ty.return_type
}

/// Empty-array back-widening : on `arr.push(elem)` where `arr` is a
/// Local with `?[]` and `elem` has a concrete type, retroactively
/// widens the Local's `local_types` to `elem_type[]`. The current
/// call's `arr` IdentExpr stays at `?[]` in `expr_types` (typed
/// before this fires) — subsequent reads of `arr` see the widened
/// type.
///
/// The `[]` LITERAL is widened alongside it (via `empty_array_inits`). It is
/// what the lowerer reads to pick the buffer's element kind, so leaving it at
/// `?[]` allocates a BOXED buffer while the widened local makes every read and
/// write packed — a mismatch that corrupts silently once the buffer grows past
/// its first allocation (`x := [] ; 9 × push(i)` read back `x[8] == 0`).
widen_empty_array_on_push :: fn(c: AST.CallExpr, typed: TypedProgram) -> void {
    if c.callee !is AST.FieldExpr {
        return
    }
    field_callee :: c.callee
    if field_callee.field != "push" {
        return
    }
    if c.args.len() == 0 {
        return
    }
    if field_callee.target !is AST.IdentExpr {
        return
    }
    target_ident :: field_callee.target
    symbol :: typed.resolved.idents[target_ident.span.hash()] ?? return
    if symbol.kind != .Local {
        return
    }
    binding_span :: symbol.defined_at ?? return
    binding_key :: binding_span.hash()
    current :: typed.local_types[binding_key]
    if current !is ArrayType {
        return
    }
    if current.element !is UnresolvedType {
        return
    }
    arg_type :: typed.expr_types[c.args[0].value.id] ?? return
    if arg_type is UnresolvedType {
        return
    }
    element :: default_if_free(arg_type)
    widened :: mk_array(element, false)
    typed.local_types[binding_key] = widened
    // This very call's receiver and `push` member were typed before the widening
    // fired, so they still read `?[]` / `fn(?) -> void`. Nothing downstream picks
    // the element kind from them today — the emitted C is identical either way —
    // but leaving a type that lies is how the literal-vs-local mismatch started,
    // and the LSP reads these same entries for hover.
    typed.expr_types[target_ident.id] = widened
    // `push` takes `value: T!` ; the rebuilt member keeps the marker.
    typed.expr_types[c.callee.id] = FnType { .params = [element], .params_mutable = [true], .return_type = TY_VOID }
    init_id :: typed.empty_array_inits[binding_key] ?? return
    typed.expr_types[init_id] = widened
}

// Whether `c` is a conversion `T(x)` rather than a call : its callee names a type in
// value position — the metatype of a bare type name, or a struct's own name called on
// one value (`Info(v)`), which types as the struct rather than as a metatype.
converts_by_name :: fn(c: AST.CallExpr, callee_ty: Type, typed: TypedProgram) -> bool {
    if callee_ty is TypeMetaType {
        return true
    }
    if callee_ty !is StructType || c.args.len() != 1 {
        return false
    }
    return names_symbol_of_kind(c.callee, .Struct, typed)
}

// Whether `c`, once checked, was a conversion `T(x)`, which runs no user code.
is_checked_conversion :: fn(c: AST.CallExpr, typed: TypedProgram) -> bool {
    callee_ty :: typed.expr_types[c.callee.id] ?? return false
    return converts_by_name(c, callee_ty, typed)
}

/// `T(x)` where `T` is a type-name — the call-syntax cast (the parser emits a
/// `CallExpr` here, not a `CastExpr`). Type-checks the value and returns the
/// target type — the read-only data itself for `Data(variant)` — emitting
/// T3010 for an illegal conversion via the shared `cast_allowed` gate (same as
/// `expr_cast.vader::infer_cast`).
///
/// @error T3010 when a `(value → target)` pair is not a legal conversion
///        (`i32("hello")`, `bool(someStruct)`).
cast_call_target :: fn(
    c: AST.CallExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> Type {
    target :: type_from_expr(c.callee, typed.resolved, diags)
    if c.args.len() != 1 {
        diags.push(typecheck_error(.WrongArgCount, c.span,
            "a cast to `${display_type(target)}` takes one value, got ${c.args.len()}"))
    }
    result: Type = target
    // Pass the cast target as expected for each arg so a Free* literal
    // (or `-Free*` unary) narrows into the target's primitive shape —
    // `i64(-250)` types the `-250` as `i64`, not `{integer}`.
    expected :: cast_operand_expected(target)
    for arg in c.args {
        src :: check_expr_fn(arg.value, expected, typed, diags)
        // Variant data is constant : reading it hands back a read-only value.
        data :: enum_data_of(src, target)
        if data != null {
            result = data
        } else if !cast_allowed(src, target, typed) {
            diags.push(
                typecheck_error(
                    .InvalidCast,
                    arg.value.span,
                    "cannot cast ${display_type(src)} to ${display_type(target)}",
                ),
            )
        } else if type_withholds_mutation(src) {
            // A conversion hands out what it was lent : `Point(ORIGIN)` is the const.
            result = with_immutable(target, true)
        }
    }
    return result
}

/// T3006 enforcement : every type parameter the call bound must satisfy each
/// trait of its bound, wherever the callee is declared and however it is called
/// — direct, UFCS, through a namespace. Skips a parameter the call left unbound
/// (it already reports T3001 or T3069).
check_typeparam_bounds :: fn(
    c: AST.CallExpr,
    bindings: MutableMap<i32, Type>,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    for [id, bound_ty] in bindings {
        bound :: typed.type_param_bound_traits[id] ?? continue
        for trait_ty in bound.traits {
            wanted: TraitType = trait_ty
            if trait_ty.args.len() > 0 {
                substituted :: substitute_map(trait_ty, bindings)
                if substituted is TraitType {
                    wanted = substituted
                }
            }
            reason :: unmet_bound_reason(bound_ty, wanted, typed) ?? continue
            key :: trait_key_of(trait_ty.symbol)
            owner :: callee_name(c.callee)
            detail := unmet_bound_detail(bound.name, owner, wanted, reason) +
                unmet_impl_bound_note(bound_ty, key, typed)
            // `satisfies_bound` refuses an array any `Display` : say why.
            if bound_ty is ArrayType && key == core_trait_key(TRAIT_DISPLAY) {
                detail = ("an array renders only when interpolated directly, not through type "
                    + "parameter `${bound.name}` of `${owner}`")
            }
            diags.push(typecheck_error(.TraitNotSatisfied, c.span, detail))
        }
    }
}

// Whether `t` implements `wanted` at its arguments — `Contains<string>` is no
// `Contains<i32>`. A trait without arguments is `satisfies_bound`'s alone (an
// enum's `Equals` has no impl to compare) ; arguments the call left unbound, or a
// type the check cannot see into, are undecided and so met.
meets_trait_args :: fn(t: Type, wanted: Type, typed: TypedProgram) -> bool {
    if wanted !is TraitType || wanted.args.len() == 0 || type_contains_type_param(wanted) {
        return true
    }
    if t is TypeParamType {
        return bound_widens_into(t, wanted, typed)
    }
    return t is UnresolvedType | AnyType || implements_trait_instance(t, wanted, typed)
}

// The fn a UFCS call reaches when its receiver's parameter names the fn's type
// parameters, else null.
generic_ufcs_callee :: fn(callee: AST.Expr, typed: TypedProgram) -> FnCandidate | null {
    if callee !is AST.FieldExpr || typed.ufcs_receiver_types[callee.id] == null {
        return null
    }
    chosen :: typed.chosen_fns[callee.id] ?? return null
    return if type_contains_type_param(chosen.ty.params[0]) { chosen } else { null }
}

// The signature a UFCS call of a generic fn is checked against : the callee's own,
// minus the receiver, its type parameters left for the receiver AND the arguments to
// bind together, as the free call binds them (`local.pick(CFG)` is
// `pick(local, CFG)`). Any other callee keeps `callee_ty`.
ufcs_generic_signature :: fn(callee: AST.Expr, callee_ty: Type, typed: TypedProgram) -> Type {
    if callee_ty !is FnType {
        return callee_ty
    }
    chosen :: generic_ufcs_callee(callee, typed) ?? return callee_ty
    return mk_fn_drop_self(chosen.ty)
}

// The receiver of a UFCS call of a generic fn, held to its parameter as the instance
// has it, as any argument is (`rows.put(LIST)` is `put(rows, LIST)`). Its own top
// level was judged when the method was resolved (T3071).
reject_ufcs_receiver_at_instance :: fn(
    c: AST.CallExpr, bindings: MutableMap<i32, Type>, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    callee :: c.callee
    if callee !is AST.FieldExpr {
        return
    }
    chosen :: generic_ufcs_callee(callee, typed) ?? return
    first :: chosen.ty.params[0]
    if mentions_unbound_type_param(first, bindings) {
        return
    }
    receiver_ty :: typed.expr_types[callee.target.id] ?? return
    want :: substitute_map(first, bindings)
    // A receiver widening into a trait parameter fits through its impl, which the
    // method access checked — or converts into it, as an array into an `Iterator`.
    if want is TraitType {
        return
    }
    if is_assignable(arg_mutability_cleared(receiver_ty), param_shape_slot(receiver_ty, want)) {
        return
    }
    push_level_mismatch(
        receiver_ty, want, callee.target.span, .TypeMismatch, callee.target, typed, diags,
    )
}

// Whether a lambda argument's parameter still names a type parameter of the callee
// that a round over the lambdas could bind : one nothing has bound, or one only a
// free literal has (`fold(0, (acc: i32, x: i32) -> …)` settles `U` on `i32`).
lambda_slot_unbound :: fn(
    c: AST.CallExpr, callee_ty: FnType, bindings: MutableMap<i32, Type>, n: usize,
) -> bool {
    for i in 0..<n {
        if c.args[i].value !is AST.LambdaExpr {
            continue
        }
        slot :: callee_ty.params[i]
        if mentions_unbound_type_param(slot, bindings) {
            return true
        }
        if any_type(substitute_map(slot, bindings), is_free_numeric) {
            return true
        }
    }
    return false
}


// A free literal receiver of a UFCS call takes what its parameter was bound to, as
// a free literal argument does : `1.pick(x)` with `x: i64` is an `i64` receiver.
repin_free_ufcs_receiver_at_instance :: fn(
    c: AST.CallExpr,
    bindings: MutableMap<i32, Type>,
    typed: TypedProgram,
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> void {
    callee :: c.callee
    if callee !is AST.FieldExpr {
        return
    }
    chosen :: generic_ufcs_callee(callee, typed) ?? return
    receiver_ty :: typed.expr_types[callee.target.id] ?? return
    if receiver_ty !is FreeIntType && receiver_ty !is FreeFloatType {
        return
    }
    want :: substitute_map(chosen.ty.params[0], bindings)
    if want is PrimitiveType {
        _ :: check_expr_fn(callee.target, want, typed, [])
    }
}

// A UFCS call whose signature minus the receiver names none of the callee's type
// parameters (`m.println()` on `println<T: Display>(msg: T)`) : the receiver alone
// binds them, so the generic path never ran. Its bounds (T3006) and its rights
// are judged here.
check_receiver_alone :: fn(c: AST.CallExpr, typed: TypedProgram, diags: Diagnostic[]) -> void {
    if c.callee !is AST.FieldExpr || generic_ufcs_callee(c.callee, typed) == null {
        return
    }
    bindings :: MutableMap<i32, Type> {}
    seed_ufcs_bindings(c.callee, typed, bindings, null)
    reject_ufcs_receiver_at_instance(c, bindings, typed, diags)
    decl :: chosen_decl(typed, c.callee.id) ?? return
    if has_bounded_type_param(decl) {
        check_typeparam_bounds(c, bindings, typed, diags)
    }
}

has_bounded_type_param :: fn(decl: AST.FnDecl) -> bool {
    for tp in decl.type_params {
        if tp.bound !is null {
            return true
        }
    }
    return false
}

/// The declaration a call's callee names: a bare or explicitly instantiated name
/// (`f`, `f<…>`), through an import redirect, or a namespace-qualified `M.f`.
/// Says nothing about overloads — `chosen_decl` holds the one typecheck picked.
///
/// @param callee  the call's callee expression.
/// @param typed   the module the call sits in.
/// @return        the `FnDecl`, or null when the callee is no named fn.
export lookup_callee_fn_decl :: fn(callee: AST.Expr, typed: TypedProgram) -> AST.FnDecl | null {
    found :: resolve_callee_fn(callee, typed) ?? return null
    return found.decl
}

// `lookup_callee_fn_decl`'s declaration, with the module that declares it.
resolve_callee_fn :: fn(callee: AST.Expr, typed: TypedProgram) -> FnDeclRef | null {
    // See through an explicit `f<…>` instantiation to the underlying
    // ident, so `f<i64>(…)` finds its decl too.
    base: AST.Expr = callee
    if callee is AST.GenericInstExpr {
        base = callee.callee
    }
    // A namespace-qualified name — `M.f`, the form §7 of the style guide
    // mandates for an aliased import. It is a `FieldExpr`, not an ident, and
    // treating it as unresolvable had two costs: a valid callback argument was
    // refused T3080, and a call whose CALLEE wore that shape skipped the check
    // entirely and reached `midir/build`'s panic.
    if base is AST.FieldExpr {
        mod_id :: namespace_call_mod_id(base, typed) ?? return null
        by_name :: typed.namespace_export_decls[mod_id] ?? return null
        member :: by_name[base.field] ?? return null
        return FnDeclRef { .module = mod_id, .decl = member }
    }
    if base !is AST.IdentExpr {
        return null
    }
    sym :: typed.resolved.idents[base.span.hash()] ?? return null
    redirected :: redirect_import_typed(sym, typed)
    decl :: typed.fn_decls[redirected.id] ?? return null
    return FnDeclRef { .module = redirected.module, .decl = decl }
}

// True when the callee fn carries `@no_return` (`panic` / `todo` /
// `unreachable`). Such a call diverges, so its expression type is `never` —
// assignable into any slot and flow-terminating (see `is_divergent_stmt`).
/// Reject a callback argument that is not a direct reference to a named fn.
///
/// What crosses to C is the function's ADDRESS (`bytecode/op::FnAddr`), and only
/// a named fn has one: a lambda or a closure is a `vader_fn_t` whose `code` takes
/// a leading `env` and boxed arguments, so the foreign callee would jump into the
/// wrong ABI. The TYPE is fine in both cases — this is a shape rule, which is why
/// it needs a diagnostic of its own rather than a mismatch.
///
/// @param c          the call being checked.
/// @param callee_ty  its callee's fn type, for the parameter positions.
/// @param typed      resolves an argument to the fn it names, if any.
/// @param diags      accumulator for T3080.
reject_indirect_callbacks :: fn(
    c: AST.CallExpr, callee_ty: FnType, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    // Nothing to look up unless a parameter is a fn type — this runs on every
    // call expression in the program, and almost none has one.
    has_callback := false
    for pt in callee_ty.params {
        if pt is FnType {
            has_callback = true
        }
    }
    if !has_callback {
        return
    }
    decl :: lookup_callee_fn_decl(c.callee, typed) ?? return
    if !AST.decorators_have(decl.decorators, "extern") {
        return
    }
    n :: min(c.args.len(), callee_ty.params.len())
    for i in 0..<n {
        if callee_ty.params[i] !is FnType {
            continue
        }
        // The SAME question `midir/build::build_extern_args` asks — does this
        // argument resolve to a fn symbol. A syntactic ident test is not it: a
        // local bound to a fn is an ident and has no address of its own.
        if lookup_callee_fn_decl(c.args[i].value, typed) != null {
            continue
        }
        diags.push(typecheck_error(
            .CallbackNotDirectFn, c.args[i].span,
            "argument ${i + 1} of `${callee_name(c.callee)}`",
        ))
    }
}

callee_name :: fn(callee: AST.Expr) -> string {
    // @partial: only ident / field / generic-inst callees carry a source name;
    // any other callee shape is anonymous → the "<callee>" placeholder.
    @partial match callee {
        is AST.IdentExpr       -> { return callee.name }
        is AST.FieldExpr       -> { return callee.field }
        is AST.GenericInstExpr -> { return callee_name(callee.callee) }
        _                      -> { return "<callee>" }
    }
}

import "vader/resolver"

redirect_import_typed :: fn(sym: Symbol, typed: TypedProgram) -> Symbol {
    if typed.import_targets == null {
        return sym
    }
    return resolve_import_redirect(sym, typed.import_targets)
}

/// When `param` is `Trait(T, U, …)` and `arg` is a struct (or
/// primitive — e.g. `i32 implements Doubler(i32)`) that implements
/// that trait, bind `T`, `U`, … from `struct_trait_args`.
unify_struct_to_trait_args :: fn(
    param: Type,
    arg: Type,
    typed: TypedProgram,
    out: MutableMap<i32, Type>,
    held: MutableSet<i32> | null,
) -> void {
    if param !is TraitType {
        return
    }
    // Resolve (not just look up) so a GENERIC impl's `[T]` args are substituted by
    // the concrete receiver instance (`FilterIterator<i32>` → `[i32]`), binding the
    // param's `T` to `i32` instead of the impl's own `T`.
    impl_args :: resolve_struct_trait_args(arg, trait_key_of(param.symbol), typed) ?? return
    n :: min(param.args.len(), impl_args.len())
    for i in 0..<n {
        unify_type_param(param.args[i], impl_args[i], out, held)
    }
}

fn_has_type_params :: fn(f: FnType) -> bool {
    for p in f.params {
        if type_contains_type_param(p) {
            return true
        }
    }
    return type_contains_type_param(f.return_type)
}

// Walk the args once for their side-effects only — type them in a
// fresh-position context so inner literals get a sensible type even
// when the callee itself didn't resolve to a Fn (already errored).
check_args_no_expected :: fn(
    c: AST.CallExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> void {
    for a in c.args {
        check_expr_fn(a.value, null, typed, diags)
    }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "vader/parser"

// Tiny stub : handles the variants the call tests touch. Real call sites
// use `expr.vader::check_expr` — we can't import that here (cycle).
call_check_stub :: fn(
    e: AST.Expr,
    expected: Type | null,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type {
    // @partial: test stub — only the literal / ident / call expr kinds the call
    // tests build are typed; every other Expr is irrelevant → unresolved.
    @partial match e {
        is AST.IntLitExpr    -> { return TY_FREE_INT }
        is AST.StringLitExpr -> { return TY_STRING }
        is AST.IdentExpr     -> { return infer_ident(e, typed) }
        is AST.CallExpr      -> { return infer_call(e, null, typed, diags, call_check_stub) }
        _                    -> { return TY_UNRESOLVED }
    }
}

// Parse + resolve + check `src`, then find the first `CallExpr` reached
// by a depth-first walk of the last decl's body via the shared
// `find_first_in_block` walker.
first_call_in_last_fn :: fn(src: string) -> CallFixture! {
    parsed :: parse_source(src, "t.vader")
    factory :: SymbolFactory {}
    rm :: resolve_module(parsed.program, "t", factory)
    diags: Diagnostic[]: []
    result :: check_module(parsed.program, rm, factory, diags)
    last :: parsed.program.decls[parsed.program.decls.len() - 1]
    if last is AST.FnDecl {
        match last.body {
            is null          -> {
                return CallFixture { .typed = result.typed, .call = null }
            }
            is AST.BlockExpr -> {
                hit :: find_first_in_block(last.body, accept_call)
                call: AST.CallExpr | null = null
                if hit is AST.CallExpr {
                    call = hit
                }
                return CallFixture { .typed = result.typed, .call = call }
            }
        }
    }
    return CallFixture { .typed = result.typed, .call = null }
}

accept_call :: fn(e: AST.Expr) -> AST.Expr! | null {
    if e is AST.CallExpr {
        return e
    }
    return null
}

CallFixture :: struct {
    typed: TypedProgram!
    call: AST.CallExpr! | null
}

@test
test_call_returns_fn_return_type :: fn() -> void {
    src :: """
add :: fn(a: i32, b: i32) -> i32 { return a + b }
main :: fn() -> i32 { return add(1, 2) }
"""
    fx :: first_call_in_last_fn(src)
    match fx.call as c {
        is null         -> { assert(false, "expected to find a call") }
        is AST.CallExpr -> {
            diags: Diagnostic[]: []
            assert_eq(display_type(infer_call(c, null, fx.typed, diags, call_check_stub)), "i32")
            assert_eq(diags.len(), 0)
        }
    }
}

@test
test_call_missing_required_emits_T3005 :: fn() -> void {
    src :: """
add :: fn(a: i32, b: i32) -> i32 { return a + b }
main :: fn() -> i32 { return add(1) }
"""
    fx :: first_call_in_last_fn(src)
    match fx.call as c {
        is null         -> { assert(false, "expected to find a call") }
        is AST.CallExpr -> {
            diags: Diagnostic[]: []
            infer_call(c, null, fx.typed, diags, call_check_stub)
            assert(diags.len() >= 1, "expected at least one diagnostic")
            assert_eq(diags[0].code.id, "T3005")
        }
    }
}

@test
test_call_too_many_emits_T3003 :: fn() -> void {
    src :: """
add :: fn(a: i32, b: i32) -> i32 { return a + b }
main :: fn() -> i32 { return add(1, 2, 3) }
"""
    fx :: first_call_in_last_fn(src)
    match fx.call as c {
        is null         -> { assert(false, "expected to find a call") }
        is AST.CallExpr -> {
            diags: Diagnostic[]: []
            infer_call(c, null, fx.typed, diags, call_check_stub)
            assert(diags.len() >= 1, "expected at least one diagnostic")
            assert_eq(diags[0].code.id, "T3003")
        }
    }
}

@test
test_cast_string_to_int_emits_T3010 :: fn() -> void {
    src :: """
f :: fn() -> i32 { return i32("hello") }
"""
    fx :: first_call_in_last_fn(src)
    match fx.call as c {
        is null         -> { assert(false, "expected to find the cast call") }
        is AST.CallExpr -> {
            diags: Diagnostic[]: []
            infer_call(c, null, fx.typed, diags, call_check_stub)
            found := false
            for d in diags {
                if d.code.id == "T3010" {
                    found = true
                }
            }
            assert(found, "expected T3010 for `i32(string)` (illegal cast)")
        }
    }
}

@test
test_cast_numeric_widen_ok :: fn() -> void {
    src :: """
f :: fn(a: i32) -> i64 { return i64(a) }
"""
    fx :: first_call_in_last_fn(src)
    match fx.call as c {
        is null         -> { assert(false, "expected to find the cast call") }
        is AST.CallExpr -> {
            diags: Diagnostic[]: []
            assert_eq(display_type(infer_call(c, null, fx.typed, diags, call_check_stub)), "i64")
            found := false
            for d in diags {
                if d.code.id == "T3010" {
                    found = true
                }
            }
            assert(!found, "no T3010 for numeric cast `i64(i32)`")
        }
    }
}

@test
test_default_arg_fills_in_place :: fn() -> void {
    src :: """
greet :: fn(name: i32, prefix: i32 = 7) -> i32 { return name }
main :: fn() -> i32 { return greet(1) }
"""
    fx :: first_call_in_last_fn(src)
    match fx.call as c {
        is null         -> { assert(false, "expected to find a call") }
        is AST.CallExpr -> {
            diags: Diagnostic[]: []
            infer_call(c, null, fx.typed, diags, call_check_stub)
            // The omitted trailing param is filled from its default.
            assert_eq(c.args.len(), 2)
        }
    }
}

@test
test_call_type_mismatch_emits_T3001 :: fn() -> void {
    src :: """
greet :: fn(name: string) -> void { }
main :: fn() -> void { greet(42) }
"""
    fx :: first_call_in_last_fn(src)
    match fx.call as c {
        is null         -> { assert(false, "expected to find a call") }
        is AST.CallExpr -> {
            diags: Diagnostic[]: []
            infer_call(c, null, fx.typed, diags, call_check_stub)
            // FreeInt is not assignable to string ; T3001 fires.
            found := false
            for d in diags {
                if d.code.id == "T3001" {
                    found = true
                }
            }
            assert(found, "expected T3001 for int → string")
        }
    }
}

// An argument with its own top-level STRUCT / TUPLE / TRAIT read-only bit dropped — a
// distinct's backing included, but never an ARRAY's, nor a nominal argument's.
//
// T3072 owns struct mutability at an argument, and it reasons about the whole access
// path — so letting the top-level bit reach the generic check only double-reports.
// An array stays as it is: nothing else checks that a read-only `Box[]` is not handed
// to a `Box![]` parameter, whose callee may write through it. A nominal argument
// stays too : `gen_mut(h: Holder<Box!>)` handed a `Holder<Box>` would write through
// its `Box`.
arg_mutability_cleared :: fn(t: Type) -> Type = match t {
    is StructType | TraitType -> with_immutable(t, false)
    is TupleType    -> mk_tuple(arg_mutability_cleared_each(t.elements), false)
    is UnionType    -> mk_union(arg_mutability_cleared_each(t.variants))
    is DistinctType -> if carries_mutability_bit(t) {
        mk_distinct(t.symbol, arg_mutability_cleared(t.backing))
    } else {
        t
    }
    // `FnType` sits in the identity group, where `strip_mutability` descends: a fn
    // type carries no element bit to clear — its marker rides `params_mutable`.
    is ArrayType | PrimitiveType | EnumType | FnType | TypeParamType
     | TypeMetaType | SelfType | UnresolvedType | FreeIntType | FreeFloatType
     | FreeCharType | NeverType | AnyType -> t
}

// The parameter an argument's shape is checked against. A `T` at the argument's top
// level, bare or as a variant, has no bit for `arg_mutability_cleared` to clear, so
// the parameter's top level is set aside instead : T3072 judges a `T` through its
// bound.
param_shape_slot :: fn(arg_ty: Type, param_ty: Type) -> Type =
    if type_param_at_top(arg_ty) { with_immutable(param_ty, true) } else { param_ty }

arg_mutability_cleared_each :: fn(ts: Type[]) -> Type[] {
    out: Type[]: []
    for t in ts { out.push(arg_mutability_cleared(t)) }
    return out
}

// T3071's job, in `field.vader`. `callee_ty` is the signature as this call sees it,
// substituted. True when the argument is refused : its other levels then go unjudged,
// the refusal having said what to fix.
reject_immutable_into_mutable_param :: fn(
    callee_ty: FnType, i: usize, arg_ty: Type, c: AST.CallExpr,
    typed: TypedProgram, diags: Diagnostic[],
) -> bool {
    param_ty :: callee_ty.params[i]
    note_arg_edge(c, i, arg_ty, param_ty, typed)
    note_element_store(c, i, arg_ty, typed)
    if !param_mutable_at(callee_ty, i) {
        return false
    }
    // A `!` on a type parameter promises as much mutation as `T` is bound to, and
    // no more: `push :: fn(self!, value: T!)` stores `value` in the receiver, so a
    // `Box![]` demands a mutable `Box` while a `Box[]` or an `i32[]` asks nothing.
    // An argument filling one variant of a union is held to that variant : `OTHER`
    // fills the read-only `Other` of `Cfg! | Other`.
    slot :: filled_variant(arg_ty, param_ty)
    // A read-only view never fills its own `T`, whatever the bound : the caller may
    // hold that `T` mutable.
    if !lends_view(arg_ty, slot) && !slot_may_grant_mutation(slot, typed.type_param_bound_traits) {
        return false
    }
    // An argument converted on its way in takes the rights of the `into` it goes
    // through : an owned result is what the callee mutates, never the argument.
    if converts_to_owned(arg_ty, param_ty, typed) {
        return false
    }
    if !value_is_read_only(c.args[i].value, arg_ty, typed) {
        return false
    }
    value :: c.args[i].value
    what :: "it is passed to a parameter that mutates it"
    if note_slot_need(value, c.args[i].span, what, typed) {
        return false
    }
    detail :: mutable_param_detail(c, callee_ty, i, typed)
    report_refusal(.ImmutableBorrowIntoMutableParam, c.args[i].span, detail, value, typed, diags)
    return true
}

// The variant of `param_ty` an argument of type `arg_ty` fills, or `param_ty` itself
// when it is not a union or no single variant has the argument's type.
filled_variant :: fn(arg_ty: Type, param_ty: Type) -> Type {
    if param_ty !is UnionType || arg_ty is UnionType {
        return param_ty
    }
    for v in param_ty.variants {
        if equals_type(v, arg_ty) {
            return v
        }
    }
    return param_ty
}

// Why parameter `i` grants mutation : its `!`, `@c_out`, or a type parameter this call
// binds to a type granting it — a mark the declaration does not carry.
mutable_param_detail :: fn(
    c: AST.CallExpr, callee_ty: FnType, i: usize, typed: TypedProgram,
) -> string {
    declared :: "the parameter is declared `!` — the callee may mutate it"
    param :: param_for_arg(c, i, typed) ?? return declared
    if AST.decorators_have(param.decorators, "c_out") {
        return "the parameter is `@c_out` — C writes through it"
    }
    deduced :: deduced_mutation_why(param, typed)
    if deduced != null {
        return deduced
    }
    if AST.param_is_mutable(param) {
        return declared
    }
    return "`${param.name}` takes `${display_type(callee_ty.params[i])}` : this call " +
        "binds its type parameter to a type granting mutation"
}
