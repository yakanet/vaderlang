// vader/typecheck/match_expr — MatchExpr inference (MVP).
//
// `match scrutinee { p1 -> b1, p2 -> b2 }` types as `union_of(arm bodies)`.
// Out of scope: exhaustiveness check (T3013), per-arm scrutinee
// narrowing (the header alias `match e as x` typing `x` per arm) — both
// land with `narrow.vader`. Guards must be `bool` (T3019).

module "vader/typecheck"

import "vader/diagnostics"
import "vader/types"
AST :: import "toolchain/ast"

// Type-check the literal / range bound expressions embedded directly in a
// pattern. Literal and range patterns carry scalar exprs (`value`, or
// `lower`/`upper`) that must be checked so they land in `expr_types` ; every
// other pattern kind carries none. Called on the arm pattern and on each
// or-pattern alternative. NOTE : bounds are checked in isolation (`null`
// expected), so a bound whose type mismatches the scrutinee is not yet rejected
// — see TODO "range/literal pattern bound typing".
check_pattern_bound_exprs :: fn(
    pat: AST.Pattern!,
    typed: TypedProgram!,
    diags: Diagnostic[]!,
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> void {
    if pat is AST.LiteralPattern {
        _ :: check_expr_fn(pat.value, null, typed, diags)
    }
    if pat is AST.RangePattern {
        _ :: check_expr_fn(pat.lower, null, typed, diags)
        _ :: check_expr_fn(pat.upper, null, typed, diags)
    }
}

/// Type-check a `MatchExpr`. `expected` flows into every arm body so
/// `let x: i32 = match v { is Foo -> 1, is Bar -> 2 }` narrows each
/// arm to i32.
/// Span of a match pattern, whichever variant it is.
///
/// Written out rather than reaching for `p.span` on the bare union: a common
/// field reads at a FIXED offset, so the shorthand is only sound while every
/// variant agrees on it, and nothing checks that.
pattern_span :: fn(p: AST.Pattern) -> Span = match p {
    is AST.IsPattern          -> p.span
    is AST.StructPattern      -> p.span
    is AST.WildcardPattern    -> p.span
    is AST.EnumVariantPattern -> p.span
    is AST.LiteralPattern     -> p.span
    is AST.RangePattern       -> p.span
    is AST.OrPattern          -> p.span
}

export infer_match :: fn(
    e: AST.MatchExpr!,
    expected: Type | null,
    typed: TypedProgram!,
    diags: Diagnostic[]!,
    ctx: FnContext! | null,
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> Type {
    raw_scrut :: check_expr_fn(e.scrutinee, null, typed, diags)
    scrut_ty :: lift_enum_placeholder(raw_scrut, typed)
    // `match e as x { … }` : the alias IS the narrowing slot, so an EXPRESSION
    // scrutinee narrows exactly like a named one — which is the whole point of the
    // form. The resolver minted the binding at the `x` token and registered it in
    // `idents`, so the symbol is reachable from the MatchExpr alone. The
    // field-narrow key is empty for an alias : a binding is a slot, not a chain.
    scrut :: e.scrutinee
    alias :: e.bind_as
    alias_sym :: if alias != null { typed.resolved.idents[alias.span.hash()] } else { null }
    if alias != null && alias_sym is Symbol {
        typed.local_types[alias.span.hash()] = scrut_ty
        // Same hop as `is T as x` : the binding inherits the scrutinee's
        // mutability, so a rejected write through it points at the scrutinee.
        typed.narrow.binding_scrutinee[alias.span.hash()] = scrut
    }
    scrut_sym_id    :: if alias_sym is Symbol as a { a.id } else { scrutinee_sym_id(scrut, typed) }
    scrut_field_key :: if alias_sym is Symbol { "" } else { scrutinee_field_key(scrut, typed) }
    arm_types: Type[]!: []
    remaining := scrut_ty
    has_wildcard := false
    covered_enum_variants: string[]!: []
    for arm in e.arms {
        // W0014 — nothing is left for this arm to match: a wildcard, or arms
        // that together consumed the scrutinee, came before it. T3013 asks the
        // opposite question (is a variant MISSING) and T3040 compares against
        // the scrutinee's static type, so neither sees a variant covered twice.
        //
        // Unions and enums only, the same domain W0005 takes. A non-union
        // scrutinee REQUIRES a wildcard (T3013 says so in as many words), and an
        // `is P` over it subtracts the whole of `P` here — so on those this
        // would flag the arm T3013 just demanded.
        closed_scrutinee :: scrut_ty is UnionType || scrut_ty is EnumType
        if closed_scrutinee && (has_wildcard || remaining is NeverType) {
            diags.push(
                warning(
                    .UnreachableMatchArm,
                    pattern_span(arm.pattern),
                    "every value of `${display_type(scrut_ty)}` is already matched above",
                ),
            )
        }
        check_pattern_bound_exprs(arm.pattern, typed, diags, check_expr_fn)
        if arm.pattern is AST.OrPattern as op {
            for sub in op.patterns {
                check_pattern_bound_exprs(sub, typed, diags, check_expr_fn)
            }
        }
        // Re-bind the pattern types against the narrowed `remaining`
        // so the wildcard arm sees only the still-possible
        // variants ("union − matched").
        bind_pattern_types(arm.pattern, remaining, typed, diags, check_expr_fn)
        // Per-arm narrowing — `is T` arms see just T, the wildcard
        // arm sees `remaining` (subset of `scrut_ty` after
        // earlier arms removed their matched variants).
        arm_narrow :: arm_narrow_for(arm.pattern, remaining, typed)
        prev_arm: NarrowSlot | null = null
        if scrut_sym_id != -1 {
            if arm_narrow !is null {
                prev_arm = push_narrow(typed, scrut_sym_id, arm_narrow)
            }
        }
        prev_field: NarrowSlot | null = null
        if scrut_field_key != "" {
            if arm_narrow !is null {
                prev_field = push_field_narrow(typed, scrut_field_key, arm_narrow)
            }
        }
        if arm.guard !is null {
            got :: check_expr_fn(arm.guard, TY_BOOL, typed, diags)
            if !is_assignable(got, TY_BOOL) {
                diags.push(
                    typecheck_error(
                        .ConditionMustBeBool,
                        arm.guard.span,
                        "match-arm guard must be `bool`, got ${display_type(got)}",
                    ),
                )
            }
        }
        arm_types.push(check_expr_fn(arm.body, expected, typed, diags))
        if scrut_sym_id != -1 {
            if arm_narrow !is null {
                pop_narrow(typed, scrut_sym_id, prev_arm)
            }
        }
        if scrut_field_key != "" {
            if arm_narrow !is null {
                pop_field_narrow(typed, scrut_field_key, prev_field)
            }
        }
        // Subtract the matched type from `remaining` for subsequent
        // arms — `is T`, wildcard/binding, and tuple shapes consume
        // their corresponding union variants.
        // A guarded arm (`is T if cond ->`, `_ if cond ->`) matches only
        // when its guard holds at runtime, so it contributes NOTHING to
        // coverage : no variant subtraction, no covered-variant record, no
        // wildcard. Counting it would silence T3013 on a match that can
        // still fall through. (The overlap check on `is T` stays — a guard
        // cannot make a type-impossible test reachable.) A literal field in the
        // pattern (`is P { x: 10 }`) is a guard written inline, and counts the same.
        guarded :: arm.guard != null || is_constrained(arm.pattern)
        match arm.pattern as pattern {
            is AST.IsPattern          -> {
                matched :: pattern_type_of(pattern.ty, remaining, typed, scratch_diags())
                reject_shared_instance_is_test(matched, pattern.span, diags)
                if is_overlap_checkable(scrut_ty) && is_overlap_checkable(matched) {
                    if !types_overlap(scrut_ty, matched) {
                        diags.push(
                            typecheck_error(
                                .UnreachableIsTest,
                                pattern.span,
                                "`${display_type(matched)}` is never a value of `${display_type(scrut_ty)}`",
                            ),
                        )
                    }
                }
                if !guarded {
                    // Subtracting a type already gone leaves `remaining` equal:
                    // the arm restates a test an earlier one made.
                    //
                    // Gated on the test being possible at all. `is null` against
                    // `Cat | Dog` also subtracts nothing, but nothing covered it
                    // earlier either — it can never match, which is T3040's
                    // question, not this one. Reporting it here would say "an
                    // earlier arm covers it" of a variant no arm can hold.
                    narrowed :: subtract_type_with_impls(remaining, matched, typed)
                    covers_something :: is_overlap_checkable(scrut_ty)
                        && is_overlap_checkable(matched)
                        && types_overlap(scrut_ty, matched)
                    if covers_something && display_type(narrowed) == display_type(remaining)
                        && remaining !is NeverType {
                        diags.push(
                            warning(
                                .UnreachableMatchArm,
                                pattern.span,
                                "`${display_type(matched)}` is matched by an earlier arm",
                            ),
                        )
                    }
                    remaining = narrowed
                }
            }
            is AST.EnumVariantPattern -> {
                // A variant in a PATTERN is checked exactly as one in an
                // expression is (`expr_dot_variant`, same T3027): an arm naming
                // a variant that does not exist would otherwise type-check,
                // match nothing, and count itself as covering one. Only a
                // directly enum-typed scrutinee is judged; anything wider stays
                // silent rather than risk a false positive.
                if scrut_ty is EnumType {
                    if scrut_ty.indices[pattern.variant] is null {
                        diags.push(typecheck_error(.UnknownEnumVariant, pattern.span,
                            "`${pattern.variant}` is not a variant of ${display_type(scrut_ty)}"))
                    }
                }
                if !guarded {
                    if covered_enum_variants.contains(pattern.variant) {
                        diags.push(
                            warning(
                                .UnreachableMatchArm,
                                pattern.span,
                                "`.${pattern.variant}` is matched by an earlier arm",
                            ),
                        )
                    }
                    covered_enum_variants.push(pattern.variant)
                }
            }
            is AST.WildcardPattern    -> {
                if !guarded {
                    has_wildcard = true
                    remaining = TY_NEVER
                }
            }
            is AST.OrPattern          -> {
                for sub in pattern.patterns {
                    if sub is AST.IsPattern {
                        tested :: pattern_type_of(sub.ty, remaining, typed, scratch_diags())
                        reject_shared_instance_is_test(tested, sub.span, diags)
                    }
                }
                // Each alternative consumes its own variant — enum variants add
                // to the covered set, `is T` alternatives subtract their type.
                // Literal alternatives exhaust nothing (open domain).
                if !guarded {
                    for sub in pattern.patterns {
                        if sub is AST.EnumVariantPattern {
                            covered_enum_variants.push(sub.variant)
                        }
                        if sub is AST.IsPattern && !is_constrained(sub) {
                            remaining = subtract_type_with_impls(
                                remaining,
                                pattern_type_of(sub.ty, remaining, typed, scratch_diags()),
                                typed,
                            )
                        }
                    }
                }
            }
            _                         -> {}
        }
    }
    // T3013 — non-exhaustive match. `@partial` / `@unreachable` opt out
    // (the latter asserts the uncovered variants trap rather than degrade).
    if !has_wildcard && !e.partial && !e.unreachable && e.arms.len() > 0 {
        if scrut_ty is UnionType {
            if !is_never(remaining) {
                diags.push(
                    typecheck_error(
                        .NonExhaustiveMatch,
                        e.span,
                        "variant ${display_type(remaining)} of ${display_type(scrut_ty)} is not covered",
                    ),
                )
            }
        } else if scrut_ty is EnumType {
            missing_variant :: missing_enum_variant_name(scrut_ty, typed, covered_enum_variants)
            if missing_variant != "" {
                diags.push(
                    typecheck_error(
                        .NonExhaustiveMatch,
                        e.span,
                        "variant .${missing_variant} of ${display_type(scrut_ty)} is not covered",
                    ),
                )
            }
        } else if scrut_ty is UnresolvedType {
            // skip — upstream error already surfaced.
        } else {
            diags.push(
                typecheck_error(
                    .NonExhaustiveMatch,
                    e.span,
                    "match on non-union ${display_type(scrut_ty)} requires a wildcard arm",
                ),
            )
        }
    }
    // W0005 — a wildcard arm on a closed union silences the T3013 check above,
    // so a newly added variant degrades silently into `_` instead of erroring
    // (a silent mis-compile). Any match that CONTRIBUTES A VALUE
    // must enumerate every variant or opt out with `@partial`. This includes the
    // `return`-per-arm form (every arm diverges → result_ty is `never`), which is
    // the dominant compiler style and the one that hid the `type_base_name` /
    // `bc_type_of` footguns — so `never` is NOT exempt. Only a genuine void
    // statement match (`_ -> {}`, side-effects only) and open scrutinees
    // (i32 / string / …) stay out of scope.
    result_ty :: union_of(arm_types)
    // Same rule as the `if` join : only when nothing pins the result.
    if expected == null {
        report_mixed_mutability(result_ty, e.span, diags)
    }
    // `has_wildcard` is only set by a wildcard arm, so it already
    // implies ≥ 1 arm — no explicit arm-count guard needed.
    if has_wildcard && !e.partial && !e.unreachable && !is_void(result_ty) {
        if scrut_ty is UnionType || scrut_ty is EnumType {
            diags.push(
                warning(
                    .WildcardOnClosedUnion,
                    e.span,
                    "wildcard arm on closed union `${display_type(scrut_ty)}` — enumerate its variants or mark the match `@partial`",
                ),
            )
        }
    }
    return result_ty
}

// First enum variant name absent from `covered`. Uses the EnumType's
// `indices` map (populated at declare-time) so we don't need to walk
// the program AST a second time.
missing_enum_variant_name :: fn(
    en: EnumType,
    typed: TypedProgram,
    covered: string[],
) -> string {
    for [name, _] in en.indices {
        found := false
        for c in covered {
            if c == name {
                found = true
                break
            }
        }
        if !found {
            return name
        }
    }
    return ""
}

is_never :: fn(t: Type) -> bool {
    if t is NeverType {
        return true
    }
    return false
}

// The type an `is T` pattern denotes, carrying the immutability of the
// scrutinee it is tested against.
//
// A pattern writes a bare type NAME, which has no mutability of its own — taken
// verbatim it costs twice over: the arm would see a MUTABLE `Cfg` where the
// scrutinee holds a read-only borrow (laundering it), and `subtract_type` would
// no longer recognise the variant it just matched, so `remaining` would stop
// shrinking and exhaustiveness (T3013) would misfire. Mirrors the `is` operator
// in `expr_if.vader`.
// `diags` is the sink `type_from_expr` writes into. Three of the four callers pass
// a throwaway one because they RE-DERIVE a pattern already lowered elsewhere, and a
// real sink there would report the same type four times ; only `bind_pattern_types`,
// which walks each pattern once, passes the caller's. Before it did, every
// diagnostic raised while lowering an arm pattern was dropped on the floor — an
// `is Alias.Nope` compiled clean and took a branch under the VM that native never
// takes.
pattern_type_of :: fn(ty: AST.Expr, scrut: Type, typed: TypedProgram, diags: Diagnostic[]!) -> Type {
    narrowed :: type_from_expr(ty, typed.resolved, diags)
    if !(narrowed is ArrayType | StructType | TupleType | UnionType) { return narrowed }
    return with_immutable(narrowed, narrowing_immutability(scrut, narrowed))
}

arm_narrow_for :: fn(p: AST.Pattern, remaining: Type, typed: TypedProgram) -> Type | null {
    // Only `is T` / wildcard arms narrow the scrutinee; literal / range /
    // enum-variant / struct / or patterns carry no slot narrowing.
    match p {
        is AST.IsPattern -> { return pattern_type_of(p.ty, remaining, typed, scratch_diags()) }
        is AST.WildcardPattern -> { return remaining }
        is AST.StructPattern | AST.EnumVariantPattern | AST.LiteralPattern | AST.RangePattern | AST.OrPattern -> { return null }
    }
}

is_overlap_checkable :: fn(t: Type) -> bool {
    // @partial: overlap is undecidable only for the four open / abstract
    // variants below; every concrete variant has a checkable value domain.
    @partial match t {
        is UnresolvedType -> { return false }
        is TypeParamType  -> { return false }
        is TypeMetaType   -> { return false }
        is TraitType      -> { return false }
        _                 -> { return true }
    }
}

scrutinee_sym_id :: fn(scrut: AST.Expr, typed: TypedProgram) -> i32 {
    if scrut !is AST.IdentExpr {
        return -1
    }
    sym :: typed.resolved.idents[scrut.span.hash()] ?? return -1
    return sym.id
}

/// Build the `${root_sym.id}#path` field-narrow key when the
/// scrutinee is a `recv.f1.f2.…` chain rooted at an `IdentExpr`.
/// Returns `""` (no narrowing slot) for other scrutinee shapes.
scrutinee_field_key :: fn(scrut: AST.Expr, typed: TypedProgram) -> string {
    if scrut !is AST.FieldExpr {
        return ""
    }
    return field_chain_key(scrut, typed)
}

/// Walk a match-arm pattern and record each binding's type in
/// `typed.local_types`. Struct patterns bind through `bind_struct_pattern`.
bind_pattern_types :: fn(
    p: AST.Pattern, scrut: Type, typed: TypedProgram!, diags: Diagnostic[]!,
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> void {
    match p {
        is AST.IsPattern      -> {
            narrowed :: pattern_type_of(p.ty, scrut, typed, diags)
            // Nested pattern (e.g. `is T { x, y }`) — recurse
            // with the narrowed type so inner StructPattern bindings
            // pick up T's field types.
            if p.inner !is null {
                bind_pattern_types(p.inner, narrowed, typed, diags, check_expr_fn)
            }
        }
        is AST.StructPattern -> { bind_struct_pattern(p, scrut, typed, diags, check_expr_fn) }
        is AST.OrPattern     -> {
            for sub in p.patterns {
                bind_pattern_types(sub, scrut, typed, diags, check_expr_fn)
            }
        }
        _                           -> {}
    }
}

// Each field of `{ name, x: 10 }` names a field of the struct: a binding takes
// its type, a literal is checked against it (the lowering compares the two).
bind_struct_pattern :: fn(
    sp: AST.StructPattern,
    scrut: Type,
    typed: TypedProgram!,
    diags: Diagnostic[]!,
    check_expr_fn: fn(AST.Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> void {
    st :: struct_backing(scrut)
    if st == null {
        if scrut !is UnresolvedType {
            diags.push(typecheck_error(
                .TypeMismatch, sp.span,
                "a `{ … }` pattern reads the fields of a struct, got `${display_type(scrut)}`"))
        }
        return
    }
    decl :: typed.struct_decls[st.symbol.id] ?? return
    for field in sp.fields {
        // T3054 : reject binding an `@internal` field in a struct
        // pattern from outside its declaring module.
        check_internal_field(st, decl, field.name, field.name_span, typed, diags)
        raw :: resolved_field_type(st.symbol.id, decl, field.name, typed, scratch_diags())
        if raw == null {
            diags.push(typecheck_error(
                .FieldDoesNotExist, field.name_span,
                "`${field.name}` on ${display_type(scrut)}"))
            continue
        }
        // `Box<i32> { value }` reads `value` as `i32`, not as the declared `T`.
        ft :: substitute_struct_field(raw, decl, st)
        match field.value as value {
            is AST.PatternBinding -> { typed.local_types[value.span.hash()] = ft }
            is AST.PatternLiteral -> {
                got :: check_expr_fn(value.value, ft, typed, diags)
                if !is_assignable(got, ft) {
                    diags.push(mismatch_diagnostic(got, ft, value.value.span, .TypeMismatch))
                }
            }
        }
    }
}

scratch_diags :: fn() -> Diagnostic[]! { return [] }

// Whether an `is T { … }` pattern tests a field against a literal — it then
// matches only some values of `T`.
is_constrained :: fn(p: AST.Pattern) -> bool {
    if p !is AST.IsPattern {
        return false
    }
    if p.inner is AST.StructPattern {
        for field in p.inner.fields {
            if field.value is AST.PatternLiteral {
                return true
            }
        }
    }
    return false
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "vader/parser"
import "vader/resolver"
import "vader/resolver/symbol"
import "toolchain/span"

match_expr_check_stub :: fn(
    e: AST.Expr!,
    expected: Type | null,
    typed: TypedProgram!,
    diags: Diagnostic[]!,
) -> Type {
    // @partial: test stub — only the literal / ident / match expr kinds the
    // match tests build are typed; every other Expr is irrelevant → unresolved.
    @partial match e {
        is AST.IntLitExpr    -> { return narrow_for_expected(TY_FREE_INT, expected) }
        is AST.BoolLitExpr   -> { return TY_BOOL }
        is AST.StringLitExpr -> { return TY_STRING }
        is AST.IdentExpr     -> { return infer_ident(e, typed) }
        is AST.MatchExpr     -> { return infer_match(
            e,
            expected,
            typed,
            diags,
            null,
            match_expr_check_stub,
        ) }
        _                    -> { return TY_UNRESOLVED }
    }
}

accept_match :: fn(e: AST.Expr) -> AST.Expr | null {
    if e is AST.MatchExpr {
        return e
    }
    return null
}

ExpectedMatch :: struct {
    typed: TypedProgram
    m: AST.MatchExpr
}

expect_match :: fn(src: string) -> ExpectedMatch {
    parsed :: parse_source(src, "t.vader")
    factory :: SymbolFactory {}
    rm :: resolve_module(parsed.program, "t", factory)
    diags: Diagnostic[]!: []
    result :: check_module(parsed.program, rm, factory, diags)
    last :: parsed.program.decls[parsed.program.decls.len() - 1]
    match last {
        is AST.FnDecl -> {
            match last.body as b {
                is null          -> {}
                is AST.BlockExpr -> {
                    hit :: find_first_in_block(b, accept_match)
                    if hit is AST.MatchExpr { return ExpectedMatch {
                        .typed = result.typed,
                        .m = hit,
                    } }
                }
            }
        }
        _                  -> {}
    }
    assert(false, "expected a MatchExpr in: ${src}")
    return ExpectedMatch { .typed = result.typed, .m = synthetic_match() }
}

synthetic_match :: fn() -> AST.MatchExpr {
    sp :: empty_span()
    scrut: AST.Expr: AST.IntLitExpr {
        .span = sp,
        .id = AST.UNASSIGNED_NODE_ID,
        .value = 0,
    }
    return AST.MatchExpr {
        .span = sp,
        .id = AST.UNASSIGNED_NODE_ID,
        .scrutinee = scrut,
        .arms = [],
        .partial = false,
    }
}

@test
test_match_single_arm_returns_arm_type :: fn() -> void {
    src :: "f :: fn(x: i32) -> i32 { return match x { _ -> 42 } }"
    em :: expect_match(src)
    diags: Diagnostic[]!: []
    assert_eq(
        display_type(infer_match(em.m, null, em.typed, diags, null, match_expr_check_stub)),
        "{integer}",
    )
}

@test
test_match_two_arms_unions :: fn() -> void {
    src :: "f :: fn(x: i32) -> string | i32 { return match x { 0 -> \"zero\", _ -> 1 } }"
    em :: expect_match(src)
    diags: Diagnostic[]!: []
    ty :: infer_match(em.m, null, em.typed, diags, null, match_expr_check_stub)
    // union_of sorts by display (`s` < `{`), so `string | {integer}`.
    assert_eq(display_type(ty), "string | {integer}")
}

@test
test_match_guard_non_bool_emits_T3019 :: fn() -> void {
    src :: "f :: fn(x: i32) -> i32 { return match x { _ if 1 -> 0, _ -> 1 } }"
    em :: expect_match(src)
    diags: Diagnostic[]!: []
    infer_match(em.m, null, em.typed, diags, null, match_expr_check_stub)
    found := false
    for d in diags {
        if d.code.id == "T3019" {
            found = true
        }
    }
    assert(found, "expected T3019 on non-bool guard")
}
