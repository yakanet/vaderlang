// vader/typecheck/orchestrate — full-pipeline typecheck.
//
// Adds body-walking on top of `check.vader::check_module` so CLI / dump
// callers get a fully-typed program in one call.
//
// Also exposes `check_project_with_bodies` which takes a
// `LoadedProject` (multi-module) and propagates wire + cross-module
// type info into the entry module's `TypedProgram`.

module "vader/typecheck"

import "std/collections"
import "std/iter"
import "std/string"
AST :: import "toolchain/ast"
import "toolchain/span"
import "vader/diagnostics"
import "vader/resolver"
import "vader/resolver/symbol"
import "vader/target"
import "vader/types"

// Concatenate every file of a (possibly multi-file) module into one
// synthetic Program so the resolver body-walks ALL files, not just
// files[0].
// `Span.hash()` is file-aware, so idents from sibling files at the same
// (line, column) no longer collide in the merged per-module map.
merge_module_program :: fn(files: SourceFile[]) -> AST.Program {
    first :: files[0].program
    if files.len() == 1 {
        return first
    }
    return AST.Program { ...first, .decls = concat_file_decls(files) }
}

/// Multi-module typecheck. Types the entry module fully, then
/// types each directly-imported module *just enough* to harvest
/// its top-level decl types (for cross-module ident lookup). Wires
/// imports across the project and patches the entry's
/// `import_targets` + `external_types`.
/// `dump_types` populates the dump-only `expr_kinds` / `node_spans` side-tables
/// (set only by `check_file` for `dump --stage=typed-ast`) ; build / run /
/// bootstrap / LSP pass `false`, since nothing reads those tables there.
export check_project_with_bodies :: fn(
    project: LoadedProject,
    diags: Diagnostic[],
    dump_types: bool,
) -> CheckResult {
    // Build the core_symbols seed once — every per-module resolve gets the same map so
    // the body-walker can fire R2006 unconditionally on unresolved idents instead of
    // deferring to typecheck.
    core_seed :: build_core_seed(project)
    mod_index :: module_index_by_name(project)
    // Phase A0 : materialise single-abstract-method sugar (`Type implements Trait ->
    // expr`) project-wide so the resolver walks bodies with `self` / `other` / …
    // properly bound. It reports into `project.diags`.
    materialize_all_sams_pre_resolve(project, mod_index, core_seed)
    result :: check_project_modules(project, diags, dump_types, core_seed, mod_index)
    propagate_type_param_observation(result.all_modules)
    return result
}

// Resolve and type every module of `project`, bodies included.
check_project_modules :: fn(
    project: LoadedProject,
    diags: Diagnostic[],
    dump_types: bool,
    core_seed: MutableMap<string, Symbol>,
    mod_index: MutableMap<string, LoadedModule>,
) -> CheckResult {
    entry_loaded :: project.modules[project.entry]
    if entry_loaded is null {
        return CheckResult {
            .typed = empty_fallback(project),
            .impls = empty_impls(),
            .others = [],
            .all_modules = MutableMap<string, TypedProgram> {},
        }
    }
    entry_rm :: resolve_module_files(
        entry_loaded.module.files,
        project.entry,
        entry_loaded.module.display_path,
        project.factory,
        entry_loaded.collected,
        mod_index,
        core_seed,
    )
    // One set of impl tables for the whole project (`register_project_impls`), and
    // one alias table: symbol ids are project-wide, and every module expands an
    // alias as its owner registered it.
    impl_tables :: ImplTables {}
    alias_types :: MutableMap<i32, Type> {}
    alias_params :: MutableMap<i32, TypeParamType[]> {}
    entry_typed :: new_typed_program(entry_rm)
    entry_typed.dump_types = dump_types
    entry_typed.impl_tables = impl_tables
    entry_rm.alias_types = alias_types
    entry_rm.alias_params = alias_params
    // Pre-resolve every module first so we can register all type
    // aliases project-wide before any fn signature is lowered.
    per_module :: MutableMap<string, TypedProgram> {}
    per_module[project.entry] = entry_typed
    for [id, other] in project.modules {
        if id == project.entry {
            continue
        }
        rm :: resolve_module_files(
            other.module.files,
            id,
            other.module.display_path,
            project.factory,
            other.collected,
            mod_index,
            core_seed,
        )
        rm.alias_types = alias_types
        rm.alias_params = alias_params
        typed :: new_typed_program(rm)
        typed.dump_types = dump_types
        typed.impl_tables = impl_tables
        per_module[id] = typed
    }
    // Phase A : register every type alias project-wide. Cross-
    // module aliases (`Pet` imported from `./types`) need to land
    // before any fn signature consults them.
    unsettled :: MutableMap<string, AST.Decl[]> {}
    unsettled[project.entry] = register_aliases(
        entry_typed, merge_module_program(entry_loaded.module.files).decls,
    )
    for [id, other] in project.modules {
        if id == project.entry {
            continue
        }
        other_typed :: per_module[id]
        if other_typed !is null {
            decls :: merge_module_program(other.module.files).decls
            unsettled[id] = register_aliases(other_typed, decls)
        }
    }
    _ :: settle_project_aliases(per_module, unsettled)
    // Make every module's enums resolvable cross-module before any fn
    // signature is lowered — so a `d: parser.Visibility` param resolves to
    // the `EnumType` (→ `repr` ordinal at bytecode emit) instead of the
    // struct placeholder.
    register_enum_types(per_module, project, alias_types)
    // Wire imports + resolver-side imports_to early so cross-module
    // alias lookups (`Pet` from `./types`) follow ImportBinding to
    // the real symbol during fn-signature lowering below.
    wire_targets :: wire_imports(project)
    imports_to :: resolver_imports(wire_targets)
    for [_, typed] in per_module {
        typed.import_targets = wire_targets
        typed.resolved.imports_to = imports_to
    }
    // R2018 orphan-rule pre-resolve check (project-level — needs the
    // wire_imports redirect table to resolve ImportBinding to the
    // concrete owner). Diagnostics fold into each module's resolved
    // diags bucket so the CLI / typecheck dumpers surface them in
    // their usual place.
    run_orphan_rule_check_for_module(
        entry_loaded,
        project.entry,
        entry_rm.idents,
        wire_targets,
        entry_rm.diags,
    )
    for [id, other] in project.modules {
        if id == project.entry {
            continue
        }
        other_typed :: per_module[id]
        if other_typed !is null {
            run_orphan_rule_check_for_module(
                other,
                id,
                other_typed.resolved.idents,
                wire_targets,
                other_typed.resolved.diags,
            )
        }
    }
    // Pre-populate every module's `namespace_member_types` so `type_from_expr`'s
    // FieldExpr arm can resolve `P.Decl` in fn-signature type positions (which run
    // during `declare_module` below, before `populate_external_types` builds
    // `namespace_exports`), and settle the aliases that name such a member.
    settle_namespace_member_aliases(project, wire_targets, per_module, unsettled)
    // Phase B : declare every decl (fn signatures, struct types, etc.)
    // across ALL files of the module. decl_types is Symbol.id-keyed and
    // the span-keyed tables (param_types / type_expr_types) are now
    // file-aware, so merging sibling files no longer collides — fn
    // signatures in non-first files get declared too (was the source of
    // `?` types on multi-file modules).
    declare_module(
        merge_module_program(entry_loaded.module.files).decls,
        entry_rm,
        entry_typed,
        diags,
    )
    // Declare every imported module too: the whole-program lowerer lowers imported
    // bodies, so a signature whose param/return is a namespace-qualified imported
    // type (`d: p.TraitDecl`) must resolve here, from the member tables filled
    // above; otherwise the param degrades to `?` (→ field-gets drop to
    // `Drop;Return` in emit).
    for [id, other] in project.modules {
        if id == project.entry {
            continue
        }
        other_typed :: per_module[id] ?? continue
        declare_module(
            merge_module_program(other.module.files).decls,
            other_typed.resolved,
            other_typed,
            diags,
        )
    }
    // Cross-module struct visibility — see `broadcast_struct_decls`.
    broadcast_struct_decls(per_module)
    share_type_param_symbols(per_module)
    // Wire was done before declare ; now populate the remaining
    // typecheck-side tables that depend on per-module decl types.
    // Settle expression-bodied fn returns in every non-entry module
    // BEFORE copying their FnTypes into the entry's external_types /
    // imported_fn_overloads — otherwise a `fn(a, b) = if … { a } …`
    // export lands as `fn(_, _) -> ?` in the bucket.
    populate_core_symbols(entry_typed, project, per_module)
    // Cross-publish trait_decls (Iterator, Display, …) to every
    // per_module typed program BEFORE settle walks their bodies — so a
    // trait's default method called in another module's body is found
    // via `try_default_trait_method`.
    cross_publish_trait_decls(per_module)
    cross_publish_fn_decls(per_module)
    broadcast_type_param_bounds(per_module, project)
    // Index every module's typed program by its declared module name, so the
    // import-respecting overload population (D-a) can resolve each module's
    // `import "..."` paths to the imported module's typed program.
    typed_by_name :: MutableMap<string, TypedProgram> {}
    for [id, lm] in project.modules {
        t :: per_module[id]
        if t != null {
            typed_by_name[lm.module.module_name] = t
        }
    }
    // Populate `imported_fn_overloads` for every NON-ENTRY module BEFORE
    // `settle_external_expr_bodied_returns` walks their bodies — otherwise
    // UFCS dispatch inside an external expr-bodied fn (e.g. `s.chars()
    // .count()` inside std/string::len) doesn't see cross-module overloads.
    // The entry's overload table is populated AFTER settle so it picks up
    // the resolved return types of expr-bodied externals.
    for [id, lm] in project.modules {
        if id == project.entry {
            continue
        }
        other_typed :: per_module[id]
        if other_typed != null {
            populate_imported_fn_overloads(other_typed, lm.collected.files, typed_by_name)
        }
    }
    register_project_impls(project, per_module)
    settle_external_expr_bodied_returns(project, per_module)
    populate_external_types(entry_typed, project, per_module)
    populate_imported_fn_overloads(entry_typed, entry_loaded.collected.files, typed_by_name)
    pull_field_external_types(entry_typed, per_module)
    // Coherence : at most one impl per (concrete type, trait, trait-args) across
    // the whole program — the prelude's `i32 implements Display` etc. are in
    // scope everywhere, so a user re-impl is a conflict (R2030), not a silent
    // shadow. Mirrors Rust's E0119. (Blanket / generic-receiver overlap is
    // deferred — only fully-concrete receivers are checked.)
    check_impl_coherence(project, per_module, diags)
    // No two functions in a module may share name + signature (a redefinition).
    check_fn_redefinitions(project, per_module, diags)
    // Direction A : register each `generator`'s synthetic `<fn>$State implements
    // Iterator<U>` in the shared impl tables, before the full body walks: a chained
    // combinator's receiver is the prior combinator's concrete `__genstate_<fn>`
    // result, and typing its `self: Iterator<T>` param needs the struct→trait
    // widening this registers. Cross-module (imported std/iter combinators)
    // resolves each generator's element via its owner module.
    register_generator_iter_impls(per_module, impl_tables)
    // Two-pass body walk : first pass infers expression-bodied fn
    // return types (forward-reference safe) ; second pass re-types
    // bodies with all returns settled. Diags are captured only on
    // the second pass — the first one is a throwaway sink.
    if has_expr_bodied_fn(merge_module_program(entry_loaded.module.files).decls) {
        walk_bodies(
            merge_module_program(entry_loaded.module.files).decls,
            entry_typed,
            diag_sink(),
            .ReturnsOnly,
        )
        reset_expr_tables(entry_typed)
    }
    walk_bodies(merge_module_program(entry_loaded.module.files).decls, entry_typed, diags, .Full)
    // W0007 dead-code lint : private top-level decls never reached from the
    // module's public surface. Entry-module-only, so it lints the
    // module being compiled. Name-based reachability — see dead_code.vader.
    check_dead_code(merge_module_program(entry_loaded.module.files).decls,
        entry_loaded.module.module_name, diags, entry_loaded.discarded_bodies)
    // Body-check every imported module too, so the lowerer sees the
    // expression types of imported fn bodies. The whole-program lowerer
    // (vader/lower) lowers EVERY module's bodies to emit their bytecode ;
    // without per-module body types, imported bodies degrade — e.g. `m[k]`
    // Index resolution misses (target_type unresolved) and the emitter
    // drops the call. Each import needs its OWN external types wired first
    // (the entry-only setup above doesn't reach them), so we replay the
    // same setup chain parameterised on each module's typed program.
    // Diagnostics route to a throwaway sink : the user-facing surface stays
    // entry-only (the resolver-diag forwarding below is likewise
    // entry-scoped). Imported modules are body-checked here too.
    for [id, other] in project.modules {
        if id == project.entry {
            continue
        }
        other_typed :: per_module[id] ?? continue
        populate_external_types(other_typed, project, per_module)
        // The pre-settle populate (so settle's own UFCS sees cross-module
        // overloads) captured expr-bodied callees' returns while still `?` ;
        // re-populate now that `settle` patched the settled returns into
        // decl_types. `push_overload` is replace-on-signature (idempotent), so it
        // OVERWRITES the stale `fn(i64) -> ?` entry in place rather than leaving it
        // ahead of the settled `fn(i64) -> i64` — no `clear` needed. (That
        // stale-ahead ordering is what `pick_overload` first-matched into `?` →
        // `any` → wide-int compares truncated to `i32.lt`, the `abs` bug.)
        populate_imported_fn_overloads(other_typed, other.collected.files, typed_by_name)
        other_decls :: merge_module_program(other.module.files).decls
        if has_expr_bodied_fn(other_decls) {
            walk_bodies(other_decls, other_typed, diag_sink(), .ReturnsOnly)
            reset_expr_tables(other_typed)
        }
        walk_bodies(other_decls, other_typed, other_typed.resolved.diags, .Full)
        // Imported-module body-check diagnostics are forwarded (not dropped) :
        // library W0005 etc. are real lines to fix, worth surfacing
        // project-wide rather than only in the entry module. Likewise W0007
        // (dead private code) below. Spans point at each module's own file, so
        // the LSP still filters to the open document.
        check_dead_code(other_decls, other.module.module_name, diags, other.discarded_bodies)
    }
    // Once every body is typed : the cycles run through any module.
    reject_growing_recursion(per_module, diags)
    // Forward resolver-side R-codes (unresolved-ident, reserved-name, …)
    // so the CLI's `# Diagnostics` block surfaces them next to T-codes.
    for d in entry_typed.resolved.diags {
        diags.push(d)
    }
    impls :: build_impl_registry(merge_module_program(entry_loaded.module.files).decls, entry_typed.resolved)
    // Every directly-imported non-stdlib module gets its own `## <path>`
    // section in the dump.
    others: TypedProgram[]: collect_direct_imports(entry_loaded, project, per_module)
    return CheckResult {
        .typed = entry_typed,
        .impls = impls,
        .others = others,
        .all_modules = per_module,
    }
}

collect_direct_imports :: fn(
    entry_loaded: LoadedModule,
    project: LoadedProject,
    per_module: MutableMap<string, TypedProgram>,
) -> TypedProgram[] {
    out: TypedProgram[]: []
    // The loader already resolved every import. A module imported as
    // `import "path"` declares `module "path"` (module-system invariant), so
    // map each loaded module's declared name to its id and look the import up
    // there — using the loader's own result instead of re-resolving through the
    // now-deleted parallel resolver (#11).
    // Toolchain-shipped modules are filtered HERE rather than at the lookup: every
    // value of this map is a key of `project.modules`, so a later `?? null` read
    // could not fail and only cost a second lookup per import.
    //
    // Excluded by where a module came FROM, never by a `std/` name prefix: `lib/`
    // hosts every namespace the toolchain ships, so a `json` or `regex` import
    // would drag in modules a prefix test kept out.
    id_by_name :: MutableMap<string, string> {}
    for [id, lm] in project.modules {
        if lm.module.origin == .Toolchain { continue }
        id_by_name[lm.module.module_name] = id
    }
    seen :: MutableMap<string, bool> {}
    for raw in entry_loaded.collected.import_paths {
        target_id :: id_by_name[raw] ?? continue
        if target_id == project.entry { continue }
        if seen[target_id] !is null   { continue }
        seen[target_id] = true
        tp :: per_module[target_id]
        if tp !is null {
            out.push(tp)
        }
    }
    return out
}

empty_impls :: fn() -> ImplRegistry { return ImplRegistry {} }

empty_fallback :: fn(project: LoadedProject) -> TypedProgram {
    loaded :: project.modules[project.entry]
    if loaded == null {
        // Defensive — load_project guarantees entry is loaded.
        return new_typed_program(synth_resolved())
    }
    rm :: resolve_module(loaded.module.files[0].program, project.entry, project.factory)
    return new_typed_program(rm)
}

synth_resolved :: fn() -> ResolvedModule {
    return ResolvedModule {
        .path = "",
        .display_path = "",
        .symbols = [],
        .idents = MutableMap<u64, Symbol> {},
        .immutable_locals = MutableMap<i32, bool> {},
        .fn_overloads = MutableMap<string, Symbol[]> {},
        .declarations = MutableMap<u64, Symbol> {},
        .imports_to = MutableMap<i32, Symbol> {},
        .alias_types = MutableMap<i32, Type> {},
        .alias_params = MutableMap<i32, TypeParamType[]> {},
        .type_param_bounds = MutableMap<i32, AST.Expr> {},
        .diags = [],
        .deprecated_messages = MutableMap<i32, string> {},
        .namespace_member_types = MutableMap<i32, MutableMap<string, Type>> {},
        .namespace_private_members = MutableMap<i32, MutableMap<string, bool>> {},
    }
}

/// For every Symbol id appearing in `import_targets` as a
/// `SymbolTarget`, copy its declared type from the target module's
/// `decl_types` into `entry_typed.external_types`. Lets
/// `infer_ident` resolve a cross-module name to its full type
/// without re-walking the project at lookup time.
populate_external_types :: fn(
    entry_typed: TypedProgram,
    project: LoadedProject,
    per_module: MutableMap<string, TypedProgram>,
) -> void {
    if entry_typed.import_targets !is null {
        populate_from(entry_typed.import_targets, entry_typed, project, per_module)
    }
}

populate_from :: fn(
    targets: ImportTargetTable,
    entry_typed: TypedProgram,
    project: LoadedProject,
    per_module: MutableMap<string, TypedProgram>,
) -> void {
    for [_, st] in targets.symbol_targets {
        external :: lookup_external_type(st, per_module)
        if external !is null {
            entry_typed.external_types[st.symbol.id] = external
        }
    }
    // Namespace targets : for `name :: import "p"`, materialise an
    // `(field_name → Type)` table from `p`'s public exports so
    // `field.vader` can resolve `name.foo` accesses.
    for [_, mod_id] in targets.namespace_targets {
        if entry_typed.namespace_exports[mod_id] is null {
            entry_typed.namespace_exports[mod_id] = build_namespace_exports(
                mod_id,
                project,
                per_module,
            )
        }
        if entry_typed.namespace_export_decls[mod_id] is null {
            entry_typed.namespace_export_decls[mod_id] = build_namespace_export_decls(
                mod_id,
                project,
                per_module,
            )
        }
        publish_namespace_defaults(mod_id, entry_typed, per_module)
    }
}

// `P.f()` fills an omitted argument from `f`'s default as a wildcard call does,
// so the default's resolutions travel the same way (`import_defaults.vader`).
publish_namespace_defaults :: fn(
    mod_id: string, into: TypedProgram, per_module: MutableMap<string, TypedProgram>,
) -> void {
    from :: per_module[mod_id] ?? return
    decls :: into.namespace_export_decls[mod_id] ?? return
    for [_, fd] in decls {
        publish_default_resolutions(from, into, fd)
    }
}

// ---- trait coherence ------------------------------------------------------

// Coherence key for an `impl` : `(receiver type, trait, trait-args)`. Keyed on
// `canonical_key`, so distinct types never collide (it carries struct/enum
// symbol ids and generic args — `Foo<i32>` and `Foo<string>` stay separate) and
// equivalent types always match. Returns null for a blanket / generic receiver
// (`T implements …`, `T[] implements …`) — their overlap rules are subtler than
// concrete-vs-concrete, so they're left unchecked for now.
coherence_key :: fn(for_ty: Type, trait_key: string, args: Type[]) -> string | null {
    if type_contains_type_param(for_ty) {
        return null
    }
    return "${canonical_key(for_ty)}#${trait_key}<${canonical_args_key(args)}>"
}

// Project-wide trait coherence : at most one impl per (concrete type, trait,
// trait-args). Walks every loaded module's `ImplDecl`s (including the `std/core`
// prelude, whose impls are in scope everywhere) into one key→span map and fires
// R2030 on the second impl of a key. Catches a user redefining a prelude impl
// (`i32 implements Display`) — previously a silent, order-dependent shadow that
// could recurse / mis-resolve. Mirror of Rust's E0119 (concrete-receiver subset).
check_impl_coherence :: fn(
    project: LoadedProject,
    per_module: MutableMap<string, TypedProgram>,
    diags: Diagnostic[],
) -> void {
    seen :: MutableMap<string, Span> {}
    by_base :: MutableMap<string, ImplShape[]> {}
    // Register every NON-entry module's impls (the `std/core` prelude + stdlib +
    // deps) first, then the entry module LAST. A user impl that duplicates a
    // prelude/stdlib one is then the *second* seen, so R2030 lands on the user's
    // (entry-module) span — entry diags are surfaced, imported-module diags are
    // filtered by the CLI, so an error on a stdlib span would be invisible.
    for [id, _] in project.modules {
        if id == project.entry {
            continue
        }
        check_module_impl_coherence(id, project, per_module, seen, by_base, diags)
    }
    check_module_impl_coherence(project.entry, project, per_module, seen, by_base, diags)
}

check_module_impl_coherence :: fn(
    id: string,
    project: LoadedProject,
    per_module: MutableMap<string, TypedProgram>,
    seen: MutableMap<string, Span>,
    by_base: MutableMap<string, ImplShape[]>,
    diags: Diagnostic[],
) -> void {
    tp :: per_module[id] ?? return
    loaded :: project.modules[id] ?? return
    for decl in merge_module_program(loaded.module.files).decls {
        if decl is AST.ImplDecl {
            // A trait is told apart by its declaration, not by the name an
            // import gave it ; one that does not resolve is reported elsewhere.
            trait_sym :: impl_trait_symbol(decl, tp.resolved) ?? continue
            trait_key :: trait_key_of(trait_sym)
            for_ty :: type_from_expr(decl.for_type, tp.resolved, diag_sink())
            if has_builtin_impl(for_ty, trait_key) {
                detail :: ("every enum implements `Equals`, comparing by variant : "
                    + "`${display_type(for_ty)}` takes no impl of its own")
                diags.push(resolver_error(.ConflictingImpl, decl.span, detail))
                continue
            }
            args :: written_type_args(decl.trait_args, tp.resolved, diag_sink())
            if reject_overlapping_impl(decl, for_ty, trait_key, args, by_base, diags) {
                continue
            }
            key :: coherence_key(for_ty, trait_key, args) ?? continue
            if seen[key] != null {
                // `ConflictingImpl` is a `ResolverCode` (declaration-level, like
                // the R2018 orphan rule), so it's built with `resolver_error`.
                detail :: conflict_detail(decl, for_ty)
                diags.push(resolver_error(.ConflictingImpl, decl.span, detail))
            } else {
                seen[key] = decl.span
            }
        }
    }
}

// An impl met so far, as the overlap check compares it.
ImplShape :: struct {
    for_ty: Type
    args:   Type[]
    span:   Span
}

// R2030 for two generic impls of one trait on one base type that some instance could
// both match : dispatch could not tell which one it takes. The bounds are not
// compared : nothing proves that no type implements both. An impl on a concrete
// instance (`Wrapper<MonType>`) is not one of them — it wins over the generic impl
// for that instance. A blanket over a bare `T` stays out too — a type's own impl
// wins over it — and so does an array receiver over anything but a bare `T`, which
// T3090 refuses. True when reported ; the impl is recorded otherwise.
reject_overlapping_impl :: fn(
    decl: AST.ImplDecl,
    for_ty: Type,
    trait_key: string,
    args: Type[],
    by_base: MutableMap<string, ImplShape[]>,
    diags: Diagnostic[],
) -> bool {
    if for_ty is TypeParamType {
        return false
    }
    if for_ty is ArrayType && for_ty.element !is TypeParamType {
        return false
    }
    if !type_contains_type_param(for_ty) && !any_contains(args) {
        return false
    }
    bucket :: "${impl_base_key(for_ty)}#${trait_key}"
    shape :: ImplShape { .for_ty = for_ty, .args = args, .span = decl.span }
    seen :: by_base[bucket]
    if seen == null {
        by_base[bucket] = [shape]
        return false
    }
    for other in seen {
        if may_coincide(for_ty, other.for_ty) && may_coincide_each(args, other.args) {
            diags.push(resolver_error(.ConflictingImpl, decl.span,
                "this impl and the one at ${where_of(other.span)} may both cover an " +
                    "instance of `${display_type(for_ty)}` — two generic " +
                    "impls of one trait cannot overlap"))
            return true
        }
    }
    seen.push(shape)
    return false
}

// Whether some instantiation makes `a` and `b` one type : a type parameter stands
// for any type.
may_coincide :: fn(a: Type, b: Type) -> bool {
    if a is TypeParamType || b is TypeParamType {
        return true
    }
    // @partial: the shapes holding other types compare part by part ; any other type
    // coincides only with itself.
    return @partial match a {
        is StructType -> b is StructType && b.symbol.id == a.symbol.id &&
            may_coincide_each(a.args, b.args)
        is TraitType  -> b is TraitType && b.symbol.id == a.symbol.id &&
            may_coincide_each(a.args, b.args)
        is ArrayType  -> b is ArrayType && may_coincide(a.element, b.element)
        is TupleType  -> b is TupleType && may_coincide_each(a.elements, b.elements)
        is FnType     -> b is FnType && may_coincide_each(a.params, b.params) &&
            may_coincide(a.return_type, b.return_type)
        _             -> equals_type(a, b)
    }
}

may_coincide_each :: fn(a: Type[], b: Type[]) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0..<a.len() {
        if !may_coincide(a[i], b[i]) {
            return false
        }
    }
    return true
}

conflict_detail :: fn(decl: AST.ImplDecl, for_ty: Type) -> string {
    if AST.decorators_have(decl.decorators, "displayable") {
        return ("`@displayable` generates the `Display` of `${display_type(for_ty)}`, "
            + "which already implements it")
    }
    return ("`${display_type(for_ty)}` already implements `${decl.trait_name}` — "
        + "only one impl per (type, trait) is allowed")
}

// No two functions in a module may share a name AND signature (resolved param
// types) — that's a redefinition, not an overload. `main` is the special case
// (one possible signature). Sibling files merge into one module, so this also
// catches a `main` per file (the `vader run dir/file.vader` footgun, where the
// directory loads as one module and the first-declared `main` silently wins).
check_fn_redefinitions :: fn(
    project: LoadedProject,
    per_module: MutableMap<string, TypedProgram>,
    diags: Diagnostic[],
) -> void {
    for [id, _] in project.modules {
        check_module_fn_redefinitions(id, project, per_module, diags)
    }
}

check_module_fn_redefinitions :: fn(
    id: string,
    project: LoadedProject,
    per_module: MutableMap<string, TypedProgram>,
    diags: Diagnostic[],
) -> void {
    tp :: per_module[id] ?? return
    loaded :: project.modules[id] ?? return
    // Group fn decls by name (cheap — no type resolution) ; resolve signatures
    // only for names with ≥2 decls. Signatures come from the AST, the
    // authoritative source of declared params, not from `decl_types`.
    by_name :: MutableMap<string, AST.FnDecl[]> {}
    for decl in merge_module_program(loaded.module.files).decls {
        if decl !is AST.FnDecl {
            continue
        }
        group :: by_name[decl.name]
        if group == null {
            by_name[decl.name] = [decl]
        } else {
            group.push(decl)
        }
    }
    // The module's EXPLICITLY-imported free fns — a module fn with the SAME name
    // AND signature as one of them would otherwise silently shadow it
    // (resolver-modules-3, CASE C).
    imported :: imported_fn_sigs(loaded, tp, per_module)
    imported_names :: MutableSet<string> {}
    for sig in imported {
        imported_names.add(sig.local)
    }
    // Signature keys of the module's fns, by name, where there is something to
    // check : ≥2 decls (a possible in-module redefinition) or a same-named import.
    module_keys :: MutableMap<string, MutableMap<string, bool>> {}
    for [name, group] in by_name {
        if group.len() < 2 && !(name in imported_names) {
            continue
        }
        seen :: MutableMap<string, bool> {}
        for fd in group {
            key :: fn_signature_key(fd, tp.resolved) ?? continue
            // A matching canonical signature key is a redefinition, not an overload.
            if seen[key] != null {
                diags.push(
                    typecheck_error(
                        .DuplicateFnDefinition,
                        fd.span,
                        "`${name}` is already defined with the same signature in this module",
                    ),
                )
            } else {
                seen[key] = true
            }
        }
        module_keys[name] = seen
    }
    // Reported on the import : it belongs to one file, the fn to the module.
    for sig in imported {
        keys :: module_keys[sig.local] ?? continue
        if keys[sig.key] != null {
            diags.push(
                typecheck_error(
                    .DuplicateFnDefinition,
                    sig.span,
                    "`${sig.local}` has the same signature as a function of this module",
                ),
            )
        }
    }
}

// An explicitly-imported free fn of a module : the local name its import binds,
// the signature key of its target, and where the import is written.
ImportedFnSig :: struct {
    local: string
    key:   string
    span:  Span
}

// The explicitly-imported free fns of `loaded`, one per import. Reads each
// binding's target FnType from the owning module's `decl_types` — import-scoped,
// NOT the broad `imported_fn_overloads` branch-b scan (which surfaces every
// co-loaded module's fns and would false-positive on ones this module never
// imported). Iterates `collected.imports` (keyed by Symbol id), which holds the
// bindings of every file of the module, and keeps `info.local` (the alias for a
// renamed `foo as bar`), NOT the source name : a wrapper like
// `is_int :: fn(..) = ty_is_int(..)` over `import { is_int as ty_is_int }` must
// NOT be flagged — its local binding is `ty_is_int`, which no module fn shares.
imported_fn_sigs :: fn(
    loaded: LoadedModule,
    tp: TypedProgram,
    per_module: MutableMap<string, TypedProgram>,
) -> ImportedFnSig[] {
    out: ImportedFnSig[]: []
    targets :: tp.import_targets
    if targets !is ImportTargetTable {
        return out
    }
    for [sym_id, info] in loaded.collected.imports {
        if info.imported_name is null {
            continue
        }
        // namespace import — not a free-fn binding
        st :: targets.symbol_targets[sym_id] ?? continue
        owner :: per_module[st.module_id] ?? continue
        ty :: owner.decl_types[st.symbol.id]
        if ty is FnType {
            out.push(ImportedFnSig {
                .local = info.local,
                .key   = canonical_args_key(ty.params),
                .span  = info.binding_span,
            })
        }
    }
    return out
}

// Canonical key for a fn decl's resolved parameter signature, or null when a
// param is un-annotated (only lambdas omit param types ; a named fn always has
// them, so the null branch is a defensive skip).
fn_signature_key :: fn(fd: AST.FnDecl, resolved: ResolvedModule) -> string | null {
    params: Type[]: []
    for p in fd.params {
        pty :: p.ty ?? return null
        params.push(type_from_expr(pty, resolved, diag_sink()))
    }
    return canonical_args_key(params)
}

// ---- impl tables ----------------------------------------------------------

// Record every impl of the project into the tables its modules share, each impl
// once, by the module that declares it: the membership of every impl, then the
// members of every impl. Runs before the first body walk. An impl's diagnostics
// go to its module's resolver diagnostics, which the entry's build forwards.
register_project_impls :: fn(
    project: LoadedProject,
    per_module: MutableMap<string, TypedProgram>,
) -> void {
    owners: TypedProgram[]: []
    impls: RecordedImpl[][]: []
    for [id, owner] in per_module {
        loaded :: project.modules[id] ?? continue
        found :: recorded_impls(merge_module_program(loaded.module.files).decls, owner)
        record_impl_memberships(owner, found)
        owners.push(owner)
        impls.push(found)
    }
    for i in 0..<owners.len() {
        record_impls_members(owners[i], impls[i], owners[i].resolved.diags)
    }
}

// Record the impls of one module checked alone, `decls` declared by `owner`.
register_module_impls :: fn(decls: AST.Decl[], owner: TypedProgram, diags: Diagnostic[]) -> void {
    found :: recorded_impls(decls, owner)
    record_impl_memberships(owner, found)
    record_impls_members(owner, found, diags)
}

// An impl the tables record: its declaration, the type it is written for and its
// trait, both resolved in the module that declares it.
RecordedImpl :: struct {
    decl: AST.ImplDecl
    for_ty: Type
    trait_sym: Symbol
}

// The impls of `decls` the tables record: neither one whose trait does not
// resolve, nor one on an array type its module refuses (T3090).
recorded_impls :: fn(decls: AST.Decl[], owner: TypedProgram) -> RecordedImpl[] {
    out: RecordedImpl[]: []
    for decl in decls {
        if decl is AST.ImplDecl {
            for_ty :: type_from_expr(decl.for_type, owner.resolved, diag_sink())
            trait_sym :: impl_trait_symbol(decl, owner.resolved) ?? continue
            if !is_refused_array_impl(for_ty) {
                out.push(RecordedImpl {
                    .decl = decl,
                    .for_ty = for_ty,
                    .trait_sym = trait_sym,
                })
            }
        }
    }
    return out
}

// What each of `impls`, declared by `owner`, makes its type implement.
record_impl_memberships :: fn(owner: TypedProgram, impls: RecordedImpl[]) -> void {
    for r in impls {
        record_impl_membership(owner, r.decl, r.for_ty, trait_key_of(r.trait_sym))
    }
}

// The members of each of `impls`, declared by `owner` ; the errors of a trait
// argument or a member signature go to `diags`.
record_impls_members :: fn(
    owner: TypedProgram,
    impls: RecordedImpl[],
    diags: Diagnostic[],
) -> void {
    for r in impls {
        record_impl_members(owner, r.decl, r.for_ty, r.trait_sym, diags)
    }
}

// The trait membership an impl declares: `is Trait`, trait widening, the bounds
// its type parameters put on the arguments. Recorded for every impl before
// anything else, so a member type that widens to a later-declared impl resolves.
//
// `owner` is the module that declares `decl` : it resolves the type parameters'
// bounds.
record_impl_membership :: fn(
    owner: TypedProgram,
    decl: AST.ImplDecl,
    for_ty: Type,
    trait_key: string,
) -> void {
    if is_instance_receiver(for_ty) {
        owner.impl_tables.instance_impl_bases.add(impl_base_key(for_ty))
    }
    record_struct_trait(owner.impl_tables, for_ty, trait_key)
    record_impl_bounds(owner, for_ty, trait_key)
}

// The lookup tables an impl's members feed : the element / key types of its
// `Iterator` / `Index` / `IndexSet` / `Into` trait, its trait arguments, and one
// UFCS entry per member, plus the target-keyed `Into` entry.
//
// `owner` is the module that declares `decl` : it resolves the trait arguments
// and the member signatures, whose errors go to `diags`.
record_impl_members :: fn(
    owner: TypedProgram,
    decl: AST.ImplDecl,
    for_ty: Type,
    trait_sym: Symbol,
    diags: Diagnostic[],
) -> void {
    trait_key :: trait_key_of(trait_sym)
    // The impl's own parameters, as those of the struct it is written for : every
    // template recorded below then reads a receiver's arguments by the struct's.
    as_struct :: impl_params_as_struct_params(for_ty, owner)
    // With the default a slot's arguments take, so the impl's instance compares
    // with the slots that ask for it (`implements_trait_instance`).
    written :: written_type_args(decl.trait_args, owner.resolved, diags)
    trait_args :: substitute_each_map(written, as_struct)
    tables :: owner.impl_tables
    index_impl_metadata(tables, for_ty, trait_key, trait_args)
    record_struct_trait_args(tables, for_ty, trait_key, trait_args)
    trait_decl :: owner.trait_decls[trait_sym.id]
    is_into :: trait_key == core_trait_key(TRAIT_INTO) && trait_args.len() == 1
    side :: impl_side_key(for_ty)
    for m in decl.members {
        trait_method :: lookup_trait_method(trait_decl, m.name)
        written_ty :: ufcs_method_type(decl, m, for_ty, trait_method, owner, diags)
        entry :: ImplMethod {
            .ty = in_struct_frame(written_ty, as_struct),
            .decl = m,
            .impl_key = decl.span.hash(),
            .trait_key = trait_key,
            .trait_args = trait_args,
            .trait_symbol = trait_sym,
            .generic = type_contains_type_param(for_ty),
        }
        add_impl_method(tables, "${impl_type_key(for_ty)}::${m.name}", entry)
        // And under its side key : the base, which every instance of a generic impl
        // reads, or the impl's own type, which wins for that instance alone.
        member_key :: "${side}::${m.name}"
        add_impl_method(tables, member_key, entry)
        add_trait_unique(tables.impl_method_traits, member_key, trait_key)
        // `Into<T>` impls are indexed under a target-qualified key so
        // multiple `Into` impls for the same source (e.g. `Into<i32>` +
        // `Into<string>`) don't collide. The pair is the impl's own, as a body of
        // the impl sees its receiver. A generic impl's pair names a type parameter
        // no conversion carries : it is found by the base of its target instead
        // (`into_method_toward`).
        if is_into && m.name == METHOD_INTO {
            add_impl_method(tables, into_impl_key(for_ty, written[0]), entry)
            if type_contains_type_param(for_ty) {
                add_impl_method(tables, "${side}${into_toward_suffix(trait_args[0])}", entry)
            }
        }
    }
}

// Adds `entry` to the members `key` offers, once : a plain type's own key is its
// side key.
add_impl_method :: fn(tables: ImplTables, key: string, entry: ImplMethod) -> void {
    members :: tables.impl_methods[key]
    if members == null {
        tables.impl_methods[key] = [entry]
        return
    }
    for i in 0..<members.len() {
        if members[i].impl_key == entry.impl_key {
            members[i] = entry
            return
        }
    }
    members.push(entry)
}

diag_sink :: fn() -> Diagnostic[] { return [] }

// Index an impl's `Iterator` / `Into` / `Index` / `IndexSet` trait args into the
// element / key / target tables of the impl tables, so `for x in X`, `m[k]`
// and `m[k] = v` pin their types. `trait_key` is the impl's resolved trait, so a
// user trait that happens to be named `Index` indexes nothing.
index_impl_metadata :: fn(
    tables: ImplTables,
    for_ty: Type,
    trait_key: string,
    trait_args: Type[],
) -> void {
    key :: impl_side_key(for_ty)
    if trait_key == core_trait_key(TRAIT_ITERATOR) && trait_args.len() == 1 {
        tables.iter_element_types[key] = trait_args[0]
    }
    // A type that is an `Iterator` itself is walked through its own `next`, whatever
    // it converts into.
    if trait_key == core_trait_key(TRAIT_INTO) && trait_args.len() == 1 {
        elem :: core_trait_arg(trait_args[0], TRAIT_ITERATOR)
        if elem != null && !has_iterator_impl(tables, key) {
            tables.iter_element_types[key] = elem
        }
    }
    if trait_key == core_trait_key(TRAIT_INDEX) && trait_args.len() == 2 {
        tables.index_key_types[key] = trait_args[0]
        tables.index_target_types[key] = trait_args[1]
    }
    if trait_key == core_trait_key(TRAIT_INDEX_SET) && trait_args.len() == 2 {
        tables.index_set_key_types[key] = trait_args[0]
        tables.index_set_value_types[key] = trait_args[1]
    }
}

has_iterator_impl :: fn(tables: ImplTables, key: string) -> bool {
    traits :: tables.struct_implemented_traits[key] ?? return false
    return core_trait_key(TRAIT_ITERATOR) in traits
}

// Append `trait_key` to `m[key]`'s bucket unless already present.
// Shared by the three trait-membership recorders (`record_impl_members` + both
// maps of `record_struct_trait`), generic over the key type so the id-keyed and
// base-keyed maps use one form.
add_trait_unique :: fn<K: Hash & Equals>(
    m: MutableMap<K, string[]>, key: K, trait_key: string,
) -> void {
    bucket :: m[key]
    if bucket == null {
        m[key] = [trait_key]
        return
    }
    for n in bucket {
        if n == trait_key {
            return
        }
    }
    bucket.push(trait_key)
    m[key] = bucket
}

record_struct_trait :: fn(tables: ImplTables, for_ty: Type, trait_key: string) -> void {
    // Two membership maps populated in lockstep: the symbol-id map drives the
    // runtime `is Trait` impl_table rows via the emitter, the `impl_side_key` map
    // answers the typecheck consumers and also covers primitives and arrays. An
    // impl on one instance stays off the symbol-id map, which every tag of the
    // declaration reads : the instance's own tag gets its row from the members
    // materialised for it.
    target :: type_to_target_symbol(for_ty)
    if target is Symbol && !is_instance_receiver(for_ty) {
        add_trait_unique(tables.struct_traits_by_sym, target.id, trait_key)
    }
    add_trait_unique(tables.struct_implemented_traits, impl_side_key(for_ty), trait_key)
}

// The bounds an impl's type parameters put on the arguments of `for_ty`, the type
// it implements its trait for (`ImplTables.impl_bounds`). `owner` is the
// impl's own module, which holds its type parameters' bounds and the scope they
// name traits in. An impl for a type without arguments puts no bound.
record_impl_bounds :: fn(owner: TypedProgram, for_ty: Type, trait_key: string) -> void {
    args :: type_arguments(for_ty)
    if args.is_empty() || is_instance_receiver(for_ty) {
        return
    }
    bounds: ArgBound[]: []
    for i in 0..<args.len() {
        arg :: args[i]
        if arg is TypeParamType {
            bound :: owner.resolved.type_param_bounds[arg.symbol.id] ?? continue
            traits: TraitType[]: []
            collect_bound_trait_types(bound, owner.resolved, traits)
            bounds.push(ArgBound {
                .position = i,
                .name = arg.symbol.name,
                .traits = traits,
            })
        }
    }
    entry :: BoundedImpl { .trait_key = trait_key, .bounds = bounds }
    base :: impl_base_key(for_ty)
    held :: owner.impl_tables.impl_bounds[base] ?? []
    held.push(entry)
    owner.impl_tables.impl_bounds[base] = held
}

// ---- cross-module table merges --------------------------------------------

// Every module's type-parameter bounds in ONE table every module reads, so a call
// checks an imported callee's bounds as it checks a local one's. Symbol ids are
// project-wide, so modules cannot collide. Built once imports are wired : a bound
// naming a renamed import or a namespace member (`T: Ns.Trait`) resolves only then.
broadcast_type_param_bounds :: fn(
    per_module: MutableMap<string, TypedProgram>,
    project: LoadedProject,
) -> void {
    shared :: MutableMap<i32, TypeParamBound> {}
    for [_, typed] in per_module {
        record_type_param_bounds(typed.resolved, shared)
    }
    struct_bounds :: MutableMap<i32, ArgBound[]> {}
    for [_, typed] in per_module {
        record_struct_bounds(typed, shared, struct_bounds)
    }
    for [id, lm] in project.modules {
        typed :: per_module[id] ?? continue
        for file in lm.module.files {
            inherit_struct_bounds(file.program.decls, typed.resolved, struct_bounds, shared)
        }
    }
    for [_, typed] in per_module {
        typed.type_param_bound_traits = shared
        typed.struct_bounds = struct_bounds
    }
}

// The bounds each generic struct `typed` declares puts on its type arguments, by the
// struct's symbol id. Only the declaring module resolves a type parameter's span.
record_struct_bounds :: fn(
    typed: TypedProgram,
    shared: MutableMap<i32, TypeParamBound>,
    out: MutableMap<i32, ArgBound[]>,
) -> void {
    for sym in typed.resolved.symbols {
        if sym.kind != .Struct {
            continue
        }
        decl :: typed.struct_decls[sym.id] ?? continue
        bounds: ArgBound[]: []
        for i in 0..<decl.type_params.len() {
            tp :: decl.type_params[i]
            tp_sym :: typed.resolved.idents[tp.span.hash()] ?? continue
            bound :: shared[tp_sym.id] ?? continue
            bounds.push(ArgBound {
                .position = i,
                .name = tp.name,
                .traits = bound.traits,
            })
        }
        if !bounds.is_empty() {
            out[sym.id] = bounds
        }
    }
}

// An impl that borrows its struct's type parameters (`Wrapper<T> implements Poke`)
// holds only for the instances the struct admits, so its `T` takes the struct's bound
// at that position on top of its own : a literal or a member it reaches through `T`
// is then judged as the struct's own would be.
inherit_struct_bounds :: fn(
    decls: AST.Decl[],
    resolved: ResolvedModule,
    struct_bounds: MutableMap<i32, ArgBound[]>,
    shared: MutableMap<i32, TypeParamBound>,
) -> void {
    for d in decls {
        if d !is AST.ImplDecl {
            continue
        }
        head :: d.for_type
        if head !is AST.GenericInstExpr || head.callee !is AST.IdentExpr {
            continue
        }
        owner :: resolved.idents[head.callee.span.hash()] ?? continue
        bounds :: struct_bounds[owner.id] ?? continue
        for bound in bounds {
            if bound.position >= head.type_args.len() {
                continue
            }
            arg :: head.type_args[bound.position]
            if arg !is AST.IdentExpr {
                continue
            }
            sym :: resolved.idents[arg.span.hash()] ?? continue
            if sym.kind == .TypeParam {
                shared[sym.id] = with_struct_traits(shared[sym.id], sym.name, bound.traits)
            }
        }
    }
}

// `own` with the struct's traits it does not already name.
with_struct_traits :: fn(
    own: TypeParamBound | null, name: string, inherited: TraitType[],
) -> TypeParamBound {
    traits: TraitType[]: []
    if own != null {
        traits.push_all(own.traits)
    }
    for t in inherited {
        if !names_trait(traits, t) {
            traits.push(t)
        }
    }
    return TypeParamBound { .name = name, .traits = traits }
}

names_trait :: fn(traits: TraitType[], t: TraitType) -> bool {
    for have in traits {
        if have.symbol.id == t.symbol.id {
            return true
        }
    }
    return false
}

// The bound of every type parameter `resolved` declares, by its symbol id. The
// bound table has no names : `idents` is what carries a type parameter's.
record_type_param_bounds :: fn(
    resolved: ResolvedModule,
    out: MutableMap<i32, TypeParamBound>,
) -> void {
    for [_, sym] in resolved.idents {
        if sym.kind != .TypeParam || out[sym.id] != null {
            continue
        }
        bound :: resolved.type_param_bounds[sym.id] ?? continue
        traits: TraitType[]: []
        collect_bound_trait_types(bound, resolved, traits)
        out[sym.id] = TypeParamBound { .name = sym.name, .traits = traits }
    }
}

/// The `trait_key`s of the traits `bound` names — one, or an `A & B` chain.
///
/// @param bound     a type parameter's bound.
/// @param resolved  the module that declares the type parameter.
/// @param out       receives one key per trait, left to right.
export collect_bound_traits :: fn(bound: AST.Expr, resolved: ResolvedModule, out: string[]) -> void {
    traits: TraitType[]: []
    collect_bound_trait_types(bound, resolved, traits)
    for t in traits {
        out.push(trait_key_of(t.symbol))
    }
}

// The traits `bound` names, with their arguments (`Contains<i32>`), left to right.
collect_bound_trait_types :: fn(bound: AST.Expr, resolved: ResolvedModule, out: TraitType[]) -> void {
    if bound is AST.BinaryExpr && bound.op == .BitAnd {
        collect_bound_trait_types(bound.left, resolved, out)
        collect_bound_trait_types(bound.right, resolved, out)
        return
    }
    bound_type :: type_from_expr(bound, resolved, diag_sink())
    if bound_type is TraitType {
        out.push(bound_type)
    }
}

record_struct_trait_args :: fn(
    tables: ImplTables,
    for_ty: Type,
    trait_key: string,
    // Mutable because that is what `struct_trait_args` stores.
    args: Type[],
) -> void {
    key :: impl_side_key(for_ty)
    if tables.struct_trait_args[key] == null {
        tables.struct_trait_args[key] = MutableMap<string, Type[][]> {}
    }
    per_struct :: tables.struct_trait_args[key] ?? return
    lists :: per_struct[trait_key]
    if lists == null {
        per_struct[trait_key] = [args]
        return
    }
    // Two impls with equal arguments are R2030 : the list keeps one.
    for recorded in lists {
        if type_list_equals(recorded, args) {
            return
        }
    }
    lists.push(args)
}


// Walk every loaded module's `ImplDecl`s and call
// `materialize_sam_members` against the matching trait — works
// cross-module so `Foo implements Display -> "..."` picks up
// Display from `std/core`. Emits R2016 when the short impl form
// (`Type implements Trait -> expr`) targets a trait with != 1
// required method.
export materialize_all_sams_pre_resolve :: fn(
    project: LoadedProject,
    name_index: MutableMap<string, LoadedModule>,
    core_seed: MutableMap<string, Symbol>,
) -> void {
    for [_, loaded] in project.modules {
        for file in loaded.module.files {
            materialize_file_sams(project, loaded, file, name_index, core_seed)
        }
    }
}

// The SAM impls of one file : its trait names resolve in that file's scope, with
// the imports the file wrote.
materialize_file_sams :: fn(
    project: LoadedProject,
    loaded: LoadedModule,
    file: SourceFile,
    name_index: MutableMap<string, LoadedModule>,
    core_seed: MutableMap<string, Symbol>,
) -> void {
    decls :: file.program.decls
    if !has_impl_decl(decls) {
        return
    }
    imports :: file_imports(loaded.collected, file.program.file)
    no_builtins :: MutableMap<string, Symbol> {}
    scope :: file_root_scope(no_builtins, loaded.collected, imports, name_index, core_seed)
    for decl in decls {
        if decl !is AST.ImplDecl {
            continue
        }
        found :: find_impl_trait_decl(decl.trait_name, loaded, scope, name_index, project)
        if found.trait_decl is null {
            if found.other_kind != "" {
                project.diags.push(
                    resolver_error(
                        .TraitNameNotATrait,
                        decl.trait_name_span,
                        "`${decl.trait_name}` is a ${found.other_kind}",
                    ),
                )
            } else {
                project.diags.push(
                    resolver_error(
                        .UnresolvedTypeName,
                        decl.trait_name_span,
                        "`${decl.trait_name}`",
                    ),
                )
            }
            continue
        }
        trait_decl :: found.trait_decl
        check_short_impl_arity(decl, trait_decl, project.diags)
        // `@intrinsic <T> implements <Trait>` arrives with an empty
        // `members` list — synthesise body-less FnDecls from the
        // trait's methods so the rest of the pipeline (declare /
        // ufcs / walk_fn_body) sees them.
        materialize_intrinsic_members(decl, trait_decl, loaded.node_id_factory)
        // Always materialise the SAM rename — `check_short_impl_arity`
        // already marked invalid synthetics as `materialized=true` so
        // body-walk + body-typecheck skip them, but the rename still
        // lets the T3036 "missing method" loop credit the SAM-named
        // slot. Without the rename, both required methods would be
        // flagged missing instead of just the unprovided one.
        materialize_sam_members(decl, trait_decl, loaded.node_id_factory)
        // Default-bodied trait methods get cloned into the impl
        // (body + signature substituted). Bodies carry the
        // materialised-span marker + IDs minted from the project's
        // factory so cloned nodes contribute distinct expr_types
        // entries in the typecheck dump (rendered as
        // `undefined:undefined`).
        materialize_default_members(decl, trait_decl, loaded.node_id_factory)
    }
}

/// R2016 : `Type implements Trait -> expr` desugars one body into the
/// trait's lone required method. When the trait has 0 or 2+ required
/// methods, the sugar is ill-defined — emit once per synthetic member.
check_short_impl_arity :: fn(
    impl_: AST.ImplDecl,
    trait_: AST.TraitDecl,
    diags: Diagnostic[],
) -> bool {
    required :: required_methods(trait_.members).len()
    if required == 1 {
        return true
    }
    fired := false
    for i in 0..<impl_.members.len() {
        m :: impl_.members[i]
        if m.sam_synthetic {
            diags.push(
                resolver_error(
                    .ShortImplFormSingleMethod,
                    m.span,
                    "trait `${impl_.trait_name}` has ${required} required methods",
                ),
            )
            // Mark the synthetic body as already-typechecked so the
            // walker skips it — otherwise T3020 / R2006 on `self` cascade
            // out of a body the user can't fix without restructuring the
            // impl. Same `materialized` flag default-method clones use.
            impl_.members[i].materialized = true
            fired = true
        }
    }
    return !fired
}

// True when `decls` declares at least one impl.
has_impl_decl :: fn(decls: AST.Decl[]) -> bool {
    for d in decls {
        if d is AST.ImplDecl {
            return true
        }
    }
    return false
}

// The declaration of the trait an impl in `loaded` names. Runs before the
// resolver, so it walks the scope the resolver will build : the module's own
// names and imports, then `seed` (the prelude and the wildcard imports).
find_impl_trait_decl :: fn(
    name: string,
    loaded: LoadedModule,
    scope: MutableMap<string, Symbol>,
    name_index: MutableMap<string, LoadedModule>,
    project: LoadedProject,
) -> NamedDeclLookup {
    unresolved :: NamedDeclLookup { .trait_decl = null, .other_kind = "" }
    sym :: name_in_file_scope(name, loaded, scope, name_index) ?? return unresolved
    if sym.kind != .Trait {
        // @partial: only a type declaration is reported by its kind ; any other
        // binding reads as an unresolved type name.
        other_kind :: @partial match sym.kind {
            .Struct    -> "struct"
            .Enum      -> "enum"
            .TypeAlias -> "alias"
            _          -> ""
        }
        return NamedDeclLookup { .trait_decl = null, .other_kind = other_kind }
    }
    owner :: project.modules[sym.module] ?? return unresolved
    for decl in merge_module_program(owner.module.files).decls {
        if decl is AST.TraitDecl {
            if decl.name == sym.name {
                return NamedDeclLookup { .trait_decl = decl, .other_kind = "" }
            }
        }
    }
    return unresolved
}

// The symbol `name` binds to in a file's `scope` (`file_root_scope`), an import
// followed to the declaration it names. Null when the name binds to nothing.
name_in_file_scope :: fn(
    name: string,
    loaded: LoadedModule,
    scope: MutableMap<string, Symbol>,
    name_index: MutableMap<string, LoadedModule>,
) -> Symbol | null {
    own :: scope[name] ?? return null
    if own.kind != .ImportBinding {
        return own
    }
    info :: loaded.collected.imports[own.id] ?? return null
    imported :: info.imported_name ?? return null
    target :: name_index[info.path] ?? return null
    return target.collected.symbols[imported]
}

// What an impl's trait name binds to : the trait, or — so the impl reports R2009
// rather than R2007 — the kind of the other type it names.
NamedDeclLookup :: struct {
    trait_decl: AST.TraitDecl | null
    /// `"struct"` / `"enum"` / `"alias"` when the name binds to that kind of
    /// declaration ; empty otherwise. Only meaningful when `trait_decl` is null.
    other_kind: string
}

// An expression-bodied fn with no explicit return annotation — the only fn
// shape whose return type is settled by body inference (`patch_fn_return_type`,
// stmt.vader). Names the condition shared by `has_expr_bodied_fn` (which fns
// force a forward-reference re-walk) and the return-only `walk_fn_body` guard
// (which fns a re-walk must still walk).
needs_return_inference :: fn(fd: AST.FnDecl) = fd.is_expression_bodied && fd.return_type is null

has_expr_bodied_fn :: fn(decls: AST.Decl[]) -> bool {
    for d in decls {
        if d is AST.FnDecl {
            if needs_return_inference(d) {
                return true
            }
        }
        if d is AST.ImplDecl {
            for m in d.members {
                if needs_return_inference(m) {
                    return true
                }
            }
        }
    }
    return false
}

// Clear per-expression tables so the second pass can re-populate
// them with the now-settled fn return types: an entry the settle walk
// wrote and the full walk does not would outlive it. Decl-level tables
// (`decl_types`, struct/trait decls, the impl tables, …) stay intact:
// only side-tables filled from inside fn bodies need a refresh.
reset_expr_tables :: fn(typed: TypedProgram) -> void {
    typed.expr_types = MutableMap<usize, Type> {}
    typed.expr_kinds = MutableMap<usize, string> {}
    typed.node_spans = MutableMap<usize, Span> {}
    typed.ufcs_receiver_types = MutableMap<usize, Type> {}
    typed.into_coercions = MutableMap<usize, Type> {}
    typed.chosen_fns = MutableMap<usize, FnCandidate> {}
    typed.chosen_impl_methods = MutableMap<usize, ImplMethod> {}
    typed.overloaded_members = MutableMap<usize, ImplMethod[]> {}
    typed.literals_past_default = MutableMap<usize, AST.IntLitExpr> {}
    typed.static_members = MutableMap<usize, StaticMember> {}
    typed.callee_field_id = AST.UNASSIGNED_NODE_ID
    typed.callees = MutableMap<usize, Callee> {}
    typed.call_sites = CallSites {}
    typed.local_types = MutableMap<u64, Type> {}
    // The whole narrowing machine, not table by table: a table added to
    // `NarrowState` is then reset here for free instead of being silently left
    // out of a hand-written list.
    typed.narrow = NarrowState {}
}

// Register every type alias of one module (explicit `T :: type ...` or implicit
// `T :: <type-expr>`) into `resolved.alias_types` — across the project, BEFORE
// `declare_module`, so a signature naming an alias resolves it — and return the
// decls that could not settle: an alias const whose RHS is not yet a type, a type
// alias naming a type not yet registered. The module's own order is settled here
// (`Value :: I32Val | StringVal` above the distincts it names) ; what another
// module declares is `settle_project_aliases`'.
register_aliases :: fn(typed: TypedProgram, decls: AST.Decl[]) -> AST.Decl[] {
    pending: AST.Decl[]: []
    for decl in decls {
        if !register_alias_decl(decl, typed) {
            pending.push(decl)
        }
    }
    return settle_pending_aliases(typed, pending)
}

// Retry `pending` until a round registers nothing ; what is left is returned.
settle_pending_aliases :: fn(typed: TypedProgram, pending: AST.Decl[]) -> AST.Decl[] {
    rest := pending
    for rest.len() > 0 {
        still: AST.Decl[]: []
        for decl in rest {
            if !register_alias_decl(decl, typed) {
                still.push(decl)
            }
        }
        if still.len() == rest.len() {
            break
        }
        rest = still
    }
    return rest
}

// Register `decl` when it is a type alias ; false when it is one that does not
// settle yet. Any other decl has nothing to register.
register_alias_decl :: fn(decl: AST.Decl, typed: TypedProgram) -> bool {
    if decl is AST.TypeAliasDecl {
        sym :: symbol_declared_at(typed.resolved, decl.name_span) ?? return true
        aliased :: type_from_expr(decl.aliased, typed.resolved, diag_sink())
        typed.resolved.alias_types[sym.id] = aliased
        typed.resolved.alias_params[sym.id] = quantifier_of(decl.type_params, typed.resolved)
        return !contains_unresolved(aliased)
    }
    if decl is AST.ConstDecl {
        return decl.ty != null || register_alias_const(decl, typed)
    }
    return true
}

// An alias naming another module's types (`Reading :: Celsius | Label`, the
// members imported) settles only once that module has registered them: retry each
// module's pending aliases, the alias table being the project's, until a round
// registers nothing. True when anything settled.
settle_project_aliases :: fn(
    per_module: MutableMap<string, TypedProgram>, unsettled: MutableMap<string, AST.Decl[]>,
) -> bool {
    settled_any := false
    for {
        progressed := false
        for id in unsettled.keys() {
            pending :: unsettled[id] ?? continue
            typed :: per_module[id] ?? continue
            if pending.len() == 0 {
                continue
            }
            rest :: settle_pending_aliases(typed, pending)
            if rest.len() < pending.len() {
                unsettled[id] = rest
                progressed = true
                settled_any = true
            }
        }
        if !progressed {
            return settled_any
        }
    }
}

// Fill every module's `namespace_member_types`, then retry the consts Phase A left
// pending: one whose type names a namespace member (`Shape :: sh.Circle | Square`)
// could not register before those tables existed. A newly settled alias is itself
// a member another module may name, so the tables are rebuilt until a round
// settles nothing. Runs before any `declare_module`, so neither the order of the
// declarations nor that of the modules matters.
settle_namespace_member_aliases :: fn(
    project: LoadedProject,
    targets: ImportTargetTable,
    per_module: MutableMap<string, TypedProgram>,
    unsettled: MutableMap<string, AST.Decl[]>,
) -> void {
    // A target's private-name set depends on its collected symbols alone, so it is
    // built once ; its member map also on its `alias_types`, so it is rebuilt each
    // round.
    share_namespace_private_members(targets, project, per_module)
    for {
        share_namespace_member_types(targets, project, per_module)
        // The retry merges every module's aliases into each pending one: skip it
        // when no pending decl can settle, which is every project without such an
        // alias.
        if !can_settle_now(per_module, unsettled) || !settle_project_aliases(per_module, unsettled) {
            return
        }
    }
}

// Whether a pending decl may settle now that the member tables are filled: a const
// that reads as a type, or a type alias still unresolved. A const that does not
// read as a type yet can only settle after one of those does.
can_settle_now :: fn(
    per_module: MutableMap<string, TypedProgram>, unsettled: MutableMap<string, AST.Decl[]>,
) -> bool {
    for [id, pending] in unsettled {
        typed :: per_module[id] ?? continue
        for decl in pending {
            if decl is AST.TypeAliasDecl {
                return true
            }
            if decl is AST.ConstDecl && is_type_expr(decl.value, typed.resolved) {
                return true
            }
        }
    }
    return false
}

// Every module's `type_param_symbols` merged into one table they all share : a
// struct, trait or impl written in one module substitutes the parameters another
// one declares.
share_type_param_symbols :: fn(per_module: MutableMap<string, TypedProgram>) -> void {
    shared :: MutableMap<u64, Symbol> {}
    for [_, typed] in per_module {
        for [site, sym] in typed.type_param_symbols {
            shared[site] = sym
        }
    }
    for [_, typed] in per_module {
        typed.type_param_symbols = shared
    }
}

// Cross-module struct visibility : each module's `declare_module` only
// populates its OWN `struct_decls` / `struct_field_types`, yet a field access on
// a local typed as another module's struct (`block: LoweredBlock` in main.vader)
// looks `typed.struct_decls[sym.id]` up in the CURRENT module, and a miss turns
// into `?` and cascades. Symbol ids being project-global, the union of every
// module's tables is one table, written by nothing after the declarations:
// every module shares that instance.
broadcast_struct_decls :: fn(per_module: MutableMap<string, TypedProgram>) -> void {
    all_decls :: MutableMap<i32, AST.StructDecl> {}
    all_fields :: MutableMap<i32, MutableMap<string, Type>> {}
    for [_, typed] in per_module {
        for [sid, d] in typed.struct_decls {
            all_decls[sid] = d
        }
        for [sid, f] in typed.struct_field_types {
            all_fields[sid] = f
        }
    }
    for [_, typed] in per_module {
        typed.struct_decls = all_decls
        typed.struct_field_types = all_fields
    }
}

// Compute every enum's `EnumType` across all files of all modules (Phase A) and
// record it in the project's alias table, keyed by the enum symbol's global id. A
// fn signature or struct field then resolves an enum reference (same module, another
// one, or a sibling file of a multi-file module) to its `EnumType` rather than the
// `type_from_symbol` `.Enum -> mk_struct` placeholder, so the bytecode emit
// collapses the enum to its `repr` ordinal. Every enum is built before any is
// recorded. Must run before `declare_module` lowers any signature.
register_enum_types :: fn(
    per_module: MutableMap<string, TypedProgram>,
    project: LoadedProject,
    alias_types: MutableMap<i32, Type>,
) -> void {
    collected :: MutableMap<i32, Type> {}
    for [id, typed] in per_module {
        loaded :: project.modules[id] ?? continue
        for file in loaded.module.files {
            for decl in file.program.decls {
                if decl is AST.EnumDecl {
                    sym :: symbol_declared_at(typed.resolved, decl.name_span) ?? continue
                    collected[sym.id] = build_enum_type(sym, decl, typed.resolved, diag_sink())
                }
            }
        }
    }
    for [sid, t] in collected {
        alias_types[sid] = t
    }
}

register_alias_const :: fn(cd: AST.ConstDecl, typed: TypedProgram) -> bool {
    if !is_type_expr(cd.value, typed.resolved) {
        return false
    }
    sym :: symbol_declared_at(typed.resolved, cd.name_span) ?? return true
    aliased :: type_from_expr(cd.value, typed.resolved, diag_sink())
    // `alias_for` (decl.vader, same module) is the shared distinct promotion rule ;
    // this cross-project pass is the authoritative writer of `alias_types`.
    typed.resolved.alias_types[sym.id] = alias_for(sym, aliased, cd)
    return true
}

/// True when `e` is a TYPE expression — the trigger to promote a `Name :: <...>`
/// const to a type alias / distinct newtype instead of a value binding. The one
/// predicate behind every alias-registration site: `register_alias_const` +
/// `declare_const` + `check_const_value` (const RHS) and the in-fn `let`-alias
/// detection (`stmt.vader`).
///
/// An IdentExpr names a type when it is a primitive (incl. `type` / `Self` and
/// the friendly aliases `int` / `long` / …), a real type declaration
/// (`is_type_kind` — struct / trait / enum / type-alias / type-param / builtin),
/// OR a `Name :: <type>` const/distinct already registered in `alias_types`.
/// That last case is what lets a newtype be used as an alias RHS
/// (`Distance :: Meters`) or a tuple-alias element (`Pair :: [Meters, i32]`) —
/// such a decl is a plain `ConstDecl` (SymbolKind.Const), so it is invisible to
/// the kind check but resolves to a type through `alias_types`, which
/// `register_aliases` fills to a fixed point within a module — a chain of any
/// depth, in any declaration order. A member imported from another module is only
/// seen by the later writers, which walk in source order.
///
/// `Ns.Member` names a type when `Ns` is a namespace import whose target exports a
/// type by that name (`namespace_member_types`). Those tables are filled after
/// `register_aliases`; `settle_namespace_member_aliases` retries the consts left
/// pending once they are.
is_type_expr :: fn(e: AST.Expr, resolved: ResolvedModule) -> bool {
    if e is AST.IdentExpr {
        if primitive_from_name(e.name) !is null {
            return true
        }
        sym :: resolved.idents[e.span.hash()] ?? return false
        if is_type_kind(sym.kind) {
            return true
        }
        return resolved.alias_types[sym.id] !is null
    }
    if e is AST.FieldExpr {
        if e.target !is AST.IdentExpr {
            return false
        }
        namespace :: resolved.idents[e.target.span.hash()] ?? return false
        members :: resolved.namespace_member_types[namespace.id] ?? return false
        return members[e.field] !is null
    }
    if e is AST.BinaryExpr {
        if e.op == .BitOr {
            // Treat `T | U` chains as types.

            return is_type_expr(e.left, resolved) && is_type_expr(e.right, resolved)
        }
    }
    if e is AST.GenericInstExpr { return true }
    if e is AST.FnTypeExpr      { return true }
    if e is AST.ArrayTypeExpr   { return true }
    // `Coord :: [i32, i32]` — a ≥ 2-element all-type bracketed list is a tuple
    // type alias (1-tuples are forbidden).
    if e is AST.SeqLitExpr {
        if e.elements.len() < 2 {
            return false
        }
        for el in e.elements {
            if !is_type_expr(el, resolved) {
                return false
            }
        }
        return true
    }
    return false
}

/// Give every typed program the project-wide `trait_decls` (+ owner), so
/// default-method dispatch from any body can find the trait declaration
/// regardless of which module the trait lives in. Nothing writes these tables
/// after the declarations, so one instance serves every module.
cross_publish_trait_decls :: fn(per_module: MutableMap<string, TypedProgram>) -> void {
    decls :: MutableMap<i32, AST.TraitDecl> {}
    owners :: MutableMap<i32, ResolvedModule> {}
    for [_, tp] in per_module {
        for [sym_id, d] in tp.trait_decls {
            decls[sym_id] = d
            owners[sym_id] = tp.trait_decl_owners[sym_id] ?? tp.resolved
        }
    }
    for [_, tp] in per_module {
        tp.trait_decls = decls
        tp.trait_decl_owners = owners
    }
}

/// Same idea as `cross_publish_trait_decls` but for `fn_decls`.
/// Lets `lookup_callee_fn_decl` reach a callee declared in another module
/// (`std/math.min` from an entry call site).
cross_publish_fn_decls :: fn(per_module: MutableMap<string, TypedProgram>) -> void {
    fdecls :: MutableMap<i32, AST.FnDecl> {}
    for [_, tp] in per_module {
        for [sym_id, d] in tp.fn_decls {
            fdecls[sym_id] = d
        }
    }
    for [_, tp] in per_module {
        tp.fn_decls = fdecls
    }
}

// Pull into the entry's `external_types` the named types a struct field reaches
// only transitively (an Enum / Struct / Trait declared in a module the entry does
// not import), so the passes that lift placeholders (`lift_enum_placeholder` in
// `expr_dot_variant.vader`) can find them: without it, `FlagSpec { .kind = .Str }`
// rejects `.Str` when `FlagKind` is reached only through the struct's field.
// `struct_field_types` is the project-wide table `broadcast_struct_decls` shares.
pull_field_external_types :: fn(
    entry_typed: TypedProgram,
    per_module: MutableMap<string, TypedProgram>,
) -> void {
    for [_, fmap] in entry_typed.struct_field_types {
        for [_, ft] in fmap {
            pull_referenced_external_types(ft, entry_typed, per_module)
        }
    }
}

/// Walk `t` and, for every named-type symbol (Struct / Enum / Trait)
/// declared in a non-entry module, copy its real declared type from
/// the owning module's `decl_types` into `entry.external_types`. The
/// `external_types[id]` presence check inside `register_external`
/// both memoizes and breaks Struct ↔ Struct cycles.
///
/// Spells out the variant arms instead of routing through
/// `for_each_type` so the recursion stays a plain call graph — a
/// closure capturing the two-field context tripped the self-host
/// codegen at the time of writing.
pull_referenced_external_types :: fn(
    t: Type,
    entry: TypedProgram,
    per_module: MutableMap<string, TypedProgram>,
) -> void {
    match t {
        is StructType -> {
            register_external(t.symbol, entry, per_module)
            for a in t.args {
                pull_referenced_external_types(a, entry, per_module)
            }
        }
        is TraitType  -> {
            register_external(t.symbol, entry, per_module)
            for a in t.args {
                pull_referenced_external_types(a, entry, per_module)
            }
        }
        is EnumType  -> { register_external(t.symbol, entry, per_module) }
        is ArrayType -> { pull_referenced_external_types(t.element, entry, per_module) }
        is TupleType -> {
            for el in t.elements {
                pull_referenced_external_types(el, entry, per_module)
            }
        }
        is UnionType   -> {
            for v in t.variants {
                pull_referenced_external_types(v, entry, per_module)
            }
        }
        is FnType      -> {
            for p in t.params {
                pull_referenced_external_types(p, entry, per_module)
            }
            pull_referenced_external_types(t.return_type, entry, per_module)
        }
        _                   -> {}
    }
}

register_external :: fn(
    sym: Symbol,
    entry: TypedProgram,
    per_module: MutableMap<string, TypedProgram>,
) -> void {
    if entry.external_types[sym.id] !is null { return }
    if sym.module == entry.resolved.path     { return }
    owner :: per_module[sym.module] ?? return
    declared :: owner.decl_types[sym.id] ?? return
    entry.external_types[sym.id] = declared
    // Chained references — `Foo { bar: Bar }` where `Bar { baz: Baz }`.
    pull_referenced_external_types(declared, entry, per_module)
}

// Build a name → FnType[] index of every imported free fn so
// `field.vader::try_free_fn_ufcs` can dispatch `x.method()` to a
// stdlib helper without requiring the user to re-implement it
// locally. Walks `external_types` (already populated with the
// imported name's resolved Type) and buckets by symbol name.
/// Pre-walk every non-entry module's expression-bodied fns so their return
/// types get patched into the owning module's `decl_types` before the
/// resolution env is wired from those types (`populate_external_types` /
/// `populate_imported_fn_overloads`). A `.ReturnsOnly` walk : it touches only
/// `needs_return_inference` fns and builds NO `expr_types`. The full per-module
/// `expr_types` + stdlib-fn materialisation (GATE B1) are produced later, by the
/// import-loop's real `.Full` walk in `check_project_with_bodies`.
settle_external_expr_bodied_returns :: fn(
    project: LoadedProject,
    per_module: MutableMap<string, TypedProgram>,
) -> void {
    entry_path :: project.entry
    // Two-pass : expression-bodied fns whose body calls other expr-bodied
    // fns in the same module need the callees' return types patched
    // before the caller's inference sees them. A second walk picks up
    // the now-resolved return types so chains like
    // `lexer_error(...) = new_diagnostic(...)` (where new_diagnostic
    // is itself expr-bodied) settle to the concrete return type
    // instead of `?`.
    //
    // Both passes are `.ReturnsOnly` : they settle returns and nothing else.
    // `expr_types` + materialisation come from the import-loop `.Full` walk that
    // runs over every module afterwards, so settle skips every non-settling body.
    // Pass 1 only re-settles forward refs, so it's gated to expr-bodied modules
    // (std/iter et al. don't pay a second pass for a sibling's settling).
    for pass in 0..<2 {
        for [id, loaded] in project.modules {
            if id == entry_path {
                continue
            }
            other_typed :: per_module[id] ?? continue
            // Merge each module's files once per iteration — `merge_module_program`
            // rebuilds + copies the decl list for multi-file modules, so reuse it
            // across the gate + the walk (mirrors the import loop's `other_decls`).
            decls :: merge_module_program(loaded.module.files).decls
            if pass == 1 && !has_expr_bodied_fn(decls) {
                continue
            }
            walk_bodies(decls, other_typed, diag_sink(), .ReturnsOnly)
        }
    }
}

// Build one overload table per FILE of the module, from that file's own
// wildcard imports. Imports are file-scoped (SPEC §"Modules"), so two files of
// one module see different names — including the same path imported bare in one
// and under a modifier list in the other, which is real in-tree usage
// (`vader/lsp/main_entry.vader` vs `vader/lsp/main.vader` on `std/cli`).
//
// Only the forms that put names in UNQUALIFIED scope feed a table: bare
// `import "p"`, `import "p" { … }` minus what its modifiers drop, the names a
// modifier list REBINDS, and the always-in-scope `std/core` prelude. A namespace
// alias (`P :: import "p"`) contributes nothing — it binds one name and
// qualifies the rest, so `x.f()` must fail exactly where `f(x)` is R2006, the
// divergence SPEC §UFCS rules out ("resolves … exactly as `foo(x)` would").
populate_imported_fn_overloads :: fn(
    entry_typed: TypedProgram,
    wildcards: FileImports[],
    typed_by_name: MutableMap<string, TypedProgram>,
) -> void {
    // Loop-invariant : the prelude is the same module for every file.
    core :: typed_by_name["std/core"]
    for fw in wildcards {
        table :: file_overload_table(entry_typed, fw.file)
        // Dedup: a path can appear more than once in one file (re-imported in a
        // `// ---- tests ----` block), and `push_module_exported_fns` would
        // rescan it — idempotent but wasted.
        seen :: MutableMap<string, bool> {}
        for path in fw.paths {
            if seen[path] != null {
                continue
            }
            seen[path] = true
            other :: typed_by_name[path]
            if other != null {
                // A modifier drops its source name from that path's wildcard, so
                // the UFCS table must drop it too — else `{ x as _ }` leaves
                // `recv.x()` callable while `x(recv)` is R2006.
                push_module_exported_fns(other, entry_typed, table, fw.excludes[path] ?? [])
            }
        }
        if core != null {
            // Re-pushed per file rather than shared: `push_overload` mutates a
            // bucket in place, so one array reachable from two files' tables
            // would let a file's own overload of that name leak into a sibling.
            // The prelude is in scope with no import, so it honours no modifier
            // list, and a per-file copy of its few fns costs little.
            push_module_exported_fns(core, entry_typed, table, [])
        }
    }
    // Renamed imports (`import "p" { foo as bar }`) bind ONE name, in the file
    // that wrote them — under the local name only, since the same modifier
    // excluded the source name from that path's wildcard just above.
    push_renamed_imports(entry_typed)
}

// The table `file` reads its imported overloads from, created on first use.
//
// Registered under the file's own path AND under the `<clone>:` form a
// materialised trait-default body carries (`resolver/substitute_body.vader`):
// such a body has no file of its own, and the names it may use are the ones its
// impl's file can see. Maps hold references, so the alias costs one entry.
file_overload_table :: fn(
    typed: TypedProgram, file: string,
) -> MutableMap<string, FnCandidate[]> {
    existing :: typed.imported_fn_overloads[file]
    if existing !is null {
        return existing
    }
    table :: MutableMap<string, FnCandidate[]> {}
    typed.imported_fn_overloads[file] = table
    typed.imported_fn_overloads["${CLONE_FILE_PREFIX}${file}"] = table
    return table
}

// `import "p" { foo as bar }` — dispatch `bar` via UFCS on its declared first
// param, in the file that bound it. `symbol_targets` is module-wide, so the
// owning file comes from the local symbol's own span.
push_renamed_imports :: fn(entry_typed: TypedProgram) -> void {
    targets :: entry_typed.import_targets ?? return
    for [sym_id, st] in targets.symbol_targets {
        ty :: entry_typed.external_types[st.symbol.id] ?? continue
        if ty !is FnType {
            continue
        }
        local :: import_binding_by_id(sym_id, entry_typed) ?? continue
        where :: local.defined_at ?? continue
        // A renamed import binds the same declaration under a new local name,
        // so the decl travels with it exactly as a wildcard's does.
        push_overload(
            file_overload_table(entry_typed, where.start.file), local.name,
            FnCandidate {
                .ty = ty,
                .symbol = st.symbol,
                .decl = entry_typed.fn_decls[st.symbol.id],
            },
        )
    }
}

// Push every fn overload of `from` into `table`, keyed by name (`push_overload`
// is replace-on-signature). We iterate `fn_overloads` (not `symbols`) so every
// overload of the same name lands in the bucket. Skips the self case (a module
// never contributes to its own import table).
//
// `excluded` holds the source names the importing file's modifier list drops
// from this path's wildcard. They stay out of `table` but are still typed into
// `into.external_types` — that table is keyed by symbol id and answers "what
// type is this?", not "is this name in scope here?", and a rename reads its
// target's type from it.
push_module_exported_fns :: fn(
    from: TypedProgram,
    into: TypedProgram,
    table: MutableMap<string, FnCandidate[]>,
    excluded: string[],
) -> void {
    if from.resolved.path == into.resolved.path {
        return
    }
    for [name, bucket] in from.resolved.fn_overloads {
        for sym in bucket {
            // Only EXPORTED fns are reachable cross-module — a private fn is not
            // importable, so it must not enter another module's UFCS/prefix pool
            // (mirrors `seed_wildcard_exports`'s Public filter + the destructure
            // R2008 check). Without this, a module's private helpers leaked as
            // cross-module UFCS candidates.
            if sym.visibility != .Public {
                continue
            }
            ty :: from.decl_types[sym.id] ?? continue
            if ty is FnType {
                if name !in excluded {
                    // The DECL travels with the type: it is what carries
                    // parameter names and defaults, which a UFCS call site in
                    // the importing module has no other way to reach.
                    fd :: from.fn_decls[sym.id]
                    push_overload(table, name, FnCandidate {
                        .ty = ty,
                        .symbol = sym,
                        .decl = fd,
                    })
                    // And the defaults' own name resolutions travel with it —
                    // they are lowered in the CALLER's context. See
                    // `import_defaults.vader`.
                    if fd is AST.FnDecl {
                        publish_default_resolutions(from, into, fd)
                    }
                }
                into.external_types[sym.id] = ty
            }
        }
    }
    // Same for wildcard-exposed CONSTS : without their type in `external_types`,
    // a wildcard `println(CLI_VERSION)` const or `EnumName.Variant` types the const as `?`, so the generic
    // `println<T>` instance can't be pinned and its materialisation drops
    // (GATE B1), and a wildcard enum-variant access mis-resolves. A struct's
    // name in value position needs it too (`Info(v)` converts). Traits flow
    // through `cross_publish`.
    for sym in from.resolved.symbols {
        if sym.visibility != .Public {
            continue
        }
        if sym.kind != .Const && sym.kind != .Enum && sym.kind != .TypeAlias && sym.kind != .Struct {
            continue
        }
        cty :: from.decl_types[sym.id] ?? continue
        into.external_types[sym.id] = cty
    }
}

push_overload :: fn(
    table: MutableMap<string, FnCandidate[]>, name: string, ft: FnCandidate,
) -> void {
    bucket :: table[name]
    if bucket is null {
        table[name] = [ft]
    } else {
        for i in 0..<bucket.len() {
            if type_list_equals(bucket[i].ty.params, ft.ty.params) {
                bucket[i] = ft
                table[name] = bucket
                return
            }
        }
        bucket.push(ft)
        table[name] = bucket
    }
}

// The resolver-side `imports_to` table, so `type_from_expr` can dereference an
// ImportBinding symbol (`ParseError` from `std/string`) to its real export
// without the full `TypedProgram`. Symbol ids are project-global, so one table
// serves every module: each looks up only the import symbols it resolves.
resolver_imports :: fn(targets: ImportTargetTable) -> MutableMap<i32, Symbol> {
    out :: MutableMap<i32, Symbol> {}
    for [sym_id, st] in targets.symbol_targets {
        out[sym_id] = st.symbol
    }
    return out
}

populate_core_symbols :: fn(
    entry_typed: TypedProgram,
    project: LoadedProject,
    per_module: MutableMap<string, TypedProgram>,
) -> void {
    // Resolve `std/async`'s `run_async_main` for the entry (the implicit
    // async-`main` driver) when the program imports `std/async` — independent of
    // core, so it survives the core early-returns below.
    async_id :: find_async_module_id(project)
    if async_id != null {
        async_loaded :: project.modules[async_id]
        if async_loaded != null {
            entry_typed.run_async_main_symbol = async_loaded.collected.symbols["run_async_main"]
        }
    }
    // The baked target constants, BEFORE core's early-returns: a stdlib-less
    // snippet has no `std/core` but still gets `VADER_OS` seeded, and bridging
    // its type must not depend on core being present.
    //
    // `build_core_seed` puts the symbol in scope so the NAME resolves; without
    // this the TYPE never arrives, and an untyped const reads as `?` — which
    // panics the emitter on a method receiver and lowers a `match` silently to
    // `unreachable`. Seeding a symbol and bridging its type are two halves of
    // the same act; shipping one without the other is what made `VADER_OS`
    // assignable to a `string`.
    populate_baked_symbols(entry_typed, project, per_module)
    core_id :: find_core_module_id(project) ?? return
    core_loaded :: project.modules[core_id] ?? return
    core_typed :: per_module[core_id]
    // EXPERIMENT (complete fix): seed core symbols into EVERY module's typed
    // program, not just the entry.
    populate_core_symbols_into(entry_typed, core_loaded, core_typed)
    for [_, other] in per_module {
        if other.resolved.path != entry_typed.resolved.path {
            populate_core_symbols_into(other, core_loaded, core_typed)
        }
    }
}

// The type half of the baked-module seed — see `populate_core_symbols_into`,
// which does the same job for `std/core`.
populate_baked_symbols :: fn(
    entry_typed: TypedProgram,
    project: LoadedProject,
    per_module: MutableMap<string, TypedProgram>,
) -> void {
    baked_loaded :: project.modules[BAKED_FOLDER] ?? return
    baked_typed :: per_module[BAKED_FOLDER] ?? return
    for [_, sym] in baked_loaded.collected.symbols {
        t :: baked_typed.decl_types[sym.id] ?? continue
        entry_typed.external_types[sym.id] = t
        for [_, other] in per_module {
            other.external_types[sym.id] = t
        }
    }
}

populate_core_symbols_into :: fn(
    typed: TypedProgram,
    core_loaded: LoadedModule,
    core_typed: TypedProgram | null,
) -> void {
    // Surface each core symbol's declared type into `external_types` so a
    // reference to a core symbol (e.g. via `mk_struct(Range, ...)`) returns the
    // concrete declared type.
    if core_typed == null {
        // Still set the well-known slots below even without typed core types.
        typed.range_symbol = core_loaded.collected.symbols[STRUCT_RANGE]
        typed.field_symbol = core_loaded.collected.symbols[STRUCT_FIELD]
        return
    }
    for [_, sym] in core_loaded.collected.symbols {
        t :: core_typed.decl_types[sym.id] ?? continue
        typed.external_types[sym.id] = t
    }
    // Well-known struct slots : Range (`a..b`) + Field (`@fields`), synthesised
    // without a source span so they can't come through span-keyed `idents`.
    typed.range_symbol = core_loaded.collected.symbols[STRUCT_RANGE]
    typed.field_symbol = core_loaded.collected.symbols[STRUCT_FIELD]
    typed.async_symbol = core_loaded.collected.symbols[TRAIT_ASYNC]
    typed.equals_symbol = core_loaded.collected.symbols[TRAIT_EQUALS]
}

build_namespace_exports :: fn(
    mod_id: string,
    project: LoadedProject,
    per_module: MutableMap<string, TypedProgram>,
) -> MutableMap<string, Type> {
    out :: MutableMap<string, Type> {}
    loaded :: project.modules[mod_id] ?? return out
    typed :: per_module[mod_id] ?? return out
    for [name, sym] in loaded.collected.symbols {
        // Exported members only — reached through a `P :: import "m"` alias.
        // Mirrors the destructured-import check that fires R2008 (`wire.vader`);
        // a private member's absence here routes `P.private` to the private-set
        // check in `field.vader::try_namespace_field`.
        if sym.visibility == .Private {
            continue
        }
        t :: typed.decl_types[sym.id]
        if t !is null {
            out[name] = t
            continue
        }
        aliased :: typed.resolved.alias_types[sym.id]
        if aliased !is null {
            out[name] = aliased
        }
    }
    return out
}

// Declared params of `mod_id`'s exported FN members, by name. Parallels
// `build_namespace_exports` (which carries only the Type) so a namespace-
// qualified call `mod.foo(...)` can reach each param's `default_value` for
// named-arg reordering + default filling (see `call.vader::callee_param_decls`).
//
// First-overload-only: `collected.symbols` is keyed by name with first-decl-wins
// (collect.vader), and `pick_overload` bails for non-IdentExpr callees, so a
// namespace-qualified call never overload-resolves — only the first overload's
// params are reachable here. To support overloaded namespace calls this map
// would need to become bucket-valued and selection move into
// `namespace_member_params`, mirroring `overload_params_matching`.
build_namespace_export_decls :: fn(
    mod_id: string,
    project: LoadedProject,
    per_module: MutableMap<string, TypedProgram>,
) -> MutableMap<string, AST.FnDecl> {
    out :: MutableMap<string, AST.FnDecl> {}
    loaded :: project.modules[mod_id] ?? return out
    typed :: per_module[mod_id] ?? return out
    for [name, sym] in loaded.collected.symbols {
        // Exported members only — see `build_namespace_exports`.
        if sym.visibility == .Private {
            continue
        }
        decl :: typed.fn_decls[sym.id]
        if decl is AST.FnDecl {
            out[name] = decl
        }
    }
    return out
}

/// Build the `namespace_member_types` every module shares from each target
/// module's `collected.symbols` + `alias_types`. Runs BEFORE any `declare_module`
/// (`settle_namespace_member_aliases`) so fn signatures referencing `P.Decl` in
/// type position resolve correctly. The full `namespace_exports` table (built
/// later from `decl_types`) is only used for value-position field access via
/// `field.vader::try_namespace_field`. Every module needs it: the
/// whole-program lowerer lowers imported bodies too, so their fn signatures can
/// reference `P.Decl` namespace-qualified types that must resolve here instead
/// of degrading to `?`. Plain (non-namespace) imports still resolve via
/// `imports_to` + `alias_types` and don't need this.
///
/// The member maps are cached by target `mod_id`, so a module namespace-imported
/// by N others has its map built once, not N times. The table is keyed by the
/// project-global id of each namespace binding, so one serves every module.
share_namespace_member_types :: fn(
    targets: ImportTargetTable,
    project: LoadedProject,
    per_module: MutableMap<string, TypedProgram>,
) -> void {
    member_cache :: MutableMap<string, MutableMap<string, Type>> {}
    members :: MutableMap<i32, MutableMap<string, Type>> {}
    for [sym_id, mod_id] in targets.namespace_targets {
        members[sym_id] = build_namespace_type_members(mod_id, project, per_module, member_cache)
    }
    for [_, typed] in per_module {
        typed.resolved.namespace_member_types = members
    }
}

// The companion of `share_namespace_member_types` : each namespace binding's set
// of the target's PRIVATE member names, so a `P.private` access can be told apart
// from a genuinely-absent member and fire R2008.
share_namespace_private_members :: fn(
    targets: ImportTargetTable,
    project: LoadedProject,
    per_module: MutableMap<string, TypedProgram>,
) -> void {
    private_cache :: MutableMap<string, MutableMap<string, bool>> {}
    privates :: MutableMap<i32, MutableMap<string, bool>> {}
    for [sym_id, mod_id] in targets.namespace_targets {
        privates[sym_id] = build_namespace_private_names(mod_id, project, private_cache)
    }
    for [_, typed] in per_module {
        typed.resolved.namespace_private_members = privates
    }
}

// PRIVATE (non-`export`) member names of `mod_id`, as a name→true set. Read at
// namespace-member access sites (`field.vader`, `type_expr.vader`) to fire R2008
// on `P.private` instead of degrading to unresolved. Visibility lives on the
// collected Symbol (`add_fn`/`add_named` carry the decl's `visibility`).
build_namespace_private_names :: fn(
    mod_id: string,
    project: LoadedProject,
    cache: MutableMap<string, MutableMap<string, bool>>,
) -> MutableMap<string, bool> {
    hit :: cache[mod_id]
    if hit !is null {
        return hit
    }
    out :: MutableMap<string, bool> {}
    loaded :: project.modules[mod_id] ?? return out
    for [name, sym] in loaded.collected.symbols {
        if sym.visibility == .Private {
            out[name] = true
        }
    }
    // An import binding of the module is its own, never a member : `P.name`
    // naming one is as unreachable as an unexported declaration.
    for imports in loaded.collected.files {
        for [name, _] in imports.bindings {
            if loaded.collected.symbols[name] == null {
                out[name] = true
            }
        }
    }
    cache[mod_id] = out
    return out
}

build_namespace_type_members :: fn(
    mod_id: string,
    project: LoadedProject,
    per_module: MutableMap<string, TypedProgram>,
    cache: MutableMap<string, MutableMap<string, Type>>,
) -> MutableMap<string, Type> {
    hit :: cache[mod_id]
    if hit !is null {
        return hit
    }
    out :: MutableMap<string, Type> {}
    loaded :: project.modules[mod_id] ?? return out
    target_typed :: per_module[mod_id]
    for [name, sym] in loaded.collected.symbols {
        // Exported types only — see `build_namespace_exports`. A private type
        // is not reachable as `P.PrivateType`.
        if sym.visibility == .Private {
            continue
        }
        // TypeAlias resolves to the alias's expanded union (already
        // registered in the project's alias table by `register_aliases`).
        // Other type-kind symbols resolve via
        // `type_from_symbol`, which dispatches on `sym.kind`.
        if target_typed !is null {
            aliased :: target_typed.resolved.alias_types[sym.id]
            if aliased !is null {
                out[name] = aliased
                continue
            }
        }
        if is_type_kind(sym.kind) {
            out[name] = type_from_symbol(sym, [])
        }
    }
    cache[mod_id] = out
    return out
}

lookup_external_type :: fn(
    st: SymbolTarget,
    per_module: MutableMap<string, TypedProgram>,
) -> Type | null {
    typed :: per_module[st.module_id] ?? return null
    declared :: typed.decl_types[st.symbol.id]
    if declared !is null {
        return declared
    }
    return typed.resolved.alias_types[st.symbol.id]
}

/// How `walk_bodies` treats fn bodies that don't need return inference.
WalkMode :: enum(u8) {
    /// Type-check every body — populate `expr_types`, materialise stdlib fns.
    Full,
    /// Settle returns only : walk ONLY `needs_return_inference` fns to patch
    /// their return into `decl_types` ; skip every other body (its return is
    /// already final). Used by `settle_external_expr_bodied_returns` + the
    /// forward-reference throwaway re-walks. Valid ONLY where a following
    /// `Full` walk resets/overwrites `expr_types` — see the `walk_fn_body`
    /// contract.
    ReturnsOnly,
}

/// Walk every fn / const body in `decls` and type-check it. Skips
/// extern / abstract decls (no body). For ConstDecls without an
/// annotation, types the value expression and back-fills the const's
/// declared type (post `default_if_free`) so `IdentExpr` lookups
/// against it return a concrete type. A `Full` walk ends with the free
/// literals past their default (`report_literals_past_default`).
walk_bodies :: fn(
    decls: AST.Decl[],
    typed: TypedProgram,
    diags: Diagnostic[],
    mode: WalkMode,
) -> void {
    // Pre-pass : the member declarations and the checks of every impl of the
    // module, before any fn body is walked, so a body that references an impl
    // member declared later in file order resolves. The impl tables are filled
    // before any walk (`register_project_impls`).
    for decl in decls {
        if decl is AST.ImplDecl {
            declare_and_check_impl(decl, typed, diags)
        }
    }
    // A const is typed at its turn below, or at a read before it (`const_walk`).
    open_const_walk(decls, typed, diags)
    for decl in decls {
        match decl {
            is AST.FnDecl        -> {
                walk_fn_body(decl, typed, diags, mode)
            }
            is AST.ConstDecl     -> {
                settle_with_reads(decl, typed)
            }
            is AST.AssertDecl    -> {
                check_expr(decl.condition, null, typed, diags)
            }
            // Its field defaults are typed below, once every const has its type.
            is AST.StructDecl    -> {}
            is AST.ImplDecl      -> {
                // The member declarations and the checks ran in the pre-pass
                // (`declare_and_check_impl`) so forward references resolve ;
                // only the member bodies remain to walk here.
                typed.enclosing_impl = decl.span.hash()
                for m in decl.members {
                    walk_fn_body(m, typed, diags, mode)
                }
                typed.enclosing_impl = 0
            }
            is AST.EnumDecl      -> { check_variant_data(decl, typed, diags) }
            // Body-less decl kinds — nothing to walk. Listed explicitly (not
            // `_`) so a new Decl variant trips T3013 and forces a decision.
            is AST.TraitDecl     -> {}
            is AST.TypeAliasDecl -> {}
            is AST.ImportDecl    -> {}
        }
    }
    fill :: DefaultFill {}
    for decl in decls {
        if decl is AST.StructDecl {
            check_field_defaults(decl, typed, diags)
            if mode == .Full {
                reject_default_cycle(decl, fill, typed, diags)
            }
        }
    }
    if mode == .Full {
        report_literals_past_default(typed, diags)
    }
    settle_fn_references(typed, diags)
    zonk_module_tables(typed)
}

// Type each field's default against the field's declared type (`delta: isize = -1`
// types the `-1` as `isize`, not `{integer}`) and check that it fits. Runs after
// the bodies, so a const declared below the struct has its type.
check_field_defaults :: fn(
    decl: AST.StructDecl, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    sym :: symbol_declared_at(typed.resolved, decl.name_span) ?? return
    for f in decl.fields {
        dv :: f.default ?? continue
        field_ty :: resolved_field_type(sym.id, decl, f.name, typed, diags) ?? continue
        got :: check_expr(dv, field_ty, typed, diags)
        emit_mismatch_if(got, field_ty, f.span, dv, .TypeMismatch, typed, diags)
    }
}

// Every array type shares the impls `T[] implements<T> …` writes, and a concrete
// array (`i32[]`, `MonType[]`) adds its own, which win for it. An element built
// from a type parameter without being one (`T[][]`, `[T, i32][]`) would be a second
// generic impl on arrays, overlapping `T[]`.
is_refused_array_impl :: fn(t: Type) =
    t is ArrayType && t.element !is TypeParamType && type_contains_type_param(t)

// Declare the members of an impl block of this module and check it: the member
// parameter types, the impl diagnostics. Runs in `walk_bodies`' pre-pass so a
// forward reference from an earlier fn body resolves. The impl tables are not
// written here (`register_project_impls`), nor the member bodies walked (the main
// pass does).
declare_and_check_impl :: fn(
    id: AST.ImplDecl,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    for_ty :: type_from_expr(id.for_type, typed.resolved, diags)
    if is_refused_array_impl(for_ty) {
        diags.push(
            typecheck_error(
                .ArrayImplPartlyGeneric,
                id.for_type.span,
                "`${display_type(for_ty)}` — write the impl on `T[]` or on a concrete array",
            ),
        )
        return
    }
    trait_sym :: impl_trait_symbol(id, typed.resolved) ?? return
    trait_key :: trait_key_of(trait_sym)
    if trait_key == core_trait_key(TRAIT_INTO) {
        if id.trait_args.len() == 1 {
            target_ty :: type_from_expr(id.trait_args[0], typed.resolved, diags)
            if equals_type(for_ty, target_ty) {
                diags.push(
                    typecheck_error(
                        .IntoIdentityForbidden,
                        id.span,
                        "`${display_type(for_ty)} implements Into<${display_type(target_ty)}>`"
                            + " — source and target must differ",
                    ),
                )
            }
        }
    }
    trait_decl :: typed.trait_decls[trait_sym.id]
    for m in id.members {
        declare_impl_method_for_trait(m, for_ty, lookup_trait_method(trait_decl, m.name), typed, diags)
    }
    check_impl_members(id, trait_sym, for_ty, typed, diags)
}

// An impl's own type parameters, as the parameters of the struct it is written
// for : `Box<U> implements<U> …` gives `U ↦ T` for `Box :: struct<T>`. Empty for any
// other receiver ; an impl written for one instance binds none.
impl_params_as_struct_params :: fn(for_ty: Type, typed: TypedProgram) -> MutableMap<i32, Type> {
    bindings :: MutableMap<i32, Type> {}
    if for_ty !is StructType {
        return bindings
    }
    decl :: typed.struct_decls[for_ty.symbol.id] ?? return bindings
    declared :: declared_type_args(decl.type_params, typed) ?? return bindings
    unify_type_param(for_ty, mk_struct(for_ty.symbol, declared), bindings)
    return bindings
}

// A member's signature read in the struct's own parameters (`as_struct` renames the
// impl's to them) : a parameter the signature quantifies over stays quantified,
// under the struct's name, so a static call (`Bag.make(1)`) still instantiates it.
in_struct_frame :: fn(member_ty: FnType, as_struct: MutableMap<i32, Type>) -> FnType {
    if as_struct.is_empty() {
        return member_ty
    }
    quantifier: TypeParamType[]: []
    for tp in member_ty.type_params {
        quantifier.push(renamed_param(tp, as_struct))
    }
    return FnType { ...substitute_fn_map(member_ty, as_struct), .type_params = quantifier }
}

// `tp` under the struct's name for it, or as is when `as_struct` does not rename it.
renamed_param :: fn(tp: TypeParamType, as_struct: MutableMap<i32, Type>) -> TypeParamType {
    to :: as_struct[tp.symbol.id]
    if to is TypeParamType {
        return to
    }
    return tp
}

walk_fn_body :: fn(
    fd: AST.FnDecl,
    typed: TypedProgram,
    diags: Diagnostic[],
    mode: WalkMode,
) -> void {
    // SAM short-impl synthetics carry no real body to type ; skip them.
    // Default-method clones are also `materialized` but DO need typing —
    // the resolver bound their `self`, and their body's expr_types feed
    // the lowerer (otherwise every node lands on `:?`).
    if fd.materialized && fd.sam_synthetic                 { return }
    // Return-only mode (the `settle_external_expr_bodied_returns` passes + the
    // import-loop / entry throwaway re-walks). Their sole job is to settle
    // expression-bodied fn returns into `decl_types` — and only
    // `needs_return_inference` fns ever call `patch_fn_return_type`
    // (stmt.vader). Every other fn's return is already final from
    // `declare_module`, so walking its body re-does full inference for
    // nothing. Skip it.
    //
    // CONTRACT: use `.ReturnsOnly` ONLY from a walk whose `expr_types` is
    // reset or fully overwritten by a following `.Full` walk. The always-full
    // walk that follows (settle pass 0 / the real import walk) re-types every
    // body, populates `expr_types`, and materialises stdlib fns — so skipping
    // bodies here is byte-identical. A non-reset return-only walk would
    // silently leave every skipped body at `:?` (lowerer → degraded bytecode,
    // no error).
    if mode == .ReturnsOnly && !needs_return_inference(fd) { return }
    if fd.body is AST.BlockExpr as body {
        check_fn_body(fd, body, typed, diags)
    }
}

// T3036 : report every trait member the impl doesn't provide, unless the trait
// declares a default body for it. T3094 : report every impl member the trait does
// not declare — an impl block adds no method of its own to the type. The SAM short
// form names none of its own ; R2016 reports a trait it cannot fill.
check_impl_members :: fn(
    id: AST.ImplDecl,
    trait_sym: Symbol,
    for_ty: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    trait_decl :: typed.trait_decls[trait_sym.id] ?? return
    // Resolved again by `record_impl_members`, which reports what fails.
    trait_args :: written_type_args(id.trait_args, typed.resolved, [])
    trait_type :: TraitType { .symbol = trait_sym, .args = trait_args }
    for member in id.members {
        trait_method :: lookup_trait_method(trait_decl, member.name)
        if trait_method != null {
            check_member_signature(member, trait_method, trait_type, for_ty, typed, diags)
        } else if !member.sam_synthetic {
            diags.push(
                typecheck_error(
                    .ImplMemberNotInTrait,
                    member.name_span,
                    "`${member.name}` is not a member of `${id.trait_name}`",
                ),
            )
        }
    }
    for required in trait_decl.members {
        if required.body is null {
            if !impl_has_method(id, required.name) {
                diags.push(
                    typecheck_error(
                        .ImplMissingRequiredMethod,
                        id.trait_name_span,
                        "`${id.trait_name}` requires method `${required.name}`"
                            + " — not provided in this impl block",
                    ),
                )
            }
        }
    }
}

// T3095 — `member` must have its trait method's signature, as `trait_type` gives it
// (its arguments, then the defaults) with `Self` read as `for_ty` : the same number of
// parameters, each of the same type, and the same return type. The vtable slot and
// the direct call both assume this shape. A generic trait method is held to its arity
// alone, its own type parameters being the impl's to name. A SAM member and a
// default-method clone copy the trait's signature.
check_member_signature :: fn(
    member: AST.FnDecl,
    trait_method: AST.FnDecl,
    trait_type: TraitType,
    for_ty: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    if member.sam_synthetic || member.materialized {
        return
    }
    want_count :: trait_method.params.len()
    if member.params.len() != want_count {
        detail :: "`${member.name}`: expected ${want_count} parameter(s), got ${member.params.len()}"
        diags.push(typecheck_error(.ImplMemberSignatureDiffers, member.name_span, detail))
        return
    }
    if trait_method.type_params.len() > 0 {
        return
    }
    want :: try_trait_method(trait_type, member.name, typed, for_ty) ?? return
    got :: typed.impl_method_decl_types[member.name_span.hash()]
    if want !is FnType || got !is FnType {
        return
    }
    // `want` has no receiver ; `got` keeps the impl's `self`.
    skip :: receiver_count(trait_method)
    for i in 0..<want.params.len() {
        param :: member.params[i + skip]
        have :: got.params[i + skip]
        if !equals_type(want.params[i], have) {
            detail :: "`${member.name}` parameter `${param.name}`: ${expected_got(want.params[i], have)}"
            diags.push(typecheck_error(.ImplMemberSignatureDiffers, param.span, detail))
        }
    }
    if !equals_type(want.return_type, got.return_type) {
        detail :: "`${member.name}` return: ${expected_got(want.return_type, got.return_type)}"
        diags.push(typecheck_error(.ImplMemberSignatureDiffers, member.name_span, detail))
    }
}

// `expected X, got Y` over two types.
expected_got :: fn(want: Type, got: Type) -> string =
    "expected `${display_type(want)}`, got `${display_type(got)}`"

lookup_trait_method :: fn(td: AST.TraitDecl | null, name: string) -> AST.FnDecl | null {
    if td is null {
        return null
    }
    for m in td.members {
        if m.name == name {
            return m
        }
    }
    return null
}

impl_has_method :: fn(id: AST.ImplDecl, name: string) -> bool {
    for m in id.members {
        if m.name == name {
            return true
        }
    }
    return false
}

/// UFCS-bound method type : `fn(self, ...rest) -> R` becomes `fn(...rest) -> R`,
/// since the receiver binds `self` at the call site. Always returns a type — a
/// member with no params, or whose first param isn't `self`, just keeps them all.
///
/// @param impl_         the impl block, whose type parameters the signature
///                      quantifies over with the member's own.
/// @param fd            the impl member.
/// @param for_ty        the impl block's for-type, substituted into each param.
/// @param trait_method  the matching trait signature, when the impl is for a
///                      trait ; supplies the return type the member elides.
/// @return              the receiver-dropped fn type stored in `impl_methods`.
ufcs_method_type :: fn(
    impl_: AST.ImplDecl,
    fd: AST.FnDecl,
    for_ty: Type,
    trait_method: AST.FnDecl | null,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> FnType {
    rest: Type[]: []
    for i in receiver_count(fd)..<fd.params.len() {
        rest.push(param_type(fd.params[i], for_ty, typed, diags))
    }
    ret :: declare_impl_return(fd, for_ty, trait_method, typed, diags)
    return mk_fn(rest, ret, impl_member_quantifier(impl_, fd, typed.resolved))
}

// The parameters an impl member quantifies over : the enclosing impl's, then its
// own `<…>`. A receiver binds the impl's (`substitute_impl_method`) ; a static
// call binds them at the call, as its own.
impl_member_quantifier :: fn(
    impl_: AST.ImplDecl, fd: AST.FnDecl, resolved: ResolvedModule,
) -> TypeParamType[] {
    of_impl :: impl_type_params_of(impl_, resolved)
    if fd.type_params.len() == 0 {
        return of_impl
    }
    return of_impl + quantifier_of(fd.type_params, resolved)
}

/// Pre-walk an impl method's signature so `self` resolves to the impl block's
/// for-type and the rest of the params take their annotated types. Results land
/// in `param_types` (per-param, span-keyed) and `impl_method_decl_types` (the
/// whole `FnType`, keyed by the member's `name_span` — impl members are not in
/// `resolved.symbols`), so `infer_ident` / `check_fn_body` see concrete types.
///
/// @param fd            the impl member.
/// @param for_ty        the impl block's for-type — what `self` resolves to.
/// @param trait_method  the matching trait signature, when the impl is for a
///                      trait ; supplies the return type the member elides.
declare_impl_method_for_trait :: fn(
    fd: AST.FnDecl,
    for_ty: Type,
    trait_method: AST.FnDecl | null,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    params: Type[]: []
    for p in fd.params {
        pt :: param_type(p, for_ty, typed, diags)
        typed.param_types[p.span.hash()] = pt
        params.push(pt)
    }
    ret :: declare_impl_return(fd, for_ty, trait_method, typed, diags)
    // Impl methods aren't in `resolved.symbols` (they're members of
    // an ImplDecl, not top-level names) — use the dedicated span-keyed
    // table.
    typed.impl_method_decl_types[fd.name_span.hash()] = mk_fn(params, ret)
}

declare_impl_return :: fn(
    fd: AST.FnDecl,
    for_ty: Type,
    trait_method: AST.FnDecl | null,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type {
    // An unannotated member takes the trait method's return type, with `Self`
    // substituted to `for_ty`: `Direction implements Turnable { turn_left :: fn(self) = … }`
    // picks up `-> Self` from `Turnable.turn_left`.
    if fd.return_type == null && trait_method !is null {
        written :: trait_method.return_type
        if written !is null {
            return type_with_self(written, for_ty, typed.resolved, diags)
        }
    }
    // A written `-> Self` names `for_ty` too.
    declared :: fd.return_type ?? return declare_fn_return(fd, typed.resolved, diags)
    return type_with_self(declared, for_ty, typed.resolved, diags)
}

param_type :: fn(
    p: AST.FnParam,
    for_ty: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type {
    if p.ty == null {
        if p.name == "self" {
            return for_ty
        }
        return TY_UNRESOLVED
    }
    // Substitute `Self` → `for_ty` so an explicit `Self`-typed param (e.g.
    // `Comparable.compare(self, other: Self)`) records the concrete carrier
    // — otherwise the impl method's type keeps `other: Self`, and a default-
    // method clone calling it with its own `other` (already substituted to
    // `for_ty`) mismatches `expected Self, got <for_ty>`.
    return type_with_self(p.ty, for_ty, typed.resolved, diags)
}

check_const_value :: fn(cd: AST.ConstDecl, typed: TypedProgram, diags: Diagnostic[]) -> void {
    sym :: symbol_declared_at(typed.resolved, cd.name_span) ?? return
    // Only a written type is the expected type. An unannotated const's entry is what
    // an earlier walk inferred — a return-only walk types it before the expression-
    // bodied fns it calls have their return, and would pin it to `?`.
    annot :: if cd.ty == null { null } else { typed.decl_types[sym.id] }
    if is_type_expr(cd.value, typed.resolved) {
        if annot is null {
            typed.decl_types[sym.id] = TY_TYPE
        }
        alias_ty :: type_from_expr(cd.value, typed.resolved, diags)
        // Same promotion as `register_alias_const`, via `alias_for` — this
        // body-typing pass ALSO writes `alias_types`, so without it the
        // transparent backing would clobber the DistinctType earlier passes
        // registered.
        typed.resolved.alias_types[sym.id] = alias_for(sym, alias_ty, cd)
        return
    }
    got :: check_expr(cd.value, annot, typed, diags)
    typed.decl_types[sym.id] = annot ?? default_if_free(got)
}

// @partial: only type-introducing kinds are type kinds; every other SymbolKind → false.
is_type_kind :: fn(k: SymbolKind) -> bool = @partial match k {
    .Struct | .Trait | .Enum | .TypeAlias | .TypeParam | .BuiltinType -> true
    _ -> false
}
