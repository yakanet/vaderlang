// vader/typecheck/expr_generic_inst — a generic type written with its arguments in
// value position.
//
// The only such expression is the owner of a static member, `Bag<f64>.make(1)` : a
// call's own type arguments are `CallExpr.type_args`, and a struct literal's name is
// read as a type.

module "vader/typecheck"

import "vader/diagnostics"
import "vader/types"
AST :: import "toolchain/ast"

/// Type `Name<T1, T2, …>` as the instance it names.
///
/// @param e      the written instance.
/// @param typed  the module it sits in.
/// @param diags  receives what the type's arguments get wrong.
/// @return       the instance, `Bag<f64>`.
infer_generic_inst :: fn(
    e: AST.GenericInstExpr, typed: TypedProgram, diags: Diagnostic[],
    check_expr_fn: fn(AST.Expr, Type | null, TypedProgram, Diagnostic[]) -> Type,
) -> Type {
    check_expr_fn(e.callee, null, typed, diags)
    return type_from_expr(e, typed.resolved, diags)
}
