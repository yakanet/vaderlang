// vader/typecheck/expr_generic_inst — a generic written with its arguments in value
// position.
//
// Two such expressions : the owner of a static member, `Bag<f64>.make(1)`, and a
// generic function as a value, `id<i32>`. A call's own type arguments are
// `CallExpr.type_args`, and a struct literal's name is read as a type.

module "vader/typecheck"

import "vader/support/diagnostics"
import "vader/types"
AST :: import "toolchain/ast"

/// Type `Name<T1, T2, …>` as the instance it names.
///
/// @param e         the written instance.
/// @param expected  the slot a function's instance flows into, which binds the
///                  parameters left unwritten ; null for none.
/// @param typed     the module it sits in.
/// @param diags     receives what the type's arguments get wrong.
/// @return          the instance : `Bag<f64>`, or `fn(i32) -> i32` for `id<i32>`.
infer_generic_inst :: fn(
    e: AST.GenericInstExpr, expected: Type | null, typed: TypedProgram, diags: Diagnostic[],
) -> Type {
    named :: check_keeping_quantifier(e.callee, typed, diags)
    if named is FnType && named.type_params.len() > 0 {
        return infer_fn_instance(e, named, expected, typed, diags)
    }
    return type_from_expr(e, typed.resolved, diags)
}
