// vader/typecheck/enum_pass — variant index resolution for enum decls.
//
// Walks `EnumDecl.variants` and produces the canonical `name → value` map :
// explicit `= N` values land verbatim ; bare variants take `previous + 1`
// (starting at 0). Range checking against the repr's `[min, max]` bounds
// and duplicate-value detection emit T3030 / T3031.
//
// The header's resolution is `decl.vader`'s `build_enum_type` (via
// `type_from_expr`). This file handles only what needs no type-expression
// machinery : the indices, the narrowest width they fit, and the span an
// enum with variant data may cover.

module "vader/typecheck"

import "std/collections"
import "vader/diagnostics"
import "vader/integer"
import "toolchain/ast"
import "vader/parser"
import "vader/types"
import "toolchain/span"

/// Compute the canonical `name → value` map for `decl`. `repr` is the
/// already-resolved backing type name (e.g. `"i32"`, `"u8"`) ; pass
/// `"i64"` when the source wrote none — the width is then inferred from
/// the indices.
///
/// Side effects : pushes T3030 (out-of-range) and T3031 (duplicate value)
/// onto `diags`. The map still includes every variant even on error so
/// downstream phases don't cascade with "unknown variant" noise.
resolve_enum_indices :: fn(
    decl: EnumDecl, repr: string, diags: Diagnostic[],
) -> MutableMap<string, i64> {
    out :: MutableMap<string, i64> {}
    seen_values :: MutableSet<i64> {}
    values :: primitive_interval(repr)
    cursor: i64 = 0
    for variant in decl.variants {
        value :: variant.value
        v: i64: match value {
            is i64 -> value
            is null -> cursor
        }
        if values != null && (v < values.lo || v > values.hi) {
            span :: span_of_value(variant)
            diags.push(typecheck_error(
                .EnumVariantValueOutOfRange, span,
                "${v} not in [${values.lo}, ${values.hi}] for `${repr}`",
            ))
        }
        if !seen_values.add(v) {
            span :: span_of_value(variant)
            owner :: find_owner(out, v)
            diags.push(typecheck_error(
                .DuplicateEnumVariantValue, span,
                "value ${v} already used by `${owner}`",
            ))
        }
        out[variant.name] = v
        cursor = v + 1
    }
    return out
}

find_owner :: fn(out: MutableMap<string, i64>, target: i64) -> string {
    for [k, v] in out {
        if v == target { return k }
    }
    return "?"
}

// ---- inferred width -------------------------------------------------------

/// The narrowest integer holding every index in `[smallest, largest]` : unsigned when
/// none is negative.
export narrowest_width :: fn(smallest: i64, largest: i64) -> string =
    narrowest_machine_integer(interval(smallest, largest)).name

/// `[smallest, largest]` of `values` ; `[0, 0]` when there are none.
export value_bounds :: fn(values: i64[]) -> [i64, i64] {
    if values.len() == 0 {
        return [0, 0]
    }
    smallest := values[0]
    largest := values[0]
    for value in values {
        if value < smallest {
            smallest = value
        }
        if value > largest {
            largest = value
        }
    }
    return [smallest, largest]
}

// ---- variant data -----------------------------------------------------------

/// Type-check each variant's `{ .f = v }` block against the data struct the
/// enum's header declares, exactly as a struct literal of that struct.
///
/// @param decl  the enum declaration.
/// @error       T3085 for a block on an enum whose header declares no data ;
///              T3037 for a variant, with or without a block, that leaves a
///              required field unset.
check_variant_data :: fn(decl: EnumDecl, typed: TypedProgram, diags: Diagnostic[]) -> void {
    data :: declared_enum_data(decl, typed)
    if data == null {
        for v in decl.variants {
            if v.data !is null {
                diags.push(typecheck_error(.VariantDataWithoutEnumData, v.span, "`${v.name}`"))
            }
        }
        return
    }
    for v in decl.variants {
        items: StructLitItem[]: v.data ?? []
        check_struct_items(items, v.span, data, typed, diags)
    }
    reject_variant_data_reference(decl, data, typed, diags)
}

// T3096: variant data is a constant table every read shares (ADR 0034), and the
// effect summary does not follow it: a field holding a reference would hand that
// table out to be written. Values only: numbers, strings, enums.
reject_variant_data_reference :: fn(
    decl: EnumDecl, data: StructType, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    fields :: typed.struct_field_types[data.symbol.id] ?? return
    for [name, t] in fields {
        if !is_value_only_type(t) {
            detail :: "the data of `${decl.name}` holds `${name}: " +
                "${display_type(t)}`, which every read of it would share"
            diags.push(typecheck_error(.VariantDataHoldsReference, decl.name_span, detail))
            return
        }
    }
}

/// The struct the enum `decl` keeps its variant data in, as `build_enum_type`
/// recorded it ; null when it has none.
///
/// @param decl   an enum declaration of the module `typed` checks.
/// @param typed  the module, whose types hold the enum's.
export declared_enum_data :: fn(decl: EnumDecl, typed: TypedProgram) -> StructType | null {
    t :: declared_type_at(typed, decl.name_span)
    if t is EnumType {
        return t.data
    }
    return null
}

// ---- variant spans ------------------------------------------------------

// Where a variant's value is written, or the variant itself when it has none.
span_of_value :: fn(v: EnumVariant) -> Span {
    match v.value_span as s {
        is null -> { return v.span }
        is Span -> { return s }
    }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

expect_index :: fn(indices: MutableMap<string, i64>, name: string, want: i64) -> void {
    hit :: indices[name]
    match hit {
        is null -> { assert(false, "missing index for ${name}") }
        is i64 -> { assert_eq(hit, want) }
    }
}

@test
test_implicit_indices_count_from_zero :: fn() -> void {
    src :: """
Color :: enum {
    Red
    Green
    Blue
}
"""
    parsed :: parse_source(src, "t.vader")
    enum_decl :: find_enum(parsed.program.decls, "Color")
    match enum_decl {
        is null -> { assert(false, "Color enum should parse") }
        is EnumDecl -> {
            diags: Diagnostic[]: []
            indices :: resolve_enum_indices(enum_decl, "i32", diags)
            expect_index(indices, "Red",   0)
            expect_index(indices, "Green", 1)
            expect_index(indices, "Blue",  2)
            assert_eq(diags.len(), 0)
        }
    }
}

@test
test_explicit_value_resets_cursor :: fn() -> void {
    src :: """
Flag :: enum {
    A = 5
    B
    C = 100
    D
}
"""
    parsed :: parse_source(src, "t.vader")
    enum_decl :: find_enum(parsed.program.decls, "Flag")
    match enum_decl {
        is null -> { assert(false, "Flag enum should parse") }
        is EnumDecl -> {
            diags: Diagnostic[]: []
            indices :: resolve_enum_indices(enum_decl, "i32", diags)
            expect_index(indices, "A",   5)
            expect_index(indices, "B",   6)
            expect_index(indices, "C", 100)
            expect_index(indices, "D", 101)
        }
    }
}

@test
test_duplicate_value_emits_T3031 :: fn() -> void {
    src :: """
Bad :: enum {
    A = 1
    B = 1
}
"""
    parsed :: parse_source(src, "t.vader")
    enum_decl :: find_enum(parsed.program.decls, "Bad")
    match enum_decl {
        is null -> { assert(false, "Bad enum should parse") }
        is EnumDecl -> {
            diags: Diagnostic[]: []
            resolve_enum_indices(enum_decl, "i32", diags)
            assert_eq(diags.len(), 1)
            assert_eq(diags[0].code.id, "T3031")
        }
    }
}

@test
test_out_of_range_emits_T3030 :: fn() -> void {
    src :: """
Overflow :: enum {
    A = 999
}
"""
    parsed :: parse_source(src, "t.vader")
    enum_decl :: find_enum(parsed.program.decls, "Overflow")
    match enum_decl {
        is null -> { assert(false, "Overflow enum should parse") }
        is EnumDecl -> {
            diags: Diagnostic[]: []
            resolve_enum_indices(enum_decl, "u8", diags)
            assert_eq(diags.len(), 1)
            assert_eq(diags[0].code.id, "T3030")
        }
    }
}

find_enum :: fn(decls: Decl[], name: string) -> EnumDecl | null {
    for d in decls {
        if d is EnumDecl {
            if d.name == name {
                return d
            }
        }
    }
    return null
}
