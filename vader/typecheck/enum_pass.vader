// vader/typecheck/enum_pass — variant index resolution for enum decls.
//
// Walks `EnumDecl.variants` and produces the canonical `name → value` map :
// explicit `= N` values land verbatim ; bare variants take `previous + 1`
// (starting at 0). Range checking against the repr's `[min, max]` bounds
// and duplicate-value detection emit T3030 / T3031.
//
// The header's resolution is `decl.vader`'s `build_enum_type` (via
// `type_from_expr`). This file handles only what needs no type-expression
// machinery : the indices, the narrowest width they fit, and the span an
// enum with variant data may cover.

module "vader/typecheck"

import "std/collections"
import "vader/diagnostics"
import "toolchain/ast"
import "vader/parser"
import "vader/types"
import "toolchain/span"

/// Compute the canonical `name → value` map for `decl`. `repr` is the
/// already-resolved backing type name (e.g. `"i32"`, `"u8"`) ; pass
/// `"i64"` when the source wrote none — the width is then inferred from
/// the indices.
///
/// Side effects : pushes T3030 (out-of-range) and T3031 (duplicate value)
/// onto `diags`. The map still includes every variant even on error so
/// downstream phases don't cascade with "unknown variant" noise.
export resolve_enum_indices :: fn(
    decl: EnumDecl, repr: string, diags: Diagnostic[]!,
) -> MutableMap<string, i64> {
    out :: MutableMap<string, i64> {}
    seen_values :: MutableSet<i64> {}
    range :: repr_range(repr)
    cursor: i64 = 0
    for variant in decl.variants {
        value :: variant.value
        v: i64: match value {
            is i64 -> value
            is null -> cursor
        }
        if !range.contains(v) {
            span :: span_of_value(variant)
            diags.push(typecheck_error(
                .EnumVariantValueOutOfRange, span,
                "${v} not in [${range.min}, ${range.max}] for `${repr}`",
            ))
        }
        if !seen_values.add(v) {
            span :: span_of_value(variant)
            owner :: find_owner(out, v)
            diags.push(typecheck_error(
                .DuplicateEnumVariantValue, span,
                "value ${v} already used by `${owner}`",
            ))
        }
        out[variant.name] = v
        cursor = v + 1
    }
    return out
}

find_owner :: fn(out: MutableMap<string, i64>, target: i64) -> string {
    for [k, v] in out {
        if v == target { return k }
    }
    return "?"
}

// ---- inferred width and data range ----------------------------------------

/// Most values an enum with variant data may span : its data is a table with
/// one slot per value between the smallest and the largest.
export ENUM_DATA_MAX_SLOTS: i64: 4096

/// The narrowest integer holding every index in `[lo, hi]` : unsigned when
/// none is negative.
export narrowest_repr :: fn(lo: i64, hi: i64) -> string {
    candidates :: if lo >= 0 { ["u8", "u16", "u32"] } else { ["i8", "i16", "i32"] }
    for name in candidates {
        range :: repr_range(name)
        if range.contains(lo) && range.contains(hi) {
            return name
        }
    }
    // The 64-bit width holds every index the parser can carry.
    return if lo >= 0 { "u64" } else { "i64" }
}

/// Report T3086 when the indices `[lo, hi]` of an enum with variant data span
/// more than `ENUM_DATA_MAX_SLOTS` values.
export check_data_range :: fn(decl: EnumDecl, lo: i64, hi: i64, diags: Diagnostic[]!) -> void {
    if span_fits(lo, hi) {
        return
    }
    diags.push(typecheck_error(.EnumDataRangeTooWide, decl.name_span,
        "values ${lo} to ${hi}, at most ${ENUM_DATA_MAX_SLOTS} ; carry the value in a field instead"))
}

// `hi - lo < ENUM_DATA_MAX_SLOTS`, without overflowing : bounds of the same
// sign subtract safely, and bounds of opposite signs are only compared once
// each is known to lie within the cap of zero.
span_fits :: fn(lo: i64, hi: i64) -> bool {
    if lo < 0 && hi >= 0 && (lo <= -ENUM_DATA_MAX_SLOTS || hi >= ENUM_DATA_MAX_SLOTS) {
        return false
    }
    return hi - lo < ENUM_DATA_MAX_SLOTS
}

/// `[smallest, largest]` index ; `[0, 0]` for an enum without variants.
export index_bounds :: fn(indices: MutableMap<string, i64>) -> [i64, i64] {
    lo: i64 = 0
    hi: i64 = 0
    first := true
    for [_, v] in indices {
        if first || v < lo {
            lo = v
        }
        if first || v > hi {
            hi = v
        }
        first = false
    }
    return [lo, hi]
}

// ---- variant data -----------------------------------------------------------

/// Type-check each variant's `{ .f = v }` block against the data struct the
/// enum's header declares, exactly as a struct literal of that struct.
///
/// @param decl           the enum declaration.
/// @param check_expr_fn  the expression checker the body walk runs under.
/// @error                T3085 for a block on an enum whose header declares no
///                       data ; T3037 for a variant, with or without a block,
///                       that leaves a required field unset.
export check_variant_data :: fn(
    decl: EnumDecl, typed: TypedProgram!, diags: Diagnostic[]!,
    check_expr_fn: fn(Expr!, Type | null, TypedProgram!, Diagnostic[]!) -> Type,
) -> void {
    data :: declared_enum_data(decl, typed)
    if data == null {
        for v in decl.variants {
            if v.data !is null {
                diags.push(typecheck_error(.VariantDataWithoutEnumData, v.span, "`${v.name}`"))
            }
        }
        return
    }
    for v in decl.variants {
        items: StructLitItem![]: v.data ?? []
        check_struct_items(items, v.span, data, typed, diags, check_expr_fn)
    }
}

// The data struct `build_enum_type` recorded for `decl` ; null when it has none.
declared_enum_data :: fn(decl: EnumDecl, typed: TypedProgram) -> StructType | null {
    sym :: lookup_sym_by_name(typed.resolved, decl.name) ?? return null
    t :: typed.decl_types[sym.id] ?? return null
    return if t is EnumType { t.data } else { null }
}

// ---- repr ranges ----------------------------------------------------------

/// Inclusive `[min, max]` integer range for a backing primitive.
/// `contains(v)` returns true when v lands in the range (or always-true
/// when the repr isn't an integer — defensive fallback).
export ReprRange :: struct {
    min: i64
    max: i64
    /// True when the range is meaningful. False for non-integer reprs
    /// (which shouldn't reach this pass — repr validation already
    /// rejects them via T3029).
    has_bounds: bool
}

contains :: fn(self: ReprRange, v: i64) -> bool {
    if !self.has_bounds { return true }
    return self.min <= v && v <= self.max
}

// Inclusive `[min, max]` value range of a backing integer primitive, DERIVED
// from its width + signedness (`vader/types::PRIMITIVE_META`) rather than a
// per-width name table. Signed n-bit = `[-2^(n-1), 2^(n-1)-1]`; unsigned =
// `[0, 2^n-1]`. The 64-bit widths (i64/isize + u64/usize) clamp `max` to
// `i64.MAX`: values above it can't be carried in the AST. That clamp is a
// typecheck-local decision, which is why the bounds live here and not in the
// leaf `vader/types` (only the universal `size` / `is_signed` do).
repr_range :: fn(repr: string) -> ReprRange {
    m :: primitive_meta(repr)
    if m == null  { return ReprRange { .min = 0, .max = 0, .has_bounds = false } }
    if !m.is_int  { return ReprRange { .min = 0, .max = 0, .has_bounds = false } }
    if m.size >= 8 {
        lo: i64: if m.is_signed { -9_223_372_036_854_775_808 } else { 0 }
        return ReprRange { .min = lo, .max = 9_223_372_036_854_775_807, .has_bounds = true }
    }
    bits :: m.size * 8
    if m.is_signed {
        half :: pow2_i64(bits - 1)
        return ReprRange { .min = -half, .max = half - 1, .has_bounds = true }
    }
    return ReprRange { .min = 0, .max = pow2_i64(bits) - 1, .has_bounds = true }
}

// 2^k as an i64 (k ≤ 32 here — narrower integer widths only; the 64-bit widths
// are handled above without ever computing 2^64).
pow2_i64 :: fn(k: i64) -> i64 {
    r: i64 = 1
    for _ in 0..<k { r = r * 2 }
    return r
}

span_of_value :: fn(v: EnumVariant) -> Span {
    match v.value_span as s {
        is null -> { return v.span }
        is Span -> { return s }
    }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

expect_index :: fn(indices: MutableMap<string, i64>, name: string, want: i64) -> void {
    hit :: indices[name]
    match hit {
        is null -> { assert(false, "missing index for ${name}") }
        is i64 -> { assert_eq(hit, want) }
    }
}

@test
test_implicit_indices_count_from_zero :: fn() -> void {
    src :: """
Color :: enum {
    Red
    Green
    Blue
}
"""
    parsed :: parse_source(src, "t.vader")
    enum_decl :: find_enum(parsed.program.decls, "Color")
    match enum_decl {
        is null -> { assert(false, "Color enum should parse") }
        is EnumDecl -> {
            diags: Diagnostic[]!: []
            indices :: resolve_enum_indices(enum_decl, "i32", diags)
            expect_index(indices, "Red",   0)
            expect_index(indices, "Green", 1)
            expect_index(indices, "Blue",  2)
            assert_eq(diags.len(), 0)
        }
    }
}

@test
test_explicit_value_resets_cursor :: fn() -> void {
    src :: """
Flag :: enum {
    A = 5
    B
    C = 100
    D
}
"""
    parsed :: parse_source(src, "t.vader")
    enum_decl :: find_enum(parsed.program.decls, "Flag")
    match enum_decl {
        is null -> { assert(false, "Flag enum should parse") }
        is EnumDecl -> {
            diags: Diagnostic[]!: []
            indices :: resolve_enum_indices(enum_decl, "i32", diags)
            expect_index(indices, "A",   5)
            expect_index(indices, "B",   6)
            expect_index(indices, "C", 100)
            expect_index(indices, "D", 101)
        }
    }
}

@test
test_duplicate_value_emits_T3031 :: fn() -> void {
    src :: """
Bad :: enum {
    A = 1
    B = 1
}
"""
    parsed :: parse_source(src, "t.vader")
    enum_decl :: find_enum(parsed.program.decls, "Bad")
    match enum_decl {
        is null -> { assert(false, "Bad enum should parse") }
        is EnumDecl -> {
            diags: Diagnostic[]!: []
            resolve_enum_indices(enum_decl, "i32", diags)
            assert_eq(diags.len(), 1)
            assert_eq(diags[0].code.id, "T3031")
        }
    }
}

@test
test_out_of_range_emits_T3030 :: fn() -> void {
    src :: """
Overflow :: enum {
    A = 999
}
"""
    parsed :: parse_source(src, "t.vader")
    enum_decl :: find_enum(parsed.program.decls, "Overflow")
    match enum_decl {
        is null -> { assert(false, "Overflow enum should parse") }
        is EnumDecl -> {
            diags: Diagnostic[]!: []
            resolve_enum_indices(enum_decl, "u8", diags)
            assert_eq(diags.len(), 1)
            assert_eq(diags[0].code.id, "T3030")
        }
    }
}

find_enum :: fn(decls: Decl[], name: string) -> EnumDecl | null {
    for d in decls {
        if d is EnumDecl {
            if d.name == name {
                return d
            }
        }
    }
    return null
}
