// vader/typecheck/seq_lit — SeqLitExpr inference (`[e1, e2, …]`).
//
// The parser doesn't commit to "array" or "tuple" ; the typechecker
// decides via contextual disambiguation against `expected` :
//
//   - Tuple(T0..Tn-1)  → tuple, element-wise (arity must match)
//   - Array<T>         → array, every element checked against T
//   - Union(...)       → pick a Tuple variant whose arity matches,
//                        otherwise the first Array variant ; recurse
//   - no expected      → default-if-free each element, then array
//                        when they unify (single post-dedup type),
//                        tuple otherwise.

module "vader/typecheck"

import "std/math"
import "std/iter"
import "vader/diagnostics"
import "vader/types"
AST :: import "toolchain/ast"

/// Type a bracketed literal contextually : returns `Tuple(...)` when
/// `expected` is a tuple-shaped slot, `Array(...)` otherwise.
infer_seq_lit :: fn(
    e: AST.SeqLitExpr,
    expected: Type | null,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type {
    // Union → pick the most appropriate variant, then recurse.
    if expected is UnionType {
        picked :: pick_seq_variant(expected, e.elements.len())
        if picked !is null {
            return infer_seq_lit(e, picked, typed, diags)
        }
    }
    // @partial: only a tuple- or array-shaped expectation drives contextual
    // disambiguation; for every other (or absent) slot type we infer freely.
    @partial match expected {
        is TupleType -> {
            return infer_against_tuple(e, expected, typed, diags)
        }
        is ArrayType -> {
            return infer_against_array(e, expected, typed, diags)
        }
        is DistinctType -> {
            // Composite-backed distinct newtype (`f: BigInt = [1]`,
            // `p: Coord = [3, 4]`) : check the elements against the backing array /
            // tuple, but the literal's type is the nominal distinct itself, not the
            // raw composite.

            ab :: array_backing(expected)
            if ab != null {
                infer_against_array(e, ab, typed, diags)
                return expected
            }
            tb :: tuple_backing(expected)
            if tb != null {
                infer_against_tuple(e, tb, typed, diags)
                return expected
            }
            return infer_no_expected(e, typed, diags)
        }
        _ -> {
            return infer_no_expected(e, typed, diags)
        }
    }
}

// ---- per-shape -----------------------------------------------------------

infer_against_tuple :: fn(
    e: AST.SeqLitExpr,
    tup: TupleType,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type {
    if tup.elements.len() != e.elements.len() {
        diags.push(
            typecheck_error(
                .TypeMismatch,
                e.span,
                "expected ${display_type(tup)} (${tup.elements.len()} element(s)), got ${e.elements.len()}",
            ),
        )
        // Best-effort : check overlapping slots against their per-slot
        // expected types so cascading errors stay minimal.
        n :: min(tup.elements.len(), e.elements.len())
        elem_types: Type[]: []
        for i in 0..<n {
            elem_types.push(check_expr(e.elements[i], tup.elements[i], typed, diags))
        }
        for i in n..<e.elements.len() {
            elem_types.push(check_expr(e.elements[i], null, typed, diags))
        }
        return mk_tuple(default_each(elem_types))
    }
    elem_types: Type[]: []
    for i in 0..<e.elements.len() {
        slot :: tup.elements[i]
        got :: check_expr(e.elements[i], slot, typed, diags)
        // When the expected slot is a generic type-param the element
        // can't narrow against it ; default Free* so the unifier binds
        // a concrete type instead of `{integer}` / `{float}`.
        if slot is TypeParamType | InferVar {
            elem_types.push(default_if_free(got))
        }
        else {
            elem_types.push(got)
        }
    }
    // A fresh literal is built straight into the slot's element types, so when
    // every element fits its slot it takes the slot's tuple type, as an array
    // literal does (`infer_against_array`) : the invariant tuple rule
    // (`is_assignable_tuple`) then accepts the init.
    if fits_tuple_slots(elem_types, tup, typed) {
        return tup
    }
    return mk_tuple(elem_types)
}

// Whether every element type fits its slot of `tup`, a trait slot through an impl,
// none of which names a type parameter : generic inference pins those from the
// elements.
fits_tuple_slots :: fn(elem_types: Type[], tup: TupleType, typed: TypedProgram) -> bool {
    for i in 0..<elem_types.len() {
        slot :: tup.elements[i]
        if type_contains_type_param(slot) || !fits_or_implements(elem_types[i], slot, typed) {
            return false
        }
    }
    return true
}

infer_against_array :: fn(
    e: AST.SeqLitExpr,
    arr: ArrayType,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type {
    elem_types :: walk_elements(e, arr.element, typed, diags)
    if elem_types.len() == 0 {
        return arr
    }
    actual :: union_of(default_each(elem_types))
    // A fresh literal is materialised directly into the target's element
    // representation, so when its elements FIT a concrete hint element it adopts
    // that hint rather than the narrower union of its actual elements : `[1, 2,
    // 3]` against a `(i32 | string)[]` slot types as `(i32 | string)[]`. This
    // keeps the literal's type equal to the slot's, so the invariant array rule
    // (`is_assignable_array`) accepts the init without a widening, which only an
    // argument may take. Elements implementing a trait the slot names fit it too:
    // `[Circle { .r = 1 }]` into a `Shape[]`. The guard preserves the mismatch
    // diagnostic when an element does NOT fit — `xs: i32[] = ["a"]` keeps
    // `string[]` and is rejected downstream. A type-param-bearing hint is skipped
    // so generic inference still pins `T` from the actual elements (`call.vader`
    // doesn't thread such a hint here).
    if !type_contains_type_param(arr.element) && fits_or_implements(actual, arr.element, typed) {
        return arr
    }
    return mk_array(actual)
}

infer_no_expected :: fn(e: AST.SeqLitExpr, typed: TypedProgram, diags: Diagnostic[]) -> Type {
    elem_types :: walk_elements(e, null, typed, diags)
    if elem_types.len() == 0 {
        return mk_array(TY_UNRESOLVED)
    }
    widened :: default_each(elem_types)
    merged :: union_of(widened)
    // Heterogeneous elements stay UnionType → treat as a tuple. Elements that
    // all share one type are an array of it, even when that type is itself a
    // union : `[shape]` with `shape: A | B` is a `(A | B)[]`, not a 1-tuple.
    if merged is UnionType && !all_same_type(widened) {
        return mk_tuple(widened)
    }
    return mk_array(merged)
}


// ---- helpers -------------------------------------------------------------

walk_elements :: fn(
    e: AST.SeqLitExpr,
    hint: Type | null,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type[] {
    out: Type[]: []
    for el in e.elements {
        out.push(check_expr(el, hint, typed, diags))
    }
    return out
}

default_each :: fn(types: Type[]) -> Type[] = types.map((t) -> default_if_free(t)).collect()

// Same type, the rule `union_of` merges variants by.
all_same_type :: fn(types: Type[]) -> bool {
    for t in types {
        if !equals_type(t, types[0]) {
            return false
        }
    }
    return true
}

pick_seq_variant :: fn(u: UnionType, arity: usize) -> Type | null {
    for v in u.variants {
        if v is TupleType {
            if v.elements.len() == arity {
                return v
            }
        }
    }
    for v in u.variants {
        if v is ArrayType {
            return v
        }
    }
    return null
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "vader/parser"
import "vader/resolver"
import "vader/resolver/symbol"
import "toolchain/span"

accept_seq :: fn(e: AST.Expr) -> AST.Expr | null {
    if e is AST.SeqLitExpr {
        return e
    }
    return null
}

ExpectedSeq :: struct {
    typed: TypedProgram
    sl: AST.SeqLitExpr
}

expect_seq :: fn(src: string) -> ExpectedSeq {
    parsed :: parse_source(src, "t.vader")
    factory :: SymbolFactory {}
    rm :: resolve_module(parsed.program, "t", factory)
    diags: Diagnostic[]: []
    result :: check_module(parsed.program, rm, diags)
    last :: parsed.program.decls[parsed.program.decls.len() - 1]
    match last {
        is AST.FnDecl -> {
            match last.body as b {
                is null          -> {}
                is AST.BlockExpr -> {
                    hit :: find_first_in_block(b, accept_seq)
                    if hit is AST.SeqLitExpr { return ExpectedSeq {
                        .typed = result.typed,
                        .sl = hit,
                    } }
                }
            }
        }
        _ -> {}
    }
    assert(false, "expected a SeqLitExpr in: ${src}")
    return ExpectedSeq { .typed = result.typed, .sl = synthetic_seq() }
}

synthetic_seq :: fn() -> AST.SeqLitExpr {
    sp :: empty_span()
    return AST.SeqLitExpr {
        .span = sp,
        .id = AST.UNASSIGNED_NODE_ID,
        .elements = [],
    }
}

@test
test_seq_homogeneous_int_returns_array :: fn() -> void {
    src :: "f :: fn() -> i32[] { return [1, 2, 3] }"
    es :: expect_seq(src)
    diags: Diagnostic[]: []
    ty :: infer_seq_lit(es.sl, null, es.typed, diags)
    assert_eq(display_type(ty), "i32[]")
}

@test
test_seq_heterogeneous_returns_tuple :: fn() -> void {
    src :: "f :: fn() -> [i32, string] { return [1, \"two\"] }"
    es :: expect_seq(src)
    diags: Diagnostic[]: []
    ty :: infer_seq_lit(es.sl, null, es.typed, diags)
    assert_eq(display_type(ty), "[i32, string]")
}

@test
test_seq_with_expected_array_narrows :: fn() -> void {
    src :: "f :: fn() -> i64[] { return [1, 2, 3] }"
    es :: expect_seq(src)
    diags: Diagnostic[]: []
    expected: Type: mk_array(mk_primitive("i64"))
    ty :: infer_seq_lit(es.sl, expected, es.typed, diags)
    assert_eq(display_type(ty), "i64[]")
}

@test
test_seq_empty_with_array_expected :: fn() -> void {
    src :: "f :: fn() -> i32[] { return [] }"
    es :: expect_seq(src)
    diags: Diagnostic[]: []
    expected: Type: mk_array(mk_primitive("i32"))
    ty :: infer_seq_lit(es.sl, expected, es.typed, diags)
    assert_eq(display_type(ty), "i32[]")
}

@test
test_seq_tuple_arity_mismatch_emits_T3001 :: fn() -> void {
    src :: "f :: fn() -> [i32, i32] { return [1, 2, 3] }"
    es :: expect_seq(src)
    diags: Diagnostic[]: []
    expected: Type: mk_tuple([mk_primitive("i32"), mk_primitive("i32")])
    infer_seq_lit(es.sl, expected, es.typed, diags)
    found := false
    for d in diags {
        if d.code.id == "T3001" {
            found = true
        }
    }
    assert(found, "expected T3001 on tuple arity mismatch")
}
