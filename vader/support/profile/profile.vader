// vader/support/profile/profile.vader — per-pass profiler for the self-compile.
//
// Bindings to the runtime profiler (runtime/c/vader_runtime.c). The compiler
// brackets each pipeline pass with `prof_begin(phase)` / `prof_end(phase)`; the
// runtime accumulates wall time, peak-RSS growth and GC churn per phase and
// dumps a table to stderr when `$VADER_PROFILE` is set. Every call is a cheap
// no-op otherwise, so the brackets stay in the hot path unconditionally.

module "vader/support/profile"

/// A pipeline pass the profiler times. Its value indexes `g_prof_names[]` in
/// `runtime/c/vader_runtime.c`, so the two lists move together, and the width
/// is written because the value crosses to C.
export ProfPhase :: enum(i32) {
    /// Front-end load: resolve, parse and import wiring (`load_project`).
    Load = 0,
    /// Type-checking with bodies (`check_project_with_bodies`).
    Typecheck = 1,
    /// Comptime evaluation and monomorphisation (`evaluate_project`).
    Comptime = 2,
    /// Lowering to the LoweredAST (`lower_project`).
    Lower = 3,
    /// Reachability prune over the lowered project (`prune_unreachable_fns`).
    Prune = 4,
    /// CFG construction (`build_cfg_project`).
    CfgBuild = 5,
    /// CFG-level dead-code elimination (`eliminate_dead_cfg`).
    CfgDce = 6,
    /// Escape annotation (`annotate_escape`).
    Escape = 7,
    /// Bytecode emission from the CFG (`emit_bytecode_from_cfg`).
    Bytecode = 8,
    /// C emission (`emit_c`).
    CEmit = 9,
    /// Value-ABI return scalarisation (`scalarise_value_returns`).
    ValueReturn = 10,
    /// Range analysis: the accesses a native build marks proven
    /// (`mark_proven_accesses`), and `report_ranges` under `$VADER_OPT_REPORT`.
    Ranges = 11,
}

/// Mark the start of `phase`. A no-op unless `$VADER_PROFILE` is set.
///
/// @param phase  the pass starting.
@extern("vader_prof_begin")
export prof_begin :: fn(phase: ProfPhase) -> void

/// Mark the end of `phase`, accumulating its wall / peak-RSS / GC deltas.
///
/// @param phase  the pass ending, as given to the matching `prof_begin`.
@extern("vader_prof_end")
export prof_end :: fn(phase: ProfPhase) -> void

/// Emit the accumulated per-pass profile to stderr. Idempotent: a later atexit
/// fallback does not print it twice. A no-op unless `$VADER_PROFILE` is set.
@extern("vader_prof_dump")
export prof_dump :: fn() -> void
