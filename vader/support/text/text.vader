// vader/support/text/text: low-level byte/text helpers shared across the compiler.
//
// Byte-level ASCII predicates over raw `bytes()` views, name mangling
// (`c_emit`, `comptime`) and identifier-boundary scans (`lsp`), plus small
// dump/text helpers. Distinct from `std/char` (codepoint-typed) and from the
// lexer's `is_ident_start` / `is_ident_continue`, which classify `char`.

module "vader/support/text"

// `std/string` for the `chars` free fn `for c in s` lowers to: the impl has to
// be in THIS module's closure, not merely somewhere in the program.
import "std/string"
import "std/string_builder"

/// Identifier byte: `[A-Za-z0-9_]` (regex `\w`). The byte-level classifier
/// for raw UTF-8 / ASCII `bytes()` views ; bytes outside the class are what
/// `sanitise`-style helpers replace with `_`.
export is_ident_byte :: fn(b: u8) -> bool = (b >= 'A' && b <= 'Z') || (b >= 'a' && b <= 'z')
    || (b >= '0' && b <= '9') || b == '_'

/// Replace every byte outside `[A-Za-z0-9_]` with `_`: a type's display or a
/// library's name as an identifier fragment. Distinct from
/// `vader/emit/c/body.sanitise`, which keeps the `$` of a mangled name.
///
/// @param raw  the text to flatten (a type display, a library name).
/// @return     the sanitised form, safe to splice into a mangled name.
export sanitise_ident :: fn(raw: string) -> string {
    sb :: StringBuilder {}
    n :: raw.byte_len()
    for i in 0..<n {
        b :: raw.byte_at(i)
        if is_ident_byte(b) {
            sb.append_char(char(u32(b)))
        } else {
            sb.append_char('_')
        }
    }
    return "${sb}"
}

/// JSON-style simple escape : wrap `s` in double quotes and escape `"`, `\`,
/// `\n`, `\t`, `\r`. Walks by codepoint so multi-byte UTF-8 passes through
/// unchanged (byte-walking would synthesise U+FFFD on continuation bytes).
/// Used by the lexer dump.
///
/// @param s  the raw string to quote.
/// @return   `s` wrapped in `"..."` with the five C/JSON escapes applied.
export quote_simple :: fn(s: string) -> string {
    sb :: StringBuilder {}
    sb.append_char('"')
    for c in s {
        if c == '"' { sb.append("\\\"") }
        else if c == '\\' { sb.append("\\\\") }
        else if c == '\n' { sb.append("\\n") }
        else if c == '\t' { sb.append("\\t") }
        else if c == '\r' { sb.append("\\r") }
        else { sb.append_char(c) }
    }
    sb.append_char('"')
    return sb.to_string()
}

/// True when `display_path` falls within the dump scope `scope`: it equals a
/// scope entry or is a submodule of one (`M` or `M/...`). The IR dumps
/// (`dump --stage=...`) render only in-scope modules ; the scope defaults to the
/// entry module's subtree and is overridable with `--module`, so the stdlib and
/// any other dependency are out of scope by default.
///
/// @param display_path  the module's user-declared name (`module "..."`).
/// @param scope         the in-scope module ids / prefixes.
export module_in_scope :: fn(display_path: string, scope: string[]) -> bool {
    for m in scope {
        if display_path == m {
            return true
        }
        if display_path.starts_with("${m}/") {
            return true
        }
    }
    return false
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_sanitise_ident_passes_through_clean :: fn() -> void {
    assert_eq(sanitise_ident("foo_bar"), "foo_bar")
}

@test
test_sanitise_ident_replaces_slashes_and_dots :: fn() -> void {
    assert_eq(sanitise_ident("tests/snippets/arith.vader"), "tests_snippets_arith_vader")
}
