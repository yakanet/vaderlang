// vader/support/diagnostics/render: the single diagnostic renderer.
//
// The one place a `Diagnostic[]` becomes human-readable text, shared by every
// command (build / run / dump / fmt / dap / bootstrap). Three channels:
//   - `dump_diagnostics`            machine / snapshot : no file prefix, uncapped.
//   - `dump_diagnostics_with_paths` machine / snapshot of several files : file
//                                   prefix with `/`, uncapped, plain.
//   - `dump_diagnostics_with_file`  user-facing build  : file prefix, sorted,
//                                   deduped, capped, TTY-coloured.
//
// Lives here rather than in `vader/front/lexer/dump` (its historical home: the lexer
// dump was the first diagnostic consumer): rendering diagnostics is a
// diagnostics concern, and `vader/front/lexer` already depends on this module, so the
// renderer belongs below it. `Diagnostic` / `Position` / `Span` / `Severity` /
// `CodeInfo` / `is_empty` are module-local (diagnostic.vader): no import here.

module "vader/support/diagnostics"

import "std/env"
import "std/string" { compare_ascending as string_less }
import "std/string_builder"
import "std/sort"
import "std/math"
import "std/path"
import "std/collections"
import "vader/support/text"
TTY :: import "std/tty"

/// Render `diags` as a `# Diagnostics` block, ordered by (offset, code). The
/// sole producer of the `lexer.snapshot` fixtures: keep its signature frozen.
/// This is the machine channel : output is complete and byte-diffable, so it is
/// never capped (dedup is lossless and still applies).
export dump_diagnostics :: fn(diags: Diagnostic[]) -> string = render_diagnostics(diags, Channel {})

/// Render `diags` as a `# Diagnostics` Markdown section, for a dump written in
/// Markdown: one list item per diagnostic, each a code span, in the order and
/// with the completeness of `dump_diagnostics`.
///
/// @param diags  the diagnostics to render.
export markdown_diagnostics :: fn(diags: Diagnostic[]) -> string {
    sb :: StringBuilder {}
    sb.append("\n# Diagnostics\n")
    for d in dedup_diagnostics(sort(diags, diag_less)) {
        sb.append("\n- ${code_span(diagnostic_line(d))}")
    }
    return sb.to_string()
}

/// Render `d` as `dump_diagnostics` writes its line, without its file:
/// `[line:col] error[CODE] message: detail`.
///
/// @param d  the diagnostic to render.
export diagnostic_line :: fn(d: Diagnostic) -> string {
    sb :: StringBuilder {}
    sb.format_diagnostic(d, Channel {})
    return sb.to_string()
}

/// Like `dump_diagnostics`, but prefixes every line with the source file and
/// orders by (file, offset, code). For the build renderers (each
/// `flush_build_diags`), whose diagnostics span every compiled module: without
/// the file a `[line:col]` can't be traced back to a module. The dump stages run
/// one file at a time and omit it so their snapshots stay machine-independent.
/// This is the user-facing channel, so the block is capped.
export dump_diagnostics_with_file :: fn(diags: Diagnostic[]) -> string {
    // Read at RUNTIME, once per render. A module-level
    // `CWD :: current_working_directory()` would be comptime-folded and bake the
    // build machine's directory into the binary: the same trap that made
    // `VADER_OS` wrong.
    channel :: Channel {
        .files = true,
        .base = current_working_directory(),
        .user = true,
    }
    return render_diagnostics(diags, channel)
}

/// Render `diags` with their files, as `dump_diagnostics_with_file` orders them,
/// for a snapshot of a program that spans several files: every diagnostic, no
/// colour, and `/` between the folders of a file on every OS.
///
/// @param diags  the diagnostics to render.
/// @param base   the folder the files are named from; a file outside it keeps
///               its whole path.
export dump_diagnostics_with_paths :: fn(diags: Diagnostic[], base: string) -> string =
    render_diagnostics(diags, Channel { .files = true, .base = base })

// How a renderer writes its block.
Channel :: struct {
    /// Prefix each line with its file, named from `base`, and order by file
    /// first: diagnostics that span several modules.
    files: bool = false
    base: string = ""
    /// The user-facing channel: the block is capped, the severity coloured on a
    /// terminal, a file written with the separators of the OS.
    user: bool = false
}

// Upper bound on diagnostics rendered in one block. A single root error can
// cascade into hundreds of derived diagnostics ; past this many the real cause
// scrolls off, so the tail is collapsed into a "... and N more" line.
MAX_SHOWN_DIAGNOSTICS: i64: 100

// Shared body for the public renderers. `channel.files` switches the per-line
// file prefix AND the sort (file-grouped vs offset-only) in lockstep. The user
// channel collapses the tail past `MAX_SHOWN_DIAGNOSTICS`; a machine channel's
// contract is complete output. Duplicates are always dropped (lossless on any
// channel).
render_diagnostics :: fn(diags: Diagnostic[], channel: Channel) -> string {
    sorted :: if channel.files { sort(diags, diag_less_with_file) } else { sort(diags, diag_less) }
    unique :: dedup_diagnostics(sorted)
    limit :: if channel.user { min(unique.len(), MAX_SHOWN_DIAGNOSTICS) } else { unique.len() }
    sb :: StringBuilder {}
    sb.append("\n# Diagnostics")
    for d in unique[0..<limit] {
        sb.append_char('\n')
        sb.format_diagnostic(d, channel)
    }
    if unique.len() > limit {
        sb.append_char('\n')
        sb.append("... and ${unique.len() - limit} more diagnostic(s)")
    }
    return sb.to_string()
}

/// Drop exact-duplicate diagnostics, preserving first-seen order. The same error
/// can surface through more than one path (e.g. a cross-module symbol reported
/// once per importer) ; the user should see it a single time.
///
/// @param diags  the diagnostics, in the order they are shown.
/// @return       each distinct one once: same severity, code, span and detail.
export dedup_diagnostics :: fn(diags: Diagnostic[]) -> Diagnostic[] {
    seen :: Set<string> {}
    out: Diagnostic[]: []
    for d in diags {
        if seen.add(diag_key(d)) { out.push(d) }
    }
    return out
}

// Identity of a diagnostic for dedup : severity, code, full span and message.
diag_key :: fn(d: Diagnostic) -> string =
    "${i32(d.severity)}|${d.code.id}|${d.primary.start.file}|${d.primary.start.offset}|${d.primary.end.offset}|${d.detail}"

diag_less :: fn(a: Diagnostic, b: Diagnostic) -> bool {
    // A single dump-stage run comes from one file, so order by (offset, code)
    // only: `diag_less_with_file` adds the file tie-break for the build path.
    if a.primary.start.offset < b.primary.start.offset { return true }
    if a.primary.start.offset > b.primary.start.offset { return false }
    return string_less(a.code.id, b.code.id)
}

// Build-renderer ordering : group by file first (build diagnostics span every
// compiled module), then defer to `diag_less` for the (offset, code) tie-break.
diag_less_with_file :: fn(a: Diagnostic, b: Diagnostic) -> bool {
    af :: a.primary.start.file
    bf :: b.primary.start.file
    if af != bf { return string_less(af, bf) }
    return diag_less(a, b)
}

// Format one diagnostic as `[file:line:col] error[CODE] message: detail`. The
// severity word is TTY-coloured only on the user-facing channel ; the machine
// channels stay plain so the `*.snapshot` fixtures are byte-stable.
//
// A run from the project root turns a 78-character absolute path into a short
// one under `tests/`, which is the difference between a readable console
// line and one that scrolls. Relativising a path OUTSIDE `base` is refused on
// purpose: it would produce a `../../..` chain, longer than the absolute form
// and harder to follow: the stdlib of an installed toolchain is exactly that
// case.
//
// The suffix must start at a SEPARATOR: `/proj` must not shorten
// `/project/x.vader` to `ect/x.vader`.
export relative_to :: fn(file: string, base: string) -> string {
    if base.is_empty() {
        return file
    }
    prefix :: if base.ends_with("/") {
        base
    } else {
        "${base}/"
    }
    if !file.starts_with(prefix) {
        return file
    }
    return file[prefix.len()..<file.len()]
}

// The file `file` as `channel` names it, shortened against its base.
shown_file :: fn(file: string, channel: Channel) -> string {
    if channel.user {
        return to_native(relative_to(file, channel.base))
    }
    return relative_to(to_posix(file), to_posix(channel.base))
}

format_diagnostic :: fn(sb: StringBuilder, d: Diagnostic, channel: Channel) -> void {
    sev_word :: match d.severity {
        .Error   -> "error"
        .Warning -> "warning"
        .Info    -> "info"
        .Hint    -> "hint"
    }
    sev :: if channel.user {
        match d.severity {
            .Error        -> TTY.red(sev_word)
            .Warning      -> TTY.yellow(sev_word)
            .Info | .Hint -> sev_word
        }
    } else { sev_word }
    p :: d.primary.start
    detail: string = ""
    if !d.detail.is_empty() {
        detail = ": ${d.detail}"
    }
    loc :: if channel.files {
        "${shown_file(p.file, channel)}:${p.line}:${p.column}"
    } else {
        "${p.line}:${p.column}"
    }
    sb.append("[${loc}] ${sev}[${d.code.id}] ${d.code.message}${detail}")
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "toolchain/span"

mk_diag_span :: fn(start: i32, end: i32) -> Span = Span {
    .start = Position { .file = "t.vader", .offset = i64(start), .line = 1, .column = start + 1 },
    .end   = Position { .file = "t.vader", .offset = i64(end),   .line = 1, .column = end + 1 },
}

@test test_dedup_drops_exact_duplicates :: fn() -> void {
    sp :: mk_diag_span(0, 1)
    d1 :: lexer_error(.UnexpectedCharacter, sp, "x")
    d2 :: lexer_error(.UnexpectedCharacter, sp, "x")   // identical content
    d3 :: lexer_error(.StrayBackslash,      sp, "y")   // distinct code + detail
    diags: Diagnostic[]: [d1, d2, d3]
    assert_eq(dedup_diagnostics(diags).len(), 2)
}

@test test_dedup_keeps_distinct_spans :: fn() -> void {
    a :: lexer_error(.UnexpectedCharacter, mk_diag_span(0, 1), "x")
    b :: lexer_error(.UnexpectedCharacter, mk_diag_span(5, 6), "x")   // same code/detail, different span
    diags: Diagnostic[]: [a, b]
    assert_eq(dedup_diagnostics(diags).len(), 2)
}

@test test_cap_collapses_tail :: fn() -> void {
    // The user-facing channel (with_file) caps at MAX_SHOWN_DIAGNOSTICS.
    diags: Diagnostic[]: []
    for i in 0..<150 {
        diags.push(lexer_error(.UnexpectedCharacter, mk_diag_span(i, i + 1), "e"))
    }
    out :: dump_diagnostics_with_file(diags)
    assert("... and 50 more diagnostic(s)" in out, "expected the cap tail for 150 diagnostics")
}

@test test_no_cap_tail_under_limit :: fn() -> void {
    diags: Diagnostic[]: []
    for i in 0..<10 {
        diags.push(lexer_error(.UnexpectedCharacter, mk_diag_span(i, i + 1), "e"))
    }
    assert("more diagnostic(s)" !in dump_diagnostics_with_file(diags), "no tail expected under the cap")
}

mk_file_span :: fn(file: string) -> Span = Span {
    .start = Position { .file = file, .offset = 0, .line = 1, .column = 1 },
    .end = Position { .file = file, .offset = 1, .line = 1, .column = 2 },
}

@test
test_the_paths_channel_names_each_file_from_its_base :: fn() -> void {
    diags: Diagnostic[]: [
        lexer_error(.UnexpectedCharacter, mk_file_span("/repo/b/main.vader"), "x"),
        lexer_error(.UnexpectedCharacter, mk_file_span("/repo/a/main.vader"), "x"),
        lexer_error(.UnexpectedCharacter, mk_file_span("/elsewhere/c.vader"), "x"),
    ]
    out :: dump_diagnostics_with_paths(diags, "/repo")
    lines :: out.split("\n")
    assert_eq(lines.len(), 5)
    // In the order of their paths: the one outside the base keeps its own.
    assert(lines[2].starts_with("[/elsewhere/c.vader:1:1] error[L0001]"), "outside the base")
    assert(lines[3].starts_with("[a/main.vader:1:1] error[L0001]"), "the first under it")
    assert(lines[4].starts_with("[b/main.vader:1:1] error[L0001]"), "the second under it")
}

@test test_machine_channel_uncapped :: fn() -> void {
    // The snapshot/machine channel must stay complete: no cap, no collapse line.
    diags: Diagnostic[]: []
    for i in 0..<150 {
        diags.push(lexer_error(.UnexpectedCharacter, mk_diag_span(i, i + 1), "e"))
    }
    assert("more diagnostic(s)" !in dump_diagnostics(diags), "machine channel must not cap")
}
