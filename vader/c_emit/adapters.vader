// vader/c_emit/adapters: the C adapters through which the interpreter calls
// what none of its trampolines can.
//
// The VM calls a foreign function through a trampoline written ahead of time,
// one per shape of signature (`runtime/c/vader_ffi.h`). A struct by value, an
// `f32`, mixed classes or a symbol held by a static archive take an ADAPTER
// instead: a C function of the call's frame alone, compiled by `cc` against the
// real prototype, so that `cc` applies the ABI (`vader/vm/adapters.vader` says
// which imports, `vader/pipeline/ffi_adapters.vader` builds them).
//
// An adapter reads argument `j` from slot `j` of the frame, as
// `vader/vm/host.vader::dispatch_extern` filled it: a word, a double, or an
// address the runtime resolved (a string, a lent array, a mirror's block). The
// two sides change together. The result goes back over slot 0, a struct result
// into the block the slot after the arguments addresses.
//
// One unit per `CLibrary`, as the native build gives each its unit
// (`emit_library_unit`): two libraries' headers need not agree.

module "vader/c_emit"

import "std/collections"
import "std/sort"
import "std/string"
import "vader/bytecode"
import "vader/c_emit/c_ast"

/// The C units of a program's adapters, compiled together into one library.
export AdapterUnits :: struct {
    /// The unit names, as files are named after them (`adapter_unit_name`).
    names: string[]
    units: string[]
}

/// Emit the adapters of the imports `adapted` of `m`.
///
/// @param m        the program.
/// @param adapted  indices into `m.imports`, each an `@extern` with no callback
///                 parameter (`vader/vm/adapters.vader::adapted_imports`).
/// @return         one unit per library the imports reach, sorted by name.
export emit_adapter_units :: fn(m: BytecodeModule, adapted: i64[]) -> AdapterUnits {
    by_library :: MutableMap<string, BcImport[]> {}
    for i in adapted {
        by_library.get_or_put_with(library_name(m.imports[i]), () -> []).push(m.imports[i])
    }
    libraries: string[]: []
    for [library, _] in by_library {
        libraries.push(library)
    }
    struct_names :: struct_c_names_of(m.types)
    names: string[]: []
    units: string[]: []
    for library in sort(libraries, compare_ascending) {
        imports :: by_library[library] ?? continue
        names.push(adapter_unit_name(library))
        units.push(emit_adapter_unit(m.types, struct_names, library, imports))
    }
    return AdapterUnits { .names = names, .units = units }
}

// The unit name of the adapters of the `CLibrary` called `library`, `""` for
// the `@extern`s outside any.
adapter_unit_name :: fn(library: string) -> string {
    if library == "" {
        return "adapters"
    }
    return "adapters_${sanitise(library)}"
}

// The unit of the adapters of `imports`, all of `library`. `types` is the
// module type table, `struct_names` its struct C names.
emit_adapter_unit :: fn(types: BcType[], struct_names: string[], library: string, imports: BcImport[]) -> string {
    printer :: CPrinter {}
    printer.emit_preamble("Generated by vader: do not edit. ${adapter_banner(library)}")
    printer.print_item(CInclude { .path = "vader_adapter.h" })
    emit_mirrored_struct_typedefs(types, struct_names, printer)
    emit_foreign_declarations(printer, imports, types, block_crossings(imports, types))
    adapters: CTopLevel[]: []
    for imp in imports {
        adapters.push(adapter_function(imp, types))
    }
    printer.print_section(CSection { .items = adapters })
    return printer.printed_text()
}

// What the unit of the adapters of `library` says it holds.
adapter_banner :: fn(library: string) -> string {
    if library == "" {
        return "Interpreter adapters of the `@extern`s outside any `CLibrary`."
    }
    return "Interpreter adapters of the `CLibrary` `${library}`."
}

// How the mirrors of `imports` cross under an adapter: the interpreter lays
// every one out in a block of its own, so each is lent besides whatever else it
// is, and the block must hold it.
block_crossings :: fn(imports: BcImport[], types: BcType[]) -> MirrorCrossings {
    crossings :: mirror_crossings(imports, types)
    for t in crossings.copied {
        crossings.lent.add(t)
    }
    return crossings
}

// The adapter of `imp`: each argument read from its slot, the foreign symbol
// called with them, the result written back.
adapter_function :: fn(imp: BcImport, types: BcType[]) -> CFunction {
    arguments: CExpression[]: []
    for j in 0..<imp.signature.params.len() {
        arguments.push(adapter_argument(imp, types, j))
    }
    signature :: CSignature {
        .result = "VADER_ADAPTER void",
        .name = adapter_symbol(imp),
        .parameters = [CParameter { .type = "unsigned char*", .name = "frame" }],
    }
    body :: [adapter_return(imp, types, call(imp.extern_name, arguments))]
    return CFunction { .signature = signature, .body = CBlock { .body = body } }
}

// Argument `j` of `imp`, read from its slot as `dispatch_extern` filled it.
adapter_argument :: fn(imp: BcImport, types: BcType[], j: i64) -> CExpression {
    sig :: imp.signature
    type_index :: sig.param_types[j]
    address :: frame_read("vader_adapter_address", j)
    mirror :: mirrored_c_struct(types, type_index)
    // An array, or a mirror lent by address: the address as the callee types it.
    if is_abi_array(types, type_index) || (mirror != "" && param_is_by_address(sig, j)) {
        return cast(extern_parameter_type(imp, types, j), address)
    }
    if mirror != "" {
        return CUnary { .operator = "*", .operand = cast("const ${mirror}*", address) }
    }
    // A `@c_pointer` scalar was spilled into the frame; a pointer that may be
    // null rides as one.
    if param_is_by_address(sig, j) || is_abi_nullable_pointer(types, type_index) {
        return address
    }
    if sig.params[j] == .String || is_abi_nullable_string(types, type_index) {
        return cast("const char*", address)
    }
    if sig.params[j] == .F64 {
        return frame_read("vader_adapter_double", j)
    }
    if sig.params[j] == .F32 {
        return cast("float", frame_read("vader_adapter_double", j))
    }
    return cast(extern_parameter_type(imp, types, j), frame_read("vader_adapter_word", j))
}

// The statement that makes the call `forwarded` and writes its result where
// `dispatch_extern` reads it.
adapter_return :: fn(imp: BcImport, types: BcType[], forwarded: CExpression) -> CStatement {
    sig :: imp.signature
    result :: bc_single_result(sig)
    result_type :: bc_single_result_type(sig)
    mirror :: mirrored_c_struct(types, result_type)
    if mirror != "" {
        block :: frame_read("vader_adapter_address", sig.params.len())
        target :: CUnary { .operator = "*", .operand = cast("${mirror}*", block) }
        return CAssign { .target = target, .value = forwarded }
    }
    if result == .Void {
        return CExpressionStatement { .expression = forwarded }
    }
    frame :: verbatim("frame")
    if result == .F64 || result == .F32 {
        return perform("vader_adapter_return_double", [frame, cast("double", forwarded)])
    }
    if is_pointer_result(result, types, result_type) {
        return perform("vader_adapter_return_word", [frame, address_as_integer(forwarded)])
    }
    return perform("vader_adapter_return_word", [frame, cast("int64_t", forwarded)])
}

// `reader(frame, slot)`, one of the slot readers of `vader_adapter.h`.
frame_read :: fn(reader: string, slot: i64) -> CExpression = call(reader, [verbatim("frame"), number(slot)])

// Whether a result of class `result`, type `result_type`, is an address.
is_pointer_result :: fn(result: ValType, types: BcType[], result_type: i32) -> bool =
    result == .String
        || result == .Pointer
        || is_abi_nullable_pointer(types, result_type)
        || is_abi_nullable_string(types, result_type)

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_adapter_unit_name_of_a_library :: fn() -> void {
    assert_eq(adapter_unit_name("raylib"), "adapters_raylib")
}

@test
test_adapter_unit_name_outside_any_library :: fn() -> void {
    assert_eq(adapter_unit_name(""), "adapters")
}
