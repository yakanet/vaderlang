// vader/c_emit/split — multi-file C emit for a parallel native build.
//
// The monolithic emitter (`emit.vader::emit_c`) produces one `.c` TU that
// `cc -O3` compiles single-threaded — the dominant local build cost. This
// module re-routes the SAME section emitters into a shared header plus N
// compilation units so an outer driver can `cc -c` them in parallel and link.
//
// Layout (one program → several files) :
//   - `<base>.h`    — every cross-TU declaration : struct typedefs / bodies,
//                     fn-sig typedefs, the EXTERNAL fn / dispatcher / closure
//                     prototypes, the import shims themselves (`static inline`,
//                     so every unit absorbs them), the atom-count macro, and
//                     `extern` decls for the data globals defined in the
//                     globals TU.
//                     (`vader_type_info_table` is already extern'd by
//                     `vader.h`.)
//   - `<base>.g.c`  — the data-global DEFINITIONS : atom table, data pool,
//                     type-info + size tables. Pure data, no code.
//   - `<base>.<k>.c`— the function bodies, partitioned into N buckets by body
//                     size in mangle-sorted order (deterministic → stable for
//                     the bootstrap fixed point). Unit 0 also carries the
//                     trampolines, import shims, dispatchers, and `main`.
//
// A symbol keeps external linkage only when another unit refers to it
// (`internal_fn_flags`); the rest stay `static` in their own TU so `cc` can
// still inline them. The mangle-unique names resolve across TUs either way.
// The monolithic path is untouched — `emit_c` stays the CI / release default.

module "vader/c_emit"

import "std/abort"
import "std/string"
import "std/string_builder"
import "std/collections"
import "std/sort"
import "vader/bytecode"

/// A program emitted as several C translation units. `header` is the shared
/// `.h`, `globals` the data-globals `.c`, and `units` the function `.c` bodies —
/// one per source module, plus `unit_names[0] == GLUE_UNIT` for the trampolines,
/// import shims, dispatchers and `main`.
export CProgram :: struct {
    header:  string
    /// The `@extern` declarations and their shims, split out of `header`
    /// because they are the part of it a target is most likely to change.
    /// Keeping them apart lets the shared header stay shared — see
    /// `IMPORTS_HEADER_SUFFIX`.
    imports: string
    globals: string
    units:   string[]
    /// The module each unit holds, parallel to `units`. Callers name files by
    /// this rather than by index: an index shifts every later unit the moment a
    /// module is added, which renames and rewrites files that did not change.
    unit_names: string[]
}

/// Name of the unit holding the code that belongs to no module — trampolines,
/// import shims, vtable dispatchers, `main`. Leading `_` so it cannot collide
/// with a module stem, which is always a sanitised identifier.
export GLUE_UNIT :: "_glue"

/// Unit name for a per-target globals file. The shared one keeps its own
/// `<stem>.split.g.c` spelling, which the build scripts glob by name; a
/// per-target one has to look like every other per-target unit so the
/// `<stem>.<target>-*.c` glob picks it up.
export GLOBALS_UNIT :: "_globals"

/// Suffix of the imports header, `#include`d by the shared one under a FIXED
/// name so the units never mention a target. When targets disagree, the build
/// puts the right one first on the include path rather than renaming anything.
export IMPORTS_HEADER_SUFFIX :: ".imports.h"

/// Basename of the imports header for a shared header called `header_name`
/// (`foo.split.h` → `foo.imports.h`).
///
/// @param header_name  basename of the shared header.
/// @return             basename of the imports header beside it.
export imports_header_name :: fn(header_name: string) -> string {
    // Slice off the suffix rather than `replace_all`, which would also rewrite
    // a `.split.h` occurring earlier in a path.
    if header_name.ends_with(".split.h") {
        return "${header_name[0..<header_name.len() - 8]}${IMPORTS_HEADER_SUFFIX}"
    }
    return "${header_name}${IMPORTS_HEADER_SUFFIX}"
}

/// Emit `m` as a header + globals TU + one function TU per Vader module.
///
/// Reuses the monolithic section emitters, routing the type / declaration half
/// to the header, the data half to the globals TU, and the code half to the
/// function units. `EmitCtx.split` is forced on so every def takes external
/// linkage and the closure forward decls land in the header.
///
/// @param m            the bytecode module to lower.
/// @param opts         emit-time switches ; `entry_mangled` resolves `main`.
/// @param header_name  basename of the shared header, `#include`d by every TU
///                     (resolved relative to each `.c` — keep them co-located).
/// @return             the header, the globals TU, and one function TU per
///                     module (plus unit 0 for the glue).
export emit_c_split :: fn(m: BytecodeModule, opts: EmitOptions, header_name: string) -> CProgram {
    // The partition comes FIRST: the linkage analysis needs to know which unit
    // each function lands in, and the context needs the analysis.
    buckets :: partition_functions(m.functions)
    ctx :: new_ctx(
        m, opts.release, true, opts.atom_universe,
        internal_fn_flags(m, buckets, opts.entry_mangled),
    )

    // ---- shared header : every cross-TU declaration -----------------------
    hdr :: StringBuilder {}
    hdr.append("/* Generated by vader — do not edit. Shared declarations. */\n")
    hdr.append("#include \"vader.h\"\n")
    hdr.append("#include <stddef.h>\n")
    hdr.append("#include <stdlib.h>\n")
    hdr.append("#include <string.h>\n")
    hdr.append("\n")
    emit_struct_typedefs(ctx, hdr)
    emit_fn_sig_typedefs(ctx, hdr)
    emit_forward_decls(ctx, hdr)
    emit_closure_forward_decls(ctx, hdr)
    emit_vtable_forward_decls(ctx, hdr)
    // The shim DEFINITIONS, not prototypes: they stay `static inline` so every
    // unit inlines them instead of calling into unit 0 — but they live in their
    // OWN header, included here under a fixed name. They are the only part of
    // this file a target can change, and keeping them inline in the shared one
    // forced a whole 6000-line copy per target the moment a binding diverged.
    imports :: StringBuilder {}
    imports.append("/* Generated by vader — do not edit. Foreign imports. */\n")
    imports.append("#include \"vader.h\"\n\n")
    emit_import_shims(ctx, imports)
    hdr.append("#include \"${imports_header_name(header_name)}\"\n\n")
    emit_atom_count_define(ctx, hdr)
    emit_data_global_externs(ctx, hdr)

    // ---- globals TU : the data-global definitions -------------------------
    glob :: StringBuilder {}
    glob.append("#include \"${header_name}\"\n\n")
    // Re-emits `#define VADER_COMPTIME_ATOM_COUNT` too. Both sides count
    // `ctx.atom_table`, so the redefinition is identical by construction — and
    // stays silent — rather than by the two pools happening to match.
    emit_atom_comptime_table(ctx, glob)
    emit_data_pool(ctx, glob)
    emit_type_info_table(ctx, glob)

    // ---- function TUs : one per MODULE, plus unit 0 for the fixed code ----
    names :: unit_names_of(m.functions, buckets)
    units: string[]! = []
    for k in 0..<buckets.len() {
        u :: StringBuilder {}
        u.append("#include \"${header_name}\"\n\n")
        // Prototypes for this unit's OWN internal functions — the shared header
        // carries only the external ones, and a `static` definition needs a
        // `static` declaration ahead of any mutually-recursive use.
        emit_internal_forward_decls(ctx, buckets[usize(k)], u)
        if k == 0 {
            emit_fn_trampolines(ctx, u)
            emit_vtable_dispatchers(ctx, u)
        }
        for idx in buckets[usize(k)] {
            emit_function_body(ctx, idx, m.functions[usize(idx)], u)
            u.append("\n")
        }
        if k == 0 {
            emit_main(ctx, u, opts.entry_mangled)
        }
        units.push("${u}")
    }

    return CProgram {
        .header = "${hdr}", .imports = "${imports}", .globals = "${glob}",
        .units = units, .unit_names = names,
    }
}

/// `static <sig>;` for each of this unit's own internal functions, so a
/// mutually-recursive pair inside one unit still compiles in any order.
///
/// The shared header cannot carry these: it is included by every TU, and a
/// `static` declaration there would give each unit its own undefined symbol.
///
/// @param ctx      the emit context, for the per-fn linkage decision.
/// @param bucket   function indices belonging to this unit.
/// @param out      the accumulating unit source.
emit_internal_forward_decls :: fn(ctx: EmitCtx, bucket: i32[], out: StringBuilder!) -> void {
    fns :: ctx.module.functions
    any: bool = false
    for idx in bucket {
        if fn_linkage_prefix(ctx, idx) != "" {
            out.append("static ${signature_for(fns[usize(idx)])};\n")
            any = true
        }
    }
    if any {
        out.append("\n")
    }
}

// ---- linkage analysis -----------------------------------------------------

/// Per-function: true when NO unit but its own refers to it, so it can be
/// `static` in that unit.
///
/// Splitting used to give every function external linkage, which forbids `cc`
/// from inlining it — a definition another TU may call has to be emitted as
/// written. That is what the split cost: measured at +10 % to +29 % on the
/// stdlib-heavy bench workloads, against a monolithic build where everything
/// is already `static`.
///
/// A function stays EXTERNAL when any of these holds. The list is the complete
/// set of ways a name can be reached from outside its unit, and erring towards
/// external is safe (it only forgoes an inline); erring the other way is a link
/// error, so each entry is a reference site, not a heuristic:
///   - an `@export` target — a host names it;
///   - the entry point — `emit_main` calls it from unit 0;
///   - a vtable target — the vtable arrays live in the globals TU;
///   - taken as a fn-value — `emit_fn_trampolines` wraps it from unit 0;
///   - called by a function in another unit.
///
/// @param m              the module being emitted.
/// @param buckets        unit → function indices, from `partition_functions`.
/// @param entry_mangled  mangled name of the entry fn, `""` when there is none.
/// @return               flags parallel to `m.functions`.
internal_fn_flags :: fn(m: BytecodeModule, buckets: i32[][], entry_mangled: string) -> bool[] {
    n :: m.functions.len()
    unit_of: i32[]! = []
    external: bool[]! = []
    for i in 0..<n {
        unit_of.push(-1)
        external.push(false)
    }
    for u in 0..<buckets.len() {
        for idx in buckets[u] {
            unit_of[usize(idx)] = i32(u)
        }
    }

    for e in m.exports {
        external[usize(e.fn_index)] = true
    }
    for row in m.vtables {
        for en in row.entries {
            external[usize(en.fn_index)] = true
        }
    }
    usage :: scan_fn_value_usage(m.functions)
    for i in 0..<n {
        if usage.fn_ref_type[i] >= 0 || usage.is_closure[i] {
            external[i] = true
        }
        if entry_mangled != "" && m.functions[i].name == entry_mangled {
            external[i] = true
        }
    }

    for i in 0..<n {
        home :: unit_of[i]
        for op in m.functions[i].body {
            callee :: callee_index_of(op)
            if callee >= 0 && unit_of[usize(callee)] != home {
                external[usize(callee)] = true
            }
        }
    }

    out: bool[]! = []
    for i in 0..<n {
        out.push(!external[i])
    }
    return out
}

/// Index of the function `op` refers to, or `-1` when it refers to none.
/// `fn.ref` counts: the reference itself crosses units even though the call
/// through it does not. `fn.addr` counts for a stronger reason — it emits
/// `&<symbol>`, so a unit taking the address of a function defined in another
/// one needs that function to keep external linkage or the link fails.
callee_index_of :: fn(op: Op) -> i32 {
    if op is Call as c   { return c.function_index }
    if op is FnRef as f  { return f.function_index }
    if op is FnAddr as f { return f.function_index }
    return -1
}

// ---- header-only declaration emitters -------------------------------------

/// `#define VADER_COMPTIME_ATOM_COUNT N` for the shared header — the unit that
/// carries `main` reads it to size `vader_atom_init_with_comptime`. Mirrors the
/// value `emit_atom_comptime_table` bakes into the globals TU.
emit_atom_count_define :: fn(ctx: EmitCtx, out: StringBuilder!) -> void {
    out.append("#define VADER_COMPTIME_ATOM_COUNT ${comptime_atom_count(ctx)}u\n\n")
}

/// Count of the atoms `emit_atom_comptime_table` bakes — the length of
/// `ctx.atom_table`, which is this module's own non-empty literals or the
/// shared universe when one was given.
///
/// Reading the table rather than recounting the module's own pool is what keeps
/// this equal to the `VADER_COMPTIME_ATOM_COUNT` the globals TU emits. With a
/// universe the pool is the SMALLER of the two, so counting it sized
/// `vader_atom_init_with_comptime` short of the entries actually baked, and
/// every atom past the module's own count read uninitialised memory.
comptime_atom_count :: fn(ctx: EmitCtx) -> i32 = i32(ctx.atom_table.len())

/// `extern` decls for the data globals defined in the globals TU and read from
/// the function units : the data-pool arrays (`data.const`), the atom table
/// (`main`), and the size table (`@size_of`). `vader_type_info_table` and its
/// count are already declared by `vader.h`.
emit_data_global_externs :: fn(ctx: EmitCtx, out: StringBuilder!) -> void {
    for i in 0..<ctx.module.data_pool.len() {
        // The qualifier must match the definition in the globals TU — a mutable
        // module const is a writable global, so `const` here would be a conflicting
        // declaration.
        out.append("extern ${storage_qualifier(data_entry_mutable(ctx.module.data_pool[i]))}vader_array_t vader_data_${i};\n")
    }
    // The permanent GC frame rooting the mutable module-consts. Defined beside the
    // data pool, installed by `main`, which is in another unit.
    if mutable_pool_indices(ctx.module.data_pool).len() > 0 {
        out.append("extern vader_array_t* vader_global_const_arrays[];\n")
        out.append("extern void* vader_global_const_objs[];\n")
        out.append("extern vader_gc_frame_t vader_global_const_frame;\n")
    }
    out.append("extern const vader_atom_entry_t vader_atom_comptime_table[];\n")
    out.append("extern const size_t vader_type_size[];\n")
    out.append("\n")
}

// ---- partitioning ----------------------------------------------------------

/// Partition the fn indices into one bucket per SOURCE MODULE, with bucket 0
/// reserved for the fixed code (trampolines, import shims, dispatchers, `main`).
///
/// Grouping by module rather than balancing by size is what makes a per-target
/// seed affordable. A balanced partition reassigns every bucket the moment one
/// function is added or removed, so a single `@target` body rewrote all eight
/// units; grouped by module, a module's functions stay in that module's file
/// whatever happens elsewhere.
///
/// Modules come out in sorted order and functions within one in mangle order,
/// so the output is deterministic and the bootstrap fixed point holds.
///
/// @param fns  the module's functions (index == position).
/// @return     bucket 0 (empty, for the fixed code) then one per module.
partition_functions :: fn(fns: BcFunction[]) -> i32[][] {
    // GROUPED, not run-detected. Sorting by mangled name does NOT make a
    // module's functions contiguous: a name with no module (`main`, `concat_3`,
    // a lifted lambda) sorts among the module-qualified ones by its own first
    // letter, so the moduleless group interleaves with them. Detecting runs
    // therefore produced several buckets called `_root`, which wrote the same
    // file and lost every function but the last — a link failure listing
    // undefined `vader_fn_lift_*`, and only in projects with enough bare names
    // to straddle a module.
    of_module :: MutableMap<string, i32[]!> {}
    for idx in sorted_fn_indices(fns) {
        m :: module_stem_of(fns[usize(idx)].name)
        cur :: of_module[m]
        if cur == null {
            of_module[m] = [idx]
        } else {
            cur.push(idx)
        }
    }
    buckets: i32[]![]! = [[]]
    for m in sorted_module_stems(of_module) {
        buckets.push(of_module[m] ?? [])
    }
    return buckets
}

// The module stems, sorted — the deterministic unit order.
sorted_module_stems :: fn(of_module: MutableMap<string, i32[]!>) -> string[] {
    stems: string[]! = []
    for [m, _] in of_module {
        stems.push(m)
    }
    return sort(stems, (a: string, b: string) -> compare_ascending(a, b))
}

// The module each bucket holds. Bucket 0 is the glue; every other takes the
// module stem of its first function, which is the same for all of them because
// `partition_functions` groups by exactly that — and is non-empty, since every
// bucket past 0 comes from a map entry that holds at least one index.
//
// The names are what `unit_path` keys the output file on, so two units sharing
// one would write the same file and lose every function but the last. That is
// not hypothetical: it is the failure `partition_functions` documents above,
// from back when runs were detected instead of grouped. Grouping closed the
// route that produced several `_root`s; the check closes the one a module
// literally stemmed `_glue` or `_root` would still take.
unit_names_of :: fn(fns: BcFunction[], buckets: i32[][]) -> string[] {
    out: string[]! = [GLUE_UNIT]
    for k in 1..<buckets.len() {
        stem :: module_stem_of(fns[usize(buckets[k][0])].name)
        // A stem names a MODULE, so every byte of it is an identifier byte. An
        // EMPTY stem is ordinary — a bare name like `main` has no `$` — and
        // becomes `_root` below. A stem that is non-empty but not an identifier
        // cannot come from source: it means the mangled name was corrupted
        // upstream, and letting it through writes `<out>-<garbage>.c`, which
        // `open()` truncates at the first NUL. The file then reaches the linker
        // with no `.c`, and the failure is reported three steps away as
        // `ld: unknown file type`. Fail HERE, where the name is still readable.
        for b in stem.bytes() {
            if !is_ident_byte(b) {
                todo("split: unit name for `${fns[usize(buckets[k][0])].name}` is not an identifier — the mangled name is corrupt")
            }
        }
        out.push(if stem == "" { "_root" } else { stem })
    }
    seen :: MutableSet<string> {}
    for n in out {
        if n in seen {
            todo("split: two units named `${n}` would write the same file")
        }
        seen.add(n)
    }
    return out
}

// The module part of a mangled name: everything before the first `$`.
// `mangle` emits `<module_stem>$<decl>`, and omits the prefix entirely when the
// module stem is empty or equal to the decl name — those land together under
// `""`, which is one more module rather than a special case.
module_stem_of :: fn(name: string) -> string {
    at :: name.index_of('$', 0)
    if at < 0 {
        return ""
    }
    return name.bytes()[0..<usize(at)].bytes_to_string()
}

/// Fn indices sorted by mangled name — the deterministic visit order.
sorted_fn_indices :: fn(fns: BcFunction[]) -> i32[] {
    idxs: i32[]! = []
    for i in 0..<fns.len() { idxs.push(i32(i)) }
    return sort(idxs, (a: i32, b: i32) -> compare_ascending(fns[usize(a)].name, fns[usize(b)].name))
}


