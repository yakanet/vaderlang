// vader/c_emit/c_ast/print — writes a statement tree (`c_ast.vader`) as C text.
//
// Every layout decision lives here : indentation (4 spaces per level), braces,
// `else if` chains, `end_N: ;` labels, `#line` directives at column 0, and the
// spelling of a return around the GC frame restore.

module "vader/c_emit/c_ast"

import "std/abort"
import "std/string"
import "std/string_builder"

// The column C text is wrapped at.
LINE_WIDTH: usize: 100

// The columns one level of indentation takes.
INDENT_WIDTH: usize: 4

/// Accumulates C text printed from trees. Only this module can write the text,
/// so an emitter can produce C only as a tree.
export CPrinter :: struct {
    @internal
    out: StringBuilder! = StringBuilder {}
    /// A section was printed : the next one starts after a blank line.
    @internal
    started: bool = false
}

/// The C printed so far.
///
/// @param printer  the printer to read.
export printed_text :: fn(printer: CPrinter) -> string = printer.out.to_string()

/// Print `block`'s statements, one per line, `depth` levels deep.
///
/// @param printer  receives the text.
/// @param block    the statements to print.
/// @param depth    the indentation level of `block`'s own lines.
export print_block :: fn(printer: CPrinter!, block: CBlock, depth: i32) -> void = write_block(
    printer.out,
    block,
    depth,
)

/// Print `section` : its comment then its items, a blank line away from the
/// section before — nothing at all when it has no item. A function stands
/// apart from its neighbours.
///
/// @param printer  receives the text.
/// @param section  the items to print, with the comment above them.
export print_section :: fn(printer: CPrinter!, section: CSection) -> void {
    if section.items.len() == 0 {
        return
    }
    // Joined before it joins the unit : a builder keeps every appended piece
    // until it is joined, and a unit's pieces would all stay alive together.
    text :: StringBuilder {}
    if printer.started {
        text.append("\n")
    }
    printer.started = true
    if section.comment.len() > 0 {
        text.append("/* ${section.comment.join("\n * ")} */\n")
    }
    for k in 0..<section.items.len() {
        if k > 0 && (section.items[k] is CFunction || section.items[k - 1] is CFunction) {
            text.append("\n")
        }
        write_top_level(text, section.items[k])
    }
    printer.out.append(text.to_string())
}

/// Print `item` as a section of its own — one function of a stream, typically.
///
/// @param printer  receives the text.
/// @param item     the declaration, definition or directive to print.
export print_item :: fn(printer: CPrinter!, item: CTopLevel) -> void = printer.print_section(
    CSection { .items = [item] },
)

write_top_level :: fn(out: StringBuilder!, item: CTopLevel) -> void {
    match item {
        is CInclude                -> out.append("#include ${include_operand(item)}\n")
        is CDefine                 -> {
            out.append("#define ${item.name} ")
            write_expression(out, item.value)
            out.append("\n")
        }
        is CStructForward          -> out.append("typedef struct ${item.name} ${item.name};\n")
        is CStructDefinition       -> {
            out.append("struct ${item.name} {\n")
            for field in item.fields {
                write_line(out, "${field.type} ${field.name};", 1)
            }
            out.append("};\n")
        }
        is CGlobal                 -> {
            qualifier :: if item.constant { "const " } else { "" }
            head :: "${storage_keyword(item.storage)}${qualifier}${item.type} "
            out.append(head)
            write_declarator(out, item.declarator, head.bytes().len(), 0)
            out.append(";\n")
        }
        is CPrototype              -> {
            write_signature(out, item.signature)
            out.append(";\n")
        }
        is CFunctionPointerTypedef -> {
            out.append("typedef ${item.result} (*${item.name})(")
            write_parameters(out, item.parameters)
            out.append(");\n")
        }
        is CFunction               -> write_function(out, item)
        is CStaticAssert           -> {
            out.append("_Static_assert(")
            write_expression(out, item.condition)
            out.append(", ")
            write_expression(out, item.message)
            out.append(");\n")
        }
    }
}

// `<path>` for a system header, `"path"` otherwise.
include_operand :: fn(include: CInclude) -> string {
    if include.system {
        return "<${include.path}>"
    }
    return "\"${include.path}\""
}

// The storage-class keyword of a global, with its trailing space.
storage_keyword :: fn(storage: CStorage) -> string = match storage {
    .Internal    -> "static "
    .External    -> ""
    .Declaration -> "extern "
}

// `storage inline result name(parameters)`, without `;` or body.
write_signature :: fn(out: StringBuilder!, signature: CSignature) -> void {
    out.append(storage_keyword(signature.storage))
    if signature.inline {
        out.append("inline ")
    }
    out.append("${signature.result} ${signature.name}(")
    write_parameters(out, signature.parameters)
    out.append(")")
}

// `parameters` separated by `, ` — `void` when there is none.
write_parameters :: fn(out: StringBuilder!, parameters: CParameter[]) -> void {
    if parameters.len() == 0 {
        out.append("void")
    }
    for k in 0..<parameters.len() {
        if k > 0 {
            out.append(", ")
        }
        parameter :: parameters[k]
        out.append(
            if parameter.name == "" {
                parameter.type
            } else {
                "${parameter.type} ${parameter.name}"
            },
        )
    }
}

write_function :: fn(out: StringBuilder!, function: CFunction) -> void {
    write_signature(out, function.signature)
    out.append(" {\n")
    write_statements(out, function.prologue, 0, function.prologue.len(), 1)
    write_block(out, function.body, 1)
    write_line(out, "}", 0)
}

// `block`'s statements, `depth` levels deep.
write_block :: fn(out: StringBuilder!, block: CBlock, depth: i32) -> void = write_statements(
    out,
    block.body,
    0,
    block.body.len(),
    depth,
)

// `statements[from..<to]`, `depth` levels deep.
write_statements :: fn(
    out: StringBuilder!,
    statements: CStatement[],
    from: usize,
    to: usize,
    depth: i32,
) -> void {
    for k in from..<to {
        statement :: statements[k]
        match statement {
            is CDirective           -> write_directive(out, statement.text)
            is CAssign              -> {
                indent(out, depth)
                write_assign(out, statement)
                out.append("\n")
            }
            is CExpressionStatement -> {
                indent(out, depth)
                write_expression(out, statement.expression)
                out.append(";\n")
            }
            is CMacroStatement      -> {
                indent(out, depth)
                write_expression(out, statement.call)
                out.append("\n")
            }
            is CDeclaration         -> {
                indent(out, depth)
                write_declaration(out, statement, depth)
                out.append("\n")
            }
            is CIf                  -> write_if(out, statement, depth)
            is CReturn              -> write_return(out, statement, depth)
            is CGoto                -> {
                indent(out, depth)
                write_goto(out, statement)
                out.append("\n")
            }
            is CSwitch              -> write_switch(out, statement, depth)
            is CScope               -> {
                write_line(
                    out,
                    if statement.label == "" { "{" } else { "${statement.label}: {" },
                    depth,
                )
                write_block(out, statement.body, depth + 1)
                write_closer(out, statement.end_label, depth)
            }
        }
    }
}

write_if :: fn(out: StringBuilder!, node: CIf, depth: i32) -> void {
    write_if_head(out, "if (", node.condition, depth)
    write_block(out, node.then_block, depth + 1)
    write_else_chain(out, node, node.end_label, depth)
}

// `node`'s `else` arm, then the closing brace carrying `label`. An arm holding
// a single `if` — `#line` directives aside — continues the chain as
// `} else if`, the two closing braces merging into one ; so they may not both
// carry a label. A directive leading an arm is written above the `} else` line,
// next to the condition it describes ; one trailing it, below the shared
// closing brace, innermost arm first.
write_else_chain :: fn(out: StringBuilder!, node: CIf, label: string, depth: i32) -> void {
    arm :: node.else_block
    if arm == null {
        write_closer(out, label, depth)
        return
    }
    body :: arm.body
    start :: leading_directives(body)
    end :: body.len() - trailing_directives(body, start)
    write_statements(out, body, 0, start, depth)
    inner :: if end == start + 1 { body[start] } else { null }
    if inner is CIf && (label == "" || inner.end_label == "") {
        write_if_head(out, "} else if (", inner.condition, depth)
        write_block(out, inner.then_block, depth + 1)
        write_else_chain(out, inner, if label != "" { label } else { inner.end_label }, depth)
        write_statements(out, body, end, body.len(), depth)
        return
    }
    write_line(out, "} else {", depth)
    write_statements(out, body, start, body.len(), depth + 1)
    write_closer(out, label, depth)
}

// ---- expressions ----------------------------------------------------------

write_expression :: fn(out: StringBuilder!, expression: CExpression) -> void {
    match expression {
        is CTemporary       -> {
            if expression.slot < 0 {
                panic(
                    "c_ast: temp ${expression.id} printed before `coalesce_temporaries` gave it a slot",
                )
            }
            out.append("t")
            out.append("${expression.slot}")
        }
        is CLocal           -> {
            out.append("l")
            out.append("${expression.slot}")
        }
        is CVerbatim        -> out.append(expression.text)
        is CIntegerLiteral  -> write_integer_literal(out, expression)
        is CNumber          -> {
            out.append("${expression.value}")
            if expression.unsigned {
                out.append("u")
            }
        }
        is CCall            -> {
            out.append(expression.callee)
            out.append("(")
            write_list(out, expression.arguments)
            out.append(")")
        }
        is CCastToTypeOf    -> {
            out.append("(__typeof__(")
            write_expression(out, expression.model)
            out.append(")) ")
            write_operand(out, expression.value, CAST_PRECEDENCE)
        }
        is CCast            -> {
            for type in expression.types {
                out.append("(")
                out.append(type)
                out.append(")")
            }
            out.append(" ")
            write_operand(out, expression.value, CAST_PRECEDENCE)
        }
        is CBinary          -> {
            operator :: COperatorInfo(expression.operator)
            write_operand(out, expression.left, operator.precedence)
            out.append(" ")
            out.append(operator.spelling)
            out.append(" ")
            write_operand(out, expression.right, operator.precedence + 1)
        }
        is CAddressOf       -> {
            out.append("&")
            write_operand(out, expression.operand, CAST_PRECEDENCE)
        }
        is CUnary           -> {
            out.append(expression.operator)
            out.append("(")
            write_expression(out, expression.operand)
            out.append(")")
        }
        is CParenthesized   -> {
            out.append("(")
            write_expression(out, expression.inner)
            out.append(")")
        }
        is CMember          -> {
            write_expression(out, expression.base)
            out.append(if expression.arrow { "->" } else { "." })
            out.append(expression.member)
        }
        is CIndex           -> {
            write_expression(out, expression.base)
            out.append("[")
            write_expression(out, expression.index)
            out.append("]")
        }
        is CConditional     -> {
            write_expression(out, expression.condition)
            out.append(" ? ")
            write_expression(out, expression.then_value)
            out.append(" : ")
            write_expression(out, expression.else_value)
        }
        is CDesignated      -> {
            out.append(expression.designator)
            out.append(" = ")
            write_expression(out, expression.value)
        }
        is CCompoundLiteral -> {
            out.append("(")
            out.append(expression.type)
            out.append("){ ")
            write_list(out, expression.elements)
            out.append(" }")
        }
        is CStringLiterals  -> out.append(expression.literals.join(" "))
        is CInitializerList -> {
            if expression.elements.len() == 0 {
                out.append("{ }")
            } else {
                out.append("{ ")
                write_list(out, expression.elements)
                out.append(" }")
            }
        }
        is CSequence        -> {
            for part in expression.parts {
                write_expression(out, part)
            }
        }
    }
}

// C binds a cast tighter than any binary operator : one above `*`.
CAST_PRECEDENCE :: 11

// `child`, an operand needing at least `minimum` precedence : a `CBinary` that
// binds looser is parenthesised. A right operand needs one more than its
// operator — every binary operator here is left-associative.
write_operand :: fn(out: StringBuilder!, child: CExpression, minimum: i32) -> void {
    if child is CBinary && COperatorInfo(child.operator).precedence < minimum {
        out.append("(")
        write_expression(out, child)
        out.append(")")
        return
    }
    write_expression(out, child)
}

write_integer_literal :: fn(out: StringBuilder!, literal: CIntegerLiteral) -> void {
    wide :: literal.class == .I64
    if is_most_negative(literal) {
        out.append(if wide { "INT64_MIN" } else { "INT32_MIN" })
    } else {
        out.append(if wide { "INT64_C(" } else { "INT32_C(" })
        out.append("${literal.value}")
        out.append(")")
    }
}

// ---- statements -----------------------------------------------------------

// A return on one line : bare, or braced around the frame restore — every value
// is read before `vader_gc_top` moves, through the `__vret` snapshot when the
// value may read a frame-pinned local.
write_return :: fn(out: StringBuilder!, node: CReturn, depth: i32) -> void {
    indent(out, depth)
    write_return_text(out, node)
    out.append("\n")
}

// A return, without indentation or newline.
write_return_text :: fn(out: StringBuilder!, node: CReturn) -> void {
    if node.pops_frame {
        out.append("{ ")
    }
    for store in node.stores {
        write_assign(out, store)
        out.append(" ")
    }
    snapshot :: node.pops_frame && node.snapshot_type != ""
    value :: node.value
    if snapshot && value != null {
        out.append(node.snapshot_type)
        out.append(" __vret = ")
        write_expression(out, value)
        out.append("; ")
    }
    if node.pops_frame {
        write_assign(out, FRAME_RESTORE)
        out.append(" ")
    }
    if value == null {
        out.append("return;")
    } else {
        out.append("return ")
        if snapshot {
            out.append("__vret")
        } else {
            write_expression(out, value)
        }
        out.append(";")
    }
    if node.pops_frame {
        out.append(" }")
    }
}

// `goto label;`, or `if (condition) goto label;`, without indentation or newline.
write_goto :: fn(out: StringBuilder!, node: CGoto) -> void {
    condition :: node.condition
    if condition != null {
        out.append("if (")
        write_expression(out, condition)
        out.append(") ")
    }
    out.append("goto ")
    out.append(node.label)
    out.append(";")
}

// `switch (subject) {`, one line per clause, then `}`.
write_switch :: fn(out: StringBuilder!, node: CSwitch, depth: i32) -> void {
    indent(out, depth)
    out.append("switch (")
    write_expression(out, node.subject)
    out.append(") {\n")
    default_body :: node.default_body
    for k in 0..<node.cases.len() {
        case_node :: node.cases[k]
        indent(out, depth + 1)
        out.append("case ")
        write_expression(out, case_node.value)
        out.append(":")
        write_case_body(out, case_node.body, default_body == null && k + 1 == node.cases.len())
    }
    if default_body != null {
        indent(out, depth + 1)
        out.append("default:")
        write_case_body(out, default_body, true)
    }
    write_line(out, "}", depth)
}

// A clause's statements on its `case` line, then `break;` unless the last one
// already leaves the switch or the clause is the switch's last.
write_case_body :: fn(out: StringBuilder!, body: CCaseStatement[], last_clause: bool) -> void {
    for statement in body {
        out.append(" ")
        match statement {
            is CExpressionStatement -> {
                write_expression(out, statement.expression)
                out.append(";")
            }
            is CReturn              -> write_return_text(out, statement)
            is CGoto                -> write_goto(out, statement)
        }
    }
    leaves :: body.len() > 0 && body[body.len() - 1] is CReturn | CGoto
    if !last_clause && !leaves {
        out.append(" break;")
    }
    out.append("\n")
}

// `opening condition) {` on its own line.
write_if_head :: fn(out: StringBuilder!, opening: string, condition: CExpression, depth: i32) -> void {
    indent(out, depth)
    out.append(opening)
    write_expression(out, condition)
    out.append(") {\n")
}

// `target = value;`, without indentation or newline.
write_assign :: fn(out: StringBuilder!, node: CAssign) -> void {
    write_expression(out, node.target)
    operator :: node.operator
    if operator != null {
        out.append(" ")
        out.append(COperatorInfo(operator).spelling)
        out.append("= ")
    } else {
        out.append(" = ")
    }
    write_expression(out, node.value)
    out.append(";")
}

// `type d1, d2 = v, d3[n] = { … };`, without indentation or newline.
write_declaration :: fn(out: StringBuilder!, node: CDeclaration, depth: i32) -> void {
    out.append(node.type)
    out.append(" ")
    column :: usize(depth) * INDENT_WIDTH + node.type.bytes().len() + 1
    for k in 0..<node.declarators.len() {
        if k > 0 {
            out.append(", ")
        }
        write_declarator(out, node.declarators[k], column, depth)
    }
    out.append(";")
}

// `name[length] = value`, `column` being where `name` starts.
write_declarator :: fn(
    out: StringBuilder!,
    declarator: CDeclarator,
    column: usize,
    depth: i32,
) -> void {
    length :: declarator.length
    suffix :: if length is i32 { "[${length}]" } else if length is CUnsized { "[]" } else { "" }
    write_declared(out, "${declarator.name}${suffix}", declarator.value, column, depth)
}

// `head = value`, `value` laid out by `write_initializer` ; `head` alone when
// `value` is null.
write_declared :: fn(
    out: StringBuilder!,
    head: string,
    value: CExpression | null,
    column: usize,
    depth: i32,
) -> void {
    out.append(head)
    if value != null {
        out.append(" =")
        write_initializer(out, value, column + head.bytes().len() + 2, depth)
    }
}

// ` value`, laid out by `write_initializer_line` from `column + 1` ; adjacent
// string literals that do not fit take one literal per line instead.
write_initializer :: fn(
    out: StringBuilder!,
    value: CExpression,
    column: usize,
    depth: i32,
) -> void {
    text :: text_of(value)
    if value is CStringLiterals && !fits(text, column + 1) {
        for literal in value.literals {
            out.append("\n")
            indent(out, depth + 1)
            out.append(literal)
        }
        return
    }
    out.append(" ")
    write_laid_out(out, value, text, column + 1, depth)
}

// `value` from `column`, on the current line when the line then fits in
// `LINE_WIDTH` columns with its `;` or `,`. Otherwise an initializer list opens
// a block one level deeper than `depth` : a table — every element a list —
// takes one element per line, any other list fills its lines.
write_initializer_line :: fn(
    out: StringBuilder!,
    value: CExpression,
    column: usize,
    depth: i32,
) -> void = write_laid_out(
    out,
    value,
    text_of(value),
    column,
    depth,
)

// `write_initializer_line` for a `value` already rendered on one line as `text`.
write_laid_out :: fn(
    out: StringBuilder!,
    value: CExpression,
    text: string,
    column: usize,
    depth: i32,
) -> void {
    if value !is CInitializerList || fits(text, column) {
        out.append(text)
        return
    }
    out.append("{\n")
    if is_table(value.elements) {
        for element in value.elements {
            indent(out, depth + 1)
            write_element(out, element, depth + 1)
            out.append(",\n")
        }
    } else {
        write_filled(out, value.elements, depth + 1)
    }
    indent(out, depth)
    out.append("}")
}

// Whether every one of `elements` is a list, bare or designated.
is_table :: fn(elements: CExpression[]) -> bool {
    for element in elements {
        listed :: if element is CDesignated { element.value } else { element }
        if listed !is CInitializerList {
            return false
        }
    }
    return true
}

// `elements` at `depth`, each followed by `,`, as many on a line as fit in
// `LINE_WIDTH` ; one too wide for a line of its own is laid out on its own lines.
write_filled :: fn(out: StringBuilder!, elements: CExpression[], depth: i32) -> void {
    start :: usize(depth) * INDENT_WIDTH
    column := start
    for element in elements {
        text :: text_of(element)
        width :: text.bytes().len() + 1
        if column > start && column + 1 + width > LINE_WIDTH {
            out.append("\n")
            column = start
        }
        if column == start {
            indent(out, depth)
        } else {
            out.append(" ")
            column += 1
        }
        if column + width > LINE_WIDTH {
            write_element(out, element, depth)
            out.append(",\n")
            column = start
        } else {
            out.append(text)
            out.append(",")
            column += width
        }
    }
    if column > start {
        out.append("\n")
    }
}

// One element of an initializer list, already indented to `depth`.
write_element :: fn(out: StringBuilder!, element: CExpression, depth: i32) -> void {
    column :: usize(depth) * INDENT_WIDTH
    if element is CDesignated {
        write_declared(out, element.designator, element.value, column, depth)
    } else {
        write_initializer_line(out, element, column, depth)
    }
}

// Whether `text`, written from `column`, leaves room for a closing `;` or `,`
// within `LINE_WIDTH`.
fits :: fn(text: string, column: usize) -> bool = column + text.bytes().len() + 1 <= LINE_WIDTH

// `expression` as C text, on one line.
text_of :: fn(expression: CExpression) -> string {
    out :: StringBuilder {}
    write_expression(out, expression)
    return out.to_string()
}

// `expressions` separated by `, `.
write_list :: fn(out: StringBuilder!, expressions: CExpression[]) -> void {
    for k in 0..<expressions.len() {
        if k > 0 {
            out.append(", ")
        }
        write_expression(out, expressions[k])
    }
}

indent :: fn(out: StringBuilder!, depth: i32) -> void = out.append_repeated(
    ' ',
    depth * i32(INDENT_WIDTH),
)

write_line :: fn(out: StringBuilder!, text: string, depth: i32) -> void {
    indent(out, depth)
    out.append(text)
    out.append("\n")
}

write_directive :: fn(out: StringBuilder!, text: string) -> void {
    out.append(text)
    out.append("\n")
}

write_closer :: fn(out: StringBuilder!, label: string, depth: i32) -> void = write_line(
    out,
    if label == "" { "}" } else { "} ${label}" },
    depth,
)

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_print_block_indents_an_if :: fn() -> void {
    root :: CBlock {
        .body = [
            CIf {
                .condition = verbatim("a"),
                .then_block = CBlock { .body = [assigned("x", "1")] },
            },
        ],
    }
    printer :: CPrinter {}
    printer.print_block(root, 1)
    assert_eq(printer.printed_text(), "    if (a) {\n        x = 1;\n    }\n")
}

@test
test_print_block_folds_an_else_if_chain :: fn() -> void {
    innermost :: CIf {
        .condition = verbatim("c"),
        .then_block = CBlock { .body = [assigned("x", "3")] },
    }
    inner :: CIf {
        .condition = verbatim("b"),
        .then_block = CBlock { .body = [assigned("x", "2")] },
        .else_block = CBlock { .body = [innermost] },
    }
    root :: CBlock {
        .body = [
            CIf {
                .condition = verbatim("a"),
                .then_block = CBlock { .body = [assigned("x", "1")] },
                .else_block = CBlock {
                    .body = [CDirective { .text = "#line 4 \"f.vader\"" }, inner],
                },
            },
        ],
    }
    printer :: CPrinter {}
    printer.print_block(root, 1)
    assert_eq(
        printer.printed_text(),
        [
            "    if (a) {",
            "        x = 1;",
            "#line 4 \"f.vader\"",
            "    } else if (b) {",
            "        x = 2;",
            "    } else if (c) {",
            "        x = 3;",
            "    }",
            "",
        ].join(
            "\n",
        ),
    )
}

@test
test_print_block_keeps_an_arm_with_two_statements :: fn() -> void {
    root :: CBlock {
        .body = [
            CIf {
                .condition = verbatim("a"),
                .then_block = CBlock { .body = [] },
                .else_block = CBlock {
                    .body = [
                        assigned("t0", "f()"),
                        CIf { .condition = verbatim("t0"), .then_block = CBlock { .body = [] } },
                    ],
                },
            },
        ],
    }
    printer :: CPrinter {}
    printer.print_block(root, 1)
    assert_eq(
        printer.printed_text(),
        "    if (a) {\n    } else {\n        t0 = f();\n        if (t0) {\n        }\n    }\n",
    )
}

@test
test_print_block_keeps_both_labels_apart :: fn() -> void {
    inner :: CIf {
        .condition = verbatim("b"),
        .then_block = CBlock { .body = [] },
        .end_label = "end_7: ;",
    }
    root :: CBlock {
        .body = [
            CIf {
                .condition = verbatim("a"),
                .then_block = CBlock { .body = [] },
                .else_block = CBlock { .body = [inner] },
                .end_label = "end_3: ;",
            },
        ],
    }
    printer :: CPrinter {}
    printer.print_block(root, 1)
    assert_eq(
        printer.printed_text(),
        "    if (a) {\n    } else {\n        if (b) {\n        } end_7: ;\n    } end_3: ;\n",
    )
}

@test
test_print_block_writes_trailing_directives_below_the_closer :: fn() -> void {
    inner :: CIf {
        .condition = verbatim("b"),
        .then_block = CBlock { .body = [] },
        .else_block = CBlock {
            .body = [assigned("x", "2"), CDirective { .text = "#line 9" }],
        },
    }
    root :: CBlock {
        .body = [
            CIf {
                .condition = verbatim("a"),
                .then_block = CBlock { .body = [] },
                .else_block = CBlock { .body = [inner, CDirective { .text = "#line 8" }] },
            },
        ],
    }
    printer :: CPrinter {}
    printer.print_block(root, 1)
    assert_eq(
        printer.printed_text(),
        [
            "    if (a) {",
            "    } else if (b) {",
            "    } else {",
            "        x = 2;",
            "#line 9",
            "    }",
            "#line 8",
            "",
        ].join(
            "\n",
        ),
    )
}

// `<name> = <value>;`.
assigned :: fn(name: string, value: string) -> CStatement = CAssign {
    .target = verbatim(name),
    .value = verbatim(value),
}

// `*out<index> = l<slot>`.
store :: fn(index: i32, slot: i32) = CAssign {
    .target = verbatim("*out${index}"),
    .value = CLocal { .slot = slot },
}

@test
test_print_block_spells_every_return :: fn() -> void {
    root :: CBlock {
        .body = [
            CReturn {},
            CReturn { .value = CLocal { .slot = 0 } },
            CReturn { .stores = [store(0, 1)] },
            CReturn { .pops_frame = true },
            CReturn {
                .value = CLocal { .slot = 0 },
                .snapshot_type = "int32_t",
                .pops_frame = true,
            },
            CReturn { .stores = [store(0, 1), store(1, 2)], .pops_frame = true },
        ],
    }
    printer :: CPrinter {}
    printer.print_block(root, 0)
    assert_eq(
        printer.printed_text(),
        [
            "return;",
            "return l0;",
            "*out0 = l1; return;",
            "{ vader_gc_top = gc_frame.prev; return; }",
            "{ int32_t __vret = l0; vader_gc_top = gc_frame.prev; return __vret; }",
            "{ *out0 = l1; *out1 = l2; vader_gc_top = gc_frame.prev; return; }",
            "",
        ].join(
            "\n",
        ),
    )
}

@test
test_text_of_spells_every_expression :: fn() -> void {
    value :: CMember {
        .base = CTemporary { .id = 3, .val = .Any, .slot = 3 },
        .member = "payload.i",
    }
    call :: CCall {
        .callee = "vader_box_i32",
        .arguments = [
            verbatim("7u"),
            CCast { .types = ["int32_t", "uint32_t"], .value = CLocal { .slot = 2 } },
        ],
    }
    sum :: CParenthesized { .inner = CBinary { .operator = .Add, .left = value, .right = call } }
    assert_eq(text_of(sum), "(t3.payload.i + vader_box_i32(7u, (int32_t)(uint32_t) l2))")
    assert_eq(
        text_of(
            CUnary {
                .operator = "-",
                .operand = CSequence { .parts = [verbatim("a"), verbatim("b")] },
            },
        ),
        "-(ab)",
    )
}

@test
test_text_of_spells_integer_extremes_as_macros :: fn() -> void {
    assert_eq(text_of(CIntegerLiteral { .class = .I32, .value = I32_MIN }), "INT32_MIN")
    assert_eq(text_of(CIntegerLiteral { .class = .I64, .value = I64_MIN }), "INT64_MIN")
    assert_eq(text_of(CIntegerLiteral { .class = .I64, .value = -5 }), "INT64_C(-5)")
}

@test
test_text_of_parenthesises_a_looser_operand :: fn() -> void {
    equality :: CBinary { .operator = .Equal, .left = CLocal { .slot = 0 }, .right = verbatim("1") }
    assert_eq(text_of(CCast { .types = ["uint8_t"], .value = equality }), "(uint8_t) (l0 == 1)")
    assert_eq(
        text_of(CBinary { .operator = .Equal, .left = verbatim("a"), .right = equality }),
        "a == (l0 == 1)",
    )
    assert_eq(
        text_of(CBinary { .operator = .LogicalOr, .left = equality, .right = equality }),
        "l0 == 1 || l0 == 1",
    )
}

@test
test_print_block_spells_declarations :: fn() -> void {
    root :: CBlock {
        .body = [
            CDeclaration {
                .type = "int32_t",
                .declarators = [
                    CDeclarator { .name = "l1" },
                    CDeclarator { .name = "l2", .value = verbatim("0") },
                ],
            },
            array_declaration(
                "void*",
                "roots",
                [address_of(CLocal { .slot = 1 }), verbatim("NULL")],
            ),
        ],
    }
    printer :: CPrinter {}
    printer.print_block(root, 0)
    assert_eq(printer.printed_text(), "int32_t l1, l2 = 0;\nvoid* roots[2] = { &l1, NULL };\n")
}

@test
test_print_block_spells_a_compound_assignment :: fn() -> void {
    root :: CBlock {
        .body = [CAssign { .target = verbatim("n"), .value = verbatim("1"), .operator = .Add }],
    }
    printer :: CPrinter {}
    printer.print_block(root, 0)
    assert_eq(printer.printed_text(), "n += 1;\n")
}

@test
test_print_function_writes_prologue_then_body :: fn() -> void {
    function :: CFunction {
        .signature = CSignature { .storage = .Internal, .result = "void", .name = "f" },
        .prologue = [declaration("int32_t", "l0")],
        .body = CBlock { .body = [assigned("l0", "1")] },
    }
    printer :: CPrinter {}
    printer.print_item(function)
    assert_eq(printer.printed_text(), "static void f(void) {\n    int32_t l0;\n    l0 = 1;\n}\n")
}

@test
test_print_block_spells_a_switch :: fn() -> void {
    effect :: CExpressionStatement { .expression = call("f", []) }
    switch_node :: CSwitch {
        .subject = CMember { .base = verbatim("recv"), .member = "tag" },
        .cases = [
            CCase { .value = verbatim("4u"), .body = [CReturn { .value = verbatim("1") }] },
            CCase { .value = verbatim("7u"), .body = [effect] },
        ],
        .default_body = [effect],
    }
    printer :: CPrinter {}
    printer.print_block(CBlock { .body = [switch_node] }, 0)
    assert_eq(
        printer.printed_text(),
        [
            "switch (recv.tag) {",
            "    case 4u: return 1;",
            "    case 7u: f(); break;",
            "    default: f();",
            "}",
            "",
        ].join(
            "\n",
        ),
    )
}

// `count` names, `name_number_0` onwards.
names :: fn(count: i32) -> CExpression[]! {
    out: CExpression[]!: []
    for k in 0..<count {
        out.push(verbatim("name_number_${k}"))
    }
    return out
}

// An unsized `int x[]` initialised with `value`, as C text.
global_text :: fn(value: CExpression) -> string {
    text :: StringBuilder {}
    declarator :: CDeclarator { .name = "x", .length = UNSIZED, .value = value }
    write_top_level(text, CGlobal { .type = "int", .declarator = declarator })
    return text.to_string()
}

@test
test_print_section_sets_functions_apart :: fn() -> void {
    signature :: CSignature { .result = "void", .name = "f" }
    function :: CFunction { .signature = signature, .body = CBlock { .body = [] } }
    printer :: CPrinter {}
    printer.print_section(
        CSection {
            .comment = ["two prototypes", "then a function"],
            .items = [
                CPrototype { .signature = signature },
                CPrototype { .signature = signature },
                function,
            ],
        },
    )
    printer.print_section(CSection { .comment = ["nothing"], .items = [] })
    printer.print_section(CSection { .items = [CInclude { .path = "last.h" }] })
    expected :: """
/* two prototypes
 * then a function */
void f(void);
void f(void);

void f(void) {
}

#include "last.h"
"""
    assert_eq(printer.printed_text(), expected)
}

@test
test_unit_text_keeps_a_short_initializer_on_one_line :: fn() -> void {
    assert_eq(
        global_text(initializer_list(names(2))),
        "int x[] = { name_number_0, name_number_1 };\n",
    )
    assert_eq(global_text(initializer_list([])), "int x[] = { };\n")
}

@test
test_unit_text_fills_the_lines_of_a_long_scalar_list :: fn() -> void {
    expected :: """
int x[] = {
    name_number_0, name_number_1, name_number_2, name_number_3, name_number_4, name_number_5,
    name_number_6,
};
"""
    assert_eq(global_text(initializer_list(names(7))), expected)
}

@test
test_unit_text_puts_one_table_row_per_line :: fn() -> void {
    rows: CExpression[]!: []
    for k in 0..<3 {
        rows.push(designated("[${k}]", initializer_list(names(2))))
    }
    expected :: """
int x[] = {
    [0] = { name_number_0, name_number_1 },
    [1] = { name_number_0, name_number_1 },
    [2] = { name_number_0, name_number_1 },
};
"""
    assert_eq(global_text(initializer_list(rows)), expected)
}

@test
test_unit_text_breaks_long_string_literals_one_per_line :: fn() -> void {
    literal :: "\"abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghij\""
    expected :: "int x[] =\n    ${literal}\n    ${literal};\n"
    assert_eq(global_text(CStringLiterals { .literals = [literal, literal] }), expected)
}
