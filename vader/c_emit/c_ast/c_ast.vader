// vader/c_emit/c_ast/c_ast — the tree a C function is built as.
//
// The walker (`vader/c_emit/walker.vader`, through `stack.vader`) appends
// statements to the block it is in, and `print.vader` writes the whole tree
// once the walk is done. A nested block is a node of its own, so its depth is
// structural.
//
// Expressions are nodes too (`CExpression`) : an operand temporary or a local
// is a node of its own, so a pass over the tree finds every use of one without
// reading C text. Shapes the tree does not model yet are spelled as
// `CVerbatim` text inside a `CSequence`.

module "vader/c_emit/c_ast"

import "vader/bytecode"

/// One statement of a C function body.
export CStatement :: CDirective
            | CAssign
            | CExpressionStatement
            | CMacroStatement
            | CDeclaration
            | CIf
            | CScope
            | CReturn
            | CGoto
            | CSwitch

/// `target = value;`.
export CAssign :: struct {
    target: CExpression
    value: CExpression
    /// `target operator= value` — a compound assignment ; null for plain `=`.
    operator: CBinaryOperator | null = null
}

/// `expression;`.
export CExpressionStatement :: struct {
    expression: CExpression
}

/// A statement macro invocation (`VADER_ARRAY_CHECK_INDEX(a, i)`) : its
/// expansion is a whole statement, so it takes no `;` of its own.
export CMacroStatement :: struct {
    call: CCall
}

/// `type d1, d2 = v, d3[n] = { … };` — one type, several declarators.
export CDeclaration :: struct {
    type: string
    declarators: CDeclarator[]
}

/// One name of a `CDeclaration` : `name`, `name[length]`, `name = value`.
export CDeclarator :: struct {
    name: string
    /// The element count of an array, `UNSIZED` for `name[]`, null for a scalar.
    length: i32 | CUnsized | null = null
    value: CExpression | null = null
}

/// The length of an array declared `name[]` : taken from its initializer, or
/// defined in another unit.
export CUnsized :: struct {}

/// `[]` in a declarator.
export UNSIZED :: CUnsized {}

/// A C function definition : its signature, the statements declaring its
/// locals and setting up its GC frame, then its body.
export CFunction :: struct {
    signature: CSignature
    prologue: CStatement[] = []
    body: CBlock
}

/// A preprocessor line (`#line`), written at column 0.
export CDirective :: struct {
    text: string
}

/// A statement that leaves the function : out-param stores, then `return`.
export CReturn :: struct {
    /// Assignments run before leaving — a multi-value return's `*outN = v`.
    stores: CAssign[] = []
    /// The returned expression ; null for a void return.
    value: CExpression | null = null
    /// The C type `value` is read into before the GC frame is popped, because
    /// it may read a frame-pinned local ; `""` to return it directly. Only a
    /// return that pops the frame needs it.
    snapshot_type: string = ""
    /// Restore the caller's GC frame on the way out.
    pops_frame: bool = false
}

/// A sequence of statements, written one level deeper than the construct that
/// holds it.
export CBlock :: struct {
    body: CStatement[]!
}

/// `if (condition) { … } else { … }`. An `else` whose only statement is an
/// `if` prints as `else if` (`write_if`).
export CIf :: struct {
    condition: CExpression
    then_block: CBlock!
    else_block: CBlock! | null = null
    /// `end_N: ;` after the closing brace, when a `goto` exits past the `if`.
    end_label: string = ""
}

/// `goto label;`, or `if (condition) goto label;`.
export CGoto :: struct {
    label: string
    condition: CExpression | null = null
}

/// `switch (subject) { case value: … default: … }`. A clause is printed on its
/// `case` line ; one neither last nor leaving the switch gets a `break;` —
/// clauses never fall through.
export CSwitch :: struct {
    subject: CExpression
    cases: CCase[]
    default_body: CCaseStatement[] | null = null
}

/// `case value: body`.
export CCase :: struct {
    value: CExpression
    body: CCaseStatement[]
}

/// A statement a switch clause may hold : one that fits on the `case` line.
export CCaseStatement :: CExpressionStatement | CReturn | CGoto

/// A braced block — `{`, or `label: {` for a loop's continue target — closed
/// by `}`.
export CScope :: struct {
    /// The label before the opening brace ; `""` for none.
    label: string = ""
    body: CBlock!
    /// `end_N: ;` after the closing brace, when a `goto` exits past the scope.
    end_label: string = ""
}

// ---- expressions ----------------------------------------------------------

/// One C expression.
export CExpression :: CTemporary
             | CLocal
             | CVerbatim
             | CIntegerLiteral
             | CNumber
             | CCall
             | CCast
             | CCastToTypeOf
             | CBinary
             | CUnary
             | CAddressOf
             | CParenthesized
             | CMember
             | CIndex
             | CConditional
             | CInitializerList
             | CDesignated
             | CCompoundLiteral
             | CStringLiterals
             | CSequence

/// An operand temporary of stack class `val`, printed `t<slot>` ; printing one
/// before `coalesce_temporaries` gave it a slot is an internal error.
export CTemporary :: struct {
    id: i32
    val: ValType
    slot: i32 = -1
}

/// A local slot, `l<slot>`.
export CLocal :: struct {
    slot: i32
}

/// C text with no operand in it : a name, a literal, a macro.
export CVerbatim :: struct {
    text: string
}

/// An integer constant of stack class `.I32` or `.I64` : `INT32_C(n)`, or the
/// `INT32_MIN` / `INT64_MIN` macro for the most negative value.
export CIntegerLiteral :: struct {
    class: ValType
    value: i64
}

/// A plain C integer constant, `12`, or `12u` when `unsigned`.
export CNumber :: struct {
    value: i64
    unsigned: bool = false
}

/// `callee(arguments…)`.
export CCall :: struct {
    callee: string
    arguments: CExpression[]
}

/// `designator = value` inside an initializer : `.field = v`, `[3] = v`.
export CDesignated :: struct {
    designator: string
    value: CExpression
}

/// `(type){ elements… }`.
export CCompoundLiteral :: struct {
    type: string
    elements: CExpression[]
}

/// Adjacent C string literals, concatenated by the compiler : `"ab" "\0" "cd"`.
/// Each entry is already spelled as C source.
export CStringLiterals :: struct {
    literals: string[]
}

/// `{ elements… }` — an aggregate initializer.
export CInitializerList :: struct {
    elements: CExpression[]
}

/// `(T1)(T2) value` : the casts in `types` apply right to left, written with
/// no space between them.
export CCast :: struct {
    types: string[]
    value: CExpression
}

/// A C binary operator's spelling and how tightly C binds it — higher binds
/// tighter.
export COperatorInfo :: struct {
    spelling: string
    precedence: i32
}

/// A C binary operator ; `COperatorInfo(operator)` gives its spelling and
/// precedence.
export CBinaryOperator :: enum(COperatorInfo) {
    Multiply       { .spelling = "*", .precedence = 10 },
    Divide         { .spelling = "/", .precedence = 10 },
    Remainder      { .spelling = "%", .precedence = 10 },
    Add            { .spelling = "+", .precedence = 9 },
    Subtract       { .spelling = "-", .precedence = 9 },
    ShiftLeft      { .spelling = "<<", .precedence = 8 },
    ShiftRight     { .spelling = ">>", .precedence = 8 },
    Less           { .spelling = "<", .precedence = 7 },
    LessOrEqual    { .spelling = "<=", .precedence = 7 },
    Greater        { .spelling = ">", .precedence = 7 },
    GreaterOrEqual { .spelling = ">=", .precedence = 7 },
    Equal          { .spelling = "==", .precedence = 6 },
    NotEqual       { .spelling = "!=", .precedence = 6 },
    BitAnd         { .spelling = "&", .precedence = 5 },
    BitXor         { .spelling = "^", .precedence = 4 },
    BitOr          { .spelling = "|", .precedence = 3 },
    LogicalAnd     { .spelling = "&&", .precedence = 2 },
    LogicalOr      { .spelling = "||", .precedence = 1 },
}

/// `(__typeof__(model)) value` — `value` converted to the type of another
/// expression, for a member whose C type only the header knows. `model` is
/// never evaluated, so it reads no local and no temporary.
export CCastToTypeOf :: struct {
    model: CExpression
    value: CExpression
}

/// `left operator right` ; the printer parenthesises an operand C would
/// otherwise group differently.
export CBinary :: struct {
    operator: CBinaryOperator
    left: CExpression
    right: CExpression
}

/// `operator(operand)`.
export CUnary :: struct {
    operator: string
    operand: CExpression
}

/// `&operand`. Unlike `CUnary`, whose `op(operand)` form always parenthesises,
/// its operand is parenthesised only when C would otherwise bind it looser.
export CAddressOf :: struct {
    operand: CExpression
}

/// `(inner)`.
export CParenthesized :: struct {
    inner: CExpression
}

/// `base.member`, or `base->member` through a pointer — `member` may be a path
/// (`payload.i`).
export CMember :: struct {
    base: CExpression
    member: string
    arrow: bool = false
}

/// `base[index]`.
export CIndex :: struct {
    base: CExpression
    index: CExpression
}

/// `condition ? then_value : else_value`, unparenthesised.
export CConditional :: struct {
    condition: CExpression
    then_value: CExpression
    else_value: CExpression
}

/// The concatenation of `parts`, for a shape with no node of its own.
export CSequence :: struct {
    parts: CExpression[]
}

/// `CVerbatim` over `text`.
///
/// @param text  C text with no operand in it.
export verbatim :: fn(text: string) -> CExpression = CVerbatim { .text = text }

/// `prefix`, `inner`, `suffix` as one `CSequence`.
///
/// @param prefix  the text written before `inner`.
/// @param inner   the expression in the middle.
/// @param suffix  the text written after it.
export around :: fn(prefix: string, inner: CExpression, suffix: string) -> CExpression = CSequence {
    .parts = [verbatim(prefix), inner, verbatim(suffix)],
}

/// `parts[0] || parts[1] || …`, unparenthesised.
///
/// @param parts  the disjuncts, left to right ; must not be empty.
export any_of :: fn(parts: CExpression[]) -> CExpression {
    disjunction := parts[0]
    for k in 1..<parts.len() {
        disjunction = CBinary { .operator = .LogicalOr, .left = disjunction, .right = parts[k] }
    }
    return disjunction
}

/// `type name = value;`, or `type name;` when `value` is null.
///
/// @param type   the declared C type.
/// @param name   the declared name.
/// @param value  its initializer.
export declaration :: fn(type: string, name: string, value: CExpression | null = null) -> CStatement = CDeclaration {
    .type = type,
    .declarators = [CDeclarator { .name = name, .value = value }],
}

/// `type name[n] = { elements… };` — `n` is the element count.
///
/// @param type      the element type.
/// @param name      the declared array.
/// @param elements  its initializers.
export array_declaration :: fn(type: string, name: string, elements: CExpression[]) -> CStatement {
    initializer :: CInitializerList { .elements = elements }
    declarator :: CDeclarator { .name = name, .length = i32(elements.len()), .value = initializer }
    return CDeclaration { .type = type, .declarators = [declarator] }
}

/// `{ elements… }`.
///
/// @param elements  the initializers, in order.
export initializer_list :: fn(elements: CExpression[]) -> CExpression = CInitializerList {
    .elements = elements,
}

/// `designator = value`, inside an initializer list.
///
/// @param designator  `.field` or `[index]`.
/// @param value       the member's initializer.
export designated :: fn(designator: string, value: CExpression) -> CExpression = CDesignated {
    .designator = designator,
    .value = value,
}

/// `value`, a plain `int` constant.
///
/// @param value  the constant.
export number :: fn(value: i64) -> CExpression = CNumber { .value = value }

/// `value` with the `u` suffix.
///
/// @param value  the constant.
export unsigned :: fn(value: i64) -> CExpression = CNumber { .value = value, .unsigned = true }

/// `0u`.
export ZERO :: CNumber { .value = 0, .unsigned = true }

/// The null pointer, `NULL`.
export NULL_POINTER :: CVerbatim { .text = "NULL" }

/// `callee(arguments…);`.
///
/// @param callee     the function called for its effect.
/// @param arguments  its arguments, left to right.
export perform :: fn(callee: string, arguments: CExpression[]) -> CStatement = CExpressionStatement {
    .expression = call(callee, arguments),
}

/// `return callee(arguments…);`.
///
/// @param callee     the function whose result is returned.
/// @param arguments  its arguments, left to right.
export returning :: fn(callee: string, arguments: CExpression[]) -> CStatement = CReturn {
    .value = call(callee, arguments),
}

/// The statement that restores the caller's GC frame.
export FRAME_RESTORE :: CAssign {
    .target = CVerbatim { .text = "vader_gc_top" },
    .value = CVerbatim { .text = "gc_frame.prev" },
}

/// `callee(arguments…)`.
///
/// @param callee     the function or macro called.
/// @param arguments  its arguments, left to right.
export call :: fn(callee: string, arguments: CExpression[]) -> CExpression = CCall {
    .callee = callee,
    .arguments = arguments,
}

/// `left operator right`.
///
/// @param operator  the binary operator.
/// @param left      its left operand.
/// @param right     its right operand.
export binary :: fn(
    operator: CBinaryOperator,
    left: CExpression,
    right: CExpression,
) -> CExpression = CBinary {
    .operator = operator,
    .left = left,
    .right = right,
}

/// `&operand`.
///
/// @param operand  the object whose address is taken.
export address_of :: fn(operand: CExpression) -> CExpression = CAddressOf { .operand = operand }

/// `(type) value`.
///
/// @param type   the C type to cast to.
/// @param value  the expression cast.
export cast :: fn(type: string, value: CExpression) -> CExpression = CCast {
    .types = [type],
    .value = value,
}

/// `((type) value)->member`.
///
/// @param type    the pointer type `value` is cast to.
/// @param value   the pointer.
/// @param member  the member read through it.
export pointer_member :: fn(type: string, value: CExpression, member: string) -> CExpression = CMember {
    .base = CParenthesized { .inner = cast(type, value) },
    .member = member,
    .arrow = true,
}

/// Whether `literal` is the most negative value of its class, spelled as the
/// `INT32_MIN` / `INT64_MIN` macro.
///
/// @param literal  the integer constant.
export is_most_negative :: fn(literal: CIntegerLiteral) -> bool = if literal.class == .I64 {
    literal.value == I64_MIN
} else { literal.value == I32_MIN }

/// Most negative `int64_t`, the value `INT64_MIN` spells.
I64_MIN: i64: -0x8000_0000_0000_0000
/// Most negative `int32_t`, the value `INT32_MIN` spells.
I32_MIN: i64: -0x8000_0000

// ---- translation units ----------------------------------------------------

/// A run of top-level items under an optional comment. The printer sets a
/// section a blank line away from the one before, and a function a blank line
/// away from its neighbours ; a section with no item prints nothing.
export CSection :: struct {
    /// The comment above the items, one entry per line ; empty for none.
    comment: string[] = []
    items: CTopLevel[]
}

/// One top-level item of a C translation unit.
export CTopLevel :: CInclude
           | CDefine
           | CStructForward
           | CStructDefinition
           | CGlobal
           | CPrototype
           | CFunctionPointerTypedef
           | CFunction
           | CStaticAssert

/// `#include "path"`, or `#include <path>` for a `system` header — searched on
/// the system include path only.
export CInclude :: struct {
    path: string
    system: bool = false
}

/// `#define name value`.
export CDefine :: struct {
    name: string
    value: CExpression
}

/// `typedef struct name name;`.
export CStructForward :: struct {
    name: string
}

/// `struct name { fields… };`.
export CStructDefinition :: struct {
    name: string
    fields: CField[]
}

/// One member of a `CStructDefinition`.
export CField :: struct {
    type: string
    name: string
}

/// A global : `storage const type name[length] = initializer;`.
export CGlobal :: struct {
    storage: CStorage = .External
    /// Read-only : `const`.
    constant: bool = false
    type: string
    declarator: CDeclarator
}

/// Where a global is visible, and whether this is its definition.
export CStorage :: enum {
    /// Private to its unit : `static`.
    Internal,
    /// Defined here, visible to every unit.
    External,
    /// Defined in another unit : `extern`, never initialised.
    Declaration,
}

/// A function declaration : `signature;`.
export CPrototype :: struct {
    signature: CSignature
}

/// `storage inline result name(parameters)` — the head a prototype and its
/// definition share.
export CSignature :: struct {
    /// `.Declaration` is a prototype for a function defined in another unit.
    storage: CStorage = .External
    inline: bool = false
    result: string
    name: string
    /// Empty for `(void)`.
    parameters: CParameter[] = []
}

/// One parameter : `type name`, or `type` alone in a declaration that names
/// none.
export CParameter :: struct {
    type: string
    name: string = ""
}

/// `typedef result (*name)(parameters);`.
export CFunctionPointerTypedef :: struct {
    result: string
    name: string
    parameters: CParameter[]
}

/// `_Static_assert(condition, message);` — a check `cc` spends at build time.
export CStaticAssert :: struct {
    condition: CExpression
    /// The message, a string literal.
    message: CStringLiterals
}

// ---- queries ------------------------------------------------------------

/// Whether `block` ends on a `return`, `#line` directives aside — its end is
/// then unreachable.
///
/// @param block  the statements to inspect.
export ends_with_return :: fn(block: CBlock) -> bool {
    body :: block.body
    last :: body.len() - trailing_directives(body, 0)
    return last > 0 && body[last - 1] is CReturn
}

/// Whether `expression` reads local `l<slot>`.
///
/// @param expression  the expression to search.
/// @param slot        the local's slot.
export mentions_local :: fn(expression: CExpression, slot: i32) -> bool = match expression {
    is CLocal                                   -> expression.slot == slot
    is CTemporary | CVerbatim | CIntegerLiteral -> false
    is CCall                                    -> any_mentions_local(expression.arguments, slot)
    is CCast                                    -> mentions_local(expression.value, slot)
    is CCastToTypeOf                            -> mentions_local(expression.value, slot)
    is CBinary                                  -> mentions_local(expression.left, slot) || mentions_local(
        expression.right,
        slot,
    )
    is CUnary                                   -> mentions_local(expression.operand, slot)
    is CAddressOf                               -> mentions_local(expression.operand, slot)
    is CParenthesized                           -> mentions_local(expression.inner, slot)
    is CMember                                  -> mentions_local(expression.base, slot)
    is CIndex                                   -> mentions_local(expression.base, slot) || mentions_local(
        expression.index,
        slot,
    )
    is CConditional                             -> {
        mentions_local(expression.condition, slot) || mentions_local(expression.then_value, slot) || mentions_local(
            expression.else_value,
            slot,
        )
    }
    is CInitializerList                         -> any_mentions_local(expression.elements, slot)
    is CCompoundLiteral                         -> any_mentions_local(expression.elements, slot)
    is CDesignated                              -> mentions_local(expression.value, slot)
    is CStringLiterals | CNumber                -> false
    is CSequence                                -> any_mentions_local(expression.parts, slot)
}

/// Whether `a` and `b` are the same expression, node for node.
///
/// @param a  one expression.
/// @param b  the other.
export same_expression :: fn(a: CExpression, b: CExpression) -> bool = match a {
    is CTemporary       -> b is CTemporary && b.id == a.id
    is CLocal           -> b is CLocal && b.slot == a.slot
    is CVerbatim        -> b is CVerbatim && b.text == a.text
    is CIntegerLiteral  -> b is CIntegerLiteral && b.class == a.class && b.value == a.value
    is CNumber          -> b is CNumber && b.value == a.value && b.unsigned == a.unsigned
    is CCall            -> b is CCall && b.callee == a.callee && same_expressions(
        a.arguments,
        b.arguments,
    )
    is CCastToTypeOf    -> {
        b is CCastToTypeOf && same_expression(a.model, b.model) && same_expression(a.value, b.value)
    }
    is CCast            -> b is CCast && same_strings(a.types, b.types) && same_expression(
        a.value,
        b.value,
    )
    is CBinary          -> {
        b is CBinary && b.operator == a.operator && same_expression(a.left, b.left) && same_expression(
            a.right,
            b.right,
        )
    }
    is CAddressOf       -> b is CAddressOf && same_expression(a.operand, b.operand)
    is CUnary           -> b is CUnary && b.operator == a.operator && same_expression(
        a.operand,
        b.operand,
    )
    is CParenthesized   -> b is CParenthesized && same_expression(a.inner, b.inner)
    is CMember          -> b is CMember && b.member == a.member && b.arrow == a.arrow && same_expression(
        a.base,
        b.base,
    )
    is CIndex           -> b is CIndex && same_expression(a.base, b.base) && same_expression(
        a.index,
        b.index,
    )
    is CConditional     -> {
        b is CConditional && same_expression(a.condition, b.condition) && same_expression(
            a.then_value,
            b.then_value,
        ) && same_expression(a.else_value, b.else_value)
    }
    is CInitializerList -> b is CInitializerList && same_expressions(a.elements, b.elements)
    is CCompoundLiteral -> b is CCompoundLiteral && b.type == a.type && same_expressions(
        a.elements,
        b.elements,
    )
    is CDesignated      -> b is CDesignated && b.designator == a.designator && same_expression(
        a.value,
        b.value,
    )
    is CStringLiterals  -> b is CStringLiterals && same_strings(a.literals, b.literals)
    is CSequence        -> b is CSequence && same_expressions(a.parts, b.parts)
}

// `a` and `b` pairwise the same.
same_expressions :: fn(a: CExpression[], b: CExpression[]) -> bool {
    if a.len() != b.len() {
        return false
    }
    for k in 0..<a.len() {
        if !same_expression(a[k], b[k]) {
            return false
        }
    }
    return true
}

same_strings :: fn(a: string[], b: string[]) -> bool {
    if a.len() != b.len() {
        return false
    }
    for k in 0..<a.len() {
        if a[k] != b[k] {
            return false
        }
    }
    return true
}

// Whether any of `expressions` reads local `l<slot>`.
any_mentions_local :: fn(expressions: CExpression[], slot: i32) -> bool {
    for expression in expressions {
        if mentions_local(expression, slot) {
            return true
        }
    }
    return false
}

// The number of `#line` directives `statements` starts with.
leading_directives :: fn(statements: CStatement[]) -> usize {
    n: usize = 0
    for n < statements.len() && statements[n] is CDirective {
        n += 1
    }
    return n
}

// The number of `#line` directives `statements[from…]` ends with.
trailing_directives :: fn(statements: CStatement[], from: usize) -> usize {
    n: usize = 0
    for statements.len() - n > from && statements[statements.len() - 1 - n] is CDirective {
        n += 1
    }
    return n
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_ends_with_return_skips_trailing_directives :: fn() -> void {
    block :: CBlock { .body = [CReturn { .pops_frame = true }, CDirective { .text = "#line 3" }] }
    assert(ends_with_return(block), "a return followed by a directive ends the block")
}

@test
test_ends_with_return_rejects_directives_only :: fn() -> void {
    assert(
        !ends_with_return(CBlock { .body = [CDirective { .text = "#line 3" }] }),
        "directives alone are no return",
    )
}
