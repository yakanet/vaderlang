// vader/c_emit/c_ast/coalesce — post-walk operand-temp cleanup: copy elision + slot
// coalescing, on the statement tree (`c_ast.vader`).
//
// The body walker (`vader/c_emit/walker.vader`) mints a fresh `tN` for every
// materialised operand and never recycles it, so a function's frame — and its
// GC-root set — grows with the TOTAL number of materialisations, not the number
// live at once. The bytecode is a stack machine, so a temp is dead the moment
// its value is consumed ; most `tN` have short, disjoint live ranges.
//
// `coalesce_temporaries` does two things :
//   0. COPY ELISION — an adjacent `tN = EXPR;` / `lM = tN;` pair whose `tN` is
//      used nowhere else collapses to `lM = EXPR;`. The temp disappears
//      entirely (no slot, no GC root, no box copy) ; a copy between two
//      GC-rooted boxes is one the C compiler cannot elide, since both addresses
//      escape into `gc_roots[]`.
//   1. SLOT COALESCING — the surviving temps are packed by live range.
//
// A temp's live range is `[first, last]` over statement positions, numbered in
// print order (an `if` holds one position, its condition's). A temp is written
// once and can't be read before it is written, so its first use is its
// definition and its last is its final read. Temps whose ranges are disjoint,
// and share a `ValType`, share a slot.
//
// GC-safety : two temps share a slot only when their ranges are STRICTLY
// disjoint (`A.last < B.first`), so the slot only ever holds the currently-live
// value and its single `gc_roots[]` entry always points at a live object (or an
// already-dead one still reachable from the frame — harmless, never a dangling
// pointer). Position order is an EXACT live range only because no operand temp
// ever crosses a scope boundary : midir materialises every control-flow result
// into a named LOCAL (`if_res` / `and_res` / `or_res`, and loops are void —
// `vader/midir/build.vader`), so the operand stack is empty at every block /
// loop / if / br boundary and each `tN` is confined to one straight-line region
// where statement order IS execution order. This is why — unlike the sibling
// local-slot pass — no loop-range extension is needed. If a future change ever
// left an operand live across a scope, that invariant would break ; the
// walker's scope handlers are the place to guard it.
//
// Locals (`lN`) are left untouched : they are named, potentially reassigned, and
// can stay live across arbitrary control flow — they are coalesced upstream,
// loop-aware, by the bytecode pass instead.
//
// Sibling `vader/bytecode/slot_coalesce.vader` runs the same greedy
// interval-partition on the *other* IR — bytecode local slots (`lN`) over op
// PC-ranges — which this pass cannot reach : operand temps exist only in the
// c_emit walk, not in the bytecode.

module "vader/c_emit/c_ast"

import "std/sort"
import "vader/bytecode"

/// Elide temp-to-local copies, then pack the surviving temps into shared slots.
///
/// @param root         the function body ; copies are elided in place.
/// @param temporaries  every temp of the body, indexed by id ; each receives
///                     its `slot`.
/// @return             the ValType of each slot, indexed by slot.
export coalesce_temporaries :: fn(root: CBlock!, temporaries: CTemporary![]) -> ValType[]! {
    n :: temporaries.len()
    if n == 0 {
        return []
    }
    // Uses and live ranges in one walk. Positions stay valid through the copy
    // elision below : a fused copy statement holds nothing but its own temp,
    // so dropping it keeps every other range in the same order.
    usage :: TemporaryUsage { .uses = [0] * n, .first = [-1] * n, .last = [-1] * n }
    scan_block(root, usage)
    fuse_temp_local_copies(root, usage)
    // Greedy interval packing, per ValType. Process temps in first-use order ;
    // reuse a slot whose current occupant ended strictly before this temp begins
    // (equal endpoints share a statement, so they overlap).
    slot_types: ValType[]!: []
    slot_end: i32[]!: []
    for id in order_by_first(usage.first) {
        temporary :: temporaries[id]
        chosen: i32 = -1
        for slot in 0..<slot_types.len() {
            if slot_types[slot] == temporary.val && slot_end[slot] < usage.first[id] {
                chosen = i32(slot)
                break
            }
        }
        if chosen < 0 {
            chosen = i32(slot_types.len())
            slot_types.push(temporary.val)
            slot_end.push(usage.last[id])
        } else {
            slot_end[usize(chosen)] = usage.last[id]
        }
        temporary.slot = chosen
    }
    return slot_types
}

// Temp ids `0..<first.len()` that are used, ordered by first use (ties by id,
// via the stable sort).
order_by_first :: fn(first: i32[]) -> usize[] {
    used: usize[]!: []
    for id in 0..<first.len() {
        if first[id] >= 0 {
            used.push(id)
        }
    }
    return sort(used, (a: usize, b: usize) -> first[a] < first[b])
}

// ---- uses and live ranges -------------------------------------------------

/// Per temp id : how many times it is used, and the first / last statement
/// position it is used at (-1 = unused).
TemporaryUsage :: struct {
    uses: i32[]!
    first: i32[]!
    last: i32[]!
    /// The position of the statement being scanned.
    position: i32 = -1
}

scan_block :: fn(block: CBlock, usage: TemporaryUsage!) -> void {
    for statement in block.body {
        usage.position += 1
        match statement {
            is CLine | CDirective   -> {}
            is CAssign              -> {
                scan_expression(statement.target, usage)
                scan_expression(statement.value, usage)
            }
            is CExpressionStatement -> scan_expression(statement.expression, usage)
            is CDeclaration         -> scan_expression(statement.value, usage)
            is CGoto                -> {
                condition :: statement.condition
                if condition != null {
                    scan_expression(condition, usage)
                }
            }
            is CIf                  -> {
                scan_expression(statement.condition, usage)
                scan_block(statement.then_block, usage)
                else_block :: statement.else_block
                if else_block != null {
                    scan_block(else_block, usage)
                }
            }
            is CScope               -> scan_block(statement.body, usage)
            is CReturn              -> {
                for store in statement.stores {
                    scan_expression(store.target, usage)
                    scan_expression(store.value, usage)
                }
                value :: statement.value
                if value != null {
                    scan_expression(value, usage)
                }
            }
        }
    }
}

scan_expression :: fn(expression: CExpression, usage: TemporaryUsage!) -> void {
    match expression {
        is CTemporary                           -> {
            id :: usize(expression.id)
            usage.uses[id] += 1
            if usage.first[id] < 0 {
                usage.first[id] = usage.position
            }
            usage.last[id] = usage.position
        }
        is CLocal | CVerbatim | CIntegerLiteral -> {}
        is CCall                                -> {
            for argument in expression.arguments {
                scan_expression(argument, usage)
            }
        }
        is CCast                                -> scan_expression(expression.value, usage)
        is CBinary                              -> {
            scan_expression(expression.left, usage)
            scan_expression(expression.right, usage)
        }
        is CUnary                               -> scan_expression(expression.operand, usage)
        is CParenthesized                       -> scan_expression(expression.inner, usage)
        is CMember                              -> scan_expression(expression.base, usage)
        is CIndex                               -> {
            scan_expression(expression.base, usage)
            scan_expression(expression.index, usage)
        }
        is CConditional                         -> {
            scan_expression(expression.condition, usage)
            scan_expression(expression.then_value, usage)
            scan_expression(expression.else_value, usage)
        }
        is CSequence                            -> {
            for part in expression.parts {
                scan_expression(part, usage)
            }
        }
    }
}

// ---- temp -> local copy elision -------------------------------------------

// Fuse an adjacent `tN = EXPR;` / `lM = tN;` pair into `lM = EXPR;` when `tN`
// has no other use ; `tN` is then unused. Only statements next to each other
// in one block fuse, so no side-effecting expression is reordered. Compacts
// `block.body` in place.
fuse_temp_local_copies :: fn(block: CBlock!, usage: TemporaryUsage!) -> void {
    body :: block.body
    kept: usize = 0
    k: usize = 0
    for k < body.len() {
        statement :: body[k]
        if statement is CIf {
            fuse_temp_local_copies(statement.then_block, usage)
            else_block :: statement.else_block
            if else_block != null {
                fuse_temp_local_copies(else_block, usage)
            }
        } else if statement is CScope {
            fuse_temp_local_copies(statement.body, usage)
        }
        fused :: if k + 1 < body.len() { fused_copy(statement, body[k + 1], usage) } else { null }
        if fused != null {
            body[kept] = fused
            k += 2
        } else {
            body[kept] = statement
            k += 1
        }
        kept += 1
    }
    for body.len() > kept {
        body.remove_last()
    }
}

// `lM = EXPR;` when `definition` is `tN = EXPR;`, `copy` is `lM = tN;` and the
// two are `tN`'s only uses — `tN` is then marked unused ; null otherwise.
fused_copy :: fn(definition: CStatement, copy: CStatement, usage: TemporaryUsage!) -> CAssign | null {
    if definition !is CAssign || copy !is CAssign {
        return null
    }
    temporary :: definition.target
    if temporary !is CTemporary || usage.uses[usize(temporary.id)] != 2 {
        return null
    }
    source :: copy.value
    if copy.target !is CLocal || source !is CTemporary || source.id != temporary.id {
        return null
    }
    usage.first[usize(temporary.id)] = -1
    return CAssign { .target = copy.target, .value = definition.value }
}

// ---- tests ----------------------------------------------------------------

import "std/string_builder"
import "std/testing"

// A body built over temps `0..<count`, coalesced, then printed.
TestBody :: struct {
    temporaries: CTemporary![]!
    root: CBlock!
}

// `count` temps of class `.Ref`, temp 1 of class `second`.
test_body :: fn(count: i32, second: ValType) -> TestBody {
    temporaries: CTemporary![]!: []
    for id in 0..<count {
        temporaries.push(CTemporary { .id = id, .val = if id == 1 {
            second
        } else {
            .Ref
        } })
    }
    return TestBody { .temporaries = temporaries, .root = CBlock { .body = [] } }
}

set :: fn(target: CExpression, value: CExpression) -> CStatement = CAssign {
    .target = target,
    .value = value,
}
use :: fn(value: CExpression) -> CStatement = CExpressionStatement {
    .expression = CCall { .callee = "use", .arguments = [value] },
}

printed :: fn(block: CBlock) -> string {
    out :: StringBuilder {}
    print_block(out, block, 0)
    return out.to_string()
}

@test
test_coalesce_merges_disjoint_temps :: fn() -> void {
    b :: test_body(2, .Ref)
    t0 :: b.temporaries[0]
    t1 :: b.temporaries[1]
    b.root.body.push_all(
        [set(t0, verbatim("a")), use(t0), use(verbatim("sep")), set(t1, verbatim("b")), use(t1)],
    )
    types :: coalesce_temporaries(b.root, b.temporaries)
    assert_eq(types.len(), 1)
    assert_eq(printed(b.root), "t0 = a;\nuse(t0);\nuse(sep);\nt0 = b;\nuse(t0);\n")
}

@test
test_coalesce_keeps_touching_temps_apart :: fn() -> void {
    // t0's last read is the statement t1 is defined on : the ranges touch.
    b :: test_body(2, .Ref)
    t0 :: b.temporaries[0]
    t1 :: b.temporaries[1]
    b.root.body.push_all(
        [set(t0, verbatim("a")), set(t1, CCall { .callee = "f", .arguments = [t0] }), use(t1)],
    )
    assert_eq(coalesce_temporaries(b.root, b.temporaries).len(), 2)
}

@test
test_coalesce_keeps_types_apart :: fn() -> void {
    b :: test_body(2, .I32)
    t0 :: b.temporaries[0]
    t1 :: b.temporaries[1]
    b.root.body.push_all([set(t0, verbatim("a")), use(t0), set(t1, verbatim("b")), use(t1)])
    assert_eq(coalesce_temporaries(b.root, b.temporaries).len(), 2)
}

@test
test_coalesce_fuses_a_temp_copied_to_a_local :: fn() -> void {
    b :: test_body(1, .Ref)
    t0 :: b.temporaries[0]
    b.root.body.push_all(
        [set(t0, CCall { .callee = "f", .arguments = [] }), set(CLocal { .slot = 3 }, t0)],
    )
    assert_eq(coalesce_temporaries(b.root, b.temporaries).len(), 0)
    assert_eq(printed(b.root), "l3 = f();\n")
}

@test
test_coalesce_keeps_a_copy_whose_temp_is_reused :: fn() -> void {
    b :: test_body(1, .Ref)
    t0 :: b.temporaries[0]
    b.root.body.push_all([set(t0, verbatim("x")), set(CLocal { .slot = 3 }, t0), use(t0)])
    coalesce_temporaries(b.root, b.temporaries)
    assert_eq(printed(b.root), "t0 = x;\nl3 = t0;\nuse(t0);\n")
}

@test
test_coalesce_keeps_a_copy_that_is_not_adjacent :: fn() -> void {
    b :: test_body(1, .Ref)
    t0 :: b.temporaries[0]
    b.root.body.push_all(
        [set(t0, verbatim("x")), use(verbatim("sep")), set(CLocal { .slot = 3 }, t0)],
    )
    coalesce_temporaries(b.root, b.temporaries)
    assert_eq(printed(b.root), "t0 = x;\nuse(sep);\nl3 = t0;\n")
}
