// vader/c_emit/body — shared name/type helpers for the C-emit pipeline.
//
// Holds the C identifier / literal escaping helpers and the
// `BcType` / `ValType` → C type mapping + box / unbox / coerce helpers
// (`c_type_for*` / `sanitise` / `box_expr` / `unbox_expr` / `coerce_expr`
// family) used across the C-emit pipeline. The per-op / per-fn body walker
// lives in `walker.vader` (same module).
//
// The one thing worth knowing before picking a helper : every heap shape
// collapses to `vader_box_t` on the C side and to `Ref` on the stack side, so
// `c_type_for` / `val_type_of_bc_type` are lossy by design — reach for
// `struct_c_name` when you need the concrete `vader_struct_<name>_t`.

module "vader/c_emit"

import "std/numbers"
import "vader/bytecode"
import "vader/c_emit/c_ast"
import "vader/text"

// =========================================================================
// C identifier sanitation
// =========================================================================

/// Replace every non-`[A-Za-z0-9_]` byte in `raw` with `_`. Then, if the
/// result collides with a C11 (or common-extension) keyword, suffix it
/// with `_v` so the emitted C is always valid.
///
/// @param raw  the mangled name from the bytecode (`std_core_i32_Add_add` etc.).
/// @return     a safe C identifier.
export sanitise :: fn(raw: string) -> string {
    // Build the sanitised bytes then intern ONCE. The byte-by-byte
    // `StringBuilder.append_char` this replaced UTF-8-encoded + interned a fresh
    // 1-char string per byte — the hottest `append_char` caller in c-emit.
    rawb :: raw.bytes()
    n :: rawb.len()
    buf: u8[]!: []
    for i in 0..<n {
        b :: rawb[i]
        buf.push(if is_ident_byte(b) { b } else { u8('_') })
    }
    out :: buf.bytes_to_string()
    if is_c_reserved(out) {
        return "${out}_v"
    }
    return out
}

/// C11 reserved words plus the common `_`-prefixed extensions (`_Atomic`,
/// `_Static_assert`, …). A flat const so the collision test is a single `in`.
C_RESERVED_WORDS: string[]: [
    "auto", "break", "case", "char", "const", "continue", "default", "do",
    "double", "else", "enum", "extern", "float", "for", "goto", "if", "inline",
    "int", "long", "register", "restrict", "return", "short", "signed", "sizeof",
    "static", "struct", "switch", "typedef", "union", "unsigned", "void",
    "volatile", "while", "_Alignas", "_Alignof", "_Atomic", "_Bool", "_Complex",
    "_Generic", "_Imaginary", "_Noreturn", "_Static_assert", "_Thread_local",
]

/// True when `name` collides with a C reserved word ; `sanitise` appends
/// `_v` to any mangled name that does.
is_c_reserved :: fn(name: string) -> bool = name in C_RESERVED_WORDS

// =========================================================================
// C string literal escaping
// =========================================================================

/// Quote-wrap `s` with C string-literal escapes — `\\`, `\"`, `\n`,
/// `\r`, `\t` for the printable specials, `\x<hh>` for everything
/// outside printable ASCII. Lower-case hex digits.
///
/// Special case : when a `\x<hh>` escape is followed by a byte that
/// happens to be a hex digit (or a UTF-8 continuation byte), the
/// reader would extend the escape with those digits. We close the
/// escape with an empty `""` quote-pair so the digits start a fresh
/// literal piece.
///
/// @param s  the UTF-8 source string.
/// @return   a C source-text string literal, including the surrounding
///           double quotes.
export c_string_lit :: fn(s: string) -> string {
    // Build the escaped bytes then intern ONCE. The per-byte
    // `StringBuilder.append_char` this replaced UTF-8-encoded + interned a fresh
    // 1-char string per char — the 2nd-hottest `append_char` caller in c-emit.
    sbytes :: s.bytes()
    n :: sbytes.len()
    buf: u8[]!: []
    buf.push('"')
    for i in 0..<n {
        b :: sbytes[i]
        if b == '\\' {
            buf.push('\\')
            buf.push('\\')
        } else if b == '"' {
            buf.push('\\')
            buf.push('"')
        } else if b == '\n' {
            buf.push('\\')
            buf.push('n')
        } else if b == '\r' {
            buf.push('\\')
            buf.push('r')
        } else if b == '\t' {
            buf.push('\\')
            buf.push('t')
        } else if b < 0x20 || b >= 0x7F {
            // `\x<hh>` escape — two-digit lowercase hex.
            buf.push('\\')
            buf.push('x')
            buf.push(u8(hex_digit(u64(b) >> 4)))
            buf.push(u8(hex_digit(u64(b) & 0xF)))
            // Close the escape so a following hex digit doesn't extend it.
            next_idx :: i + 1
            if next_idx < n {
                next_b :: sbytes[next_idx]
                if is_hex_digit(char(u32(next_b))) {
                    buf.push('"')
                    buf.push('"')
                }
            }
        } else {
            buf.push(b)
        }
    }
    buf.push('"')
    return buf.bytes_to_string()
}

// =========================================================================
// ValType → C type mapping
// =========================================================================

/// Primitive `ValType` → bare C type spelling. `null` lands in
/// `vader_box_t` because the runtime null is the box variant whose
/// tag identifies it ; `ref` / `any` also collapse to `vader_box_t`.
///
/// @param v  the stack-machine value class.
/// @return   the C type spelling used at locals, signature slots,
///           struct-field positions.
export c_type_for_val_bare :: fn(v: ValType) -> string = match v {
    .I8 -> "int8_t"
    .I16 -> "int16_t"
    .I32 -> "int32_t"
    .I64 -> "int64_t"
    .U8 -> "uint8_t"
    .U16 -> "uint16_t"
    .U32 -> "uint32_t"
    .U64 -> "uint64_t"
    .Usize -> "size_t"
    .Isize -> "ptrdiff_t"
    .F32 -> "float"
    .F64 -> "double"
    .Bool -> "bool"
    .Char -> "uint32_t"
    .String -> "vader_string_t"
    .Null -> "vader_box_t"
    .Void -> "void"
    // T12: a concrete heap ref rides the stack as a raw 8-byte pointer; the tag
    // is recovered from the object header at the erasure boundary (`vader_ref_box`).
    .Pointer -> "void*"
    .Ref -> "void*"
    .Any -> "vader_box_t"
}

/// C expression unboxing `value` (a `vader_box_t`) to `target`'s storage —
/// the per-class payload accessor (`.payload.i` for every integer / char,
/// `.payload.f` for floats, `.payload.b` / `.payload.s` for bool / string).
/// `null` / `ref` / `any` pass through (already a box).
///
/// @param value   the `vader_box_t` to unbox.
/// @param target  the destination stack value class.
/// @return        an expression of `target`'s storage type.
unbox_expr :: fn(value: CExpression, target: ValType) -> CExpression = match target {
    .I8    -> payload_cast("int8_t", value, "i")
    .I16   -> payload_cast("int16_t", value, "i")
    .I32   -> payload_cast("int32_t", value, "i")
    .I64   -> payload_cast("int64_t", value, "i")
    .U8    -> payload_cast("uint8_t", value, "i")
    .U16   -> payload_cast("uint16_t", value, "i")
    .U32   -> payload_cast("uint32_t", value, "i")
    .U64   -> payload_cast("uint64_t", value, "i")
    .Usize -> payload_cast("size_t", value, "i")
    .Isize -> payload_cast("ptrdiff_t", value, "i")
    .Char  -> payload_cast("uint32_t", value, "i")
    .F32   -> payload_cast("float", value, "f")
    .F64   -> payload_cast("double", value, "f")
    .Bool  -> payload(value, "b")
    .String -> payload(value, "s")
    .Null  -> value
    .Void  -> verbatim("((void) 0)")
    // Rides in the INTEGER payload, never `obj` : the GC must not follow a
    // foreign address, and going through `payload.i` makes that structural.
    .Pointer -> CParenthesized { .inner = cast("void*", cast("intptr_t", payload(value, "i"))) }
    // T12: narrowing a box to a concrete ref extracts its object pointer.
    .Ref   -> payload(value, "obj")
    .Any   -> value
}

/// `box.payload.<field>`.
payload :: fn(box: CExpression, field: string) -> CExpression = CMember { .base = box, .member = "payload.${field}" }

/// `((type) box.payload.<field>)`.
payload_cast :: fn(type: string, box: CExpression, field: string) -> CExpression =
    CParenthesized { .inner = cast(type, payload(box, field)) }

/// C expression boxing `value` (a `val`-typed value) into a `vader_box_t`
/// tagged `type_index` — the inverse of `unbox_expr`. Each width routes to
/// the matching `vader_box_<class>` runtime constructor (unsigned widths
/// re-cast through the signed payload slot). `null` / `ref` / `any` pass
/// through (already boxed) ; `void` boxes to the empty box.
///
/// @param value       the value to box.
/// @param val         its stack value class.
/// @param type_index  the BcType tag to stamp on the box (the value's own
///                    type, NOT the enclosing container's).
/// @return            an expression of type `vader_box_t`.
box_expr :: fn(value: CExpression, val: ValType, type_index: i32) -> CExpression = match val {
    .I8 | .I16 | .I32     -> box_call("i32", type_index, value)
    .U8 | .U16 | .U32     -> box_call("i32", type_index, CCast { .types = ["int32_t", "uint32_t"], .value = value })
    .I64                  -> box_call("i64", type_index, value)
    .Isize                -> box_call("i64", type_index, cast("int64_t", value))
    .U64 | .Usize         -> box_call("i64", type_index, CCast { .types = ["int64_t", "uint64_t"], .value = value })
    .F32                  -> box_call("f64", type_index, cast("double", value))
    .F64                  -> box_call("f64", type_index, value)
    .Bool                 -> box_call("bool", type_index, value)
    .Char                 -> box_call("i32", type_index, cast("int32_t", value))
    .String               -> box_call("string", type_index, value)
    .Null | .Any          -> value
    .Void                 -> call("vader_box_null", [])
    .Pointer              -> box_call("i64", type_index, cast("int64_t", cast("intptr_t", value)))
    .Ref                  -> ref_box(value)
}

/// `vader_ref_box(value)` — a raw concrete ref widened into a box, its tag
/// recovered from the object header.
ref_box :: fn(value: CExpression) -> CExpression = call("vader_ref_box", [value])

/// `vader_box_<class>(<type_index>u, value)`.
box_call :: fn(class: string, type_index: i32, value: CExpression) -> CExpression =
    call("vader_box_${class}", [verbatim("${type_index}u"), value])

/// BcType index of the primitive whose stack class is `val`, or `0` when no
/// such primitive is materialised in the type table. Used to tag a box when
/// the call site has no explicit target type-index (`box_expr_unknown`). A
/// missing primitive falls back to tag 0 — the receiver's `type_check` simply
/// misses.
///
/// @param types  the module type table.
/// @param val    the primitive stack class to find a tag for.
/// @return       the BcType index, or `0` if absent.
export primitive_tag_of :: fn(types: BcType[], val: ValType) -> i32 {
    for i in 0..<types.len() {
        t :: types[i]
        if t is BcPrimitive {
            if t.val == val { return i32(i) }
        }
    }
    // f32/f64 share the F64 box representation — an f32 value flows with class
    // F64 (there is no distinct F32 payload). If the exact class has no primitive
    // in the table (e.g. an `i32 | f32` union carries only the f32 row), fall back
    // to the OTHER float primitive so the box gets a real float tag rather than
    // the 0/null default. `one_variant_check` aliases f32/f64 tags, so either
    // float index resolves `is f32` / `is f64` downstream.
    if is_float_val(val) {
        for i in 0..<types.len() {
            if types[i] is BcPrimitive as p {
                if is_float_val(p.val) { return i32(i) }
            }
        }
    }
    return 0
}

/// Box `name` to a `vader_box_t` without an explicit target type-index — the
/// tag is the primitive's own BcType index (`primitive_tag_of`). Used by
/// `coerce_expr` when widening a primitive into a `ref` / `any` slot (fn-arg
/// boxing, dispatcher result wrapping).
box_expr_unknown :: fn(types: BcType[], value: CExpression, val: ValType) -> CExpression =
    box_expr(value, val, primitive_tag_of(types, val))


/// True when the type at `type_index` is exactly the primitive of class
/// `slot_val` — the compile-time answer for `type_check` on a primitively-
/// typed value (no runtime tag to inspect).
export primitive_matches_type :: fn(types: BcType[], slot_val: ValType, type_index: i32) -> bool {
    t :: types[usize(type_index)]
    if t is BcPrimitive { return t.val == slot_val }
    return false
}

/// C expression coercing `value` from stack class `from` to `to`. Identity
/// when equal or both boxed ; boxes a primitive into a `ref` / `any` slot ;
/// unboxes a box into a primitive ; otherwise a double-cast (through `from`
/// first, matching `emit_convert`).
///
/// @param types  the module type table (for the box tag).
/// @param value  the expression to coerce.
/// @param from   its current stack class.
/// @param to     the destination stack class.
/// @return       an expression of `to`'s storage type.
coerce_expr :: fn(types: BcType[], value: CExpression, from: ValType, to: ValType) -> CExpression {
    if from == to { return value }
    // T12 erasure boundary — `.Ref` is a raw `void*`, `.Any`/`.Null` are boxes.
    // Narrow a boxed dynamic value (or `null`) into a raw concrete ref.
    if to == .Ref {
        if from == .Any || from == .Null { return payload(value, "obj") }
        return value
    }
    // Widen a raw concrete ref into a boxed slot — tag from the object header.
    if from == .Ref {
        if is_ref_val(to) { return ref_box(value) }
        return value
    }
    // Neither side is a raw ref : the classic box/primitive reconciliation.
    if is_ref_val(to) && is_ref_val(from) { return value }
    if is_ref_val(to) { return box_expr_unknown(types, value, from) }
    if is_ref_val(from) { return unbox_expr(value, to) }
    return scalar_cast(value, from, to)
}

/// `(to) (from) value` — convert through `from` first, as `emit_convert` does.
/// A literal of `from`'s own class takes one cast : `(size_t) 0`, not
/// `(size_t) (int64_t) INT64_C(0)` ; C converts the constant the same way,
/// negative values included. A literal re-read as another class (an `i32`
/// constant taken as `u32`) keeps both casts : the inner one truncates.
///
/// @param value  the expression to convert.
/// @param from   its current stack class.
/// @param to     the destination class.
scalar_cast :: fn(value: CExpression, from: ValType, to: ValType) -> CExpression {
    if value is CIntegerLiteral && value.class == from && !is_most_negative(value) {
        return cast(c_type_for_val_bare(to), verbatim("${value.value}"))
    }
    return cast(c_type_for_val_bare(to), cast(c_type_for_val_bare(from), value))
}

/// Coerce a binary / unary OPERAND to the op's class `to`. Only a boxed
/// operand (an erased `any` / `ref` flowing into a primitive op) is converted
/// — it is unboxed via `coerce_expr`. A primitively-typed operand is left
/// verbatim : the op's typed C operator drives any width / signedness
/// conversion implicitly (and re-casting it would add noise without changing
/// behaviour). Used by `push_binop` / `push_cmp` / `push_unop` / `push_eager`.
coerce_operand :: fn(types: BcType[], value: CExpression, from: ValType, to: ValType) -> CExpression {
    if is_ref_val(from) { return coerce_expr(types, value, from, to) }
    return value
}

/// `BcType` → C type. Heap shapes (struct, array, union, ref, fn)
/// collapse to `vader_box_t` ; primitives delegate to
/// `c_type_for_val_bare`.
///
/// @param t  the bytecode type-table entry.
/// @return   the C type spelling for slots of this type.
// The C storage type follows directly from the stack class: `val_type_of_bc_type`
// owns the concrete-heap (`.Ref` → `void*`) vs erased (`.Any` → `vader_box_t`)
// partition and stays exhaustive over `BcType`, so deriving here keeps a single
// source of truth (and can't drift from the GC's field bucketing, which reads
// the same predicate — see `classify_struct_fields`).
export c_type_for :: fn(t: BcType) -> string = c_type_for_val_bare(val_type_of_bc_type(t))

/// Stack-machine value class for a `BcType`. Every heap shape lands in
/// `Ref` ; the value stack itself only ever carries `Ref` slots for
/// these.
///
/// @param t  the bytecode type-table entry.
/// @return   the stack-machine value class — primitive name for
///           `BcPrimitive`, `Ref` for every heap shape.
export val_type_of_bc_type :: fn(t: BcType) -> ValType = match t {
    is BcPrimitive -> t.val
    // Concrete heap → `.Ref` (void*) ; erased trait/union → `.Any` (box).
    // Mirrors `type_classify.vader::val_type_of_type` (T12).
    is BcStruct -> .Ref
    is BcArray -> .Ref
    is BcFn -> .Ref
    is BcUnion -> .Any
    is BcRef -> .Any
}

/// True for the boxed value classes (`ref` / `any`) — both collapse to
/// `vader_box_t` storage and are GC roots.
export is_ref_val :: fn(v: ValType) -> bool = v == .Ref || v == .Any

/// Stack value class of the field / slot whose `BcType` lives at
/// `type_index` in `types`. The field-store / field-read / arg paths use it
/// to spell the C-storage type of a struct field.
export val_type_of_field :: fn(types: BcType[], type_index: i32) -> ValType =
    val_type_of_bc_type(types[usize(type_index)])

/// Canonical C identifier for a `BcStruct` slot. Format is
/// `vader_struct_<sanitised>_t` so the runtime `vader.h` shim and any
/// hand-written debug printer can spot the type by name.
///
/// @param name  the source-level struct name (post-monomorphization mangle).
/// @return      the C `typedef` identifier, e.g. `vader_struct_Pair_t`.
export struct_c_name :: fn(name: string) -> string {
    return "vader_struct_${sanitise(name)}_t"
}
