// vader/c_emit/stack — operand-stack model for the C body walker.
//
// The bytecode is a stack machine ; the C body walker maps it to C
// statements + expressions by maintaining a virtual operand stack of
// `StackVal`. Each push records HOW to spell the value at its eventual
// consumer — a literal, an inlined side-effect-free expression, a local
// slot `lN`, or a materialised temp `tN` — and the consumer pops and
// inlines that text.
//
// `StackTmp` is the materialised case : `local.set`, call results, and
// allocations force their value into a fresh `tN` temp (see the
// materialisation helpers below). `EmitCtx` is same-module
// (`vader/c_emit`), so it needs no import here.

module "vader/c_emit"

import "std/string_builder"
import "std/abort"
import "vader/bytecode"
import "std/collections"

// ---- StackVal -------------------------------------------------------------

/// One value on the virtual operand stack. Every variant carries its
/// C-storage `ValType` ; the consumer pops it and inlines `name_of`.
StackVal :: StackTmp | StackLit | StackLocalRef | StackExpr

/// A value already materialised into a fresh `tN` C local — the eager
/// case (calls, allocations, anything with a side effect).
StackTmp :: struct {
    name: string
    val:  ValType
}

/// A pure literal (`INT32_C(42)`, `true`). Always safe to inline ; no
/// `T tN = lit;` line is emitted.
StackLit :: struct {
    text: string
    val:  ValType
}

/// A snapshot of local slot `slot`, spelled `lN` at the consumer.
/// Inlined directly unless a `local.set` / `local.tee` on the same slot
/// intervenes before the pop (then it is materialised first).
StackLocalRef :: struct {
    slot: i32
    val:  ValType
}

/// A side-effect-free C expression (`(l0 + l1)`, `(a == b)`). Inlined
/// verbatim ; materialised on `dup` or any `local.set` / `local.tee`,
/// since operand dependencies are not tracked.
StackExpr :: struct {
    text: string
    val:  ValType
}

/// How to spell `sv` at its consumer.
name_of :: fn(sv: StackVal) -> string = match sv {
    is StackTmp      -> sv.name
    is StackLit      -> sv.text
    is StackLocalRef -> "l${sv.slot}"
    is StackExpr     -> sv.text
}

/// Static C-storage type of `sv`.
val_of :: fn(sv: StackVal) -> ValType = match sv {
    is StackTmp      -> sv.val
    is StackLit      -> sv.val
    is StackLocalRef -> sv.val
    is StackExpr     -> sv.val
}

// ---- FnState --------------------------------------------------------------

/// One escape-stack-allocated GC struct to hoist to the function top. Both the
/// zeroed decl (`<cname> <storage> = {0};`) and the root address
/// (`(void*) &<storage>`) are rendered from these two names at emit time — see
/// `emit_function_body` — so there is no pre-rendered-C-syntax to keep in sync.
StackStorage :: struct {
    cname:   string
    storage: string
}

/// Mutable state for one fn-body emit. Owns the operand stack plus the
/// temp / aux counters. Lives only for `emit_function_body` ; discarded
/// once the body lands in `out`.
FnState :: struct {
    ctx:      EmitCtx
    function: BcFunction
    /// The function body ; `print_block` writes it once the walk is done.
    root:     CBlock!
    /// Virtual operand stack — the top of stack is the last element.
    stack:    StackVal[]!
    /// ValType of each materialised temp `tN` (index = N). Drives the
    /// prelude temp declarations. Allocation is monotone — no free-list
    /// recycling ; the run-oracle is the gate, not byte-parity, and
    /// monotone allocation is fine since a fn allocates each temp at most
    /// once).
    tmp_types: ValType[]!
    /// Monotone `_aN` scratch allocator for struct storage / call args.
    /// Never recycled, so it can't collide with a reused name.
    aux_counter: i32
    /// Precomputed structured-control scopes (block / loop / if), keyed by
    /// opener pc. Drives the `if` / `else` / `end` close labels and the
    /// `br` / `br_if` goto-target resolution. See `precompute_scopes`.
    scopes: ScopeInfo[]
    /// Loop opener pcs that a `continue` (`br` to `opener_pc + 1`) jumps to —
    /// they get a `loop_<opener>:` label before the `{`. A label is emitted
    /// only for referenced openers (an unreferenced one warns).
    continue_targets: i32[]
    /// Scope opener pcs (block / loop / if) that a `break` / forward exit
    /// (`br` to `end_pc + 1`) jumps past — they get an `end_<opener>:` label
    /// after the closing `}`. Distinct from `continue_targets` so a loop
    /// targeted only by a continue doesn't emit an unused `end_` label.
    break_targets: i32[]
    /// True when the fn is provably no-alloc (not in `EmitCtx.may_alloc`) —
    /// it gets no GC shadow-stack frame, so `return` skips the `gc_top`
    /// restore and ref slots skip the `= vader_box_null()` root-init. Set by
    /// `emit_function_body` ; default `true` (the scalar / stack subset).
    ///
    /// SECOND CONSUMER — `invalidate_resolve_cache` reads this bit for a
    /// stronger property than frame emission : "this body reaches no GC
    /// safepoint at all", which is what lets a resolve survive entering a
    /// nested scope. That holds because `may_alloc` IS the safepoint-
    /// reachability closure (`compute_may_alloc`), not by coincidence. If the
    /// frame decision ever stops tracking safepoint-freedom exactly — a
    /// no-alloc fn given a frame for debugging, say — split the two before
    /// changing this, or the resolve cache silently goes unsound.
    no_frame: bool
    /// True when the last line emitted is a `return` at the function body's
    /// top level — it pops the frame itself, so the fall-through restore after
    /// it would be dead. Every line clears it ; the return emitters set it.
    ends_with_return: bool = false
    /// Loops whose array state is currently lifted into C locals, innermost
    /// last. Pushed by the `Loop` opener that planned one, popped by its `end`.
    /// See `push_cache_emit.vader`.
    push_caches: PushCache[]!
    /// Resolve-CSE cache : array C-expr (`((vader_array_t*) lN.payload.obj)`) →
    /// the `_slotarrK` local that already chased its buf-forward chain in this
    /// straight-line region. A second slot access on the same array reuses it,
    /// skipping the walk (the arr_rw native win). Cleared at every GC safepoint /
    /// control-flow op and on reassignment of the array's local (see
    /// `invalidate_resolve_cache`) — a stale entry would read a moved buffer.
    resolved_arrays: MutableMap<string, string>
    /// BCE resolve-hoist : keys in `resolved_arrays` that are PINNED — their
    /// hoisted buf-resolve (emitted in a loop preheader by `emit_array_len` with
    /// `resolve_buf`) survives the loop's pure control-flow ops so the body reuses
    /// it. A pin is dropped only by an op that could move a buffer (call / alloc —
    /// a real GC safepoint) or by reassignment of the array's local. Sound because
    /// pins are minted ONLY for BCE-safe loops (no call / alloc in the body).
    pinned_resolves: MutableSet<string>
    /// Set by the walk driver when the current `call` / `call.import` op is
    /// immediately followed by a `drop` — its non-void result is emitted as a
    /// bare statement (like a void call) instead of `tN = call(...);` + an
    /// unread temp. `emit_call_result` reads it ; the driver skips the paired
    /// `drop`. See `emit_function_body`.
    drop_call_result: bool
    /// Escape-stack-allocated GC structs to hoist to the function top — one per
    /// stack `StructNew` in a framed fn (see `emit_struct_new`). Hoisting makes
    /// each storage FUNCTION-scoped so its address in the `gc_stack_objs[]` root
    /// array never dangles past a nested block, and its zeroed decl reads as type
    /// 0 (a scan no-op) until the `StructNew` writes the real header + fields.
    /// The GC scans each object's FIELDS in place so its captured heap refs are
    /// forwarded across a safepoint (else they dangle — the walk_elements
    /// closure-env use-after-forward bug).
    stack_storages: StackStorage[]!
    /// The `if` / scope nodes the walk is inside, innermost last. Statements
    /// go to the innermost one's open block (`current_block`), or to `root`.
    open_nodes: COpenNode![]!
}

/// Fresh state for walking `function` into a statement tree.
new_fn_state :: fn(ctx: EmitCtx, function: BcFunction) -> FnState! = FnState {
    .ctx = ctx,
    .function = function,
    .root = CBlock { .body = [] },
    .stack = [],
    .tmp_types = [],
    .aux_counter = 0,
    .scopes = [],
    .continue_targets = [],
    .break_targets = [],
    .no_frame = true,
    .push_caches = [],
    .resolved_arrays = MutableMap<string, string> {},
    .pinned_resolves = MutableSet<string> {},
    .drop_call_result = false,
    .stack_storages = [],
    .open_nodes = [],
}

// ---- indented output ------------------------------------------------------

/// Append one C statement to the block the walk is in ; `print_block` gives it
/// the block's indentation.
line :: fn(s: FnState!, code: string) -> void {
    append_statement(s, CLine { .text = code })
    s.ends_with_return = false
}

/// Append a `#line` directive : column 0, not a statement.
directive :: fn(s: FnState!, text: string) -> void = append_statement(s, CDirective { .text = text })

append_statement :: fn(s: FnState!, statement: CStmt) -> void {
    current_block(s).body.push(statement)
}

/// `line` for a statement that leaves the function : it records whether the
/// body now ends on it (see `FnState.ends_with_return`).
return_line :: fn(s: FnState!, code: string) -> void {
    line(s, code)
    s.ends_with_return = s.open_nodes.len() == 0
}

// The block statements go to : the innermost open node's, else the root. The
// tree and `open_nodes` hold the SAME objects — statements pushed while a node
// is open land in the tree — so `CBlock`, `CIf` and `CScope` must stay
// reference types.
current_block :: fn(s: FnState!) -> CBlock! {
    if s.open_nodes.len() == 0 {
        return s.root
    }
    node :: s.open_nodes[s.open_nodes.len() - 1]
    if node is CIf {
        return node.else_block ?? node.then_block
    }
    return node.body
}

/// Open `if (condition) {` : its then-arm becomes the block the walk is in.
open_if :: fn(s: FnState!, condition: string) -> void =
    open_node(s, CIf { .condition = condition, .then_block = CBlock { .body = [] } })

/// Open the `else` arm of the innermost open `if`.
open_else :: fn(s: FnState!) -> void {
    node :: s.open_nodes[s.open_nodes.len() - 1]
    if node !is CIf {
        panic("c_emit: `else` outside an `if`")
    }
    node.else_block = CBlock { .body = [] }
}

/// Open a braced scope whose first line is `head` (`{`, `loop_N: {`).
open_scope :: fn(s: FnState!, head: string) -> void =
    open_node(s, CScope { .head = head, .body = CBlock { .body = [] } })

/// Close the innermost open node ; `end_label` (`end_N: ;`, or `""`) follows
/// its closing brace.
close_node :: fn(s: FnState!, end_label: string) -> void {
    node :: s.open_nodes[s.open_nodes.len() - 1]
    // Narrowed per variant : `end_label` sits at a different offset in each,
    // and a field written through the bare union lands at one fixed offset.
    if node is CIf {
        node.end_label = end_label
    } else {
        node.end_label = end_label
    }
    s.open_nodes.remove_last()
    // A trailing call would make `remove_last`'s value the body's.
    return
}

open_node :: fn(s: FnState!, node: COpenNode!) -> void {
    append_statement(s, node)
    s.open_nodes.push(node)
}

/// Push a pure literal — inlined at the consumer, no temp line emitted.
push_lit :: fn(s: FnState!, val: ValType, text: string) -> void {
    s.stack.push(StackLit { .text = text, .val = val })
}

/// Push a side-effect-free C expression, inlined verbatim at the
/// consumer. `text` must already carry whatever parentheses precedence
/// safety requires.
push_expr :: fn(s: FnState!, val: ValType, text: string) -> void {
    s.stack.push(StackExpr { .text = text, .val = val })
}

/// Push a snapshot of local slot `slot`, spelled `lN` when popped.
push_local_ref :: fn(s: FnState!, slot: i32, val: ValType) -> void {
    s.stack.push(StackLocalRef { .slot = slot, .val = val })
}

/// Pop the top of the operand stack. An empty stack means the op is in
/// unreachable code — the lowerer emits dead ops after a terminator (e.g.
/// a `drop` / `call` past an exhaustive-returning match), and the walker
/// tracks no reachability (T2). Return a defensive dummy so the dead op
/// emits harmless (never-executed) C rather than trapping.
pop :: fn(s: FnState!) -> StackVal {
    n :: s.stack.len()
    if n == 0 { return StackLit { .text = "0", .val = .I32 } }
    top :: s.stack[n - 1]
    s.stack = s.stack[0..<n - 1]
    return top
}

/// Discard the top of the operand stack — the `drop` op. An empty stack
/// means a dead `drop` in unreachable code (see `pop`) ; no-op rather than
/// trap.
drop_top :: fn(s: FnState!) -> void {
    n :: s.stack.len()
    if n == 0 { return }
    s.stack = s.stack[0..<n - 1]
}

/// C-storage `ValType` of local slot `slot` — params occupy the first
/// `params.len()` slots, then `locals` in order.
slot_val_type :: fn(function: BcFunction, slot: i32) -> ValType {
    params :: function.signature.params
    if slot < i32(params.len()) {
        return params[usize(slot)]
    }
    return function.locals[usize(slot) - params.len()].val
}

// ---- materialisation ------------------------------------------------------

/// Allocate a fresh `tN` temp of type `val` : record its ValType for the
/// prelude declaration and return the name. Monotone (index = count).
fresh_tmp :: fn(s: FnState!, val: ValType) -> string {
    idx :: s.tmp_types.len()
    s.tmp_types.push(val)
    return "t${idx}"
}

/// Push an already-named temp onto the operand stack.
push_tmp :: fn(s: FnState!, name: string, val: ValType) -> void {
    s.stack.push(StackTmp { .name = name, .val = val })
}

/// Materialise a ready C expression into a fresh `tN` : emit
/// `tN = <expr>;` and push the temp. The eager-result idiom shared by
/// every op that forces its value into a slot (`push_eager`'s div/rem,
/// call results, struct/array results).
push_into_tmp :: fn(s: FnState!, expr: string, val: ValType) -> void {
    name :: fresh_tmp(s, val)
    line(s, "${name} = ${expr};")
    push_tmp(s, name, val)
}

/// Allocate a fresh monotone scratch C identifier `_aN_<suffix>` — block-
/// local storage that isn't an operand-stack temp (struct stack storage,
/// the obj pointer, call-arg buffers). Never recycled, so names never
/// collide with a reused `tN`.
aux :: fn(s: FnState!, suffix: string) -> string {
    name :: "_a${s.aux_counter}_${suffix}"
    s.aux_counter = s.aux_counter + 1
    return name
}

/// Force `e` into a fresh `tN` temp : allocate the index, emit
/// `tN = <e>;`, and return the `StackTmp`.
materialise_entry :: fn(s: FnState!, e: StackVal) -> StackVal {
    val :: val_of(e)
    name :: fresh_tmp(s, val)
    line(s, "${name} = ${name_of(e)};")
    return StackTmp { .name = name, .val = val }
}

/// True for stack entries that a write to slot `slot` would invalidate :
/// every `StackExpr` (operands are not tracked, so any could read the
/// slot) and any `StackLocalRef` aliasing `slot`. Literals and existing
/// temps are stable.
entry_needs_materialise :: fn(e: StackVal, slot: i32) -> bool = match e {
    is StackExpr     -> true
    is StackLocalRef -> e.slot == slot
    is StackTmp      -> false
    is StackLit      -> false
}

/// Materialise every stack entry that a write to slot `slot` would
/// invalidate, in bottom-to-top order (so the emitted `tN = …;` lines
/// keep stack order). Run before a `local.set` / `local.tee` mutates the
/// slot.
materialize_stack_for_slot :: fn(s: FnState!, slot: i32) -> void {
    for i in 0..<s.stack.len() {
        e :: s.stack[i]
        if entry_needs_materialise(e, slot) {
            s.stack[i] = materialise_entry(s, e)
        }
    }
}
