// vader/c_emit/frame: whether a function pushes a GC shadow-stack frame.
//
// A frame roots the function's own ref slots, so that a slot read after a
// safepoint sees the pointer the collector forwarded. It is decided per
// function before the walk (`new_fn_state`), and it is not the absence
// of a safepoint : a tail forwarder reaches one and still needs no frame, since
// nothing it reads afterwards is a slot of its own. The header cache asks the
// other question, through `FnState.safepoint_free`. See ADR 0106.

module "vader/c_emit"

import "vader/bytecode"
vm :: import "vader/bytecode"

/// Whether `function` pushes a GC shadow-stack frame at its entry.
///
/// A function that may reach a safepoint roots its ref slots, unless it is a
/// tail forwarder (`is_tail_forwarder`). One that cannot needs a frame only to
/// root a GC struct it builds on the C stack, through `gc_stack_objs[]`
/// (ADR 0003). A forwarder builds none, so the first case covers both there.
///
/// @param ctx       the module context : `may_alloc`, and the callee
///                  signatures a forwarder is checked against.
/// @param fn_index  the index of `function` in `ctx.module.functions`.
/// @param function  the function to decide for.
needs_frame :: fn(ctx: EmitCtx, fn_index: i32, function: BcFunction) -> bool {
    if ctx.may_alloc[fn_index] {
        return !is_tail_forwarder(ctx.module.functions, function.body)
    }
    return fn_builds_stack_object(function)
}

/// Whether `body` only hands its operands to one safepoint, then returns.
///
/// The shape is closed, and anything outside it is refused :
///
/// 1. pure reads (`is_pure_read`), exactly as many as the safepoint takes, so
///    the operand stack holds nothing else ;
/// 2. ONE safepoint : a `call` of a module function that leaves at most one
///    value, or an `array.push` ;
/// 3. at most one `drop`, of the value that call left ;
/// 4. then the end of the body, or a last `return` / `return.lit`.
///
/// Nothing such a body reads after its safepoint is a slot of its own : what
/// it returns is the callee's value or a literal, and the return coercion does
/// not allocate. A frame would root values no one reads again, and the callee
/// roots what it reads itself : a module function with a frame roots every ref
/// parameter, and the out-of-line `array.push` roots the array and the value.
///
/// The other safepoints stay out. A host (`call.import`) may read an atom's
/// bytes after it allocates, and only the caller's frame keeps that atom
/// alive ; `call.indirect` and `virtual.call` go through trampolines and
/// dispatchers ; `struct.new`, `array.new` and `make_closure` read their
/// operands after they allocate.
///
/// @param functions  the module's functions, where a `call` finds its callee.
/// @param body       the op stream to classify.
is_tail_forwarder :: fn(functions: BcFunction[], body: vm.Op[]) -> bool {
    reads :: leading_pure_reads(body)
    if reads == body.len() {
        return false
    }
    arity :: safepoint_result_arity(functions, body[reads], reads) ?? return false
    after_safepoint :: reads + 1
    if arity == 1 && after_safepoint < body.len() && body[after_safepoint] is vm.Drop {
        return returns_at(body, after_safepoint + 1)
    }
    return returns_at(body, after_safepoint)
}

// How many pure reads open `body`.
leading_pure_reads :: fn(body: vm.Op[]) -> i64 {
    for i in 0..<body.len() {
        if !is_pure_read(body[i]) {
            return i
        }
    }
    return body.len()
}

// An op that pushes one value, and can neither collect nor write : a slot or
// field read, or a constant.
is_pure_read :: fn(op: vm.Op) -> bool = op is vm.LocalGet | vm.LocalField || const_op_of(op) != null

// How many values `op` leaves when it is a safepoint a forwarder may end on and
// takes exactly `operands` values, `null` otherwise.
safepoint_result_arity :: fn(functions: BcFunction[], op: vm.Op, operands: i64) -> i64 | null {
    if op is vm.ArrayPush {
        if operands != 2 {
            return null
        }
        return 0
    }
    if op is vm.Call {
        signature :: functions[op.function_index].signature
        arity :: bc_result_arity(signature)
        if signature.params.len() != operands || arity > 1 {
            return null
        }
        return arity
    }
    return null
}

// Whether the body ends at `at`, or with a `return` / `return.lit` there.
returns_at :: fn(body: vm.Op[], at: i64) -> bool {
    if at == body.len() {
        return true
    }
    return at == body.len() - 1 && body[at] is vm.Return | vm.ReturnLit
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// A callee of the test bodies : `results` is `[.Void]` for none.
callee :: fn(params: ValType[], results: ValType[]) -> BcFunction = BcFunction {
    .name = "callee",
    .is_main = false,
    .signature = BcSignature {
        .params = params,
        .results = results,
        .param_types = [],
        .result_types = [],
        .param_names = [],
    },
    .locals = [],
    .body = [],
    .debug = [],
    .jump_table = [],
}

// The functions a test body calls, by index : 0 `put(ref, i64, i32) -> bool`,
// 1 `log(ref)`, 2 `pair(ref) -> (i32, i32)`, 3 `get(ref, i64) -> ref`.
forwarded_callees :: fn() -> BcFunction[] = [
    callee([.Ref, .I64, .I32], [.Bool]),
    callee([.Ref], [.Void]),
    callee([.Ref], [.I32, .I32]),
    callee([.Ref, .I64], [.Ref]),
]

forwards :: fn(body: vm.Op[]) -> bool = is_tail_forwarder(forwarded_callees(), body)

@test
test_tail_forwarder_relays_a_dropped_result :: fn() -> void {
    body: vm.Op[]: [
        vm.LocalGet { .slot = 0 },
        vm.LocalGet { .slot = 1 },
        vm.LocalGet { .slot = 2 },
        vm.Call { .function_index = 0 },
        vm.Drop {},
        vm.Return {},
    ]
    assert(forwards(body), "a `set_at` handing its parameters to `put`")
}

@test
test_tail_forwarder_returns_the_callee_value :: fn() -> void {
    body: vm.Op[]: [
        vm.LocalGet { .slot = 0 },
        vm.LocalGet { .slot = 1 },
        vm.Call { .function_index = 3 },
        vm.Return {},
    ]
    assert(forwards(body), "a relay returning what `get` returns")
}

@test
test_tail_forwarder_pushes_a_field_array :: fn() -> void {
    body: vm.Op[]: [
        vm.LocalField {
            .slot = 0,
            .type_id = 5,
            .field_index = 1,
        },
        vm.LocalGet { .slot = 1 },
        vm.ArrayPush { .type_id = 7 },
    ]
    assert(forwards(body), "a push into a field array, ending the body")
}

@test
test_tail_forwarder_takes_constant_arguments :: fn() -> void {
    body: vm.Op[]: [
        vm.LocalGet { .slot = 0 },
        vm.I64Const { .value = 7 },
        vm.I32Const { .value = 1 },
        vm.Call { .function_index = 0 },
        vm.Drop {},
        vm.Return {},
    ]
    assert(forwards(body), "constants among the operands")
}

@test
test_tail_forwarder_returns_a_literal :: fn() -> void {
    body: vm.Op[]: [
        vm.LocalGet { .slot = 0 },
        vm.LocalGet { .slot = 1 },
        vm.LocalGet { .slot = 2 },
        vm.Call { .function_index = 0 },
        vm.Drop {},
        vm.ReturnLit { .value = vm.BoolConst { .value = true } },
    ]
    assert(forwards(body), "`drop` then `return.lit`")
}

@test
test_tail_forwarder_refuses_a_value_under_the_operands :: fn() -> void {
    body: vm.Op[]: [
        vm.LocalGet { .slot = 0 },
        vm.LocalGet { .slot = 0 },
        vm.LocalGet { .slot = 1 },
        vm.Call { .function_index = 3 },
        vm.Drop {},
        vm.Return {},
    ]
    assert(!forwards(body), "a slot read before the call and returned after it")
}

@test
test_tail_forwarder_refuses_two_calls :: fn() -> void {
    body: vm.Op[]: [
        vm.LocalGet { .slot = 0 },
        vm.Call { .function_index = 1 },
        vm.LocalGet { .slot = 0 },
        vm.Call { .function_index = 1 },
        vm.Return {},
    ]
    assert(!forwards(body), "a slot read after a first safepoint")
}

@test
test_tail_forwarder_refuses_a_host_call :: fn() -> void {
    body: vm.Op[]: [vm.LocalGet { .slot = 0 }, vm.CallImport { .index = 0 }, vm.Return {}]
    assert(!forwards(body), "`call.import`")
}

@test
test_tail_forwarder_refuses_an_indirect_call :: fn() -> void {
    body: vm.Op[]: [
        vm.LocalGet { .slot = 0 },
        vm.LocalGet { .slot = 1 },
        vm.CallIndirect { .type_id = 4 },
        vm.Return {},
    ]
    assert(!forwards(body), "`call.indirect`")
}

@test
test_tail_forwarder_refuses_a_struct_new :: fn() -> void {
    body: vm.Op[]: [
        vm.LocalGet { .slot = 0 },
        vm.StructNew { .type_id = 5, .stack = false },
        vm.Return {},
    ]
    assert(!forwards(body), "`struct.new` reads its operands after it allocates")
}

@test
test_tail_forwarder_refuses_a_read_after_the_call :: fn() -> void {
    body: vm.Op[]: [
        vm.LocalGet { .slot = 0 },
        vm.LocalGet { .slot = 1 },
        vm.LocalGet { .slot = 2 },
        vm.Call { .function_index = 0 },
        vm.Drop {},
        vm.LocalGet { .slot = 0 },
        vm.Return {},
    ]
    assert(!forwards(body), "`local.get` after the call")
}

@test
test_tail_forwarder_refuses_two_results :: fn() -> void {
    body: vm.Op[]: [vm.LocalGet { .slot = 0 }, vm.Call { .function_index = 2 }, vm.Return {}]
    assert(!forwards(body), "a callee leaving two values")
}

@test
test_tail_forwarder_refuses_a_drop_after_a_void_call :: fn() -> void {
    body: vm.Op[]: [
        vm.LocalGet { .slot = 0 },
        vm.Call { .function_index = 1 },
        vm.Drop {},
        vm.Return {},
    ]
    assert(!forwards(body), "a `drop` with nothing to drop")
}

@test
test_tail_forwarder_refuses_ops_after_the_return :: fn() -> void {
    body: vm.Op[]: [
        vm.LocalGet { .slot = 0 },
        vm.Call { .function_index = 1 },
        vm.Return {},
        vm.Return {},
    ]
    assert(!forwards(body), "an op past the `return`")
}

@test
test_tail_forwarder_refuses_a_body_of_reads :: fn() -> void {
    body: vm.Op[]: [vm.LocalGet { .slot = 0 }]
    assert(!forwards(body), "reads with nothing to hand them to")
}

@test
test_tail_forwarder_refuses_a_last_op_other_than_return :: fn() -> void {
    body: vm.Op[]: [
        vm.LocalGet { .slot = 0 },
        vm.Call { .function_index = 1 },
        vm.Unreachable { .reason = "end" },
    ]
    assert(!forwards(body), "a body ending on `unreachable`")
}

@test
test_tail_forwarder_refuses_a_body_without_safepoint :: fn() -> void {
    body: vm.Op[]: [vm.LocalGet { .slot = 0 }, vm.Return {}]
    assert(!forwards(body), "no safepoint at all")
}
