// vader/c_emit/dispatch — trait-method dispatchers for the generated C.
//
// One output feeds virtual dispatch in the generated C: a per-`(trait.method)`
// dispatcher function (`vader_vt_<key>`) that the `virtual.call` op invokes — a
// `switch (recv.tag)` forwarding to the matching impl fn, boxing args and result
// to the erased ABI so heterogeneous monomorphised impls can share one
// dispatcher.
//
// There used to be a second: per-tag slot tables (`vt_<typeIdx>` +
// `vader_vtable_table[]`) behind a generic `vader_virtual_dispatch(tag, slot)`
// helper. Removed 2026-07-28 — the helper had no caller anywhere, so the tables
// were 33 × 64 pointers plus a 561-entry index, ~21 KB of dead data in every
// binary. They kept nothing alive either: the 34 functions they addressed are all
// called elsewhere. With them went the slot registry (the pinned `Hash.hash`=0 /
// `Equals.equals`=1 / … numbering) that existed only to lay them out.
//
// The runtime half went with it a commit later, once a seed that no longer emits
// the tables was committed — `vader.h` had to keep declaring `vader_vtable_t`
// while the old seed's C still referenced it. Any change of this shape (the emit
// stops producing something the runtime declares) needs the same two steps.

module "vader/c_emit"

import "std/collections"
import "std/sort"
import "std/string"
import "std/string_builder"
import "vader/bytecode"
import "vader/c_emit/c_ast"

// ---- per-key dispatcher metadata ------------------------------------------

/// C identifier for the dispatcher function of a `${trait}.${method}` key —
/// `vader_vt_<Trait>__<method>`. The `.` becomes `__` before sanitation so
/// the two halves stay readable.
vtable_helper_name :: fn(key: string) -> string = "vader_vt_${sanitise(key.split(".").join("__"))}"

/// The vtable row whose key is `key`, or `null` when absent.
find_vtable_row :: fn(ctx: EmitCtx, key: string) -> VtableRow | null {
    for row in ctx.module.vtables {
        if row.key == key {
            return row
        }
    }
    return null
}

/// Canonical signature for a dispatcher : the first impl's signature when
/// every impl agrees on `(result, result_type)`, otherwise a synthetic sig
/// with `result = .Any` so divergent monomorphised impls can box-and-return
/// uniformly. Callers guarantee `row.entries` is non-empty.
vtable_sig_for_row :: fn(ctx: EmitCtx, row: VtableRow) -> BcSignature {
    first :: ctx.module.functions[usize(row.entries[0].fn_index)]
    first_sig :: first.signature
    // Bound once each: loop-invariant, and re-asking is a call where reading a
    // field used to be free.
    first_result :: bc_single_result(first_sig)
    first_result_type :: bc_single_result_type(first_sig)
    uniform := true
    for e in row.entries {
        f :: ctx.module.functions[usize(e.fn_index)]
        if bc_single_result(f.signature) != first_result
            || bc_single_result_type(f.signature) != first_result_type {
            uniform = false
        }
    }
    if uniform { return first_sig }
    return BcSignature {
        .params = first_sig.params,
        // The receiver's own result type, so the two arrays stay the same
        // length — a vtable target is never scalarised (`value_return.vader`
        // drops every function a row names), so this is always one entry.
        .results = [.Any],
        .param_types = first_sig.param_types,
        .result_types = [first_result_type],
        .param_names = first_sig.param_names,
    }
}

/// Formal parameter list for a dispatcher : `vader_box_t recv` plus one
/// `vader_box_t a<j>` per tail param. Tail params take the erased box type
/// so impls with divergent concrete signatures share one dispatcher — each
/// arm unboxes to its own signature.
dispatcher_formal :: fn(sig: BcSignature) -> string {
    sb :: StringBuilder {}
    sb.append("vader_box_t recv")
    tail :: i32(sig.params.len()) - 1
    for j in 0..<tail {
        sb.append(", vader_box_t a${j}")
    }
    return sb.to_string()
}

// ---- emit -----------------------------------------------------------------


/// Forward-declare every dispatcher so user fns calling them compile before
/// the bodies are emitted.
emit_vtable_forward_decls :: fn(ctx: EmitCtx, out: StringBuilder!) -> void {
    rows :: ctx.module.vtables
    if rows.len() == 0 {
        return
    }
    out.append("\n/* ----------------------------------------------- vtable forwards */\n")
    for row in rows {
        if row.entries.len() == 0 {
            continue
        }
        sig :: vtable_sig_for_row(ctx, row)
        out.append("${linkage_prefix(ctx.split)}${c_type_for_val_bare(bc_single_result(sig))} ${vtable_helper_name(row.key)}(${dispatcher_formal(sig)});\n")
    }
}

/// Emit one dispatch helper per `(trait.method)` : `static <ret>
/// vader_vt_<key>(vader_box_t recv, …)` switching on `recv.tag` and
/// forwarding to the matching impl. Each arm unboxes args to the impl's
/// concrete signature ; when the dispatcher returns `any` but the impl
/// returns a primitive, the result is re-boxed. B1 nullable-ref returns are
/// deferred to T12 (the non-erased subset never produces them).
emit_vtable_dispatchers :: fn(ctx: EmitCtx, out: StringBuilder!) -> void {
    rows :: ctx.module.vtables
    if rows.len() == 0 { return }
    types :: ctx.module.types
    out.append("\n/* ----------------------------------------------- vtable dispatchers */\n")
    for row in rows {
        if row.entries.len() == 0 { continue }
        sig :: vtable_sig_for_row(ctx, row)
        helper :: vtable_helper_name(row.key)
        out.append("${linkage_prefix(ctx.split)}${c_type_for_val_bare(bc_single_result(sig))} ${helper}(${dispatcher_formal(sig)}) {\n")
        out.append("    switch (recv.tag) {\n")
        // A distinct (newtype) over a primitive shares its backing's runtime
        // tag, so several entries can map to one tag (e.g. i32 + a distinct
        // BlockId/LocalId → tag 4). Emit one `case` per tag : the first (the
        // backing's, whose delegating impl is equivalent) wins. Without this
        // the C carries a `duplicate case value`.
        seen_tags: i32[]!: []
        for e in row.entries {
            dup := false
            for st in seen_tags {
                if st == e.receiver_type_index {
                    dup = true
                }
            }
            if dup {
                continue
            }
            seen_tags.push(e.receiver_type_index)
            callee :: ctx.module.functions[usize(e.fn_index)]
            csig :: callee.signature
            args: CExpression[]!: [coerce_expr(types, verbatim("recv"), .Any, csig.params[0])]
            tail :: i32(csig.params.len()) - 1
            for i in 0..<tail {
                args.push(coerce_expr(types, verbatim("a${i}"), .Any, csig.params[usize(i + 1)]))
            }
            call_expr :: CCall { .callee = sanitise(callee.name), .arguments = args }
            if bc_single_result(sig) == .Void {
                out.append("        case ${e.receiver_type_index}u: ${text_of(call_expr)}; return;\n")
            } else {
                result :: dispatcher_result(types, call_expr, bc_single_result(csig), bc_single_result(sig))
                out.append("        case ${e.receiver_type_index}u: return ${text_of(result)};\n")
            }
        }
        out.append("        default: vader_unreachable(\"vtable miss in ${row.key}\");\n")
        out.append("    }\n")
        if bc_single_result(sig) != .Void {
            out.append("    vader_unreachable(\"vtable miss in ${row.key}\");\n")
        }
        out.append("}\n")
    }
}

/// The per-arm return expression : wrap the impl's result when the dispatcher
/// returns the erased `any` and the impl does not.
///
/// A `Ref` is NOT already a box — it is a bare `void*`, and returning one from a
/// `vader_box_t` function does not compile. `Void` has nothing to wrap and `Any`
/// is already the target shape; everything else does.
dispatcher_result :: fn(types: BcType[], call_expr: CExpression, impl_result: ValType, sig_result: ValType) -> CExpression =
    if sig_result == .Any && impl_result != .Any && impl_result != .Void {
        coerce_expr(types, call_expr, impl_result, .Any)
    } else {
        call_expr
    }


