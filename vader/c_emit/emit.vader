// vader/c_emit/emit — BytecodeModule → C source.
//
// The pipeline driver (`emit_c`) + the section emitters : type decls,
// forward decls, fn-sig typedefs, fn-value trampolines, the type-info
// table, import shims, vtable dispatchers, fn bodies, and the `main`
// shim. The per-op body walker lives in `walker.vader`. The one frontier
// still open is B1 (nullable-ref inline rep) — see the T12 notes below.
//
// Strategy :
//   - one C function per BcFunction with a C signature derived from
//     `BcSignature` ;
//   - the bytecode's value stack maps to a chain of generated C tmp
//     vars (one per push) ; the C compiler folds the chain back into
//     expression form ;
//   - structured control (`block`/`loop`/`if`) is walked into labelled
//     scopes and `goto`s, named from the opener's pc ; `c_ast/loops.vader`
//     then rewrites them as `while` / `for (;;)` with `continue` / `break` ;
//   - primitives flow as their native C type ; struct/array refs as
//     `vader_box_t` ; the emitter inserts box/unbox sequences at every
//     value boundary (γ representation) ;
//   - imports for `std/io` map to the runtime's `vader_*` functions ;
//     tag-aware ones receive the BcType indices resolved per module.
//
// Output : a single `string` containing the C source, terminated by
// two newlines (the last appended entry already carries a `\n`).

module "vader/c_emit"

import "std/abort"
import "std/collections"
import "std/iter"
import "std/string"
import "vader/bytecode"
import "vader/c_emit/c_ast"

/// Options threaded through the emit.
///
/// `release` gates `#line` directives in the per-op body emit — debug
/// builds emit them so `gdb` / `lldb` step through the original Vader
/// source ; release builds skip them for a faster compile + smaller
/// binary.
///
/// `entry_mangled` is the designated program-entry main's mangled name
/// (`<entry-module-id>$main`, the same `dump_bytecode` stamps as
/// `export main N`). A multi-module program — the compiler imports
/// `vader/lsp`, which has its OWN `main` — has several fns all flagged
/// `is_main`, and the entry one isn't necessarily first in the fn table, so
/// the `main()` shim resolves it by name. Empty → fall back to the first
/// `is_main` fn (single-main programs).
///
/// `split` emits the module with EXTERNAL linkage (drops the `static`
/// storage class on every function / data global) plus forward decls for the
/// address-taken fn-value closures. It prepares the source for a multi-file
/// split (one program → header + globals + N function TUs, compiled in
/// parallel). Off by default → the monolithic single-TU output (with `static`
/// everywhere) that CI / release builds ship, unchanged.
export EmitOptions :: struct {
    release: bool
    entry_mangled: string
    split: bool = false
    /// String literals the atom table must cover, in the order that fixes their
    /// ids. Empty (the default) means "this module's own pool", which is the
    /// behaviour every caller had.
    ///
    /// It exists for the seed. Atom ids are POSITIONS, so a literal present only
    /// on one target shifts every id after it — measured across a darwin/windows
    /// pair: 7028 of 7030 differing lines were renumberings, and 2 were real.
    /// Emitting every target against one universe makes the ids agree, so the C
    /// then differs only where the code does.
    atom_universe: string[] = []
}

/// Default options : debug build, `#line` directives ON, entry resolved by
/// the first `is_main` fn (no designated entry name), monolithic linkage.
export default_emit_options :: fn() -> EmitOptions = EmitOptions { .release = false, .entry_mangled = "" }

/// Per-module emit context. Built once by `new_ctx`, then threaded
/// through every section emitter. Read-only — every cache / index is
/// computed up-front so per-op emit stays branch-free.
///
/// Caches `struct_c_names` (parallel to `module.types`, `""` for
/// non-struct slots), the string-literal `atom_ids`, the `null` / `string`
/// / `[string]` primitive tags, and the `may_alloc` set (fns needing a GC
/// frame). Each is computed by `new_ctx`.
export EmitCtx :: struct {
    module: BytecodeModule
    /// `vader_struct_<sanitised>_t` per BcStruct slot, `""` elsewhere.
    /// Indexed by type slot. Computed by `new_ctx`.
    struct_c_names: string[]
    /// Runtime atom id per string-literal pool index (parallel to
    /// `module.strings`). Empty string → 0 (VADER_ATOM_EMPTY) ; every
    /// other literal → a contiguous id `1..M`. `string.const` inlines
    /// the id at its use site. Computed by `new_ctx`.
    atom_ids: i32[]
    /// The literals the emitted table holds, in id order (id k is at index
    /// k - 1). The module's own non-empty literals, or `opts.atom_universe`.
    atom_table: string[]
    /// BcType index of the `null` primitive (`0` when absent). Tags the
    /// boxed null literal. Cached so per-op const emit stays a field read.
    null_tag: i32
    /// BcType index of the `string` primitive, or `-1` when absent.
    string_tag: i32
    /// BcType index of the `[string]` array (element == `string_tag`), or
    /// `-1` when absent. Used by the `main(argv: [string])` shim.
    string_array_tag: i32
    /// Indices into `module.functions` of every fn that may trigger a GC
    /// allocation (transitively). A fn NOT in this set is `no_frame` — it
    /// skips the shadow-stack prologue. Computed by `compute_may_alloc`.
    may_alloc: i32[]
    release: bool
    /// External-linkage mode — drops `static` on every emitted def and adds
    /// closure forward decls, so the output can be split across TUs. Mirrors
    /// `EmitOptions.split`. Read by `wrapper_storage`.
    split: bool
    /// Per-function: true when NO other unit refers to it, so it can keep
    /// internal linkage inside its own TU and stay inlinable. Parallel to
    /// `module.functions`; EMPTY means "no analysis ran", which is the
    /// monolithic build (everything is already `static` there) and any caller
    /// that has not computed it. Filled by `split.vader::internal_fn_flags`.
    internal_fns: bool[]
}

new_ctx :: fn(
    m: BytecodeModule, release: bool, split: bool, universe: string[] = [],
    internal_fns: bool[] = [],
) -> EmitCtx {
    names: string[]!: []
    for i in 0..<m.types.len() {
        match m.types[i] as s {
            is BcStruct -> names.push(struct_c_name(s.name))
            _           -> names.push("")
        }
    }
    string_tag :: string_primitive_tag(m.types)
    return EmitCtx {
        .module = m,
        .struct_c_names = names,
        .atom_ids = compute_atom_ids(m.strings, universe),
        .atom_table = atom_table_of(m.strings, universe),
        .null_tag = null_primitive_tag(m.types),
        .string_tag = string_tag,
        .string_array_tag = string_array_tag(m.types, string_tag),
        .may_alloc = compute_may_alloc(m.functions),
        .release = release,
        .split = split,
        .internal_fns = internal_fns,
    }
}

/// Storage of a function the emitter defines outside `module.functions` — a
/// trampoline, a dispatcher : private to its single unit, except in a split
/// build, where another unit may call it. Every emitted name is a
/// globally-unique mangle, so external linkage is collision-free.
///
/// @param split  whether the build is split into several units.
wrapper_storage :: fn(split: bool) -> CStorage = if split { .External } else { .Internal }

/// Storage of one of `module.functions`, for its definition and prototype.
///
/// Same as `wrapper_storage` except in a split build, where a function no
/// other unit refers to keeps internal linkage. That is what lets `cc` inline
/// it: an externally-visible definition must be emitted as written, so the split
/// was costing every intra-module call its inlining. 79 % of the compiler's own
/// functions qualify.
///
/// @param ctx    the emit context; `internal_fns` empty means nothing qualifies.
/// @param index  index into `module.functions`.
module_function_storage :: fn(ctx: EmitCtx, index: i32) -> CStorage {
    if !ctx.split {
        return .Internal
    }
    if usize(index) < ctx.internal_fns.len() && ctx.internal_fns[usize(index)] {
        return .Internal
    }
    return .External
}

/// Runtime atom id for each string-literal pool index. The empty string
/// maps to 0 (VADER_ATOM_EMPTY — reached via direct `== 0`, never the
/// intern hash) ; every other literal gets a contiguous id `1..M`.
///
/// An empty literal MUST resolve to 0 so it compares equal to a
/// runtime-produced empty string (also atom 0).
///
/// @param strings  the bytecode string-literal pool.
/// @return         atom ids parallel to `strings`.
compute_atom_ids :: fn(strings: string[], universe: string[]) -> i32[] {
    if universe.is_empty() {
        ids: i32[]!: []
        next_id: i32 = 1
        for i in 0..<strings.len() {
            if strings[i] == "" {
                ids.push(0)
            } else {
                ids.push(next_id)
                next_id += 1
            }
        }
        return ids
    }
    // Position in the UNIVERSE, so two targets that share it agree on every id.
    // A literal the universe does not carry is a build-order bug rather than a
    // recoverable case — it would silently alias another atom — so it takes 0
    // (the empty atom) and `atom_universe_covers` is what a caller checks.
    index :: MutableMap<string, i32> {}
    for i in 0..<universe.len() {
        if index[universe[i]] == null {
            index[universe[i]] = i32(i) + 1
        }
    }
    ids: i32[]!: []
    for i in 0..<strings.len() {
        if strings[i] == "" {
            ids.push(0)
        } else {
            ids.push(index[strings[i]] ?? 0)
        }
    }
    return ids
}

// The literals the table holds, in id order: the universe when one is given,
// otherwise this module's own non-empty literals in pool order.
atom_table_of :: fn(strings: string[], universe: string[]) -> string[] {
    if universe.len() != 0 {
        return universe
    }
    out: string[]!: []
    for i in 0..<strings.len() {
        if strings[i] != "" {
            out.push(strings[i])
        }
    }
    return out
}

/// Every non-empty literal of `strings` that `universe` does not carry.
///
/// The seed's build order must union the pools BEFORE emitting; this is what
/// turns a mistake there into a named failure rather than a silent atom alias.
///
/// @param strings   a module's literal pool.
/// @param universe  the shared atom universe.
/// @return          the uncovered literals, empty when the universe is complete.
export atom_universe_gaps :: fn(strings: string[], universe: string[]) -> string[] {
    have :: MutableSet<string> {}
    for u in universe {
        have.add(u)
    }
    out: string[]!: []
    for s in strings {
        if s != "" && !have.contains(s) {
            out.push(s)
        }
    }
    return out
}

/// Top-level entry — produces the C source for a `BytecodeModule`.
/// Output ends with a trailing newline.
///
/// @param m     the bytecode module to lower.
/// @param opts  emit-time switches (see `EmitOptions`).
/// @return      a fresh string containing the generated C source.
export emit_c :: fn(m: BytecodeModule, opts: EmitOptions) -> string {
    ctx :: new_ctx(m, opts.release, opts.split, opts.atom_universe)
    printer :: CPrinter {}
    printer.emit_preamble("Generated by vader — do not edit.")
    ctx.emit_type_decls(printer)
    ctx.emit_forward_decls(printer)
    // Split builds cross-TU-reference the address-taken fn-value closures
    // (`vader_fn_tramp_N` / `vader_fn_static_N` / `vader_fn_lift_N`), which are
    // synthesised outside `module.functions` and so get no prototype above.
    ctx.emit_closure_forward_decls(printer)
    ctx.emit_fn_sig_typedefs(printer)
    ctx.emit_fn_trampolines(printer)
    ctx.emit_type_info_table(printer)
    ctx.emit_import_shims(printer)
    ctx.emit_vtable_forward_decls(printer)
    ctx.emit_functions(printer)
    ctx.emit_vtable_dispatchers(printer)
    ctx.emit_main(printer, opts.entry_mangled)
    return printer.printed_text()
}

/// The opening of a translation unit : a banner over the runtime and libc
/// headers.
///
/// @param printer  receives the section.
/// @param banner   the text of the leading comment.
emit_preamble :: fn(printer: CPrinter!, banner: string) -> void = printer.print_section(CSection {
    .comment = [banner],
    .items = [
        CInclude { .path = "vader.h" },
        CInclude { .path = "stddef.h", .system = true },
        CInclude { .path = "stdlib.h", .system = true },
        CInclude { .path = "string.h", .system = true },
    ],
})

// =========================================================================
// Section emitters
// =========================================================================
//
// The section order is fixed so the output stays deterministic.

/// Per-type forward decls, struct bodies, string-literal statics, and
/// data-pool .rodata blocks. Each sub-section is followed by a blank
/// line so the resulting C reads cleanly even when a sub-section is
/// empty.
emit_type_decls :: fn(ctx: EmitCtx, printer: CPrinter!) -> void {
    // Struct typedefs + bodies (the split routes these to the shared header).
    emit_struct_typedefs(ctx, printer)

    // Comptime atom table — every non-empty literal serialised as a PERM
    // atom in `.rodata`. `string.const` resolves to a bare atom id
    // (`ctx.atom_ids[i]`) inlined at each use site, so no per-literal
    // `vader_str_<i>` global is emitted.
    emit_atom_comptime_table(ctx, printer)

    emit_data_pool(ctx, printer)
}

/// The `@c_struct` mirrors, emitted with the imports rather than in the shared
/// header.
///
/// A mirror is per SYSTEM by nature: two systems describe the same C type with
/// different fields, and each mirror is materialised only where its `@target`
/// body is kept. So a mirror belongs beside the shims that marshal it and the
/// `_Static_assert`s that check it — all of which already live per target —
/// rather than in the header every target shares.
///
/// @param ctx      the emit context.
/// @param printer  receives the typedefs and definitions.
emit_mirrored_struct_typedefs :: fn(ctx: EmitCtx, printer: CPrinter!) -> void {
    forwards: CTopLevel[]!: []
    definitions: CTopLevel[]!: []
    for i in 0..<ctx.module.types.len() {
        if ctx.module.types[i] is BcStruct as s {
            if s.c_name != "" {
                forwards.push(CStructForward { .name = ctx.struct_c_names[i] })
                definitions.push(struct_definition(ctx, s, i))
            }
        }
    }
    printer.print_section(CSection { .items = forwards })
    printer.print_section(CSection { .items = definitions })
}

/// Struct forward-decl typedefs + struct bodies. The type-declaration half
/// of `emit_type_decls` : in a split build these are the module's public
/// shape, routed to the shared header ; the atom table + data pool (the data
/// half) go to the globals TU.
emit_struct_typedefs :: fn(ctx: EmitCtx, printer: CPrinter!) -> void {
    // Forward decls for every struct so field references compile in any
    // declaration order, then the bodies. Under `--split` a `@c_struct` mirror
    // is emitted with the imports instead: it exists only on the systems that
    // declare it, and the shared header has to read the same for every target.
    // In a single file there is nowhere else to put it, and the type table
    // takes `sizeof` on it, so it stays here.
    forwards: CTopLevel[]!: []
    definitions: CTopLevel[]!: []
    for i in 0..<ctx.module.types.len() {
        if ctx.module.types[i] is BcStruct as s {
            if s.c_name == "" || !ctx.split {
                forwards.push(CStructForward { .name = ctx.struct_c_names[i] })
                definitions.push(struct_definition(ctx, s, i))
            }
        }
    }
    printer.print_section(CSection { .items = forwards })
    printer.print_section(CSection { .items = definitions })
}

/// Compile-time atom table — every non-empty string literal serialised
/// as a PERM atom in `.rodata`. The emitted `main` hands the table to
/// `vader_atom_init_with_comptime` at startup ; the runtime memcpys it
/// into the live atom table at indices `1..M` (index 0 is
/// VADER_ATOM_EMPTY). A `vader_string_t` is a u32 atom id, so a literal
/// is referenced by its bare `ctx.atom_ids[i]` at each use site.
emit_atom_comptime_table :: fn(ctx: EmitCtx, printer: CPrinter!) -> void {
    comment :: ["Compile-time atom table — see docs/ATOM_INTERNING.md."]
    if ctx.atom_table.len() == 0 {
        // No comptime atoms (no literals, or every literal is ""). A
        // 1-entry placeholder keeps `&vader_atom_comptime_table[0]`
        // well-defined ; the count of 0 tells the runtime to ignore it.
        empty :: initializer_list([ZERO, ZERO, ZERO, ZERO, ZERO, verbatim("\"\"")])
        placeholder :: CGlobal {
            .storage = global_storage(ctx.split),
            .constant = true,
            .type = "vader_atom_entry_t",
            .declarator = CDeclarator {
                .name = "vader_atom_comptime_table",
                .length = 1,
                .value = initializer_list([empty]),
            },
        }
        items: CTopLevel[]: [placeholder, atom_count_define(ctx)]
        printer.print_section(CSection { .comment = comment, .items = items })
        return
    }

    // `ctx.atom_table` is already in id order (id k at index k-1) — the
    // module's own non-empty literals, or the shared universe when one was
    // given. Empty literals carry no atom; they alias VADER_ATOM_EMPTY (0).
    // The blob holds each literal's bytes + an inline NUL sentinel so
    // `data[len]` reads NUL ; C concatenates the adjacent literals into one
    // `.rodata` array. Each entry is one PERM owner pointing into the blob.
    storage :: global_storage(ctx.split)
    literals: string[]!: []
    entries: CExpression[]!: []
    offset: i64 = 0
    for s in ctx.atom_table {
        byte_len :: i64(s.bytes().len())
        literals.push("${c_string_lit(s)} \"\\0\"")
        blob_byte :: CIndex { .base = verbatim("vader_atom_blob"), .index = number(offset) }
        entries.push(initializer_list([
            ZERO, ZERO, unsigned(byte_len), verbatim("VADER_ATOM_FLAG_PERM"), ZERO,
            address_of(blob_byte),
        ]))
        offset += byte_len + 1
    }
    blob :: CGlobal {
        .storage = storage,
        .constant = true,
        .type = "char",
        .declarator = CDeclarator {
            .name = "vader_atom_blob",
            .length = UNSIZED,
            .value = CStringLiterals { .literals = literals },
        },
    }
    table :: CGlobal {
        .storage = storage,
        .constant = true,
        .type = "vader_atom_entry_t",
        .declarator = CDeclarator {
            .name = "vader_atom_comptime_table",
            .length = UNSIZED,
            .value = initializer_list(entries),
        },
    }
    printer.print_section(CSection { .comment = comment, .items = [blob] })
    printer.print_section(CSection { .items = [table] })
    printer.print_section(CSection { .items = [atom_count_define(ctx)] })
}

/// `#define VADER_COMPTIME_ATOM_COUNT N` — the count `main` hands to
/// `vader_atom_init_with_comptime`. It counts `ctx.atom_table`, the entries
/// `emit_atom_comptime_table` bakes, so every unit that spells it agrees. With
/// a shared universe the module's own literal pool is smaller than that table :
/// counting the pool would leave every atom past it uninitialised.
///
/// @param ctx  the emit context.
atom_count_define :: fn(ctx: EmitCtx) -> CTopLevel = CDefine {
    .name = "VADER_COMPTIME_ATOM_COUNT",
    .value = unsigned(i64(ctx.atom_table.len())),
}

/// Storage of a global defined by the emitter : private to its single unit,
/// except in a split build, where another unit may read it.
///
/// A mutable module const is written through `(void*) &vader_data_N` (see
/// `emit_data_const_op`), so it must not be `const` : the store would land in
/// `.rodata` — a segfault, not a diagnostic. The write barrier stays safe either
/// way: it is range-guarded on the old-gen block (`vader.h`), and a static lives
/// outside it.
///
/// @param split  whether the build is split into several units.
global_storage :: fn(split: bool) -> CStorage = if split { .External } else { .Internal }

/// A declaration of a global defined in another unit.
///
/// @param type      its C type.
/// @param name      its name.
/// @param length    its declared length, `UNSIZED` for an array.
/// @param constant  whether the definition is `const` — the two must agree.
external :: fn(
    type: string,
    name: string,
    length: CUnsized | null,
    constant: bool,
) -> CTopLevel = CGlobal {
    .storage = .Declaration,
    .constant = constant,
    .type = type,
    .declarator = CDeclarator { .name = name, .length = length },
}

/// One struct body : the object header, then one member per field.
///
/// @param ctx         the emit context (used for the cached struct C name).
/// @param s           the struct decl to render.
/// @param type_index  index of `s` in `ctx.module.types` ; used to look
///                    up the cached C identifier in `struct_c_names`.
struct_definition :: fn(ctx: EmitCtx, s: BcStruct, type_index: usize) -> CStructDefinition {
    fields: CField[]!: [CField { .type = "vader_obj_header_t", .name = "header" }]
    for f in s.fields {
        ftype :: ctx.module.types[usize(f.type_index)]
        fields.push(CField { .type = c_type_for(ftype), .name = "f_${sanitise(f.name)}" })
    }
    return CStructDefinition { .name = ctx.struct_c_names[type_index], .fields = fields }
}

/// Data pool — module-level read-only `T[]` literals emitted as `.rodata` statics.
/// Skipped when `data_pool.len() == 0`. Primitive arrays bake a concrete-typed
/// element buffer ; string arrays bake a `vader_box_t` slot buffer holding the
/// elements' atom ids.
emit_data_pool :: fn(ctx: EmitCtx, printer: CPrinter!) -> void {
    if ctx.module.data_pool.len() == 0 {
        return
    }
    items: CTopLevel[]!: []
    // The `BcDataEntry` carries no array type_id (the op does) ; recover it by
    // scanning the module's `data.const` ops once, pool_index → type_id.
    type_ids :: data_pool_type_ids(ctx.module)
    // The value→atom map scans the whole module string table ; only string
    // arrays need it, so skip the build when the pool is all primitive.
    atom_of :: if has_str_data(ctx.module.data_pool) { build_string_atom_map(ctx) } else { MutableMap<string, i32> {} }
    for i in 0..<ctx.module.data_pool.len() {
        entry :: ctx.module.data_pool[i]
        array :: PoolArray {
            .name = "vader_data_${i}",
            .storage = global_storage(ctx.split),
            .constant = !data_entry_mutable(entry),
            .type_id = type_ids[i],
            .element_tag = array_element_tag(ctx.module.types, type_ids[i]),
        }
        match entry {
            is BcStrData       -> emit_str_data_entry(items, array, entry, atom_of)
            is BcPrimData      -> emit_prim_data_entry(items, array, entry)
            is BcAggregateData -> emit_agg_data_entry(ctx, items, array, entry, atom_of)
        }
    }
    emit_global_const_roots(ctx, items)
    printer.print_section(CSection {
        .comment = [
            "Comptime data pool — read-only arrays in `.rodata`.",
            "Out-of-arena pointers are immortal to the GC (it never copies /",
            "relocates them), so `data.const` boxes a zero-copy view.",
        ],
        .items = items,
    })
}

/// One baked array of the data pool, as its two globals see it.
PoolArray :: struct {
    /// The `vader_array_t` ; its buffer is `<name>_buf`.
    name: string
    /// Storage and constness, shared by the array and its buffer.
    storage: CStorage
    constant: bool
    /// The array's type index.
    type_id: i32
    /// The element type index, stamped on the buffer and on each boxed slot.
    element_tag: i32
}

/// The buffer of `array`, then the `vader_array_t` header pointing at it.
///
/// A buffer is an anonymous struct : `vader_array_buf_t` ends on a flexible
/// member, which a static initializer cannot fill.
///
/// @param items      receives both globals.
/// @param array      the array's name, storage and type indices.
/// @param slot_type  the C type of one slot.
/// @param kind       the storage kind stamped on the buffer.
/// @param slots      the slot initializers, in order.
push_pool_array :: fn(
    items: CTopLevel[]!,
    array: PoolArray,
    slot_type: string,
    kind: ArrayKind,
    slots: CExpression[],
) -> void {
    n :: i64(slots.len())
    buffer :: "${array.name}_buf"
    items.push(CGlobal {
        .storage = array.storage,
        .constant = array.constant,
        .type = "struct { ${ARRAY_BUFFER_HEADER} ${slot_type} slots[${n}]; }",
        .declarator = CDeclarator {
            .name = buffer,
            .value = initializer_list([
                object_header(verbatim("VADER_TYPE_INDEX_ARRAY_BUF")),
                unsigned(n),
                unsigned(n),
                unsigned(i64(array.element_tag)),
                unsigned(i64(array_kind_index(kind))),
                initializer_list([ZERO, ZERO, ZERO]),
                initializer_list(slots),
            ]),
        },
    })
    items.push(CGlobal {
        .storage = array.storage,
        .constant = array.constant,
        .type = "vader_array_t",
        .declarator = CDeclarator {
            .name = array.name,
            .value = initializer_list([
                object_header(unsigned(i64(array.type_id))),
                unsigned(n),
                unsigned(n),
                ZERO,
                cast("vader_array_buf_t*", address_of(verbatim(buffer))),
            ]),
        },
    })
}

/// The members of `vader_array_buf_t` ahead of its slots.
ARRAY_BUFFER_HEADER :: "vader_obj_header_t header; size_t capacity; size_t length; " +
    "uint32_t element_tag; uint8_t element_kind; uint8_t _pad[3];"

/// `{ tag, 0u, 0u, 0u, NULL }` — the header of a static object.
///
/// @param tag  its type index.
object_header :: fn(tag: CExpression) -> CExpression = initializer_list([
    tag, ZERO, ZERO, ZERO, NULL_POINTER,
])

// A static table of the mutable module-const arrays plus a PERMANENT GC frame
// rooting them, installed as the base of the frame chain by `main`.
//
// A writable global belongs to no other root set — the frame chain and the defer
// stack are it — so its buffer was invisible to the collector. Growing one
// reallocates the buffer on the GC heap, and a runtime-built string stored in one
// had its atom swept (measured: 50/50 slots corrupted after GC churn).
//
// The frame needs NO new runtime machinery: `stack_objs` was built for
// stack-allocated structs — an off-arena object that never moves but whose pointer
// FIELDS must be forwarded — and a static global is exactly that case.
// `vader_gc_scan_object` reads the array's type-info row, sees `KIND_ARRAY`, and
// forwards `.buf` through `vader_gc_scan_raw` (write barrier included). Atoms need
// their own pass because `vader_atom_mark_roots` only walks a frame's boxed `ptrs`.
emit_global_const_roots :: fn(ctx: EmitCtx, items: CTopLevel[]!) -> void {
    indices :: mutable_pool_indices(ctx.module.data_pool)
    if indices.len() == 0 {
        return
    }
    // `main` installs the frame, and under `--split` `main` lives in a different
    // unit from the data pool — so `static` here leaves it undeclared there.
    storage :: global_storage(ctx.split)
    arrays: CExpression[]!: []
    for i in indices {
        arrays.push(address_of(verbatim("vader_data_${i}")))
    }
    items.push(CGlobal {
        .storage = storage,
        .type = "vader_array_t*",
        .declarator = CDeclarator {
            .name = "vader_global_const_arrays",
            .length = UNSIZED,
            .value = initializer_list(arrays),
        },
    })
    // A BOXED static buffer is rooted alongside its array. `vader_gc_scan_raw`
    // forwards `.buf` but never descends into an off-arena object, so a heap value
    // written into a slot (`SPECS[0] = other`) would be invisible to the collector.
    // Registering the buffer routes it through `vader_gc_scan_object`'s ARRAY_BUF
    // branch, which scans the slots. A primitive buffer holds no pointer, so only
    // the boxed kinds are listed. Post-growth the array points at a heap buffer and
    // this one is stale — still valid memory, so scanning it is safe ; it just
    // retains whatever the initial slots held.
    objects :: arrays.clone()
    for i in indices {
        if ctx.module.data_pool[i] !is BcPrimData {
            objects.push(address_of(verbatim("vader_data_${i}_buf")))
        }
    }
    items.push(CGlobal {
        .storage = storage,
        .type = "void*",
        .declarator = CDeclarator {
            .name = "vader_global_const_objs",
            .length = UNSIZED,
            .value = initializer_list(objects),
        },
    })
    frame :: initializer_list([
        NULL_POINTER, ZERO, ZERO, NULL_POINTER, NULL_POINTER,
        unsigned(i64(objects.len())), verbatim("vader_global_const_objs"),
    ])
    items.push(CGlobal {
        .storage = storage,
        .type = "vader_gc_frame_t",
        .declarator = CDeclarator { .name = "vader_global_const_frame", .value = frame },
    })
}

/// Pool indices of the mutable entries, in pool order — the writable globals that
/// need rooting. Aggregates are always read-only (T3076), so only the two flat
/// kinds can appear.
///
/// @param pool  the module's data pool.
/// @return      the indices whose entry is mutable ; empty when none.
mutable_pool_indices :: fn(pool: BcDataEntry[]) -> usize[] {
    out: usize[]!: []
    for i in 0..<pool.len() {
        if data_entry_mutable(pool[i]) { out.push(i) }
    }
    return out
}

// One aggregate (struct / tuple / nested) `.rodata` array : a boxed slot buffer
// of pointers to each element's own materialised static, emitted depth-first
// (children before parents) so the C forward-refs resolve.
//
// The marker is on the ARRAY level only, so the buffer and header lose `const`
// while the element objects (emitted by `box_slot` below) keep theirs. The type
// system is what makes that split safe: the element type stays read-only, so
// `SPECS[0] = other` reaches a slot while `SPECS[0].code = 9` is T3070 — a write
// into `.rodata` is never reachable.
emit_agg_data_entry :: fn(
    ctx: EmitCtx,
    items: CTopLevel[]!,
    array: PoolArray,
    ad: BcAggregateData,
    atom_of: MutableMap<string,
    i32>,
) -> void {
    slots: CExpression[]!: []
    for k in 0..<ad.elements.len() {
        slots.push(
            box_slot(
                ctx,
                items,
                ad.elements[k],
                "${array.name}_e${k}",
                array.element_tag,
                atom_of,
            ),
        )
    }
    push_pool_array(items, array, "vader_box_t", .Boxed, slots)
}

// Materialise one recursive baked value, emitting any prerequisite statics, and
// return the C init expression to place in the parent slot/field. Prim leaves
// inline their literal ; string leaves inline their atom id ; structs and nested
// arrays emit their own static and return its address (cast to the slot type).
emit_data_value :: fn(
    ctx: EmitCtx,
    items: CTopLevel[]!,
    v: BcDataValue,
    name: string,
    atom_of: MutableMap<string,
    i32>,
) -> CExpression {
    if v is BcValPrim { return data_slot(v.kind, v.bits) }
    if v is BcValStr { return unsigned(i64(atom_for(atom_of, v.value))) }
    if v is BcValStruct {
        type_id :: type_id_for_struct_symbol(ctx.module.types, v.symbol_id)
        type :: "struct ${ctx.struct_c_names[usize(type_id)]}"
        members: CExpression[]!: [object_header(unsigned(i64(type_id)))]
        if ctx.module.types[usize(type_id)] is BcStruct as bcs {
            for k in 0..<v.fields.len() {
                field_tid :: if k < bcs.fields.len() { bcs.fields[k].type_index } else { 0 }
                members.push(
                    struct_field_init(
                        ctx,
                        items,
                        v.fields[k],
                        "${name}_f${k}",
                        field_tid,
                        atom_of,
                    ),
                )
            }
        }
        items.push(CGlobal {
            .storage = global_storage(ctx.split),
            .constant = true,
            .type = type,
            .declarator = CDeclarator { .name = name, .value = initializer_list(members) },
        })
        return cast("${type}*", address_of(verbatim(name)))
    }
    if v is BcValArray {
        return emit_nested_array(ctx, items, v, name, atom_of)
    }
    return number(0)
}

// A nested array field (e.g. a struct's `T[]` field). Primitive-element arrays
// inline concrete-typed slots ; otherwise a boxed slot buffer of element statics.
emit_nested_array :: fn(
    ctx: EmitCtx,
    items: CTopLevel[]!,
    a: BcValArray,
    name: string,
    atom_of: MutableMap<string,
    i32>,
) -> CExpression {
    // The storage kind comes from the ELEMENTS (an enum array's name resolves to
    // Boxed, but its values are prim leaves at the repr width), not the type name.
    kind :: element_storage_kind(a.elements)
    element_tag :: type_index_for_name(ctx.module.types, a.element_type_name)
    array :: PoolArray {
        .name = name,
        .storage = global_storage(ctx.split),
        .constant = true,
        .type_id = array_type_index_for_element(ctx.module.types, element_tag),
        .element_tag = element_tag,
    }
    slots: CExpression[]!: []
    for k in 0..<a.elements.len() {
        element :: a.elements[k]
        if kind == .Boxed {
            slots.push(box_slot(ctx, items, element, "${name}_x${k}", element_tag, atom_of))
        } else if element is BcValPrim {
            slots.push(data_slot(kind, element.bits))
        }
    }
    push_pool_array(items, array, c_type_for_array_kind(kind), kind, slots)
    return cast("vader_array_t*", address_of(verbatim(name)))
}

// One struct field initialiser. Primitive fields inline their literal, string
// fields inline their atom id (a `vader_string_t` slot), and struct / array
// fields are stored as a `vader_box_t` ref slot — a pointer to the field value's
// own static, tagged with the declared field type index.
struct_field_init :: fn(
    ctx: EmitCtx,
    items: CTopLevel[]!,
    v: BcDataValue,
    name: string,
    field_tid: i32,
    atom_of: MutableMap<string,
    i32>,
) -> CExpression {
    if v is BcValPrim { return data_slot(v.kind, v.bits) }
    if v is BcValStr { return unsigned(i64(atom_for(atom_of, v.value))) }
    // T12: a concrete-ref field (struct/array/fn) is a raw `void*` ; an erased
    // field (union / open ref) stays a tagged `vader_box_t` slot.
    if val_type_of_bc_type(ctx.module.types[usize(field_tid)]) == .Ref {
        return cast("void*", emit_data_value(ctx, items, v, name, atom_of))
    }
    return boxed_object(field_tid, emit_data_value(ctx, items, v, name, atom_of))
}

// One `vader_box_t` slot for a boxed-array element : a string boxes its atom in
// `.s`, a struct / nested array boxes a pointer to its static in `.obj`.
box_slot :: fn(
    ctx: EmitCtx,
    items: CTopLevel[]!,
    v: BcDataValue,
    name: string,
    tag: i32,
    atom_of: MutableMap<string,
    i32>,
) -> CExpression {
    if v is BcValStr { return boxed_string(tag, atom_for(atom_of, v.value)) }
    return boxed_object(tag, emit_data_value(ctx, items, v, name, atom_of))
}

// `{ tag, 0u, { .obj = (void*) pointer } }` — a box holding a static object.
boxed_object :: fn(tag: i32, pointer: CExpression) -> CExpression = initializer_list([
    unsigned(i64(tag)), ZERO, initializer_list([designated(".obj", cast("void*", pointer))]),
])

// `{ tag, 0u, { .s = atom } }` — a box holding a string.
boxed_string :: fn(tag: i32, atom: i32) -> CExpression = initializer_list([
    unsigned(i64(tag)), ZERO, initializer_list([designated(".s", unsigned(i64(atom)))]),
])

// Storage kind of an array's elements — the first element's prim kind (enum/prim
// arrays store at the repr width), or Boxed for struct / string / array elements.
element_storage_kind :: fn(elements: BcDataValue[]) -> ArrayKind {
    if elements.len() == 0 { return .Boxed }
    if elements[0] is BcValPrim as p { return p.kind }
    return .Boxed
}

// Type-table index of the `BcStruct` declared by `symbol_id`. Load-bearing here
// (it picks the static's C struct type + header tag), and a baked struct is
// always declared in the same module — so a miss is an upstream bug, not a
// degraded-to-primitive-0 silent corruption.
type_id_for_struct_symbol :: fn(types: BcType[], symbol_id: i32) -> i32 {
    for i in 0..<types.len() {
        if types[i] is BcStruct as s {
            if s.symbol_id == symbol_id { return i32(i) }
        }
    }
    panic("c_emit: baked struct symbol_id ${symbol_id} not in the module type table")
}

// Type-table index of a `BcStruct` by display name, or 0 (nested-array element).
type_index_for_name :: fn(types: BcType[], name: string) -> i32 {
    for i in 0..<types.len() {
        if types[i] is BcStruct as s {
            if struct_c_name(s.name) == struct_c_name(name) { return i32(i) }
        }
    }
    return 0
}

// Type-table index of the `BcArray` whose element is `elem_index`, or 0.
array_type_index_for_element :: fn(types: BcType[], elem_index: i32) -> i32 {
    for i in 0..<types.len() {
        if types[i] is BcArray as ar {
            if ar.element == elem_index { return i32(i) }
        }
    }
    return 0
}

// One primitive-element `.rodata` buffer + array header. Concrete-typed slots so
// the initialiser is a plain C aggregate.
emit_prim_data_entry :: fn(items: CTopLevel[]!, array: PoolArray, pd: BcPrimData) -> void {
    slots: CExpression[]!: []
    for bits in pd.items {
        slots.push(data_slot(pd.kind, bits))
    }
    push_pool_array(items, array, c_type_for_array_kind(pd.kind), pd.kind, slots)
}

// Storage class of a pool entry. Aggregates are always read-only (T3076 keeps a
// mutable module const to value elements), so only the two flat kinds carry a bit.
data_entry_mutable :: fn(e: BcDataEntry) -> bool = match e {
    is BcPrimData -> e.mutable
    is BcStrData -> e.mutable
    is BcAggregateData -> e.mutable
}

// One string-array buffer + array header. A string is a `vader_string_t`
// atom id, so the elements live in `vader_box_t` slots (element_kind Boxed) — each
// box tagged with the string element type, payload `.s` = the interned atom id.
emit_str_data_entry :: fn(
    items: CTopLevel[]!,
    array: PoolArray,
    sd: BcStrData,
    atom_of: MutableMap<string,
    i32>,
) -> void {
    slots: CExpression[]!: []
    for value in sd.values {
        slots.push(boxed_string(array.element_tag, atom_for(atom_of, value)))
    }
    push_pool_array(items, array, "vader_box_t", .Boxed, slots)
}

// Value → comptime atom id, parallel to `module.strings` / `atom_ids`. Every
// data-pool string is interned into `module.strings` by `midir::emit`, so each
// element resolves here ; `atom_for` defaults a stray miss to the empty atom.
build_string_atom_map :: fn(ctx: EmitCtx) -> MutableMap<string, i32> {
    m :: MutableMap<string, i32> {}
    strings :: ctx.module.strings
    for i in 0..<strings.len() { m[strings[i]] = ctx.atom_ids[i] }
    return m
}

// Does the pool hold any string array ? Gates the (whole-string-table) map build.
has_str_data :: fn(data_pool: BcDataEntry[]) -> bool {
    for e in data_pool {
        if e is BcStrData { return true }
        if e is BcAggregateData { return true }
    }
    return false
}

atom_for :: fn(atom_of: MutableMap<string, i32>, value: string) -> i32 {
    a :: atom_of[value]
    if a is i32 { return a }
    return 0
}

// Recover each data-pool entry's array type_id by scanning every fn's ops for
// the `data.const` that references it (the entry struct doesn't store it).
data_pool_type_ids :: fn(module: BytecodeModule) -> i32[] {
    out: i32[]!: [0] * module.data_pool.len()
    for f in module.functions {
        for op in f.body {
            if op is DataConst {
                if op.pool_index >= 0 && usize(op.pool_index) < out.len() {
                    out[usize(op.pool_index)] = op.type_id
                }
            }
        }
    }
    return out
}

// One `.rodata` slot initialiser for a data-pool element. Integer / char / bool
// kinds store the raw bit pattern verbatim (`(cty) UINT64_C(bits)`). Float kinds
// must NOT numerically convert the bits — they reinterpret via `from_bits` and
// re-render the value as a C float literal (`float_lit`), so `2.5` lands as the
// double `2.5`, not the integer `0x4004…` cast to double.
data_slot :: fn(kind: ArrayKind, bits: u64) -> CExpression {
    type :: c_type_for_array_kind(kind)
    if kind == .F64 { return cast(type, verbatim(float_lit(bits.from_bits()))) }
    if kind == .F32 { return cast(type, verbatim(float_lit(f64(u32(bits).from_bits())))) }
    return cast(type, call("UINT64_C", [verbatim("${bits}")]))
}

// C slot type for a primitive `ArrayKind`. Mirrors `vader_array_element_size`
// widths ; `Boxed` never reaches here (data pool is primitive-only).
c_type_for_array_kind :: fn(k: ArrayKind) -> string = match k {
    .U8    -> "uint8_t"
    .U16   -> "uint16_t"
    .U32   -> "uint32_t"
    .U64   -> "uint64_t"
    .I8    -> "int8_t"
    .I16   -> "int16_t"
    .I32   -> "int32_t"
    .I64   -> "int64_t"
    .F32   -> "float"
    .F64   -> "double"
    .Char  -> "uint32_t"
    .Bool  -> "uint8_t"
    .Ref   -> "void*"
    .Boxed -> "vader_box_t"
}

/// Forward decl for every fn a call site outside its own unit can reach, so
/// those compile in any declaration order.
///
/// In a split build the INTERNAL functions are deliberately absent: they are
/// declared `static` at the top of their own unit instead
/// (`split.vader::emit_internal_forward_decls`). A `static` definition preceded
/// by a non-`static` declaration is invalid C, so the two have to agree.
emit_forward_decls :: fn(ctx: EmitCtx, printer: CPrinter!) -> void {
    prototypes: CTopLevel[]!: []
    for i in 0..<ctx.module.functions.len() {
        storage :: module_function_storage(ctx, i32(i))
        if storage == .External || !ctx.split {
            prototypes.push(CPrototype { .signature = signature_for(ctx, i32(i)) })
        }
    }
    printer.print_section(CSection { .items = prototypes })
}

/// C signature of `module.functions[index]` : its storage, return type,
/// sanitised name and parameters `l<i>`.
///
/// B1 (nullable-ref inline rep) slots pass as raw `void*` at the C-ABI
/// boundary AND rename the param to `lN_b1` (the body prologue then
/// re-declares a `vader_box_t lN` from it) ; both halves land together in
/// T12. Until then every slot uses its plain `c_type_for_val_bare`
/// spelling and the `lN` name.
///
/// @param ctx    the emit context, for the storage.
/// @param index  index into `module.functions`.
signature_for :: fn(ctx: EmitCtx, index: i32) -> CSignature {
    function :: ctx.module.functions[usize(index)]
    parameters :: value_parameters(function.signature.params, "l")
    // A multi-value return has no C spelling, so it becomes out-params appended
    // after the declared ones and the function itself returns void. Measured as
    // the fastest of the three shapes a composite can cross in — out-params,
    // a flat struct by value, or the heap object this replaces — and the only
    // one that needs no ABI threshold to be known.
    multiple :: bc_result_arity(function.signature) > 1
    if multiple {
        results :: function.signature.results
        for i in 0..<results.len() {
            parameters.push(CParameter {
                .type = "${c_type_for_val_bare(results[i])}*",
                .name = out_param_name(i),
            })
        }
    }
    return CSignature {
        .storage = module_function_storage(ctx, index),
        .result = if multiple {
            "void"
        } else {
            c_type_for_val_bare(bc_single_result(function.signature))
        },
        .name = sanitise(function.name),
        .parameters = parameters,
    }
}

/// Name of the `i`-th out-param in a scalarised multi-value signature.
///
/// One place, because the callee's `return` writes through it and every call
/// site takes its address — a mismatch between the two is a C compile error at
/// best and the wrong slot at worst.
export out_param_name :: fn(i: usize) -> string = "__o${i}"

/// Per-`BcFn` function-pointer typedef + per-arity canonical erased
/// typedef. The canonical erased family is always emitted at least for
/// arity 0 (used by the closure dispatch path's lift / tramp wrapper).
emit_fn_sig_typedefs :: fn(ctx: EmitCtx, printer: CPrinter!) -> void {
    // Canonical erased fn-pointer signatures per arity, from 0 : a module
    // with no fn type still gets the 0-arity one.
    typedefs: CTopLevel[]!: []
    for n in 0..=max_fn_arity(ctx.module.types) {
        typedefs.push(CFunctionPointerTypedef {
            .result = "vader_box_t",
            .name = "vader_fn_erased_sig_${n}_t",
            .parameters = erased_parameters(n),
        })
    }
    printer.print_section(CSection { .items = typedefs })
}

/// Highest arity across every `BcFn` type in the module. Returns `0`
/// for an empty type table so the 0-arity typedef is always emitted.
max_fn_arity :: fn(types: BcType[]) -> usize {
    best: usize = 0
    for t in types {
        if t is BcFn && t.params.len() > best {
            best = t.params.len()
        }
    }
    return best
}

/// The parameters of an erased-ABI function : `void* env`, then one
/// `vader_box_t a<j>` per boxed slot. Shared by the `vader_fn_erased_sig_N_t`
/// typedefs and by the trampoline and lift wrappers, whose prototypes must
/// match their definitions.
///
/// @param count  the boxed slots after `env`.
erased_parameters :: fn(count: usize) -> CParameter[] = boxed_parameters(
    CParameter { .type = "void*", .name = "env" },
    count,
)

/// `first`, then one `vader_box_t a<j>` per boxed slot.
///
/// @param first  the leading parameter.
/// @param count  the boxed slots after it.
boxed_parameters :: fn(first: CParameter, count: usize) -> CParameter[] {
    parameters: CParameter[]!: [first]
    for j in 0..<count {
        parameters.push(CParameter { .type = "vader_box_t", .name = "a${j}" })
    }
    return parameters
}

/// One parameter per value slot, `<type> <prefix><i>`.
///
/// @param slots   the parameters' stack classes.
/// @param prefix  the name every parameter shares, before its index.
value_parameters :: fn(slots: ValType[], prefix: string) -> CParameter[]! {
    parameters: CParameter[]!: []
    for i in 0..<slots.len() {
        type :: c_type_for_val_bare(slots[i])
        parameters.push(CParameter { .type = type, .name = "${prefix}${i}" })
    }
    return parameters
}

// `emit_fn_trampolines` (the per-fn `fn.ref` / `make_closure` wrappers)
// lives in `walker.vader` (same module), next to `compute_may_alloc` — both
// are whole-module body scans over the fn table.

/// Per-type GC info table + (at the end) the vtable section. Always
/// emitted, even for an empty module — the runtime fallback expects strong
/// symbols here.
///
/// Each struct visits its fields exactly once : a single classifier walk
/// produces the `(ptr_offsets, str_offsets, ref_offsets)` lists its row
/// writes in place.
///
/// @param ctx   the emit context.
/// @param printer  receives the table.
emit_type_info_table :: fn(ctx: EmitCtx, printer: CPrinter!) -> void {
    types :: ctx.module.types
    count :: types.len()

    // Every array and every fn value has the same single reference, so they
    // share one offset list each — emitted only when used, since an unused
    // `static const` draws a C warning.
    has_fn := false
    has_array := false
    for t in types {
        if t is BcFn    { has_fn = true }
        if t is BcArray { has_array = true }
    }
    shared: CTopLevel[]!: []
    if has_fn {
        shared.push(single_offset_list("vader_fn_ptr_offsets", "offsetof(vader_fn_t, env)"))
    }
    if has_array {
        shared.push(single_offset_list("vader_array_ptr_offsets", "offsetof(vader_array_t, buf)"))
    }
    printer.print_section(CSection { .items = shared })

    // Per-type info initialiser rows — struct / fn / array carry a full row ;
    // primitives / unions / refs only set `slot_size` and keep the zero-init
    // `VADER_TYPE_KIND_NONE` (so the GC scanner short-circuits without reading
    // the payload).
    rows: CExpression[]!: []
    for j in 0..<count {
        match types[j] as entry {
            is BcStruct -> rows.push(
                struct_info_row(ctx, entry, classify_struct_fields(ctx, entry, j), j),
            )
            is BcFn     -> rows.push(
                single_reference_row(
                    j,
                    "FN",
                    "vader_fn_t",
                    size_of_bc_type(entry),
                    "vader_fn_ptr_offsets",
                ),
            )
            is BcArray  -> rows.push(
                single_reference_row(
                    j,
                    "ARRAY",
                    "vader_array_t",
                    size_of_bc_type(entry),
                    "vader_array_ptr_offsets",
                ),
            )
            // Primitives / unions / refs — every other `BcType`. MUST stay a
            // `_` arm, not `@partial` : those slots are reachable (e.g. an
            // enum/distinct interning under its backing primitive's key), and a
            // trapping fallback would abort. `null` is 0 wide and keeps no row.
            _           -> {
                size :: size_of_bc_type(entry)
                if size > 0 {
                    rows.push(info_row(j, [designated(".slot_size", number(i64(size)))]))
                }
            }
        }
    }
    table :: CGlobal {
        .constant = true,
        .type = "vader_type_info_t",
        .declarator = CDeclarator {
            .name = "vader_type_info_table",
            .length = i32(count),
            .value = initializer_list(rows),
        },
    }
    table_count :: CGlobal {
        .constant = true,
        .type = "size_t",
        .declarator = CDeclarator { .name = "vader_type_info_count", .value = number(i64(count)) },
    }
    printer.print_section(CSection { .items = [table, table_count] })
}

// `static const uint16_t name[] = { offset };` — the offset list every type of
// one kind shares.
single_offset_list :: fn(name: string, offset: string) -> CTopLevel = CGlobal {
    .storage = .Internal,
    .constant = true,
    .type = "uint16_t",
    .declarator = CDeclarator {
        .name = name,
        .length = UNSIZED,
        .value = initializer_list([verbatim(offset)]),
    },
}

// The row of a type whose objects hold exactly one reference, at the offset
// the shared list `offsets` names.
single_reference_row :: fn(
    index: usize,
    kind: string,
    type: string,
    slot_size: i32,
    offsets: string,
) -> CExpression = info_row(
    index,
    [
        designated(".kind", verbatim("VADER_TYPE_KIND_${kind}")),
        designated(".size", verbatim("sizeof(${type})")),
        designated(".slot_size", number(i64(slot_size))),
        designated(".ptr_offsets", verbatim(offsets)),
        designated(".ptr_count", number(1)),
    ],
)

// `[index] = { members… }` — one row of the type-info table.
info_row :: fn(index: usize, members: CExpression[]) -> CExpression = designated(
    "[${index}]",
    initializer_list(members),
)

/// Per-struct field classification carrier, captured once by
/// `classify_struct_fields` and written by `struct_info_row`. Each list
/// holds `offsetof` expressions.
StructOffsets :: struct {
    /// Box-bearing fields.
    ptr_offsets: string[]!
    /// Raw `vader_string_t` fields — the string GC marks them independently of
    /// the box-aliased Cheney walk.
    str_offsets: string[]!
    /// Nullable-ref slots that store a raw `void*`.
    ref_offsets: string[]!
}

empty_struct_offsets :: fn() -> StructOffsets {
    p: string[]!: []
    s: string[]!: []
    r: string[]!: []
    return StructOffsets { .ptr_offsets = p, .str_offsets = s, .ref_offsets = r }
}

/// Classify each field of `s` into ptr / str / ref offset lists. Used
/// by the type-info emit's single-pass-per-struct flow.
///
/// All three buckets are live: the bucket a field lands in decides which GC
/// reader scans it, so it MUST match the field's emitted C type — see the T12
/// note in the body, and `val_type_of_bc_type`, the shared predicate that keeps
/// the two from drifting.
classify_struct_fields :: fn(ctx: EmitCtx, s: BcStruct, type_index: usize) -> StructOffsets {
    cname :: ctx.struct_c_names[type_index]
    offsets :: empty_struct_offsets()
    for i in 0..<s.fields.len() {
        f :: s.fields[i]
        ftype :: ctx.module.types[usize(f.type_index)]
        sanitised :: sanitise(f.name)
        offset :: "offsetof(${cname}, f_${sanitised})"
        // T12: the offset bucket MUST match the field's C type so the GC scans it
        // with the right reader — a raw `void*` (`.Ref`) via `ref_offsets` →
        // `vader_gc_scan_raw`, a `vader_box_t` (`.Any`) via `ptr_offsets` →
        // `vader_gc_scan_box`. Derive the bucket from `val_type_of_bc_type` (the
        // same predicate `c_type_for` uses) so the two can't drift: misfiling a
        // raw `void*` under `ptr_offsets` makes the collector read the pointer as
        // a 24 B box, forwarding garbage / never updating the field → a stale ref
        // after a move (the `MutableMap` ekeys UAF). Only `string` primitives take
        // a `str_offsets` tracking slot ; other primitives carry no heap ref.
        if ftype is BcPrimitive {
            if is_string_val(ftype.val) { offsets.str_offsets.push(offset) }
        } else if val_type_of_bc_type(ftype) == .Ref {
            offsets.ref_offsets.push(offset)
        } else {
            offsets.ptr_offsets.push(offset)
        }
    }
    return offsets
}

/// One struct's row of the type-info table, its offset lists written in place.
/// Every struct gets a heap-backed `VADER_TYPE_KIND_STRUCT` row — no
/// inline-variant (`VADER_TYPE_KIND_INLINE_REF`) or packed-payload shape.
struct_info_row :: fn(
    ctx: EmitCtx,
    s: BcStruct,
    offs: StructOffsets,
    type_index: usize,
) -> CExpression {
    // Fields are named, so the row does not depend on `vader_type_info_t`'s
    // field order — the committed seed is compiled against the header of the
    // tree, and a positional row would shift under any new field. An empty
    // offset list is left out : it stays zero, which is `NULL` / 0.
    members: CExpression[]!: [
        designated(".kind", verbatim("VADER_TYPE_KIND_STRUCT")),
        designated(".size", verbatim("sizeof(${ctx.struct_c_names[type_index]})")),
        designated(".slot_size", number(i64(size_of_bc_type(s)))),
    ]
    push_offset_list(members, "ptr", offs.ptr_offsets)
    push_offset_list(members, "string", offs.str_offsets)
    push_offset_list(members, "ref", offs.ref_offsets)
    return info_row(type_index, members)
}

// `.<prefix>_offsets = (const uint16_t[]){ offsets… }, .<prefix>_count = N`,
// nothing when `offsets` is empty. The list is a compound literal : static
// storage, used by this row alone, so it needs no name.
push_offset_list :: fn(members: CExpression[]!, prefix: string, offsets: string[]) -> void {
    if offsets.len() == 0 {
        return
    }
    elements :: offsets.map((offset) -> verbatim(offset)).collect()
    members.push(
        designated(
            ".${prefix}_offsets",
            CCompoundLiteral { .type = "const uint16_t[]", .elements = elements },
        ),
    )
    members.push(designated(".${prefix}_count", number(i64(offsets.len()))))
}

// `emit_import_shims` lives in `host.vader` (same module) — the
// `call.import` host-fn dispatch is a distinct responsibility.
//
// The vtable dispatchers (`emit_vtable_forward_decls` /
// `emit_vtable_dispatchers`) live in `dispatch.vader` (same module) —
// trait-method dispatch is its own responsibility.

/// `int main(...)` shim. No `is_main` fn → the `return 0;` stub. Otherwise
/// a signature-aware entry : `vader_atom`/`vader_gc` init, optional
/// `[string]` argv construction, and the call to the user `main`
/// (`return (int) main()` for an `i32` result, `main(); return 0;` for
/// `void`). T3033 guarantees the signature is `()` or `([string])`.
emit_main :: fn(ctx: EmitCtx, printer: CPrinter!, entry_mangled: string) -> void {
    signature :: CSignature {
        .result = "int",
        .name = "main",
        .parameters = [
            CParameter { .type = "int", .name = "argc" },
            CParameter { .type = "char**", .name = "argv" },
        ],
    }
    body :: CBlock { .body = main_body(ctx, entry_mangled) }
    printer.print_item(CFunction { .signature = signature, .body = body })
}

// The statements of `int main`.
main_body :: fn(ctx: EmitCtx, entry_mangled: string) -> CStatement[]! {
    unused_arguments: CStatement[]!: [
        CExpressionStatement { .expression = cast("void", verbatim("argc")) },
        CExpressionStatement { .expression = cast("void", verbatim("argv")) },
    ]
    main_index :: find_main(ctx.module, entry_mangled)
    if main_index < 0 {
        unused_arguments.push(CReturn { .value = number(0) })
        return unused_arguments
    }

    function :: ctx.module.functions[usize(main_index)]
    takes_argv :: function.signature.params.len() == 1
    // Atom table init must precede any string interning. `atexit`
    // handlers fire LIFO, so atom shutdown runs after gc shutdown.
    atom_table: CExpression[]: [
        verbatim("vader_atom_comptime_table"),
        verbatim("VADER_COMPTIME_ATOM_COUNT"),
    ]
    body: CStatement[]!: [perform("vader_atom_init_with_comptime", atom_table)]
    // Before any Vader code runs, so the very first collection already sees them.
    // The frame becomes the BASE of the chain: every later frame links onto it and
    // nothing ever pops below it.
    root_count :: mutable_pool_indices(ctx.module.data_pool).len()
    if root_count > 0 {
        body.push(
            CAssign {
                .target = verbatim("vader_gc_top"),
                .value = address_of(verbatim("vader_global_const_frame")),
            },
        )
        roots: CExpression[]: [verbatim("vader_global_const_arrays"), unsigned(i64(root_count))]
        body.push(perform("vader_atom_roots_register", roots))
    }
    body.push(perform("atexit", [verbatim("vader_atom_shutdown")]))
    body.push(perform("atexit", [verbatim("vader_gc_shutdown")]))

    arguments: CExpression[]!: []
    if takes_argv {
        string_tag :: ctx.string_tag
        array_tag :: ctx.string_array_tag
        if string_tag < 0 || array_tag < 0 {
            body.push_all(unused_arguments)
            body.push(trap("main(argv): missing [string] type"))
            body.push(CReturn { .value = number(1) })
            return body
        }
        argv :: call(
            "vader_runtime_argv",
            [
                verbatim("argc"),
                verbatim("argv"),
                unsigned(i64(array_tag)),
                unsigned(i64(string_tag)),
            ],
        )
        // The entry's `argv: [string]` param is a concrete array → a raw `void*`
        // (`.Ref`) under T12 ; pass the array pointer directly. (`.Any` would box.)
        if function.signature.params[0] == .Ref {
            body.push(declaration("void*", "__args", cast("void*", argv)))
        } else {
            body.push(
                declaration(
                    "vader_box_t",
                    "__args",
                    call("vader_box_obj", [unsigned(i64(array_tag)), argv]),
                ),
            )
        }
        arguments.push(verbatim("__args"))
    } else {
        body.push_all(unused_arguments)
    }

    entry :: call(sanitise(function.name), arguments)
    if bc_single_result(function.signature) == .Void {
        body.push(CExpressionStatement { .expression = entry })
        body.push(CReturn { .value = number(0) })
    } else {
        body.push(CReturn { .value = cast("int", entry) })
    }
    return body
}

/// Index of the program-entry main, or `-1` when none. Prefers the fn whose
/// name is `entry_mangled` (the designated entry — `dump_bytecode` stamps the
/// same one as `export main N`) : a multi-module program has several `main`
/// fns all flagged `is_main`, and the entry one isn't necessarily first in the
/// fn table. Falls back to the first non-empty `is_main` fn when no entry name
/// is supplied (single-main programs).
find_main :: fn(m: BytecodeModule, entry_mangled: string) -> i32 {
    if entry_mangled != "" {
        for i in 0..<m.functions.len() {
            f :: m.functions[i]
            if f.name == entry_mangled && f.body.len() > 0 {
                return i32(i)
            }
        }
    }
    for i in 0..<m.functions.len() {
        f :: m.functions[i]
        if f.is_main && f.body.len() > 0 {
            return i32(i)
        }
    }
    return -1
}

/// BcType index of the `null` primitive, or `0` when absent. Tags the
/// boxed null literal so `type_check` stays consistent across boxed and
/// unboxed paths. Called once by `new_ctx` (cached in `EmitCtx.null_tag`).
null_primitive_tag :: fn(types: BcType[]) -> i32 {
    for i in 0..<types.len() {
        t :: types[i]
        if t is BcPrimitive {
            if t.val == .Null { return i32(i) }
        }
    }
    return 0
}

/// BcType index of the `string` primitive, or `-1` when absent. Called
/// once by `new_ctx` (cached in `EmitCtx.string_tag`).
string_primitive_tag :: fn(types: BcType[]) -> i32 {
    for i in 0..<types.len() {
        t :: types[i]
        if t is BcPrimitive {
            if is_string_val(t.val) { return i32(i) }
        }
    }
    return -1
}

/// BcType index of the `[string]` array (element type == `str_idx`), or
/// `-1` when absent. Called once by `new_ctx` (cached in
/// `EmitCtx.string_array_tag`).
string_array_tag :: fn(types: BcType[], str_idx: i32) -> i32 {
    if str_idx < 0 { return -1 }
    return array_tag(types, str_idx)
}
