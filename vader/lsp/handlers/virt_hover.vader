// vader/lsp/handlers/virt_hover — `textDocument/hover` over a `.virt` document.
//
// Hovering the first word of a line — an op or a directive — shows its entry in
// the text bytecode's reference (`vader/bytecode/ops.md`, read by `op_doc`).

module "vader/lsp/handlers"

import "json"
import "std/string"
import "vader/lsp/analysis"
import "vader/lsp/protocol"

Bc :: import "vader/bytecode"

/// The hover for `params` in a `.virt` document : the reference entry of the
/// line's first word when the cursor is on it, null anywhere else.
///
/// @param state   the server state, which holds the document's text.
/// @param params  the `textDocument/hover` params.
export handle_virt_hover :: fn(state: ServerState, params: JsonValue) -> JsonValue {
    text :: state.source_for(position_uri(params)) ?? return JsonNull {}
    li :: new_line_index(text, state.position_encoding)
    line :: position_line(params)
    if line < 0 || usize(line) >= li.line_starts.len() {
        return JsonNull {}
    }
    cursor :: li_offset(li, line, position_character(params))
    head :: head_at(text, li.line_starts[usize(line)], cursor) ?? return JsonNull {}
    doc :: Bc.op_doc(head) ?? return JsonNull {}
    return markdown_hover("```virt\n${doc.forms.join("\n")}\n```\n\n${doc.text}")
}

// The first word of the line starting at byte `start` of `text`, when byte
// `cursor` falls inside it ; null otherwise.
head_at :: fn(text: string, start: usize, cursor: usize) -> string | null {
    b :: text.bytes()
    first := start
    for first < b.len() && (b[first] == ' ' || b[first] == '\t') {
        first += 1
    }
    stop := first
    for stop < b.len() && !ends_word(b[stop]) {
        stop += 1
    }
    if cursor < first || cursor >= stop {
        return null
    }
    return b[first..<stop].bytes_to_string()
}

ends_word :: fn(c: u8) -> bool = c == ' ' || c == '\t' || c == '\r' || c == '\n'

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_head_at_on_an_indented_op :: fn() -> void {
    assert_eq(head_at("  local.get 0   ; arg 0", 0, 4) ?? "", "local.get")
}

@test
test_head_at_on_a_later_line :: fn() -> void {
    assert_eq(head_at("fn 0 main\n  drop\n", 10, 13) ?? "", "drop")
}

@test
test_head_at_off_the_first_word :: fn() -> void {
    assert(head_at("  local.get 0", 0, 12) == null, "an operand is not the head")
    assert(head_at("  local.get 0", 0, 0) == null, "the indentation is not the head")
}
