// vader/lsp/handlers/definition — `textDocument/definition` handler.
//
// The client sends `{ textDocument: { uri }, position: { line, character } }`
// (both 0-based). We look up the per-document index built in
// `vader/lsp/analysis/state` and ask the indexer for the decl whose name matches
// the identifier under the cursor.
//
// Response shape depends on `client.capabilities.textDocument.definition.linkSupport`
// (captured at `initialize`) :
//   - true → `LocationLink[]` with `originSelectionRange` set to the
//            clicked token's span. Lets the editor draw a precise
//            Ctrl/Cmd-hover underline on the exact identifier.
//   - false → bare `Location { uri, range }`, the older shape every
//             client understands.
// `JsonNull` for "no result" in both cases.

module "vader/lsp/handlers"

import "json"
import "std/collections"
import "vader/diagnostics"
import "vader/types"
import "vader/lsp/protocol"
import "vader/lsp/analysis"
import "toolchain/span"
AST :: import "toolchain/ast"

/// Resolve goto-def for the position carried in `params`. Returns
/// `LocationLink[]` (when `linkSupport`) or a bare `Location`, or
/// `JsonNull` on miss.
export handle_definition :: fn(state: ServerState!, params: JsonValue) -> JsonValue {
    uri :: position_uri(params)
    if uri == "" { return JsonNull {} }
    line :: position_line(params)
    character :: position_character(params)

    idx :: state.index_for(uri)
    match idx {
        is null              -> { return JsonNull {} }
        is DocIndex as index -> {
            // A `break` / `continue` jumps to the loop it targets (bare →
            // innermost, `break <var>` / `<label>` → the named enclosing loop) —
            // the reader-clarity tool that replaced the retired W0004 nudge.
            loop_target :: loop_jump_at(index, line, character)
            if loop_target != null {
                origin :: index.span_at(line, character)
                return def_response(state, origin, uri, loop_target, loop_target, index.line_index)
            }
            // BEFORE the local index, and that ordering is the point: a
            // same-file `b.cond` matches the first `cond` entry the document
            // has, which is another struct's. The type lookup declines unless
            // the cursor really follows a dot, so ordinary names are untouched.
            after_dot :: cursor_follows_a_dot(index, line, character)
            by_type :: member_by_type(state, uri, index, line, character)
            if by_type != null {
                origin_m :: index.span_at(line, character)
                return def_response(state, origin_m, by_type.uri, by_type.target.name_span, by_type.target.full_span, index.line_index)
            }
            entry :: index.find_at(line, character)
            match entry {
                is DeclEntry as found  -> {
                    origin :: index.span_at(line, character)
                    return def_response(state, origin, uri, found.name_span, found.full_span, index.line_index)
                }
                is null -> {
                    nm :: index.name_at(line, character)
                    origin :: index.span_at(line, character)
                    // By name: imports, siblings, wildcards, and finally any
                    // member of that name. The typed lookup above already
                    // declined — the receiver has no declaring symbol (an array,
                    // a string), so its methods live on a built-in trait with no
                    // type to key on.
                    ext :: resolve(state, index, nm, after_dot)
                    if ext == null { return JsonNull {} }
                    return def_response(state, origin, ext.uri, ext.target.name_span, ext.target.full_span, index.line_index)
                }
            }
        }
    }
}

// Resolve `name` as a member of the type it is accessed ON.
//
// Two shapes reach here, and both carry their answer in the typed program:
//
//   - `recv.name` — the receiver's type names the declaring struct or trait.
//   - `.Variant`  — the dot-variant's OWN type names the enum, inferred from
//     whatever slot it sits in.
//
// Returns null when the type has no declaring symbol (an array, a string: their
// methods live on a built-in trait) — the caller then falls back to the
// name-based search, which is right for exactly those.
member_by_type :: fn(
    state: ServerState!, uri: string, index: DocIndex, line: i32, character: i32,
) -> ExternalHit | null {
    name :: index.name_at(line, character)
    if name.bytes().len() == 0 {
        return null
    }
    // The DOT TEST COMES FIRST, before anything expensive. `typed_project_for`
    // loads and typechecks the project, and the cache holds ONE entry keyed on
    // the entry path — so with two files open every goto-def is a cold one.
    // Testing after it made an ordinary identifier, which cannot be a member,
    // pay that: 0.03 s to 0.6 s, on the most interactive path there is.
    if !cursor_follows_a_dot(index, line, character) {
        return null
    }
    nm_span :: index.span_at(line, character) ?? return null
    // A namespace alias FIRST, and cheaply: `AST.MatchExpr` has no receiver
    // whose type could be read — the alias names a module, not a value — so the
    // typed path below can never answer it. Resolving the member as an EXPORT of
    // that module is the only route, and it is the spelling CLAUDE §7 makes
    // mandatory once an alias is taken.
    alias_path :: alias_before(index, nm_span.start.offset)
    if alias_path != null {
        // `true`: an alias exposes only the module's public surface, exactly
        // like a wildcard.
        return resolve_in_module(state, uri, alias_path, name, true)
    }
    file_path :: uri_to_path(uri)
    if file_path.bytes().len() == 0 {
        return null
    }
    // DURING an edit burst this project is deliberately stale: `handle_did_change`
    // rebuilds the document index but keeps the typed cache, so the debounce can
    // typecheck once instead of per keystroke. The AST here is then the PREVIOUS
    // text, and no receiver ends where the new one says the dot is — so this
    // answers null until the burst settles. That is the right outcome: a stale
    // AST would otherwise jump to a position the text no longer has.
    cached :: typed_project_for(state, file_path)
    entry :: cached.project.modules[cached.project.entry] ?? return null
    sf :: source_file_for_path(entry.module.files, file_path) ?? return null
    // LSP positions are 0-based ; the AST is 1-based.
    l :: line + 1
    c :: character + 1
    ty :: member_owner_type(sf, cached.result.typed, nm_span, l, c) ?? return null
    sym :: type_symbol(ty)
    if sym == null {
        // A BUILT-IN receiver has no declaring symbol, so `type_symbol` — which
        // answers for the nominal types only — declines. Arrays still have an
        // owner: the traits an intrinsic `T[] implements …` block names.
        if ty is ArrayType {
            return array_member(state, cached, name)
        }
        return ufcs_member(state, cached, ty, name)
    }
    da :: sym.defined_at ?? return null
    return member_in_declaring_module(state, da.start.file, sym.name, name)
}

// `name` as the UFCS call `name(receiver, …)` — a FREE function whose first
// parameter accepts the receiver's type.
//
// `s.len()` on a string has no owning declaration to point at: `len(s: string)`
// is a free function in `primitives.vader`, not a trait member, so
// `type_symbol` declines and there is no impl block to walk. It used to fall
// through to the name-based lookup, which is blind to the receiver's type and
// answered `array.vader` here — `ArrayOps.len` — because that is what the
// folder enumeration served first.
//
// The FIRST PARAMETER's type is what decides, read from the owning module's
// typed program rather than from the written syntax: `param_types` holds the
// RESOLVED type, so an alias or an import spelling cannot make two different
// types compare equal by their source text.
ufcs_member :: fn(state: ServerState, cached: ProjectCache, recv: Type, name: string) -> ExternalHit | null {
    want :: display_type(recv)
    for [id, m] in cached.project.modules {
        typed :: cached.result.all_modules[id] ?? continue
        for f in m.module.files {
            for d in f.program.decls {
                if d is AST.FnDecl as fd {
                    if fd.name != name || fd.params.len() == 0 {
                        continue
                    }
                    pt :: typed.param_types[fd.params[0].span.hash()] ?? continue
                    if display_type(pt) != want {
                        continue
                    }
                    hit :: toplevel_in_file(state, f.path, name)
                    if hit != null {
                        return hit
                    }
                }
            }
        }
    }
    return null
}

// The exported top-level `name` in `path`. Reads through `source_for_path` — the
// OVERLAY first, disk second — for the same reason `member_in_file` does.
toplevel_in_file :: fn(state: ServerState, path: string, name: string) -> ExternalHit | null {
    src :: state.source_for_path(path)
    if src.bytes().len() == 0 {
        return null
    }
    uri :: path_to_uri(path)
    sub :: build_index(uri, src, state.position_encoding)
    d :: sub.find_exported_toplevel(name) ?? return null
    return ExternalHit { .uri = uri, .target = d }
}

// `name` as a member of one of the traits an intrinsic `T[] implements …` block
// names — `ArrayOps` for `len` / `push` / …, plus `Contains`, `Into`, `Mul`.
//
// Read off the PROJECT's own decls rather than `CheckResult.impls`: that
// registry is built from the entry module's declarations alone
// (`orchestrate.vader`, `build_impl_registry(merge_module_program(entry…))`), so
// the blanket impl in `std/core` is absent from it for every user file. The
// completion handler documents the same gap on the same table.
//
// EVERY array-targeted impl is tried, not the first found: they are four, and
// only one declares the member being asked about.
//
// Without this the lookup fell through to the name-based one, which is blind to
// the receiver's type. `len` is declared four times across the stdlib, so
// `xs.len()` answered with whichever the FOLDER ENUMERATION served first — and
// nothing sorts it: measured `array.vader` on APFS and on a container's
// overlayfs, `primitives.vader` on the CI runner's ext4. Right on a Mac by luck,
// wrong on CI, for four red runs.
//
// A `string` receiver is still not covered: `len(s: string)` is a free function
// in `primitives.vader`, not a trait member, so there is no owning declaration
// to point at and the fallback still decides.
array_member :: fn(state: ServerState, cached: ProjectCache, name: string) -> ExternalHit | null {
    for [_, m] in cached.project.modules {
        for f in m.module.files {
            for d in f.program.decls {
                if d is AST.ImplDecl as im {
                    if !(im.for_type is AST.ArrayTypeExpr) {
                        continue
                    }
                    hit :: member_in_declaring_module(state, im.span.start.file, im.trait_name, name)
                    if hit != null {
                        return hit
                    }
                }
            }
        }
    }
    return null
}

// The type whose declaration owns the member under the cursor: the RECEIVER's
// type for `recv.name`, or the expression's own type for a bare `.Variant`.
member_owner_type :: fn(
    sf: SourceFile, typed: TypedProgram, nm_span: Span, l: i32, c: i32,
) -> Type | null {
    recv :: find_receiver_before_dot(sf.program.decls, l, nm_span.start.column - 1, typed)
    if recv != null {
        return typed.expr_types[recv.id]
    }
    // No receiver ends at the dot — a leading-dot variant, whose type comes
    // from its context rather than from anything to its left.
    e :: find_expr_at(sf.program.decls, l, c, typed) ?? return null
    // A match ARM's pattern is not an expression, so the smallest expression
    // containing the cursor is the whole `match`. Its type is the match's
    // RESULT — `i32` for `.Struct -> 23` — which names no enum, and the lookup
    // then fell back to searching by name and picked another enum's `Struct`
    // from another file. The SCRUTINEE is what the pattern is matched against,
    // so it is the type that owns the variant.
    if e is AST.MatchExpr as m {
        return typed.expr_types[m.scrutinee.id]
    }
    return typed.expr_types[e.id]
}

// Whether the identifier under the cursor starts a member access. Shared by the
// typed lookup and the name-based fallback so both agree on what a member is.
cursor_follows_a_dot :: fn(index: DocIndex, line: i32, character: i32) -> bool {
    sp :: index.span_at(line, character)
    if sp == null {
        return false
    }
    return follows_a_dot(index.source, sp.start.offset)
}

// The module path of the namespace alias immediately left of the dot at
// `offset - 1`, or null when the receiver is not one.
//
// Compares BYTES rather than slicing the source. `Span.offset` is a byte offset
// while `s[a..<b]` on a Vader string slices by CODEPOINT, so building the name
// by slicing reads the wrong region the moment the file holds a single non-ASCII
// character — and this file's own comments are full of em dashes.
alias_before :: fn(index: DocIndex, offset: usize) -> string | null {
    if offset < 2 {
        return null
    }
    bytes :: index.source.bytes()
    end :: offset - 1
    for [alias, path] in index.namespace_aliases {
        n :: alias.byte_len()
        if n == 0 || n > end {
            continue
        }
        start :: end - n
        if !bytes_equal_at(bytes, start, alias) {
            continue
        }
        // The match must be the WHOLE receiver: `MyAST.Foo` must not match an
        // alias called `AST`.
        if start > 0 {
            b :: bytes[start - 1]
            if is_word_byte(b) {
                continue
            }
        }
        return path
    }
    return null
}

bytes_equal_at :: fn(bytes: u8[], start: usize, text: string) -> bool {
    tb :: text.bytes()
    for i in 0..<tb.len() {
        if bytes[start + i] != tb[i] {
            return false
        }
    }
    return true
}

is_word_byte :: fn(b: u8) -> bool = (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
    || (b >= '0' && b <= '9') || b == '_'

// Whether `offset` starts a member access: the byte immediately before it is a
// `.`, and that dot stands alone.
//
// IMMEDIATELY, with no spaces skipped. An earlier version skipped them so
// `a . b` would read like `a.b`, and the two halves of the guard then disagreed:
// the caller takes the dot's column as `name.column - 1`, which under a space is
// the space. No receiver ends there, so it fell into the leading-dot branch and
// took the type of the whole `a . b` expression — answering with a member of the
// WRONG type. Declining loses `a . b` entirely, since the name-based path is
// gated on this same test: better nothing than a member of another type, and the
// tree contains no such spelling (the 175 lines a naive grep finds are all
// `-> .Variant` match arms).
//
// ALONE, because `...` is the spread operator. Its last dot passes a naive test,
// and `{ ...name }` then looked up the local `name` as a member of its own type
// — leaving a perfectly indexed local for a field that merely shares its name.
follows_a_dot :: fn(source: string, offset: usize) -> bool {
    if offset == 0 {
        return false
    }
    bytes :: source.bytes()
    if bytes[offset - 1] != '.' {
        return false
    }
    if offset >= 2 {
        if bytes[offset - 2] == '.' {
            return false
        }
    }
    return true
}

// Find `owner`'s member `name`, starting at the file that declares `owner` and
// then across the rest of its FOLDER.
//
// The folder, because a module is one (R2022) and an `implements` block does not
// have to sit beside the struct it targets: with `Alpha` and `Beta` declared in
// one file and both impls in another, searching only the declaring file
// answered with the first impl it happened to see. The declaring file is tried
// first so the common single-file case costs one read.
member_in_declaring_module :: fn(
    state: ServerState, path: string, owner: string, name: string,
) -> ExternalHit | null {
    here :: member_in_file(state, path, owner, name)
    if here != null {
        return here
    }
    folder :: dirname_path(path)
    if folder.bytes().len() == 0 {
        return null
    }
    files_or :: read_dir(folder)
    match files_or {
        is IOError -> { return null }
        is string[] as files -> {
            for fname in files {
                if !fname.ends_with_vader() {
                    continue
                }
                full :: path_join(folder, fname)
                if full == path {
                    continue
                }
                hit :: member_in_file(state, full, owner, name)
                if hit != null {
                    return hit
                }
            }
            return null
        }
    }
}

// Reads through `source_for_path` — the OVERLAY first, disk second — and not
// `read_file_string`. `def_response` encodes the returned span with
// `line_index_for_path`, which is overlay-backed, so reading the disk here
// pairs one text's offsets with another text's line index. That is not a corner
// case: the first file this path targets is usually the one being edited, and
// five unsaved lines inserted above a struct sent `o.name` to the wrong
// declaration entirely.
member_in_file :: fn(
    state: ServerState, path: string, owner: string, name: string,
) -> ExternalHit | null {
    src :: state.source_for_path(path)
    if src.bytes().len() == 0 {
        return null
    }
    uri :: path_to_uri(path)
    sub :: build_index(uri, src, state.position_encoding)
    d :: sub.find_member_of(owner, name) ?? return null
    return ExternalHit { .uri = uri, .target = d }
}

// Pick the response shape based on what the client said it could
// consume at `initialize` time. The `target_range` widens to the
// decl's full span — `LocationLink` separates "where to jump"
// (`targetSelectionRange`, the name) from "what to highlight"
// (`targetRange`, the whole decl).
def_response :: fn(
    state: ServerState, origin: Span | null, uri: string,
    name_span: Span, full_span: Span, origin_li: LineIndex,
) -> JsonValue {
    // The target spans (`name_span` / `full_span`) live in `uri`'s file, which
    // may differ from the origin's — encode each with its own file's index.
    target_li :: state.line_index_for_path(uri_to_path(uri))
    if state.definition_link_support {
        return JsonArray { .items = [location_link_json(origin, uri, name_span, full_span, origin_li, target_li)] }
    }
    return location_json(uri, name_span.span_to_range_json(target_li))
}

// `LocationLink` carries the optional origin selection range (the clicked
// token) plus the target's full + name ranges.
location_link_json :: fn(
    origin: Span | null, uri: string,
    name_span: Span, full_span: Span,
    origin_li: LineIndex, target_li: LineIndex,
) -> JsonValue {
    obj :: MutableMap<string, JsonValue> {}
    match origin {
        is null -> {}
        is Span as sp -> {
            obj["originSelectionRange"] = range_json(sp.span_to_range_json(origin_li))
        }
    }
    obj["targetUri"]            = JsonString { .value = uri }
    obj["targetRange"]          = range_json(full_span.span_to_range_json(target_li))
    obj["targetSelectionRange"] = range_json(name_span.span_to_range_json(target_li))
    return JsonObject { .entries = obj }
}
