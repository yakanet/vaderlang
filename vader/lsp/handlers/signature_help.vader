// vader/lsp/handlers/signature_help — `textDocument/signatureHelp` handler.
//
// When the cursor sits inside a `CallExpr`'s argument list, look up
// the callee's `FnDecl` and render its signature with the active
// parameter highlighted. Returns `null` for any other cursor
// context (literals, decls, comments, etc.).
//
// LSP §3.17.16 SignatureHelp shape :
//   { signatures: SignatureInformation[],
//     activeSignature?: number, activeParameter?: number }
// SignatureInformation :
//   { label, documentation?, parameters?: [{ label, documentation? }] }

module "vader/lsp/handlers"

import "std/collections"
import "json"
import "vader/typecheck"
import "vader/lsp/protocol"
import "vader/lsp/analysis"
AST :: import "toolchain/ast"

/// Build the signature-help payload for the cursor in `params`. Returns
/// `JsonNull` when the cursor isn't inside a `CallExpr`'s arg list.
export handle_signature_help :: fn(state: ServerState!, params: JsonValue) -> JsonValue {
    uri  :: position_uri(params)
    line :: cursor_field(params, "line")
    char :: cursor_field(params, "character")
    if uri == "" { return JsonNull {} }
    file_path :: uri_to_path(uri)
    if file_path == "" { return JsonNull {} }

    cached :: typed_project_for(state, file_path)
    project :: cached.project
    result :: cached.result
    entry :: project.modules[project.entry]
    if entry is null { return JsonNull {} }
    sf :: source_file_for_path(entry.module.files, file_path)
    if sf is null { return JsonNull {} }

    // LSP positions are 0-based ; AST spans are 1-based.
    target_line :: line + 1
    target_col  :: char + 1
    call :: find_enclosing_call(sf.program.decls, target_line, target_col)
    if call is null { return JsonNull {} }

    sig :: build_signature(call, result.typed)
    if sig is null { return JsonNull {} }
    active :: active_param_index(call, target_line, target_col) + receiver_slots(call, result.typed)

    sigs: JsonValue[]: [sig]
    obj :: MutableMap<string, JsonValue> {}
    obj["signatures"]      = JsonArray { .items = sigs }
    obj["activeSignature"] = JsonNumber { .value = 0.0 }
    obj["activeParameter"] = JsonNumber { .value = f64(active) }
    return JsonObject { .entries = obj }
}

// The `find_enclosing_call` cursor walker lives in
// `vader/lsp/analysis/ast_walk` — shared with hover / typeDefinition.

// ---- signature lookup ----------------------------------------------------

/// Resolve `call.callee` to its `FnDecl` and render it as a
/// SignatureInformation. Returns `null` on miss (no fn behind the callee).
build_signature :: fn(call: AST.CallExpr, typed: TypedProgram) -> JsonValue | null {
    fn_decl :: lookup_fn_decl(call.callee, typed) ?? return null
    label :: render_signature_label(fn_decl)
    params: JsonValue[]!: []
    for p in fn_decl.params {
        p_label :: render_param_label(p)
        p_obj :: MutableMap<string, JsonValue> {}
        p_obj["label"] = JsonString { .value = p_label }
        params.push(JsonObject { .entries = p_obj })
    }
    obj :: MutableMap<string, JsonValue> {}
    obj["label"]      = JsonString { .value = label }
    obj["parameters"] = JsonArray { .items = params }
    return JsonObject { .entries = obj }
}

// The declaration of the fn `callee` calls: the one typecheck chose, which tells
// overloads apart and covers a UFCS `x.f()`, else the one its name designates.
lookup_fn_decl :: fn(callee: AST.Expr, typed: TypedProgram) -> AST.FnDecl | null {
    chosen :: chosen_decl(typed, callee.id)
    if chosen != null {
        return chosen
    }
    return lookup_callee_fn_decl(callee, typed)
}

// A UFCS call's receiver fills the first parameter, so its written arguments
// start at the second.
receiver_slots :: fn(call: AST.CallExpr, typed: TypedProgram) -> i32 =
    if typed.ufcs_receiver_types[call.callee.id] != null { 1 } else { 0 }

render_signature_label :: fn(fd: AST.FnDecl) -> string {
    out := "${fd.name}("
    first := true
    for p in fd.params {
        if !first { out = out + ", " }
        first = false
        out = out + render_param_label(p)
    }
    out = out + ")"
    if fd.return_type !is null {
        out = out + " -> " + render_type_expr(fd.return_type)
    }
    return out
}

render_param_label :: fn(p: AST.FnParam) -> string {
    if p.ty == null { return p.name }
    return "${p.name}: ${render_type_expr(p.ty)}"
}

render_type_expr :: fn(e: AST.TypeExpr) -> string {
    // @partial: only the renderable type-expr shapes are listed ; any other
    // expression form a parser might surface in type position falls back to
    // "?" so the caller still gets a label instead of failing.
    @partial match e {
        is AST.IdentExpr -> { return e.name }
        is AST.GenericInstExpr -> {
            base :: render_type_expr(e.callee)
            args := ""
            first := true
            for a in e.type_args {
                if !first { args = args + ", " }
                first = false
                args = args + render_type_expr(a)
            }
            return "${base}<${args}>"
        }
        is AST.ArrayTypeExpr -> { return "${render_type_expr(e.element)}[]" }
        is AST.MutableTypeExpr -> { return "${render_type_expr(e.inner)}!" }
        is AST.FnTypeExpr -> {
            ps := ""
            first := true
            for p in e.params {
                if !first { ps = ps + ", " }
                first = false
                ps = ps + render_type_expr(p)
            }
            ret := ""
            if e.return_type !is null {
                ret = " -> " + render_type_expr(e.return_type)
            }
            return "fn(${ps})${ret}"
        }
        is AST.BinaryExpr -> {
            return "${render_type_expr(e.left)} | ${render_type_expr(e.right)}"
        }
        is AST.NullLitExpr -> { return "null" }
        // Fallback for unsupported shapes — caller sees the label,
        // doesn't fail.
        _ -> { return "?" }
    }
}

// ---- active-parameter computation ----------------------------------------

/// Count commas before `(line, col)` inside `call.args` to compute the
/// active parameter index. Cursor before the first arg → 0 ; cursor
/// after the second comma → 2 ; etc.
active_param_index :: fn(call: AST.CallExpr, line: i32, col: i32) -> i32 {
    i: i32 = 0
    for a in call.args {
        // Cursor before this arg's start: it sits in the gap that opens this slot
        // — after the previous comma, or before the first argument.
        if before(line, col, a.span.start.line, a.span.start.column) { break }
        if before_or_at(line, col, a.span.end.line, a.span.end.column) { return i }
        i += 1
    }
    // Past every arg (a trailing comma waiting for the next one), or no arg at all.
    return i
}

before :: fn(line_a: i32, col_a: i32, line_b: i32, col_b: i32) -> bool {
    if line_a < line_b { return true }
    if line_a > line_b { return false }
    return col_a < col_b
}

before_or_at :: fn(line_a: i32, col_a: i32, line_b: i32, col_b: i32) -> bool {
    if line_a < line_b { return true }
    if line_a > line_b { return false }
    return col_a <= col_b
}

