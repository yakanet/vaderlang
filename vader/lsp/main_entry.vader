// vader/lsp/main_entry — standalone `main` for the LSP binary.
//
// The unified `vader` CLI (`vader/cli/main.vader`) bundles run / build /
// fmt / dump / lsp into one binary. For the LSP subcommand we ship a
// SEPARATE binary (`vader-lsp`) that loads only the LSP modules — keeps
// startup latency tiny and dodges generic-mono conflicts the bigger CLI
// surfaces. Editors spawn this binary directly.

module "vader/lsp"

import "std/cli"
import "std/io"


main :: fn(argv: string[]) -> i32 {
    // argv[0] is the binary path ; the rest is parsed against `LSP_FLAGS` — the
    // same array the unified CLI's `lsp` action uses, so both entry points
    // accept exactly the same flags and reject the same typos. The host shim
    // seeds the two roots so cross-file goto-def can resolve `std/*` / `vader/*`
    // imports to absolute paths.
    parsed :: parse(argv[1..<argv.len()], LSP_FLAGS)
    if parsed.errors.len() > 0 {
        for e in parsed.errors {
            eprintln("vader-lsp: ${e}")
        }
        return 1
    }
    return run_server(parsed.string_flag("stdlib-root", ""), parsed.string_flag("vader-root", ""))
}
