// vader/lsp/analysis/workspace: find-usages past the document's own project.
//
// A typed project holds what its entry file imports, so find-usages built on the
// open file's project misses every module that imports the file's module in
// turn. `reference_sites` finds those modules with a text search over the files
// under the document's roots (`modules_mentioning`), loads them beside the entry,
// and lets the typecheck decide which mentions are references.
//
// The search finds a module through a file that SPELLS the name. A site that
// runs a target without naming it (`a + b` running an impl's `add`, `${x}` its
// `to_string`) is found only in a module that names the target somewhere too.

module "vader/lsp/analysis"

import "std/collections"
import "std/io"
import "std/string"
import "toolchain/span"
import "vader/lsp/protocol"
import "vader/parser"
import "vader/resolver"
import "vader/text"
import "vader/typecheck"

/// How deep under a root a walk looks for module folders.
WALK_DEPTH_MAX: i64: 12

// The module every file sees without importing it.
PRELUDE :: "std/core"

/// Every site of what `target` names, in the modules that import its own too.
///
/// `index` covers the open file's project : the file and what it imports. A
/// target no other module can name (a private declaration, a local) keeps its
/// sites there. Otherwise the modules of the workspace that name it are loaded
/// beside the file, and its sites come from that wider project, where the
/// target is found again under the same cursor. The answer is kept until the
/// next edit, for a rename that follows a find-usages.
///
/// @param state    the server state.
/// @param uri      the document the request came from.
/// @param project  the document's typed project.
/// @param index    `project`'s references.
/// @param target   the named site under the cursor, from `index`.
/// @return         the sites, the declaration's and the implicit ones included.
export reference_sites :: fn(
    state: ServerState, uri: string, project: ProjectCache, index: ReferenceIndex, target: RefSite,
) -> RefSite[] {
    local :: sites_of(index, target.key)
    if target.key in index.confined {
        return local
    }
    kept :: state.usages
    if kept != null && kept.entry_path == project.entry_path && kept.key == target.key {
        return kept.sites
    }
    roots :: document_roots(state, uri) ?? return local
    name :: span_text(state, target.span)
    spelling :: import_spelling(index, target.key)
    extra :: modules_mentioning(state, roots.paths, name, spelling, project.module_name_index)
    if extra.len() == 0 {
        return local
    }
    wide :: state.check_with_modules(project.entry_path, extra)
    wide_index :: build_reference_index(wide.project, wide.result)
    at :: target.span.start
    again :: site_at(wide_index, at.file, at.line, at.column) ?? return local
    sites :: sites_of(wide_index, again.key)
    state.usages = UsagesCache {
        .entry_path = project.entry_path,
        .key        = target.key,
        .sites      = sites,
    }
    return sites
}

// The sites of `index` whose target is `key`.
sites_of :: fn(index: ReferenceIndex, key: i64) -> RefSite[] {
    out: RefSite[]: []
    for s in index.sites {
        if s.key == key {
            out.push(s)
        }
    }
    return out
}

// `"module"` as every import of the module exporting `key` spells it, or "" when
// a file may name the target without one : a member, reached through its type,
// or a prelude export.
import_spelling :: fn(index: ReferenceIndex, key: i64) -> string {
    module :: index.exports[key] ?? return ""
    if module == PRELUDE {
        return ""
    }
    return "\"" + module + "\""
}

// The source text `span` covers.
span_text :: fn(state: ServerState, span: Span) -> string =
    state.source_for_path(span.start.file).byte_slice(span.start.offset, span.end.offset)

/// The modules under `roots`, other than those of `loaded`, with a file that
/// mentions `name` as a whole word, and holds `spelling` too when it is not
/// empty. Each is named as an import names it, and counts only when the file
/// declares that module : a folder whose files declare another module (a test
/// fixture's `module "main"`) is no module an import can reach.
///
/// @param state     the server state, whose overlay is read before the disk.
/// @param roots     the roots the document's imports search, from `document_roots`.
/// @param name      the identifier to look for.
/// @param spelling  text a file must hold besides `name`, or "".
/// @param loaded    the modules already in the document's project, by name.
/// @return          the module names, each once, in walk order.
export modules_mentioning :: fn(
    state: ServerState, roots: IncludePath[], name: string, spelling: string,
    loaded: MutableMap<string, LoadedModule>,
) -> string[] {
    // A root nested in another (`lib/` under the project root) is walked as
    // itself, where its folders get their module names, and not again from
    // the outer root.
    root_dirs :: MutableSet<string> {}
    for root in roots {
        root_dirs.add(root.dir)
    }
    walk :: Walk {
        .state     = state,
        .name      = name,
        .spelling  = spelling,
        .loaded    = loaded,
        .root_dirs = root_dirs,
    }
    for root in roots {
        walk.folder(root, root.dir, "", 0)
    }
    out: string[]: []
    for module in walk.found {
        out.push(module)
    }
    return out
}

// One `modules_mentioning` search : what it looks for and what it found so far.
Walk :: struct {
    state:     ServerState
    name:      string
    spelling:  string
    loaded:    MutableMap<string, LoadedModule>
    /// The roots' folders, each walked from its own root only.
    root_dirs: MutableSet<string>
    /// The modules found, in walk order.
    found:     MutableSet<string> = MutableSet<string> {}
}

// Record the module of `dir` when one of its files names what the walk looks
// for, then walk its sub-folders. `rel` is `dir` relative to `root`, "" at the
// root.
folder :: fn(self: Walk, root: IncludePath, dir: string, rel: string, depth: i64) -> void {
    entries :: read_dir(dir)
    if entries is IOError {
        return
    }
    module :: module_for(root.prefix, rel)
    // Nothing to learn from a module the document's project already holds.
    searched := module.byte_len() == 0 || module in self.loaded || module in self.found
    for entry in entries {
        path :: join_path(dir, entry)
        if entry.ends_with(".vader") {
            if !searched && self.names_it(path, module) {
                searched = true
                self.found.add(module)
            }
            continue
        }
        // A file name carries an extension ; a module folder never does.
        if "." in entry || depth >= WALK_DEPTH_MAX || is_skipped_folder(entry, depth) || path in self.root_dirs {
            continue
        }
        if is_dir(path) {
            self.folder(root, path, join_path(rel, entry), depth + 1)
        }
    }
}

// Whether the file at `path`, in the folder `module` maps to, names what the
// walk looks for and declares that module.
names_it :: fn(self: Walk, path: string, module: string) -> bool {
    text :: self.state.source_for_path(path)
    if !mentions_word(text, self.name) || !(self.spelling in text) {
        return false
    }
    header :: parse_module_header(text, path) ?? return false
    return header.name == module
}

// The module name of a folder `rel` under a root whose namespace is `prefix`.
module_for :: fn(prefix: string, rel: string) -> string {
    if rel.byte_len() == 0 {
        return prefix
    }
    return join_path(prefix, rel)
}

// Whether a walk stays out of the folder `entry`, `depth` levels under its root:
// a hidden one anywhere, a dependency folder, and at the root the build output.
is_skipped_folder :: fn(entry: string, depth: i64) -> bool {
    if entry.starts_with(".") || entry == "node_modules" {
        return true
    }
    return depth == 0 && (entry == "build" || entry == "dist")
}

/// Whether `text` holds `name` with no identifier character on either side.
///
/// @param text  the text to search.
/// @param name  an identifier.
export mentions_word :: fn(text: string, name: string) -> bool {
    n :: name.byte_len()
    if n == 0 || n > text.byte_len() {
        return false
    }
    first :: name.byte_at(0)
    for i in 0..=(text.byte_len() - n) {
        if text.byte_at(i) != first || !text.matches_at(i, name) {
            continue
        }
        before_ok :: i == 0 || !is_word_byte(text.byte_at(i - 1))
        after_ok :: i + n == text.byte_len() || !is_word_byte(text.byte_at(i + n))
        if before_ok && after_ok {
            return true
        }
    }
    return false
}

// Whether `b` may sit inside an identifier : an ASCII identifier byte, or a byte
// of a non-ASCII character.
is_word_byte :: fn(b: u8) -> bool = is_ident_byte(b) || b >= 0x80

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_mentions_word_whole_words_only :: fn() -> void {
    assert(mentions_word("x :: Span {}", "Span"), "a whole word is found")
    assert(!mentions_word("x :: SpanSet {}", "Span"), "a prefix of a longer word is not")
    assert(!mentions_word("x :: my_Span", "Span"), "a suffix of a longer word is not")
    assert(mentions_word("Span", "Span"), "the whole text")
    assert(!mentions_word("", "Span"), "an empty text")
}

@test
test_module_for_prefix :: fn() -> void {
    assert_eq(module_for("", "vader/parser"), "vader/parser")
    assert_eq(module_for("main", "config"), "main/config")
    assert_eq(module_for("main", ""), "main")
}
