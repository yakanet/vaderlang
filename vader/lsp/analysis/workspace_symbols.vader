// vader/lsp/analysis/workspace_symbols: every declaration of the workspace, for
// `workspace/symbol`.
//
// The files of the modules under the workspace's roots are indexed once, and
// read again only when they change : the editor's "go to symbol" box searches on
// every keystroke, and a file on the disk is told unchanged by its modification
// time alone.

module "vader/lsp/analysis"

import "std/collections"
import "std/io"
import "std/sort"
import "std/string"
import "vader/lsp/protocol"
import "vader/parser"
import "vader/resolver"

/// A declaration of the workspace : a top-level one, or a member of a type.
export WorkspaceSymbol :: struct {
    name:   string
    /// The name in lowercase, which a lowercased query is compared with.
    folded: string
    kind:   DeclKind
    /// The type it belongs to, for a member ; "" otherwise.
    owner:  string
    module: string
    path:   string
    /// Its name's range, in the negotiated encoding.
    range:  SpanRange
}

/// The symbols of a file read from the disk, and its modification time then.
export FileSymbols :: struct {
    mtime:   i64
    symbols: WorkspaceSymbol[]
}

// A symbol and how well it matches a query : the lower, the better.
ScoredSymbol :: struct {
    symbol: WorkspaceSymbol
    score:  i32
}

/// The declarations of the workspace whose name matches `query`, best first :
/// the name itself as typed, then the name in another case, then a prefix, then
/// a part, then a prefix of each of its words in turn (`refsites` finds
/// `reference_sites`, `ArgKind` finds `IntrinsicArgKind`), case aside ; among
/// equals, a declaration before a member and a shorter name first.
///
/// @param state  the server state, which keeps each file's symbols.
/// @param query  what the user typed ; empty finds nothing.
/// @param limit  the most symbols returned.
export find_workspace_symbols :: fn(
    state: ServerState, query: string, limit: i64,
) -> WorkspaceSymbol[] {
    if query.byte_len() == 0 {
        return []
    }
    wanted :: query.to_lower()
    scored: ScoredSymbol[]: []
    kept :: MutableMap<string, FileSymbols> {}
    walk_module_folders(workspace_roots(state), (module: string, files: string[]) -> {
        for path in files {
            for s in file_symbols(state, kept, path, module) {
                score :: match_score(s.name, s.folded, query, wanted)
                if score >= 0 {
                    scored.push(ScoredSymbol { .symbol = s, .score = score })
                }
            }
        }
    })
    // A file the walk did not meet is gone, or out of the roots.
    state.symbols = kept
    ranked :: sort(scored, ranks_before)
    out: WorkspaceSymbol[]: []
    for r in ranked {
        if out.len() == limit {
            break
        }
        out.push(r.symbol)
    }
    return out
}

// Whether `a` ranks before `b`.
ranks_before :: fn(a: ScoredSymbol, b: ScoredSymbol) -> bool {
    if a.score != b.score {
        return a.score < b.score
    }
    a_member :: a.symbol.owner.byte_len() > 0
    if a_member != (b.symbol.owner.byte_len() > 0) {
        return !a_member
    }
    return a.symbol.name.byte_len() < b.symbol.name.byte_len()
}

// How `name` matches `query` : 0 the same, 1 the same in another case, then case
// aside 2 a prefix, 3 a part, 4 a prefix of each of its words in turn ; -1 no
// match. `folded` and `wanted` are `name` and `query` in lowercase.
match_score :: fn(name: string, folded: string, query: string, wanted: string) -> i32 {
    if name == query {
        return 0
    }
    if folded == wanted {
        return 1
    }
    if folded.starts_with(wanted) {
        return 2
    }
    if wanted in folded {
        return 3
    }
    if letters_in_order(folded, wanted) && words_match(words_of(name), 0, wanted, 0) {
        return 4
    }
    return -1
}

// Whether every byte of `query` appears in `name`, in order : a cheap test that
// rules most names out before `words_match`.
letters_in_order :: fn(name: string, query: string) -> bool {
    at: i64 = 0
    for i in 0..<name.byte_len() {
        if at == query.byte_len() {
            break
        }
        if name.byte_at(i) == query.byte_at(at) {
            at += 1
        }
    }
    return at == query.byte_len()
}

// The words of an identifier, lowercase : split at `_` and before an uppercase
// letter that follows a lowercase one (`IntrinsicArgKind`, `reference_sites`).
words_of :: fn(name: string) -> string[] {
    out: string[]: []
    start: i64 = 0
    for i in 0..<name.byte_len() {
        b :: name.byte_at(i)
        camel :: i > 0 && is_upper_byte(b) && is_lower_or_digit_byte(name.byte_at(i - 1))
        boundary :: b == '_' || camel
        if boundary {
            if i > start {
                out.push(name.byte_slice(start, i).to_lower())
            }
            start = word_start_after(b, i)
        }
    }
    if name.byte_len() > start {
        out.push(name.byte_slice(start, name.byte_len()).to_lower())
    }
    return out
}

// Where the next word starts after the boundary `b` at `i` : past an `_`, at an
// uppercase letter.
word_start_after :: fn(b: u8, i: i64) -> i64 {
    if b == '_' {
        return i + 1
    }
    return i
}

// Whether `b` is an ASCII uppercase letter.
is_upper_byte :: fn(b: u8) -> bool = b >= 'A' && b <= 'Z'

// Whether `b` is an ASCII lowercase letter or a digit : what may end a word
// before an uppercase letter starts the next.
is_lower_or_digit_byte :: fn(b: u8) -> bool = (b >= 'a' && b <= 'z') || (b >= '0' && b <= '9')

// Whether `query` from `at` is a prefix of a word of `words` from `from`, then
// the rest a prefix of a later word, and so on : `refsites` reads `ref` from
// `reference` and `sites` from `sites`.
words_match :: fn(words: string[], from: i64, query: string, at: i64) -> bool {
    if at == query.byte_len() {
        return true
    }
    for k in from..<words.len() {
        take := common_prefix(words[k], query, at)
        for take > 0 {
            if words_match(words, k + 1, query, at + take) {
                return true
            }
            take -= 1
        }
    }
    return false
}

// How many bytes `word` shares with `query` from `at`.
common_prefix :: fn(word: string, query: string, at: i64) -> i64 {
    n: i64 = 0
    for n < word.byte_len() && at + n < query.byte_len()
        && word.byte_at(n) == query.byte_at(at + n) {
        n += 1
    }
    return n
}

// The symbols of the file at `path`, of the folder `module` maps to : the open
// document's, from the index the server keeps for it, else the disk's, read again
// only when the file's modification time changed, and kept in `kept`. None when
// the file declares another module, such as a test fixture's `module "main"`.
file_symbols :: fn(
    state: ServerState, kept: MutableMap<string, FileSymbols>, path: string, module: string,
) -> WorkspaceSymbol[] {
    open :: state.index_for(path_to_uri(path))
    if open != null {
        return symbols_of(open, path, module)
    }
    mtime :: modification_time(path) ?? return []
    known :: state.symbols[path]
    if known != null && known.mtime == mtime {
        kept[path] = known
        return known.symbols
    }
    source :: read_file_string(path)
    if source is IOError {
        return []
    }
    symbols :: disk_symbols(state, path, source, module)
    kept[path] = FileSymbols { .mtime = mtime, .symbols = symbols }
    return symbols
}

// The declarations of `source`, the text of the file at `path` on the disk, when
// it declares `module` : the header is read first, so a file of another module is
// never indexed.
disk_symbols :: fn(
    state: ServerState, path: string, source: string, module: string,
) -> WorkspaceSymbol[] {
    header :: parse_module_header(source, path) ?? return []
    if header.name != module {
        return []
    }
    return symbols_of(build_index(path_to_uri(path), source, state.position_encoding), path, module)
}

// The top-level declarations and type members `idx` indexes, when its file
// declares `module`.
symbols_of :: fn(idx: DocIndex, path: string, module: string) -> WorkspaceSymbol[] {
    out: WorkspaceSymbol[]: []
    if idx.module != module {
        return out
    }
    for d in idx.decls {
        if d.scope_span != null {
            continue
        }
        out.push(WorkspaceSymbol {
            .name   = d.name,
            .folded = d.name.to_lower(),
            .kind   = d.kind,
            .owner  = d.owner,
            .module = module,
            .path   = path,
            .range  = d.name_span.span_to_range_json(idx.line_index),
        })
    }
    return out
}

// The roots of the workspace : those a file at its root would search.
workspace_roots :: fn(state: ServerState) -> IncludePath[] {
    root :: state.workspace_root
    if root.byte_len() == 0 {
        return []
    }
    roots :: document_roots(state, path_to_uri(join_path(root, "workspace.vader"))) ?? return []
    return roots.paths
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// `match_score` of `name` against `query`, both folded here.
score_of :: fn(name: string, query: string) -> i32 =
    match_score(name, name.to_lower(), query, query.to_lower())

@test
test_match_score_ranks_the_closest_match_first :: fn() -> void {
    assert_eq(score_of("Span", "Span"), 0)
    assert_eq(score_of("span", "Span"), 1)
    assert_eq(score_of("span_text", "span"), 2)
    assert_eq(score_of("decl_span", "span"), 3)
    assert_eq(score_of("reference_sites", "refsites"), 4)
    assert_eq(score_of("IntrinsicArgKind", "argkind"), 3)
    assert_eq(score_of("IntrinsicArgKind", "intargk"), 4)
    assert_eq(score_of("DeferBlockBody", "frob"), -1)
    assert_eq(score_of("span", "spot"), -1)
}
