// vader/lsp/analysis/driven: the projects a `build.vader` describes, as the
// server learns them.
//
// A driver is a program: only running it says which module search roots it
// declares. The server asks `vader info --json --no-driver-build`, its own
// executable, which describes a driver only if it is compiled as it stands: the
// server never starts a compile, which would race a `vader build` typed
// meanwhile over the same files in `build/driver/`. A driver not compiled yet
// waits for the user's own build: it rewrites the driver's stamp, and the next
// analysis of the project describes it again. The run is started without
// waiting and polled from the event loop (vader/lsp/main.vader). Until its first
// answer, the project's diagnostics are held back: every import of a root the
// driver declares would read as unresolved. Later runs leave the known roots in
// place until they answer. The answer goes to the loader
// (`register_project_roots`).

module "vader/lsp/analysis"

import "json"
import "std/collections"
import "std/io"
import "std/path"
import "std/process"
import "std/string"
import "vader/lsp/protocol"
import "vader/pipeline"
import "vader/resolver"

/// What the server knows of one project its `build.vader` describes.
export DrivenProject :: struct {
    /// What the last run described (`description_key`); empty before the first.
    described_key: string = ""
    /// Whether the user was told the driver needs a build, since its last
    /// description: a save of `build.vader` does not tell them again.
    warned:        bool = false
    /// The roots the last answer registered; null until the first one.
    roots:         string[] | null = null
    /// The `vader info` run in flight, its `spawn_start` handle.
    job:           i64 | null = null
}

/// Make sure the registered roots of the project `root` describe its
/// `build.vader` as it is on disk, starting a `vader info` run when they do not.
/// Nothing to do for a project its `vader.json` describes: the loader reads the
/// file itself.
///
/// @param self  the server state, which tracks the driven projects.
/// @param root  a project folder, as `project_of_document` names it.
/// @return      false while the project has no roots yet: its diagnostics wait.
export ensure_described :: fn(self: ServerState, root: string) -> bool {
    if exists(join_path(root, MANIFEST_FILENAME)) || !holds_build_driver(root) {
        return true
    }
    known :: self.driven.get_or_put_with(root, () -> DrivenProject {})
    key :: description_key(root)
    if known.job == null && known.described_key != key {
        known.described_key = key
        handle :: spawn_start([
            current_executable_location(),
            "info",
            "--json",
            "--no-driver-build",
            root,
        ])
        if handle < 0 {
            warn_undescribed(root, "`vader info` could not be started")
            settle(self, root, known, known.roots ?? [])
        } else {
            known.job = handle
        }
    }
    return known.roots != null
}

/// True while some `vader info` run is in flight: the event loop then polls
/// instead of blocking on the next message.
export is_describing_any :: fn(self: ServerState) -> bool {
    for [_, known] in self.driven {
        if known.job != null {
            return true
        }
    }
    return false
}

/// Collect every `vader info` run that finished and register the roots it
/// describes, or say why there are none. Never waits.
export poll_descriptions :: fn(self: ServerState) -> void {
    for [root, known] in self.driven {
        job :: known.job ?? continue
        finished :: spawn_finished(job, "vader info") ?? continue
        known.job = null
        answer :: description_of(finished)
        if finished is ProcessResult && finished.exit == DRIVER_NOT_COMPILED_EXIT {
            await_build(self, root, known)
        } else if answer is string {
            warn_undescribed(root, answer)
            // The roots known before stay: a `build.vader` being edited fails
            // often, and its last good answer serves better. A first failure
            // settles on none, so that diagnostics flow again.
            settle(self, root, known, known.roots ?? [])
        } else {
            known.warned = false
            settle(self, root, known, answer)
        }
        // A save that came during the run asks for another.
        _ :: ensure_described(self, root)
    }
}

// What a description of the project `root` depends on: its `build.vader`, and
// the stamp a compile of its driver rewrites. Either changing asks for another.
description_key :: fn(root: string) -> string {
    driver :: modified_at(join_path(root, DRIVER_FILENAME))
    compiled :: modified_at(driver_stamp_path(root))
    return "${driver}:${compiled}"
}

// The modification time of `path`, 0 when it cannot be read.
modified_at :: fn(path: string) -> i64 {
    stamp :: modification_time(path)
    if stamp is IOError {
        return 0
    }
    return stamp
}

// The driver of the project `root` is not compiled as it stands: the roots known
// stay, or none for a first run, so that diagnostics flow, and the user is told
// once that a build lets the editor see the driver's roots.
await_build :: fn(self: ServerState, root: string, known: DrivenProject) -> void {
    settle(self, root, known, known.roots ?? [])
    if known.warned {
        return
    }
    known.warned = true
    show_warning("vader: the editor reads the search roots of `${root}/${DRIVER_FILENAME}` once its "
        + "driver is compiled; `vader build` compiles it")
}

// The search roots a finished `vader info --json` run reports, or why it
// reports none.
description_of :: fn(finished: ProcessResult | ProcessError) -> string[] | string {
    if finished is ProcessError {
        return finished.msg
    }
    if finished.exit != 0 {
        return finished.stderr.trim()
    }
    if parse(finished.stdout) !is JsonObject {
        return "`vader info --json` printed no report"
    }
    return parse_manifest(finished.stdout).include_paths
}

// Tell the user the project `root` could not be described: the first line of
// `why` in the editor, all of it (a whole driver build's diagnostics, maybe) in
// the server's log.
warn_undescribed :: fn(root: string, why: string) -> void {
    log_warn("vader: cannot describe the project `${root}`:\n${why}")
    show_warning("vader: cannot describe the project `${root}`: ${why.split("\n")[0]} "
        + "(the server log has the rest)")
}

// Take `roots` as the project's. When they differ from the ones its documents
// were analysed with, register them, forget those analyses and mark the open
// documents for the next diagnostics flush.
settle :: fn(self: ServerState, root: string, known: DrivenProject, roots: string[]) -> void {
    before :: known.roots
    known.roots = roots
    if before != null && before.content_equals(roots) {
        return
    }
    register_project_roots(root, roots)
    forget_project_analyses(self, root)
    for [uri, _] in self.docs {
        if is_inside(uri_to_path(uri), root) {
            self.dirty[uri] = true
        }
    }
}

// Forget the analyses whose entry sits inside the project `root`: they saw
// other roots. Another project's stay.
forget_project_analyses :: fn(self: ServerState, root: string) -> void {
    if self.cache != null && is_inside(self.cache.entry_path, root) {
        self.cache = null
    }
    if self.cache_prev != null && is_inside(self.cache_prev.entry_path, root) {
        self.cache_prev = null
    }
    if self.union_cache != null && is_inside(self.union_cache.entry_path, root) {
        self.union_cache = null
    }
    if self.usages != null && is_inside(self.usages.entry_path, root) {
        self.usages = null
    }
}

// Whether the file `path` sits inside the folder `root`.
is_inside :: fn(path: string, root: string) -> bool =
    Path(path.to_posix()).starts_with(Path(root.to_posix()))

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_is_inside_stops_at_a_segment_boundary :: fn() -> void {
    assert(is_inside("/work/game/src/main.vader", "/work/game"), "a file of the project")
    assert(!is_inside("/work/gameplay/main.vader", "/work/game"), "a sibling with a longer name")
}
