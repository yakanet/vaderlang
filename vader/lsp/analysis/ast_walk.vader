// vader/lsp/analysis/ast_walk — cursor-driven AST position finders.
//
// Shared "what AST node is under the cursor" traversals, factored out of the
// individual handlers so hover, typeDefinition, signatureHelp — and the
// completion / code-action layers — all descend the tree the same way :
//
//   - `enclosing_exprs`         : the full containing-expression chain, innermost
//                                 first (code actions). The base traversal that
//                                 `find_enclosing_call` filters.
//   - `find_enclosing_call`     : the innermost `CallExpr` containing the cursor
//                                 (signatureHelp) — a thin filter over
//                                 `enclosing_exprs`.
//   - `find_expr_at`            : the smallest *typed* expression at a position
//                                 (hover, typeDefinition, completion receiver).
//   - `find_binding_rhs_type_at`: the inferred type of a `let` / `::` binding
//                                 whose *name* the cursor sits on (hover).
//
// These are position-targeted descents over the same Decl/Stmt/Expr shape and
// share the `span_contains` / `span_size` geometry from `protocol/position`
// (smallest-span-wins). Positions are 1-based, matching the AST `Span`.

module "vader/lsp/analysis"

import "vader/types"
import "vader/typecheck"
import "vader/lsp/protocol"
AST :: import "toolchain/ast"

// ---- smallest typed expression at a position ------------------------------

/// Walk every fn body in `decls` looking for the smallest expression whose
/// span contains `(line, col)` AND has a `typed.expr_types` entry. Returns the
/// matching `AST.Expr`, or `null` on miss. Smallest match wins so hovering on
/// `x` in `f(x + y)` returns `x`, not the whole `f(...)` call.
///
/// @param decls  the file's top-level declarations to descend.
/// @param line   1-based cursor line.
/// @param col    1-based cursor column.
/// @param typed  the typed program (a node only matches if it carries a type).
/// @return       the innermost typed expression at the cursor, or `null`.
export find_expr_at :: fn(
    decls: AST.Decl[], line: i32, col: i32, typed: TypedProgram,
) -> AST.Expr | null = find_expr_with_mode(decls, line, col, .SmallestContaining, typed)

/// The receiver expression of a member access whose `.` sits at 1-based
/// `(line, dot_col)` — the outermost typed expression that *ends* exactly where
/// the dot begins. Spans encode `end` as one-past-the-last-char, so the receiver
/// of `recv.field` ends at the dot.
///
/// Anchors on the end column rather than "smallest node containing the column
/// just left of the dot" : that positional query mis-resolves a call receiver
/// (`f(a, b).m`) to its last argument, whose exclusive-end column overlaps the
/// closing `)`. The largest node ending at the dot is the call itself. Returns
/// `null` when nothing typed ends there (whitespace before the dot, an untyped
/// receiver) — callers fall back to a positional lookup.
///
/// @param decls    the file's top-level declarations to descend.
/// @param line     1-based line of the dot.
/// @param dot_col  1-based column of the dot ; the receiver ends here.
/// @param typed    the typed program (a node only matches if it carries a type).
/// @return         the receiver expression, or `null`.
export find_receiver_before_dot :: fn(
    decls: AST.Decl[], line: i32, dot_col: i32, typed: TypedProgram,
) -> AST.Expr | null = find_expr_with_mode(decls, line, dot_col, .EndsAt, typed)

// Selection rule for the shared walker : `SmallestContaining` keeps the
// innermost node over the cursor (hover / typeDefinition) ; `EndsAt` keeps the
// outermost node ending at `(line, col)` (completion receiver).
FindMode :: enum(u8) {
    SmallestContaining,
    EndsAt,
}

FindState :: struct {
    line:      i32
    col:       i32
    mode:      FindMode
    best:      AST.Expr | null
    best_size: u64
}

// Shared driver behind `find_expr_at` / `find_receiver_before_dot` : descends
// every fn body in `decls`, accumulating the best node under `mode` (see
// `hv_consider`).
find_expr_with_mode :: fn(
    decls: AST.Decl[], line: i32, col: i32, mode: FindMode, typed: TypedProgram,
) -> AST.Expr | null {
    state :: FindState { .line = line, .col = col, .mode = mode, .best = null, .best_size = 0 }
    for d in decls { hv_walk_decl(d, typed, state) }
    return state.best
}

hv_walk_decl :: fn(d: AST.Decl, typed: TypedProgram, st: FindState!) -> void {
    // A position walk maps a cursor to a fn body; these hold none.
    if d is AST.ImportDecl | AST.StructDecl | AST.EnumDecl | AST.TraitDecl
         | AST.TypeAliasDecl | AST.AssertDecl {
        return
    }
    match d {
        is AST.FnDecl -> {
            match d.body as b {
                is null          -> {}
                is AST.BlockExpr -> { hv_walk_block(b, typed, st) }
            }
        }
        is AST.ImplDecl -> {
            for m in d.members {
                match m.body as b {
                    is null          -> {}
                    is AST.BlockExpr -> { hv_walk_block(b, typed, st) }
                }
            }
        }
        is AST.ConstDecl -> { hv_walk_expr(d.value, typed, st) }
    }
}

hv_walk_block :: fn(b: AST.BlockExpr, typed: TypedProgram, st: FindState!) -> void {
    for s in b.stmts { hv_walk_stmt(s, typed, st) }
    if b.trailing !is null {
        hv_walk_expr(b.trailing, typed, st)
    }
}

hv_walk_stmt :: fn(s: AST.Stmt, typed: TypedProgram, st: FindState!) -> void {
    match s {
        is AST.LetStmt -> { hv_walk_expr(s.value, typed, st) }
        is AST.ExprStmt -> { hv_walk_expr(s.expr, typed, st) }
        is AST.ReturnStmt -> {
            if s.value !is null {
                hv_walk_expr(s.value, typed, st)
            }
        }
        is AST.YieldStmt -> { hv_walk_expr(s.value, typed, st) }
        is AST.AssignStmt -> {
            hv_walk_expr(s.target, typed, st)
            hv_walk_expr(s.value, typed, st)
        }
        is AST.ForStmt -> {
            match s.form as w {
                is AST.WhileFor    -> { hv_walk_expr(w.cond, typed, st) }
                is AST.InFor       -> { hv_walk_expr(w.iter, typed, st) }
                is AST.InfiniteFor -> {}
            }
            hv_walk_block(s.body, typed, st)
        }
        is AST.BreakStmt -> {}
        is AST.ContinueStmt -> {}
        is AST.DeferStmt -> {
            match s.body as dsb {
                is AST.DeferStmtBody  -> { hv_walk_stmt(dsb.stmt, typed, st) }
                is AST.DeferBlockBody -> { hv_walk_block(dsb.block, typed, st) }
            }
        }
    }
}

hv_walk_expr :: fn(e: AST.Expr, typed: TypedProgram, st: FindState!) -> void {
    hv_consider(e, typed, st)
    // Already considered above, and no child carries an independent span.
    if e is AST.IntLitExpr | AST.FloatLitExpr | AST.BoolLitExpr | AST.NullLitExpr
         | AST.CharLitExpr | AST.IdentExpr | AST.DotVariantExpr | AST.FnTypeExpr
         | AST.ArrayTypeExpr | AST.MutableTypeExpr {
        return
    }
    match e {
        is AST.CallExpr -> {
            hv_walk_expr(e.callee, typed, st)
            for a in e.args { hv_walk_expr(a.value, typed, st) }
        }
        is AST.FieldExpr -> { hv_walk_expr(e.target, typed, st) }
        is AST.IndexExpr -> {
            hv_walk_expr(e.target, typed, st)
            hv_walk_expr(e.index, typed, st)
        }
        is AST.UnaryExpr -> { hv_walk_expr(e.operand, typed, st) }
        is AST.BinaryExpr -> {
            hv_walk_expr(e.left, typed, st)
            hv_walk_expr(e.right, typed, st)
        }
        is AST.IfExpr -> {
            hv_walk_expr(e.cond, typed, st)
            hv_walk_block(e.then_block, typed, st)
            match e.else_branch as ei {
                is null            -> {}
                is AST.IfElseIf    -> { hv_walk_expr(ei.branch, typed, st) }
                is AST.IfElseBlock -> { hv_walk_block(ei.block, typed, st) }
            }
        }
        is AST.MatchExpr -> {
            hv_walk_expr(e.scrutinee, typed, st)
            for arm in e.arms {
                if arm.guard !is null {
                    hv_walk_expr(arm.guard, typed, st)
                }
                hv_walk_expr(arm.body, typed, st)
            }
        }
        is AST.BlockExpr -> { hv_walk_block(e, typed, st) }
        is AST.LambdaExpr -> { hv_walk_block(e.body, typed, st) }
        is AST.StructLitExpr -> {
            hv_walk_expr(e.type_name, typed, st)
            for item in e.items {
                match item {
                    is AST.StructLitField  -> { hv_walk_expr(item.value, typed, st) }
                    is AST.StructLitSpread -> { hv_walk_expr(item.expr, typed, st) }
                }
            }
        }
        is AST.SeqLitExpr -> {
            for el in e.elements { hv_walk_expr(el, typed, st) }
        }
        is AST.CastExpr -> { hv_walk_expr(e.value, typed, st) }
        is AST.AwaitExpr -> { hv_walk_expr(e.inner, typed, st) }
        is AST.GenericInstExpr -> {
            hv_walk_expr(e.callee, typed, st)
            for ta in e.type_args { hv_walk_expr(ta, typed, st) }
        }
        is AST.IntrinsicCallExpr -> {
            for a in e.args { hv_walk_expr(a, typed, st) }
        }
        // These three were listed as LEAVES and are not. Each carries child
        // expressions with their own spans, and a cursor inside one reached
        // nothing — invisible for as long as members were also findable by
        // name, because the name search covered for the walk. Removing that
        // fallback took the cover away and four correct answers with it.
        //
        // Surface in this tree: 306 range bounds holding a member access, 46
        // left operands of `??`, 828 interpolations.
        is AST.RangeExpr -> {
            hv_walk_expr(e.lower, typed, st)
            hv_walk_expr(e.upper, typed, st)
        }
        is AST.NullCoalesceExpr -> {
            hv_walk_expr(e.left, typed, st)
            fb :: AST.coalesce_fallback_expr(e.fallback)
            if fb != null {
                hv_walk_expr(fb, typed, st)
            }
        }
        is AST.StringLitExpr -> {
            for part in e.parts {
                if part is AST.StringLitInterp {
                    hv_walk_expr(part.expr, typed, st)
                }
            }
        }
    }
}

hv_consider :: fn(e: AST.Expr, typed: TypedProgram, st: FindState!) -> void {
    // Skip until we have a type entry — no point reporting a node whose hover
    // would show `?`, nor resolving a receiver the typed cache can't type.
    if typed.expr_types[e.id] is null { return }
    sp :: e.span
    if st.mode == .EndsAt {
        // Outermost node ending exactly at the dot — the member-access receiver.
        if sp.end.line != st.line || sp.end.column != st.col { return }
        size :: span_size(sp)
        if st.best is null || size > st.best_size {
            st.best = e
            st.best_size = size
        }
        return
    }
    // SmallestContaining : innermost node over the cursor.
    if !span_contains(sp, st.line, st.col) { return }
    size :: span_size(sp)
    if st.best is null || size < st.best_size {
        st.best = e
        st.best_size = size
    }
}

// ---- inferred type of the binding whose name is under the cursor ----------

/// When `(line, col)` falls inside a `let` / `::` binding name, return the RHS
/// expression's inferred type. Returns `null` for any other cursor context.
///
/// @param decls  the file's top-level declarations to descend.
/// @param line   1-based cursor line.
/// @param col    1-based cursor column.
/// @param typed  the typed program — `expr_types` for a single name,
///               `local_types` for a destructuring slot.
/// @return       the binding's inferred type, or `null`.
export find_binding_rhs_type_at :: fn(
    decls: AST.Decl[], line: i32, col: i32, typed: TypedProgram,
) -> Type | null {
    state :: FindBindingState { .line = line, .col = col, .ty = null }
    for d in decls { binding_hv_walk_decl(d, typed, state) }
    return state.ty
}

FindBindingState :: struct {
    line: i32
    col:  i32
    ty:   Type | null
}

binding_hv_walk_decl :: fn(d: AST.Decl, typed: TypedProgram, st: FindBindingState!) -> void {
    // `ConstDecl` joins them: its value is an expression, not a binding site.
    if d is AST.ImportDecl | AST.StructDecl | AST.EnumDecl | AST.TraitDecl
         | AST.TypeAliasDecl | AST.AssertDecl | AST.ConstDecl {
        return
    }
    match d {
        is AST.FnDecl -> {
            match d.body as b {
                is null          -> {}
                is AST.BlockExpr -> { binding_hv_walk_block(b, typed, st) }
            }
        }
        is AST.ImplDecl -> {
            for m in d.members {
                match m.body as b {
                    is null          -> {}
                    is AST.BlockExpr -> { binding_hv_walk_block(b, typed, st) }
                }
            }
        }
    }
}

binding_hv_walk_block :: fn(b: AST.BlockExpr, typed: TypedProgram, st: FindBindingState!) -> void {
    for s in b.stmts { binding_hv_walk_stmt(s, typed, st) }
    if b.trailing !is null {
        binding_hv_walk_expr(b.trailing, typed, st)
    }
}

binding_hv_walk_stmt :: fn(s: AST.Stmt, typed: TypedProgram, st: FindBindingState!) -> void {
    // No sub-statement and no binding of their own.
    if s is AST.AssignStmt | AST.BreakStmt | AST.ContinueStmt {
        return
    }
    match s {
        is AST.LetStmt -> {
            ty :: binding_type_at(s.binding, s.value, typed, st.line, st.col)
            if ty != null {
                st.ty = ty
                return
            }
            binding_hv_walk_expr(s.value, typed, st)
        }
        is AST.ExprStmt -> { binding_hv_walk_expr(s.expr, typed, st) }
        is AST.YieldStmt -> { binding_hv_walk_expr(s.value, typed, st) }
        is AST.ReturnStmt -> {
            if s.value !is null {
                binding_hv_walk_expr(s.value, typed, st)
            }
        }
        is AST.ForStmt -> { binding_hv_walk_block(s.body, typed, st) }
        is AST.DeferStmt -> {
            match s.body as dsb {
                is AST.DeferStmtBody  -> { binding_hv_walk_stmt(dsb.stmt, typed, st) }
                is AST.DeferBlockBody -> { binding_hv_walk_block(dsb.block, typed, st) }
            }
        }
    }
}

/// Type of the binding under the cursor in a `let`, or `null` when the cursor is
/// not on a bound name.
///
/// A single name reports the INITIALIZER's inferred type, which is the whole
/// point of this walk — `hover.vader` wants `origin: ? | null :: span_at(…)` to
/// surface what the typechecker resolved, not the `?` the user wrote.
/// `local_types` holds the DECLARED type, so it is only right where there is no
/// single initializer to read: a destructuring slot.
binding_type_at :: fn(
    b: AST.LetBinding, value: AST.Expr, typed: TypedProgram, line: i32, col: i32,
) -> Type | null {
    match b {
        is AST.SimpleBinding -> {
            if span_contains(b.name_span, line, col) {
                return typed.expr_types[value.id]
            }
        }
        is AST.RestBinding -> {
            // Keyed by the whole span, not `name_span` — `assign_binding_types`
            // writes it so, and the `...` makes the two start at different columns.
            if span_contains(b.name_span, line, col) {
                return typed.local_types[b.span.hash()]
            }
        }
        is AST.TupleBinding -> {
            for element in b.elements {
                found :: binding_type_at(element, value, typed, line, col)
                if found != null {
                    return found
                }
            }
        }
        // `_ :: e` binds no name to hover.
        is AST.WildcardBinding -> {}
    }
    return null
}

binding_hv_walk_expr :: fn(e: AST.Expr, typed: TypedProgram, st: FindBindingState!) -> void {
    // Only the block-bearing forms reachable DIRECTLY. A binding inside a lambda
    // passed as a call argument is not found — pre-existing gap, not a design.
    //
    // The list is spelled out rather than aliased on purpose: it is what makes
    // the match below exhaustive, so a new `Expr` variant stops here.
    if e is AST.IntLitExpr | AST.FloatLitExpr | AST.BoolLitExpr | AST.NullLitExpr
         | AST.CharLitExpr | AST.StringLitExpr | AST.IdentExpr | AST.CallExpr
         | AST.FieldExpr | AST.IndexExpr | AST.UnaryExpr | AST.BinaryExpr
         | AST.NullCoalesceExpr | AST.StructLitExpr | AST.SeqLitExpr
         | AST.RangeExpr | AST.CastExpr | AST.GenericInstExpr
         | AST.IntrinsicCallExpr | AST.DotVariantExpr | AST.FnTypeExpr
         | AST.ArrayTypeExpr | AST.MutableTypeExpr | AST.AwaitExpr {
        return
    }
    match e {
        is AST.BlockExpr -> { binding_hv_walk_block(e, typed, st) }
        is AST.IfExpr -> {
            binding_hv_walk_block(e.then_block, typed, st)
            match e.else_branch as ei {
                is null            -> {}
                is AST.IfElseIf    -> { binding_hv_walk_expr(ei.branch, typed, st) }
                is AST.IfElseBlock -> { binding_hv_walk_block(ei.block, typed, st) }
            }
        }
        is AST.MatchExpr -> {
            for arm in e.arms { binding_hv_walk_expr(arm.body, typed, st) }
        }
        is AST.LambdaExpr -> { binding_hv_walk_block(e.body, typed, st) }
    }
}

// ---- innermost enclosing call --------------------------------------------

/// The innermost `CallExpr` whose span contains `(line, col)`, or `null`.
/// "Innermost" matters for nested calls like `f(g(|))` — we want `g` when the
/// cursor is between its parens, not the outer `f`.
///
/// A thin filter over `enclosing_exprs`, which already yields the containing
/// chain innermost-first : the first `CallExpr` in that chain is the smallest
/// call span over the cursor. Sharing the one traversal keeps the call walker
/// (signatureHelp) and the code-action walker from drifting apart.
///
/// @param decls  the file's top-level declarations to descend.
/// @param line   1-based cursor line.
/// @param col    1-based cursor column.
/// @return       the innermost enclosing `AST.CallExpr`, or `null`.
export find_enclosing_call :: fn(
    decls: AST.Decl[], line: i32, col: i32,
) -> AST.CallExpr | null {
    chain :: enclosing_exprs(decls, line, col)
    // Index loop (not `for x in arr`) sidesteps the for-in iterator
    // materialisation gap (GATE B1) over the erased `AST.Expr[]` element type.
    for i in 0..<chain.len() {
        e :: chain[i]
        if e is AST.CallExpr { return e }
    }
    return null
}

// ---- enclosing expression chain -------------------------------------------

/// Every expression whose span contains `(line, col)`, innermost first. The
/// code-action layer walks this chain to find the node a given action targets
/// (the enclosing match for match→if, the enclosing if for if→match, …) without
/// a per-node-kind walker. 1-based coords.
///
/// @param decls  the file's top-level declarations to descend.
/// @param line   1-based cursor line.
/// @param col    1-based cursor column.
/// @return       the containing expressions, innermost (smallest span) first.
export enclosing_exprs :: fn(decls: AST.Decl[], line: i32, col: i32) -> AST.Expr[] {
    acc: AST.Expr[]!: []
    st :: EncloseState { .line = line, .col = col, .acc = acc }
    for d in decls { ee_walk_decl(d, st) }
    return st.acc
}

EncloseState :: struct {
    line: i32
    col:  i32
    acc:  AST.Expr[]!
}

ee_walk_decl :: fn(d: AST.Decl, st: EncloseState!) -> void {
    // A position walk maps a cursor to a fn body; these hold none.
    if d is AST.ImportDecl | AST.StructDecl | AST.EnumDecl | AST.TraitDecl
         | AST.TypeAliasDecl | AST.AssertDecl {
        return
    }
    match d {
        is AST.FnDecl -> {
            match d.body as b {
                is null          -> {}
                is AST.BlockExpr -> { ee_walk_block(b, st) }
            }
        }
        is AST.ImplDecl -> {
            for m in d.members {
                match m.body as b {
                    is null          -> {}
                    is AST.BlockExpr -> { ee_walk_block(b, st) }
                }
            }
        }
        is AST.ConstDecl -> { ee_walk_expr(d.value, st) }
    }
}

ee_walk_block :: fn(b: AST.BlockExpr, st: EncloseState!) -> void {
    for s in b.stmts { ee_walk_stmt(s, st) }
    if b.trailing !is null {
        ee_walk_expr(b.trailing, st)
    }
}

ee_walk_stmt :: fn(s: AST.Stmt, st: EncloseState!) -> void {
    match s {
        is AST.LetStmt -> { ee_walk_expr(s.value, st) }
        is AST.ExprStmt -> { ee_walk_expr(s.expr, st) }
        is AST.ReturnStmt -> {
            if s.value !is null {
                ee_walk_expr(s.value, st)
            }
        }
        is AST.YieldStmt -> { ee_walk_expr(s.value, st) }
        is AST.AssignStmt -> {
            ee_walk_expr(s.target, st)
            ee_walk_expr(s.value, st)
        }
        is AST.ForStmt -> {
            match s.form as w {
                is AST.WhileFor    -> { ee_walk_expr(w.cond, st) }
                is AST.InFor       -> { ee_walk_expr(w.iter, st) }
                is AST.InfiniteFor -> {}
            }
            ee_walk_block(s.body, st)
        }
        is AST.BreakStmt -> {}
        is AST.ContinueStmt -> {}
        is AST.DeferStmt -> {
            match s.body as dsb {
                is AST.DeferStmtBody  -> { ee_walk_stmt(dsb.stmt, st) }
                is AST.DeferBlockBody -> { ee_walk_block(dsb.block, st) }
            }
        }
    }
}

// Recurse into children FIRST, then record `e` — post-order push yields an
// innermost-first chain (a child is appended before its parent).
ee_walk_expr :: fn(e: AST.Expr, st: EncloseState!) -> void {
    match e {
        is AST.CallExpr -> {
            ee_walk_expr(e.callee, st)
            for a in e.args { ee_walk_expr(a.value, st) }
        }
        is AST.FieldExpr -> { ee_walk_expr(e.target, st) }
        is AST.IndexExpr -> {
            ee_walk_expr(e.target, st)
            ee_walk_expr(e.index, st)
        }
        is AST.UnaryExpr -> { ee_walk_expr(e.operand, st) }
        is AST.BinaryExpr -> {
            ee_walk_expr(e.left, st)
            ee_walk_expr(e.right, st)
        }
        is AST.IfExpr -> {
            ee_walk_expr(e.cond, st)
            ee_walk_block(e.then_block, st)
            match e.else_branch as ei {
                is null            -> {}
                is AST.IfElseIf    -> { ee_walk_expr(ei.branch, st) }
                is AST.IfElseBlock -> { ee_walk_block(ei.block, st) }
            }
        }
        is AST.MatchExpr -> {
            ee_walk_expr(e.scrutinee, st)
            for arm in e.arms {
                if arm.guard !is null {
                    ee_walk_expr(arm.guard, st)
                }
                ee_walk_expr(arm.body, st)
            }
        }
        is AST.BlockExpr -> { ee_walk_block(e, st) }
        is AST.LambdaExpr -> { ee_walk_block(e.body, st) }
        is AST.StructLitExpr -> {
            ee_walk_expr(e.type_name, st)
            for item in e.items {
                match item {
                    is AST.StructLitField  -> { ee_walk_expr(item.value, st) }
                    is AST.StructLitSpread -> { ee_walk_expr(item.expr, st) }
                }
            }
        }
        is AST.SeqLitExpr -> {
            for el in e.elements { ee_walk_expr(el, st) }
        }
        is AST.CastExpr -> { ee_walk_expr(e.value, st) }
        is AST.AwaitExpr -> { ee_walk_expr(e.inner, st) }
        is AST.IntrinsicCallExpr -> {
            for a in e.args { ee_walk_expr(a, st) }
        }
        is AST.StringLitExpr -> {
            for part in e.parts {
                if part is AST.StringLitInterp {
                    ee_walk_expr(part.expr, st)
                }
            }
        }
        is AST.NullCoalesceExpr -> {
            ee_walk_expr(e.left, st)
            fallback :: AST.coalesce_fallback_expr(e.fallback)
            if fallback != null {
                ee_walk_expr(fallback, st)
            }
        }
        is AST.RangeExpr -> {
            ee_walk_expr(e.lower, st)
            ee_walk_expr(e.upper, st)
        }
        is AST.GenericInstExpr -> {
            ee_walk_expr(e.callee, st)
            for ta in e.type_args { ee_walk_expr(ta, st) }
        }
        // An arm, not an early `return`: `e` itself is pushed below the match.
        is AST.IntLitExpr | AST.FloatLitExpr | AST.BoolLitExpr | AST.NullLitExpr
         | AST.CharLitExpr | AST.IdentExpr | AST.DotVariantExpr | AST.FnTypeExpr
         | AST.ArrayTypeExpr | AST.MutableTypeExpr -> {}
    }
    if span_contains(e.span, st.line, st.col) { st.acc.push(e) }
}
