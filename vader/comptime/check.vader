// vader/comptime/check — comptime orchestrator entry point.
//
// Drives the tree-walk evaluator over every module's `@comptime const`
// decls in topological order, accumulating values into
// `EvaluatedProgram.comptime_decls` keyed by Symbol id, and harvests the
// concrete generic-instance set (`instances`) the lowerer materialises.

module "vader/comptime"

import "std/collections"
import "vader/diagnostics"
import "vader/types"
import "vader/resolver/symbol"
import "vader/resolver"
import "vader/typecheck"
AST :: import "toolchain/ast"

/// Evaluate every `@comptime` decl across the project's typed view,
/// harvest the generic-instance set, and return the cross-module evaluated AST.
/// Takes both `LoadedProject` (for the source decls) and `TypedProject`
/// (for the typed view) because the resolver doesn't carry decls onto
/// `ResolvedModule` ; later passes always re-derive from the loaded
/// program. Mirrors how `check_project_with_bodies` works.
/// @param loaded  the loaded project (for source decls per module).
/// @param typed   the typed project (for typecheck side-tables).
/// @param diags   diagnostics emitted during evaluation (cycle, assert,
///                type-mismatch, vm-required).
/// @return        the evaluated project, ready to feed the dumper.
export evaluate_project :: fn(
    loaded: LoadedProject, typed: TypedProject, diags: Diagnostic[],
) -> EvaluatedProject {
    project :: new_evaluated_project(typed)
    for [module_id, module_typed] in typed.modules {
        program :: new_evaluated_program(module_typed)
        decls :: lookup_module_decls(loaded, module_id)
        if decls !is null {
            evaluate_module_decls(decls, module_typed, program, project, module_id, diags)
            // After the consts are baked : an `@assert` may reference one, and an
            // unresolved ident would leave it unevaluated.
            evaluate_assert_decls(decls, program, diags)
            bake_file_exprs(decls, project, program)
        }
        project.modules[module_id] = program
    }
    // `instances` is the concrete generic-instance set the lowerer's
    // struct path materialises (`lower_mono_struct`). The lowerer is the
    // authoritative monomorphizer — there is no separate comptime mono pass.
    project.instances = harvest_instances(typed, loaded.entry)
    return project
}

// Walk every typed module's expr / decl / param / local type tables
// and register each generic instance. The for-in / Into / fn-call passes
// are not handled yet (those land alongside the
// lowerer port when their downstream consumers exist).
harvest_instances :: fn(typed: TypedProject, entry: string) -> GenericInstance[] {
    registry :: InstanceRegistry {}
    for [_, module_typed] in typed.modules {
        for [_, t] in module_typed.decl_types {
            observe(registry, t)
        }
        for [_, t] in module_typed.expr_types {
            observe(registry, t)
        }
        for [_, t] in module_typed.local_types {
            observe(registry, t)
        }
        for [_, t] in module_typed.param_types {
            observe(registry, t)
        }
        for [_, t] in module_typed.type_expr_types {
            observe(registry, t)
        }
        // Impl-method types live in `impl_methods` (mangled-name keyed, read
        // below) and `impl_method_decl_types` (span-keyed), not `decl_types`
        // (Symbol.id-keyed — impl methods aren't in `resolved.symbols`).
        for [_, t] in module_typed.impl_method_decl_types {
            observe(registry, t)
        }
    }
    // Every module reads the same impl tables : their members are observed once,
    // through the entry's.
    entry_typed :: typed.modules[entry]
    if entry_typed != null {
        for [_, members] in entry_typed.impl_tables.impl_methods {
            for im in members {
                observe(registry, im.ty)
            }
        }
    }
    return sorted_instances(registry)
}

// Concatenate the decls of EVERY file in the module (a module may span several
// files of one folder — `discover.vader` merges them). A `files[0]`-only read
// drops a 2nd file's decls, so the comptime const-bake never folds a const
// living there (e.g. a std/core formatter table moved to a sibling file) and its
// readers emit an unreachable. Mirrors `lower.vader::module_decls`.
lookup_module_decls :: fn(loaded: LoadedProject, module_id: string) -> AST.Decl[] | null {
    module_loaded :: loaded.modules[module_id] ?? return null
    files :: module_loaded.module.files
    if files.len() == 0 { return null }
    return concat_file_decls(files)
}

evaluate_module_decls :: fn(
    decls: AST.Decl[], typed: TypedProgram, program: EvaluatedProgram,
    project: EvaluatedProject, module_id: string, diags: Diagnostic[],
) -> void {
    order :: sort_comptime_decls(decls, typed)
    for diagnostic in order.cycle_diags { diags.push(diagnostic) }
    context :: ComptimeContext {
        .typed    = typed,
        .bindings = program.comptime_decls,
    }
    for decl in order.order {
        result :: evaluate_expr(decl.value, context)
        // The tree-walk gave up on a VM-evaluable shape (loop / mutation /
        // statement-bodied callee). Record the decl for the `comptime_vm` VM
        // pass (run from bootstrap, where `evaluated` is complete) and suppress
        // the C4001 — unless the RHS isn't a stageable nullary call, in which
        // case the diagnostic stands.
        if result.vm_required {
            symbol :: symbol_declared_at(typed.resolved, decl.name_span)
            if symbol != null {
                record :: build_vm_required(decl, symbol, typed, module_id)
                if record is VmRequiredDecl {
                    project.vm_required.push(record)
                    continue
                }
            }
            if !(result.diag is null) { diags.push(result.diag) }
            continue
        }
        value :: result.value
        if value !is null {
            symbol :: symbol_declared_at(typed.resolved, decl.name_span)
            if symbol != null {
                program.comptime_decls[symbol.id] = value
                program.routes[symbol.id] = .Marked
            }
        }
        if result.diag !is null {
            diags.push(result.diag)
        }
    }
    // Second pass : best-effort fold of plain consts (no `@comptime`
    // decorator). Successful folds populate `comptime_decls` so the
    // lowerer can inline scalar use sites. Failures are silently
    // swallowed — these decls don't promise comptime evaluability.
    for decl in decls {
        if decl is AST.ConstDecl {
            if has_comptime_decorator(decl) {
                continue
            }
            symbol :: symbol_declared_at(typed.resolved, decl.name_span) ?? continue
            if program.comptime_decls[symbol.id] !is null {
                continue
            }
            result :: evaluate_expr(decl.value, context)
            if result.value !is null {
                program.comptime_decls[symbol.id] = result.value
                program.routes[symbol.id] = .Folded
            }
        }
    }
}

// Bake every `@file("path")` of `decls`: evaluate the path as a comptime string,
// read the file (relative to the source file's directory) and store its content
// under `project.file_exprs[id]`, which `lower_intrinsic`'s `@file` arm turns
// into a literal. Each read lands in `program.file_reads` ; a constant that is a
// bare `@file(...)` also lands in `project.file_baked_consts`, which the lower
// merges into `comptime_value_by_symbol_id` so its reads inline the literal. It
// stays out of `comptime_decls`, or the dump would list it twice, the second
// time as a `@comptime` holding the whole file.
bake_file_exprs :: fn(decls: AST.Decl[], project: EvaluatedProject, program: EvaluatedProgram) -> void {
    // Two-step : collect every `@file(arg)` IntrinsicCallExpr first,
    // then evaluate + bake. Avoids closures over the call-time
    // context (Vader's closure-capture analysis isn't robust enough
    // for the multi-field capture this would need).
    found: AST.IntrinsicCallExpr[]: []
    for decl in decls {
        collect_file_intrinsics(decl, found)
    }
    context :: ComptimeContext {
        .typed    = program.typed,
        .bindings = program.comptime_decls,
    }
    initialisers :: file_constants(decls)
    for ic in found {
        bake_one_file_expr(ic, initialisers[ic.id], context, project, program)
    }
}

// The constant each bare `NAME :: @file(...)` initialises, keyed by the `@file`
// call's node id.
file_constants :: fn(decls: AST.Decl[]) -> MutableMap<i64, AST.ConstDecl> {
    out :: MutableMap<i64, AST.ConstDecl> {}
    for decl in decls {
        if decl is AST.ConstDecl {
            ic :: decl.value
            if ic is AST.IntrinsicCallExpr {
                if ic.name == "file" {
                    out[ic.id] = decl
                }
            }
        }
    }
    return out
}

bake_one_file_expr :: fn(
    ic: AST.IntrinsicCallExpr,
    constant: AST.ConstDecl | null,
    context: ComptimeContext,
    project: EvaluatedProject,
    program: EvaluatedProgram,
) -> void {
    arg_result :: evaluate_expr(ic.args[0], context)
    if arg_result.value !is StringValue {
        return
    }
    path :: arg_result.value.value
    content :: read_relative_file(path, program.typed.resolved.path) ?? return
    project.file_exprs[ic.id] = content
    program.file_reads.push(FileRead {
        .span = ic.span,
        .path = path,
        .bytes = content.byte_len(),
        .name = constant_name(constant),
    })
    if constant != null {
        symbol :: symbol_declared_at(program.typed.resolved, constant.name_span) ?? return
        project.file_baked_consts[symbol.id] = string_val(content)
    }
}

constant_name :: fn(constant: AST.ConstDecl | null) -> string | null {
    if constant == null {
        return null
    }
    return constant.name
}

// Resolve a `@file("path")` arg : absolute paths pass through ;
// relative paths join against `source_dir` which the caller passes
// as the module's source directory (`typed.resolved.path` in the
// resolver — already a folder, not a file).
read_relative_file :: fn(raw_path: string, source_dir: string) -> string | null {
    abs :: if starts_with(raw_path, "/") {
        raw_path
    } else if source_dir == "" {
        raw_path
    } else {
        "${source_dir}/${raw_path}"
    }
    result :: read_file_string(abs)
    if result is string { return result }
    return null
}

import "std/io"
import "std/string"

// Recursive expression walker that collects every IntrinsicCallExpr
// named "file" reachable from a decl's bodies (FnDecl body, ImplDecl
// members' bodies, ConstDecl value, AssertDecl condition). Avoids
// closures for portability — `out` accumulates the matches.
collect_file_intrinsics :: fn(decl: AST.Decl, out: AST.IntrinsicCallExpr[]) -> void {
    match decl {
        is AST.FnDecl -> {
            match b :: decl.body {
                is null          -> {}
                is AST.BlockExpr -> { collect_in_block(b, out) }
            }
        }
        is AST.ImplDecl -> {
            for m in decl.members {
                match b :: m.body {
                    is null          -> {}
                    is AST.BlockExpr -> { collect_in_block(b, out) }
                }
            }
        }
        is AST.ConstDecl -> { collect_in_expr(decl.value, out) }
        is AST.AssertDecl -> { collect_in_expr(decl.condition, out) }
        _ -> {}
    }
}

collect_in_block :: fn(b: AST.BlockExpr, out: AST.IntrinsicCallExpr[]) -> void {
    for s in b.stmts { collect_in_stmt(s, out) }
    if b.trailing !is null {
        collect_in_expr(b.trailing, out)
    }
}

collect_in_stmt :: fn(s: AST.Stmt, out: AST.IntrinsicCallExpr[]) -> void {
    match s {
        is AST.LetStmt               -> { collect_in_expr(s.value, out) }
        is AST.AssignStmt            -> {
            collect_in_expr(s.target, out)
            collect_in_expr(s.value, out)
        }
        is AST.DestructureAssignStmt -> {
            for place in AST.assign_places(s) {
                collect_in_expr(place, out)
            }
            collect_in_expr(s.value, out)
        }
        is AST.ExprStmt              -> { collect_in_expr(s.expr, out) }
        is AST.ReturnStmt            -> {
            if s.value !is null {
                collect_in_expr(s.value, out)
            }
        }
        is AST.ForStmt               -> {
            match wf :: s.form {
                is AST.WhileFor -> { collect_in_expr(wf.cond, out) }
                is AST.InFor    -> { collect_in_expr(wf.iter, out) }
                _               -> {}
            }
            collect_in_block(s.body, out)
        }
        is AST.DeferStmt             -> {
            match dsb :: s.body {
                is AST.DeferStmtBody  -> { collect_in_stmt(dsb.stmt, out) }
                is AST.DeferBlockBody -> { collect_in_block(dsb.block, out) }
            }
        }
        _                            -> {}
    }
}

collect_in_expr :: fn(e: AST.Expr, out: AST.IntrinsicCallExpr[]) -> void {
    if e is AST.IntrinsicCallExpr {
        if e.name == "file" && e.args.len() == 1 { out.push(e) }
    }
    match e {
        is AST.BlockExpr -> { collect_in_block(e, out) }
        is AST.CallExpr -> {
            collect_in_expr(e.callee, out)
            for arg in e.args { collect_in_expr(arg.value, out) }
        }
        is AST.FieldExpr -> { collect_in_expr(e.target, out) }
        is AST.IndexExpr -> {
            collect_in_expr(e.target, out)
            collect_in_expr(e.index, out)
        }
        is AST.UnaryExpr -> { collect_in_expr(e.operand, out) }
        is AST.BinaryExpr -> {
            collect_in_expr(e.left, out)
            collect_in_expr(e.right, out)
        }
        is AST.IfExpr -> {
            collect_in_expr(e.cond, out)
            collect_in_block(e.then_block, out)
            match eb :: e.else_branch {
                is null            -> {}
                is AST.IfElseBlock -> { collect_in_block(eb.block, out) }
                is AST.IfElseIf    -> { collect_in_expr(eb.branch, out) }
            }
        }
        is AST.IntrinsicCallExpr -> {
            for arg in e.args { collect_in_expr(arg, out) }
        }
        is AST.StringLitExpr -> {
            for part in e.parts {
                if part is AST.StringLitInterp { collect_in_expr(part.expr, out) }
            }
        }
        _ -> {}
    }
}

// Build a `VmRequiredDecl` when a deferred `@comptime` decl's RHS is a stageable
// nullary call `f()` ; returns null for any other shape (the caller keeps the
// C4001). The callee `f` is staged + executed by the `comptime_vm` pass.
build_vm_required :: fn(decl: AST.ConstDecl, symbol: Symbol, typed: TypedProgram, module_id: string) -> VmRequiredDecl | null {
    call :: decl.value
    if call is AST.CallExpr {
        callee_id :: call.callee
        if callee_id is AST.IdentExpr {
            if call.args.len() == 0 {
                decl_type :: typed.decl_types[symbol.id]
                if decl_type != null {
                    return VmRequiredDecl {
                        .symbol_id   = symbol.id,
                        .module_id   = module_id,
                        .callee_name = callee_id.name,
                        .decl_type   = decl_type,
                        .span        = decl.span,
                    }
                }
            }
        }
    }
    return null
}

// Per-evaluator @tests live in `eval_lit.vader` / `eval_binary.vader`
// / `eval_ident.vader` ; the orchestrator's behaviour is covered by
// the end-to-end snippet snapshots.
