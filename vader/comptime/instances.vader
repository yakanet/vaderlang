// vader/comptime/instances — passive registry of generic instantiations.
//
// The typechecker already
// represents `List<i32>` as `Struct { symbol, args }` ; this pass
// scans every typed-AST type-expression, normalises each instance,
// and registers it under a canonical key. Sorted output goes into
// `EvaluatedProject.instances`, from which `lower_mono_struct` materialises
// each concrete struct instance.

module "vader/comptime"

import "std/collections"
import "std/sort"
import "std/string"
import "vader/resolver/symbol"
import "vader/types"

/// One registered instantiation. `args` carries the concrete (or
/// possibly type-param) type arguments ; `display_key` is the dedup key :
/// the symbol id and the arguments' `canonical_key`.
export GenericInstance :: struct {
    symbol:      Symbol
    args:        Type[]
    display_key: string
}

/// Append-only registry, deduplicated by `display_key`. `sorted_instances` is
/// the deterministic view.
InstanceRegistry :: struct {
    by_key: MutableMap<string, GenericInstance> = MutableMap<string, GenericInstance> {}
}

/// Register `(symbol, args)` if not already present. Returns the
/// canonical instance (existing or newly-added).
/// @param registry  the registry.
/// @param symbol    the generic decl's resolver symbol.
/// @param raw_args  the concrete type arguments ; distinct newtypes are
///                  stripped to their backing before keying (see the body).
/// @return          the registered instance.
add :: fn(registry: InstanceRegistry, symbol: Symbol, raw_args: Type[]) -> GenericInstance {
    // Distinct→backing before this instance is keyed or stored: a distinct has
    // no runtime identity, so `MutableMap<BlockId>` must register as the same
    // raw instance as `MutableMap<i32>`, never a separate erased one. This is
    // the central struct/trait instance source (via `observe`/`walk_type`).
    args :: strip_distinct_each(raw_args)
    key :: "${symbol.id}(${canonical_args_key(args)})"
    existing :: registry.by_key[key]
    match existing {
        is GenericInstance -> { return existing }
        _ -> {}
    }
    instance :: GenericInstance {
        .symbol      = symbol,
        .args        = args,
        .display_key = key,
    }
    registry.by_key[key] = instance
    return instance
}

/// Walk `t`, registering every `StructType` / `EnumType` / `TraitType`
/// instance whose args list is non-empty AND made of resolved types
/// (no `Unresolved` / `FreeInt` / `FreeFloat` / `Self`). TypeParam
/// references are accepted — they appear in the snapshot as the bare
/// name (`T`).
/// @param registry  the registry.
/// @param t         the type to scan.
observe :: fn(registry: InstanceRegistry, t: Type) -> void {
    walk_type(registry, t)
}

walk_type :: fn(registry: InstanceRegistry, t: Type) -> void {
    match t {
        is StructType -> {
            if t.args.len() > 0 && all_concrete_enough(t.args) {
                registry.add(t.symbol, t.args)
            }
            for arg in t.args { walk_type(registry, arg) }
        }
        is EnumType -> {}
        is TraitType -> {
            if t.args.len() > 0 && all_concrete_enough(t.args) {
                registry.add(t.symbol, t.args)
            }
            for arg in t.args { walk_type(registry, arg) }
        }
        is ArrayType -> { walk_type(registry, t.element) }
        is TupleType -> { for el in t.elements { walk_type(registry, el) } }
        is UnionType -> { for v in t.variants { walk_type(registry, v) } }
        is FnType    -> {
            for p in t.params { walk_type(registry, p) }
            walk_type(registry, t.return_type)
        }
        _ -> {}
    }
}

// Filter that allows TypeParam through — the registry stores `Range<T>`
// etc. as observed alongside `Range<i32>`. Rejects only types that signal
// "not yet resolved" or "free literal".
all_concrete_enough :: fn(args: Type[]) -> bool {
    for arg in args {
        if !is_concrete_enough(arg) { return false }
    }
    return true
}

is_concrete_enough :: fn(t: Type) -> bool {
    // @partial: only the "not yet pinned" kinds (Unresolved / Free* / Self) are
    // rejected; every other type — concrete or generic — counts as concrete enough.
    @partial match t {
        is UnresolvedType | FreeIntType | FreeCharType | FreeFloatType | SelfType -> { return false }
        _ -> { return true }
    }
}


/// Return the registry's instances sorted alphabetically by
/// `display_key`.
/// @param registry  the registry.
/// @return          the sorted instance list.
sorted_instances :: fn(registry: InstanceRegistry) -> GenericInstance[] =
    sort(registry.by_key.values(), display_key_before)

display_key_before :: fn(a: GenericInstance, b: GenericInstance) -> bool =
    compare_ascending(a.display_key, b.display_key)

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "vader/parser"

@test test_add_deduplicates :: fn() -> void {
    registry :: InstanceRegistry {}
    sym :: dummy_struct_symbol("Foo")
    args: Type[]: [TY_I32]
    registry.add(sym, args)
    registry.add(sym, args)
    assert_eq(registry.by_key.len(), 1)
}

@test test_observe_struct_instance :: fn() -> void {
    registry :: InstanceRegistry {}
    sym :: dummy_struct_symbol("List")
    args: Type[]: [TY_I32]
    list_type :: mk_struct(sym, args)
    registry.observe(list_type)
    instances :: registry.sorted_instances()
    assert_eq(instances.len(), 1)
    assert_eq(instances[0].symbol.name, "List")
    assert_eq(display_type(instances[0].args[0]), "i32")
}

dummy_struct_symbol :: fn(name: string) -> Symbol {
    return Symbol {
        .id         = 1,
        .kind       = .Struct,
        .name       = name,
        .module     = "t",
        .module_name = "t",
        .visibility = .Public,
        .defined_at = null,
    }
}
