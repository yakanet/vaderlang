// vader/comptime/eval_binary — binary + unary operator evaluation.
//
// Per-operator dispatch over `BinaryOp` / `UnaryOp` for the operand
// shapes the tree-walk MVP supports (Int, Float, Bool, String for `+`
// concat). Type mismatches surface as `C4007` ; the operators the VM
// would otherwise handle (`Is`, `In`, `NotIn`) fall back to `C4001`.

module "vader/comptime"

AST :: import "toolchain/ast"
import "toolchain/span"
import "vader/diagnostics"
import "vader/integer"
import "vader/types"

/// Evaluate a `BinaryExpr`. Recurses into both operands ; combines
/// per `op`. Short-circuits on operand failure (the operand's error
/// propagates up). `Is` / `In` / `NotIn` need the typechecker's
/// narrowing tables — fall back to C4001.
/// @param expr     the binary expression node.
/// @param context  the evaluator context.
/// @return         the combined value or a diagnostic.
export evaluate_binary_expr :: fn(expr: AST.BinaryExpr, context: ComptimeContext) -> EvalResult {
    left_result :: evaluate_expr(expr.left, context)
    left :: left_result.value ?? return left_result
    right_result :: evaluate_expr(expr.right, context)
    right :: right_result.value ?? return right_result
    // Width of the node's resolved type: the type `+`, `-` and `*` are checked
    // against, and the width the wrapping and bitwise operators wrap at, so a
    // comptime fold matches the run time. Empty string: unknown / non-integer,
    // never truncated (wide dtoa / crypto tables must keep full 64-bit precision).
    rname :: resolved_int_name(context, expr.id)
    // The shift amount is masked to the width first : native `<<` on `int32_t`
    // masks to 5 bits (int64_t to 6), so `1 << 33` runs as `1 << 1`. Without
    // this the i64 tree-walk shift would compute `1 << 33` then wrap to 0.
    right_value :: if expr.op == .Shl || expr.op == .Shr {
        mask_shift_amount(right, rname)
    } else {
        right
    }
    // `==` on a union compares by variant : two values of different kinds are
    // unequal, two `null`s equal ; `compare` answers two values of one kind.
    if expr.op == .Eq || expr.op == .Neq {
        apart :: !same_kind(left, right_value)
        if (apart || left is NullValue) && has_union_operand(context, expr) {
            return ok(bool_value(apart == (expr.op == .Neq)))
        }
    }
    combined :: combine_binary(expr, left, right_value, rname)
    return normalize_int_result(combined, rname)
}

// `+`, `-` or `*` on two integers, checked at the width it folds at: an overflow
// is an error, as it would stop the run.
checked_int :: fn(expr: AST.BinaryExpr, left: IntValue, right: IntValue, rname: string) -> EvalResult {
    type_name :: result_type_name(left, rname)
    bits :: int_bits_of(type_name)
    value :: checked_int_op(expr.op, bits, is_unsigned_int_name(type_name), left.value, right.value)
    return checked_result(expr.span, value, type_name)
}

// `op`, which is `+`, `-` or `*`, in the integer type of `bits` bits.
checked_int_op :: fn(op: AST.BinaryOp, bits: i64, unsigned: bool, x: i64, y: i64) -> i64 | null {
    if op == .Add { return checked_add(bits, unsigned, x, y) }
    if op == .Sub { return checked_sub(bits, unsigned, x, y) }
    return checked_mul(bits, unsigned, x, y)
}

// The folded value of a checked operation, or the overflow it ran into.
checked_result :: fn(span: Span, value: i64 | null, type_name: string) -> EvalResult {
    if value == null {
        return fail(comptime_error(.IntegerOverflow, span, "the result leaves `${type_name}`"))
    }
    return ok(int_val_typed(value, type_name))
}

// The width of the integer type `type_name` ; 64 bits for an unknown one, which
// folds unbounded at `i64` rather than at a guessed width.
int_bits_of :: fn(type_name: string) -> i64 {
    if is_int_name(type_name) {
        return primitive_size(type_name) * 8
    }
    return 64
}

has_union_operand :: fn(context: ComptimeContext, expr: AST.BinaryExpr) -> bool =
    context.typed.expr_types[expr.left.id] is UnionType
        || context.typed.expr_types[expr.right.id] is UnionType

same_kind :: fn(left: ComptimeValue, right: ComptimeValue) -> bool = match left {
    is IntValue    -> right is IntValue
    is FloatValue  -> right is FloatValue
    is BoolValue   -> right is BoolValue
    is CharValue   -> right is CharValue
    is StringValue -> right is StringValue
    is NullValue   -> right is NullValue
    is VoidValue   -> right is VoidValue
    is ArrayValue  -> right is ArrayValue
    is StructValue -> right is StructValue
    is TypeValue   -> right is TypeValue
}

combine_binary :: fn(
    expr: AST.BinaryExpr, left: ComptimeValue, right: ComptimeValue, rname: string,
) -> EvalResult = match expr.op {
    .Add    -> arithmetic_or_concat(expr, left, right, rname)
    .Sub    -> arithmetic(expr, left, right, rname)
    .Mul    -> arithmetic(expr, left, right, rname)
    .Div    -> int_div_check(expr, left, right, rname)
    .Mod    -> int_mod_check(expr, left, right)
    .Shl    -> arithmetic_int(expr, left, right, op_shl)
    .Shr    -> arithmetic_int(expr, left, right, op_shr)
    .BitAnd -> arithmetic_int(expr, left, right, op_bit_and)
    .BitOr  -> arithmetic_int(expr, left, right, op_bit_or)
    .BitXor -> arithmetic_int(expr, left, right, op_bit_xor)
    .And    -> bool_op(expr, left, right, op_and)
    .Or     -> bool_op(expr, left, right, op_or)
    .Eq     -> compare(expr, left, right, .Eq)
    .Neq    -> compare(expr, left, right, .Neq)
    .Lt     -> compare(expr, left, right, .Lt)
    .Lte    -> compare(expr, left, right, .Lte)
    .Gt     -> compare(expr, left, right, .Gt)
    .Gte    -> compare(expr, left, right, .Gte)
    .Is     -> vm_required(expr.span, "BinaryOp.Is")
    .In     -> vm_required(expr.span, "BinaryOp.In")
    .NotIn  -> vm_required(expr.span, "BinaryOp.NotIn")
    .Same    -> vm_required(expr.span, "BinaryOp.Same")
    .NotSame -> vm_required(expr.span, "BinaryOp.NotSame")
    .AddWrap -> arithmetic_int(expr, left, right, op_add)
    .SubWrap -> arithmetic_int(expr, left, right, op_sub)
    .MulWrap -> arithmetic_int(expr, left, right, op_mul)
}

/// Evaluate a `UnaryExpr` (`-x`, `!x`, `~x`).
/// @param expr     the unary expression node.
/// @param context  the evaluator context.
/// @return         the result value or a diagnostic.
export evaluate_unary_expr :: fn(expr: AST.UnaryExpr, context: ComptimeContext) -> EvalResult {
    inner :: evaluate_expr(expr.operand, context)
    operand :: inner.value ?? return inner
    rname :: resolved_int_name(context, expr.id)
    combined :: match expr.op {
        .Neg    -> unary_neg(expr, operand, rname)
        .Not    -> unary_not(expr, operand)
        .BitNot -> unary_bit_not(expr, operand)
    }
    return normalize_int_result(combined, rname)
}

// ---- integer-width normalisation (audit CT1) ------------------------------

// Re-wrap an integer result to the node's resolved width so a comptime fold
// matches the runtime's fixed-width arithmetic. Non-integer results (bool from
// comparisons, string from concat) pass through, as do unknown / 64-bit widths
// — a missing or `i64`/`u64`/`isize`/`usize` width is NEVER truncated.
normalize_int_result :: fn(r: EvalResult, rname: string) -> EvalResult {
    if r.value is IntValue as iv {
        return ok(int_val_typed(wrap_to_width(iv.value, rname), result_type_name(iv, rname)))
    }
    return r
}

// The node's resolved width names the result, else the operand's own type does.
result_type_name :: fn(iv: IntValue, rname: string) -> string {
    if rname != "" {
        return rname
    }
    return iv.type_name
}

// Wrap an i64 to the given primitive width, keeping the value in that type's
// range so a comparison, a division or a shift folds as it runs. A `u64` above
// `i64` cannot be held this way and stays as its bits.
wrap_to_width :: fn(v: i64, type_name: string) -> i64 = match type_name {
    "i8"  -> sign_extend(v, 8)
    "u8"  -> v & 0xFF
    "i16" -> sign_extend(v, 16)
    "u16" -> v & 0xFFFF
    "i32" -> sign_extend(v, 32)
    "u32" -> v & 0xFFFF_FFFF
    _     -> v
}

// Truncate to the low `bits`, then sign-extend the top one into the upper half,
// as a signed slot of that width holds the value.
sign_extend :: fn(v: i64, bits: i64) -> i64 {
    span: i64: 1 << bits
    low :: v & (span - 1)
    if low & (span >> 1) != 0 {
        return low - span
    }
    return low
}

// Mask a shift's right operand to the result width (5 bits for a 32-bit type,
// 6 for a 64-bit / unknown one) — mirrors the hardware shift the backends emit.
mask_shift_amount :: fn(rhs: ComptimeValue, rname: string) -> ComptimeValue {
    if rhs is IntValue { return int_val_typed(rhs.value & shift_amount_mask(rname), rhs.type_name) }
    return rhs
}

shift_amount_mask :: fn(rname: string) -> i64 = match rname {
    "i8" | "u8" | "i16" | "u16" | "i32" | "u32" -> 31
    _                                           -> 63
}

// Primitive name of the node's resolved type, or "" when the typechecker left
// no entry / the type isn't a bare primitive (both ⇒ don't wrap).
resolved_int_name :: fn(context: ComptimeContext, expr_id: i64) -> string {
    t :: context.typed.expr_types[expr_id]
    name :: primitive_name(t)
    if name != "" {
        return name
    }
    // A free int the typechecker never pinned to a concrete width (nested inside
    // a comparison / shift, so no slot narrowed it) defaults to `i32` — SPEC
    // "Default integer", exactly what the runtime does, so it wraps at 32 bits.
    if t is FreeIntType { return "i32" }
    return ""
}

// ---- arithmetic helpers ---------------------------------------------------

// `Add` accepts strings (concat) in addition to numeric pairs, hence
// the dedicated wrapper. Other arith ops go through `arithmetic` which
// rejects strings with `C4007`.
arithmetic_or_concat :: fn(
    expr: AST.BinaryExpr, left: ComptimeValue, right: ComptimeValue, rname: string,
) -> EvalResult {
    if left is StringValue {
        if right is StringValue { return ok(string_val("${left.value}${right.value}")) }
        return type_mismatch(expr, "string + non-string")
    }
    return arithmetic(expr, left, right, rname)
}

// `+`, `-`, `*` or `/` on two numbers: on integers, the first three checked
// (`checked_int`) and a quotient as the run time computes it ; IEEE on floats.
arithmetic :: fn(
    expr: AST.BinaryExpr, left: ComptimeValue, right: ComptimeValue, rname: string,
) -> EvalResult {
    if left is IntValue && right is IntValue {
        if expr.op == .Div {
            return ok(int_val_typed(op_div(left.value, right.value), left.type_name))
        }
        return checked_int(expr, left, right, rname)
    }
    if left is FloatValue && right is FloatValue {
        return ok(float_val_typed(float_arith(expr.op, left.value, right.value), left.type_name))
    }
    return type_mismatch(expr, "operand kinds disagree for arithmetic op")
}

arithmetic_int :: fn(
    expr: AST.BinaryExpr, left: ComptimeValue, right: ComptimeValue,
    int_op: fn(i64, i64) -> i64,
) -> EvalResult {
    match left {
        is IntValue -> {
            match right {
                is IntValue -> { return ok(int_val_typed(int_op(left.value, right.value), left.type_name)) }
                _ -> {}
            }
        }
        _ -> {}
    }
    return type_mismatch(expr, "operand kinds disagree for bit / mod / shift op")
}

// Short-circuit before the C-level division — `idiv` by 0 traps with
// SIGFPE on x86_64, which is host-platform UB the evaluator can't
// otherwise observe.
int_div_check :: fn(
    expr: AST.BinaryExpr, left: ComptimeValue, right: ComptimeValue, rname: string,
) -> EvalResult {
    if right is IntValue {
        if right.value == 0 { return division_by_zero(expr, "/") }
    }
    return arithmetic(expr, left, right, rname)
}

int_mod_check :: fn(expr: AST.BinaryExpr, left: ComptimeValue, right: ComptimeValue) -> EvalResult {
    if right is IntValue {
        if right.value == 0 { return division_by_zero(expr, "%") }
    }
    return arithmetic_int(expr, left, right, op_mod)
}

bool_op :: fn(
    expr: AST.BinaryExpr, left: ComptimeValue, right: ComptimeValue,
    op: fn(bool, bool) -> bool,
) -> EvalResult {
    match left {
        is BoolValue -> {
            match right {
                is BoolValue -> {
                    if op(left.value, right.value) { return ok(VAL_TRUE) }
                    return ok(VAL_FALSE)
                }
                _ -> {}
            }
        }
        _ -> {}
    }
    return type_mismatch(expr, "logical operator requires bool operands")
}

// ---- comparison helpers ---------------------------------------------------

CompareOp :: enum(u8) { Eq, Neq, Lt, Lte, Gt, Gte }

compare :: fn(
    expr: AST.BinaryExpr, left: ComptimeValue, right: ComptimeValue, op: CompareOp,
) -> EvalResult {
    match left {
        is IntValue -> {
            if right is IntValue {
                return ok(bool_value(int_compare(left.value, right.value, op)))
            }
        }
        is FloatValue -> {
            if right is FloatValue {
                return ok(bool_value(float_compare(left.value, right.value, op)))
            }
        }
        is BoolValue -> {
            if right is BoolValue {
                return bool_equality_only(expr, left.value == right.value, op)
            }
        }
        is StringValue -> {
            if right is StringValue {
                order :: i64(left.value.compare(right.value))
                return ok(bool_value(int_compare(order, 0, op)))
            }
        }
        _ -> {}
    }
    // Two structs, tuples or arrays compare through their impl — `Equals`,
    // `Comparable` — or field by field : the lowered code answers that, on the VM.
    if (left is ArrayValue || left is StructValue) && same_kind(left, right) {
        return vm_required(expr.span, "comparison of arrays or structs")
    }
    return type_mismatch(expr, "comparison operand kinds disagree")
}

// `bool` supports only equality at comptime : it implements no `Comparable`, so
// `<` / `<=` / `>` / `>=` are unordered — refused loudly rather than baked as a
// `false` the typecheck would never have let through.
bool_equality_only :: fn(expr: AST.BinaryExpr, eq: bool, op: CompareOp) -> EvalResult {
    if op == .Eq  { return ok(bool_value(eq)) }
    if op == .Neq { return ok(bool_value(!eq)) }
    return type_mismatch(expr, "`bool` values are not ordered (no Comparable impl); only == and != are valid at comptime")
}

int_compare :: fn(left: i64, right: i64, op: CompareOp) -> bool = match op {
    .Eq  -> left == right
    .Neq -> left != right
    .Lt  -> left < right
    .Lte -> left <= right
    .Gt  -> left > right
    .Gte -> left >= right
}

float_compare :: fn(left: f64, right: f64, op: CompareOp) -> bool = match op {
    .Eq  -> left == right
    .Neq -> left != right
    .Lt  -> left < right
    .Lte -> left <= right
    .Gt  -> left > right
    .Gte -> left >= right
}

bool_value :: fn(b: bool) -> ComptimeValue {
    if b { return VAL_TRUE }
    return VAL_FALSE
}

// ---- unary helpers --------------------------------------------------------

unary_neg :: fn(expr: AST.UnaryExpr, inner: ComptimeValue, rname: string) -> EvalResult {
    // @partial: only Int / Float negate; every other value kind is a type mismatch.
    @partial match inner {
        is IntValue   -> {
            type_name :: result_type_name(inner, rname)
            bits :: int_bits_of(type_name)
            negated :: checked_negation(bits, is_unsigned_int_name(type_name), inner.value)
            return checked_result(expr.span, negated, type_name)
        }
        is FloatValue -> { return ok(float_val_typed(-inner.value, inner.type_name)) }
        _             -> { return unary_type_mismatch(expr, "`-` requires numeric") }
    }
}

unary_not :: fn(expr: AST.UnaryExpr, inner: ComptimeValue) -> EvalResult {
    if inner is BoolValue {
        if inner.value { return ok(VAL_FALSE) }
        return ok(VAL_TRUE)
    }
    return unary_type_mismatch(expr, "`!` requires bool")
}

unary_bit_not :: fn(expr: AST.UnaryExpr, inner: ComptimeValue) -> EvalResult {
    if inner is IntValue { return ok(int_val_typed(bit_not_i64(inner.value), inner.type_name)) }
    return unary_type_mismatch(expr, "`~` requires int")
}

// Vader doesn't expose `~` as a builtin yet ; emulate via `xor` with -1.
bit_not_i64 :: fn(value: i64) -> i64 { return value ^ -1 }

// ---- error helpers --------------------------------------------------------

type_mismatch :: fn(expr: AST.BinaryExpr, detail: string) -> EvalResult {
    return fail(comptime_error(.TypeMismatch, expr.span, detail))
}

division_by_zero :: fn(expr: AST.BinaryExpr, op_sym: string) -> EvalResult {
    return fail(comptime_error(.DivisionByZero, expr.span, op_sym))
}

unary_type_mismatch :: fn(expr: AST.UnaryExpr, detail: string) -> EvalResult {
    return fail(comptime_error(.TypeMismatch, expr.span, detail))
}

// ---- per-op closures ------------------------------------------------------

op_add     :: fn(left: i64, right: i64) -> i64 { return left +% right }
op_sub     :: fn(left: i64, right: i64) -> i64 { return left -% right }
op_mul     :: fn(left: i64, right: i64) -> i64 { return left *% right }
op_div     :: fn(left: i64, right: i64) -> i64 { return left / right }
op_mod     :: fn(left: i64, right: i64) -> i64 { return left % right }
op_shl     :: fn(left: i64, right: i64) -> i64 { return left << right }
op_shr     :: fn(left: i64, right: i64) -> i64 { return left >> right }
op_bit_and :: fn(left: i64, right: i64) -> i64 { return left & right }
op_bit_or  :: fn(left: i64, right: i64) -> i64 { return left | right }
op_bit_xor :: fn(left: i64, right: i64) -> i64 { return left ^ right }
op_and     :: fn(left: bool, right: bool) -> bool { return left && right }
op_or      :: fn(left: bool, right: bool) -> bool { return left || right }

// Float arithmetic dispatches inline since the i64 closure won't fit.
// @partial: float arithmetic supports only Add/Sub/Mul/Div; other BinaryOps
// are dispatched elsewhere and default to 0.0.
float_arith :: fn(op: AST.BinaryOp, left: f64, right: f64) -> f64 = @partial match op {
    .Add -> left + right
    .Sub -> left - right
    .Mul -> left * right
    .Div -> left / right
    _    -> 0.0
}
