// vader/front/resolver/intercept: the functions a declared interceptor wraps.
//
// A decorator `D` declared under `@interceptor(around = f)` routes every call of
// a function it decorates through `f`. Once every module is parsed and before any
// is collected, each such function `g` is renamed `g$$intercepted` and loses its
// `export`, and its file gains:
//
//     g$$Layer :: struct { state: S<A, R>, site: Site<D> }
//     @singleton
//     g$$layer :: fn() = g$$Layer { .state = S<A, R> {}, .site = Site<D> { ... } }
//     g :: fn(<the parameters of g>) -> R {
//         layer :: g$$layer()
//         return f(layer.state, layer.site, <args>, (args) -> g$$intercepted(...))
//     }
//
// One singleton holds both, so a call reads one instance: the site's decorator is
// `@decorator(g$$intercepted, D)`. The names are `generated_name`'s, which no
// declaration a user writes can take.
//
// A function several interceptors mark gets one layer per interceptor, the first
// written outermost. The layer under `g` is `g$$proceed2`, which the `proceed` of
// `g` calls, with its own `g$$layer2` and `g$$Layer2`; the last one's `proceed`
// calls `g$$intercepted`.
// `S` is the struct the first parameter of `f` names, `A` the one parameter's
// type or the tuple of them, `R` the written result. The wrapper takes the name,
// so every call reaches it, the recursive ones of `g` included. It is written in
// the file of `g`, which sees the types `g` names and the interceptor under the
// import `g` wrote it with.

module "vader/front/resolver"

import "std/collections"
import "std/iter"
import "std/path"
import "std/string"
import "std/string_builder"
import "toolchain/ast"
import "toolchain/diagnostics"
import "toolchain/lexer"
import "toolchain/parser"
import "toolchain/span"
import "toolchain/stage"
import "vader/core/mangle"

// The kind of the files the wrappers are parsed under (`generated_file`): no
// source stage takes it as its name.
INTERCEPT_KIND :: "intercept"

// What a declared interceptor routes the calls of its functions through.
Interceptor :: struct {
    /// Its decorator.
    origin: DecoratorOrigin
    /// The function every call goes through.
    around: string
    /// The struct its first parameter names: the state each function keeps.
    state: string
}

/// Wrap every function a declared interceptor decorates, in every module of a
/// load.
///
/// @param modules  the modules of the load, parsed, none collected yet.
/// @param project  the project root, which a `Site` names its file from; null
///                 for a file on its own.
/// @param ids      numbers the declarations the wrapping adds.
/// @param diags    where a misdeclared interceptor and a function it cannot wrap
///                 are reported.
intercept_functions :: fn(
    modules: DeferredModule[],
    project: string | null,
    ids: NodeIdFactory,
    diags: Diagnostic[],
) -> void {
    interceptors :: declared_interceptors(modules, diags)
    if interceptors.is_empty() {
        return
    }
    declared :: declared_decorators(modules)
    for m in modules {
        glue_files: SourceFile[]: []
        for source in m.sources {
            glue :: wrap_file(source, m.found.name, project, interceptors, declared, ids, diags)
            if glue != null {
                glue_files.push(glue)
            }
        }
        m.sources.push_all(glue_files)
    }
}

// The interceptors `modules` declare.
declared_interceptors :: fn(modules: DeferredModule[], diags: Diagnostic[]) -> Interceptor[] {
    out: Interceptor[]: []
    for m in modules {
        for source in m.sources {
            for d in source.program.decls.filter_is<StructDecl>() {
                marker :: find_compiler_decorator(d.decorators, .Interceptor) else continue
                around :: around_of(m.sources, d, marker, diags) else continue
                out.push(Interceptor {
                    .origin = DecoratorOrigin { .module = m.found.name, .name = d.name },
                    .around = around.function.name,
                    .state = around.state,
                })
            }
        }
    }
    return out
}

// An interceptor of a function, and how the wrapper names what it declares.
Interception :: struct {
    interceptor: Interceptor
    /// The namespace alias the decorator is written behind and its dot, "" when it
    /// is written bare.
    qualifier: string
    /// The name the decorator is written under, after its qualifier.
    name: string
}

// The file of glue that wraps the functions of `source` an interceptor decorates,
// null when it wraps none. The glue is a file of its own, so a walk over the
// declarations `source` writes never meets it: it opens with the imports of
// `source`, which its names are written under. The wrappers are written from the
// names as written, so the functions are renamed after.
wrap_file :: fn(
    source: SourceFile,
    module_name: string,
    project: string | null,
    interceptors: Interceptor[],
    declared: Map<string, Set<string>>,
    ids: NodeIdFactory,
    diags: Diagnostic[],
) -> SourceFile | null {
    program :: source.program
    header :: framed_source(INTERCEPT_KIND, source.path, module_name, imports_text(source))
    glue :: StringBuilder {}
    origins: CodeOrigin[]: []
    wrapped: FnDecl[]: []
    for f in program.decls.filter_is<FnDecl>() {
        interceptions :: interceptions_of(program, module_name, f, interceptors, declared)
        if interceptions.is_empty() {
            continue
        }
        reason :: refusal(f, interceptions)
        if reason != null {
            diags.push(resolver_error(.CannotIntercept, f.name_span, reason))
            continue
        }
        result :: f.return_type else continue
        file :: source_file_name(source.path, project)
        for depth in 1..=interceptions.len() {
            start :: glue.byte_len()
            glue.append(layer_text(source, module_name, file, f, result, interceptions, depth))
            origins.push(CodeOrigin {
                .start = header.byte_len() + start,
                .end = header.byte_len() + glue.byte_len(),
                .origin = layer_origin(f, interceptions[depth - 1]),
            })
        }
        wrapped.push(f)
    }
    if wrapped.is_empty() {
        return null
    }
    path :: generated_file(INTERCEPT_KIND, source.path)
    content :: "${header}${glue.to_string()}"
    parsed :: parse_compiler_written(content, path)
    diags.push_all(parsed.errors)
    assign_program_ids(parsed.program, ids)
    wrappers :: Map<string, FnDecl> {}
    for d in parsed.program.decls.filter_is<FnDecl>() {
        wrappers[d.name] = d
    }
    for f in wrapped {
        wrapper :: wrappers[f.name]
        if wrapper != null {
            wrapper.doc = f.doc
        }
        f.name = generated_name(f.name, .Intercepted)
        f.visibility = .Private
        f.doc = null
    }
    return SourceFile {
        .path = path,
        .content = content,
        .program = parsed.program,
        .origins = origins,
    }
}

// The function a layer of `f` wraps, as the origin of the layer.
layer_origin :: fn(f: FnDecl, interception: Interception) -> Related = Related {
    .span = f.name_span,
    .message = "the code `@${interception.qualifier}${interception.name}` writes for `${f.name}`",
}

// The imports of `source`, as written, decorators included, one per line.
imports_text :: fn(source: SourceFile) -> string {
    out :: StringBuilder {}
    for i in source.program.decls.filter_is<ImportDecl>() {
        start :: if i.decorators.is_empty() { i.span.start } else { i.decorators[0].span.start }
        out.append(source.content.byte_slice(start.offset, i.span.end.offset))
        out.append("\n")
    }
    return out.to_string()
}

// The interceptors the decorators of `f` name, written in `program`, a file of
// the module `module_name`.
interceptions_of :: fn(
    program: Program,
    module_name: string,
    f: FnDecl,
    interceptors: Interceptor[],
    declared: Map<string, Set<string>>,
) -> Interception[] {
    out: Interception[]: []
    for d in f.decorators {
        origin :: written_origin(program, module_name, d, declared) else continue
        for i in interceptors {
            if same_origin(i.origin, origin) {
                out.push(Interception {
                    .interceptor = i,
                    .qualifier = qualifier_of(d),
                    .name = d.name,
                })
            }
        }
    }
    return out
}

// What the names of the module of `d` are written after: its namespace alias and
// a dot, "" for a bare decorator.
qualifier_of :: fn(d: Decorator) -> string {
    qualifier :: d.qualifier else return ""
    return "${qualifier.name}."
}

// Why `f`, marked by `interceptions`, cannot be wrapped, null when it can.
refusal :: fn(f: FnDecl, interceptions: Interception[]) -> string | null {
    repeated :: repeated_interceptor(interceptions)
    if repeated != null {
        return "`${f.name}` is marked twice by `${repeated}`, which wraps a function once"
    }
    if f.body == null {
        return "`${f.name}` has no body to call"
    }
    if !f.type_params.is_empty() {
        return "`${f.name}` is generic, and a state is kept per function"
    }
    if f.params.is_empty() {
        return "`${f.name}` takes no parameter to pass on"
    }
    if f.return_type == null {
        return "the result of `${f.name}` must be written"
    }
    // The layers pass the arguments on as written types: a type a default gives
    // is known to the typecheck alone.
    unwritten :: f.params.find((p) -> p.ty == null)
    if unwritten != null {
        return "the type of `${unwritten.name}` must be written"
    }
    return null
}

// The name of the interceptor written twice in `interceptions`, null when none is.
repeated_interceptor :: fn(interceptions: Interception[]) -> string | null {
    for i in 1..<interceptions.len() {
        origin :: interceptions[i].interceptor.origin
        for j in 0..<i {
            if same_origin(interceptions[j].interceptor.origin, origin) {
                return origin.name
            }
        }
    }
    return null
}

// The function a call reaches at the layer `depth` of `base`, which has `count`,
// numbered from 1: `base` itself at the first, its body under the last.
layer_function :: fn(base: string, depth: i64, count: i64) -> string {
    if depth == 1 {
        return base
    }
    if depth > count {
        return generated_name(base, .Intercepted)
    }
    return ranked_generated_name(base, .Proceed, depth)
}

// The singleton and the wrapper of the layer `depth` of `f`, a function of
// `source` in the module `module_name` that `interceptions` mark, whose written
// result is `result`. `file` names `source` as a `Site` gives it.
layer_text :: fn(
    source: SourceFile,
    module_name: string,
    file: string,
    f: FnDecl,
    result: TypeExpr,
    interceptions: Interception[],
    depth: i64,
) -> string {
    content :: source.content
    result_text :: result.span.text_in(content)
    names :: f.params.map((p) -> p.name).collect()
    interception :: interceptions[depth - 1]
    qualifier :: interception.qualifier
    interceptor :: interception.interceptor
    decorator_name :: "${qualifier}${interception.name}"
    state_type :: "${qualifier}${interceptor.state}<${arguments_type(content, f)}, ${result_text}>"
    intercepted :: generated_name(f.name, .Intercepted)
    singleton :: ranked_generated_name(f.name, .Layer, depth)
    layer_type :: ranked_generated_name(f.name, .LayerType, depth)
    out :: StringBuilder {}
    out.append("${layer_type} :: struct {\n")
    out.append("    state: ${state_type}\n")
    out.append("    site: Site<${decorator_name}>\n")
    out.append("}\n")
    out.append("@singleton\n")
    out.append("${singleton} :: fn() = ${layer_type} {\n")
    out.append("    .state = ${state_type} {},\n")
    out.append("    .site = Site<${decorator_name}> {\n")
    out.append("        .function = ${quote_vader(f.name)},\n")
    out.append("        .module = ${quote_vader(module_name)},\n")
    out.append("        .file = ${quote_vader(file)},\n")
    out.append("        .line = ${f.name_span.start.line},\n")
    out.append("        .column = ${f.name_span.start.column},\n")
    out.append("        .marker = @decorator(${intercepted}, ${decorator_name}),\n")
    out.append("    },\n")
    out.append("}\n")
    if depth == 1 && f.visibility == .Public {
        out.append("export ")
    }
    function :: layer_function(f.name, depth, interceptions.len())
    below :: layer_function(f.name, depth + 1, interceptions.len())
    out.append("${function} :: fn${f.params_span.text_in(content)} -> ${result_text} {\n")
    out.append("    layer :: ${singleton}()\n")
    out.append("    return ${qualifier}${interceptor.around}(layer.state, layer.site, ")
    out.append("${tupled(names)}, (args) -> ${below}(${spread(names.len())}))\n")
    out.append("}\n")
    return out.to_string()
}

// The type the parameters of `f` travel as: the one's, or their tuple. Each is
// written, which `refusal` requires.
arguments_type :: fn(content: string, f: FnDecl) -> string {
    types: string[]: []
    for p in f.params {
        written_type :: p.ty else continue
        types.push(written_type.span.text_in(content))
    }
    return tupled(types)
}

// `items` as one value: the one item, or their tuple. `spread` takes it apart.
tupled :: fn(items: string[]) -> string {
    if items.len() == 1 {
        return items[0]
    }
    return "[${items.join(", ")}]"
}

// The arguments a lambda taking `args` passes on, as `tupled` built it: `args`,
// or each element.
spread :: fn(count: i64) -> string {
    if count == 1 {
        return "args"
    }
    return (0..<count).map((i) -> "args.${i}").collect().join(", ")
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_intercept_passes_one_argument_alone :: fn() -> void {
    assert_eq(tupled(["n"]), "n")
    assert_eq(spread(1), "args")
}

@test
test_intercept_numbers_the_layers_under_the_first :: fn() -> void {
    assert_eq(layer_function("fib", 1, 2), "fib")
    assert_eq(layer_function("fib", 2, 2), "fib\$\$proceed2")
    assert_eq(layer_function("fib", 3, 2), "fib\$\$intercepted")
}

@test
test_intercept_passes_several_arguments_as_a_tuple :: fn() -> void {
    assert_eq(tupled(["a", "b"]), "[a, b]")
    assert_eq(spread(2), "args.0, args.1")
}
