// vader/front/resolver/manifest: a project's `vader.json`, read and written.
//
// `parse_manifest` reads the file, `write_manifest_json` writes it; a test holds
// the two to the same keys.

module "vader/front/resolver"

import "json"
import "std/collections"
import "std/io"
import "std/path"
import "std/string"
import "vader/support/text"

// Every key a `vader.json` may hold; `name` and `version` drive nothing.
// `test_the_editor_schema_describes_exactly_the_manifest_keys` holds the schema
// the editors validate the file against to this list, in this order.
MANIFEST_KEYS :: ["name", "version", "includePaths", "entries", "assets"]

/// The fields of a project `vader.json`, read in one pass.
export Manifest :: struct {
    /// The project's name (`name` key); empty when the file gives none.
    name: string = ""
    /// The project's version (`version` key); empty when the file gives none.
    version: string = ""
    /// Extra module search roots (`includePaths` key), each relative to the
    /// project root. Joined onto the project root and searched (after the
    /// manifest dir itself) by lazy resolution: GCC `-I` style. E.g.
    /// `["lib"]` makes `module "std/io"` resolve at `<root>/lib/std/io`.
    include_paths: string[] = []
    /// The programs the project builds (`entries` key), in declaration order.
    entries: ManifestEntry[] = []
    /// Files and folders a build copies beside the project's binaries (`assets`
    /// key), each relative to the project root.
    assets: string[] = []
    /// What the file gets wrong, each worded to follow the file's path. The
    /// loader reads what it can and ignores these; a command given the project
    /// refuses them.
    problems: string[] = []
}

/// One program of a project: `"<name>": "<entry file>"` in the `entries` of a
/// `vader.json`, or what a driver's `add_entry` adds.
export ManifestEntry :: struct {
    /// What the binary is called.
    name: string
    /// The entry file, relative to the project root.
    path: string
}

/// Read `vader.json` at `project_root` in one read + parse. Returns an empty
/// `Manifest` when the file is missing, and records in `problems` what a
/// malformed one gets wrong.
///
/// One pass matters : the LSP re-loads the project on every didOpen / didChange,
/// so re-reading + re-parsing the manifest per field would double the I/O.
///
/// @param project_root  the folder holding `vader.json`.
export read_manifest :: fn(project_root: string) -> Manifest {
    manifest_path :: join_path(project_root, MANIFEST_FILENAME)
    if !exists(manifest_path) {
        return Manifest {}
    }
    return parse_manifest(try_read(manifest_path) ?? "")
}

try_read :: fn(path: string) -> string | null {
    result :: read_file_string(path)
    if result is string {
        return result
    }
    return null
}

/// The `Manifest` the text of a `vader.json` describes.
///
/// @param text  the file's content.
/// @return      the fields it declares; `problems` says what it gets wrong.
export parse_manifest :: fn(text: string) -> Manifest {
    manifest :: Manifest {}
    parsed :: parse(text)
    if parsed is JsonError {
        manifest.problems.push("${parsed.message()} at byte ${parsed.pos}")
        return manifest
    }
    if parsed !is JsonObject {
        manifest.problems.push("it is not a JSON object")
        return manifest
    }
    for [key, _] in parsed.entries {
        if key !in MANIFEST_KEYS {
            known :: MANIFEST_KEYS.join("`, `")
            manifest.problems.push("unknown key `${key}`; the keys are `${known}`")
        }
    }
    manifest.name = string_at(parsed, "name", manifest.problems)
    manifest.version = string_at(parsed, "version", manifest.problems)
    manifest.include_paths.push_all(string_list(parsed, "includePaths", manifest.problems))
    entries :: parsed.entries["entries"]
    if entries is JsonObject {
        for [name, path] in entries.entries {
            problem :: entry_name_problem(name)
            same :: entry_named(manifest.entries, name)
            if problem != null {
                manifest.problems.push("entry `${name}` ${problem}")
            } else if same != null {
                both :: "entries `${same.name}` and `${name}`"
                manifest.problems.push("${both} name one binary where case is ignored")
            } else if path is JsonString {
                manifest.entries.push(ManifestEntry { .name = name, .path = path.value })
            } else {
                manifest.problems.push("entry `${name}` is not the path of its entry file")
            }
        }
    } else if entries != null {
        manifest.problems.push("`entries` is not an object of `\"<name>\": \"<entry file>\"`")
    }
    for asset in string_list(parsed, "assets", manifest.problems) {
        problem :: asset_problem(asset)
        if problem == null {
            manifest.assets.push(asset)
        } else {
            manifest.problems.push(problem)
        }
    }
    return manifest
}

// The string the key `key` of `object` holds, empty when the key is absent.
// Anything else goes to `problems`.
string_at :: fn(object: JsonObject, key: string, problems: string[]) -> string {
    found :: object.entries[key] ?? return ""
    if found !is JsonString {
        problems.push("`${key}` is not a string")
        return ""
    }
    return found.value
}

// The strings the array `key` of `object` holds, empty when the key is absent.
// What is not an array of strings goes to `problems`.
string_list :: fn(object: JsonObject, key: string, problems: string[]) -> string[] {
    found :: object.entries[key] ?? return []
    if found !is JsonArray {
        problems.push("`${key}` is not an array of strings")
        return []
    }
    strings: string[]: []
    for item in found.items {
        if item is JsonString {
            strings.push(item.value)
        } else {
            problems.push("`${key}` lists a value that is not a string")
        }
    }
    return strings
}

/// The text of a `vader.json` declaring `manifest`, which `parse_manifest` reads
/// back as the same project.
///
/// @param manifest  the project, written as `write_manifest_json` does.
/// @param indent    spaces per nesting level; 0 writes one line.
export stringify_manifest :: fn(manifest: Manifest, indent: i32 = 0) -> string {
    out :: MutableMap<string, JsonValue> {}
    write_manifest_json(out, manifest)
    return stringify(JsonObject { .entries = out }, indent)
}

/// Add the keys of a `vader.json` declaring `manifest` to `out`, in the order
/// `MANIFEST_KEYS` lists them.
///
/// @param out       the JSON object being built; keys already there stay first.
/// @param manifest  the project. An empty `name` or `version` is left out, as an
///                  absent key reads back the same; the lists are written even
///                  when empty. `problems` is not written.
export write_manifest_json :: fn(out: MutableMap<string, JsonValue>, manifest: Manifest) -> void {
    if manifest.name != "" {
        out["name"] = JsonString { .value = manifest.name }
    }
    if manifest.version != "" {
        out["version"] = JsonString { .value = manifest.version }
    }
    named :: MutableMap<string, JsonValue> {}
    for entry in manifest.entries {
        named[entry.name] = JsonString { .value = entry.path }
    }
    out["includePaths"] = string_array(manifest.include_paths)
    out["entries"] = JsonObject { .entries = named }
    out["assets"] = string_array(manifest.assets)
}

// `strings` as a JSON array.
string_array :: fn(strings: string[]) -> JsonValue {
    items: JsonValue[]: []
    for s in strings {
        items.push(JsonString { .value = s })
    }
    return JsonArray { .items = items }
}

/// Why `name` cannot name an entry, whose binary bears it, on every platform: a
/// project builds the same wherever it is checked out, and for whichever target.
///
/// A name holds ASCII letters, digits, `_` and `-`, does not start with `-`,
/// which would read as an option, and is none of the names Windows reserves for
/// a device (`con`, `nul`, `com1`...), whatever its case.
///
/// @param name  the entry's name, as the project declares it.
/// @return      why, worded to follow the name, or null when it can name a
///              binary.
export entry_name_problem :: fn(name: string) -> string | null {
    if !is_portable_name(name) {
        return "cannot name a binary: use ASCII letters, digits, `_` and `-`, not starting with `-`"
    }
    if is_windows_device_name(name) {
        return "cannot name a binary: Windows reserves it for a device"
    }
    return null
}

/// The entry of `entries` whose binary would be the file of one named `name`:
/// the same name, in any case, since a file system may ignore it.
///
/// @param entries  the entries declared so far.
/// @param name     the name of the next one.
export entry_named :: fn(entries: ManifestEntry[], name: string) -> ManifestEntry | null {
    lower :: name.to_lower()
    for entry in entries {
        if entry.name.to_lower() == lower {
            return entry
        }
    }
    return null
}

// Whether `name` holds only bytes every platform accepts in a file name, and
// none a command line mistakes for an option.
is_portable_name :: fn(name: string) -> bool {
    if name == "" || name.starts_with("-") {
        return false
    }
    for b in name.bytes() {
        if !is_ident_byte(b) && b != '-' {
            return false
        }
    }
    return true
}

// Whether Windows reserves `name` for a device, whatever its case: `con`, `prn`,
// `aux`, `nul`, and `com` or `lpt` with one digit. No file bears one, with an
// extension or without.
is_windows_device_name :: fn(name: string) -> bool {
    lower :: name.to_lower()
    if lower in ["con", "prn", "aux", "nul"] {
        return true
    }
    numbered :: lower.byte_len() == 4 && (lower.starts_with("com") || lower.starts_with("lpt"))
    return numbered && lower.byte_at(3) in '0'..='9'
}

/// What is wrong with an asset of a project, which a build copies beside its
/// binaries under the same relative path.
///
/// @param asset  the file or folder, as the project names it.
/// @return       why it cannot be copied, worded to follow the project file's
///               path, or null when it names something inside the project.
export asset_problem :: fn(asset: string) -> string | null {
    if leaves_project(asset) {
        return "asset `${asset}` is not inside the project; name it relative to the project folder"
    }
    return null
}

// Whether `path` names something outside the project root it is relative to:
// an absolute path, a drive, or a `..` step.
leaves_project :: fn(path: string) -> bool {
    posix :: to_posix(path)
    return posix.starts_with("/") || ":" in posix || ".." in posix.split("/")
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_read_manifest_reads_repo_include_paths :: fn() -> void {
    // Tests run with the repo root as cwd, so `""` joins to `"vader.json"`.
    // The Vader repo declares its library root via `"includePaths": ["lib"]`:
    // guards against a renamed key or a regressed parse silently dropping the
    // search roots (which would break every `std/*` import).
    m :: read_manifest("")
    assert(m.include_paths.len() > 0, "repo manifest lists includePaths")
    found_lib := false
    for p in m.include_paths {
        if p == "lib" {
            found_lib = true
        }
    }
    assert(found_lib, "repo includePaths contains `lib`")
}

@test
test_read_manifest_reads_entries_in_order :: fn() -> void {
    m :: parse_manifest("{\"entries\": {\"app\": \"src/main.vader\", \"tool\": \"tool.vader\"}}")
    assert_eq(m.entries.len(), 2)
    assert_eq(m.entries[0].name, "app")
    assert_eq(m.entries[0].path, "src/main.vader")
    assert_eq(m.entries[1].name, "tool")
    assert_eq(m.problems.len(), 0)
}

@test
test_read_manifest_reports_a_malformed_entry :: fn() -> void {
    m :: parse_manifest("{\"entries\": {\"app\": 42}}")
    assert_eq(m.entries.len(), 0)
    assert_eq(m.problems.len(), 1)
}

@test
test_read_manifest_reports_an_entry_that_cannot_name_a_binary :: fn() -> void {
    m :: parse_manifest("{\"entries\": {\"../../x\": \"main.vader\"}}")
    assert_eq(m.entries.len(), 0)
    assert_eq(m.problems.len(), 1)
}

@test
test_read_manifest_reports_two_entries_that_differ_only_in_case :: fn() -> void {
    m :: parse_manifest("{\"entries\": {\"App\": \"a.vader\", \"app\": \"b.vader\"}}")
    assert_eq(m.entries.len(), 1)
    assert_eq(m.problems.len(), 1)
}

@test
test_entry_name_takes_letters_digits_underscore_and_dash :: fn() -> void {
    for name in ["app", "my-app", "tool_2", "A1", "console", "com10"] {
        assert(entry_name_problem(name) == null, "`${name}` names a binary")
    }
}

@test
test_entry_name_refuses_any_other_byte :: fn() -> void {
    for name in ["../../x", "a/b", "a\\b", "my app", "caf\u{e9}", "a.b", "", "-x"] {
        assert(entry_name_problem(name) != null, "`${name}` does not name a binary")
    }
}

@test
test_entry_name_refuses_a_windows_device :: fn() -> void {
    for name in ["nul", "CON", "com1", "Lpt9"] {
        assert(entry_name_problem(name) != null, "Windows reserves `${name}`")
    }
}

@test
test_read_manifest_reports_an_unknown_key :: fn() -> void {
    m :: parse_manifest("{\"entries\": {\"app\": \"main.vader\"}, \"asset\": [\"a.png\"]}")
    assert_eq(m.entries.len(), 1)
    assert_eq(m.problems.len(), 1)
    assert("`asset`" in m.problems[0], "the problem names the unknown key")
}

@test
test_read_manifest_reports_a_version_that_is_not_a_string :: fn() -> void {
    m :: parse_manifest("{\"version\": 1}")
    assert_eq(m.problems.len(), 1)
}

@test
test_the_editor_schema_describes_exactly_the_manifest_keys :: fn() -> void {
    // Tests run with the repo root as cwd, as above.
    schema :: parse(try_read("editors/common/vader.schema.json") ?? "")
    if schema !is JsonObject {
        assert(false, "the schema is a JSON object, read from the repo root")
        return
    }
    properties :: schema.entries["properties"]
    if properties !is JsonObject {
        assert(false, "the schema lists its properties")
        return
    }
    assert_eq(properties.entries.keys().join(", "), MANIFEST_KEYS.join(", "))
}

@test
test_read_manifest_missing_is_empty :: fn() -> void {
    m :: read_manifest("/no/such/project/root")
    assert(m.include_paths.len() == 0, "absent manifest yields no include-paths")
    assert(m.problems.len() == 0, "absent manifest is not a malformed one")
}

@test
test_a_written_manifest_reads_back_as_the_same_project :: fn() -> void {
    written :: Manifest {
        .name = "my \"game\"",
        .version = "1.2.0",
        .include_paths = ["vendor"],
        .entries = [ManifestEntry { .name = "app", .path = "src/main.vader" }],
        .assets = ["sprite.png"],
    }
    read :: parse_manifest(stringify_manifest(written))
    assert_eq(read.problems.len(), 0)
    assert_eq(read.name, "my \"game\"")
    assert_eq(read.version, "1.2.0")
    assert_eq(read.include_paths.join(","), "vendor")
    assert_eq(read.entries.len(), 1)
    assert_eq(read.entries[0].name, "app")
    assert_eq(read.entries[0].path, "src/main.vader")
    assert_eq(read.assets.join(","), "sprite.png")
}

@test
test_a_full_manifest_writes_every_key_in_order :: fn() -> void {
    out :: MutableMap<string, JsonValue> {}
    write_manifest_json(out, Manifest { .name = "game", .version = "1.2.0" })
    assert_eq(out.keys().join(", "), MANIFEST_KEYS.join(", "))
}

@test
test_a_manifest_without_name_or_version_writes_neither :: fn() -> void {
    out :: MutableMap<string, JsonValue> {}
    write_manifest_json(out, Manifest {})
    assert_eq(out.keys().join(","), "includePaths,entries,assets")
}
