// vader/front/resolver/generated: the names the code the compiler writes is parsed
// under.
//
// Code the compiler writes as source (a source stage's file, the wrappers of an
// interceptor, the body a body stage gives) is parsed under a file name no file on disk has: the kind of
// writer, then what it was written for. Each such name is unique in a load, which
// keeps each span unique: a span-keyed table must never see two nodes on one span.
// A build writes each to a real file (`expanded_name`), where a diagnostic in it
// points.

module "vader/front/resolver"

import "std/collections"
import "std/iter"
import "std/path"
import "std/string"
import "toolchain/diagnostics"
import "toolchain/project"

// Every name `generated_file` makes starts with it.
GENERATED_FILE_PREFIX :: "<generated>:"

// The name the code `kind` writes for `origin` is parsed under.
generated_file :: fn(kind: string, origin: string) -> string =
    "${GENERATED_FILE_PREFIX}${kind}:${origin}"

// The source of the code `kind` writes for `origin`, a file or a module, in the
// module `module_name`: `body` under a first line saying what wrote it, then the
// `module` line. The writer gives the body alone; the first line is part of the
// code, so that its lines are the lines of the file a build writes.
framed_source :: fn(kind: string, origin: string, module_name: string, body: string) -> string =
    "${GENERATED_HEADER} (${kind}) for `${origin}`: do not edit\nmodule \"${module_name}\"\n${body}"

/// What follows a module in the name of the folder of the bodies body stages give
/// its functions, as written out and as recorded: `app.bodies`.
export BODIES_SUFFIX :: ".bodies"

/// The folder of the bodies body stages give the functions of `module_name`.
///
/// @param module_name  the module.
export bodies_folder :: fn(module_name: string) -> string = "${module_name}${BODIES_SUFFIX}"

// What the body of `late` is written for: `app.bodies/Person.to_json_value@4`.
late_body_origin :: fn(late: LateFn, module_name: string) -> string =
    "${bodies_folder(module_name)}/${late_fn_label(late.decl, late.owner)}"

/// The name the body a body stage gives `late` is parsed under, in the module
/// `module_name`: code its stage wrote, for the module.
///
/// @param late         the function given a body.
/// @param module_name  the module that declares it.
export late_body_file :: fn(late: LateFn, module_name: string) -> string =
    generated_file(late.stage, late_body_origin(late, module_name))

/// The source the body `text` of `late` is parsed from: `text` holds the block, the
/// lines around it the header of generated code and a function that holds it,
/// whose signature is not read.
///
/// @param late         the function given a body.
/// @param module_name  the module that declares it.
/// @param text         the body the stage gave, a block.
export late_body_source :: fn(late: LateFn, module_name: string, text: string) -> string {
    label :: late_fn_label(late.decl, late.owner)
    note :: "// The body `${late.stage}` gives `${label}`: the function around it only holds it."
    held :: "${note}\nlate_body :: fn() -> void ${text}\n"
    return framed_source(late.stage, late_body_origin(late, module_name), module_name, held)
}

/// Whether `file` is a name code the compiler wrote is parsed under: code no user
/// wrote, which a warning about what the user wrote leaves alone.
///
/// @param file  the file a span names.
export is_generated_file :: fn(file: string) -> bool = file.starts_with(GENERATED_FILE_PREFIX)

// Whether `file` is a name the code `kind` writes is parsed under.
is_generated_by :: fn(file: string, kind: string) -> bool =
    file.starts_with("${GENERATED_FILE_PREFIX}${kind}:")

/// Code the compiler wrote as source, as it was parsed.
export GeneratedSource :: struct {
    /// The name it was parsed under.
    file: string
    content: string
}

/// The code the compiler wrote as source for a load, and what it could have
/// written it for.
export GeneratedCode :: struct {
    sources: GeneratedSource[] = []
    /// The files and the modules of the load, each a name code is written for.
    origins: string[] = []
}

/// The code the compiler wrote as source for the modules of `loaded` the build
/// named, and the bodies its body stages gave: the toolchain's are left out, an
/// error in them being the compiler's.
///
/// @param loaded  a loaded project.
export generated_code :: fn(loaded: LoadedProject) -> GeneratedCode {
    out :: GeneratedCode {}
    for [_, lm] in loaded.modules {
        if lm.module.origin == .Toolchain {
            continue
        }
        out.origins.push(lm.module.module_name)
        for f in lm.module.files {
            if is_generated_file(f.path) {
                out.sources.push(GeneratedSource { .file = f.path, .content = f.content })
            } else {
                out.origins.push(f.path)
            }
        }
    }
    out.sources.push_all(loaded.given_bodies)
    return out
}

/// The names, under the folder of each kind, of the code written for `origins`:
/// a build owns the files of `build/expanded/` so named, and no other.
///
/// @param origins  the files and modules of a load (`GeneratedCode.origins`).
/// @param root     the folder of the project, or of the entry file on its own.
export expanded_origin_names :: fn(origins: string[], root: string) -> Set<string> {
    out :: Set<string> {}
    for origin in origins {
        out.add(origin_name(origin, root))
    }
    return out
}

/// Where a build writes the code parsed under `file`, under the folder of the
/// generated code: `<kind>/<the file it was written for>`, named from `root`, or
/// `<kind>/<module>.vader`. Null for a file a user wrote.
///
/// @param file  the file a span names.
/// @param root  the folder of the project, or of the entry file on its own.
export expanded_name :: fn(file: string, root: string) -> string | null {
    if !is_generated_file(file) {
        return null
    }
    rest :: file.byte_slice(GENERATED_FILE_PREFIX.byte_len(), file.byte_len())
    colon :: rest.index_of(':') else return null
    origin :: rest.byte_slice(colon + 1, rest.byte_len())
    return "${rest.byte_slice(0, colon)}/${origin_name(origin, root)}"
}

// The name the code written for `origin` takes in the folder of its kind: a file
// of the project, named from `root` (its file name alone when outside), or a
// module.
origin_name :: fn(origin: string, root: string) -> string {
    if !origin.ends_with(".vader") {
        // The name of a WIT interface holds `:`, which Windows refuses in a file
        // name: it takes the escape of the mangling.
        return "${origin.replace_all(":", "_0")}.vader"
    }
    file :: normalized_path(origin)
    within :: relative_to(file, normalized_path(root))
    if within == file {
        return origin.to_path().filename()
    }
    return within
}

/// Lead each diagnostic of `diags` in code the compiler wrote to the code a user
/// wrote that asked for it (`Diagnostic.related`).
///
/// @param diags   the diagnostics, linked in place.
/// @param loaded  the project they were found in.
export link_generated_origins :: fn(diags: Diagnostic[], loaded: LoadedProject) -> void {
    if !diags.any_match((d) -> is_generated_file(d.primary.start.file)) {
        return
    }
    origins :: Map<string, CodeOrigin[]> {}
    for [_, lm] in loaded.modules {
        for f in lm.module.files {
            if !f.origins.is_empty() {
                origins[f.path] = f.origins
            }
        }
    }
    for i in 0..<diags.len() {
        d :: diags[i]
        ranges :: origins[d.primary.start.file] else continue
        offset :: d.primary.start.offset
        for o in ranges {
            if o.start <= offset && offset < o.end {
                diags[i] = Diagnostic { ...d, .related = d.related + [o.origin] }
                break
            }
        }
    }
}

/// The file the code parsed under `file` was written for: the written file a glue
/// of interceptors wraps the functions of, `file` itself for any other.
///
/// @param file  the file a span names.
export written_file_of :: fn(file: string) -> string {
    if !is_generated_by(file, INTERCEPT_KIND) {
        return file
    }
    return file.byte_slice(generated_file(INTERCEPT_KIND, "").byte_len(), file.byte_len())
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_expanded_name_follows_the_written_file :: fn() -> void {
    written :: expanded_name("<generated>:intercept:./app/main.vader", ".") else ""
    assert_eq(written, "intercept/app/main.vader")
}

@test
test_expanded_name_follows_the_module :: fn() -> void {
    written :: expanded_name("<generated>:displayable:app/shapes", ".") else ""
    assert_eq(written, "displayable/app/shapes.vader")
}

@test
test_expanded_name_of_a_wit_interface_holds_no_colon :: fn() -> void {
    written :: expanded_name("<generated>:wit:wasi:clocks/types@0.3.0", ".") else ""
    assert_eq(written, "wit/wasi_0clocks/types@0.3.0.vader")
}

@test
test_expanded_name_puts_a_body_beside_its_module :: fn() -> void {
    written :: expanded_name("<generated>:json:app.bodies/Person.to_json_value@4", ".") else ""
    assert_eq(written, "json/app.bodies/Person.to_json_value@4.vader")
}

@test
test_expanded_name_leaves_a_written_file :: fn() -> void {
    assert(expanded_name("main.vader", ".") == null, "a written file has no expanded name")
}
