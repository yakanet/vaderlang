// vader/front/resolver/displayable: the `Display` an `@displayable` enum is given.
//
// The first source stage of the compiler (`source_stages.vader`): the impl is
// written out as source into a file of the enum's module, so every later pass
// meets an ordinary `E implements Display` and the generated code goes through
// the checks a written one does. Each impl reports at the decorator that asked
// for it, since its own spans name no file on disk: a conflict with a written
// impl points there, and so does an "implementations" lookup.

module "vader/front/resolver"

import "std/iter"
import "std/string_builder"
import "toolchain/span"
import "toolchain/stage"
AST :: import "toolchain/ast"

// The name `DisplayableStage` describes itself under, and generates under.
DISPLAYABLE_STAGE :: "displayable"

// The `Display` of each `@displayable` enum of a module.
DisplayableStage :: struct {}

DisplayableStage implements SourceStage {
    describe :: fn(self) = SourceSpec {
        .name = DISPLAYABLE_STAGE,
        .given = [DecoratedWith { .marker = .Displayable }],
    }

    run :: fn(self, input: Sources) -> Generated {
        text :: StringBuilder {}
        anchors: Span[]: []
        for program in input.files {
            for e in program.decls.filter_is<AST.EnumDecl>() {
                marker :: AST.find_compiler_decorator(e.decorators, .Displayable) else continue
                text.append("${e.name} implements Display {\n")
                text.append("    to_string :: fn(self) -> string = match self {\n")
                for v in e.variants {
                    text.append("        .${v.name} -> \"${v.name}\"\n")
                }
                text.append("    }\n}\n")
                anchors.push(marker.span)
            }
        }
        return Generated { .text = text.to_string(), .anchors = anchors }
    }
}

/// Whether `decl` is the `Display` an `@displayable` enum is given.
///
/// @param decl  an impl.
export is_displayable_impl :: fn(decl: AST.ImplDecl) -> bool =
    decl.members.any_match((m) -> is_generated_by(m.span.start.file, DISPLAYABLE_STAGE))
