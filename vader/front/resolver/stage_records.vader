// vader/front/resolver/stage_records: what the stages of a project's driver
// wrote in its last build, which a load with no driver replays.
//
// A source stage is pure: what it writes follows from its files alone, read
// without their bodies, nothing typed. A served build records, for each stage of
// the driver and each module it ran on, a key of the files it read and what it
// wrote, under `STAGE_RECORDS_DIR` of the project (the build server writes them).
// `vader run`, `vader test` and the language server load the project once the
// driver is gone, and replay the records. A record whose key no longer matches was
// written for files changed since: it is replayed all the same, with a warning,
// until the next build. A change to the driver itself shows at the next build.
//
// A body stage is recorded the same way, one record per function, its key that of
// the declarations of the module, decorator values included.

module "vader/front/resolver"

import "std/collections"
import "std/fs"
import "std/iter"
import "std/numbers"
import "std/path"
import "std/string"
import "toolchain/ast"
import "toolchain/diagnostics"
import "toolchain/protocol"
import "toolchain/span"
import "toolchain/stage"

/// Where a build records what the stages of its driver wrote, under the project.
export STAGE_RECORDS_DIR :: "build/stages"

// The file, under `STAGE_RECORDS_DIR`, describing the stages of the last build.
STAGE_PLAN_FILE :: "plan"

/// The files of a stage of the driver as the driver receives them: the
/// declarations that cross.
///
/// @param input  what the stage is given.
export driver_sources :: fn(input: Sources) -> Sources {
    files: Program[]: []
    for program in input.files {
        files.push(Program { ...program, .decls = program.decls.filter(crosses).collect() })
    }
    return Sources { .module_name = input.module_name, .files = files }
}

/// How the driver of `project_root` names the files of a load: from the project
/// folder, whatever the command called them, so that what a stage reads, and the
/// key of its record, are the files alone.
export DriverNames :: struct {
    /// Each file of the load to the name the driver reads it under.
    sent: Map<string, string> = Map<string, string> {}
    /// Each name the driver reads to the file of the load.
    read: Map<string, string> = Map<string, string> {}
}

/// The names the driver of `project_root` reads `files` under: each from the
/// project folder, a file outside it and code the compiler wrote under their own.
///
/// @param files         the files of the load a stage reads.
/// @param project_root  the project folder; null or empty for a file on its own,
///                      whose records are under the working directory.
export driver_names :: fn(files: string[], project_root: string | null) -> DriverNames {
    names :: DriverNames {}
    root :: normalized_path(records_folder(project_root))
    for file in files {
        if is_generated_file(file) {
            continue
        }
        // Outside the folder, `relative_to` hands the normalised path back: the file
        // keeps its name.
        normalized :: normalized_path(file)
        name :: relative_to(normalized, root)
        if name != normalized && name != file {
            names.sent[file] = name
            names.read[name] = file
        }
    }
    return names
}

/// The files `sources` hands a source stage.
///
/// @param sources  what a source stage reads.
export source_files :: fn(sources: Sources) -> string[] = sources.files.map((f) -> f.file).collect()

// The folder the records of `project_root` are under: the working directory for a
// file on its own.
records_folder :: fn(project_root: string | null) -> string {
    if project_root == null || project_root == "" {
        return "."
    }
    return project_root
}

/// The files the declarations of `request` name.
///
/// @param request  what a body stage is asked.
export request_files :: fn(request: BodyRequest) -> string[] {
    files: string[]: [request.decl.span.start.file]
    for d in request.declarations {
        files.push(decl_span(d).start.file)
    }
    return files.distinct().collect()
}

/// `reports` of a stage of the driver, their spans named as the load names them.
///
/// @param reports  what the stage reported.
/// @param names    how the driver named the files (`driver_names`).
export reports_read :: fn(reports: ReportFrame[], names: DriverNames) -> ReportFrame[] =
    reports.map((r) -> ReportFrame { ...r, .span = renamed_span(r.span, names.read) }).collect()

/// `anchors` a source stage of the driver answered, named as the load names them.
///
/// @param anchors  the spans the generated declarations report at.
/// @param names    how the driver named the files (`driver_names`).
export anchors_read :: fn(anchors: Span[], names: DriverNames) -> Span[] =
    anchors.map((a) -> renamed_span(a, names.read)).collect()

/// The key of the files `sources` hands the stage `stage`: equal for files that
/// read alike.
///
/// @param stage    the name of the stage.
/// @param sources  its files, as `driver_sources` makes them.
/// @param names    how the driver names them (`driver_names`).
export record_key :: fn(stage: string, sources: Sources, names: DriverNames) -> string {
    frame :: SourceStageFrame {
        .stage = stage,
        .sources = sources,
        .names = names.sent,
    }
    return server_payload(frame).hash().to_hex()
}

/// The folder of the records of `project_root`.
///
/// @param project_root  the project folder.
export stage_records_dir :: fn(project_root: string) -> string =
    join_path(project_root, STAGE_RECORDS_DIR)

/// The file describing the stages the last build of `project_root` ran.
///
/// @param project_root  the project folder.
export stage_plan_path :: fn(project_root: string) -> string =
    join_path(stage_records_dir(project_root), STAGE_PLAN_FILE)

/// The function a body stage is asked a body for, the declarations that cross
/// only, as the driver receives them.
///
/// @param input  what the stage is given.
export driver_request :: fn(input: BodyRequest) -> BodyRequest =
    BodyRequest { ...input, .declarations = input.declarations.filter(crosses).collect() }

/// The key of the request `request` hands the body stage `stage`.
///
/// @param stage    the name of the stage.
/// @param request  what it is asked, as `driver_request` makes it.
/// @param names    how the driver names its files (`driver_names`).
export body_record_key :: fn(stage: string, request: BodyRequest, names: DriverNames) -> string {
    frame :: BodyStageFrame {
        .stage = stage,
        .request = request,
        .names = names.sent,
    }
    return server_payload(frame).hash().to_hex()
}

/// The file recording the body the body stage `stage` gave the function of
/// `request`: under the module, the function's name, after its impl's type for a
/// member.
///
/// @param project_root  the project folder.
/// @param stage         the name of the stage.
/// @param request       what it was asked.
export body_record_path :: fn(project_root: string, stage: string, request: BodyRequest) -> string {
    folder :: bodies_folder(request.module_name)
    bodies :: stage_records_dir(project_root).join_path(stage).join_path(folder)
    return join_path(bodies, "${late_fn_label(request.decl, request.owner)}.record")
}

/// The file recording what the stage `stage` wrote for the module `module_name`.
///
/// @param project_root  the project folder.
/// @param stage         the name of the stage.
/// @param module_name   the module.
export stage_record_path :: fn(project_root: string, stage: string, module_name: string) -> string =
    stage_records_dir(project_root).join_path(stage).join_path("${module_name}.record")

/// A record: its key on a line, then the answer of the stage as the driver sent
/// it.
///
/// @param key     the key of what the stage read (`record_key`, `body_record_key`).
/// @param answer  what it gave back.
export record_text :: fn(key: string, answer: GeneratedFrame | BodyFrame) -> string =
    "${key}\n${driver_payload(answer)}"

/// A report of the driver as a diagnostic, under the hook code it names.
///
/// @param frame  the report.
/// @error        `ProtocolError` when it names no hook code.
export hook_diagnostic :: fn(frame: ReportFrame) -> Diagnostic | ProtocolError {
    for code in HookCode {
        if CodeInfo(code).id == frame.code {
            return hook_error(code, frame.span, frame.detail)
        }
    }
    return ProtocolError { .msg = "`${frame.code}` is no hook code" }
}

// The stages the last build of `project` recorded: none when no build of it ran
// a stage.
recorded_plan :: fn(project: string) -> StagePlan {
    text :: read_file_string(stage_plan_path(project)) else return StagePlan {}
    return decode_stage_plan(text) else StagePlan {}
}

// The source stages the last build of `project` recorded, which replay what they
// wrote.
replayed_stages :: fn(project: string) -> SourceStage[] {
    stages: SourceStage[]: []
    for spec in recorded_plan(project).sources {
        stages.push(ReplayedStage { .spec = spec, .project_root = project })
    }
    return stages
}

// The body stages the last build of `project` recorded, which replay the bodies
// they gave.
replayed_body_stages :: fn(project: string) -> BodyStage[] {
    stages: BodyStage[]: []
    for name in recorded_plan(project).bodies {
        stages.push(ReplayedBodyStage { .name = name, .project_root = project })
    }
    return stages
}

// A body stage of the driver of the last build, which replays the bodies it gave
// then. A function it gave none is left an empty body, with the warning.
ReplayedBodyStage :: struct {
    name: string
    project_root: string
}

ReplayedBodyStage implements BodyStage {
    describe :: fn(self) -> BodySpec = BodySpec { .name = self.name }

    run :: fn(self, input: BodyRequest) -> Body {
        request :: driver_request(input)
        at :: input.decl.name_span
        why :: "`${self.name}` has not given `${input.decl.name}` a body"
        missing :: Body { .text = "{}", .diagnostics = [replay_warning_at(at, why)] }
        recorded :: read_recorded(body_record_path(self.project_root, self.name, request))
            else return missing
        answer :: recorded.answer
        if answer !is BodyFrame {
            return missing
        }
        names :: driver_names(request_files(request), self.project_root)
        diagnostics :: replayed_diagnostics(reports_read(answer.reports, names))
        if recorded.key != body_record_key(self.name, request, names) {
            stale :: "`${self.name}` read other declarations of `${input.module_name}`"
            diagnostics.push(replay_warning_at(at, stale))
        }
        return Body { .text = answer.text, .diagnostics = diagnostics }
    }
}

// The reports a record holds as diagnostics, but for one naming no hook code: a
// record of another compiler's codes still replays.
replayed_diagnostics :: fn(reports: ReportFrame[]) -> Diagnostic[] {
    diagnostics: Diagnostic[]: []
    for report in reports {
        d :: hook_diagnostic(report) else continue
        diagnostics.push(d)
    }
    return diagnostics
}

// A stage of the driver of the last build, which replays what it wrote then.
ReplayedStage :: struct {
    spec: SourceSpec
    project_root: string
}

ReplayedStage implements SourceStage {
    describe :: fn(self) -> SourceSpec = self.spec

    run :: fn(self, input: Sources) -> Generated {
        name :: self.spec.name
        path :: stage_record_path(self.project_root, name, input.module_name)
        why :: "`${name}` has not run on `${input.module_name}`"
        missing :: Generated { .diagnostics = [replay_warning(input, why)] }
        recorded :: read_recorded(path) else return missing
        answer :: recorded.answer
        if answer !is GeneratedFrame {
            return missing
        }
        names :: driver_names(source_files(input), self.project_root)
        diagnostics :: replayed_diagnostics(reports_read(answer.reports, names))
        if recorded.key != record_key(name, driver_sources(input), names) {
            diagnostics.push(replay_warning(input, "`${name}` read other files of `${input.module_name}`"))
        }
        return Generated {
            .text = answer.text,
            .anchors = anchors_read(answer.anchors, names),
            .diagnostics = diagnostics,
        }
    }
}

// A record read back: its key, and the answer of the stage.
Recorded :: struct {
    key: string
    answer: DriverFrame
}

// The record in the file `path`, null when there is none or it does not read.
read_recorded :: fn(path: string) -> Recorded | null {
    text :: read_file_string(path) else return null
    newline :: text.index_of('\n') else return null
    frame :: decode_driver_frame(text.byte_slice(newline + 1, text.byte_len())) else return null
    return Recorded { .key = text.byte_slice(0, newline), .answer = frame }
}

// The warning that a stage is replayed from an earlier build, at the head of the
// first file it reads.
replay_warning :: fn(input: Sources, why: string) -> Diagnostic {
    at :: input.files[0].span.start
    return replay_warning_at(Span { .start = at, .end = at }, why)
}

// The warning that a stage is replayed from an earlier build, at `span`.
replay_warning_at :: fn(span: Span, why: string) -> Diagnostic {
    detail :: "${why} since the last build: build the project again"
    return new_diagnostic(.Warning, CodeInfo(HookCode.StaleStageReplay), span, detail)
}

// ---- tests ----------------------------------------------------------------

import "std/abort"
import "std/env"
import "std/testing"
import "toolchain/parser"

// The files of `app` a stage reads: one, with `source`, under `path`.
app_sources :: fn(source: string, path: string = "src/main.vader") -> Sources =
    Sources { .module_name = "app", .files = [parse_source(source, path).program] }

// A project whose last build recorded that `echo` wrote `text` for `recorded`.
recorded_project :: fn(recorded: Sources, text: string) -> string {
    project :: create_unique_dir(temp_dir(), "stage_records.") else panic("no temporary folder")
    record_echo(project, recorded, text)
    return project
}

// Record in `project` that `echo` wrote `text` for `recorded`.
record_echo :: fn(project: string, recorded: Sources, text: string) -> void {
    create_dir(join_path(stage_records_dir(project), "echo"))
    write_file(stage_plan_path(project), encode_stage_plan(StagePlan { .sources = [SourceSpec { .name = "echo" }] }))
    names :: driver_names(source_files(recorded), project)
    key :: record_key("echo", driver_sources(recorded), names)
    write_file(stage_record_path(project, "echo", "app"), record_text(key, GeneratedFrame { .text = text }))
}

// The stage of `project` replayed on `input`.
replayed :: fn(project: string, input: Sources) -> Generated {
    stages :: replayed_stages(project)
    assert_eq(stages.len(), 1)
    return stages[0].run(input)
}

@test
test_a_load_replays_what_the_last_build_recorded :: fn() -> void {
    input :: app_sources("module \"app\"\nP :: struct {}\n")
    project :: recorded_project(input, "x :: 1")
    defer remove(project, RemoveOptions { .recursive = true })
    generated :: replayed(project, input)
    assert_eq(generated.text, "x :: 1")
    assert_eq(generated.diagnostics.len(), 0)
}

@test
test_the_driver_reads_a_file_of_the_project_from_its_folder :: fn() -> void {
    names :: driver_names(["/p/src/main.vader", "/elsewhere/x.vader"], "/p")
    assert_eq(names.sent["/p/src/main.vader"] else "", "src/main.vader")
    assert_eq(names.read["src/main.vader"] else "", "/p/src/main.vader")
    assert(names.sent["/elsewhere/x.vader"] == null, "a file outside keeps its name")
}

@test
test_a_file_on_its_own_is_named_from_the_working_directory :: fn() -> void {
    names :: driver_names(["./src/main.vader", "src/lib.vader"], null)
    assert_eq(names.sent["./src/main.vader"] else "", "src/main.vader")
    assert(names.sent["src/lib.vader"] == null, "a name already from there is kept")
}

@test
test_a_file_named_otherwise_replays_without_a_warning :: fn() -> void {
    project :: create_unique_dir(temp_dir(), "stage_records.") else panic("no temporary folder")
    defer remove(project, RemoveOptions { .recursive = true })
    source :: "module \"app\"\nP :: struct {}\n"
    record_echo(project, app_sources(source, join_path(project, "src/main.vader")), "x :: 1")
    generated :: replayed(project, app_sources(source, join_path(project, "src/./main.vader")))
    assert_eq(generated.text, "x :: 1")
    assert_eq(generated.diagnostics.len(), 0)
}

@test
test_a_record_for_other_files_is_replayed_with_a_warning :: fn() -> void {
    project :: recorded_project(app_sources("module \"app\"\nP :: struct {}\n"), "x :: 1")
    defer remove(project, RemoveOptions { .recursive = true })
    generated :: replayed(project, app_sources("module \"app\"\nQ :: struct {}\n"))
    assert_eq(generated.text, "x :: 1")
    assert_eq(generated.diagnostics.len(), 1)
    assert_eq(generated.diagnostics[0].code.id, "H6016")
    assert(generated.diagnostics[0].severity == .Warning, "a stale replay only warns")
}

@test
test_a_module_no_build_ran_the_stage_on_gets_a_warning :: fn() -> void {
    input :: app_sources("module \"app\"\nP :: struct {}\n")
    project :: recorded_project(input, "x :: 1")
    defer remove(project, RemoveOptions { .recursive = true })
    stages :: replayed_stages(project)
    generated :: stages[0].run(Sources { ...input, .module_name = "other" })
    assert_eq(generated.text, "")
    assert_eq(generated.diagnostics[0].code.id, "H6016")
}
