// vader/front/resolver/impl_members: every impl filled from its trait, before the
// resolver walks a body.
//
// An impl names its trait, and the trait may come from any module, `std/core`
// included. This pass finds it in the scope the resolver will build for the impl's
// file, then fills the impl with what the trait implies (`materialize.vader`): the
// method a short impl stands for, the default methods it does not override. The resolver then walks those bodies with `self`
// and the trait's parameters bound like any written member's.

module "vader/front/resolver"

import "std/collections"
import "std/iter"
AST :: import "toolchain/ast"
import "toolchain/diagnostics"
import "vader/core/symbol"

/// Fill every impl of `project` with the members its trait implies, before the
/// resolver walks a body: the method a short impl (`Type implements Trait ->
/// expr`) stands for, and a declaration of each
/// default method the impl inherits (`FnDecl.inherits`). Works across modules, so
/// `Foo implements Display -> "..."` finds `Display` in `std/core`.
///
/// @param project     the loaded project ; its impls are filled in place.
/// @param name_index  the loaded modules by name (`module_index_by_name`).
/// @param core_seed   the prelude's names (`build_core_seed`).
/// @error             R2009 when an impl's trait name binds to a struct, an enum or
///                    an alias, R2007 when it binds to nothing else that is a
///                    trait, R2016 when a short impl targets a trait with other
///                    than one required method ; all pushed onto `project.diags`.
export materialize_impl_members :: fn(
    project: LoadedProject,
    name_index: Map<string, LoadedModule>,
    core_seed: Map<string, Symbol>,
) -> void {
    for [_, loaded] in project.modules {
        for file in loaded.module.files {
            materialize_file_impl_members(project, loaded, file, name_index, core_seed)
        }
    }
}

// The impls of one file : their trait names resolve in that file's scope, with the
// imports the file wrote.
materialize_file_impl_members :: fn(
    project: LoadedProject,
    loaded: LoadedModule,
    file: SourceFile,
    name_index: Map<string, LoadedModule>,
    core_seed: Map<string, Symbol>,
) -> void {
    decls :: file.program.decls
    if !has_impl_decl(decls) {
        return
    }
    imports :: file_imports(loaded.collected, file.program.file)
    no_builtins :: Map<string, Symbol> {}
    scope :: file_root_scope(no_builtins, loaded.collected, imports, name_index, core_seed)
    for decl in decls {
        if decl !is AST.ImplDecl {
            continue
        }
        head :: AST.impl_trait_head(decl)
        found :: find_impl_trait_decl(
            head,
            AST.impl_trait_args(decl),
            loaded,
            scope,
            name_index,
            project,
            core_seed,
        )
        if found.trait_decl is null {
            written :: "`${AST.impl_trait_written_name(decl)}`"
            diag :: if found.hidden {
                resolver_error(.SymbolNotExported, head.span, written)
            } else if found.other_kind != "" {
                resolver_error(.TraitNameNotATrait, head.span, "${written} is ${found.other_kind}")
            } else {
                resolver_error(.UnresolvedTypeName, head.span, written)
            }
            project.diags.push(diag)
            continue
        }
        trait_decl :: found.trait_decl
        check_short_impl_arity(decl, trait_decl, project.diags)
        // Always materialise the SAM rename: `check_short_impl_arity`
        // already marked invalid synthetics as `materialized=true` so
        // body-walk + body-typecheck skip them, but the rename still
        // lets the T3036 "missing method" loop credit the SAM-named
        // slot. Without the rename, both required methods would be
        // flagged missing instead of just the unprovided one.
        materialize_sam_members(decl, trait_decl, found.args, loaded.node_id_factory)
        // A default method the impl does not write is declared for it, its
        // signature substituted ; the body stays the trait's.
        materialize_default_members(decl, trait_decl, found.args, loaded.node_id_factory)
    }
}

/// R2016 : `Type implements Trait -> expr` desugars one body into the
/// trait's lone required method. When the trait has 0 or 2+ required
/// methods, the sugar is ill-defined: emit once per synthetic member.
check_short_impl_arity :: fn(
    impl_: AST.ImplDecl,
    trait_: AST.TraitDecl,
    diags: Diagnostic[],
) -> void {
    required :: required_methods(trait_.members).len()
    if required == 1 {
        return
    }
    for i in 0..<impl_.members.len() {
        m :: impl_.members[i]
        if m.sam_synthetic {
            diags.push(
                resolver_error(
                    .ShortImplFormSingleMethod,
                    m.span,
                    "trait `${AST.impl_trait_name(impl_)}` has ${required} required methods",
                ),
            )
            // Mark the synthetic body as already-typechecked so the
            // walker skips it: otherwise T3020 / R2006 on `self` cascade
            // out of a body the user can't fix without restructuring the
            // impl. The walkers skip a member both `sam_synthetic` and `materialized`.
            impl_.members[i].materialized = true
        }
    }
}

/// True when `decls` declares at least one impl.
///
/// @param decls  the declarations of one file.
export has_impl_decl :: fn(decls: AST.Decl[]) -> bool = !decls.filter_is<AST.ImplDecl>().is_empty()

// The declaration of the trait an impl in `loaded` names. Runs before the
// resolver, so it walks the scope the resolver will build : `scope`
// (`file_root_scope`, without builtins), the module's own names and imports, then
// the prelude and the wildcard imports.
find_impl_trait_decl :: fn(
    head: AST.Expr,
    written: AST.TypeExpr[],
    loaded: LoadedModule,
    scope: Map<string, Symbol>,
    name_index: Map<string, LoadedModule>,
    project: LoadedProject,
    core_seed: Map<string, Symbol>,
) -> TraitLookup {
    unresolved :: TraitLookup { .trait_decl = null, .other_kind = "" }
    sym :: trait_in_file_scope(head, loaded, scope, name_index) else return unresolved
    if head is AST.FieldExpr && sym.visibility == .Private {
        return TraitLookup { .trait_decl = null, .other_kind = "", .hidden = true }
    }
    if sym.kind != .Trait {
        // @partial: only a type declaration is reported by its kind ; any other
        // binding reads as an unresolved type name.
        other_kind :: @partial match sym.kind {
            .Struct    -> "a struct"
            .Enum      -> "an enum"
            .TypeAlias -> "an alias"
            _          -> ""
        }
        return TraitLookup { .trait_decl = null, .other_kind = other_kind }
    }
    owner :: project.modules[sym.module] else return unresolved
    named :: trait_named(owner, sym.name) else return unresolved
    return through_aliases(named, owner, written, name_index, project, core_seed)
}

// The trait `named`, declared in `owner`, stands for, its arguments `written` as
// the impl writes them: `named` itself, or the trait an alias names, its own
// parameters bound in the arguments it gives (`CheckStage` for `Stage<Checked,
// Diagnostic[]>`). A name the alias writes binds in the scope of its own file.
through_aliases :: fn(
    named: DeclaredTrait,
    owner: LoadedModule,
    written: AST.TypeExpr[],
    name_index: Map<string, LoadedModule>,
    project: LoadedProject,
    core_seed: Map<string, Symbol>,
) -> TraitLookup {
    unresolved :: TraitLookup { .trait_decl = null, .other_kind = "" }
    no_builtins :: Map<string, Symbol> {}
    current := named
    module := owner
    args := written
    // An alias of an alias is followed ; one that comes back to itself stops here.
    for _ in 0..<AST.MAX_TRAIT_ALIAS_DEPTH {
        target :: AST.trait_alias_target(current.decl) else {
            return TraitLookup { .trait_decl = current.decl, .other_kind = "", .args = args }
        }
        imports :: file_imports(module.collected, current.file)
        scope :: file_root_scope(no_builtins, module.collected, imports, name_index, core_seed)
        sym :: trait_in_file_scope(AST.instance_head(target), module, scope, name_index)
            else return unresolved
        if sym.kind != .Trait {
            return TraitLookup { .trait_decl = null, .other_kind = "an alias of no trait" }
        }
        next_module :: project.modules[sym.module] else return unresolved
        next :: trait_named(next_module, sym.name) else return unresolved
        subst :: new_subst()
        bind_trait_params(subst, current.decl, args)
        args = AST.instance_args(target).map((a) -> substitute_type_expr(a, subst)).collect()
        current = next
        module = next_module
    }
    return TraitLookup { .trait_decl = null, .other_kind = "an alias that names itself" }
}

// A trait declaration, and the file that declares it.
DeclaredTrait :: struct {
    decl: AST.TraitDecl
    file: string
}

// The trait `name` of `owner`.
trait_named :: fn(owner: LoadedModule, name: string) -> DeclaredTrait | null {
    for f in owner.module.files {
        for d in f.program.decls.filter_is<AST.TraitDecl>() {
            if d.name == name {
                return DeclaredTrait { .decl = d, .file = f.program.file }
            }
        }
    }
    return null
}

// The symbol the trait name `head` binds to in a file's `scope`: a name of the
// file, or a member of the module a namespace alias imports (`Ns.Trait`). Null
// when it binds to nothing.
trait_in_file_scope :: fn(
    head: AST.Expr,
    loaded: LoadedModule,
    scope: Map<string, Symbol>,
    name_index: Map<string, LoadedModule>,
) -> Symbol | null {
    if head is AST.IdentExpr {
        return name_in_file_scope(head.name, loaded, scope, name_index)
    }
    if head !is AST.FieldExpr || head.target !is AST.IdentExpr {
        return null
    }
    alias :: scope[head.target.name] else return null
    info :: loaded.collected.imports[alias.id] else return null
    if info.imported_name != null {
        return null
    }
    imported :: name_index[info.path] else return null
    return imported.collected.symbols[head.field]
}

// The symbol `name` binds to in a file's `scope` (`file_root_scope`), an import
// followed to the declaration it names. Null when the name binds to nothing.
name_in_file_scope :: fn(
    name: string,
    loaded: LoadedModule,
    scope: Map<string, Symbol>,
    name_index: Map<string, LoadedModule>,
) -> Symbol | null {
    own :: scope[name] else return null
    if own.kind != .ImportBinding {
        return own
    }
    info :: loaded.collected.imports[own.id] else return null
    imported :: info.imported_name else return null
    target :: name_index[info.path] else return null
    return target.collected.symbols[imported]
}

// What an impl's trait name binds to : the trait, or the kind of the other type it
// names, so that the impl reports R2009 rather than R2007.
TraitLookup :: struct {
    trait_decl: AST.TraitDecl | null
    /// `"a struct"` / `"an enum"` / `"an alias"` when the name binds to that kind
    /// of declaration, or what a trait alias that reaches no trait is ; empty
    /// otherwise. Only meaningful when `trait_decl` is null.
    other_kind: string
    /// The name is `Ns.Trait`, and its module does not export `Trait`.
    hidden: bool = false
    /// The arguments the impl gives `trait_decl`: those it writes, or for an
    /// alias, those the alias gives in its own terms, the impl's substituted.
    args: AST.TypeExpr[] = []
}
