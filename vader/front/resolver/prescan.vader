// vader/front/resolver/prescan: project-level pre-resolve checks.
//
// Runs after `wire_imports` (so the redirect table is available) and
// before the typechecker walks bodies. Today the pass owns the R2018
// orphan-rule check : `Type implements Trait<Args>` is legal only when
// the current module owns `Type` *or* `Trait` (primitives exempt).
//
// Lives in its own file so future project-level checks (e.g.
// cross-module dup-decl) have a clear home.

module "vader/front/resolver"

import "std/collections"
import "std/iter"
import "toolchain/diagnostics"
import "vader/core/symbol"
AST :: import "toolchain/ast"

/// Walk every ImplDecl in `loaded.module.files` and push R2018 when
/// neither the for-type nor the trait is owned by `module_id`.
/// Symbols come from `collected.symbols` and the file's import bindings
/// (for the trait) and from `idents` (for the for-type, which IS walked
/// through `walk_expr`). Both resolve through `wire_imports`' redirect
/// table to follow ImportBinding to the concrete owner, and a namespace
/// alias to its module.
///
/// Diagnostics are pushed into `diags` so the caller decides where
/// they land (resolver-stage CLI surfaces, typecheck orchestrator
/// folds them into its main bucket).
///
/// @param loaded         loaded module (we walk files[*].program.decls).
/// @param module_id      module id used as the owner reference.
/// @param idents         body-walker `idents` table for this module
///                       (`ResolvedModule.idents`). Used for `for_type`.
/// @param wire_targets   import-redirect table from `wire_imports` ;
///                       lets us follow ImportBinding to the concrete
///                       export.
/// @param diags          diagnostics sink ; R2018s appended here.
export run_orphan_rule_check_for_module :: fn(
    loaded: LoadedModule, module_id: string,
    idents: Map<u64, Symbol>, wire_targets: ImportTargetTable,
    diags: Diagnostic[],
) -> void {
    for file in loaded.module.files {
        bindings :: file_imports(loaded.collected, file.program.file).bindings
        for decl in file.program.decls.filter_is<AST.ImplDecl>() {
            check_orphan_rule(decl, module_id, loaded.collected.symbols, bindings,
                idents, wire_targets, diags)
        }
    }
}

check_orphan_rule :: fn(
    decl: AST.ImplDecl, module_id: string,
    module_symbols: Map<string, Symbol>, bindings: Map<string, Symbol>,
    idents: Map<u64, Symbol>, wire_targets: ImportTargetTable,
    diags: Diagnostic[],
) -> void {
    trait_module :: trait_owner_module(decl, module_symbols, bindings, wire_targets) else return
    for_sym :: for_type_owner_sym(decl.for_type, idents, wire_targets)
    for_is_primitive := false
    for_is_local := false
    if for_sym is Symbol {
        for_is_primitive = for_sym.kind == .BuiltinType
        for_is_local = for_sym.module == module_id
    }
    trait_is_local :: trait_module == module_id
    if !for_is_primitive && !for_is_local && !trait_is_local {
        diags.push(resolver_error(.OrphanImplForbidden, decl.span,
            "${AST.impl_trait_written_name(decl)} for ${for_type_display_name(decl.for_type)} (neither type nor trait is owned by this module)"))
    }
}

// The module declaring the trait an impl names: that of a trait of the module or
// of an import binding of the impl's file, or the module a namespace alias
// imports (`Ns.Trait`). Null when the name binds to no trait.
trait_owner_module :: fn(
    decl: AST.ImplDecl,
    module_symbols: Map<string, Symbol>,
    bindings: Map<string, Symbol>,
    wire_targets: ImportTargetTable,
) -> string | null {
    head :: AST.impl_trait_head(decl)
    if head is AST.FieldExpr && head.target is AST.IdentExpr {
        alias :: bindings[head.target.name] else return null
        return wire_targets.namespace_targets[alias.id]
    }
    trait_sym :: lookup_trait_sym(AST.impl_trait_name(decl), module_symbols, bindings, wire_targets)
        else return null
    return if trait_sym.kind == .Trait { trait_sym.module } else { null }
}

// The trait named `name` : a declaration of the module, else an import binding of
// the impl's file.
lookup_trait_sym :: fn(
    name: string,
    module_symbols: Map<string, Symbol>,
    bindings: Map<string, Symbol>,
    wire_targets: ImportTargetTable,
) -> Symbol | null {
    declared :: module_symbols[name]
    if declared is Symbol {
        return resolve_import_redirect(declared, wire_targets)
    }
    bound :: bindings[name] else return null
    return resolve_import_redirect(bound, wire_targets)
}

// The declaration that owns the impl's type. An array belongs to its element's
// owner (`MonType[]` to `MonType`'s module) ; the `T[]` of a generic impl, to
// nobody.
for_type_owner_sym :: fn(
    t: AST.TypeExpr,
    idents: Map<u64, Symbol>, wire_targets: ImportTargetTable,
) -> Symbol | null {
    if t is AST.ArrayTypeExpr {
        owner :: for_type_owner_sym(t.element, idents, wire_targets) else return null
        return if owner.kind == .TypeParam { null } else { owner }
    }
    if t is AST.IdentExpr {
        raw :: idents[t.span.hash()] else return null
        return resolve_import_redirect(raw, wire_targets)
    }
    if t is AST.GenericInstExpr {
        if t.callee is AST.IdentExpr {
            raw :: idents[t.callee.span.hash()] else return null
            return resolve_import_redirect(raw, wire_targets)
        }
    }
    return null
}

for_type_display_name :: fn(t: AST.TypeExpr) -> string {
    if t is AST.ArrayTypeExpr {
        return "${for_type_display_name(t.element)}[]"
    }
    if t is AST.IdentExpr { return t.name }
    if t is AST.GenericInstExpr {
        if t.callee is AST.IdentExpr { return t.callee.name }
    }
    return "?"
}
