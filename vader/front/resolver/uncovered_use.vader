// vader/front/resolver/uncovered_use: a use of a declaration the target being
// built leaves without a body.
//
// Target selection notes each bare `@target` declaration whose group has no
// body for the target (`UncoveredDecl`, `target_select.vader`). Such a
// declaration is an error where the program uses it, and dead otherwise: a
// library may declare what a target lacks, and only a program that uses it
// fails to build there.
//
// What the program uses is what its roots reach by name, by the rules
// `only_reached` follows (`reached.vader`), over every module this time. The
// roots are those the lowerer keeps: `main`, or every declaration of the project
// when it declares none, the tests a load runs, `@extern` functions, and the
// functions the compiler calls by itself. The walk keeps the name that reached
// each one first, which gives the chain the diagnostic names, from a root to the
// use.

module "vader/front/resolver"

import "std/collections"
import "std/iter"
import "std/string"
import "toolchain/diagnostics"
import "toolchain/span"
import "vader/front/reach"
AST :: import "toolchain/ast"

/// Report R2041 for each declaration of `uncovered` that `units` still hold and
/// the roots of the program use.
///
/// @param units            every module of the load, as the load keeps them.
/// @param compiler_called  the names the compiler calls by itself.
/// @param tested           whether the load runs tests: the tests of the rooted
///                         module are then roots, beside its `main`.
/// @param uncovered        the declarations target selection left without a body.
/// @param target           the target being built, as a message names it.
/// @param diags            receives one R2041 per declaration used.
report_used_uncovered :: fn(
    units: ReachUnit[],
    compiler_called: string[],
    tested: bool,
    uncovered: UncoveredDecl[],
    target: string,
    diags: Diagnostic[],
) -> void {
    held :: still_held(units, uncovered)
    if held.is_empty() {
        return
    }
    // Every module graphed: none seeds the walk with all it writes.
    graphed :: units.map((u) -> ReachUnit { ...u, .trimmed = true }).collect()
    graph :: name_graph(graphed, compiler_called)
    seeds :: graph.seeds
    seeds.push_all(root_names(units, tested))
    parents :: parents_reached(seeds, graph.refs_by_name)
    for u in held {
        name :: used_name(u, parents) else continue
        way :: way_to(name, parents)
        steps :: use_steps(way, sites_on(units, way, graph.dependency_types))
        diags.push(uncovered_use(u, way, steps, target))
    }
}

// The declarations of `uncovered` that `units` still hold.
still_held :: fn(units: ReachUnit[], uncovered: UncoveredDecl[]) -> UncoveredDecl[] {
    if uncovered.is_empty() {
        return uncovered
    }
    held :: Set<i64> {}
    for unit in units {
        for f in unit.files {
            for d in f.program.decls {
                held.add(d.id)
            }
        }
    }
    return uncovered.filter((u) -> u.decl.id in held).collect()
}

// The names of the roots of the program, in the modules that declare them:
// their entries (`is_entry`), else every declaration when no test runs and no
// `main` is declared.
root_names :: fn(units: ReachUnit[], tested: bool) -> string[] {
    entries: string[]: []
    every: string[]: []
    has_main := false
    for unit in units {
        if !unit.rooted {
            continue
        }
        for f in unit.files {
            own :: module_of(f)
            for d in f.program.decls {
                name :: declared_name(d) else continue
                if d is AST.FnDecl && is_entry(d, tested) {
                    entries.push_all(names_of(d, name, own))
                    has_main = has_main || name == "main"
                }
                every.push_all(names_of(d, name, own))
            }
        }
    }
    if tested || has_main {
        return entries
    }
    return every
}

// Whether the program starts at `d`, as the lowerer keeps it: `main`, an
// `@extern` function, and a test when the load runs them.
is_entry :: fn(d: AST.FnDecl, tested: bool) -> bool {
    if d.name == "main" || AST.has_compiler_decorator(d.decorators, .Extern) {
        return true
    }
    return tested && AST.has_compiler_decorator(d.decorators, .Test)
}

// The name by which the walk reached the declaration `u` ; null when it did not.
used_name :: fn(u: UncoveredDecl, parents: Map<string, string>) -> string | null {
    for name in names_of(u.decl, u.decl.name, u.module) {
        if parents[name] != null {
            return name
        }
    }
    return null
}

// The names from a root to `name`, each the one that reached the next first.
way_to :: fn(name: string, parents: Map<string, string>) -> string[] {
    back: string[]: [name]
    parent := parents[name] else ""
    for parent != "" {
        back.push(parent)
        parent = parents[parent] else ""
    }
    out: string[]: []
    for i in 0..<back.len() {
        out.push(back[back.len() - 1 - i])
    }
    return out
}

// A declaration a name of a way leads to.
DeclSite :: struct {
    decl: AST.Decl
    /// Whether its module declares the roots of the program, which its author
    /// can change.
    rooted: bool
}

// The declarations of `units` each name of `way` leads to.
sites_on :: fn(units: ReachUnit[], way: string[], dependency_types: Set<string>) -> Map<string, DeclSite[]> {
    wanted :: Set<string> {}
    for name in way {
        wanted.add(name)
    }
    out :: Map<string, DeclSite[]> {}
    for unit in units {
        for f in unit.files {
            own :: module_of(f)
            for d in f.program.decls {
                key :: reach_key(d, dependency_types) else continue
                for name in names_of(d, key, own) {
                    if name !in wanted {
                        continue
                    }
                    site :: DeclSite { .decl = d, .rooted = unit.rooted }
                    current :: out.put_absent(name, [site]) else continue
                    current.push(site)
                }
            }
        }
    }
    return out
}

// One step of a way from a root: a declaration that uses the next.
UseStep :: struct {
    user: string
    used: string
    /// Where `user` writes the name of `used` ; null for a name that leads to a
    /// declaration without writing it (a trait reached by its member).
    span: Span | null
    /// Whether `user` is declared in a module of the roots.
    rooted: bool
}

// Each name of `way` but the last, with where a declaration it leads to writes
// the next.
use_steps :: fn(way: string[], sites: Map<string, DeclSite[]>) -> UseStep[] {
    out: UseStep[]: []
    for i in 0..<way.len() - 1 {
        used :: unqualified_name(way[i + 1])
        step := UseStep { .user = unqualified_name(way[i]), .used = used, .span = null, .rooted = false }
        for site in sites[way[i]] else [] {
            span :: first_written(site.decl, used) else continue
            step = UseStep { ...step, .span = span, .rooted = site.rooted }
            break
        }
        out.push(step)
    }
    return out
}

// R2041 for the declaration `u`, which `way` leads to from a root through
// `steps`: at the deepest use the project writes, the uses past it and the
// declaration related.
uncovered_use :: fn(u: UncoveredDecl, way: string[], steps: UseStep[], target: string) -> Diagnostic {
    d :: u.decl
    detail :: "`${d.name}` has no body for `${target}` and no general body ; its `@target` bodies cover "
        + "${u.covered} ; ${display_way(way)}"
    at :: primary_step(steps) else return resolver_error(.NoTargetBodyCoversTarget, d.name_span, detail)
    related: Related[]: []
    for i in at + 1..<steps.len() {
        step :: steps[i]
        span :: step.span else continue
        related.push(Related { .span = span, .message = "`${step.user}` uses `${step.used}` here" })
    }
    related.push(Related { .span = d.name_span, .message = "`${d.name}` is declared here" })
    primary :: steps[at].span else d.name_span
    return Diagnostic { ...resolver_error(.NoTargetBodyCoversTarget, primary, detail), .related = related }
}

// The index of the step the diagnostic points at: the deepest use a module of
// the roots writes, else the deepest use written ; null for none.
primary_step :: fn(steps: UseStep[]) -> i64 | null {
    deepest: i64 | null = null
    deepest_rooted: i64 | null = null
    for i in 0..<steps.len() {
        step :: steps[i]
        if step.span == null {
            continue
        }
        deepest = i
        if step.rooted {
            deepest_rooted = i
        }
    }
    if deepest_rooted != null {
        return deepest_rooted
    }
    return deepest
}

// The way from a root to the declaration, as a message says it.
display_way :: fn(way: string[]) -> string {
    if way.len() == 1 {
        return "it is a root of the program"
    }
    users: string[]: []
    for i in 0..<way.len() - 1 {
        users.push("`${unqualified_name(way[i])}`")
    }
    return "used through ${users.join(" -> ")}"
}

// ---- tests ----------------------------------------------------------------

import "std/abort"
import "std/testing"
import "toolchain/parser"

// A module of one file at `path`, its nodes numbered by `ids`.
numbered_unit :: fn(source: string, path: string, rooted: bool, ids: NodeIdFactory) -> ReachUnit {
    program :: parse_source(source, path).program
    assign_program_ids(program, ids)
    return ReachUnit {
        .files = [SourceFile { .path = path, .content = source, .program = program }],
        .trimmed = !rooted,
        .rooted = rooted,
    }
}

// The declaration `name` of `unit`, as target selection notes one no body covers.
uncovered_in :: fn(unit: ReachUnit, name: string) -> UncoveredDecl {
    for d in unit.files[0].program.decls.filter_is<AST.FnDecl>() {
        if d.name == name {
            return UncoveredDecl {
                .decl = d,
                .module = module_of(unit.files[0]),
                .covered = ".wasi",
            }
        }
    }
    panic("no declaration `${name}`")
}

// The diagnostics a load of `program` and `library` reports for the hole `hole`
// of `library`.
uses_of_hole :: fn(program: string, library: string, tested: bool) -> Diagnostic[] {
    ids :: NodeIdFactory { .next = 0 }
    project :: numbered_unit(program, "main.vader", true, ids)
    lib :: numbered_unit(library, "lib.vader", false, ids)
    diags: Diagnostic[]: []
    report_used_uncovered([project, lib], [], tested, [uncovered_in(lib, "hole")], "wasi-wasm32", diags)
    return diags
}

LIBRARY_WITH_A_HOLE :: r"""
    module "lib"

    @target
    hole :: fn() -> i32

    export through :: fn() -> i32 = hole() + 1
"""

@test
test_a_hole_nothing_uses_is_no_error :: fn() -> void {
    program :: r"""
        module "main"

        import "lib"

        unused :: fn() -> i32 = through()

        main :: fn() -> i32 = 0
    """
    assert_eq(uses_of_hole(program, LIBRARY_WITH_A_HOLE, false).len(), 0)
}

@test
test_a_use_through_a_library_points_at_the_project :: fn() -> void {
    program :: r"""
        module "main"

        import "lib"

        main :: fn() -> i32 = through()
    """
    diags :: uses_of_hole(program, LIBRARY_WITH_A_HOLE, false)
    assert_eq(diags.len(), 1)
    d :: diags[0]
    assert_eq(d.code.id, "R2041")
    assert_eq(d.primary.start.file, "main.vader")
    assert(d.detail.contains("used through `main` -> `through`"), d.detail)
    assert_eq(d.related.len(), 2)
    assert_eq(d.related[0].message, "`through` uses `hole` here")
    assert_eq(d.related[1].message, "`hole` is declared here")
}

@test
test_the_tests_of_a_load_that_runs_them_are_its_roots :: fn() -> void {
    program :: r"""
        module "main"

        import "lib"

        main :: fn() -> i32 = 0

        @test
        test_through :: fn() -> void {
            through()
        }
    """
    assert_eq(uses_of_hole(program, LIBRARY_WITH_A_HOLE, false).len(), 0)
    assert_eq(uses_of_hole(program, LIBRARY_WITH_A_HOLE, true).len(), 1)
}

@test
test_a_project_with_no_main_uses_all_it_declares :: fn() -> void {
    program :: r"""
        module "main"

        import "lib"

        export entry :: fn() -> i32 = through()
    """
    assert_eq(uses_of_hole(program, LIBRARY_WITH_A_HOLE, false).len(), 1)
}

@test
test_an_extern_function_is_a_root_beside_main :: fn() -> void {
    program :: r"""
        module "main"

        import "lib"

        main :: fn() -> i32 = 0

        @extern
        on_signal :: fn() -> i32 = through()
    """
    assert_eq(uses_of_hole(program, LIBRARY_WITH_A_HOLE, false).len(), 1)
}
