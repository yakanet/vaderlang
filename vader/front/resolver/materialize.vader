// vader/front/resolver/materialize: synthetic trait method injection.
//
// Each entry point expands an `ImplDecl.members` array with synthesised method
// declarations drawn from the trait :
//
//   1. `materialize_intrinsic_members`: @intrinsic impl with an empty
//      body : push one stub FnDecl per trait method, signature only.
//   2. `materialize_default_members`: trait methods with a default
//      body : inject a declaration without a body for any name the impl
//      didn't override, its signature substituted. The body stays the
//      trait's, checked once there and lowered for each impl from there
//      (`vader/lower/inherited.vader`).
//   3. `materialize_sam_members`: single-abstract-method sugar
//      (`Foo implements Trait -> expr`) : fill name/params/return_type
//      on the parser-fabricated synthetic FnDecl(s) from the trait's
//      single required method.
//
// All three share the `Self → impl_.for_type` + trait type-param →
// impl trait-arg substitution wired through `substitute.vader`.

module "vader/front/resolver"

import "std/collections"
import "std/iter"
import "std/math"
import "std/testing"
import "vader/support/diagnostics"
import "vader/front/parser"
AST :: import "toolchain/ast"
import "toolchain/span"

/// Where a member declared for an impl from its trait is written: nowhere. Its name,
/// and an inherited member's parameters, take this span, which names no source
/// (`has_source_position`) and is zero-wide, so an editor places nothing on it. The
/// typecheck keys a member by its node id, never by this span.
unplaced_span :: fn() -> Span {
    pos :: Position { .file = SYNTHETIC_FILE, .offset = 0, .line = 0, .column = 0 }
    return Span { .start = pos, .end = pos }
}

/// `@intrinsic impl ... {}` carries an empty body : fill it with one
/// stub FnDecl per trait method so downstream phases see the impl's
/// full surface. No-op when the impl already has members.
///
/// @param impl_decl    the `@intrinsic` impl to fill.
/// @param trait_decl   the trait it implements.
/// @param factory  the project's node-id factory : each stub takes a
///                 declaration id of its own from it.
export materialize_intrinsic_members :: fn(
    impl_decl: AST.ImplDecl,
    trait_decl: AST.TraitDecl,
    factory: NodeIdFactory,
) -> void {
    if !is_intrinsic(impl_decl.decorators) { return }
    if impl_decl.members.len() > 0 { return }
    subst :: build_subst(impl_decl, trait_decl)
    for method in trait_decl.members {
        decorators :: intrinsic_decorator(impl_decl.span)
        params :: substitute_params(method.params, subst)
        id :: factory.mint()
        impl_decl.members.push(synth_signature(method, unplaced_span(), params, subst, decorators, id))
    }
}

/// Add to `impl_` a declaration without a body of each default method it does not
/// write, its signature read for the impl and `inherits` naming the trait's member.
/// Each takes an id of its own from the project's factory, so it has slots of its
/// own in the id-keyed tables.
///
/// @param impl_decl    the impl to complete.
/// @param trait_decl   the trait it implements.
/// @param factory  the project's node-id factory.
export materialize_default_members :: fn(
    impl_decl: AST.ImplDecl,
    trait_decl: AST.TraitDecl,
    factory: NodeIdFactory,
) -> void {
    if !any_has_body(trait_decl.members) {
        return
    }
    provided :: provided_names(impl_decl.members)
    subst :: build_subst(impl_decl, trait_decl)
    for method in trait_decl.members {
        if method.body == null || method.name in provided {
            continue
        }
        impl_decl.members.push(synth_inherited(method, subst, factory.mint()))
    }
}

// The member an impl inherits : typed from the trait's (`declare_inherited_member`),
// its signature substituted only to be shown.
synth_inherited :: fn(method: AST.FnDecl, subst: Subst, id: i64) -> AST.FnDecl {
    params :: method.params.map((p) -> unplaced_param(p, subst)).collect()
    signature :: synth_signature(method, unplaced_span(), params, subst, [], id)
    return AST.FnDecl { ...signature, .inherits = method }
}

// `p` as `substitute_param` reads it, written nowhere.
unplaced_param :: fn(p: AST.FnParam, subst: Subst) -> AST.FnParam = AST.FnParam {
    ...substitute_param(p, subst),
    .span = unplaced_span(),
    .name_span = unplaced_span(),
}

/// Mint a fresh, globally-unique synthetic span for a SAM member's non-self
/// param. `line = 0` keeps it clear of any real source span (real spans are
/// 1-based) ; the minted factory id rides in `column` so each call yields a
/// distinct `Span.hash()`.
synth_param_span :: fn(factory: NodeIdFactory) -> Span {
    pos :: Position { .file = "", .offset = 0, .line = 0, .column = i32(factory.mint()) }
    return Span { .start = pos, .end = pos }
}

/// `substitute_params` but `self` re-anchors at `self_span` (its type is
/// contextual, so a shared span is fine) while every non-self param gets a
/// fresh minted span, so a two-arg SAM method (`Comparable.compare(self,
/// other: Self)`) doesn't collide `other` across sibling impls in the
/// span-keyed `param_types` table.
substitute_params_disambiguated :: fn(
    params: AST.FnParam[],
    subst: Subst,
    self_span: Span,
    factory: NodeIdFactory,
) -> AST.FnParam[] {
    out: AST.FnParam[]: []
    for p in params {
        span :: if p.name == "self" { self_span } else { synth_param_span(factory) }
        out.push(AST.FnParam {
            ...substitute_param(p, subst),
            .span = span,
            .name_span = unplaced_span(),
        })
    }
    return out
}


/// SAM-synthetic members come out of the parser with a placeholder
/// name and an empty param list ; the trait's lone required method
/// supplies the canonical name + signature. Mutates each synthetic
/// member in place. SAM shape-mismatch diagnostics (R2016) aren't
/// emitted here: `check_short_impl_arity` (orchestrate.vader) fires
/// them before this runs.
export materialize_sam_members :: fn(
    impl_decl: AST.ImplDecl,
    trait_decl: AST.TraitDecl,
    factory: NodeIdFactory
) -> void {
    syn_count :: count_sam_synthetics(impl_decl.members)
    if syn_count == 0 { return }
    required :: required_methods(trait_decl.members)
    if required.is_empty() { return }
    // Pick the first required method as the SAM target. When the trait
    // has >1 required method, R2016 already fired ; renaming under the
    // first one still lets the T3036 "missing method" loop find at
    // least the SAM-named method instead of flagging both as missing.
    method :: required[0]
    subst :: build_subst(impl_decl, trait_decl)
    for i in 0..<impl_decl.members.len() {
        m :: impl_decl.members[i]
        if !m.sam_synthetic { continue }
        m.name = method.name
        // `self` re-anchors at the synthetic member's own span (unique per
        // impl) ; non-self params get fresh minted spans so a two-arg SAM
        // method (`Comparable.compare(self, other: Self)`) doesn't collide
        // `self` / `other` on one span-keyed `param_types` slot.
        m.params = substitute_params_disambiguated(method.params, subst, m.name_span, factory)
        m.return_type = substitute_opt_type(method.return_type, subst)
    }
}

// ---- helpers --------------------------------------------------------------

is_intrinsic :: fn(decs: AST.Decorator[]) -> bool {
    for d in decs {
        if d.name == "intrinsic" { return true }
    }
    return false
}

any_has_body :: fn(members: AST.FnDecl[]) -> bool {
    for m in members {
        match m.body {
            is AST.BlockExpr -> { return true }
            is null          -> {}
        }
    }
    return false
}

provided_names :: fn(members: AST.FnDecl[]) -> MutableSet<string> {
    set :: MutableSet<string> {}
    for m in members { set.add(m.name) }
    return set
}

export count_sam_synthetics :: fn(members: AST.FnDecl[]) -> i64 {
    n: i64 = 0
    for m in members {
        if m.sam_synthetic { n = n + 1 }
    }
    return n
}

export required_methods :: fn(members: AST.FnDecl[]) -> AST.FnDecl[] {
    out: AST.FnDecl[]: []
    for m in members {
        match m.body {
            is null          -> { out.push(m) }
            is AST.BlockExpr -> {}     // default-bodied, not a "required" method
        }
    }
    return out
}

build_subst :: fn(impl_: AST.ImplDecl, trait_: AST.TraitDecl) -> Subst {
    subst :: new_subst()
    bind(subst, "Self", impl_.for_type)
    n :: min(trait_.type_params.len(), impl_.trait_args.len())
    for i in 0..<n {
        bind(subst, trait_.type_params[i].name, impl_.trait_args[i])
    }
    // Fill any trailing params the impl didn't supply from their `<T = Default>`
    // defaults. `Self` (and any earlier param) is already bound, so a `Self`
    // default (or a default referencing an earlier param) resolves through
    // `subst`. Bind in order so a later default can reference an earlier one.
    for i in n..<trait_.type_params.len() {
        d :: trait_.type_params[i].default ?? break
        bind(subst, trait_.type_params[i].name, substitute_type_expr(d, subst))
    }
    return subst
}

synth_signature :: fn(
    method: AST.FnDecl,
    name_span: Span,
    params: AST.FnParam[],
    subst: Subst,
    decorators: AST.Decorator[],
    id: i64,
) -> AST.FnDecl {
    return AST.FnDecl {
        .span = method.span,
        .id = id,
        .name = method.name,
        .name_span = name_span,
        .visibility = .Public,
        .type_params = [],
        .params = params,
        .return_type = substitute_opt_type(method.return_type, subst),
        .body = null,
        .decorators = decorators,
        .sam_synthetic = false,
        .is_expression_bodied = method.is_expression_bodied,
        .materialized = true,
        .doc = method.doc,
    }
}

substitute_params :: fn(params: AST.FnParam[], subst: Subst) -> AST.FnParam[] =
    params.map((p) -> substitute_param(p, subst)).collect()

// `p` with `Self` and the trait's parameters substituted, as a member declared for
// an impl reads it.
substitute_param :: fn(p: AST.FnParam, subst: Subst) -> AST.FnParam = AST.FnParam {
    ...p,
    .id = AST.UNASSIGNED_NODE_ID,
    .ty = substitute_opt_type(p.ty, subst),
}

substitute_opt_type :: fn(t: AST.TypeExpr | null, subst: Subst) -> AST.TypeExpr | null {
    if t == null { return null }
    return substitute_type_expr(t, subst)
}

intrinsic_decorator :: fn(span: Span) -> AST.Decorator[] {
    args: AST.Expr[]: []
    return [AST.Decorator { .span = span, .id = AST.UNASSIGNED_NODE_ID, .name = "intrinsic", .args = args }]
}

// ---- tests ----------------------------------------------------------------

import "std/abort"

@test
test_materialize_sam_fills_name_and_signature :: fn() -> void {
    src :: """
Equals :: trait {
    equals :: fn(self, other: Self) -> bool
}

Point :: struct {
    x: i32
}

Point implements Equals -> true
"""
    parsed :: parse_source(src, "t.vader")
    trait_decl :: find_trait(parsed.program.decls, "Equals")
    impl_decl  :: find_impl(parsed.program.decls)
    match trait_decl {
        is null -> { assert(false, "Equals trait should be parsed") }
        is AST.TraitDecl -> {
            match impl_decl {
                is null -> { assert(false, "Point implements Equals should be parsed") }
                is AST.ImplDecl -> {
                    materialize_sam_members(impl_decl, trait_decl, new_node_id_factory())
                    found := false
                    for m in impl_decl.members {
                        if m.name == "equals" { found = true }
                    }
                    assert(found, "SAM-synthetic member should be named after the trait's method")
                }
            }
        }
    }
}

@test
test_materialize_intrinsic_fills_empty_body :: fn() -> void {
    // `@intrinsic <T> implements <Trait>` is the bare-impl form ; the
    // parser leaves `members` empty, and materialize pushes one stub
    // FnDecl per trait method.
    src :: """
Iter :: trait {
    next :: fn(self) -> i32
}

@intrinsic i32 implements Iter
"""
    parsed :: parse_source(src, "t.vader")
    trait_decl :: find_trait(parsed.program.decls, "Iter")
    impl_decl  :: find_impl(parsed.program.decls)
    match trait_decl {
        is null -> { assert(false, "Iter trait should be parsed") }
        is AST.TraitDecl -> {
            match impl_decl {
                is null -> { assert(false, "i32 implements Iter should be parsed") }
                is AST.ImplDecl -> {
                    before :: impl_decl.members.len()
                    assert_eq(before, 0)
                    materialize_intrinsic_members(impl_decl, trait_decl, new_node_id_factory())
                    after :: impl_decl.members.len()
                    assert_eq(after, 1)
                    assert_eq(impl_decl.members[0].name, "next")
                    assert(impl_decl.members[0].id != AST.UNASSIGNED_NODE_ID, "the stub has an id")
                }
            }
        }
    }
}

@test
test_materialize_default_member_has_an_id :: fn() -> void {
    src :: """
Shape :: trait {
    area :: fn(self) -> i32
    twice :: fn(self) -> i32 = self.area()
}

Square :: struct {
    side: i32
}

Square implements Shape {
    area :: fn(self) -> i32 = self.side
}
"""
    parsed :: parse_source(src, "t.vader")
    trait_decl :: find_trait(parsed.program.decls, "Shape") ?? panic("the trait should parse")
    impl_decl :: find_impl(parsed.program.decls) ?? panic("the impl should parse")
    materialize_default_members(impl_decl, trait_decl, new_node_id_factory())
    assert_eq(impl_decl.members.len(), 2)
    twice :: impl_decl.members[1]
    assert_eq(twice.name, "twice")
    assert(twice.id != AST.UNASSIGNED_NODE_ID, "the inherited member has an id")
    assert(!has_source_position(twice.name_span), "the inherited member is written nowhere")
}

find_trait :: fn(decls: AST.Decl[], name: string) -> AST.TraitDecl | null {
    for d in decls {
        if d is AST.TraitDecl && d.name == name {
            return d
        }
    }
    return null
}

find_impl :: fn(decls: AST.Decl[]) -> AST.ImplDecl | null {
    for d in decls {
        if d is AST.ImplDecl {
            return d
        }
    }
    return null
}
