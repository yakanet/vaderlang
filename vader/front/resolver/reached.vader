// vader/front/resolver/reached: a load keeps of its dependencies what the
// program reaches.
//
// A program pays for every declaration of every module it loads: each is
// resolved, typed and summarised whether or not anything calls it. Here, once
// every module is parsed and before any symbol is minted, the declarations of a
// dependency that no name leads to are dropped, and no later pass ever sees
// them.
//
// The walk is the one of `vader/front/reach`, across modules: a reference counts
// by its name, never resolved. Everything the program's own modules write is
// reached; a declaration of a dependency is reached when a reached declaration
// writes its name. Two declarations of one name in two modules are reached
// together, so the walk keeps too much and never too little.
//
// What a name does not lead to is reached by a rule of its own:
//
// - an impl has no name. It follows its type when a dependency declares that
//   type, its trait otherwise (`i32 implements Shape`, `T[] implements Shape`);
// - a trait is reached by the name of any of its members, since `x.area()`
//   writes `area` and never `Shape`;
// - a name an import rebinds (`import "p" { x as y }`) is reached as written.
//
// Three rules of the language narrow what a name leads to, each keyed by the
// name of a declaration in its module (`qualified_name`, `m#f`):
//
// - `Alias.f`, through a namespace import, names `f` of the module the alias
//   names, and no other `f`. An alias whose path names no module of the load
//   leads by the bare name, as any name does;
// - a private function or constant is named from its own module alone, so only
//   a name written in that module leads to it;
// - a body that target selection moved into its declaration reads the imports
//   of the file it is written in, as the resolver does.
//
// A module reaches here without its tests, which the load took
// (`dependency_tests.vader`).
//
// The compiler itself names declarations with no source to write them: the
// prelude is never trimmed, and the caller gives the names it calls elsewhere.

module "vader/front/resolver"

import "std/collections"
import "std/iter"
import "vader/front/reach"
AST :: import "toolchain/ast"

/// One parsed module, as `only_reached` reads it.
ReachUnit :: struct {
    files: SourceFile[]
    /// Whether the module loses the declarations nothing reaches: a dependency.
    /// A module that is not trimmed is reached whole.
    trimmed: bool
    /// The bodies of the other targets, which target selection dropped. In a
    /// module that is not trimmed, what they name stays, so that the lint of
    /// imports finds what an import served.
    discarded: AST.FnDecl[] = []
}

/// What `only_reached` leaves of one module.
Reached :: struct {
    files: SourceFile[]
    /// The trait of each impl that went with what nothing reaches, as written.
    lost_impl_traits: string[] = []
}

/// The files of each module, a trimmed one holding only the declarations the
/// others reach.
///
/// @param units            every module of the load.
/// @param compiler_called  the names the compiler calls by itself, reached
///                         whatever the sources write.
/// @return                 what is left of each unit, in the order of `units`.
only_reached :: fn(units: ReachUnit[], compiler_called: string[] = []) -> Reached[] {
    dependency_types :: Set<string> {}
    // The names that reach a declaration of a trimmed module. Any other name a
    // declaration writes leads nowhere, and is not kept: a program writes far
    // more names than its dependencies declare.
    leading :: Set<string> {}
    modules :: Set<string> {}
    for unit in units {
        for f in unit.files {
            modules.add(module_of(f))
        }
    }
    aliases_by_file :: Map<string, Map<string, string>> {}
    for unit in units {
        for f in unit.files {
            aliases_by_file[file_of(f)] = namespace_aliases(f, modules)
        }
    }
    for unit in units {
        if !unit.trimmed {
            continue
        }
        for f in unit.files {
            own :: module_of(f)
            for d in f.program.decls {
                add_leading_names(d, own, leading)
                if declares_type(d) {
                    dependency_types.add(declared_name(d) else continue)
                }
            }
        }
    }
    refs_by_name :: Map<string, string[]> {}
    seeded :: Set<string> {}
    seed_refs: string[]: []
    for name in compiler_called {
        if seeded.add(name) {
            seed_refs.push(name)
        }
    }
    for unit in units {
        // The lint of imports reads no trimmed module.
        if !unit.trimmed {
            for body in unit.discarded {
                aliases :: aliases_in(aliases_by_file, body.span.start.file)
                seed_leading(names_written_by(body, aliases, ""), leading, seeded, seed_refs)
            }
        }
        for f in unit.files {
            own :: module_of(f)
            module_names: string[]: []
            collect_decorator_names(AST.module_decorators(f.program), module_names)
            seed_leading(module_names, leading, seeded, seed_refs)
            for d in f.program.decls {
                written :: names_written_by(d, aliases_read_by(d, f, aliases_by_file), own)
                key :: reach_key(d, dependency_types)
                if !unit.trimmed || key == null {
                    seed_leading(written, leading, seeded, seed_refs)
                    continue
                }
                refs: string[]: []
                for name in written {
                    if name in leading {
                        refs.push(name)
                    }
                }
                if !is_private_to(d, own) {
                    register_refs(refs_by_name, key, refs)
                }
                if own != "" && d !is AST.ImplDecl {
                    register_refs(refs_by_name, qualified_name(own, key), refs.clone())
                }
                if d is AST.TraitDecl {
                    for member in d.members {
                        register_refs(refs_by_name, member.name, [d.name])
                    }
                }
            }
        }
    }
    reachable :: bfs_reachable([], seed_refs, refs_by_name)
    out: Reached[]: []
    for unit in units {
        if !unit.trimmed {
            out.push(Reached { .files = unit.files })
            continue
        }
        left :: Reached { .files = [] }
        for f in unit.files {
            own :: module_of(f)
            kept: AST.Decl[]: []
            for d in f.program.decls {
                key :: reach_key(d, dependency_types)
                if key == null || is_reached(d, key, own, reachable) {
                    kept.push(d)
                } else if d is AST.ImplDecl {
                    left.lost_impl_traits.push(AST.impl_trait_name(d))
                }
            }
            left.files.push(
                SourceFile { ...f, .program = AST.Program { ...f.program, .decls = kept } },
            )
        }
        out.push(left)
    }
    return out
}

// Add to `leading` the names that reach the declaration `d` of the trimmed
// module `own`: its own, bare and in its module, the trait of an impl, the
// members of a trait.
add_leading_names :: fn(d: AST.Decl, own: string, leading: Set<string>) -> void {
    if d is AST.ImplDecl {
        leading.add(AST.impl_trait_name(d))
        return
    }
    name :: declared_name(d) else return
    leading.add(name)
    if own != "" {
        leading.add(qualified_name(own, name))
    }
    if d is AST.TraitDecl {
        for member in d.members {
            leading.add(member.name)
        }
    }
}

// Seed the walk with each of `names` that leads to a trimmed module, once.
seed_leading :: fn(
    names: string[],
    leading: Set<string>,
    seeded: Set<string>,
    seed_refs: string[],
) -> void {
    for name in names {
        if name in leading && seeded.add(name) {
            seed_refs.push(name)
        }
    }
}

// Every name `d`, written in the module `own`, writes: through the namespace
// aliases `aliases`, the one the walk of the tree does not meet as a node
// included (the source name an import rebinds), and each bare name again as the
// name of a declaration of `own`, which a private one answers to alone.
names_written_by :: fn(d: AST.Decl, aliases: Map<string, string>, own: string) -> string[] {
    refs: string[]: []
    collect_names_through(d, aliases, refs)
    if d is AST.ImportDecl {
        binding :: d.binding
        if binding is AST.DestructureImport {
            for imported in binding.names {
                refs.push(imported.name)
            }
        }
    }
    if own == "" {
        return refs
    }
    bare :: refs.len()
    for i in 0..<bare {
        if !refs[i].contains("#") {
            refs.push(qualified_name(own, refs[i]))
        }
    }
    return refs
}

// Whether the walk reached `d`, of the module `own`, which `key` names: by its
// bare name unless it is private, or by its name in its module.
is_reached :: fn(d: AST.Decl, key: string, own: string, reachable: Set<string>) -> bool {
    if key in reachable && !is_private_to(d, own) {
        return true
    }
    return own != "" && d !is AST.ImplDecl && qualified_name(own, key) in reachable
}

// Whether `d`, of the module `own`, is a function or a constant no other module
// can name. A file with no `module` line has no name to key one by, and leads by
// the bare name.
is_private_to :: fn(d: AST.Decl, own: string) -> bool {
    if own == "" {
        return false
    }
    if d is AST.FnDecl | AST.ConstDecl {
        return d.visibility == .Private
    }
    return false
}

// The name of the module `f` belongs to, `""` for a file with no `module` line.
module_of :: fn(f: SourceFile) -> string {
    own :: f.program.module else return ""
    return own.name
}

// The file a span of `f` names, which keys its aliases.
file_of :: fn(f: SourceFile) -> string = f.program.span.start.file

// The namespace aliases of `f` that name a module of the load, each with the
// module's name. Any other alias leads by the bare name: the walk may keep too
// much, never too little.
namespace_aliases :: fn(f: SourceFile, modules: Set<string>) -> Map<string, string> {
    out :: Map<string, string> {}
    for d in f.program.decls.filter_is<AST.ImportDecl>() {
        binding :: d.binding
        if binding is AST.NamedNamespaceImport && d.path in modules {
            out[binding.name] = d.path
        }
    }
    return out
}

// The aliases `d`, a declaration of `f`, reads: those of the file its body is
// written in when target selection moved the body there, as the resolver reads
// them.
aliases_read_by :: fn(
    d: AST.Decl,
    f: SourceFile,
    by_file: Map<string, Map<string, string>>,
) -> Map<string, string> {
    if d is AST.FnDecl {
        body :: d.body
        if body != null {
            return aliases_in(by_file, body.span.start.file)
        }
    }
    return aliases_in(by_file, file_of(f))
}

// The namespace aliases of the file `file`, none for a file the load does not
// hold.
aliases_in :: fn(by_file: Map<string, Map<string, string>>, file: string) -> Map<string, string> =
    by_file[file] else Map<string, string> {}

// The name that reaches `d` in a trimmed module, null for a declaration that
// always stays: an import, an assert, an impl with neither a type of a
// dependency nor a trait.
reach_key :: fn(d: AST.Decl, dependency_types: Set<string>) -> string | null {
    if d !is AST.ImplDecl {
        return declared_name(d)
    }
    owner :: type_head_name(d.for_type)
    if owner != null && owner in dependency_types {
        return owner
    }
    trait_name :: AST.impl_trait_name(d)
    return if trait_name == "" { null } else { trait_name }
}

// ---- tests ----------------------------------------------------------------

import "std/string"
import "std/testing"
import "toolchain/parser"

// A one-file module from its source.
unit_of :: fn(source: string, trimmed: bool) -> ReachUnit = ReachUnit {
    .files = [file_at(source, "t.vader")],
    .trimmed = trimmed,
}

// The file at `path` that holds `source`.
file_at :: fn(source: string, path: string) -> SourceFile =
    SourceFile { .path = path, .content = source, .program = parse_source(source, path).program }

// What `only_reached` leaves of the dependency `library` loaded by `program`:
// the names it declares, an impl as `Type:Trait`.
reached_by :: fn(program: string, library: string) -> string {
    left :: only_reached([unit_of(program, false), unit_of(library, true)])
    return names_left(left[1])
}

// The names `left` declares, an impl as `Type:Trait`.
names_left :: fn(left: Reached) -> string {
    names: string[]: []
    for d in left.files[0].program.decls {
        if d is AST.ImplDecl {
            names.push("${type_head_name(d.for_type) else "_"}:${AST.impl_trait_name(d)}")
            continue
        }
        names.push(declared_name(d) else continue)
    }
    return names.join(" ")
}

@test
test_only_reached_keeps_what_a_name_leads_to :: fn() -> void {
    library :: r"""
        module "lib"

        export shown :: fn(x: i32) -> i32 = helper(x)

        helper :: fn(x: i32) -> i32 = x * LIMIT

        LIMIT :: 2

        export unused :: fn(x: i32) -> i32 = other(x)

        other :: fn(x: i32) -> i32 = x
    """
    program :: r"""
        module "main"

        import "lib"

        main :: fn() -> i32 = shown(1)
    """
    assert_eq(reached_by(program, library), "shown helper LIMIT")
}

@test
test_only_reached_keeps_an_impl_with_its_type :: fn() -> void {
    library :: r"""
        module "lib"

        export Circle :: struct {
            radius: f64
        }

        export Square :: struct {
            side: f64
        }

        export Shape :: trait {
            area :: fn(self) -> f64
        }

        Circle implements Shape {
            area :: fn(self) -> f64 = self.radius
        }

        Square implements Shape {
            area :: fn(self) -> f64 = self.side
        }
    """
    program :: r"""
        module "main"

        import "lib"

        main :: fn() -> f64 = (Circle { .radius = 1.0 }).area()
    """
    assert_eq(reached_by(program, library), "Circle Shape Circle:Shape")
}

@test
test_only_reached_keeps_an_impl_of_a_built_in_type_with_its_trait :: fn() -> void {
    library :: r"""
        module "lib"

        export Doubled :: trait {
            doubled :: fn(self) -> i32
        }

        export Halved :: trait {
            halved :: fn(self) -> i32
        }

        i32 implements Doubled {
            doubled :: fn(self) -> i32 = self * 2
        }

        i32 implements Halved {
            halved :: fn(self) -> i32 = self / 2
        }
    """
    program :: r"""
        module "main"

        import "lib"

        main :: fn() -> i32 = 4.doubled()
    """
    assert_eq(reached_by(program, library), "Doubled i32:Doubled")
}

@test
test_only_reached_keeps_the_name_an_import_rebinds :: fn() -> void {
    library :: r"""
        module "lib"

        export first :: fn() -> i32 = 1

        export second :: fn() -> i32 = 2
    """
    program :: r"""
        module "main"

        import "lib" { first as one }

        main :: fn() -> i32 = one()
    """
    assert_eq(reached_by(program, library), "first")
}

@test
test_only_reached_leaves_whole_a_module_that_is_not_trimmed :: fn() -> void {
    source :: r"""
        module "main"

        main :: fn() -> i32 = 0

        unused :: fn() -> i32 = 1
    """
    left :: only_reached([unit_of(source, false)])
    assert_eq(left[0].files[0].program.decls.len(), 2)
}

@test
test_only_reached_follows_an_alias_to_its_module_alone :: fn() -> void {
    program :: file_at(r"""
        module "main"

        A :: import "a"

        main :: fn() -> i32 = A.value()
    """, "main.vader")
    first :: file_at(r"""
        module "a"

        export value :: fn() -> i32 = 1
    """, "a.vader")
    second :: file_at(r"""
        module "b"

        export value :: fn() -> i32 = 2
    """, "b.vader")
    left :: only_reached([
        ReachUnit { .files = [program], .trimmed = false },
        ReachUnit { .files = [first], .trimmed = true },
        ReachUnit { .files = [second], .trimmed = true },
    ])
    assert_eq(names_left(left[1]), "value")
    assert_eq(names_left(left[2]), "")
}

@test
test_only_reached_leaves_a_private_function_another_module_names :: fn() -> void {
    library :: r"""
        module "lib"

        export unused :: fn() -> i32 = helper()

        helper :: fn() -> i32 = 1
    """
    program :: r"""
        module "main"

        import "lib"

        main :: fn() -> i32 = helper()

        helper :: fn() -> i32 = 0
    """
    assert_eq(reached_by(program, library), "")
}

// Target selection moved the body of `f`, written beside the alias `B`, into a
// file that has no such alias.
@test
test_only_reached_reads_the_aliases_of_the_file_a_moved_body_is_written_in :: fn() -> void {
    program :: file_at(r"""
        module "main"

        import "lib"

        main :: fn() -> i32 = f()
    """, "main.vader")
    declared :: file_at(r"""
        module "lib"
    """, "declared.vader")
    written :: file_at(r"""
        module "lib"

        B :: import "b"

        export f :: fn() -> i32 = B.g()
    """, "written.vader")
    moved :: with_decls(declared, written.program.decls.filter((d) -> d is AST.FnDecl).collect())
    imports :: written.program.decls.filter((d) -> d is AST.ImportDecl).collect()
    aliases :: with_decls(written, imports)
    b :: file_at(r"""
        module "b"

        export g :: fn() -> i32 = 1
    """, "b.vader")
    c :: file_at(r"""
        module "c"

        export g :: fn() -> i32 = 2
    """, "c.vader")
    left :: only_reached([
        ReachUnit { .files = [program], .trimmed = false },
        ReachUnit { .files = [moved, aliases], .trimmed = true },
        ReachUnit { .files = [b], .trimmed = true },
        ReachUnit { .files = [c], .trimmed = true },
    ])
    assert_eq(names_left(left[1]), "f")
    assert_eq(names_left(left[2]), "g")
    assert_eq(names_left(left[3]), "")
}

// `f` holding the declarations `decls` in place of its own.
with_decls :: fn(f: SourceFile, decls: AST.Decl[]) -> SourceFile =
    SourceFile { ...f, .program = AST.Program { ...f.program, .decls = decls } }
