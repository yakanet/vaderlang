// vader/front/resolver/dependency_tests: a module is loaded without its tests,
// unless the load runs them.
//
// Tests exist for `vader test` alone: nothing else runs them, and every pass
// after the loader would still study them. They go here, right after parsing,
// with the private declarations only they reach and the impls of the types that
// go with them. A declaration the module's own surface reaches by name stays
// (`vader/front/reach`), and so does one nothing reaches: dead code is the lint
// of dead code's to report.
//
// Imports stay: one that only a test needed is still loaded, and the lint of
// imports does not judge a file that lost a test (`Untested.cut`).

module "vader/front/resolver"

import "std/collections"
import "std/iter"
import "toolchain/project"
import "vader/front/reach"
AST :: import "toolchain/ast"

/// The files of a module without the tests it declares.
///
/// Runs before target selection, on every body of a `@target` group: a helper
/// reached from the body of another platform stays.
///
/// @param files        the module's parsed files.
/// @param module_name  the module's declared name.
/// @return             the files, holding the declarations the module's surface
///                     reaches, and those that went.
export without_tests :: fn(files: SourceFile[], module_name: string) -> Untested {
    if !files.any_match((f) -> f.program.decls.any_match(is_test)) {
        return Untested { .files = files }
    }
    private_types :: Set<string> {}
    for f in files {
        for d in f.program.decls {
            if !AST.decl_is_public(d) && declares_type(d) {
                private_types.add(declared_name(d) else continue)
            }
        }
    }
    refs_by_name :: Map<string, string[]> {}
    root_names: string[]: []
    test_names: string[]: []
    seed_refs: string[]: []
    for f in files {
        for d in f.program.decls {
            refs: string[]: []
            collect_names(d, refs)
            name :: declared_name(d)
            if name != null {
                register_refs(refs_by_name, name, refs)
                if is_test(d) {
                    test_names.push(name)
                } else if is_surface(d, name, module_name) {
                    root_names.push(name)
                }
                continue
            }
            // An impl is reached through its type when the module alone can name
            // that type, and from anywhere otherwise. An assert is always checked.
            owner :: private_type_of(d, private_types)
            if owner != null {
                register_refs(refs_by_name, owner, refs)
            } else {
                seed_refs.push_all(refs)
            }
        }
    }
    reachable :: bfs_reachable(root_names, seed_refs, refs_by_name)
    by_tests :: bfs_reachable(test_names, [], refs_by_name)
    out :: Untested { .files = [] }
    for f in files {
        kept: AST.Decl[]: []
        for d in f.program.decls {
            only_tested :: is_reached(d, by_tests, private_types)
                && !is_reached(d, reachable, private_types)
            if is_test(d) || only_tested {
                out.cut.add(AST.decl_span(d).start.file)
            } else {
                kept.push(d)
            }
        }
        out.files.push(SourceFile { ...f, .program = AST.Program { ...f.program, .decls = kept } })
    }
    return out
}

/// A module's files without its tests (`without_tests`).
export Untested :: struct {
    files: SourceFile[]
    /// The files that lost a test, or what only tests reach.
    cut: Set<string> = Set<string> {}
}

// Whether `d` is a test.
is_test :: fn(d: AST.Decl) -> bool = AST.has_compiler_decorator(AST.decl_decorators(d), .Test)

// The name `d` declares, null for an impl, an assert or an import.
declared_name :: fn(d: AST.Decl) -> string | null = match d {
    is AST.FnDecl        -> d.name
    is AST.StructDecl    -> d.name
    is AST.EnumDecl      -> d.name
    is AST.TraitDecl     -> d.name
    is AST.TypeAliasDecl -> d.name
    is AST.ConstDecl     -> d.name
    is AST.ImplDecl | AST.AssertDecl | AST.ImportDecl -> null
}

declares_type :: fn(d: AST.Decl) -> bool =
    d is AST.StructDecl || d is AST.EnumDecl || d is AST.TypeAliasDecl

// Whether the named declaration `d`, not a test, is reached from outside the
// module: exported, an entry point, or wired to the host.
is_surface :: fn(d: AST.Decl, name: string, module_name: string) -> bool {
    decorators :: AST.decl_decorators(d)
    return AST.decl_is_public(d) || is_wired_root(decorators, name)
        || module_name == DRIVER_MODULE && name == DRIVER_ENTRY
}

// The private type of the module the impl `d` is written for, null for an impl
// of any other type and for a declaration that is not an impl.
private_type_of :: fn(d: AST.Decl, private_types: Set<string>) -> string | null {
    if d !is AST.ImplDecl {
        return null
    }
    owner :: type_head_name(d.for_type) else return null
    if owner in private_types {
        return owner
    }
    return null
}

// The name a written type starts with: `Box` for `Box` and for `Box<T>`, null
// for a type with no name of its own (an array, a tuple, a function).
type_head_name :: fn(written: AST.TypeExpr) -> string | null {
    if written is AST.IdentExpr {
        return written.name
    }
    if written is AST.GenericInstExpr {
        callee :: written.callee
        if callee is AST.IdentExpr {
            return callee.name
        }
    }
    return null
}

// Whether `d` stays: a named declaration that is reached, the surface included
// since the walk starts from it, an impl whose private type is, and everything
// else.
is_reached :: fn(d: AST.Decl, reachable: Set<string>, private_types: Set<string>) -> bool {
    name :: declared_name(d)
    if name != null {
        return name in reachable
    }
    owner :: private_type_of(d, private_types) else return true
    return owner in reachable
}

// ---- tests ----------------------------------------------------------------

import "std/string"
import "std/testing"
import "toolchain/parser"

// What is left of the one-file module `source`: the names it declares, an impl
// as `Type:Trait`.
left_of :: fn(source: string) -> string {
    parsed :: parse_source(source, "t.vader")
    files :: [SourceFile { .path = "t.vader", .content = source, .program = parsed.program }]
    names: string[]: []
    for d in without_tests(files, "t").files[0].program.decls {
        if d is AST.ImplDecl {
            target :: d.for_type
            if target is AST.IdentExpr {
                names.push("${target.name}:${AST.impl_trait_name(d)}")
            }
            continue
        }
        names.push(declared_name(d) else continue)
    }
    return names.join(" ")
}

@test
test_without_tests_drops_a_test_and_what_only_it_reaches :: fn() -> void {
    source :: r"""
        module "t"

        export double :: fn(x: i32) -> i32 = twice(x)

        twice :: fn(x: i32) -> i32 = x * 2

        expected :: fn() -> i32 = 4

        @test
        test_double :: fn() -> void {
            assert_eq(double(2), expected())
        }
        """
    assert_eq(left_of(source), "double twice")
}

@test
test_without_tests_drops_the_impl_of_a_type_only_a_test_names :: fn() -> void {
    source :: r"""
        module "t"

        export Shape :: trait {
            area :: fn(self) -> i32
        }

        Unit :: struct {}

        Unit implements Shape {
            area :: fn(self) -> i32 = 1
        }

        Probe :: struct {}

        Probe implements Shape {
            area :: fn(self) -> i32 = 0
        }

        export unit :: fn() -> Shape = Unit {}

        @test
        test_probe :: fn() -> void {
            assert_eq(Probe {}.area(), 0)
        }
        """
    assert_eq(left_of(source), "Shape Unit Unit:Shape unit")
}

@test
test_without_tests_keeps_what_an_impl_of_an_exported_type_reaches :: fn() -> void {
    source :: r"""
        module "t"

        Named :: trait {
            name :: fn(self) -> string
        }

        export Dog :: struct {}

        Dog implements Named {
            name :: fn(self) -> string = label()
        }

        label :: fn() -> string = "dog"
        """
    assert_eq(left_of(source), "Named Dog Dog:Named label")
}
