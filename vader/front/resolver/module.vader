// vader/front/resolver/module: module discovery + path resolution.
//
// A `Module` represents one resolved-on-disk unit. Imports resolve by
// *name* against an ordered set of include-path roots (GCC `-I` style),
// never relative to the importing file. SPEC §11 disavows relative imports :
// `import "./foo"` / `import "../foo"` are not a language form and are
// rejected (R2025).
//
//   - `import "std/foo"`: resolves against the library root `lib/`, which
//     hosts every namespace the toolchain ships (probed next to the
//     executable, then `<cwd>/lib`, see `resolve_sidecar`).
//   - `import "vader/front/parser"`: a bare name resolved against the project
//     root and each `includePaths` entry, first match wins.
//
// Each candidate path is probed first as a directory (multi-file
// module : every `*.vader` inside contributes), then as a single
// `*.vader` file. The `displayPath` is what shows up in diagnostics
// and dumps: for stdlib this is the raw `std/...` text ; for a project
// module it's the module's declared `module "..."` name.

module "vader/front/resolver"

import "std/env"
import "std/io"
import "std/path"
import "std/string"
import "toolchain/ast"
import "vader/front/parser"

/// The file through which a project drives its own build. Here, beside
/// `MANIFEST_FILENAME`, because the CLI and the driver contract both name it.
export DRIVER_FILENAME :: "build.vader"

/// The file that describes a project folder. A command is handed the folder;
/// only the language server and the debugger look for it, walking up from a
/// file (`find_project_root`).
export MANIFEST_FILENAME :: "vader.json"

/// Module a project's build driver declares, and the entry shim shares.
///
/// Lives here, not in `vader/tools/cli`, because two passes need it and only one of
/// them may import a front-end: the CLI writes the shim, and the dead-code lint
/// has to know that `DRIVER_ENTRY` in this module is an ENTRY POINT. Without
/// that, `build` reads as unreachable: nothing in the project calls it, since
/// its only caller is a shim that exists solely during a driven build.
export DRIVER_MODULE :: "build"

/// Function a build driver must declare: reserved in `DRIVER_MODULE` the way
/// `main` is reserved in a program, with no decorator involved.
export DRIVER_ENTRY :: "build"

/// Where a driven build's generated modules live, relative to the project root.
///
/// Owned by the resolver because the resolver is what READS them: when this
/// directory exists under the project root, it becomes a merge root
/// (`lazy::IncludePath.merge`), so `vader run` / `test` / `lint` / `dump` and the
/// LSP see generated code exactly as `vader build` does. A build driver writes
/// here (`toolchain/build`), it does not decide the location: the two halves have to
/// agree, and only one of them can be authoritative.
///
/// Under `build/` so a checkout's existing ignore rules already cover it.
export GENERATED_ROOT_DIR :: "build/generated"

/// A loaded source file in a module: raw text plus its parsed AST.
export SourceFile :: struct {
    path: string
    content: string
    program: Program
}

/// Concatenate every file's top-level decls of a (possibly multi-file) module
/// into one `Decl[]`. Single-file modules (the common case) return the file's
/// decls directly: zero-copy, no concat allocation. Shared by the typecheck /
/// lower / comptime "decls of a module" accessors so the concat lives once.
///
/// @param files  the module's source files (`Module.files`).
/// @return       every file's decls in file order ; the sole file's decls
///               verbatim for a single-file module.
export concat_file_decls :: fn(files: SourceFile[]) -> Decl[] {
    if files.len() == 1 {
        return files[0].program.decls
    }
    out: Decl[]: []
    for f in files {
        for d in f.program.decls {
            out.push(d)
        }
    }
    return out
}

/// Who brought a root into the module search, and so who provided the modules
/// found under it. The question every policy site actually asks: a shipped
/// library must not import the compiler (R2034), and the toolchain's own exports
/// are outside a project's lint scope (W0012).
///
/// Decided ONCE, where the roots are assembled (`loader::project_include_paths`),
/// and carried from there, never recomputed by matching a module's folder
/// against a list of roots, which is what this replaces.
@displayable
export ModuleOrigin :: enum(u8) {
    /// This build named it: the entry's own folder, a `--include-paths` flag (in a
    /// driven build the compiler's own sources arrive this way), the project root,
    /// a `vader.json includePaths` entry holding no library marker, the generated
    /// tree.
    ///
    /// The ENTRY is always this, whatever it sits under: a root exists because the
    /// caller named that file. `paths[0]` is that root and first match wins, so the
    /// entry never picks up another root's origin.
    ///
    /// That is DECIDED, not an omission, and it has one visible consequence: R2034
    /// does not fire on a library module compiled as the entry. `vader build
    /// lib/probe/probe.vader` stays silent where `vader build app.vader` importing
    /// the same `probe` reports it. Which is right: being a library is
    /// not a property of a DIRECTORY, it is a property of how a build reaches it.
    /// R2034 protects a consumer from a library that SHIPS a dependency on the
    /// compiler and is then imported; a file the caller named on the command line
    /// is not that, whatever it sits under.
    ///
    /// The alternative was testing the entry folder's ANCESTRY against the marker
    /// (which sits at the library ROOT, `lib/`, not at `lib/probe/`): reintroducing
    /// the path-matching this type exists to remove, to report an error whose
    /// premise does not hold.
    Build,
    /// The toolchain ships it: a root holding `LIBRARY_ROOT_MARKER`, whether found
    /// beside the binary in a bundle or declared by the project's manifest.
    Toolchain,
}

/// A resolved module : `id` is its folder, as the root that found it spells it,
/// `display_path` is what users see in the dump, `module_name` is
/// the declared `module "..."` identifier used as the key for
/// `import "..."` lookups, `files` is every file participating in
/// the module (one for single-file, N for folders).
export Module :: struct {
    id: string
    display_path: string
    module_name: string
    /// Who provided this module, see `ModuleOrigin`. It replaces `root_dir`, a
    /// byte-identical duplicate of `id` with no reader, which is what makes the
    /// tag free. Required, with no default: the predecessor it replaces was a
    /// defaulted list on `LoadedProject`, and a literal that omitted it answered
    /// "nothing came from the toolchain" rather than failing to compile.
    origin: ModuleOrigin
    files: SourceFile[]
}

// ---------------------------------------------------------------- discovery

/// Walk up from `start` to the nearest folder holding a `vader.json` or a build
/// driver (`holds_build_driver`), whichever describes the project. The way the
/// language server and the debugger find the project of the file they open.
///
/// @param start  a file or a folder; for a file, the walk starts at its folder.
/// @return       that folder, or null when none up to the filesystem root does.
export find_project_root :: fn(start: string) -> string | null =
    walk_up(start, (dir) -> exists(join_path(dir, MANIFEST_FILENAME)) || holds_build_driver(dir))

/// Whether `dir` holds a build driver: a `build.vader` that declares
/// `module "build"`. A file of that name in another module (the compiler's own
/// `vader/midir/build.vader`) is an ordinary source file of its folder.
///
/// @param dir  the folder to look in.
export holds_build_driver :: fn(dir: string) -> bool {
    path :: join_path(dir, DRIVER_FILENAME)
    text :: read_file_string(path)
    if text is IOError {
        return false
    }
    header :: parse_module_header(text, path) ?? return false
    return header.name == DRIVER_MODULE
}

/// Whether the project folder `dir` is described by its build driver: it holds
/// one and no `vader.json`, which wins where a file's project is found.
///
/// @param dir  a project folder (`find_project_root`).
export is_driven_project :: fn(dir: string) -> bool =
    !exists(join_path(dir, MANIFEST_FILENAME)) && holds_build_driver(dir)

// The nearest folder from `start` up whose `holds` is true, or null.
walk_up :: fn(start: string, holds: fn(string) -> bool) -> string | null {
    // Accept either a file or a directory as the start point ; for
    // a file, walk-up begins at its parent.
    dir := start
    if exists(dir) {
        if !is_dir(dir) {
            dir = dir_of(dir)
        }
    } else {
        dir = dir_of(dir)
    }
    for {
        if holds(dir) {
            return dir
        }
        parent_dir :: dir_of(dir)
        // A drive (`C:`) has no parent: the empty path `dir_of` gives back for it
        // names the working directory.
        if parent_dir == dir || (parent_dir == "" && dir.ends_with(":")) {
            return null
        }
        dir = parent_dir
    }
}

// ---------------------------------------------------------------- path utils

/// Join two path segments with a `/` separator (no normalization).
/// `base` "" yields `seg` unchanged. Doesn't strip trailing `/` from
/// `base` ; callers are expected to pass clean inputs.
export join_path :: fn(base: string, seg: string) -> string {
    // Strip a leading `./` from the relative segment so module ids
    // stay normalised: `from/./mod_a` would render as `## from/./mod_a`
    // in the typecheck dump.
    s :: trim_prefix(seg, "./")
    if base == "" {
        return s
    }
    if base.ends_with("/") {
        return "${base}${s}"
    }
    return "${base}/${s}"
}

/// Directory portion of `path` (everything before the last `/`).
/// Returns "" when no separator is present. Uses `std/path::parent`.
export dir_of :: fn(path: string) -> string { return path.to_path().parent().as_string() }

/// `path` made absolute against the working directory, the base a relative path
/// is read from.
///
/// @param path  a `/`-separated path; one that starts with `/` or a drive letter
///              is kept as it is.
export absolute_path :: fn(path: string) -> string {
    if is_absolute_path(path) {
        return path
    }
    return join_path(current_working_directory(), path)
}

/// Whether `path` is absolute: it starts with `/`, or with a drive letter.
///
/// @param path  a `/`-separated path.
export is_absolute_path :: fn(path: string) -> bool =
    path.starts_with("/") || (path.byte_len() > 1 && path.byte_at(1) == ':')

/// Resolve a resource directory `<base>/subdir` next to the executable, falling
/// back to the bare cwd-relative `subdir`. The sidecar candidate wins only when
/// it holds `marker`. Lets a `dist/` bundle find its stdlib + C runtime next to
/// the binary, while a repo checkout still resolves via the cwd.
///
/// The fallback returns the *relative* `subdir`, never an absolutised cwd path:
/// the resolved root becomes a module-id prefix, and an absolute root reshuffles
/// map-keyed insertion order (the comptime generic-instance collection), drifting
/// snapshots. Relative keeps the historical cwd-relative ids.
export resolve_sidecar :: fn(subdir: string, marker: string) -> string = sidecar_root(
    subdir,
    marker,
) ?? subdir

/// The toolchain's `<base>/subdir`, or null when it does not hold `marker`,
/// i.e. when the running binary is not part of a bundle. `<base>` is
/// `$VADER_HOME`, else the folder the process was told
/// (`register_toolchain_root`), else the executable's own.
///
/// Separate from `resolve_sidecar` because the distinction is load-bearing for
/// namespace reservation: a bundle's library root is AUTHORITATIVE (the toolchain
/// put it there, verified by the marker), so it is searched before the project;
/// the bare cwd-relative fallback is a guess, and a project that happens to have
/// its own `lib/` must not have it searched ahead of its own modules. See
/// `loader::project_include_paths`.
export sidecar_root :: fn(subdir: string, marker: string) -> string | null {
    home :: home_root(subdir, marker)
    if home != null {
        return home
    }
    candidate :: join_path(toolchain_base(), subdir)
    if exists(join_path(candidate, marker)) {
        return candidate
    }
    return null
}

// Where the toolchain sits when `$VADER_HOME` does not say: the folder the
// process was told, else the executable's own.
toolchain_base :: fn() -> string {
    told :: registered_toolchain().path
    if told != "" {
        return told
    }
    return current_executable_location().dir_of()
}

// The toolchain folder a process was told it belongs to; empty when none was.
ToolchainFolder :: struct {
    path: string = ""
}

@singleton
registered_toolchain :: fn() -> ToolchainFolder = ToolchainFolder {}

/// Declare the folder holding the toolchain (its `lib/` and `runtime/`), for a
/// process that does not run from it: a build driver, compiled into its
/// project's `build/driver/`, is told it by the CLI that runs it. `sidecar_root`
/// probes it after `$VADER_HOME`, in place of the executable's own folder.
///
/// @param dir  the toolchain folder; empty leaves the executable's folder.
export register_toolchain_root :: fn(dir: string) -> void {
    registered_toolchain().path = dir
}

/// Environment variable naming the toolchain's own directory: the one holding
/// `lib/`, `runtime/` and (in a bundle) `src/`.
///
/// Optional. Without it the toolchain is found beside the binary, then relative
/// to the working directory, and those two are all a bare binary has, which is
/// why it only works from a directory that happens to hold a `lib/`.
export TOOLCHAIN_HOME_VAR :: "VADER_HOME"

/// `<$VADER_HOME>/subdir` when the variable is set AND that directory holds
/// `marker`, else null.
///
/// Probed BEFORE the executable's own neighbourhood: an explicit setting beats an
/// implicit guess, which is the only reason to have the variable: pointing a
/// binary at a toolchain that is not the one beside it.
///
/// A value that does not hold the marker is IGNORED rather than fatal, so a stale
/// `VADER_HOME` left over from a moved install degrades to the ordinary probe
/// instead of bricking every invocation. That silence is deliberate and it is
/// paid for by `vader doctor`, which reports the variable as set-and-unusable.
///
/// ⚠️ The root it returns is ABSOLUTE, so it becomes an absolute module-id prefix:
/// the same thing a `dist/` bundle already does, and the reason the cwd fallback
/// in `resolve_sidecar` stays relative (see its note on snapshot-order drift). Do
/// not set this variable when running the snapshot corpus.
///
/// @param subdir  resource directory under the home, e.g. `"lib"`, `"runtime/c"`.
/// @param marker  file proving the candidate really is that resource.
/// @return        the resolved root, or null when unset or unusable.
export home_root :: fn(subdir: string, marker: string) -> string | null {
    home :: get_env(TOOLCHAIN_HOME_VAR) ?? return null
    if home == "" {
        return null
    }
    candidate :: join_path(home, subdir)
    if exists(join_path(candidate, marker)) {
        return candidate
    }
    return null
}

/// Marker proving a candidate directory really is a library root.
///
/// `lib/` hosts every namespace the toolchain ships, `std/` among them: it is not
/// the stdlib's own directory, which is why the name says library and not stdlib.
/// The marker is `std/io/io.vader` : `std/io` is a folder module, so the bare
/// `std/io.vader` file does not exist. A stale marker silently defeats the
/// exe-sidecar probe (`sidecar_root`) and forces every binary onto the
/// `<cwd>/lib` fallback, so a `dist/` bundle cannot find its own stdlib unless it
/// is run from a directory that happens to hold one.
export LIBRARY_ROOT_MARKER :: "std/io/io.vader"

/// `.Toolchain` when `dir` holds the library marker, else `.Build`.
///
/// The marker is the whole test: a directory is the toolchain's because it contains
/// `std/io/io.vader`, never because it is spelled `lib`. Exported for the LSP, which
/// asks the same question of a manifest's `includePaths` so the editor and the
/// compiler cannot disagree about which root is which.
///
/// @param dir  a candidate include-path root.
export origin_of_root :: fn(dir: string) -> ModuleOrigin {
    if exists(join_path(dir, LIBRARY_ROOT_MARKER)) {
        return .Toolchain
    }
    return .Build
}


/// Directory name a bundled library root goes by, beside the binary.
export LIBRARY_ROOT_DIR :: "lib"

/// The one module under the library root allowed to import `vader/**`: the
/// build-driver contract, which exists to drive the compiler.
///
/// A driver LINKS the compiler (a hook shares its compilation unit: type indices
/// and atom ids are per-unit), so this cannot be a library that merely reads the
/// language's shapes. `toolchain/span` and `toolchain/ast` are those, and they
/// import nothing from `vader/`, which is what lets a library depend on them.
export DRIVER_CONTRACT_MODULE :: "toolchain/build"

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_a_registered_toolchain_root_provides_its_sidecars :: fn() -> void {
    toolchain :: join_path(temp_dir(), "vader_registered_toolchain_probe")
    create_dir(join_path(toolchain, "kit"))
    write_file_string(join_path(toolchain, "kit/marker"), "")
    register_toolchain_root(toolchain)
    found :: sidecar_root("kit", "marker")
    register_toolchain_root("")
    if get_env(TOOLCHAIN_HOME_VAR) == null {
        assert_eq(found ?? "", join_path(toolchain, "kit"))
    }
}

@test
test_a_build_vader_of_another_module_is_no_driver :: fn() -> void {
    dir :: join_path(temp_dir(), "vader_holds_build_driver_probe")
    create_dir(dir)
    write_file_string(join_path(dir, DRIVER_FILENAME), "module \"tools\"\n")
    assert(!holds_build_driver(dir), "a source file named build.vader is no driver")
    write_file_string(join_path(dir, DRIVER_FILENAME), "module \"build\"\n")
    assert(holds_build_driver(dir), "one declaring `module \"build\"` is")
}

@test
test_origin_of_root_asks_the_marker_not_the_name :: fn() -> void {
    // A directory is the toolchain's because it holds `std/io/io.vader`, never
    // because it is spelled `lib`. This repo's own tree is the fixture.
    assert_eq(origin_of_root(LIBRARY_ROOT_DIR), .Toolchain)
    assert_eq(origin_of_root("vader"), .Build)
    assert_eq(origin_of_root("runtime"), .Build)
    assert_eq(origin_of_root("/no/such/dir"), .Build)
}
