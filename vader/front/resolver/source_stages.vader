// vader/front/resolver/source_stages: the stages that write source into a module
// once every module is parsed.
//
// A source stage reads parsed files of one module and returns source the module
// gains, parsed as a file of its own (`generated_file`): nothing typed, nothing of
// another module. It reads only the files its description gives it (`given`):
// those with a top-level declaration under one of the decorators it names, so a
// load that never meets them pays one look per decorator. A decorator is matched
// to the module that declares it (`written_origin`), whether it is written bare
// or behind an alias. A stage that reads what another generates declares it
// (`generates`), and the plan runs that one first.
//
// The driver of a project plugs stages of its own, which run in its process: the
// build registers them for the project (`register_project_stages`), and every
// load of the project plans them with the compiler's. They read each declared
// decorator of their files under the module that declares it
// (`Decorator.module_name`), as the driver reads every declaration it receives.
//
// A function a stage writes without a body, top-level or impl member, waits for
// the body stage of the same name (`LateFn`), which gives it once the comptime has
// run (`vader/pipeline/check/late_bodies.vader`).

module "vader/front/resolver"

import "std/abort"
import "std/collections"
import "std/iter"
import "std/path"
Time :: import "std/time"
import "toolchain/ast"
import "toolchain/diagnostics"
import "toolchain/parser"
import "toolchain/span"
import "toolchain/stage"
Prof :: import "vader/support/profile"

/// The source stages of the compiler, in the order they are registered.
source_stages :: fn() -> SourceStage[] = [DisplayableStage {}, TestsStage {}]

/// The body stages of the compiler.
body_stages :: fn() -> BodyStage[] = []

// The stages the driver of a project plugged.
DriverStages :: struct {
    sources: SourceStage[]
    bodies: BodyStage[]
}

// The stages the driver of each project being built plugged, by project folder.
@singleton
driver_stages :: fn() -> Map<string, DriverStages> = Map<string, DriverStages> {}

/// Declare the stages the driver of the project `project_root` plugged: every
/// load of the project runs them beside the compiler's, until
/// `forget_project_stages`.
///
/// @param project_root  the project folder, with `\` or `/` separators.
/// @param stages        the source stages, in the order the driver plugged them,
///                      which `project_stages_problem` accepts.
/// @param bodies        the body stages, each named like one of `stages`.
export register_project_stages :: fn(
    project_root: string,
    stages: SourceStage[],
    bodies: BodyStage[],
) -> void {
    driver_stages()[project_root.to_posix()] = DriverStages {
        .sources = stages.clone(),
        .bodies = bodies.clone(),
    }
}

/// Forget the stages of the driver of `project_root`: its build is over.
///
/// @param project_root  the project folder, as `register_project_stages` took it.
export forget_project_stages :: fn(project_root: string) -> void {
    driver_stages().remove(project_root.to_posix())
}

/// Why the stages a driver plugged cannot run beside the compiler's, "" when
/// they can: two stages of one kind under one name, an order none allows, or a
/// body stage no source stage of the driver is named like.
///
/// @param stages  the driver's source stages, in the order it plugged them.
/// @param bodies  its body stages.
export project_stages_problem :: fn(stages: SourceStage[], bodies: BodyStage[]) -> string {
    planned :: plan_stages(with_compiler_stages(stages)) else return planned.message
    sources :: Set<string> {}
    for stage in stages {
        sources.add(stage.describe().name)
    }
    named :: Set<string> {}
    for stage in bodies {
        name :: stage.describe().name
        if !named.add(name) {
            return "two body stages are named `${name}`"
        }
        if name !in sources {
            return "the body stage `${name}` has no source stage of its name"
        }
    }
    return ""
}

/// A source stage a load of a project runs, as `vader info` lists it.
export ListedStage :: struct {
    spec: SourceSpec
    /// Whether a body stage of its name gives the bodies of what it writes
    /// without one.
    gives_bodies: bool = false
}

/// The source stages the driver of `project` adds to a load, in the order the load
/// runs them, plugged or recorded by its last build. The compiler's own are left
/// out: they run in every project.
///
/// @param project  the project folder, posix, null for a file on its own.
export listed_driver_stages :: fn(project: string | null) -> ListedStage[] {
    compiler :: Set<string> {}
    for stage in source_stages() {
        compiler.add(stage.describe().name)
    }
    bodies :: Set<string> {}
    for stage in body_stages_of_driver(project) {
        bodies.add(stage.describe().name)
    }
    listed: ListedStage[]: []
    // The plan, not the driver's list: a stage that reads what another writes
    // runs after it, whatever order the driver plugged them in.
    for stage in planned_source_stages(project) {
        spec :: stage.describe()
        if spec.name !in compiler {
            listed.push(ListedStage { .spec = spec, .gives_bodies = spec.name in bodies })
        }
    }
    return listed
}

// The stages of the driver of `project`, plugged or replayed. Without a project,
// the records are read under the working directory, as the generated modules are.
stages_of_driver :: fn(project: string | null) -> SourceStage[] {
    if project == null {
        return replayed_stages("")
    }
    plugged :: driver_stages()[project] else return replayed_stages(project)
    return plugged.sources
}

/// The body stages of a load: the compiler's, then those of the driver of
/// `project`, plugged or replayed as its source stages are (`stages_of_driver`).
///
/// @param project  the project the load belongs to, posix, null for a file on
///                 its own.
planned_body_stages :: fn(project: string | null) -> BodyStage[] {
    stages :: body_stages()
    stages.push_all(body_stages_of_driver(project))
    return stages
}

// The body stages of the driver of `project`, plugged or replayed.
body_stages_of_driver :: fn(project: string | null) -> BodyStage[] {
    if project == null {
        return replayed_body_stages("")
    }
    plugged :: driver_stages()[project] else return replayed_body_stages(project)
    return plugged.bodies
}

// The compiler's source stages, then `driver`'s.
with_compiler_stages :: fn(driver: SourceStage[]) -> SourceStage[] {
    stages :: source_stages()
    stages.push_all(driver)
    return stages
}

/// The source stages of a load, in a planned order: the compiler's, then those
/// of the driver of `project`: the ones it plugged while its build runs, else
/// those its last build recorded, replayed (`stage_records.vader`). A plan that
/// fails is a compiler bug: the build checks a driver's stages before it
/// registers or records them.
///
/// @param project  the project the load belongs to, posix, null for a file on
///                 its own: the working directory's records are replayed then.
planned_source_stages :: fn(project: string | null) -> SourceStage[] {
    driver :: stages_of_driver(project)
    planned :: plan_stages(with_compiler_stages(driver)) else {
        panic("source stages: ${planned.message}")
    }
    return planned
}

/// A function a source stage wrote without a body, which the body stage of the
/// same name gives once the comptime has run.
export LateFn :: struct {
    /// The id of the module that declares it.
    module: string
    decl: FnDecl
    /// The impl that declares it, null for a function of the module.
    owner: ImplDecl | null
    /// The name of the stages that declare it and give its body.
    stage: string
}

/// The name a file gives a function a stage declared without a body: `Type.name`
/// for a member of an impl on `Type`, then the line of its declaration, which no
/// other function of the stage's file shares (`Person.to_json_value@4`).
///
/// @param decl   the function.
/// @param owner  the impl that declares it, null for a function of the module.
export late_fn_label :: fn(decl: FnDecl, owner: ImplDecl | null) -> string {
    line :: decl.span.start.line
    if owner == null {
        return "${decl.name}@${line}"
    }
    type_name :: impl_type_name(owner) else "impl"
    return "${type_name}.${decl.name}@${line}"
}

/// Run `stages` on the modules of a load from `first` on, each module gaining one
/// file per stage that writes anything, numbered by `ids`. A function a stage
/// writes without a body joins the module's `late`.
///
/// @param modules  the modules of the load, parsed, none collected yet: those
///                 before `first` only declare decorators.
/// @param first    the first module the stages run on.
/// @param stages   the source stages, planned.
/// @param bodies   the names of the body stages of the load.
/// @param ids      numbers the declarations the stages write.
/// @param diags    where the parse errors of the files written and what the
///                 stages report go.
/// @error          H6017 at a function written without a body by a stage no body
///                 stage is named like.
run_source_stages :: fn(
    modules: DeferredModule[],
    first: i64,
    stages: SourceStage[],
    bodies: Set<string>,
    ids: NodeIdFactory,
    diags: Diagnostic[],
) -> void {
    specs :: stages.map((stage) -> stage.describe()).collect()
    declared :: declared_by(modules, specs)
    named :: Set<string> {}
    for at in first..<modules.len() {
        m :: modules[at]
        for i in 0..<stages.len() {
            stage :: stages[i]
            spec :: specs[i]
            files: Program[]: []
            for source in m.sources {
                if writes_given(source.program, m.found.name, spec.given, declared) {
                    files.push(source.program)
                }
            }
            if files.is_empty() {
                continue
            }
            for program in files {
                // Only a stage given a decorator a module declares reads one.
                if declared.len() > 0 && named.add(program.file) {
                    name_declared_decorators(program, m.found.name, declared)
                }
            }
            began :: Time.monotonic()
            generated :: stage.run(Sources { .module_name = m.found.name, .files = files })
            Prof.note_stage(spec.name, false, i64(Time.since(began)))
            diags.push_all(generated.diagnostics)
            if generated.text == "" {
                continue
            }
            path :: generated_file(spec.name, m.found.name)
            content :: framed_source(spec.name, m.found.name, m.found.name, generated.text)
            parsed :: parse_stage_written(content, path)
            diags.push_all(parsed.errors)
            origins :: anchor_impls(parsed.program, generated.anchors, spec.name)
            assign_program_ids(parsed.program, ids)
            late :: late_fns_of(parsed.program, m.found.folder, spec.name)
            if spec.name !in bodies {
                for l in late {
                    detail :: "`${l.decl.name}`: no body stage is named `${spec.name}`"
                    diags.push(hook_error(.LateBodyWithoutStage, l.decl.name_span, detail))
                }
            }
            m.late.push_all(late)
            m.sources.push(SourceFile {
                .path = path,
                .content = content,
                .program = parsed.program,
                .origins = origins,
            })
        }
    }
}

// The functions of `program`, which the stage `stage` wrote into the module
// `module`, that have no body: top-level, then impl members, in source order.
late_fns_of :: fn(program: Program, module: string, stage: string) -> LateFn[] {
    out: LateFn[]: []
    late :: (decl: FnDecl, owner: ImplDecl | null) -> {
        if decl.body == null && !decl.decorators.has_compiler_decorator(.Extern) {
            out.push(LateFn {
                .module = module,
                .decl = decl,
                .owner = owner,
                .stage = stage,
            })
        }
    }
    for d in program.decls {
        if d is FnDecl {
            late(d, null)
        } else if d is ImplDecl {
            for member in d.members {
                late(member, d)
            }
        }
    }
    return out
}

// Name the module that declares each decorator of `program` a module declares
// (`Decorator.module_name`), in place: above its declarations, their fields,
// variants and parameters, and their members. Those `declared` does not know
// keep an empty name, as a decorator of the compiler does.
name_declared_decorators :: fn(
    program: Program,
    module_name: string,
    declared: Map<string, Set<string>>,
) -> void {
    for d in program.decls {
        name_sites(program, module_name, d, place_of(d), declared)
        for member in members_of(d) {
            name_sites(program, module_name, member, member_place(d), declared)
        }
    }
}

name_sites :: fn(
    program: Program,
    module_name: string,
    decl: Decl,
    place: string,
    declared: Map<string, Set<string>>,
) -> void {
    for site in decorator_sites(decl, place) {
        for written in site.decorators {
            origin :: written_origin(program, module_name, written, declared) else continue
            written.module_name = origin.module
        }
    }
}

// The decorators each module of `modules` declares, when one of `specs` is given
// a declared decorator: empty otherwise, which no stage then reads.
declared_by :: fn(modules: DeferredModule[], specs: SourceSpec[]) -> Map<string, Set<string>> {
    if !specs.any_match((spec) -> spec.given.any_match((g) -> g is DecoratorOrigin)) {
        return Map<string, Set<string>> {}
    }
    return declared_decorators(modules)
}

// Whether `program`, a file of the module `module_name`, has a top-level
// declaration under a decorator of `given`.
writes_given :: fn(
    program: Program,
    module_name: string,
    given: Given[],
    declared: Map<string, Set<string>>,
) -> bool {
    for d in program.decls {
        for written in decl_decorators(d) {
            if given.any_match((g) -> names_given(program, module_name, written, g, declared)) {
                return true
            }
        }
    }
    return false
}

// Whether `written`, a decorator of `program`, is the one `given` names.
names_given :: fn(
    program: Program,
    module_name: string,
    written: Decorator,
    given: Given,
    declared: Map<string, Set<string>>,
) -> bool {
    if given is DecoratedWith {
        return written.is_compiler(given.marker)
    }
    origin :: written_origin(program, module_name, written, declared) else return false
    return same_origin(origin, given)
}

// Give each impl of `program`, which the stage `stage` wrote, the span of its
// anchor, in order: the origin of each impl so anchored.
anchor_impls :: fn(program: Program, anchors: Span[], stage: string) -> CodeOrigin[] {
    origins: CodeOrigin[]: []
    message :: "the code `${stage}` writes here"
    i: i64 = 0
    for d in program.decls.filter_is<ImplDecl>() {
        if i >= anchors.len() {
            break
        }
        origins.push(CodeOrigin {
            .start = d.span.start.offset,
            .end = d.span.end.offset,
            .origin = Related { .span = anchors[i], .message = message },
        })
        d.span = anchors[i]
        i += 1
    }
    return origins
}

// ---- tests ----------------------------------------------------------------

import "std/string"
import "std/testing"

// A stage that reads the declarations under `Route` of `http`, and writes some
// under `@displayable`.
RouterStage :: struct {}

RouterStage implements SourceStage {
    describe :: fn(self) = SourceSpec {
        .name = "router",
        .given = [DecoratorOrigin { .module = "http", .name = "Route" }],
        .generates = [DecoratedWith { .marker = .Displayable }],
    }
    run :: fn(self, input: Sources) -> Generated = Generated {}
}

@test
test_source_plan_runs_a_generator_before_its_reader :: fn() -> void {
    stages: SourceStage[]: [DisplayableStage {}, RouterStage {}]
    planned :: plan_stages(stages) else return assert_eq(planned.message, "")
    assert_eq(planned.map((s) -> s.describe().name).collect().join(", "), "router, displayable")
}

// Whether the first function of `source`, a file of the module `app`, is given
// to `RouterStage`, `http` declaring `Route`.
given_to_router :: fn(source: string) -> bool {
    program :: parse_source(source, "app.vader").program
    routes :: Set<string> {}
    routes.add("Route")
    declared :: Map<string, Set<string>> {}
    declared["http"] = routes
    return writes_given(program, "app", RouterStage {}.describe().given, declared)
}

@test
test_source_stage_reads_a_decorator_behind_an_alias :: fn() -> void {
    source :: "module \"app\"\nH :: import \"http\"\n@H.Route\nf :: fn() -> i32 = 0\n"
    assert(given_to_router(source), "`@H.Route` is the `Route` of `http`")
}

@test
test_source_stage_skips_a_decorator_of_another_module :: fn() -> void {
    source :: "module \"app\"\nimport \"web\"\n@Route\nf :: fn() -> i32 = 0\n"
    assert(!given_to_router(source), "`@Route` of `web` is not the `Route` of `http`")
}

@test
test_driver_stages_named_like_another_cannot_run :: fn() -> void {
    assert_eq(project_stages_problem([RouterStage {}], []), "")
    assert_eq(
        project_stages_problem([RouterStage {}, RouterStage {}], []),
        "two stages are named `router`",
    )
}

// A body stage named `name`.
NamedBodies :: struct {
    name: string
}

NamedBodies implements BodyStage {
    describe :: fn(self) -> BodySpec = BodySpec { .name = self.name }
    run :: fn(self, input: BodyRequest) -> Body = Body { .text = "{}" }
}

@test
test_a_body_stage_runs_beside_the_source_stage_of_its_name :: fn() -> void {
    assert_eq(project_stages_problem([RouterStage {}], [NamedBodies { .name = "router" }]), "")
    assert_eq(
        project_stages_problem([RouterStage {}], [NamedBodies { .name = "other" }]),
        "the body stage `other` has no source stage of its name",
    )
}

@test
test_a_stage_reads_the_module_of_each_declared_decorator :: fn() -> void {
    source :: "module \"app\"\nH :: import \"http\"\nS :: struct {\n    @H.Route\n    x: i32\n}\n"
    program :: parse_source(source, "app.vader").program
    routes :: Set<string> {}
    routes.add("Route")
    declared :: Map<string, Set<string>> {}
    declared["http"] = routes
    name_declared_decorators(program, "app", declared)
    s :: program.decls[1]
    if s !is StructDecl {
        assert(false, "the second declaration is the struct")
        return
    }
    assert_eq(s.fields[0].decorators[0].module_name, "http")
}
