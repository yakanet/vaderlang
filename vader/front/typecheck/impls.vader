// vader/front/typecheck/impls: registry of `T implements Trait { ... }` blocks.
//
// One entry per impl, its trait and target resolved through the names the impl
// writes (an import followed to the declaration it names) so an entry is keyed
// on identity (`impl_base_key` of the target, `trait_key` of the trait), never on
// a spelling two modules can share. The lowerer drives impl-member lookup,
// virtual dispatch and the vtables from it.

module "vader/front/typecheck"

import "std/collections"
import "std/iter"
import "toolchain/ast"
import "vader/front/parser"
import "vader/front/resolver"
import "vader/core/symbol"
import "vader/core/types"
import "vader/support/diagnostics"

/// One `T implements Trait { ... }` block, indexed by the registry.
export ImplEntry :: struct {
    decl: ImplDecl
    /// The trait's declaration (`SymbolKind.Trait`).
    trait_symbol: Symbol
    /// Display path of the module that DECLARES this impl block (e.g.
    /// `"std/core"` for the intrinsic `string implements Display`).
    /// Distinct from the caller's module: the impl-member mangle must
    /// use the owning module so cross-module calls resolve to the same
    /// mangle the impl's lowered/surfaced decl is registered under.
    module: string = ""
    /// True when the impl references ≥1 type parameter (`Range<T>
    /// implements<T> …`, `Range<T> implements …`). Mirrors
    /// `is_empty_substitution(build_impl_mixed_subst(...))` in the lowerer
    /// (`lower/mono_struct.vader`) :
    /// generic impls erase their instance args to `Any` when mangling
    /// materialised members (`__Any` suffix), so call-site resolution
    /// (`find_impl_member_for`, `lower_for_in`) must erase the same way.
    /// Concrete-instantiation impls (`Wrapper<i32> implements …`) keep
    /// the concrete suffix.
    is_generic: bool = false
    /// The trait's `trait_key`.
    trait_key: string = ""
    /// The type the impl is written for, resolved in its own module.
    for_type: Type = TY_UNRESOLVED
    /// `impl_base_key(for_type)`: compared with a receiver's to ask whether the
    /// impl applies to its declaration.
    target: string = ""
    /// Written for one instance of its base (`Wrapper<MonType> implements …`,
    /// `is_instance_receiver`) : it covers that instance alone, and wins there over
    /// the base's generic impl.
    instance: bool = false
    /// The trait's arguments as the impl writes them (`Add<f64>` → `[f64]`) : what
    /// tells two impls of one trait on one base apart.
    trait_args: Type[] = []
    /// What tells apart the members of several impls of one trait on one base,
    /// declared in one module (`Vec2 implements Add<f64>` beside `Add<Vec2>`,
    /// `MonType[] implements Into<Label>` beside `… Into<Tag>`) : "" for the first
    /// registered, then `$1`, `$2`, …: a `$`, which no type name in a receiver's
    /// own suffix carries. Every builder of an impl member's mangle appends it : the
    /// call sites and the materialisers.
    overload_suffix: string = ""
}

/// Project-wide registry. Built once by `build_impl_registry` ; queried
/// by the typechecker and the lowerer.
export ImplRegistry :: struct {
    /// Entries keyed `"${target}::${trait_key}"`: several when concrete
    /// instantiations (`Box<i32>`, `Box<string>`) each implement the trait.
    by_target: MutableMap<string, ImplEntry[]> = MutableMap<string, ImplEntry[]> {}
    /// Every entry, keyed by its impl's `span.hash()`: unique project-wide.
    by_decl: MutableMap<u64, ImplEntry> = MutableMap<u64, ImplEntry> {}
    /// Every entry, keyed by the node id of each member it declares, a materialised
    /// one included (`member_entry`).
    by_member: MutableMap<i64, ImplEntry> = MutableMap<i64, ImplEntry> {}
    /// Every entry the registry has seen: used by the lowerer to drive
    /// virtual dispatch over trait-typed receivers.
    all: ImplEntry[] = []
    /// Entries keyed by their `target`, every trait together.
    by_base: MutableMap<string, ImplEntry[]> = MutableMap<string, ImplEntry[]> {}
    /// `impl_type_key` of every type an impl on one instance is built from
    /// (`MonType` for `Wrapper<MonType>`), see `is_specialized_arg`.
    specialized_args: MutableSet<string> = MutableSet<string> {}
    /// `target` of every base two impls of one trait cover whole (`Vec2 implements
    /// Mul<f64>` beside `Mul<Vec2>`), see `is_specialized_arg`.
    overloaded_bases: MutableSet<string> = MutableSet<string> {}
}

/// Harvest the `ImplDecl`s of `program_decls` into a fresh registry.
///
/// @param program_decls  one module's declarations.
/// @param resolved       that module.
build_impl_registry :: fn(program_decls: Decl[], resolved: ResolvedModule) -> ImplRegistry {
    reg :: ImplRegistry {}
    reg.collect_impls(program_decls, resolved)
    return reg
}

/// Register one entry per `ImplDecl` of `decls` whose trait name binds to a
/// trait.
///
/// @param decls     one module's declarations.
/// @param resolved  the module that declares them: it resolves each impl.
export collect_impls :: fn(self: ImplRegistry, decls: Decl[], resolved: ResolvedModule) -> void {
    for d in decls {
        if d is ImplDecl {
            self.collect_impl(d, resolved)
        }
    }
}

/// The trait `decl` implements: the symbol its name binds to in the impl's
/// own module, an import followed to the declaration it names. Null when the
/// name binds to nothing there, or to something that is not a trait.
///
/// @param decl      the impl.
/// @param resolved  the module that declares `decl`.
impl_trait_symbol :: fn(decl: ImplDecl, resolved: ResolvedModule) -> Symbol | null {
    bound :: resolved.idents[decl.trait_name_span.hash()] ?? return null
    target :: redirect_import(bound, resolved)
    return if target.kind == .Trait { target } else { null }
}

collect_impl :: fn(self: ImplRegistry, impl_: ImplDecl, resolved: ResolvedModule) -> void {
    trait_sym :: impl_trait_symbol(impl_, resolved) ?? return
    scratch: Diagnostic[]: []
    for_type :: type_from_expr(impl_.for_type, resolved, scratch)
    target :: impl_base_key(for_type)
    trait_key :: trait_key_of(trait_sym)
    instance :: is_instance_receiver(for_type)
    same_trait :: self.impls_of(target, trait_key)
    earlier := 0
    for other in same_trait {
        if other.module == resolved.display_path {
            earlier += 1
        }
        if !instance && !other.instance {
            self.overloaded_bases.add(target)
        }
    }
    entry :: ImplEntry {
        .decl            = impl_,
        .trait_symbol    = trait_sym,
        .module          = resolved.display_path,
        .is_generic      = impl_is_generic(impl_, resolved),
        .trait_key       = trait_key,
        .for_type        = for_type,
        .target          = target,
        .instance        = instance,
        .trait_args      = written_type_args(impl_.trait_args, resolved, scratch),
        .overload_suffix = if earlier == 0 { "" } else { "$${earlier}" },
    }
    push_entry(self.by_target, "${target}::${trait_key}", entry)
    push_entry(self.by_base, target, entry)
    self.by_decl[impl_.span.hash()] = entry
    for m in impl_.members {
        // A member synthesised without an id names no site.
        if m.id != UNASSIGNED_NODE_ID {
            self.by_member[m.id] = entry
        }
    }
    self.all.push(entry)
    if instance {
        self.record_specialized_args(for_type)
    }
}

push_entry :: fn(table: MutableMap<string, ImplEntry[]>, key: string, entry: ImplEntry) -> void =
    table.get_or_put_with(key, () -> []).push(entry)

// Every type `receiver`'s arguments are built from.
record_specialized_args :: fn(self: ImplRegistry, receiver: Type) -> void {
    built_from: Type[]: []
    for arg in type_arguments(receiver) {
        for_each_type(arg, (sub) -> built_from.push(sub))
    }
    for sub in built_from {
        self.specialized_args.add(impl_type_key(sub))
    }
}

/// True when the impl references ≥1 type parameter. Mirrors the
/// discriminator the lowerer's `build_impl_mixed_subst` computes : the
/// `implements<T>` form (`impl_.type_params` non-empty) and the legacy
/// `Foo<T> implements …` form (a `for_type` arg that binds to a `TypeParam`)
/// both count. Concrete instantiations (`Wrapper<i32> implements …`) bind
/// their for-type args to other declarations and return false.
impl_is_generic :: fn(impl_: ImplDecl, resolved: ResolvedModule) -> bool {
    if impl_.type_params.len() > 0 {
        return true
    }
    gi :: impl_.for_type
    if gi is GenericInstExpr {
        for ta in gi.type_args {
            bound :: resolved.idents[ta.span.hash()] ?? continue
            if bound.kind == .TypeParam {
                return true
            }
        }
    }
    return false
}

/// The parameters an impl declares : its `implements<…>`, and the fresh names its
/// `for_type`'s arguments bind when it writes none (`Stack<T> implements Trait<T>`).
/// An impl member's signature quantifies over them.
export impl_type_params_of :: fn(impl_: ImplDecl, resolved: ResolvedModule) -> TypeParamType[] {
    out :: quantifier_of(impl_.type_params, resolved)
    gi :: impl_.for_type
    if gi is GenericInstExpr {
        for ta in gi.type_args {
            bound :: resolved.idents[ta.span.hash()] ?? continue
            if bound.kind == .TypeParam && !out.any_match((tp) -> tp.symbol.id == bound.id) {
                out.push(TypeParamType { .symbol = bound })
            }
        }
    }
    return out
}

// ---- query API ------------------------------------------------------------

NO_IMPLS: ImplEntry[]: []

/// The impls of the trait `trait_key` whose target is `target`.
///
/// @param target     an `impl_base_key`.
/// @param trait_key  a `trait_key`.
export impls_of :: fn(self: ImplRegistry, target: string, trait_key: string) -> ImplEntry[] {
    found :: self.by_target["${target}::${trait_key}"] ?? return NO_IMPLS
    return found
}

/// The impls whose target is `target`, every trait together.
///
/// @param target  an `impl_base_key`.
export impls_on :: fn(self: ImplRegistry, target: string) -> ImplEntry[] {
    found :: self.by_base[target] ?? return NO_IMPLS
    return found
}

/// Whether `entry` covers `receiver` : a generic or plain impl covers every instance
/// of its base, an impl on one instance (`Wrapper<MonType>`) that instance alone.
///
/// @param entry     an impl of `receiver`'s base.
/// @param receiver  the type asked about.
export impl_covers :: fn(entry: ImplEntry, receiver: Type) -> bool =
    !entry.instance || impl_type_key(entry.for_type) == impl_type_key(default_if_free(receiver))

any_instance_impl :: fn(entries: ImplEntry[]) -> bool {
    for entry in entries {
        if entry.instance {
            return true
        }
    }
    return false
}

/// The impls of `trait_key` that cover `receiver`, the one written for its own
/// instance first : it wins over its base's generic impl.
///
/// @param receiver   the type asked about.
/// @param trait_key  a `trait_key`.
export impls_for :: fn(self: ImplRegistry, receiver: Type, trait_key: string) -> ImplEntry[] =
    covering_first(self.impls_of(impl_base_key(receiver), trait_key), receiver)

/// `entries` that cover `receiver`, the instance impls first, less the generic impls
/// one of them hides: the same trait at arguments some instantiation makes equal
/// (`MonType[] implements Into<Label>` leaves `T[] implements<T> Into<Iterator<T>>`).
///
/// @param entries   impls of `receiver`'s base.
/// @param receiver  the type asked about.
export covering_first :: fn(entries: ImplEntry[], receiver: Type) -> ImplEntry[] {
    if !any_instance_impl(entries) {
        return entries
    }
    own: ImplEntry[]: []
    rest: ImplEntry[]: []
    for entry in entries {
        if !impl_covers(entry, receiver) {
            continue
        }
        if entry.instance {
            own.push(entry)
        } else {
            rest.push(entry)
        }
    }
    if own.len() == 0 {
        return rest
    }
    out: ImplEntry[]: []
    out.push_all(own)
    for entry in rest {
        if !hidden_by(own, entry, receiver) {
            out.push(entry)
        }
    }
    return out
}

/// The impl of `trait_key` covering `receiver` at the trait arguments `args`, when
/// several impls of the trait cover it (`Vec2 implements Mul<f64>` beside
/// `Mul<Vec2>`, reached through `T: Mul<f64>`) ; null when at most one does (it is
/// found by name) or none matches.
///
/// @param receiver   the concrete receiver.
/// @param trait_key  the trait.
/// @param args       the trait arguments the use site names.
export impl_at_args :: fn(
    self: ImplRegistry, receiver: Type, trait_key: string, args: Type[],
) -> ImplEntry | null {
    covering :: self.impls_for(receiver, trait_key)
    if covering.len() < 2 {
        return null
    }
    for entry in covering {
        if may_coincide_each(entry.trait_args, args) {
            return entry
        }
    }
    return null
}

// Whether one of the impls `own`, on a receiver's own instance, implements the
// trait instance `generic` does there : it then serves that receiver instead.
// `receiver` binds `generic`'s own parameters (`T[] implements<T>
// Into<Iterator<T>!>` at `MonType[]` is `Into<Iterator<MonType>!>`).
hidden_by :: fn(own: ImplEntry[], generic: ImplEntry, receiver: Type) -> bool {
    if !any_of_trait(own, generic.trait_key) {
        return false
    }
    args :: trait_args_at(generic, receiver)
    for o in own {
        if o.trait_key == generic.trait_key && may_coincide_each(o.trait_args, args) {
            return true
        }
    }
    return false
}

any_of_trait :: fn(entries: ImplEntry[], trait_key: string) -> bool {
    for entry in entries {
        if entry.trait_key == trait_key {
            return true
        }
    }
    return false
}

/// The type each of `entry`'s own type parameters takes at `receiver` : the type the
/// impl is written for, matched against `receiver`.
///
/// @param entry     an impl of the registry.
/// @param receiver  a type the impl covers.
export impl_bindings_at :: fn(entry: ImplEntry, receiver: Type) -> MutableMap<i32, Type> {
    bindings :: MutableMap<i32, Type> {}
    unify_type_param(entry.for_type, receiver, bindings)
    return bindings
}

// `entry`'s trait arguments at `receiver`.
trait_args_at :: fn(entry: ImplEntry, receiver: Type) -> Type[] {
    if !entry.is_generic {
        return entry.trait_args
    }
    bindings :: impl_bindings_at(entry, receiver)
    out: Type[]: []
    for a in entry.trait_args {
        out.push(substitute_map(a, bindings))
    }
    return out
}

/// Whether a generic instance must keep the type argument `t` concrete : `t` is, or
/// is built from, a type an impl on one instance names, or a type two impls of one
/// trait cover. Erased to `Any`, the first would build that instance under its
/// base's shared tag, and the instance's own impl would never be reached ; the
/// second would dispatch by the trait alone, which cannot tell the two impls apart.
///
/// @param t  a concrete type argument of a generic instance.
export is_specialized_arg :: fn(self: ImplRegistry, t: Type) -> bool {
    if self.specialized_args.is_empty() && self.overloaded_bases.is_empty() {
        return false
    }
    return any_type(t, (sub) -> self.keeps_concrete(sub))
}

keeps_concrete :: fn(self: ImplRegistry, t: Type) -> bool =
    impl_type_key(t) in self.specialized_args || impl_base_key(t) in self.overloaded_bases

/// The impl that declares the member `member`, a materialised one included ; null
/// for a fn no impl declares.
///
/// @param member  an impl member, as the typecheck's call-site record names it.
export member_entry :: fn(self: ImplRegistry, member: FnDecl) -> ImplEntry | null =
    self.by_member[member.id]

/// The impl that serves `receiver` in place of `entry` : one written for the
/// receiver's own instance that implements the same trait instance (impl
/// specialization), else `entry` itself.
///
/// @param entry     the impl chosen against a receiver naming a type parameter.
/// @param receiver  that receiver at an instance.
export serving_impl :: fn(self: ImplRegistry, entry: ImplEntry, receiver: Type) -> ImplEntry {
    // No impl is written for one instance anywhere.
    if entry.instance || self.specialized_args.is_empty() {
        return entry
    }
    args :: trait_args_at(entry, receiver)
    for own in self.impls_for(receiver, entry.trait_key) {
        if own.instance && may_coincide_each(own.trait_args, args) {
            return own
        }
    }
    return entry
}

/// The entry of `decl`, or null when its trait name binds to no trait.
///
/// @param decl  an impl the registry was built from.
export entry_of :: fn(self: ImplRegistry, decl: ImplDecl) -> ImplEntry | null = self.by_decl[decl.span.hash()]

// ---- tests ----------------------------------------------------------------

import "std/testing"

build_test_registry :: fn(src: string) -> ImplRegistry {
    parsed :: parse_source(src, "t.vader")
    factory :: SymbolFactory {}
    rm :: resolve_module(parsed.program, "t", factory)
    return build_impl_registry(parsed.program.decls, rm)
}

@test
test_registry_collects_one_impl :: fn() -> void {
    src :: """
Display :: trait { to_string :: fn(self) -> string }
Point   :: struct { x: i32 }
Point implements Display -> "point"
"""
    reg :: build_test_registry(src)
    assert_eq(reg.all.len(), 1)
}

@test
test_has_user_recognises_registered_impl :: fn() -> void {
    src :: """
Display :: trait { to_string :: fn(self) -> string }
Point   :: struct { x: i32 }
Point implements Display -> "point"
"""
    parsed :: parse_source(src, "t.vader")
    factory :: SymbolFactory {}
    rm :: resolve_module(parsed.program, "t", factory)
    reg :: build_impl_registry(parsed.program.decls, rm)
    // Pull the two symbols by name to query the registry.
    point :: lookup_named(rm, "Point")
    disp :: lookup_named(rm, "Display")
    match point {
        is null -> { assert(false, "Point symbol should be resolved") }
        is Symbol -> {
            match disp {
                is null -> { assert(false, "Display symbol should be resolved") }
                is Symbol -> {
                    assert(reg.impls_of(declaration_key(point), trait_key_of(disp)).len() == 1,
                        "Point implements Display should be registered")
                }
            }
        }
    }
}

@test
test_registry_empty_when_no_impls :: fn() -> void {
    src :: """
add :: fn(a: i32, b: i32) -> i32 { return a + b }
"""
    reg :: build_test_registry(src)
    assert_eq(reg.all.len(), 0)
}

lookup_named :: fn(rm: ResolvedModule, name: string) -> Symbol | null {
    for s in rm.symbols {
        if s.name == name {
            return s
        }
    }
    return null
}
