// vader/front/typecheck/expr_intrinsic: `@size_of(T)` / `@type_name(T)` /
// etc. typing.
//
// Each intrinsic's static return type comes from
// `vader/front/parser/intrinsics::intrinsic_spec(name).result`. The result
// string is one of "i64", "bool", "string", "type", "field_array",
// "type_array" (`type_for_result`) : a primitive, `type`, `type[]`, or
// `std/core`'s `Field[]`. `@field` and `@min` / `@max` take theirs from their
// arguments, and are unresolved when those are wrong.

module "vader/front/typecheck"

import "vader/support/diagnostics"
import "vader/front/parser"
import "vader/core/symbol"
import "vader/core/types"
AST :: import "toolchain/ast"

/// Type-check an `@name(...)` call, argument by argument as the intrinsic's spec
/// says. A `.Type` argument bypasses `check_expr`: no `expr_types` entry is made
/// for its inner ident.
infer_intrinsic :: fn(e: AST.IntrinsicCallExpr, typed: TypedProgram, diags: Diagnostic[]) -> Type {
    spec :: intrinsic_spec(e.name)
    if spec is null {
        // Parser already rejects unknown @name ; defensive only.
        for a in e.args { check_expr(a, null, typed, diags) }
        return TY_UNRESOLVED
    }
    for i in 0..<e.args.len() {
        match kind :: spec.arg_kind(i) {
            .Value | .TypeValue | .Unevaluated -> {
                check_intrinsic_value(e.args[i], kind, typed, diags)
            }
            .Type -> {
                // Record the resolved Type in `type_expr_types` so
                // downstream consumers (the lowerer's intrinsic
                // fold, the comptime instance harvester) can recover
                // generic instances like `Pair<string, i64>` via
                // a span-keyed (`Span.hash()`) lookup. Without this write, the
                // `harvest_instances` pass never observes the
                // instance and the @fields / @type_args fold falls
                // through to LoweredUnreachable.
                resolved :: type_from_expr(e.args[i], typed.resolved, diags)
                typed.type_expr_types[e.args[i].span.hash()] = resolved
            }
        }
    }
    // Every intrinsic takes as many arguments as its spec lists: past here, each
    // one sits where its kind says.
    if e.args.len() != spec.args.len() {
        diags.push(typecheck_error(.WrongArgCount, e.span,
            "`@${e.name}` expected ${spec.args.len()}, got ${e.args.len()}"))
        return type_for_result(spec.result, typed)
    }
    if e.name == "fields" || e.name == "field_index" {
        check_struct_argument(e, typed, diags)
    }
    if e.name == "field_index" {
        check_field_index(e, typed, diags)
    }
    if e.name == "field" {
        return infer_field_intrinsic(e, typed, diags)
    }
    if e.name == "min" || e.name == "max" {
        return integer_bound_type(e, typed, diags)
    }
    return type_for_result(spec.result, typed)
}

// Type-check a value argument. One that names a type (`@size_of(i32)`,
// `@size_of(null)`) is recorded as a `.Type` argument is, so the lowerer folds it
// statically; any other must be a `type` when `kind` is `.TypeValue`.
check_intrinsic_value :: fn(
    arg: AST.Expr, kind: IntrinsicArgKind, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    got :: check_expr(arg, null, typed, diags)
    if is_type_operand(arg, typed.resolved) {
        scratch: Diagnostic[]: []
        typed.type_expr_types[arg.span.hash()] = type_from_expr(arg, typed.resolved, scratch)
    } else if kind == .TypeValue {
        check_type_value(arg, got, diags)
    }
}

// A `.TypeValue` argument must be a `type`: `@size_of(h)` on an `i64` has no width
// to read, and both backends would stop on it at run time.
check_type_value :: fn(arg: AST.Expr, got: Type, diags: Diagnostic[]) -> void {
    if got is TypeMetaType | UnresolvedType {
        return
    }
    diags.push(typecheck_error(.TypeMismatch, arg.span, expected_got(TY_TYPE, got)))
}

// `@field(x, "name")` with a literal name on a struct or a union of structs reads
// the field as `x.name` would, `@internal` and narrowing included. A name only
// `@comptime for` unrolls, or a receiver that is neither (a type parameter), types
// as unresolved : lowering resolves it once the name or the type is known.
infer_field_intrinsic :: fn(
    e: AST.IntrinsicCallExpr, typed: TypedProgram, diags: Diagnostic[],
) -> Type {
    recv_ty :: typed.expr_types[e.args[0].id] ?? return TY_UNRESOLVED
    if recv_ty !is UnionType && struct_backing(recv_ty) == null {
        return TY_UNRESOLVED
    }
    field_name :: AST.string_literal_text(e.args[1]) ?? return TY_UNRESOLVED
    access :: AST.FieldExpr {
        .span = e.span,
        .target = e.args[0],
        .field = field_name,
        .field_span = e.args[1].span,
        .is_numeric = false,
    }
    return try_union_common_field_dispatch(recv_ty, access, typed, diags)
        ?? resolve_struct_field(recv_ty, access, typed, diags)
}

// `@fields(T)` and `@field_index(T, ...)` read the fields of a struct: a `T` known
// to be something else is a type mismatch, at the type.
check_struct_argument :: fn(
    e: AST.IntrinsicCallExpr, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    owner :: typed.type_expr_types[e.args[0].span.hash()] ?? return
    if is_known_non_struct(owner) {
        diags.push(typecheck_error(.TypeMismatch, e.args[0].span,
            "`@${e.name}` reads the fields of a struct, got `${display_type(owner)}`"))
    }
}

// Whether `t` is settled as something other than a struct. A type parameter,
// `Self`, or a type not yet known may still be one.
is_known_non_struct :: fn(t: Type) -> bool = match t {
    is StructType -> false
    is TypeParamType | SelfType | InferVar | UnresolvedType | AnyType -> false
    is PrimitiveType | RangeType | DistinctType | EnumType | UnionType -> true
    is ArrayType | TupleType | FnType | TraitType | TypeMetaType | NeverType -> true
    is FreeIntType | FreeCharType | FreeFloatType -> true
}

// `@field_index(T, "name")` on a struct names one of its fields. A name only
// `@comptime for` unrolls, or a type parameter, is left to lowering, which knows
// both. The comptime evaluator counts on this check: it reports nothing for such
// a name (`REPORTED_BY_TYPECHECK`).
check_field_index :: fn(
    e: AST.IntrinsicCallExpr, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    owner :: typed.type_expr_types[e.args[0].span.hash()] ?? return
    name :: AST.string_literal_text(e.args[1]) ?? return
    if owner !is StructType {
        return
    }
    decl :: typed.struct_decls[owner.symbol.id] ?? return
    if field_position(decl, name) >= 0 {
        return
    }
    diags.push(typecheck_error(.MemberDoesNotExist, e.args[1].span,
        "`${name}` on `${display_type(owner)}`"))
}




type_for_result :: fn(name: string, typed: TypedProgram) -> Type {
    if name == "i64"        { return TY_I64 }
    if name == "bool"       { return TY_BOOL }
    if name == "string"     { return TY_STRING }
    if name == "type"       { return TY_TYPE }
    if name == "type_array" { return mk_array(TY_TYPE) }
    if name == "field_array" {
        // `@fields(T) -> Field[]`: `Field` lives in std/core
        // (auto-imported). Fall back to Unresolved when std/core
        // hasn't been registered yet (compiling std/core itself).
        field_sym :: typed.field_symbol
        match field_sym {
            is null -> { return TY_UNRESOLVED }
            is Symbol -> { return mk_array(mk_struct(field_sym, [])) }
        }
    }
    return TY_UNRESOLVED
}
