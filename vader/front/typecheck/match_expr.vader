// vader/front/typecheck/match_expr: MatchExpr inference.
//
// `match scrutinee { p1 -> b1, p2 -> b2 }` types as the join of its arm bodies
// (`join_branch_types`: their union, a free literal arm repinned to a concrete one).
// An `is T` arm narrows the scrutinee (a name, a field chain, or the header
// binding of `match x :: e`) to `T`, the wildcard arm to what the arms above leave
// (`arm_narrow_for`). Every match is exhaustive (T3013) : a union or an enum by
// its variants, an integer type by its values (its literal and range arms, an
// integer variant of a union alike), any other scrutinee by `_`. Guards must be
// `bool` (T3019).

module "vader/front/typecheck"

import "vader/support/diagnostics"
import "vader/support/integer"
import "vader/core/types"
AST :: import "toolchain/ast"

// Type-check the literal / range bound expressions embedded directly in a
// pattern, an or-pattern's alternatives included ; every other pattern kind carries
// none. A literal is checked as `compared == literal` (`check_pattern_literal`)
// and a range's bounds as the operands `compared` is ordered against
// (`check_range_pattern`), both against `rest`, what the arms above leave of
// `scrut`.
check_pattern_bound_exprs :: fn(
    pat: AST.Pattern,
    compared: AST.Expr,
    scrut: Type,
    rest: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    match pat {
        is AST.LiteralPattern -> {
            check_pattern_literal(pat.value, compared, scrut, rest, typed, diags)
        }
        is AST.RangePattern -> {
            check_range_pattern(pat, scrut, rest, typed, diags)
        }
        is AST.OrPattern -> {
            for sub in pat.patterns {
                check_pattern_bound_exprs(sub, compared, scrut, rest, typed, diags)
            }
        }
        _ -> {}
    }
}

/// Type-check a `MatchExpr`. `expected` flows into every arm body so
/// `let x: i32 = match v { is Foo -> 1, is Bar -> 2 }` narrows each
/// arm to i32.
// The symbol the resolver minted for a `match` header's binding ; null without one.
header_symbol :: fn(binding: AST.SimpleBinding | null, typed: TypedProgram) -> Symbol | null {
    present :: binding ?? return null
    return typed.resolved.idents[present.name_span.hash()]
}

infer_match :: fn(
    e: AST.MatchExpr,
    expected: Type | null,
    typed: TypedProgram,
    diags: Diagnostic[],
    ctx: FnContext | null,
) -> Type {
    raw_scrut :: check_expr(e.scrutinee, null, typed, diags)
    scrut_ty :: lift_enum_placeholder(raw_scrut, typed)
    // `match x :: e { … }` : the binding IS the narrowing slot, so an EXPRESSION
    // scrutinee narrows exactly like a named one, which is the whole point of the
    // form. The resolver minted the binding at the `x` token and registered it in
    // `idents`, so the symbol is reachable from the MatchExpr alone. The
    // field-narrow key is empty for a binding : it is a slot, not a chain.
    scrut :: e.scrutinee
    binding :: e.binding
    bound :: header_symbol(binding, typed)
    if binding != null && bound != null {
        assign_binding_types(binding, scrut_ty, typed, diags)
    }
    scrut_sym_id    :: if bound is Symbol { bound.id } else { scrutinee_sym_id(scrut, typed) }
    scrut_field_key :: if bound is Symbol { "" } else { scrutinee_field_key(scrut, typed) }
    arm_types: Type[]: []
    bodies: AST.Expr[]: []
    remaining := scrut_ty
    has_wildcard := false
    covered_enum_variants: string[]: []
    // The integer type among the scrutinee's (itself, or a union's one integer
    // variant) and its values no unguarded arm took yet : its literal and range
    // arms cover it, and once they took every value it is matched.
    counted :: counted_integer(scrut_ty)
    whole :: integer_set_of(counted)
    uncovered := whole
    // Unions, enums and integer types, whose arms can consume the scrutinee. Any
    // other scrutinee REQUIRES a wildcard (T3013 says so in as many words), and an
    // `is P` over it subtracts the whole of `P` here, so on those W0014 would
    // flag the arm T3013 just demanded.
    // Arms testing `Self` in a default body cloned for an impl : the impl settles
    // them, so one that can never match, or that an earlier one covers, is no
    // mistake.
    settled :: settled_by_clone(typed, scrut_ty)
    closed_scrutinee :: !settled && (scrut_ty is UnionType || scrut_ty is EnumType || whole != null)
    for arm in e.arms {
        // W0014, nothing is left for this arm to match: a wildcard, or arms
        // that together consumed the scrutinee, came before it. T3013 asks the
        // opposite question (is a variant MISSING) and T3040 compares against
        // the scrutinee's static type, so neither sees a variant covered twice.
        if closed_scrutinee && (has_wildcard || remaining is NeverType) {
            diags.push(
                warning(
                    .UnreachableMatchArm,
                    arm.pattern.span,
                    "every value of `${display_type(scrut_ty)}` is already matched above",
                ),
            )
        }
        check_pattern_bound_exprs(arm.pattern, scrut, scrut_ty, remaining, typed, diags)
        // Re-bind the pattern types against the narrowed `remaining`
        // so the wildcard arm sees only the still-possible
        // variants ("union − matched").
        bind_pattern_types(arm.pattern, remaining, typed, diags)
        arm_narrow :: arm_narrow_for(arm.pattern, remaining, counted, uncovered, typed)
        prev_arm: NarrowSlot | null = null
        if scrut_sym_id != -1 {
            if arm_narrow !is null {
                arm_type :: narrowed_in_clone(typed, scrut_ty, arm_narrow)
                prev_arm = push_narrow(typed, scrut_sym_id, arm_type)
            }
        }
        prev_field: NarrowSlot | null = null
        if scrut_field_key != "" {
            if arm_narrow !is null {
                prev_field = push_field_narrow(typed, scrut_field_key, arm_narrow)
            }
        }
        guard :: arm.guard
        if guard !is null {
            got :: check_expr(guard, TY_BOOL, typed, diags)
            if !is_assignable(got, TY_BOOL) {
                diags.push(
                    typecheck_error(
                        .ConditionMustBeBool,
                        guard.span,
                        "match-arm guard must be `bool`, got ${display_type(got)}",
                    ),
                )
            }
        }
        arm_types.push(check_expr(arm.body, expected, typed, diags))
        bodies.push(arm.body)
        if scrut_sym_id != -1 {
            if arm_narrow !is null {
                pop_narrow(typed, scrut_sym_id, prev_arm)
            }
        }
        if scrut_field_key != "" {
            if arm_narrow !is null {
                pop_field_narrow(typed, scrut_field_key, prev_field)
            }
        }
        // Subtract the matched type from `remaining` for subsequent
        // arms: `is T`, wildcard/binding, and tuple shapes consume
        // their corresponding union variants.
        // A guarded arm (`is T if cond ->`, `_ if cond ->`) matches only
        // when its guard holds at runtime, so it contributes NOTHING to
        // coverage : no variant subtraction, no covered-variant record, no
        // wildcard. Counting it would silence T3013 on a match that can
        // still fall through. (The overlap check on `is T` stays: a guard
        // cannot make a type-impossible test reachable.) A literal field in the
        // pattern (`is P { x: 10 }`) is a guard written inline, and counts the same.
        guarded :: arm.guard != null || is_constrained(arm.pattern)
        match pattern :: arm.pattern {
            is AST.IsPattern          -> {
                matched :: pattern_type_of(pattern.ty, typed, scratch_diags())
                check_is_test_target(matched, pattern.span, typed, diags)
                if !settled && is_overlap_checkable(scrut_ty) && is_overlap_checkable(matched) {
                    if !types_overlap(scrut_ty, matched) {
                        diags.push(
                            typecheck_error(
                                .UnreachableIsTest,
                                pattern.span,
                                "`${display_type(matched)}` is never a value of `${display_type(scrut_ty)}`",
                            ),
                        )
                    }
                }
                if !guarded {
                    // Subtracting a type already gone leaves `remaining` equal:
                    // the arm restates a test an earlier one made.
                    //
                    // Gated on the test being possible at all. `is null` against
                    // `Cat | Dog` also subtracts nothing, but nothing covered it
                    // earlier either: it can never match, which is T3040's
                    // question, not this one. Reporting it here would say "an
                    // earlier arm covers it" of a variant no arm can hold.
                    narrowed :: subtract_type_with_impls(remaining, matched, typed)
                    covers_something :: is_overlap_checkable(scrut_ty)
                        && is_overlap_checkable(matched)
                        && types_overlap(scrut_ty, matched)
                    if covers_something && equals_type(narrowed, remaining)
                        && remaining !is NeverType {
                        diags.push(
                            warning(
                                .UnreachableMatchArm,
                                pattern.span,
                                "`${display_type(matched)}` is matched by an earlier arm",
                            ),
                        )
                    }
                    remaining = narrowed
                }
            }
            is AST.EnumVariantPattern -> {
                // A variant in a PATTERN is checked exactly as one in an
                // expression is (`expr_dot_variant`, same T3027): an arm naming
                // a variant that does not exist would otherwise type-check,
                // match nothing, and count itself as covering one. Only a
                // directly enum-typed scrutinee is judged; anything wider stays
                // silent rather than risk a false positive.
                if scrut_ty is EnumType {
                    if scrut_ty.indices[pattern.variant] is null {
                        diags.push(typecheck_error(.UnknownEnumVariant, pattern.span,
                            "`${pattern.variant}` is not a variant of ${display_type(scrut_ty)}"))
                    }
                }
                if !guarded {
                    if covered_enum_variants.contains(pattern.variant) {
                        diags.push(
                            warning(
                                .UnreachableMatchArm,
                                pattern.span,
                                "`.${pattern.variant}` is matched by an earlier arm",
                            ),
                        )
                    }
                    covered_enum_variants.push(pattern.variant)
                }
            }
            is AST.WildcardPattern    -> {
                if !guarded {
                    has_wildcard = true
                    remaining = TY_NEVER
                }
            }
            // `null ->` takes the `null` of a union as `is null` does.
            is AST.LiteralPattern     -> {
                if !guarded && pattern.value is AST.NullLitExpr {
                    narrowed :: subtract_type_with_impls(remaining, TY_NULL, typed)
                    if equals_type(narrowed, remaining) && types_overlap(scrut_ty, TY_NULL)
                        && remaining !is NeverType {
                        diags.push(
                            warning(.UnreachableMatchArm, pattern.span, "`null` is matched by an earlier arm"),
                        )
                    }
                    remaining = narrowed
                }
            }
            is AST.OrPattern          -> {
                for sub in pattern.patterns {
                    if sub is AST.IsPattern {
                        tested :: pattern_type_of(sub.ty, typed, scratch_diags())
                        check_is_test_target(tested, sub.span, typed, diags)
                    }
                }
                // Each alternative consumes its own variant: enum variants add
                // to the covered set, `is T` alternatives subtract their type.
                // Literal alternatives take values of an integer scrutinee below.
                if !guarded {
                    for sub in pattern.patterns {
                        if sub is AST.EnumVariantPattern {
                            covered_enum_variants.push(sub.variant)
                        }
                        if sub is AST.IsPattern && !is_constrained(sub) {
                            remaining = subtract_type_with_impls(
                                remaining,
                                pattern_type_of(sub.ty, typed, scratch_diags()),
                                typed,
                            )
                        }
                    }
                }
            }
            _                         -> {}
        }
        if !guarded && counted != null && whole != null && uncovered != null
            && uncovered.len() > 0 {
            uncovered = covering(uncovered, whole, arm.pattern, diags)
            if uncovered.len() == 0 {
                remaining = subtract_type_with_impls(remaining, counted, typed)
            }
        }
    }
    // T3013: non-exhaustive match. `@partial` / `@unreachable` opt out
    // (the latter asserts the uncovered variants trap rather than degrade).
    if !has_wildcard && !e.partial && !e.unreachable && e.arms.len() > 0 {
        if settled {
            // The impl's type, one arm or none covering it.
            if !is_never(remaining) {
                diags.push(
                    typecheck_error(
                        .NonExhaustiveMatch,
                        e.span,
                        "no arm matches `${display_type(scrut_ty)}`, the impl's `Self`",
                    ),
                )
            }
        } else if scrut_ty is UnionType {
            if !is_never(remaining) {
                diags.push(typecheck_error(
                    .NonExhaustiveMatch,
                    e.span,
                    uncovered_variant_detail(remaining, scrut_ty, counted, whole, uncovered, typed),
                ))
            }
        } else if scrut_ty is EnumType {
            missing_variant :: missing_enum_variant_name(scrut_ty, typed, covered_enum_variants)
            if missing_variant != "" {
                diags.push(
                    typecheck_error(
                        .NonExhaustiveMatch,
                        e.span,
                        "variant .${missing_variant} of ${display_type(scrut_ty)} is not covered",
                    ),
                )
            }
        } else if scrut_ty is UnresolvedType {
            // skip: upstream error already surfaced.
        } else if uncovered != null {
            if !is_never(remaining) && uncovered.len() > 0 {
                detail :: uncovered_detail(uncovered[0], scrut_ty)
                diags.push(typecheck_error(.NonExhaustiveMatch, e.span, detail))
            }
        } else {
            diags.push(
                typecheck_error(
                    .NonExhaustiveMatch,
                    e.span,
                    "match on non-union ${display_type(scrut_ty)} requires a wildcard arm",
                ),
            )
        }
    }
    // W0005: a wildcard arm on a closed union silences the T3013 check above,
    // so a newly added variant degrades silently into `_` instead of erroring
    // (a silent mis-compile). Any match that CONTRIBUTES A VALUE
    // must enumerate every variant or opt out with `@partial`. This includes the
    // `return`-per-arm form (every arm diverges → result_ty is `never`), which is
    // the dominant compiler style and the one that hid the `impl_base_key` /
    // `bc_type_of` footguns, so `never` is NOT exempt. Only a genuine void
    // statement match (`_ -> {}`, side-effects only) and open scrutinees
    // (i32 / string / …) stay out of scope.
    result_ty :: join_branch_types(bodies, arm_types, typed, diags)
    // `has_wildcard` is only set by a wildcard arm, so it already
    // implies ≥ 1 arm: no explicit arm-count guard needed.
    // A `_` over `Self` in a default body is what the body needs, whichever impl
    // it was cloned for.
    if has_wildcard && !settled && !e.partial && !e.unreachable && !is_void(result_ty) {
        if scrut_ty is UnionType || scrut_ty is EnumType {
            diags.push(
                warning(
                    .WildcardOnClosedUnion,
                    e.span,
                    "`${display_type(scrut_ty)}`",
                ),
            )
        }
    }
    return result_ty
}

// What an integer scrutinee leaves uncovered once the arm `pattern` took its
// values : a literal or a range, or each of an or-pattern's alternatives. An arm
// whose values of the type `whole` holds are all taken already is W0014, said once
// by the arm's own check when no value is left at all ; values out of the type are
// T3066's.
covering :: fn(
    uncovered: Interval[],
    whole: Interval[],
    pattern: AST.Pattern,
    diags: Diagnostic[],
) -> Interval[] {
    if pattern is AST.OrPattern {
        left := uncovered
        for sub in pattern.patterns {
            left = covering(left, whole, sub, diags)
        }
        return left
    }
    if uncovered.len() == 0 {
        return uncovered
    }
    taken :: pattern_values(pattern) ?? return uncovered
    if !meets_any(whole, taken) {
        return uncovered
    }
    if meets_any(uncovered, taken) {
        return interval_remove(uncovered, taken)
    }
    diags.push(
        warning(.UnreachableMatchArm, pattern.span, "its values are matched by an earlier arm"),
    )
    return uncovered
}

// Whether `taken` shares a value with one of `set`.
meets_any :: fn(set: Interval[], taken: Interval) -> bool {
    for part in set {
        if interval_meet(part, taken) != null {
            return true
        }
    }
    return false
}

// T3013's detail for the first values `gap` of the integer scrutinee `scrut` no arm
// covers : `value `12` of Hour`, `code points `0..=96` of char`.
uncovered_detail :: fn(gap: Interval, scrut: Type) -> string {
    values :: display_values(gap)
    backing :: strip_distinct(scrut)
    if backing is PrimitiveType && backing.name == "char" {
        return "code points `${values}` of ${display_type(scrut)} are not covered"
    }
    if gap.lo == gap.hi {
        return "value `${values}` of ${display_type(scrut)} is not covered"
    }
    return "values `${values}` of ${display_type(scrut)} are not covered"
}

// `gap` as written : one value alone, else its bounds.
display_values :: fn(gap: Interval) -> string {
    if gap.lo == gap.hi {
        return "${gap.lo}"
    }
    return display_bounds(gap)
}

// The values the literal or range pattern `p` matches, as one interval ; null for
// any other pattern, a bound no integer or `char` literal, and an empty range.
pattern_values :: fn(p: AST.Pattern) -> Interval | null {
    if p is AST.LiteralPattern {
        value :: literal_scalar(p.value) ?? return null
        return interval(value, value)
    }
    if p !is AST.RangePattern {
        return null
    }
    lo :: literal_scalar(p.lower) ?? return null
    written_hi :: literal_scalar(p.upper) ?? return null
    hi :: greatest_below(written_hi, p.inclusive) ?? return null
    if hi < lo {
        return null
    }
    return interval(lo, hi)
}

// The value of an integer or `char` literal ; null for any other expression.
literal_scalar :: fn(e: AST.Expr) -> i64 | null {
    if e is AST.CharLitExpr {
        return i64(e.value)
    }
    return int_literal_i64(e)
}

// The integer type whose values a match over `scrut` counts arm by arm : `scrut`
// itself, or the one integer variant of a union (`Hour` of `Hour | null`) ; null
// for none, and for a union of several, which a literal would not tell apart.
counted_integer :: fn(scrut: Type) -> Type | null {
    if integer_set(scrut) != null {
        return scrut
    }
    if scrut !is UnionType {
        return null
    }
    found: Type | null = null
    for v in scrut.variants {
        if integer_set(v) == null {
            continue
        }
        if found != null {
            return null
        }
        found = v
    }
    return found
}

// The values of `counted` (`integer_set`), null when there is none.
integer_set_of :: fn(counted: Type | null) -> Interval[] | null {
    if counted == null {
        return null
    }
    return integer_set(counted)
}

// T3013's detail for a union scrutinee : the first values of its integer variant no
// arm covers, when arms took some of them, else the variants left.
uncovered_variant_detail :: fn(
    remaining: Type,
    scrut: Type,
    counted: Type | null,
    whole: Interval[] | null,
    uncovered: Interval[] | null,
    typed: TypedProgram,
) -> string {
    if counted != null && whole != null && uncovered != null && took_some(whole, uncovered)
        && uncovered.len() > 0
        && !equals_type(subtract_type_with_impls(remaining, counted, typed), remaining) {
        return uncovered_detail(uncovered[0], counted)
    }
    return "variant ${display_type(remaining)} of ${display_type(scrut)} is not covered"
}

// Whether arms took some of the values `whole` : what is left differs from it.
took_some :: fn(whole: Interval[], left: Interval[]) -> bool {
    if whole.len() != left.len() {
        return true
    }
    for i in 0..<whole.len() {
        if !same_interval(whole[i], left[i]) {
            return true
        }
    }
    return false
}

// First enum variant name absent from `covered`. Uses the EnumType's
// `indices` map (populated at declare-time) so we don't need to walk
// the program AST a second time.
missing_enum_variant_name :: fn(
    en: EnumType,
    typed: TypedProgram,
    covered: string[],
) -> string {
    for [name, _] in en.indices {
        found := false
        for c in covered {
            if c == name {
                found = true
                break
            }
        }
        if !found {
            return name
        }
    }
    return ""
}

is_never :: fn(t: Type) -> bool {
    if t is NeverType {
        return true
    }
    return false
}

// The type an `is T` pattern denotes.
//
// `diags` is the sink `type_from_expr` writes into. The callers that re-derive a
// pattern checked elsewhere pass a throwaway one, so a type is reported once ;
// `bind_pattern_types`, which walks each pattern once, passes the caller's, and a
// pattern's diagnostics must reach it : an unreported `is Alias.Nope` takes a
// branch under the VM that native never takes.
pattern_type_of :: fn(ty: AST.Expr, typed: TypedProgram, diags: Diagnostic[]) -> Type =
    type_from_expr(ty, typed.resolved, diags)

arm_narrow_for :: fn(
    p: AST.Pattern,
    remaining: Type,
    counted: Type | null,
    uncovered: Interval[] | null,
    typed: TypedProgram,
) -> Type | null = match p {
    // `is T` narrows to `T`, the wildcard to what the arms above leave, a literal or
    // range arm an integer scrutinee to its values ; enum-variant and struct
    // patterns carry no slot narrowing.
    is AST.IsPattern -> pattern_type_of(p.ty, typed, scratch_diags())
    is AST.WildcardPattern -> left_values(remaining, counted, uncovered)
    is AST.LiteralPattern | AST.RangePattern | AST.OrPattern -> taken_values(p, counted)
    is AST.StructPattern | AST.EnumVariantPattern -> null
}

// What a literal, range or or-pattern arm narrows an integer scrutinee to : the
// values it takes within `counted`, the hull of an or-pattern's. Null for any
// other scrutinee, and for a pattern taking no integer value ; `char` and a
// distinct are not narrowed to a range (`inside_of`).
taken_values :: fn(p: AST.Pattern, counted: Type | null) -> Type | null {
    target :: counted ?? return null
    taken :: arm_values(p) ?? return null
    return inside_of(target, RangeType { .bounds = taken })
}

// The values `p` takes, as one interval : a literal's or a range's, the hull of an
// or-pattern's alternatives ; null when one of them takes no integer value.
arm_values :: fn(p: AST.Pattern) -> Interval | null {
    if p !is AST.OrPattern {
        return pattern_values(p)
    }
    hull: Interval | null = null
    for sub in p.patterns {
        values :: pattern_values(sub) ?? return null
        if hull == null {
            hull = values
        } else {
            hull = interval_join(hull, values)
        }
    }
    return hull
}

// What the wildcard narrows the scrutinee to : what the arms above leave, the one
// interval of an integer scrutinee no arm took when that is all that is left.
left_values :: fn(remaining: Type, counted: Type | null, uncovered: Interval[] | null) -> Type {
    if counted == null || uncovered == null || uncovered.len() != 1
        || !equals_type(remaining, counted) {
        return remaining
    }
    return inside_of(counted, RangeType { .bounds = uncovered[0] }) ?? remaining
}

is_overlap_checkable :: fn(t: Type) -> bool {
    // @partial: overlap is undecidable only for the four open / abstract
    // variants below; every concrete variant has a checkable value domain.
    @partial match t {
        is UnresolvedType -> { return false }
        is TypeParamType  -> { return false }
        is TypeMetaType   -> { return false }
        is TraitType      -> { return false }
        _                 -> { return true }
    }
}

scrutinee_sym_id :: fn(scrut: AST.Expr, typed: TypedProgram) -> i32 {
    if scrut !is AST.IdentExpr {
        return -1
    }
    sym :: typed.resolved.idents[scrut.span.hash()] ?? return -1
    return sym.id
}

/// Build the `${root_sym.id}#path` field-narrow key when the
/// scrutinee is a `recv.f1.f2.…` chain rooted at an `IdentExpr`.
/// Returns `""` (no narrowing slot) for other scrutinee shapes.
scrutinee_field_key :: fn(scrut: AST.Expr, typed: TypedProgram) -> string {
    if scrut !is AST.FieldExpr {
        return ""
    }
    return field_chain_key(scrut, typed)
}

/// Walk a match-arm pattern and record each binding's type in
/// `typed.local_types`. Struct patterns bind through `bind_struct_pattern`.
bind_pattern_types :: fn(
    p: AST.Pattern, scrut: Type, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    match p {
        is AST.IsPattern      -> {
            narrowed :: pattern_type_of(p.ty, typed, diags)
            // Recorded for the lowerer, by node id : the clones of a default
            // method keep the trait's spans, each with fresh ids.
            typed.expr_types[p.ty.id] = narrowed
            // Nested pattern (e.g. `is T { x, y }`): recurse
            // with the narrowed type so inner StructPattern bindings
            // pick up T's field types.
            if p.inner !is null {
                bind_pattern_types(p.inner, narrowed, typed, diags)
            }
        }
        is AST.StructPattern -> { bind_struct_pattern(p, scrut, typed, diags) }
        is AST.OrPattern     -> {
            for sub in p.patterns {
                bind_pattern_types(sub, scrut, typed, diags)
            }
        }
        _                           -> {}
    }
}

// Each field of `{ name, x: 10 }` names a field of the struct: a binding takes
// its type, a literal is checked against it (the lowering compares the two).
bind_struct_pattern :: fn(
    sp: AST.StructPattern,
    scrut: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    st :: struct_backing(scrut)
    if st == null {
        if scrut !is UnresolvedType {
            diags.push(typecheck_error(
                .TypeMismatch, sp.span,
                "a `{ … }` pattern reads the fields of a struct, got `${display_type(scrut)}`"))
        }
        return
    }
    decl :: typed.struct_decls[st.symbol.id] ?? return
    for field in sp.fields {
        // T3054 : reject binding an `@internal` field in a struct
        // pattern from outside its declaring module.
        check_internal_field(st, decl, field.name, field.name_span, typed, diags)
        raw :: resolved_field_type(st.symbol.id, decl, field.name, typed, scratch_diags())
        if raw == null {
            diags.push(typecheck_error(
                .FieldDoesNotExist, field.name_span,
                "`${field.name}` on ${display_type(scrut)}"))
            continue
        }
        // `Box<i32> { value }` reads `value` as `i32`, not as the declared `T`.
        ft :: substitute_struct_args(raw, st, typed)
        match value :: field.value {
            is AST.PatternBinding -> { typed.local_types[value.span.hash()] = ft }
            is AST.PatternLiteral -> {
                check_pattern_literal(value.value, value.value, ft, ft, typed, diags)
            }
        }
    }
}

// A literal pattern (or a literal constraining a struct field) matches when
// `compared == literal` holds, so it is checked as the right operand of that `==`
// is (`infer_binary`): typed alone, a free literal then repinned to the variant it
// fills, and `==`'s own rule applied (`check_equality`). It meets `rest`, what the
// arms above leave of `scrut` : after `is Point ->`, `"a"` meets `string | null`,
// and `Point` needs no `Equals`. A literal whose variant they consumed can no
// longer match (W0014) ; once nothing is left, the arm-level W0014 has it.
// `compared` only lends its span to the diagnostics.
check_pattern_literal :: fn(
    literal: AST.Expr,
    compared: AST.Expr,
    scrut: Type,
    rest: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    alone :: check_expr(literal, null, typed, diags)
    if rest is NeverType {
        repin_operand(literal, alone, scrut, typed, diags)
        return
    }
    got :: repin_operand(literal, alone, rest, typed, diags)
    if counterpart(rest, got) == null && !equals_type(rest, scrut) {
        whole :: repin_operand(literal, alone, scrut, typed, diags)
        if counterpart(scrut, whole) != null {
            diags.push(
                warning(
                    .UnreachableMatchArm,
                    literal.span,
                    "every `${display_type(whole)}` is matched by an earlier arm",
                ),
            )
            return
        }
    }
    comparison :: AST.BinaryExpr {
        .span = literal.span,
        .op = .Eq,
        .left = compared,
        .right = literal,
    }
    check_equality(comparison, rest, got, typed, diags)
}

// A range pattern matches when `lower <= scrutinee <=(<) upper` holds, so each
// bound is repinned as an ordering operand is, to `rest`, what the arms above
// leave of `scrut`, a distinct read as its backing as `<` reads it. Both bounds
// are recorded at one integer or `char` type, the scrutinee's or one of its
// variants: the lowerer reads the variant to test from the lower bound's type.
check_range_pattern :: fn(
    pat: AST.RangePattern,
    scrut: Type,
    rest: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    lower :: check_expr(pat.lower, null, typed, diags)
    upper :: check_expr(pat.upper, null, typed, diags)
    written :: range_target(scrut, rest)
    target :: strip_distinct(written)
    if !offers_range(target) {
        report_range_scrutinee(pat, lower, upper, scrut, written, typed, diags)
        return
    }
    low :: repin_operand(pat.lower, lower, target, typed, diags)
    high :: repin_operand(pat.upper, upper, target, typed, diags)
    ordered :: range_variant(target, low)
    if ordered == null {
        variants :: "an integer or `char` variant of `${display_type(written)}`"
        diags.push(
            typecheck_error(
                .TypeMismatch,
                pat.lower.span,
                "a range orders ${variants}, got `${display_type(low)}`",
            ),
        )
        return
    }
    emit_mismatch_if(low, ordered, pat.lower.span, null, .TypeMismatch, typed, diags)
    emit_mismatch_if(high, ordered, pat.upper.span, null, .TypeMismatch, typed, diags)
}

// A range over `written` with no integer or `char` to order. When the arms above
// took the scrutinee's, the arm can no longer match (W0014), as a literal whose
// variant they took; the bounds still land on that variant for the lowerer.
// Otherwise the scrutinee has none (T3001).
report_range_scrutinee :: fn(
    pat: AST.RangePattern,
    lower: Type,
    upper: Type,
    scrut: Type,
    written: Type,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    whole_target :: strip_distinct(scrut)
    if !offers_range(whole_target) {
        diags.push(
            typecheck_error(
                .TypeMismatch,
                pat.span,
                "a range pattern matches an integer or a `char`, got `${display_type(written)}`",
            ),
        )
        return
    }
    whole :: repin_operand(pat.lower, lower, whole_target, typed, diags)
    repin_operand(pat.upper, upper, whole_target, typed, diags)
    diags.push(
        warning(
            .UnreachableMatchArm,
            pat.span,
            "every `${display_type(whole)}` is matched by an earlier arm",
        ),
    )
}

// What a range pattern's bounds meet: what the arms above leave of the
// scrutinee, or the whole of it once they left nothing (the arm is then W0014).
range_target :: fn(scrut: Type, rest: Type) -> Type {
    if rest is NeverType {
        return scrut
    }
    return rest
}

// Whether a range can match a value of `t`: `t` is an integer or a `char`, or a
// union holding one.
offers_range :: fn(t: Type) -> bool {
    for v in union_variants(t) ?? [t] {
        if v is UnresolvedType || is_integer_or_char(v) {
            return true
        }
    }
    return false
}

// The type a range over `target` orders: `target` itself, or over a union the
// integer or `char` variant its lower bound `low` lands on.
range_variant :: fn(target: Type, low: Type) -> Type | null {
    if target !is UnionType {
        return target
    }
    v :: counterpart(target, low) ?? return null
    if is_integer_or_char(v) {
        return v
    }
    return null
}

is_integer_or_char :: fn(t: Type) -> bool = t is RangeType || is_char(t)

scratch_diags :: fn() -> Diagnostic[] { return [] }

// Whether an `is T { … }` pattern tests a field against a literal: it then
// matches only some values of `T`.
is_constrained :: fn(p: AST.Pattern) -> bool {
    if p !is AST.IsPattern {
        return false
    }
    if p.inner is AST.StructPattern {
        for field in p.inner.fields {
            if field.value is AST.PatternLiteral {
                return true
            }
        }
    }
    return false
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "vader/front/parser"
import "vader/front/resolver"
import "vader/core/symbol"
import "toolchain/span"

accept_match :: fn(e: AST.Expr) -> AST.Expr | null {
    if e is AST.MatchExpr {
        return e
    }
    return null
}

ExpectedMatch :: struct {
    typed: TypedProgram
    m: AST.MatchExpr
}

expect_match :: fn(src: string) -> ExpectedMatch {
    parsed :: parse_source(with_integers(src), "t.vader")
    factory :: SymbolFactory {}
    rm :: resolve_module(parsed.program, "t", factory)
    diags: Diagnostic[]: []
    result :: check_module(parsed.program, rm, diags)
    last :: parsed.program.decls[parsed.program.decls.len() - 1]
    match last {
        is AST.FnDecl -> {
            match b :: last.body {
                is null          -> {}
                is AST.BlockExpr -> {
                    hit :: find_first_in_block(b, accept_match)
                    if hit is AST.MatchExpr { return ExpectedMatch {
                        .typed = result.typed,
                        .m = hit,
                    } }
                }
            }
        }
        _                  -> {}
    }
    assert(false, "expected a MatchExpr in: ${src}")
    return ExpectedMatch { .typed = result.typed, .m = synthetic_match() }
}

synthetic_match :: fn() -> AST.MatchExpr {
    sp :: empty_span()
    scrut: AST.Expr: AST.IntLitExpr {
        .span = sp,
        .id = AST.UNASSIGNED_NODE_ID,
        .value = 0,
    }
    return AST.MatchExpr {
        .span = sp,
        .id = AST.UNASSIGNED_NODE_ID,
        .scrutinee = scrut,
        .arms = [],
        .partial = false,
    }
}

@test
test_match_single_arm_returns_arm_type :: fn() -> void {
    src :: "f :: fn(x: i32) -> i32 { return match x { _ -> 42 } }"
    em :: expect_match(src)
    diags: Diagnostic[]: []
    assert_eq(display_type(infer_match(em.m, null, em.typed, diags, null)), "{integer}")
}

@test
test_match_two_arms_unions :: fn() -> void {
    src :: "f :: fn(x: i32) -> string | i32 { return match x { 0 -> \"zero\", _ -> 1 } }"
    em :: expect_match(src)
    diags: Diagnostic[]: []
    ty :: infer_match(em.m, null, em.typed, diags, null)
    // union_of sorts by display (`s` < `{`), so `string | {integer}`.
    assert_eq(display_type(ty), "string | {integer}")
}

@test
test_match_guard_non_bool_emits_T3019 :: fn() -> void {
    src :: "f :: fn(x: i32) -> i32 { return match x { _ if 1 -> 0, _ -> 1 } }"
    em :: expect_match(src)
    diags: Diagnostic[]: []
    infer_match(em.m, null, em.typed, diags, null)
    found := false
    for d in diags {
        if d.code.id == "T3019" {
            found = true
        }
    }
    assert(found, "expected T3019 on non-bool guard")
}
