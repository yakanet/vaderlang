// vader/front/typecheck/test_helpers: shared helpers for inline @tests.

module "vader/front/typecheck"

import "std/string_builder"
AST :: import "toolchain/ast"
import "vader/core/types"
import "vader/support/integer"

// ---- a source without `std/core` ------------------------------------------

/// `src` after the integers `std/core` declares, one line per machine integer, so
/// that a test source checked without `std/core` can name them and its last
/// declaration stays the test's.
///
/// @param src  a test source that names integer types.
with_integers :: fn(src: string) -> string {
    sb :: StringBuilder {}
    for m in MACHINE_INTEGERS {
        sb.append("${m.name} :: ${INT_BASE_NAME} in ${display_bounds(m.values)}\n")
    }
    sb.append(src)
    return sb.to_string()
}

/// The first function among `decls`, past the integers `with_integers` declares.
///
/// @param decls  a parsed test program's declarations.
first_fn_decl :: fn(decls: AST.Decl[]) -> AST.FnDecl | null {
    for d in decls {
        if d is AST.FnDecl {
            return d
        }
    }
    return null
}
