// vader/front/typecheck/type_param_observation: which generic fns observe their type parameters.
//
// A generic fn whose body tests one of its type parameters at run time (`x is U`)
// observes it (`observe_type_param_test`), and its instances stay concrete
// (`fn_instance_flavor`): an erased instance would test `Any`. A fn that hands its
// own type parameters to one observing them observes them too, for the same
// reason. That is the smallest fixed point over a call graph drawn from the record
// (`call_sites.vader`): one node per function that observes or relays, one edge per
// call handing its callee a type that names the caller's own parameters.

module "vader/front/typecheck"

import "std/collections"
import "vader/core/types"
import "vader/support/diagnostics"
import "vader/support/fixpoint"

// The calls of a project that forward the caller's type parameters, and what each
// function observes. Declaration ids are project-wide.
ForwardingGraph :: struct {
    /// Declaration id → node.
    nodes: MutableMap<i64, i32>
    /// Per node, whether its function observes its type parameters.
    observing: bool[]
    successors: i32[][]
}

// Mark every function that hands its own type parameters to one observing them
// (`TypedProgram.fn_observes_type_params`), in the module that lists its calls: the
// one that walked its body, where `fn_instance_flavor` reads the mark.
propagate_type_param_observation :: fn(
    modules: MutableMap<string, TypedProgram>, diags: Diagnostic[],
) -> void {
    forwarding :: forwarding_graph(modules) ?? return
    solve_reachability(Graph { .successors = forwarding.successors }, forwarding.observing)
    for [_, typed] in modules {
        for [caller, _] in typed.call_sites.calls_in_fn {
            node :: forwarding.nodes[caller] ?? continue
            if forwarding.observing[node] {
                typed.fn_observes_type_params[caller] = true
            }
        }
    }
    reject_observing_impl_forwards(modules, forwarding, diags)
}

// T3087 on a call in a generic impl's member that hands the impl's type parameters
// to a function observing them : the impl's instances share the member's body,
// which keeps no instance of its own to observe them in.
reject_observing_impl_forwards :: fn(
    modules: MutableMap<string, TypedProgram>, forwarding: ForwardingGraph, diags: Diagnostic[],
) -> void {
    for [_, typed] in modules {
        for [call, span] in typed.impl_param_forwards {
            callee :: typed.call_sites.calls[call] ?? continue
            if callee !is DirectFn {
                continue
            }
            node :: forwarding.nodes[callee.decl.id] ?? continue
            if !forwarding.observing[node] {
                continue
            }
            diags.push(
                typecheck_error(
                    .IsTestOnSharedInstance,
                    span,
                    "`${callee.decl.name}` observes its type parameters, and an impl member"
                        + " keeps no body per instance ; dispatch through a trait instead",
                ),
            )
        }
    }
}

// The forwarding calls of `modules`, or null when no function observes its type
// parameters by itself: then none does.
forwarding_graph :: fn(modules: MutableMap<string, TypedProgram>) -> ForwardingGraph | null {
    forwarding :: ForwardingGraph {
        .nodes = MutableMap<i64, i32> {},
        .observing = [],
        .successors = [],
    }
    for [_, typed] in modules {
        for [id, _] in typed.fn_observes_type_params {
            node :: node_of(forwarding, id)
            forwarding.observing[node] = true
        }
    }
    if forwarding.observing.len() == 0 {
        return null
    }
    for [_, typed] in modules {
        for [caller, calls] in typed.call_sites.calls_in_fn {
            for call in calls {
                callee :: typed.call_sites.calls[call] ?? continue
                if callee is DirectFn && forwards_type_params(callee) {
                    from :: node_of(forwarding, caller)
                    to :: node_of(forwarding, callee.decl.id)
                    forwarding.successors[from].push(to)
                }
            }
        }
    }
    return forwarding
}

// The node of declaration `id`, added unmarked and with no edge on first sight.
node_of :: fn(forwarding: ForwardingGraph, id: i64) -> i32 {
    fresh :: i32(forwarding.successors.len())
    node :: forwarding.nodes.get_or_put(id, fresh)
    if node == fresh {
        forwarding.observing.push(false)
        forwarding.successors.push([])
    }
    return node
}

// Whether the call to `callee` hands it a type naming one of the enclosing body's
// own type parameters.
forwards_type_params :: fn(callee: DirectFn) -> bool {
    bindings :: callee.bindings ?? return false
    for [_, bound] in bindings {
        if type_contains_type_param(bound) {
            return true
        }
    }
    return false
}
