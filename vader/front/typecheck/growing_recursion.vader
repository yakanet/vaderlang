// vader/front/typecheck/growing_recursion: a generic recursion may not grow its type argument.
//
// Every instantiation of a generic records the type each parameter of the callee
// takes there : a call (`DirectFn.bindings`), a generic function named as a value,
// and a member reached on an array receiver (`receiver_instances`). A node is one
// parameter of one function, by declaration : a type parameter `Q` of the caller
// met in the type the callee's parameter `P` takes gives an edge `Q → P` : `Q`'s
// instances ask for `P`'s. The edge grows when that type nests `Q` (`[Q, Q]`, `Q[]`,
// `Box<Q>`) rather than being `Q` itself. An instance of a function then reaches
// finitely many others, unless a growing edge lies on a cycle : `wrap<T>` calling
// `wrap([x, x], …)` gives the edge `T → T`, and each instance would ask for a
// larger one, without end. Such a call is refused (T3104). A recursion that passes
// its parameters on unchanged, or calls itself on a fixed type, is not.
//
// An array impl's member runs one instance per element type, so a receiver built
// inside it (`[self].depth(…)`) is an edge like a call. A generic struct's impl
// member is not : it runs once per primitive shape of its arguments, every
// reference argument erased, so `Box<T[]>` built inside `Box<T>`'s impl reaches
// no new body and adds no edge. A member reached through a bound
// (`x.depth()` with `x: X`, `X: Depth`) records nothing yet.

module "vader/front/typecheck"

import "std/collections"
import "toolchain/span"
import "vader/support/diagnostics"
import "vader/support/fixpoint"
import "vader/core/symbol"
import "vader/core/types"
AST :: import "toolchain/ast"

// The graph of instantiations, over the parameters of each function.
InstantiationGraph :: struct {
    nodes:      MutableMap<u64, i32> = MutableMap<u64, i32> {}
    successors: i32[][] = []
}

// A call that passes `from` on inside a larger type.
GrowingCall :: struct {
    from:   Symbol
    edge:   [i32, i32]
    callee: string
    bound:  Type
    span:   Span
}

/// T3104 on every instantiation that passes a type parameter on in a larger type,
/// along a cycle of instantiations that leads back to it.
///
/// @param per_module  every module's typed program, its bodies walked.
/// @param diags       where the diagnostics go.
reject_growing_recursion :: fn(
    per_module: MutableMap<string, TypedProgram>, diags: Diagnostic[],
) -> void {
    graph :: InstantiationGraph {}
    growing: GrowingCall[]: []
    for [_, typed] in per_module {
        sites :: typed.call_sites
        instantiating :: [
            sites.calls,
            sites.references,
            sites.method_values,
            sites.receiver_instances,
        ]
        for table in instantiating {
            for [id, callee] in table {
                if callee !is DirectFn {
                    continue
                }
                bindings :: callee.bindings ?? continue
                span :: sites.instantiation_spans[id] ?? continue
                caller :: sites.instantiation_callers[id] ?? continue
                graph.add_instantiation(growing, caller, callee.decl, bindings, span)
            }
        }
    }
    component :: component_of_each_node(Graph { .successors = graph.successors })
    reported :: MutableSet<u64> {}
    for call in growing {
        [from, to] :: call.edge
        if component[from] != component[to] || !reported.add(call.span.hash()) {
            continue
        }
        diags.push(
            typecheck_error(
                .GenericRecursionGrows,
                call.span,
                "this call passes `${call.from.name}` on as `${display_type(call.bound)}` to"
                    + " `${call.callee}`, and the calls lead back here : each instance would"
                    + " ask for a larger one",
            ),
        )
    }
}

// The edges the instantiation of `callee` in the function `caller` adds : each type
// parameter of `caller` met in what a parameter of `callee` takes asks for that
// parameter's instances, growing when it is nested.
add_instantiation :: fn(
    graph: InstantiationGraph,
    growing: GrowingCall[],
    caller: i64,
    callee: AST.FnDecl,
    bindings: MutableMap<i32, Type>,
    span: Span,
) -> void {
    for [param, bound] in bindings {
        froms :: type_params_in(bound)
        if froms.len() == 0 {
            continue
        }
        to :: graph.node_of(param_key(callee.id, param))
        for from in froms {
            origin :: graph.node_of(param_key(caller, from.id))
            graph.successors[origin].push(to)
            if bound !is TypeParamType {
                growing.push(GrowingCall {
                    .from = from,
                    .edge = [origin, to],
                    .callee = callee.name,
                    .bound = bound,
                    .span = span,
                })
            }
        }
    }
}

// The node key of parameter `param` of the function declared as `decl`.
param_key :: fn(decl: i64, param: i32) -> u64 = u64(decl) * 0x1_0000_0000 + u64(param)

// The node of `key`, added on first sight.
node_of :: fn(graph: InstantiationGraph, key: u64) -> i32 {
    fresh :: i32(graph.successors.len())
    node :: graph.nodes.get_or_put(key, fresh)
    if node == fresh {
        graph.successors.push([])
    }
    return node
}

// The type parameters `t` names.
type_params_in :: fn(t: Type) -> Symbol[] {
    out: Symbol[]: []
    for_each_type(t, (x: Type) -> {
        if x is TypeParamType {
            out.push(x.symbol)
        }
    })
    return out
}
