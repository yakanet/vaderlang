// vader/front/typecheck/generator_iter: a `generator`'s call result is a
// CONCRETE nominal type implementing `Iterator<U>`, not the erased trait.
//
// A `generator fn -> Iterator<U>` returns the honest erased `Iterator<U>` in
// source, but a call to it is typed as the concrete synthesized state struct
// `<fn>$State` (which `implements Iterator<U>`), erased to `Iterator<U>` only at
// boundaries. This makes a combinator chain `arr.map(f).filter(p)` resolve
// field/UFCS on a CONCRETE nominal receiver, instead of the erased trait
// receiver that mis-resolves to a virtual dispatch.
// Each generator DECLARATION has its own state struct (two overloads of a name
// are two generators) recorded in `generator_states`, which the lowerer
// (`lower/generator.vader`) reads to build that same struct.

module "vader/front/typecheck"

AST :: import "toolchain/ast"
import "vader/support/diagnostics"
import "vader/core/symbol"
import "vader/core/types"
import "std/collections"

// The state-struct symbol of the `generator` `decl`, declared in `owner`, minted
// from the project's `factory` so that no other symbol shares its id. Its name
// carries the overload suffix the fn's own mangled name does, so two overloads of
// one name get two state structs. No source declares it: it is defined where the
// generator is named.
gen_state_symbol :: fn(decl: AST.FnDecl, owner: TypedProgram, factory: SymbolFactory) -> Symbol {
    suffix :: overload_suffix(owner.resolved, decl.name, decl.name_span)
    // No identifier holds a `$`, so no declared struct takes this name.
    name :: "\$genstate_${decl.name}${suffix}"
    // `display_path` (the DECLARED name), not `path`: this feeds `module_name`,
    // which `symbol_key` folds into a type-intern key and from there into
    // emitted C names. `path` is the filesystem identity and is absolute
    // whenever the entry was named absolutely.
    module :: owner.resolved.display_path
    return factory.make(.GeneratorState, name, module, module, .Private, decl.name_span)
}

/// True when `t` is the state struct of a `generator`, the iterator its call
/// returns.
///
/// @param t  the type to test.
export is_gen_state_struct :: fn(t: Type) -> bool =
    t is StructType && t.symbol.kind == .GeneratorState

/// One `generator` declaration's state struct and what it yields.
export GeneratorState :: struct {
    /// The generator declaring this state.
    decl: AST.FnDecl
    /// The state struct: a call to the generator types as it, and its
    /// lowering builds it.
    symbol: Symbol
    /// The yielded element, in the declaration's own type parameters.
    element: Type
}

/// The state of the `generator` declared by `decl` ; null when `decl` declares
/// no generator, or one whose element did not resolve.
///
/// @param decl   a fn declaration, from any module.
/// @param typed  any module's typechecked program: every one holds the registry.
export generator_state_of :: fn(decl: AST.FnDecl, typed: TypedProgram) -> GeneratorState | null =
    typed.generator_states[decl.name_span.hash()]

// The `generator` whose state struct `state` is, found where the state is defined:
// at the generator's name, which keys `generator_states`.
generator_of_state :: fn(state: StructType, typed: TypedProgram) -> AST.FnDecl | null {
    site :: state.symbol.defined_at ?? return null
    generator :: typed.generator_states[site.hash()] ?? return null
    return generator.decl
}

/// Register every `generator` fn's synthetic state struct as `implements
/// Iterator<U>`, in the impl tables every module shares, so a call to it types as
/// a concrete iterator (chains resolve) regardless of which module consumes it.
/// Runs before the full body walks so `try_trait_widen` sees `<fn>$State →
/// Iterator` while typing chained receivers.
///
/// Each generator registers from the module that declares it, walking only that
/// module's own fns (`fn_overloads`): `fn_decls` is the project-wide table
/// (`cross_publish_fn_decls`), and a signature resolves only in its owner. Read
/// from a consumer declaring a fn of the same name, it would take that fn's.
register_generator_iter_impls :: fn(
    per_module: MutableMap<string, TypedProgram>,
    impl_tables: ImplTables,
    factory: SymbolFactory,
) -> void {
    states :: MutableMap<u64, GeneratorState> {}
    for [_, owner] in per_module {
        sink: Diagnostic[]: []
        for [_, bucket] in owner.resolved.fn_overloads {
            for sym in bucket {
                fn_decl :: owner.fn_decls[sym.id] ?? continue
                if !fn_is_generator(owner, fn_decl) {
                    continue
                }
                returned :: lookup_return_type(fn_decl, owner)
                elem :: generator_element_type(fn_decl, returned, sink) ?? continue
                states[fn_decl.name_span.hash()] = GeneratorState {
                    .decl = fn_decl,
                    .symbol = gen_state_symbol(fn_decl, owner, factory),
                    .element = elem,
                }
            }
        }
    }
    for [_, tp] in per_module {
        tp.generator_states = states
    }
    iterator :: core_trait_key(TRAIT_ITERATOR)
    for [_, state] in states {
        state_ty :: mk_struct(state.symbol, [])
        record_struct_trait(impl_tables, state_ty, iterator)
        record_struct_trait_args(impl_tables, state_ty, iterator, [state.element])
    }
}

/// The concrete result type for a call whose callee is a `generator`, or null.
/// `mk_struct(<fn>$State, [element])`: a nominal type that `implements
/// Iterator<element>`. The concrete element (from the call's substituted return
/// `Iterator<i32>`) is carried as the sole type arg so a terminal returning the
/// element (`collect -> element[]`, `find -> element | null`) on a chain of these
/// concretises instead of erasing to `T[]` (the `<fn>$State<E> implements
/// Iterator<E>` convention that `resolve_struct_trait_args` reads).
generator_call_result_type :: fn(c: AST.CallExpr, typed: TypedProgram, concrete_ret: Type) -> Type | null {
    // Cheap program-level bail: a generator-free program skips the per-call
    // callee probe entirely.
    if typed.generator_states.is_empty() { return null }
    decl :: recorded_decl(typed, c) ?? return null
    state :: generator_state_of(decl, typed) ?? return null
    elem :: core_trait_arg(concrete_ret, TRAIT_ITERATOR) ?? return mk_struct(state.symbol, [])
    return mk_struct(state.symbol, [elem])
}
