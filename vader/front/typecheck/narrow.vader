// vader/front/typecheck/narrow — flow-sensitive type narrowing.
//
// API for pushing / popping narrowed types into per-binding and per-field
// stacks. Consumers (`infer_ident`, `infer_field`) call `narrow_for_binding`
// / `narrow_for_field` to read the current narrowed type, falling back to
// the static type when no narrowing is in effect.
//
// Producers are wired : `expr_if.vader` narrows in the then/else branches of
// `if x is T` / `if x == null` (idents and `expr.field` chains alike),
// `match_expr.vader` narrows per arm, and `stmt.vader` narrows on
// early-return guards. Each pushes before the narrowed region and restores
// via the paired `pop_*` on exit.
//
// Reassignment invalidation : the push/pop stack alone is unsound once the
// narrowed binding is written to — `x = <other variant>` must retire not
// just the active entry but every still-stacked `prev` an enclosing `pop_*`
// would later restore. Each slot therefore carries a *kill generation* : a
// `NarrowSlot` records the generation at push time, an incompatible
// assignment bumps the slot's current generation
// (`invalidate_narrow_on_assign`, called from `check_assign`), and the
// `narrow_for_*` readers treat an entry from an older generation as absent.
// A fresh `is` / null test after the assignment pushes at the new
// generation and narrows normally.
//
// The same generations retire what other code may change behind the walk: a
// call (and an `await`, a `yield`) may write any object it reaches, a loop's
// next iteration runs after the body's writes, and a field write may go through
// an alias. See `retire_narrowings_across_call` and
// `retire_narrowings_entering_loop`.

module "vader/front/typecheck"

import "std/collections"
import "std/string"
import "vader/core/types"
AST :: import "toolchain/ast"

/// One narrowing-table entry : the narrowed type plus the slot's kill
/// generation captured at push time. `narrow_for_binding` /
/// `narrow_for_field` ignore entries whose generation is older than the
/// slot's current one — that is how a reassignment retires both the
/// active narrowing and every stacked `prev` awaiting restore.
export NarrowSlot :: struct {
    ty: Type
    gen: i32
}

/// The tables that make up flow-sensitive narrowing, carried together on
/// `TypedProgram.narrow`.
///
/// They are one machine, not five side-tables: an entry in `bindings` counts as
/// live only while the generation it recorded still matches `kill_gens`, and a
/// reader that consults one without the other sees a narrowing a reassignment
/// already retired. Grouping them keeps that pairing visible at the type, and
/// keeps every producer in this file.
export NarrowState :: struct {
    /// Per-binding narrowed type stack (`Symbol.id → NarrowSlot`). `push_narrow`
    /// / `pop_narrow` write when a flow-sensitive narrowing is active (inside
    /// the then-branch of `if x is T`, or a match arm); readers go through
    /// `narrow_for_binding`, which falls back to the static type when no
    /// narrowing is in effect or the entry's generation is stale. Producers live
    /// in `expr_if.vader`, `match_expr.vader` and `stmt.vader`.
    bindings: MutableMap<i32, NarrowSlot> = MutableMap<i32, NarrowSlot> {}

    /// Per-field narrowed type stack, keyed by `"${receiver_sym_id}#${field_name}"`.
    /// Mirrors `bindings` but for `expr.field` chains: when
    /// `if b.items != null { ... }` activates a narrowing in the then-branch,
    /// `field.vader::infer_field` reads this to return `i32[]` rather than
    /// `i32[] | null`.
    fields: MutableMap<string, NarrowSlot> = MutableMap<string, NarrowSlot> {}

    /// Kill generation per binding slot — bumped by `invalidate_narrow_on_assign`
    /// when a reassignment invalidates the binding's active narrowing. Entries
    /// pushed at an older generation are ignored by `narrow_for_binding`,
    /// including the stacked `prev` values a later `pop_narrow` would restore.
    kill_gens: MutableMap<i32, i32> = MutableMap<i32, i32> {}

    /// Kill generation per field-chain slot; mirrors `kill_gens` for `fields`.
    field_kill_gens: MutableMap<string, i32> = MutableMap<string, i32> {}

    /// How many calls `retire_narrowings_across_call` has counted, so a caller can
    /// tell whether checking an expression ran one.
    calls: i32 = 0

    /// `&&` / `||` nodes whose right operand ran a call : what the left operand
    /// narrowed does not hold past it.
    calling_right_operands: MutableSet<i64> = MutableSet<i64> {}

    /// The writes of the `defer` body being checked, null outside one; see
    /// `bring_narrowings_back`.
    deferred_writes: DeferredWrite[] | null = null
}


// Current kill generation for a binding slot ; 0 until first bumped.
cur_narrow_gen :: fn(typed: TypedProgram, sym_id: i32) -> i32 = typed.narrow.kill_gens[sym_id] ?? 0

// Current kill generation for a field-chain slot ; 0 until first bumped.
cur_field_narrow_gen :: fn(typed: TypedProgram, key: string) -> i32 = typed.narrow.field_kill_gens[key] ?? 0

/// Push a narrowed type for `sym_id` ; returns the prior narrowing
/// (or null) so the caller can restore it on scope exit.
push_narrow :: fn(typed: TypedProgram, sym_id: i32, narrowed: Type) -> NarrowSlot | null {
    prev :: typed.narrow.bindings[sym_id]
    typed.narrow.bindings[sym_id] = NarrowSlot {
        .ty = narrowed,
        .gen = cur_narrow_gen(typed, sym_id),
    }
    return prev
}

/// Restore the prior narrowing for `sym_id`. Pair with `push_narrow`.
/// When `prev` is null the slot is *removed* so a later
/// `narrow_for_binding` falls back to the binding's then-current static
/// type. Removing (not overwriting with a captured `static_ty`) is what
/// keeps narrowing scope-local : a stale type captured by an earlier
/// walk — e.g. the premature imported-body walk in
/// `settle_external_expr_bodied_returns`, which runs before a module's
/// imports are wired and so sees `?` for `m[k]`-bound locals — must not
/// outlive its scope and poison the authoritative re-walk.
pop_narrow :: fn(typed: TypedProgram, sym_id: i32, prev: NarrowSlot | null) -> void {
    if prev == null {
        typed.narrow.bindings.remove(sym_id)
    } else {
        typed.narrow.bindings[sym_id] = prev
    }
}

/// Look up the current narrowed type for `sym_id`, falling back to
/// `static_ty` when no narrowing is active for that binding. An entry
/// from an older kill generation (retired by a reassignment) counts as
/// absent.
narrow_for_binding :: fn(typed: TypedProgram, sym_id: i32, static_ty: Type) -> Type {
    cur :: typed.narrow.bindings[sym_id] ?? return static_ty
    if cur.gen != cur_narrow_gen(typed, sym_id) {
        return static_ty
    }
    return cur.ty
}

/// Build the slot key for a `root.f1.f2.…` chain : `${root_sym.id}#f1#f2…`.
/// `fields` must be ordered root-to-leaf. The `#` separator avoids
/// collisions with `.`-prefixed identifiers and field names like `0`
/// (tuple positional access).
chain_key :: fn(root_sym_id: i32, fields: string[]) -> string {
    key := "${root_sym_id}"
    for f in fields {
        key = "${key}#${f}"
    }
    return key
}

/// Static type of a resolved field chain : the chain's narrow-table
/// key + the type recorded by `check_expr` on its outermost FieldExpr.
/// Shared by `expr_if.vader` / `stmt.vader` / `match_expr.vader` so
/// they don't each re-derive the chain's declared type from scratch.
FieldChainStatic :: struct {
    field_key: string
    static_ty: Type
}

/// Pick the FieldExpr operand of a `field == null` / `null != field`
/// comparison. Returns null when neither side is a FieldExpr-vs-null
/// pair.
pick_field_vs_null :: fn(a: AST.Expr, b: AST.Expr) -> AST.FieldExpr | null {
    if a is AST.FieldExpr {
        if b is AST.NullLitExpr {
            return a
        }
    }
    if b is AST.FieldExpr {
        if a is AST.NullLitExpr {
            return b
        }
    }
    return null
}

/// Pick the IdentExpr operand of an `ident == null` / `null != ident`
/// comparison. Mirrors `pick_field_vs_null` for plain bindings.
pick_ident_vs_null :: fn(a: AST.Expr, b: AST.Expr) -> AST.IdentExpr | null {
    if a is AST.IdentExpr && b is AST.NullLitExpr {
        return a
    }
    if b is AST.IdentExpr && a is AST.NullLitExpr {
        return b
    }
    return null
}

/// Resolve a FieldExpr chain to its narrow-table key + the static
/// type recorded by `check_expr`. Returns null when the chain root
/// isn't a plain ident-bound Symbol or the chain's type wasn't
/// resolved (no point in narrowing an Unresolved slot).
resolve_field_chain_static :: fn(
    e: AST.FieldExpr,
    typed: TypedProgram,
) -> FieldChainStatic | null {
    key :: field_chain_key(e, typed)
    if key == "" {
        return null
    }
    static_ty :: typed.expr_types[e.id] ?? return null
    if static_ty is UnresolvedType {
        return null
    }
    return FieldChainStatic { .field_key = key, .static_ty = static_ty }
}

/// Walk a FieldExpr down to its root `IdentExpr` and return the
/// matching `chain_key`. Returns `""` when the root isn't a plain ident
/// or it doesn't resolve to a Symbol — callers gate narrowing on the
/// empty string sentinel.
field_chain_key :: fn(e: AST.FieldExpr, typed: TypedProgram) -> string {
    // Collect fields leaf-to-root, then reverse for chain_key.
    parts_leaf_first: string[]: []
    cur: AST.Expr = e
    for true {
        if cur is AST.FieldExpr {
            parts_leaf_first.push(cur.field)
            cur = cur.target
        } else {
            break
        }
    }
    if cur !is AST.IdentExpr {
        return ""
    }
    sym :: typed.resolved.idents[cur.span.hash()] ?? return ""
    fields: string[]: []
    i := parts_leaf_first.len() - 1
    for i >= 0 {
        fields.push(parts_leaf_first[i])
        i -= 1
    }
    return chain_key(sym.id, fields)
}

/// Push a narrowed type for a `${receiver_sym_id}.${field_name}` slot ;
/// returns the prior narrowing (or null) so the caller can restore it
/// on scope exit. Mirrors `push_narrow` for ident bindings.
push_field_narrow :: fn(typed: TypedProgram, key: string, narrowed: Type) -> NarrowSlot | null {
    prev :: typed.narrow.fields[key]
    typed.narrow.fields[key] = NarrowSlot {
        .ty = narrowed,
        .gen = cur_field_narrow_gen(typed, key),
    }
    return prev
}

/// Restore the prior narrowing for `key`. Pair with `push_field_narrow`.
/// When `prev` is null the slot is *removed* so subsequent
/// `narrow_for_field` lookups fall through to the field's then-current
/// static type. See `pop_narrow` for why removal (not overwrite) matters.
pop_field_narrow :: fn(typed: TypedProgram, key: string, prev: NarrowSlot | null) -> void {
    // A `prev` from an older generation is dead : dropping it, rather than
    // restoring it, keeps the table empty once a call has retired everything.
    if prev == null || prev.gen != cur_field_narrow_gen(typed, key) {
        typed.narrow.fields.remove(key)
        return
    }
    typed.narrow.fields[key] = prev
}

/// Look up the current narrowed type for `key`, falling back to
/// `static_ty` when no narrowing is active for that field slot. An
/// entry from an older kill generation counts as absent.
narrow_for_field :: fn(typed: TypedProgram, key: string, static_ty: Type) -> Type {
    cur :: typed.narrow.fields[key] ?? return static_ty
    if cur.gen != cur_field_narrow_gen(typed, key) {
        return static_ty
    }
    return cur.ty
}

// ---- reassignment invalidation ---------------------------------------------

/// Retire flow narrowings made stale by `target = value`. Called from
/// `check_assign` after the value expression is typed :
///
///   - `x = v` — when `x` carries an active narrowing and `v`'s type no
///     longer fits it, bump the binding's kill generation (retiring the
///     entry and every stacked `prev`). A compatible `v` (e.g. `x = 42`
///     inside an `x is i32` region) keeps the narrowing. Field chains
///     rooted at `x` retire unconditionally — `x` now names another value.
///   - `x.f = v` — same keep-if-compatible rule for the `x.f` chain slot ;
///     chains *deeper* than the written field (`x.f.g…`) retire
///     unconditionally, the slot now holds a fresh object.
///
/// An `IndexExpr` LHS (`a[i] = v`) never designates a tracked slot :
/// `field_chain_key` only walks `FieldExpr` chains rooted at a plain ident.
/// A field write may go through an alias (`y.f = v` where `y` is `x`, or
/// `a[i].f = v`), so it also retires every other chain through a field of
/// that name. Writes inside a callee are retired at the call.
///
/// @param target    the assignment's LHS expression.
/// @param value_ty  the checked type of the RHS.
/// @param typed     the program's typing tables.
invalidate_narrow_on_assign :: fn(target: AST.Expr, value_ty: Type, typed: TypedProgram) -> void {
    writes :: typed.narrow.deferred_writes
    if writes != null {
        writes.push(DeferredWrite { .target = target, .value = value_ty })
    }
    // Fast path first : with no active narrowing there is nothing to
    // retire, and this runs on every assignment in the program — skip
    // before any symbol lookup / key interpolation allocates.
    if target is AST.IdentExpr {
        if typed.narrow.bindings.is_empty() && typed.narrow.fields.is_empty() {
            return
        }
        sym :: typed.resolved.idents[target.span.hash()] ?? return
        cur :: typed.narrow.bindings[sym.id]
        if cur != null {
            g :: cur_narrow_gen(typed, sym.id)
            if cur.gen == g && !is_assignable(value_ty, cur.ty) {
                typed.narrow.kill_gens[sym.id] = g + 1
            }
        }
        if !typed.narrow.fields.is_empty() {
            retire_field_chains_under(typed, "${sym.id}#")
        }
        return
    }
    if target is AST.FieldExpr {
        if typed.narrow.fields.is_empty() {
            return
        }
        key :: field_chain_key(target, typed)
        retire_chains_through_field(typed, target.field, key)
        if key == "" {
            return
        }
        cur :: typed.narrow.fields[key]
        if cur != null && cur.gen == cur_field_narrow_gen(typed, key) && !is_assignable(value_ty, cur.ty) {
            retire_field_chain(typed, key)
        }
    }
}

// Bump the kill generation of every tracked field chain whose key starts
// with `prefix` ("<sym_id>#" for a rebound root, "<chain_key>#" for a
// rewritten intermediate field — the `#` matches `chain_key`'s segment
// separator). Only chains present in the table need a bump : a chain
// absent here has no active region, hence no stacked `prev` a later pop
// could restore.
retire_field_chains_under :: fn(typed: TypedProgram, prefix: string) -> void {
    if typed.narrow.fields.is_empty() {
        return
    }
    for [k, _] in typed.narrow.fields {
        if starts_with(k, prefix) {
            retire_field_chain(typed, k)
        }
    }
}

// Bump every tracked chain but `except` that reads a field named `field` at
// some level : the written object may be the one such a chain goes through. The
// chains under `except` itself read `field` too.
retire_chains_through_field :: fn(typed: TypedProgram, field: string, except: string) -> void {
    last :: "#${field}"
    inner :: "${last}#"
    for [k, _] in typed.narrow.fields {
        if k != except && (inner in k || k.ends_with(last)) {
            retire_field_chain(typed, k)
        }
    }
}

// Retire every tracked chain. They are all dead, so the table empties too, and
// the readers' `is_empty()` fast paths hold again.
retire_all_field_chains :: fn(typed: TypedProgram) -> void {
    if typed.narrow.fields.is_empty() {
        return
    }
    for [k, _] in typed.narrow.fields {
        retire_field_chain(typed, k)
    }
    typed.narrow.fields.clear()
}

// Bump `key`'s kill generation, retiring its entry and every stacked `prev`.
retire_field_chain :: fn(typed: TypedProgram, key: string) -> void {
    typed.narrow.field_kill_gens[key] = cur_field_narrow_gen(typed, key) + 1
}

// ---- what a call or a loop may change -------------------------------------

/// Retire the narrowings a call may falsify. A call can write any object its
/// arguments, an alias or a module reach, and nothing here tracks which, so
/// every field chain goes; a binding goes only when a lambda rebinds it, since
/// the call may run that lambda. An `await` or a `yield` lets other code run
/// before the body resumes, so it counts as a call. An implicit call (an
/// operator's impl, an interpolation's `Display`) is not counted.
///
/// @param typed  the program's typing tables.
retire_narrowings_across_call :: fn(typed: TypedProgram) -> void {
    typed.narrow.calls += 1
    retire_all_field_chains(typed)
    for [sym_id, _] in typed.narrow.bindings {
        if sym_id in typed.resolved.closure_rebound {
            retire_binding(typed, sym_id)
        }
    }
}

/// Retire, on entering `loop`, the narrowings its next iteration may find
/// false: the body runs again after its own writes, so a write placed after a
/// read reaches that read on the next pass. What a call may change goes, and so
/// does every binding the body rebinds.
///
/// @param loop   the loop being entered.
/// @param typed  the program's typing tables.
retire_narrowings_entering_loop :: fn(loop: AST.ForStmt, typed: TypedProgram) -> void {
    retire_narrowings_across_call(typed)
    rebinds :: typed.resolved.loop_rebinds[loop.span.hash()] ?? return
    for sym_id in rebinds {
        retire_binding(typed, sym_id)
    }
}

/// One write a `defer` body makes, replayed on the narrowings around the `defer`
/// once the body is checked.
export DeferredWrite :: struct {
    target: AST.Expr
    value:  Type
}

/// The narrowing tables a body that runs later than it is written was checked
/// without, and the `defer` writes being gathered then, put back by
/// `bring_narrowings_back`.
NarrowingsAside :: struct {
    bindings: MutableMap<i32, NarrowSlot>
    fields:   MutableMap<string, NarrowSlot>
    writes:   DeferredWrite[] | null
    calls:    i32
}

/// Set aside, while a body that runs later than it is written is checked (a
/// lambda's, a `defer`'s), the narrowings what runs in between may falsify:
/// every field chain, and every binding an assignment rebinds. A binding nothing
/// rebinds keeps its value, so its narrowing holds wherever the body runs.
///
/// @param typed     the program's typing tables.
/// @param deferred  whether the body is a `defer`'s, whose writes and calls run
///                  before the code that follows its block.
/// @return          what to hand `bring_narrowings_back` once the body is checked.
set_narrowings_aside :: fn(typed: TypedProgram, deferred: bool) -> NarrowingsAside {
    aside :: NarrowingsAside {
        .bindings = typed.narrow.bindings,
        .fields   = typed.narrow.fields,
        .writes   = typed.narrow.deferred_writes,
        .calls    = typed.narrow.calls,
    }
    kept :: MutableMap<i32, NarrowSlot> {}
    for [sym_id, slot] in aside.bindings {
        if sym_id in typed.resolved.rebind_free {
            kept[sym_id] = slot
        }
    }
    typed.narrow.bindings = kept
    typed.narrow.fields = MutableMap<string, NarrowSlot> {}
    writes: DeferredWrite[] | null = null
    if deferred {
        writes = []
    }
    typed.narrow.deferred_writes = writes
    return aside
}

/// Put back the narrowings `set_narrowings_aside` set aside. Writing a lambda ran
/// none of its body; a `defer` body runs at the exit of its block, so its writes
/// and calls retire here what they would retire inline.
///
/// @param typed  the program's typing tables.
/// @param aside  what `set_narrowings_aside` returned.
bring_narrowings_back :: fn(typed: TypedProgram, aside: NarrowingsAside) -> void {
    writes :: typed.narrow.deferred_writes
    called :: typed.narrow.calls != aside.calls
    typed.narrow.bindings = aside.bindings
    typed.narrow.fields = aside.fields
    typed.narrow.deferred_writes = aside.writes
    if writes == null {
        return
    }
    for write in writes {
        invalidate_narrow_on_assign(write.target, write.value, typed)
    }
    if called {
        retire_narrowings_across_call(typed)
    }
}

/// Record that the right operand of the `&&` / `||` node `id` ran a call, when
/// `typed.narrow.calls` moved past `calls_before` while it was checked.
///
/// @param typed         the program's typing tables.
/// @param id            the `&&` / `||` node.
/// @param calls_before  `typed.narrow.calls` before its right operand was checked.
note_right_operand_calls :: fn(typed: TypedProgram, id: i64, calls_before: i32) -> void {
    if typed.narrow.calls != calls_before {
        typed.narrow.calling_right_operands.add(id)
    }
}

// Bump `sym_id`'s kill generation when it carries a narrowing.
retire_binding :: fn(typed: TypedProgram, sym_id: i32) -> void {
    if sym_id in typed.narrow.bindings {
        typed.narrow.kill_gens[sym_id] = cur_narrow_gen(typed, sym_id) + 1
    }
}
