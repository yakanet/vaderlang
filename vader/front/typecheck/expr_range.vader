// vader/front/typecheck/expr_range — RangeExpr inference (`a..<b`, `a..=b`).
//
// A range types as `Range<T>`, the `std/core` struct. `T` comes from the slot
// when it expects a `Range<T>` (`r: Range<i64>: …`, `x in lo..=hi`), from the
// bounds otherwise.

module "vader/front/typecheck"

AST :: import "toolchain/ast"
import "vader/support/diagnostics"
import "vader/front/resolver/symbol"
import "vader/types"

/// Type-check a range. Resolves to `Range<T>` when `std/core::Range`
/// is loaded (auto-loaded by `loader.vader`), otherwise Unresolved.
///
/// @param expected  the slot's type : an expected `Range<T>` gives `T`, each bound
///                  checked against it, as `x in lo..=hi` does with `x`'s type ;
///                  otherwise `T` is picked from the bounds.
/// @error           T3066 when a literal bound does not fit the expected element.
/// @error           T3001 when a bound is of another type than the expected element.
infer_range :: fn(
    e: AST.RangeExpr,
    expected: Type | null,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type {
    element :: range_element(expected, typed)
    if element == null {
        return infer_range_from_bounds(e, typed, diags)
    }
    lower :: check_expr(e.lower, element, typed, diags)
    upper :: check_expr(e.upper, element, typed, diags)
    emit_mismatch_if(lower, element, e.lower.span, null, .TypeMismatch, typed, diags)
    emit_mismatch_if(upper, element, e.upper.span, null, .TypeMismatch, typed, diags)
    return range_of(element, typed)
}

/// `Range<element>`, or Unresolved while `std/core::Range` is not loaded.
///
/// @param element  the bounds' type.
range_of :: fn(element: Type, typed: TypedProgram) -> Type {
    // `range_symbol` is the well-known `std/core::Range` symbol, populated once
    // from core by the orchestrator ; a `RangeExpr` (`0..10`) is synthesised
    // without a source span, so it resolves via this slot, not `idents`.
    range_sym :: typed.range_symbol ?? return TY_UNRESOLVED
    return mk_struct(range_sym, [element])
}

// The `T` of an expected `Range<T>` when the bounds can take it
// (`is_pinned_element`).
range_element :: fn(expected: Type | null, typed: TypedProgram) -> Type | null {
    range_sym :: typed.range_symbol ?? return null
    if expected !is StructType || expected.symbol.id != range_sym.id || expected.args.len() != 1 {
        return null
    }
    element :: expected.args[0]
    if !is_pinned_element(element) {
        return null
    }
    return element
}

/// Whether the literals of a container — a range's bounds, an array's elements —
/// can take `t` from the slot: a concrete type, not a union, whose variant a
/// literal alone cannot pick.
///
/// @param t  the element the slot expects.
is_pinned_element :: fn(t: Type) -> bool =
    !is_free_numeric(t) && t !is UnionType | UnresolvedType | NeverType | TypeParamType | InferVar

infer_range_from_bounds :: fn(e: AST.RangeExpr, typed: TypedProgram, diags: Diagnostic[]) -> Type {
    lower :: check_expr(e.lower, null, typed, diags)
    if lower !is RangeType | FreeIntType {
        element :: pick_bound_or_default(lower)
        check_expr(e.upper, element, typed, diags)
        return range_of(element, typed)
    }
    upper :: check_expr(e.upper, null, typed, diags)
    if lower is RangeType || upper is RangeType {
        return range_of(joined_bounds(e, lower, upper, typed, diags), typed)
    }
    element :: pick_bound_or_default(upper)
    // Retype the still-free side to `element` so downstream
    // consumers (slice lowering, dump) see the same width ; through
    // `settle_free_value`, which checks that a literal fits it.
    target :: if upper is FreeIntType { e.upper } else { e.lower }
    settle_free_value(target, element, typed, diags)
    return range_of(element, typed)
}

// The element of `e`, a range one of whose bounds is an integer type : the two
// bounds joined as two branches are (`join_branch_types`), a free literal beside a
// range standing for its own value (`h..=23` on an `Hour` walks an `Hour`,
// `n..=10` past `n in 0..=2` a `0..=10`). Bounds that join into no integer type
// are a mismatch, the lower one's type kept.
joined_bounds :: fn(
    e: AST.RangeExpr, lower: Type, upper: Type, typed: TypedProgram, diags: Diagnostic[],
) -> Type {
    joined :: join_branch_types([e.lower, e.upper], [lower, upper], typed, diags)
    if joined is RangeType {
        return joined
    }
    diags.push(mismatch_diagnostic(upper, lower, e.upper.span, .TypeMismatch, typed))
    return lower
}

// The element of a range whose bounds are no integer types (`joined_bounds` takes
// those) : `char` for `char` bounds, else the `i32` a free literal defaults to.
pick_bound_or_default :: fn(t: Type) -> Type {
    if is_char(t) || t is FreeCharType {
        return TY_CHAR
    }
    return TY_I32
}
