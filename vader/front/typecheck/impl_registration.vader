// vader/front/typecheck/impl_registration: each impl's members, recorded for lookup.

module "vader/front/typecheck"

import "std/collections"
AST :: import "toolchain/ast"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/resolver"
import "vader/support/diagnostics"

// Record every impl of the project into the tables its modules share, each impl
// once, by the module that declares it: the membership of every impl, then the
// members of every impl. Runs before the first body walk. An impl's diagnostics
// go to its module's resolver diagnostics, which the entry's build forwards.
register_project_impls :: fn(
    project: LoadedProject,
    per_module: Map<string, TypedProgram>,
) -> void {
    owners: TypedProgram[]: []
    impls: RecordedImpl[][]: []
    for [id, owner] in per_module {
        loaded :: project.modules[id] ?? continue
        found :: recorded_impls(concat_file_decls(loaded.module.files), owner)
        record_impl_memberships(owner, found)
        owners.push(owner)
        impls.push(found)
    }
    for i in 0..<owners.len() {
        record_impls_members(owners[i], impls[i], owners[i].resolved.diags)
    }
}

// Record the impls of one module checked alone, `decls` declared by `owner`.
register_module_impls :: fn(decls: AST.Decl[], owner: TypedProgram, diags: Diagnostic[]) -> void {
    found :: recorded_impls(decls, owner)
    record_impl_memberships(owner, found)
    record_impls_members(owner, found, diags)
}

// An impl the tables record: its declaration, the type it is written for and its
// trait, both resolved in the module that declares it.
RecordedImpl :: struct {
    decl: AST.ImplDecl
    for_ty: Type
    trait_sym: Symbol
}

// The impls of `decls` the tables record: neither one whose trait does not
// resolve, nor one its module refuses for its shape (T3090, T3117).
recorded_impls :: fn(decls: AST.Decl[], owner: TypedProgram) -> RecordedImpl[] {
    out: RecordedImpl[]: []
    for decl in decls {
        if decl is AST.ImplDecl {
            for_ty :: type_from_expr(decl.for_type, owner.resolved, diag_sink())
            trait_sym :: impl_trait_symbol(decl, owner.resolved) ?? continue
            partly_generic :: is_refused_array_impl(for_ty)
            if !partly_generic && unbound_impl_params(decl, for_ty, owner.resolved).is_empty() {
                out.push(RecordedImpl {
                    .decl = decl,
                    .for_ty = for_ty,
                    .trait_sym = trait_sym,
                })
            }
        }
    }
    return out
}

// What each of `impls`, declared by `owner`, makes its type implement.
record_impl_memberships :: fn(owner: TypedProgram, impls: RecordedImpl[]) -> void {
    for r in impls {
        record_impl_membership(owner, r.decl, r.for_ty, trait_key_of(r.trait_sym))
    }
}

// The members of each of `impls`, declared by `owner` ; the errors of a trait
// argument or a member signature go to `diags`.
record_impls_members :: fn(
    owner: TypedProgram,
    impls: RecordedImpl[],
    diags: Diagnostic[],
) -> void {
    for r in impls {
        record_impl_members(owner, r.decl, r.for_ty, r.trait_sym, diags)
    }
}

// The trait membership an impl declares: `is Trait`, trait widening, the bounds
// its type parameters put on the arguments. Recorded for every impl before
// anything else, so a member type that widens to a later-declared impl resolves.
//
// `owner` is the module that declares `decl` : it resolves the type parameters'
// bounds.
record_impl_membership :: fn(
    owner: TypedProgram,
    decl: AST.ImplDecl,
    for_ty: Type,
    trait_key: string,
) -> void {
    if is_instance_receiver(for_ty) {
        owner.impl_tables.instance_impl_bases.add(impl_base_key(for_ty))
    }
    if is_structural(for_ty) {
        owner.impl_tables.has_structural_target = true
    }
    record_struct_trait(owner.impl_tables, for_ty, trait_key)
    record_impl_bounds(owner, decl, for_ty, trait_key)
}

// The lookup tables an impl's members feed : the element / key types of its
// `Iterator` / `Index` / `IndexSet` / `Into` trait, its trait arguments, and one
// UFCS entry per member, plus the target-keyed `Into` entry.
//
// `owner` is the module that declares `decl` : it resolves the trait arguments
// and the member signatures, whose errors go to `diags`.
record_impl_members :: fn(
    owner: TypedProgram,
    decl: AST.ImplDecl,
    for_ty: Type,
    trait_sym: Symbol,
    diags: Diagnostic[],
) -> void {
    trait_key :: trait_key_of(trait_sym)
    // The impl's own parameters, as those of the struct it is written for : every
    // template recorded below then reads a receiver's arguments by the struct's.
    as_struct :: impl_params_as_struct_params(for_ty, owner)
    // With the default a slot's arguments take, so the impl's instance compares
    // with the slots that ask for it (`implements_trait_instance`).
    written :: written_type_args(decl.trait_args, owner.resolved, diags)
    trait_args :: substitute_each_map(
        implemented_trait_args(written, trait_sym, for_ty, owner),
        as_struct,
    )
    tables :: owner.impl_tables
    index_impl_metadata(tables, for_ty, trait_key, trait_args)
    record_struct_trait_args(tables, for_ty, trait_key, trait_args)
    trait_decl :: owner.trait_decls[trait_sym.id]
    is_into :: trait_key == core_trait_key(TRAIT_INTO) && trait_args.len() == 1
    side :: impl_side_key(for_ty)
    trait_type :: TraitType { .symbol = trait_sym, .args = written }
    if written.len() == 1 {
        reject_iterator_of_stop(trait_type, decl.trait_args[0].span, diags)
    }
    generic :: type_contains_type_param(for_ty)
    for_type :: substitute_map(for_ty, as_struct)
    for m in decl.members {
        trait_method :: lookup_trait_method(trait_decl, m.name)
        written_ty :: ufcs_method_type(decl, m, for_ty, trait_method, trait_type, owner, diags)
        entry :: ImplMethod {
            .ty = in_struct_frame(written_ty, as_struct),
            .decl = m,
            .impl_key = decl.span.hash(),
            .trait_key = trait_key,
            .trait_args = trait_args,
            .trait_symbol = trait_sym,
            .generic = generic,
            .for_type = for_type,
            .return_of = default_giving_return(m, trait_method),
        }
        add_impl_method(tables, "${impl_type_key(for_ty)}::${m.name}", entry)
        // And under its side key : the base, which every instance of a generic impl
        // reads, or the impl's own type, which wins for that instance alone.
        member_key :: "${side}::${m.name}"
        add_impl_method(tables, member_key, entry)
        add_trait_unique(tables.impl_method_traits, member_key, trait_key)
        // `Into<T>` impls are indexed under a target-qualified key so
        // multiple `Into` impls for the same source (e.g. `Into<i32>` +
        // `Into<string>`) don't collide. The pair is the impl's own, as a body of
        // the impl sees its receiver. A generic impl's pair names a type parameter
        // no conversion carries : it is found by the base of its target instead
        // (`into_impl_method`).
        if is_into && m.name == METHOD_INTO {
            add_impl_method(tables, into_impl_key(for_ty, written[0]), entry)
            if type_contains_type_param(for_ty) {
                add_impl_method(tables, "${side}${into_toward_suffix(trait_args[0])}", entry)
            }
        }
    }
}

// An impl's own type parameters, as the parameters of the struct it is written
// for : `Box<U> implements<U> ...` gives `U ↦ T` for `Box :: struct<T>`. Empty for any
// other receiver ; an impl written for one instance binds none.
impl_params_as_struct_params :: fn(for_ty: Type, typed: TypedProgram) -> Map<i32, Type> {
    bindings :: Map<i32, Type> {}
    if for_ty !is StructType {
        return bindings
    }
    decl :: typed.struct_decls[for_ty.symbol.id] ?? return bindings
    declared :: declared_type_args(decl.type_params, typed) ?? return bindings
    unify_type_param(for_ty, mk_struct(for_ty.symbol, declared), bindings)
    return bindings
}

// A member's signature read in the struct's own parameters (`as_struct` renames the
// impl's to them) : a parameter the signature quantifies over stays quantified,
// under the struct's name, so a static call (`Bag.make(1)`) still instantiates it.
in_struct_frame :: fn(member_ty: FnType, as_struct: Map<i32, Type>) -> FnType {
    if as_struct.is_empty() {
        return member_ty
    }
    quantifier: TypeParamType[]: []
    for tp in member_ty.type_params {
        quantifier.push(renamed_param(tp, as_struct))
    }
    return FnType { ...substitute_fn_map(member_ty, as_struct), .type_params = quantifier }
}

// `tp` under the struct's name for it, or as is when `as_struct` does not rename it.
renamed_param :: fn(tp: TypeParamType, as_struct: Map<i32, Type>) -> TypeParamType {
    to :: as_struct[tp.symbol.id]
    if to is TypeParamType {
        return to
    }
    return tp
}

// The default of the trait whose return `m` takes : `m` writes none, and the
// default leaves its own to its body. Null otherwise.
default_giving_return :: fn(m: AST.FnDecl, trait_method: AST.FnDecl | null) -> AST.FnDecl | null {
    if m.return_type != null || trait_method == null || !needs_return_inference(trait_method) {
        return null
    }
    return trait_method
}

// Adds `entry` to the members `key` offers, once : a plain type's own key is its
// side key.
add_impl_method :: fn(tables: ImplTables, key: string, entry: ImplMethod) -> void {
    members :: tables.impl_methods.get_or_put_with(key, () -> [])
    for i in 0..<members.len() {
        if members[i].impl_key == entry.impl_key {
            members[i] = entry
            return
        }
    }
    members.push(entry)
}

diag_sink :: fn() -> Diagnostic[] { return [] }

// Index an impl's `Iterator` / `Into` / `Index` / `IndexSet` trait args into the
// element / key / target tables of the impl tables, so `for x in X`, `m[k]`
// and `m[k] = v` pin their types. `trait_key` is the impl's resolved trait, so a
// user trait that happens to be named `Index` indexes nothing.
index_impl_metadata :: fn(
    tables: ImplTables,
    for_ty: Type,
    trait_key: string,
    trait_args: Type[],
) -> void {
    key :: impl_side_key(for_ty)
    if trait_key == core_trait_key(TRAIT_ITERATOR) && trait_args.len() == 1 {
        tables.iter_element_types[key] = trait_args[0]
    }
    // A type that is an `Iterator` itself is walked through its own `next`, whatever
    // it converts into.
    if trait_key == core_trait_key(TRAIT_INTO) && trait_args.len() == 1 {
        elem :: core_trait_arg(trait_args[0], TRAIT_ITERATOR)
        if elem != null && !has_iterator_impl(tables, key) {
            tables.iter_element_types[key] = elem
        }
    }
    if trait_key == core_trait_key(TRAIT_INDEX) && trait_args.len() == 2 {
        tables.index_key_types[key] = trait_args[0]
        tables.index_target_types[key] = trait_args[1]
    }
    if trait_key == core_trait_key(TRAIT_INDEX_SET) && trait_args.len() == 2 {
        tables.index_set_key_types[key] = trait_args[0]
        tables.index_set_value_types[key] = trait_args[1]
    }
}

has_iterator_impl :: fn(tables: ImplTables, key: string) -> bool {
    traits :: tables.struct_implemented_traits[key] ?? return false
    return core_trait_key(TRAIT_ITERATOR) in traits
}

// Append `trait_key` to `m[key]`'s bucket unless already present.
// Shared by the three trait-membership recorders (`record_impl_members` + both
// maps of `record_struct_trait`), generic over the key type so the id-keyed and
// base-keyed maps use one form.
add_trait_unique :: fn<K: Hash & Equals>(
    m: Map<K, string[]>, key: K, trait_key: string,
) -> void {
    bucket :: m.get_or_put_with(key, () -> [])
    for n in bucket {
        if n == trait_key {
            return
        }
    }
    bucket.push(trait_key)
}

record_struct_trait :: fn(tables: ImplTables, for_ty: Type, trait_key: string) -> void {
    // Two membership maps populated in lockstep: the symbol-id map drives the
    // runtime `is Trait` impl_table rows via the emitter, the `impl_side_key` map
    // answers the typecheck consumers and also covers primitives and arrays. An
    // impl on one instance stays off the symbol-id map, which every tag of the
    // declaration reads : the instance's own tag gets its row from the members
    // materialised for it.
    target :: type_to_target_symbol(for_ty)
    if target is Symbol && !is_instance_receiver(for_ty) {
        add_trait_unique(tables.struct_traits_by_sym, target.id, trait_key)
    }
    add_trait_unique(tables.struct_implemented_traits, impl_side_key(for_ty), trait_key)
}

// The bounds an impl's type parameters put on the arguments of `for_ty`, the type
// it implements its trait for (`ImplTables.impl_bounds`). `owner` is the
// impl's own module, which holds its type parameters' bounds and the scope they
// name traits in. An impl for a type without arguments puts no bound.
record_impl_bounds :: fn(
    owner: TypedProgram, decl: AST.ImplDecl, for_ty: Type, trait_key: string,
) -> void {
    args :: type_arguments(for_ty)
    if args.is_empty() || is_instance_receiver(for_ty) {
        return
    }
    bounds: ArgBound[]: []
    for i in 0..<args.len() {
        arg :: args[i]
        if arg is TypeParamType {
            bound :: owner.resolved.type_param_bounds[arg.symbol.id] ?? continue
            traits: TraitType[]: []
            collect_bound_trait_types(bound, owner.resolved, traits)
            bounds.push(ArgBound {
                .position = i,
                .name = arg.symbol.name,
                .traits = traits,
            })
        }
    }
    entry :: BoundedImpl {
        .trait_key = trait_key,
        .impl_key  = decl.span.hash(),
        .bounds    = bounds,
    }
    owner.impl_tables.impl_bounds.get_or_put_with(impl_base_key(for_ty), () -> []).push(entry)
}
