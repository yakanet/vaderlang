// vader/front/typecheck/guard: a predicate narrows the arguments it is called on.
//
// An expression-bodied function returning `bool` whose condition narrows its
// parameters is a guard : `is_weekend :: fn(d: Weekday) -> bool = d >= 5` proves
// `d` within `5..=6` where it returns true and within `0..=4` where it returns
// false, so `if is_weekend(d)` narrows `d` at the call. What it proves is what the
// narrowing machine gives its condition on each side, read for each parameter
// once the body is checked ; a call written ahead of the guard checks that body
// first, on its own. An inferred guard holds in its own module : the facts live in
// its `TypedProgram`, and another module calls it as a plain predicate.
//
// `@returns(cond)` declares the contract instead : what the fn proves is then what
// `cond` proves, in every module. The contract depends on the signature and
// `cond` alone, so it is read on demand in the module declaring it, whatever has
// been walked. The body is held to it at each value it returns, both sides
// (T3111), and may not write a parameter (T3113).
//
// `@ensures(cond)` states what holds once the fn has returned : a call written as
// a statement, or as the value of a `let`, narrows its arguments as `cond` narrows
// the parameters where it is true, for the rest of the block. The contract is read
// the same way ; the body is held to it at each return and at its end (T3114),
// under the same rules of shape (T3112) and of writing (T3113).

module "vader/front/typecheck"

import "std/collections"
import "toolchain/span"
import "vader/support/diagnostics"
import "vader/core/types"
AST :: import "toolchain/ast"

/// The inferred guards of a module, and the contract being held while the body of a
/// fn declaring one is checked.
export GuardState :: struct {
    /// The module's top-level fns that may be inferred guards
    /// (`is_guard_candidate`), by node id.
    candidates: MutableSet<i64> = MutableSet<i64> {}
    /// What each checked candidate proves, by node id ; nothing while its body is
    /// being checked.
    facts: MutableMap<i64, GuardFact[]> = MutableMap<i64, GuardFact[]> {}
    /// A contract of the fn whose body is being checked, `@returns` or `@ensures` :
    /// a write to one of its parameters, from a lambda in it too, is refused.
    verifying: GuardContract | null = null
}

/// The declared contracts of the project, `@returns` and `@ensures` : tables every
/// module shares.
export SharedGuards :: struct {
    /// The module declaring each fn with a contract, by node id.
    owners: MutableMap<i64, TypedProgram> = MutableMap<i64, TypedProgram> {}
    /// What each `@returns` states.
    returns: ContractTable = ContractTable {}
    /// What each `@ensures` states.
    ensures: ContractTable = ContractTable {}
}

/// The contracts of one decorator, read on demand.
export ContractTable :: struct {
    /// Each contract read so far, by node id.
    contracts: MutableMap<i64, GuardContract> = MutableMap<i64, GuardContract> {}
    /// The contracts being read : a condition that reaches its own fn reads nothing
    /// of it.
    reading: MutableSet<i64> = MutableSet<i64> {}
}

/// What a fn declaring `@returns` or `@ensures` promises : the facts its condition
/// proves, over its parameters.
export GuardContract :: struct {
    decl: AST.FnDecl
    facts: GuardFact[]
    params: ParamSlots
}

/// What a guard proves about one of its parameters.
export GuardFact :: struct {
    /// The parameter's position.
    index: i64
    /// The parameter's declared type.
    declared: Type
    /// What it holds where the condition is true : the guard returns true, or the
    /// `@ensures` fn has returned.
    then_ty: Type
    /// What it holds where the condition is false.
    else_ty: Type
}

/// The symbol and the declared type of each parameter of a fn, by position.
export ParamSlots :: struct {
    symbols: i32[]
    declared: Type[]
}

// ---- inferred guards ------------------------------------------------------

/// Whether `fd`, a top-level fn of the module once declared, may be an inferred
/// guard : a predicate written as one expression, with a parameter of a type a test
/// can narrow, and no contract of its own.
///
/// @param fd  a function declaration whose signature is declared.
is_guard_candidate :: fn(fd: AST.FnDecl, typed: TypedProgram) -> bool {
    if !fd.is_expression_bodied || fd.params.len() == 0 || guard_condition(fd) != null {
        return false
    }
    if predicate_problem(fd, typed) != "" {
        return false
    }
    for p in fd.params {
        declared :: typed.param_types[p.span.hash()] ?? continue
        if is_narrowable(declared) {
            return true
        }
    }
    return false
}

// What keeps `fd` from being a predicate a guard can be : "" when it returns
// `bool` or an inferred type, has a body and is not generic.
predicate_problem :: fn(fd: AST.FnDecl, typed: TypedProgram) -> string {
    held :: held_problem(fd)
    if held != "" {
        return held
    }
    returned :: lookup_return_type(fd, typed)
    if !is_bool(returned) && returned !is UnresolvedType {
        return "`${fd.name}` returns ${display_type(returned)}"
    }
    return ""
}

// What keeps `fd` from having a contract `@ensures` states : "" when it has a body
// that has run once a call returns, and is not generic. A generator's body runs as
// its stream is read, a coroutine's past its first `await`.
ensures_problem :: fn(fd: AST.FnDecl, typed: TypedProgram) -> string {
    held :: held_problem(fd)
    if held != "" {
        return held
    }
    if fn_is_generator(typed, fd) {
        return "`${fd.name}` is a generator : its body runs after the call has returned"
    }
    if fn_is_async(typed, fd) {
        return "`${fd.name}` awaits : its body runs after the call has returned"
    }
    return ""
}

// What keeps any contract off `fd` : a type parameter, which the contract cannot
// speak of yet, or no body to hold to it.
held_problem :: fn(fd: AST.FnDecl) -> string {
    if fd.type_params.len() > 0 {
        return "`${fd.name}` is generic"
    }
    if fd.body == null {
        return "`${fd.name}` has no body to hold to it"
    }
    return ""
}

// Whether a test can narrow a value of type `t` : a union, a trait value, an
// integer a bounds test narrows, a range ; or an unresolved type, which says
// nothing yet.
is_narrowable :: fn(t: Type) -> bool =
    t is UnionType || t is TraitType || t is UnresolvedType || integer_values(t) != null

/// What the checked predicate `fd` proves about each parameter its condition
/// narrows.
///
/// @param fd    an inferred guard candidate (`is_guard_candidate`).
/// @param body  its body, the condition its trailing expression.
proved_facts :: fn(fd: AST.FnDecl, body: AST.BlockExpr, typed: TypedProgram) -> GuardFact[] {
    facts: GuardFact[]: []
    cond :: body.trailing ?? return facts
    recorded :: typed.expr_types[cond.id] ?? return facts
    if !is_bool(recorded) {
        return facts
    }
    params :: param_slots(fd, typed) ?? return facts
    return facts_of(cond, params, typed)
}

// What the guard `decl` of this module proves : read off its checked body, which a
// call written ahead of it checks now. Null while a const's value is typed : a fn
// body is checked once every const it may read is set.
guard_facts :: fn(decl: AST.FnDecl, typed: TypedProgram) -> GuardFact[] | null {
    known :: typed.guards.facts[decl.id]
    if known != null {
        return known
    }
    if typed.const_walk.typing.len() > 0 {
        return null
    }
    body :: decl.body ?? return null
    position :: set_walk_aside(typed)
    check_fn_body(decl, body, typed, diag_sink())
    resume_walk(typed, position)
    return typed.guards.facts[decl.id]
}

// ---- declared guards ------------------------------------------------------

/// The condition `@returns(cond)` declares on `fd`, if it carries one.
///
/// @param fd  a function declaration.
guard_condition :: fn(fd: AST.FnDecl) -> AST.Expr | null = declared_condition(fd, "returns")

/// The condition `@ensures(cond)` declares on `fd`, if it carries one.
///
/// @param fd  a function declaration.
ensured_condition :: fn(fd: AST.FnDecl) -> AST.Expr | null = declared_condition(fd, "ensures")

// The condition the decorator `name` declares on `fd` ; none where it does not
// state exactly one (P1032).
declared_condition :: fn(fd: AST.FnDecl, name: string) -> AST.Expr | null {
    decorator :: AST.find_decorator(fd.decorators, name) ?? return null
    if decorator.args.len() != 1 {
        return null
    }
    return decorator.args[0]
}

/// The contract the `@returns` fn `decl` declares : read once, in the module
/// declaring it, apart from whatever that module's walk is in.
///
/// @return  null for no `@returns` fn, a misshapen one, and while the contract is
///          being read.
contract_of :: fn(decl: AST.FnDecl, typed: TypedProgram) -> GuardContract | null {
    table :: typed.shared_guards.returns
    known :: table.contracts[decl.id]
    if known != null {
        return known
    }
    cond :: guard_condition(decl) ?? return null
    owner :: typed.shared_guards.owners[decl.id] ?? return null
    if predicate_problem(decl, owner) != "" {
        return null
    }
    return read_once(decl, cond, owner, table)
}

/// The contract the `@ensures` fn `decl` declares, read as `contract_of` reads one.
///
/// @return  null for no `@ensures` fn, a misshapen one, and while the contract is
///          being read.
ensures_of :: fn(decl: AST.FnDecl, typed: TypedProgram) -> GuardContract | null {
    table :: typed.shared_guards.ensures
    known :: table.contracts[decl.id]
    if known != null {
        return known
    }
    cond :: ensured_condition(decl) ?? return null
    owner :: typed.shared_guards.owners[decl.id] ?? return null
    if ensures_problem(decl, owner) != "" {
        return null
    }
    return read_once(decl, cond, owner, table)
}

// The contract `cond` states for `decl`, read in `owner` and kept in `table`.
read_once :: fn(
    decl: AST.FnDecl,
    cond: AST.Expr,
    owner: TypedProgram,
    table: ContractTable,
) -> GuardContract | null {
    if !table.reading.add(decl.id) {
        return null
    }
    position :: set_walk_aside(owner)
    contract :: read_contract(decl, cond, owner)
    resume_walk(owner, position)
    table.reading.remove(decl.id)
    if contract != null {
        table.contracts[decl.id] = contract
    }
    return contract
}

// The contract `cond` states for `decl`, read in the module declaring it.
read_contract :: fn(decl: AST.FnDecl, cond: AST.Expr, owner: TypedProgram) -> GuardContract | null {
    check_expr(cond, TY_BOOL, owner, diag_sink())
    params :: param_slots(decl, owner) ?? return null
    return GuardContract {
        .decl = decl,
        .facts = facts_of(cond, params, owner),
        .params = params,
    }
}

/// Start checking the body of the `@returns` fn `fd` : report what its contract
/// lacks, and hold the body to it, its returns through `ctx` and its writes through
/// the module's guard state.
///
/// @param ctx  the context of `fd`'s body.
/// @error      T3112 when `@returns` is misshapen or proves nothing.
hold_to_contract :: fn(
    fd: AST.FnDecl,
    ctx: FnContext,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    cond :: guard_condition(fd) ?? return
    problem :: predicate_problem(fd, typed)
    ctx.guard = admitted(fd, cond, problem, typed, diags, () -> contract_of(fd, typed))
}

/// Start checking the body of the `@ensures` fn `fd` : report what its contract
/// lacks, and hold the body to it, its returns and its end through `ctx` and its
/// writes through the module's guard state.
///
/// @param ctx  the context of `fd`'s body.
/// @error      T3112 when `fd` cannot carry the contract, or it proves nothing.
hold_to_ensures :: fn(
    fd: AST.FnDecl,
    ctx: FnContext,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    cond :: ensured_condition(fd) ?? return
    problem :: ensures_problem(fd, typed)
    ctx.ensures = admitted(fd, cond, problem, typed, diags, () -> ensures_of(fd, typed))
}

// The contract `read` gives `fd`, whose body is checked next : null after a T3112
// where `problem` keeps the contract off `fd`, or where its condition proves
// nothing of the parameters. From here on the body may not write them (T3113).
admitted :: fn(
    fd: AST.FnDecl,
    cond: AST.Expr,
    problem: string,
    typed: TypedProgram,
    diags: Diagnostic[],
    read: fn() -> GuardContract | null,
) -> GuardContract | null {
    if problem != "" {
        diags.push(typecheck_error(.MisshapenGuard, fd.name_span, problem))
        return null
    }
    check_expr(cond, TY_BOOL, typed, diags)
    contract :: read() ?? return null
    if contract.facts.len() == 0 {
        diags.push(typecheck_error(.MisshapenGuard, cond.span,
            "the condition proves nothing of the parameters of `${fd.name}`"))
        return null
    }
    typed.guards.verifying = contract
    return contract
}

/// Hold the point an `@ensures` fn returns from to its contract : each parameter,
/// as the narrowings in force there leave it, must lie within what the condition
/// proves where it is true.
///
/// @param contract  the fn's contract.
/// @param at        where it returns : a `return`, or the end of its body.
/// @param how       `returns` or `ends`, as the message says it.
/// @error           T3114 for each parameter that leaves the contract.
check_ensured :: fn(
    contract: GuardContract,
    at: Span,
    how: string,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    params :: contract.params
    for fact in contract.facts {
        holds :: narrow_for_binding(typed, params.symbols[fact.index], fact.declared)
        if !is_assignable(holds, fact.then_ty) {
            param :: contract.decl.params[fact.index].name
            diags.push(typecheck_error(.PostconditionDoesNotHold, at,
                "`${contract.decl.name}` ${how} where `${param}` is ${described(holds)}, "
                    + "not within ${described(fact.then_ty)}"))
        }
    }
}

/// Hold the value `returned` an `@ensures` fn returns to its contract
/// (`check_ensured`) : an `if` value branch by branch, a branch that diverges not at
/// all, and one with no `else` whose branch diverges past it, as a statement is ; a
/// call to an `@ensures` fn with what it ensures pushed ; a value that never comes,
/// not at all.
///
/// @param contract  the fn's contract.
/// @param returned  the value, already checked.
/// @param how       `returns` or `ends`, as the message says it.
check_ensured_value :: fn(
    contract: GuardContract,
    returned: AST.Expr,
    how: string,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    if typed.expr_types[returned.id] is NeverType {
        return
    }
    pushed: PushedNarrow[]: []
    if returned is AST.IfExpr {
        visit :: (v: AST.Expr) -> check_ensured_value(contract, v, how, typed, diags)
        if !push_past_divergent_if(returned, typed, pushed)
            && each_branch_value(returned, typed, visit) {
            return
        }
    } else if returned is AST.CallExpr {
        push_ensured_call(returned, typed, pushed)
    }
    check_ensured(contract, returned.span, how, typed, diags)
    pop_narrows(pushed, typed)
}

/// Hold a point the fn returns from to its `@ensures`, if it has one : the value it
/// returns there, or the point itself where it returns none.
///
/// @param contract  the fn's `@ensures` contract, null for none.
/// @param value     the value returned there, null for none.
/// @param at        where it returns : a `return`, or the end of its body.
/// @param how       `returns` or `ends`, as the message says it.
check_ensured_exit :: fn(
    contract: GuardContract | null,
    value: AST.Expr | null,
    at: Span,
    how: string,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    ensured :: contract ?? return
    if value != null {
        check_ensured_value(ensured, value, how, typed, diags)
        return
    }
    check_ensured(ensured, at, how, typed, diags)
}

/// Hold the value `returned` a `@returns` fn returns to its contract : where it is
/// true, each parameter must lie within what the contract proves on the true side,
/// and where it is false, on the false side.
///
/// @param contract  the fn's contract.
/// @param returned  a value the fn returns, already checked, the narrowings in
///                  force where it is returned still pushed.
/// @error           T3111 for each side and parameter that leaves the contract.
check_guard_return :: fn(
    contract: GuardContract,
    returned: AST.Expr,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    if returned is AST.IfExpr && check_guard_branches(contract, returned, typed, diags) {
        return
    }
    params :: contract.params
    for truth in [true, false] {
        if returned is AST.BoolLitExpr && returned.value != truth {
            continue
        }
        holds :: narrowed_params(returned, truth, params.symbols, params.declared, typed)
        for fact in contract.facts {
            promised :: side_of(truth, fact.then_ty, fact.else_ty)
            if !is_assignable(holds[fact.index], promised) {
                param :: contract.decl.params[fact.index].name
                diags.push(typecheck_error(.GuardDoesNotHold, returned.span,
                    "`${contract.decl.name}` returns ${truth} where `${param}` is "
                        + "${described(holds[fact.index])}, not within ${described(promised)}"))
            }
        }
    }
}

// Hold each branch of the `if` value `e` to the contract (`each_branch_value`) ;
// whether its branches cover `e`.
check_guard_branches :: fn(
    contract: GuardContract,
    e: AST.IfExpr,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> bool =
    each_branch_value(e, typed, (v: AST.Expr) -> check_guard_return(contract, v, typed, diags))

// Visit each value the `if` value `e` gives, its condition pushed on the side that
// reaches it ; a branch that diverges gives none. Whether every branch gives a value
// or diverges, so that the visits cover `e`. What a branch block's own statements
// narrow is not read, which only refuses more.
each_branch_value :: fn(e: AST.IfExpr, typed: TypedProgram, visit: fn(AST.Expr) -> void) -> bool {
    then_branch :: branch_of(e.then_block.trailing, then_is_divergent(e.then_block, typed))
        ?? return false
    else_branch :: branch_of(else_value_of(e), else_is_divergent(e, typed)) ?? return false
    visit_branch(e.cond, true, then_branch, typed, visit)
    visit_branch(e.cond, false, else_branch, typed, visit)
    return true
}

// A branch that never ends.
Diverged :: struct {}

// What a branch gives : its value, `Diverged` where it never ends, null where it
// ends with no value.
branch_of :: fn(value: AST.Expr | null, diverges: bool) -> AST.Expr | Diverged | null {
    if diverges {
        return Diverged {}
    }
    return value
}

// Whether the `else` of `e` is a block that never ends.
else_is_divergent :: fn(e: AST.IfExpr, typed: TypedProgram) -> bool {
    eb :: e.else_branch
    if eb is AST.IfElseBlock {
        return then_is_divergent(eb.block, typed)
    }
    return false
}

// Visit the value `branch` gives, the condition `cond` pushed on its side `truth`.
visit_branch :: fn(
    cond: AST.Expr,
    truth: bool,
    branch: AST.Expr | Diverged,
    typed: TypedProgram,
    visit: fn(AST.Expr) -> void,
) -> void {
    if branch is Diverged {
        return
    }
    pushed :: push_cond_narrows(cond, truth, typed, diag_sink())
    visit(branch)
    pop_narrows(pushed, typed)
}

// The value the `else` of `e` gives : its block's trailing, or the next `if`.
else_value_of :: fn(e: AST.IfExpr) -> AST.Expr | null = match eb :: e.else_branch {
    is null            -> null
    is AST.IfElseBlock -> eb.block.trailing
    is AST.IfElseIf    -> eb.branch
}

/// Hold the end of `block` to the contracts of the fn it is the body of, before the
/// narrowings its guards pushed are undone : its trailing value to `@returns`, and
/// to `@ensures` the value or, with none, the end itself unless the block never
/// gets there.
///
/// @param result  the type of `block`, `never` where its last statement diverges.
/// @param ctx     the context the block is checked in.
check_body_value :: fn(
    block: AST.BlockExpr,
    result: Type,
    ctx: FnContext | null,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    if ctx == null {
        return
    }
    contract :: ctx.guard
    if contract != null && is_body_of(block, contract) && block.trailing != null {
        check_guard_return(contract, block.trailing, typed, diags)
    }
    ensured :: ctx.ensures ?? return
    if !is_body_of(block, ensured) || result is NeverType {
        return
    }
    check_ensured_exit(ensured, block.trailing, end_of(block), "ends", typed, diags)
}

// Whether `block` is the body of the fn `contract` belongs to.
is_body_of :: fn(block: AST.BlockExpr, contract: GuardContract) -> bool {
    body :: contract.decl.body ?? return false
    return body.id == block.id
}

// Where `block` ends, as a diagnostic places it : its last statement, else itself.
end_of :: fn(block: AST.BlockExpr) -> Span {
    if block.stmts.len() == 0 {
        return block.span
    }
    return block.stmts[block.stmts.len() - 1].span
}

/// Refuse a write to `target` when it names a parameter of the fn whose body is
/// being checked and which declares a contract : the contract speaks of the
/// argument, which the write would hide.
///
/// @param target  the name an assignment writes.
/// @return        whether the write was refused.
/// @error         T3113.
reject_guard_param_write :: fn(target: AST.IdentExpr, typed: TypedProgram, diags: Diagnostic[]) -> bool {
    contract :: typed.guards.verifying ?? return false
    sym :: typed.resolved.idents[target.span.hash()] ?? return false
    if sym.id !in contract.params.symbols {
        return false
    }
    diags.push(typecheck_error(.GuardParameterWritten, target.span,
        "`${contract.decl.name}` writes `${target.name}`"))
    return true
}

// `t` as a message names it, a range with its bounds.
described :: fn(t: Type) -> string {
    if t is RangeType {
        return display_range(t)
    }
    return "`${display_type(t)}`"
}

// ---- facts ----------------------------------------------------------------

// The parameters of `fd` as a guard's condition reads them ; null when one is not
// recorded.
param_slots :: fn(fd: AST.FnDecl, typed: TypedProgram) -> ParamSlots | null {
    params :: ParamSlots { .symbols = [], .declared = [] }
    for p in fd.params {
        sym :: typed.resolved.idents[p.span.hash()] ?? return null
        params.symbols.push(sym.id)
        params.declared.push(typed.param_types[p.span.hash()] ?? return null)
    }
    return params
}

// A fact for each parameter `cond` narrows, read where it is true and where it is
// false.
facts_of :: fn(cond: AST.Expr, params: ParamSlots, typed: TypedProgram) -> GuardFact[] {
    declared :: params.declared
    then_tys :: narrowed_params(cond, true, params.symbols, declared, typed)
    else_tys :: narrowed_params(cond, false, params.symbols, declared, typed)
    facts: GuardFact[]: []
    for i in 0..<declared.len() {
        if equals_type(then_tys[i], declared[i]) && equals_type(else_tys[i], declared[i]) {
            continue
        }
        facts.push(GuardFact {
            .index = i,
            .declared = declared[i],
            .then_ty = then_tys[i],
            .else_ty = else_tys[i],
        })
    }
    return facts
}

// What each parameter, the binding `symbols` names, holds where `cond` evaluates
// to `truth`, on top of the narrowings in force.
narrowed_params :: fn(
    cond: AST.Expr,
    truth: bool,
    symbols: i32[],
    declared: Type[],
    typed: TypedProgram,
) -> Type[] {
    pushed :: push_cond_narrows(cond, truth, typed, diag_sink())
    out: Type[]: []
    for i in 0..<declared.len() {
        out.push(narrow_for_binding(typed, symbols[i], declared[i]))
    }
    pop_narrows(pushed, typed)
    return out
}

/// `then_ty` where a test evaluated to `truth`, `else_ty` otherwise.
///
/// @param truth  the test's outcome.
side_of :: fn(truth: bool, then_ty: Type, else_ty: Type) -> Type {
    if truth {
        return then_ty
    }
    return else_ty
}

// ---- calls ----------------------------------------------------------------

/// The narrowings a call to a guard gives the arguments it narrows, one per
/// argument that is a binding or a field chain.
///
/// @param call  a call in a condition, already checked.
/// @return      null when the callee is no guard here.
guard_narrowings :: fn(call: AST.CallExpr, typed: TypedProgram) -> IsNarrow[] | null {
    decl :: recorded_decl(typed, call) ?? return null
    facts :: callee_guard_facts(decl, typed) ?? return null
    return argument_narrowings(call, decl, facts, typed)
}

/// Push what a call to an `@ensures` fn narrows once it has returned : each argument
/// within what the condition proves of its parameter where it is true, for the rest
/// of the block. Only a binding no lambda rebinds is narrowed : a field the callee,
/// or a later argument, may write through another name, and a local a lambda the
/// call runs may rebind, may no longer hold the value the contract spoke of.
///
/// @param call    a call written as a statement, already checked.
/// @param pushed  receives the records that unwind them (`pop_narrows`).
push_ensured_call :: fn(call: AST.CallExpr, typed: TypedProgram, pushed: PushedNarrow[]) -> void {
    decl :: recorded_decl(typed, call) ?? return
    contract :: ensures_of(decl, typed) ?? return
    for n in argument_narrowings(call, decl, contract.facts, typed) {
        if n.field_key != "" || n.sym_id in typed.resolved.closure_rebound {
            continue
        }
        pushed.push(push_one_narrow(typed, n.sym_id, n.field_key, n.then_ty))
    }
}

// The narrowing each of `facts`, of the fn `decl`, gives the argument `call` passes
// its parameter, one per argument that is a binding or a field chain.
argument_narrowings :: fn(
    call: AST.CallExpr,
    decl: AST.FnDecl,
    facts: GuardFact[],
    typed: TypedProgram,
) -> IsNarrow[] {
    offset :: receiver_offset(call, decl, typed)
    out: IsNarrow[]: []
    for fact in facts {
        arg :: guard_argument(call, offset, fact.index) ?? continue
        slot :: slot_of(arg, typed) ?? continue
        current :: slot.current
        if current is UnresolvedType {
            continue
        }
        out.push(IsNarrow {
            .sym_id = slot.sym_id,
            .static_ty = current,
            .then_ty = fitted(current, fact.declared, fact.then_ty),
            .else_ty = fitted(current, fact.declared, fact.else_ty),
            .field_key = slot.field_key,
        })
    }
    return out
}

// What the fn `decl` a call names proves as a guard : its contract, in any module,
// else what it proves as an inferred guard of this module.
callee_guard_facts :: fn(decl: AST.FnDecl, typed: TypedProgram) -> GuardFact[] | null {
    if decl.id in typed.guards.candidates {
        return guard_facts(decl, typed)
    }
    contract :: contract_of(decl, typed) ?? return null
    return contract.facts
}

/// The first narrowing a call to a guard gives : what a test read as one leaf
/// narrows (`detect_value_narrow`). A condition pushes them all
/// (`push_guard_call`).
///
/// @param call  a call in a condition, already checked.
guard_narrowing :: fn(call: AST.CallExpr, typed: TypedProgram) -> IsNarrow | null {
    narrowings :: guard_narrowings(call, typed) ?? return null
    if narrowings.len() == 0 {
        return null
    }
    return narrowings[0]
}

/// Push what a call to a guard narrows where it evaluated to `truth`.
///
/// @param pushed  receives the records that unwind them (`pop_narrows`).
push_guard_call :: fn(call: AST.CallExpr, truth: bool, typed: TypedProgram, pushed: PushedNarrow[]) -> void {
    narrowings :: guard_narrowings(call, typed) ?? return
    for n in narrowings {
        pushed.push(push_one_narrow(typed, n.sym_id, n.field_key, side_of(truth, n.then_ty, n.else_ty)))
    }
}

// The argument `call` passes the parameter `index` of a fn `offset` of whose
// parameters its receiver fills ; the typecheck put the arguments in parameter
// order.
guard_argument :: fn(call: AST.CallExpr, offset: i64, index: i64) -> AST.Expr | null {
    if index < offset {
        callee :: call.callee
        if callee is AST.FieldExpr {
            return callee.target
        }
        return null
    }
    position :: index - offset
    if position >= call.args.len() {
        return null
    }
    return call.args[position].value
}

// What a value of type `current`, passed where `declared` is expected, holds where
// the guard proved `proved` of its parameter : `proved` when the two types agree,
// the values both hold for integers, `proved` again when it refines `current`, and
// `current` itself when the fact says nothing of it.
fitted :: fn(current: Type, declared: Type, proved: Type) -> Type {
    if proved is NeverType || equals_type(current, declared) {
        return proved
    }
    proved_values :: integer_values(proved)
    if proved_values != null {
        within :: inside_of(current, RangeType { .bounds = proved_values })
        if within != null {
            return within
        }
    }
    if is_assignable(proved, current) {
        return proved
    }
    return current
}
