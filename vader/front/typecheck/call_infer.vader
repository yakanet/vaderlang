// vader/front/typecheck/call_infer — a call to a quantified signature.
//
// Each call instantiates the callee's quantifier afresh : every parameter becomes
// an `InferVar` of its own, and only those variables bind. A type parameter met in
// the arguments, the receiver or the result slot is rigid, whoever declared it, so
// a generic body calling itself (`f(x)` inside `f<T>`) binds the callee's variable
// to the caller's `T` and nothing else. Once the call is solved, the bindings are
// keyed back by the declared parameters, which is what the later passes read.
// docs/adr/0070-a-generic-call-instantiates-its-callee-afresh.md

module "vader/front/typecheck"

import "std/collections"
import "std/iter"
import "std/math"
import "toolchain/span"
import "vader/support/diagnostics"
AST :: import "toolchain/ast"
import "vader/core/types"
import "vader/core/symbol"

// ---- the call --------------------------------------------------------------

// One generic call being solved : its signature with the quantified parameters
// turned into this call's variables (`own`), and what binds them so far.
CallInference :: struct {
    call:      AST.CallExpr
    inst:      FnType
    own:       InferVar[]
    solutions: MutableMap<i32, Type>
    held:      MutableSet<i32> | null
    typed:     TypedProgram
}

// Type a call whose callee quantifies over parameters (`callee_ty.type_params`), each
// instantiated afresh here ; `n` arguments line up with a parameter. Returns what
// the instance returns.
type_generic_call :: fn(
    c: AST.CallExpr,
    callee_ty: FnType,
    expected: Type | null,
    n: i64,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type {
    vars :: MutableMap<i32, Type> {}
    own: InferVar[]: []
    for tp in callee_ty.type_params {
        v :: fresh_infer_var(typed, tp)
        vars[tp.symbol.id] = v
        own.push(v)
    }
    solutions :: typed.infer_solutions
    written :: written_vars(c, callee_ty, own, typed)
    ctx :: CallInference {
        .call = c,
        .inst = substitute_fn_map(callee_ty, vars),
        .own = own,
        .solutions = solutions,
        .held = seed_explicit_infer(c.type_args, written, typed, solutions, diags),
        .typed = typed,
    }
    seed_ufcs_infer(ctx, vars)
    // Lambda arguments go last, once the other arguments and the result slot have
    // bound what their parameters name.
    arg_types: Type[]: []
    lambdas: i64[]: []
    for i in 0..<n {
        if c.args[i].value is AST.LambdaExpr {
            arg_types.push(TY_UNRESOLVED)
            lambdas.push(i)
            continue
        }
        arg_types.push(check_infer_arg(ctx, i, diags))
    }
    // A result slot still waiting on an enclosing call's variables pins nothing.
    if expected != null && !type_contains_infer_var(expected) {
        unify_infer(ctx.inst.return_type, expected, solutions, ctx.held)
    }
    if lambdas.len() > 0 {
        solve_through_lambdas(ctx, lambdas)
        for i in lambdas {
            arg_types[i] = check_infer_arg(ctx, i, diags)
        }
    }
    // Keyed back by the declared parameters. A variable nothing solved stands for
    // its parameter from here on, so what was typed against it reads as the
    // unsolved parameter it is.
    bindings :: MutableMap<i32, Type> {}
    unsolved: Symbol[]: []
    for v in own {
        solved :: solutions[v.id]
        if solved == null {
            unsolved.push(v.origin)
            solutions[v.id] = mk_type_param(v.origin)
            continue
        }
        bindings[v.origin.id] = zonk(solved, solutions)
    }
    report_unsolved(c, unsolved, callee_ty, arg_types, diags)
    reject_ufcs_receiver_at_instance(c, bindings, unsolved, typed, diags)
    instance :: substitute_fn_map(callee_ty, bindings)
    for i in 0..<n {
        // A parameter naming a variable nothing solved has nothing to check against.
        if names_any(callee_ty.params[i], unsolved) {
            continue
        }
        got :: zonk(arg_types[i], solutions)
        want :: instance.params[i]
        if fits_argument(typed, c.args[i].value, got, want) { continue }
        if try_into(got, want, typed, c.args[i].value)      { continue }
        span :: c.args[i].span
        diags.push(mismatch_diagnostic(got, want, span, .TypeMismatch, typed))
    }
    // Free literals in `bindings` take their default here : what follows reads the
    // instance as recorded.
    note_call_bindings(typed, c, callee_ty.type_params, bindings)
    settle_generic_member_dispatch(c, typed, diags)
    recorded :: substitute_fn_map(callee_ty, bindings)
    if c.callee is AST.FieldExpr && typed.ufcs_receiver_types[c.callee.id] != null {
        typed.expr_types[c.callee.id] = recorded
    }
    for i in 0..<n {
        got :: zonk(arg_types[i], solutions)
        if !is_free_numeric(got) {
            continue
        }
        want :: recorded.params[i]
        if want !is TraitType {
            settle_free_at_slot(c.args[i].value, want, typed, diags)
        } else if got !is FreeCharType {
            if struct_implements_trait(default_if_free(got), trait_key_of(want.symbol), typed) {
                typed.expr_types[c.args[i].value.id] = want
            }
        }
    }
    repin_free_ufcs_receiver_at_instance(c, bindings, typed, diags)
    check_typeparam_bounds(c.span, callee_name(c.callee), bindings, typed, diags)
    return recorded.return_type
}

// A member with type parameters of its own, called by `c`, runs one instance per
// call, which no vtable holds. T3107 on a trait value, and on a bound of an impl's
// parameter in that impl's members, whose body the impl's instances share. Through
// a bound elsewhere, the caller observes its type parameters : its instances, and
// those of the functions handing it theirs, stay concrete.
settle_generic_member_dispatch :: fn(
    c: AST.CallExpr, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    callee :: typed.call_sites.calls[c.id] ?? return
    if callee is TraitMember {
        report_generic_member_at_run_time(c, callee.member, "on a trait value", diags)
        return
    }
    if callee !is BoundMember || callee.own_args.len() == 0 {
        return
    }
    if typed.enclosing_impl != 0 {
        report_generic_member_at_run_time(
            c, callee.member, "in an impl member, whose body the impl's instances share", diags,
        )
        return
    }
    observe_type_params(typed)
}

report_generic_member_at_run_time :: fn(
    c: AST.CallExpr, member: string, where: string, diags: Diagnostic[],
) -> void {
    diags.push(
        typecheck_error(
            .GenericMemberAtRunTime,
            member_name_span(c),
            "`${member}` takes type parameters of its own, and is called ${where} :"
                + " call it on the type that implements it",
        ),
    )
}

// The span of the member name `c` calls, or of `c` when its callee is no member.
member_name_span :: fn(c: AST.CallExpr) -> Span {
    if c.callee is AST.FieldExpr {
        return c.callee.field_span
    }
    return c.span
}

// Check argument `i` against its instantiated parameter, then bind from it.
check_infer_arg :: fn(ctx: CallInference, i: i64, diags: Diagnostic[]) -> Type {
    pattern :: ctx.inst.params[i]
    slot :: zonk(pattern, ctx.solutions)
    // An argument typed against a variable still unsolved may record it : the
    // module's tables are then swept once its bodies are walked.
    if !ctx.typed.infer_leak_possible && type_contains_infer_var(slot) {
        ctx.typed.infer_leak_possible = true
    }
    arg_ty :: check_expr(ctx.call.args[i].value, slot, ctx.typed, diags)
    actual :: zonk(arg_ty, ctx.solutions)
    unify_infer(pattern, actual, ctx.solutions, ctx.held)
    unify_struct_to_trait_infer(pattern, actual, ctx.typed, ctx.solutions, ctx.held)
    return arg_ty
}

// Rounds over the lambda arguments, their diagnostics dropped, while one binds a
// variable another lambda's parameter waits on. A round that binds nothing ends
// them ; each other one binds a variable, so there are at most as many rounds as
// variables.
solve_through_lambdas :: fn(ctx: CallInference, lambdas: i64[]) -> void {
    if !lambda_slot_open(ctx, lambdas) {
        return
    }
    scratch: Diagnostic[]: []
    for 0..<ctx.own.len() {
        before :: solved_count(ctx)
        for i in lambdas {
            check_infer_arg(ctx, i, scratch)
        }
        if solved_count(ctx) == before {
            break
        }
    }
}

// The variables of `own` a call's written type arguments fix (`explicit_params`).
written_vars :: fn(
    c: AST.CallExpr, callee_ty: FnType, own: InferVar[], typed: TypedProgram,
) -> InferVar[] {
    explicit :: explicit_params(c.callee, callee_ty.type_params, typed)
    if explicit.len() == own.len() {
        return own
    }
    out: InferVar[]: []
    for v in own {
        if explicit.any_match((tp) -> tp.symbol.id == v.origin.id) {
            out.push(v)
        }
    }
    return out
}

// Fix the variables an explicit `<…>` writes, in the order the callee declares its
// parameters. Returns the ids of the variables it fixed.
seed_explicit_infer :: fn(
    type_args: AST.TypeExpr[],
    own: InferVar[],
    typed: TypedProgram,
    solutions: MutableMap<i32, Type>,
    diags: Diagnostic[],
) -> MutableSet<i32> | null {
    if type_args.len() == 0 {
        return null
    }
    held :: MutableSet<i32> {}
    for i in 0..<min(own.len(), type_args.len()) {
        solutions[own[i].id] = type_from_expr(type_args[i], typed.resolved, diags)
        held.add(own[i].id)
    }
    return held
}

// A UFCS receiver binds the variables of the parameter it was curried from.
seed_ufcs_infer :: fn(ctx: CallInference, vars: MutableMap<i32, Type>) -> void {
    callee :: ctx.call.callee
    if callee !is AST.FieldExpr {
        return
    }
    receiver_param :: ctx.typed.ufcs_receiver_types[callee.id] ?? return
    target_ty :: ctx.typed.expr_types[callee.target.id] ?? return
    pattern :: substitute_map(receiver_param, vars)
    unify_infer(pattern, target_ty, ctx.solutions, ctx.held)
    unify_struct_to_trait_infer(pattern, target_ty, ctx.typed, ctx.solutions, ctx.held)
}

// A struct or primitive argument reaching a `Trait<…>` parameter through its impl
// binds the parameter's arguments from the impl's.
unify_struct_to_trait_infer :: fn(
    pattern: Type,
    actual: Type,
    typed: TypedProgram,
    solutions: MutableMap<i32, Type>,
    held: MutableSet<i32> | null,
) -> void {
    if pattern !is TraitType {
        return
    }
    // A rigid parameter reaches the trait through its bound : `count(it)` with
    // `it: I` and `I: Iterator<i32>` binds the callee's `T` to `i32`.
    if actual is TypeParamType {
        // The argument then converts at each instance, from its concrete type.
        keep_instances_concrete(typed)
        bound :: typed.type_param_bound_traits[actual.symbol.id] ?? return
        for t in bound.traits {
            if t.symbol.id == pattern.symbol.id {
                unify_infer_each(pattern.args, t.args, solutions, held)
            }
        }
        return
    }
    impl_args :: resolve_struct_trait_args(actual, trait_key_of(pattern.symbol), typed) ?? return
    unify_infer_each(pattern.args, impl_args, solutions, held)
}

// Whether a lambda argument's parameter still names a variable of this call that a
// round over the lambdas could bind, or one only a free literal solved.
lambda_slot_open :: fn(ctx: CallInference, lambdas: i64[]) -> bool {
    for i in lambdas {
        slot :: zonk(ctx.inst.params[i], ctx.solutions)
        if any_type(slot, is_free_numeric) {
            return true
        }
        for v in ctx.own {
            if mentions_infer_var(slot, v.id) {
                return true
            }
        }
    }
    return false
}

solved_count :: fn(ctx: CallInference) -> i64 {
    count: i64 = 0
    for v in ctx.own {
        if ctx.solutions[v.id] != null {
            count += 1
        }
    }
    return count
}

// Whether `t` names one of `params`.
names_any :: fn(t: Type, params: Symbol[]) -> bool {
    if params.len() == 0 {
        return false
    }
    return any_type(
        t, (x: Type) -> x is TypeParamType && params.any_match((p) -> p.id == x.symbol.id),
    )
}

// T3069 for every parameter of the callee this call left unsolved. Unreported, an
// unsolved parameter flows on erased and fails far downstream : a vtable miss at
// run time, or the lowering's unresolved-callee panic. Silent on an arity mismatch,
// which T3003 / T3005 already name, and on an argument already reported (`?`),
// which may be the one that would have bound it.
report_unsolved :: fn(
    c: AST.CallExpr, unsolved: Symbol[], callee_ty: FnType, arg_types: Type[], diags: Diagnostic[],
) -> void {
    if unsolved.len() == 0 || arg_types.len() != callee_ty.params.len() {
        return
    }
    if arg_types.any_match((t) -> type_contains_unresolved(t)) {
        return
    }
    for sym in unsolved {
        diags.push(
            typecheck_error(
                .TypeArgumentNotInferable,
                c.span,
                "`${sym.name}` — annotate the result slot, or pass the type argument explicitly",
            ),
        )
    }
}

// ---- leaving the typecheck -------------------------------------------------

// Replace every inference variable recorded in `typed`'s tables by what it was
// solved to. Runs once the module's bodies are walked : no variable outlives the
// typecheck.
zonk_module_tables :: fn(typed: TypedProgram) -> void {
    if !typed.infer_leak_possible {
        return
    }
    typed.infer_leak_possible = false
    solutions :: typed.infer_solutions
    zonk_table(typed.expr_types, solutions)
    zonk_table(typed.ufcs_receiver_types, solutions)
    zonk_table(typed.into_coercions, solutions)
    zonk_table(typed.local_types, solutions)
    zonk_table(typed.param_types, solutions)
    zonk_table(typed.type_expr_types, solutions)
    for callee in typed.call_sites.calls.values() {
        if callee !is DirectFn {
            continue
        }
        bindings :: callee.bindings ?? continue
        zonk_table(bindings, solutions)
    }
}

zonk_table :: fn<K: Hash & Equals>(
    table: MutableMap<K, Type>, solutions: MutableMap<i32, Type>,
) -> void {
    stale: K[]: []
    for [k, t] in table {
        if type_contains_infer_var(t) {
            stale.push(k)
        }
    }
    for k in stale {
        t :: table[k] ?? continue
        table[k] = zonk(t, solutions)
    }
}
