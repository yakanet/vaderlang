// vader/front/typecheck/decorator_use: the checks of a decorator where it is
// written.
//
// `@Route(.Get, "/users/{id}")` above a function names a decorator declaration
// (`decorator_decl.vader`), declared for some places, repeatable or not. Its
// arguments are those of a call whose parameters are the fields, in order, a field
// with a default being optional. A decorator of the compiler is declared by
// `std/core` and checked here the same way, but read as written and never
// evaluated: each argument is a literal, and a field only it takes (a
// `Condition`, a `CLibrary`) is left to the pass that reads it.

module "vader/front/typecheck"

import "std/collections"
import "std/iter"
import "std/string"
AST :: import "toolchain/ast"
import "toolchain/diagnostics"
import "toolchain/parser"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/resolver"

/// Check every decorator written on `decls`, at each of their places
/// (`AST.decorator_sites`) and on the members of their traits and impls.
///
/// @param decls  the declarations of a module.
/// @param typed  the module's typed program, the struct tables of the project
///               shared.
/// @param diags  where T3141, T3142, T3143 and the argument errors go.
export check_decorator_uses :: fn(
    decls: AST.Decl[], typed: TypedProgram, diags: Diagnostic[],
) -> void {
    check_decorators_at(typed.resolved.module_decorators, "Module", typed, diags)
    for decl in decls {
        check_sites(decl, AST.place_of(decl), typed, diags)
        for m in AST.members_of(decl) {
            check_sites(m, AST.member_place(decl), typed, diags)
        }
    }
}

check_sites :: fn(
    decl: AST.Decl, place: string, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    for site in AST.decorator_sites(decl, place) {
        check_decorators_at(site.decorators, site.place, typed, diags)
    }
}

// The decorators of one declaration, written at `place`.
check_decorators_at :: fn(
    decs: AST.Decorator[], place: string, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    if decs.len() == 0 {
        return
    }
    written: i32[]: []
    for d in decs {
        sym :: decorator_symbol(d, typed, diags) else continue
        declaration :: typed.struct_decls[sym.id]
        if !sym.is_decorator || declaration == null {
            diags.push(typecheck_error(.NotADecorator, d.name_span,
                "`${sym.name}` is a ${sym.kind.label}"))
            continue
        }
        check_place(d, declaration, place, diags)
        if sym.id in written && !is_repeatable(declaration) {
            diags.push(typecheck_error(.DecoratorRepeated, d.name_span,
                "`@${d.name}` again on this declaration"))
        }
        written.push(sym.id)
        check_decorator_arguments(d, sym, typed, diags)
    }
}

// The declaration `d` names, followed through its import ; null when the name is
// unresolved, which the resolver or the namespace lookup reports, and for a
// decorator of the compiler while `std/core` itself is checked.
decorator_symbol :: fn(
    d: AST.Decorator, typed: TypedProgram, diags: Diagnostic[],
) -> Symbol | null {
    if is_compiler_decorator(d) {
        return typed.compiler_decorator_symbols[d.name]
    }
    qualifier :: d.qualifier
    if qualifier != null {
        member :: AST.FieldExpr {
            .span = d.span,
            .target = qualifier,
            .field = d.name,
            .field_span = d.name_span,
            .is_numeric = false,
        }
        return namespace_member_declaration(member, typed.resolved, diags)
    }
    sym :: typed.resolved.idents[d.name_span.hash()] else return null
    return declared_symbol(sym, typed)
}

/// The places `declaration` names in its parentheses, as `DecoratorTarget`
/// variants: `.Function` and `DecoratorTarget.Function` alike.
///
/// @param declaration  a decorator declaration.
/// @return             the variant names ; none means anywhere.
export declared_places :: fn(declaration: AST.StructDecl) -> string[] {
    out: string[]: []
    for a in declaration.decorator_args else [] {
        place :: place_name(a.value)
        if a.name == null && place != "" {
            out.push(place)
        }
    }
    return out
}

check_place :: fn(
    d: AST.Decorator, declaration: AST.StructDecl, place: string, diags: Diagnostic[],
) -> void {
    places :: declared_places(declaration)
    if places.len() == 0 || place in places {
        return
    }
    allowed :: either_of(places.map(place_phrase).collect())
    diags.push(typecheck_error(.DecoratorMisplaced, d.name_span,
        "`@${d.name}` applies to ${allowed}, not to ${place_phrase(place)}"))
}

// The `DecoratorTarget` variant `place`, in the words of a diagnostic.
place_phrase :: fn(place: string) -> string = match place {
    "Function"       -> "a top-level function"
    "TraitMember"    -> "a member of a trait"
    "ImplMember"     -> "a member of an `implements` block"
    "Struct"         -> "a struct"
    "Enum"           -> "an enum"
    "Trait"          -> "a trait"
    "Implementation" -> "an `implements` block"
    "Constant"       -> "a constant"
    "Alias"          -> "a type alias"
    "Import"         -> "an import"
    "Field"          -> "a struct field"
    "Variant"        -> "an enum variant"
    "Parameter"      -> "a function parameter"
    "Module"         -> "a module"
    "Match"          -> "a `match`"
    "Expression"     -> "an expression"
    "Assertion"      -> "a line of its own among the declarations"
    _                -> "`.${place}`"
}

// `phrases` as one alternative: `a, b or c`.
either_of :: fn(phrases: string[]) -> string {
    if phrases.len() == 1 {
        return phrases[0]
    }
    last :: phrases.len() - 1
    return "${phrases[0..<last].join(", ")} or ${phrases[last]}"
}

/// Whether `declaration` writes `repeatable = true`: the decorator may be written
/// more than once above one declaration.
///
/// @param declaration  a decorator declaration.
export is_repeatable :: fn(declaration: AST.StructDecl) -> bool {
    for a in declaration.decorator_args else [] {
        value :: a.value
        if a.name == REPEATABLE_OPTION && value is AST.BoolLitExpr {
            return value.value
        }
    }
    return false
}

// The arguments of `d` against the fields of the decorator `sym`, as a call's
// against its parameters: positional ones in field order, then named ones, each
// field once, the fields without a default all given. A variadic field takes the
// positional arguments left, each typed as an element. The arguments bound to a
// field are recorded for the comptime pass (`decorator_uses`), except those of a
// decorator of the compiler, which nothing evaluates.
check_decorator_arguments :: fn(
    d: AST.Decorator, sym: Symbol, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    fields :: typed.struct_fields[sym.id] else return
    compiler :: is_compiler_decorator(d)
    // Most compiler decorators are written bare: only a field it needs to be
    // given is left to report.
    if compiler && d.args.is_empty() {
        report_missing_fields(d, fields, Map<string, AST.Expr> {}, diags)
        return
    }
    order: string[]: []
    variadic: VariadicArguments | null = null
    element: Type | null = null
    for [name, field] in fields {
        if field.decl.variadic {
            variadic = VariadicArguments { .field = name, .type = field.ty, .elements = [] }
            element = argument_type(field)
        } else {
            order.push(name)
        }
    }
    bound :: Map<string, AST.Expr> {}
    next_position := 0
    seen_named := false
    for a in d.args {
        left_over :: a.name == null && !seen_named && next_position >= order.len()
        if left_over && variadic != null {
            check_argument(d, compiler, a.value, element, typed, diags)
            variadic.elements.push(a.value)
            continue
        }
        target: string | null = null
        name :: a.name
        if name == null {
            if seen_named {
                diags.push(typecheck_error(.WrongArgCount, a.span,
                    "positional argument after a named argument"))
            } else if next_position >= order.len() {
                diags.push(typecheck_error(.WrongArgCount, a.span,
                    "`@${d.name}` has ${count_of_fields(order.len())}"))
            } else {
                target = order[next_position]
            }
            next_position += 1
        } else {
            seen_named = true
            if name !in fields {
                diags.push(typecheck_error(.UnknownNamedArg, a.span,
                    "`@${d.name}` has no field `${name}`"))
            } else if name in bound {
                diags.push(typecheck_error(.ArgumentGivenTwice, a.span,
                    "`${name}` is given already"))
            } else {
                target = name
            }
        }
        field :: if target == null { null } else { fields[target] }
        expected :: if field == null { null } else { field.ty }
        check_argument(d, compiler, a.value, expected, typed, diags)
        if target != null {
            bound[target] = a.value
        }
    }
    report_missing_fields(d, fields, bound, diags)
    // Given whole by name, the variadic field takes no positional argument.
    if variadic != null && variadic.field in bound {
        if variadic.elements.len() > 0 {
            diags.push(typecheck_error(.ArgumentGivenTwice, variadic.elements[0].span,
                "`${variadic.field}` is given already"))
        }
        variadic = null
    }
    if compiler {
        return
    }
    typed.decorator_uses[d.id] = DecoratorUse {
        .written = d,
        .symbol = sym,
        .arguments = bound,
        .variadic = variadic,
    }
}

// Each field of the decorator `d` with no default, not variadic, that `bound`
// gives nothing.
report_missing_fields :: fn(
    d: AST.Decorator,
    fields: Map<string, StructFieldInfo>,
    bound: Map<string, AST.Expr>,
    diags: Diagnostic[],
) -> void {
    for [name, field] in fields {
        if field.decl.default == null && !field.decl.variadic && name !in bound {
            diags.push(typecheck_error(.MissingRequiredArg, d.span,
                "`@${d.name}` needs `${name}`"))
        }
    }
}

// Type the argument `value` of `d` against `expected`, the type of the field it
// is bound to, null when it is bound to none. A field only the compiler's
// decorators take is read where it means something (`guard.vader`,
// `check_extern_library`) ; any other argument of one (`compiler`) is a literal.
check_argument :: fn(
    d: AST.Decorator,
    compiler: bool,
    value: AST.Expr,
    expected: Type | null,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    if expected != null && is_compiler_field_type(expected) {
        return
    }
    check_decorator_value(value, expected, typed, diags)
    if expected != null && compiler && !is_literal_argument(value) {
        diags.push(typecheck_error(.CompilerDecoratorNotLiteral, value.span,
            "write a string without interpolation, `.Variant`, a number or a boolean"))
    }
}

// Whether `value` is written as a literal: a string without interpolation, a
// number, a boolean, a character, or an enum variant (`.Linux`, `Os.Linux`): a
// field of a plain name, which the typing has checked names a variant.
is_literal_argument :: fn(value: AST.Expr) -> bool {
    if AST.string_literal_text(value) != null {
        return true
    }
    if value is AST.FieldExpr {
        return value.target is AST.IdentExpr
    }
    return value is AST.IntLitExpr | AST.FloatLitExpr | AST.BoolLitExpr | AST.CharLitExpr
        | AST.DotVariantExpr
}

// `count` fields, in words: `no field`, `one field`, `3 fields`.
count_of_fields :: fn(count: i64) -> string = match count {
    0 -> "no field"
    1 -> "one field"
    _ -> "${count} fields"
}

/// The type an argument bound to `field` takes: an element of its array for a
/// variadic field, else the field's own type.
///
/// @param field  a field of a decorator.
export argument_type :: fn(field: StructFieldInfo) -> Type {
    if !field.decl.variadic {
        return field.ty
    }
    backing :: array_backing(field.ty) else return field.ty
    return backing.element
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_either_of_joins_the_last_phrase_with_or :: fn() -> void {
    assert_eq(either_of(["a constant"]), "a constant")
    assert_eq(either_of(["a struct", "an enum", "a trait"]), "a struct, an enum or a trait")
}
