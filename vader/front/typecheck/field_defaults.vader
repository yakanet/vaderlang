// vader/front/typecheck/field_defaults: the defaults a struct literal fills in.
//
// A literal that leaves a defaulted field out takes the default's value, and the
// struct literals inside that default leave fields out in turn : the lowerer fills
// them all in, at every literal. So a const typed through a literal reads what those
// defaults read (T3099 when that is the const itself), and defaults that fill one
// another in would be filled in without end (T3100). Only the literals `value_reads`
// reaches are followed : one under an `if`, a `match` or a lambda is not.

module "vader/front/typecheck"

import "std/collections"
import "std/string"
import "toolchain/span"
import "vader/support/diagnostics"
import "vader/core/symbol"
import "vader/core/types"
AST :: import "toolchain/ast"
import "vader/front/resolver"

// A walk over the defaults literals fill in.
DefaultFill :: struct {
    /// The defaults being filled in, outermost first.
    filling: FillingDefault[] = []
    /// The defaults filled in already, by their field's span hash.
    filled: Set<u64> = Set<u64> {}
    /// The consts the filled-in defaults name.
    consts: AST.ConstDecl[] = []
}

FillingDefault :: struct {
    key: u64
    /// The struct whose declaration writes the default.
    owner: Symbol
    field: string
    span: Span
}

// Settle the consts the defaults a literal (`span`) of the struct `struct_id` fills
// in read : a const being typed through the literal reads them: `D :: Q {}.n` with
// `Q :: struct { n: i32 = D }` is a cycle (T3099). Outside a const's value, nothing
// needs them before their turn.
settle_literal_defaults :: fn(
    struct_id: i32, provided: string[], span: Span, typed: TypedProgram,
) -> void {
    if typed.const_walk.typing.len() == 0 {
        return
    }
    fill :: DefaultFill {}
    fill_omitted_defaults(struct_id, provided, fill, typed)
    for cd in fill.consts {
        settle_decl_read(cd, span, typed)
    }
}

// T3100: defaults of `decl` that fill one another in, through the literals they hold.
// `fill` is shared by the module's structs, so a cycle is reported once, at the
// default that closes it.
reject_default_cycle :: fn(
    decl: AST.StructDecl, fill: DefaultFill, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    sym :: symbol_declared_at(typed.resolved, decl.name_span) ?? return
    closing :: fill_omitted_defaults(sym.id, [], fill, typed) ?? return
    detail :: cycle_detail(fill, closing)
    diags.push(typecheck_error(.FieldDefaultsFillEachOther, closing.span, detail))
    for d in fill.filling {
        fill.filled.add(d.key)
    }
    fill.filling.clear()
}

// "`A.b` fills in `B.a`, which fills in `A.b`": the chain from `closing`.
cycle_detail :: fn(fill: DefaultFill, closing: FillingDefault) -> string {
    labels: string[]: []
    for d in fill.filling {
        if labels.len() > 0 || d.key == closing.key {
            labels.push("`${d.owner.name}.${d.field}`")
        }
    }
    labels.push("`${closing.owner.name}.${closing.field}`")
    return "${labels[0]} fills in ${labels[1..<labels.len()].join(", which fills in ")}"
}

// Fill in the defaults a literal of the struct `struct_id` leaves out (every field
// not in `provided`) then those of the struct literals these defaults hold, depth first and
// each default once, collecting the consts they name into `fill`. Returns the default
// reached again while it is being filled in, `fill.filling` then ending with the
// chain from it ; null when the filling ends.
fill_omitted_defaults :: fn(
    struct_id: i32, provided: string[], fill: DefaultFill, typed: TypedProgram,
) -> FillingDefault | null {
    fields :: typed.struct_fields[struct_id] ?? return null
    for [name, field] in fields {
        if name in provided {
            continue
        }
        // A default written in another module is checked there, and cannot reach back
        // into this one, imports having no cycle ; its names resolve in that module.
        if field.owner.symbol.module != typed.resolved.path {
            continue
        }
        default :: field.decl.default ?? continue
        key :: field.decl.span.hash()
        if key in fill.filled {
            continue
        }
        current :: FillingDefault {
            .key = key,
            .owner = field.owner.symbol,
            .field = name,
            .span = default.span,
        }
        for d in fill.filling {
            if d.key == key {
                return current
            }
        }
        fill.filling.push(current)
        reads :: value_reads(default, typed)
        fill.consts.push_all(reads.consts)
        for lit in reads.literals {
            lit_struct :: literal_struct(lit, typed) ?? continue
            written :: written_fields(lit, lit_struct, typed) ?? continue
            closing :: fill_omitted_defaults(lit_struct.symbol.id, written, fill, typed)
            if closing != null {
                return closing
            }
        }
        fill.filling.remove_last()
        fill.filled.add(key)
    }
    return null
}

// The struct `lit` builds, when this module resolves its name.
literal_struct :: fn(lit: AST.StructLitExpr, typed: TypedProgram) -> StructType | null =
    struct_backing(type_from_expr(lit.type_name, typed.resolved, diag_sink()))

// The fields `lit`, a literal of `st`, writes or takes from a spread of a base ; null when
// a spread writes them all, or its source has no type yet.
written_fields :: fn(lit: AST.StructLitExpr, st: StructType, typed: TypedProgram) -> string[] | null {
    out: string[]: []
    for item in lit.items {
        if item is AST.StructLitSpread {
            got :: typed.expr_types[item.expr.id] ?? return null
            decl :: typed.struct_decls[st.symbol.id]
            given :: spread_source_fields(item, got, st, decl, typed, diag_sink()) ?? return null
            out.push_all(given)
            continue
        }
        out.push(item.name)
    }
    return out
}

// Type each field's default against the field's declared type (`delta: i64 = -1`
// types the `-1` as `i64`, not `{integer}`) and check that it fits. Runs after
// the bodies, so a const declared below the struct has its type.
check_field_defaults :: fn(
    decl: AST.StructDecl, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    sym :: symbol_declared_at(typed.resolved, decl.name_span) ?? return
    // The defaults the declaration writes: each is checked once, where it is written.
    for f in decl.fields {
        dv :: f.default ?? continue
        field :: struct_field_info(typed, sym.id, f.name) ?? continue
        got :: check_expr(dv, field.ty, typed, diags)
        emit_mismatch_if(got, field.ty, f.span, dv, .TypeMismatch, typed, diags)
    }
}
