// vader/front/typecheck/context: shared context threaded through every typecheck pass.
//
// `FnContext` is pushed by `check_fn_body` and drives `return` checking plus
// `Self` substitution inside method bodies.
//
// Per-module side-tables live on `TypedProgram` directly (see `typed_ast.vader`)
// rather than being duplicated here: a single representation, no during/after
// split. Project-level shared state likewise: the symbol factory and the resolved
// `std/core` symbols are reached through the `TypedProgram` / `LowerProjectCtx`
// each pass already carries.

module "vader/front/typecheck"

import "vader/core/types"

/// Per-fn-body state: pushed by `check_fn_body`, consumed by `ReturnStmt`
/// checking and `Self` substitution inside method bodies.
export FnContext :: struct {
    /// Type the body must return. `void` for fns without a `-> T` clause.
    return_type: Type
    /// Loop depth: `break` / `continue` legal only when > 0.
    loop_depth: i32
    /// AST node id of the fn whose body is being checked. Lets deep
    /// expression checks (e.g. bounded trait-method dispatch in
    /// `field.vader`) attribute a finding back to the enclosing fn via
    /// `fn_needs_concrete_instances`. Keyed by id (not name) so overloaded fns
    /// don't collide. A lambda carries its enclosing fn's ; `0` for a lambda
    /// typed outside any fn body (in a module-level const, say).
    fn_id: i64 = 0
    /// True when the enclosing fn is a generator (it `yield`s). Drives `yield`
    /// legality, forbids `return <value>`, and suppresses the
    /// missing-return obligation on the `-> Iterator<T>` body. False for
    /// lambdas, `defer` bodies and synthetic contexts, so a `yield` in one
    /// trips T3059.
    is_generator: bool = false
    /// Element type `T` of the generator's `-> Iterator<T>` return:
    /// `yield e` must coerce to it. Null when not a generator (or the
    /// return type wasn't a valid `Iterator<T>`).
    yield_type: Type | null = null
    /// True when the enclosing fn is an async coroutine (it `await`s). Drives
    /// `await` legality. False for lambdas, `defer` bodies and synthetic
    /// contexts, so an `await` in one trips T3064.
    is_async: bool = false
    /// True in a `defer` body, where `return` is refused (T3106): the body runs
    /// while its block is left, once what the block returns is decided. A lambda
    /// written in it has its own context and returns as anywhere.
    in_defer: bool = false
    /// Union of every value `return`'s type seen in this body: accumulated by
    /// `check_return`. A block-body lambda that ends in `return` types its block
    /// as `never` (it diverges) ; this recovers the lambda's real return type
    /// from its returns, so a type param sitting inside a `U | Error` return
    /// position stays inferable (else it drops, unresolved at emit). Null until the first
    /// value `return`.
    inferred_return: Type | null = null
    /// The contract of the `@returns` fn whose body this is (`hold_to_contract`) :
    /// each value it returns is held to it. A lambda in it has its own context,
    /// and no contract.
    guard: GuardContract | null = null
    /// The contract of the `@ensures` fn whose body this is (`hold_to_ensures`) :
    /// each return and the end of the body are held to it.
    ensures: GuardContract | null = null
}

new_fn_context :: fn(return_type: Type) -> FnContext {
    return FnContext {
        .return_type = return_type,
        .loop_depth = 0,
    }
}

// Keep the generic instances of the fn whose body is being checked concrete rather
// than erased (`T` → `Any`), see `TypedProgram.fn_needs_concrete_instances`. Each
// call site says why its construct needs the instance's real types.
keep_instances_concrete :: fn(typed: TypedProgram) -> void {
    fctx :: typed.current_fn_ctx ?? return
    if fctx.fn_id != 0 {
        typed.fn_needs_concrete_instances[fctx.fn_id] = true
    }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_new_fn_context_holds_return_type :: fn() -> void {
    ctx :: new_fn_context(TY_I32)
    assert(equals_type(ctx.return_type, TY_I32), "the return type is i32")
    assert_eq(ctx.loop_depth, 0)
}
