// vader/front/typecheck/expr_lambda — LambdaExpr inference (`(x) -> x + 1`).
//
// Params take their annotated type ; if unannotated, the bidirectional
// `expected` fn-type provides the slot type. The body is checked
// against the annotated / inferred return type. Returns `mk_fn(params,
// body)`.
//
// MVP : no Self threading from outer fn ; no implicit closure-capture
// type inference beyond what each ident resolves to. T3024 when a
// param can't be inferred.

module "vader/front/typecheck"

AST :: import "toolchain/ast"
import "vader/core/types"
import "vader/front/resolver"
import "vader/support/diagnostics"

/// What checking a body that runs later than it is written sets aside, put back
/// by `leave_later_body`.
LaterBody :: struct {
    loops:  EnclosingLoop[]
    fn_ctx: FnContext | null
    aside:  NarrowingsAside
}

/// Enter a body that runs later than it is written (a lambda's, a `defer`'s), as
/// a fn of its own: no enclosing loop is one its jumps can reach, `ctx` is its
/// context, and it sees only the narrowings nothing run in between can falsify.
///
/// @param typed     the program's typing tables.
/// @param ctx       the body's own context.
/// @param deferred  whether the body is a `defer`'s (`set_narrowings_aside`).
/// @return          what to hand `leave_later_body` once the body is checked.
enter_later_body :: fn(typed: TypedProgram, ctx: FnContext | null, deferred: bool) -> LaterBody {
    later :: LaterBody {
        .loops  = typed.loop_stack,
        .fn_ctx = typed.current_fn_ctx,
        .aside  = set_narrowings_aside(typed, deferred),
    }
    typed.loop_stack = []
    typed.current_fn_ctx = ctx
    return later
}

/// Leave the body `enter_later_body` entered.
///
/// @param typed  the program's typing tables.
/// @param later  what `enter_later_body` returned.
leave_later_body :: fn(typed: TypedProgram, later: LaterBody) -> void {
    typed.loop_stack = later.loops
    typed.current_fn_ctx = later.fn_ctx
    bring_narrowings_back(typed, later.aside)
}

/// Type-check a `LambdaExpr`. Returns `fn(params...) -> body`.
infer_lambda :: fn(
    e: AST.LambdaExpr, expected: Type | null,
    typed: TypedProgram, diags: Diagnostic[],
) -> Type {
    expected_fn: FnType | null = null
    match expected {
        is FnType -> { expected_fn = expected }
        _ -> {}
    }
    param_types: Type[]: []
    for i in 0..<e.params.len() {
        param_types.push(infer_param(e.params[i], i, expected_fn, typed, diags))
    }
    expected_ret :: pick_return(e.return_type, expected_fn, typed.resolved, diags)
    ctx_return :: pick_ctx_return(expected_ret)
    ctx :: new_fn_context(ctx_return, null)
    // A lambda is lowered inside each instance of its enclosing fn, so what keeps
    // those instances concrete from the lambda body is the enclosing fn's to keep.
    enclosing :: typed.current_fn_ctx
    if enclosing is FnContext {
        ctx.fn_id = enclosing.fn_id
    }
    // Mirror `check_fn_body`: push the lambda's ctx onto the global
    // stack so nested `if` / `match` arms (which `check_return` reaches
    // via the recursive `check_expr` path with `ctx=null`) validate
    // against the lambda's return type instead of the enclosing fn's.
    later :: enter_later_body(typed, ctx, false)
    body :: check_block(e.body, expected_ret, typed, diags, ctx)
    leave_later_body(typed, later)
    // T3083 — the same obligation `check_fn_body` puts on a named fn. A body with
    // no trailing expression that does not diverge reaches its closing brace with
    // nothing to hand back, and the slot was promised a value. Unchecked, such a
    // lambda compiled and trapped at RUN time (`unreachable return`), which is
    // worse than the named case it mirrors.
    //
    // Only when a type was actually promised: `expected_ret` is null exactly when
    // nothing annotates or expects one, and the return is then inferred from the
    // body — a body that falls through simply infers `void`.
    if e.body.trailing is null && body !is NeverType {
        // No expectation reads as "promises nothing", which the void gate below
        // already rejects — so the two cases need only one test.
        promised :: expected_ret ?? TY_VOID
        if !is_void(promised) && promised !is UnresolvedType {
            diags.push(
                typecheck_error(
                    .BodyFallsOffEnd, e.span,
                    "this lambda promises ${display_type(promised)}",
                ),
            )
        }
    }
    // The trailing value is the lambda's return, held to the type the slot promised,
    // as a named fn's is. A promise still naming a type parameter, or none, is what
    // the body infers.
    trailing :: e.body.trailing
    if trailing != null && expected_ret != null && is_concrete_promise(expected_ret) {
        emit_return_mismatch_if(body, expected_ret, trailing.span, trailing, typed, diags)
    }
    ret :: pick_final_return(expected_ret, body, ctx)
    return mk_fn(param_types, ret)
}

is_concrete_promise :: fn(t: Type) -> bool =
    !is_void(t) && !contains_unresolved(t) && !type_contains_type_param(t)

infer_param :: fn(
    p: AST.FnParam, idx: i64, expected_fn: FnType | null,
    typed: TypedProgram, diags: Diagnostic[],
) -> Type {
    if p.ty !is null {
        t :: type_from_expr(p.ty, typed.resolved, diags)
        typed.param_types[p.span.hash()] = t
        return t
    }
    match expected_fn {
        is FnType -> {
            if idx < expected_fn.params.len() {
                t :: expected_fn.params[idx]
                typed.param_types[p.span.hash()] = t
                return t
            }
        }
        _ -> {}
    }
    diags.push(typecheck_error(.FnSignatureMustBeAnnotated, p.span,
        "lambda parameter `${p.name}` cannot be inferred"))
    typed.param_types[p.span.hash()] = TY_UNRESOLVED
    return TY_UNRESOLVED
}

pick_return :: fn(
    annot: AST.TypeExpr | null, expected_fn: FnType | null,
    resolved: ResolvedModule, diags: Diagnostic[],
) -> Type | null {
    if annot !is null {
        return type_from_expr(annot, resolved, diags)
    }
    if expected_fn is FnType { return expected_fn.return_type }
    return null
}

pick_ctx_return :: fn(expected: Type | null) -> Type {
    if expected == null { return TY_UNRESOLVED }
    return expected
}

pick_final_return :: fn(expected: Type | null, body: Type, ctx: FnContext) -> Type {
    // A block-body lambda that ends in `return` types its block as `never` (it
    // diverges), which would erase a `U | Error`-in-return type param. Recover
    // the real return type from the union of the lambda's `return` values
    // (`ctx.inferred_return`) when the block itself produced no fall-through type.
    effective_body :: if body is NeverType && ctx.inferred_return != null {
        ctx.inferred_return
    } else {
        body
    }
    if expected == null { return default_if_free(effective_body) }
    // Expected might still carry unbound TypeParams (`U`,
    // `U[]`, `Box<U>`, …) or a Free* leftover from a
    // tentative unify. Fall back to the body's defaulted type
    // in those cases so the lambda's signature reports the
    // concrete shape its body actually produces.
    if type_contains_type_param(expected) { return default_if_free(effective_body) }
    if expected is FreeIntType   { return default_if_free(effective_body) }
    if expected is FreeFloatType { return default_if_free(effective_body) }
    return expected
}
