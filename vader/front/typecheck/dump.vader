// vader/front/typecheck/dump — text formatter for the typecheck stage.
//
// Output is stable so the snapshot suite can diff it against the recorded
// `# Typecheck` fixtures.
//
// Format :
//
//     # Typecheck
//
//     ## <displayPath>
//       <DeclKind:pad14> <name:pad20> :: <type>
//       ...
//       expr <loc:pad8>  <ExprKind:pad14> :: <type>
//       ...
//
// The `expr` lines are sorted lexicographically after formatting so the
// dump is stable regardless of the underlying side-table iteration order.
// Literal variants (Int/Float/Bool/Null/Char) and BlockExpr are skipped.
//
// The `callees` section prints `vader dump --stage=callees`: every call site the
// typecheck recorded (`call_sites.vader`), with its role and what it invokes.

module "vader/front/typecheck"

import "std/path"
import "std/sort"
import "std/string"
import "std/string_builder"
import "toolchain/span"
import "vader/core/symbol"
import "vader/front/resolver"
import "vader/core/types"

/// Render a typed module and the non-entry typed modules `others`. Each module
/// renders its own `## <path>` section with its own decls + exprs, sorted by
/// module path so the entry doesn't always come first. Only modules in `scope`
/// are rendered (the entry's subtree by default, `--module` to widen), so
/// dependencies stay out. The header omits the `# Typecheck` banner when
/// `with_banner = false`, so multi-module callers can compose without
/// re-emitting it.
export dump_program_with_others :: fn(
    typed: TypedProgram,
    with_banner: bool,
    others: TypedProgram[],
    scope: string[],
) -> string {
    sb :: StringBuilder {}
    if with_banner {
        sb.append("# Typecheck")
    }
    for mod in modules_in_scope(typed, others, scope) {
        sb.append("\n\n## ")
        sb.append(mod.resolved.path)
        for line in build_decl_lines(mod) {
            sb.append("\n")
            sb.append(line)
        }
        for line in build_expr_lines(mod) {
            sb.append("\n")
            sb.append(line)
        }
    }
    return sb.to_string()
}

// The modules of the project `scope` selects (`module_in_scope`), by path.
modules_in_scope :: fn(
    typed: TypedProgram,
    others: TypedProgram[],
    scope: string[],
) -> TypedProgram[] {
    modules :: [typed]
    modules.push_all(others)
    selected: TypedProgram[]: []
    for m in sort(modules, (a, b) -> a.resolved.path < b.resolved.path) {
        if module_in_scope(m.resolved.display_path, scope) {
            selected.push(m)
        }
    }
    return selected
}

build_decl_lines :: fn(typed: TypedProgram) -> string[] {
    // Sort by symbol name (case-insensitive) rather than by the
    // formatted line —
    // otherwise `S`tructDecl always wins over `T`raitDecl regardless
    // of the actual name ordering. Fn symbols expand into every
    // overload Symbol from `fn_overloads` so the dump lists each
    // overload separately ; for non-fn kinds the primary entry is
    // emitted directly.
    syms :: sort_syms_by_name(typed.resolved.symbols)
    out: string[]: []
    for s in syms {
        kind_str :: ast_decl_kind(s)
        if kind_str == "" {
            continue
        }
        if kind_str == "FnDecl" {
            bucket :: typed.resolved.fn_overloads[s.name]
            match bucket {
                is null -> {
                    out.push(
                        "  ${kind_str.pad_end(14, ' ')} ${s.name.pad_end(20, ' ')} :: ${lookup_decl_type(typed, s)}",
                    )
                }
                _ -> {
                    for ov in bucket {
                        out.push(
                            "  ${kind_str.pad_end(14, ' ')} ${ov.name.pad_end(20, ' ')} :: ${lookup_decl_type(typed, ov)}",
                        )
                    }
                }
            }
            continue
        }
        type_str :: lookup_decl_type(typed, s)
        out.push("  ${kind_str.pad_end(14, ' ')} ${s.name.pad_end(20, ' ')} :: ${type_str}")
    }
    return out
}

sort_syms_by_name :: fn(syms: Symbol[]) -> Symbol[] {
    return sort(syms, (a: Symbol, b: Symbol) -> compare_ascending_ci(a.name, b.name))
}

build_expr_lines :: fn(typed: TypedProgram) -> string[] {
    out: string[]: []
    for [id, kind] in typed.expr_kinds {
        if is_skipped_kind(kind) {
            continue
        }
        ty_str :: lookup_expr_type_str(typed, id)
        loc :: start_loc_for_id(typed, id)
        out.push("  expr ${loc.pad_end(8, ' ')} ${kind.pad_end(14, ' ')} :: ${ty_str}")
    }
    // Byte-wise sort : case-insensitive would put `i32` before `Inner` ;
    // byte order keeps `Inner` first because `I` (0x49) < `i` (0x69).
    return sort(out, (a: string, b: string) -> compare_ascending(a, b))
}

// Look up the node's span via `node_spans` and render its start as
// `line:col`. Materialised cloned bodies have trait-source spans —
// the dump renders them at the trait method's source position.
start_loc_for_id :: fn(typed: TypedProgram, id: i64) -> string {
    s :: typed.node_spans[id] ?? return "undefined:undefined"
    return "${s.start.line}:${s.start.column}"
}

lookup_expr_type_str :: fn(typed: TypedProgram, id: i64) -> string {
    ty :: typed.expr_types[id] ?? return "?"
    return display_type(ty)
}

SKIPPED_KINDS: string[]: [
    "IntLitExpr",
    "FloatLitExpr",
    "BoolLitExpr",
    "NullLitExpr",
    "CharLitExpr",
    "BlockExpr",
]

is_skipped_kind :: fn(kind: string) -> bool {
    for s in SKIPPED_KINDS {
        if s == kind {
            return true
        }
    }
    return false
}

/// Map a `SymbolKind` to the matching AST `*Decl` kind name used by the
/// dump (`FnDecl`, `StructDecl`, `EnumDecl`, …). Returns `""` for
/// kinds the dump skips (import bindings, locals, params, …).
// @partial: only declaring kinds map to a *Decl name; other SymbolKinds are dump-skipped → "".
ast_decl_kind :: fn(s: Symbol) -> string = @partial match s.kind {
    .Fn -> "FnDecl"
    .Struct -> "StructDecl"
    .Enum -> "EnumDecl"
    .Trait -> "TraitDecl"
    .TypeAlias -> "TypeAliasDecl"
    .Const -> "ConstDecl"
    _ -> ""
}

lookup_decl_type :: fn(typed: TypedProgram, s: Symbol) -> string {
    ty :: typed.decl_types[s.id] ?? return "?"
    return display_type(ty)
}

// ---- callees ----------------------------------------------------------------

/// The calls of the modules of `scope`, module by module: `vader dump
/// --stage=callees`.
///
/// @param typed   the entry module.
/// @param others  every other module of the project.
/// @param scope   the modules to render (`module_in_scope`).
export dump_call_sites_project :: fn(
    typed: TypedProgram,
    others: TypedProgram[],
    scope: string[],
) -> string {
    sb :: StringBuilder {}
    sb.append("# callees\n")
    for m in modules_in_scope(typed, others, scope) {
        sb.append("\n## ${m.resolved.display_path}\n")
        sb.append(dump_call_sites(m))
    }
    return sb.to_string()
}

// Every site of `typed`, one line each in source order, then the count of sites
// the record could not settle. A site's position is its node's span, filed when
// the typecheck ran with `dump_types`.
dump_call_sites :: fn(typed: TypedProgram) -> string {
    sites: DumpedSite[]: []
    for role in all_roles() {
        for [id, callee] in sites_of(typed.call_sites, role) {
            span :: typed.node_spans[id] ?? empty_span()
            sites.push(DumpedSite { .span = span, .role = role, .callee = callee })
        }
    }
    sb :: StringBuilder {}
    unsettled := 0
    for site in sort(sites, comes_first) {
        if site.callee is UnsettledCallee {
            unsettled += 1
        }
        position :: site_position(site.span)
        sb.append("  ${position} ${role_label(site.role)} ${callee_label(site.callee)}\n")
    }
    sb.append("  sites: ${sites.len()}, unsettled: ${unsettled}\n")
    return sb.to_string()
}

DumpedSite :: struct {
    span: Span
    role: CallRole
    callee: Callee
}

// Source order ; among nodes that start together the inner one, and at one node the
// roles in their declared order.
comes_first :: fn(a: DumpedSite, b: DumpedSite) -> bool {
    if a.span.start.offset != b.span.start.offset {
        return a.span.start.offset < b.span.start.offset
    }
    if a.span.end.offset != b.span.end.offset {
        return a.span.end.offset < b.span.end.offset
    }
    return i64(a.role) < i64(b.role)
}

// A call inside a materialised default method sits at a synthetic span, the same
// for every run but meaningless to a reader: it shows as `clone`.
site_position :: fn(span: Span) -> string {
    if span.start.file.starts_with(CLONE_FILE_PREFIX) {
        return "clone"
    }
    return "${to_path(span.start.file).filename()}:${span.start.line}:${span.start.column}"
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "toolchain/ast"
import "vader/front/parser"
import "vader/support/diagnostics"

// A single typed module, always in scope (its own display path).
dump_typed_program :: fn(typed: TypedProgram, with_banner: bool) -> string {
    return dump_program_with_others(typed, with_banner, [], [typed.resolved.display_path])
}

dump_test :: fn(src: string) -> string {
    parsed :: parse_source(src, "t.vader")
    factory :: SymbolFactory {}
    rm :: resolve_module(parsed.program, "t", factory)
    diags: Diagnostic[]: []
    result :: check_module(parsed.program, rm, diags)
    return dump_typed_program(result.typed, true)
}

@test
test_dump_renders_fn_decl :: fn() -> void {
    // Expected string excludes the trailing newline — `println` adds it
    // at the CLI boundary.
    expected :: "# Typecheck\n\n## t\n  FnDecl         add                  :: fn(f64, f64) -> f64"
    assert_eq(dump_test("add :: fn(a: f64, b: f64) -> f64 { return a + b }"), expected)
}

@test
test_dump_sorts_decls_alphabetically :: fn() -> void {
    src :: """
zebra :: fn() -> f64 { return 0.0 }
apple :: fn() -> f64 { return 0.0 }
"""
    expected :: "# Typecheck\n\n## t\n  FnDecl         apple                :: fn() -> f64\n  FnDecl         zebra                :: fn() -> f64"
    assert_eq(dump_test(src), expected)
}

@test
test_dump_renders_struct_decl :: fn() -> void {
    src :: """
Point :: struct {
    x: i32
}
"""
    expected :: "# Typecheck\n\n## t\n  StructDecl     Point                :: Point"
    assert_eq(dump_test(src), expected)
}

@test
test_dump_renders_generic_struct :: fn() -> void {
    src :: """
Wrap :: struct<T> {
    value: T
}
"""
    expected :: "# Typecheck\n\n## t\n  StructDecl     Wrap                 :: Wrap<T>"
    assert_eq(dump_test(src), expected)
}
