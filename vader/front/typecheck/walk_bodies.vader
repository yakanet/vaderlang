// vader/front/typecheck/walk_bodies: the walk over every body of a module, impls included.

module "vader/front/typecheck"

import "std/collections"
import "std/iter"
AST :: import "toolchain/ast"
import "toolchain/diagnostics"
import "toolchain/span"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/resolver"

// ---- return inference -----------------------------------------------------

// An expression-bodied fn with no explicit return annotation: the only fn
// shape whose return type is settled by body inference (`patch_fn_return_type`,
// stmt.vader).
needs_return_inference :: fn(fd: AST.FnDecl) = fd.is_expression_bodied && fd.return_type is null

// ---- inferred export returns ----------------------------------------------

// An exported function whose expression body decides its return type: refused,
// since its type is what other modules read, and it would follow every edit of
// the body. Allocates nothing, unlike the error it gates, which runs on a hit only.
//
// `visibility` is the function's own, or for a trait's default, the trait's.
leaves_export_return_to_inference :: fn(fd: AST.FnDecl, visibility: AST.Visibility) -> bool =
    visibility == .Public && needs_return_inference(fd) && !fd.comptime_synthetic

// Refuse `fd`, naming the type to write. A `never` return has no spelling: a
// function that never returns says so with `@no_return`, which fixes its type. An
// unresolved return already draws T3034.
reject_inferred_export_return :: fn(
    fd: AST.FnDecl,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    fn_type :: declared_fn_type(typed, fd)
    if fn_type !is FnType {
        return
    }
    ret :: fn_type.return_type
    marked :: AST.has_compiler_decorator(fd.decorators, .NoReturn)
    if ret is UnresolvedType || ret is NeverType && marked {
        return
    }
    diags.push(typecheck_error(.ExportReturnLeftToInference, fd.name_span, return_to_write(ret)))
}

// What an export whose body gives `ret` writes instead.
return_to_write :: fn(ret: Type) -> string {
    if ret is NeverType {
        return "it never returns: mark it `@no_return`"
    }
    return "write `-> ${display_type(ret)}`"
}

// ---- body walk ------------------------------------------------------------

/// Walk every fn / const body in `decls` and type-check it. Skips
/// extern / abstract decls (no body). For ConstDecls without an
/// annotation, types the value expression and back-fills the const's
/// declared type (post `default_if_free`) so `IdentExpr` lookups
/// against it return a concrete type. Ends with the free literals past
/// their default (`report_literals_past_default`).
walk_bodies :: fn(decls: AST.Decl[], typed: TypedProgram, diags: Diagnostic[]) -> void {
    // Pre-pass : the member declarations and the checks of every impl of the
    // module, before any fn body is walked, so a body that references an impl
    // member declared later in file order resolves. The impl tables are filled
    // before any walk (`register_project_impls`).
    for decl in decls.filter_is<AST.ImplDecl>() {
        declare_and_check_impl(decl, typed, diags)
    }
    // A const is typed at its turn below, or at a read before it (`const_walk`) ;
    // a function whose body gives its return, at its turn or at a call before it.
    open_const_walk(decls, typed, diags)
    typed.return_walk = ReturnWalk { .diags = diags }
    for decl in decls {
        match decl {
            is AST.FnDecl        -> {
                walk_fn_body(decl, typed, diags)
                if leaves_export_return_to_inference(decl, decl.visibility) {
                    reject_inferred_export_return(decl, typed, diags)
                }
            }
            is AST.ConstDecl     -> {
                settle_with_reads(decl, typed)
            }
            is AST.AssertDecl    -> {
                check_expr(decl.condition, null, typed, diags)
            }
            // Its field defaults are typed below, once every const has its type.
            is AST.StructDecl    -> {}
            is AST.ImplDecl      -> {
                // The member declarations and the checks ran in the pre-pass
                // (`declare_and_check_impl`) so forward references resolve ;
                // only the member bodies remain to walk here.
                typed.enclosing_impl = decl.span.hash()
                typed.enclosing_impl_params = impl_param_ids(decl, typed)
                for m in decl.members {
                    walk_fn_body(m, typed, diags)
                }
                check_inherited_tests(decl, typed, diags)
                typed.enclosing_impl = 0
                typed.enclosing_impl_params = Set<i32> {}
            }
            is AST.EnumDecl      -> { check_variant_data(decl, typed, diags) }
            is AST.TraitDecl     -> {
                walk_default_bodies(decl, typed, diags)
            }
            // Body-less decl kinds: nothing to walk. Listed explicitly (not
            // `_`) so a new Decl variant trips T3013 and forces a decision.
            is AST.TypeAliasDecl -> {}
            is AST.ImportDecl    -> {}
        }
    }
    for decl in decls.filter_is<AST.StructDecl>() {
        check_field_defaults(decl, typed, diags)
        check_decorator_decl(decl, typed, diags)
    }
    check_decorator_uses(decls, typed, diags)
    // Every default is typed first : the walk reads the type of a spread in any of them.
    fill :: DefaultFill {}
    for decl in decls {
        if decl is AST.StructDecl {
            reject_default_cycle(decl, fill, typed, diags)
        }
    }
    report_literals_past_default(typed, diags)
    for decl in decls.filter_is<AST.FnDecl>() {
        check_extern_library(decl, typed, diags)
    }
    settle_fn_references(typed, diags)
    zonk_module_tables(typed)
}

// The symbol ids of `decl`'s type parameters.
impl_param_ids :: fn(decl: AST.ImplDecl, typed: TypedProgram) -> Set<i32> {
    out :: Set<i32> {}
    for tp in impl_type_params_of(decl, typed.resolved) {
        out.add(tp.symbol.id)
    }
    return out
}

// Every array type shares the impls `T[] implements<T> ...` writes, and a concrete
// array (`i32[]`, `MonType[]`) adds its own, which win for it. An element built
// from a type parameter without being one (`T[][]`, `[T, i32][]`) would be a second
// generic impl on arrays, overlapping `T[]`.
is_refused_array_impl :: fn(t: Type) =
    t is ArrayType && t.element !is TypeParamType && type_contains_type_param(t)

// The parameters of `implements<...>` that `for_ty` does not mention (T3117). A
// use of the impl binds its parameters from the type it is used at, so nothing
// would bind those. None when `for_ty` did not resolve: that is reported already.
unbound_impl_params :: fn(
    decl: AST.ImplDecl,
    for_ty: Type,
    resolved: ResolvedModule,
) -> AST.TypeParam[] {
    unbound: AST.TypeParam[]: []
    if type_contains_unresolved(for_ty) {
        return unbound
    }
    mentioned :: type_params_in(for_ty)
    for tp in decl.type_params {
        sym :: resolved.idents[tp.span.hash()] else continue
        if !mentioned.any_match((m) -> m.id == sym.id) {
            unbound.push(tp)
        }
    }
    return unbound
}

// Declare the members of an impl block of this module and check it: the member
// parameter types, the impl diagnostics. Runs in `walk_bodies`' pre-pass so a
// forward reference from an earlier fn body resolves. The impl tables are not
// written here (`register_project_impls`), nor the member bodies walked (the main
// pass does).
declare_and_check_impl :: fn(
    id: AST.ImplDecl,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    for_ty :: type_from_expr(id.for_type, typed.resolved, diags)
    if is_refused_array_impl(for_ty) {
        diags.push(
            typecheck_error(
                .ArrayImplPartlyGeneric,
                id.for_type.span,
                "`${display_type(for_ty)}` (write the impl on `T[]` or on a concrete array)",
            ),
        )
        return
    }
    for tp in unbound_impl_params(id, for_ty, typed.resolved) {
        diags.push(
            typecheck_error(
                .UnboundImplParameter,
                tp.span,
                "`${tp.name}` is not in `${display_type(for_ty)}`",
            ),
        )
    }
    // Resolved again by `record_impl_members`, which reports what fails.
    trait_type :: impl_trait_instance(id, typed.resolved, []) else return
    trait_sym :: trait_type.symbol
    trait_key :: trait_key_of(trait_sym)
    if trait_key == core_trait_key(TRAIT_INTO) {
        if trait_type.args.len() == 1 {
            target_ty :: trait_type.args[0]
            if equals_type(for_ty, target_ty) {
                diags.push(
                    typecheck_error(
                        .IntoIdentityForbidden,
                        id.span,
                        "`${display_type(for_ty)} implements Into<${display_type(target_ty)}>`"
                            + ", but source and target must differ",
                    ),
                )
            }
        }
    }
    trait_decl :: typed.trait_decls[trait_sym.id]
    for m in id.members {
        if m.inherits != null {
            declare_inherited_member(m, trait_type, for_ty, typed)
            continue
        }
        declare_impl_method_for_trait(
            m,
            for_ty,
            lookup_trait_method(trait_decl, m.name),
            trait_type,
            typed,
            m.member_diags(diags),
        )
    }
    check_impl_members(id, trait_type, for_ty, typed, diags)
}

// The default bodies of `d`, each checked once in the trait, `Self` read as the
// trait's own type parameter (`trait_self_params`) : the body of a
// `fn<Self: Trait>`, valid for every impl the trait will have.
walk_default_bodies :: fn(
    d: AST.TraitDecl,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    if !d.members.any_match((m) -> m.body != null) {
        return
    }
    trait_sym :: symbol_declared_at(typed.resolved, d.name_span) else return
    self_sym :: typed.resolved.trait_self_params[trait_sym.id] else return
    typed.default_body_params = default_body_param_ids(d, self_sym, typed)
    for m in d.members {
        if m.body != null {
            walk_default_body(m, self_sym, typed, diags)
            if leaves_export_return_to_inference(m, d.visibility) {
                reject_inferred_export_return(m, typed, diags)
            }
        }
    }
    typed.default_body_params = Set<i32> {}
}

// The default `m` of a trait: declared for the trait's own `Self` (`self_sym`), its
// body walked with `default_body_params` set for the trait, the return it gives
// recorded. Once per walk : a call ahead of the trait's turn walks it then
// (`settle_default_return`), and declaring it again would drop what that walk typed.
walk_default_body :: fn(
    m: AST.FnDecl,
    self_sym: Symbol,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    if needs_return_inference(m) && m.id in typed.return_walk.walked {
        return
    }
    declare_impl_method_for_trait(m, TypeParamType { .symbol = self_sym }, m, null, typed, diags)
    walk_fn_body(m, typed, diags)
    record_default_return(m, self_sym, typed)
}

// The return a default body gives when its member leaves it out, for every reader
// of the trait (`trait_member_type`), in every module : with `Self` written back
// for the trait's own parameter `self_sym`, as a signature writes it.
record_default_return :: fn(m: AST.FnDecl, self_sym: Symbol, typed: TypedProgram) -> void {
    if !needs_return_inference(m) {
        return
    }
    checked :: declared_fn_type(typed, m)
    if checked !is FnType || checked.return_type is UnresolvedType {
        return
    }
    as_written :: Map<i32, Type> {}
    as_written[self_sym.id] = TY_SELF
    typed.impl_tables.default_returns[m.id] = substitute_map(checked.return_type, as_written)
}

// `Self` and the type parameters of `d`, which each impl that inherits a default
// body binds.
default_body_param_ids :: fn(
    d: AST.TraitDecl,
    self_sym: Symbol,
    typed: TypedProgram,
) -> Set<i32> {
    out :: Set<i32> {}
    out.add(self_sym.id)
    for t in declared_type_args(d.type_params, typed) else [] {
        if t is TypeParamType {
            out.add(t.symbol.id)
        }
    }
    return out
}

// An inherited member has its trait member's type, read in the trait's module at the
// impl's trait arguments, `Self` read as `for_ty` : its signature names what the
// trait's file imports, which the impl's file need not.
declare_inherited_member :: fn(
    m: AST.FnDecl,
    trait_type: TraitType,
    for_ty: Type,
    typed: TypedProgram,
) -> void {
    rest :: inherited_signature(m, trait_type, for_ty, typed) else return
    params: Type[]: []
    if receiver_count(m) > 0 {
        params.push(for_ty)
    }
    params.push_all(rest.params)
    // Its parameters are written nowhere : the signature alone holds their types.
    typed.impl_method_decl_types[m.id] = mk_fn(params, rest.return_type)
}

// The type of the member `m` inherits, its receiver dropped : the trait member's,
// at the impl's trait arguments, `Self` read as `for_ty`.
inherited_signature :: fn(
    m: AST.FnDecl,
    trait_type: TraitType,
    for_ty: Type,
    typed: TypedProgram,
) -> FnType | null {
    found :: try_trait_method(trait_type, m.name, typed, for_ty)
    if found is FnType {
        return found
    }
    return null
}

// Where a member of an impl reports its declaration. A member declared for the impl
// from its trait (`materialized`) reports nothing : its signature is the trait's,
// checked there.
member_diags :: fn(m: AST.FnDecl, diags: Diagnostic[]) -> Diagnostic[] {
    if m.materialized {
        return []
    }
    return diags
}

// T3087 at `impl_` for a type test of a default body it inherits that its instances
// cannot tell apart: the body was checked once in its trait, where the trait's
// parameters erase nothing (`default_body_params`), so its tests are read again
// with the types the impl binds them to, as the impl's own member would be.
check_inherited_tests :: fn(impl_: AST.ImplDecl, typed: TypedProgram, diags: Diagnostic[]) -> void {
    if !impl_.members.any_match((m) -> m.inherits != null) {
        return
    }
    trait_sym :: impl_trait_symbol(impl_, typed.resolved) else return
    owner :: typed.trait_decl_owners[trait_sym.id] else typed.resolved
    for_ty :: type_from_expr(impl_.for_type, typed.resolved, [])
    args :: registered_trait_args(impl_, trait_sym, for_ty, typed.resolved, typed)
    bindings :: trait_param_bindings(trait_sym, args, for_ty, typed)
    for m in impl_.members {
        inherited :: m.inherits else continue
        body :: inherited.body else continue
        tested: AST.TypeExpr[]: []
        AST.inspect(body, (n) -> collect_tested_type(n, tested))
        for t in tested {
            read :: substitute_map(type_from_expr(t, owner, []), bindings)
            check_is_test_target(read, AST.impl_trait_name_span(impl_), typed, diags)
        }
    }
}

// Note the type `n` tests a value against, an `is` test's or a pattern's.
collect_tested_type :: fn(n: AST.Node, tested: AST.TypeExpr[]) -> AST.Walk {
    if n is AST.BinaryExpr && n.op == .Is {
        tested.push(n.right)
    } else if n is AST.IsPattern {
        tested.push(n.ty)
    }
    return .Descend
}

/// Type the bodies a stage gave `late`, after their module was typed and resolved
/// (`resolve_late_body`), each in the impl that declares it when there is one,
/// then settle the module's tables again. Of what the settling reports, only what
/// lies in the bodies is kept: the rest was reported with the module.
///
/// @param late   functions of the module, their bodies attached.
/// @param typed  the module's typed program, written in place.
/// @param diags  receives what the bodies' typing reports.
export check_late_bodies :: fn(late: LateFn[], typed: TypedProgram, diags: Diagnostic[]) -> void {
    typed.return_walk = ReturnWalk { .diags = diags }
    files :: Set<string> {}
    for l in late {
        given :: l.decl.body else continue
        lend_file_scope(typed, l.decl.span.start.file, given.span.start.file)
        owner :: l.owner
        if owner != null {
            typed.enclosing_impl = owner.span.hash()
            typed.enclosing_impl_params = impl_param_ids(owner, typed)
        }
        walk_fn_body(l.decl, typed, diags)
        typed.enclosing_impl = 0
        typed.enclosing_impl_params = Set<i32> {}
        files.add(given.span.start.file)
    }
    settled: Diagnostic[]: []
    report_literals_past_default(typed, settled)
    settle_fn_references(typed, settled)
    zonk_module_tables(typed)
    diags.push_all(settled.filter((d) -> d.primary.start.file in files).collect())
}

walk_fn_body :: fn(fd: AST.FnDecl, typed: TypedProgram, diags: Diagnostic[]) -> void {
    // SAM short-impl synthetics carry no real body to type ; skip them.
    if fd.materialized && fd.sam_synthetic {
        return
    }
    body :: fd.body else return
    // `add` answers false for a body a call ahead of its turn walked already.
    if needs_return_inference(fd) && !typed.return_walk.walked.add(fd.id) {
        return
    }
    check_fn_body(fd, body, typed, diags)
}

// Walk now the body of the function `sym` of this module when it gives its return
// and the walk has not reached it : a call ahead of its turn reads the return, a
// const's value included. A call to a function being walked is a recursion, whose
// return stays unknown (T3034).
settle_return :: fn(sym: Symbol, typed: TypedProgram) -> void {
    if sym.module != typed.resolved.path {
        return
    }
    // A return the body gives is unresolved until then: a written or settled one
    // ends here, the common case, before any lookup of the declaration.
    declared :: typed.decl_types[sym.id]
    if declared !is FnType || declared.return_type !is UnresolvedType {
        return
    }
    decl :: typed.fn_decls[sym.id] else return
    body :: decl.body else return
    walk :: typed.return_walk
    if !needs_return_inference(decl) || !walk.walked.add(decl.id) {
        return
    }
    position :: set_walk_aside(typed)
    check_fn_body(decl, body, typed, walk.diags)
    resume_walk(typed, position)
}

// Walk now the default `m` of the trait `trait_id` when the trait is of this module,
// the default gives its return, and the walk has not reached it : a call ahead of
// the trait's turn reads the return. One being walked is a recursion (T3034).
settle_default_return :: fn(trait_id: i32, m: AST.FnDecl, typed: TypedProgram) -> void {
    if m.id in typed.impl_tables.default_returns || !needs_return_inference(m) {
        return
    }
    owner :: typed.trait_decl_owners[trait_id] else return
    if owner.path != typed.resolved.path || m.id in typed.return_walk.walked {
        return
    }
    d :: typed.trait_decls[trait_id] else return
    self_sym :: typed.resolved.trait_self_params[trait_id] else return
    position :: set_walk_aside(typed)
    typed.default_body_params = default_body_param_ids(d, self_sym, typed)
    walk_default_body(m, self_sym, typed, typed.return_walk.diags)
    resume_walk(typed, position)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// The type `checked` holds for its function or constant `name`.
type_named :: fn(checked: CheckedSource, name: string) -> string {
    sym :: checked.typed.resolved.symbols.find((s) -> s.name == name) else return "<none>"
    return display_type(checked.typed.decl_types[sym.id] else TY_UNRESOLVED)
}

@test
test_return_left_to_a_body_is_read_through_a_chain_of_calls_ahead :: fn() -> void {
    checked :: check_source_bodies("a :: fn() = b() + 1\nb :: fn() = c() + 1\nc :: fn() = 1\n")
    assert_eq(checked.diags.len(), 0)
    assert_eq(type_named(checked, "a"), "fn() -> i32")
}

@test
test_return_left_to_a_body_is_read_through_a_method_call_ahead :: fn() -> void {
    checked :: check_source_bodies("a :: fn() = 3.twice()\ntwice :: fn(n: i32) = n * 2\n")
    assert_eq(checked.diags.len(), 0)
    assert_eq(type_named(checked, "a"), "fn() -> i32")
}

@test
test_return_left_to_a_recursive_body_is_refused :: fn() -> void {
    checked :: check_source_bodies("f :: fn(n: i32) = f(n - 1)\n")
    assert(has_code(checked.diags, "T3034"), "a recursion has no return to read")
}

@test
test_return_left_to_a_body_is_read_by_a_constant_ahead :: fn() -> void {
    checked :: check_source_bodies("X :: later()\nlater :: fn() = 40\n")
    assert_eq(checked.diags.len(), 0)
    assert_eq(type_named(checked, "X"), "i32")
}

@test
test_return_left_to_a_trait_default_is_read_by_a_call_ahead :: fn() -> void {
    src :: """
        use :: fn(b: Bag) = b.twice() + 1
        Counted :: trait {
            count :: fn(self) -> i32
            twice :: fn(self) = self.count() * 2
        }
        Bag :: struct {
            n: i32
        }
        Bag implements Counted {
            count :: fn(self) -> i32 = self.n
        }
        """
    checked :: check_source_bodies(src)
    assert_eq(checked.diags.len(), 0)
    assert_eq(type_named(checked, "use"), "fn(Bag) -> i32")
}
