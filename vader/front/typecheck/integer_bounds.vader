// vader/front/typecheck/integer_bounds — what the bounds of an integer type give.
//
// `x in Hour` tests an integer against the bounds of an integer type, a range or
// a primitive, and narrows `x` where it holds (`narrow_value.vader`). `@min(T)`
// and `@max(T)` are the least and the greatest value of such a type, values of
// `T` the lowering writes as literals. A type with no integer bounds is T3110.
//
// An enum without variant data is a named set of integers : `x in E` tests an
// integer against its values, `@min(E)` and `@max(E)` are its variants of the
// least and the greatest value, `E(x)` converts an integer, stopping on any other
// value. It stays nominal : no arithmetic, no widening into an integer.
//
// `char` is the set of the Unicode scalar values, two runs around the surrogates :
// `x in char` tests an integer against them, `@min(char)` and `@max(char)` are
// U+0000 and U+10FFFF, `char(x)` converts an integer, stopping on a surrogate or
// past U+10FFFF.
//
// A type parameter bounded by `Int` is such a type whose bounds only its instances
// know : `@min(T)`, `x in T` and `T(x)` read them there. Its values are computed on
// as `i64`, which holds every one of them, and getting a `T` back takes `x in T`
// or `T(x)`.

module "vader/front/typecheck"

import "std/collections"
import "std/sort"
import "vader/support/diagnostics"
import "vader/support/integer"
import "vader/core/types"
AST :: import "toolchain/ast"

/// The type of `x in T` or `x !in T`, `T` a type : a `bool`, `x` an integer
/// tested against the bounds of the integer type `T`, or the values of the enum `T`
/// or of `char`.
///
/// @param e     the test, its right operand a type expression.
/// @param left  its left operand's type, as checked.
/// @error       T3110 when `T` has no bounds (`has_bounds`), or `x` is no integer.
check_in_type :: fn(e: AST.BinaryExpr, left: Type, typed: TypedProgram, diags: Diagnostic[]) -> Type {
    record_site(typed, e, .Operator, BUILTIN_CALLEE)
    tested :: type_operand(e.right, typed, diags)
    if tested is UnresolvedType {
        return TY_BOOL
    }
    if !has_bounds(tested, typed) {
        detail :: no_bounds_detail("in", tested)
        diags.push(typecheck_error(.NotAnIntegerType, e.right.span, detail))
        return TY_BOOL
    }
    value :: settle_range_operand(e.left, left, typed, diags)
    if !is_integer_type(value, typed) {
        diags.push(typecheck_error(.NotAnIntegerType, e.left.span,
            "`in ${display_type(tested)}` tests an integer, got `${display_type(value)}`"))
    }
    return TY_BOOL
}

/// The type of `@min(T)` or `@max(T)` : `T` itself, an integer type, `char` or an
/// enum.
///
/// @param e  the intrinsic call, its argument a type already recorded.
/// @error    T3110 when `T` has no bounds (`has_bounds`), or is an enum of no
///           variant.
integer_bound_type :: fn(e: AST.IntrinsicCallExpr, typed: TypedProgram, diags: Diagnostic[]) -> Type {
    t :: bounded_type(e, typed) ?? return TY_UNRESOLVED
    if has_bounds(t, typed) && !(t is EnumType && t.indices.is_empty()) {
        return t
    }
    detail :: no_bounds_detail("@${e.name}", t)
    diags.push(typecheck_error(.NotAnIntegerType, e.args[0].span, detail))
    return TY_UNRESOLVED
}

/// Whether `t` is an enum without variant data : one whose stored integer is the
/// value of its variant, where an enum with variant data stores a rank.
///
/// @param t  any type.
is_valued_enum :: fn(t: Type) -> bool = t is EnumType && t.data == null

/// The values of the enum `e`, in runs of consecutive values, the least first :
/// `enum { A = 1, B = 2, C = 5 }` is `1..=2` and `5..=5` ; none for an enum of no
/// variant.
///
/// @param e  an enum without variant data (`is_valued_enum`).
export enum_value_runs :: fn(e: EnumType) -> Interval[] {
    runs: Interval[]: []
    values :: sort(e.indices.values(), (a, b) -> a < b)
    if values.len() == 0 {
        return runs
    }
    lo := values[0]
    hi := values[0]
    for v in values {
        // `v - 1`, not `hi + 1` : `hi` may be the greatest `i64`.
        if v > hi && v - 1 > hi {
            runs.push(interval(lo, hi))
            lo = v
        }
        hi = v
    }
    runs.push(interval(lo, hi))
    return runs
}

/// The least and the greatest value of the type `t` : an integer type's bounds, the
/// hull of an enum's values, of the Unicode scalar values for `char`.
///
/// @param t  any type.
/// @return   null for a type with no integer values, an enum of no variant included.
export type_bounds :: fn(t: Type) -> Interval | null {
    if is_char(t) {
        return hull(CHAR_VALUES)
    }
    if t is EnumType && t.data == null {
        return hull(enum_value_runs(t))
    }
    return integer_values(t)
}

// From the least to the greatest value of `runs`, sorted ; null for none.
hull :: fn(runs: Interval[]) -> Interval | null {
    if runs.len() == 0 {
        return null
    }
    return interval(runs[0].lo, runs[runs.len() - 1].hi)
}

// The detail of T3110 on `t`, the type `what` takes : an enum with variant data
// stores a rank, not a value ; an enum of no variant has none.
no_bounds_detail :: fn(what: string, t: Type) -> string {
    if t is EnumType && t.data != null {
        return "`${what}` takes an enum without variant data, got `${display_type(t)}`"
    }
    if t is EnumType {
        return "`${display_type(t)}` has no variant"
    }
    return "`${what}` takes an integer type, `char` or an enum, got `${display_type(t)}`"
}

// Whether `t` has bounds an integer is tested against : an integer type, a type
// parameter bounded by `Int`, `char`, an enum without variant data.
has_bounds :: fn(t: Type, typed: TypedProgram) -> bool =
    integer_values(t) != null || is_integer_param(t, typed) || is_char(t) || is_valued_enum(t)

/// The value `e` stands for when it is `@min(T)` or `@max(T)`, as a range of
/// one value : what a comparison with it narrows to.
///
/// @return  null for any other expression, and for a `@max` past `i64`.
integer_bound_value :: fn(e: AST.Expr, typed: TypedProgram) -> Interval | null {
    if e !is AST.IntrinsicCallExpr || e.name != "min" && e.name != "max" {
        return null
    }
    t :: bounded_type(e, typed) ?? return null
    values :: integer_values(t) ?? return null
    if e.name == "max" && values.hi_open {
        return null
    }
    bound :: integer_bound(values, e.name == "max")
    return interval(bound, bound)
}

/// Whether `t` is a type parameter bounded by `Int`.
is_integer_param :: fn(t: Type, typed: TypedProgram) -> bool {
    if t !is TypeParamType {
        return false
    }
    bound :: typed.type_param_bound_traits[t.symbol.id] ?? return false
    return bound.integer
}

/// Whether `t` is an integer type : a primitive, a range, a free literal, or a type
/// parameter bounded by `Int`.
is_integer_type :: fn(t: Type, typed: TypedProgram) -> bool =
    is_integer(t) || is_integer_param(t, typed)

/// The type a value of `t` is computed on as : `i64` for a type parameter bounded
/// by `Int`, `t` itself otherwise.
as_computed :: fn(t: Type, typed: TypedProgram) -> Type {
    if is_integer_param(t, typed) {
        return COMPUTED_INTEGER
    }
    return t
}

/// Whether a value of `got`, a type parameter bounded by `Int`, fits a slot of
/// `expected` : one an `i64` fits.
widens_integer_param :: fn(got: Type, expected: Type, typed: TypedProgram) -> bool =
    is_integer_param(got, typed) && is_assignable(COMPUTED_INTEGER, expected)

/// Whether `t` may be the argument of a type parameter bounded by `Int` : an integer
/// type within `i64`, a range or a primitive, or another such parameter.
fits_integer_bound :: fn(t: Type, typed: TypedProgram) -> bool {
    if t is UnresolvedType || is_integer_param(t, typed) {
        return true
    }
    values :: integer_values(t) ?? return false
    return !values.hi_open
}

// What the values of a type parameter bounded by `Int` are computed on as.
COMPUTED_INTEGER :: TY_I64

// The type the one argument of `@min(T)` or `@max(T)` names, as recorded.
bounded_type :: fn(e: AST.IntrinsicCallExpr, typed: TypedProgram) -> Type | null {
    if e.args.len() != 1 {
        return null
    }
    return typed.type_expr_types[e.args[0].span.hash()]
}
