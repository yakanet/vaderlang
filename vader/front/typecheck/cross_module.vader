// vader/front/typecheck/cross_module: the tables every module of a project shares.

module "vader/front/typecheck"

import "std/collections"
AST :: import "toolchain/ast"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/resolver"

// ---- cross-module table merges --------------------------------------------

// Every module's fns declaring a contract, `@returns` or `@ensures`, in tables every
// module reads : a call reads the contract another module declares, read on demand
// in that module (`contract_of`, `ensures_of`), whatever has been walked.
share_guards :: fn(per_module: Map<string, TypedProgram>) -> void {
    shared :: SharedGuards {}
    for [_, typed] in per_module {
        for [id, owner] in typed.shared_guards.owners {
            shared.owners[id] = owner
        }
    }
    for [_, typed] in per_module {
        typed.shared_guards = shared
    }
}

// Every module's `type_param_symbols` merged into one table they all share : a
// struct, trait or impl written in one module substitutes the parameters another
// one declares.
share_type_param_symbols :: fn(per_module: Map<string, TypedProgram>) -> void {
    shared :: Map<u64, Symbol> {}
    for [_, typed] in per_module {
        for [site, sym] in typed.type_param_symbols {
            shared[site] = sym
        }
    }
    for [_, typed] in per_module {
        typed.type_param_symbols = shared
    }
}

// Cross-module struct visibility : each module's `declare_module` only
// populates its OWN `struct_decls` / `struct_fields`, yet a field access on
// a local typed as another module's struct (`block: LoweredBlock` in main.vader)
// looks `typed.struct_fields[sym.id]` up in the CURRENT module, and a miss turns
// into `?` and cascades. Symbol ids being project-global, the union of every
// module's tables is one table, written by nothing after the declarations:
// every module shares that instance.
broadcast_struct_decls :: fn(per_module: Map<string, TypedProgram>) -> void {
    all_decls :: Map<i32, AST.StructDecl> {}
    all_fields :: Map<i32, Map<string, StructFieldInfo>> {}
    for [_, typed] in per_module {
        for [sid, d] in typed.struct_decls {
            all_decls[sid] = d
        }
        for [sid, f] in typed.struct_fields {
            all_fields[sid] = f
        }
    }
    for [_, typed] in per_module {
        typed.struct_decls = all_decls
        typed.struct_fields = all_fields
    }
}

/// Give every typed program the project-wide `trait_decls` (+ owner), so
/// default-method dispatch from any body can find the trait declaration
/// regardless of which module the trait lives in. Nothing writes these tables
/// after the declarations, so one instance serves every module.
cross_publish_trait_decls :: fn(per_module: Map<string, TypedProgram>) -> void {
    decls :: Map<i32, AST.TraitDecl> {}
    owners :: Map<i32, ResolvedModule> {}
    for [_, tp] in per_module {
        for [sym_id, d] in tp.trait_decls {
            decls[sym_id] = d
            owners[sym_id] = tp.trait_decl_owners[sym_id] ?? tp.resolved
        }
    }
    for [_, tp] in per_module {
        tp.trait_decls = decls
        tp.trait_decl_owners = owners
    }
}

/// Same idea as `cross_publish_trait_decls` but for `fn_decls`.
/// Lets `lookup_callee_fn_decl` reach a callee declared in another module
/// (`std/math.min` from an entry call site).
cross_publish_fn_decls :: fn(per_module: Map<string, TypedProgram>) -> void {
    fdecls :: Map<i32, AST.FnDecl> {}
    for [_, tp] in per_module {
        for [sym_id, d] in tp.fn_decls {
            fdecls[sym_id] = d
        }
    }
    for [_, tp] in per_module {
        tp.fn_decls = fdecls
    }
}

// ---- external types -------------------------------------------------------

// Pull into the entry's `external_types` the named types a struct field reaches
// only transitively (an Enum / Struct / Trait declared in a module the entry does
// not import), so the passes that lift placeholders (`lift_enum_placeholder` in
// `expr_dot_variant.vader`) can find them: without it, `FlagSpec { .kind = .Str }`
// rejects `.Str` when `FlagKind` is reached only through the struct's field.
// `struct_fields` is the project-wide table `broadcast_struct_decls` shares.
pull_field_external_types :: fn(
    entry_typed: TypedProgram,
    per_module: Map<string, TypedProgram>,
) -> void {
    for [_, fields] in entry_typed.struct_fields {
        for [_, field] in fields {
            pull_referenced_external_types(field.ty, entry_typed, per_module)
        }
    }
}

/// Walk `t` and, for every named-type symbol (Struct / Enum / Trait)
/// declared in a non-entry module, copy its real declared type from
/// the owning module's `decl_types` into `entry.external_types`. The
/// `external_types[id]` presence check inside `register_external`
/// both memoizes and breaks Struct ↔ Struct cycles.
///
/// Spells out the variant arms instead of routing through
/// `for_each_type` so the recursion stays a plain call graph: a
/// closure capturing the two-field context tripped the self-host
/// codegen at the time of writing.
pull_referenced_external_types :: fn(
    t: Type,
    entry: TypedProgram,
    per_module: Map<string, TypedProgram>,
) -> void {
    match t {
        is StructType -> {
            register_external(t.symbol, entry, per_module)
            for a in t.args {
                pull_referenced_external_types(a, entry, per_module)
            }
        }
        is TraitType  -> {
            register_external(t.symbol, entry, per_module)
            for a in t.args {
                pull_referenced_external_types(a, entry, per_module)
            }
        }
        is EnumType  -> { register_external(t.symbol, entry, per_module) }
        is ArrayType -> { pull_referenced_external_types(t.element, entry, per_module) }
        is TupleType -> {
            for el in t.elements {
                pull_referenced_external_types(el, entry, per_module)
            }
        }
        is UnionType   -> {
            for v in t.variants {
                pull_referenced_external_types(v, entry, per_module)
            }
        }
        is FnType      -> {
            for p in t.params {
                pull_referenced_external_types(p, entry, per_module)
            }
            pull_referenced_external_types(t.return_type, entry, per_module)
        }
        _                   -> {}
    }
}

register_external :: fn(
    sym: Symbol,
    entry: TypedProgram,
    per_module: Map<string, TypedProgram>,
) -> void {
    if entry.external_types[sym.id] !is null { return }
    if sym.module == entry.resolved.path     { return }
    owner :: per_module[sym.module] ?? return
    declared :: owner.decl_types[sym.id] ?? return
    entry.external_types[sym.id] = declared
    // Chained references: `Foo { bar: Bar }` where `Bar { baz: Baz }`.
    pull_referenced_external_types(declared, entry, per_module)
}

// Build a name → FnType[] index of every imported free fn so
// `field.vader::try_free_fn_ufcs` can dispatch `x.method()` to a
// stdlib helper without requiring the user to re-implement it
// locally. Walks `external_types` (already populated with the
// imported name's resolved Type) and buckets by symbol name.
/// Pre-walk every non-entry module's expression-bodied fns so their return
/// types get patched into the owning module's `decl_types` before the
/// resolution env is wired from those types (`populate_external_types` /
/// `populate_imported_fn_overloads`). A `.ReturnsOnly` walk : it touches only
/// `needs_return_inference` fns and builds NO `expr_types`. The full per-module
/// `expr_types` + stdlib-fn materialisation are produced later, by the
/// import-loop's real `.Full` walk in `check_project_with_bodies`.
settle_external_expr_bodied_returns :: fn(
    project: LoadedProject,
    per_module: Map<string, TypedProgram>,
) -> void {
    entry_path :: project.entry
    // Two-pass : expression-bodied fns whose body calls other expr-bodied
    // fns in the same module need the callees' return types patched
    // before the caller's inference sees them. A second walk picks up
    // the now-resolved return types so chains like
    // `lexer_error(...) = new_diagnostic(...)` (where new_diagnostic
    // is itself expr-bodied) settle to the concrete return type
    // instead of `?`.
    //
    // Both passes are `.ReturnsOnly` : they settle returns and nothing else.
    // `expr_types` + materialisation come from the import-loop `.Full` walk that
    // runs over every module afterwards, so settle skips every non-settling body.
    // Pass 1 only re-settles forward refs, so it's gated to expr-bodied modules
    // (std/iter et al. don't pay a second pass for a sibling's settling).
    for pass in 0..<2 {
        for [id, loaded] in project.modules {
            if id == entry_path {
                continue
            }
            other_typed :: per_module[id] ?? continue
            // Concatenate each module's files once per iteration: `concat_file_decls`
            // copies the decl list of a multi-file module, so reuse it across the
            // gate and the walk (mirrors the import loop's `other_decls`).
            decls :: concat_file_decls(loaded.module.files)
            if pass == 1 && !has_expr_bodied_fn(decls) {
                continue
            }
            walk_bodies(decls, other_typed, diag_sink(), .ReturnsOnly)
        }
    }
}
