// vader/front/typecheck/decorator_decl: the checks of a decorator declaration.
//
// `Route :: decorator(.Function, repeatable = true) { method: Method, path: string }`
// declares a type whose values the compiler builds where `@Route(...)` is written
// (ADR 0152). Its fields hold what the compiler evaluates there, so each takes a
// type a compile-time value has; its parentheses name the places it may be
// written, as `DecoratorTarget` values, then its one option, `repeatable`.

module "vader/front/typecheck"

AST :: import "toolchain/ast"
import "toolchain/diagnostics"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/resolver"

/// The one named option a decorator declaration takes.
export REPEATABLE_OPTION :: "repeatable"

/// Check what a decorator declaration writes besides an ordinary struct: the type
/// of each field, then the places and the options in its parentheses.
///
/// @param decl   a struct declaration; nothing to check for a plain struct.
/// @param typed  the module's typed program, its struct fields declared.
/// @param diags  where T3140, T3144, T3004, T3025 and the type mismatches go.
export check_decorator_decl :: fn(
    decl: AST.StructDecl, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    args :: decl.decorator_args else return
    sym :: symbol_declared_at(typed.resolved, decl.name_span) else return
    fields :: typed.struct_fields[sym.id] else return
    in_core :: sym.module_name == CORE_MODULE
    for [name, field] in fields {
        if is_compile_time_field_type(field.ty) || (in_core && is_compiler_field_type(field.ty)) {
            continue
        }
        // A field a spread brings is written in its base: the declaration is what
        // the reader of this one can change.
        span :: if field.owner.symbol.id == sym.id { field.decl.ty.span } else { decl.name_span }
        diags.push(typecheck_error(.DecoratorFieldNotCompileTime, span,
            "`${name}` is ${display_type(field.ty)}"))
    }
    places :: decorator_target_type(typed)
    given: string[]: []
    for arg in args {
        check_decorator_arg(arg, places, given, typed, diags)
    }
}

// A positional argument names a place, a named one the option, once: `given`
// holds the names written before `arg`.
check_decorator_arg :: fn(
    arg: AST.CallArg,
    places: Type | null,
    given: string[],
    typed: TypedProgram,
    diags: Diagnostic[],
) -> void {
    key :: given_key(arg)
    if key != "" && key in given {
        diags.push(typecheck_error(.ArgumentGivenTwice, arg.span, "`${key}` is given already"))
    }
    given.push(key)
    // The typecheck reads them where a decorator is written, before any value is
    // computed: each is a literal.
    name :: arg.name else {
        check_decorator_value(arg.value, places, typed, diags)
        if place_name(arg.value) == "" {
            diags.push(typecheck_error(.DecoratorDeclarationNotLiteral, arg.value.span,
                "a place is written `.Function`"))
        }
        return
    }
    if name == REPEATABLE_OPTION {
        check_decorator_value(arg.value, TY_BOOL, typed, diags)
        if arg.value !is AST.BoolLitExpr {
            diags.push(typecheck_error(.DecoratorDeclarationNotLiteral, arg.value.span,
                "`${REPEATABLE_OPTION}` is written `true` or `false`"))
        }
        return
    }
    check_expr(arg.value, null, typed, diags)
    diags.push(typecheck_error(.UnknownNamedArg, arg.span,
        "a decorator declaration takes `${REPEATABLE_OPTION}`, got `${name}`"))
}

// What `arg` gives, to tell it given twice: the option's name, or `.Place` for a
// place ; "" for a place written in another form.
given_key :: fn(arg: AST.CallArg) -> string {
    name :: arg.name else {
        place :: place_name(arg.value)
        if place == "" {
            return ""
        }
        return ".${place}"
    }
    return name
}

// The `DecoratorTarget` variant `value` names, written `.Function` or
// `DecoratorTarget.Function` ; "" for any other form.
place_name :: fn(value: AST.Expr) -> string {
    if value is AST.DotVariantExpr {
        return value.variant
    }
    if value is AST.FieldExpr {
        return value.field
    }
    return ""
}

// Type `value` against `expected`, when there is one: none for a place while
// `std/core` declares no `DecoratorTarget`, nor for an argument that names no field
// (`decorator_use.vader`).
check_decorator_value :: fn(
    value: AST.Expr, expected: Type | null, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    got :: check_expr(value, expected, typed, diags)
    if expected != null {
        emit_mismatch_if(got, expected, value.span, value, .TypeMismatch, typed, diags)
    }
}

/// `std/core`'s `DecoratorTarget`, the type of the places a decorator declaration
/// names.
///
/// @param typed  the typed program of any module.
/// @return       null while `std/core` itself is checked, before the enum is
///               declared.
export decorator_target_type :: fn(typed: TypedProgram) -> Type | null {
    sym :: typed.decorator_target_symbol else return null
    return type_of_symbol(sym, typed)
}

// Whether `t` is a field type only the compiler's decorators take, each read as
// written: a `Condition`, the `Around` of `@interceptor`, where an `@extern` comes
// from.
is_compiler_field_type :: fn(t: Type) -> bool = is_extern_source(t)
    || (t is StructType && (is_core_struct(t, STRUCT_CONDITION) || is_core_struct(t, STRUCT_AROUND)))

// Whether a value of `t` is one the compiler can hold at compile time: a scalar, a
// string, an enum, an array of these, or a distinct over one. An unresolved type
// is reported already.

is_compile_time_field_type :: fn(t: Type) -> bool = match t {
    is PrimitiveType  -> t.name != TY_VOID.name && t.name != TY_NULL.name
    is RangeType | EnumType | UnresolvedType -> true
    is ArrayType      -> is_compile_time_field_type(t.element)
    is DistinctType   -> is_compile_time_field_type(t.backing)
    is StructType | TraitType | UnionType | FnType | TupleType | TypeParamType | TypeMetaType
        | SelfType | FreeIntType | FreeFloatType | FreeCharType | NeverType | AnyType
        | InferVar -> false
}
