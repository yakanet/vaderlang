// vader/front/typecheck/body_scan: what a function body lexically holds.
//
// Two questions share one walk: does a body `yield` (a generator), and can a
// `break` leave a given loop (W0002, T3083). Each reads the source as written,
// never a type, so it answers the same at a definition and at a call site.
//
// The walk is `inspect`'s (`toolchain/ast`), which reaches every node. A `yield`
// or a `break` can sit wherever a value does: `total += next() else break` puts
// the `break` in the right operand of the `+` that a compound assignment
// desugars to. The walk does not enter a lambda body, nor a `defer` body, which
// runs at scope exit as a fn of its own: their `yield` does not colour the
// enclosing fn, and a `break` cannot cross them.

module "vader/front/typecheck"

AST :: import "toolchain/ast"

// ---- entry points ---------------------------------------------------------

/// True when `fn_decl` is a generator, i.e. it lexically `yield`s.
///
/// Generator-ness is inferred from `yield`, with no annotation ; a generator
/// states it in its signature by returning `Iterator<T>` (T3056).
///
/// A declaration the lowering synthesises carries no node id, so it is scanned
/// on every request rather than remembered under an id it shares with the
/// others. An inherited member yields as the default body it runs, remembered
/// once for every impl.
///
/// @param typed    the module whose `generator_bodies` remembers the answer ;
///                 any module will do, the declaration need not be its own.
/// @param fn_decl  the declaration to scan ; a bodyless one is no generator.
export fn_is_generator :: fn(typed: TypedProgram, fn_decl: AST.FnDecl) -> bool {
    source :: AST.body_source(fn_decl)
    if source.id == AST.UNASSIGNED_NODE_ID {
        return body_yields(source)
    }
    return typed.generator_bodies[source.id] else remember_generator(typed, source)
}

remember_generator :: fn(typed: TypedProgram, fn_decl: AST.FnDecl) -> bool {
    yields :: body_yields(fn_decl)
    typed.generator_bodies[fn_decl.id] = yields
    return yields
}

body_yields :: fn(fn_decl: AST.FnDecl) -> bool {
    body :: fn_decl.body else return false
    return has_yield(body)
}

/// True when `n` is, or holds, a `yield` outside any nested body (a lambda, a
/// `defer`).
///
/// @param n  the statement or expression to scan.
export has_yield :: fn(n: AST.Node) -> bool = node_contains(n, BodyProbe { .kind = .Yield })

/// True when `s` is an infinite `for { ... }` that no `break` can leave.
///
/// Only the `InfiniteFor` form qualifies. `for cond` and `for x in xs` both
/// carry an exit edge, and deciding that one is never taken would need
/// value-range reasoning the checker does not do, so `for true { }` is
/// deliberately NOT divergent here. A labelled `break` is followed at any depth
/// since it can name an outer loop ; an infinite `for` has no iteration variable,
/// so its label is the only name that reaches it (see `resolve_loop_target`).
///
/// @param s  the loop to judge.
loop_never_exits :: fn(s: AST.ForStmt) -> bool {
    if s.form !is AST.InfiniteFor {
        return false
    }
    probe :: BodyProbe {
        .kind = .LoopExit,
        .label = s.label,
        .bare_counts = true,
    }
    return !node_contains(s.body, probe)
}

// ---- the walk -------------------------------------------------------------

ProbeKind :: enum {
    Yield,
    LoopExit,
}

/// What a scan looks for.
BodyProbe :: struct {
    kind: ProbeKind
    /// `LoopExit` only: the label of the loop being judged.
    label: string | null = null
    /// `LoopExit` only: whether a bare `break` still targets the loop being
    /// judged, false once the walk has entered a nested loop, which swallows
    /// bare `break`s.
    bare_counts: bool = false
}

node_contains :: fn(n: AST.Node, probe: BodyProbe) -> bool =
    AST.inspect(n, (m) -> probe_step(m, probe))

// Exhaustive, so a new node kind that yields or jumps gets an arm.
probe_step :: fn(n: AST.Node, probe: BodyProbe) -> AST.Walk = match n {
    // Holds what its children hold.
    is AST.IdentExpr | AST.FieldExpr | AST.CallExpr | AST.StringLitExpr | AST.IntLitExpr
        | AST.BoolLitExpr | AST.NullLitExpr | AST.CharLitExpr | AST.FloatLitExpr | AST.BinaryExpr
        | AST.ExprStmt | AST.LetStmt | AST.BlockExpr | AST.ReturnStmt | AST.IfExpr
        | AST.DotVariantExpr | AST.StructLitExpr | AST.UnaryExpr | AST.AssignStmt | AST.IndexExpr
        | AST.MatchExpr | AST.FallbackExpr | AST.GenericInstExpr | AST.SeqLitExpr
        | AST.RangeExpr | AST.IntrinsicCallExpr | AST.CastExpr | AST.ContinueStmt
        | AST.DestructureAssignStmt | AST.Decl -> .Descend
    is AST.ForStmt -> loop_step(n, probe)
    // A nested body runs as a fn of its own ; a pattern or a type evaluates nothing.
    is AST.LambdaExpr | AST.DeferStmt | AST.Pattern | AST.ArrayTypeExpr | AST.FnTypeExpr -> .Skip
    is AST.BreakStmt -> stop_if(break_leaves_loop(n, probe))
    is AST.YieldStmt -> stop_if(probe.kind == .Yield)
}

stop_if :: fn(found: bool) -> AST.Walk {
    if found {
        return .Stop
    }
    return .Descend
}

// Does this `break` leave the loop being judged ? A bare one targets the
// innermost loop ; a labelled one reaches any enclosing loop carrying that label.
break_leaves_loop :: fn(b: AST.BreakStmt, probe: BodyProbe) -> bool {
    if probe.kind != .LoopExit {
        return false
    }
    named :: b.label else return probe.bare_counts
    return probe.label != null && named == probe.label
}

// A nested loop swallows the bare `break`s of its body, but not those of its
// iterable or its condition, which are evaluated before the loop is entered.
loop_step :: fn(s: AST.ForStmt, probe: BodyProbe) -> AST.Walk {
    if probe.kind != .LoopExit || !probe.bare_counts {
        return .Descend
    }
    inside :: BodyProbe { ...probe, .bare_counts = false }
    if form_contains(s.form, probe) || node_contains(s.body, inside) {
        return .Stop
    }
    return .Skip
}

form_contains :: fn(form: AST.ForForm, probe: BodyProbe) -> bool = match form {
    is AST.InFor       -> node_contains(form.iter, probe)
    is AST.WhileFor    -> node_contains(form.cond, probe)
    is AST.InfiniteFor -> false
}
