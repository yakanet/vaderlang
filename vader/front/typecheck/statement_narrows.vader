// vader/front/typecheck/statement_narrows: what a statement leaves narrowed after it.
//
// Past an `if` with no `else` whose branch diverges, what its condition holds
// where it is false, as an `else` would see it (`push_cond_narrows`,
// `expr_if.vader`) ; past a call to an `@ensures` fn, what it ensures.

module "vader/front/typecheck"

AST :: import "toolchain/ast"
import "vader/core/types"

// ---- past a statement -----------------------------------------------------

// Push what `stmt` leaves narrowed for the rest of its block : past a call to an
// `@ensures` fn, what it ensures (`push_ensured_call`) ; past an `if` whose branch
// diverges, what its condition leaves (`push_past_divergent_if`).
push_statement_narrows :: fn(
    stmt: AST.Stmt,
    typed: TypedProgram,
    stack: PushedNarrow[],
) -> void {
    called :: statement_call(stmt)
    if called != null {
        push_ensured_call(called, typed, stack)
        return
    }
    if stmt is AST.ExprStmt && stmt.expr is AST.IfExpr {
        push_past_divergent_if(stmt.expr, typed, stack)
    }
}

// Push what the condition of `e`, an `if` with no `else` whose branch diverges
// (`return`, `break`, `continue`, a call that never returns), holds where it is
// false, for what follows it ; whether `e` is one.
push_past_divergent_if :: fn(e: AST.IfExpr, typed: TypedProgram, stack: PushedNarrow[]) -> bool {
    if e.else_branch !is null || !then_is_divergent(e.then_block, typed) {
        return false
    }
    push_cond_narrows_into(e.cond, false, typed, diag_sink(), stack)
    return true
}

// The call `stmt` makes as a whole, an expression statement or the value a `let`
// binds : what its callee `@ensures` holds past it.
statement_call :: fn(stmt: AST.Stmt) -> AST.CallExpr | null {
    if stmt is AST.ExprStmt && stmt.expr is AST.CallExpr {
        return stmt.expr
    }
    if stmt is AST.LetStmt && stmt.value is AST.CallExpr {
        return stmt.value
    }
    return null
}

// ---- divergent statements -------------------------------------------------

then_is_divergent :: fn(b: AST.BlockExpr, typed: TypedProgram) -> bool {
    // A guard block whose sole (or final) content is a `@no_return` call
    // (`{ panic(...) }`) parses that call as the block's trailing expression,
    // not a statement, so `b.stmts` is empty. Honor a `never`-typed trailing
    // expr as divergent, mirroring the `is_divergent_stmt` ExprStmt arm ;
    // otherwise the complement narrowing is dropped and the guarded binding
    // keeps its union type (T3009 on the post-guard use).
    if b.trailing !is null {
        if typed.expr_types[b.trailing.id] is NeverType {
            return true
        }
    }
    if b.stmts.len() == 0 {
        return false
    }
    return is_divergent_stmt(b.stmts[b.stmts.len() - 1], typed)
}

is_divergent_stmt :: fn(s: AST.Stmt, typed: TypedProgram) -> bool {
    if s is AST.ReturnStmt   { return true }
    if s is AST.BreakStmt    { return true }
    if s is AST.ContinueStmt { return true }
    // An expression statement that evaluates to `never` (a call to a
    // `@no_return` fn: `panic` / `todo` / `unreachable`) terminates the
    // flow : code after it is unreachable, and it discharges a non-`void`
    // fn's return obligation.
    if s is AST.ExprStmt {
        if typed.expr_types[s.expr.id] is NeverType {
            return true
        }
    }
    // A `for { ... }` no `break` can leave has no exit edge, so whatever follows
    // it cannot run. A `return` in the body doesn't reopen one: it leaves the
    // fn, not the loop.
    if s is AST.ForStmt {
        return loop_never_exits(s)
    }
    return false
}
