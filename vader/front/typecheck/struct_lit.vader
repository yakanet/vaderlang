// vader/front/typecheck/struct_lit: StructLitExpr inference (`Point { x: 1 }`).
//
// Lowers `type_name` into a `StructType` (T3001 if it isn't one), looks
// up the struct's fields via `typed.struct_fields`, and checks each item.
// Returns the struct type.

module "vader/front/typecheck"

import "std/collections"
import "std/iter"
import "std/string"
import "vader/support/diagnostics"
import "vader/core/types"
AST :: import "toolchain/ast"

/// Type-check a `StructLitExpr`. Always returns the struct type even
/// when the body has errors so downstream passes keep flowing.
infer_struct_lit :: fn(e: AST.StructLitExpr, typed: TypedProgram, diags: Diagnostic[]) -> Type {
    ty :: type_from_expr(e.type_name, typed.resolved, diags)
    // A struct-backed distinct newtype (`Color :: Rgb`) constructs through the
    // backing struct's fields but keeps its nominal identity: check the body
    // against the backing, return the distinct `Color` (not the raw `Rgb`).
    st_backing :: struct_backing(ty)
    if st_backing != null {
        reject_partial_type_args(e.type_name, st_backing, typed, diags)
        reject_unmet_struct_bounds(st_backing, e.type_name.span, typed, diags)
        check_struct_items(e.items, e.span, st_backing, typed, diags)
        return ty
    }
    // An unresolved name is already reported.
    if ty !is UnresolvedType {
        diags.push(typecheck_error(.TypeMismatch, e.type_name.span,
            "${display_type(ty)} is not a struct"))
    }
    // Still type every item so nested diagnostics surface ; the literal itself is
    // `?`, so the slot it fills reports nothing more.
    for item in e.items { check_item_no_expected(item, typed, diags) }
    return TY_UNRESOLVED
}

// T3105 on a generic struct written with some of its type arguments where nothing
// infers the rest : a literal (`Pair<i32> { … }`), whose fields bind none once some
// are written, or the owner of a static member (`Pair<f64>.make(1)`).
reject_partial_type_args :: fn(
    name: AST.Expr, st: StructType, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    if name !is AST.GenericInstExpr {
        return
    }
    decl :: typed.struct_decls[st.symbol.id] ?? return
    declared :: decl.type_params.len()
    if name.type_args.len() == declared {
        return
    }
    diags.push(
        typecheck_error(
            .TypeArgumentCountMismatch,
            name.span,
            "`${decl.name}` takes ${declared}, got ${name.type_args.len()}",
        ),
    )
}

// T3006: a literal is where a value of `Wrapper<X>` comes to exist, so `X` meets the
// bounds the struct declares on its type arguments there.
reject_unmet_struct_bounds :: fn(
    st: StructType, span: Span, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    if st.args.len() == 0 {
        return
    }
    bounds :: typed.struct_bounds[st.symbol.id] ?? return
    unmet :: first_unmet_bound(st.args, bounds, typed) ?? return
    detail :: unmet_bound_detail(unmet.bound.name, st.symbol.name, unmet.required, unmet.reason)
    diags.push(typecheck_error(.TraitNotSatisfied, span, detail))
}

/// Type-check the items of a struct literal against `st` : each field
/// against its declared type, each spread against `st` or a struct `st`
/// spreads, then T3037 for a required field nothing provides.
///
/// @param items  the literal's entries, as written.
/// @param span   where T3037 points: the literal, or the enum variant that
///               carries these items.
/// @param st     the struct the items build.
/// @return       `st`.
check_struct_items :: fn(
    items: AST.StructLitItem[],
    span: Span,
    st: StructType,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> Type {
    decl :: typed.struct_decls[st.symbol.id]
    provided: string[]: []
    // The fields the spreads of a base give, made at the first one.
    covered: string[] | null = null
    whole_spread := false
    for item in items {
        match item {
            is AST.StructLitSpread -> {
                got :: check_expr(item.expr, st, typed, diags)
                fields :: spread_source_fields(item, got, st, decl, typed, diags)
                if fields == null {
                    whole_spread = true
                } else if covered == null {
                    covered = fields
                } else {
                    covered.push_all(fields)
                }
            }
            is AST.StructLitField -> {
                check_field(item, st, decl, typed, diags, provided)
            }
        }
    }
    // T3037: required fields without defaults must be provided when no
    // `...spread` covers them ; the defaults of the others land in the literal.
    if decl is AST.StructDecl && !whole_spread {
        filled :: filled_fields(provided, covered)
        check_missing_fields(span, st, filled, typed, diags)
        settle_literal_defaults(st.symbol.id, filled, span, typed)
    }
    return st
}

// The fields a literal fills : those it names, and those its spreads of a base give.
filled_fields :: fn(provided: string[], covered: string[] | null) -> string[] {
    if covered == null {
        return provided
    }
    covered.push_all(provided)
    return covered
}

// The fields a spread source of type `got` gives a literal of `st` : those of its struct
// when `st` spreads it, null when it gives them all : a source of `st` itself, or one in
// error (T3001), over which the literal reports no missing field.
spread_source_fields :: fn(
    item: AST.StructLitSpread,
    got: Type,
    st: StructType,
    decl: AST.StructDecl | null,
    typed: TypedProgram,
    diags: Diagnostic[],
) -> string[] | null {
    if is_assignable(got, st) {
        return null
    }
    fields :: base_spread_fields(got, st, decl, typed)
    if fields == null {
        diags.push(
            typecheck_error(
                .TypeMismatch,
                item.span,
                "spread source must be ${display_type(st)} or a struct it spreads, got ${display_type(got)}",
            ),
        )
    }
    return fields
}

// The fields of `got` when it is a struct `st` spreads, directly or through its bases,
// with the arguments `st` gives it ; null otherwise.
base_spread_fields :: fn(
    got: Type,
    st: StructType,
    decl: AST.StructDecl | null,
    typed: TypedProgram,
) -> string[] | null {
    if got !is StructType {
        return null
    }
    base :: spread_base_of(st, got.symbol, typed, Set<i32> {}) ?? return null
    if !is_assignable(got, spread_slot(base, st, decl)) {
        return null
    }
    fields :: typed.struct_fields[got.symbol.id] ?? return null
    return fields.keys().collect()
}

// The type a spread source must have to fill `base` in a literal of `st` : `base`, or its
// shape when the literal binds none of the parameters of `st` (`Chain { ...pair }`), as a
// field value matches its type.
spread_slot :: fn(base: StructType, st: StructType, decl: AST.StructDecl | null) -> Type {
    if leaves_type_args_unbound(st, decl) {
        return erase_type_params(base)
    }
    return base
}

// A literal of `st` written without the type arguments of its struct (`Box { ... }`).
leaves_type_args_unbound :: fn(st: StructType, decl: AST.StructDecl | null) -> bool =
    decl is AST.StructDecl && st.args.len() < decl.type_params.len()

check_field :: fn(
    f: AST.StructLitField, st: StructType, decl: AST.StructDecl | null,
    typed: TypedProgram, diags: Diagnostic[], provided: string[],
) -> void {
    expected: Type | null = null
    field :: struct_field_info(typed, st.symbol.id, f.name)
    if field != null {
        // T3054 : reject setting an `@internal` field at construction from
        // outside its declaring module (the field's default still applies, so
        // `T {}` keeps working cross-module).
        check_internal_field(field, f.name_span, typed, diags)
        expected = substitute_struct_args(field.ty, st, typed)
    }
    got :: check_expr(f.value, expected, typed, diags)
    if expected is null {
        diags.push(typecheck_error(.MemberDoesNotExist, f.name_span,
            "`${f.name}` on ${display_type(st)}"))
        return
    }
    // Duplicate-field check runs against the list ; the offending field
    // still gets type-checked against the field type so nested diags
    // surface for the second occurrence too.
    if f.name in provided {
        diags.push(typecheck_error(.FieldAlreadyProvided, f.name_span,
            "field `${f.name}` already provided in this struct literal"))
    }
    provided.push(f.name)
    // A literal written without type arguments (`Box { .value = [4, 5] }`) binds
    // none of its struct's parameters, so its fields match them as a pattern,
    // except a free literal, which needs a type to land on and gets none
    // (`Box { .value = 0 }` ; `Box<i32> { … }` gives it one).
    as_pattern :: leaves_type_args_unbound(st, decl) && !is_free_numeric(got)
    want :: if as_pattern { erase_type_params(expected) } else { expected }
    if is_assignable(got, want) {
        return
    }
    if try_into(got, want, typed, f.value) {
        return
    }
    diags.push(mismatch_diagnostic(got, expected, f.span, .TypeMismatch, typed))
}

check_missing_fields :: fn(
    span: Span, st: StructType, provided: string[], typed: TypedProgram, diags: Diagnostic[],
) -> void {
    fields :: typed.struct_fields[st.symbol.id] ?? return
    missing: string[]: []
    for [name, field] in fields {
        if field.decl.default == null && name !in provided {
            missing.push("`${name}`")
        }
    }
    if missing.len() == 0 { return }
    label := "fields"
    if missing.len() == 1 { label = "field" }
    diags.push(typecheck_error(.MissingRequiredFieldInStructLit, span,
        "missing required ${label} on ${display_type(st)}: ${missing.join(", ")}"))
}

check_item_no_expected :: fn(
    item: AST.StructLitItem, typed: TypedProgram, diags: Diagnostic[],
) -> void {
    match item {
        is AST.StructLitField  -> { check_expr(item.value, null, typed, diags) }
        is AST.StructLitSpread -> { check_expr(item.expr,  null, typed, diags) }
    }
    return
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "vader/front/parser"
import "vader/front/resolver"
import "vader/core/symbol"
import "toolchain/span"

ExpectedSL :: struct {
    typed: TypedProgram
    sl:    AST.StructLitExpr
}

expect_struct_lit :: fn(src: string) -> ExpectedSL {
    parsed :: parse_source(with_integers(src), "t.vader")
    factory :: SymbolFactory {}
    rm :: resolve_module(parsed.program, "t", factory)
    diags: Diagnostic[]: []
    result :: check_module(parsed.program, rm, diags)
    last :: parsed.program.decls[parsed.program.decls.len() - 1]
    match last {
        is AST.FnDecl -> {
            match b :: last.body {
                is null          -> {}
                is AST.BlockExpr -> {
                    hit :: AST.find_expr(b, (e) -> e is AST.StructLitExpr)
                    if hit is AST.StructLitExpr { return ExpectedSL { .typed = result.typed, .sl = hit } }
                }
            }
        }
        _ -> {}
    }
    assert(false, "expected a StructLitExpr in: ${src}")
    return ExpectedSL { .typed = result.typed, .sl = synthetic_sl() }
}

synthetic_sl :: fn() -> AST.StructLitExpr {
    sp :: empty_span()
    int_lit: AST.Expr: AST.IntLitExpr {
        .span = sp, .id = AST.UNASSIGNED_NODE_ID, .value = 0,
    }
    return AST.StructLitExpr {
        .span = sp, .id = AST.UNASSIGNED_NODE_ID,
        .type_name = int_lit, .items = [],
    }
}

@test
test_struct_lit_types_to_struct :: fn() -> void {
    src :: """
Point :: struct {
    x: i32
    y: i32
}
f :: fn() -> Point { return Point { .x = 1, .y = 2 } }
"""
    eb :: expect_struct_lit(src)
    diags: Diagnostic[]: []
    assert_eq(display_type(infer_struct_lit(eb.sl, eb.typed, diags)), "Point")
    assert_eq(diags.len(), 0)
}

@test
test_struct_lit_unknown_field_emits_T3009 :: fn() -> void {
    src :: """
Point :: struct { x: i32 }
f :: fn() -> Point { return Point { .x = 1, .z = 2 } }
"""
    eb :: expect_struct_lit(src)
    diags: Diagnostic[]: []
    infer_struct_lit(eb.sl, eb.typed, diags)
    found := false
    for d in diags { if d.code.id == "T3009" { found = true } }
    assert(found, "expected T3009 on unknown field")
}

@test
test_struct_lit_missing_field_emits_T3037 :: fn() -> void {
    src :: """
Point :: struct {
    x: i32
    y: i32
}
f :: fn() -> Point { return Point { .x = 1 } }
"""
    eb :: expect_struct_lit(src)
    diags: Diagnostic[]: []
    infer_struct_lit(eb.sl, eb.typed, diags)
    found := false
    for d in diags { if d.code.id == "T3037" { found = true } }
    assert(found, "expected T3037 on missing field")
}

@test
test_struct_lit_field_type_mismatch_emits_T3001 :: fn() -> void {
    src :: """
Point :: struct { x: i32 }
f :: fn() -> Point { return Point { .x = "hello" } }
"""
    eb :: expect_struct_lit(src)
    diags: Diagnostic[]: []
    infer_struct_lit(eb.sl, eb.typed, diags)
    found := false
    for d in diags { if d.code.id == "T3001" { found = true } }
    assert(found, "expected T3001 on field type mismatch")
}
