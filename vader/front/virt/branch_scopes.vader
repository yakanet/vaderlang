// vader/front/virt/branch_scopes: label-keyed scope stack and branch wiring.
//
// `virt_reader.vader` fills a function's jump table from a labelled scope stack
// while it replays a `.virt` dump: a `br` names a scope by its label, and the
// jump target is known at once for a loop, at the matching `end` otherwise. The
// stacks and the jump table live in `ParserState`.
//
// `emit/bytecode/emit.vader` has a sibling that resolves by `BlockId` and prefers loop
// scopes on a tie: a different rule, not a copy of this one.

module "vader/front/virt"

import "vader/core/bytecode"

/// One scope opened by `block` / `loop` / `if` / `else`. `label` is the tag a
/// `br <label>` matches against the scope ; `is_loop` distinguishes back-edges
/// (loop) from forward-edges (block / if / else) ; `opener_pc` is the pc of the
/// op that opened the scope.
ScopeEntry :: struct {
    label:     string
    is_loop:   bool
    opener_pc: i32
}

/// One `br` / `br_if` whose target scope hasn't closed yet. Drained on the
/// matching `end`.
PendingBranch :: struct {
    branch_pc:    i32
    target_label: string
}

/// Push `entry` on the scope stack. Reuses an already-allocated slot when one is
/// available (cursor < array length), saving an allocation per push for the
/// second and subsequent functions in a module.
///
/// @param entry  the scope to push.
push_scope :: fn(state: ParserState, entry: ScopeEntry) -> void {
    sp :: state.scope_sp[0]
    if sp == state.scopes.len() {
        state.scopes.push(entry)
    } else {
        state.scopes[sp] = entry
    }
    state.scope_sp[0] += 1
}

/// Wire one `br` / `br_if` against the innermost scope carrying `label`.
///
/// A loop label resolves immediately, its opener pc being known. A `block` / `if`
/// / `else` label targets a pc that does not exist yet, so the branch is
/// deferred to `drain_pending`. An unmatched label is left unwired: the caller
/// has already reported the malformed input.
///
/// @param label  the label the branch names.
/// @param pc     pc of the branch op.
defer_or_resolve_branch :: fn(state: ParserState, label: string, pc: i32) -> void {
    // Innermost match wins : walk down from the top of the stack.
    i := state.scope_sp[0] - 1
    for i >= 0 {
        if state.scopes[i].label == label {
            break
        }
        i -= 1
    }
    if i < 0 {
        return
    }
    target :: state.scopes[i]
    if target.is_loop {
        state.table[pc] = target.opener_pc + 1
        return
    }
    psp :: state.pending_sp[0]
    entry :: PendingBranch { .branch_pc = pc, .target_label = label }
    if psp == state.pending.len() {
        state.pending.push(entry)
    } else {
        state.pending[psp] = entry
    }
    state.pending_sp[0] += 1
}

/// When the scope `closed` ends, fill in every pending branch that named it.
/// Branches that didn't match its label stay pending, compacted to the front of
/// the cursor window.
///
/// @param closed  the scope just closed (a loop's back-edge target is its opener + 1).
/// @param end_pc  pc of the matching `end` op.
drain_pending :: fn(state: ParserState, closed: ScopeEntry, end_pc: i32) -> void {
    psp :: state.pending_sp[0]
    new_sp: i64 = 0
    for i in 0..<psp {
        entry :: state.pending[i]
        if entry.target_label != closed.label {
            state.pending[new_sp] = entry
            new_sp += 1
            continue
        }
        if closed.is_loop {
            state.table[entry.branch_pc] = closed.opener_pc + 1
        } else {
            state.table[entry.branch_pc] = end_pc + 1
        }
    }
    state.pending_sp[0] = new_sp
}
