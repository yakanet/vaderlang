// vader/front/virt/virt_reader — shared `.virt` op-stream parsing.
//
// Holds the per-op line parsers + structured control-flow → linear op-stream
// wiring (`ParserState`, `wire_control_flow`, `parse_op_line`, every
// `parse_<op>` helper) used by the canonical `.virt` reader in
// `virt_reader_bc.vader` (which produces a `BytecodeModule`).
//
// The format is the one produced by `vader dump --stage=bytecode`.
//
// Every branching op's target pc is resolved in a single pass via a
// label-keyed scope stack that resets at each fn boundary.

module "vader/front/virt"

import "std/numbers"
import "std/string"
import "vader/core/bytecode"
import "vader/core/bytecode/builder"
import "vader/core/types"

// `ScopeEntry` and `PendingBranch` live in `vader/core/bytecode/builder`, beside
// the scope stack / branch wiring that consume them (`branch_scopes.vader`):
// one source of truth for both. The parser threads them through
// `ParserState` below while reading `.virt` text ; the builder wires the same
// shapes at programmatic build time.

/// Per-function parser state bundle. Carries the six structures
/// `wire_control_flow` threads together, so it takes one parameter instead of
/// six. Mutations happen through the embedded array references (Vader arrays
/// are heap-allocated, so `state.scopes.push(...)` is visible across calls
/// without explicit by-ref passing). The 1-element `scope_sp` / `pending_sp`
/// arrays are the canonical "boxed scalar" pattern used elsewhere in the file.
///
/// The bundle stops at this module's edge: the shared helpers in
/// `branch_scopes.vader` take the arrays directly, since `FunctionBuilder`
/// holds the same six fields under its own names and has no `ParserState` to
/// hand over.
///
/// `ops` and `table` are reset at every `fn ...` header in `parse_virt_bc` ;
/// `scopes` and `pending` are reused across functions (only their
/// cursors reset to 0).
ParserState :: struct {
    ops:        Op[]
    table:      i32[]
    scopes:     ScopeEntry[]
    scope_sp:   i64[]
    pending:    PendingBranch[]
    pending_sp: i64[]
}

/// Strip a trailing `; ...` comment (the .virt format glues a source-
/// span annotation after every op). The semicolon never appears inside
/// an op payload today, so a first-occurrence split is correct. Walks a
/// held `bytes()` view + slices to avoid allocating a segment array per line.
///
/// @param line  one full line of the .virt source.
/// @return      the line with its trailing comment removed, also trimmed
///              of surrounding whitespace.
strip_comment :: fn(line: string) -> string {
    // Walk the line and find the first `;` that's not inside a double-
    // quoted string. The `.virt` writer keeps the comment delimiter
    // literal so a `;` inside a quoted payload (e.g. `string 3 "GC;..."`)
    // must not be treated as the start of a comment.
    n :: line.byte_len()
    in_quote := false
    i: i64 = 0
    for i < n {
        b :: line.byte_at(i)
        if b == '\\' && in_quote && i + 1 < n {
            // Skip the escaped byte so `\"` doesn't close the string.
            i += 2
            continue
        }
        if b == '"' { in_quote = !in_quote }
        else if b == ';' && !in_quote { return line.byte_slice(0, i).trim() }
        i += 1
    }
    return line.trim()
}

/// First whitespace-separated token after `prefix` — the structured
/// ops embed their label here (`block $L0 void` → `$L0`). Zero-alloc :
/// trims the prefix, finds the next space, slices.
///
/// @param cleaned  the .virt line (comment-stripped).
/// @param prefix   literal prefix to skip (e.g. `"block "`, `"br "`).
/// @return         the next whitespace-delimited token, or the rest of
///                 the line if there is no further space.
first_token_after :: fn(cleaned: string, prefix: string) -> string {
    rest :: cleaned.byte_slice(prefix.byte_len(), cleaned.byte_len()).trim()
    return head_of(rest)
}

/// First whitespace-delimited token of `s`. Returns the full string when
/// no whitespace is present (bare ops like `drop`, `return`, or any
/// dotted op-name like `i32.add` / `array.len`). One allocation per call —
/// callers share via `head :: head_of(cleaned)` once per line instead of
/// chaining `starts_with` byte-walks per dispatch arm.
///
/// @param s  source string.
/// @return   the head token, or the full string when there's no space.
head_of :: fn(s: string) -> string = before_first(s, ' ')

// The text of `s` before the first `c`, or all of it when `c` does not occur.
before_first :: fn(s: string, c: char) -> string {
    at :: s.index_of(c, 0)
    if at < 0 {
        return s
    }
    return s.byte_slice(0, at)
}

// The text of `s` after the first `c`, or nothing when `c` does not occur.
after_first :: fn(s: string, c: char) -> string {
    at :: s.index_of(c, 0)
    if at < 0 {
        return ""
    }
    return s.byte_slice(at + 1, s.byte_len())
}

/// Parse a comma-separated list of base-10 i32s — used by both
/// `parse_union_type` (variant list) and `parse_fn_type` (param-type list).
/// Malformed entries are skipped silently ; an empty input yields `[]`.
///
/// @param csv  string body, e.g. `"1,2,3"` or `""`.
/// @return     parsed ids, in order.
parse_int_list :: fn(csv: string) -> i32[] {
    ids: i32[]: []
    if csv.byte_len() == 0 { return ids }
    parts :: csv.split(",")
    n :: parts.len()
    for i in 0..<n {
        parsed :: parse_int_in_base(parts[i].trim(), 10)
        if !(parsed is ParseError) { ids.push(i32(parsed)) }
    }
    return ids
}
/// Parse `string N "..."`. Anything inside the quotes is taken
/// verbatim (the .virt encoder doesn't currently emit escapes for the
/// inner content, so a naive first-quote / last-quote split is right).
///
/// @param cleaned  the .virt line, already comment-stripped.
/// @param strings  the module-wide string pool, appended to in place.
/// @return         `null` when a string was appended, else why it could not be.
parse_string_decl :: fn(cleaned: string, strings: string[]) -> DirectiveError | null {
    after :: cleaned.trim_prefix("string ")
    first_quote :: after.index_of('"', 0)
    if first_quote < 0 {
        return DirectiveError { .reason = "expected `string <index> \"…\"`, got no quoted text" }
    }
    body :: after.byte_slice(first_quote + 1, after.byte_len() - 1)
    strings.push(decode_escapes(body))
    return null
}
/// Decode a hex string (lowercase or uppercase digits) into a byte array.
/// Odd-length input is rounded down (the bytecode writer always emits
/// even-length blobs, so this only fires on malformed input). Digit
/// decoding delegates to `std/numbers::hex_digit_value` ; an invalid
/// digit (-1 return) leaks through as a high-bit junk byte, which the
/// caller treats as out-of-range data and surfaces as a value mismatch.
///
/// @param s  hex digits (no `0x` prefix, no separators).
/// @return   one byte per pair of hex digits, in input order.
hex_to_bytes :: fn(s: string) -> u8[] {
    out: u8[]: []
    i: i64 = 0
    len :: s.byte_len()
    for i + 1 < len {
        hi :: u32(hex_digit_value(char(u32(s.byte_at(i)))))
        lo :: u32(hex_digit_value(char(u32(s.byte_at(i + 1)))))
        out.push(u8((hi << 4) | lo))
        i += 2
    }
    return out
}

/// Index of the last ASCII space in `s`, or `-1` if absent.
last_index_of_space :: fn(s: string) -> i32 = i32(s.last_index_of(' ', 0))
/// Read the mangled name from a `fn N MANGLED (PARAMS) -> RET` header
/// — the second whitespace-token after the `fn ` prefix. Same tokenizing
/// shape as `parse_import_decl`'s `parts[2]` lookup, so both header
/// parsers read uniformly.
///
/// @param cleaned  the .virt line, already comment-stripped.
/// @return         the mangled name, or `""` if the header is malformed.
read_fn_mangled_name :: fn(cleaned: string) -> string {
    after :: cleaned.trim_prefix("fn ")
    parts :: after.split(" ")
    if parts.len() < 2 { return "" }
    return parts[1]
}

/// Update the scope stack and the jump table for the op at `pc`.
/// Called once the op is appended, so `pc` is `ops.len() - 1`.
///
/// @param state    per-function parser scratch state (mutated in place).
/// @param cleaned  the .virt line (comment-stripped) — still needed by
///                 helpers that re-parse args like the branch label.
/// @param head     the line's pre-computed head token (see `head_of`).
/// @param pc       the pc that was just emitted (= `state.ops.len() - 1`).
wire_control_flow :: fn(state: ParserState, cleaned: string, head: string, pc: i32) -> void {
    if head == "block" {
        push_scope(state.scopes, state.scope_sp, ScopeEntry { .label = first_token_after(cleaned, "block "), .is_loop = false, .opener_pc = pc })
    } else if head == "loop" {
        // Loop target is the start of its body (opener_pc + 1) — known
        // immediately, so we fill `table[pc]` up front.
        push_scope(state.scopes, state.scope_sp, ScopeEntry { .label = first_token_after(cleaned, "loop "), .is_loop = true, .opener_pc = pc })
        state.table[pc] = pc + 1
    } else if head == "if" {
        push_scope(state.scopes, state.scope_sp, ScopeEntry { .label = first_token_after(cleaned, "if "), .is_loop = false, .opener_pc = pc })
    } else if head == "else" {
        sp :: state.scope_sp[0]
        if sp > 0 {
            top :: state.scopes[sp - 1]
            state.table[top.opener_pc] = pc + 1
            // Repurpose the same entry as an "else scope" so its
            // matching `end` pairs the else with the past-end pc.
            state.scopes[sp - 1] = ScopeEntry { .label = top.label, .is_loop = false, .opener_pc = pc }
        }
    } else if head == "end" {
        sp :: state.scope_sp[0]
        if sp > 0 {
            top :: state.scopes[sp - 1]
            state.scope_sp[0] -= 1
            // Block/if/else fall-through target = past the end. Loops
            // don't fall through via the opener — their `table[opener]`
            // already points at the body start.
            if !top.is_loop && state.table[top.opener_pc] < 0 {
                state.table[top.opener_pc] = pc + 1
            }
            drain_pending(state.table, state.pending, state.pending_sp,
                          top.label, top.is_loop, top.opener_pc, pc)
        }
    } else if head == "br" || head == "br_if" {
        // `first_token_after` slices past the prefix then trims, so the head
        // token is the prefix — the two forms differ only in their opcode.
        defer_or_resolve_branch(state.scopes, state.scope_sp, state.table,
                                state.pending, state.pending_sp,
                                first_token_after(cleaned, head), pc)
    }
}

/// Dispatch on the line's head token to construct the matching `Op` variant.
///
/// The dotted width families (`i32.*` / `i64.*` / `u32.*` / `u64.*` / `f64.*`
/// and every `<from>.to_<to>`) are decoded by the block up front ; the literal
/// `head == "…"` chain below covers the rest. Between them the two arms must
/// cover every op `emit/virt/dump.vader::write_op` can emit — a gap there reaches
/// `parse_virt_bc` as a `VirtParseError` on a dump the compiler itself produced.
///
/// @param cleaned  the .virt line (comment-stripped).
/// @param head     the line's pre-computed head token (see `head_of`).
/// @return         the parsed op, or `null` when the head is outside the opcode
///                 set or the operands don't parse. Both are fatal to the caller
///                 — `parse_virt_bc` turns either into a `VirtParseError` rather
///                 than step over the line and shift every following pc.
parse_op_line :: fn(cleaned: string, head: string) -> Op | null {
    dot :: head.index_of('.', 0)
    if dot >= 0 {
        width :: head.byte_slice(0, dot)

        // Width gates : we only slice the suffix for the int / f64 width
        // families. `array.X`, `bool.X`, `char.X`, `string.X`, `ref.X`,
        // `local.X`, `struct.X`, `data.X`, `fn.X`, `call.X`, `make_closure`
        // skip past the dotted block entirely — saving one slice on every
        // such line (the dominant share of `json_basics.virt`).
        is_int :: is_int_width(width)
        is_f64 :: width == "f64"
        is_char_or_f32 :: width == "char" || width == "f32"
        if is_int || is_f64 || is_char_or_f32 {
            suffix :: head.byte_slice(dot + 1, head.byte_len())

            if suffix == "const" && is_int {
                value_off :: head.byte_len() + 1
                if value_off >= cleaned.byte_len() { return null }
                text :: cleaned.byte_slice(value_off, cleaned.byte_len()).trim()
                return parse_int_const_text(text, width)
            }
            if suffix == "const" && is_f64 { return parse_f64_const(cleaned) }

            // `<from>.to_<to>` — every width, `char` included, becomes the one
            // `Convert` op the bytecode emitter itself produces. Reading a dump
            // back must yield the SAME op the compiler emitted: char conversions
            // used to be relabelled into dedicated `IntToChar` / `CharToInt` ops
            // here, so a program run from a `.virt` executed a different
            // implementation than the same program run from memory — and the two
            // did not accept the same inputs. `f32` stays a valid from-type for
            // forward compatibility even though the emit doesn't produce it.
            if suffix.starts_with("to_") {
                target :: suffix.trim_prefix("to_")
                if is_numeric_name(target) || target == "char" { return parse_convert(cleaned) }
            }

            if is_int {
                int_op :: int_op_for(width, suffix)
                if !(int_op is null) { return int_op }
            }
            if is_f64 {
                if suffix == "add" { return F64Add {} }
                if suffix == "sub" { return F64Sub {} }
                if suffix == "mul" { return F64Mul {} }
                if suffix == "div" { return F64Div {} }
                if suffix == "neg" { return F64Neg {} }
                if suffix == "eq"  { return F64Eq {} }
                if suffix == "ne"  { return F64Ne {} }
                if suffix == "lt"  { return F64Lt {} }
                if suffix == "le"  { return F64Le {} }
                if suffix == "gt"  { return F64Gt {} }
                if suffix == "ge"  { return F64Ge {} }
            }
        }
    }

    if head == "local.get"        { return parse_slot_arg(cleaned, "local.get ", true) }
    if head == "local.set"        { return parse_slot_arg(cleaned, "local.set ", false) }
    if head == "local.tee"        { return parse_local_tee(cleaned) }
    if head == "string.const"     { return parse_string_const(cleaned) }
    if head == "call.import"      { return parse_call_import(cleaned) }
    if head == "call.indirect"    { return parse_call_indirect(cleaned) }
    if head == "virtual.call"     { return parse_virtual_call(cleaned) }
    if head == "call"             { return parse_call(cleaned) }
    if head == "fn.ref"           { return parse_fn_ref(cleaned) }
    if head == "fn.addr"          { return parse_fn_addr(cleaned) }
    if head == "make_closure"     { return parse_make_closure(cleaned) }
    if head == "struct.new_stack" { return parse_struct_new_after(cleaned, "struct.new_stack ") }
    if head == "struct.new"       { return parse_struct_new_after(cleaned, "struct.new ") }
    if head == "struct.get"       { return parse_struct_get(cleaned) }
    if head == "local.field"      { return parse_local_field(cleaned) }
    if head == "union.get"        { return parse_union_field_get(cleaned) }
    if head == "union.set"        { return parse_union_field_set(cleaned) }
    if head == "return.lit"       { return parse_return_lit(cleaned) }
    if head == "struct.set_stack" { return parse_struct_set_after(cleaned, "struct.set_stack ") }
    if head == "struct.set"       { return parse_struct_set_after(cleaned, "struct.set ") }
    if head == "array.new"        { return parse_array_new(cleaned) }
    if head == "array.push"       { return parse_array_push(cleaned) }
    if head == "array.get"        { return parse_array_get(cleaned) }
    if head == "array.set"        { return parse_array_set(cleaned) }
    if head == "array.len"        { return ArrayLen {} }
    if head == "array.slice"      { return parse_array_slice(cleaned) }
    if head == "array.repeat"      { return ArrayRepeat {} }
    if head == "array.push_all"    { return ArrayPushAll {} }
    if head == "array.copy"        { return ArrayCopy {} }
    if head == "array.remove_last" { return ArrayRemoveLast {} }
    if head == "array.clear"       { return ArrayClear {} }
    if head == "data.const"       { return parse_data_const(cleaned) }
    if head == "global.get"       { return parse_global_get(cleaned) }
    if head == "global.set"       { return parse_global_set(cleaned) }
    if head == "ref.cast"         { return parse_ref_cast(cleaned) }
    if head == "retag"            { return parse_retag(cleaned) }
    if head == "intrinsic" {
        if cleaned == "intrinsic size_of.type"            { return SizeOfType {} }
        return null
    }
    if head == "null.const"     { return NullConst {} }
    if head == "bool.const"     { return parse_bool_const(cleaned) }
    if head == "bool.eq"        { return BoolEq {} }
    if head == "bool.ne"        { return BoolNe {} }
    if head == "bool.and"       { return BoolAnd {} }
    if head == "bool.or"        { return BoolOr {} }
    if head == "bool.not"       { return BoolNot {} }
    if head == "char.const"     { return parse_char_const(cleaned) }
    if head == "string.eq"      { return StringEq {} }
    if head == "string.ne"      { return StringNe {} }
    if head == "string.compare" { return StringCompare {} }
    if head == "ref.eq"         { return RefEq {} }
    if head == "ref.ne"         { return RefNe {} }
    if head == "drop"           { return Drop {} }
    if head == "type_check"     { return parse_type_check(cleaned) }
    if head == "type.const"     { return parse_type_const(cleaned) }
    if head == "defer.push"     { return DeferPush {} }
    if head == "defer.pop_exec" { return parse_defer_pop_exec(cleaned) }
    if head == "block"          { return Block {} }
    if head == "loop"           { return Loop {} }
    if head == "if"             { return If {} }
    if head == "else"           { return Else {} }
    if head == "end"            { return End {} }
    if head == "br_if"          { return BranchIf {} }
    if head == "br"             { return Branch {} }
    if head == "return"         { return Return {} }
    // `reason` is not serialised to `.virt` — the round-trip VM traps with a
    // generic message ; the in-memory run and the native build keep the reason.
    if head == "unreachable"    { return Unreachable { .reason = "" } }
    // Memory opcodes (Target ABI). `buffer.new` carries no operand ; the
    // rest are all-stack, no operands. Landed alongside
    // write_op's arms so a known op never silently drops here (which would
    // shift every following pc).
    if head == "buffer.new"     { return BufferNew {} }
    if head == "load_u8"        { return LoadU8 {} }
    if head == "load_i32"       { return LoadI32 {} }
    if head == "load_i64"       { return LoadI64 {} }
    if head == "load_f64"       { return LoadF64 {} }
    if head == "store_u8"       { return StoreU8 {} }
    if head == "store_i32"      { return StoreI32 {} }
    if head == "store_i64"      { return StoreI64 {} }
    if head == "store_f64"      { return StoreF64 {} }
    if head == "load_slot_i32"  { return LoadSlotI32 {} }
    if head == "load_slot_i64"  { return LoadSlotI64 {} }
    if head == "load_slot_f64"  { return LoadSlotF64 {} }
    if head == "store_slot_i32" { return StoreSlotI32 {} }
    if head == "store_slot_i64" { return StoreSlotI64 {} }
    if head == "store_slot_f64" { return StoreSlotF64 {} }
    if head == "memory_copy"    { return MemoryCopy {} }
    if head == "buffer_to_string" { return BufferToString {} }
    if head == "buffer_write_string" { return BufferWriteString {} }
    if head == "f64_to_bits"    { return F64ToBits {} }
    if head == "bits_to_f64"    { return BitsToF64 {} }
    if head == "f32_to_bits"    { return F32ToBits {} }
    if head == "bits_to_f32"    { return BitsToF32 {} }
    return null
}

/// Decode `<width>.<suffix>` into the matching integer op. `width` is
/// already known to satisfy `is_int_width`. Wide widths (i64/u64) route
/// to I64*; everything else collapses to I32* (the VM aliases narrow
/// integer storage classes). `shr` splits on signedness — signed widths
/// keep arithmetic shift, unsigned widths get the logical variant.
///
/// @param width   the integer width prefix (`i32`, `u8`, ..., `u64`).
/// @param suffix  the verb tail (`add`, `shl`, `neg`, ...).
/// @return        the matching op, or `null` for an unrecognised suffix.
int_op_for :: fn(width: string, suffix: string) -> Op | null {
    if suffix.starts_with("checked_") {
        return checked_op_for(width, suffix.trim_prefix("checked_"))
    }
    is_wide :: width == "i64" || width == "u64"
    // Unsigned widths route compare / div / rem to dedicated U32*/U64*
    // ops so values with the high bit set don't read as negative. add /
    // sub / mul / eq / ne / bitwise are signedness-agnostic on two's
    // complement and stay on the signed family.
    is_unsigned :: is_unsigned_width(width)
    if is_wide {
        if suffix == "add" { return I64Add {} }
        if suffix == "sub" { return I64Sub {} }
        if suffix == "mul" { return I64Mul {} }
        if suffix == "eq"  { return I64Eq {} }
        if suffix == "ne"  { return I64Ne {} }
        if suffix == "neg" { return I64Neg {} }
        if is_unsigned {
            if suffix == "div" { return U64Div {} }
            if suffix == "rem" { return U64Mod {} }
            if suffix == "lt"  { return U64Lt {} }
            if suffix == "le"  { return U64Le {} }
            if suffix == "gt"  { return U64Gt {} }
            if suffix == "ge"  { return U64Ge {} }
        }
        if suffix == "div" { return I64Div {} }
        if suffix == "rem" { return I64Mod {} }
        if suffix == "lt"  { return I64Lt {} }
        if suffix == "le"  { return I64Le {} }
        if suffix == "gt"  { return I64Gt {} }
        if suffix == "ge"  { return I64Ge {} }
        // 64-bit bitwise / shift stay in the I64 family so wide-width
        // operands don't truncate via the I32 path's i32 apply closure.
        if suffix == "bitand" { return I64BitAnd {} }
        if suffix == "bitor"  { return I64BitOr {} }
        if suffix == "bitxor" { return I64BitXor {} }
        if suffix == "bitnot" { return I64BitNot {} }
        if suffix == "shl"    { return I64Shl {} }
        if suffix == "shr" {
            if is_unsigned { return I64ShrU {} }
            return I64Shr {}
        }
    }
    if suffix == "add"    { return I32Add {} }
    if suffix == "sub"    { return I32Sub {} }
    if suffix == "mul"    { return I32Mul {} }
    if suffix == "eq"     { return I32Eq {} }
    if suffix == "ne"     { return I32Ne {} }
    if suffix == "neg"    { return I32Neg {} }
    if is_unsigned {
        if suffix == "div" { return U32Div {} }
        if suffix == "rem" { return U32Mod {} }
        if suffix == "lt"  { return U32Lt {} }
        if suffix == "le"  { return U32Le {} }
        if suffix == "gt"  { return U32Gt {} }
        if suffix == "ge"  { return U32Ge {} }
    }
    if suffix == "div"    { return I32Div {} }
    if suffix == "rem"    { return I32Mod {} }
    if suffix == "lt"     { return I32Lt {} }
    if suffix == "le"     { return I32Le {} }
    if suffix == "gt"     { return I32Gt {} }
    if suffix == "ge"     { return I32Ge {} }
    if suffix == "bitnot" { return I32BitNot {} }
    if suffix == "bitand" { return I32BitAnd {} }
    if suffix == "bitor"  { return I32BitOr {} }
    if suffix == "bitxor" { return I32BitXor {} }
    if suffix == "shl"    { return I32Shl {} }
    if suffix == "shr" {
        if is_unsigned { return I32ShrU {} }
        return I32Shr {}
    }
    return null
}

// `<width>.checked_<name>`: the checked op on the exact integer type `width`.
checked_op_for :: fn(width: string, name: string) -> Op | null {
    kind :: parse_val_type(width) ?? return null
    if name == "add" { return CheckedArith { .kind = kind, .op = .Add } }
    if name == "sub" { return CheckedArith { .kind = kind, .op = .Sub } }
    if name == "mul" { return CheckedArith { .kind = kind, .op = .Mul } }
    if name == "neg" { return CheckedNeg { .kind = kind } }
    return null
}

/// Parse the operand of `<width>.const N`. Values that fit signed-i32
/// stay as `I32Const` ; values outside that range promote to `I64Const`
/// so the unsigned wide widths (e.g. `u32.const 4000000000`) survive
/// without wraparound. Downstream `read_i32` truncates the i64 back to
/// i32 when an i32 consumer wants it.
parse_int_const_text :: fn(rest: string, width: string) -> Op | null {
    // 64-bit widths must NEVER collapse to `I32Const` even when the value
    // fits signed-i32 : an `I32Val` only carries 32 bits, so a wide unsigned
    // value whose i64 form happens to fit i32 (e.g. `u64 18446744073700000000`
    // = i64 -9551616) loses its high bits and the unsigned-display host then
    // renders only the low 32 (`4285415680`). Preserving `I64Const` keeps the
    // full bit pattern ; signed consumers still read it via `read_i64`.
    is_wide :: width == "i64" || width == "u64"
    // Negative literals : both emitters print `<width>.const -N` directly
    // (signed widths only — unsigned widths never carry a sign), so a
    // leading `-` strips to the magnitude, which we parse unsigned and
    // negate. The fit-check then routes to I32Const / I64Const exactly
    // like the positive path ; `read_i64` sign-extends an I32Val(-N) back
    // to the right i64, so an `i64.const -1` that collapses to I32Const is
    // read correctly downstream.
    if rest.starts_with("-") {
        mag :: parse_uint_in_base(rest.trim_prefix("-"), 10)
        if mag is ParseError { return null }
        signed :: 0 - i64(mag)
        if !is_wide && signed >= -0x80000000 && signed <= 0x7fffffff {
            return I32Const { .value = i32(signed) }
        }
        return I64Const { .value = signed }
    }
    // Non-negative path : parse as `u64` to catch the full unsigned range
    // — i.e. literals up to `u64.MAX`. Values that don't fit signed-i64
    // still round-trip by reinterpreting the bit pattern when we drop into
    // `I64Const`, and the host display arms pick the right signedness from
    // the op sequence that surrounds the const.
    parsed :: parse_uint_in_base(rest, 10)
    if parsed is ParseError { return null }
    if !is_wide && parsed <= 0x7fffffff {
        return I32Const { .value = i32(parsed) }
    }
    return I64Const { .value = i64(parsed) }
}

/// True iff `width` is one of the 8 integer prefixes the VM recognises
/// (`i8` / `i16` / `i32` / `i64` / `u8` / `u16` / `u32` / `u64`).
/// `parse_op_line` and `int_op_for` read this to gate the `<width>.<verb>`
/// dispatch.
///
/// @param width  the prefix candidate.
/// @return       `true` for any of the 8 supported integer widths.
is_int_width :: fn(width: string) -> bool = is_int_name(width)

/// True iff `width` is one of the 4 unsigned integer prefixes. Used by
/// `int_op_for` to route cmp / div / rem / shr to the U* family so the
/// signedness is respected.
///
/// @param width  the prefix candidate.
/// @return       `true` for `u8` / `u16` / `u32` / `u64`.
is_unsigned_width :: fn(width: string) -> bool = is_unsigned_int_name(width)

/// Strip `prefix` from `line`, trim, and parse the rest as a base-10
/// integer. The five op-with-int parsers below all delegate here so the
/// "slice prefix → parse_int_in_base → unwrap" pattern lives in one
/// place ; each wrapper only contributes the variant constructor.
///
/// @param line    the full .virt line (already comment-stripped).
/// @param prefix  literal prefix to strip (e.g. `"i32.const "`).
/// @return        the parsed i32, or `null` if the remainder isn't
///                a valid base-10 number.
parse_int_after_prefix :: fn(line: string, prefix: string) -> i32 | null {
    rest :: line.byte_slice(prefix.byte_len(), line.byte_len()).trim()
    parsed :: parse_int_in_base(rest, 10)
    if parsed is ParseError { return null }
    return i32(parsed)
}

/// Parse a `<from>.to_<to>` line into the matching `Convert`. Only
/// the target width affects runtime semantics — the executor re-tags
/// the top of the stack to the target's storage class.
///
/// @param cleaned  the .virt line, already comment-stripped.
/// @return         the `Convert` op carrying the target tag.
parse_convert :: fn(cleaned: string) -> Op {
    dot :: cleaned.index_of('.', 0)
    prefix :: cleaned.byte_slice(0, dot)
    suffix :: cleaned.byte_slice(dot + 1 + 3, cleaned.byte_len())
    return Convert { .from_name = prefix, .target = convert_target_named(suffix) }
}

/// Collapse a target width to its `ConvertTarget` storage class. Every
/// integer width below 64 bits collapses to `I32` ; `i64` / `u64` map
/// to `I64` ; floats to `F64` ; `char` to `Char`.
///
/// @param width  the target width literal (`i32`, `f64`, `char`, ...).
/// @return       the matching `ConvertTarget`.
convert_target_named :: fn(width: string) -> ConvertTarget {
    v :: parse_val_type(width) ?? return .I32
    return convert_target_of(v) ?? .I32
}

parse_slot_arg :: fn(line: string, prefix: string, is_get: bool) -> Op | null {
    parsed :: parse_int_after_prefix(line, prefix) ?? return null
    if is_get { return LocalGet { .slot = parsed } }
    return LocalSet { .slot = parsed }
}

/// Parse `f64.const <decimal> <u64 bits>`, where the trailing `u64` is the
/// exact IEEE-754 bit pattern and the leading decimal is its readable Ryu
/// rendering (informational, for diffs). Reconstructing via `from_bits` makes
/// subnormals / scientific / near-max values round-trip exactly — the decimal
/// parser alone cannot (it overflows past ~1e308 and can't reach subnormals).
///
/// Non-finite values dump with NO bit column — a bare abstract word `inf` /
/// `-inf` / `nan` (see `emit/virt::f64_const_operands`) — because ±inf are unique,
/// every NaN is one value, and a NaN's raw bits aren't architecturally stable.
/// Each word maps straight back to its canonical bit pattern here. Legacy
/// single-token `f64.const N.M` finite lines fall back to the decimal parser.
///
/// @param line  the comment-stripped op line.
/// @return      `F64Const { value }` on success, `null` on malformed input.
parse_f64_const :: fn(line: string) -> Op | null {
    rest :: line.trim_prefix("f64.const ").trim()
    // Abstract non-finite words carry no bit column — map each to its canonical
    // IEEE-754 pattern (typed so the >i64 hex constants pin to `u64`).
    pos_inf: u64: 0x7FF0000000000000
    neg_inf: u64: 0xFFF0000000000000
    quiet_nan: u64: 0x7FF8000000000000
    if rest == "inf"  { return F64Const { .value = pos_inf.from_bits() } }
    if rest == "-inf" { return F64Const { .value = neg_inf.from_bits() } }
    if rest == "nan"  { return F64Const { .value = quiet_nan.from_bits() } }
    sp :: last_index_of_space(rest)
    if sp >= 0 {
        bits :: parse_uint_in_base(rest.byte_slice(i64(sp) + 1, rest.byte_len()), 10)
        if bits is u64 { return F64Const { .value = bits.from_bits() } }
    }
    parsed :: parse_f64(rest) ?? return null
    return F64Const { .value = parsed }
}

parse_string_const :: fn(line: string) -> Op | null {
    parsed :: parse_int_after_prefix(line, "string.const ") ?? return null
    return StringConst { .index = parsed }
}

parse_call_import :: fn(line: string) -> Op | null {
    parsed :: parse_int_after_prefix(line, "call.import ") ?? return null
    return CallImport { .index = parsed }
}

parse_call :: fn(line: string) -> Op | null {
    parsed :: parse_int_after_prefix(line, "call ") ?? return null
    return Call { .function_index = parsed }
}

/// Parse `bool.const true` / `bool.const false`. The bytecode
/// writer only emits the textual literal —
/// no numeric path to support.
///
/// @param line  the .virt line (comment-stripped).
/// @return      `BoolConst { value }`, or `null` on malformed input.
parse_bool_const :: fn(line: string) -> Op | null {
    rest :: line.trim_prefix("bool.const ").trim()
    if rest == "true"  { return BoolConst { .value = true  } }
    if rest == "false" { return BoolConst { .value = false } }
    return null
}

/// Parse `char.const N` where N is the codepoint as a base-10 integer.
parse_char_const :: fn(line: string) -> Op | null {
    parsed :: parse_int_after_prefix(line, "char.const ") ?? return null
    return CharConst { .value = char(u32(parsed)) }
}

parse_call_indirect :: fn(line: string) -> Op | null {
    parsed :: parse_int_after_prefix(line, "call.indirect ") ?? return null
    return CallIndirect { .type_id = parsed }
}

/// Parse `virtual.call PARAM_COUNT VTABLE_KEY` — the vtable key is the
/// remainder of the line (it contains a `.`, never a space).
///
/// @param line  the .virt line (comment-stripped).
/// @return      `VirtualCall { parameter_count, vtable_key }`, or `null`
///              on malformed input.
parse_virtual_call :: fn(line: string) -> Op | null {
    rest :: line.trim_prefix("virtual.call ").trim()
    space :: rest.index_of(' ', 0)
    if space < 0 { return null }
    pc_text :: rest.byte_slice(0, space).trim()
    parsed_pc :: parse_int_in_base(pc_text, 10)
    if parsed_pc is ParseError { return null }
    key :: rest.byte_slice(space + 1, rest.byte_len()).trim()
    return VirtualCall { .parameter_count = i32(parsed_pc), .vtable_key = key }
}

/// Parse `fn.ref FN_INDEX TYPE_ID` — the TYPE_ID operand is parsed
/// (and validated) but not stored on the op : it's a static-type hint,
/// not needed at runtime since `call.indirect` carries its own type_id
/// that drives the call's parameter count.
///
/// @param line  the .virt line (comment-stripped).
/// @return      `FnRef { function_index }`, or `null` on malformed input.
parse_fn_ref :: fn(line: string) -> Op | null {
    pair :: parse_int_pair_after_prefix(line, "fn.ref ") ?? return null
    [fn_idx, type_id] :: pair
    return FnRef { .function_index = fn_idx, .type_id = type_id }
}

/// Parse `fn.addr FN_INDEX` — the address of the function's own compiled code.
///
/// Carries no type hint: unlike `fn.ref` there is no `FnVal` to type, and the
/// signature the address is called through belongs to the foreign callee.
///
/// @param line  the .virt line (comment-stripped).
/// @return      `FnAddr`, or `null` on malformed input.
parse_fn_addr :: fn(line: string) -> Op | null {
    idx :: parse_int_after_prefix(line, "fn.addr ") ?? return null
    return FnAddr { .function_index = idx }
}

/// Parse `make_closure FN_INDEX ENV_TYPE_ID` — same shape as `fn.ref`,
/// trailing ENV_TYPE_ID is the captured-env struct's type-table index.
///
/// @param line  the .virt line (comment-stripped).
/// @return      `MakeClosure { function_index, env_type_id }`, or `null` on malformed input.
parse_make_closure :: fn(line: string) -> Op | null {
    pair :: parse_int_pair_after_prefix(line, "make_closure ") ?? return null
    [fn_idx, env_type_id] :: pair
    return MakeClosure { .function_index = fn_idx, .env_type_id = env_type_id }
}

parse_type_check :: fn(line: string) -> Op | null {
    parsed :: parse_int_after_prefix(line, "type_check ") ?? return null
    return TypeCheck { .type_id = parsed }
}

parse_ref_cast :: fn(line: string) -> Op | null {
    parsed :: parse_int_after_prefix(line, "ref.cast ") ?? return null
    return RefCast { .type_id = parsed }
}

parse_retag :: fn(line: string) -> Op | null {
    parsed :: parse_int_after_prefix(line, "retag ") ?? return null
    return Retag { .type_id = parsed }
}

parse_type_const :: fn(line: string) -> Op | null {
    parsed :: parse_int_after_prefix(line, "type.const ") ?? return null
    return TypeConst { .type_id = parsed }
}

parse_defer_pop_exec :: fn(line: string) -> Op | null {
    parsed :: parse_int_after_prefix(line, "defer.pop_exec ") ?? return null
    return DeferPopExec { .count = parsed }
}

parse_local_tee :: fn(line: string) -> Op | null {
    parsed :: parse_int_after_prefix(line, "local.tee ") ?? return null
    return LocalTee { .slot = parsed }
}

parse_struct_new_after :: fn(line: string, prefix: string) -> Op | null {
    parsed :: parse_int_after_prefix(line, prefix) ?? return null
    stack :: prefix == "struct.new_stack "
    return StructNew { .type_id = parsed, .stack = stack }
}

/// Parse two space-separated base-10 ints after `prefix`. Used by
/// every op carrying exactly two int operands (struct.get/set's
/// TID + FIELD_INDEX, array.new's TID + LENGTH, ...).
///
/// @param line    the .virt line (comment-stripped).
/// @param prefix  literal prefix to skip (e.g. `"struct.get "`).
/// @return        the parsed pair ; `null` on malformed input.
parse_int_pair_after_prefix :: fn(line: string, prefix: string) -> [i32, i32] | null {
    rest :: line.byte_slice(prefix.byte_len(), line.byte_len()).trim()
    space :: rest.index_of(' ', 0)
    if space < 0 { return null }
    a :: parse_int_in_base(rest.byte_slice(0, space).trim(), 10)
    if a is ParseError { return null }
    b :: parse_int_in_base(rest.byte_slice(space + 1, rest.byte_len()).trim(), 10)
    if b is ParseError { return null }
    return [i32(a), i32(b)]
}

parse_struct_get :: fn(line: string) -> Op | null {
    pair :: parse_int_pair_after_prefix(line, "struct.get ") ?? return null
    [tid, fi] :: pair
    return StructGet { .type_id = tid, .field_index = fi }
}

parse_union_field_get :: fn(line: string) -> Op | null {
    pair :: parse_int_pair_after_prefix(line, "union.get ") ?? return null
    [tid, fi] :: pair
    return UnionFieldGet { .type_id = tid, .field_index = fi }
}

parse_union_field_set :: fn(line: string) -> Op | null {
    pair :: parse_int_pair_after_prefix(line, "union.set ") ?? return null
    [tid, fi] :: pair
    return UnionFieldSet { .type_id = tid, .field_index = fi }
}

/// Parse `local.field SLOT TYPE FIELD` — three whitespace-separated
/// non-negative integers after the `local.field ` prefix.
///
/// @param line  full line, leading whitespace already stripped.
/// @return      a `LocalField` op on success, `null` on any parse error
///              (missing space, non-integer token, …).
parse_local_field :: fn(line: string) -> Op | null {
    rest :: line.trim_prefix("local.field ").trim()
    s1 :: rest.index_of(' ', 0)
    if s1 < 0 { return null }
    s2 :: rest.index_of(' ', s1 + 1)
    if s2 < 0 { return null }
    slot_str :: rest.byte_slice(0, s1).trim()
    type_str :: rest.byte_slice(s1 + 1, s2).trim()
    field_str :: rest.byte_slice(s2 + 1, rest.byte_len()).trim()
    slot :: parse_int_in_base(slot_str, 10)
    if slot is ParseError { return null }
    tid :: parse_int_in_base(type_str, 10)
    if tid is ParseError { return null }
    fi :: parse_int_in_base(field_str, 10)
    if fi is ParseError { return null }
    return LocalField { .slot = i32(slot), .type_id = i32(tid), .field_index = i32(fi) }
}

/// Parse `return.lit <inner-const-op>` — the inner literal is parsed
/// recursively through `parse_op_line`, then validated to be a const
/// variant. Examples: `return.lit i32.const 42`, `return.lit bool.const true`,
/// `return.lit string.const 0`, `return.lit null.const`.
///
/// @param line  full line, leading whitespace already stripped.
/// @return      a `ReturnLit` op on success, `null` when the inner op
///              isn't a recognised const-producing op.
parse_return_lit :: fn(line: string) -> Op | null {
    inner_raw :: line.trim_prefix("return.lit ").trim()
    inner_head :: head_of(inner_raw)
    inner_op :: parse_op_line(inner_raw, inner_head) ?? return null
    const_inner :: const_op_of(inner_op) ?? return null
    return ReturnLit { .value = const_inner }
}

parse_struct_set_after :: fn(line: string, prefix: string) -> Op | null {
    pair :: parse_int_pair_after_prefix(line, prefix) ?? return null
    [tid, fi] :: pair
    stack :: prefix == "struct.set_stack "
    return StructSet { .type_id = tid, .field_index = fi, .stack = stack }
}

parse_array_new :: fn(line: string) -> Op | null {
    pair :: parse_int_pair_after_prefix(line, "array.new ") ?? return null
    [tid, len] :: pair
    return ArrayNew { .type_id = tid, .length = len }
}

// `array.push TYPE` or `array.push TYPE SLOT` — the second form carries the
// push-cache hint (`push_cache.vader`). The VM ignores the hint and runs the
// ordinary push either way.
parse_array_push :: fn(line: string) -> Op | null {
    pair :: parse_int_pair_after_prefix(line, "array.push ")
    if pair != null {
        [tid, cache_slot] :: pair
        return ArrayPush { .type_id = tid, .cache_slot = cache_slot }
    }
    parsed :: parse_int_after_prefix(line, "array.push ") ?? return null
    return ArrayPush { .type_id = parsed }
}

parse_array_get :: fn(line: string) -> Op | null {
    parsed :: parse_int_after_prefix(line, "array.get ") ?? return null
    return ArrayGet { .type_id = parsed }
}

parse_array_set :: fn(line: string) -> Op | null {
    parsed :: parse_int_after_prefix(line, "array.set ") ?? return null
    return ArraySet { .type_id = parsed }
}

parse_array_slice :: fn(line: string) -> Op | null {
    parsed :: parse_int_after_prefix(line, "array.slice ") ?? return null
    return ArraySlice { .type_id = parsed }
}

parse_data_const :: fn(line: string) -> Op | null {
    after :: line.trim_prefix("data.const ")
    sp :: after.index_of(' ', 0)
    if sp < 0 { return null }
    pool_text :: after.byte_slice(0, sp)
    type_text :: after.byte_slice(sp + 1, after.byte_len()).trim()
    pool_parsed :: parse_int_in_base(pool_text, 10)
    if pool_parsed is ParseError { return null }
    type_parsed :: parse_int_in_base(type_text, 10)
    if type_parsed is ParseError { return null }
    return DataConst { .pool_index = i32(pool_parsed), .type_id = i32(type_parsed) }
}

// `global.get <slot>`.
parse_global_get :: fn(line: string) -> Op | null {
    index :: parse_int_after_prefix(line, "global.get ") ?? return null
    return GlobalGet { .index = index }
}

// `global.set <slot>`.
parse_global_set :: fn(line: string) -> Op | null {
    index :: parse_int_after_prefix(line, "global.set ") ?? return null
    return GlobalSet { .index = index }
}

// ---- tests ----------------------------------------------------------------

import "std/string_builder"
import "std/testing"
import "vader/emit/virt"

/// Round-trip an op through `write_op` (the canonical mnemonic writer,
/// `emit/virt/dump.vader`) and `parse_op_line`, returning the re-serialised text. A parse
/// miss returns a sentinel so the asserting test fails with the offending
/// mnemonic rather than a bare `null`.
roundtrip_op_text :: fn(op: Op) -> string {
    sb :: StringBuilder {}
    write_op(sb, op)
    text :: "${sb}"
    parsed :: parse_op_line(text, head_of(text)) ?? return "PARSE-FAIL: ${text}"
    sb2 :: StringBuilder {}
    write_op(sb2, parsed)
    return "${sb2}"
}

@test test_memory_opcode_roundtrip :: fn() -> void {
    // The Target ABI memory opcodes. `buffer.new` carries no operand
    // immediate ; the rest are operand-free. Each must survive write_op →
    // parse_op_line → write_op unchanged — proving parse ≠ null and that the
    // op (and its immediate) is preserved, so a synthetic op stream keeps its
    // pc indices. Includes the width-typed array slot family.
    assert_eq(roundtrip_op_text(BufferNew {}),  "buffer.new")
    assert_eq(roundtrip_op_text(LoadU8 {}),     "load_u8")
    assert_eq(roundtrip_op_text(LoadI32 {}),    "load_i32")
    assert_eq(roundtrip_op_text(LoadI64 {}),    "load_i64")
    assert_eq(roundtrip_op_text(LoadF64 {}),    "load_f64")
    assert_eq(roundtrip_op_text(StoreU8 {}),    "store_u8")
    assert_eq(roundtrip_op_text(StoreI32 {}),   "store_i32")
    assert_eq(roundtrip_op_text(StoreI64 {}),   "store_i64")
    assert_eq(roundtrip_op_text(StoreF64 {}),   "store_f64")
    assert_eq(roundtrip_op_text(LoadSlotI32 {}),   "load_slot_i32")
    assert_eq(roundtrip_op_text(LoadSlotI64 {}),   "load_slot_i64")
    assert_eq(roundtrip_op_text(LoadSlotF64 {}),   "load_slot_f64")
    assert_eq(roundtrip_op_text(StoreSlotI32 {}),  "store_slot_i32")
    assert_eq(roundtrip_op_text(StoreSlotI64 {}),  "store_slot_i64")
    assert_eq(roundtrip_op_text(StoreSlotF64 {}),  "store_slot_f64")
    assert_eq(roundtrip_op_text(MemoryCopy {}), "memory_copy")
    assert_eq(roundtrip_op_text(BufferToString {}), "buffer_to_string")
    assert_eq(roundtrip_op_text(BufferWriteString {}), "buffer_write_string")
    assert_eq(roundtrip_op_text(F64ToBits {}),  "f64_to_bits")
    assert_eq(roundtrip_op_text(BitsToF64 {}),  "bits_to_f64")
    assert_eq(roundtrip_op_text(F32ToBits {}),  "f32_to_bits")
    assert_eq(roundtrip_op_text(BitsToF32 {}),  "bits_to_f32")
}

@test test_f64_const_non_finite_roundtrip :: fn() -> void {
    // Non-finite f64 consts dump as a bare abstract word (no bit column) and
    // parse straight back — arch-stable by construction. A sign-set NaN (what
    // x86-64 folds `0.0 / 0.0` to) must round-trip to `nan`, never its raw
    // arch-specific bits.
    pos_inf: u64: 0x7FF0000000000000
    neg_inf: u64: 0xFFF0000000000000
    neg_nan: u64: 0xFFF8000000000000
    assert_eq(roundtrip_op_text(F64Const { .value = pos_inf.from_bits() }), "f64.const inf")
    assert_eq(roundtrip_op_text(F64Const { .value = neg_inf.from_bits() }), "f64.const -inf")
    assert_eq(roundtrip_op_text(F64Const { .value = neg_nan.from_bits() }), "f64.const nan")

    // A finite value keeps its exact bit column and round-trips unchanged.
    finite: f64: 3.5
    assert_eq(roundtrip_op_text(F64Const { .value = finite }), "f64.const ${finite} ${finite.to_bits()}")
}
