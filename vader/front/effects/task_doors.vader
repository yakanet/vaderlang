// vader/front/effects/task_doors: the functions a task goes through.
//
// The primitives of `std/task` launch a task, wait for one, hand a message on, hold
// a lock. What each is to a task is a row of the compiler's closed table
// (`vader/core/types/task_runtime.vader`), and the row stands for the body a
// primitive may have: that body shares a task's state with the threads of the
// runtime, which no task may race on. What a primitive does to what it is lent is
// read from its row too. A function that calls a primitive is read from its body.
//
// A task is a task of `std/task`: a thread started straight through
// `std/runtime/scheduler`, as the VM runs the threads of the program it runs, is
// the runtime's, which the check does not see. Only parking reaches it, so that a
// block holding a lock parks wherever its callees park.

module "vader/front/effects"

import "std/collections"
import "std/iter"
import "vader/core/types"
import "vader/front/typecheck"

AST :: import "toolchain/ast"

/// What the primitive `p`, declaring `params` parameters, does with each of them.
///
/// @param paths   the summary's paths.
/// @param p       the primitive's row.
/// @param params  how many parameters it declares.
primitive_effects :: fn(paths: PathTable, p: TaskPrimitive, params: i64) -> ParamEffects[] =
    (0..<params).map((q) -> lent_effects(paths, p, q)).collect()

// What the primitive `p` does with its parameter `q`: what it hands back of the task
// it joins, the value it hands on, or what it does to the struct it is lent first.
lent_effects :: fn(paths: PathTable, p: TaskPrimitive, q: i64) -> ParamEffects {
    if p.joins == q {
        return joined_effects(paths, p.joins_array)
    }
    if p.gives == q {
        return effects_of(.Stored, ROOT)
    }
    effects :: none()
    if q != 0 {
        return effects
    }
    if p.writes != "" {
        effects.insert(Access { .path = paths.path_to(p.writes), .effect = .Assigned })
    }
    if p.grows != "" {
        effects.insert(Access { .path = paths.path_to(p.grows), .effect = .Resized })
    }
    if p.guards != "" {
        // The fn holding the lock may do anything with the guarded value, keep it
        // included.
        guarded :: paths.cut(paths.path_to(p.guards))
        effects.insert(Access { .path = guarded, .effect = .Stored })
        effects.insert(Access { .path = guarded, .effect = .Unknown })
    }
    return effects
}

// What a join hands back: what the task returned, which its result holds once it
// ended ; for a combinator, what each task of its array returned.
joined_effects :: fn(paths: PathTable, each: bool) -> ParamEffects {
    result :: element_of(paths, TASK_RESULT)
    if each {
        return effects_of(.Returned, paths.joined(paths.path_to(ELEMENT), result))
    }
    return effects_of(.Returned, result)
}

// The path to an element of the array field `field`.
element_of :: fn(paths: PathTable, field: string) -> i32 =
    paths.child(paths.path_to(field), paths.step_id(ELEMENT))

/// What `callee` is to the task check, when it is a primitive ; null for any other
/// callee.
///
/// @param index   the project's functions.
/// @param callee  what a call settles on.
door_of :: fn(index: CalleeIndex, callee: Callee) -> TaskPrimitive | null {
    if callee !is DirectFn {
        return null
    }
    return index.doors[callee.decl.id]
}

/// Whether `callee` runs its parameter `q` holding a lock, on the value the lock
/// guards.
///
/// @param index   the project's functions.
/// @param callee  what a call settles on.
/// @param q       the parameter's position.
holds_lock_for :: fn(index: CalleeIndex, callee: Callee, q: i64) -> bool {
    door :: index.door_of(callee) else return false
    return door.exclusive == q
}

// What parameter `q` of the primitive `callee` is to a task ; null when nothing:
// the fn a task runs, or a value handed on to tasks that may do anything with it.
intrinsic_sending :: fn(index: CalleeIndex, callee: Callee, q: i64) -> Sending | null {
    if callee !is DirectFn {
        return null
    }
    door :: index.doors[callee.decl.id] else return null
    if door.runs == q {
        return Sending { .runs = true, .launcher = callee.decl.name }
    }
    if door.gives == q {
        return Sending {
            .given = [EVERYWHERE],
            .written = [EVERYWHERE],
            .launcher = callee.decl.name,
        }
    }
    return null
}

// Whether `callee` hands something to a task, or holds a lock for a lambda.
opens_door :: fn(index: CalleeIndex, callee: Callee) -> bool {
    door :: index.door_of(callee) else return false
    return door.runs != null || door.gives != null || door.exclusive != null
}

// What the call to `callee`, summarised without its body, reaches: a C function
// bound to the main thread, a primitive that parks. Empty for any other callee.
summarised_reach :: fn(index: CalleeIndex, callee: Callee) -> Reach {
    out :: Reach {}
    if callee !is DirectFn || callee.decl.id !in index.summarised {
        return out
    }
    if AST.decorators_have(callee.decl.decorators, "main_thread") {
        out.main_thread = [callee.decl.name]
    }
    door :: index.doors[callee.decl.id]
    if door != null && door.parks {
        out.parks = [callee.decl.name]
    }
    return out
}

// The name of the primitive `callee`, as a detail names the door it opens.
intrinsic_name :: fn(callee: Callee) -> string {
    if callee is DirectFn {
        return callee.decl.name
    }
    return ""
}
