// vader/front/effects/walk: a function's body read into its skeleton.
//
// One pass over the typed body, writing down what it does with the values it is
// lent (`skeleton.vader`). A value's slot holds the parameters it may be reached
// from. Locals are aliases: a local's slot holds the roots of everything bound
// or assigned to it, wherever in the body, which needs no order between the
// statements ; but a name bound to a frozen value holds a copy of it
// (`frozen.vader`). A write is recorded by its form (`p.f = v`, `xs[i] = v`),
// whatever the type it writes through.
//
// What escapes the call is stored: a value put in a field or an element. A value
// the function returns is returned, so that its caller holds it through the
// result ; one a generator yields lies below the iterator its call returns, at
// `ITEM`. What a lambda returns goes to whoever calls it, which may be anyone:
// stored.
//
// A frame that outlives the call is no escape: the frame of a function that
// suspends, the bindings a lambda captures. Nothing but the code walked here
// reaches them, and the walk records all that code does with them.

module "vader/front/effects"

import "std/collections"
import "std/iter"
import "toolchain/span"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/typecheck"

AST :: import "toolchain/ast"

/// The state of the walk of one body.
WalkCtx :: struct {
    s: Skeleton
    typed: TypedProgram
    index: CalleeIndex
    /// Symbol id → slot, for the parameters that hold references and the locals.
    slots: Map<i32, i64> = Map<i32, i64> {}
    /// How many lambdas the walk is inside.
    lambda_depth: i32 = 0
    /// What the body's own result undergoes: returned to the caller, or kept for
    /// the whole run by a `@singleton`.
    result_effect: Effect = .Returned
    /// Where the walk notes what it does with frozen values (`frozen.vader`).
    frozen: FrozenSites
    /// Where the walk notes the arguments the typecheck widened (`variance.vader`).
    widenings: PendingWidening[]
    /// The roots the frozen checks decide: each use of a frozen value, each binding.
    roots: FrozenRoot[] = []
    /// The name nodes a write lands below, `c` in `c.n = 0` or `c.n += 1`: no read.
    place_bases: Set<i64> = Set<i64> {}
    /// The slots that hold nothing but frozen values: a use of a constant or of an
    /// enum's variant data, a step below such a slot, a join of such slots.
    pure: Set<i64> = Set<i64> {}
    /// The locals and parameters a write into may be seen through, by symbol id:
    /// those the body reads, and those that may hold anything but frozen values.
    seen_names: Set<i32> = Set<i32> {}
    /// Set while the walk reaches a lambda handed to a call: its parameters get
    /// slots, which the task check gives roots to.
    binds_lambda_params: bool = false
    /// The slots of the parameters of the lambda the walk last bound so.
    lambda_params: i64[] = []
    /// Symbol id -> position, for every parameter: a call of one that holds a
    /// function value hands its arguments on to the caller's (`CalledParam`).
    param_positions: Map<i32, i64> = Map<i32, i64> {}
}

/// The skeleton of `decl`'s body.
///
/// @param decl       a function with a body.
/// @param typed      the module that typed it.
/// @param index      the project's functions, to resolve its calls.
/// @param frozen     where the walk notes what the body does with frozen values.
/// @param widenings  where the walk notes the arguments the typecheck widened.
/// @param node       the function's node in the call graph.
skeleton_of :: fn(
    decl: AST.FnDecl,
    typed: TypedProgram,
    index: CalleeIndex,
    frozen: FrozenSites,
    widenings: PendingWidening[],
    node: i32,
) -> Skeleton {
    ctx :: WalkCtx {
        .s = new_skeleton(decl.params.len()),
        .typed = typed,
        .index = index,
        .frozen = frozen,
        .widenings = widenings,
        .result_effect = result_effect_of(decl),
    }
    for i in 0..<decl.params.len() {
        p :: decl.params[i]
        sym :: typed.resolved.idents[p.span.hash()] ?? continue
        ctx.param_positions[sym.id] = i
        if holds_references(typed.param_types[p.span.hash()]) {
            ctx.slots[sym.id] = i
            ctx.seen_names.add(sym.id)
        }
    }
    body :: decl.body ?? return ctx.s
    result :: ctx.block_value(body)
    ctx.escape(result, ctx.result_effect, body.span)
    ctx.note_frozen_body(node, null)
    return ctx.s
}

// ---- statements -----------------------------------------------------------

stmt :: fn(ctx: WalkCtx, s: AST.Stmt) -> void {
    match s {
        is AST.LetStmt               -> { ctx.bind(s.binding, ctx.value(s.value)) }
        is AST.AssignStmt            -> {
            ctx.note_place(s.target)
            ctx.assign(s.target, ctx.value(s.value))
        }
        is AST.DestructureAssignStmt -> { ctx.destructure_assign(s) }
        is AST.ExprStmt              -> { ctx.discard(s.expr) }
        is AST.ReturnStmt            -> { ctx.return_stmt(s) }
        is AST.YieldStmt             -> { ctx.yielded(ctx.value(s.value), s.span) }
        is AST.ForStmt               -> { ctx.for_stmt(s) }
        is AST.BreakStmt | AST.ContinueStmt -> {}
        is AST.DeferStmt             -> { ctx.defer_stmt(s) }
    }
}

return_stmt :: fn(ctx: WalkCtx, s: AST.ReturnStmt) -> void {
    value :: s.value ?? return
    ctx.escape(ctx.value(value), ctx.return_effect(), s.span)
}

// A `return` hands its value to the caller ; inside a lambda, to whoever calls the
// lambda.
return_effect :: fn(ctx: WalkCtx) -> Effect {
    if ctx.lambda_depth > 0 {
        return .Stored
    }
    return ctx.result_effect
}

// A generator hands out what it yields through the iterator its call returns.
yielded :: fn(ctx: WalkCtx, value: i64 | null, at: Span) -> void {
    held :: value ?? return
    ctx.s.add_mark(held, ROOT, .Returned, at, ctx.index.paths.path_to(ITEM))
}

// A `@singleton` keeps what its body builds for the whole run: kept, not returned.
result_effect_of :: fn(decl: AST.FnDecl) -> Effect {
    if AST.decorators_have(decl.decorators, "singleton") {
        return .Stored
    }
    return .Returned
}

defer_stmt :: fn(ctx: WalkCtx, s: AST.DeferStmt) -> void {
    match body :: s.body {
        is AST.DeferStmtBody  -> { ctx.stmt(body.stmt) }
        is AST.DeferBlockBody -> { ctx.block_value(body.block) }
    }
}

for_stmt :: fn(ctx: WalkCtx, s: AST.ForStmt) -> void {
    match form :: s.form {
        is AST.InfiniteFor -> {}
        is AST.WhileFor    -> { ctx.discard(form.cond) }
        is AST.InFor       -> {
            element :: ctx.loop_element(form.iter, ctx.value(form.iter))
            match var :: form.loop_var {
                is AST.NamedVar       -> { ctx.bind_symbol(var.span, element) }
                is AST.DestructureVar -> { ctx.bind(var.pattern, element) }
                is AST.DiscardVar     -> {}
            }
        }
    }
    ctx.block_value(s.body)
}

// What each step of a `for` over `iter` hands its variable: an element of an array,
// or what the iterator's `next` returns, the iterator being what `into` makes of
// the iterable. A value a generator yields lies below its iterator, where no
// `next` of the project reaches.
loop_element :: fn(ctx: WalkCtx, iter: AST.Expr, iterable: i64 | null) -> i64 | null {
    if ctx.steps_through_elements(iter) {
        return ctx.step_slot(iterable, ELEMENT)
    }
    iterator :: ctx.converted_by(ctx.site_callee(.IterInto, iter.id), iterable, iter)
    return ctx.union_of([ctx.stepped(iter, iterator), ctx.step_slot(iterator, ITEM)])
}

// What the `next` a step of a `for` over `iter` calls returns of `iterator`. The
// iterator of a generator's call steps through the generator's body, which that
// call has done to what it was handed: no call of its own.
stepped :: fn(ctx: WalkCtx, iter: AST.Expr, iterator: i64 | null) -> i64 | null {
    next :: ctx.site_callee(.IterNext, iter.id)
    if next is DirectFn && ctx.index.is_generator(next.decl) {
        return null
    }
    return ctx.call(next, [iterator], iter.span)
}

// Whether a `for` over `iter` binds the elements of an array, with no iterator.
steps_through_elements :: fn(ctx: WalkCtx, iter: AST.Expr) -> bool {
    next :: ctx.site_callee(.IterNext, iter.id)
    return next == null || next is Builtin
}

destructure_assign :: fn(ctx: WalkCtx, s: AST.DestructureAssignStmt) -> void {
    value :: ctx.value(s.value)
    for t in s.targets {
        match t {
            is AST.PlaceTarget    -> {
                ctx.note_place(t.place)
                ctx.assign(t.place, ctx.step_slot(value, ELEMENT))
            }
            is AST.RestTarget     -> {
                ctx.note_place(t.place)
                ctx.assign(t.place, value)
            }
            is AST.WildcardTarget -> {}
        }
    }
}

// Note the name a write to `place` lands below, through its fields and elements:
// what it reads there is no read of the name. A compound assignment reads its
// target through the same node.
note_place :: fn(ctx: WalkCtx, place: AST.Expr) -> void {
    // @partial: any other place reads no name below it.
    @partial match place {
        is AST.FieldExpr -> { ctx.note_place(place.target) }
        is AST.IndexExpr -> { ctx.note_place(place.target) }
        is AST.IdentExpr -> { ctx.place_bases.add(place.id) }
        _                -> {}
    }
}

// `place = value`: a local now holds `value` too ; a field or an element of a value
// is assigned, and keeps `value` ; anything else, a place the typecheck refused,
// keeps it.
assign :: fn(ctx: WalkCtx, place: AST.Expr, value: i64 | null) -> void {
    // @partial: no other form is a place the typecheck accepts ; one that were
    // would keep `value` all the same.
    @partial match place {
        is AST.IdentExpr -> { ctx.assign_name(place, value) }
        is AST.FieldExpr -> {
            ctx.note_write(place.target)
            field :: ctx.index.paths.path_to(field_step(place))
            target :: ctx.value(place.target)
            ctx.mark(target, field, .Assigned, place.span)
            ctx.escape(value, .Stored, place.span)
            ctx.store(value, target, field, place.span)
        }
        is AST.IndexExpr -> { ctx.assign_element(place, value) }
        _                -> {
            ctx.discard(place)
            ctx.escape(value, .Stored, place.span)
        }
    }
}

// `name = value`: a local or a parameter now holds `value` too ; a module constant,
// which the typecheck refuses to rebind (T3041), keeps it.
assign_name :: fn(ctx: WalkCtx, name: AST.IdentExpr, value: i64 | null) -> void {
    slot :: ctx.ident_value(name)
    if slot == null {
        ctx.escape(value, .Stored, name.span)
        return
    }
    sym :: ctx.typed.resolved.idents[name.span.hash()] ?? return
    ctx.s.rebinds.push(Use { .slot = slot, .name = sym.name, .at = name.span })
    ctx.bind_copy(slot, value, name.span, sym)
}

// `target[index] = value`, through the target's `IndexSet` or into an array. A
// write the typecheck refused is still a write of the element.
assign_element :: fn(ctx: WalkCtx, place: AST.IndexExpr, value: i64 | null) -> void {
    ctx.note_write(place.target)
    target :: ctx.value(place.target)
    index :: ctx.value(place.index)
    writer :: ctx.site_callee(.IndexWrite, place.id)
    if writer != null && writer !is Builtin && writer !is ErroneousCallee {
        ctx.call(writer, [target, index, value], place.span, [null, place.index, null])
        return
    }
    element :: ctx.index.paths.path_to(ELEMENT)
    ctx.mark(target, element, .Assigned, place.span)
    ctx.escape(value, .Stored, place.span)
    ctx.store(value, target, element, place.span)
}

// ---- bindings -------------------------------------------------------------

bind :: fn(ctx: WalkCtx, b: AST.LetBinding, value: i64 | null) -> void {
    match b {
        is AST.SimpleBinding   -> { ctx.bind_symbol(b.name_span, value) }
        is AST.TupleBinding    -> {
            for element in b.elements {
                ctx.bind(element, ctx.step_slot(value, ELEMENT))
            }
        }
        is AST.RestBinding     -> { ctx.bind_symbol(b.span, value) }
        is AST.WildcardBinding -> {}
    }
}

// The binding whose name sits at `span` now holds `value` too, a copy of what it
// holds of a frozen value.
bind_symbol :: fn(ctx: WalkCtx, span: Span, value: i64 | null) -> void {
    sym :: ctx.typed.resolved.idents[span.hash()] ?? return
    ctx.bind_copy(ctx.local_slot(sym, span), value, span, sym)
}

// The slot of the local `sym`, made on its first binding, at `span`.
local_slot :: fn(ctx: WalkCtx, sym: Symbol, span: Span) -> i64 {
    known :: ctx.slots[sym.id]
    if known != null {
        return known
    }
    slot :: ctx.s.fresh_slot()
    ctx.slots[sym.id] = slot
    ctx.s.locals.push(Local { .slot = slot, .name = sym.name, .at = span })
    return slot
}

// `value` is now a part of `holder`, at `path` below it: the task check reads it as
// a flow, the summary as the store its marks already record.
store :: fn(ctx: WalkCtx, value: i64 | null, holder: i64 | null, path: i32, at: Span) -> void {
    into :: value ?? return
    from :: holder ?? return
    ctx.s.stores.push(Flow { .into = into, .from = from, .path = path })
    ctx.s.stored_at.push(at)
}

// `literal` holds the part `path` of `value`, `under` below its own value. The
// summary records that part as kept, at `at` ; the task check follows it.
hold :: fn(ctx: WalkCtx, literal: i64, value: i64 | null, path: i32, under: i32, at: Span) -> void {
    from :: value ?? return
    ctx.s.held_marks.push(ctx.s.marks.len())
    ctx.s.add_mark(from, path, .Stored, at)
    ctx.s.held.push(Flow { .into = literal, .from = from, .path = path, .under = under })
}

// ---- helpers --------------------------------------------------------------

// The function does `effect` at `path` below `value`, at `at`, when `value` holds
// anything lent.
mark :: fn(ctx: WalkCtx, value: i64 | null, path: i32, effect: Effect, at: Span) -> void {
    if value != null {
        ctx.s.add_mark(value, path, effect, at)
    }
}

// `value` leaves the call at `at`, kept (`.Stored`) or returned.
escape :: fn(ctx: WalkCtx, value: i64 | null, effect: Effect, at: Span) -> void =
    ctx.mark(value, ROOT, effect, at)

// What `value`, of type `from`, holds as a value of type `to`: one `NARROWED` step
// down when an `is` test narrows a type that may be a view to one that is none, so
// that what is done below is not taken for what a view the value may otherwise be
// undergoes (`views.vader`).
narrowed :: fn(
    ctx: WalkCtx, value: i64 | null, from: Type | null, to: Type | null,
) -> i64 | null {
    view :: ctx.index.view ?? return value
    if !may_hold_view(from, view) || may_hold_view(to, view) {
        return value
    }
    return ctx.step_slot(value, NARROWED)
}

// A slot holding what `value` holds one `step` down, null when `value` is.
step_slot :: fn(ctx: WalkCtx, value: i64 | null, step: string) -> i64 | null {
    from :: value ?? return null
    return ctx.path_slot(from, ctx.index.paths.path_to(step))
}

// A slot holding what `value` holds at `path` below it, null when `value` is.
path_slot :: fn(ctx: WalkCtx, value: i64 | null, path: i32) -> i64 | null {
    from :: value ?? return null
    slot :: ctx.s.fresh_slot()
    ctx.s.add_flow(slot, from, path)
    if from in ctx.pure {
        ctx.pure.add(slot)
    }
    return slot
}

// A slot holding what each of `values` holds ; the value itself when only one holds
// anything.
union_of :: fn(ctx: WalkCtx, values: (i64 | null)[]) -> i64 | null {
    first: i64 | null = null
    count := 0
    pure := true
    for v in values {
        held :: v ?? continue
        if first == null {
            first = held
        }
        count += 1
        if held !in ctx.pure {
            pure = false
        }
    }
    if count < 2 {
        return first
    }
    slot :: ctx.s.fresh_slot()
    for v in values {
        held :: v ?? continue
        ctx.s.add_flow(slot, held)
    }
    if pure {
        ctx.pure.add(slot)
    }
    return slot
}

// What evaluates to one of `values`, the branches of an `if`, a `match` or a `??`.
// A branch that holds nothing lent may still be shared, a lambda's parameter: a
// join of frozen values with one gets a slot of its own, outside `pure`.
one_of :: fn(ctx: WalkCtx, values: (i64 | null)[]) -> i64 | null {
    joined :: ctx.union_of(values) ?? return null
    if joined !in ctx.pure || values.all_match((v) -> v != null) {
        return joined
    }
    slot :: ctx.s.fresh_slot()
    ctx.s.add_flow(slot, joined)
    return slot
}

// What the record says the site `role` at node `id` invokes.
site_callee :: fn(ctx: WalkCtx, role: CallRole, id: i64) -> Callee | null =
    sites_of(ctx.typed.call_sites, role)[id]

// A call at `at` to `callee` handing it `args` by its parameters' positions ; its
// result's slot, or null when there is no call, or one that runs nothing. `sources`
// are the expressions the arguments come from, where the walk has them.
call :: fn(
    ctx: WalkCtx,
    callee: Callee | null,
    args: (i64 | null)[],
    at: Span,
    sources: (AST.Expr | null)[] = [],
    fn_args: (LambdaArg | ParamArg | null)[] = [],
    called: i64 | null = null,
) -> i64 | null {
    c :: callee ?? return null
    targets :: ctx.call_targets(c, called)
    if targets.len() == 0 {
        return null
    }
    for q in 0..<sources.len() {
        source :: sources[q] ?? continue
        ctx.note_known_writes(targets, q, source)
        ctx.note_widened(c, targets, q, source)
    }
    ctx.note_appended(targets, args, at)
    // A copy: callers widen an `AST.Expr[]` into `sources`, which a callee that
    // keeps it may not take.
    kept: (AST.Expr | null)[]: []
    for source in sources {
        kept.push(source)
    }
    return ctx.s.add_site(targets, args, c, at, kept, fn_args)
}

// What a call to `callee` may run: the function value the parameter `called` of the
// body holds, when that is what it calls.
call_targets :: fn(ctx: WalkCtx, callee: Callee, called: i64 | null) -> CallTarget[] {
    if called != null {
        return [CalledParam { .param = called }]
    }
    return ctx.index.targets_of(callee)
}

// The position of the parameter of the body `e` names ; null for any other
// expression.
param_named :: fn(ctx: WalkCtx, e: AST.Expr) -> i64 | null {
    if e !is AST.IdentExpr {
        return null
    }
    sym :: ctx.typed.resolved.idents[e.span.hash()] ?? return null
    return ctx.param_positions[sym.id]
}

// A call that grows its first argument and keeps its second makes the second a
// part of the first, as `push` does with an element and `push_all` with the
// elements of another array: a store the task check follows.
note_appended :: fn(ctx: WalkCtx, targets: CallTarget[], args: (i64 | null)[], at: Span) -> void {
    if targets.len() != 1 || args.len() != 2 {
        return
    }
    known :: targets[0]
    if known !is KnownEffects || known.params.len() != 2 || !grows(known.params[0]) {
        return
    }
    into :: args[1] ?? return
    from :: args[0] ?? return
    for a in known.params[1].accesses {
        if a.effect == .Stored {
            ctx.store(into, from, ctx.appended_path(a.path), at)
        }
    }
}

// Whether `effects` grows the array the parameter holds.
grows :: fn(effects: ParamEffects) -> bool =
    effects.accesses.any_match((a) -> a.effect == .Resized && a.path == ROOT)

// Where a value a call appends sits below the array it grows, the call keeping it
// at `kept`: an element, or for the elements of another array, the same place.
appended_path :: fn(ctx: WalkCtx, kept: i32) -> i32 {
    if kept == ROOT {
        return ctx.index.paths.path_to(ELEMENT)
    }
    return ROOT
}

// The step a field access takes: an element of a tuple for `t.0`.
field_step :: fn(e: AST.FieldExpr) -> string {
    if e.is_numeric {
        return ELEMENT
    }
    return e.field
}
