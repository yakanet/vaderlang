// vader/front/effects/origin: why an access is in a set, and the chain it leads down.
//
// Each access of a `ParamEffects` keeps the constraint that first put it there, in
// two words (`ParamEffects.origins`): a mark of the body, its own write or keep, or
// a call, which carries an access of its callee's parameter. That access was in the
// callee's set before the call carried it, and a cut path that drops accesses takes
// the origin of the first it drops, which was there before it: following the
// origins from a fault goes back in the order the accesses arrived, down the calls
// to the write, and ends. A cut path may have dropped the access a call carries;
// the cut path that covers it stands for it.

module "vader/front/effects"

import "std/abort"
import "std/collections"
import "toolchain/span"

// ---- origin words ---------------------------------------------------------

/// The origin of an access no constraint of a body put there: a fixed set, an
/// intrinsic's or that of code the summary cannot see.
FIXED: i64: -1

/// The second word of an origin that carries no callee's access.
NO_ACCESS: i64: -1

/// The origin of an access the mark at index `mark` of its skeleton put there.
mark_origin :: fn(mark: i64) -> i64 = -2 - mark

/// The origin of an access the call at index `site` of its skeleton put there,
/// running its target `target` with the argument of the callee's parameter `param`.
call_origin :: fn(site: i64, target: i64, param: i64) -> i64 =
    (site << 32) | (target << 16) | param

// The mark an origin names ; null for a call or a fixed set.
origin_mark :: fn(how: i64) -> i64 | null {
    if how >= FIXED {
        return null
    }
    return i64(-2 - how)
}

// The call, its target and the callee's parameter an origin names ; null for a
// mark or a fixed set.
origin_call :: fn(how: i64) -> [i64, i64, i64] | null {
    if how < 0 {
        return null
    }
    return [i64(how >> 32), i64((how >> 16) & 0xFFFF), i64(how & 0xFFFF)]
}

// ---- fault chains ---------------------------------------------------------

/// The most calls a fault's chain may go down: past it, the chains do not end as
/// `include` promises, which is a fault of the summary.
MAX_HOPS: i32: 4096

/// One call on the way from a fault down to the write.
export FaultHop :: struct {
    /// The function the value is lent to, as a diagnostic names it.
    callee: string
    /// The parameter of that function the value is lent through.
    param: string
    /// Where the call is.
    span: Span
    module: string
}

/// What modifies a frozen value at the end of a fault's chain.
export FaultWrite :: struct {
    effect: Effect
    /// Where it lands, below the name the value goes by there: `c.n`.
    place: string
    /// The callee that does it without a body of its own (`push`) ; null for a write
    /// the body makes.
    by: string | null = null
    span: Span
    module: string
}

/// The calls from a fault down to the write, and the write ; no write when the
/// chain cannot be followed to one.
export FaultChain :: struct {
    via: FaultHop[] = []
    write: FaultWrite | null = null
}

/// What following a chain reads: the functions, their skeletons and settled facts.
TraceCtx :: struct {
    index: CalleeIndex
    /// Per node, the skeleton of its body.
    skeletons: Skeleton[]
    facts: ParamEffects[][]
}

// Where an access of a chain sits: the skeleton that put it in its set, the module
// of that body, the set, and the name its root goes by in labels.
Link :: struct {
    s: Skeleton
    module: string
    effects: ParamEffects
    name: string
}

// The chain of the access at `index` of `start`'s set: the calls it goes down, and
// the write it ends at.
trace :: fn(ctx: TraceCtx, start: Link, index: i64) -> FaultChain {
    chain :: FaultChain {}
    at := start
    i := index
    for _ in 0..<MAX_HOPS {
        a :: at.effects.accesses[i]
        how :: at.effects.constraint_at(i)
        mark :: origin_mark(how)
        if mark != null {
            chain.write = written_by(ctx.index.paths, at, a, at.s.marks[mark].at, null)
            return chain
        }
        call :: origin_call(how) ?? return chain
        site :: at.s.sites[call.0]
        param :: call.2
        callee :: match target :: site.targets[call.1] {
            is CalleeNode   -> target
            is KnownEffects -> {
                by :: display_callee(site.callee)
                chain.write = written_by(ctx.index.paths, at, a, site.at, by)
                return chain
            }
            is AnyCallee    -> { return chain }
        }
        f :: ctx.index.functions[callee.node]
        name :: f.decl.params[param].name
        hop :: FaultHop {
            .callee = "`${f.decl.name}`",
            .param = name,
            .span = site.at,
            .module = at.module,
        }
        chain.via.push(hop)
        effects :: ctx.facts[callee.node][param]
        i = find_access(ctx.index.paths, effects, at.effects.carried_at(i)) ?? return chain
        at = Link {
            .s = ctx.skeletons[callee.node],
            .module = f.typed.resolved.display_path,
            .effects = effects,
            .name = name,
        }
    }
    panic("effects: the chain of a frozen fault goes down more than ${MAX_HOPS} calls")
}

// The write at `span` of the access `a` of `at`'s set, which `by` makes when the body
// does not.
written_by :: fn(
    paths: PathTable, at: Link, a: Access, span: Span, by: string | null,
) -> FaultWrite = FaultWrite {
    .effect = a.effect,
    .place = paths.place_label(at.name, a.path),
    .by = by,
    .span = span,
    .module = at.module,
}

// The index in `effects` of the access whose key is `key`, or of the cut path that
// dropped it ; null when neither is there.
find_access :: fn(paths: PathTable, effects: ParamEffects, key: i64) -> i64 | null {
    if key == NO_ACCESS {
        return null
    }
    for j in 0..<effects.accesses.len() {
        x :: effects.accesses[j]
        if access_key(x) == key || paths.covers_key(x, key) {
            return j
        }
    }
    return null
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_origin_words_name_their_constraint :: fn() -> void {
    assert_eq(origin_mark(mark_origin(3)) ?? 99, 3)
    assert(origin_call(mark_origin(3)) == null, "a mark is no call")
    call :: origin_call(call_origin(5, 1, 2)) ?? return
    assert_eq(call.0, 5)
    assert_eq(call.1, 1)
    assert_eq(call.2, 2)
    assert(origin_mark(FIXED) == null && origin_call(FIXED) == null, "a fixed set has neither")
}

@test
test_find_access_takes_the_cut_path_that_dropped_it :: fn() -> void {
    t :: PathTable {}
    deep :: Access { .path = path_of(t, ["a", "b"]), .effect = .Assigned }
    effects :: ParamEffects {}
    t.include(effects, ROOT, .Stored)
    t.include(effects, t.cut(path_of(t, ["a"])), .Assigned)
    assert_eq(find_access(t, effects, access_key(deep)) ?? 99, 1)
    assert(find_access(t, effects, NO_ACCESS) == null, "no access to find")
}

@test
test_find_access_skips_an_ancestor_that_is_no_cut :: fn() -> void {
    t :: PathTable {}
    effects :: ParamEffects {}
    t.include(effects, path_of(t, ["a"]), .Assigned)
    deep :: Access { .path = path_of(t, ["a", "b"]), .effect = .Assigned }
    assert(find_access(t, effects, access_key(deep)) == null, "`.a` does not stand for `.a.b`")
}
