// vader/front/effects/effect: what a function does below one of its parameters.
//
// The fact the summary computes for a parameter is a set of accesses: an effect
// at a path below the parameter. A path is a few steps down from the value the
// caller lends (a field by its name, an element), cut at `MAX_STEPS`: past that,
// it stands for every path that extends it. That keeps the sets finite, which is
// what lets the fixed point over the call graph settle (`effects.vader`).
//
// A path is a value (`PartPath`): the ids of its steps, packed, so the same path is
// always the same number and naming one writes nothing. The `PathTable` keeps only
// the names of the steps, which the walks write and the fixed point only reads:
// tasks that settle functions side by side share it as it is.
//
// A narrowing (`is`) takes no step: it does not change the object, but for one
// that rules out a byte array (`NARROWED`). An element of a tuple is an element
// too, so that a path never depends on a type the walk does not always know.

module "vader/front/effects"

import "std/abort"
import "std/collections"
import "std/sort"
import "std/string_builder"

// ---- paths ----------------------------------------------------------------

/// The step to an element of an array or of a tuple; any other step is a field,
/// by its name.
ELEMENT :: "[]"

/// The step to a value narrowed by an `is` test to a type no byte array is: below
/// it is no part of a view the value may otherwise be (`narrowed_read`).
NARROWED :: "<narrowed>"

/// The step to what an iterator hands out: below the iterator a generator's call
/// returns lies each value it yields.
ITEM :: "<item>"

// The ids of `ELEMENT`, `NARROWED` and `ITEM`, the same in every table.
ELEMENT_STEP: i32: 1
NARROWED_STEP: i32: 2
ITEM_STEP: i32: 3

/// The most steps a path keeps.
MAX_STEPS: i32: 3

/// A path from a value down to one of its parts: the ids of its steps from the
/// value down, how many there are, and whether it is cut. A cut path also stands
/// for every path that extends it.
export PartPath :: i64

// A step id takes `STEP_BITS` bits, the first step lowest, 0 for no step ; then
// come the length, on two bits, and the cut bit.
STEP_BITS: i64: 12
STEP_MASK: i64: 0xFFF
STEPS_MASK: i64: 0xF_FFFF_FFFF
LENGTH_SHIFT: i64: 36
CUT_BIT: i64: 0x40_0000_0000

/// The value itself.
ROOT :: PartPath(0)

/// The value and everything reachable from it.
EVERYWHERE :: PartPath(CUT_BIT)

/// The names of the steps every path of a summary takes, by id.
export PathTable :: struct {
    @internal
    step_names: string[] = ["", ELEMENT, NARROWED, ITEM]
    @internal
    step_ids: Map<string, i32> = first_step_ids()
}

// The steps every table names from the start.
first_step_ids :: fn() -> Map<string, i32> {
    ids :: Map<string, i32> {}
    ids[ELEMENT] = ELEMENT_STEP
    ids[NARROWED] = NARROWED_STEP
    ids[ITEM] = ITEM_STEP
    return ids
}

// The id of the step `name`.
step_id :: fn(t: PathTable, name: string) -> i32 {
    fresh :: i32(t.step_names.len())
    id :: t.step_ids.get_or_put(name, fresh)
    if id == fresh {
        t.step_names.push(name)
    }
    return id
}

// The id of step `k` of `p`, 0 past its last.
step_at :: fn(p: PartPath, k: i64) -> i32 = i32((i64(p) >> (k * STEP_BITS)) & STEP_MASK)

// The number of steps of `p`.
length_of :: fn(p: PartPath) -> i32 = i32((i64(p) >> LENGTH_SHIFT) & 3)

// Whether `p` stands for deeper paths too.
is_cut :: fn(p: PartPath) -> bool = (i64(p) & CUT_BIT) != 0

// `p`, standing for every path that extends it too.
cut :: fn(p: PartPath) -> PartPath = PartPath(i64(p) | CUT_BIT)

// The path one `step` below `p`. A step whose id does not fit cuts `p` instead,
// which stands for that path too.
child :: fn(p: PartPath, step: i32) -> PartPath {
    if is_cut(p) {
        return p
    }
    length :: length_of(p)
    if length == MAX_STEPS || i64(step) > STEP_MASK {
        return cut(p)
    }
    steps :: (i64(p) & STEPS_MASK) | (i64(step) << (i64(length) * STEP_BITS))
    return PartPath(steps | (i64(length + 1) << LENGTH_SHIFT))
}

// The path one step below the value, by the step's name.
path_to :: fn(t: PathTable, name: string) -> PartPath = child(ROOT, t.step_id(name))

// `p` then `q`, cut at `MAX_STEPS`.
joined :: fn(p: PartPath, q: PartPath) -> PartPath {
    if q == ROOT || is_cut(p) {
        return p
    }
    if p == ROOT {
        return q
    }
    result := p
    for k in 0..<i64(length_of(q)) {
        result = child(result, step_at(q, k))
    }
    if is_cut(q) {
        return cut(result)
    }
    return result
}

// The steps from the value down to `p`, in order.
steps_of :: fn(p: PartPath) -> i32[] {
    steps: i32[]: []
    for k in 0..<i64(length_of(p)) {
        steps.push(step_at(p, k))
    }
    return steps
}

// The first `length` steps of `p`, uncut ; `length` is at most its own.
first_steps :: fn(p: PartPath, length: i32) -> PartPath {
    kept :: STEPS_MASK >> (i64(MAX_STEPS - length) * STEP_BITS)
    return PartPath((i64(p) & kept) | (i64(length) << LENGTH_SHIFT))
}

// The steps of `p` past its first `length`, as a path from the value: cut when
// `p` is.
rest_after :: fn(p: PartPath, length: i32) -> PartPath {
    if length == 0 {
        return p
    }
    total :: length_of(p)
    if length >= total {
        if is_cut(p) {
            return EVERYWHERE
        }
        return ROOT
    }
    steps :: (i64(p) & STEPS_MASK) >> (i64(length) * STEP_BITS)
    return PartPath(steps | (i64(total - length) << LENGTH_SHIFT) | (i64(p) & CUT_BIT))
}

// The path down the first `length` steps of `p` ; `p` itself when it has no more.
prefix :: fn(p: PartPath, length: i32) -> PartPath {
    if length_of(p) <= length {
        return p
    }
    return first_steps(p, length)
}

// Whether the first step of `p` is the step `name`.
first_step_is :: fn(t: PathTable, p: PartPath, name: string) -> bool =
    length_of(p) >= 1 && t.step_names[step_at(p, 0)] == name

// Whether `p` is `c`'s path or one below it, `c` standing for deeper paths.
extends :: fn(p: PartPath, c: PartPath) -> bool {
    length :: length_of(c)
    if length_of(p) < length {
        return false
    }
    at :: prefix(p, length)
    return at == c || cut(at) == c
}

// Where `p` sits on the chain of arrays that leads to an element widened `depth`
// arrays deep: its length, when every step of it is an element and there are at
// most `depth` of them. Null when it leaves the chain through a field, or goes
// below the widened element.
chain_position :: fn(p: PartPath, depth: i32) -> i32 | null {
    length :: length_of(p)
    if length > depth {
        return null
    }
    for k in 0..<i64(length) {
        if step_at(p, k) != ELEMENT_STEP {
            return null
        }
    }
    return length
}

/// Whether access `a` lets a callee put a value of the wider type into an argument
/// whose element was widened `depth` arrays deep: an element or an inner array
/// replaced, or an array on the way down grown, kept, returned or handed to code
/// the summary cannot see. A shrink takes nothing in, and what happens to the
/// widened element itself, or below it, stays inside a value of its own type.
///
/// @param a      an access of the callee's parameter.
/// @param depth  how many arrays deep the element was widened (`widening_depth`).
breaks_widening :: fn(a: Access, depth: i32) -> bool {
    k :: chain_position(a.path, depth) else return false
    return match a.effect {
        .Shrunk -> false
        .Assigned -> k >= 1 || a.path.is_cut()
        .Resized | .Stored | .Returned | .Unknown | .Handed -> k < depth
    }
}

// How the dump writes `p` after its parameter's name: `.f[]`, then `...` when it
// stands for deeper paths too.
display_path :: fn(t: PathTable, p: PartPath) -> string {
    if is_cut(p) {
        return "${t.display_steps(p)}..."
    }
    return t.display_steps(p)
}

// The value at `p` below the name `name`, as source writes it: `c.n`.
place_label :: fn(t: PathTable, name: string, p: PartPath) -> string = "${name}${t.display_path(p)}"

// The steps of `p` as source writes them after a name: `.f[]`.
display_steps :: fn(t: PathTable, p: PartPath) -> string {
    sb :: StringBuilder {}
    for step in steps_of(p) {
        name :: t.step_names[step]
        if name == ELEMENT || name == ITEM {
            sb.append(name)
        } else if name != NARROWED {
            sb.append(".${name}")
        }
    }
    return sb.to_string()
}

// ---- effects --------------------------------------------------------------

/// What a function does at the end of a path below one of its parameters.
export Effect :: enum {
    /// A slot is assigned: the path ends at the field or element written,
    /// `p.f = v`, `xs[i] = v`.
    Assigned,
    /// The array at the end of the path gets longer: `push`, `push_all`.
    Resized,
    /// The array at the end of the path gets shorter: `remove_last`, `clear`.
    Shrunk,
    /// The value at the end of the path is kept past the call: put in a field or
    /// an element, captured by a lambda, handed to a parameter its callee keeps.
    Stored,
    /// The value at the end of the path is returned: the caller holds it through
    /// the call's result.
    Returned,
    /// Code the summary cannot see may change anything at the end of the path: a
    /// function value, a site the record could not settle. A client that needs a
    /// sound answer reads it as any change.
    Unknown,
    /// The value at the end of the path is handed to the function value a
    /// parameter holds (`Access.fn_param`), as its parameter `Access.fn_arg`: what
    /// it undergoes is what the caller hands there does. A caller that hands a
    /// lambda it writes runs the lambda's body on it ; one that hands its own
    /// parameter hands the value on ; any other caller reads it as `Unknown`.
    Handed,
}

// Whether `a` changes what the caller lent, by code the summary sees.
modifies :: fn(a: Access) -> bool = match a.effect {
    .Assigned | .Resized | .Shrunk           -> true
    .Stored | .Returned | .Unknown | .Handed -> false
}

// Whether access `a` keeps a value past the call: stored, or returned.
is_kept :: fn(a: Access) -> bool = match a.effect {
    .Stored | .Returned -> true
    .Assigned | .Resized | .Shrunk | .Unknown | .Handed -> false
}

// Whether access `a` hands a value to code the summary cannot see: a function value
// the caller hands is one, until the caller says which.
is_unknown :: fn(a: Access) -> bool = a.effect == .Unknown || a.effect == .Handed

// How the dump names `e`.
effect_label :: fn(e: Effect) -> string = match e {
    .Assigned -> "assigned"
    .Resized  -> "resized"
    .Shrunk   -> "shrunk"
    .Stored   -> "stored"
    .Returned -> "returned"
    .Unknown  -> "unknown"
    .Handed   -> "handed"
}

/// An effect at a path below a parameter.
export Access :: struct {
    path: PartPath
    effect: Effect
    /// For `Handed`: the parameter that holds the function value, and the position
    /// of the function's parameter the value is handed to ; -1 otherwise.
    fn_param: i32 = -1
    fn_arg: i32 = -1
    /// For `Returned`: where the value lies below the function's result, `ROOT` for
    /// the result itself, `ITEM` for a value a generator yields.
    under: PartPath = ROOT
}

// The access `a` of a function, handed to a function value: `Handed`, to the
// function's parameter `fn_arg` of the value parameter `fn_param` holds.
handed_to :: fn(path: PartPath, fn_param: i64, fn_arg: i64) -> Access = Access {
    .path = path,
    .effect = .Handed,
    .fn_param = i32(fn_param),
    .fn_arg = i32(fn_arg),
}

/// What a function may do with everything a caller lends one parameter: the
/// accesses, each once, and why each is there.
export ParamEffects :: struct {
    accesses: Access[] = []
    /// Two words per access, in the order of `accesses`: the constraint that put it
    /// there, and the key of the access of the callee a call carries
    /// (`origin.vader`).
    @internal
    origins: i64[] = []
    /// The keys of `accesses` once they outgrow a scan (`SCANNED_ACCESSES`) ; null
    /// before.
    @internal
    keys: Set<i64> | null = null
    /// The places below the result where its `Returned` accesses put a value, other
    /// than the result itself: a key names one by its position here, which only
    /// grows.
    @internal
    unders: PartPath[] = []
}

// The most accesses a set scans for a key ; past it, the set keeps their keys in a
// hash set.
SCANNED_ACCESSES: i64: 8

// A key holds the effect in its low bits, then the path, then where the value goes
// (`destination_in`) on the 21 bits left: a set numbers fewer places than that, and a
// `Handed` access takes two fields of `HANDED_BITS`. A key is that of one set: the
// number of a place means nothing in another.
PATH_SHIFT: i64: 3
PATH_MASK: i64: 0x7F_FFFF_FFFF
DESTINATION_SHIFT: i64: 42

// A `Handed` access names its function value's parameter and argument in a key on
// this many bits each.
HANDED_BITS: i64: 10

// The key of access `x` of `effects`.
access_key :: fn(effects: ParamEffects, x: Access) -> i64 = key_of(effects, x.path, x)

// The key in `effects` of an access doing what `x`, an access of `effects`, does at
// `path` instead, building no `Access`.
key_of :: fn(effects: ParamEffects, path: PartPath, x: Access) -> i64 {
    destination :: effects.destination_in(x)
        else panic("effects: a key for a place the set does not number")
    return key_at(path, x.effect, destination)
}

// The key of the access at `path` doing `effect` toward `destination`
// (`destination_in`).
key_at :: fn(path: PartPath, effect: Effect, destination: i64) -> i64 =
    (destination << DESTINATION_SHIFT) | (i64(path) << PATH_SHIFT) | i64(effect)

// Where `a` hands its value, as a key of `effects` holds it: the function value of
// a `Handed` access, the place below the result of a `Returned` one, by its
// position in `effects.unders` ; null for a place no access of `effects` returns
// to, which no key of it holds.
destination_in :: fn(effects: ParamEffects, a: Access) -> i64 | null {
    if a.effect != .Returned {
        return (i64(a.fn_param + 1) << HANDED_BITS) | i64(a.fn_arg + 1)
    }
    if a.under == ROOT {
        return NO_DESTINATION
    }
    for i in 0..<effects.unders.len() {
        if effects.unders[i] == a.under {
            return i + 1
        }
    }
    return null
}

// Where `a`, an access about to join `effects`, hands its value, as its key holds
// it: a place below the result takes a position in `effects.unders`, which only
// `insert` grows.
register_destination :: fn(effects: ParamEffects, a: Access) -> i64 {
    known :: effects.destination_in(a)
    if known != null {
        return known
    }
    effects.unders.push(a.under)
    return effects.unders.len()
}

/// The destination of a plain access: it hands nothing to a function value, and a
/// value it returns is the result itself (`destination_in`).
NO_DESTINATION: i64: 0

// The path of the access whose key is `key`.
key_path :: fn(key: i64) -> PartPath = PartPath((key >> PATH_SHIFT) & PATH_MASK)

// Whether `a` and `x`, of one effect, hand their value to the same place: the rule
// `destination_in` numbers, on the accesses themselves.
same_destination :: fn(a: Access, x: Access) -> bool {
    if a.effect == .Returned {
        return a.under == x.under
    }
    return a.fn_param == x.fn_param && a.fn_arg == x.fn_arg
}

// Add `a` to `effects`, which does not hold it, put there by the constraint `how`
// carrying the callee's access `then` ; with no constraint, for a fixed set built
// by hand.
insert :: fn(effects: ParamEffects, a: Access, how: i64 = FIXED, then: i64 = NO_ACCESS) -> void {
    destination :: effects.register_destination(a)
    effects.accesses.push(a)
    effects.origins.push(how)
    effects.origins.push(then)
    if effects.keys != null {
        effects.keys.add(key_at(a.path, a.effect, destination))
        return
    }
    if effects.accesses.len() > SCANNED_ACCESSES {
        effects.keys = key_set(effects)
    }
}

// The keys of the accesses of `effects`.
key_set :: fn(effects: ParamEffects) -> Set<i64> {
    keys :: Set<i64> {}
    for x in effects.accesses {
        keys.add(access_key(effects, x))
    }
    return keys
}

// Add to `effects` the access at `path` doing `effect`, put there by `how` carrying
// `then` ; false when it held it already, or the same effect at a path that stands
// for `path`: an access keeps the first origin it gets. A path that stands for
// deeper ones drops the accesses it covers, which keeps a recursive walk of a tree
// from naming every path below it, and takes the origin of the first it drops: that
// one was there before it, so a chain of origins through it ends (`origin.vader`).
include :: fn(
    effects: ParamEffects,
    path: PartPath,
    effect: Effect,
    how: i64 = FIXED,
    then: i64 = NO_ACCESS,
) -> bool = include_access(effects, Access { .path = path, .effect = effect }, how, then)

// Add `a` to `effects`, as `include` does.
include_access :: fn(
    effects: ParamEffects,
    a: Access,
    how: i64 = FIXED,
    then: i64 = NO_ACCESS,
) -> bool {
    destination :: effects.destination_in(a)
    if destination != null && covered(effects, a.path, a.effect, destination) {
        return false
    }
    add_access(effects, a, how, then)
    return true
}

// Add `a`, which `effects` does not cover, as `include` does.
add_access :: fn(effects: ParamEffects, a: Access, how: i64, then: i64) -> void {
    if is_cut(a.path) {
        dropped :: drop_covered(effects, a)
        if dropped != null {
            effects.insert(a, dropped.0, dropped.1)
            return
        }
    }
    effects.insert(a, how, then)
}

// Whether `effects` holds the access at `path` doing `effect` toward `destination`,
// or the same access at a path standing for one that `path` extends. The key is
// tested before any `Access` is built: the fixed point finds most accesses there
// already.
covered :: fn(effects: ParamEffects, path: PartPath, effect: Effect, destination: i64) -> bool {
    key :: key_at(path, effect, destination)
    keys :: effects.keys else return find_access(effects, key) != null
    if key in keys {
        return true
    }
    for length in 0..<i64(length_of(path)) + 1 {
        standing :: cut(first_steps(path, i32(length)))
        if key_at(standing, effect, destination) in keys {
            return true
        }
    }
    return false
}

// Drop from `effects` every access of `a`'s effect that `a.path` stands for ; the
// origin of the first it drops, null when it drops none. The set is rebuilt only
// when `a` covers one.
drop_covered :: fn(effects: ParamEffects, a: Access) -> [i64, i64] | null {
    first :: first_covered(a, effects) else return null
    origin: [i64, i64]: [effects.constraint_at(first), effects.carried_at(first)]
    kept: Access[]: []
    origins: i64[]: []
    for i in 0..<effects.accesses.len() {
        x :: effects.accesses[i]
        if i >= first && covers(a, x) {
            if effects.keys != null {
                effects.keys.remove(access_key(effects, x))
            }
        } else {
            kept.push(x)
            origins.push(effects.constraint_at(i))
            origins.push(effects.carried_at(i))
        }
    }
    effects.accesses = kept
    effects.origins = origins
    return origin
}

// The index of the first access of `effects` that `a` covers (`covers`) ; null when
// it covers none.
first_covered :: fn(a: Access, effects: ParamEffects) -> i64 | null {
    for i in 0..<effects.accesses.len() {
        if covers(a, effects.accesses[i]) {
            return i
        }
    }
    return null
}

// The constraint that put the access at index `i` of `effects` there.
constraint_at :: fn(effects: ParamEffects, i: i64) -> i64 = effects.origins[2 * i]

// The callee's access the constraint of the access at index `i` carries.
carried_at :: fn(effects: ParamEffects, i: i64) -> i64 = effects.origins[2 * i + 1]

// Whether `x`, an access of `effects` at a cut path, covers the access whose key in
// `effects` is `key` (`covers`).
covers_key :: fn(effects: ParamEffects, x: Access, key: i64) -> bool {
    path :: key_path(key)
    if x.path == path || !is_cut(x.path) || key_of(effects, path, x) != key {
        return false
    }
    return extends(path, x.path)
}

// Whether `a`, at a path standing for deeper ones, covers another access `x`.
covers :: fn(a: Access, x: Access) -> bool =
    x.effect == a.effect && same_destination(a, x) && x.path != a.path && extends(x.path, a.path)

// The accesses of a parameter nothing is known of: changed by unseen code, and
// kept, anywhere below it.
any_effects :: fn() -> ParamEffects {
    effects :: ParamEffects {}
    effects.insert(Access { .path = EVERYWHERE, .effect = .Unknown })
    effects.insert(Access { .path = EVERYWHERE, .effect = .Stored })
    return effects
}

// The accesses of `effects` in a stable order: by effect, then as the dump writes
// their paths.
sorted_accesses :: fn(t: PathTable, effects: ParamEffects) -> Access[] {
    keyed: KeyedAccess[]: []
    for a in effects.accesses {
        key :: "${i64(a.effect)} ${t.display_path(a.path)}"
        keyed.push(KeyedAccess { .key = key, .access = a })
    }
    out: Access[]: []
    for k in sort(keyed, (x, y) -> x.key < y.key) {
        out.push(k.access)
    }
    return out
}

// An access and the key it sorts by.
KeyedAccess :: struct {
    key: string
    access: Access
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// The path down `steps` from the parameter.
path_of :: fn(t: PathTable, steps: string[]) -> PartPath {
    p := ROOT
    for step in steps {
        p = child(p, t.step_id(step))
    }
    return p
}

@test
test_joined_appends_the_steps :: fn() -> void {
    t :: PathTable {}
    p :: joined(path_of(t, ["a"]), path_of(t, [ELEMENT, "b"]))
    assert_eq(t.display_path(p), ".a[].b")
}

@test
test_joined_cuts_past_the_maximum :: fn() -> void {
    t :: PathTable {}
    p :: joined(path_of(t, ["a", "b"]), path_of(t, ["c", "d"]))
    assert_eq(t.display_path(p), ".a.b.c...")
}

@test
test_joined_below_a_cut_path_keeps_it :: fn() -> void {
    t :: PathTable {}
    cut_path :: cut(path_of(t, ["a", "b", "c"]))
    assert_eq(joined(cut_path, path_of(t, ["d"])), cut_path)
}

@test
test_joined_onto_everywhere_stays_everywhere :: fn() -> void {
    t :: PathTable {}
    assert_eq(joined(EVERYWHERE, path_of(t, ["a"])), EVERYWHERE)
}

@test
test_a_plain_access_has_no_destination :: fn() -> void {
    effects :: [
        Effect.Assigned,
        Effect.Resized,
        Effect.Shrunk,
        Effect.Stored,
        Effect.Returned,
        Effect.Unknown,
        Effect.Handed,
    ]
    for effect in effects {
        a :: Access { .path = ROOT, .effect = effect }
        destination :: ParamEffects {}.destination_in(a) else -1
        assert(destination == NO_DESTINATION, "a plain ${effect_label(effect)} access")
    }
}

@test
test_a_step_whose_id_does_not_fit_cuts_the_path :: fn() -> void {
    t :: PathTable {}
    a :: path_of(t, ["a"])
    assert_eq(child(a, 4096), cut(a))
    assert(!is_cut(child(ROOT, 4095)), "the widest id fits")
}

@test
test_returned_to_two_places_is_two_accesses :: fn() -> void {
    t :: PathTable {}
    effects :: ParamEffects {}
    to_a :: Access { .path = ROOT, .effect = .Returned, .under = path_of(t, ["a"]) }
    to_b :: Access { .path = ROOT, .effect = .Returned, .under = path_of(t, ["b"]) }
    assert(include_access(effects, to_a), "returned into `.a`")
    assert(include_access(effects, to_b), "returned into `.b`")
    assert(!include_access(effects, to_a), "returned into `.a` again")
    assert_eq(effects.accesses.len(), 2)
}

@test
test_returned_to_two_places_is_two_keys_past_a_scan :: fn() -> void {
    t :: PathTable {}
    effects :: ParamEffects {}
    for name in ["a", "b", "c", "d", "e", "f", "g", "h", "i"] {
        include(effects, path_of(t, [name]), .Assigned)
    }
    to_a :: Access { .path = ROOT, .effect = .Returned, .under = path_of(t, ["a"]) }
    to_b :: Access { .path = ROOT, .effect = .Returned, .under = path_of(t, ["b"]) }
    assert(effects.keys != null, "the set keeps its keys")
    assert(include_access(effects, to_a), "returned into `.a`")
    assert(include_access(effects, to_b), "returned into `.b`")
    assert(!include_access(effects, to_b), "returned into `.b` again")
}

@test
test_include_keeps_each_access_once :: fn() -> void {
    effects :: ParamEffects {}
    assert(include(effects, ROOT, .Stored), "first include")
    assert(!include(effects, ROOT, .Stored), "second include")
    assert_eq(effects.accesses.len(), 1)
}

@test
test_include_skips_a_covered_path :: fn() -> void {
    t :: PathTable {}
    effects :: ParamEffects {}
    include(effects, cut(path_of(t, ["a"])), .Assigned)
    below :: path_of(t, ["a", "b"])
    assert(!include(effects, below, .Assigned), "covered")
    assert(include(effects, below, .Stored), "other effect")
}

@test
test_include_of_a_cut_path_drops_what_it_covers :: fn() -> void {
    t :: PathTable {}
    effects :: ParamEffects {}
    include(effects, path_of(t, ["a", "b"]), .Assigned)
    include(effects, path_of(t, ["c"]), .Assigned)
    include(effects, cut(path_of(t, ["a"])), .Assigned)
    assert_eq(effects.accesses.len(), 2)
}

@test
test_include_keeps_the_first_origin :: fn() -> void {
    effects :: ParamEffects {}
    include(effects, ROOT, .Stored, mark_origin(0))
    include(effects, ROOT, .Stored, mark_origin(1))
    assert_eq(effects.constraint_at(0), mark_origin(0))
}

@test
test_drop_covered_keeps_each_origin_with_its_access :: fn() -> void {
    t :: PathTable {}
    effects :: ParamEffects {}
    include(effects, path_of(t, ["a", "b"]), .Assigned, mark_origin(0))
    include(effects, path_of(t, ["c"]), .Assigned, mark_origin(1))
    include(effects, cut(path_of(t, ["a"])), .Assigned, mark_origin(2))
    assert_eq(effects.origins.len(), 4)
    assert_eq(effects.constraint_at(0), mark_origin(1))
    // The cut path stands for `.a.b`, and takes its origin.
    assert_eq(effects.constraint_at(1), mark_origin(0))
}

@test
test_widening_survives_a_shrink_and_a_kept_element :: fn() -> void {
    t :: PathTable {}
    shrunk :: Access { .path = ROOT, .effect = .Shrunk }
    kept :: Access { .path = path_of(t, [ELEMENT]), .effect = .Stored }
    assert(!breaks_widening(shrunk, 1), "a pop takes nothing in")
    assert(!breaks_widening(kept, 1), "the element escapes as what it is")
}

@test
test_widening_breaks_on_a_grown_or_kept_array :: fn() -> void {
    t :: PathTable {}
    grown :: Access { .path = ROOT, .effect = .Resized }
    inner_kept :: Access { .path = path_of(t, [ELEMENT]), .effect = .Stored }
    assert(breaks_widening(grown, 1), "a push may add a wider value")
    assert(breaks_widening(inner_kept, 2), "an inner array escapes under the wider type")
}

@test
test_widening_breaks_on_a_replaced_element_only :: fn() -> void {
    t :: PathTable {}
    replaced :: Access { .path = path_of(t, [ELEMENT]), .effect = .Assigned }
    field :: Access { .path = path_of(t, [ELEMENT, "r"]), .effect = .Assigned }
    assert(breaks_widening(replaced, 1), "`xs[i] = wider` replaces an element")
    assert(!breaks_widening(field, 1), "a field of the element keeps its own type")
}

@test
test_widening_breaks_when_unknown_code_gets_the_array :: fn() -> void {
    t :: PathTable {}
    array :: Access { .path = EVERYWHERE, .effect = .Unknown }
    element :: Access { .path = cut(path_of(t, [ELEMENT])), .effect = .Unknown }
    assert(breaks_widening(array, 1), "unknown code may push into the array")
    assert(!breaks_widening(element, 1), "unknown code handed an element cannot replace it")
}
