// vader/front/effects/callees: what a call may run, as targets of the fixed point.
//
// The typecheck records what each call settles on (`call_sites.vader`, ADR 0056).
// A function with a body is a node of the call graph. A bodyless one does what
// the compiler knows of it: a member of `Intrinsic` by `member_summary`, an
// `@extern` by its `@c_out` parameters. So does a primitive of `std/task`
// (`task_primitives.vader`), body or not: what it does to a task is the runtime's, not
// what its body shows ; and a function that only forwards to a member of
// `Intrinsic`, which does what the member does (`forwarded_effects`).
// A member reached through a trait is the member of that name in every impl of the
// trait, the whole program being compiled. A function value, or a site the record
// could not settle, may do anything.

module "vader/front/effects"

import "std/abort"
import "std/collections"
import "std/iter"
import "std/string"
import "vader/core/bytecode"
import "vader/core/mangle"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/resolver"
import "vader/front/typecheck"

AST :: import "toolchain/ast"

/// The functions of a project: the nodes of the call graph, and what each
/// function the compiler summarises without its body does.
export CalleeIndex :: struct {
    /// Per node, the function and the module that typed it.
    functions: Function[] = []
    /// Declaration id -> node, for each function with a body.
    nodes: Map<i64, i32> = Map<i64, i32> {}
    /// A trait default's declaration id -> the node every impl inheriting it runs.
    /// Apart from `nodes`: a declaration naming the trait's member itself may reach
    /// any impl's override, so `target_of_decl` must not find the default there.
    default_nodes: Map<i64, i32> = Map<i64, i32> {}
    /// Declaration id -> what a function summarised without its body does: a
    /// bodyless one, or a door of the task check.
    summarised: Map<i64, CallTarget> = Map<i64, CallTarget> {}
    /// The declarations of the intrinsics that hand back a frozen view
    /// (`HostSummary.frozen_view`).
    frozen_views: Set<i64> = Set<i64> {}
    /// The array type of a view, as such an intrinsic declares its result
    /// (`u8[]`) ; null when the project has none.
    view: ArrayType | null = null
    /// The nodes that return a view, found once the facts are settled
    /// (`spread_views`).
    view_nodes: Set<i32> = Set<i32> {}
    /// The nodes that return an iterator that hands views out, or that yield views:
    /// what such a call returns hands one out at each step (`spread_views`).
    handing_nodes: Set<i32> = Set<i32> {}
    /// The `trait_key` of `Iterator`, whose `next` hands out a part of its receiver.
    iterator_key: string = ITERATOR_TRAIT_KEY
    /// Per node of a `next`, the nodes whose body builds an iterator it serves: they
    /// are walked again once that `next` is found to return a view.
    built_by: Map<i32, Set<i32>> = Map<i32, Set<i32>> {}
    /// The structs some enum keeps its variant data in, by symbol id.
    variant_data: Set<i32> = Set<i32> {}
    /// Per declaration id, what a primitive is to a task (`task_doors.vader`).
    doors: Map<i64, TaskPrimitive> = Map<i64, TaskPrimitive> {}
    /// The declaration ids of the functions the host of `deep_copy` serves: the
    /// member `Runtime.deep_copy`, and every function that forwards to it
    /// (`deep_copy_check.vader`).
    deep_copies: Set<i64> = Set<i64> {}
    /// Every module constant's initialiser, which may hand a frozen value on.
    constants: Initialiser[] = []
    /// Every struct field default, which every struct built without the field keeps.
    defaults: Initialiser[] = []
    /// The impls of every module, each resolved in the module that declares it.
    impls: ImplRegistry = ImplRegistry {}
    /// Every path the summary names.
    paths: PathTable = PathTable {}
    /// What a callee nothing is known of does with each argument (`EvalCtx.any`).
    /// Every evaluation reads this one set, so nothing includes into it: a fact
    /// that starts as it is a fresh `any_effects()`.
    any: ParamEffects = any_effects()
    /// The loaded project, whose modules hold the symbols a namespace alias names.
    project: LoadedProject
    /// `trait_key.member` -> the members of that name of every impl of the trait.
    members: Map<string, CallTarget[]> = Map<string, CallTarget[]> {}
    /// Bodyless functions the compiler knows nothing of while they are lent a value
    /// that holds references: each is assumed to do anything with it.
    unknown: string[] = []
    /// The members of `std/core`'s `Intrinsic` and `Runtime`, by declaration id.
    intrinsics: Map<i64, ToolchainMember> = Map<i64, ToolchainMember> {}
}

/// A member of a trait the toolchain implements.
export ToolchainMember :: struct {
    /// Its signature : a member of a trait has no symbol to hold one.
    signature: FnType
    /// The `trait_key` of the trait declaring it.
    trait_key: string
}

/// A function with a body.
export Function :: struct {
    decl: AST.FnDecl
    typed: TypedProgram
}

/// A value the program evaluates outside a function, a constant's initialiser or
/// a field default, and the module that typed it.
export Initialiser :: struct {
    value: AST.Expr
    typed: TypedProgram
    /// The symbol id of the frozen constant it initialises ; null for a field default.
    initialises: i32 | null = null
}

/// Index every function of `project`, and the impls of every module: the
/// typecheck's own registry holds the entry module's alone.
///
/// @param project  the loaded project, whose declarations hold the bodies.
/// @param modules  the typed modules, by the same key as `project.modules`.
index_functions :: fn(
    project: LoadedProject, modules: Map<string, TypedProgram>,
) -> CalleeIndex {
    index :: CalleeIndex { .project = project }
    for [id, loaded] in project.modules {
        typed :: modules[id] else continue
        for file in loaded.module.files {
            index.impls.collect_impls(file.program.decls, typed.resolved, typed)
            for d in file.program.decls {
                match d {
                    is AST.FnDecl     -> { index.register(d, typed) }
                    is AST.ImplDecl   -> {
                        for member in d.members {
                            index.register_member(member, d, typed, modules)
                        }
                    }
                    is AST.ConstDecl  -> {
                        sym :: loaded.collected.symbols[d.name] else continue
                        index.constants.push(constant_initialiser(d, sym, typed))
                    }
                    is AST.StructDecl -> { index.register_defaults(d, typed) }
                    is AST.EnumDecl   -> {
                        data :: declared_enum_data(d, typed) else continue
                        index.variant_data.add(data.symbol.id)
                    }
                    is AST.TraitDecl  -> { index.register_intrinsics(d, typed) }
                    is AST.AssertDecl | AST.ImportDecl | AST.TypeAliasDecl -> {}
                }
            }
        }
    }
    return index
}

// The initialiser of the module constant `decl`.
constant_initialiser :: fn(decl: AST.ConstDecl, sym: Symbol, typed: TypedProgram) -> Initialiser =
    Initialiser {
        .value = decl.value,
        .typed = typed,
        .initialises = sym.id,
    }

// Note what each member of `decl` does when the toolchain implements it
// (`Intrinsic`, `Runtime`): a member is summarised by its op or its service,
// never a node.
register_intrinsics :: fn(index: CalleeIndex, decl: AST.TraitDecl, typed: TypedProgram) -> void {
    trait_sym :: toolchain_trait_of(decl, typed) else return
    for member in decl.members {
        // Every reader of a member decides for it by its `IntrinsicId` or its
        // `RuntimeService` ; one both enums lack would be served by nothing.
        name :: member.name
        if intrinsic_id(name) == null && runtime_service(name) == null {
            panic("effects: `${trait_sym.name}.${name}` has no `IntrinsicId` nor `RuntimeService`")
        }
        index.intrinsics[member.id] = ToolchainMember {
            .signature = trait_member_type(trait_sym.id, member, typed),
            .trait_key = trait_key_of(trait_sym),
        }
        index.register(member, typed)
    }
}

// Note each default of `decl`'s fields.
register_defaults :: fn(index: CalleeIndex, decl: AST.StructDecl, typed: TypedProgram) -> void {
    for field in decl.fields {
        value :: field.default else continue
        index.defaults.push(Initialiser { .value = value, .typed = typed })
    }
}

// Make `member` of `impl_` a node: one the impl inherits from its trait runs the
// trait's default body, read in the trait's module, one node for every impl.
register_member :: fn(
    index: CalleeIndex,
    member: AST.FnDecl,
    impl_: AST.ImplDecl,
    typed: TypedProgram,
    modules: Map<string, TypedProgram>,
) -> void {
    inherited :: index.inherited_function(member, impl_, modules) else {
        index.register(member, typed)
        return
    }
    shared :: index.default_nodes[inherited.decl.id]
    if shared != null {
        index.nodes[member.id] = shared
        return
    }
    node :: index.add_node(inherited)
    index.default_nodes[inherited.decl.id] = node
    index.nodes[member.id] = node
}

// Add `f` to the nodes ; its node.
add_node :: fn(index: CalleeIndex, f: Function) -> i32 {
    index.functions.push(f)
    return i32(index.functions.len() - 1)
}

// The trait's default body `member` runs, in the trait's module ; null for a
// member the impl writes.
inherited_function :: fn(
    index: CalleeIndex,
    member: AST.FnDecl,
    impl_: AST.ImplDecl,
    modules: Map<string, TypedProgram>,
) -> Function | null {
    inherited :: member.inherits else return null
    entry :: index.impls.entry_of(impl_) else return null
    owner :: modules[entry.trait_symbol.module] else return null
    return Function { .decl = inherited, .typed = owner }
}

// Make `decl` a node when it has a body that is no door of the task check, else
// note what it does.
register :: fn(index: CalleeIndex, decl: AST.FnDecl, typed: TypedProgram) -> void {
    forwarding :: forwarded_operation(decl, typed)
    door :: door_declared_by(decl, typed, forwarding)
    if door != null {
        index.doors[decl.id] = door
        effects :: primitive_effects(index.paths, door, decl.params.len())
        index.summarised[decl.id] = KnownEffects { .params = effects }
        return
    }
    forwarded :: forwarded_effects(index, decl, forwarding)
    if forwarded != null {
        index.summarised[decl.id] = KnownEffects { .params = forwarded }
        return
    }
    if decl.body != null {
        index.nodes[decl.id] = index.add_node(Function { .decl = decl, .typed = typed })
        return
    }
    index.summarised[decl.id] = index.summary_target(decl, typed)
}

// What `decl` does when it only forwards its parameters to a member of
// `Intrinsic`, `forwarding`: the member's effects, so a diagnostic names `decl`
// and the value it was handed, never the member. Null for any other function, a
// native operator's included: its body says what it does.
forwarded_effects :: fn(
    index: CalleeIndex,
    decl: AST.FnDecl,
    forwarding: Forwarding | null,
) -> ParamEffects[] | null {
    member :: forwarding else return null
    if member is ForwardedOperator {
        return null
    }
    if runtime_service(member.name) == RuntimeService.DeepCopy {
        index.deep_copies.add(decl.id)
    }
    return member_summary(member.name).params
}

// What `decl`, summarised without its body, does: an `@extern` writes what `@c_out`
// marks, a member of `Intrinsic` what `member_summary` says ; one neither describes
// does nothing to a parameter that holds no references, and anything to one that
// does.
summary_target :: fn(
    index: CalleeIndex,
    decl: AST.FnDecl,
    typed: TypedProgram,
) -> CallTarget {
    if AST.has_compiler_decorator(decl.decorators, .Extern) {
        return KnownEffects { .params = decl.params.map(foreign_effects).collect() }
    }
    // By its node id : an inherited member shares its parameters' spans with the
    // other impls of its trait.
    signature :: index.signature_of(decl, typed)
    member :: member_of(index, decl)
    known :: member_summary(member)
    if known.frozen_view {
        index.frozen_views.add(decl.id)
        index.view = returned_array(signature)
    }
    if runtime_service(member) == RuntimeService.DeepCopy {
        index.deep_copies.add(decl.id)
    }
    if known.params != null {
        return KnownEffects { .params = known.params }
    }
    if signature is FnType && !signature.params.any_match((t: Type) -> holds_references(t)) {
        return KnownEffects { .params = decl.params.map((_) -> none()).collect() }
    }
    index.unknown.push(index.function_key(decl, typed))
    return AnyCallee {}
}

// The type declared for `decl`: its own, or for a member of `Intrinsic` or
// `Runtime`, which has no symbol to hold one, its member's.
signature_of :: fn(index: CalleeIndex, decl: AST.FnDecl, typed: TypedProgram) -> Type | null {
    declared :: declared_fn_type(typed, decl)
    if declared != null {
        return declared
    }
    member :: index.intrinsics[decl.id] else return null
    return member.signature
}

// The array a function of type `declared` returns ; null for any other result.
returned_array :: fn(declared: Type | null) -> ArrayType | null {
    if declared is FnType {
        return array_backing(declared.return_type)
    }
    return null
}

// C reads a parameter of an `@extern`, and writes one marked `@c_out`.
foreign_effects :: fn(p: AST.FnParam) -> ParamEffects {
    if AST.has_compiler_decorator(p.decorators, .COut) {
        return effects_of(.Assigned, EVERYWHERE)
    }
    return none()
}

// The name of the member of `Intrinsic` or `Runtime` `decl` is ; `""` for any
// other function.
member_of :: fn(index: CalleeIndex, decl: AST.FnDecl) -> string {
    if decl.id !in index.intrinsics {
        return ""
    }
    return decl.name
}

// The key of a function in the dump of the unknown ones: `trait_key.member` for a
// member of an impl, of `Intrinsic` or of `Runtime`, `module.name` for a free
// function.
function_key :: fn(index: CalleeIndex, decl: AST.FnDecl, typed: TypedProgram) -> string {
    member :: index.intrinsics[decl.id]
    if member != null {
        return vtable_key(member.trait_key, decl.name)
    }
    entry :: index.impls.member_entry(decl)
    if entry != null {
        return vtable_key(entry.trait_key, decl.name)
    }
    return "${typed.resolved.display_path}.${decl.name}"
}

// Whether a value of type `t` may reach something a function could change
// (`is_value_only_type`) ; true when the type is not known.
holds_references :: fn(t: Type | null) -> bool {
    known :: t else return true
    return !is_value_only_type(known)
}

// Whether `decl`, a function of the project, is a generator: its body runs as the
// iterator its call returns is pulled.
is_generator :: fn(index: CalleeIndex, decl: AST.FnDecl) -> bool {
    node :: index.nodes[decl.id] else return false
    f :: index.functions[node]
    return fn_is_generator(f.typed, f.decl)
}

// ---- targets --------------------------------------------------------------

/// What a call to `callee` may run ; empty for one that runs nothing, a cast or a
/// numeric operator.
///
/// @param index   the project's functions.
/// @param callee  what the record says the call invokes.
targets_of :: fn(index: CalleeIndex, callee: Callee) -> CallTarget[] = match callee {
    is DirectFn    -> index.direct_targets(callee)
    is BoundMember -> index.member_targets(callee.trait_key, callee.member)
    is TraitMember -> index.member_targets(callee.trait_key, callee.member)
    is EachOf      -> each_targets(index, callee.callees)
    is Builtin     -> []
    is FnValue | ErroneousCallee | UnsettledCallee -> [AnyCallee {}]
}

// A direct call runs its declaration ; one chosen against a type parameter runs, at
// an instance, the impl of that instance's own type, which may be any impl's
// member of that name.
direct_targets :: fn(index: CalleeIndex, callee: DirectFn) -> CallTarget[] {
    own :: index.target_of_decl(callee.decl)
    if !callee.per_instance {
        return [own]
    }
    entry :: index.impls.member_entry(callee.decl) else return [own]
    out: CallTarget[]: [own]
    out.push_all(index.member_targets(entry.trait_key, callee.decl.name))
    return out
}

each_targets :: fn(index: CalleeIndex, callees: Callee[]) -> CallTarget[] =
    callees.flat_map((c) -> index.targets_of(c)).collect()

// What running `decl` does: its node, or what it does without a body. A
// declaration the index never met (a trait's own member) may do anything.
target_of_decl :: fn(index: CalleeIndex, decl: AST.FnDecl) -> CallTarget {
    node :: index.nodes[decl.id]
    if node != null {
        return CalleeNode { .node = node }
    }
    return index.summarised[decl.id] else AnyCallee {}
}

// The member `member` of every impl of the trait `trait_key`, an inherited one
// included, once per node : the impls inheriting one default share it. An impl
// that lacks it is one in error: it may do anything.
member_targets :: fn(index: CalleeIndex, trait_key: string, member: string) -> CallTarget[] {
    key :: vtable_key(trait_key, member)
    cached :: index.members[key]
    if cached != null {
        return cached
    }
    out: CallTarget[]: []
    reached :: Set<i32> {}
    for entry in index.impls.all {
        if entry.trait_key != trait_key {
            continue
        }
        decl :: entry.decl.members.find((m) -> m.name == member) else {
            out.push(AnyCallee {})
            continue
        }
        target :: index.target_of_decl(decl)
        if target is CalleeNode && !reached.add(target.node) {
            continue
        }
        out.push(target)
    }
    index.members[key] = out
    return out
}

// ---- intrinsics -----------------------------------------------------------

/// What a member of `Intrinsic` or `Runtime` does beyond what its signature says.
MemberSummary :: struct {
    /// What it does with each parameter ; null when it does nothing the
    /// signature does not tell.
    params:      ParamEffects[] | null = null
    /// It hands back a view of a frozen value: the bytes of a string, which alias
    /// the interned string (ADR 0053).
    frozen_view: bool = false
}

/// What the member named `member` of `Intrinsic` or `Runtime` does with its
/// parameters ; nothing the signature does not tell for any other function.
///
/// @param member  the member's name, `""` for none.
member_summary :: fn(member: string) -> MemberSummary {
    id :: intrinsic_id(member)
    if id != null {
        return op_summary(id)
    }
    service :: runtime_service(member) else return MemberSummary {}
    return service_summary(service)
}

/// What the member `id` of `Intrinsic` does with its parameters. Exhaustive, so a
/// new member is a decision here.
///
/// @param id  the member.
op_summary :: fn(id: IntrinsicId) -> MemberSummary = match id {
    .ArrayLen           -> MemberSummary { .params = [none()] }
    .ArrayPush          -> MemberSummary { .params = push_effects(ROOT) }
    .ArrayPushAll       -> MemberSummary { .params = push_effects(elements_of()) }
    .ArrayCopyTo        -> MemberSummary { .params = copy_to_effects(elements_of()) }
    .ArrayRemoveLast    -> MemberSummary { .params = [remove_last_effects(elements_of())] }
    .ArrayClear         -> MemberSummary { .params = [effects_of(.Shrunk, ROOT)] }
    .NewByteBuffer      -> MemberSummary { .params = [none()] }
    .BufferLoadU8       -> MemberSummary { .params = [none(), none()] }
    .BufferStoreU8      -> MemberSummary { .params = writes_bytes(elements_of()) }
    .BufferMemoryCopy   -> MemberSummary { .params = memory_copy_effects(elements_of()) }
    .BufferInternString -> MemberSummary { .params = [none(), none()] }
    .BufferWriteString  -> MemberSummary { .params = writes_bytes(elements_of()) }
    // Their signature says it all: scalars and strings, which nothing writes.
    .ByteLen | .ByteAt | .ByteSlice | .IsAscii | .StringHash | .StringCompare
        | .F64ToBits | .BitsToF64 | .F32ToBits | .BitsToF32 -> MemberSummary {}
}

/// What the service `service` of `Runtime` does with its parameters. Exhaustive,
/// so a new service is a decision here.
///
/// @param service  the service.
service_summary :: fn(service: RuntimeService) -> MemberSummary = match service {
    .Bytes              -> MemberSummary { .frozen_view = true }
    .BytesToString      -> MemberSummary { .params = [none()] }
    .DeepCopy           -> MemberSummary { .params = [none()] }
    .WasmStreamRead     -> MemberSummary { .params = [none(), none(), none()] }
    .WasmFutureWait     -> MemberSummary { .params = [none()] }
    .WasmStreamDrop     -> MemberSummary { .params = [none()] }
    .WasmFutureDrop     -> MemberSummary { .params = [none()] }
    // A thread runs a function value, as `spawn_thread` does; the others take
    // scalars.
    .WasmThreadNew | .WasmThreadSuspend | .WasmThreadResumeLater | .WasmThreadYield
        | .WasmThreadIndex | .WasmThreadExit -> MemberSummary {}
    .FfiCall            -> MemberSummary { .params = ffi_call_effects(elements_of()) }
    .FfiCallFrame       -> MemberSummary { .params = ffi_call_frame_effects(elements_of()) }
    // Their signature says it all: scalars and strings, which nothing writes.
    .RuntimeCollect | .RuntimeCountAllocations | .RuntimeStatistic
        | .SchedulerSpawn | .SchedulerPark | .SchedulerWake | .SchedulerSleepFor
        | .SchedulerCancel | .SchedulerCurrent | .SchedulerIsCancelled | .SchedulerIsLeaving
        | .SchedulerWatchReadable | .SchedulerWatchExit | .SchedulerMonitorEnter
        | .SchedulerMonitorExit | .SchedulerTaskEnded
        | .WaitStop | .WaitFor
        | .AbortPanic | .TargetCurrentOs | .TargetCurrentArch
        | .FfiOpen | .FfiOpenPath | .FfiSymbol -> MemberSummary {}
    // Reads where its value lies, and writes none of it.
    .SchedulerMonitorGive -> MemberSummary { .params = [none()] }
    // Read where their value lies, or take and let go of a mutex its holder
    // alone writes, which no task sees as a write of the value.
    .SchedulerPublish | .SchedulerMutexLock | .SchedulerMutexUnlock
        | .SchedulerMutexWait -> MemberSummary {
        .params = [none()],
    }
}

// `self.push(value)` and `self.push_all(other)`: `self` grows, and keeps the value
// at `kept` below the argument (the value itself, or the elements of `other`).
push_effects :: fn(kept: PartPath) -> ParamEffects[] =
    [effects_of(.Resized, ROOT), effects_of(.Stored, kept)]

// `store_u8` and `write_string` write bytes of `self`.
writes_bytes :: fn(elements: PartPath) -> ParamEffects[] =
    [effects_of(.Assigned, elements), none(), none()]

// `self.copy_to(source_offset, destination, destination_offset, count)`: the
// elements of `self` go into `destination`.
copy_to_effects :: fn(elements: PartPath) -> ParamEffects[] =
    [effects_of(.Stored, elements), none(), effects_of(.Assigned, elements), none(), none()]

// `self.remove_last()` shortens `self` and hands back the element it removed.
remove_last_effects :: fn(elements: PartPath) -> ParamEffects {
    effects :: effects_of(.Shrunk, ROOT)
    effects.insert(Access { .path = elements, .effect = .Returned })
    return effects
}

// `self.memory_copy(d, src, s, n)` writes bytes of `self`, read from `src`.
memory_copy_effects :: fn(elements: PartPath) -> ParamEffects[] =
    [effects_of(.Assigned, elements), none(), none(), none(), none()]

// `ffi_call(fn_ptr, desc, frame, nfixed)`: the foreign function writes its result
// into `frame`.
ffi_call_effects :: fn(elements: PartPath) -> ParamEffects[] =
    [none(), none(), effects_of(.Assigned, elements), none()]

// `ffi_call_frame(fn_ptr, desc, frame)`: the adapter writes its result into
// `frame`, as the runtime does the addresses it resolves.
ffi_call_frame_effects :: fn(elements: PartPath) -> ParamEffects[] =
    [none(), none(), effects_of(.Assigned, elements)]

none :: fn() -> ParamEffects = ParamEffects {}

// The single access `effect` at `path`.
effects_of :: fn(effect: Effect, path: PartPath) -> ParamEffects {
    effects :: ParamEffects {}
    effects.insert(Access { .path = path, .effect = effect })
    return effects
}

// The path to the elements of a parameter.
elements_of :: fn() -> PartPath = child(ROOT, ELEMENT_STEP)

// ---- tests ----------------------------------------------------------------

import "std/env"
import "std/fs"
import "std/testing"

@test
test_member_summary_push_resizes_and_stores :: fn() -> void {
    effects :: op_summary(.ArrayPush).params else []
    assert_eq(effects.len(), 2)
    assert(effects[0].accesses[0].effect == .Resized, "push resizes its receiver")
    assert(effects[1].accesses[0].effect == .Stored, "push keeps its value")
}

@test
test_member_summary_of_no_member :: fn() -> void {
    assert(member_summary("").params == null, "no member")
}

@test
test_holds_references_of_a_value :: fn() -> void {
    assert(!holds_references(TY_BOOL), "bool")
    assert(holds_references(mk_array(TY_BOOL)), "bool[]")
    assert(holds_references(null), "an unknown type")
}

// Each variant of `IntrinsicId` names a member of the prelude's `Intrinsic`, and
// each of `RuntimeService` one of its `Runtime`, or it serves a member nothing
// declares. The other way round, a member with no variant, `register_intrinsics`
// refuses in every build.
@test
test_every_member_variant_names_a_member_of_its_trait :: fn() -> void {
    dir :: create_unique_dir(temp_dir(), "intrinsic_members.") else panic("no temporary folder")
    entry :: join_path(dir, "_main.vader")
    assert_succeeds(write_file(entry, "module \"probe\"\n\nmain :: fn() -> i32 = 0\n"))
    project :: load_project(entry, [], null)
    core :: project.modules[find_core_module_id(project) else ""] else {
        fail("the prelude is loaded")
        return
    }
    traits: AST.TraitDecl[]: []
    for f in core.module.files {
        traits.push_all(f.program.decls.filter_is<AST.TraitDecl>().collect())
    }
    ops :: members_of_trait(traits, TRAIT_INTRINSIC)
    services :: members_of_trait(traits, TRAIT_RUNTIME)
    for id in IntrinsicId {
        member :: member_name(id)
        if member != "" {
            assert(member in ops, member)
        }
    }
    for service in RuntimeService {
        member :: service_member(service)
        if member != "" {
            assert(member in services, member)
        }
    }
}

// The names of the members of the trait `name` among `traits`, none when it is
// absent.
members_of_trait :: fn(traits: AST.TraitDecl[], name: string) -> string[] {
    found :: traits.find((t) -> t.name == name) else return []
    return found.members.map((m) -> m.name).collect()
}
