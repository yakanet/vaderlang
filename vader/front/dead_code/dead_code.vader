// vader/front/dead_code/dead_code — name-reachability lints : W0007 (dead private
// decls, per-module, on every build) and W0012 (dead exported fns, project-wide,
// `vader lint` only).
//
// A reference-reachability lint. For every top-level declaration of the (merged,
// all-files) module, collect the NAMES it references — in bodies, signatures,
// field / alias / const / enum types, decorator args. Then BFS from the roots
// (`export`-visible decls, `main`, `@test` / `@extern` / `@intrinsic`, every
// `impl` member, `@assert`); a PRIVATE top-level decl whose name is never reached
// is dead → W0007.
//
// `dead_exports` (W0012, at the bottom) reuses the very same collectors and BFS,
// but merges EVERY module's decls and drops the `export`-is-a-root clause, so a
// public fn unreachable across the whole project — invisible to the per-module
// W0007 and to a lowered-project DCE diff (lazy lowering never materialises it) —
// is flagged. Never on the default build — `vader lint` and the LSP's diagnostic
// pass (`tools/lsp/analysis/diagnostics.vader`) are its only two callers.
//
// Name-based by design. Resolving every reference to a `Symbol.id` is the gap
// that sank the unused-import attempt (W0006) : `resolved.idents` is span-keyed,
// `files[0]`-only, and misses positions. Collecting names over the merged AST
// over-approximates uses (a local shadowing a top-level name marks it used) — the
// SAFE bias for a lint : we under-report, never false-positive (a false positive
// would tell you to delete live code). The names come from one `AST.inspect` walk,
// which reaches every node, interpolated parts included: an identifier names what
// it reads, and the field of `recv.foo()` the fn UFCS reaches.

module "vader/front/dead_code"

import "std/collections"
import "std/iter"
import "std/string"
import "vader/support/diagnostics"
import "vader/front/resolver"
AST :: import "toolchain/ast"
Parse :: import "vader/front/parser"
import "toolchain/span"

// A private top-level declaration that may be dead — keyed for the final report.
DeadDecl :: struct {
    name: string
    name_span: Span
}

// ---- name collection ------------------------------------------------------

// Push every name `n` and the nodes under it reference: an identifier, and the
// field of a `recv.field` access, through which UFCS reaches a fn. `AST.inspect`
// reaches every node, type positions, decorator arguments and interpolated parts
// included, so only the nodes that carry a name need an arm.
collect_names :: fn(n: AST.Node, out: string[]) -> void {
    AST.inspect(n, (m) -> referenced_name(m, out))
}

// Only an identifier and a field access carry a name of their own ; every other
// node is walked for its children.
referenced_name :: fn(n: AST.Node, out: string[]) -> AST.Walk {
    if n is AST.IdentExpr {
        out.push(n.name)
    } else if n is AST.FieldExpr {
        out.push(n.field)
    }
    return .Descend
}

// ---- root classification --------------------------------------------------

is_public :: fn(v: AST.Visibility) = v == .Public

/// A declaration pins liveness regardless of visibility when it is an entry point
/// (`main`), host- or test-wired (`@test` / `@extern` / `@intrinsic` / `@export`),
/// or explicitly exempted by the author (`@allow_unused`, for intentional dead
/// code : an API not yet wired, a symmetry helper, a test fixture's deliberate
/// decoy). The single root list shared by both name-reachability lints : W0007
/// (`is_root_decl`) adds the public surface on top ; W0012 (`dead_exports`) uses
/// this alone, so a project-dead PUBLIC fn stays flaggable.
is_wired_root :: fn(decorators: AST.Decorator[], name: string) -> bool {
    if name == "main" {
        return true
    }
    for dec in decorators {
        if dec.name == "test"      { return true }
        if dec.name == "extern"    { return true }
        if dec.name == "intrinsic" { return true }
        if dec.name == "export"    { return true }
        if dec.name == "allow_unused" {
            return true
        }
    }
    return false
}

// A W0007 reachability root : the public surface (`export`), every wired-or-exempt
// root, plus a build driver's entry. Never flagged, its refs kept live.
//
// `build` in `build.vader` is an entry point exactly as `main` is — reserved by
// NAME in its module, with no decorator to mark it. Its only caller is the shim
// `vader build` writes beside it and removes afterwards, so from the module's own
// point of view nothing reaches it ; without this the lint tells every driver
// author their `build` is dead code. The test sits HERE and not in
// `is_wired_root` because only a per-module walk has a module name to test: W0012
// merges every module's decls, so the same test there would root a fn named
// `build` in any module at all.
is_root_decl :: fn(
    v: AST.Visibility,
    decorators: AST.Decorator[],
    name: string,
    module_name: string,
) = is_public(v) || is_wired_root(decorators, name) || module_name == DRIVER_MODULE && name == DRIVER_ENTRY

// ---- shared traversal (W0007 + W0012) -------------------------------------

// One named top-level decl's identity plus the names it references — the unit
// both lints classify. `is_fn` lets W0012 flag fn exports only.
NamedDeclRefs :: struct {
    name: string
    name_span: Span
    visibility: AST.Visibility
    decorators: AST.Decorator[]
    is_fn: bool
    refs: string[]
}

// Collect the reference names of a top-level decl. For the six NAMED kinds
// returns its identity + refs ; for `impl` / `@assert` (whose refs are always
// live) it seeds them into `seed_refs` and returns null ; imports reference no
// in-module name and return null. The single source of truth for "what does a
// decl reference", shared by `check_dead_code` (W0007) and `dead_exports`
// (W0012) so the two can never drift a collection edge apart.
collect_decl_refs :: fn(d: AST.Decl, seed_refs: string[]) -> NamedDeclRefs | null {
    return match d {
        is AST.FnDecl        -> named_decl(d, d.name, d.name_span, d.visibility, d.decorators, true)
        is AST.ConstDecl     -> named_decl(d, d.name, d.name_span, d.visibility, d.decorators, false)
        is AST.StructDecl    -> named_decl(d, d.name, d.name_span, d.visibility, d.decorators, false)
        is AST.EnumDecl      -> named_decl(d, d.name, d.name_span, d.visibility, d.decorators, false)
        is AST.TraitDecl     -> named_decl(d, d.name, d.name_span, d.visibility, d.decorators, false)
        is AST.TypeAliasDecl -> named_decl(d, d.name, d.name_span, d.visibility, d.decorators, false)
        is AST.ImplDecl      -> {
            // Impl members are dispatched (vtable / UFCS) and can't be proven dead ;
            // the block is nameless. Seed its refs as live roots.
            collect_names(d, seed_refs)
            seed_refs.push(d.trait_name)
            null
        }
        is AST.AssertDecl    -> {
            collect_names(d, seed_refs)
            null
        }
        is AST.ImportDecl    -> {
            null
        }
    }
}
// Imports name CROSS-module symbols ; unused imports are W0006's job.

// A named decl's identity and the names it references: one constructor so the six
// arms of `collect_decl_refs` stay one line each.
named_decl :: fn(
    d: AST.Decl,
    name: string,
    name_span: Span,
    visibility: AST.Visibility,
    decorators: AST.Decorator[],
    is_fn: bool,
) -> NamedDeclRefs {
    refs: string[]: []
    collect_names(d, refs)
    return NamedDeclRefs {
        .name = name,
        .name_span = name_span,
        .visibility = visibility,
        .decorators = decorators,
        .is_fn = is_fn,
        .refs = refs,
    }
}

// BFS over the name-edge graph from the seeded roots, returning the reachable
// set. `work` grows as we discover referenced names ; the manual cursor loop
// (not `0..<len`) re-reads the growing length. Shared by both lints.
bfs_reachable :: fn(
    root_names: string[],
    seed_refs: string[],
    refs_by_name: MutableMap<string, string[]>,
) -> MutableSet<string> {
    reachable :: MutableSet<string> {}
    work :: chain(root_names, seed_refs).collect()
    cursor: i64 = 0
    for cursor < work.len() {
        n :: work[cursor]
        cursor += 1
        if !reachable.add(n) {
            continue
        }
        nrefs :: refs_by_name[n]
        if nrefs != null {
            for r in nrefs {
                work.push(r)
            }
        }
    }
    return reachable
}

// ---- entry ----------------------------------------------------------------

/// Flag every private top-level declaration of `decls` that is never reached
/// from the module's public surface — W0007. Runs on every module of a checked
/// project (`vader/pipeline/check`).
///
/// @param decls        the module's merged top-level declarations (all files).
/// @param module_name  the module's declared name — what tells a build driver's
///                     `build` apart from any other fn of that name.
/// @param diags        sink for the W0007 warnings.
/// @param discarded    bodies target selection dropped. Their references count
///                     as roots: a private helper reached only from another
///                     platform's body is live source, not dead code, and saying
///                     otherwise is a false positive on every multi-platform
///                     module (see `resolver::discarded_bodies`).
export check_dead_code :: fn(
    decls: AST.Decl[],
    module_name: string,
    diags: Diagnostic[],
    discarded: AST.FnDecl[] = [],
) -> void {
    refs_by_name :: MutableMap<string, string[]> {}
    root_names: string[]: []
    seed_refs: string[]: []
    flaggable: DeadDecl[]: []
    for d in decls {
        nd :: collect_decl_refs(d, seed_refs) ?? continue
        register_refs(refs_by_name, nd.name, nd.refs)
        if is_root_decl(nd.visibility, nd.decorators, nd.name, module_name) {
            root_names.push(nd.name)
        } else if !is_comptime_helper(d) {
            flaggable.push(DeadDecl { .name = nd.name, .name_span = nd.name_span })
        }
    }
    for d in discarded {
        collect_names(d, seed_refs)
    }
    reachable :: bfs_reachable(root_names, seed_refs, refs_by_name)
    for fd in flaggable {
        if !(fd.name in reachable) {
            diags.push(warning(.DeadCode, fd.name_span, "`${fd.name}` is never used"))
        }
    }
}

// The `__comptime_NAME` fn behind a `NAME :: @comptime …` const: its refs count,
// but only the const, which the user wrote, is reported.
is_comptime_helper :: fn(d: AST.Decl) -> bool = d is AST.FnDecl && d.comptime_synthetic

// Append `refs` to the edge set for `name` (overloads share a name → merge).
register_refs :: fn(m: MutableMap<string, string[]>, name: string, refs: string[]) -> void {
    // A name met first takes `refs` itself.
    before :: m.len()
    cur :: m.get_or_put(name, refs)
    if m.len() == before {
        for r in refs {
            cur.push(r)
        }
    }
}

// ---- unused-export (W0012) : project-wide dead exported fns ----------------
//
// Same name-reachability engine as W0007 (`collect_decl_refs` + `bfs_reachable`),
// but run ONCE over the MERGED decls of every non-stdlib module instead of
// per-module, and with one root difference : a plain `export` is NOT a root here.
// W0007 roots the whole public surface (`is_root_decl`, so it only flags dead
// PRIVATES) ; unused-export uses `is_wired_root` alone, so a public fn
// unreachable across the WHOLE project is flaggable — what the per-module pass
// structurally can't see (an `export` used by no other module looks live to
// W0007 but is dead project-wide).
//
// This lives OUTSIDE the default build : `vader lint` calls it, `vader build`
// never does (P-lean). It runs on load+parse alone — a name-reachability walk
// needs no types — so it is cheap and, unlike a lowered-project diff, immune to
// lazy lowering (which never materialises an unreached imported-module fn and so
// would hide a dead export from any input-vs-output diff).

/// One dead exported function : an `export`-keyword fn unreachable from the
/// project's true roots. `name_span` points at the name token — its file + line
/// carry the location for the report, so no separate module field is needed.
export DeadExport :: struct {
    name: string
    name_span: Span
}

/// Report every `export`-keyword FUNCTION unreachable from the project's true
/// roots — the `unused-export` lint (W0012).
///
/// Pass the MERGED decls of every non-stdlib module, so a fn used by any module
/// counts as reached. Seeds the BFS with the wired roots only (`is_wired_root`)
/// — NOT plain exports — then flags each public non-root fn whose name no live
/// decl reaches. Types / consts are registered (a live one can be a fn's sole
/// caller) but never flagged: fn exports only in v1.
///
/// P-safe (inherits `check_dead_code`'s bias) : a name collision across modules
/// marks the name reachable, so the lint UNDER-reports (never a false positive
/// that would tell you to delete live code). A fn is always named at every call
/// / UFCS / value / generic-instantiation site, so a genuinely used export is
/// never flagged.
///
/// @param decls  the merged top-level decls of every non-stdlib module.
/// @return       every dead exported fn, in the order encountered.
dead_exports :: fn(decls: AST.Decl[], discarded: AST.FnDecl[] = []) -> DeadExport[] {
    refs_by_name :: MutableMap<string, string[]> {}
    root_names: string[]: []
    seed_refs: string[]: []
    flaggable: DeadExport[]: []
    for d in decls {
        nd :: collect_decl_refs(d, seed_refs) ?? continue
        register_refs(refs_by_name, nd.name, nd.refs)
        if is_wired_root(nd.decorators, nd.name) {
            root_names.push(nd.name)
        } else if nd.is_fn && is_public(nd.visibility) {
            // The only kind v1 flags : a plain public non-root fn. Its refs are
            // registered above, so a REACHABLE one still keeps its callees live ;
            // only an unreached one is reported. (A PRIVATE dead fn is W0007's
            // job ; a public non-root type / const is registered but not flagged.)
            flaggable.push(DeadExport { .name = nd.name, .name_span = nd.name_span })
        }
    }
    // Same seeding as W0007, and for the same reason: an export called only from
    // a `@target(.Windows)` body is alive, and a build for another platform must
    // not call it dead. Without this the fix landed for private declarations and
    // left the public ones reporting a false positive.
    for d in discarded {
        collect_names(d, seed_refs)
    }
    reachable :: bfs_reachable(root_names, seed_refs, refs_by_name)
    out: DeadExport[]: []
    for e in flaggable {
        if e.name !in reachable {
            out.push(e)
        }
    }
    return out
}

/// Result of linting a LOADED project for unused exports : the findings plus
/// whether the project exposed a `main` (its reachability seed). A rootless
/// project (`has_main == false`) yields no findings — callers surface an
/// under-report warning instead of trusting the empty list.
///
/// ⚠️ A build driver's `build` is deliberately NOT accepted as that seed, unlike
/// in W0007's per-module roots. Rooting it makes the lint RUN on a driven
/// project, whose closure is the whole compiler — and every compiler export the
/// driver does not reach then reports as unused, all of
/// them alive and called by `vader/tools/cli`, which is not in that closure. Running it
/// needs a scope predicate first: "was this module provided by a TOOLCHAIN root or
/// by the project?", which `Module.origin` answers for `lib/` but not for
/// the compiler, since a checkout reaches `vader/` through the project root — and
/// there the compiler IS the project, where the lint must keep working.
export UnusedExportReport :: struct {
    has_main: bool
    findings: DeadExport[]
}

/// Run `dead_exports` over a loaded project : merge every non-stdlib module's
/// decls, detect the `main` root, and lint. The single source of truth for
/// "lint a loaded project", shared by `vader lint` (`vader/tools/cli`) and the LSP
/// (`vader/tools/lsp/analysis`) so the stdlib filter and `main` detection never drift.
///
/// Bodies target selection discarded are gathered from the same modules and fed
/// in as reachability seeds — see `dead_exports`.
///
/// @param project  the loaded module graph (from `load_project` or the LSP cache).
/// @return         findings + `has_main` (see `UnusedExportReport`).
export dead_exports_of_project :: fn(project: LoadedProject) -> UnusedExportReport {
    all_decls: AST.Decl[]: []
    all_discarded: AST.FnDecl[]: []
    has_main := false
    // Where a module came from, not what it is called: `lib/` hosts every
    // namespace the toolchain ships, so a `std/` name test would put `json`,
    // `regex` and `toolchain` inside a project's lint scope — reporting W0012 on
    // every export the toolchain provides.
    for [_, lm] in project.modules {
        if lm.module.origin == .Toolchain {
            continue
        }
        for d in lm.discarded_bodies {
            all_discarded.push(d)
        }
        for d in concat_file_decls(lm.module.files) {
            all_decls.push(d)
            if d is AST.FnDecl {
                if d.name == "main" {
                    has_main = true
                }
            }
        }
    }
    if !has_main {
        return UnusedExportReport {
            .has_main = false,
            .findings = [],
        }
    }
    return UnusedExportReport {
        .has_main = true,
        .findings = dead_exports(all_decls, all_discarded),
    }
}

/// Render one `DeadExport` as its W0012 warning.
///
/// @param e  the dead exported fn to report.
dead_export_diag :: fn(e: DeadExport) = warning(
    .UnusedExport,
    e.name_span,
    "`${e.name}` is never used",
)

/// Render every finding of `es` as its W0012 warning — the list form of
/// `dead_export_diag`, used by both `vader lint` and the LSP.
///
/// @param es  the dead exported fns to report.
export dead_export_diags :: fn(es: DeadExport[]) -> Diagnostic[] =
    es.map(dead_export_diag).collect()

// ---- tests ----------------------------------------------------------------

import "std/testing"

// Parse `src` as a single-file module and return the number of W0007 the pass
// raises — the reachability BFS exercised end to end on a synthetic graph.
dead_count :: fn(src: string) -> i64 = dead_count_in(src, "t")

// The module name matters to one root only — a driver's `build` — so the tests
// that do not exercise it pass an ordinary name.
dead_count_in :: fn(src: string, module_name: string) -> i64 {
    parsed :: Parse.parse_source(src, "t.vader")
    diags: Diagnostic[]: []
    check_dead_code(parsed.program.decls, module_name, diags)
    return diags.len()
}

@test test_driver_entry_is_a_root :: fn() -> void {
    // `build` in `build.vader` is an entry point exactly as `main` is: its only
    // caller is the shim `vader build` writes beside it and removes afterwards,
    // so nothing in the module reaches it. Flagging it told every driver author
    // their driver was dead code.
    // The module NAME is what decides, not the source text — the lint is handed
    // the name its caller resolved.
    src :: "module \"t\"\nbuild :: fn(args: string[]) -> i32 = 0\n"
    assert_eq(dead_count_in(src, DRIVER_MODULE), 0)
    assert_eq(dead_count_in(src, "elsewhere"), 1)
}

@test
test_flags_unreachable_private :: fn() -> void {
    // `helper` is private and reached by nothing → flagged.
    src :: "module \"t\"\nhelper :: fn() -> i32 = 1\nmain :: fn() -> i32 = 0\n"
    assert_eq(dead_count(src), 1)
}

@test
test_keeps_reachable_private :: fn() -> void {
    // `helper` is reached from `main` → not flagged.
    src :: "module \"t\"\nhelper :: fn() -> i32 = 1\nmain :: fn() -> i32 = helper()\n"
    assert_eq(dead_count(src), 0)
}

@test
test_exported_is_root :: fn() -> void {
    // An exported decl is the public surface ; never flagged even when unused.
    src :: "module \"t\"\nexport helper :: fn() -> i32 = 1\n"
    assert_eq(dead_count(src), 0)
}

@test
test_transitive_dead_flags_both :: fn() -> void {
    // `a` references `b`, but nothing live reaches `a` → both are dead. A plain
    // "has a caller" check would wrongly spare `b`; root-reachability flags both.
    src :: "module \"t\"\na :: fn() -> i32 = b()\nb :: fn() -> i32 = 2\nmain :: fn() -> i32 = 0\n"
    assert_eq(dead_count(src), 2)
}
