// vader/front/comptime/eval_call: tree-walk interpreter for `simple_fn(args)`
// calls at comptime.
//
// Covers `@comptime X :: simple_fn(...)` patterns. A call runs the function the
// typecheck recorded at it (`call_sites`), as the run time does. Each argument is
// evaluated in the caller's context and bound to the callee's parameter symbol
// (made addressable by `vader/front/resolver/body.vader::walk_fn_decl`'s
// `idents[p.span.hash()] = sym` write), then the callee's body is evaluated in a
// fresh `ComptimeContext` carrying the bindings. A generic callee goes to the VM:
// the tree-walk does not substitute its type parameters.
//
// Out of scope : side effects, `if` / `match` in the body. The body must be a
// single `return <expr>` statement or a trailing-expr block ; anything else
// falls back to C4001. Recursion IS bounded: the caller's depth is carried into
// the callee context so the guard also covers cyclic comptime calls.

module "vader/front/comptime"

import "std/collections"
import "vader/support/diagnostics"
import "vader/core/types"
import "vader/front/resolver"
import "vader/front/typecheck"
AST :: import "toolchain/ast"
import "toolchain/span"

/// Evaluate `callee(args)` at comptime when both sides are simple
/// enough : the typecheck recorded a known, non-generic fn at the call, args
/// reduce to concrete `ComptimeValue`s, and the body is a single trailing
/// expression or `return <expr>`.
evaluate_call_expr :: fn(
    expr: AST.CallExpr, context: ComptimeContext,
) -> EvalResult {
    if expr.callee !is AST.IdentExpr {
        return vm_required(expr.span, "CallExpr (non-ident callee)")
    }
    callee :: expr.callee
    // A primitive integer cast written as a call (`i64(16)`) keeps its argument's
    // value, wrapped to the target width.
    if expr.args.len() == 1 && is_int_name(callee.name) {
        arg_result :: evaluate_expr(expr.args[0].value, context)
        value :: arg_result.value ?? return arg_result
        if value is IntValue {
            wrapped :: wrap_to_width(value.value, callee.name)
            return ok(IntValue { .value = wrapped, .type_name = callee.name })
        }
    }
    recorded :: sites_of(context.typed.call_sites, .Call)[expr.id]
    if recorded !is DirectFn {
        return vm_required(expr.span, "CallExpr (callee not a known fn)")
    }
    if recorded.bindings != null {
        return vm_required(expr.span, "CallExpr (generic callee)")
    }
    fn_decl :: recorded.decl
    call_context :: context_declaring(fn_decl, context)
        ?? return vm_required(expr.span, "CallExpr (callee of another module)")
    // Its instance is built by the program's run, which has not started.
    if AST.decorators_have(fn_decl.decorators, "singleton") {
        return fail(comptime_error(.SingletonAtComptime, expr.span, "`${callee.name}`"))
    }
    if fn_decl.params.len() != expr.args.len() {
        return vm_required(expr.span, "CallExpr (arity mismatch)")
    }
    bindings :: MutableMap<i32, ComptimeValue> {}
    for [k, bound] in context.bindings {
        bindings[k] = bound
    }
    arguments: ComptimeValue[]: []
    for arg in expr.args {
        arg_result :: evaluate_expr(arg.value, context)
        value :: arg_result.value ?? return arg_result
        arguments.push(value)
    }
    return evaluate_with_arguments(fn_decl, arguments, bindings, call_context, expr.span)
}

// The context that evaluates the body of `decl`: the caller's own when `decl` is
// declared beside the caller, else that of its module when the evaluation
// reaches the project. Null otherwise.
context_declaring :: fn(decl: AST.FnDecl, context: ComptimeContext) -> ComptimeContext | null {
    if decl_symbol(context.typed.resolved, decl) != null {
        return context
    }
    project :: context.project ?? return null
    for [module, typed] in project.typed.modules {
        if decl_symbol(typed.resolved, decl) != null {
            return declaring_context(module, context)
        }
    }
    return null
}

// The context that evaluates code declared in `module` (a function body, a
// constant, a field default): that module, where its names are resolved, with
// no local binding. Null when the evaluation does not reach the project or the
// module is unknown.
declaring_context :: fn(module: string, context: ComptimeContext) -> ComptimeContext | null {
    project :: context.project ?? return null
    owner :: project.typed.modules[module] ?? return null
    return ComptimeContext {
        ...context,
        .typed = owner,
        .bindings = MutableMap<i32, ComptimeValue> {},
    }
}

/// Evaluate the body of `fn_decl` with its parameters bound to `arguments`, on
/// top of `bindings`. The parameters are resolved in `context.typed`, the module
/// declaring `fn_decl`; the depth budget is the caller's, so the recursion guard
/// also bounds cyclic comptime calls.
///
/// @param fn_decl    the function, its arity that of `arguments`.
/// @param arguments  the values of its parameters, in order.
/// @param bindings   the constants already bound, extended in place.
/// @param context    the evaluator context of the declaring module.
/// @param span       the call, for a C4001.
evaluate_with_arguments :: fn(
    fn_decl: AST.FnDecl,
    arguments: ComptimeValue[],
    bindings: MutableMap<i32, ComptimeValue>,
    context: ComptimeContext,
    span: Span,
) -> EvalResult {
    for i in 0..<arguments.len() {
        parameter :: context.typed.resolved.idents[fn_decl.params[i].span.hash()]
            ?? return vm_required(span, "CallExpr (param sym unresolved)")
        bindings[parameter.id] = arguments[i]
    }
    call_context :: ComptimeContext {
        ...context,
        .bindings = bindings,
    }
    return evaluate_fn_body(fn_decl, call_context, span)
}

evaluate_fn_body :: fn(
    fn_decl: AST.FnDecl, context: ComptimeContext, call_span: Span,
) -> EvalResult {
    body :: fn_decl.body ?? return vm_required(call_span, "CallExpr (callee has no body)")
    trailing :: body.trailing
    if trailing !is null {
        // Sound ONLY with no preceding statements : earlier bindings and early
        // `return`s would be silently dropped, and a self-contained trailing
        // would bake a wrong value. `lift_trailing_return` (parser) puts the
        // final `return <e>` here, so any other statement must route via the VM.
        if body.stmts.len() == 0 {
            return evaluate_expr(trailing, context)
        }
        return vm_required(call_span, "CallExpr (block has statements before trailing)")
    }
    // Block with statements only: accept a single `return <expr>`.
    if body.stmts.len() == 1 {
        s :: body.stmts[0]
        if s is AST.ReturnStmt {
            if !(s.value is null) {
                return evaluate_expr(s.value, context)
            }
        }
    }
    return vm_required(call_span, "CallExpr (body too complex)")
}
