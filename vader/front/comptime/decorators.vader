// vader/front/comptime/decorators: the value of each declared decorator written.
//
// `@Route(.Get, "/users/{id}")` builds a `Route`: the typecheck bound each argument
// to a field (`TypedProgram.decorator_uses`), and this pass evaluates them through
// the tree-walker, then the defaults of the other fields, into one `StructValue`
// per decorator written (`EvaluatedProgram.decorator_values`). An argument the
// tree-walker cannot compute is an error, unless it is written `@comptime`: the
// parser made it a hidden constant, which the VM computes when the tree-walker
// cannot, and the decorator waits for it (`awaiting_decorators`). Nothing of a
// decorator runs with the program.

module "vader/front/comptime"

import "std/collections"
import "std/iter"
AST :: import "toolchain/ast"
import "toolchain/diagnostics"
import "vader/core/types"
import "vader/front/typecheck"

/// Evaluate every declared decorator written in the module of `program`.
///
/// @param program    the module's evaluated program, its constants baked ; the
///                   values go to its `decorator_values`.
/// @param constants  the constants of the project, for an argument or a default
///                   that reads one of another module, an enum variant or a struct.
/// @param diags      where an argument that cannot be evaluated is reported.
evaluate_decorator_uses :: fn(
    program: EvaluatedProgram, constants: ProjectConstants, diags: Diagnostic[],
) -> void {
    context :: decorator_context(program, constants)
    for [_, use] in program.typed.decorator_uses {
        if has_uncomputed_argument(use, program) {
            program.awaiting_decorators.push(use)
        } else {
            record_decorator_value(program, use, context, diags)
        }
    }
}

/// Evaluate the declared decorators that waited for a `@comptime` argument
/// (`awaiting_decorators`), once the VM has computed it.
///
/// @param evaluated  the evaluated project, its deferred constants baked.
/// @param owners     the modules whose deferred constants were baked ; every
///                   module when null. The others keep waiting.
/// @param diags      where an argument or a default that fails is reported.
export evaluate_awaiting_decorator_uses :: fn(
    evaluated: EvaluatedProject, owners: string[] | null, diags: Diagnostic[],
) -> void {
    constants :: ProjectConstants { .typed = evaluated.typed }
    for [module_id, program] in evaluated.modules {
        if program.awaiting_decorators.len() == 0 || owners != null && module_id !in owners {
            continue
        }
        context :: decorator_context(program, constants)
        for use in program.awaiting_decorators {
            // A constant the VM did not compute is reported already.
            if !has_uncomputed_argument(use, program) {
                record_decorator_value(program, use, context, diags)
            }
        }
        program.awaiting_decorators = []
    }
}

decorator_context :: fn(program: EvaluatedProgram, constants: ProjectConstants) = ComptimeContext {
    .typed = program.typed,
    .bindings = program.comptime_decls,
    .project = constants,
}

record_decorator_value :: fn(
    program: EvaluatedProgram, use: DecoratorUse, context: ComptimeContext, diags: Diagnostic[],
) -> void {
    value :: decorator_value(use, context, diags) else return
    program.decorator_values[use.written.id] = DecoratorValue { .use = use, .value = value }
}

// The value `use` builds ; null when an argument or a default fails, reported.
decorator_value :: fn(
    use: DecoratorUse, context: ComptimeContext, diags: Diagnostic[],
) -> StructValue | null {
    fields :: Map<string, ComptimeValue> {}
    failed := false
    for [name, argument] in use.arguments {
        value :: argument_value(argument, context, diags) else {
            failed = true
            continue
        }
        fields[name] = value
    }
    variadic :: use.variadic
    if variadic != null {
        elements: ComptimeValue[]: []
        for element in variadic.elements {
            value :: argument_value(element, context, diags) else {
                failed = true
                continue
            }
            elements.push(value)
        }
        fields[variadic.field] = ArrayValue { .elements = elements, .type = variadic.type }
    }
    if failed {
        return null
    }
    t :: StructType { .symbol = use.symbol, .args = [] }
    result :: complete_struct(t, fields, use.written.span, context)
    value :: result.value else {
        report_failure(result, diags)
        return null
    }
    if value !is StructValue {
        return null
    }
    return value
}

// The value of `argument`, null when its evaluation fails, which is reported.
argument_value :: fn(
    argument: AST.Expr, context: ComptimeContext, diags: Diagnostic[],
) -> ComptimeValue | null {
    result :: evaluate_expr(argument, context)
    value :: result.value else {
        report_failure(result, diags)
        return null
    }
    return value
}

// A failed evaluation reports its diagnostic ; one with none was reported where it
// failed.
report_failure :: fn(result: EvalResult, diags: Diagnostic[]) -> void {
    diag :: result.diag else return
    diags.push(diag)
}

// Whether a `@comptime` argument of `use` names a hidden constant with no value:
// before the VM, one the tree-walker could not compute ; after it, one the VM
// failed on, reported there.
has_uncomputed_argument :: fn(use: DecoratorUse, program: EvaluatedProgram) -> bool =
    use.written.args.any_match((a) -> a.comptime_body != null && !is_computed(a.value, program))

// Whether the hidden constant `reference` names has a value.
is_computed :: fn(reference: AST.Expr, program: EvaluatedProgram) -> bool {
    constant :: program.typed.resolved.idents[reference.span.hash()] else return true
    return program.comptime_decls[constant.id] != null
}
