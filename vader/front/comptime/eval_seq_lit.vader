// vader/front/comptime/eval_seq_lit: `[e0, e1, …]` literal evaluator.
//
// Tuples (typed `[T0, T1, …]`) materialise as `StructValue` with
// synthetic `_0`, `_1`, … field names. Arrays (typed `T[]`)
// materialise as `ArrayValue`. The discriminator is the type-checker's
// `expr_types[expr.id]` ; both shapes recurse through the dispatcher
// to evaluate elements.

module "vader/front/comptime"

import "std/collections"
AST :: import "toolchain/ast"
import "vader/core/types"

/// Evaluate a `[e0, e1, …]` literal : each element in order, then a tuple or an
/// array according to the literal's checked type.
/// @param expr     the literal node.
/// @param context  the evaluator context.
/// @return         a `StructValue` for a tuple, an `ArrayValue` for an array, or
///                 the first element's failure.
evaluate_seq_lit :: fn(expr: AST.SeqLitExpr, context: ComptimeContext) -> EvalResult {
    elements: ComptimeValue[]: []
    for el in expr.elements {
        r :: evaluate_expr(el, context)
        value :: r.value ?? return r
        elements.push(value)
    }
    inferred :: context.typed.expr_types[expr.id] ?? TY_UNRESOLVED
    if tuple_backing(inferred) != null {
        fields :: MutableMap<string, ComptimeValue> {}
        for i in 0..<elements.len() {
            fields["_${i}"] = elements[i]
        }
        return ok(StructValue { .type = inferred, .fields = fields })
    }
    element_type_name: string = ""
    if inferred is ArrayType { element_type_name = display_type(inferred.element) }
    return ok(ArrayValue { .elements = elements, .element_type_name = element_type_name })
}
