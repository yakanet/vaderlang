// vader/front/comptime/libraries: the `CLibrary` and `WasmInterface` constants that
// `@extern` declarations name, evaluated for the build target.
//
// `@extern(RAYLIB, "InitWindow")` names a constant of `std/core`'s `CLibrary`.
// What it lists (the default headers, the archives, the platform libraries)
// reaches the native build and the interpreter, so it is evaluated here, once
// per constant, reaching the whole project: a library is a struct literal that
// often chooses its fields with a `match` on `VADER_OS`.

module "vader/front/comptime"

import "std/collections"
import "std/path"
import "std/string"
import "toolchain/diagnostics"
import "vader/core/symbol"
import "vader/front/resolver"
import "vader/front/typecheck"

/// Evaluate the library of every `@extern` the typecheck accepted a `CLibrary`
/// for (`TypedProgram.extern_libraries`), into `project.libraries`.
///
/// A constant that does not reduce reports why, once, where the evaluation
/// stopped inside it. One that describes another binary under the name of a
/// constant met before it is reported on its declaration.
///
/// @param constants  the constants of the project, evaluated on demand.
/// @param project    the evaluated project, whose `libraries` this fills.
/// @param diags      where a failed evaluation is reported.
evaluate_extern_libraries :: fn(
    constants: ProjectConstants,
    project: EvaluatedProject,
    diags: Diagnostic[],
) -> void {
    first_of_name :: Map<string, NamedLibrary> {}
    evaluate :: (symbol: Symbol) -> {
        library :: evaluate_constant_as<CLibrary>(
            symbol,
            constants,
            "CLibrary",
            (value: ComptimeValue) -> resolved_library(value, symbol.module),
            diags,
        ) else return null
        check_one_binary_per_name(symbol, library, first_of_name, diags)
        return library
    }
    evaluate_named_constants<CLibrary>(
        constants,
        (typed: TypedProgram) -> typed.extern_libraries,
        evaluate,
        project.libraries,
    )
}

/// Evaluate the interface of every `@extern` the typecheck accepted a
/// `WasmInterface` for (`TypedProgram.extern_interfaces`), into
/// `project.interfaces`. A constant that does not reduce reports why, once.
///
/// @param constants  the constants of the project, evaluated on demand.
/// @param project    the evaluated project, whose `interfaces` this fills.
/// @param diags      where a failed evaluation is reported.
evaluate_extern_interfaces :: fn(
    constants: ProjectConstants,
    project: EvaluatedProject,
    diags: Diagnostic[],
) -> void {
    evaluate :: (symbol: Symbol) -> evaluate_constant_as<WasmInterface>(
        symbol,
        constants,
        "WasmInterface",
        resolved_interface,
        diags,
    )
    evaluate_named_constants<WasmInterface>(
        constants,
        (typed: TypedProgram) -> typed.extern_interfaces,
        evaluate,
        project.interfaces,
    )
}

// Fill `into` with the value of the constant each `@extern` names, as `sources`
// reads them off every module, keyed by the declaration's node id. `evaluate`
// runs once per constant, reporting why one does not reduce, and the
// declarations naming one share its value.
evaluate_named_constants :: fn<T>(
    constants: ProjectConstants,
    sources: fn(TypedProgram) -> Map<i64, Symbol>,
    evaluate: fn(Symbol) -> T | null,
    into: Map<i64, T>,
) -> void {
    evaluated :: Map<i32, T> {}
    failed :: Set<i32> {}
    for [_, module_typed] in constants.typed.modules {
        for [decl_id, symbol] in sources(module_typed) {
            known :: evaluated[symbol.id]
            if known != null {
                into[decl_id] = known
                continue
            }
            if symbol.id in failed {
                continue
            }
            value :: evaluate(symbol) else {
                failed.add(symbol.id)
                continue
            }
            evaluated[symbol.id] = value
            into[decl_id] = value
        }
    }
}

// The interface a value describes, or null when it is not one.
resolved_interface :: fn(value: ComptimeValue) -> WasmInterface | null {
    if value !is StructValue {
        return null
    }
    package :: string_field(value, "package") else return null
    name :: string_field(value, "name") else return null
    version :: string_field(value, "version") else return null
    return WasmInterface {
        .package = package,
        .name = name,
        .version = version,
    }
}

// The first constant met that names a library, with what it holds.
NamedLibrary :: struct {
    symbol: Symbol
    library: CLibrary
}

// Report `symbol` when a constant met before it names its library but describes
// another binary: the build and the interpreter know a library by its name alone.
// `""` names the running process, which constants share whatever they list. The
// headers may differ: they declare functions, and the library's unit includes
// every one.
check_one_binary_per_name :: fn(
    symbol: Symbol,
    library: CLibrary,
    first_of_name: Map<string, NamedLibrary>,
    diags: Diagnostic[],
) -> void {
    if library.name == "" {
        return
    }
    first :: first_of_name[library.name] else {
        first_of_name[library.name] = NamedLibrary { .symbol = symbol, .library = library }
        return
    }
    fields :: differing_binary_fields(first.library, library)
    if fields.len() == 0 {
        return
    }
    span :: symbol.defined_at else return
    previous :: "`${first.symbol.name}` in `${first.symbol.module_name}`"
    differing :: fields.join(", ")
    detail :: "`${library.name}` is already described by ${previous}, which differs on ${differing}"
    diags.push(comptime_error(.LibrariesDisagree, span, detail))
}

// The fields describing the binary on which `a` and `b` differ, each in
// backticks. `archives` are compared in order, which is the link's.
differing_binary_fields :: fn(a: CLibrary, b: CLibrary) -> string[] {
    out: string[]: []
    if a.include != b.include {
        out.push("`include`")
    }
    if !a.archives.content_equals(b.archives) {
        out.push("`archives`")
    }
    if !a.system.content_equals(b.system) {
        out.push("`system`")
    }
    return out
}

// What the constant `symbol` holds, as `convert` reads its value, or null after
// reporting why it does not reduce, or why its value is no `type_name`.
evaluate_constant_as :: fn<T>(
    symbol: Symbol,
    constants: ProjectConstants,
    type_name: string,
    convert: fn(ComptimeValue) -> T | null,
    diags: Diagnostic[],
) -> T | null {
    owner :: constants.typed.modules[symbol.module] else return null
    declaration :: owner.const_decls[symbol.id] else return null
    context :: ComptimeContext {
        .typed = owner,
        .bindings = Map<i32, ComptimeValue> {},
        .project = constants,
    }
    result :: evaluate_project_const(symbol, context, declaration.span) else return null
    value :: result.value else {
        if result.diag != null {
            diags.push(result.diag)
        }
        return null
    }
    converted :: convert(value)
    if converted == null {
        detail :: "`${symbol.name}` holds no `${type_name}`"
        diags.push(comptime_error(.CannotEvaluate, declaration.span, detail))
    }
    return converted
}

/// The `CLibrary` a value describes, its `include` and `archives` resolved in
/// `folder` (`path_beside`), or null when `value` is not one: the evaluation fills every field,
/// the defaults included, so one that is missing means the struct changed.
///
/// @param value   the evaluated constant.
/// @param folder  the folder of the module declaring it.
resolved_library :: fn(value: ComptimeValue, folder: string) -> CLibrary | null {
    if value !is StructValue {
        return null
    }
    name :: string_field(value, "name") else return null
    headers :: strings_field(value, "headers") else return null
    include :: string_field(value, "include") else return null
    archives :: strings_field(value, "archives") else return null
    system :: strings_field(value, "system") else return null
    resolved: string[]: []
    for archive in archives {
        resolved.push(path_beside(folder, archive))
    }
    return CLibrary {
        .name = name,
        .headers = headers,
        .include = folder_beside(folder, include),
        .archives = resolved,
        .system = system,
    }
}

// `relative` resolved in `folder`, or `""` when there is none.
folder_beside :: fn(folder: string, relative: string) -> string {
    if relative == "" {
        return ""
    }
    return path_beside(folder, relative)
}

// `relative` resolved in `folder`, its `.` and `..` collapsed: two constants that
// name one file by two spellings describe the same binary.
path_beside :: fn(folder: string, relative: string) -> string =
    join_path(folder, relative).to_path().normalize().as_string()

// The string field `name` of `value`, or null when it is absent or not a string.
string_field :: fn(value: StructValue, name: string) -> string | null {
    field :: value.fields[name] else return null
    if field is StringValue {
        return field.value
    }
    return null
}

// The strings of the array field `name` of `value`, or null when it is absent or
// not an array of strings.
strings_field :: fn(value: StructValue, name: string) -> string[] | null {
    field :: value.fields[name] else return null
    if field !is ArrayValue {
        return null
    }
    out: string[]: []
    for element in field.elements {
        if element !is StringValue {
            return null
        }
        out.push(element.value)
    }
    return out
}
