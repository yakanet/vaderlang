// vader/front/comptime/libraries: the `CLibrary` constants that `@extern` declarations
// name, evaluated for the build target.
//
// `@extern(RAYLIB, "InitWindow")` names a constant of `std/ffi`'s `CLibrary`.
// What it lists (the default headers, the archives, the platform libraries)
// reaches the native build and the interpreter, so it is evaluated here, once
// per constant, reaching the whole project: a library is a struct literal that
// often chooses its fields with a `match` on `VADER_OS`.

module "vader/front/comptime"

import "std/collections"
import "std/ffi"
import "std/path"
import "std/string"
import "toolchain/ast"
import "vader/core/symbol"
import "vader/front/resolver"
import "vader/front/typecheck"
import "vader/support/diagnostics"

/// Evaluate the library of every `@extern` the typecheck accepted a `CLibrary`
/// for (`TypedProgram.extern_libraries`), into `project.libraries`.
///
/// A constant that does not reduce reports why, once, where the evaluation
/// stopped inside it. One that describes another binary under the name of a
/// constant met before it is reported on its declaration.
///
/// @param typed    the typed project.
/// @param project  the evaluated project, whose `libraries` this fills.
/// @param diags    where a failed evaluation is reported.
evaluate_extern_libraries :: fn(
    typed: TypedProject,
    project: EvaluatedProject,
    diags: Diagnostic[],
) -> void {
    constants :: ProjectConstants { .typed = typed }
    // One library per constant, shared by every declaration naming it.
    evaluated :: Map<i32, CLibrary> {}
    failed :: Set<i32> {}
    first_of_name :: Map<string, NamedLibrary> {}
    for [_, module_typed] in typed.modules {
        for [decl_id, symbol] in module_typed.extern_libraries {
            known :: evaluated[symbol.id]
            if known != null {
                project.libraries[decl_id] = known
                continue
            }
            if symbol.id in failed {
                continue
            }
            library :: evaluate_library(symbol, constants, diags)
            if library == null {
                failed.add(symbol.id)
                continue
            }
            evaluated[symbol.id] = library
            project.libraries[decl_id] = library
            check_one_binary_per_name(symbol, library, first_of_name, diags)
        }
    }
}

// The first constant met that names a library, with what it holds.
NamedLibrary :: struct {
    symbol: Symbol
    library: CLibrary
}

// Report `symbol` when a constant met before it names its library but describes
// another binary: the build and the interpreter know a library by its name alone.
// `""` names the running process, which constants share whatever they list. The
// headers may differ: they declare functions, and the library's unit includes
// every one.
check_one_binary_per_name :: fn(
    symbol: Symbol,
    library: CLibrary,
    first_of_name: Map<string, NamedLibrary>,
    diags: Diagnostic[],
) -> void {
    if library.name == "" {
        return
    }
    first :: first_of_name[library.name]
    if first == null {
        first_of_name[library.name] = NamedLibrary { .symbol = symbol, .library = library }
        return
    }
    fields :: differing_binary_fields(first.library, library)
    if fields.len() == 0 {
        return
    }
    span :: symbol.defined_at ?? return
    previous :: "`${first.symbol.name}` in `${first.symbol.module_name}`"
    differing :: fields.join(", ")
    detail :: "`${library.name}` is already described by ${previous}, which differs on ${differing}"
    diags.push(comptime_error(.LibrariesDisagree, span, detail))
}

// The fields describing the binary on which `a` and `b` differ, each in
// backticks. `archives` are compared in order, which is the link's.
differing_binary_fields :: fn(a: CLibrary, b: CLibrary) -> string[] {
    out: string[]: []
    if a.include != b.include {
        out.push("`include`")
    }
    if !a.archives.content_equals(b.archives) {
        out.push("`archives`")
    }
    if !a.system.content_equals(b.system) {
        out.push("`system`")
    }
    return out
}

// The library the constant `symbol` holds, or null after reporting why it does
// not reduce.
evaluate_library :: fn(
    symbol: Symbol,
    constants: ProjectConstants,
    diags: Diagnostic[],
) -> CLibrary | null {
    owner :: constants.typed.modules[symbol.module] ?? return null
    declaration :: owner.const_decls[symbol.id] ?? return null
    context :: ComptimeContext {
        .typed = owner,
        .bindings = Map<i32, ComptimeValue> {},
        .project = constants,
    }
    result :: evaluate_project_const(symbol, context, declaration.span) ?? return null
    value :: result.value
    if value == null {
        if result.diag != null {
            diags.push(result.diag)
        }
        return null
    }
    library :: resolved_library(value, symbol.module)
    if library == null {
        detail :: "`${symbol.name}` holds no `CLibrary`"
        diags.push(comptime_error(.CannotEvaluate, declaration.span, detail))
    }
    return library
}

/// The `CLibrary` a value describes, its `include` and `archives` resolved in
/// `folder` (`path_beside`), or null when `value` is not one: the evaluation fills every field,
/// the defaults included, so one that is missing means the struct changed.
///
/// @param value   the evaluated constant.
/// @param folder  the folder of the module declaring it.
resolved_library :: fn(value: ComptimeValue, folder: string) -> CLibrary | null {
    if value !is StructValue {
        return null
    }
    name :: string_field(value, "name") ?? return null
    headers :: strings_field(value, "headers") ?? return null
    include :: string_field(value, "include") ?? return null
    archives :: strings_field(value, "archives") ?? return null
    system :: strings_field(value, "system") ?? return null
    resolved: string[]: []
    for archive in archives {
        resolved.push(path_beside(folder, archive))
    }
    return CLibrary {
        .name = name,
        .headers = headers,
        .include = folder_beside(folder, include),
        .archives = resolved,
        .system = system,
    }
}

// `relative` resolved in `folder`, or `""` when there is none.
folder_beside :: fn(folder: string, relative: string) -> string {
    if relative == "" {
        return ""
    }
    return path_beside(folder, relative)
}

// `relative` resolved in `folder`, its `.` and `..` collapsed: two constants that
// name one file by two spellings describe the same binary.
path_beside :: fn(folder: string, relative: string) -> string =
    join_path(folder, relative).to_path().normalize().as_string()

// The string field `name` of `value`, or null when it is absent or not a string.
string_field :: fn(value: StructValue, name: string) -> string | null {
    field :: value.fields[name] ?? return null
    if field is StringValue {
        return field.value
    }
    return null
}

// The strings of the array field `name` of `value`, or null when it is absent or
// not an array of strings.
strings_field :: fn(value: StructValue, name: string) -> string[] | null {
    field :: value.fields[name] ?? return null
    if field !is ArrayValue {
        return null
    }
    out: string[]: []
    for element in field.elements {
        if element !is StringValue {
            return null
        }
        out.push(element.value)
    }
    return out
}
