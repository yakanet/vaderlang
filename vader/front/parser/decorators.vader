// vader/front/parser/decorators: registry of the decorators the compiler knows.
//
// One table for every `@name` a declaration, a parameter, a struct field or a
// `match` may carry, and where. The parser reads it for a field's and a
// `match`'s decorators, the resolver for a declaration's (R2010 for a name it
// does not hold), the typecheck for a parameter's, and the LSP hover shows an
// entry's usage and text. SPEC §12 is the reference each `doc` summarises.

module "vader/front/parser"

/// Where a decorator is written.
export DecoratorPlace :: enum {
    /// Above a declaration.
    Declaration,
    /// On a parameter of an `@extern` fn.
    Parameter,
    /// Before a `match` expression.
    Match,
    /// On a struct field.
    Field,
}

/// One decorator the compiler knows.
export DecoratorSpec :: struct {
    name:   string
    /// How it is written, its arguments included : `@target(.Os, …)`.
    usage:  string
    /// Where it may be written.
    places: DecoratorPlace[]
    /// What it does, in Markdown.
    doc:    string
}

/// Every decorator the compiler knows : what an editor offers after a `@`.
///
/// Each `doc` is the decorator's row of SPEC §12, kept to what a reader needs at
/// the use site; the SPEC holds the full rules.
export DECORATORS: DecoratorSpec[]: [
    DecoratorSpec {
        .name   = "comptime",
        .usage  = "@comptime",
        .places = [.Declaration],
        .doc    = "Forces compile-time evaluation of a value or a fn. Everything it touches must be comptime-evaluable.",
    },
    DecoratorSpec {
        .name   = "extern",
        .usage  = "@extern, @extern(\"symbol\"), @extern(LIBRARY, \"symbol\")",
        .places = [.Declaration],
        .doc    = "Declares a bodyless fn supplied by user code across the FFI. `LIBRARY` names a `CLibrary` constant (`std/ffi`), whose header, archives and platform libraries the native build adds. Pair it with `@c_header`, or a library header, so `cc` checks the call against the real prototype.",
    },
    DecoratorSpec {
        .name   = "export",
        .usage  = "@export, @export(\"name\")",
        .places = [.Declaration],
        .doc    = "Exposes the fn under an unmangled name, for a host on the JS or library side.",
    },
    DecoratorSpec {
        .name   = "test",
        .usage  = "@test",
        .places = [.Declaration],
        .doc    = "Marks a `fn() -> void` as a test, run by `vader test`.",
    },
    DecoratorSpec {
        .name   = "intrinsic",
        .usage  = "@intrinsic",
        .places = [.Declaration],
        .doc    = "Marks a bodyless stdlib fn, or a bodyless trait impl, as provided by the host runtime. Required on any bodyless free fn (`T3062`); the build fails if the host does not wire it.",
    },
    DecoratorSpec {
        .name   = "deprecated",
        .usage  = "@deprecated(\"reason\")",
        .places = [.Declaration],
        .doc    = "Reports `W0001` at every reference to the declaration; the code still compiles.",
    },
    DecoratorSpec {
        .name   = "assert",
        .usage  = "@assert(condition), @assert(condition, \"message\")",
        .places = [.Declaration],
        .doc    = "A compile-time assertion at top level: the build fails with `C4015` when `condition` does not evaluate to `true`. The message must be a static string literal.",
    },
    DecoratorSpec {
        .name   = "no_return",
        .usage  = "@no_return",
        .places = [.Declaration],
        .doc    = "Marks the fn as diverging: it panics, aborts or loops forever. A call to it types as `never`, so it fits any slot and ends control flow.",
    },
    DecoratorSpec {
        .name   = "allow_unused",
        .usage  = "@allow_unused",
        .places = [.Declaration],
        .doc    = "Exempts a top-level declaration from the `W0007` dead-code lint, and keeps live whatever it references. Say why in a comment.",
    },
    DecoratorSpec {
        .name   = "target",
        .usage  = "@target, @target(.Os, …)",
        .places = [.Declaration],
        .doc    = "Selects which body of a top-level fn the build uses. Bare, it names the declaration (signature, `export`, vaderdoc, optionally the general body); with a list, a body for those operating systems.",
    },
    DecoratorSpec {
        .name   = "c_header",
        .usage  = "@c_header(\"<header.h>\")",
        .places = [.Declaration],
        .doc    = "Includes the header instead of synthesising a prototype for an `@extern` fn, so `cc` checks the call against the real declaration.",
    },
    DecoratorSpec {
        .name   = "c_pointer",
        .usage  = "@c_pointer",
        .places = [.Parameter],
        .doc    = "On a parameter of an `@extern` fn: the callee receives the parameter's address, not its value. `@c_out` says whether C writes through it. `T3079` anywhere else.",
    },
    DecoratorSpec {
        .name   = "c_out",
        .usage  = "@c_out",
        .places = [.Parameter],
        .doc    = "On a parameter of an `@extern` fn: C writes through it, an array or a `@c_struct` crossing with `@c_pointer`. `T3079` anywhere else.",
    },
    DecoratorSpec {
        .name   = "c_type",
        .usage  = "@c_type(\"size_t\")",
        .places = [.Declaration, .Parameter],
        .doc    = "The C type the callee declares for an integer parameter, or for the result when on the fn, where it is not the Vader type's own spelling. Must be as wide as the Vader type.",
    },
    DecoratorSpec {
        .name   = "c_struct",
        .usage  = "@c_struct, @c_struct(\"struct name\")",
        .places = [.Declaration],
        .doc    = "Declares which C struct this struct mirrors, so it may cross an `@extern` call: by address with `@c_pointer`, by value otherwise (native build only). Bare, the C type has the struct's name. Fields are copied by name; a mirror lent by address may stop early, one copied by value names every member.",
    },
    DecoratorSpec {
        .name   = "c_variadic",
        .usage  = "@c_variadic(N)",
        .places = [.Declaration],
        .doc    = "The `@extern` callee is variadic, with `N` fixed parameters.",
    },
    DecoratorSpec {
        .name   = "displayable",
        .usage  = "@displayable",
        .places = [.Declaration],
        .doc    = "Generates the enum's `Display`: each variant renders as its own name. An explicit `implements Display` beside it is `R2030`.",
    },
    DecoratorSpec {
        .name   = "singleton",
        .usage  = "@singleton",
        .places = [.Declaration],
        .doc    = "Runs the body of a parameterless top-level fn once per program and hands every call the instance it built: how a module keeps state. Neither `await` nor `yield` inside (`T3103`), and it cannot run at comptime (`C4018`).",
    },
    DecoratorSpec {
        .name   = "returns",
        .usage  = "@returns(cond)",
        .places = [.Declaration],
        .doc    = "Declares that a `bool` predicate returns the value of `cond` over its parameters: a call narrows its arguments as `cond` would, and the body is checked against it (`T3111` to `T3113`).",
    },
    DecoratorSpec {
        .name   = "ensures",
        .usage  = "@ensures(cond)",
        .places = [.Declaration],
        .doc    = "Declares that `cond` over the parameters holds once the fn has returned: a call written as a statement narrows its arguments for the rest of the block, and the body is checked against it (`T3112` to `T3114`).",
    },
    DecoratorSpec {
        .name   = "partial",
        .usage  = "@partial match …",
        .places = [.Match],
        .doc    = "Opts the `match` out of exhaustiveness checking (`T3013`), for a deliberate \"everything else does X\" `_` arm. Precede it with a `// @partial: <reason>` line.",
    },
    DecoratorSpec {
        .name   = "unreachable",
        .usage  = "@unreachable match …",
        .places = [.Match],
        .doc    = "Opts the `match` out of exhaustiveness checking and asserts the uncovered variants never occur: one of them reaching the `match` traps at run time. Mutually exclusive with `@partial`.",
    },
    DecoratorSpec {
        .name   = "internal",
        .usage  = "@internal",
        .places = [.Field],
        .doc    = "Restricts one struct field to its declaring module: reading, writing or constructing with it elsewhere is `T3054`. Give the field a default so the struct stays constructible.",
    },
]

/// The decorator named `name`, or null when the compiler knows none.
///
/// @param name  the decorator's name, without the `@`.
export decorator_spec :: fn(name: string) -> DecoratorSpec | null {
    for d in DECORATORS {
        if d.name == name {
            return d
        }
    }
    return null
}

/// Whether the decorator `name` may be written at `place`.
///
/// @param name   the decorator's name, without the `@`.
/// @param place  where it is written.
export decorator_on :: fn(name: string, place: DecoratorPlace) -> bool {
    spec :: decorator_spec(name) ?? return false
    return place in spec.places
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_decorator_spec_finds_a_known_name :: fn() -> void {
    spec :: decorator_spec("singleton") ?? return assert(false, "singleton is known")
    assert_eq(spec.usage, "@singleton")
}

@test
test_decorator_on_its_places :: fn() -> void {
    assert(decorator_on("c_type", .Declaration) && decorator_on("c_type", .Parameter), "c_type sits on both")
    assert(!decorator_on("c_pointer", .Declaration), "c_pointer sits on a parameter only")
    assert(decorator_on("internal", .Field), "internal sits on a field")
    assert(!decorator_on("nope", .Declaration), "an unknown name sits nowhere")
}

@test
test_decorator_spec_rejects_an_unknown_name :: fn() -> void {
    assert(decorator_spec("nope") == null, "an unknown decorator has no spec")
}
