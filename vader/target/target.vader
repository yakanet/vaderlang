// vader/target — the compilation target as a pair, and the `<os>-<arch>` form
// the command line speaks.
//
// The two axes and their asymmetry live in `std/target`, which holds the
// vocabulary alone: `Os` selects CODE (it is what `@target` filters on), `Arch`
// selects nothing and only parameterises values. They sit in the standard
// library because `current_os()` — the OS a program is RUNNING on — must share
// their type, and `std/` may not import a layer above it.
//
// What lives here is the part only a toolchain needs: the pair, and reading one
// from a string. A program computing numbers has no reason to parse
// `"darwin-arm64"`.
//
// This module depends on nothing in the compiler, which is what will make it a
// `git mv` away from `toolchain/` the day a build driver asks for its target.
// It is not there yet because the shape of that namespace is still an open
// question (TODO §`lib/` — "does the namespace publish the AST, or the RESOLVED
// declaration?").

module "vader/target"

import "std/string"
import "std/target"

/// No selection at all — every `@target` body is kept.
///
/// The NAVIGATION view, and the only one that can reach a body this machine does
/// not build: `textDocument/implementation` on a bare declaration must list the
/// Windows body from a Mac, and selection has already dropped it by the time any
/// typed view exists.
///
/// It must NEVER feed diagnostics. Under it, another platform's code is resolved
/// and type-checked — which is exactly the property `@target` exists to remove.
/// A library's Windows bug would squiggle in a Linux editor.
export AllTargets :: struct {}

/// What a load selects on — one target, or all of them.
///
/// NOT named `Union`: `A | B` already IS a union in this language, and
/// `Target | Union` made the word mean two things in one line.
///
/// Two views, and the split is load-bearing rather than ergonomic: the cut
/// happens at LOAD time, so one `LoadedProject` cannot serve both. See the
/// target plan §8.5.
export Selection :: Target | AllTargets

/// A compilation target — the pair a build is parameterised by.
export Target :: struct {
    os: Os
    arch: Arch
}

/// Render a target as `<os>-<arch>` — the form `--target=` accepts and
/// `parse_target` round-trips.
///
/// @param t  the target.
export display_target :: fn(t: Target) -> string = "${t.os.to_string()}-${t.arch.to_string()}"

/// The target this machine IS — the default a build assumes when `--target=` is
/// not given.
///
/// Reads the running platform rather than the compilation one, which is the only
/// answer that is right in every case: a compiler emitting for Windows from a Mac
/// still runs on the Mac, and it is the Mac's filesystem it must resolve paths
/// against while doing so.
///
/// @return  the host's OS and architecture.
export host_target :: fn() -> Target = Target { .os = current_os(), .arch = current_arch() }

// ---- parsing --------------------------------------------------------------

/// Why a target string could not be read. Carries the offending fragment so the
/// caller can name it without re-splitting the input.
export TargetParseError :: struct {
    /// Human-readable reason, lowercase and without a trailing period.
    reason: string
    /// The fragment at fault — the whole string for a shape error, the OS or
    /// arch fragment for an unknown value. Empty when the input was empty.
    fragment: string
}

TargetParseError implements Error -> self.reason

/// Read a `<os>-<arch>` target string.
///
/// Exactly two fragments, so neither axis may contain a `-`. That is a real
/// constraint on future names rather than an accident: it keeps the form
/// unambiguous without a rule about which hyphen separates.
///
/// @param s  the target string, e.g. `"darwin-arm64"`.
/// @return   the parsed pair on success.
/// @error    `TargetParseError` when the string is not two `-`-separated
///           fragments, or when either names no known OS / architecture.
export parse_target :: fn(s: string) -> Target | TargetParseError {
    if s.byte_len() == 0 {
        return TargetParseError { .reason = "empty target", .fragment = "" }
    }
    parts :: s.split("-")
    // Guarded before destructuring: an array pattern does NOT check arity —
    // surplus elements are dropped silently and missing ones trap at runtime
    // (SPEC §Destructuring, "Array sources").
    if parts.len() != 2 {
        return TargetParseError {
            .reason = "target must be written `<os>-<arch>`",
            .fragment = s,
        }
    }
    [os_part, arch_part] :: parts
    os :: parse_os(os_part)
    if os == null {
        return TargetParseError { .reason = "unknown operating system", .fragment = os_part }
    }
    arch :: parse_arch(arch_part)
    if arch == null {
        return TargetParseError { .reason = "unknown architecture", .fragment = arch_part }
    }
    return Target { .os = os, .arch = arch }
}

/// The OS named by `s`, or null when it names none. The inverse of `Os`'s
/// `Display` impl, and pinned against it by `test_every_os_round_trips`.
///
/// @param s  a canonical OS name.
export parse_os :: fn(s: string) -> Os | null = match s {
    "windows" -> .Windows
    "linux"   -> .Linux
    "darwin"  -> .Darwin
    "wasi"    -> .Wasi
    "browser" -> .Browser
    _         -> null
}

/// The architecture named by `s`, or null when it names none. The inverse of
/// `Arch`'s `Display` impl.
///
/// @param s  a canonical architecture name.
export parse_arch :: fn(s: string) -> Arch | null = match s {
    "x86_64" -> .X86_64
    "arm64"  -> .Arm64
    "wasm32" -> .Wasm32
    _        -> null
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_display_round_trips :: fn() -> void {
    t :: Target { .os = .Darwin, .arch = .Arm64 }
    assert_eq(display_target(t), "darwin-arm64")
}

@test test_parse_target_reads_both_axes :: fn() -> void {
    r :: parse_target("linux-x86_64")
    assert(r is Target, "linux-x86_64 parses")
    if r is Target {
        assert(r.os == .Linux, "os is linux")
        assert(r.arch == .X86_64, "arch is x86_64")
    }
}

@test test_parse_target_rejects_extra_fragments :: fn() -> void {
    // Exactly two fragments — a third is a shape error, not a longer arch name.
    r :: parse_target("linux-x86_64-gnu")
    assert(r is TargetParseError, "three fragments is an error")
}

@test test_parse_target_rejects_missing_separator :: fn() -> void {
    r :: parse_target("darwin")
    assert(r is TargetParseError, "no separator is an error")
    if r is TargetParseError {
        assert_eq(r.fragment, "darwin")
    }
}

@test test_parse_target_names_the_bad_fragment :: fn() -> void {
    r :: parse_target("drawin-arm64")
    assert(r is TargetParseError, "unknown os is an error")
    if r is TargetParseError {
        assert_eq(r.fragment, "drawin")
        assert_eq(r.reason, "unknown operating system")
    }
}

@test test_parse_target_rejects_unknown_arch :: fn() -> void {
    r :: parse_target("linux-riscv64")
    assert(r is TargetParseError, "unknown arch is an error")
    if r is TargetParseError {
        assert_eq(r.fragment, "riscv64")
    }
}

@test test_every_os_round_trips :: fn() -> void {
    // Pins `Os`'s Display impl against `parse_os`, so adding an OS to one
    // without the other fails here rather than at a call site.
    all: Os[] = [.Windows, .Linux, .Darwin, .Wasi, .Browser]
    for os in all {
        assert(parse_os(os.to_string()) == os, "round trip ${os.to_string()}")
    }
}

@test test_every_arch_round_trips :: fn() -> void {
    all: Arch[] = [.X86_64, .Arm64, .Wasm32]
    for arch in all {
        assert(parse_arch(arch.to_string()) == arch, "round trip ${arch.to_string()}")
    }
}

@test test_the_c_runtime_agrees_with_the_enum :: fn() -> void {
    // `current_os()` reads the C runtime, which returns ORDINALS it hardcodes
    // (`vader_runtime.c::vader_current_os`); `VADER_OS` is baked from the enum
    // the compiler parsed. Nothing else makes the two agree — reorder `Os` and
    // the C keeps returning the old numbers, silently, with `current_os()`
    // naming the wrong platform on every machine.
    //
    // This test runs natively, so the compilation target IS the running
    // platform and the two MUST match. It fails on all three CI runners the
    // moment they drift. It says nothing about a cross-compiled build, where
    // they are meant to differ.
    assert(current_os() == VADER_OS, "current_os ${current_os().to_string()} vs VADER_OS ${VADER_OS.to_string()}")
    assert(
        current_arch() == VADER_ARCH,
        "current_arch ${current_arch().to_string()} vs VADER_ARCH ${VADER_ARCH.to_string()}",
    )
}
