// vader/diagnostics/codes — typed diagnostic codes shared by every compiler
// phase (lexer, parser, resolver, typecheck, comptime, lower).
//
// Each phase owns its own enum so the type checker enforces "the lexer can only
// emit LexerCode values". Every variant carries its `CodeInfo` — the canonical
// `LXXXX`/`PXXXX`/... wire ID and the human message — as variant data, so a
// call site names the variant (`.UnexpectedCharacter`) and `CodeInfo(code)`
// recovers both strings when the diagnostic is built.
//
// Not every variant has a live emission site yet : some are reserved for
// checks not implemented in the self-host compiler (e.g. import-cycle and
// arg-spread diagnostics landed only once their pass did). A variant without
// a `<phase>_error(.Variant, ...)` call site is reserved-for-future, not dead
// — it keeps its wire ID for when the check ships.
//
// IDs are NOT frozen. Nothing outside this repo consumes them, so a code may be
// renumbered, reused, or given a new meaning. The constraint is per-commit, not
// forever : one meaning per ID at a time, and the variant's message, the
// `tests/diag_corpus/` fixture and the committed snapshots move together. The
// retirement comments below are kept as history, not as reservations : reuse
// those gaps rather than grow the space. This flips to append-only once there
// are users.

module "vader/diagnostics"

/// The wire identity of a diagnostic code — the data every code enum carries.
export CodeInfo :: struct {
    /// Stable wire ID, `T3001` style ; what a test or a tool matches on.
    id: string
    /// Canonical wording of the error class — no per-site values (see `detail`).
    message: string
}

export LexerCode :: enum(CodeInfo) {
    UnexpectedCharacter             { .id = "L0001", .message = "unexpected character" },
    UnterminatedStringLiteral       { .id = "L0002", .message = "unterminated string literal" },
    UnterminatedBlockComment        { .id = "L0003", .message = "unterminated block comment" },
    InvalidEscapeSequence           { .id = "L0004", .message = "invalid escape sequence" },
    InvalidCharacterLiteral         { .id = "L0005", .message = "invalid character literal" },
    MalformedNumericLiteral         { .id = "L0006", .message = "malformed numeric literal" },
    StrayBackslash                  { .id = "L0007", .message = "stray backslash (Vader has no line continuation)" },
    ShebangNotOnFirstLine           { .id = "L0008", .message = "shebang only allowed on first line" },
    InvalidUnicodeCodepointEscape   { .id = "L0009", .message = "invalid Unicode codepoint escape" },
    InterpolationExpressionExpected { .id = "L0010", .message = "interpolation expression must follow `\${`" },
    IntegerLiteralOverflow          { .id = "L0011", .message = "integer literal exceeds the u64 range" },
}

// Typecheck-pass codes. New codes are appended ; retired IDs may be reused —
// see the file header for the condition.
export TypecheckCode :: enum(CodeInfo) {
    TypeMismatch                    { .id = "T3001", .message = "type mismatch" },
    ExpectedKnownType               { .id = "T3002", .message = "expected an expression of a known type" },
    WrongArgCount                   { .id = "T3003", .message = "wrong number of arguments" },
    UnknownNamedArg                 { .id = "T3004", .message = "unknown named argument" },
    MissingRequiredArg              { .id = "T3005", .message = "missing required argument" },
    TraitNotSatisfied               { .id = "T3006", .message = "trait not satisfied" },
    NotCallable                     { .id = "T3007", .message = "expression is not callable" },
    NotIndexable                    { .id = "T3008", .message = "expression is not indexable" },
    FieldDoesNotExist               { .id = "T3009", .message = "field does not exist on this type" },
    InvalidCast                     { .id = "T3010", .message = "invalid cast" },
    NonExhaustiveMatch              { .id = "T3013", .message = "non-exhaustive match" },
    UnreachableMatchArm             { .id = "T3014", .message = "unreachable match arm" },
    BreakContinueOutsideLoop        { .id = "T3015", .message = "`break` / `continue` only allowed inside a loop" },
    SelfOutsideMethod               { .id = "T3016", .message = "`self` only valid inside a method body" },
    OperatorNotDefined              { .id = "T3017", .message = "operator not defined for these operand types" },
    InterpolationRequiresDisplay    { .id = "T3018", .message = "string interpolation expression must implement `Display`" },
    ConditionMustBeBool             { .id = "T3019", .message = "condition must be `bool`" },
    BodyReturnIncompatible          { .id = "T3020", .message = "function body returns a value incompatible with its declared return type" },
    GenericArgCountMismatch         { .id = "T3021", .message = "generic argument count mismatch" },
    CyclicTypeAlias                 { .id = "T3022", .message = "cyclic type alias" },
    SelfOutsideTraitOrImpl          { .id = "T3023", .message = "use of `Self` outside a trait or impl context" },
    FnSignatureMustBeAnnotated      { .id = "T3024", .message = "function signature must be fully annotated" },
    NamedArgDuplicatesPositional    { .id = "T3025", .message = "named argument duplicates a positional one" },
    TypeHasNoGenericParams          { .id = "T3026", .message = "type does not have generic parameters" },
    UnknownEnumVariant              { .id = "T3027", .message = "unknown enum variant" },
    CannotInferEnumType             { .id = "T3028", .message = "cannot infer enum type from context" },
    EnumReprMustBePrimitiveInt      { .id = "T3029", .message = "enum backing type must be a primitive integer" },
    EnumVariantValueOutOfRange      { .id = "T3030", .message = "enum variant value out of range for backing type" },
    DuplicateEnumVariantValue       { .id = "T3031", .message = "duplicate enum variant value" },
    AmbiguousOverload               { .id = "T3032", .message = "ambiguous overload resolution" },
    InvalidMainSignature            { .id = "T3033", .message = "invalid `main` signature" },
    RecursiveExprBodiedFn           { .id = "T3034", .message = "recursive expression-bodied function requires an explicit `-> Type` annotation" },
    TypeValuedSlotNotYetSupported   { .id = "T3035", .message = "type-valued slot is not yet supported in this position" },
    ImplMissingRequiredMethod       { .id = "T3036", .message = "impl block missing required trait method" },
    MissingRequiredFieldInStructLit { .id = "T3037", .message = "missing required field in struct literal" },
    FieldAlreadyProvided            { .id = "T3038", .message = "field already provided in struct literal" },
    IntoIdentityForbidden           { .id = "T3039", .message = "`Into<T>` cannot use `T` as its target (identity coercion is forbidden)" },
    UnreachableIsTest               { .id = "T3040", .message = "test can never match — operands have no overlapping values" },
    CannotReassignConst             { .id = "T3041", .message = "cannot reassign a constant binding" },
    CannotMutateImmutableArray      { .id = "T3042", .message = "cannot mutate an immutable array" },
    InvalidExternDecl               { .id = "T3050", .message = "invalid `@extern` declaration" },
    ExternMustNotHaveBody           { .id = "T3051", .message = "`@extern` declaration must not have a body" },
    PrivateTypeInPublicInterface    { .id = "T3052", .message = "exported declaration exposes a non-exported type" },
    DuplicateFnDefinition           { .id = "T3053", .message = "function defined more than once with the same signature in a module" },
    InternalFieldAccess             { .id = "T3054", .message = "access to a struct field marked `@internal` from outside its declaring module" },
    CharLiteralOutOfRange           { .id = "T3055", .message = "character literal's codepoint does not fit the target integer type" },
    OperatorTraitNotImplemented     { .id = "T3043", .message = "operand type does not implement the trait this operator requires" },
    GeneratorReturnMustBeIterator   { .id = "T3056", .message = "a function that `yield`s must return `Iterator<T>`" },
    IntegerLiteralOutOfRange        { .id = "T3066", .message = "integer literal does not fit the target integer type" },
    ReturnValueInGenerator          { .id = "T3058", .message = "a generator produces values via `yield`; `return` with a value is not allowed (use a bare `return` to stop)" },
    YieldOutsideGenerator           { .id = "T3059", .message = "`yield` is only allowed directly inside a generator's own body, not in a nested lambda" },
    DeferInGenerator                { .id = "T3060", .message = "`defer` is not yet supported inside a generator" },
    GeneratorYieldIncompatible      { .id = "T3061", .message = "yielded value type does not match the generator's element type" },
    BodylessFnMustBeIntrinsic       { .id = "T3062", .message = "a bodyless function must be `@intrinsic` (host-provided) or `@extern` (foreign symbol)" },
    AssignTypeMismatch              { .id = "T3063", .message = "assigned value's type is not assignable to the target's declared type" },
    AwaitOutsideAsync               { .id = "T3064", .message = "`await` is not allowed inside a nested lambda (a lambda cannot be an async coroutine)" },
    LoopTargetNotLoopVariable       { .id = "T3067", .message = "`break` / `continue` target must be an enclosing loop's iteration variable or label" },
    NullCoalesceOnNonOptional       { .id = "T3068", .message = "`??` left operand is never null — the fallback is unreachable" },
    TypeArgumentNotInferable        { .id = "T3069", .message = "cannot infer type argument — nothing at this call site binds the type parameter" },
    CannotMutateImmutableBinding    { .id = "T3070", .message = "cannot mutate through an immutable access path" },
    MutatingMethodOnImmutable       { .id = "T3071", .message = "this method mutates its receiver (`self!`), but the receiver is immutable" },
    ImmutableBorrowIntoMutableParam { .id = "T3072", .message = "this argument is immutable, but the parameter is declared `!` (the callee may mutate it)" },
    FnValueMutabilityMismatch       { .id = "T3073", .message = "this function mutates a parameter the target slot lends out read-only" },
    UnionMixesMutabilities          { .id = "T3074", .message = "a union mixes the same type at two mutabilities" },
    MutabilityMarkerOnValueType     { .id = "T3075", .message = "a `!` that grants nothing" },
    ModuleConstMutableElement       { .id = "T3076", .message = "a mutable module const needs a flat element type" },
    ImmutableValueIntoMutableSlot   { .id = "T3077", .message = "a read-only value cannot fill a slot that promises mutation" },
    MethodOnlyBehindNamespaceAlias  { .id = "T3078", .message = "this free function is only in scope through its namespace alias" },
    InvalidParameterDecorator       { .id = "T3079", .message = "decorator not allowed on this parameter" },
    CallbackNotDirectFn             { .id = "T3080", .message = "callback argument must name a function directly" },
    CannotDestructure               { .id = "T3081", .message = "value cannot be destructured into this many elements" },
    InvalidAssignTarget             { .id = "T3082", .message = "not an assignment target" },
    BodyFallsOffEnd                 { .id = "T3083", .message = "not every path through the body returns a value" },
    EnumDataNotStruct               { .id = "T3084", .message = "enum variant data must be a struct" },
    VariantDataWithoutEnumData      { .id = "T3085", .message = "variant data on an enum whose header declares none" },
    UnionEnumDataNotInterpolable    { .id = "T3086", .message = "a union holding an enum with variant data cannot be interpolated" },
}

// Parser-pass codes. New codes are appended ; once shipped, a code never
// changes meaning.
export ParserCode :: enum(CodeInfo) {
    UnexpectedToken                   { .id = "P1001", .message = "unexpected token" },
    ExpectedToken                     { .id = "P1002", .message = "expected token" },
    ExpectedExpression                { .id = "P1003", .message = "expected an expression" },
    ExpectedStatement                 { .id = "P1004", .message = "expected a statement" },
    ExpectedType                      { .id = "P1005", .message = "expected a type" },
    ExpectedDeclaration               { .id = "P1006", .message = "expected a declaration" },
    ExpectedPattern                   { .id = "P1007", .message = "expected a pattern" },
    ExpectedIdentifier                { .id = "P1008", .message = "expected an identifier" },
    TrailingCommaListEnded            { .id = "P1009", .message = "trailing comma allowed but list ended unexpectedly" },
    NonAssocChained                   { .id = "P1010", .message = "non-associative operator chained" },
    StructLitInControlCondition       { .id = "P1011", .message = "struct literal not allowed at the top level of a control-flow condition" },
    MissingFunctionBody               { .id = "P1012", .message = "missing function body" },
    ExecutableStatementAtTopLevel     { .id = "P1013", .message = "executable statement at top level (only declarations allowed)" },
    UnknownDecoratorPlacement         { .id = "P1014", .message = "unknown decorator placement" },
    DuplicateStructLitField           { .id = "P1015", .message = "duplicate field name in struct literal" },
    ExpectedGenericArgList            { .id = "P1016", .message = "expected a generic argument list" },
    MissingNewlineBetweenDecls        { .id = "P1017", .message = "missing newline between top-level declarations" },
    TypeParamMustBePrefixedWithDollar { .id = "P1018", .message = "type parameter must be prefixed with `$`" },
    TypeBoundRedundant                { .id = "P1019", .message = "`: type` bound is redundant; write `\$T` instead" },
    ExprBodiedFnExplicitReturnType    { .id = "P1020", .message = "expression-bodied function cannot also declare an explicit return type" },
    OneTupleNotAllowed                { .id = "P1021", .message = "1-tuple types are not allowed" },
    TuplePatternRemoved               { .id = "P1022", .message = "a match arm cannot destructure a tuple" },
    LetDestructureRequiresTwoElements { .id = "P1023", .message = "let destructure requires at least 2 elements" },
    RemovedConstQualifier             { .id = "P1027", .message = "`const` was removed from the language" },
    InvalidModuleName                 { .id = "P1028", .message = "invalid module name (does not match `[a-z][a-z0-9_]*(/[a-z][a-z0-9_]*)*` grammar)" },
    ExpressionNestingTooDeep          { .id = "P1029", .message = "expression nesting too deep" },
    RepeatedMutabilityMarker          { .id = "P1030", .message = "repeated `!` on the same type level" },
    MutabilityMarkerOnName            { .id = "P1031", .message = "`!` belongs on the type, not the parameter name" },
    DecoratorArgumentCount            { .id = "P1032", .message = "wrong number of decorator arguments" },
    DecoratorArgumentForm             { .id = "P1033", .message = "decorator argument has the wrong form" },
    CompoundAssignToPattern           { .id = "P1035", .message = "compound assignment needs a single target" },
    ArmBindingNotInHeader             { .id = "P1036", .message = "a match arm cannot bind with `as`" },
    PatternBindsName                  { .id = "P1037", .message = "a match pattern cannot bind a name" },
}

// R-codes belong to the resolver pass (name-binding) ; once shipped,
// never re-used.
export ResolverCode :: enum(CodeInfo) {
    ModuleNotFound               { .id = "R2001", .message = "module not found" },
    EmptyImportPath              { .id = "R2002", .message = "import path is empty" },
    ImportedNameNotExported      { .id = "R2003", .message = "imported name not exported by module" },
    DuplicateTopLevelSymbol      { .id = "R2004", .message = "duplicate top-level symbol in module" },
    ImportCycle                  { .id = "R2005", .message = "import cycle detected" },
    UnresolvedIdent              { .id = "R2006", .message = "unresolved identifier" },
    UnresolvedTypeName           { .id = "R2007", .message = "unresolved type name" },
    SymbolNotExported            { .id = "R2008", .message = "symbol is not exported from its module" },
    TraitNameNotATrait           { .id = "R2009", .message = "trait name does not refer to a trait" },
    UnknownDecorator             { .id = "R2010", .message = "decorator unknown to the compiler" },
    DuplicateImportBinding       { .id = "R2011", .message = "duplicate import binding" },
    ImportShadowsBuiltin         { .id = "R2012", .message = "imported symbol shadows a builtin" },
    SelfOutsideFirstParam        { .id = "R2013", .message = "self only valid as the first parameter of a method" },
    ManifestMalformed            { .id = "R2014", .message = "vader.json malformed or unreadable" },
    ModuleFolderEmpty            { .id = "R2015", .message = "module folder is empty (no .vader files)" },
    ShortImplFormSingleMethod    { .id = "R2016", .message = "short impl form requires a trait with exactly one method" },
    FeatureNotYetImplemented     { .id = "R2017", .message = "feature not yet implemented" },
    OrphanImplForbidden          { .id = "R2018", .message = "orphan impl forbidden" },
    ReservedName                 { .id = "R2019", .message = "`void` is reserved and cannot be used as an identifier" },
    ModuleDeclMissing            { .id = "R2020", .message = "module declaration missing on first non-trivial line" },
    DuplicateModuleDecl          { .id = "R2021", .message = "more than one module declaration in the same file" },
    MixedModuleNamesInFolder     { .id = "R2022", .message = "files in the same folder declare different module names" },
    DuplicateModuleNameGlobally  { .id = "R2023", .message = "two folders declare the same module name globally" },
    SelfImport                   { .id = "R2024", .message = "self-import: file imports its own module" },
    RelativeImportRemoved        { .id = "R2025", .message = "relative import (`./` / `../`) is not part of the language" },
    DuplicateNonFnDeclInModule   { .id = "R2026", .message = "duplicate non-fn declaration across files of the same module" },
    VisibilityLeak               { .id = "R2027", .message = "exported decl references a module-private decl in its signature" },
    ExplicitCorePreludeImport    { .id = "R2028", .message = "explicit `import \"std/core\"` is redundant (prelude already in scope)" },
    AsBindingInConjunction       { .id = "R2029", .message = "`as` binding not allowed in a `&&` condition" },
    ConflictingImpl              { .id = "R2030", .message = "conflicting trait impl for the same type" },
    AmbiguousWildcardImport      { .id = "R2031", .message = "name is exported by several wildcard-imported modules" },
    ConflictingImportForms       { .id = "R2032", .message = "the same path is imported both bare (wildcard) and with `{ … }` (destructure)" },
    PlainNameInImportModifiers   { .id = "R2033", .message = "a plain name in an `import \"p\" { … }` modifier list — use `x as _` (exclude) or `x as y` (rename)" },
    CompilerImportFromLibrary    { .id = "R2034", .message = "a shipped library must not import the compiler" },
    UnknownTargetSelector        { .id = "R2035", .message = "unknown target selector" },
    TargetBodyWithoutDeclaration { .id = "R2036", .message = "`@target` body matches no declaration" },
    TargetBodyCarriesExport      { .id = "R2037", .message = "`@target` body carries `export`" },
    TargetBodiesOverlap          { .id = "R2038", .message = "two `@target` bodies cover the same platform" },
    DuplicateTargetDeclaration   { .id = "R2039", .message = "duplicate bare `@target` declaration" },
    TargetBodySignatureDiffers   { .id = "R2040", .message = "`@target` body does not have the declaration's signature" },
    NoTargetBodyCoversTarget     { .id = "R2041", .message = "no `@target` body covers the target being built" },
}

// C-codes belong to the comptime evaluator + monomorphizer ; once
// shipped, never re-used.
export ComptimeCode :: enum(CodeInfo) {
    CannotEvaluate                  { .id = "C4001", .message = "expression cannot be evaluated at compile time" },
    EvaluationPanic                 { .id = "C4002", .message = "comptime evaluation panicked" },
    NotCallable                     { .id = "C4003", .message = "function is not callable in comptime context" },
    StackOverflow                   { .id = "C4004", .message = "comptime call stack overflow" },
    DivisionByZero                  { .id = "C4005", .message = "comptime division by zero" },
    FileNotReadable                 { .id = "C4006", .message = "@file path could not be read" },
    TypeMismatch                    { .id = "C4007", .message = "comptime value has incompatible type" },
    EnvRequiresFlag                 { .id = "C4008", .message = "ENV access requires `--allow-env`" },
    DependencyCycle                 { .id = "C4009", .message = "comptime evaluation depends on itself" },
    IndexOutOfBounds                { .id = "C4010", .message = "comptime index out of bounds" },
    FeatureNotSupported             { .id = "C4011", .message = "comptime feature not yet supported" },
    FileSingleArg                   { .id = "C4012", .message = "@file expects a single string-literal argument" },
    DecoratorArgsStringLit          { .id = "C4013", .message = "decorator arguments must be string literals at comptime" },
    InstanceDiscoveryDidNotConverge { .id = "C4014", .message = "generic instance discovery did not converge" },
    AssertFailed                    { .id = "C4015", .message = "compile-time assertion failed" },
    ImpureHostAtComptime            { .id = "C4016", .message = "impure host call at comptime" },
}

// M-codes belong to the MIR-lowering pass (AST -> Lowered IR) ; once
// shipped, never re-used. The `M` prefix avoids ambiguity with `L0xxx`
// (Lexer) and `B5001` (Backend), matching the `midir` module name.
export LowerCode :: enum(CodeInfo) {
    IteratorImplMissing      { .id = "M5001", .message = "for-in receiver has no `Iterator` impl" },
    LambdaCaptureUnsupported { .id = "M5002", .message = "lambda capture not yet supported for this binding kind" },
    UnreachableMatchPath     { .id = "M5003", .message = "match arm is unreachable after lowering" },
    IntoCoercionFailed       { .id = "M5004", .message = "`Into` coercion cannot be lowered" },
    IntrinsicUnsupported     { .id = "M5005", .message = "intrinsic not implemented by the lowerer" },
    SelfReceiverMissing      { .id = "M5006", .message = "method call lacks a resolvable `self` receiver" },
    UnresolvedIdent          { .id = "M5007", .message = "identifier did not resolve at lowering" },
    AwaitInShortCircuit      { .id = "M5009", .message = "`await` in a short-circuit operand or loop condition is not yet supported" },
    ComptimeForNotUnrollable { .id = "M5010", .message = "`@comptime for` cannot be unrolled" },
}

// `WARNING` — non-fatal diagnostics. New entries appended ; retired IDs are free
// to reuse — see the file header for the condition.
export WarningCode :: enum(CodeInfo) {
    UseOfDeprecated             { .id = "W0001", .message = "use of deprecated declaration" },
    UnreachableCode             { .id = "W0002", .message = "unreachable code" },
    WildcardOnClosedUnion       { .id = "W0005", .message = "wildcard arm on a closed union silences exhaustiveness checking ; enumerate the variants or mark the match `@partial`" },
    DeadCode                    { .id = "W0007", .message = "declaration is never used in its module" },
    LocalShadowsOuter           { .id = "W0008", .message = "local binding shadows an outer local or parameter of the same name" },
    LocalRedeclaration          { .id = "W0009", .message = "redeclaration of a name already bound in this block" },
    PreferLoopVariableOverLabel { .id = "W0010", .message = "prefer targeting this loop by its iteration variable over a label ; a label is only needed for a `while` / infinite loop that has no variable" },
    EmptyImportModifierList     { .id = "W0011", .message = "empty modifier list on an import — `import \"p\" {}` is just a wildcard, write `import \"p\"`" },
    UnusedExport                { .id = "W0012", .message = "exported function is never reached from the project's roots" },
    SharedRepeatElement         { .id = "W0013", .message = "`[v] * n` repeats one reference — every slot shares this freshly allocated element" },
    UnreachableMatchArm         { .id = "W0014", .message = "match arm can never be taken — an earlier arm already covers it" },
    MutableNeverReassigned      { .id = "W0015", .message = "local is declared mutable but never reassigned — declare it with `::`" },
    NeedlessEnumTypePrefix      { .id = "W0016", .message = "the enum name adds nothing here — the slot already pins it, so the bare variant reads the same" },
}

/// `H6xxx` — the build driver (`build.vader`) and the hooks it registers.
///
/// A driver reports through `HookReport`: it describes its own problem and the
/// registry owns the id, so a project's lint rules never allocate diagnostic
/// codes. The rest name failures of the driver contract itself.
export HookCode :: enum(CodeInfo) {
    MissingBuildEntry          { .id = "H6001", .message = "`build.vader` declares no `build` function" },
    InvalidBuildEntrySignature { .id = "H6002", .message = "invalid `build` signature" },
    NoBuildFiles               { .id = "H6003", .message = "the build driver queued no entry file" },
    HookReport                 { .id = "H6004", .message = "build driver reported a problem" },
    AmbiguousOutput            { .id = "H6005", .message = "one output name for several entries" },
    GenerationDidNotSettle     { .id = "H6006", .message = "code generation did not reach a fixed point" },
    InvalidGeneratedModuleName { .id = "H6007", .message = "invalid generated module name" },
    GeneratedModuleNotWritten  { .id = "H6008", .message = "cannot write a generated module" },
}

/// IR self-check codes, emitted by the cross-pass verifiers
/// (`vader/lower/verify`, `vader/midir/verify`) rather than by a compiling
/// phase. Each reports a malformed IR — a compiler bug, never something a
/// program can provoke.
///
/// The family takes the same no-fixture exception `H6xxx` takes: the
/// `diag_corpus` harness provokes a diagnostic by compiling a source file,
/// and no source file reaches these. `tests/verify.test.ts` pins them.
export InternalCode :: enum(CodeInfo) {
    StrayCoroutineMarker     { .id = "I7001", .message = "a transient coroutine marker survived lowering" },
    UnresolvedFnReference    { .id = "I7002", .message = "function reference resolves to no emitted function" },
    FieldNotAMember          { .id = "I7003", .message = "field access names no member of its receiver" },
    BlockIdOutOfRange        { .id = "I7004", .message = "terminator names a block outside the function" },
    LocalIdOutOfRange        { .id = "I7005", .message = "instruction names a local outside the function" },
    LocalReadNeverWritten    { .id = "I7006", .message = "local is read but never written" },
    EntryBlockNotZero        { .id = "I7008", .message = "entry block is not block 0" },
    NonPrimitiveDataPoolLeaf { .id = "I7009", .message = "pooled constant holds a non-primitive leaf" },
    ReturnArityMismatch      { .id = "I7010", .message = "a return hands back a different number of values than the function declares" },
}
