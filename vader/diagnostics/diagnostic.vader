// vader/diagnostics/diagnostic — structured diagnostic shape consumed by the
// terminal renderer and (eventually) the LSP. Carries the Severity /
// Position / Span / Diagnostic shapes the LSP serialises to JSON.

module "vader/diagnostics"

import "std/string"

export Severity :: enum {
    Error,
    Warning,
    Info,
    Hint,
}

// Source position. `offset` is a raw UTF-8 byte offset ; `column` is a
// 1-based **codepoint** index within the line (the lexer counts leading
// bytes). The LSP boundary translates to UTF-16 column counts when
// needed.
export Position :: struct {
    file: string
    offset: usize
    line: i32
    column: i32
}

// Half-open span [start, end) in source.
export Span :: struct {
    start: Position
    end: Position
}

/// Position key for span-keyed side-tables. Folds the source file (via
/// its FNV hash) with the start line/column so spans at the same
/// `(line, column)` in DIFFERENT files of a multi-file module don't
/// collide when their per-module maps merge. `start`-only by design :
/// every side-table that keys on a span keys on its start ; `Equals`
/// (start AND end) still distinguishes an envelope expr from its child
/// in a hash bucket, so the start-only hash is a valid
/// over-approximation.
Span implements Hash -> self.start.file.hash() * 1000003 + (u64(self.start.line) << 32) + u64(self.start.column)

/// Structural equality over `(file, line, column)` of both ends — the
/// full key the typed-ast side-tables need to tell an envelope expr
/// apart from a child that shares its start position.
Span implements Equals {
    equals :: fn(self, other: Span) -> bool {
        return self.start.file == other.start.file &&
            self.start.line == other.start.line &&
            self.start.column == other.start.column &&
            self.end.line == other.end.line &&
            self.end.column == other.end.column
    }
}

/// `lineS:colS-lineE:colE` — human-readable form for diagnostics and
/// for keying side-tables that need an envelope expr to stay disjoint
/// from a child sharing its start position.
Span implements Display -> "${self.start.line}:${self.start.column}-${self.end.line}:${self.end.column}"

/// Sentinel file name on spans minted by the compiler with no real source
/// origin (test fixtures, intrinsic stubs, lowering-synthesised nodes).
export SYNTHETIC_FILE :: "<synthetic>"

/// Synthetic `Span` for AST nodes minted by the compiler (test fixtures,
/// materialised trait methods, intrinsic stubs). Points to a dummy 1:1
/// position so renderers and span-keyed side-tables stay happy.
export empty_span :: fn() -> Span {
    return Span {
        .start = Position { .file = SYNTHETIC_FILE, .offset = 0, .line = 1, .column = 1 },
        .end   = Position { .file = SYNTHETIC_FILE, .offset = 1, .line = 1, .column = 2 },
    }
}

/// Sentinel file name on spans that belong to AST nodes cloned from a
/// trait's default-method body into an implementing struct's impl.
/// The typecheck dump renders these spans as `undefined:undefined`.
export MATERIALIZED_FILE :: "<materialized>"

/// True when `s` points at a real source location worth surfacing to a user
/// — a concrete file with a 1-based line. False for every compiler-minted
/// marker : the `<synthetic>` sentinel (`empty_span`), the `<materialized>`
/// marker (`materialized_span`, line 0), a blank file (`empty_span(file)`
/// with no file), or any non-positive line. Callers gate per-op `#line` /
/// `DebugPos` emission on this so no bogus `#line 0 "<materialized>"` reaches
/// the C output or the debugger.
export has_source_position :: fn(s: Span) -> bool {
    if s.start.file == "" { return false }
    if s.start.file == SYNTHETIC_FILE { return false }
    if s.start.file == MATERIALIZED_FILE { return false }
    return s.start.line > 0
}

export Diagnostic :: struct {
    severity: Severity
    // Resolved at construction time so the renderer doesn't need to dispatch
    // on a union-of-enums (which the runtime can't pattern-match cleanly).
    code:     CodeInfo
    // Optional detail appended to the canonical message at render time.
    detail:   string
    primary:  Span
}

/// Generic constructor for a fully-resolved `Diagnostic` record. Callers
/// normally reach for one of the typed `*_error` / `*_warning` shortcuts
/// below ; `new_diagnostic` is exposed for the rare emitter that knows
/// its `CodeInfo` ahead of time (snapshot loaders, JSON re-import).
/// True when any diagnostic in `diags` is error-severity.
///
/// The gate every stage uses before doing work a rejected program does not
/// deserve — the lowerer refuses to lower, the comptime pass refuses to bake.
///
/// @param diags  the accumulated diagnostics of a phase, or several merged.
/// @return       true as soon as one carries `.Error` ; warnings do not count.
export any_error_diag :: fn(diags: Diagnostic[]) -> bool {
    for d in diags {
        if d.severity == .Error {
            return true
        }
    }
    return false
}

export new_diagnostic :: fn(severity: Severity, code: CodeInfo, primary: Span, detail: string) =
    Diagnostic { .severity = severity, .code = code, .detail = detail, .primary = primary }

// One typed shortcut per phase — `<phase>_<severity>(.VariantName, span, detail)`.
// Phases : `lexer_*`, `parser_*`, `typecheck_*`. Severities are added on demand
// (callers exist today only for `error` ; `warning` / `info` / `hint` join
// when the first call site needs them — no point shipping dead helpers).

export lexer_error :: fn(code: LexerCode, primary: Span, detail: string) =
    new_diagnostic(.Error, lexer_info(code), primary, detail)

export parser_error :: fn(code: ParserCode, primary: Span, detail: string) =
    new_diagnostic(.Error, parser_info(code), primary, detail)

export typecheck_error :: fn(code: TypecheckCode, primary: Span, detail: string) =
    new_diagnostic(.Error, typecheck_info(code), primary, detail)

export resolver_error :: fn(code: ResolverCode, primary: Span, detail: string) =
    new_diagnostic(.Error, resolver_info(code), primary, detail)

export comptime_error :: fn(code: ComptimeCode, primary: Span, detail: string) =
    new_diagnostic(.Error, comptime_info(code), primary, detail)

export lower_error :: fn(code: LowerCode, primary: Span, detail: string) =
    new_diagnostic(.Error, lower_info(code), primary, detail)

export hook_error :: fn(code: HookCode, primary: Span, detail: string) =
    new_diagnostic(.Error, hook_info(code), primary, detail)

export warning :: fn(code: WarningCode, primary: Span, detail: string) =
    new_diagnostic(.Warning, warning_info(code), primary, detail)
