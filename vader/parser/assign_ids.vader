// vader/parser/assign_ids — post-parse walker assigning unique IDs.
//
// Every AST node declares `id: usize = UNASSIGNED_NODE_ID` so downstream
// passes can key side-tables (`expr_types`, `expr_kinds`, …) on a stable
// integer rather than on stringified spans (which collide when materialise
// clones default-method bodies into impl members).
//
// Vader has no reflection, so this walker enumerates every variant of
// `Decl`, `Expr`, `Stmt`, `Pattern`, `LetBinding`, `ImportBinding`,
// `StringLitPart`, etc. explicitly.

/// Mints a unique `usize` id per call. One factory per parsed file is the
/// expected ownership shape ; cloned bodies in `materialize.vader` re-use
/// the host module's factory so cloned-node IDs stay disjoint from
/// pre-existing IDs in that module.
module "vader/parser"

export NodeIdFactory :: struct { next: usize }

/// Build a fresh factory. IDs start at 1 — `0` is reserved for
/// `UNASSIGNED_NODE_ID` so `node.id == 0` reliably detects un-walked nodes.
export new_node_id_factory :: fn() -> NodeIdFactory {
    return NodeIdFactory { .next = 1 }
}

/// Mint the next ID and advance the counter. Pure side-effect on `self`.
export mint :: fn(self: NodeIdFactory!) -> usize {
    id :: self.next
    self.next = id + 1
    return id
}

/// Walk a freshly-parsed `Program`, minting an ID on every reachable
/// AST node. Idempotent only if called once per program — re-running
/// would re-stamp IDs and break any side-table built against the prior
/// IDs.
export assign_program_ids :: fn(p: Program!, f: NodeIdFactory!) -> void {
    p.id = f.mint()
    match p.module {
        is null       -> {}
        is ModuleDecl -> { p.module.id = f.mint() }
    }
    for d in p.decls { walk_decl(d, f) }
}

/// Re-entrant entry for cloned blocks (used by
/// `vader/resolver/materialize.vader` after substituting default-method
/// bodies into an impl). Same factory the host module's parse used so
/// cloned IDs don't collide with pre-existing ones.
export assign_block_ids :: fn(b: BlockExpr!, f: NodeIdFactory!) -> void {
    walk_block(b, f)
}

// ---- declaration walkers --------------------------------------------------

walk_decl :: fn(d: Decl!, f: NodeIdFactory!) -> void {
    match d {
        is ImportDecl -> {
            d.id = f.mint()
            walk_import_binding(d.binding, f)
            for dec in d.decorators { walk_decorator(dec, f) }
        }
        is FnDecl -> { walk_fn_decl(d, f) }
        is StructDecl -> {
            d.id = f.mint()
            for tp in d.type_params { walk_type_param(tp, f) }
            for fld in d.fields {
                fld.id = f.mint()
                walk_expr(fld.ty, f)
                if fld.default !is null {
                    walk_expr(fld.default, f)
                }
            }
            for dec in d.decorators { walk_decorator(dec, f) }
        }
        is EnumDecl -> {
            d.id = f.mint()
            if d.repr !is null {
                walk_expr(d.repr, f)
            }
            for v in d.variants { v.id = f.mint() }
            for dec in d.decorators { walk_decorator(dec, f) }
        }
        is TraitDecl -> {
            d.id = f.mint()
            for tp in d.type_params { walk_type_param(tp, f) }
            if d.requires !is null {
                walk_expr(d.requires, f)
            }
            for m in d.members { walk_fn_decl(m, f) }
            for dec in d.decorators { walk_decorator(dec, f) }
        }
        is ImplDecl -> {
            d.id = f.mint()
            for tp in d.type_params { walk_type_param(tp, f) }
            walk_expr(d.for_type, f)
            for ta in d.trait_args { walk_expr(ta, f) }
            for m in d.members { walk_fn_decl(m, f) }
            for dec in d.decorators { walk_decorator(dec, f) }
        }
        is TypeAliasDecl -> {
            d.id = f.mint()
            for tp in d.type_params { walk_type_param(tp, f) }
            walk_expr(d.aliased, f)
            for dec in d.decorators { walk_decorator(dec, f) }
        }
        is ConstDecl -> {
            d.id = f.mint()
            if d.ty !is null {
                walk_expr(d.ty, f)
            }
            walk_expr(d.value, f)
            for dec in d.decorators { walk_decorator(dec, f) }
        }
        is AssertDecl -> {
            d.id = f.mint()
            walk_expr(d.condition, f)
            for dec in d.decorators { walk_decorator(dec, f) }
        }
    }
}

walk_fn_decl :: fn(d: FnDecl!, f: NodeIdFactory!) -> void {
    d.id = f.mint()
    for dec in d.decorators { walk_decorator(dec, f) }
    for tp in d.type_params { walk_type_param(tp, f) }
    for p in d.params { walk_fn_param(p, f) }
    if d.return_type !is null {
        walk_expr(d.return_type, f)
    }
    if d.body !is null {
        walk_block(d.body, f)
    }
}

walk_fn_param :: fn(p: FnParam!, f: NodeIdFactory!) -> void {
    p.id = f.mint()
    if p.ty !is null {
        walk_expr(p.ty, f)
    }
    if p.default_value !is null {
        walk_expr(p.default_value, f)
    }
}

walk_type_param :: fn(tp: TypeParam!, f: NodeIdFactory!) -> void {
    tp.id = f.mint()
    if tp.bound !is null {
        walk_expr(tp.bound, f)
    }
}

walk_decorator :: fn(d: Decorator!, f: NodeIdFactory!) -> void {
    d.id = f.mint()
    for a in d.args { walk_expr(a, f) }
}

walk_import_binding :: fn(b: ImportBinding, f: NodeIdFactory!) -> void {
    match b {
        is NamedNamespaceImport -> {}
        is WildcardImport -> {}
        is DestructureImport -> {
            for n in b.names { n.id = f.mint() }
        }
    }
}

// ---- expression walker ---------------------------------------------------

walk_expr :: fn(e: Expr!, f: NodeIdFactory!) -> void {
    match e {
        is IntLitExpr    -> { e.id = f.mint() }
        is FloatLitExpr  -> { e.id = f.mint() }
        is BoolLitExpr   -> { e.id = f.mint() }
        is NullLitExpr   -> { e.id = f.mint() }
        is CharLitExpr   -> { e.id = f.mint() }
        is StringLitExpr -> {
            e.id = f.mint()
            for p in e.parts {
                match p {
                    is StringLitText   -> { p.id = f.mint() }
                    is StringLitInterp -> {
                        p.id = f.mint()
                        walk_expr(p.expr, f)
                    }
                }
            }
        }
        is IdentExpr -> { e.id = f.mint() }
        is CallExpr -> {
            e.id = f.mint()
            walk_expr(e.callee, f)
            for a in e.args {
                a.id = f.mint()
                walk_expr(a.value, f)
            }
        }
        is FieldExpr -> {
            e.id = f.mint()
            walk_expr(e.target, f)
        }
        is IndexExpr -> {
            e.id = f.mint()
            walk_expr(e.target, f)
            walk_expr(e.index, f)
        }
        is UnaryExpr -> {
            e.id = f.mint()
            walk_expr(e.operand, f)
        }
        is BinaryExpr -> {
            e.id = f.mint()
            walk_expr(e.left, f)
            walk_expr(e.right, f)
        }
        is NullCoalesceExpr -> {
            e.id = f.mint()
            walk_expr(e.left, f)
            match e.fallback {
                is ReturnStmt | BreakStmt | ContinueStmt as s -> { walk_stmt(s, f) }
                is Expr as e -> { walk_expr(e, f) }
            }
        }
        is IfExpr -> {
            e.id = f.mint()
            walk_expr(e.cond, f)
            walk_block(e.then_block, f)
            match e.else_branch {
                is null -> {}
                is IfElseIf    as ei -> { walk_expr(ei.branch, f) }
                is IfElseBlock as eb -> { walk_block(eb.block, f) }
            }
        }
        is MatchExpr -> {
            e.id = f.mint()
            walk_expr(e.scrutinee, f)
            for a in e.arms {
                a.id = f.mint()
                walk_pattern(a.pattern, f)
                if a.guard !is null {
                    walk_expr(a.guard, f)
                }
                walk_expr(a.body, f)
            }
        }
        is BlockExpr -> { walk_block(e, f) }
        is LambdaExpr -> {
            e.id = f.mint()
            for p in e.params { walk_fn_param(p, f) }
            if e.return_type !is null {
                walk_expr(e.return_type, f)
            }
            walk_block(e.body, f)
        }
        is StructLitExpr -> {
            e.id = f.mint()
            walk_expr(e.type_name, f)
            for item in e.items {
                match item {
                    is StructLitField -> {
                        item.id = f.mint()
                        walk_expr(item.value, f)
                    }
                    is StructLitSpread  -> {
                        item.id = f.mint()
                        walk_expr(item.expr, f)
                    }
                }
            }
        }
        is SeqLitExpr -> {
            e.id = f.mint()
            for el in e.elements { walk_expr(el, f) }
        }
        is RangeExpr -> {
            e.id = f.mint()
            walk_expr(e.lower, f)
            walk_expr(e.upper, f)
        }
        is AwaitExpr -> {
            e.id = f.mint()
            walk_expr(e.inner, f)
        }
        is CastExpr -> {
            e.id = f.mint()
            walk_expr(e.target, f)
            walk_expr(e.value, f)
        }
        is GenericInstExpr -> {
            e.id = f.mint()
            walk_expr(e.callee, f)
            for ta in e.type_args { walk_expr(ta, f) }
        }
        is IntrinsicCallExpr -> {
            e.id = f.mint()
            for a in e.args { walk_expr(a, f) }
        }
        is DotVariantExpr -> { e.id = f.mint() }
        is FnTypeExpr -> {
            e.id = f.mint()
            for p in e.params { walk_expr(p, f) }
            if e.return_type !is null {
                walk_expr(e.return_type, f)
            }
        }
        is ArrayTypeExpr -> {
            e.id = f.mint()
            walk_expr(e.element, f)
        }
        is MutableTypeExpr -> {
            e.id = f.mint()
            walk_expr(e.inner, f)
        }
    }
}

// ---- block / stmt / pattern walkers ---------------------------------------

walk_block :: fn(b: BlockExpr!, f: NodeIdFactory!) -> void {
    b.id = f.mint()
    for s in b.stmts { walk_stmt(s, f) }
    if b.trailing !is null {
        walk_expr(b.trailing, f)
    }
}

walk_stmt :: fn(s: Stmt!, f: NodeIdFactory!) -> void {
    match s {
        is LetStmt -> {
            s.id = f.mint()
            walk_let_binding(s.binding, f)
            if s.ty !is null {
                walk_expr(s.ty, f)
            }
            walk_expr(s.value, f)
        }
        is AssignStmt -> {
            s.id = f.mint()
            walk_expr(s.target, f)
            walk_expr(s.value, f)
        }
        is ExprStmt -> {
            s.id = f.mint()
            walk_expr(s.expr, f)
        }
        is ReturnStmt -> {
            s.id = f.mint()
            if s.value !is null {
                walk_expr(s.value, f)
            }
        }
        is YieldStmt -> {
            s.id = f.mint()
            walk_expr(s.value, f)
        }
        is ForStmt -> {
            s.id = f.mint()
            walk_for_form(s.form, f)
            walk_block(s.body, f)
        }
        is BreakStmt -> { s.id = f.mint() }
        is ContinueStmt -> { s.id = f.mint() }
        is DeferStmt -> {
            s.id = f.mint()
            match s.body {
                is DeferStmtBody  as ds -> { walk_stmt(ds.stmt, f) }
                is DeferBlockBody as db -> { walk_block(db.block, f) }
            }
        }
    }
}

walk_for_form :: fn(form: ForForm!, f: NodeIdFactory!) -> void {
    match form {
        is InfiniteFor -> {}
        is WhileFor -> { walk_expr(form.cond, f) }
        is InFor -> { walk_expr(form.iter, f) }
    }
}

walk_let_binding :: fn(b: LetBinding!, f: NodeIdFactory!) -> void {
    match b {
        is SimpleBinding   -> { b.id = f.mint() }
        is WildcardBinding -> { b.id = f.mint() }
        is RestBinding     -> { b.id = f.mint() }
        is TupleBinding    -> {
            b.id = f.mint()
            for el in b.elements { walk_let_binding(el, f) }
        }
    }
}

walk_pattern :: fn(p: Pattern!, f: NodeIdFactory!) -> void {
    match p {
        is IsPattern -> {
            p.id = f.mint()
            walk_expr(p.ty, f)
            if p.inner !is null {
                walk_pattern(p.inner, f)
            }
        }
        is StructPattern -> {
            p.id = f.mint()
            for fld in p.fields {
                fld.id = f.mint()
                match fld.value {
                    is PatternBinding as pb -> { pb.id = f.mint() }
                    is PatternLiteral as pl -> { walk_expr(pl.value, f) }
                }
            }
        }
        is TuplePattern -> {
            p.id = f.mint()
            for el in p.elements { walk_pattern(el, f) }
        }
        is WildcardPattern    -> { p.id = f.mint() }
        is BindingPattern     -> { p.id = f.mint() }
        is EnumVariantPattern -> { p.id = f.mint() }
        is LiteralPattern     -> {
            p.id = f.mint()
            walk_expr(p.value, f)
        }
        is RangePattern -> {
            p.id = f.mint()
            walk_expr(p.lower, f)
            walk_expr(p.upper, f)
        }
        is OrPattern -> {
            p.id = f.mint()
            for sub in p.patterns { walk_pattern(sub, f) }
        }
    }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "toolchain/ast"

@test
test_mint_starts_at_one_and_increments :: fn() -> void {
    f :: new_node_id_factory()
    assert_eq(f.mint(), 1)
    assert_eq(f.mint(), 2)
    assert_eq(f.mint(), 3)
}

@test
test_assign_program_ids_stamps_decls_and_exprs :: fn() -> void {
    parsed :: parse_source("""
fact :: fn(n: i32) -> i32 {
    if n <= 1 { return 1 }
    return n * fact(n - 1)
}
""", "t.vader")
    // parser.vader already calls assign_program_ids ; verify by sampling
    // the program + its first decl (FnDecl).
    assert(parsed.program.id != UNASSIGNED_NODE_ID, "program.id minted")
    for d in parsed.program.decls {
        match d {
            is FnDecl -> {
                assert(d.id != UNASSIGNED_NODE_ID, "fn id minted")
                for p in d.params {
                    assert(p.id != UNASSIGNED_NODE_ID, "param id minted")
                }
            }
            _ -> {}
        }
    }
}
