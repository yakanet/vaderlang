// vader/bootstrap/bootstrap: the source of the committed C seed.
//
// A compiler with a single command, which compiles its input to one C unit per
// module (docs/BOOTSTRAP.md). It must not import `vader/tools/`, so that the
// command line, the formatter, the language server and the debugger never change
// the seed. It drives `vader/pipeline` as `vader build --release --emit=c` does:
// `bootstrap/verify.sh` checks that both write the same C for the compiler.

module "vader/bootstrap"

import "std/console"
import "std/path"
import "vader/pipeline"

/// Compile `argv[1]` to one C unit per module, written beside the prefix `argv[2]`.
///
/// The prefix `build/work/stage1/stage1` yields `stage1.split.h`,
/// `stage1.split.g.c` and one `stage1-<module>.c` per module. Its directory must
/// exist.
///
/// The command line and the names of the files are frozen between two seeds: the
/// build scripts follow the tree but run the stage0 of the committed seed, so
/// changing either needs a new seed.
///
/// @param argv  `argv[1]` the input `.vader`, `argv[2]` the output prefix.
/// @return      0 on success, 1 on a usage, compile or write error.
main :: fn(argv: string[]) -> i32 {
    if argv.len() < 3 {
        eprintln("usage: bootstrap <input.vader> <output-prefix>")
        return 1
    }
    b :: prepare_program(argv[1].to_path(), BuildRequest { .emit = "c", .release = true })
    if !flush_build_diags(b.pre_diags, b.lower_diags) {
        return 1
    }
    return write_split_c(b, argv[2].to_path())
}
