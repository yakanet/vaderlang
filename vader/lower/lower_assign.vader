// vader/lower/lower_assign — assignment and index / slice lowering.
//

module "vader/lower"

import "std/collections"
import "toolchain/ast"
import "vader/diagnostics"
import "vader/resolver/symbol"
import "vader/types"
import "toolchain/span"

lower_assign :: fn(ctx: FnLowerCtx!, assign_stmt: AssignStmt) -> LoweredStmt =
    lower_assign_one(ctx, assign_stmt.target, lower_expr(ctx, assign_stmt.value), assign_stmt.span)

/// One write to one target, with the value ALREADY lowered.
///
/// Every assignment funnels through here — the plain `a = v` and each element of
/// a destructuring assignment alike — because the two special shapes below are
/// invisible in the target's syntax: an `m[k]` over an `IndexSet` impl is a
/// `set_at` call, and a captured local is a write THROUGH a cell. A caller that
/// built its own `LoweredAssign` would drop the map write on the floor and
/// corrupt the captured slot.
lower_assign_one :: fn(
    ctx: FnLowerCtx!, target: Expr, value: LoweredExpr, span: Span,
) -> LoweredStmt {
    via_index_set :: try_lower_index_set_assign(ctx, target, value, span)
    if via_index_set != null { return via_index_set }
    // Reassignment to a captured local : write into its cell rather than
    // overwriting the slot.
    via_cell :: try_lower_cell_set_assign(ctx, target, value, span)
    if via_cell != null { return via_cell }
    return LoweredAssign {
        .span = span, .target = lower_assign_target(ctx, target), .value = value,
    }
}

try_lower_cell_set_assign :: fn(
    ctx: FnLowerCtx!, assign_target: Expr, value: LoweredExpr, span: Span,
) -> LoweredStmt | null {
    target_ident :: as_ident(assign_target) ?? return null
    if target_ident is IdentExpr {
        symbol :: ctx.typed.resolved.idents[target_ident.span.hash()] ?? return null
        if symbol is Symbol {
            if !ctx.project.closures.captured_symbols.contains(symbol.id) { return null }
            value_type :: ctx.types.expr_type(target_ident)
            // Build the cell pointer. Inside a lifted lambda body the
            // captured symbol has no local slot ; the cell ref lives on
            // the env-struct param at `cap_N`. Otherwise (in the
            // enclosing fn) the local slot itself holds the cell.
            // Mirrors `try_route_through_env`'s structure but without
            // the trailing CellGet wrap — we want the raw cell pointer
            // so CellSet can write through it.
            cell_ref: LoweredExpr = LoweredIdent {
                .span = target_ident.span, .type = value_type, .symbol = symbol,
            }
            lifted :: ctx.lifted_context
            if !(lifted is null) {
                field_name :: lifted.capture_fields[symbol.id]
                if field_name is string {
                    env_ident :: LoweredIdent {
                        .span = target_ident.span, .type = lifted.env_type,
                        .symbol = lifted.env_symbol,
                    }
                    cell_ref = LoweredFieldAccess {
                        .span = target_ident.span, .type = TY_UNRESOLVED,
                        .target = env_ident, .field = field_name,
                    }
                }
            }
            return LoweredCellSet {
                .span = span,
                .target = cell_ref,
                .value = value,
                .value_type = value_type,
            }
        }
    }
    return null
}

// `[t0, _, ...rest] = value` — read every element into its own temp, THEN write.
//
// The two phases are the whole point: writing as we read would make
// `[a, b] = [b, a]` assign `a = b` and then read the NEW `a` back into `b`.
// The source is bound once too, so `[a, b] = f()` calls `f` a single time. A
// `_` reads nothing; a `...rest` builds its fresh tail array in the read phase.
lower_destructuring_assign :: fn(ctx: FnLowerCtx!, s: DestructureAssignStmt) -> LoweredStmt {
    span :: s.span
    value_ty :: ctx.types.expr_type(s.value)
    src_sym :: fresh_synthetic_symbol(ctx, "destr_src")
    stmts: LoweredStmt[]!: [
        LoweredLet {
            .span = span, .name = src_sym.name, .symbol = src_sym,
            .type = value_ty, .value = lower_expr(ctx, s.value),
        },
    ]
    src :: synth_ident(src_sym, value_ty, span)
    backing :: destructure_backing(value_ty)
    writes: Expr[]!: []
    reads: LoweredExpr[]!: []
    for i in 0..<s.targets.len() {
        match s.targets[i] as t {
            is PlaceTarget    -> {
                elem_ty :: ctx.types.expr_type(t.place)
                tmp :: fresh_synthetic_symbol(ctx, "destr_el")
                stmts.push(LoweredLet {
                    .span = span, .name = tmp.name, .symbol = tmp, .type = elem_ty,
                    .value = build_leaf_access(src, backing, elem_ty, span, i, null),
                })
                writes.push(t.place)
                reads.push(synth_ident(tmp, elem_ty, span))
            }
            is RestTarget     -> {
                // The typechecker only lets a rest through over an array source.
                arr :: array_backing(value_ty) ?? continue
                elem_ty :: ctx.types.apply(arr.element)
                tail_ty :: mk_array(elem_ty, false)
                tmp :: fresh_synthetic_symbol(ctx, "destr_rest")
                stmts.push(LoweredLet {
                    .span = span, .name = tmp.name, .symbol = tmp, .type = tail_ty,
                    .value = LoweredArrayLit { .span = span, .type = tail_ty, .elements = [] },
                })
                tail :: synth_ident(tmp, tail_ty, span)
                emit_tail_copy(ctx, tail, i, src, elem_ty, span, stmts)
                writes.push(t.place)
                reads.push(tail)
            }
            is WildcardTarget -> {}
        }
    }
    for i in 0..<writes.len() {
        stmts.push(lower_assign_one(ctx, writes[i], reads[i], span))
    }
    return wrap_stmts(span, stmts)
}

/// Lvalue lowerer — bypasses the match-narrowing `LoweredCast` wrap that
/// `lower_ident` applies on use-site reads. The bytecode emitter resolves
/// assignment slots via the raw `LoweredIdent` ; a cast in target position
/// breaks that pattern match.
lower_assign_target :: fn(ctx: FnLowerCtx!, target: Expr) -> LoweredExpr {
    if target is IdentExpr {
        symbol :: ctx.typed.resolved.idents[target.span.hash()]
        if symbol is Symbol {
            return LoweredIdent {
                .span = target.span, .type = ctx.types.expr_type(target), .symbol = symbol,
            }
        }
    }
    return lower_expr(ctx, target)
}

// `arr[lo..<hi]` / `arr[lo..=hi]` over an array-typed receiver lowers
// to `LoweredArraySlice` (zero-copy view). Other index expressions
// (single-element access, user IndexExpr on structs) keep the
// generic `LoweredIndex` shape.

lower_index :: fn(ctx: FnLowerCtx!, expr: IndexExpr, type: Type) -> LoweredExpr {
    target_type :: ctx.types.expr_type(expr.target)
    is_range :: index_is_range(ctx, expr.index)
    if is_range {
        // `arr[r]` → zero-copy `LoweredArraySlice` ; `s[r]` (string) →
        // codepoint-range `LoweredStringSlice`.
        if array_backing(target_type) != null {
            sliced :: try_lower_range_slice(ctx, expr, type, false)
            if sliced != null { return sliced }
        }
        if target_type is PrimitiveType {
            if target_type.name == "string" {
                sliced :: try_lower_range_slice(ctx, expr, type, true)
                if sliced != null { return sliced }
            }
        }
    }
    // TypeParam-bounded `Index` receiver : the typer recorded the dispatch on
    // this index expr — emit a virtual `Index.at(c, i)` call so the erased
    // receiver's runtime tag picks the impl, mirroring the `c.at(i)` method form
    // (`try_lower_virtual_call`).
    if ctx.typed.bounded_dispatch_trait[expr.id] is string as bounded_trait {
        ctx.project.virtually_dispatched_traits.add(bounded_trait)
        return LoweredVirtualCall {
            .span = expr.span, .type = type,
            .trait_name = bounded_trait, .method = METHOD_AT,
            .receiver = lower_expr(ctx, expr.target),
            .args = [lower_expr(ctx, expr.index)],
        }
    }
    // Index trait routing : `s[i]` on a `string` / user struct with an
    // `Index<I, T>` impl rewrites to a direct `at(s, i)` call. Skip for
    // ArrayType (built-in path above) and for Range-typed indices
    // (slicing handled above).
    if !is_range && array_backing(target_type) == null {
        member :: find_trait_impl_member(ctx, target_type, TRAIT_INDEX)
        if member is UfcsMember {
            args: LoweredExpr[]!: []
            args.push(lower_expr(ctx, expr.target))
            args.push(lower_expr(ctx, expr.index))
            return LoweredCall {
                .span = expr.span, .type = type,
                .callee = LoweredIdent {
                    .span = expr.span, .type = type, .symbol = member.symbol,
                },
                .args = args,
            }
        }
    }
    return LoweredIndex {
        .span = expr.span, .type = type,
        .target = lower_expr(ctx, expr.target),
        .index  = lower_expr(ctx, expr.index),
    }
}

index_is_range :: fn(ctx: FnLowerCtx, index_expr: Expr) -> bool {
    if index_expr is RangeExpr { return true }
    idx_type :: ctx.types.expr_type(index_expr)
    if idx_type is StructType { return idx_type.symbol.name == STRUCT_RANGE }
    return false
}

// Build the slice node — `LoweredStringSlice` for codepoint-range string
// slicing, `LoweredArraySlice` for the zero-copy array view. The two
// share an identical shape ; only the runtime op downstream differs.
mk_slice_node :: fn(as_string: bool, span: Span, type: Type, target: LoweredExpr, lo: LoweredExpr, hi: LoweredExpr) -> LoweredExpr {
    if as_string {
        return LoweredStringSlice {
            .span = span, .type = type, .target = target, .lo = lo, .hi = hi,
        }
    }
    return LoweredArraySlice {
        .span = span, .type = type, .target = target, .lo = lo, .hi = hi,
    }
}

try_lower_range_slice :: fn(ctx: FnLowerCtx!, expr: IndexExpr, type: Type, as_string: bool) -> LoweredExpr | null {
    match expr.index as range_lit {
        is RangeExpr -> {
            target_lowered :: lower_expr(ctx, expr.target)
            lo_value :: cast_to_usize(lower_expr(ctx, range_lit.lower), range_lit.span)
            hi_raw   :: cast_to_usize(lower_expr(ctx, range_lit.upper), range_lit.span)
            hi_value :: adjust_hi_inclusive(hi_raw, range_lit.inclusive, range_lit.span)
            return mk_slice_node(as_string, expr.span, type, target_lowered, lo_value, hi_value)
        }
        _            -> {}
    }
    // Range-typed *value* index (`let r = 0..<n ; arr[r]`) — bind the
    // range to a temp so the three field reads (`.start`, `.end`,
    // `.inclusive`) share one evaluation, then emit the slice.
    idx_type :: ctx.types.expr_type(expr.index)
    if idx_type is StructType {
        if idx_type.symbol.name != STRUCT_RANGE { return null }
        span :: expr.span
        range_sym :: fresh_synthetic_symbol(ctx, "slice_r")
        range_binding :: LoweredLet {
            .span = span, .name = range_sym.name, .symbol = range_sym,
            .type = idx_type, .value = lower_expr(ctx, expr.index),
        }
        range_ref :: LoweredIdent { .span = span, .type = idx_type, .symbol = range_sym }
        bound_type :: if idx_type.args.len() > 0 { idx_type.args[0] } else { mk_primitive("usize") }
        lo_value :: cast_to_usize(LoweredFieldAccess {
            .span = span, .type = bound_type, .target = range_ref, .field = "start",
        }, span)
        hi_raw :: cast_to_usize(LoweredFieldAccess {
            .span = span, .type = bound_type, .target = range_ref, .field = "end",
        }, span)
        hi_value :: adjust_hi_inclusive_dynamic(hi_raw, LoweredFieldAccess {
            .span = span, .type = TY_BOOL, .target = range_ref, .field = "inclusive",
        }, span)
        stmts: LoweredStmt[]!: []
        stmts.push(range_binding)
        return LoweredBlock {
            .span = span, .type = type, .stmts = stmts,
            .trailing = mk_slice_node(
                as_string, span, type, lower_expr(ctx, expr.target), lo_value, hi_value,
            ),
        }
    }
    return null
}

adjust_hi_inclusive_dynamic :: fn(hi: LoweredExpr, inclusive: LoweredExpr, span: Span) -> LoweredExpr {
    usize_ty :: mk_primitive("usize")
    delta :: LoweredIf {
        .span = span, .type = usize_ty, .cond = inclusive,
        .then_block = LoweredBlock {
            .span = span, .type = usize_ty, .stmts = [],
            .trailing = LoweredIntLit { .span = span, .type = usize_ty, .value = 1 },
        },
        .else_block = LoweredBlock {
            .span = span, .type = usize_ty, .stmts = [],
            .trailing = LoweredIntLit { .span = span, .type = usize_ty, .value = 0 },
        },
    }
    return LoweredBinary {
        .span = span, .type = usize_ty, .op = .Add,
        .left = hi, .right = delta,
    }
}

cast_to_usize :: fn(value: LoweredExpr, span: Span) -> LoweredExpr {
    // No-op when already usize.
    vt :: type_of(value)
    if vt is PrimitiveType {
        if vt.name == "usize" { return value }
    }
    return LoweredCast { .span = span, .type = mk_primitive("usize"), .value = value }
}

adjust_hi_inclusive :: fn(hi: LoweredExpr, inclusive: bool, span: Span) -> LoweredExpr {
    if !inclusive { return hi }
    return LoweredBinary {
        .span = span, .type = mk_primitive("usize"), .op = .Add,
        .left = hi,
        .right = LoweredIntLit { .span = span, .type = mk_primitive("usize"), .value = 1 },
    }
}

try_lower_index_set_assign :: fn(
    ctx: FnLowerCtx!, assign_target: Expr, value: LoweredExpr, span: Span,
) -> LoweredStmt | null {
    target :: assign_target
    // @partial: only an `m[k]` (IndexExpr) LHS can be an IndexSet assign; every
    // other Expr target → null (handled by the regular assign path).
    @partial match target {
        is IndexExpr -> {
            // TypeParam-bounded `IndexSet` receiver : the typer recorded the
            // dispatch on this index expr (`check_assign`) — emit a virtual
            // `IndexSet.set_at(c, i, v)` call (erased receiver, runtime tag picks
            // the impl), mirroring the read-side `Index.at` vcall in `lower_index`.
            if ctx.typed.bounded_dispatch_trait[target.id] is string as bounded_trait {
                ctx.project.virtually_dispatched_traits.add(bounded_trait)
                return LoweredExprStmt {
                    .span = span,
                    .expr = LoweredVirtualCall {
                        .span = span, .type = TY_VOID,
                        .trait_name = bounded_trait, .method = METHOD_SET_AT,
                        .receiver = lower_expr(ctx, target.target),
                        .args = [lower_expr(ctx, target.index), value],
                    },
                }
            }
            target_type :: ctx.types.expr_type(target.target)
            // Resolve the write through the `IndexSet` impl by TRAIT identity —
            // never by a hard-coded `"set_at"` literal. This matches how the
            // typechecker routes `m[k] = v` (`orchestrate.vader`, TRAIT_INDEX_SET)
            // and how `lower_index` reads (`find_trait_impl_member(…, TRAIT_INDEX)`),
            // and it carries the SAME mangle the materialiser emits (and that DCE
            // indexes). The old `synth_set_at_symbol` minted a bare `set_at` symbol
            // that no fn-table slot matched, so the call was silently dropped and
            // `m[k] = v` became a no-op (the value leaked onto the stack).
            member :: find_trait_impl_member(ctx, target_type, TRAIT_INDEX_SET) ?? return null
            if member is UfcsMember {
                // Build `set_at(target, index, value)` direct call.
                receiver :: lower_expr(ctx, target.target)
                index :: lower_expr(ctx, target.index)

                args: LoweredExpr[]!: []
                args.push(receiver)
                args.push(index)
                args.push(value)
                return LoweredExprStmt {
                    .span = span,
                    .expr = LoweredCall {
                        .span = span, .type = TY_VOID,
                        .callee = LoweredIdent {
                            .span = span, .type = TY_VOID, .symbol = member.symbol,
                        },
                        .args = args,
                    },
                }
            }
            return null
        }
        _ -> { return null }
    }
}

