// vader/lower/lower_subst — type substitutions and mangle-suffix helpers.
//

module "vader/lower"

import "std/collections"
import "std/iter"
import "std/math"
import "std/string_builder"

import "vader/diagnostics"
import "toolchain/ast"
import "vader/resolver"
import "vader/typecheck"
import "vader/types"
import "vader/comptime"
import "vader/resolver/symbol"

// A substitution of exactly `bindings`.
substitution_of :: fn(bindings: MutableMap<i32, Type>) -> Substitution =
    Substitution { .type_params = bindings, .self_type = null }

/// Each of `tps` bound to `args[i]`, the concrete instance (`Mono`).
build_concrete_subst :: fn(tps: TypeParam[], args: Type[], typed: TypedProgram) -> Substitution =
    substitution_of(type_param_bindings(tps, args, typed))

/// Each of `tps` bound to `args[i]` where `kept_argument` keeps it, to `Any` otherwise
/// (`Mixed`) : a primitive argument stays concrete, so trait dispatch devirtualises
/// and primitive operations inline, while references share one uniform-pointer body.
/// A struct's layout and every accessor of it must be built the same way : a field a
/// mixed layout keeps raw (`Entry.key: string`) is misread by an accessor that boxes
/// it.
build_mixed_subst :: fn(
    impls: ImplRegistry, tps: TypeParam[], args: Type[], typed: TypedProgram,
) -> Substitution = substitution_of(kept_or_any(impls, type_param_bindings(tps, args, typed)))

/// Every one of `tps` bound to `Any` (`Erased`), whatever the instance's arguments :
/// the instances of one declaration then share one body and one layout.
build_erased_subst :: fn(tps: TypeParam[], typed: TypedProgram) -> Substitution {
    bindings :: MutableMap<i32, Type> {}
    for tp in tps {
        sym :: typed.type_param_symbols[tp.span.hash()] ?? continue
        bindings[sym.id] = TY_ANY
    }
    return substitution_of(bindings)
}

// Each binding as a mixed instance keeps it : what `kept_argument` keeps, else `Any`.
kept_or_any :: fn(impls: ImplRegistry, bindings: MutableMap<i32, Type>) -> MutableMap<i32, Type> {
    out :: MutableMap<i32, Type> {}
    for [id, bound] in bindings {
        out[id] = impls.kept_argument(bound) ?? TY_ANY
    }
    return out
}

/// Replace every concrete leaf in a `Type` tree with `Any` while
/// preserving generic wrappers (Struct / Trait / Array / Union /
/// Tuple).
any_leaves_of :: fn(t: Type) -> Type {
    if t is StructType {
        if t.args.is_empty() { return TY_ANY }
        new_args: Type[]: []
        for a in t.args { new_args.push(any_leaves_of(a)) }
        return mk_struct(t.symbol, new_args)
    }
    if t is TraitType {
        if t.args.is_empty() { return TY_ANY }
        new_args: Type[]: []
        for a in t.args { new_args.push(any_leaves_of(a)) }
        return TraitType { ...t, .args = new_args }
    }
    if t is ArrayType {
        return mk_array(any_leaves_of(t.element))
    }
    if t is UnionType {
        // Erase THEN dedupe. Every variant that carries no args erases to `Any`,
        // so a union of N such variants — a type-param's trait bounds, say
        // `Hash & Equals`, or a 19-trait array bound — would otherwise become a
        // union of N `Any`s. That is a distinct SHAPE per arity: measured on one
        // driven build, 136 distinct `MutableMap` shapes and a mangle 1 539
        // characters long (`MutableMap__i32__ArrayClear___ArrayCopy___…`), each
        // one materialised as its own struct decl. `Any | Any` is `Any`.
        new_vars: Type[]: []
        seen :: MutableSet<string> {}
        for v in t.variants {
            erased :: any_leaves_of(v)
            key :: display_type(erased)
            if seen.contains(key) { continue }
            seen.add(key)
            new_vars.push(erased)
        }
        if new_vars.len() == 1 { return new_vars[0] }
        return mk_union(new_vars)
    }
    if t is TupleType {
        new_elems: Type[]: []
        for el in t.elements { new_elems.push(any_leaves_of(el)) }
        return mk_tuple(new_elems)
    }
    return TY_ANY
}

/// Short stable display used when synthesising the representative's
/// mangled name.
// @partial: only arg-bearing / composite type shapes render a suffix; every other type → "Any".
display_any_arg :: fn(t: Type) -> string = @partial match t {
    is StructType -> if t.args.is_empty() { t.symbol.name } else { joined_named(t.symbol.name, t.args, "_") }
    is TraitType  -> if t.args.is_empty() { t.symbol.name } else { joined_named(t.symbol.name, t.args, "_") }
    is ArrayType  -> "${display_any_arg(t.element)}_arr"
    is UnionType  -> joined_unnamed(t.variants, "__")
    is TupleType  -> joined_named("Tup", t.elements, "_")
    _             -> "Any"
}

joined_named :: fn(name: string, args: Type[], sep: string) -> string {
    sb :: StringBuilder {}
    sb.append(name)
    for a in args {
        sb.append(sep)
        sb.append(display_any_arg(a))
    }
    return "${sb}"
}

joined_unnamed :: fn(args: Type[], sep: string) -> string {
    sb :: StringBuilder {}
    first := true
    for a in args {
        if !first { sb.append(sep) }
        first = false
        sb.append(display_any_arg(a))
    }
    return "${sb}"
}

build_any_args_list :: fn(args: Type[]) -> Type[] {
    out: Type[]: []
    for a in args { out.push(any_leaves_of(a)) }
    return out
}

// MIXED counterpart of `build_any_args_list` : keep every arg `kept_argument`
// keeps, collapse every other one to `Any` (via `keep_concrete_or_erase`). This is the
// single per-arg erasure kernel shared by the vtable-receiver self
// (`materialize_impl_for_instance`) and the box runtime tag (`erase_generic_struct_tag`)
// — the two MUST agree arg-for-arg or a generic-struct box `vtable miss`es, so the
// formula lives here once, not copied at each site.
build_mixed_args_list :: fn(impls: ImplRegistry, args: Type[]) -> Type[] {
    out: Type[]: []
    for a in args { out.push(keep_concrete_or_erase(impls, a)) }
    return out
}

join_any_displays :: fn(args: Type[]) -> string {
    sb :: StringBuilder {}
    first := true
    for a in args {
        if !first { sb.append("__") }
        first = false
        sb.append(display_any_arg(a))
    }
    return "${sb}"
}


// Merge `extra`'s type-param bindings over `base` (extra wins on a key clash).
// Used to thread a generic struct instance's type-args into the subst when
// lowering its field DEFAULTS in the owner module's view — `base` is the caller's
// subst, `extra` binds the struct's own type-params (`K` / `V`) to the concrete
// instance args. Without this an `ekeys: K[] = []` default lowers as the owner's
// erased `Any[]` (boxed) while the construction is monomorphised raw.
merge_subst :: fn(base: Substitution, extra: Substitution) -> Substitution {
    out :: new_substitution()
    out.self_type = base.self_type
    for [k, v] in base.type_params { out.type_params[k] = v }
    for [k, v] in extra.type_params { out.type_params[k] = v }
    return out
}

resolve_field_type :: fn(
    ty: TypeExpr, owner_typed: TypedProgram, sd: StructDecl, args: Type[],
) -> Type {
    // Prefer the typer's recorded type ; fall back to `type_from_expr`
    // resolving fresh against the struct's typeParam-shadowed scope.
    raw :: owner_typed.type_expr_types[ty.span.hash()]
    if !(raw is null) {
        // `raw is Type as t` would always be false — `Type` is the union
        // alias and the runtime tag carries the concrete variant, not the
        // alias. After the null check, `raw` already narrows to `Type`.
        if !(raw is UnresolvedType) { return raw }
    }
    scratch: Diagnostic[]: []
    return type_from_expr(ty, owner_typed.resolved, scratch)
}

// Each of `entry`'s type parameters bound to what it takes on the instance whose
// arguments are `args`.
build_impl_subst :: fn(entry: ImplEntry, args: Type[]) -> Substitution =
    substitution_of(impl_param_bindings(entry, args))

// The type each of `entry`'s type parameters takes on the instance whose arguments
// are `args` : a parameter binds to its own argument at whatever position or depth
// the impl writes it (`Pair<B, A> implements<A, B>`, `Wrapper<T[]> implements<T>`).
impl_param_bindings :: fn(entry: ImplEntry, args: Type[]) -> MutableMap<i32, Type> {
    written :: entry.for_type
    if written is StructType {
        return impl_bindings_at(entry, mk_struct(written.symbol, args))
    }
    if written is ArrayType && args.len() == 1 {
        return impl_bindings_at(entry, mk_array(args[0]))
    }
    return MutableMap<i32, Type> {}
}

/// Variant of `build_impl_subst` keeping the type args `kept_argument` keeps and
/// erasing every other one to `Any` (see `keep_concrete_or_erase`). Every type
/// parameter of a generic impl is mapped, so the substitution is empty exactly
/// when the impl is concrete (`impl_is_generic`).
build_impl_mixed_subst :: fn(
    impls: ImplRegistry, entry: ImplEntry, impl_typed: TypedProgram, args: Type[],
) -> Substitution {
    bindings :: impl_param_bindings(entry, args)
    kept :: MutableMap<i32, Type> {}
    for tp in impl_type_params_of(entry.decl, impl_typed.resolved) {
        id :: tp.symbol.id
        kept[id] = impls.kept_argument(bindings[id] ?? TY_ANY) ?? TY_ANY
    }
    return substitution_of(kept)
}

/// Erase a type arg for the impl-member self-type, but KEEP what `kept_argument`
/// keeps.
keep_concrete_or_erase :: fn(impls: ImplRegistry, t: Type) -> Type =
    impls.kept_argument(t) ?? any_leaves_of(t)

// The type a generic instance keeps for the argument `t`, or null when it erases
// it to `Any` : what `kept_type_argument` keeps, and an argument an impl on one
// instance is built from (`is_specialized_arg`), so that instance gets its own tag
// and reaches its own impl.
kept_argument :: fn(impls: ImplRegistry, t: Type) -> Type | null {
    kept :: kept_type_argument(t)
    if kept != null || !impls.is_specialized_arg(t) {
        return kept
    }
    return t
}

// The suffix segment of a kept type arg. A primitive's name is global ; an enum's
// or a struct's is only unique within its module, so two `Status` enums of
// different modules would otherwise share one instance.
kept_suffix :: fn(kept: Type | null) -> string {
    if kept is EnumType {
        return module_qualified_name(kept.symbol)
    }
    if kept is StructType && kept.args.is_empty() {
        return module_qualified_name(kept.symbol)
    }
    return if kept == null { "Any" } else { mangle_type_arg(kept) }
}

// A nominal type's name as an instance suffix carries it, qualified by its module.
module_qualified_name :: fn(sym: Symbol) -> string =
    "${mangle_module_id(sym.module_name)}_${sym.name}"

// True when AT LEAST ONE type arg is one `kept_argument` keeps (the mixed-flavor
// gate, BROAD — incl `string`/`bool`/`char`, matching `mixed_any_suffix` /
// `build_mixed_subst`). Such an instance is monomorphized MIXED : those args
// kept concrete (devirt + primops/atom-eq inline), references erased to `Any`
// (uniform pointer). `Any` is `AnyType`, not `PrimitiveType`, so an all-erased
// transitive arg list (`[Any, Any]`) is correctly EXCLUDED → stays fully erased
// (symbol-id indexed). Subsumes Inc 1's narrow "all type args are raw-flippable
// primitives" gate : an all-primitive arg list satisfies this too, and a mixed
// subst over all-primitive args equals the concrete subst, so Inc 1's instances
// are byte-unchanged.
has_any_kept_arg :: fn(impls: ImplRegistry, type_args: Type[]) -> bool {
    for a in type_args {
        if impls.kept_argument(a) != null { return true }
    }
    return false
}

find_struct_decl_by_name :: fn(decls: Decl[], name: string) -> StructDecl | null {
    for d in decls {
        match d {
            is StructDecl -> { if d.name == name { return d } }
            _ -> {}
        }
    }
    return null
}

args_suffix :: fn(args: Type[]) -> string {
    sb :: StringBuilder {}
    for a in args {
        sb.append("__")
        sb.append(mangle_type_arg(a))
    }
    return sb.to_string()
}

/// Erasure suffix for a GENERIC impl member. KEEPS the type args
/// `kept_argument` keeps (so a primitive-keyed instance devirtualises its trait
/// dispatch — `i32.eq` instead of a `virtual.call` thunk) and flattens every
/// other arg to a bare `__Any`. The flatten avoids the inner-shape leak a structure-preserving
/// `args_suffix(any_leaves_of(...))` would cause — e.g. `MutableMap<Any, Any[]>`
/// → `at__Any__Any__` diverging from a sibling's `at__Any__Any`. All three
/// suffix sites (`materialize_impl_for_instance`, `find_impl_member_for`,
/// `lower_for_in`) MUST call this with the same `args` so each call name
/// reconciles with the single materialised body (the dedupe keys on the suffix).
/// @param impls  the project's impls — they say which arguments are kept.
/// @param args   the impl's concrete type arguments.
/// @return       `"__<type>"` per arg `kept_argument` keeps, `"__Any"` per
///               other arg.
export mixed_any_suffix :: fn(impls: ImplRegistry, args: Type[]) -> string {
    sb :: StringBuilder {}
    for a in args {
        sb.append("__")
        sb.append(kept_suffix(impls.kept_argument(a)))
    }
    return sb.to_string()
}
