// vader/lower/lower_field_default — the value a struct literal takes for a field it
// leaves out.
//
// A default is evaluated at every literal that omits its field, so it is lowered
// there, in place. A default holding a literal of a struct whose own defaults lead
// back to it would then be expanded without end : through a lambda, which is valid
// since the lambda runs later, or through any form the typecheck's T3100 does not
// follow. So the default being expanded is tracked, and a literal that reaches it
// again calls a thunk instead — the default lowered once, per struct instance
// (`default_thunk_name`). Only such a cycle pays for a call.
//
// Thunks are project-global and drained once into the entry module, like
// `concat_N` (`LowerProjectCtx.entry_decls`) : the per-site `synth_decls` window of
// a deduped generic instance is dropped, which would strand a thunk first lowered
// inside it.

module "vader/lower"

import "std/collections"
import "toolchain/ast"
import "vader/resolver/symbol"
import "vader/types"

/// Lower the default of `field` for a literal of the struct instance `st`.
///
/// @param default_ctx  the literal's fn-body context seen from the struct's owning
///                     module (`ctx_in_owning_module`), which the default resolves in.
/// @param st           the struct instance the literal builds.
/// @param field        the omitted field.
/// @param default      `field`'s default.
/// @param field_type   the field's type in `st`.
/// @return             the default lowered in place, or a call to its thunk when the
///                     literal sits inside the expansion of that same default.
lower_field_default :: fn(
    default_ctx: FnLowerCtx, st: StructType, field: StructField, default: Expr, field_type: Type,
) -> LoweredExpr {
    expanding :: default_ctx.project.expanding_defaults
    key :: field.span.hash()
    if !expanding.add(key) {
        thunk :: default_thunk(default_ctx, st, field, default, field_type)
        return mk_lowered_call(thunk.symbol, [], thunk.type, field.span)
    }
    value :: lower_for_slot(default_ctx, default, field_type, field.span)
    expanding.remove(key)
    return value
}

/// A field-default thunk and the type its call returns.
DefaultThunk :: struct {
    symbol: Symbol
    type: Type
}

// `<module>$<Struct>__<args>$default$<field>` : the instance's mangle over the
// arguments its layout keeps, so instances that lower a default alike share one.
default_thunk_name :: fn(project: LowerProjectCtx, st: StructType, field: StructField) -> string {
    args :: build_mixed_args_list(project.impls, st.args)
    instance :: mangle_struct_instance(st.symbol.module_name, st.symbol.name, args)
    return "${instance}\$default\$${field.name}"
}

// The thunk returning the default of `field` for `st`, its body lowered on first
// use. It is cached before that, so the literal inside the body that reaches the
// default again calls the thunk ; such a call types as the field's type in the
// owning module, every later one as the lowered value.
default_thunk :: fn(
    default_ctx: FnLowerCtx, st: StructType, field: StructField, default: Expr, field_type: Type,
) -> DefaultThunk {
    project :: default_ctx.project
    name :: default_thunk_name(project, st, field)
    cached :: project.default_thunks[name]
    if cached != null {
        return cached
    }
    symbol :: synth_entry_symbol(default_ctx, .Fn, name)
    own_type :: literal_field_type(default_ctx, st, field)
    project.default_thunks[name] = DefaultThunk { .symbol = symbol, .type = own_type }
    thunk_ctx :: new_fn_lower_ctx(
        project,
        synth_mono_entry(default_ctx, symbol),
        default_ctx.typed,
        default_ctx.subst,
        own_type,
    )
    thunk_ctx.blocks.push(new_block_ctx(true, null))
    // The lambdas the body lifts belong with the thunk, not with the window of
    // whatever body first reached it.
    synth :: project.synth_decls
    synth_start :: synth.len()
    value :: lower_for_slot(thunk_ctx, default, field_type, field.span)
    project.entry_decls.push_all(synth[synth_start..<synth.len()])
    for _ in synth_start..<synth.len() {
        synth.remove_last()
    }
    thunk :: DefaultThunk { .symbol = symbol, .type = value.type }
    project.default_thunks[name] = thunk
    project.entry_decls.push(LoweredFnDecl {
        .mangled     = name,
        .params      = [],
        .return_type = thunk.type,
        .body        = LoweredBlock {
            .span = field.span,
            .type = thunk.type,
            .stmts = [],
            .trailing = value,
        },
        .origin      = thunk_ctx.entry,
    })
    return thunk
}
