// vader/lower/iter_fusion: stream-fusion of lazy iterator chains.
//
// Turns `for x in (0..<n).map(f).filter(p)` into a single flat counter loop (no
// iterator struct, no `next()`, no step pair). The entry `try_lower_chain_fusion`
// is called first from `lower_for_in`; a `null` result falls through to the other
// fast paths. Shared loop-building helpers (`bind_loop_var`, `cmp_op_for_inclusive`,
// `is_integer_type`, `resolve_loop_binding`) stay in `for_in.vader`: same
// `module "vader/lower"`, so callable with no import.

module "vader/lower"

import "std/abort"
import "vader/support/diagnostics"
AST :: import "toolchain/ast"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/typecheck"
import "toolchain/span"
import "vader/lower/ir"

// ---- chain fusion ---------------------------------------------------------

// One layer of a fusible iterator chain. The bottoms are `Range` (an
// integer-typed `RangeExpr`), `Array` (a bare array or `arr.into()`),
// `GenSource` (a generator call whose body is inlined) and `OpaqueIter` (a
// concrete iterator struct) ;
// a `Generator` layer wraps a `source` layer with an inlined `generator`
// combinator body (map / filter / take / skip). Non-int ranges,
// runtime-bound chains, etc fall back to the generic slow path.
IterChainKind :: enum(u8) {
    Range,
    Array,
    Generator,
    // Concrete-iterator bottom (e.g. `chars()` → `StringChars`) driven by a
    // `next()` step-loop: the fallback for a combinator source, or an inlined
    // consumer's argument, that is neither a Range nor an array. Set only via
    // `opaque_iter_bottom`. See `emit_fused_opaque_iter`.
    OpaqueIter,
    // A call to a generator that is not a combinator (`zip(a, b)`, a user
    // generator), or a `for` iterable whose `into` is a generator: its whole body
    // is inlined at the bottom of the chain. See `try_descend_gen_source`,
    // `try_descend_into_gen_source` and `emit_fused_gen_source`.
    GenSource,
}

IterChain :: struct {
    kind:         IterChainKind
    // Range bottom
    range_lower:  AST.Expr | null
    range_upper:  AST.Expr | null
    inclusive:    bool
    element_type: Type
    // Array bottom: the concrete source array. Defaulted so the
    // Range/Generator literals need no update.
    array_expr:   AST.Expr | null = null
    // True when this Array bottom is a BARE array (`arr.map(f)`'s implicit head),
    // vs an explicit `arr.into()` cursor. A top-level bare Array is
    // declined by `try_lower_chain_fusion` so a plain `for x in arr` keeps the
    // raw-array fast path ; only a combinator chain over it fuses.
    implicit_head: bool = false
    // Combinator layer: the source chain this layer sits on top of.
    source:       IterChain | null
    // Generator combinator layer: the inlined `generator` body (map / filter /
    // take / skip, all `generator`). Defaulted ; see `generator_fusion.vader`.
    gen_layer:    GenComboLayer | null = null
    // GenSource bottom: the generator call whose body is inlined.
    gen_source:   GenSourceCall | null = null
    // OpaqueIter bottom: a concrete iterator struct, stepped through its own
    // `next()`. Defaulted ; set only by `mk_opaque_iter_chain`.
    iter_expr:    AST.Expr | null = null
    span:         Span
    // The operands the loops read, each evaluated once ahead of them by
    // `bind_chain_operands` : a Range's bounds, an Array's source array, an
    // OpaqueIter's iterator. Null until then: the AST fields above are what
    // the binding lowers, these are what the emitters use.
    bound_lower:  LoweredExpr | null = null
    bound_upper:  LoweredExpr | null = null
    bound_source: LoweredExpr | null = null
}

// Build an `OpaqueIter` chain bottom over a concrete iterator struct, stepped
// through its own `next()` (see `emit_fused_opaque_iter`).
mk_opaque_iter_chain :: fn(iter_expr: AST.Expr, elem: Type, span: Span) -> IterChain = IterChain {
    .kind = .OpaqueIter,
    .range_lower = null, .range_upper = null, .inclusive = false,
    .element_type = elem, .iter_expr = iter_expr,
    .source = null, .span = span,
}

// Build a `Generator` chain layer over `source`: the inlined `generator`
// combinator body carried in `gen_layer` (see `generator_fusion.vader`).
mk_generator_chain :: fn(source: IterChain, gen_layer: GenComboLayer, span: Span) -> IterChain = IterChain {
    .kind = .Generator,
    .range_lower = null, .range_upper = null, .inclusive = false,
    .element_type = TY_UNRESOLVED,
    .source = source, .gen_layer = gen_layer, .span = span,
}

// Top-level entry: recognise `for x in <chain>` and emit the fused
// loop. Returns null whenever the chain doesn't match a fusible shape
// (`generator` combinators over a range, an array or a generator source).
try_lower_chain_fusion :: fn(
    ctx: FnLowerCtx, for_stmt: AST.ForStmt, in_form: AST.InFor,
) -> LoweredStmt | null {
    // The loop over an inlined consumer's parameter drains the call's chain,
    // whose operands the call site bound.
    consumed :: consumed_chain(ctx, in_form.iter)
    found :: if consumed != null { consumed } else { descend_chain(ctx, in_form.iter, false) }
    chain :: found ?? return null
    if consumed == null {
        // Bare ranges already hit the int-range fast path ; bypassing would lose
        // `default_if_free` + counter-name fidelity. A bare array keeps the
        // raw-array fast path: the array bottom is only meant as a source.
        if chain.kind == .Range || (chain.kind == .Array && chain.implicit_head) {
            return null
        }
    }
    lb :: resolve_loop_binding(ctx, in_form.loop_var, for_stmt.span)
    ctx.jump_frames.push(chain_jump_frame(for_stmt.id, chain))
    body :: lower_block(ctx, for_stmt.body, false, for_stmt.id)
    frame :: pop_jump_frame(ctx)
    user_body :: resumable_body(frame, body)
    body_template :: BodyTemplate {
        .binding_name   = lb.name,
        .binding_symbol = lb.symbol,
        .element_type   = fused_loop_element_type(ctx, in_form.loop_var, for_stmt.span, chain),
        .user_body      = user_body,
        .pattern        = lb.pattern,
    }
    stmts: LoweredStmt[]: []
    bound :: consumed ?? bind_chain_operands(ctx, chain, stmts)
    emitted :: emit_fused_chain(ctx, bound, for_stmt.span, body_template)
    stmts.push_all(exit_block(frame, for_stmt.span, emitted))
    return LoweredExprStmt {
        .span = for_stmt.span,
        .expr = mk_void_block(stmts, for_stmt.span),
    }
}

// The fused loop variable's element type. Prefer the typer's CONCRETE loop-var
// type over the chain's fused `output_elem`. `concrete_local_type` reads the same
// slot the un-fused `resolve_element_type` does, and answers null for the cases
// the fused element covers better: destructuring, an unresolved binding, and a
// generic body whose `T` no instance substitution has bound.
fused_loop_element_type :: fn(ctx: FnLowerCtx, loop_var: AST.LoopVar, span: Span, chain: IterChain) -> Type =
    concrete_local_type(ctx.types, loop_var_type_key(loop_var, span)) ?? chain_element_type(chain)

BodyTemplate :: struct {
    binding_name:   string
    binding_symbol: Symbol
    element_type:   Type
    user_body:      LoweredBlock
    /// Destructuring loop var (`for [k, v] in <chain>`). Set only on the
    /// user-facing template built from the `InFor` ; the intermediate combinator
    /// stages bind a fresh single element, so they leave it null.
    pattern:        AST.LetBinding | null = null
}

// A concrete `Iterator` struct used as a COMBINATOR SOURCE that isn't a Range or
// array bottom, e.g. `chars()` → `StringChars` under `.filter(p)`. Iterate it
// via its own `next()` (a static call for a concrete struct, see
// `build_step_call`), so the combinator + terminal fuse over it instead of
// declining. Excludes `generator` state structs (`$genstate_*`): a combinator
// over one fuses through ITS source instead (`try_descend_gen_combinator`), and
// stepping the state itself would keep the state machine fusion removes. Returns
// null for non-iterator structs / non-structs.
opaque_iter_bottom :: fn(ctx: FnLowerCtx, expr: AST.Expr) -> IterChain | null {
    t :: ctx.types.expr_type(expr)
    if !(t is StructType) { return null }
    if is_gen_state_struct(t) { return null }
    if !struct_implements_trait(t, core_trait_key(TRAIT_ITERATOR), ctx.typed) { return null }
    elem :: opaque_iter_element(ctx, t) ?? return null
    return mk_opaque_iter_chain(expr, elem, expr.span)
}

// The element type of a concrete iterator struct, by the typecheck's own rule
// (`for_in_element`) ; null when it yields nothing the tables know.
opaque_iter_element :: fn(ctx: FnLowerCtx, t: Type) -> Type | null {
    element :: iterated_element(t, ctx.typed)
    if element is UnresolvedType {
        return null
    }
    return element
}

// Descend a fusible iterator chain. `as_source` is true when `expr` sits UNDER a
// combinator (its source) : a concrete-iterator bottom that isn't a Range/array
// (`chars()`) then fuses via `opaque_iter_bottom`, as does the argument of an
// inlined consumer. A top-level `for` (`as_source = false`) keeps that fallback
// off: a bare concrete iterator there takes the for-in step loop.
descend_chain :: fn(ctx: FnLowerCtx, expr: AST.Expr, as_source: bool) -> IterChain | null {
    concrete :: descend_chain_concrete(ctx, expr)
    if concrete != null { return concrete }
    if as_source { return opaque_iter_bottom(ctx, expr) }
    return null
}

descend_chain_concrete :: fn(ctx: FnLowerCtx, expr: AST.Expr) -> IterChain | null {
    // @partial: a Range and a call (combinator or generator) have their own
    // arms; every other Expr is read by `expression_bottom`.
    @partial match expr {
        is AST.RangeExpr -> {
            bound :: ctx.types.expr_type(expr.lower)
            if !is_counting_type(bound) { return null }
            element :: default_if_free(bound)
            return IterChain {
                .kind = .Range,
                .range_lower = expr.lower,
                .range_upper = expr.upper,
                .inclusive = expr.inclusive,
                .element_type = element,
                .source = null, .span = expr.span,
            }
        }
        is AST.CallExpr -> {
            // An array-headed chain: fuse over `arr` directly rather than
            // through whatever the coercion would materialise.
            arr_bottom :: descend_array_call(ctx, expr)
            if arr_bottom != null { return arr_bottom }
            // Generator combinator (`generator` whose first param is the source
            // iterator): recognised by callee. map / filter / take / skip all
            // lower through here now the hand-written *Iterator structs are gone.
            combinator :: try_descend_gen_combinator(ctx, expr)
            if combinator != null {
                return combinator
            }
            // Any other generator call : its body inlined as the source.
            gen_source :: try_descend_gen_source(ctx, expr)
            if gen_source != null {
                return gen_source
            }
            // Any other call is a source like any expression : `f().map(g)`.
            return expression_bottom(ctx, expr)
        }
        _ -> { return expression_bottom(ctx, expr) }
    }
}

// Any other expression as a chain source: a bare array, or a `for` iterable whose
// `into` is a generator.
expression_bottom :: fn(ctx: FnLowerCtx, expr: AST.Expr) -> IterChain | null {
    array :: bare_array_bottom(ctx, expr)
    if array != null {
        return array
    }
    return try_descend_into_gen_source(ctx, expr, expr.span)
}

// A BARE array-typed expr heading a lazy chain (`arr.map(f)`: the implicit array
// head : no explicit `.into()` cursor), or null when `expr` is not an array. Any
// array-typed expr is a fusible `Array` bottom. Reached via a combinator's source
// recursion ; a bare `for x in arr` is declined at the top by
// `try_lower_chain_fusion` so it keeps the raw-array fast path.
bare_array_bottom :: fn(ctx: FnLowerCtx, expr: AST.Expr) -> IterChain | null {
    bare :: ctx.types.expr_type(expr)
    if bare is ArrayType {
        if converts_through_own_into(ctx, bare, expr) {
            return null
        }
        return mk_array_chain(expr, bare.element, expr.span, true)
    }
    return null
}

// True when the array `expr` reaches its `Iterator` slot through the `into` of an
// impl on its own instance (`MonType[] implements Into<Iterator<MonType>>`), as
// the typecheck recorded it : iterating the raw array would skip it.
converts_through_own_into :: fn(ctx: FnLowerCtx, array: Type, expr: AST.Expr) -> bool {
    into :: recorded_callee(ctx, expr, .Into)
    if into !is DirectFn {
        return false
    }
    entry :: recorded_impl(ctx, into, array) ?? return false
    return entry.instance
}

// The receiver (chain source) + transform/predicate arg of a fluent
// combinator call. The caller checks the call's return type to decide
// whether it's a `map` or a `filter`.
FluentCombinator :: struct {
    receiver: AST.Expr
    /// The combinator's single non-self argument (map's `f`, take's `n`), or
    /// null for a 0-arg combinator whose only input is the source (`indexed`).
    fn_arg:   AST.Expr | null
}

// Recognise the fluent `it.map(f)` / `it.indexed()` (UFCS) and the direct
// `map(it, f)` / `indexed(it)` shapes. Returns the receiver + optional fn arg
// (null for a 0-arg combinator), or null when the call isn't a fusible combinator.
unpack_fluent_combinator :: fn(ctx: FnLowerCtx, call: AST.CallExpr) -> FluentCombinator | null {
    callee :: call.callee
    // @partial: only a FieldExpr (UFCS) or IdentExpr (direct call) callee can be
    // a fusible combinator; every other Expr callee → null.
    @partial match callee {
        // UFCS form `it.map(f)` / `it.indexed()` : the FieldExpr resolved as a
        // free-fn UFCS dispatch (the typer stashed the receiver type under its id).
        // The callee's target is the receiver ; the first arg (if any) is the transform.
        is AST.FieldExpr -> {
            recv_ty :: ctx.typed.ufcs_receiver_types[callee.id] ?? return null
            fn_arg :: if call.args.len() > 0 { call.args[0].value } else { null }
            return FluentCombinator { .receiver = callee.target, .fn_arg = fn_arg }
        }
        // Direct-call form `map(it, f)` [2 args] or `indexed(it)` [1 arg] :
        // first arg is the receiver, the second (if any) is the transform / predicate.
        is AST.IdentExpr -> {
            if call.args.len() == 0 { return null }
            fn_arg :: if call.args.len() > 1 { call.args[1].value } else { null }
            return FluentCombinator { .receiver = call.args[0].value, .fn_arg = fn_arg }
        }
        _ -> { return null }
    }
}

// Build an `Array` chain bottom over `arr_expr`. `implicit` marks a bare-array
// head (`arr.map(f)`) vs an explicit `.into()` cursor, see the field
// on `IterChain`.
mk_array_chain :: fn(arr_expr: AST.Expr, elem: Type, span: Span, implicit: bool) -> IterChain = IterChain {
    .kind = .Array,
    .range_lower = null, .range_upper = null, .inclusive = false,
    .element_type = elem, .array_expr = arr_expr, .implicit_head = implicit,
    .source = null, .span = span,
}

descend_array_call :: fn(ctx: FnLowerCtx, call: AST.CallExpr) -> IterChain | null {
    // `arr.into()`: an erased `Iterator<T>` head over a statically-array
    // receiver. The result type is the trait, but the receiver is an array, so
    // fuse over the raw array: `arr.into().map(f).collect()` becomes a flat loop
    // instead of materialising an iterator.
    into_arr :: array_from_into_call(ctx, call)
    if into_arr != null {
        arr_ty :: ctx.types.expr_type(into_arr)
        // `arr.into()` resolves by name, to the `into` of an impl on the array's own
        // instance when there is one : iterating the raw array would skip it.
        if has_instance_impl(arr_ty, core_trait_key(TRAIT_INTO), ctx.typed) {
            return null
        }
        elem :: if arr_ty is ArrayType { arr_ty.element } else { TY_UNRESOLVED }
        return mk_array_chain(into_arr, elem, call.span, false)
    }
    return null
}

// The source array of an `arr.into()` (UFCS) / `into(arr)` (direct) call whose
// receiver is statically an array: else null (a non-array `.into()` head, e.g.
// `set.into()`, is not a fusible array bottom).
array_from_into_call :: fn(ctx: FnLowerCtx, call: AST.CallExpr) -> AST.Expr | null {
    // @partial: only a method or a free call names `into` ; any other callee is not
    // an array head.
    @partial match fe :: call.callee {
        is AST.FieldExpr -> {
            if fe.field != METHOD_INTO { return null }
            if ctx.types.expr_type(fe.target) is ArrayType { return fe.target }
            return null
        }
        is AST.IdentExpr -> {
            if fe.name != METHOD_INTO { return null }
            if call.args.len() != 1 { return null }
            arg :: call.args[0].value
            if ctx.types.expr_type(arg) is ArrayType { return arg }
            return null
        }
        _                -> { return null }
    }
}

chain_element_type :: fn(chain: IterChain) -> Type = match chain.kind {
    .Range | .Array | .OpaqueIter | .GenSource -> chain.element_type
    .Generator -> if chain.gen_layer is GenComboLayer { chain.gen_layer.output_elem } else { TY_UNRESOLVED }
}

// ---- operands -------------------------------------------------------------
//
// A fused chain evaluates its operands exactly as the lazy chain would when
// built : each once, in source order, before the first element. The binding
// runs as its own pass ahead of the loops because the loops nest the other way
// round: the outermost layer wraps its source's loop, so an operand lowered
// where its loop is emitted would run per element, or ahead of its source.

// Evaluate every operand of `chain` once, into `out`, or into the sink when a
// later operand awaits (`lower_after_prelude`) : a source's operands before the
// layer built on it, a layer's source before its argument. Returns the chain
// with the values its loops read in `bound_*`: `emit_fused_chain` reads those.
bind_chain_operands :: fn(
    ctx: FnLowerCtx, chain: IterChain, out: LoweredStmt[],
) -> IterChain = match chain.kind {
    .Range      -> bind_range_operands(ctx, chain, out)
    .Array      -> bind_array_operand(ctx, chain, out)
    .Generator  -> bind_layer_operands(ctx, chain, out)
    .OpaqueIter -> bind_opaque_iter_operand(ctx, chain, out)
    .GenSource  -> bind_gen_source_operands(ctx, chain, out)
}

// A loop body may run before either bound is read : `hi` is read at every step,
// and a range that is `chain`'s second source starts after the first one's loop.
bind_range_operands :: fn(ctx: FnLowerCtx, chain: IterChain, out: LoweredStmt[]) -> IterChain {
    lower :: chain.range_lower ?? return chain
    upper :: chain.range_upper ?? return chain
    lo_value :: lower_after_prelude(ctx, lower, out)
    lo :: bind_unless_invariant(ctx, lo_value, "fuse_lo", chain.span, out)
    hi_value :: lower_after_prelude(ctx, upper, out)
    hi :: bind_unless_invariant(ctx, hi_value, "fuse_hi", chain.span, out)
    return IterChain { ...chain, .bound_lower = lo, .bound_upper = hi }
}

// Always bound to a fresh `fuse_arr`, invariant or not: the local the loop reads
// its length and every element from.
bind_array_operand :: fn(ctx: FnLowerCtx, chain: IterChain, out: LoweredStmt[]) -> IterChain {
    src :: chain.array_expr ?? return chain
    arr :: lower_after_prelude(ctx, src, out)
    bound :: bind_to_local(ctx, arr, arr.type, "fuse_arr", chain.span, out)
    return IterChain { ...chain, .bound_source = bound }
}

// The iterator is the loop's cursor, so it always gets a local of its own.
bind_opaque_iter_operand :: fn(ctx: FnLowerCtx, chain: IterChain, out: LoweredStmt[]) -> IterChain {
    src :: chain.iter_expr ?? return chain
    iter :: lower_after_prelude(ctx, src, out)
    bound :: bind_to_local(ctx, iter, iter.type, "fuse_iter", chain.span, out)
    return IterChain { ...chain, .bound_source = bound }
}

// A layer's source, then each extra source (`chain`'s `other`), then its data
// argument: prepared for its parameter's slot as a call would, and bound to the
// combinator's own param symbol, which its inlined body reads.
bind_layer_operands :: fn(ctx: FnLowerCtx, chain: IterChain, out: LoweredStmt[]) -> IterChain {
    src :: chain.source ?? return chain
    layer :: chain.gen_layer ?? return chain
    source :: bind_chain_operands(ctx, src, out)
    extra_sources: GenSourceBinding[]: []
    for extra in layer.extra_sources {
        extra_source :: bind_chain_operands(ctx, extra.source, out)
        extra_sources.push(GenSourceBinding { ...extra, .source = extra_source })
    }
    arg_expr :: layer.arg_expr
    arg_sym :: layer.arg_sym
    arg_slot :: layer.arg_slot
    if arg_expr != null && arg_sym != null && arg_slot != null {
        lowered :: lower_after_prelude(ctx, arg_expr, out)
        arg :: prepare_into(ctx, arg_expr, lowered, arg_slot, chain.span)
        out.push(cell_aware_let(ctx, arg_sym, arg_sym.name, arg, arg_slot, chain.span))
    }
    return IterChain {
        ...chain,
        .source = source,
        .gen_layer = GenComboLayer { ...layer, .extra_sources = extra_sources },
    }
}

// ---- loops ----------------------------------------------------------------

// An emitter reached with a chain `bind_chain_operands` did not return: a loop
// with no operand to read, which would otherwise iterate nothing, silently.
UNBOUND_CHAIN :: "fused chain emitted before `bind_chain_operands` bound its operands"

// Emit the fused chain recursively over a chain `bind_chain_operands` returned.
// The Range / Array bottoms expand into a counter loop ; a Generator layer
// inlines its `generator` body over its source (map / filter / take / skip all
// lower through here).
emit_fused_chain :: fn(
    ctx: FnLowerCtx, chain: IterChain, outer_span: Span,
    template: BodyTemplate,
) -> LoweredStmt[] = match chain.kind {
    .Range      -> emit_fused_range(ctx, chain, outer_span, template)
    .Array      -> emit_fused_array(ctx, chain, outer_span, template)
    .Generator  -> emit_fused_gen_combinator(ctx, chain, outer_span, template)
    .OpaqueIter -> emit_fused_opaque_iter(ctx, chain, outer_span, template)
    .GenSource  -> emit_fused_gen_source(ctx, chain, template)
}

// Emit the fused loop at an `OpaqueIter` bottom : a `next()` step-loop over the
// concrete iterator (a static call) structurally the un-fused for-in shape
// (`lower_for_in`) but running the chain's template. A `break` in the template
// exits the loop ; `continue` is naturally step-safe (the next iteration
// re-pulls `next()`).
emit_fused_opaque_iter :: fn(
    ctx: FnLowerCtx, chain: IterChain, outer_span: Span,
    template: BodyTemplate,
) -> LoweredStmt[] {
    span :: chain.span
    iter_ref :: chain.bound_source ?? panic(UNBOUND_CHAIN)
    element_type :: chain.element_type

    shape :: resolve_step_shape(ctx, element_type) ?? return []
    step_type :: shape.type

    step_symbol :: fresh_synthetic_symbol(ctx, "fuse_step")
    step_call :: build_step_call(ctx, null, iter_ref, iter_ref.type, step_type, span)
    step_let :: LoweredLet {
        .span = span, .name = step_symbol.name, .symbol = step_symbol,
        .type = step_type, .value = step_call,
    }
    step_ref :: LoweredIdent { .span = span, .type = step_type, .symbol = step_symbol }
    is_done :: step_is_done(shape, step_ref, span, ctx)
    value_access :: step_value(shape, step_ref, span)
    bind_stmts :: bind_loop_var(ctx, template.binding_symbol, template.binding_name, template.pattern, value_access, element_type, span)

    body_stmts: LoweredStmt[]: []
    body_stmts.push_all(bind_stmts)
    for s in template.user_body.stmts { body_stmts.push(s) }
    if template.user_body.trailing != null {
        body_stmts.push(LoweredExprStmt { .span = span, .expr = template.user_body.trailing })
    }

    branch_if :: LoweredExprStmt {
        .span = span,
        .expr = LoweredIf {
            .span = span, .type = TY_VOID, .cond = is_done,
            .then_block = mk_void_block(build_break_stmts(span), span),
            .else_block = mk_void_block(body_stmts, span),
        },
    }

    loop_stmt :: LoweredLoop {
        .span = outer_span, .label = null, .cond = null,
        .body = mk_void_block([step_let, branch_if], span),
        .step = [],
    }
    out: LoweredStmt[]: [loop_stmt]
    return out
}

// Emit the counter loop at the Range bottom. The user binding is
// re-cast under the surface name so the body sees the same symbol
// the resolver bound.
emit_fused_range :: fn(
    ctx: FnLowerCtx, range_chain: IterChain, outer_span: Span,
    template: BodyTemplate,
) -> LoweredStmt[] {
    span :: range_chain.span
    int_type :: range_chain.element_type
    lo :: range_chain.bound_lower ?? panic(UNBOUND_CHAIN)
    hi :: range_chain.bound_upper ?? panic(UNBOUND_CHAIN)

    // The counter runs on the loop variable itself : nothing but the loop rebinds
    // it (T3041).
    counter_init :: LoweredLet {
        .span = span,
        .name = template.binding_name,
        .symbol = template.binding_symbol,
        .type = int_type,
        .value = lo,
    }
    counter_ref :: LoweredIdent {
        .span = span,
        .type = int_type,
        .symbol = template.binding_symbol,
    }
    out: LoweredStmt[]: [counter_init]
    inclusive :: range_chain.inclusive
    control :: range_loop_control(ctx, counter_ref, hi, inclusive, span, out)
    hops :: is_char(int_type)
        && walk_may_cross_surrogates(range_chain.range_lower, range_chain.range_upper)
    loop_stmt :: LoweredLoop {
        .span = outer_span,
        .label = null,
        .cond = control.cond,
        .body = hopping_body(template.user_body, counter_ref, hi, inclusive, hops, span),
        .step = control.step,
    }
    // A hop over the surrogates leaves 2048 values uncounted.
    if !hops {
        loop_stmt.turns = LoopTurns {
            .counter = template.binding_symbol,
            .start = lo,
            .bound = hi,
            .inclusive = inclusive,
        }
    }
    out.push(loop_stmt)
    return out
}

// Emit the fused loop at an `Array` bottom: a direct index loop
// over the concrete source array: no iterator object, no `next()`, no step pair.
// The body is `template.user_body` (already map/filter-wrapped by the recursion),
// with the array element bound to the chain's source binding. `continue` is made
// increment-safe exactly like the non-fused raw-array path.
emit_fused_array :: fn(
    ctx: FnLowerCtx, array_chain: IterChain, outer_span: Span,
    template: BodyTemplate,
) -> LoweredStmt[] {
    span :: array_chain.span
    elem_type :: array_chain.element_type
    arr_ref :: array_chain.bound_source ?? panic(UNBOUND_CHAIN)

    len_sym :: fresh_synthetic_symbol(ctx, "fuse_len")
    idx_sym :: fresh_synthetic_symbol(ctx, "fuse_i")

    len_let :: LoweredLet {
        .span = span, .name = len_sym.name, .symbol = len_sym, .type = TY_I64,
        .value = LoweredArrayLen { .span = span, .type = TY_I64, .target = arr_ref },
    }
    idx_init :: LoweredLet {
        .span = span, .name = idx_sym.name, .symbol = idx_sym, .type = TY_I64,
        .value = LoweredIntLit { .span = span, .type = TY_I64, .value = 0 },
    }
    idx_ref :: LoweredIdent { .span = span, .type = TY_I64, .symbol = idx_sym }
    len_ref :: LoweredIdent { .span = span, .type = TY_I64, .symbol = len_sym }

    cond :: LoweredBinary {
        .span = span, .type = TY_BOOL, .op = .Lt, .left = idx_ref, .right = len_ref,
    }
    elem_access :: LoweredIndex {
        .span = span, .type = elem_type, .target = arr_ref, .index = idx_ref,
    }
    bind_stmts :: bind_loop_var(ctx, template.binding_symbol, template.binding_name, template.pattern, elem_access, elem_type, span)
    inc_stmt :: LoweredAssign {
        .span = span, .target = idx_ref,
        .value = mk_i64_plus_one(idx_ref, span),
    }

    loop_stmt :: LoweredLoop {
        .span = outer_span, .label = null, .cond = cond,
        .body = prepend_stmts_to_block(bind_stmts, template.user_body),
        .step = [inc_stmt],
        .turns = LoopTurns {
            .counter = idx_sym,
            .start = idx_init.value,
            .bound = len_ref,
            .inclusive = false,
        },
    }

    out: LoweredStmt[]: []
    out.push(len_let)
    out.push(idx_init)
    out.push(loop_stmt)
    return out
}
