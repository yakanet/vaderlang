// vader/lower/method_value: a member taken as a value on its receiver.
//
// `g :: p.label` names no function : it takes `label` with `p` bound. The value is
// a closure whose env holds the receiver, evaluated once where the value is taken,
// and whose lifted fn takes the member's other parameters and makes the call the
// typecheck recorded at the field access (`.MethodValue`). The receiver's
// conversion toward a free fn's first parameter (an array reaching an `Iterator`)
// runs in that call, so each call starts afresh.
// docs/adr/0103-a-method-taken-as-a-value-closes-over-its-receiver.md

module "vader/lower"

import "toolchain/ast"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/typecheck"

/// The env field holding the receiver.
RECEIVER_FIELD :: "receiver"

/// The closure the method value `e` makes ; null when the typecheck recorded none
/// at `e`.
///
/// @param e     the field access taking the value.
/// @param type  its type : the member's signature without its receiver.
/// @return      a closure over the receiver.
try_lower_method_value :: fn(ctx: FnLowerCtx, e: FieldExpr, type: FnType) -> LoweredExpr | null {
    callee :: recorded_callee(ctx, e, .MethodValue) ?? return null
    receiver :: lower_expr(ctx, e.target)
    lifted :: fresh_method_symbol(ctx, false)
    env :: fresh_method_symbol(ctx, true)
    env_type :: mk_struct(env, [])
    env_param :: synth_env_param_symbol(ctx)
    params: LoweredParam[]: [
        LoweredParam { .name = env_param.name, .symbol = env_param, .type = env_type },
    ]
    args: LoweredExpr[]: []
    for param_type in type.params {
        symbol :: fresh_synthetic_symbol(ctx, "arg")
        params.push(LoweredParam { .name = symbol.name, .symbol = symbol, .type = param_type })
        args.push(LoweredIdent { .span = e.span, .type = param_type, .symbol = symbol })
    }
    held :: LoweredFieldAccess {
        .span = e.span,
        .type = receiver.type,
        .target = LoweredIdent { .span = e.span, .type = env_type, .symbol = env_param },
        .field = RECEIVER_FIELD,
    }
    made :: method_call(ctx, e, callee, held, args, type.return_type)
    call :: observed(ctx, e, .MethodValue, made)
    ctx.project.synth_decls.push(
        LoweredStructDecl {
            .mangled = env.name,
            .fields = [LoweredStructField { .name = RECEIVER_FIELD, .type = receiver.type }],
            .origin = synth_mono_entry(ctx, env),
        },
    )
    ctx.project.synth_decls.push(
        LoweredFnDecl {
            .mangled = lifted.name,
            .params = params,
            .return_type = type.return_type,
            .body = LoweredBlock {
                .span = e.span,
                .type = type.return_type,
                .stmts = [],
                .trailing = call,
            },
            .origin = synth_mono_entry(ctx, lifted),
        },
    )
    return LoweredMakeClosure {
        .span = e.span,
        .type = type,
        .fn_symbol = lifted,
        .env = LoweredStructLit {
            .span = e.span,
            .type = env_type,
            .fields = [LoweredStructLitField { .name = RECEIVER_FIELD, .value = receiver }],
        },
    }
}

// The lifted fn of a method value, or its env.
fresh_method_symbol :: fn(ctx: FnLowerCtx, is_env: bool) -> Symbol =
    fresh_lifted_symbol_with_prefix(ctx, is_env, "__method_", "__method_env_")

// The call the closure of `e`, recorded as `callee`, makes on the receiver it holds,
// `held`, with its own parameters, `args` : the one a call `e(args)` would make
// (`method_target`), the receiver of a free fn prepared for its first parameter at
// each call.
method_call :: fn(
    ctx: FnLowerCtx,
    e: FieldExpr,
    callee: Callee,
    held: LoweredExpr,
    args: LoweredExpr[],
    ret: Type,
) -> LoweredExpr {
    target :: method_target(ctx, callee, e, held, args.len())
    if target == null {
        return LoweredUnreachable {
            .span = e.span,
            .type = ret,
            .reason = "no member `${e.field}` for `${display_type(held.type)}`",
        }
    }
    operands: LoweredExpr[]: [held]
    operands.push_all(args)
    if target is FreeFnTarget && target.params.len() > 0 {
        operands[0] = prepare_into(ctx, e.target, held, target.params[0], e.span)
    }
    return build_method_call(ctx, e, .MethodValue, target, e, operands, ret)
}
