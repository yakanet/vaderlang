// vader/lower/binary: binary / unary operators and operator-overload routing.
//

module "vader/lower"

import "std/collections"
import "vader/lower/ir"

import "toolchain/ast"
import "vader/front/typecheck"
import "vader/core/types"
import "vader/support/integer"
import "toolchain/span"

// Peel a narrowing `LoweredCast` off a type-check operand. `lower_ident`
// inserts such a cast (`LoweredCast { value: LoweredIdent : <union> }`) when the
// typed-AST narrowed a union-declared symbol to a variant at the use site. For
// an `is` operand that cast is harmful: the C-emit `ref.cast`-unboxes the union
// to the variant, so the following `type_check` constant-folds. Returning the
// cast's inner union value keeps the runtime tag intact (the narrowing is a
// compile-time view, so the check on the original box is what we want).
strip_narrowing_cast :: fn(e: LoweredExpr) -> LoweredExpr {
    if e is LoweredCast {
        if e.value.type is UnionType { return e.value }
    }
    return e
}

// `!cond` when `negate`, else `cond`.
maybe_negate :: fn(cond: LoweredExpr, negate: bool, span: Span) -> LoweredExpr {
    if negate {
        return LoweredUnary {
            .span = span,
            .type = TY_BOOL,
            .op = .Not,
            .operand = cond,
        }
    }
    return cond
}

// The type a run-time `is` test of a value of `scrutinee` checks : `check` itself,
// unless it is a trait, which the run-time lookup finds through a struct's impls
// alone. The other types the value may hold are resolved here, by the predicate
// the narrowing reads (`trait_test_admits`) : `x is Equals` on an `i32 | Point`
// checks `i32 | Equals`, the trait test left to the struct. A struct keeps the
// trait test ; an instance of a generic struct could not be told apart by its tag.
// A type still open at run time (a trait value, `any`, a type parameter) may hold a
// struct or a scalar : it keeps the trait test, and the tag of every scalar the
// trait admits is tested too. An admitted array gets its members for the trait's
// vtable, which the branch where the test holds dispatches through
// (`surface_array_into_trait`).
trait_test_type :: fn(ctx: FnLowerCtx, scrutinee: Type, check: Type) -> Type {
    if check !is TraitType {
        return check
    }
    admitted: Type[]: []
    needs_trait_lookup := false
    for variant in union_variants(scrutinee) ?? [scrutinee] {
        if variant is StructType {
            needs_trait_lookup = true
        } else if variant is TraitType | AnyType | TypeParamType {
            needs_trait_lookup = true
            for scalar in held_scalars() {
                if trait_test_admits(scalar, check, ctx.typed) {
                    admitted.push(scalar)
                }
            }
        } else if trait_test_admits(variant, check, ctx.typed) {
            admitted.push(variant)
            surface_array_into_trait(ctx, variant, check)
        }
    }
    if needs_trait_lookup || admitted.len() == 0 {
        admitted.push(check)
    }
    return union_of(admitted)
}

// The scalar types a value held as a trait or as `any` may have : the machine
// integers and every primitive with a value (`void` and `null` hold none).
held_scalars :: fn() -> Type[] {
    scalars: Type[]: []
    for m in MACHINE_INTEGERS {
        scalars.push(machine_integer_type(m))
    }
    for meta in PRIMITIVE_META {
        if meta.size > 0 {
            scalars.push(mk_primitive(meta.name))
        }
    }
    return scalars
}

lower_binary :: fn(ctx: FnLowerCtx, binary: BinaryExpr, type: Type) -> LoweredExpr {
    // `expr is T` lowers to a runtime tag check ; the RHS is a type
    // expression, not a value.
    if binary.op == .Is {
        observe_no_call(ctx, binary, .Operator, "type check")
        // The check must see the operand's FULL (declared union) box so it
        // can compare the runtime tag. When the typed-AST narrowed this use
        // to a variant (`l : LocalId | null` recorded as `LocalId` at the
        // `is null` site), `lower_ident` wraps it in a narrowing `LoweredCast`:
        // the C-emit then `ref.cast`-unboxes to the variant and CONSTANT-
        // FOLDS the tag check (`is null` → `false`). Peel that cast so the
        // check runs on the union value (the operand stays at the union
        // type here).
        value :: strip_narrowing_cast(lower_expr(ctx, binary.left))
        return LoweredTypeCheck {
            .span = binary.span,
            .type = TY_BOOL,
            .value = value,
            .check_type = trait_test_type(ctx, value.type, ctx.types.expr_type(binary.right)),
        }
    }
    if binary.op == .In || binary.op == .NotIn {
        // `x in T`, a type on the right : a bounds test, which calls nothing.
        if recorded_callee(ctx, binary, .Operator) is Builtin {
            return lower_in_type(ctx, binary)
        }
        range_lit :: binary.right
        if range_lit is RangeExpr {
            if scalar_backing(ctx.types.expr_type(binary.left)) != null {
                return lower_in_literal_range(ctx, binary, range_lit)
            }
        }
        // `x in coll` → `coll.contains(x)`. `x !in coll` → `!coll.contains(x)`,
        // through the `Contains` member the typecheck recorded ; an array-backed
        // distinct reaches its backing array's.
        coll_type :: ctx.types.expr_type(binary.right)
        // A collection dispatching through `Contains` at run time (a value of the
        // trait, a union of its implementors, an erased bounded `T`) has no impl to
        // call : its tag picks one.
        contains :: recorded_target(ctx, binary, .Operator, coll_type)
        if contains == null {
            observe_no_call(ctx, binary, .Operator, "stub")
            return stub(binary.span, type, "`in` / `not in` lowering deferred")
        }
        observe_contains(ctx, binary, contains)
        // `contains` takes the collection first: `x` is bound ahead of it unless
        // neither can change what the other reads.
        prelude: LoweredStmt[]: []
        element_first :: lower_expr(ctx, binary.left)
        mark :: ctx.pending_awaits.len()
        coll :: lower_expr(ctx, binary.right)
        element_value :: bind_one_before_hoisted(ctx, element_first, mark)
        element :: if reads_independently(element_value, coll) {
            element_value
        } else {
            bind_unless_stable(ctx, element_value, "in_x", binary.span, prelude)
        }
        call :: contains_call(ctx, contains, coll, element, binary.span)
        test :: maybe_negate(call, binary.op == .NotIn, binary.span)
        return with_prelude(prelude, test, binary.span)
    }
    // `<union>` `==` / `!=` `null` reduces to a tag-only `LoweredTypeCheck`.
    // The C/VM emit can't compare two `vader_box_t` directly anyway and
    // the type-check is the operation we actually want.
    if binary.op == .Eq || binary.op == .Neq {
        null_rewrite :: try_lower_null_eq(ctx, binary)
        if null_rewrite != null {
            observe_no_call(ctx, binary, .Operator, "tag test")
            return null_rewrite
        }
        // A tuple or a union has no impl to overload, so it is rewritten here
        // rather than through the trait router. See `value_eq.vader`.
        value_rewrite :: try_lower_value_eq(ctx, binary)
        if value_rewrite != null {
            observe_equality(ctx, binary, value_rewrite)
            return value_rewrite
        }
    }
    // `[lhs] * n`: array repeat / preallocation. A numeric `*` never yields an
    // array, so an array result type uniquely marks this case. Lower to the
    // `array.repeat` intrinsic : args = [source array, count], the count the `i64`
    // the arrays' `Mul` takes. The runtime reuses the source's type / element
    // kind / tag, so no static element type is threaded through. `[] * n` (empty
    // source) reserves n slots, length 0.
    if binary.op == .Mul && type is ArrayType {
        observe_no_call(ctx, binary, .Operator, "array.repeat")
        parts :: lower_in_order(ctx, [binary.left, binary.right])
        return mk_array_repeat(parts[0], parts[1], type, binary.span)
    }
    // Arithmetic + / − / × / ÷ on a user struct with a matching impl
    // (`Vec implements Add { add(self, other) }` etc.) lowers to a
    // direct call `add(a, b)`.
    op_call :: try_lower_op_overload(ctx, binary, type)
    if op_call != null { return op_call }
    // String `+` lowers to a single call to the shared arity-specialised
    // `concat_N` (`concat.vader`). The `+` tree is FLATTENED first :
    // `((a + b) + c)` collects `[a, b, c]` and emits ONE `concat_3`: one Buffer
    // alloc + one intern for the whole chain, instead of nesting a StringBuilder
    // (3 allocs + 1 intern) per `+`. Reached only for the primitive
    // `string + string` case (user-struct `Add` and `T`/`Any` receivers were
    // handled by `try_lower_op_overload` above).
    if binary.op == .Add && is_string_type(type) {
        observe_no_call(ctx, binary, .Operator, "concat")
        operands: LoweredExpr[]: []
        collect_concat_operands(ctx, binary.left, operands)
        collect_concat_operands(ctx, binary.right, operands)
        return lower_concat_chain(ctx, operands, binary.span)
    }
    observe_built_in_operator(ctx, binary)
    if ctx.in_async && (binary.op == .And || binary.op == .Or) {
        // Short-circuit : the RHS runs only when the LHS permits. An `await` in
        // it can't hoist before the statement (would run unconditionally). v1
        // diagnoses (M5009) via `guard_no_pending_await` after lowering the RHS.
        left :: lower_expr(ctx, binary.left)
        rhs_base :: ctx.pending_awaits.len()
        right :: lower_expr(ctx, binary.right)
        guard_no_pending_await(ctx, rhs_base, binary.right.span)
        return LoweredBinary {
            .span = binary.span, .type = type, .op = lower_binary_op(binary.op),
            .left = left, .right = right,
        }
    }
    left :: lower_expr(ctx, binary.left)
    mark :: ctx.pending_awaits.len()
    right :: lower_expr(ctx, binary.right)
    return LoweredBinary {
        .span = binary.span,
        .type = type,
        .op = lower_binary_op(binary.op),
        .left = bind_one_before_hoisted(ctx, left, mark),
        .right = right,
    }
}

// `x in lo..=hi` / `x in lo..<hi` over a literal range, `x` a scalar (a primitive,
// or a distinct over one) : `lo <= x && x <= hi` (or `< hi`) inline, without the
// `Range` heap allocation and `contains` call. The hot cases are the char predicates
// (`c in 'a'..='z'`) and index tests (`i64(i) in 0..<n`). A name is lowered afresh
// for each comparison, a read that does no work ; any other `x` is evaluated once,
// ahead of the bounds, as `contains` takes it, and read from a local. The bounds are
// evaluated once each, `lo` first, as the `Range` would be : an `hi` that does work
// is bound ahead (the `&&` may short-circuit past it), and `lo` then ahead of it.
lower_in_literal_range :: fn(
    ctx: FnLowerCtx,
    binary: BinaryExpr,
    range_lit: RangeExpr,
) -> LoweredExpr {
    observe_no_call(ctx, binary, .Operator, "bounds")
    span :: binary.span
    subject_first :: lowered_unless_name(ctx, binary.left)
    subject_mark :: ctx.pending_awaits.len()
    lo_first :: lower_expr(ctx, range_lit.lower)
    mark :: ctx.pending_awaits.len()
    hi_value :: lower_expr(ctx, range_lit.upper)
    lo_value :: bind_one_before_hoisted(ctx, lo_first, mark)
    bounds: LoweredStmt[]: []
    held :: held_subject(ctx, subject_first, subject_mark, span, bounds)
    hoist :: !is_effect_free_read(hi_value)
    lo :: if hoist {
        bind_unless_stable(ctx, lo_value, "in_lo", span, bounds)
    } else {
        lo_value
    }
    hi :: if hoist {
        bind_to_local(ctx, hi_value, hi_value.type, "in_hi", span, bounds)
    } else {
        hi_value
    }
    cmp_lo :: LoweredBinary {
        .span = span,
        .type = TY_BOOL,
        .op = .Lte,
        .left = lo,
        .right = subject_read(ctx, binary.left, held),
    }
    cmp_hi :: LoweredBinary {
        .span = span,
        .type = TY_BOOL,
        .op = cmp_op_for_inclusive(range_lit.inclusive),
        .left = subject_read(ctx, binary.left, held),
        .right = hi,
    }
    anded :: LoweredBinary {
        .span = span,
        .type = TY_BOOL,
        .op = .And,
        .left = cmp_lo,
        .right = cmp_hi,
    }
    test :: maybe_negate(anded, binary.op == .NotIn, span)
    return with_prelude(bounds, test, span)
}

// `left` lowered, unless it is a name, lowered afresh where it is read.
lowered_unless_name :: fn(ctx: FnLowerCtx, left: Expr) -> LoweredExpr | null {
    if left is IdentExpr {
        return null
    }
    return lower_expr(ctx, left)
}

// `first`, the subject lowered ahead of the bounds, bound to a local in `out` ahead
// of any `await` the bounds hoisted since `mark` ; null for a name.
held_subject :: fn(
    ctx: FnLowerCtx,
    first: LoweredExpr | null,
    mark: i64,
    span: Span,
    out: LoweredStmt[],
) -> LoweredExpr | null {
    if first == null {
        return null
    }
    return bind_unless_stable(ctx, bind_one_before_hoisted(ctx, first, mark), "in_x", span, out)
}

// One read of the subject `left` : its name lowered afresh, or the value it was
// held in, a local read again as a node of its own.
subject_read :: fn(ctx: FnLowerCtx, left: Expr, held: LoweredExpr | null) -> LoweredExpr {
    if held == null {
        return lower_expr(ctx, left)
    }
    if held is LoweredIdent {
        return LoweredIdent { ...held }
    }
    return held
}

is_string_type :: fn(t: Type) -> bool {
    if t is PrimitiveType { return t.name == "string" }
    return false
}

// True iff `b` is a PRIMITIVE `string + string` (not a user-struct `Add` that
// returns `string`: there one operand is the struct, not a string). The flatten
// recurses only through these. A standalone fn with early returns rather than a
// multi-line `&&` (the parser has no leading-`&&` line continuation).
is_primitive_string_concat :: fn(ctx: FnLowerCtx, b: BinaryExpr) -> bool {
    if b.op != .Add { return false }
    if !is_string_type(ctx.types.expr_type(b.left)) { return false }
    return is_string_type(ctx.types.expr_type(b.right))
}

// Flatten a primitive string `+` tree into its leaf operands, lowered in order
// (`lower_in_order`). `((a + b) + c)` collects `[a, b, c]`. A nested node is
// recursed into only when it is itself a primitive string `+` ; everything else
// is an opaque leaf.
collect_concat_operands :: fn(ctx: FnLowerCtx, e: Expr, out: LoweredExpr[]) -> void {
    if e is BinaryExpr {
        if is_primitive_string_concat(ctx, e) {
            collect_concat_operands(ctx, e.left, out)
            collect_concat_operands(ctx, e.right, out)
            return
        }
    }
    mark :: ctx.pending_awaits.len()
    value :: lower_expr(ctx, e)
    bind_before_hoisted(ctx, out, mark)
    out.push(value)
}

try_lower_op_overload :: fn(ctx: FnLowerCtx, binary: BinaryExpr, type: Type) -> LoweredExpr | null {
    info :: op_trait_method(binary.op) ?? return null
    if info is OpTraitInfo {
        left_ty :: ctx.types.expr_type(binary.left)
        target :: operator_target(ctx, binary, info, left_ty)
        // TypeParam-bound and erased Any receivers, a value of the operator's
        // trait and a union of its implementors route through virtual
        // dispatch: the boxed value's tag picks the right impl at runtime.
        // Same shape as a method-form call's (`method_target`), just driven from a
        // BinaryOp.
        if target is RecordedVirtual || left_ty is TypeParamType || left_ty is AnyType {
            observe_virtual(ctx, binary, .Operator, info.trait_key, info.method_name)
            return lower_op_overload_via_vcall(ctx, binary, type, info)
        }
        if target !is UfcsMember {
            return null
        }
        observe_symbol(ctx, binary, .Operator, target.symbol)
        lowered_left :: lower_expr(ctx, binary.left)
        mark :: ctx.pending_awaits.len()
        lowered_right :: lower_expr(ctx, binary.right)
        call_args: LoweredExpr[]: [bind_one_before_hoisted(ctx, lowered_left, mark), lowered_right]
        // For Eq, the call's value IS the bool result. For Neq we wrap in `not`.
        // For Lt/Lte/Gt/Gte, we keep the outer BinaryOp with the call as left +
        // `0` as right (compare returns i32).
        if info.shape == .DirectCall {
            // Arithmetic + Equals : returns the binary's static type.
            return mk_lowered_call(target.symbol, call_args, type, binary.span)
        }
        if info.shape == .NotCall {
            // `a != b` → `not(equals(a, b))`.
            equals_call :: mk_lowered_call(target.symbol, call_args, TY_BOOL, binary.span)
            return LoweredUnary {
                .span = binary.span, .type = TY_BOOL,
                .op = .Not, .operand = equals_call,
            }
        }
        // OpShape.CompareCmp : `a < b` → `(compare(a, b)) < 0`, same
        // for <= / > / >=. The outer BinaryOp matches `binary.op`.
        compare_call :: mk_lowered_call(target.symbol, call_args, TY_I32, binary.span)
        return LoweredBinary {
            .span = binary.span, .type = TY_BOOL,
            .op    = lower_binary_op(binary.op),
            .left  = compare_call,
            .right = LoweredIntLit {
                .span = binary.span, .type = TY_I32, .value = 0,
            },
        }
    }
    return null
}

// What `a op b` calls on a left operand of type `t`, as the typecheck recorded it :
// a distinct with none of its own reaches its backing's. Null where the built-in op
// applies: a primitive has one for every operator but ordering a `string`, which
// only its `Comparable` impl answers.
operator_target :: fn(
    ctx: FnLowerCtx,
    binary: BinaryExpr,
    info: OpTraitInfo,
    t: Type,
) -> RecordedTarget | null {
    if t is PrimitiveType | RangeType && !(info.shape == .CompareCmp && is_string_type(t)) {
        return null
    }
    return recorded_target(ctx, binary, .Operator, t)
}

// `contains(coll, element)` through `target`.
contains_call :: fn(
    ctx: FnLowerCtx,
    target: RecordedTarget,
    coll: LoweredExpr,
    element: LoweredExpr,
    span: Span,
) -> LoweredExpr {
    if target is RecordedVirtual {
        return virtual_call(ctx, target.trait_key, METHOD_CONTAINS, coll, [element], TY_BOOL, span)
    }
    return mk_lowered_call(target.symbol, [coll, element], TY_BOOL, span)
}

// Emit `a op b` as a virtual call (the receiver is TypeParam-bound, erased to Any,
// a value of the operator's trait or a union of its implementors). Shape mirrors
// the field-expr vcall path : Eq / Comparable share the dispatch + outer-op
// patterns from `op_trait_method`.
lower_op_overload_via_vcall :: fn(
    ctx: FnLowerCtx, binary: BinaryExpr, type: Type, oti: OpTraitInfo,
) -> LoweredExpr | null {
    first :: lower_expr(ctx, binary.left)
    mark :: ctx.pending_awaits.len()
    lowered_right :: lower_expr(ctx, binary.right)
    lowered_left :: bind_one_before_hoisted(ctx, first, mark)
    args: LoweredExpr[]: [lowered_right]
    // The call's own result : `compare`'s `i32`, `equals`' `bool`, else the
    // operator's (`Add`'s `Self`).
    result :: match oti.shape {
        .DirectCall -> type
        .NotCall    -> TY_BOOL
        .CompareCmp -> TY_I32
    }
    method :: oti.method_name
    call :: virtual_call(ctx, oti.trait_key, method, lowered_left, args, result, binary.span)
    return match oti.shape {
        .DirectCall -> call
        .NotCall    -> LoweredUnary {
            .span = binary.span, .type = TY_BOOL,
            .op = .Not, .operand = call,
        }
        // Preserve the BinaryOp on (compare-call, 0).
        .CompareCmp -> LoweredBinary {
            .span = binary.span, .type = TY_BOOL,
            .op    = lower_binary_op(binary.op),
            .left  = call,
            .right = LoweredIntLit {
                .span = binary.span, .type = TY_I32, .value = 0,
            },
        }
    }
}

OpShape :: enum(i32) {
    DirectCall,    // `a op b` -> `method(a, b)`             (Add / Sub / Mul / Div / Mod / Eq)
    NotCall,       // `a op b` -> `!method(a, b)`            (Neq)
    CompareCmp,    // `a op b` -> `method(a, b) <orig op> 0` (Lt / Lte / Gt / Gte)
}

OpTraitInfo :: struct {
    /// The op-trait's `trait_key`.
    trait_key:       string
    method_name: string
    shape:       OpShape
}

op_trait_method :: fn(op: BinaryOp) -> OpTraitInfo | null {
    if op == .Add { return OpTraitInfo { .trait_key = core_trait_key(TRAIT_ADD), .method_name = METHOD_ADD, .shape = .DirectCall } }
    if op == .Sub { return OpTraitInfo { .trait_key = core_trait_key(TRAIT_SUB), .method_name = METHOD_SUB, .shape = .DirectCall } }
    if op == .Mul { return OpTraitInfo { .trait_key = core_trait_key(TRAIT_MUL), .method_name = METHOD_MUL, .shape = .DirectCall } }
    if op == .Div { return OpTraitInfo { .trait_key = core_trait_key(TRAIT_DIV), .method_name = METHOD_DIV, .shape = .DirectCall } }
    if op == .Mod { return OpTraitInfo { .trait_key = core_trait_key(TRAIT_REM), .method_name = METHOD_REM, .shape = .DirectCall } }
    if op == .Eq  { return OpTraitInfo { .trait_key = core_trait_key(TRAIT_EQUALS), .method_name = METHOD_EQUALS, .shape = .DirectCall } }
    if op == .Neq { return OpTraitInfo { .trait_key = core_trait_key(TRAIT_EQUALS), .method_name = METHOD_EQUALS, .shape = .NotCall } }
    if op == .Lt  { return OpTraitInfo { .trait_key = core_trait_key(TRAIT_COMPARABLE), .method_name = METHOD_COMPARE, .shape = .CompareCmp } }
    if op == .Lte { return OpTraitInfo { .trait_key = core_trait_key(TRAIT_COMPARABLE), .method_name = METHOD_COMPARE, .shape = .CompareCmp } }
    if op == .Gt  { return OpTraitInfo { .trait_key = core_trait_key(TRAIT_COMPARABLE), .method_name = METHOD_COMPARE, .shape = .CompareCmp } }
    if op == .Gte { return OpTraitInfo { .trait_key = core_trait_key(TRAIT_COMPARABLE), .method_name = METHOD_COMPARE, .shape = .CompareCmp } }
    return null
}

try_lower_null_eq :: fn(ctx: FnLowerCtx, binary: BinaryExpr) -> LoweredExpr | null {
    union_operand: Expr | null = null
    if is_null_lit(binary.left) && is_union_with_null(ctx.types.expr_type(binary.right)) {
        union_operand = binary.right
    }
    if is_null_lit(binary.right) && is_union_with_null(ctx.types.expr_type(binary.left)) {
        union_operand = binary.left
    }
    if union_operand is null { return null }
    check :: LoweredTypeCheck {
        .span = binary.span, .type = TY_BOOL,
        .value = lower_expr(ctx, union_operand),
        .check_type = TY_NULL,
    }
    if binary.op == .Eq { return check }
    return LoweredUnary {
        .span = binary.span, .type = TY_BOOL,
        .op = .Not, .operand = check,
    }
}

is_null_lit :: fn(e: Expr) -> bool {
    if e is NullLitExpr { return true }
    return false
}

is_union_with_null :: fn(type: Type) -> bool {
    if type is UnionType {
        for v in type.variants {
            if v is PrimitiveType {
                if v.name == "null" { return true }
            }
        }
        return false
    }
    return false
}
