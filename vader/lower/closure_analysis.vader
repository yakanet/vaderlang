// vader/lower/closure_analysis: free-variable walker for closures.
//
// For every `AST.LambdaExpr` and `defer` in the project, computes the ordered list
// of captures: symbols defined in an enclosing scope that the body references. The
// lowerer's lambda-lifting pass consumes this to:
//   - Pack the captures into an env struct for `MakeClosure`.
//   - Provide a `lifted_context` to the lambda body so captured idents
//     route through `env.cap_N` instead of resolving to a (now non-
//     existent) outer local.
//
// Nested lambdas : an outer lambda's captures include any of its inner
// lambdas' captures that originate outside the outer lambda's own
// scope. Otherwise the outer would have no way to pass them to the
// inner closure. Each nested lambda gets a walk of its own, whose captures
// then fold into the enclosing body's.

module "vader/lower"

import "std/collections"
import "vader/support/diagnostics"
AST :: import "toolchain/ast"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/typecheck"
import "vader/front/resolver"
import "toolchain/span"

/// Record in `project.closures` each lambda's and `defer`'s capture list, and the
/// symbols captured as cells, for every body of `typed`'s module. A capture never
/// crosses a module, so a module is walked the first time a body of it is
/// lowered, and only modules that are lowered are walked.
///
/// @param project  the shared project context, whose `closures` is filled.
/// @param typed    the module about to have a body lowered.
ensure_closure_analysis :: fn(project: LowerProjectCtx, typed: TypedProgram) -> void {
    path :: typed.resolved.path
    if !project.closure_modules.add(path) {
        return
    }
    loaded :: project.loaded.modules[path] ?? return
    analyze_module(project, loaded, typed)
}

// Per-module walker. Walks every top-level AST.FnDecl body, every AST.ImplDecl
// member body and every default body of an AST.TraitDecl, plus the values written
// outside any fn, ConstDecl values and struct field defaults.
analyze_module :: fn(project: LowerProjectCtx, loaded: LoadedModule, typed: TypedProgram) -> void {
    ctx :: WalkCtx {
        .typed = typed,
        .symbol_index = ensure_local_symbol_index(project, typed.resolved),
        .analysis = project.closures,
    }
    for source_file in loaded.module.files {
        for decl in source_file.program.decls {
            match decl {
                is AST.FnDecl -> {
                    analyze_fn_body(ctx, decl)
                }
                is AST.ImplDecl -> {
                    analyze_fn_bodies(ctx, decl.members)
                }
                // A default body is lowered once per impl inheriting it, from the
                // trait (`inherited.vader`).
                is AST.TraitDecl -> {
                    analyze_fn_bodies(ctx, decl.members)
                }
                is AST.ConstDecl -> {
                    analyze_host(ctx, decl.value)
                }
                is AST.StructDecl -> {
                    for field in decl.fields {
                        value :: field.default ?? continue
                        analyze_host(ctx, value)
                    }
                }
                is AST.ImportDecl | AST.EnumDecl | AST.TypeAliasDecl | AST.AssertDecl -> {}
            }
        }
    }
}

analyze_fn_bodies :: fn(ctx: WalkCtx, fns: AST.FnDecl[]) -> void {
    for f in fns {
        analyze_fn_body(ctx, f)
    }
}

analyze_fn_body :: fn(ctx: WalkCtx, f: AST.FnDecl) -> void {
    body :: f.body ?? return
    analyze_host(ctx, body)
}

// Walk a fn body, or a value written outside any fn (a const's, a struct field's
// default), for the lambdas and `defer`s it hosts. It collects no captures of its
// own: its nested bodies record theirs. A const initialised by a block that
// declares locals and returns a lambda (`make_adder :: { base :: 10 (n) -> base + n }`)
// hosts a closure just like a fn body, and so does a field default that is a lambda
// declaring locals of its own ; without this its `lambda_captures` entry is
// missing, the env never carries the capture, and the lambda miscompiles.
analyze_host :: fn(ctx: WalkCtx, n: AST.Node) -> void {
    walk_node(n, BodyWalk { .ctx = ctx })
}

WalkCtx :: struct {
    typed: TypedProgram
    // Cache built once by `analyze_module` ; covers every defined_at in
    // `typed.resolved`. Lookups go through `add_symbol_at`.
    symbol_index: MutableMap<u64, Symbol>
    analysis: ClosureAnalysis
}

// ---------------------------------------------------------------- walkers
//
// One walk per body: a fn's, a lambda's, a `defer`'s. A nested lambda or `defer`
// gets a walk of its own, whose captures then fold into the enclosing body's.

// The walk over one body. `captures` is null for a body that collects none, a fn's
// or a top-level value's: it only hosts the lambdas and `defer`s to walk.
BodyWalk :: struct {
    captures: CaptureSet | null = null
    ctx: WalkCtx
}

// What a lambda's or a `defer`'s body collects. `scope` holds the ids of the
// symbols the body declares, each added where its declaration is met, before its
// value: the resolver binds a name after its value, so nothing in the value names
// it, and an ident only resolves to a binding in scope, so no name ever has to
// leave the set. `list` holds the captures in order of first use, `seen` their ids.
CaptureSet :: struct {
    scope: MutableSet<i32>
    list: Capture[] = []
    seen: MutableSet<i32> = MutableSet<i32> {}
}

walk_node :: fn(n: AST.Node, w: BodyWalk) -> void {
    AST.inspect(n, (m) -> enter_node(m, w))
}

enter_node :: fn(n: AST.Node, w: BodyWalk) -> AST.Walk = match n {
    is AST.IdentExpr -> record_ident_capture(n, w)
    is AST.LetStmt -> add_let(n, w)
    is AST.ForStmt -> add_loop_var(n, w)
    is AST.MatchExpr -> add_match_bindings(n, w)
    is AST.LambdaExpr -> process_lambda(n, w)
    is AST.DeferStmt -> walk_defer(n, w)
    // A type or a pattern names no local.
    is AST.FnTypeExpr | AST.ArrayTypeExpr | AST.Pattern -> .Skip
    is AST.Decl | AST.AssignStmt | AST.DestructureAssignStmt | AST.ExprStmt
        | AST.ReturnStmt | AST.YieldStmt | AST.BreakStmt | AST.ContinueStmt | AST.IntLitExpr
        | AST.FloatLitExpr | AST.BoolLitExpr | AST.NullLitExpr | AST.CharLitExpr
        | AST.StringLitExpr | AST.DotVariantExpr | AST.CallExpr | AST.FieldExpr | AST.IndexExpr
        | AST.UnaryExpr | AST.BinaryExpr | AST.NullCoalesceExpr | AST.IfExpr | AST.BlockExpr
        | AST.StructLitExpr | AST.SeqLitExpr | AST.RangeExpr | AST.CastExpr | AST.GenericInstExpr
        | AST.IntrinsicCallExpr | AST.AwaitExpr -> .Descend
}

add_let :: fn(l: AST.LetStmt, w: BodyWalk) -> AST.Walk {
    c :: w.captures ?? return .Descend
    add_local_to_scope(l.binding, c.scope, w.ctx.symbol_index)
    return .Descend
}

add_loop_var :: fn(for_stmt: AST.ForStmt, w: BodyWalk) -> AST.Walk {
    c :: w.captures ?? return .Descend
    form :: for_stmt.form
    if form !is AST.InFor {
        return .Descend
    }
    match loop_var :: form.loop_var {
        is AST.NamedVar       -> { add_symbol_at(loop_var.span, c.scope, w.ctx.symbol_index) }
        // `for [k, v] in ...` : each leaf is a loop-scoped local a body closure may
        // capture (reuses the shared let-binding walker).
        is AST.DestructureVar -> {
            add_local_to_scope(loop_var.pattern, c.scope, w.ctx.symbol_index)
        }
        is AST.DiscardVar     -> {}
    }
    return .Descend
}

// `match x :: e` binds ONE name around every arm, minted at the `x` token
// (`front/resolver/body.vader::walk_match`), and each arm's pattern its own.
// Without them the names read as free variables, and a lambda around them captures
// a symbol the enclosing fn has no local for.
add_match_bindings :: fn(m: AST.MatchExpr, w: BodyWalk) -> AST.Walk {
    c :: w.captures ?? return .Descend
    binding :: m.binding
    if binding != null {
        add_symbol_at(binding.name_span, c.scope, w.ctx.symbol_index)
    }
    for arm in m.arms {
        add_pattern_bindings(arm.pattern, c.scope, w.ctx.symbol_index)
    }
    return .Descend
}

record_ident_capture :: fn(ident: AST.IdentExpr, w: BodyWalk) -> AST.Walk {
    c :: w.captures ?? return .Descend
    symbol :: w.ctx.typed.resolved.idents[ident.span.hash()] ?? return .Descend
    // An alias of a generic fn has no slot : each use names the fn.
    if is_capturable(symbol) && symbol.id !in c.scope && w.ctx.typed.fn_aliases[symbol.id] == null {
        add_capture(w.ctx, c, symbol, ident)
    }
    return .Descend
}

is_capturable :: fn(symbol: Symbol) = is_local_binding(symbol.kind)

add_capture :: fn(ctx: WalkCtx, c: CaptureSet, symbol: Symbol, ident: AST.IdentExpr) -> void {
    if !c.seen.add(symbol.id) {
        return
    }
    note_cell_capture(ctx, symbol)
    c.list.push(
        Capture {
            .symbol = symbol,
            .type = laid_out_unions(type_of_captured_symbol(symbol, ident, ctx.typed)),
        },
    )
}

// Prefer the type recorded at the symbol's binding site (param /
// local) since use-sites may carry a narrowed view. Falls back to the
// AST.IdentExpr's expr_type then to `TY_UNRESOLVED`.
type_of_captured_symbol :: fn(symbol: Symbol, ident: AST.IdentExpr, typed: TypedProgram) -> Type {
    match defined :: symbol.defined_at {
        is Span -> {
            if symbol.kind == .Param {
                t :: typed.param_types[defined.hash()]
                if t !is null {
                    return t
                }
            } else if symbol.kind == .Local || symbol.kind == .Binding {
                t :: typed.local_types[defined.hash()]
                if t !is null {
                    return t
                }
            }
        }
        is null -> {}
    }
    fallback :: typed.expr_types[ident.id]
    if fallback !is null {
        return fallback
    }
    return TY_UNRESOLVED
}

// ---------------------------------------------------------------- helpers

// Add every leaf binding name from a `AST.LetBinding` tree into the scope.
add_local_to_scope :: fn(
    binding: AST.LetBinding,
    scope: MutableSet<i32>,
    symbol_index: MutableMap<u64, Symbol>,
) -> void {
    match binding {
        is AST.SimpleBinding   -> { add_symbol_at(binding.name_span, scope, symbol_index) }
        is AST.TupleBinding    -> {
            for leaf in binding.elements {
                add_local_to_scope(leaf, scope, symbol_index)
            }
        }
        is AST.WildcardBinding -> {}
        is AST.RestBinding     -> {
            // The resolver keys a rest binding's Symbol on `.span` (not
            // `.name_span` like a simple binding, see resolver `bind_let_binding`).
            add_symbol_at(binding.span, scope, symbol_index)
        }
    }
}

// Put the symbol the resolver minted at `span` into `scope`.
add_symbol_at :: fn(
    span: Span,
    scope: MutableSet<i32>,
    symbol_index: MutableMap<u64, Symbol>,
) -> void {
    symbol :: symbol_index[span.hash()] ?? return
    scope.add(symbol.id)
}

add_pattern_bindings :: fn(
    pattern: AST.Pattern,
    scope: MutableSet<i32>,
    symbol_index: MutableMap<u64, Symbol>,
) -> void {
    match pattern {
        is AST.IsPattern          -> {
            if pattern.inner !is null {
                add_pattern_bindings(pattern.inner, scope, symbol_index)
            }
        }
        is AST.StructPattern      -> {
            for field in pattern.fields {
                if field.value is AST.PatternBinding {
                    add_symbol_at(field.value.span, scope, symbol_index)
                }
            }
        }
        is AST.WildcardPattern    -> {}
        is AST.EnumVariantPattern -> {}
        is AST.LiteralPattern     -> {}
        is AST.RangePattern       -> {}
        is AST.OrPattern          -> {
            for sub in pattern.patterns {
                add_pattern_bindings(sub, scope, symbol_index)
            }
        }
    }
}

// A capture lives in a cell only when an assignment rebinds it: one nothing rebinds
// is copied into the env when the closure is made, and reads the same there as in
// its own slot. A symbol `rebind_free` does not list keeps its cell.
note_cell_capture :: fn(ctx: WalkCtx, symbol: Symbol) -> void {
    if !(symbol.id in ctx.typed.resolved.rebind_free) {
        ctx.analysis.cell_symbols.add(symbol.id)
    }
}

// ---------------------------------------------------------------- nested bodies

process_lambda :: fn(lambda: AST.LambdaExpr, w: BodyWalk) -> AST.Walk {
    scope :: MutableSet<i32> {}
    for p in lambda.params {
        add_symbol_at(p.span, scope, w.ctx.symbol_index)
    }
    captures :: collect_captures(lambda.body, scope, w)
    w.ctx.analysis.lambda_captures[capture_key(w.ctx.typed.resolved.path, lambda.id)] = captures
    return .Skip
}

// The defer body lifts to a synthetic fn with its own env struct and no params of
// its own, so it collects captures of its own from an EMPTY scope: every outer ident
// it references is then a capture (as for a lambda). They fold into the enclosing
// body's, which needs the binding in its own env to materialise the defer's at
// defer-push time.
walk_defer :: fn(d: AST.DeferStmt, w: BodyWalk) -> AST.Walk {
    captures :: collect_captures(deferred_node(d.body), MutableSet<i32> {}, w)
    w.ctx.analysis.defer_captures[capture_key(w.ctx.typed.resolved.path, d.id)] = captures
    return .Skip
}

deferred_node :: fn(body: AST.DeferBody) -> AST.Node = match body {
    is AST.DeferStmtBody  -> body.stmt
    is AST.DeferBlockBody -> body.block
}

// Walk a lambda's or a `defer`'s body, which collects captures of its own over the
// symbols `scope` starts with, and fold them into the enclosing body's.
collect_captures :: fn(body: AST.Node, scope: MutableSet<i32>, w: BodyWalk) -> Capture[] {
    inner :: CaptureSet { .scope = scope }
    walk_node(body, BodyWalk { .captures = inner, .ctx = w.ctx })
    fold_captures(inner.list, w)
    return inner.list
}

// Fold a nested body's captures into the enclosing body's, skipping the symbols the
// enclosing body declares: those are shared, no captures of its own.
fold_captures :: fn(captures: Capture[], w: BodyWalk) -> void {
    outer :: w.captures ?? return
    for capture in captures {
        if capture.symbol.id !in outer.scope && outer.seen.add(capture.symbol.id) {
            outer.list.push(capture)
        }
    }
}
