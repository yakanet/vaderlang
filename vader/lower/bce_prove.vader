// vader/lower/bce_prove — post-inline BCE (bounds-check elimination) tagging pass.
//
// The loop desugars (foreach `try_lower_for_in_raw_array` and iterator fusion
// `emit_fused_array`) lower to a counter loop that runs `0..<len(arr)` over an
// array and indexes `arr[idx]`. Each marks the `arr.len()` bound it emits with
// `LoweredArrayLen.bce_recheck` and its synthesized `arr[idx]` access with
// `LoweredIndex.bce_recheck`, but DEFERS the safety decision to this pass.
//
// Why post-devirt : a `for x in a.map(f)` / a `for x in a { helper(x) }` body
// is, at desugar time, an INDIRECT call through a fn-value — `bce_block_unsafe`
// would flag it and bail. `bce_prove_tag` runs AFTER `devirtualize_fn_refs`
// (see `lower.vader`), so the callback is a direct call by then and
// `bce_fn_pure` can resolve its callee and prove it allocation-free. No
// combinator is special-cased : the decision is purely "does the inlined loop
// body allocate / call / yield / rebind the array ?" (`bce_block_unsafe`,
// `vader/lower/lower_for_in.vader`).
//
// When safe : each synthesized `arr[idx]` has its bounds check elided. The
// `bce_recheck` markers are consumed here and never reach codegen. Mutates the
// lowered tree in place (like `devirtualize_fn_refs`).

module "vader/lower"

import "std/collections"

/// Project-wide purity memo, shared across the whole pass. A callee is resolved
/// to its decl the same two ways the backend does (`midir/emit.vader`, and the
/// sibling walk in `dce.vader`): by mangle (impl-member calls carry the mangle in
/// `symbol.name`) then by definition symbol id (bare free-fn calls carry it in
/// `symbol.id`). `memo` caches `bce_fn_pure` verdicts keyed by mangle, and doubles
/// as the recursion-cycle guard : a fn is stamped impure on entry (a re-entrant
/// query reads that) and overwritten with its real verdict before returning.
BcePurityCtx :: struct {
    by_mangle: MutableMap<string, LoweredFnDecl>
    by_symid:  MutableMap<i32, LoweredFnDecl>
    memo:      MutableMap<string, bool>
}

/// Resolve a call's callee `(name, sym_id)` to its decl — mangle first, then the
/// definition symbol id — or `null` for an unresolved / `@extern` callee.
bce_resolve_fn :: fn(pctx: BcePurityCtx, name: string, sym_id: i32) -> LoweredFnDecl | null {
    m :: pctx.by_mangle[name]
    if m != null {
        return m
    }
    return pctx.by_symid[sym_id]
}

/// Is `fd` provably free of allocation / GC-safepoints — its body allocates
/// nothing (no literal / push / slice / closure), suspends nowhere (no yield /
/// await / defer), and calls ONLY other pure fns ? Memoised by mangle. A bodyless
/// (`@extern`) fn and any recursion cycle are conservatively impure. This is what
/// makes `bce_call_unsafe` accept a pure callback (`a.map(square)`) without naming
/// any combinator.
bce_fn_pure :: fn(pctx: BcePurityCtx!, fd: LoweredFnDecl) -> bool {
    key :: fd.mangled
    cached :: pctx.memo[key]
    if cached != null {
        return cached
    }
    body :: fd.body ?? return false
    // Stamp impure BEFORE walking : a re-entrant (recursive) query hits this and
    // gets `false` — a cycle can't be proven pure. The real verdict overwrites it
    // below, so no non-cyclic caller ever reads the sentinel.
    pctx.memo[key] = false
    result :: !bce_block_unsafe(body, null, pctx)
    pctx.memo[key] = result
    return result
}

// Index every fn decl by mangle, and non-generic-instance fns also by definition
// symbol id, for `bce_resolve_fn`. Mangles are unique ; symbol ids are NOT — a
// generic's monomorphic instances all share the generic's symbol id, so indexing
// an instance by symid would collide (last-wins) and could resolve a callee to the
// WRONG instance. Same rule as `dce.vader`. An instance is therefore only reachable
// via its (unique) mangle ; a symid-only callee that misses stays conservatively
// impure — never mis-resolved to a sibling with a different purity.
bce_build_purity_ctx :: fn(project: LoweredProject) -> BcePurityCtx {
    by_mangle :: MutableMap<string, LoweredFnDecl> {}
    by_symid :: MutableMap<i32, LoweredFnDecl> {}
    for [_, m] in project.modules {
        for d in m.decls {
            if d is LoweredFnDecl {
                by_mangle[d.mangled] = d
                s :: d.origin.symbol
                if s != null && d.origin.type_arguments.len() == 0 {
                    by_symid[s.id] = d
                }
            }
        }
    }
    return BcePurityCtx {
        .by_mangle = by_mangle, .by_symid = by_symid,
        .memo = MutableMap<string, bool> {},
    }
}

/// Run the BCE tagging pass over every function body in `project`. Idempotent
/// per node (each `bce_recheck` marker is cleared once consumed).
export bce_prove_tag :: fn(project: LoweredProject) -> void {
    pctx :: bce_build_purity_ctx(project)
    for [_, m] in project.modules {
        for d in m.decls {
            if d is LoweredFnDecl {
                body :: d.body
                if body != null {
                    bp_block(body, pctx)
                }
            }
        }
    }
}

// ---- the report: count the STATE, not the attempt ---------------------------
//
// An element access inside a loop that ends the pass without `bounds_safe` will
// re-check its bounds on every iteration. That is the fact worth reporting, and
// it is reached by every route — a proof that was tried and refused, AND a loop
// whose bound was never an `arr.len()` to pair with (`for i in 0..<n` with `n` a
// separate local, which is `bench/arr_rw` and is why counting refusals missed
// it entirely).
//
// Only accesses INSIDE a loop are counted: a one-shot `a[i]` checks once, which
// is the cost of the language, not a missed optimisation.

/// Collect every in-loop element access still carrying a bounds check.
export bce_unproven_accesses :: fn(project: LoweredProject, ctx: LowerProjectCtx!) -> void {
    if !ctx.opt_report {
        return
    }
    for [_, m] in project.modules {
        for d in m.decls {
            if d is LoweredFnDecl {
                body :: d.body
                if body != null {
                    bp_scan_block(body, false, ctx)
                }
            }
        }
    }
}

bp_scan_block :: fn(b: LoweredBlock, in_loop: bool, ctx: LowerProjectCtx!) -> void {
    for st in b.stmts {
        bp_scan_stmt(st, in_loop, ctx)
    }
    trailing :: b.trailing
    if trailing != null {
        bp_scan_expr(trailing, in_loop, ctx)
    }
}

bp_scan_stmt :: fn(s: LoweredStmt, in_loop: bool, ctx: LowerProjectCtx!) -> void {
    match s {
        is LoweredLet       -> { bp_scan_expr(s.value, in_loop, ctx) }
        is LoweredAssign    -> { bp_scan_expr(s.target, in_loop, ctx)  bp_scan_expr(s.value, in_loop, ctx) }
        is LoweredExprStmt  -> { bp_scan_expr(s.expr, in_loop, ctx) }
        is LoweredReturn    -> {
            v :: s.value
            if v != null {
                bp_scan_expr(v, in_loop, ctx)
            }
        }
        is LoweredLabelledBlock -> { bp_scan_block(s.body, in_loop, ctx) }
        is LoweredLoop      -> {
            bp_scan_block(s.body, true, ctx)
            for st in s.step {
                bp_scan_stmt(st, true, ctx)
            }
        }
        _                   -> {}
    }
}

bp_scan_expr :: fn(e: LoweredExpr, in_loop: bool, ctx: LowerProjectCtx!) -> void {
    if e is LoweredIndex {
        if in_loop && !e.bounds_safe {
            record_miss(ctx, "array bounds-check", e.span,
                "an in-loop element access the compiler could not prove in range — "
                + "it re-checks bounds on every iteration")
        }
        bp_scan_expr(e.target, in_loop, ctx)
        bp_scan_expr(e.index, in_loop, ctx)
        return
    }
    if e is LoweredBlock {
        bp_scan_block(e, in_loop, ctx)
    }
}

// ---- descent : reach every block, pair a recheck-len with its sibling loop ----

bp_block :: fn(b: LoweredBlock!, pctx: BcePurityCtx!) -> void {
    for st in b.stmts {
        bp_stmt(st, pctx)
    }
    trailing :: b.trailing
    if trailing != null {
        bp_expr(trailing, pctx)
    }
    bp_pair(b, pctx)
}

bp_stmt :: fn(s: LoweredStmt!, pctx: BcePurityCtx!) -> void {
    if s is LoweredLet {
        bp_expr(s.value, pctx)
    } else if s is LoweredAssign {
        bp_expr(s.target, pctx)
        bp_expr(s.value, pctx)
    } else if s is LoweredCellSet {
        bp_expr(s.target, pctx)
        bp_expr(s.value, pctx)
    } else if s is LoweredExprStmt {
        bp_expr(s.expr, pctx)
    } else if s is LoweredReturn {
        v :: s.value
        if v != null {
            bp_expr(v, pctx)
        }
    } else if s is LoweredYield {
        bp_expr(s.value, pctx)
    } else if s is LoweredAwait {
        bp_expr(s.awaited, pctx)
    } else if s is LoweredLabelledBlock {
        bp_block(s.body, pctx)
    } else if s is LoweredLoop {
        c :: s.cond
        if c != null {
            bp_expr(c, pctx)
        }
        bp_block(s.body, pctx)
        for st in s.step {
            bp_stmt(st, pctx)
        }
    } else if s is LoweredDeferPush {
        bp_expr(s.thunk, pctx)
    }
    // Break / Continue / DeferPopExec : no nested block.
}

bp_expr :: fn(e: LoweredExpr!, pctx: BcePurityCtx!) -> void {
    if e is LoweredBlock {
        bp_block(e, pctx)
    } else if e is LoweredIf {
        bp_expr(e.cond, pctx)
        bp_block(e.then_block, pctx)
        eb :: e.else_block
        if eb != null {
            bp_block(eb, pctx)
        }
    } else if e is LoweredBinary {
        bp_expr(e.left, pctx)
        bp_expr(e.right, pctx)
    } else if e is LoweredUnary {
        bp_expr(e.operand, pctx)
    } else if e is LoweredCast {
        bp_expr(e.value, pctx)
    } else if e is LoweredTypeCheck {
        bp_expr(e.value, pctx)
    } else if e is LoweredIndex {
        bp_expr(e.target, pctx)
        bp_expr(e.index, pctx)
    } else if e is LoweredFieldAccess {
        bp_expr(e.target, pctx)
    } else if e is LoweredArrayLen {
        bp_expr(e.target, pctx)
    } else if e is LoweredCall {
        bp_expr(e.callee, pctx)
        for a in e.args {
            bp_expr(a, pctx)
        }
    } else if e is LoweredVirtualCall {
        bp_expr(e.receiver, pctx)
        for a in e.args {
            bp_expr(a, pctx)
        }
    } else if e is LoweredIntrinsicCall {
        for a in e.args {
            bp_expr(a, pctx)
        }
    } else if e is LoweredStructLit {
        for f in e.fields {
            bp_expr(f.value, pctx)
        }
    } else if e is LoweredArrayLit {
        for el in e.elements {
            bp_expr(el, pctx)
        }
    } else if e is LoweredArrayPush {
        bp_expr(e.target, pctx)
        bp_expr(e.value, pctx)
    } else if e is LoweredArraySlice {
        bp_expr(e.target, pctx)
        bp_expr(e.lo, pctx)
        bp_expr(e.hi, pctx)
    } else if e is LoweredStringSlice {
        bp_expr(e.target, pctx)
        bp_expr(e.lo, pctx)
        bp_expr(e.hi, pctx)
    } else if e is LoweredCellNew {
        bp_expr(e.value, pctx)
    } else if e is LoweredCellGet {
        bp_expr(e.target, pctx)
    } else if e is LoweredMakeClosure {
        bp_expr(e.env, pctx)
    }
    // Leaves (lits / ident / data-const / unreachable / type-const) : nothing.
}

// In block `b`, pair each `bce_recheck` `let __ = arr.len()` with the sibling loop
// built from it. `emit_fused_*` emits one source as `arr_let … len_let(recheck) …
// idx_init … loop`, so each recheck-len is followed (past its idx-init) by exactly
// the loop that iterates it — walk the block in order and pair the pending len with
// the next loop. A block can hold several such pairs back-to-back (`a.chain(b)`
// fuses to two sequential source loops, and any N-way sequential fusion likewise);
// each is proven independently, not just the last.
bp_pair :: fn(b: LoweredBlock!, pctx: BcePurityCtx!) -> void {
    pending_len: LoweredArrayLen | null = null
    for st in b.stmts {
        if st is LoweredLet {
            if st.value is LoweredArrayLen as al {
                if al.bce_recheck {
                    pending_len = al
                }
            }
        } else if st is LoweredLoop {
            if pending_len != null {
                bp_try_prove(pending_len, st, pctx)
                pending_len = null
            }
        }
    }
}

// Consume `the_len`'s recheck marker ; if `the_loop`'s body is BCE-safe (no alloc /
// impure call / yield / rebind of the bound array), elide the loop's synthesized
// `arr[idx]` checks.
bp_try_prove :: fn(the_len: LoweredArrayLen!, the_loop: LoweredLoop!, pctx: BcePurityCtx!) -> void {
    the_len.bce_recheck = false
    // Guard on the bound array's symbol : the length was read from the array that
    // symbol held, so rebinding it (`arr = other`) voids the proof.
    guard :: bp_guard_sym(the_len)
    if bce_block_unsafe(the_loop.body, guard, pctx)
        || bce_block_unsafe(loop_step_block(the_loop), guard, pctx) {
        return
    }
    bp_mark_idx_block(the_loop.body)
}

// The symbol the length was read through, or null when the target is not a
// plain local. Not `-1`: that is the id of the first synthetic local lower mints.
bp_guard_sym :: fn(al: LoweredArrayLen) -> i32 | null =
    if al.target is LoweredIdent as id { id.symbol.id } else { null }

// ---- mark synthesized `arr[idx]` accesses bounds-safe (this loop only) --------
// Walks the loop body setting `bounds_safe` on every `bce_recheck` LoweredIndex,
// but does NOT descend into a nested LoweredLoop — a nested loop's accesses belong
// to its own (separately paired) len bound.

bp_mark_idx_block :: fn(b: LoweredBlock!) -> void {
    for st in b.stmts {
        bp_mark_idx_stmt(st)
    }
    trailing :: b.trailing
    if trailing != null {
        bp_mark_idx_expr(trailing)
    }
}

bp_mark_idx_stmt :: fn(s: LoweredStmt!) -> void {
    if s is LoweredLet {
        bp_mark_idx_expr(s.value)
    } else if s is LoweredAssign {
        bp_mark_idx_expr(s.target)
        bp_mark_idx_expr(s.value)
    } else if s is LoweredCellSet {
        bp_mark_idx_expr(s.target)
        bp_mark_idx_expr(s.value)
    } else if s is LoweredExprStmt {
        bp_mark_idx_expr(s.expr)
    } else if s is LoweredReturn {
        v :: s.value
        if v != null {
            bp_mark_idx_expr(v)
        }
    } else if s is LoweredYield {
        bp_mark_idx_expr(s.value)
    } else if s is LoweredAwait {
        bp_mark_idx_expr(s.awaited)
    } else if s is LoweredDeferPush {
        bp_mark_idx_expr(s.thunk)
    } else if s is LoweredLabelledBlock {
        bp_mark_idx_block(s.body)
    }
    // LoweredLoop : NOT descended (nested loop owns its own accesses).
    // Break / Continue / DeferPopExec : nothing.
}

bp_mark_idx_expr :: fn(e: LoweredExpr!) -> void {
    if e is LoweredIndex {
        if e.bce_recheck {
            e.bounds_safe = true
            e.bce_recheck = false
        }
        bp_mark_idx_expr(e.target)
        bp_mark_idx_expr(e.index)
    } else if e is LoweredBlock {
        bp_mark_idx_block(e)
    } else if e is LoweredIf {
        bp_mark_idx_expr(e.cond)
        bp_mark_idx_block(e.then_block)
        eb :: e.else_block
        if eb != null {
            bp_mark_idx_block(eb)
        }
    } else if e is LoweredBinary {
        bp_mark_idx_expr(e.left)
        bp_mark_idx_expr(e.right)
    } else if e is LoweredUnary {
        bp_mark_idx_expr(e.operand)
    } else if e is LoweredCast {
        bp_mark_idx_expr(e.value)
    } else if e is LoweredTypeCheck {
        bp_mark_idx_expr(e.value)
    } else if e is LoweredFieldAccess {
        bp_mark_idx_expr(e.target)
    } else if e is LoweredArrayLen {
        bp_mark_idx_expr(e.target)
    } else if e is LoweredCall {
        bp_mark_idx_expr(e.callee)
        for a in e.args {
            bp_mark_idx_expr(a)
        }
    } else if e is LoweredVirtualCall {
        bp_mark_idx_expr(e.receiver)
        for a in e.args {
            bp_mark_idx_expr(a)
        }
    } else if e is LoweredIntrinsicCall {
        for a in e.args {
            bp_mark_idx_expr(a)
        }
    } else if e is LoweredCellNew {
        bp_mark_idx_expr(e.value)
    } else if e is LoweredCellGet {
        bp_mark_idx_expr(e.target)
    }
    // Leaves + array/struct literals / slices / closures : a synthesized loop-var
    // access never nests there, so no descent needed.
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "vader/diagnostics"
import "vader/types"
import "vader/resolver/symbol"
import "vader/typecheck"
import "vader/comptime"
AST :: import "toolchain/ast"
import "toolchain/span"

// Minimal fixtures. `bce_fn_pure` reads only `fd.mangled` + `fd.body` and, via
// the ctx, resolves callees by mangle / symbol id — the rest of the MonoEntry /
// LoweredFnDecl shape is inert filler here.

bce_test_ctx :: fn() -> BcePurityCtx = BcePurityCtx {
    .by_mangle = MutableMap<string, LoweredFnDecl> {},
    .by_symid = MutableMap<i32, LoweredFnDecl> {},
    .memo = MutableMap<string, bool> {},
}

bce_test_sym :: fn(id: i32, name: string) -> Symbol = Symbol {
    .id = id, .kind = .Fn,
    .name = name,
    .module = "test",
    .module_name = "test",
    .visibility = .Private,
    .defined_at = null,
}

bce_test_fn :: fn(sym: Symbol, body: LoweredBlock | null) -> LoweredFnDecl! {
    // MonoEntry shape mirrors `synth_mono_entry` (lower_lambda.vader) — kept inline
    // because that helper needs a FnLowerCtx the fixture deliberately doesn't build.
    return LoweredFnDecl {
        .mangled = sym.name,
        .params = [],
        .return_type = TY_VOID,
        .body = body,
        .origin = MonoEntry {
            .id = sym.id,
            .is_main = false,
            .mangled = sym.name,
            .decl = stub_decl_for(sym),
            .symbol = sym,
            .subst = new_substitution(),
            .type_arguments = [],
            .module = null,
        },
    }
}

bce_test_block :: fn(stmts: LoweredStmt[]) -> LoweredBlock = LoweredBlock {
    .span = empty_span(), .type = TY_VOID, .stmts = stmts, .trailing = null,
}

// `return 0` — no allocation, no call : pure.
bce_test_pure_return :: fn() -> LoweredStmt = LoweredReturn {
    .span = empty_span(),
    .value = LoweredIntLit { .span = empty_span(), .type = TY_VOID, .value = 0 },
}

// `return [0]` — an array literal allocates : impure.
bce_test_alloc_return :: fn() -> LoweredStmt = LoweredReturn {
    .span = empty_span(),
    .value = LoweredArrayLit {
        .span = empty_span(), .type = TY_VOID,
        .elements = [LoweredIntLit { .span = empty_span(), .type = TY_VOID, .value = 0 }],
    },
}

// `return callee()` — a bare call to `callee`.
bce_test_call_return :: fn(callee: Symbol) -> LoweredStmt = LoweredReturn {
    .span = empty_span(),
    .value = LoweredCall {
        .span = empty_span(), .type = TY_VOID,
        .callee = LoweredIdent { .span = empty_span(), .type = TY_VOID, .symbol = callee },
        .args = [],
    },
}

// Register a callee both ways `bce_resolve_fn` looks it up.
bce_test_register :: fn(ctx: BcePurityCtx!, fd: LoweredFnDecl) -> void {
    ctx.by_mangle[fd.mangled] = fd
    s :: fd.origin.symbol
    if s != null {
        ctx.by_symid[s.id] = fd
    }
}

@test test_bce_fn_pure_pure_body :: fn() -> void {
    fd :: bce_test_fn(bce_test_sym(1, "pure"), bce_test_block([bce_test_pure_return()]))
    assert(bce_fn_pure(bce_test_ctx(), fd), "a non-allocating body is pure")
}

@test test_bce_fn_pure_allocating_body :: fn() -> void {
    fd :: bce_test_fn(bce_test_sym(2, "alloc"), bce_test_block([bce_test_alloc_return()]))
    assert(!bce_fn_pure(bce_test_ctx(), fd), "an allocating body is impure")
}

@test test_bce_fn_pure_extern_body :: fn() -> void {
    fd :: bce_test_fn(bce_test_sym(3, "ext"), null)
    assert(!bce_fn_pure(bce_test_ctx(), fd), "a bodyless (@extern) fn is conservatively impure")
}

@test test_bce_fn_pure_memoises_verdict :: fn() -> void {
    fd :: bce_test_fn(bce_test_sym(4, "memo"), bce_test_block([bce_test_pure_return()]))
    ctx :: bce_test_ctx()
    assert(bce_fn_pure(ctx, fd), "first call computes the verdict")
    assert(bce_fn_pure(ctx, fd), "second call returns the same verdict via the memo")
    cached :: ctx.memo["memo"]
    if cached != null {
        assert(cached, "the memoised verdict is `pure`")
    } else {
        assert(false, "the verdict must have been memoised")
    }
}

@test test_bce_fn_pure_call_to_pure_callee :: fn() -> void {
    leaf_sym :: bce_test_sym(10, "leaf")
    leaf :: bce_test_fn(leaf_sym, bce_test_block([bce_test_pure_return()]))
    caller :: bce_test_fn(bce_test_sym(11, "caller"), bce_test_block([bce_test_call_return(leaf_sym)]))
    ctx :: bce_test_ctx()
    bce_test_register(ctx, leaf)
    assert(bce_fn_pure(ctx, caller), "calling a pure fn keeps the caller pure")
}

@test test_bce_fn_pure_call_to_impure_callee :: fn() -> void {
    leaf_sym :: bce_test_sym(20, "leaf_alloc")
    leaf :: bce_test_fn(leaf_sym, bce_test_block([bce_test_alloc_return()]))
    caller :: bce_test_fn(bce_test_sym(21, "caller_impure"), bce_test_block([bce_test_call_return(leaf_sym)]))
    ctx :: bce_test_ctx()
    bce_test_register(ctx, leaf)
    assert(!bce_fn_pure(ctx, caller), "calling an allocating fn makes the caller impure")
}

@test test_bce_fn_pure_unresolved_callee :: fn() -> void {
    // Callee absent from the ctx (an @extern / unknown fn) : the call is unsafe.
    ghost_sym :: bce_test_sym(30, "ghost")
    caller :: bce_test_fn(bce_test_sym(31, "caller_ghost"), bce_test_block([bce_test_call_return(ghost_sym)]))
    assert(!bce_fn_pure(bce_test_ctx(), caller), "an unresolved callee is treated as impure")
}

@test test_bce_fn_pure_recursive_fn :: fn() -> void {
    // `rec` calls itself : the memo sentinel (impure-on-entry) breaks the cycle and
    // reports it impure rather than recursing forever.
    rec_sym :: bce_test_sym(40, "rec")
    rec :: bce_test_fn(rec_sym, bce_test_block([bce_test_call_return(rec_sym)]))
    ctx :: bce_test_ctx()
    bce_test_register(ctx, rec)
    assert(!bce_fn_pure(ctx, rec), "a recursion cycle is conservatively impure")
}

// A `bce_recheck` `arr.len()` bound over `sym`, as the desugars emit it.
bce_test_recheck_len :: fn(sym: Symbol) -> LoweredArrayLen = LoweredArrayLen {
    .span = empty_span(), .type = TY_VOID,
    .target = LoweredIdent { .span = empty_span(), .type = TY_VOID, .symbol = sym },
    .bce_recheck = true,
}

// A `bce_recheck` `arr[0]` element access over `sym`.
bce_test_recheck_index :: fn(sym: Symbol) -> LoweredIndex = LoweredIndex {
    .span = empty_span(), .type = TY_VOID,
    .target = LoweredIdent { .span = empty_span(), .type = TY_VOID, .symbol = sym },
    .index = LoweredIntLit { .span = empty_span(), .type = TY_VOID, .value = 0 },
    .bce_recheck = true,
}

// A safe counter loop whose only body statement is `idx` (a pure element read).
bce_test_loop_over :: fn(idx: LoweredIndex) -> LoweredStmt = LoweredLoop {
    .span = empty_span(), .label = null, .cond = null,
    .body = bce_test_block([LoweredExprStmt { .span = empty_span(), .expr = idx }]),
    .step = [],
}

// `let len = <recheck arr.len()>` — the preheader bound.
bce_test_len_let :: fn(len: LoweredArrayLen) -> LoweredStmt = LoweredLet {
    .span = empty_span(), .name = "len", .symbol = bce_test_sym(0, "len"),
    .type = TY_VOID, .value = len,
}

@test test_bh_pair_proves_each_sequential_loop :: fn() -> void {
    // Shape of `a.chain(b)`'s fused output : two back-to-back `len(recheck) …
    // loop{ arr[i] recheck }` pairs in one block. bp_pair must prove BOTH, not
    // only the last pair it saw.
    len_a :: bce_test_recheck_len(bce_test_sym(100, "a"))
    len_b :: bce_test_recheck_len(bce_test_sym(101, "b"))
    idx_a :: bce_test_recheck_index(bce_test_sym(100, "a"))
    idx_b :: bce_test_recheck_index(bce_test_sym(101, "b"))
    block :: bce_test_block([
        bce_test_len_let(len_a), bce_test_loop_over(idx_a),
        bce_test_len_let(len_b), bce_test_loop_over(idx_b),
    ])
    bp_pair(block, bce_test_ctx())
    assert(idx_a.bounds_safe, "first loop's element access is marked bounds-safe")
    assert(idx_b.bounds_safe, "second loop's element access is marked bounds-safe")
    assert(!len_a.bce_recheck && !len_b.bce_recheck, "both recheck markers consumed")
}
