// vader/lower/iterator_step: what one `Iterator.next` hands back, and how to
// read it.
//
// `for x in it`, the fusion path and the generator state machine all need the
// same three things: the type `next` returns, the test for "the iteration is
// over", and the element it carries. This file owns them.
//
// A step is `T | Stop`: the element, or the `Stop` that ends the iteration. A
// yielded element is therefore its own step, with nothing to build around it.

module "vader/lower"

import "toolchain/span"
import "vader/core/symbol"
import "vader/core/types"
import "vader/lower/ir"

/// How this project's `Iterator<T>.next` hands a step back.
StepShape :: struct {
    /// The type `next` returns: `T | Stop`.
    type: Type
    /// `T`: the element a step carries.
    element: Type
    /// The `Stop` struct.
    stop: Type
    /// `std/core::STOP`: a synthesised `next` returns it, so its end allocates
    /// nothing and its body needs no GC frame for it.
    stop_value: Symbol
}

/// Resolve the step shape for an iterator over `element`.
///
/// @param ctx      the fn-body context.
/// @param element  the iterator's element type.
/// @return         the shape, or null when std/core declares no `Stop`
///                 (std/core not loaded).
resolve_step_shape :: fn(ctx: FnLowerCtx, element: Type) -> StepShape | null {
    stop :: find_core_type(ctx, STRUCT_STOP, []) ?? return null
    stop_value :: lookup_core_symbol(ctx, CONST_STOP) ?? return null
    return StepShape {
        .type = union_of([element, stop]),
        .element = element,
        .stop = stop,
        .stop_value = stop_value,
    }
}

/// The test that says the iteration is over.
///
/// `step` is evaluated once by the caller (it binds a local first), so naming it
/// twice across this and `step_value` is free.
///
/// @param shape  the resolved step shape.
/// @param step   an expression naming the step: normally a `LoweredIdent`.
/// @param span   the source span to attribute the test to.
/// @return       a `bool`-typed expression.
step_is_done :: fn(shape: StepShape, step: LoweredExpr, span: Span) -> LoweredExpr =
    type_check(step, shape.stop, span)

/// The element `step` carries, read where `step_is_done` said it is not over.
///
/// @param shape  the resolved step shape.
/// @param step   an expression naming the step.
/// @param span   the source span to attribute the read to.
/// @return       an `element`-typed expression.
step_value :: fn(shape: StepShape, step: LoweredExpr, span: Span) -> LoweredExpr = LoweredCast {
    .span = span,
    .type = shape.element,
    .value = step,
}

/// The step a generator returns when it is done: `STOP`, never a fresh
/// `Stop {}`, since an allocation on that cold path would give `next` a GC frame
/// on every call.
///
/// @param ctx    the fn-body context, which records the imported constant.
/// @param shape  the resolved step shape.
/// @param span   the source span.
/// @return       a `Stop`-typed expression.
step_of_done :: fn(ctx: FnLowerCtx, shape: StepShape, span: Span) -> LoweredExpr {
    register_nongeneric_imported_const(ctx, shape.stop_value)
    return LoweredIdent {
        .span = span,
        .type = shape.stop,
        .symbol = shape.stop_value,
    }
}
