// vader/lower/lower_call — call dispatch: virtual, namespace, static, array ops.
//

module "vader/lower"

import "std/collections"

import "toolchain/ast"
import "vader/diagnostics"
import "vader/typecheck"
import "vader/resolver/symbol"
import "vader/types"
import "vader/comptime"
import "vader/resolver"
import "toolchain/span"

// Call lowering : routes through UFCS rewrites (`try_lower_ufcs_call`) and
// generic-fn instance lookups before lowering the callee the typecheck recorded
// (`lower_callee`) + every arg. Special cases :
// - `arr.push(x)` / `arr.len()` route to the dedicated
//   `LoweredArrayPush` / `LoweredArrayLen` ops when the receiver is
//   an array.
// - `<namespace>.foo(args)` where `<namespace>` is an `ImportBinding`
//   ident collapses to a direct `foo(args)` call ; the surrounding
//   namespace prefix is purely a source-level concept.
// Mark every struct in `t` (and its union variants) as "a value of this type
// exists" — the same signal a struct literal records at
// `lower_struct_lit.vader::constructed_struct_symbols.add`. Used at `lower_call`
// entry so a host / `@intrinsic` callee's return struct (`read_file_bytes ->
// u8[] | IOError`) is treated as constructed, making it vtable-eligible for
// `is Trait` + trait-method dispatch without hard-coding the type. Redundant
// (idempotent set add) for a Vader-bodied callee whose producer already marked it.
mark_produced_structs :: fn(t: Type, ctx: FnLowerCtx) -> void {
    // `struct_backing` unwraps a struct-backed distinct newtype too, mirroring
    // the struct-literal path (`lower_struct_lit.vader`).
    st :: struct_backing(t)
    if st != null {
        ctx.project.constructed_struct_symbols.add(st.symbol.id)
        return
    }
    if t is UnionType {
        for v in t.variants { mark_produced_structs(v, ctx) }
    }
}

lower_call :: fn(ctx: FnLowerCtx, call: CallExpr, type: Type) -> LoweredExpr {
    mark_produced_structs(type, ctx)
    // A call to a fn iterating its `Iterator` parameter once, handed a fusible
    // chain, becomes the chain's loop before the call itself is formed.
    // The consumer, the namespace and the cast forms observe their own choice for
    // the callee verifier (`verify_callees.vader`) ; the others are read off the
    // call they produce.
    consumer_form :: try_inline_consumer(ctx, call, type)
    if consumer_form != null { return consumer_form }
    array_form :: try_lower_array_op(ctx, call, type)
    if array_form != null { return observed(ctx, call, .Call, array_form) }
    static_form :: try_lower_static_member_call(ctx, call, type)
    if static_form != null { return observed(ctx, call, .Call, static_form) }
    namespace_form :: try_lower_namespace_call(ctx, call, type)
    if namespace_form != null { return namespace_form }
    cast_form :: try_lower_cast_call(ctx, call, type)
    if cast_form != null { return cast_form }
    vcall_form :: try_lower_virtual_call(ctx, call, type)
    if vcall_form != null { return observed(ctx, call, .Call, vcall_form) }
    ufcs_form :: try_lower_ufcs_call(ctx, call, type)
    if ufcs_form != null { return observed(ctx, call, .Call, ufcs_form) }
    generic_form :: try_lower_generic_fn_call(ctx, call, type)
    if generic_form != null { return observed(ctx, call, .Call, generic_form) }
    callee :: lower_callee(ctx, call)
    mark :: ctx.pending_awaits.len()
    args :: lower_call_args(ctx, call.args, param_types_of(callee.type), 0)
    plain :: LoweredCall {
        .span = call.span,
        .type = type,
        .callee = bind_one_before_hoisted(ctx, callee, mark),
        .args = args,
    }
    return observed(ctx, call, .Call, plain)
}


// `left == right` : the `Equals` of a primitive or an enum, which the comparison
// primop answers.
equals_primop :: fn(left: LoweredExpr, right: LoweredExpr, span: Span) = LoweredBinary {
    .span = span,
    .type = TY_BOOL,
    .op = .Eq,
    .left = left,
    .right = right,
}

// The callee of a plain call : the fn the typecheck recorded, else the callee
// expression itself, a value of fn type.
lower_callee :: fn(ctx: FnLowerCtx, call: CallExpr) -> LoweredExpr {
    symbol :: recorded_fn_symbol(ctx, call) ?? return lower_expr(ctx, call.callee)
    return fn_reference(ctx, symbol, call.callee.span, ctx.types.expr_type(call.callee))
}

/// The parameter types of a callee's fn type.
///
/// @param callee_type  the callee's type ; anything but a fn type has none.
export param_types_of :: fn(callee_type: Type | null) -> Type[] {
    if callee_type is FnType {
        return callee_type.params
    }
    return []
}

/// `Type.member(args)` on a static trait member (`T.zero()`, `i64.zero()`) : a
/// direct call to the owner's impl member, with no receiver. A type-parameter
/// owner only appears in a generic body, whose instances typecheck keeps
/// concrete, so it is a concrete type once substituted.
///
/// @param call  the call ; its callee is the `Type.member` field access.
/// @param type  the call's result type.
/// @return      the lowered call — a trap when typecheck refused the owner (T3006)
///              — or null when the callee is no static member.
try_lower_static_member_call :: fn(
    ctx: FnLowerCtx,
    call: CallExpr,
    type: Type,
) -> LoweredExpr | null {
    field :: as_field_expr(call.callee) ?? return null
    found :: ctx.typed.static_members[field.id] ?? return null
    callee :: recorded_callee(ctx, call, .Call)
    owner :: ctx.types.apply(owner_at_call(callee, found.owner))
    member :: callee_target(ctx, callee, owner)
    // No impl only when typecheck refused the instance's bound (T3006) : lowering
    // still runs so every diagnostic gets reported, and the call becomes a trap.
    if member !is UfcsMember {
        return LoweredUnreachable {
            .span = call.span,
            .type = type,
            .reason = "no impl member `${field.field}` for `${display_type(owner)}`",
        }
    }
    args :: lower_call_args(ctx, call.args, member.arg_types, 0)
    return build_member_call_or_inline(member, args, type, call.span)
}

// The owner a static member call reaches : the written one, with the type parameters
// the call bound (`Bag.make(1)` under `fill<T>` calls `Bag<T>`'s `make`).
owner_at_call :: fn(callee: Callee | null, written: Type) -> Type {
    if callee !is DirectFn {
        return written
    }
    bindings :: callee.bindings ?? return written
    return substitute_map(written, bindings)
}

/// `recv.method(args)` dispatched at run time lowers to a `LoweredVirtualCall` —
/// the bytecode emit dispatches in O(1) via the per-(trait, method) vtable :
/// on a receiver whose lowered type is a `TraitType`, and wherever the typecheck
/// recorded a member of a union or a bound this instance leaves erased.
try_lower_virtual_call :: fn(ctx: FnLowerCtx, call: CallExpr, type: Type) -> LoweredExpr | null {
    callee_field :: as_field_expr(call.callee) ?? return null
    if callee_field is FieldExpr {
        receiver :: lower_expr(ctx, callee_field.target)
        receiver_ty :: receiver.type
        if receiver_ty is TraitType {
            // A `.method()` the typer resolved as a FREE-FN UFCS — a combinator
            // like `it.map(f)` on an erased `Iterator<T>` receiver, where the
            // trait has NO such method — must NOT emit a virtual call (it would
            // dispatch a non-existent `Iterator.map` → runtime miss). Decline so
            // `try_lower_ufcs_call` picks up the free fn. The typer records
            // `ufcs_receiver_types[id]` iff it resolved free-fn UFCS ; a genuine
            // trait method leaves it null → the vcall below still fires.
            if !(ctx.typed.ufcs_receiver_types[callee_field.id] is null) { return null }
            trait_key :: trait_key_of(receiver_ty.symbol)
            return dispatched_method_call(ctx, call, callee_field, receiver, trait_key, type)
        }
        // TypeParam-bounded receiver erased to Any, or a union of the trait's
        // implementors : the typecheck recorded the trait the member belongs to ;
        // route through the runtime vtable so the boxed value's tag picks the impl.
        trait_key :: recorded_dispatch(ctx, call, .Call, receiver_ty)
        if trait_key != null {
            return dispatched_method_call(ctx, call, callee_field, receiver, trait_key, type)
        }
        // Concrete primitive or enum receiver with a bounded-trait method : a
        // generic instance concretised on a primitive K (e.g. `key.equals(other)`
        // in `MutableMap<i32,_>`), or any enum, whose `Equals` is built in.
        // `Equals` is `@intrinsic` on primitives and an enum's `==` is an integer
        // comparison, so devirtualise straight to the comparison primop instead of
        // a `virtual.call` / thunk — the native build has no host binding for an
        // int `equals`. Other trait methods (Hash / Comparable have materialised
        // bodies) fall through to the UFCS direct-call path.
        if kept_type_argument(receiver_ty) != null {
            if runs_builtin_equals(ctx, call) && call.args.len() > 0 {
                mark :: ctx.pending_awaits.len()
                other :: lower_expr(ctx, call.args[0].value)
                return equals_primop(bind_one_before_hoisted(ctx, receiver, mark), other, call.span)
            }
        }
    }
    return null
}

// `call`, whose callee is `field` on `receiver`, as a virtual call through
// `trait_key`.
dispatched_method_call :: fn(
    ctx: FnLowerCtx,
    call: CallExpr,
    field: FieldExpr,
    receiver: LoweredExpr,
    trait_key: string,
    type: Type,
) -> LoweredVirtualCall {
    param_types :: param_types_of(ctx.types.expr_type(call.callee))
    mark :: ctx.pending_awaits.len()
    args :: lower_call_args(ctx, call.args, param_types, 0)
    kept :: bind_one_before_hoisted(ctx, receiver, mark)
    return virtual_call(ctx, trait_key, field.field, kept, args, type, call.span, param_types)
}

// Detect `<namespace_ident>.<member>(args)`. The target ident's
// resolved symbol has kind `ImportBinding` (namespace import). Emit
// a direct call to the imported member by name — the dump format
// shows just the bare callee name for namespace-prefixed calls.
try_lower_namespace_call :: fn(ctx: FnLowerCtx, call: CallExpr, type: Type) -> LoweredExpr | null {
    callee :: call.callee
    if callee is FieldExpr {
        namespace_symbol :: as_namespace_binding(ctx, callee.target) ?? return null
        // `nsM.T(x)` — the typer typed the callee as the metatype and resolved
        // the call as a cast (infer_call → TypeMetaType, call.vader). Lower it as
        // a cast to the result `type` (shared with the direct-ident cast path),
        // not a plain call to the type symbol. Casts carry exactly one arg.
        // NB the ident path (`try_lower_cast_call`) keys on symbol-kind +
        // `alias_types`, NOT this `TypeMetaType` signal: a cross-module distinct
        // const ident does not surface as TypeMetaType there — don't unify them.
        if call.args.len() == 1 {
            if ctx.types.expr_type(callee) is TypeMetaType {
                return emit_value_cast(ctx, call, type)
            }
        }
        member_symbol :: recorded_fn_symbol(ctx, call)
            ?? resolve_namespace_member(ctx, namespace_symbol, callee.field)
        // A GENERIC member (`io.println` → `println<T: Display>`) must harvest
        // its monomorphic instance + point the callee at the mangle, exactly
        // as the direct-ident path does — otherwise the bare member symbol is
        // unresolved at emit (GATE-B1). The member's generic signature lives in
        // its OWN module's `decl_types` (the namespace member-type table holds
        // only type-kind members, not fns), reached cross-module via
        // `lookup_fn_type_anywhere`.
        member_ty :: lookup_fn_type_anywhere(ctx, member_symbol)
        if member_ty is FnType {
            params :: member_ty.params
            generic_form :: emit_generic_fn_call(ctx, call, type, member_symbol, params, callee.span)
            if generic_form != null { return observed(ctx, call, .Call, generic_form) }
        }
        member_callee :: fn_reference(ctx, member_symbol, callee.span, ctx.types.expr_type(callee))
        args :: lower_call_args(ctx, call.args, param_types_of(member_ty), 0)
        member_call :: LoweredCall {
            .span = call.span,
            .type = type,
            .callee = member_callee,
            .args = args,
        }
        return observed(ctx, call, .Call, member_call)
    }
    return null
}

as_ident :: fn(expr: Expr) -> IdentExpr | null {
    if expr is IdentExpr { return expr }
    return null
}

// Resolve `<namespace>.<name>` to the member's REAL symbol in the namespace's
// target module, so emit indexes the call by the member's true id (matching the
// direct-import path via `follow_import_binding`). A bare `id=0` placeholder
// resolved to NEITHER `function_index_by_symbol_id` (id 0) NOR
// `function_index_by_mangle` (the fn is reserved under `<module>$<name>`, never
// the bare name) → unresolved-callee panic at emit. Falls back to the bare
// placeholder when the target module / member can't be located (recovery path).
resolve_namespace_member :: fn(ctx: FnLowerCtx, namespace_symbol: Symbol, name: string) -> Symbol {
    targets :: ctx.typed.import_targets
    if targets is ImportTargetTable {
        mod_id :: targets.namespace_targets[namespace_symbol.id]
        if mod_id != null {
            mod :: ctx.project.loaded.modules[mod_id]
            if mod != null {
                member :: mod.collected.symbols[name]
                if member is Symbol { return member }
            }
        }
    }
    return Symbol {
        .id         = 0,
        .kind       = .Fn,
        .name       = name,
        .module     = ctx.typed.resolved.path,
        .module_name = ctx.typed.resolved.path,
        .visibility = .Private,
        .defined_at = null,
    }
}

// Fold a const symbol to its lowered value : a comptime-baked scalar inlines
// directly ; an imported const the entry-only bake missed recovers via
// `try_fold_unbaked_const`. Returns null for a non-const symbol, or a const
// whose value isn't a foldable scalar — the caller keeps a real reference.
// Shared by `lower_ident` (every ident) and `try_lower_namespace_const`.
fold_const_symbol :: fn(ctx: FnLowerCtx, sym: Symbol, type: Type, span: Span) -> LoweredExpr | null {
    folded :: fold_const_value(ctx, sym, type, span) ?? return null
    // The value carries its own variant's type ; a read typed as a union boxes it,
    // as reading the const's slot would — `==` and `is` dispatch on that type.
    if type is UnionType && !equals_type(folded.type, type) {
        return LoweredCast {
            .span = span,
            .type = type,
            .value = folded,
        }
    }
    return folded
}

// The value `sym` folds to : its comptime-baked scalar, or its literal RHS when the
// bake missed. Null when it does not fold.
fold_const_value :: fn(
    ctx: FnLowerCtx, sym: Symbol, type: Type, span: Span,
) -> LoweredExpr | null {
    baked :: lookup_const_baked_value(ctx, sym)
    if baked == null {
        // Bake missed. Gate on Const kind so the common baked-miss (every
        // local / param read) skips `try_fold_unbaked_const`'s module lookups.
        if sym.kind == .Const { return try_fold_unbaked_const(ctx, sym, type) }
        return null
    }
    // An ARRAY const is never inlined at the use site (which would `array.new` +
    // refill on every read). Returning null leaves a bare const reference that
    // `inline_consts` routes to the data pool — one shared entry, a cheap
    // `data.const` view at each read. Struct consts keep the inline path. Safe vs the pool
    // eligibility check : a const that isn't poolable falls back to `const_inline`
    // (array.new), never to `unreachable`.
    if baked is ArrayValue {
        if type is ArrayType { return null }
    }
    if is_scalar_comptime(baked) { return comptime_value_to_lowered(baked, type, span) }
    return null
}

// `<alias>.CONST` → the const's lowered value. Resolves the member to its real
// const symbol in the namespace's target module, then folds it via the shared
// `fold_const_symbol`. Returns null when the target isn't a namespace binding
// or the member isn't a const — the caller falls through to regular
// field-access lowering. Without this the `alias` ident is unresolved and the
// enclosing expression (a struct literal `.id = AST.UNASSIGNED_NODE_ID`, …)
// degrades to a drop. Mirror of `try_lower_namespace_call` (fn members) /
// `try_lower_enum_field` (namespace enum variants).
// A non-scalar (compound) const reached this way only folds for scalars, so it
// is harvested + referenced by its const symbol on the fold-miss path — see the
// body. This is the namespace-alias analogue of the bare-ident const seam in
// `lower_ident`. Load-bearing under the uniform lazy lowering: any non-entry
// module's compound const reached via `M.CONST` needs the same routing as a
// bare reference (its decl is materialised on demand, not lowered eagerly).
try_lower_namespace_const :: fn(ctx: FnLowerCtx, e: FieldExpr, type: Type) -> LoweredExpr | null {
    ns_sym :: as_namespace_binding(ctx, e.target) ?? return null
    member :: resolve_namespace_member(ctx, ns_sym, e.field)
    if member.kind != .Const { return null }
    folded :: fold_const_symbol(ctx, member, type, e.span)
    if folded != null { return folded }
    // Compound const : the scalar fold missed. Harvest the const so
    // `inline_consts` materialises its decl, and reference it by its const
    // symbol (same shape as the bare-ident seam) so `build_ident` routes the
    // read site — instead of degrading to a field access on the alias.
    register_nongeneric_imported_const(ctx, member)
    return LoweredIdent {
        .span = e.span,
        .type = type,
        .symbol = member,
        .fresh = ctx.reads_fresh_constant(e.id, member),
    }
}


// The parameters of the array member `callee` names, the receiver's first : what
// the arguments of the operation it lowers to go in as.
array_op_params :: fn(ctx: FnLowerCtx, callee: FieldExpr) -> Type[] {
    params: Type[]: [ctx.types.expr_type(callee.target)]
    params.push_all(param_types_of(ctx.types.expr_type(callee)))
    return params
}

// Detect `arr.push(x)` / `arr.len()` and emit the dedicated op. Returns
// null when the receiver isn't an array or the field isn't a recognised
// array intrinsic — caller falls back to the generic call path.
try_lower_array_op :: fn(ctx: FnLowerCtx, call: CallExpr, type: Type) -> LoweredExpr | null {
    callee :: call.callee
    // Only a `recv.field(args)` can be an array op.
    if callee !is FieldExpr {
        return null
    }
    // A free fn typecheck chose is the call, on an array too : in a generic body it
    // chose against the type parameter, and an array instance holds to it.
    if recorded_fn_symbol(ctx, call) != null {
        return null
    }
    // An array receiver, or an array-backed distinct newtype (`array_backing`),
    // carries the array intrinsics : the lowered target is the value itself, which
    // is the backing array at runtime.
    array :: array_backing(ctx.types.expr_type(callee.target)) ?? return null
    if callee.field == "len" && call.args.len() == 0 {
        return LoweredArrayLen {
            .span = call.span,
            .type = type,
            .target = lower_expr(ctx, callee.target),
        }
    }
    if callee.field == "push" && call.args.len() == 1 {
        target :: lower_expr(ctx, callee.target)
        mark :: ctx.pending_awaits.len()
        value :: lower_for_slot(ctx, call.args[0].value, array.element, call.span)
        return LoweredArrayPush {
            .span = call.span,
            .type = TY_VOID,
            .target = bind_one_before_hoisted(ctx, target, mark),
            .value = value,
        }
    }
    // `push_all` / `copy_to` / `remove_last` / `clear` lower to `array.*`
    // intrinsics : the receiver is args[0], the rest are the call args in source
    // order (the bytecode op pops them in reverse). `type` is the typer's result
    // type (void, or `T | null` for remove_last). Backed by parameterless ops : the
    // runtime reads the element kind/tag off the array buf.
    if callee.field == "push_all" && call.args.len() == 1 {
        return LoweredIntrinsicCall {
            .span = call.span,
            .type = type,
            .name = INTRINSIC_ARRAY_PUSH_ALL,
            .args = lower_in_order(ctx, [callee.target, call.args[0].value]),
            .param_types = array_op_params(ctx, callee),
        }
    }
    if callee.field == "copy_to" && call.args.len() == 4 {
        return LoweredIntrinsicCall {
            .span = call.span,
            .type = type,
            .name = INTRINSIC_ARRAY_COPY,
            .args = lower_in_order(ctx, [
                callee.target,
                call.args[0].value,
                call.args[1].value,
                call.args[2].value,
                call.args[3].value,
            ]),
            .param_types = array_op_params(ctx, callee),
        }
    }
    if callee.field == "remove_last" && call.args.len() == 0 {
        return LoweredIntrinsicCall {
            .span = call.span,
            .type = type,
            .name = INTRINSIC_ARRAY_REMOVE_LAST,
            .args = [lower_expr(ctx, callee.target)],
        }
    }
    if callee.field == "clear" && call.args.len() == 0 {
        return LoweredIntrinsicCall {
            .span = call.span,
            .type = type,
            .name = INTRINSIC_ARRAY_CLEAR,
            .args = [lower_expr(ctx, callee.target)],
        }
    }
    return null
}
