// vader/lower/lower: project-level lowerer orchestrator.
//
// Walks every top-level decl across the project's typed modules, builds a
// stub `MonoEntry` per non-generic decl, and dispatches to the per-decl-kind
// lowerer.
//
// The orchestrator takes `LoadedProject` (for source decls) +
// `TypedProject` (for typed side-tables) + `EvaluatedProject` (for
// comptime values + mono entries). The heavy lifting lives in sibling
// files of this same `vader/lower` module : table population
// (populate.vader), per-decl lowering (decl.vader), generic instance
// materialization (mono_fn.vader, mono_struct.vader), substitutions and
// mangling (subst.vader), stdlib/intrinsic extern surfacing (stdlib.vader),
// and vtable / output assembly (finish.vader). The IR it produces is
// `vader/lower/ir`.

module "vader/lower"

import "std/collections"
import "std/io"
import "std/sort"
import "std/string_builder"
import "vader/lower/ir"
import "vader/lower/optimise"

import "vader/support/diagnostics"
import "toolchain/ast"
import "vader/front/resolver"
import "vader/front/typecheck"
import "vader/front/comptime"
import "vader/core/symbol"

/// Lower every module's top-level decls into a `LoweredProject`.
/// @param loaded     the loaded project (for source decls per module).
/// @param typed      the typed project (for side-tables).
/// @param evaluated  the comptime engine's output.
/// @param diags      diagnostics emitted by the lowerer (L5xxx codes).
/// @return           the lowered project ready for downstream phases.
export lower_project :: fn(
    loaded: LoadedProject, typed: TypedProject, evaluated: EvaluatedProject, diags: Diagnostic[],
) -> LoweredProject = lower_project_impl(loaded, typed, evaluated, [], diags)

/// VM-backed-comptime staging variant : lower ONLY the closure reachable from
/// `eager_modules` (the modules owning `vm_required` @comptime consts) instead
/// of the whole entry-rooted project, and skip the whole-project generic-struct
/// materialization. The eager modules' un-baked consts inline their RHS call at
/// each use site (the standard staging trick), so the nullary callee thunks land
/// in the harvest and are lowered. The result is a throwaway bytecode module used
/// only to VM-execute those callees, see `pipeline/comptime_vm/resolve.vader`.
///
/// @param eager_modules  module ids to lower eagerly (with bodies) ; every other
///                       module surfaces bodyless signatures only. Must be
///                       non-empty (use `lower_project` for the whole project).
export lower_project_staged :: fn(
    loaded: LoadedProject, typed: TypedProject, evaluated: EvaluatedProject,
    eager_modules: string[], diags: Diagnostic[],
) -> LoweredProject = lower_project_impl(loaded, typed, evaluated, eager_modules, diags)

lower_project_impl :: fn(
    loaded: LoadedProject, typed: TypedProject, evaluated: EvaluatedProject,
    eager_modules: string[], diags: Diagnostic[],
) -> LoweredProject {
    // Staging mode narrows the eager (with-body) set from the single entry to
    // `eager_modules`; the whole-project generic-struct materialization is
    // skipped since the comptime callee closure (bigint kernels) needs none.
    is_staging :: eager_modules.len() > 0
    project_ctx :: new_lower_project_ctx(evaluated, loaded, typed)
    // Populate the lowerer's core-symbol cache directly from the std/core
    // module (one seed). Lookups like `find_core_type("Yield", [T])` go
    // through this cache.
    populate_core_symbols(loaded, project_ctx)
    // Build the global symbol_id -> ComptimeValue index so per-ident
    // const-baked lookups (`lookup_const_baked_value`) hit O(1) instead
    // of walking every loaded module's `comptime_decls` map per call.
    populate_comptime_value_index(project_ctx)
    // Build the project-wide impl registry: aggregate every module's
    // `T implements Trait { … }` decls so downstream phases can query
    // by `(for_type, trait_name)`. Unblocks Display dispatch for
    // string interp, try for non-primitive Error variants, and the
    // for-in / Iterator step loop.
    populate_impls(loaded, typed, project_ctx)
    populate_fn_symbols(typed, project_ctx)
    project :: new_lowered_project()
    project.entry = loaded.entry
    project.libraries = evaluated.libraries
    // Seed runtime `is Trait` membership from the frontend's id-keyed map, which
    // holds the impls of the whole project. The emitter turns this into
    // `impl_table` rows per interned struct tag (`build_impl_table_from_vtable`).
    entry_typed :: typed.modules[loaded.entry]
    if entry_typed != null {
        project.trait_membership = entry_typed.impl_tables.struct_traits_by_sym
    }

    module_ids :: typed.modules.keys()
    // Every module lowered with its bodies is marked before any is lowered : a
    // call from one into another must not queue for the call-site harvest a
    // function the eager walk lowers as well.
    for module_id in module_ids {
        if is_eager_module(module_id, loaded, eager_modules) {
            seed_eager_module(project_ctx, loaded.modules[module_id] ?? continue)
        }
    }
    for module_id in module_ids {
        // EVERY non-entry module is lowered lazily : don't lower its with-body
        // fns up front (would bloat the project + pollute the synthetic-id
        // counter), but DO surface every bodyless fn signature (`@extern` /
        // intrinsic / declared-only) so the bytecode emitter registers them in
        // the import table. Without this, calls to `byte_len` / `println` / …
        // fall through `emit_call_to_symbol` without hitting the CallImport
        // branch and silently drop. Referenced with-body fns / consts / impl
        // members are materialised on demand by the harvest fixpoint below ;
        // the whole-program DCE (`prune_unreachable_fns`) culls the rest.
        //
        // Only the ENTRY module is lowered eagerly (with bodies): it is the
        // code under test / built, so its `main` / `@test` / exported surface
        // must survive whether or not it is reached. This is uniform across
        // stdlib and user modules : the same lazy path serves both. In staging
        // mode the eager set is the vm_required-owning modules rather than the
        // single entry: every other module stays bodyless.
        if !is_eager_module(module_id, loaded, eager_modules) {
            imported_loaded :: loaded.modules[module_id]
            imported_typed_opt :: typed.modules[module_id]
            imported_decls: LoweredDecl[]: []
            if imported_loaded is LoadedModule {
                if imported_typed_opt is TypedProgram {
                    for d in module_decls(imported_loaded) {
                        if d is FnDecl {
                            if d.body is null && d.type_params.len() == 0 {
                                synth_start :: project_ctx.synth_decls.len()
                                lowered :: lower_fn_decl(d, imported_typed_opt, project_ctx, diags)
                                // An `@extern` taking an enum with variant data
                                // leaves its import here.
                                synth :: project_ctx.synth_decls
                                imported_decls.push_all(synth[synth_start..<synth.len()])
                                if lowered != null {
                                    imported_decls.push(lowered)
                                    // Pre-seed the call-site harvest's seen-set so
                                    // `materialize_nongeneric_imported_fns` doesn't
                                    // emit a duplicate decl for the same symbol.
                                    seed_fn_seen(project_ctx, d)
                                }
                            }
                        }
                    }
                }
                project.modules[module_id] = LoweredModule {
                    .module_id    = module_id,
                    .display_path = imported_loaded.module.display_path,
                    .decls        = imported_decls,
                }
            }
            continue
        }
        module_typed :: typed.modules[module_id] ?? continue
        module_loaded :: loaded.modules[module_id] ?? continue
        decls :: module_decls(module_loaded)
        display_path :: module_loaded.module.display_path
        lowered_module :: lower_module(module_id, display_path, module_typed, decls, project_ctx, diags)
        project.modules[module_id] = lowered_module
    }
    // Generic-fn instances + non-generic stdlib free fns are MUTUALLY
    // recursive : a generic instance body calls stdlib fns (harvested into
    // `nongeneric_imported_order`), and a harvested stdlib body calls generic
    // fns (registered into `fn_instances_order`, e.g. `std/json::write_object`
    // → `MutableMap.len`). Drain all the queues in ONE joint fixpoint until
    // none grows : each pass resumes from its own persistent cursor, so
    // re-entry only processes newly-registered work (`drain_generic_fn_instances`
    // builds into `generic_collected` ; `materialize_nongeneric_imported_fns`
    // resumes from `nongeneric_imported_cursor` ; `surface_*` dedupes via
    // `materialized_impl_keys`). A pre-fixpoint single generic pass would
    // strand any instance a later stdlib-harvest round registers (a `len__...`
    // callee left unresolved at emit). The generic instances are
    // FLUSHED (sorted + erasure-deduped + pushed) once after convergence so
    // emission order is a single deterministic sort.
    // All four queues are append-only (the three arrays) / add-only (the mangle
    // set), so their combined length strictly increases until the joint fixpoint
    // settles: loop until the total stops growing.
    prev_total: i64 = 0
    draining := true
    for draining {
        drain_generic_fn_instances(typed, project_ctx, project, diags)
        materialize_nongeneric_imported_fns(typed, project_ctx, project, diags)
        materialize_nongeneric_imported_consts(typed, project_ctx, project, diags)
        materialize_enum_tables(typed, project_ctx, project)
        surface_referenced_intrinsic_externs(loaded, typed, project_ctx, project)
        cur_total :: project_ctx.fn_instances_order.len() +
            project_ctx.pending_generic_impl_recv.len() +
            project_ctx.member_instances.len() +
            project_ctx.nongeneric_imported_order.len() +
            project_ctx.nongeneric_imported_const_order.len() +
            project_ctx.enum_table_order.len() +
            project_ctx.referenced_impl_mangles.len() +
            project_ctx.virtually_dispatched_traits.len() +
            project_ctx.constructed_struct_symbols.len()
        if cur_total == prev_total { draining = false } else { prev_total = cur_total }
    }
    // INVARIANT : anything that can register a generic fn instance or harvest a
    // non-generic stdlib fn MUST run inside the loop above: the flush is
    // one-shot, so a post-flush registration is stranded (the bug this closes).
    // `close_over_field_shapes` below only pushes struct decls (no body
    // lowering), so it registers nothing: keep it that way.
    flush_generic_fn_instances(project_ctx, project)
    // Transitively materialise generic-struct shapes referenced by the
    // types of the decls emitted above, e.g. `MutableSet<i32>`'s erased
    // `inner: MutableMap<Any, bool>`:
    // otherwise the bytecode interner mints an orphan `ref` for them.
    close_over_field_shapes(typed, project_ctx, project)
    // Place the project-global synthesised decls (`concat_N`, field-default
    // thunks) into the entry module: ONCE, unconditionally. They can't ride the
    // per-window `synth_decls` drain (a deduped generic instance's window is
    // skipped, which would strand one first synthesised inside it). Runs after
    // the fixpoint so every synthesised decl is collected.
    drain_entry_decls(project_ctx, project)
    // Drain per-fn lower diagnostics pushed to `project_ctx.diags`
    // (e.g. M5001 from `lower_for_in`) into the caller-owned sink so
    // they reach `# Diagnostics` in the CLI dump.
    for d in project_ctx.diags { diags.push(d) }
    // Before `collect_vtable_entries` : it moves each guarded `Equals` slot from the
    // impl onto its guard.
    guard_equals_slots(project, project_ctx)
    // Collect vtable entries from impl members. Without this,
    // `BcModule.impl_table` is always empty and `impl TYPE_ID TRAIT_NAME`
    // directives never land in the .virt: the runtime falls back to
    // mangle-keyed dispatch.
    project.vtable_entries = collect_vtable_entries(project)
    // Devirtualize calls through a fn-value local (`let f = named_fn ; … f(x) …`) to
    // direct calls to the concrete fn: kills the erased-fn-value indirect+boxed
    // dispatch (the `.map(f).filter(p)` iterator-fusion regression). The direct
    // calls it produces are what `push_cache_tag` needs to see a pure callback.
    devirtualize_fn_refs(project)
    // Route non-scalar const decls to their read sites : bulky array consts
    // become synthetic `__const_<name>` accessor fns (resolved by a `call` in
    // `build_ident`), every other const is recorded for inline rebuild. Runs
    // last so it sees every materialised decl. It mints its accessor ids from
    // the SAME live `next_synthetic_id` counter (via `project_ctx`) so they
    // never collide with a lowering-synthetic fn-decl id (lambda / defer /
    // `concat_N`). See `inline_consts.vader`.
    inline_consts(project, project_ctx, !is_staging)
    // After `inline_consts`, which adds a slot per constant it guards.
    project.globals = project_ctx.globals
    // Mark the pushes whose loop can keep the array's state in locals. See
    // `vader/lower/optimise/push_cache.vader`.
    push_cache_tag(project)
    // `$VADER_OPT_REPORT`: what handed over to the general path
    // (`opt_report.vader`), then what a value ABI would reach
    // (`value_abi_report.vader`) ; `$VADER_VERIFY_CALLEES`, where the lowering chose
    // another callee than the typecheck's record (`verify_callees.vader`). Each
    // reads the FINISHED project, so they run after every pass that can still add
    // a decl, and each returns "" when its report is off.
    //
    // Not on the staging run: `lower_project_staged` lowers a throwaway partial
    // project for the comptime VM, and reporting on it prints a second set of
    // numbers that describe nothing a user built.
    if !is_staging {
        emit_report(render_opt_report(project_ctx))
        emit_report(render_value_abi_report(project_ctx, project, typed))
        emit_report(render_callee_report(project_ctx))
    }
    // Last, so the passes above that rewrite a `let`'s value in place are checked too.
    verify_captured_cells(project, project_ctx.closures.cell_symbols, diags)
    verify_functions_defined_once(project, diags)
    if !is_staging {
        check_extern_symbols(loaded, evaluated.libraries, diags)
    }
    return project
}

// Print a report to stderr, unless it is the empty string every renderer returns
// when the report is off.
emit_report :: fn(report: string) -> void {
    if report != "" {
        eprintln(report)
    }
}

// Per-module driver. Walks the decl list, dispatches by kind, and
// builds the resulting `LoweredModule`. Lambda-lifted synth decls
// accumulated on `project_ctx.synth_decls` during the walk get drained
// into this module's `decls` list: they were spawned while lowering
// this module's bodies, so they ship alongside the regular decls.
lower_module :: fn(
    module_id: string, display_path: string, typed: TypedProgram, decls: Decl[],
    project_ctx: LowerProjectCtx, diags: Diagnostic[],
) -> LoweredModule {
    out_decls: LoweredDecl[]: []
    // First pass : every regular decl in source order. Impl members
    // surface as a multi-decl list right after their ImplDecl so the
    // dump's per-struct grouping follows source order.
    synth_start :: project_ctx.synth_decls.len()
    for decl in decls {
        results :: lower_decl_list(decl, typed, project_ctx, diags)
        for r in results { out_decls.push(r) }
    }
    // Second pass : drain the lambda-lift synth decls accumulated while
    // walking this module's bodies (lambdas / defers route through
    // `synth_decls`).
    synth_end :: project_ctx.synth_decls.len()
    for i in synth_start..<synth_end {
        out_decls.push(project_ctx.synth_decls[i])
    }
    return LoweredModule {
        .module_id    = module_id,
        .display_path = display_path,
        .decls        = out_decls,
    }
}

/// Per-decl dispatcher returning every LoweredDecl this source decl
/// expands to. Most decls yield 0 or 1 ; ImplDecl yields one entry
/// per member so impl methods land inline (right after the impl) in
/// the dump.
lower_decl_list :: fn(
    decl: Decl, typed: TypedProgram, project_ctx: LowerProjectCtx, diags: Diagnostic[],
) -> LoweredDecl[] {
    if decl is ImplDecl {
        return lower_impl_member_list(decl, typed, project_ctx, diags)
    }
    out: LoweredDecl[]: []
    result :: lower_decl(decl, typed, project_ctx, diags)
    if !(result is null) { out.push(result) }
    return out
}

// Per-decl dispatcher. Routes FnDecl / StructDecl / ConstDecl through
// the matching phase-2 stub ; ImplDecl drains into per-member fn-decl
// entries appended to `project_ctx.synth_decls` so the module driver
// picks them up alongside the regular decls. Every other decl kind
// (Enum, Trait, TypeAlias, Import, Assert) returns null: they don't
// produce runtime slots.
lower_decl :: fn(
    decl: Decl, typed: TypedProgram, project_ctx: LowerProjectCtx, diags: Diagnostic[],
) -> LoweredDecl | null {
    // Only Fn/Struct/Const/Impl produce runtime slots; every other decl kind
    // (Enum, Trait, TypeAlias, Import, Assert) lowers to null.
    match decl {
        is FnDecl     -> { return lower_fn_decl(decl, typed, project_ctx, diags) }
        is StructDecl -> { return lower_struct_decl(decl, typed, project_ctx, diags) }
        is ConstDecl  -> { return lower_const_decl(decl, typed, project_ctx, diags) }
        is ImplDecl   -> {
            lower_impl_members(decl, typed, project_ctx, diags)
            return null
        }
        is EnumDecl | TraitDecl | TypeAliasDecl | ImportDecl | AssertDecl -> { return null }
    }
}


// The modules lowered with their bodies : the entry, or in staging the modules
// owning a constant the comptime VM evaluates. Every other module is lowered on
// demand, through the call-site harvest.
is_eager_module :: fn(module_id: string, loaded: LoadedProject, eager_modules: string[]) -> bool {
    if eager_modules.len() > 0 {
        return module_id in eager_modules
    }
    return module_id == loaded.entry
}

// Mark a module lowered with its bodies, its non-generic functions and its
// constants, as reached : the call-site harvest (`materialize_nongeneric_imported_*`)
// would otherwise lower one again when a declaration refers to it, re-lifting a
// function's lambdas under fresh ids (the make-closure then misses the surviving
// decl : an unresolved-callee panic at emit) or duplicating a constant.
seed_eager_module :: fn(project_ctx: LowerProjectCtx, module_loaded: LoadedModule) -> void {
    for d in module_decls(module_loaded) {
        if d is FnDecl {
            if d.type_params.len() == 0 {
                seed_fn_seen(project_ctx, d)
            }
        } else if d is ConstDecl {
            sym :: module_loaded.collected.symbols[d.name] ?? continue
            project_ctx.nongeneric_imported_consts[sym.id] = true
        }
    }
}

// Mark a function lowered up front as reached, so the call-site harvest
// (`materialize_nongeneric_imported_fns`) does not lower it again. It is found by
// its declaration : the module's `symbols` keeps one overload per name.
seed_fn_seen :: fn(project_ctx: LowerProjectCtx, d: FnDecl) -> void {
    sym :: project_ctx.fn_symbols[d.id] ?? return
    project_ctx.nongeneric_imported_fns[sym.id] = true
}

module_decls :: fn(module_loaded: LoadedModule) -> Decl[] {
    files :: module_loaded.module.files
    if files.len() == 0 { return [] }
    // Shared concat with the single-file zero-copy fast path.
    return concat_file_decls(files)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"


@test test_lower_empty_project :: fn() -> void {
    loaded :: LoadedProject {
        .entry        = "",
        .modules      = MutableMap<string, LoadedModule> {},
        .factory      = factory_for_test(),
        .project_root = null,
        .diags        = [],
    }
    typed :: new_typed_project(FreshReads {})
    evaluated :: new_evaluated_project(typed)
    diags: Diagnostic[]: []
    project :: lower_project(loaded, typed, evaluated, diags)
    assert_eq(project.modules.len(), 0)
}

factory_for_test :: fn() -> SymbolFactory { return SymbolFactory {} }
