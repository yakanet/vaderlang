// vader/lower/lower_for_in — `for x in iter` lowering.
//
// The generic slow path desugars `for x in <iter> { body }` into the
// Iterator step loop :
//
//   let __iter_n :: <iter, optionally array-wrapped>
//   loop {
//     let __step_m :: <iter>.Iterator.next()
//     if __step_m._1 == Continuation.Stop { break }
//     let x :: __step_m._0
//     <body>
//   }
//
// and auto-wraps `T[]` iterators through `Into<Iterator<T>>` so the loop
// dispatches through the standard Iterator impl. Before falling back to
// it, `lower_for_in` tries a series of fast paths that bypass the
// Iterator dispatch entirely : `try_lower_chain_fusion` (std/iter
// `map`/`filter` chains over an int range), `try_lower_for_in_int_range`
// (counter loop over `lo..<hi`), `try_lower_for_in_raw_array` (index
// loop over a raw `T[]`), and `try_lower_for_in_map_set` (inlined
// bucket walk over `MutableMap` / `MutableSet`).

module "vader/lower"

import "std/collections"
import "vader/diagnostics"
AST :: import "toolchain/ast"
import "vader/resolver/symbol"
import "vader/typecheck"
import "vader/types"
import "toolchain/span"

/// Lower a `for x in iter { body }` statement to a step-loop driven
/// by the `Iterator<T>.next()` dispatch.
/// @param ctx          the fn-body context.
/// @param for_stmt     the source for-stmt (carries label + body).
/// @param in_form      the iter binding + iter expression.
/// @param recurse      callback to lower nested expressions.
/// @param block_lowerer callback to lower the body block (cycle break).
/// @return             the lowered stmt (a block wrapping the loop).
export lower_for_in :: fn(
    ctx: FnLowerCtx!, for_stmt: AST.ForStmt, in_form: AST.InFor,
    recurse: fn(FnLowerCtx!, AST.Expr) -> LoweredExpr,
    block_lowerer: fn(FnLowerCtx!, AST.BlockExpr, bool, usize | null) -> LoweredBlock,
) -> LoweredStmt {
    span :: for_stmt.span
    // Fast path : `for x in <chain>` where `<chain>` is one or more
    // `std/iter` lazy combinators (`map` / `filter` / …, all generators)
    // wrapping a literal integer range — fuse
    // the whole pipeline into a single counter loop. Skipped when the
    // bottom isn't an int range, when any layer references its source
    // via a variable, or when a `f` / `pred` field isn't a bare fn
    // reference (the slow path handles those).
    chain_form :: try_lower_chain_fusion(ctx, for_stmt, in_form, recurse, block_lowerer)
    if chain_form != null { return chain_form }
    // Fast path : `for v in gen(args)` where `gen` is a directly-called
    // `generator` — inline its yield-loop with the consumer body as the
    // `yield` sink (Couche 4), skipping the state-machine struct + virtual
    // `next()`. Falls through when the callee isn't a recognised generator.
    gen_inline :: try_lower_generator_inline(ctx, for_stmt, in_form, recurse, block_lowerer)
    if gen_inline != null { return gen_inline }
    // Fast path : `for x in lo..<hi` / `for x in lo..=hi` over an
    // integer range lowers to a direct counter loop ; no Range
    // allocation, no `Iterator.next` dispatch. Falls through to the
    // slow path when the range bound isn't an integer.
    int_range :: try_lower_for_in_int_range(ctx, for_stmt, in_form, recurse, block_lowerer)
    if int_range != null { return int_range }
    iter_lowered_raw :: recurse(ctx, in_form.iter)
    iter_type_raw :: type_of(iter_lowered_raw)

    // Fast path : `for x in arr` over a raw `T[]` lowers to a counter
    // loop with index lookup. No iterator object, no per-iter virtual call.
    // Falls through to the slow path when the iter type isn't a plain array.
    raw_array :: try_lower_for_in_raw_array(ctx, for_stmt, in_form, iter_lowered_raw, iter_type_raw, recurse, block_lowerer)
    if raw_array != null { return raw_array }

    // Fast path : `for entry in m` over `MutableMap<K, V>` (or
    // `for v in s` over `MutableSet<T>`) inlines the bucket-walk +
    // chain-traversal, skipping the iterator allocation and the per-iter
    // `next()` call.
    map_set :: try_lower_for_in_map_set(ctx, for_stmt, in_form, iter_lowered_raw, iter_type_raw, span, block_lowerer)
    if map_set != null { return map_set }

    // THE FALL. Every fast path above declined, so this `for` steps the `Iterator`
    // impl: one `next()` call per iteration instead of an inlined loop. That is
    // correct and it is what the language promises — but it is also the single
    // point where the recognisers stop, so it is the one worth counting.
    //
    // Say what is actually left, and no more. The call is usually a DIRECT one
    // (the receiver's concrete type is known by the time the backend emits it),
    // and the step pair usually crosses in registers (`midir/value_return`) —
    // a reader told "vtable" or "allocation" goes looking for something that is
    // not in the C.
    record_miss(ctx.project, "for-in fusion", span,
        "stepping `${display_type(iter_type_raw)}` through its `Iterator` impl — "
        + "one `next()` per iteration instead of an inlined loop (the call itself "
        + "is usually devirtualised, and the step pair usually crosses in "
        + "registers); the fast paths cover an int range, a raw `T[]`, a map / "
        + "set, a fusible combinator chain and a direct generator")

    // A bare `string` has no `next()` to dispatch on: give the step-loop the
    // concrete `StringChars` instead.
    wrap_result :: wrap_string_iter(ctx, iter_lowered_raw, iter_type_raw, span)
    iter_lowered :: wrap_result.iter
    iter_type_wrapped :: wrap_result.iter_type
    element_type :: resolve_element_type(ctx, iter_type_raw, iter_type_wrapped, loop_var_type_key(in_form.loop_var, for_stmt.span))
    // Direction A : an escaping `generator` result is typed as its concrete
    // `__genstate_<fn>` struct so combinator chains resolve at typecheck. When the
    // for-in DIDN'T fuse (the fusion fast paths above declined), erase it back to
    // `Iterator<element>` for the step loop so dispatch goes through the proven
    // virtual `Iterator::next` vtable path (as before Direction A) rather than a
    // devirtualized direct call to the state-machine `next` — whose synth decl the
    // DCE prunes when it isn't reached by a symbol edge.
    iter_type :: erase_genstate_for_dispatch(ctx, iter_type_wrapped, element_type)

    // No `Iterator` dispatch is reachable from the step loop for a primitive or a
    // union : emit a single `unreachable` rather than a `next()` nothing
    // materialised. The typechecker refused the receiver (T3088) unless it was a
    // type parameter or `Self`, only known here per instance, or a string, which
    // iterates only when its `Iterator` impl is in scope — those are M5001.
    if iter_type is PrimitiveType | UnionType {
        checked :: ctx.types.raw_expr_type(in_form.iter)
        is_string :: iter_type is PrimitiveType && iter_type.name == "string"
        if is_string || checked is TypeParamType | SelfType {
            ctx.project.diags.push(lower_error(.IteratorImplMissing, span,
                "`for x in iter` requires an Iterator impl on ${display_type(iter_type)}"))
        }
        return LoweredExprStmt {
            .span = span,
            .expr = LoweredUnreachable {
                .span = span, .type = TY_VOID,
                .reason = "no Iterator impl on ${display_type(iter_type)}",
            },
        }
    }
    shape :: resolve_step_shape(ctx, element_type)
    if shape is null {
        return LoweredExprStmt {
            .span = span,
            .expr = LoweredUnreachable {
                .span = span, .type = TY_VOID,
                .reason = "for-in needs an `Iterator` step type from std/core",
            },
        }
    }
    lb :: resolve_loop_binding(ctx, in_form.loop_var, span)

    iter_symbol :: fresh_synthetic_symbol(ctx, "iter")
    step_symbol :: fresh_synthetic_symbol(ctx, "step")
    step_type :: shape.type

    iter_let :: LoweredLet {
        .span = span, .name = iter_symbol.name, .symbol = iter_symbol,
        .type = iter_type, .value = iter_lowered,
    }

    iter_ref :: LoweredIdent { .span = span, .type = iter_type, .symbol = iter_symbol }
    step_call :: build_step_call(ctx, iter_ref, iter_type, step_type, span)
    step_let :: LoweredLet {
        .span = span, .name = step_symbol.name, .symbol = step_symbol,
        .type = step_type, .value = step_call,
    }

    step_ref :: LoweredIdent { .span = span, .type = step_type, .symbol = step_symbol }
    is_done :: step_is_done(shape, step_ref, span, ctx)
    value_access :: step_value(shape, step_ref, span)
    bind_stmts :: bind_loop_var(ctx, lb.symbol, lb.name, lb.pattern, value_access, element_type, span)

    user_body :: block_lowerer(ctx, for_stmt.body, false, for_stmt.id)
    body_stmts :: build_body_stmts(bind_stmts, user_body)

    branch_if :: LoweredExprStmt {
        .span = span,
        .expr = LoweredIf {
            .span = span, .type = TY_VOID,
            .cond = is_done,
            .then_block = LoweredBlock {
                .span = span, .type = TY_VOID,
                .stmts = build_break_stmts(span), .trailing = null,
            },
            .else_block = LoweredBlock {
                .span = span, .type = TY_VOID, .stmts = body_stmts, .trailing = null,
            },
        },
    }

    loop_stmts: LoweredStmt[]!: []
    loop_stmts.push(step_let)
    loop_stmts.push(branch_if)

    loop_stmt :: LoweredLoop {
        .span = span, .label = resolve_loop_label(ctx, for_stmt), .cond = null,
        .body = LoweredBlock {
            .span = span, .type = TY_VOID, .stmts = loop_stmts, .trailing = null,
        },
        .step = [],
    }

    block_stmts: LoweredStmt[]!: []
    block_stmts.push(iter_let)
    block_stmts.push(loop_stmt)
    return LoweredExprStmt {
        .span = span,
        .expr = LoweredBlock {
            .span = span, .type = TY_VOID,
            .stmts = block_stmts, .trailing = null,
        },
    }
}


// The label to stamp on a for-in `LoweredLoop`. A `break <var>` resolved to this
// loop by its iteration variable recorded that variable in `loop_target_labels`
// (typecheck) ; the break carries the same name, so stamping it here makes the
// backend / block-split resolve the jump. Otherwise the loop keeps its pristine
// user label (`name:` prefix, usually null for a for-in — see W0010).
resolve_loop_label :: fn(ctx: FnLowerCtx, for_stmt: AST.ForStmt) -> string | null {
    injected :: ctx.typed.loop_target_labels[for_stmt.id]
    return instance_label(ctx, if injected != null { injected } else { for_stmt.label })
}

build_break_stmts :: fn(span: Span) -> LoweredStmt[] {
    out: LoweredStmt[]!: []
    out.push(LoweredBreak { .span = span, .label = null })
    return out
}

// Build the per-iteration loop-var binding stmt(s). A plain `for x in …` yields
// a single `let`, cell-promoted when a body closure captures it (mints a fresh
// cell each iteration so each closure sees its own value ; `lower_cell_init` is a
// no-op when uncaptured, the shape every for-in binding site uses). A
// destructuring `for [k, v] in …` (`pattern != null`) binds the element to a temp
// then destructures it into the pattern leaves — the exact shape a
// `let [k, v] := <element>` lowers to (reuses `emit_let_binding_leaves` ; the k/v
// symbols were minted by the resolver). Returns a list so every bind site splices it.
bind_loop_var :: fn(
    ctx: FnLowerCtx!, binding_symbol: Symbol, name: string, pattern: AST.LetBinding | null,
    value: LoweredExpr, value_type: Type, span: Span,
) -> LoweredStmt[] {
    out: LoweredStmt[]!: []
    if pattern is AST.TupleBinding {
        elem_sym :: fresh_synthetic_symbol(ctx, "for_elem")
        out.push(LoweredLet {
            .span = span, .name = elem_sym.name, .symbol = elem_sym,
            .type = value_type, .value = value,
        })
        out.push_all(emit_for_pattern_destructure(ctx, pattern, elem_sym, value_type, span))
        return out
    }
    out.push(cell_aware_let(ctx, binding_symbol, name, value, value_type, span))
    return out
}

// The `let <pattern> := <elem_sym>` destructure stmts for a `for [k, v]` loop
// variable — the leaves the resolver minted for the pattern, bound to the
// element temp's fields (reuses the let-destructure emission). MUST run in the
// ctx that resolved the pattern's leaves (the CONSUMER's fn-ctx) : the generator
// fusion path pre-lowers this into the sink body there, since the sink itself is
// spliced in the generator's own ctx where those leaf symbols don't resolve.
export emit_for_pattern_destructure :: fn(
    ctx: FnLowerCtx!, tup: AST.TupleBinding, elem_sym: Symbol, elem_type: Type, span: Span,
) -> LoweredStmt[] {
    out: LoweredStmt[]!: []
    elem_ref :: LoweredIdent { .span = span, .type = elem_type, .symbol = elem_sym }
    emit_let_binding_leaves(ctx, tup, elem_ref, elem_type, span, out)
    return out
}

build_body_stmts :: fn(bind_stmts: LoweredStmt[], user_body: LoweredBlock) -> LoweredStmt[] {
    out: LoweredStmt[]!: []
    out.push_all(bind_stmts)
    for stmt in user_body.stmts { out.push(stmt) }
    if user_body.trailing is null { return out }
    out.push(LoweredExprStmt { .span = span_of(user_body.trailing), .expr = user_body.trailing })
    return out
}

WrapResult :: struct {
    iter:      LoweredExpr
    iter_type: Type
}

// `string` → `StringChars`, via a synthesised `chars(s)` call.
//
// `string` implements `Into<Iterator<char>>`, but routing through `into()` hands
// back the ERASED `Iterator<char>` trait; calling `chars` keeps the concrete
// `StringChars`, which `build_step_call`'s StructType path resolves — so
// `for c in s` lowers like `for c in s.chars()`.
//
// Returns the input verbatim when it is not a string, or when `chars` is out of
// reach.
wrap_string_iter :: fn(
    ctx: FnLowerCtx!, iter: LoweredExpr, iter_type: Type, span: Span,
) -> WrapResult {
    unwrapped :: WrapResult { .iter = iter, .iter_type = iter_type }
    if iter_type !is PrimitiveType {
        return unwrapped
    }
    if iter_type.name != "string" {
        return unwrapped
    }
    chars_member :: find_free_fn_ufcs(ctx, iter_type, "chars") ?? return unwrapped
    chars_fn_ty :: lookup_fn_type_anywhere(ctx, chars_member.symbol)
    if chars_fn_ty !is FnType {
        return unwrapped
    }
    // The synthesised call bypasses `lower_call`, so harvest `chars` ourselves —
    // its owning module (`std/string`) is lowered lazily, and nothing else
    // references this non-generic free fn unless the surrounding code happens to
    // call `.chars()` explicitly. Without this the call resolves to no fn-table
    // entry → GATE B1 at emit.
    register_nongeneric_imported_fn(ctx, chars_member.symbol)
    chars_call :: LoweredCall {
        .span = span, .type = chars_fn_ty.return_type,
        .callee = LoweredIdent {
            .span = span, .type = chars_fn_ty.return_type,
            .symbol = chars_member.symbol,
        },
        .args = [iter],
    }
    return WrapResult { .iter = chars_call, .iter_type = chars_fn_ty.return_type }
}

// Determine the element type yielded by the iterator. Tries :
// 0. The type the typer already bound to the loop variable, stored under
//    its span in `local_types`. This is authoritative : the typer resolves
//    the `Iterator<T>` impl and substitutes the iterator's concrete type
//    args, so it correctly handles combinators whose element type is NOT
//    the first type arg — a `map` generator over `i32` yields `U` (the impl's
//    `Iterator<U>`), not the source `i32` ; a `MutableMap` iterator yields
//    `Entry<K, V>`. The structural heuristics below cannot, so they must
//    only run when the typer left no usable entry.
// 1. The raw iter type's first type-arg (`Range<T>`, a user iterator).
// 2. `typed.iter_element_types[display_type(raw_iter_type)]` — written
//    by the typecheck when checking the Iterator impl.
// 3. Falls back to TY_UNRESOLVED so the lowered loop still emits a
//    well-formed shape (the typer's earlier diagnostics already
//    surfaced the missing impl).
resolve_element_type :: fn(ctx: FnLowerCtx, raw_iter_type: Type, iter_type: Type, binding_key: u64) -> Type {
    from_typed_binding :: concrete_local_type(ctx.types, binding_key)
    if !(from_typed_binding is null) {
        return from_typed_binding
    }
    match iter_type {
        is StructType -> {
            if iter_type.args.len() > 0 { return iter_type.args[0] }
        }
        _ -> {}
    }
    match raw_iter_type {
        is StructType -> {
            if raw_iter_type.args.len() > 0 { return raw_iter_type.args[0] }
        }
        is TraitType -> {
            if raw_iter_type.args.len() > 0 { return raw_iter_type.args[0] }
        }
        _ -> {}
    }
    side_table_key :: display_type_key(iter_type)
    from_typed :: ctx.typed.iter_element_types[side_table_key]
    if !(from_typed is null) { return from_typed }
    return TY_UNRESOLVED
}

// Erase a concrete `__genstate_<fn>` iterator (a `generator`'s Direction-A call
// result) back to the trait `Iterator<element>`, so an un-fused for-in dispatches
// `next()` virtually through the vtable instead of a devirtualized direct call.
// Non-`__genstate` types (and `__genstate` with an unresolvable Iterator trait
// symbol) pass through unchanged.
//
// Invariant this relies on: the generator fn still RETURNS a boxed `Iterator<U>`
// (its declared return type), so a raw `__genstate` value only ever reaches (a) a
// fusible chain — where it never materialises — or (b) this un-fused for-in. Every
// other consumer (arg / slot / return) boxes it back to `Iterator` at the
// `is_assignable` boundary. If a future pass inspects a generator result's
// concrete type elsewhere, prefer routing it through that shared boundary
// coercion over adding another erase site.
erase_genstate_for_dispatch :: fn(ctx: FnLowerCtx, iter_type: Type, element_type: Type) -> Type {
    if !is_gen_state_struct(iter_type) { return iter_type }
    trait_sym :: find_core_trait(ctx.project, TRAIT_ITERATOR)
    if trait_sym is Symbol { return mk_trait(trait_sym, [element_type]) }
    return iter_type
}

// Build the per-iter `.next()` step call. Trait-typed iter →
// `LoweredVirtualCall` ; concrete struct iter → `LoweredCall` to a
// synth `next` symbol. The bytecode emit resolves the synth callee
// via the impl-member mangling once that wiring lands.
build_step_call :: fn(
    ctx: FnLowerCtx!, iter_ref: LoweredExpr, iter_type: Type, step_union: Type, span: Span,
) -> LoweredExpr {
    match iter_type {
        is TraitType -> {
            if iter_type.symbol.name == TRAIT_ITERATOR {
                args: LoweredExpr[]!: []
                return LoweredVirtualCall {
                    .span = span, .type = step_union,
                    .trait_name = TRAIT_ITERATOR, .method = METHOD_NEXT,
                    .receiver = iter_ref, .args = args, .param_types = [],
                }
            }
        }
        _ -> {}
    }
    // Concrete struct iter (e.g. `Repeat<i32>`) : the impl-member `next`
    // instance is mangled `<module>$<Struct>$Iterator$next<args-suffix>`
    // (mirror of the generic-impl instance materialisation, lower.vader).
    // Carry that mangle so the CFG call emit resolves it via
    // `function_index_by_mangle` instead of dropping a bare-name callee.
    // For multi-instantiation the erasure-dedupe keeps one body under the
    // first instance's suffix ; single-instantiation (the common case)
    // matches exactly. Cross-module user generic-impls would need the
    // impl's owning module (see GATE B1) — caller-module here covers the
    // colocated-struct case.
    method_next :: METHOD_NEXT
    next_name := method_next
    if iter_type is StructType {
        // Resolve the struct's Iterator impl entry. The materialised `next`
        // member is registered under the impl's OWNING module (GATE B1) — not
        // the caller's — so a cross-module iterator (e.g. `std/string`'s
        // `StringChars`, used from any module via `for c in s`) resolves to
        // the same mangle `surface_stdlib_impl_externs` / the generic
        // materialiser emits. Generic impls erase instance args to `__Any` ;
        // concrete-instantiation iterators keep the concrete suffix. Mirror of
        // `find_impl_member_for`.
        owning_module := mangle_module_id(ctx.typed.resolved.display_path)
        is_gen := false
        for entry in ctx.project.impls.all {
            if entry.decl.trait_name != TRAIT_ITERATOR { continue }
            if impl_targets_name(entry.decl.for_type, iter_type.symbol.name) {
                owning_module = mangle_module_id(entry.module)
                is_gen = entry.is_generic
            }
        }
        args :: iter_type.args
        suffix :: if is_gen { mixed_any_suffix(args) } else { args_suffix(args) }
        owner :: iter_type.symbol.name
        next_name = "${owning_module}$${owner}$${TRAIT_ITERATOR}$${method_next}${suffix}"
        // Record the call so the post-lowering pass materialises the (with-body)
        // stdlib impl member instead of dropping the call to the panic fallback.
        ctx.project.referenced_impl_mangles.add(next_name)
    }
    next_symbol :: synth_next_symbol(ctx, next_name)
    args: LoweredExpr[]!: []
    args.push(iter_ref)
    return LoweredCall {
        .span = span, .type = step_union,
        .callee = LoweredIdent {
            .span = span, .type = TY_UNRESOLVED, .symbol = next_symbol,
        },
        .args = args,
    }
}

synth_next_symbol :: fn(ctx: FnLowerCtx, name: string) -> Symbol {
    return Symbol {
        .id         = 0,
        .kind       = .Fn,
        .name       = name,
        .module     = ctx.typed.resolved.path,
        .module_name = ctx.typed.resolved.path,
        .visibility = .Private,
        .defined_at = null,
    }
}

// For-in bindings that the body never references don't appear in
// `resolved.idents` (the use-site map). Synthesize a placeholder
// symbol so the lowered shape stays consistent.
resolve_or_synth_symbol :: fn(ctx: FnLowerCtx!, name: string, span: Span) -> Symbol {
    found :: resolve_binding(ctx, span)
    match found {
        is Symbol -> { return found }
        is null -> {
            // Unused for-binding (never referenced in the body, so absent
            // from `resolved.idents`). Mint a FRESH unique id rather than a
            // shared `0` : the counter is still a real local that drives the
            // loop's increment/condition, and bytecode slots are keyed by
            // symbol id — two nested unused-binding loops both at id 0 would
            // alias one slot, so the outer increment writes the inner's
            // counter and the outer loop never terminates (infinite loop).
            fresh :: fresh_synthetic_symbol(ctx, name)
            return Symbol {
                .id         = fresh.id,
                .kind       = .Local,
                .name       = name,
                .module     = ctx.typed.resolved.path,
                .module_name = ctx.typed.resolved.path,
                .visibility = .Private,
                .defined_at = null,
            }
        }
    }
}

/// The lowering view of a for-loop variable : a single (symbol, name) for a
/// `NamedVar` (or a fresh synth for `DiscardVar`), plus the destructure pattern
/// for a `DestructureVar` (symbol/name are a throwaway placeholder then, since
/// `bind_loop_var` mints its own element temp for the pattern).
LoopBinding :: struct { symbol: Symbol, name: string, pattern: AST.LetBinding | null }

/// Translate an AST `LoopVar` into its lowering `LoopBinding`. Centralises the
/// per-variant resolution so every for-in lowering site (slow / raw-array /
/// int-range / map-set / iter-fusion / generator) stays uniform.
resolve_loop_binding :: fn(ctx: FnLowerCtx!, loop_var: AST.LoopVar, fallback_span: Span) -> LoopBinding {
    match loop_var {
        is AST.NamedVar -> {
            return LoopBinding { .symbol = resolve_or_synth_symbol(ctx, loop_var.name, loop_var.span), .name = loop_var.name, .pattern = null }
        }
        is AST.DestructureVar -> {
            s :: fresh_synthetic_symbol(ctx, "for_pat")
            return LoopBinding { .symbol = s, .name = s.name, .pattern = loop_var.pattern }
        }
        is AST.DiscardVar -> {
            s :: fresh_synthetic_symbol(ctx, "for_discard")
            return LoopBinding { .symbol = s, .name = s.name, .pattern = null }
        }
    }
}

/// The span a for-loop variable is keyed by — the `NamedVar`'s own span, else
/// `fallback` (destructure leaves / discard carry no single binding span).
loop_var_span :: fn(loop_var: AST.LoopVar, fallback: Span) -> Span {
    if loop_var is AST.NamedVar { return loop_var.span }
    return fallback
}

loop_var_type_key :: fn(loop_var: AST.LoopVar, fallback: Span) -> u64 = loop_var_span(loop_var, fallback).hash()


// ---- raw-array fast path --------------------------------------------------

// `for x in arr` over a raw `T[]` lowers to a counter loop with index
// lookup — no iterator object, no per-iter virtual call.
//
// Returns null when the iter type isn't a plain array ; caller falls
// back to the generic step-loop.
// ---- BCE : sound loop-body safepoint probe --------------------------------

// Is this loop body UNSAFE for bounds-check elimination (and for the push cache,
// `push_cache.vader`) ? The body must contain no GC safepoint and no array-length
// mutation. It is UNSAFE if it contains any of —
//   - a CALL (`LoweredCall` / `LoweredVirtualCall` / `LoweredIntrinsicCall`) or a
//     `push` : may allocate (⟹ GC ⟹ the buffer moves) and/or change the length ;
//   - a pure ALLOCATION (`LoweredArrayLit` / `StructLit` / `CellNew` /
//     `MakeClosure` / `ArraySlice` / `StringSlice`) : allocates ⟹ GC ⟹ move —
//     save a tuple literal within the value ABI (`value_abi_type_size`), which
//     crosses in registers (c_emit still re-checks the push cache on the op
//     stream that ships) ;
//   - a SUSPEND point (`yield` / `await`) : on resume a GC may have run, or another
//     task may have mutated the array ;
//   - a `defer` push/pop : may allocate the defer stack / runs arbitrary code.
// Index writes `a[i] = v` and variable rebinds neither allocate nor change length,
// so they stay SAFE. The matches are EXHAUSTIVE, so a new Lowered node can't
// silently pass as "safe" (T3013). Over-approximate : a call/alloc that never
// touches THIS array still bails — refining is a later tier.
// `guard_sym` (or `null` for none) : a symbol whose REBIND (`guard_sym = <expr>`)
// also makes the body unsafe — a length proven for one array says nothing about
// the array rebound in its place. Rebinding is an assignment (a statement), but a
// statement can nest inside an `if` / block expr, so the guard rides the same
// exhaustive walk.
// A CALL is unsafe UNLESS its callee is a fn PROVEN non-allocating (transitively,
// via `bce_fn_pure`) — then the call itself triggers no GC and can't change an
// array's length, so it is treated like a pure operator : the loop stays safe iff
// its ARGS are safe. This is what lets `for x in a.map(square)` (the inlined
// fusion body still calls the pure `square`) qualify, generally, for ANY pure
// callback — no combinator is named. Indirect callees, virtual calls, intrinsics
// and impure/unknown fns still bail. `pctx` carries the project-wide purity memo.
bce_call_unsafe :: fn(x: LoweredCall, guard_sym: i32 | null, pctx: BcePurityCtx!) -> bool {
    if x.callee is LoweredIdent as cid {
        if cid.symbol.kind == .Fn {
            fd :: bce_resolve_fn(pctx, cid.symbol.name, cid.symbol.id)
            if fd != null {
                if bce_fn_pure(pctx, fd) {
                    return bce_any_expr_unsafe(x.args, guard_sym, pctx)
                }
            }
        }
    }
    return true
}

bce_any_expr_unsafe :: fn(
    exprs: LoweredExpr[], guard_sym: i32 | null, pctx: BcePurityCtx!,
) -> bool {
    for e in exprs {
        if bce_expr_unsafe(e, guard_sym, pctx) {
            return true
        }
    }
    return false
}

bce_block_unsafe :: fn(b: LoweredBlock, guard_sym: i32 | null, pctx: BcePurityCtx!) -> bool {
    for st in b.stmts {
        if bce_stmt_unsafe(st, guard_sym, pctx) {
            return true
        }
    }
    trailing :: b.trailing
    if trailing != null {
        return bce_expr_unsafe(trailing, guard_sym, pctx)
    }
    return false
}

bce_opt_expr_unsafe :: fn(
    e: LoweredExpr | null, guard_sym: i32 | null, pctx: BcePurityCtx!,
) -> bool {
    if e == null {
        return false
    }
    return bce_expr_unsafe(e, guard_sym, pctx)
}

bce_is_reassign :: fn(target: LoweredExpr, guard_sym: i32 | null) -> bool =
    target is LoweredIdent && guard_sym != null && target.symbol.id == guard_sym

bce_stmt_unsafe :: fn(
    s: LoweredStmt, guard_sym: i32 | null, pctx: BcePurityCtx!,
) -> bool = match s {
    is LoweredLet          -> bce_expr_unsafe(s.value, guard_sym, pctx)
    is LoweredAssign       -> bce_is_reassign(s.target, guard_sym) || bce_expr_unsafe(s.target, guard_sym, pctx) || bce_expr_unsafe(s.value, guard_sym, pctx)
    is LoweredCellSet      -> bce_expr_unsafe(s.target, guard_sym, pctx) || bce_expr_unsafe(s.value, guard_sym, pctx)
    is LoweredExprStmt     -> bce_expr_unsafe(s.expr, guard_sym, pctx)
    is LoweredReturn       -> bce_opt_expr_unsafe(s.value, guard_sym, pctx)
    is LoweredYield        -> true
    is LoweredAwait        -> true
    is LoweredLabelledBlock -> bce_block_unsafe(s.body, guard_sym, pctx)
    is LoweredLoop         -> bce_opt_expr_unsafe(s.cond, guard_sym, pctx) || bce_block_unsafe(s.body, guard_sym, pctx)
        || bce_block_unsafe(loop_step_block(s), guard_sym, pctx)
    is LoweredBreak        -> false
    is LoweredContinue     -> false
    is LoweredDeferPush    -> true
    is LoweredDeferPopExec -> true
}

// Whether any field value of a struct literal is unsafe (`bce_expr_unsafe`).
bce_fields_unsafe :: fn(
    fields: LoweredStructLitField[], guard_sym: i32 | null, pctx: BcePurityCtx!,
) -> bool {
    for f in fields {
        if bce_expr_unsafe(f.value, guard_sym, pctx) {
            return true
        }
    }
    return false
}

bce_expr_unsafe :: fn(
    e: LoweredExpr, guard_sym: i32 | null, pctx: BcePurityCtx!,
) -> bool = match e {
    // A call to a proven-pure fn is safe (recurse into its args) ; everything else
    // callable bails.
    is LoweredCall                                    -> bce_call_unsafe(e, guard_sym, pctx)
    is LoweredVirtualCall | LoweredIntrinsicCall | LoweredArrayPush -> true
    // Allocations : allocate ⟹ GC ⟹ the buffer moves.
    is LoweredArrayLit | LoweredCellNew | LoweredMakeClosure | LoweredArraySlice | LoweredStringSlice -> true
    // A tuple of primitives within the value ABI crosses in registers, never on
    // the heap ; any other struct literal allocates.
    is LoweredStructLit -> value_abi_type_size(e.type) < 0 || bce_fields_unsafe(e.fields, guard_sym, pctx)
    // Leaves : no allocation, no call.
    is LoweredIntLit | LoweredFloatLit | LoweredBoolLit | LoweredNullLit | LoweredCharLit | LoweredStringLit | LoweredIdent | LoweredDataConst | LoweredUnreachable | LoweredTypeConst -> false
    // Pure composites : recurse (they don't allocate themselves).
    is LoweredFieldAccess -> bce_expr_unsafe(e.target, guard_sym, pctx)
    is LoweredIndex       -> bce_expr_unsafe(e.target, guard_sym, pctx) || bce_expr_unsafe(e.index, guard_sym, pctx)
    is LoweredUnary       -> bce_expr_unsafe(e.operand, guard_sym, pctx)
    is LoweredBinary      -> bce_expr_unsafe(e.left, guard_sym, pctx) || bce_expr_unsafe(e.right, guard_sym, pctx)
    is LoweredIf          -> bce_expr_unsafe(e.cond, guard_sym, pctx) || bce_block_unsafe(e.then_block, guard_sym, pctx) || bce_opt_block_unsafe(e.else_block, guard_sym, pctx)
    is LoweredBlock       -> bce_block_unsafe(e, guard_sym, pctx)
    is LoweredCast        -> bce_expr_unsafe(e.value, guard_sym, pctx)
    is LoweredTypeCheck   -> bce_expr_unsafe(e.value, guard_sym, pctx)
    is LoweredArrayLen    -> bce_expr_unsafe(e.target, guard_sym, pctx)
    is LoweredCellGet     -> bce_expr_unsafe(e.target, guard_sym, pctx)
}

bce_opt_block_unsafe :: fn(
    b: LoweredBlock | null, guard_sym: i32 | null, pctx: BcePurityCtx!,
) -> bool {
    if b == null {
        return false
    }
    return bce_block_unsafe(b, guard_sym, pctx)
}

try_lower_for_in_raw_array :: fn(
    ctx: FnLowerCtx!, for_stmt: AST.ForStmt, in_form: AST.InFor,
    iter_lowered: LoweredExpr, iter_type: Type,
    recurse: fn(FnLowerCtx!, AST.Expr) -> LoweredExpr,
    block_lowerer: fn(FnLowerCtx!, AST.BlockExpr, bool, usize | null) -> LoweredBlock,
) -> LoweredStmt | null {
    array_elem_type: Type = TY_UNRESOLVED
    // Arrays — and array-backed distinct newtypes via `array_backing` — iterate
    // by index over the value (which is the backing array at runtime).
    ab :: array_backing(iter_type)
    if ab != null {
        array_elem_type = ab.element
    } else {
        return null
    }
    span :: for_stmt.span
    lb :: resolve_loop_binding(ctx, in_form.loop_var, span)
    usize_type :: mk_primitive("usize")

    arr_sym :: fresh_synthetic_symbol(ctx, "for_arr")
    len_sym :: fresh_synthetic_symbol(ctx, "for_len")
    idx_sym :: fresh_synthetic_symbol(ctx, "for_i")

    user_body :: block_lowerer(ctx, for_stmt.body, false, for_stmt.id)

    arr_let :: LoweredLet {
        .span = span, .name = arr_sym.name, .symbol = arr_sym,
        .type = iter_type, .value = iter_lowered,
    }
    arr_ref :: LoweredIdent { .span = span, .type = iter_type, .symbol = arr_sym }
    // BCE : mark the preheader `arr.len()` + the synthesized `arr[idx]` access as
    // candidates ; the post-inline `bce_prove_tag` pass proves the (inlined) loop
    // body safe and flips `bounds_safe`. Deferred to post-inline
    // so bodies whose calls inline away (or, in iterator fusion, whose callbacks
    // inline) still qualify. The synthesized counter runs `0..<len(arr)` over `arr`.
    len_let :: LoweredLet {
        .span = span, .name = len_sym.name, .symbol = len_sym, .type = usize_type,
        .value = LoweredArrayLen { .span = span, .type = usize_type, .target = arr_ref, .bce_recheck = true },
    }
    idx_init :: LoweredLet {
        .span = span, .name = idx_sym.name, .symbol = idx_sym, .type = usize_type,
        .value = LoweredIntLit { .span = span, .type = usize_type, .value = 0 },
    }
    idx_ref :: LoweredIdent { .span = span, .type = usize_type, .symbol = idx_sym }
    len_ref :: LoweredIdent { .span = span, .type = usize_type, .symbol = len_sym }

    cond :: LoweredBinary {
        .span = span, .type = TY_BOOL, .op = .Lt,
        .left = idx_ref, .right = len_ref,
    }
    elem_access :: LoweredIndex {
        .span = span, .type = array_elem_type,
        .target = arr_ref, .index = idx_ref, .bce_recheck = true,
    }
    bind_stmts :: bind_loop_var(ctx, lb.symbol, lb.name, lb.pattern, elem_access, array_elem_type, span)
    inc_stmt :: LoweredAssign {
        .span = span, .target = idx_ref,
        .value = LoweredBinary {
            .span = span, .type = usize_type, .op = .Add,
            .left = idx_ref,
            .right = LoweredIntLit { .span = span, .type = usize_type, .value = 1 },
        },
    }

    loop_stmt :: LoweredLoop {
        .span = span, .label = resolve_loop_label(ctx, for_stmt), .cond = cond,
        .body = prepend_stmts_to_block(bind_stmts, user_body),
        .step = [inc_stmt],
    }

    block_stmts: LoweredStmt[]!: []
    block_stmts.push(arr_let)
    block_stmts.push(len_let)
    block_stmts.push(idx_init)
    block_stmts.push(loop_stmt)
    return LoweredExprStmt {
        .span = span,
        .expr = LoweredBlock {
            .span = span, .type = TY_VOID,
            .stmts = block_stmts, .trailing = null,
        },
    }
}

// ---- int-range fast path --------------------------------------------------


// `for x in lo..<hi` / `for x in lo..=hi` over an integer-typed range
// bottom emits a counter loop.
// Returns null when the bound isn't an integer ; caller falls back to
// the slow path (Iterator step dispatch).
try_lower_for_in_int_range :: fn(
    ctx: FnLowerCtx!, for_stmt: AST.ForStmt, in_form: AST.InFor,
    recurse: fn(FnLowerCtx!, AST.Expr) -> LoweredExpr,
    block_lowerer: fn(FnLowerCtx!, AST.BlockExpr, bool, usize | null) -> LoweredBlock,
) -> LoweredStmt | null {
    range :: extract_range(in_form.iter) ?? return null
    raw_lower :: ctx.types.expr_type(range.lower)
    raw_upper :: ctx.types.expr_type(range.upper)
    if !is_integer_type(raw_lower) { return null }
    // Pick the counter's width from whichever bound is concrete : a
    // FreeInt literal on either side adopts the other's width. When
    // both bounds are concrete, the lower side wins (matches the
    // typer's left-to-right inference). When both are FreeInt, fall
    // back to the i32 default via `default_if_free`. The Range's
    // element type is already settled by the bidirectional infer.
    bound_type :: if raw_lower is FreeIntType {
        if is_integer_type(raw_upper) { default_if_free(raw_upper) } else { default_if_free(raw_lower) }
    } else {
        default_if_free(raw_lower)
    }
    // For-in bindings that the body never references don't surface
    // in `resolved.idents` (the use-site map). Synthesize a placeholder
    // when the lookup misses so the dump still renders.
    span :: for_stmt.span
    lb :: resolve_loop_binding(ctx, in_form.loop_var, span)
    // Re-type FreeInt literals on either bound to the resolved
    // `bound_type` so `let i: u64 = int(0) :u64` doesn't dump as
    // `int(0) :i32`. The counter's declared slot already widens to
    // bound_type, but the literal's own type carries the i32 default
    // unless the typer narrowed it ; rewrite the LoweredIntLit here.
    lo :: widen_int_lit(recurse(ctx, range.lower), bound_type)
    hi_raw :: widen_int_lit(recurse(ctx, range.upper), bound_type)

    // When a closure in the body captures the loop counter, the raw mutable
    // counter can't be captured directly (it's reassigned in place). Run the
    // counter on a fresh synthetic symbol and rebind the user's loop var to a
    // fresh per-iteration cell at the top of the body, so each captured closure
    // sees that iteration's value. Uncaptured loops keep the counter on
    // the resolved loop-var symbol itself — byte-identical to before.
    captured :: lb.symbol.id in ctx.project.closures.captured_symbols
    counter_symbol :: if captured { fresh_synthetic_symbol(ctx, lb.name) } else { lb.symbol }
    counter_init :: LoweredLet {
        .span = span, .name = lb.name, .symbol = counter_symbol,
        .type = bound_type, .value = lo,
    }
    counter_ref :: LoweredIdent {
        .span = span, .type = bound_type, .symbol = counter_symbol,
    }

    raw_user_body :: block_lowerer(ctx, for_stmt.body, false, for_stmt.id)
    user_body :: if !captured { raw_user_body } else {
        // The counter runs on `counter_symbol` ; rebind the user's loop var to a
        // fresh per-iteration cell over the current counter value.
        bind_stmts :: bind_loop_var(ctx, lb.symbol, lb.name, lb.pattern, counter_ref, bound_type, span)
        prepend_stmts_to_block(bind_stmts, raw_user_body)
    }

    // The range is built once, at loop entry : the condition reads the upper
    // bound at every test, and the body may rebind what it names, so it gets a
    // local of its own unless it is invariant.
    hoist_stmts: LoweredStmt[]!: []
    hi :: if is_invariant_operand(ctx, hi_raw) {
        hi_raw
    } else {
        bind_to_local(ctx, hi_raw, bound_type, "for_hi", span, hoist_stmts)
    }

    op :: cmp_op_for_inclusive(range.inclusive)
    cond :: LoweredBinary {
        .span = span, .type = TY_BOOL, .op = op,
        .left = counter_ref, .right = hi,
    }
    inc_stmt :: LoweredAssign {
        .span = span, .target = counter_ref,
        .value = LoweredBinary {
            .span = span, .type = bound_type, .op = .Add,
            .left = counter_ref,
            .right = LoweredIntLit {
                .span = span, .type = bound_type, .value = 1,
            },
        },
    }
    loop_stmt :: LoweredLoop {
        .span = span, .label = resolve_loop_label(ctx, for_stmt), .cond = cond,
        .body = user_body,
        .step = [inc_stmt],
    }

    // The counter first : its initial value is the lower bound, which is
    // evaluated before the upper one.
    block_stmts: LoweredStmt[]!: [counter_init]
    block_stmts.push_all(hoist_stmts)
    block_stmts.push(loop_stmt)
    return LoweredExprStmt {
        .span = span,
        .expr = LoweredBlock {
            .span = span, .type = TY_VOID,
            .stmts = block_stmts, .trailing = null,
        },
    }
}

extract_range :: fn(iter: AST.Expr) -> AST.RangeExpr | null {
    if iter is AST.RangeExpr { return iter }
    return null
}

// When a Range bound is a bare integer literal (e.g. `0` in
// `0..<nu` where `nu: u64`), the typer left it at i32 / FreeInt
// default. Rewrite the LoweredIntLit's type to the loop counter's
// width so the dump shows `int(0) :u64` instead of `int(0) :i32`.
widen_int_lit :: fn(e: LoweredExpr, t: Type) -> LoweredExpr {
    if e is LoweredIntLit {
        return LoweredIntLit { .span = e.span, .type = t, .value = e.value }
    }
    return e
}

is_integer_type :: fn(t: Type) -> bool {
    // @partial: only primitive integers and the free int/char types are
    // integers; every other Type → false.
    @partial match t {
        is PrimitiveType -> { return is_int_name(t.name) }
        is FreeIntType -> { return true }
        is FreeCharType -> { return true }
        _ -> { return false }
    }
}


cmp_op_for_inclusive :: fn(inclusive: bool) -> LoweredBinaryOp {
    if inclusive { return .Lte }
    return .Lt
}

// `for entry in m` over `MutableMap<K, V>` / `for v in s` over
// `MutableSet<T>` — inline the bucket-walk + chain-traversal so the loop
// skips the iterator struct, the per-iter `next()` call and the step pair it
// would rebuild. Returns null when the iter type isn't a recognised map/set or
// std/collections isn't loaded.
try_lower_for_in_map_set :: fn(
    ctx: FnLowerCtx!, for_stmt: AST.ForStmt, in_form: AST.InFor,
    src_value: LoweredExpr, src_type: Type, span: Span,
    block_lowerer: fn(FnLowerCtx!, AST.BlockExpr, bool, usize | null) -> LoweredBlock,
) -> LoweredStmt | null {
    if src_type is StructType {
        // `MutableMap` / `MutableSet` lookups returning null (std/collections not
        // loaded) fall through to `!is_map && !is_set` below — no separate gate.
        is_map :: struct_sym_matches(module_export(ctx.project, "std/collections", "MutableMap"), src_type.symbol.id)
        is_set :: struct_sym_matches(module_export(ctx.project, "std/collections", "MutableSet"), src_type.symbol.id)
        if !is_map && !is_set { return null }
        // Element component types : Map<K, V> → [K, V] ; Set<T> → [T, bool].
        entry_args: Type[]!: []
        if is_map {
            for a in src_type.args { entry_args.push(a) }
        } else {
            if src_type.args.len() == 0 { return null }
            entry_args.push(src_type.args[0])
            entry_args.push(TY_BOOL)
        }
        if entry_args.len() != 2 { return null }
        // Compact-dict map/set fast-path : dense index walk over `ekeys` / `evals`.
        return lower_map_set_compact(ctx, for_stmt, in_form, src_value, src_type, span,
            block_lowerer, src_type, is_map, is_set, entry_args)
    }
    return null
}

// Compact-dict map/set for-in : walk the dense `ekeys` / `evals` arrays by
// index. For a map, bind a per-step `[key, value]` tuple (never escapes the
// body → scalar-replaced, zero-alloc) ; for a set, bind the key directly.
lower_map_set_compact :: fn(
    ctx: FnLowerCtx!, for_stmt: AST.ForStmt, in_form: AST.InFor,
    src_value: LoweredExpr, src_type: Type, span: Span,
    block_lowerer: fn(FnLowerCtx!, AST.BlockExpr, bool, usize | null) -> LoweredBlock,
    source: StructType, is_map: bool, is_set: bool, entry_args: Type[],
) -> LoweredStmt {
    usize_ty :: mk_primitive("usize")
    key_ty :: entry_args[0]
    val_ty :: entry_args[1]
    pair_type :: mk_tuple([key_ty, val_ty], false)
    ekeys_array_type :: mk_array(key_ty, false)
    evals_array_type :: mk_array(val_ty, false)
    binding_value_type: Type = pair_type
    if is_set { binding_value_type = source.args[0] }

    // Hoist the source value once.
    src_sym :: fresh_synthetic_symbol(ctx, "iter_src")
    src_let :: LoweredLet {
        .span = span, .name = src_sym.name, .symbol = src_sym,
        .type = src_type, .value = src_value,
    }
    src_ref :: LoweredIdent { .span = span, .type = src_type, .symbol = src_sym }

    // The map whose dense arrays we walk : a Map directly, a Set via `.inner`.
    map_ref: LoweredExpr = src_ref
    if is_set {
        inner_map_type :: map_struct_type(module_export(ctx.project, "std/collections", "MutableMap"), entry_args)
        map_ref = LoweredFieldAccess { .span = span, .type = inner_map_type, .target = src_ref, .field = "inner" }
    }

    // let ekeys = <map>.ekeys ; let evals = <map>.evals (map only) ; let size = <map>.size
    ekeys_sym :: fresh_synthetic_symbol(ctx, "iter_ekeys")
    ekeys_ref :: LoweredIdent { .span = span, .type = ekeys_array_type, .symbol = ekeys_sym }
    ekeys_let :: LoweredLet {
        .span = span, .name = ekeys_sym.name, .symbol = ekeys_sym, .type = ekeys_array_type,
        .value = LoweredFieldAccess { .span = span, .type = ekeys_array_type, .target = map_ref, .field = "ekeys" },
    }
    evals_sym :: fresh_synthetic_symbol(ctx, "iter_evals")
    evals_ref :: LoweredIdent { .span = span, .type = evals_array_type, .symbol = evals_sym }
    evals_let :: LoweredLet {
        .span = span, .name = evals_sym.name, .symbol = evals_sym, .type = evals_array_type,
        .value = LoweredFieldAccess { .span = span, .type = evals_array_type, .target = map_ref, .field = "evals" },
    }
    size_sym :: fresh_synthetic_symbol(ctx, "iter_size")
    size_ref :: LoweredIdent { .span = span, .type = usize_ty, .symbol = size_sym }
    size_let :: LoweredLet {
        .span = span, .name = size_sym.name, .symbol = size_sym, .type = usize_ty,
        .value = LoweredFieldAccess { .span = span, .type = usize_ty, .target = map_ref, .field = "size" },
    }
    pos_sym :: fresh_synthetic_symbol(ctx, "iter_pos")
    pos_ref :: LoweredIdent { .span = span, .type = usize_ty, .symbol = pos_sym }
    pos_let :: LoweredLet {
        .span = span, .name = pos_sym.name, .symbol = pos_sym, .type = usize_ty,
        .value = LoweredIntLit { .span = span, .type = usize_ty, .value = 0 },
    }
    // loop body : if pos >= size break ; bind ; pos += 1 ; <user body>
    oob_if :: LoweredExprStmt {
        .span = span,
        .expr = LoweredIf {
            .span = span, .type = TY_VOID,
            .cond = LoweredBinary {
                .span = span, .type = TY_BOOL, .op = .Gte,
                .left = pos_ref, .right = size_ref,
            },
            .then_block = single_stmt_block(span, LoweredBreak { .span = span, .label = null }),
            .else_block = null,
        },
    }
    // bind value : Set → ekeys[pos] (the key) ; Map → [key, value] tuple. The
    // tuple lowers to the `_0` / `_1` struct layout (mirrors `lower_seq_lit`), so
    // `for [k, v] in m` destructures it positionally like `for [x, y] in zip(...)`.
    bind_value: LoweredExpr = LoweredIndex { .span = span, .type = binding_value_type, .target = ekeys_ref, .index = pos_ref }
    if is_map {
        bind_value = LoweredStructLit {
            .span = span, .type = pair_type,
            .fields = [
                LoweredStructLitField {
                    .name = "_0", .value = LoweredIndex { .span = span, .type = key_ty, .target = ekeys_ref, .index = pos_ref },
                },
                LoweredStructLitField {
                    .name = "_1", .value = LoweredIndex { .span = span, .type = val_ty, .target = evals_ref, .index = pos_ref },
                },
            ],
        }
    }
    lb :: resolve_loop_binding(ctx, in_form.loop_var, span)
    binding_stmts :: bind_loop_var(ctx, lb.symbol, lb.name, lb.pattern, bind_value, binding_value_type, span)
    pos_inc :: LoweredAssign {
        .span = span, .target = pos_ref,
        .value = LoweredBinary {
            .span = span, .type = usize_ty, .op = .Add,
            .left = pos_ref, .right = LoweredIntLit { .span = span, .type = usize_ty, .value = 1 },
        },
    }
    user_body :: block_lowerer(ctx, for_stmt.body, false, for_stmt.id)
    loop_body_stmts: LoweredStmt[]!: []
    loop_body_stmts.push(oob_if)
    loop_body_stmts.push_all(binding_stmts)
    loop_body_stmts.push(pos_inc)
    for s in block_stmts_with_trailing(user_body) { loop_body_stmts.push(s) }
    loop_stmt :: LoweredLoop {
        .span = span, .label = resolve_loop_label(ctx, for_stmt), .cond = null,
        .body = LoweredBlock { .span = span, .type = TY_VOID, .stmts = loop_body_stmts, .trailing = null },
        .step = [],
    }
    all_stmts: LoweredStmt[]!: []
    all_stmts.push(src_let)
    all_stmts.push(ekeys_let)
    if is_map { all_stmts.push(evals_let) }
    all_stmts.push(size_let)
    all_stmts.push(pos_let)
    all_stmts.push(loop_stmt)
    return wrap_stmts(span, all_stmts)
}

struct_sym_matches :: fn(sym: Symbol | null, id: i32) -> bool {
    if sym is Symbol { return sym.id == id }
    return false
}

map_struct_type :: fn(map_sym: Symbol | null, entry_args: Type[]) -> Type {
    if map_sym != null { return mk_struct(map_sym, entry_args, immutable = false) }
    return TY_UNRESOLVED
}

single_stmt_block :: fn(span: Span, stmt: LoweredStmt) -> LoweredBlock {
    stmts: LoweredStmt[]!: []
    stmts.push(stmt)
    return LoweredBlock { .span = span, .type = TY_VOID, .stmts = stmts, .trailing = null }
}
