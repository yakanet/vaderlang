// vader/lower/lower_ref — whole-program reference walker and type visitor (DCE).
//

module "vader/lower"

import "vader/types"
import "vader/resolver/symbol"

/// Visit every `Type` node referenced by `decl` — fields (struct),
/// signature + body (fn), type + value (const). `visit` is passed as a
/// direct fn argument (threaded through the recursion), never stored on a
/// struct, so it stays on the working closure-call path.
for_each_lowered_type :: fn(decl: LoweredDecl, visit: fn(Type) -> void) -> void {
    match decl {
        is LoweredFnDecl -> {
            for p in decl.params { for_each_type(p.type, visit) }
            for_each_type(decl.return_type, visit)
            body :: decl.body
            if body != null { for_each_lowered_block(body, visit) }
        }
        is LoweredStructDecl -> { for f in decl.fields { for_each_type(f.type, visit) } }
        is LoweredConstDecl -> {
            for_each_type(decl.type, visit)
            for_each_lowered_expr(decl.value, visit)
        }
    }
}

for_each_lowered_block :: fn(b: LoweredBlock, visit: fn(Type) -> void) -> void {
    for_each_type(b.type, visit)
    for s in b.stmts { for_each_lowered_stmt(s, visit) }
    trailing :: b.trailing
    if trailing != null { for_each_lowered_expr(trailing, visit) }
}

for_each_lowered_stmt :: fn(s: LoweredStmt, visit: fn(Type) -> void) -> void {
    match s {
        is LoweredLet -> {
            for_each_type(s.type, visit)
            for_each_lowered_expr(s.value, visit)
        }
        is LoweredAssign -> {
            for_each_lowered_expr(s.target, visit)
            for_each_lowered_expr(s.value, visit)
        }
        is LoweredExprStmt -> { for_each_lowered_expr(s.expr, visit) }
        is LoweredReturn -> {
            value :: s.value
            if value != null { for_each_lowered_expr(value, visit) }
        }
        is LoweredYield -> { for_each_lowered_expr(s.value, visit) }
        is LoweredAwait -> { for_each_lowered_expr(s.awaited, visit) }
        is LoweredLoop -> {
            cond :: s.cond
            if cond != null { for_each_lowered_expr(cond, visit) }
            for_each_lowered_block(s.body, visit)
        }
        is LoweredBreak    -> {}
        is LoweredContinue -> {}
        is LoweredCellSet  -> {
            for_each_lowered_expr(s.target, visit)
            for_each_lowered_expr(s.value, visit)
            for_each_type(s.value_type, visit)
        }
        is LoweredDeferPush -> { for_each_lowered_expr(s.thunk, visit) }
        is LoweredDeferPopExec -> {}
    }
}

for_each_lowered_expr :: fn(e: LoweredExpr, visit: fn(Type) -> void) -> void {
    for_each_type(e.type, visit)
    match e {
        is LoweredIdent -> {}
        is LoweredCall -> {
            for_each_lowered_expr(e.callee, visit)
            for a in e.args { for_each_lowered_expr(a, visit) }
        }
        is LoweredVirtualCall -> {
            for_each_lowered_expr(e.receiver, visit)
            for a in e.args { for_each_lowered_expr(a, visit) }
        }
        is LoweredFieldAccess -> { for_each_lowered_expr(e.target, visit) }
        is LoweredIndex -> {
            for_each_lowered_expr(e.target, visit)
            for_each_lowered_expr(e.index, visit)
        }
        is LoweredUnary -> { for_each_lowered_expr(e.operand, visit) }
        is LoweredBinary -> {
            for_each_lowered_expr(e.left, visit)
            for_each_lowered_expr(e.right, visit)
        }
        is LoweredIf -> {
            for_each_lowered_expr(e.cond, visit)
            for_each_lowered_block(e.then_block, visit)
            else_block :: e.else_block
            if else_block != null { for_each_lowered_block(else_block, visit) }
        }
        is LoweredBlock -> { for_each_lowered_block(e, visit) }
        is LoweredStructLit -> { for f in e.fields { for_each_lowered_expr(f.value, visit) } }
        is LoweredArrayLit -> { for el in e.elements { for_each_lowered_expr(el, visit) } }
        is LoweredArrayLen -> { for_each_lowered_expr(e.target, visit) }
        is LoweredArrayPush -> {
            for_each_lowered_expr(e.target, visit)
            for_each_lowered_expr(e.value, visit)
        }
        is LoweredArraySlice -> {
            for_each_lowered_expr(e.target, visit)
            for_each_lowered_expr(e.lo, visit)
            for_each_lowered_expr(e.hi, visit)
        }
        is LoweredStringSlice -> {
            for_each_lowered_expr(e.target, visit)
            for_each_lowered_expr(e.lo, visit)
            for_each_lowered_expr(e.hi, visit)
        }
        is LoweredCast -> { for_each_lowered_expr(e.value, visit) }
        is LoweredTypeCheck -> {
            for_each_lowered_expr(e.value, visit)
            for_each_type(e.check_type, visit)
        }
        is LoweredIntrinsicCall -> {
            for a in e.args { for_each_lowered_expr(a, visit) }
        }
        is LoweredCellNew -> {
            for_each_lowered_expr(e.value, visit)
            for_each_type(e.value_type, visit)
        }
        is LoweredCellGet -> {
            for_each_lowered_expr(e.target, visit)
            for_each_type(e.value_type, visit)
        }
        is LoweredMakeClosure -> { for_each_lowered_expr(e.env, visit) }
        is LoweredDataConst -> { for_each_type(e.type, visit) }
        is LoweredTypeConst -> {
            for_each_type(e.type, visit)
            for_each_type(e.value, visit)
        }
        // Remaining variants are leaf literals (Int/Float/Bool/Null/Char/
        // String/Unreachable) carrying no nested expr. A future variant that
        // nests an expr/type must be added above, else its shapes are missed.
        _ -> {}
    }
}

// ---- reference walker (whole-program DCE) ---------------------------------

/// Walk a lowered decl's body for *call-graph* references : every
/// `LoweredCall` with a `LoweredIdent` callee yields the callee
/// symbol's `(id, name)` to `visit_fn`, and every `LoweredVirtualCall`
/// yields its `(trait, method)` to `visit_virtual`. Used by
/// `prune_unreachable_fns` (vader/lower/dce.vader) to mark reachable
/// functions from the program roots.
///
/// The callbacks are passed as DIRECT fn args rather than bundled in a struct.
/// Calling a fn stored in a struct FIELD has a history of misbehaving here — it
/// is blamed on the native backend at this site, on the typechecker elsewhere,
/// and the accounts disagree, so treat the shape as load-bearing and the reason
/// as unestablished. Direct-arg fn params dispatch correctly.
///
/// @param decl          the lowered top-level decl to scan.
/// @param visit_fn      called with `(callee.symbol.id, callee.symbol.name)`
///                      for every direct (ident-callee) call.
/// @param visit_virtual called with `(trait_name, method_name)` for every
///                      virtual call so the vtable fixpoint can keep the
///                      matching impl fns.
export for_each_lowered_ref :: fn(
    decl: LoweredDecl,
    visit_fn: fn(i32, string) -> void,
    visit_virtual: fn(string, string) -> void,
) -> void {
    match decl {
        is LoweredFnDecl -> {
            body :: decl.body
            if body != null { ref_block(body, visit_fn, visit_virtual) }
        }
        is LoweredConstDecl -> ref_expr(decl.value, visit_fn, visit_virtual)
        is LoweredStructDecl -> {}
    }
}

ref_block :: fn(b: LoweredBlock, visit_fn: fn(i32, string) -> void, visit_virtual: fn(string, string) -> void) -> void {
    for s in b.stmts { ref_stmt(s, visit_fn, visit_virtual) }
    trailing :: b.trailing
    if trailing != null { ref_expr(trailing, visit_fn, visit_virtual) }
}

ref_stmt :: fn(s: LoweredStmt, visit_fn: fn(i32, string) -> void, visit_virtual: fn(string, string) -> void) -> void {
    match s {
        is LoweredLet -> ref_expr(s.value, visit_fn, visit_virtual)
        is LoweredAssign -> {
            ref_expr(s.target, visit_fn, visit_virtual)
            ref_expr(s.value, visit_fn, visit_virtual)
        }
        is LoweredExprStmt -> ref_expr(s.expr, visit_fn, visit_virtual)
        is LoweredReturn -> {
            value :: s.value
            if value != null { ref_expr(value, visit_fn, visit_virtual) }
        }
        is LoweredYield -> ref_expr(s.value, visit_fn, visit_virtual)
        is LoweredAwait -> ref_expr(s.awaited, visit_fn, visit_virtual)
        is LoweredLoop -> {
            cond :: s.cond
            if cond != null { ref_expr(cond, visit_fn, visit_virtual) }
            ref_block(s.body, visit_fn, visit_virtual)
        }
        is LoweredBreak    -> {}
        is LoweredContinue -> {}
        is LoweredCellSet  -> {
            ref_expr(s.target, visit_fn, visit_virtual)
            ref_expr(s.value, visit_fn, visit_virtual)
        }
        is LoweredDeferPush -> ref_expr(s.thunk, visit_fn, visit_virtual)
        is LoweredDeferPopExec -> {}
    }
}

ref_expr :: fn(e: LoweredExpr, visit_fn: fn(i32, string) -> void, visit_virtual: fn(string, string) -> void) -> void {
    match e {
        is LoweredCall -> {
            if e.callee is LoweredIdent as callee_ident {
                visit_fn(callee_ident.symbol.id, callee_ident.symbol.name)
            }
            ref_expr(e.callee, visit_fn, visit_virtual)
            for a in e.args { ref_expr(a, visit_fn, visit_virtual) }
        }
        is LoweredVirtualCall -> {
            visit_virtual(e.trait_name, e.method)
            ref_expr(e.receiver, visit_fn, visit_virtual)
            for a in e.args { ref_expr(a, visit_fn, visit_virtual) }
        }
        is LoweredFieldAccess -> ref_expr(e.target, visit_fn, visit_virtual)
        is LoweredIndex -> {
            ref_expr(e.target, visit_fn, visit_virtual)
            ref_expr(e.index, visit_fn, visit_virtual)
        }
        is LoweredUnary -> ref_expr(e.operand, visit_fn, visit_virtual)
        is LoweredBinary -> {
            ref_expr(e.left, visit_fn, visit_virtual)
            ref_expr(e.right, visit_fn, visit_virtual)
        }
        is LoweredIf -> {
            ref_expr(e.cond, visit_fn, visit_virtual)
            ref_block(e.then_block, visit_fn, visit_virtual)
            else_block :: e.else_block
            if else_block != null { ref_block(else_block, visit_fn, visit_virtual) }
        }
        is LoweredBlock -> ref_block(e, visit_fn, visit_virtual)
        is LoweredStructLit -> { for f in e.fields { ref_expr(f.value, visit_fn, visit_virtual) } }
        is LoweredArrayLit -> { for el in e.elements { ref_expr(el, visit_fn, visit_virtual) } }
        is LoweredArrayLen -> ref_expr(e.target, visit_fn, visit_virtual)
        is LoweredArrayPush -> {
            ref_expr(e.target, visit_fn, visit_virtual)
            ref_expr(e.value, visit_fn, visit_virtual)
        }
        is LoweredArraySlice -> {
            ref_expr(e.target, visit_fn, visit_virtual)
            ref_expr(e.lo, visit_fn, visit_virtual)
            ref_expr(e.hi, visit_fn, visit_virtual)
        }
        is LoweredStringSlice -> {
            ref_expr(e.target, visit_fn, visit_virtual)
            ref_expr(e.lo, visit_fn, visit_virtual)
            ref_expr(e.hi, visit_fn, visit_virtual)
        }
        is LoweredCast -> ref_expr(e.value, visit_fn, visit_virtual)
        is LoweredTypeCheck -> ref_expr(e.value, visit_fn, visit_virtual)
        is LoweredIntrinsicCall -> { for a in e.args { ref_expr(a, visit_fn, visit_virtual) } }
        is LoweredCellNew -> ref_expr(e.value, visit_fn, visit_virtual)
        is LoweredCellGet -> ref_expr(e.target, visit_fn, visit_virtual)
        is LoweredMakeClosure -> {
            visit_fn(e.fn_symbol.id, e.fn_symbol.name)
            ref_expr(e.env, visit_fn, visit_virtual)
        }
        // A bare `LoweredIdent` whose symbol resolves to a `Fn` is a fn-value
        // reference (e.g. `let f = add`) — visit the target so DCE keeps it alive.
        // Without this, `add` (or any fn passed by value but not directly called)
        // gets pruned and the bytecode emit hits the defensive `Return` stub when it
        // tries to resolve the fn-index.
        //
        // Consts need no arm here: a fn-wrapped const's accessor carries a FRESH
        // synthetic id and the mangle `__const_<mangled>`
        // (`inline_consts::const_accessor_symbol`), so nothing reachable from a
        // const ident would match it. The DCE seeds those accessors as roots
        // outright instead.
        is LoweredIdent -> {
            if e.symbol.kind == SymbolKind.Fn {
                visit_fn(e.symbol.id, e.symbol.name)
            }
        }
        _ -> {}
    }
}
