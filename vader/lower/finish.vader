// vader/lower/finish — post-materialization finishing: vtable collection, output assembly.
//

module "vader/lower"

import "vader/core/symbol"

// One `LoweredVtableEntry` per surviving impl member — the slot its `MonoEntry`
// records (`(trait_key, method)`) for the receiver type of its `self`.
collect_vtable_entries :: fn(project: LoweredProject) -> LoweredVtableEntry[] {
    out: LoweredVtableEntry[]: []
    for [_, m] in project.modules {
        for d in m.decls {
            out.push(vtable_entry_of(d) ?? continue)
        }
    }
    return out
}

/// The vtable row `d` fills: the slot its `MonoEntry` records, for the type of its
/// receiver ; null for a decl that fills none.
///
/// @param d  a lowered decl.
vtable_entry_of :: fn(d: LoweredDecl) -> LoweredVtableEntry | null {
    if d !is LoweredFnDecl || d.params.len() == 0 {
        return null
    }
    slot :: d.origin.vtable_slot ?? return null
    // fn_symbol is informational here: the table builder
    // (`midir/emit.vader::build_impl_table_from_vtable`) only keys on
    // (struct_type, trait_name).
    return LoweredVtableEntry {
        .trait_name  = slot.trait_key,
        .method_name = slot.method,
        .struct_type = d.params[0].type,
        .fn_symbol   = fn_symbol_of(d),
    }
}

// The symbol a call or a vtable entry names `d` by : its own, or one carrying its
// mangle when the impl-member resolver found none — the emitter resolves either.
fn_symbol_of :: fn(d: LoweredFnDecl) -> Symbol =
    d.origin.symbol ?? synthetic_symbol(0, .Fn, d.mangled)

// A symbol no resolver minted : `id` comes from `next_project_synthetic_id`, or is 0
// where only the name is read.
synthetic_symbol :: fn(id: i32, kind: SymbolKind, name: string) = Symbol {
    .id = id,
    .kind = kind,
    .name = name,
    .module = "",
    .module_name = "",
    .visibility = .Private,
    .defined_at = null,
}

push_to_module :: fn(project: LoweredProject, module_id: string, decl: LoweredDecl) -> void {
    m :: project.modules[module_id] ?? return
    if m is LoweredModule {
        m.decls.push(decl)
    }
}

// Drain the lambda/defer lifted fns appended to `project_ctx.synth_decls`
// in the window `[start, end)` into `module_id`, right after the fn that
// spawned them. This is the post-module analogue of `lower_module`'s
// per-module synth drain (`synth_start..synth_end`) : the materialisation
// passes (generic fn instances, harvested non-generic stdlib fns, impl
// members) lower fn bodies AFTER the per-module walk, so any lambda lifted
// inside such a body would otherwise be orphaned — never reserved into the
// fn table, surfacing as an unresolved make-closure callee at emit (the
// `__lambda_*` was in `synth_decls` but no module ever drained it).
// Callers pass an explicit `end` so a separated build/push site (generic
// instances) drains only the window the survivor produced, skipping the
// windows of erasure-deduped siblings.
drain_synth_window :: fn(
    project: LoweredProject, module_id: string,
    project_ctx: LowerProjectCtx, start: i64, end: i64,
) -> void {
    for i in start..<end {
        push_to_module(project, module_id, project_ctx.synth_decls[i])
    }
}

/// Push every project-global synthesised decl (`concat_N`, field-default thunks)
/// into the entry module, once. Called after the lowering fixpoint converges (every
/// synthesised decl collected) and before DCE/emit so the calls resolve. The entry module
/// is always present + fully kept, giving the shared decls a stable home regardless
/// of which module's body first triggered the synthesis.
///
/// @param project_ctx  carries the collected `entry_decls`.
/// @param project      the lowered project ; the entry module gains the decls.
drain_entry_decls :: fn(project_ctx: LowerProjectCtx, project: LoweredProject) -> void {
    for decl in project_ctx.entry_decls {
        push_to_module(project, project.entry, decl)
    }
}

// `drain_synth_window` over the open window `[start, now)` — the common case
// for a site that captured `start` immediately before lowering one body and
// drains right after, when no other body lowered in between. The generic
// fn-instance push loop needs the explicit-`end` form instead, because its
// build and push are separated by a sort + erasure-dedup (later instances
// advance `synth_decls.len()` before the survivor is pushed).
drain_synth_since :: fn(
    project: LoweredProject, module_id: string, project_ctx: LowerProjectCtx, start: i64,
) = drain_synth_window(project, module_id, project_ctx, start, project_ctx.synth_decls.len())
