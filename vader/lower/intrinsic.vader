// vader/lower/intrinsic: the `@size_of`-style reflection calls, lowered or folded.
//

module "vader/lower"

import "std/collections"
import "toolchain/ast"
import "vader/core/types"
import "vader/front/comptime"
import "vader/front/typecheck"
import "toolchain/span"
import "vader/lower/ir"

// Preserve the `@<name>(args)` call shape. Comptime-foldable variants
// (`@size_of`, `@type_kind`, ...) get baked at evaluation time and reach
// the lowerer as bound `@comptime const` references ; what remains is
// the runtime-bound shape, which the bytecode emit consumes.
lower_intrinsic :: fn(ctx: FnLowerCtx, intrinsic: IntrinsicCallExpr, type: Type) -> LoweredExpr {
    // `@field(target, "name")` folds to `target.name` when the name
    // arg is a static string literal. Comptime-for unrolling can
    // substitute the name slot with a LoweredStringLit:
    // we lower the args here so post-substitution literals get
    // picked up. When the typer left the result type unresolved,
    // refine from the receiver's struct decl + field name pair.
    if intrinsic.intrinsic == .Field && intrinsic.args.len() == 2 {
        target :: lower_expr(ctx, intrinsic.args[0])
        name_arg :: lower_expr(ctx, intrinsic.args[1])
        if name_arg is LoweredStringLit {
            receiver :: ctx.types.expr_type(intrinsic.args[0])
            via_union :: lower_union_field(
                ctx,
                intrinsic.span,
                type,
                receiver,
                target,
                name_arg.value,
            )
            if via_union != null {
                return via_union
            }
            declared :: struct_field_type(ctx, receiver, name_arg.value)
            return LoweredFieldAccess {
                .span = intrinsic.span,
                .type = read_type_or_declared(type, declared),
                .target = target,
                .field = name_arg.value,
            }
        }
    }
    // Static-arg intrinsics fold at lower time when the typer recorded
    // the arg's underlying Type.
    folded :: try_fold_static_intrinsic(ctx, intrinsic, type)
    if folded != null { return folded }
    args :: lower_in_order(ctx, intrinsic.args)
    // Late-fold path : `@size_of` / `@align_of` / `@type_name` /
    // `@type_kind` over a single arg that lowered to a
    // `LoweredTypeConst` (e.g. via `@comptime for` substitution of
    // `t`). The early `try_fold_static_intrinsic` reads the source
    // AST so it can't see post-lower substitutions ; this catches
    // the substituted shape.
    late_folded :: try_late_fold_type_arg(intrinsic.intrinsic, args, intrinsic.span, type)
    if !(late_folded is null) { return late_folded }
    // `@size_of(x)` over a `type`-valued runtime expression routes
    // through the dedicated `size_of.type` intrinsic so the bytecode
    // emit picks the right opcode.
    final_name :: runtime_intrinsic_name(intrinsic.intrinsic, args)
    return LoweredIntrinsicCall {
        .span = intrinsic.span, .type = type, .name = final_name,
        .args = args,
    }
}

/// Late fold for the type-introspection intrinsics: fires when the
/// arg lowered to a `LoweredTypeConst` (which can happen via
/// `@comptime for` substitution that the early AST-level fold doesn't
/// see). Returns null when the pattern doesn't match ; caller falls
/// through to the runtime `LoweredIntrinsicCall`.
try_late_fold_type_arg :: fn(
    intrinsic: CompilerIntrinsic, args: LoweredExpr[], span: Span, type: Type,
) -> LoweredExpr | null {
    if args.len() != 1 {
        return null
    }
    arg :: args[0]
    if arg !is LoweredTypeConst {
        return null
    }
    return type_query(intrinsic, arg.value, span, type)
}

// The name of the runtime intrinsic a call to `intrinsic` lowers to: `@size_of`
// over a `type` value has its own.
runtime_intrinsic_name :: fn(intrinsic: CompilerIntrinsic, args: LoweredExpr[]) -> string {
    if intrinsic == .SizeOf && args.len() == 1 {
        return INTRINSIC_SIZE_OF_TYPE
    }
    return intrinsic_name(intrinsic)
}

/// Fold an intrinsic call to a literal when its arguments are known at lower
/// time: the type the typer recorded in `type_expr_types`, or a local or comptime
/// type alias. Null leaves the call to run.
try_fold_static_intrinsic :: fn(
    ctx: FnLowerCtx, intrinsic: IntrinsicCallExpr, type: Type,
) -> LoweredExpr | null = match intrinsic.intrinsic {
    .Satisfies                   -> try_fold_satisfies(ctx, intrinsic, type)
    .TypeOf                      -> try_fold_type_of(ctx, intrinsic, type)
    .TypeArgs                    -> try_fold_type_args(ctx, intrinsic, type)
    .Fields                      -> try_fold_fields(ctx, intrinsic, type)
    .FieldIndex                  -> try_fold_field_index(ctx, intrinsic, type)
    .Min | .Max                  -> fold_integer_bound(ctx, intrinsic, type)
    .FieldCount | .VariantCount  -> try_fold_part_count(ctx, intrinsic, type)
    .SizeOf | .AlignOf | .TypeName | .TypeKind -> try_fold_type_query(ctx, intrinsic, type)
    // Folded once its name argument is known, by `lower_intrinsic`.
    .Field                       -> null
    .Decorator                   -> fold_decorator(ctx, intrinsic, type)
}

// `@decorator(f, D)`: the value the comptime pass computed for the `@D` the
// typecheck found on `f`, built as a literal of `D`. A body lowered for the
// comptime VM may run before a decorator whose argument the VM computes.
fold_decorator :: fn(ctx: FnLowerCtx, intrinsic: IntrinsicCallExpr, type: Type) -> LoweredExpr {
    missing :: "@decorator read before the comptime pass computed the decorator"
    read :: ctx.typed.decorator_reads[intrinsic.span.hash()] else return stub(intrinsic.span, type, missing)
    program :: ctx.project.evaluated.modules[ctx.typed.resolved.path]
        else return stub(intrinsic.span, type, missing)
    built :: program.decorator_values[read] else return stub(intrinsic.span, type, missing)
    return baked_struct(ctx, built.value, intrinsic.span)
}

// `@field_count(T)` or `@variant_count(T)` of a type known at lower time.
try_fold_part_count :: fn(
    ctx: FnLowerCtx, intrinsic: IntrinsicCallExpr, type: Type,
) -> LoweredExpr | null {
    ty :: single_type_argument(ctx, intrinsic) else return null
    count :: if intrinsic.intrinsic == .FieldCount {
        lower_field_count(ctx, ty)
    } else {
        lower_variant_count(ty)
    }
    return LoweredIntLit { .span = intrinsic.span, .type = type, .value = count }
}

// `@size_of`, `@align_of`, `@type_name` or `@type_kind` of a type known at lower
// time.
try_fold_type_query :: fn(
    ctx: FnLowerCtx, intrinsic: IntrinsicCallExpr, type: Type,
) -> LoweredExpr | null {
    ty :: single_type_argument(ctx, intrinsic) else return null
    return type_query(intrinsic.intrinsic, ty, intrinsic.span, type)
}

// The one argument of `intrinsic`, as a type known at lower time ; null when it
// has another count of arguments or names no type yet.
single_type_argument :: fn(ctx: FnLowerCtx, intrinsic: IntrinsicCallExpr) -> Type | null {
    if intrinsic.args.len() != 1 {
        return null
    }
    ty :: resolve_intrinsic_type_arg(ctx, intrinsic.args[0]) else return null
    if ty is UnresolvedType {
        return null
    }
    return ty
}

// The literal answer of `@size_of`, `@align_of`, `@type_name` or `@type_kind`
// about `ty`, typed `type` ; null for any other intrinsic, which a type alone does
// not answer.
type_query :: fn(intrinsic: CompilerIntrinsic, ty: Type, span: Span, type: Type) -> LoweredExpr | null =
    match intrinsic {
        .SizeOf   -> LoweredIntLit {
            .span = span,
            .type = type,
            .value = byte_size(ty),
        }
        .AlignOf  -> LoweredIntLit {
            .span = span,
            .type = type,
            .value = byte_align(ty),
        }
        .TypeName -> LoweredStringLit {
            .span = span,
            .type = TY_STRING,
            .value = display_type(ty),
        }
        .TypeKind -> LoweredStringLit {
            .span = span,
            .type = TY_STRING,
            .value = type_kind_label(ty),
        }
        .FieldCount | .VariantCount | .FieldIndex | .Satisfies | .Min | .Max | .TypeOf
            | .Fields | .TypeArgs | .Field | .Decorator -> null
    }

// `@min(T)` or `@max(T)`, a literal of `type`, the integer `T` is held in ; of an
// enum, its variant of the least or the greatest value, as a variant lowers ; of
// `char`, U+0000 or U+10FFFF.
fold_integer_bound :: fn(ctx: FnLowerCtx, intrinsic: IntrinsicCallExpr, type: Type) -> LoweredExpr | null {
    if intrinsic.args.len() != 1 {
        return null
    }
    greatest :: intrinsic.intrinsic == .Max
    bounded :: ctx.types.raw_type_expr_type(intrinsic.args[0])
    if is_char(bounded) {
        hull :: type_bounds(bounded) else return null
        return LoweredCharLit {
            .span = intrinsic.span,
            .type = bounded,
            .value = u32(integer_bound(hull, greatest)),
        }
    }
    if bounded is EnumType {
        hull :: type_bounds(bounded) else return null
        return LoweredIntLit {
            .span = intrinsic.span,
            .type = bounded,
            .value = integer_bound(hull, greatest),
        }
    }
    held :: instance_range(ctx, bounded) else return null
    return LoweredIntLit {
        .span = intrinsic.span,
        .type = type,
        .value = integer_bound(held.bounds, greatest),
    }
}

// `@field_count` / `@variant_count` / `@field_index` folds: count the parts of
// a structured type (fields for Struct/Tuple, variants for Union/Enum) or the
// 0-based position of a named field. Mirror of the comptime intrinsics so the
// same value lands whether the call is folded at comptime or here.
lower_field_count :: fn(ctx: FnLowerCtx, t: Type) -> i64 {
    if t is StructType {
        fields :: ctx.typed.struct_fields[t.symbol.id] else return 0
        return fields.len()
    }
    if t is TupleType { return t.elements.len() }
    return 0
}

lower_variant_count :: fn(t: Type) -> i64 {
    if t is UnionType { return t.variants.len() }
    if t is EnumType { return t.indices.len() }
    return 0
}

try_fold_field_index :: fn(ctx: FnLowerCtx, intrinsic: IntrinsicCallExpr, type: Type) -> LoweredExpr | null {
    if intrinsic.args.len() != 2 { return null }
    arg_or_null :: resolve_intrinsic_type_arg(ctx, intrinsic.args[0]) else return null
    ty :: arg_ty_or_unresolved(arg_or_null)
    name :: string_literal_text(intrinsic.args[1]) else return null
    if ty !is StructType {
        return null
    }
    at :: struct_field_index(ctx.typed, ty.symbol.id, name)
    if at < 0 {
        return null
    }
    return LoweredIntLit { .span = intrinsic.span, .type = type, .value = at }
}

/// Fold `@type_of(x)` to a `LoweredTypeConst` carrying `x`'s static
/// type. The arg is NOT evaluated (Zig-style `@TypeOf`): only the
/// typed AST's recorded expr-type is read.
try_fold_type_of :: fn(
    ctx: FnLowerCtx, intrinsic: IntrinsicCallExpr, type: Type,
) -> LoweredExpr | null {
    if intrinsic.args.len() != 1 { return null }
    arg_type :: expr_type(ctx.types, intrinsic.args[0])
    return LoweredTypeConst {
        .span = intrinsic.span, .type = type, .value = arg_type,
    }
}

// The type arguments of a resolved intrinsic type argument: a struct's or a
// trait's, else empty. Read-only : they are borrowed straight from the type.
type_args_of :: fn(arg_or_null: Type | null) -> Type[] {
    if arg_or_null is null { return [] }
    ty :: arg_ty_or_unresolved(arg_or_null)
    if ty is StructType { return ty.args }
    if ty is TraitType { return ty.args }
    return []
}

/// Fold `@type_args(T)` to an array literal of `LoweredTypeConst`s: one
/// per generic argument of `T`. Returns an empty array for non-generic
/// shapes.
try_fold_type_args :: fn(
    ctx: FnLowerCtx, intrinsic: IntrinsicCallExpr, type: Type,
) -> LoweredExpr | null {
    if intrinsic.args.len() != 1 { return null }
    arg_or_null :: resolve_intrinsic_type_arg(ctx, intrinsic.args[0])
    args :: type_args_of(arg_or_null)
    elements: LoweredExpr[]: []
    for a in args {
        elements.push(LoweredTypeConst {
            .span = intrinsic.span, .type = TY_TYPE, .value = a,
        })
    }
    return LoweredArrayLit {
        .span = intrinsic.span, .type = type, .elements = elements,
    }
}

/// Fold `@fields(T)` to an array literal of `Field { name, type }`
/// struct lits: one entry per field declared on `T`. Generic struct
/// args flow into each field's type so `@fields(Pair<string, i64>)`
/// reports `value` as `i64`, not the unsubstituted TypeParam.
///
/// @param ctx        the fn-body lower context.
/// @param intrinsic  the `@fields(T)` call site.
/// @param type       the result type (`Field[]`).
/// @return           the array lit, or `LoweredUnreachable` when the
///                   target isn't a struct / Field core type isn't
///                   reachable / the struct decl can't be found.
try_fold_fields :: fn(
    ctx: FnLowerCtx, intrinsic: IntrinsicCallExpr, type: Type,
) -> LoweredExpr | null {
    if intrinsic.args.len() != 1 { return null }
    arg_or_null :: resolve_intrinsic_type_arg(ctx, intrinsic.args[0]) else return null
    target_ty :: arg_ty_or_unresolved(arg_or_null)
    target_struct: StructType | null = null
    if target_ty is StructType { target_struct = target_ty }
    if target_struct is null {
        return LoweredUnreachable {
            .span = intrinsic.span, .type = type,
            .reason = "@fields target is not a struct",
        }
    }
    field_type_opt :: find_core_type(ctx, STRUCT_FIELD, []) else {
        return LoweredUnreachable {
            .span = intrinsic.span, .type = type,
            .reason = "@fields needs std/core::Field",
        }
    }
    field_type :: field_type_opt
    // The struct tables are shared by the project : any module's view reads them.
    decl :: ctx.typed.struct_decls[target_struct.symbol.id]
    declared :: ctx.typed.struct_fields[target_struct.symbol.id]
    if decl is null || declared is null {
        return LoweredUnreachable {
            .span = intrinsic.span, .type = type,
            .reason = "@fields target struct decl not found",
        }
    }
    // Build the type-param -> arg substitution using the existing
    // helper that the generic-instance materialiser uses.
    subst :: build_concrete_subst(decl.type_params, target_struct.args, ctx.typed)
    string_type :: TY_STRING
    elements: LoweredExpr[]: []
    for [name, field] in declared {
        substituted :: substitute(laid_out_unions(field.ty), subst)
        field_lit_fields :: [
            LoweredStructLitField {
                .name = "name",
                .value = LoweredStringLit {
                    .span = intrinsic.span, .type = string_type, .value = name,
                },
            },
            LoweredStructLitField {
                .name = "type",
                .value = LoweredTypeConst {
                    .span = intrinsic.span, .type = TY_TYPE, .value = substituted,
                },
            },
        ]
        elements.push(build_core_struct_lit(ctx, field_type, field_lit_fields, intrinsic.span))
    }
    return LoweredArrayLit {
        .span = intrinsic.span, .type = type, .elements = elements,
    }
}

/// Fold `@satisfies(T, Trait)` to a literal bool.
try_fold_satisfies :: fn(
    ctx: FnLowerCtx, intrinsic: IntrinsicCallExpr, type: Type,
) -> LoweredExpr | null {
    if intrinsic.args.len() != 2 {
        return null
    }
    target :: resolve_intrinsic_type_arg(ctx, intrinsic.args[0])
    wanted :: resolve_intrinsic_type_arg(ctx, intrinsic.args[1])
    value :: target != null && wanted != null && satisfies_trait(target, wanted, ctx.typed)
    return LoweredBoolLit { .span = intrinsic.span, .type = type, .value = value }
}

arg_ty_or_unresolved :: fn(t: Type | null) -> Type {
    if t == null { return TY_UNRESOLVED }
    return t
}

resolve_intrinsic_type_arg :: fn(ctx: FnLowerCtx, arg: Expr) -> Type | null {
    raw :: ctx.types.type_expr_type(arg)
    if !(raw is UnresolvedType) { return raw }
    if arg is IdentExpr {
        // The resolver's own symbol, not an instance's clone: the tables are keyed
        // by its id.
        sym :: ctx.typed.resolved.idents[arg.span.hash()] else return raw
        return resolve_type_meta_symbol(ctx, sym) else raw
    }
    return raw
}
