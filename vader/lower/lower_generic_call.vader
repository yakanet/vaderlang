// vader/lower/lower_generic_call — generic function calls: the instance a call names, and its emit.
//

module "vader/lower"

import "std/collections"
import "std/string_builder"

import "toolchain/ast"
import "vader/diagnostics"
import "vader/typecheck"
import "vader/resolver/symbol"
import "vader/types"
import "vader/comptime"
import "vader/resolver"
import "toolchain/span"

/// Chase an `ImportBinding` symbol through `import_targets.symbol_targets`
/// to its concrete export target. Returns the original symbol when it
/// isn't an ImportBinding, or when the target lookup fails (let the
/// caller's kind-check filter the wrong shape).
follow_import_binding :: fn(ctx: FnLowerCtx, sym: Symbol) -> Symbol {
    if sym.kind != .ImportBinding { return sym }
    targets :: ctx.typed.import_targets ?? return sym
    if targets is ImportTargetTable {
        st :: targets.symbol_targets[sym.id] ?? return sym
        if st is SymbolTarget { return st.symbol }
    }
    return sym
}

// A call to a top-level generic fn lowers to a direct call to its monomorphized
// instance, at the type arguments the typecheck recorded (`emit_generic_fn_call`).
try_lower_generic_fn_call :: fn(ctx: FnLowerCtx, call: CallExpr, type: Type) -> LoweredExpr! | null {
    // Explicit-args generic call : `identity<i32>(42)`. The callee
    // is a GenericInstExpr whose inner callee is the fn IdentExpr.
    // Type args come from the GenericInstExpr's type_args slot.
    if call.callee is GenericInstExpr as gi {
        if gi.callee is IdentExpr as inner_id {
            fn_sym :: recorded_fn_symbol(ctx, call)
                ?? follow_import_binding(ctx, resolve_ident(ctx, inner_id.span) ?? return null)
            if fn_sym.kind == .Fn {
                type_args: Type[]: []
                for ta in gi.type_args {
                    resolved :: ctx.types.type_expr_type(ta)
                    if resolved is UnresolvedType {
                        type_args.push(type_from_expr(ta, ctx.typed.resolved, []))
                    } else {
                        type_args.push(resolved)
                    }
                }
                if all_concrete(type_args) {
                    return register_and_emit_generic_call(ctx, call, type, fn_sym, type_args, inner_id.span)
                }
            }
        }
    }
    callee_ident :: as_ident(call.callee) ?? return null
    // An overloaded name binds to its first declaration ; the overload the
    // typecheck picked is the one this call instantiates.
    fn_sym :: recorded_fn_symbol(ctx, call)
        ?? follow_import_binding(ctx, resolve_ident(ctx, callee_ident.span) ?? return null)
    if fn_sym.kind != .Fn { return null }
    callee_ty :: ctx.types.expr_type(callee_ident)
    if callee_ty !is FnType {
        return null
    }
    return emit_generic_fn_call(ctx, call, type, fn_sym, callee_ty.params, callee_ident.span)
}

// The call to the instance of the generic fn `fn_sym` that `call` names, its
// arguments prepared for `params`. Shared by the direct-ident path
// (`try_lower_generic_fn_call`) and the namespace-member path
// (`try_lower_namespace_call`, `io.println` → `println<T: Display>`). Null when the
// fn takes no type argument or they are not all concrete (recovery — the caller
// falls through to its non-generic handling).
emit_generic_fn_call :: fn(
    ctx: FnLowerCtx, call: CallExpr, type: Type, fn_sym: Symbol, params: Type[], callee_span: Span,
) -> LoweredExpr! | null {
    mangled :: recorded_instance_mangle(ctx, call, fn_sym) ?? return null
    lowered_args :: lower_call_args(ctx, call.args, params, 0)
    return LoweredCall {
        .span = call.span,
        .type = type,
        .callee = LoweredIdent {
            .span = callee_span,
            .type = type,
            .symbol = instance_symbol(fn_sym, mangled),
        },
        .args = lowered_args,
    }
}

// The mangle of the instance of the generic `fn_sym` that `call` names, at the type
// arguments the typecheck recorded there, registered for materialisation. Null for a
// fn that takes none, or for arguments not all concrete.
recorded_instance_mangle :: fn(ctx: FnLowerCtx, call: CallExpr, fn_sym: Symbol) -> string | null {
    type_args :: recorded_type_args(ctx, call, fn_sym) ?? return null
    if !all_concrete(type_args) {
        return null
    }
    return register_fn_instance_mangle(ctx, fn_sym, type_args)
}

// The callee naming the instance `mangled` of `fn_sym`. It carries `fn_sym.id` : the
// materialised instance registers in `function_index_by_symbol_id` under its origin
// symbol, so a call keyed on a placeholder id (`0`) misses and is silently dropped.
instance_symbol :: fn(fn_sym: Symbol, mangled: string) -> Symbol = Symbol {
    .id         = fn_sym.id,
    .kind       = .Fn,
    .name       = mangled,
    .module     = fn_sym.module,
    .module_name = fn_sym.module,
    .visibility = .Private,
    .defined_at = null,
}

// Register (once per instance) the monomorphic instance for
// `fn_sym<type_args>` and return its mangle.
//
// THE one place that builds either the mangle or the dedupe key. Both are derived
// here from the arguments, so no caller can build them differently — which is
// exactly what went wrong before: the UFCS harvest doubled the module prefix
// (`mod$mod$name`) while the direct-call path emitted it once. Since both key the
// instance identically and this fn returns whatever mangle was registered FIRST
// for that key, the emitted symbol depended on which syntactic form the lowering
// reached first — moving two lines of source renamed the function in the binary
// (`snippet$first_of__i32` vs `snippet$snippet$first_of__i32`). Keep the
// derivation in here; a `base_mangled` parameter is what let the two drift.
//
// The mangle is `<module>$<name><suffix>` — single module prefix, aligned with the
// canonical mono mangle in `comptime/mangle.vader` — run through `uniq` so two
// same-name / same-arity overloads (`collect(arr: T[])` vs
// `collect(it: Iterator<T>)`) don't collide on one fn name: the second to register
// gets a `_1` suffix, keeping the `dump_bytecode → parse_virt → exec` round-trip's
// fn names distinct. Later call sites of the same instance reuse the cached mangle.
//
// A distinct among `type_args` keys the instance of its backing, unless the fn
// keeps its instances concrete (`instance_type_args`).
//
// The module is the fn's DEFINING one (`fn_sym.module`), never the caller's:
// `build_fn_instance_decl` looks the AST decl up there. Its *display* path (the
// declared `module "..."` name) feeds the mangle, not the filesystem id, so the
// name matches the surfaced decl's — falling back to the id when the lookup misses.
register_fn_instance_mangle :: fn(
    ctx: FnLowerCtx, fn_sym: Symbol, type_args: Type[],
) -> string {
    concrete_args :: instance_type_args(ctx, fn_sym, type_args)
    owner_module :: fn_sym.module
    display :: lookup_module_display_path(ctx, owner_module)
    mod_mangle :: mangle_module_id(if display == null { owner_module } else { display })
    suffix :: call_site_instance_suffix(ctx, fn_sym, concrete_args)
    base_mangled :: "${mod_mangle}$${fn_sym.name}${suffix}"
    inst_key :: "${fn_sym.id}::${suffix}"
    existing :: ctx.project.fn_instances[inst_key]
    match existing {
        is GenericFnInstance -> { return existing.mangled }
        is null -> {
            fresh :: uniq(ctx.project.seen_mangled, base_mangled)
            new_inst :: GenericFnInstance {
                .fn_symbol    = fn_sym,
                .type_args    = concrete_args,
                .mangled      = fresh,
                .owner_module = owner_module,
            }
            ctx.project.fn_instances[inst_key] = new_inst
            ctx.project.fn_instances_order.push(new_inst)
            return fresh
        }
    }
}

// The call to the instance of `fn_sym` at the written type arguments of an
// explicit `fn<T>(args)` call.
register_and_emit_generic_call :: fn(
    ctx: FnLowerCtx, call: CallExpr, type: Type,
    fn_sym: Symbol, concrete_args: Type[], callee_span: Span,
) -> LoweredExpr! {
    mangled :: register_fn_instance_mangle(ctx, fn_sym, concrete_args)
    lowered_args: LoweredExpr[]: []
    for ca in call.args { lowered_args.push(lower_converted(ctx, ca.value)) }
    return LoweredCall {
        .span = call.span, .type = type,
        .callee = LoweredIdent {
            .span = callee_span, .type = type, .symbol = instance_symbol(fn_sym, mangled),
        },
        .args = lowered_args,
    }
}

all_concrete :: fn(args: Type[]) -> bool {
    for a in args {
        if type_contains_type_param(a) { return false }
        if a is UnresolvedType { return false }
    }
    return true
}

mono_suffix :: fn(args: Type[]) -> string {
    sb :: StringBuilder {}
    for a in args {
        sb.append("__")
        sb.append(mangle_instance_arg(a))
    }
    return sb.to_string()
}

// A type argument as it names an instance. A distinct keeps its own name, since
// one reaching here is kept by a concrete instance (`instance_type_args`) whose
// body is not its backing's ; an enum or a distinct is qualified by its module,
// its name being unique only there.
// @partial: any other type is named by its display key.
mangle_instance_arg :: fn(t: Type) -> string = @partial match t {
    is EnumType     -> module_qualified_name(t.symbol)
    is DistinctType -> module_qualified_name(t.symbol)
    _               -> mangle_type_arg(t)
}
