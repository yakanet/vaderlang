// vader/lower/lower_range_conversion — `Hour(x)` and `x in Hour`, a value against
// the bounds of an integer type, and the value a generic instance gets back through
// a `T` it binds to a range.
//
// The value is tested against the bounds its own type does not already keep —
// `u8` into `-5..=5` needs no test below. A conversion stops the program outside
// them, in every build : a range's values are what its type promises, and the
// lowering past here reads a range as the integer it is held in. A value its type
// keeps within the range is converted as it is. `x in T` gives the test's
// outcome, a constant where the type of `x` decides it.

module "vader/lower"

import "toolchain/ast"
import "toolchain/span"
import "vader/integer"
import "vader/typecheck"
import "vader/types"

/// The conversion `call`, `T(value)`, into the range `target`.
///
/// @param call    the conversion, its single argument the value.
/// @param target  the range converted into, as the typecheck recorded it.
/// @return        the value, checked where it may leave the range, then
///                converted to the integer the range is held in.
lower_range_conversion :: fn(ctx: FnLowerCtx, call: CallExpr, target: RangeType) -> LoweredExpr {
    observe_no_call(ctx, call, .Call, "range check")
    value :: lower_expr(ctx, call.args[0].value)
    return checked_into(ctx, value, values_of(ctx, call.args[0].value, value), target, call.span)
}

/// `value`, the outcome of `e`, checked against the range its instance binds the
/// type parameter `e` is a value of. A member reached through such a `T` is the
/// integer's own (a range borrows its integer's impls), and what it hands back is
/// a value of the integer : `a + b` of two `Hour` may be 30.
///
/// @param e      a call or an operator, its type as the typecheck recorded it.
/// @param value  `e`, lowered.
/// @return       `value`, unchanged when `e` is no value of a type parameter bound
///               to a range.
kept_in_range :: fn(ctx: FnLowerCtx, e: Expr, value: LoweredExpr) -> LoweredExpr {
    if ctx.types.subst.ranges == null {
        return value
    }
    target :: bound_range(ctx.types.subst, ctx.types.raw_expr_type(e)) ?? return value
    return checked_into(ctx, value, integer_values(value.type), target, e.span)
}

// `value` converted into `target`, the program stopped where it lies outside. Only
// the bounds `source`, the values it can take, does not already keep are tested.
checked_into :: fn(
    ctx: FnLowerCtx,
    value: LoweredExpr,
    source: Interval | null,
    target: RangeType,
    span: Span,
) -> LoweredExpr {
    held :: range_representation(target).name
    source_values :: source ?? return cast_to_width(value, held, span)
    below :: may_lie_below(source_values, target.bounds)
    above :: may_lie_above(source_values, target.bounds)
    if !below && !above {
        return cast_to_width(value, held, span)
    }
    compared :: comparison_type(source_values, target.bounds, below, above)
    stmts: LoweredStmt[]: []
    bound :: bind_to_local(
        ctx,
        cast_to_width(value, compared.name, span),
        compared,
        "in_range",
        span,
        stmts,
    )
    stmts.push(
        LoweredExprStmt {
            .span = span,
            .expr = LoweredIf {
                .span = span,
                .type = TY_VOID,
                .cond = outside_test(bound, target.bounds, below, above, compared, span),
                .then_block = LoweredBlock {
                    .span = span,
                    .type = TY_VOID,
                    .stmts = [stop_outside(target, span)],
                    .trailing = null,
                },
                .else_block = null,
            },
        },
    )
    return with_prelude(stmts, cast_to_width(bound, held, span), span)
}

/// The test `binary`, `x in T` or `x !in T`, `T` an integer type.
///
/// @param binary  the test, its right operand the type the typecheck recorded.
/// @return        whether `x` lies within `T`'s bounds, negated for `!in`.
lower_in_type :: fn(ctx: FnLowerCtx, binary: BinaryExpr) -> LoweredExpr {
    observe_no_call(ctx, binary, .Operator, "bounds")
    span :: binary.span
    negated :: binary.op == .NotIn
    value :: lower_expr(ctx, binary.left)
    tested :: integer_values(ctx.types.raw_expr_type(binary.right))
    source :: values_of(ctx, binary.left, value)
    if tested == null || source == null {
        return stub(span, TY_BOOL, "`in` over a type with no integer bounds")
    }
    if interval_meet(source, tested) == null {
        return decided(value, negated, span)
    }
    below :: may_lie_below(source, tested)
    above :: may_lie_above(source, tested)
    if !below && !above {
        return decided(value, !negated, span)
    }
    compared :: comparison_type(source, tested, below, above)
    stmts: LoweredStmt[]: []
    tested_value: LoweredExpr = cast_to_width(value, compared.name, span)
    if below && above {
        tested_value = bind_unless_stable(ctx, tested_value, "in_x", span, stmts)
    }
    outside :: outside_test(tested_value, tested, below, above, compared, span)
    return with_prelude(stmts, maybe_negate(outside, !negated, span), span)
}

// `outcome`, once `value` has run for what it does.
decided :: fn(value: LoweredExpr, outcome: bool, span: Span) -> LoweredExpr {
    known :: LoweredBoolLit { .span = span, .type = TY_BOOL, .value = outcome }
    if is_effect_free_read(value) {
        return known
    }
    return with_prelude([LoweredExprStmt { .span = span, .expr = value }], known, span)
}

// Whether a value of `source` may lie below `bounds`, and above them : an open
// end of `bounds` holds every value past it.
may_lie_below :: fn(source: Interval, bounds: Interval) -> bool =
    !bounds.lo_open && (source.lo_open || source.lo < bounds.lo)

may_lie_above :: fn(source: Interval, bounds: Interval) -> bool =
    !bounds.hi_open && (source.hi_open || source.hi > bounds.hi)

// The values the converted value can take : those of its type as the typecheck
// recorded it, a range's bounds included, else of the type it is lowered at.
values_of :: fn(ctx: FnLowerCtx, arg: Expr, lowered: LoweredExpr) -> Interval | null {
    recorded :: integer_values(ctx.types.raw_expr_type(arg))
    if recorded != null {
        return recorded
    }
    return integer_values(lowered.type)
}

// The integer type a value of `source` is compared in with the bounds of `target`
// it is tested against : one holding both.
comparison_type :: fn(source: Interval, target: Interval, below: bool, above: bool) -> PrimitiveType {
    tested := source
    if below {
        tested = interval_join(tested, interval(target.lo, target.lo))
    }
    if above {
        tested = interval_join(tested, interval(target.hi, target.hi))
    }
    return narrowest_integer(tested)
}

// `value < lo || value > hi`, each side only where it is tested.
outside_test :: fn(
    value: LoweredExpr,
    bounds: Interval,
    below: bool,
    above: bool,
    compared: Type,
    span: Span,
) -> LoweredExpr {
    under :: bound_test(value, .Lt, bounds.lo, compared, span)
    over :: bound_test(value, .Gt, bounds.hi, compared, span)
    if !below {
        return over
    }
    if !above {
        return under
    }
    return LoweredBinary {
        .span = span,
        .type = TY_BOOL,
        .op = .Or,
        .left = under,
        .right = over,
    }
}

// `value op bound`.
bound_test :: fn(
    value: LoweredExpr,
    op: LoweredBinaryOp,
    bound: i64,
    compared: Type,
    span: Span,
) -> LoweredExpr = LoweredBinary {
    .span = span,
    .type = TY_BOOL,
    .op = op,
    .left = value,
    .right = LoweredIntLit { .span = span, .type = compared, .value = bound },
}

// The stop a value outside `target` reaches.
stop_outside :: fn(target: RangeType, span: Span) -> LoweredStmt = LoweredExprStmt {
    .span = span,
    .expr = LoweredUnreachable {
        .span = span,
        .type = TY_VOID,
        .reason = "value out of range: not in ${display_range(target)}",
    },
}
