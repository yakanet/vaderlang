// vader/lower/lower_range_conversion — `Hour(x)` and `x in Hour`, a value against
// the bounds of an integer type ; `Weekday(x)` and `x in Weekday`, against the values
// of an enum ; and the value a generic instance gets back through a `T` it binds to
// a range.
//
// The tested values are runs of integers : a range is one, an enum one per stretch
// of consecutive values. A value is tested only against what its own type does not
// already decide : `u8` into `-5..=5` needs no test below. A conversion stops the
// program off them, in every build : a type's values are what it promises, and the
// lowering past here reads a range or an enum as the integer it is held in. `x in T`
// gives the test's outcome, a constant where the type of `x` decides it.

module "vader/lower"

import "toolchain/ast"
import "toolchain/span"
import "vader/integer"
import "vader/typecheck"
import "vader/types"

/// The conversion `call`, `T(value)`, into the range `target`.
///
/// @param call    the conversion, its single argument the value.
/// @param target  the range converted into, at this instance (`instance_range`).
/// @return        the value, checked where it may leave the range, then
///                converted to the integer the range is held in.
lower_range_conversion :: fn(ctx: FnLowerCtx, call: CallExpr, target: RangeType) -> LoweredExpr {
    observe_no_call(ctx, call, .Call, "range check")
    value :: lower_expr(ctx, call.args[0].value)
    source :: values_of(ctx, call.args[0].value, value)
    return checked_into_range(ctx, value, source, target, call.span)
}

/// The conversion `call`, `E(value)`, into the enum `target`.
///
/// @param call    the conversion, its single argument the value.
/// @param target  an enum without variant data.
/// @return        the value, the program stopped where it is none of `target`'s
///                values, held as the integer `target` stores.
lower_enum_conversion :: fn(ctx: FnLowerCtx, call: CallExpr, target: EnumType) -> LoweredExpr {
    observe_no_call(ctx, call, .Call, "enum check")
    value :: lower_expr(ctx, call.args[0].value)
    source :: values_of(ctx, call.args[0].value, value)
    reason :: "value out of range: no value of `${target.symbol.name}`"
    return checked_into(ctx, value, source, enum_value_runs(target), target.repr, reason, call.span)
}

/// `value`, the outcome of `e`, checked against the range its instance binds the
/// type parameter `e` is a value of. A member reached through such a `T` is the
/// integer's own (a range borrows its integer's impls), and what it hands back is
/// a value of the integer : `a + b` of two `Hour` may be 30.
///
/// @param e      a call or an operator, its type as the typecheck recorded it.
/// @param value  `e`, lowered.
/// @return       `value`, unchanged when `e` is no value of a type parameter bound
///               to a range, or a conversion `T(x)`, which checks its own.
kept_in_range :: fn(ctx: FnLowerCtx, e: Expr, value: LoweredExpr) -> LoweredExpr {
    if ctx.types.subst.ranges == null {
        return value
    }
    target :: bound_range(ctx.types.subst, ctx.types.raw_expr_type(e)) ?? return value
    if e is CallExpr && recorded_callee(ctx, e, .Call) is Builtin {
        return value
    }
    return checked_into_range(ctx, value, integer_values(value.type), target, e.span)
}

/// The integer type `t`, as the typecheck recorded it, is at this instance, as a
/// range : a range as it is, a type parameter the instance binds to one that range,
/// else the integer it stands for, under its own name.
///
/// @param t  a type the typecheck recorded.
/// @return   null when `t` is no integer type here.
instance_range :: fn(ctx: FnLowerCtx, t: Type) -> RangeType | null {
    held :: ctx.types.instance_argument(t)
    if held is RangeType {
        return held
    }
    if held !is PrimitiveType {
        return null
    }
    values :: integer_values(held) ?? return null
    return RangeType { .bounds = values, .name = held.name }
}

// `value` converted into the range `target` (`checked_into`).
checked_into_range :: fn(
    ctx: FnLowerCtx,
    value: LoweredExpr,
    source: Interval | null,
    target: RangeType,
    span: Span,
) -> LoweredExpr {
    held :: range_representation(target).name
    reason :: "value out of range: not in ${display_range(target)}"
    return checked_into(ctx, value, source, [target.bounds], held, reason, span)
}

// `value` converted into the integer `held`, the program stopped with `reason` where
// it lies in none of `runs`. Only what `source`, the values it can take, does not
// already decide is tested.
checked_into :: fn(
    ctx: FnLowerCtx,
    value: LoweredExpr,
    source: Interval | null,
    runs: Interval[],
    held: string,
    reason: string,
    span: Span,
) -> LoweredExpr {
    known :: source ?? return cast_to_width(value, held, span)
    if decided_inside(known, runs) == true {
        return cast_to_width(value, held, span)
    }
    compared :: narrowest_integer(known)
    stmts: LoweredStmt[]: []
    widened :: cast_to_width(value, compared.name, span)
    bound :: bind_to_local(ctx, widened, compared, "in_range", span, stmts)
    stmts.push(stop_if(outside_test(bound, known, runs, compared, span), reason, span))
    return with_prelude(stmts, cast_to_width(bound, held, span), span)
}

/// The test `binary`, `x in T` or `x !in T`, `T` an integer type or an enum.
///
/// @param binary  the test, its right operand the type the typecheck recorded.
/// @return        whether `x` lies within `T`'s bounds, or is one of the enum's
///                values, negated for `!in` ; a constant where the type of `x`
///                decides it.
lower_in_type :: fn(ctx: FnLowerCtx, binary: BinaryExpr) -> LoweredExpr {
    observe_no_call(ctx, binary, .Operator, "bounds")
    span :: binary.span
    negated :: binary.op == .NotIn
    value :: lower_expr(ctx, binary.left)
    runs :: tested_runs(ctx, ctx.types.raw_expr_type(binary.right))
        ?? return stub(span, TY_BOOL, "`in` over a type with no integer bounds")
    source :: values_of(ctx, binary.left, value)
        ?? return stub(span, TY_BOOL, "`in` on a value of no integer type")
    outcome :: decided_inside(source, runs)
    if outcome != null {
        return decided(value, outcome != negated, span)
    }
    compared :: narrowest_integer(source)
    stmts: LoweredStmt[]: []
    tested: LoweredExpr = cast_to_width(value, compared.name, span)
    if comparison_count(source, runs) > 1 {
        tested = bind_unless_stable(ctx, tested, "in_x", span, stmts)
    }
    if negated {
        return with_prelude(stmts, outside_test(tested, source, runs, compared, span), span)
    }
    return with_prelude(stmts, inside_test(tested, source, runs, compared, span), span)
}

// The values `x in t` tests against, `t` as this instance reads it : an enum's runs of
// values, an integer type's bounds ; null for any other type.
tested_runs :: fn(ctx: FnLowerCtx, t: Type) -> Interval[] | null {
    if t is EnumType && t.data == null {
        return enum_value_runs(t)
    }
    held :: instance_range(ctx, t) ?? return null
    return [held.bounds]
}

// `outcome`, once `value` has run for what it does.
decided :: fn(value: LoweredExpr, outcome: bool, span: Span) -> LoweredExpr {
    known :: LoweredBoolLit { .span = span, .type = TY_BOOL, .value = outcome }
    if is_effect_free_read(value) {
        return known
    }
    return with_prelude([LoweredExprStmt { .span = span, .expr = value }], known, span)
}

// Whether a value of `source` may lie below `bounds`, and above them : an open
// end of `bounds` holds every value past it.
may_lie_below :: fn(source: Interval, bounds: Interval) -> bool =
    !bounds.lo_open && (source.lo_open || source.lo < bounds.lo)

may_lie_above :: fn(source: Interval, bounds: Interval) -> bool =
    !bounds.hi_open && (source.hi_open || source.hi > bounds.hi)

// The values the converted value can take : a literal's own, those of its type as
// the typecheck recorded it, a range's bounds included, else of the type it is
// lowered at.
values_of :: fn(ctx: FnLowerCtx, arg: Expr, lowered: LoweredExpr) -> Interval | null {
    if lowered is LoweredIntLit {
        return interval(lowered.value, lowered.value)
    }
    recorded :: integer_values(ctx.types.raw_expr_type(arg))
    if recorded != null {
        return recorded
    }
    return integer_values(lowered.type)
}

// The parts of `runs` a value of `source` may lie in, each cut to `source`.
reachable_runs :: fn(source: Interval, runs: Interval[]) -> Interval[] {
    out: Interval[]: []
    for run in runs {
        met :: interval_meet(run, source) ?? continue
        out.push(met)
    }
    return out
}

// Whether a value of `source` lies in one of `runs` whatever it is : false when none
// is reachable, true when one holds all of `source` ; null when only the value tells.
decided_inside :: fn(source: Interval, runs: Interval[]) -> bool | null {
    reachable :: reachable_runs(source, runs)
    if reachable.len() == 0 {
        return false
    }
    if reachable.len() == 1 && same_interval(reachable[0], source) {
        return true
    }
    return null
}

// How many comparisons `inside_test` makes on a value of `source`.
comparison_count :: fn(source: Interval, runs: Interval[]) -> usize {
    count: usize = 0
    for run in reachable_runs(source, runs) {
        if is_single_value(run) {
            count += 1
        } else {
            count += ends_tested(source, run)
        }
    }
    return count
}

// How many ends of `run`, within `source`, a value of `source` may pass.
ends_tested :: fn(source: Interval, run: Interval) -> usize {
    count: usize = 0
    if may_lie_below(source, run) {
        count += 1
    }
    if may_lie_above(source, run) {
        count += 1
    }
    return count
}

is_single_value :: fn(run: Interval) -> bool = run.lo == run.hi && !run.lo_open && !run.hi_open

// Whether `value`, of the integer type `compared` holding `source`, lies in one of
// `runs` : one test per reachable run, each comparing only the ends `source` may
// pass ; `false` when none is reachable. Every bound compared lies within `source`,
// so `compared` holds it.
inside_test :: fn(
    value: LoweredExpr,
    source: Interval,
    runs: Interval[],
    compared: Type,
    span: Span,
) -> LoweredExpr {
    parts: LoweredExpr[]: []
    for run in reachable_runs(source, runs) {
        parts.push(run_test(value, source, run, compared, span))
    }
    return or_all(span, parts)
}

// Whether `value`, of the integer type `compared` holding `source`, lies in none of
// `runs` : past an end of the one reachable run, or in none of several ; `true` when
// none is reachable.
outside_test :: fn(
    value: LoweredExpr,
    source: Interval,
    runs: Interval[],
    compared: Type,
    span: Span,
) -> LoweredExpr {
    reachable :: reachable_runs(source, runs)
    if reachable.len() != 1 {
        return maybe_negate(inside_test(value, source, runs, compared, span), true, span)
    }
    run :: reachable[0]
    if is_single_value(run) {
        return bound_test(value, .Neq, run.lo, compared, span)
    }
    tests: LoweredExpr[]: []
    if may_lie_below(source, run) {
        tests.push(bound_test(value, .Lt, run.lo, compared, span))
    }
    if may_lie_above(source, run) {
        tests.push(bound_test(value, .Gt, run.hi, compared, span))
    }
    return or_all(span, tests)
}

// Whether `value` lies in `run`, a run within `source` : is its one value, or passes
// none of the ends `source` may pass.
run_test :: fn(
    value: LoweredExpr,
    source: Interval,
    run: Interval,
    compared: Type,
    span: Span,
) -> LoweredExpr {
    if is_single_value(run) {
        return bound_test(value, .Eq, run.lo, compared, span)
    }
    tests: LoweredExpr[]: []
    if may_lie_below(source, run) {
        tests.push(bound_test(value, .Gte, run.lo, compared, span))
    }
    if may_lie_above(source, run) {
        tests.push(bound_test(value, .Lte, run.hi, compared, span))
    }
    return and_all(span, tests)
}

// `value op bound`.
bound_test :: fn(
    value: LoweredExpr,
    op: LoweredBinaryOp,
    bound: i64,
    compared: Type,
    span: Span,
) -> LoweredExpr = LoweredBinary {
    .span = span,
    .type = TY_BOOL,
    .op = op,
    .left = value,
    .right = LoweredIntLit { .span = span, .type = compared, .value = bound },
}

// `if stop { @unreachable(reason) }` : a value off its type stops the program, in
// every build.
stop_if :: fn(stop: LoweredExpr, reason: string, span: Span) -> LoweredStmt = LoweredExprStmt {
    .span = span,
    .expr = LoweredIf {
        .span = span,
        .type = TY_VOID,
        .cond = stop,
        .then_block = LoweredBlock {
            .span = span,
            .type = TY_VOID,
            .stmts = [
                LoweredExprStmt {
                    .span = span,
                    .expr = LoweredUnreachable { .span = span, .type = TY_VOID, .reason = reason },
                },
            ],
            .trailing = null,
        },
        .else_block = null,
    },
}
