// vader/lower/intrinsic_member: a call to a member of `std/core`'s `Intrinsic`.
//
// The toolchain implements `Intrinsic` (`lib/std/core/intrinsics.vader`): a
// member has no body, and `Intrinsic.byte_len(s)` calls the member itself. A
// member of the arrays is the operation the lowering has a node for
// (`array_member_op`). Any other member a call reaches is surfaced as a bodyless
// declaration carrying its name, which the bytecode emitter reserves as the
// import of that host, or replaces by the op that serves it.

module "vader/lower"

import "std/collections"
import "std/iter"
import "toolchain/ast"
import "toolchain/span"
Bc :: import "vader/core/bytecode"
import "vader/core/mangle"
import "vader/core/mono"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/resolver"
import "vader/front/typecheck"
import "vader/lower/ir"

/// `Intrinsic.member(args)` : the member called on its arguments.
///
/// @param call  the call.
/// @param type  its result type.
/// @return      the lowered call ; null when the callee is no member of
///              `Intrinsic`.
try_lower_intrinsic_call :: fn(ctx: FnLowerCtx, call: CallExpr, type: Type) -> LoweredExpr | null {
    field :: as_field_expr(call.callee) else return null
    if !names_intrinsic(ctx, field.target) {
        return null
    }
    member :: recorded_decl(ctx.typed, call) else return null
    observe_inlined(ctx, call, member, member.name)
    return lower_forwarding_on_arguments(ctx, member, call, type)
}

/// A call to a function that only forwards its parameters to a primitive
/// operation (`forwarding_of`), but a method-form one, which `method_target`
/// decides : the operation on the call's arguments.
///
/// @param call  the call.
/// @param type  its result type.
/// @return      the lowered call ; null when the callee forwards nothing.
try_lower_forwarded_call :: fn(ctx: FnLowerCtx, call: CallExpr, type: Type) -> LoweredExpr | null {
    callee :: call.callee
    if callee is FieldExpr && as_namespace_binding(ctx, callee.target) == null {
        return null
    }
    decl :: recorded_decl(ctx.typed, call) else return null
    forwarding :: forwarding_of(ctx.project, decl) else return null
    observe_inlined(ctx, call, decl, decl.name)
    return lower_forwarding_on_arguments(ctx, forwarding, call, type)
}

// The operation `forwarding` on the arguments of `call`, each lowered for its
// parameter.
lower_forwarding_on_arguments :: fn(
    ctx: FnLowerCtx,
    forwarding: Forwarding,
    call: CallExpr,
    type: Type,
) -> LoweredExpr {
    signature :: forwarding_signature(ctx, forwarding, first_argument_type(ctx, call))
    operands :: lower_call_args(ctx, call.args, signature.params, 0)
    return lower_forwarding(ctx, forwarding, signature, operands, type, call.span, call.callee.span)
}

// The type of the first argument of `call` ; null when it has none.
first_argument_type :: fn(ctx: FnLowerCtx, call: CallExpr) -> Type | null =
    if call.args.is_empty() { null } else { ctx.types.expr_type(call.args[0].value) }

/// The signature of `member` of `Intrinsic` at a call whose first argument has the
/// type `first` : a generic member's parameters bound by that argument, as every
/// generic member of the trait takes what it is generic over first (a `T`, or a
/// `T[]`).
///
/// @param member  a member of `Intrinsic`.
/// @param first   the type of the call's first argument ; null when it has none.
intrinsic_signature :: fn(ctx: FnLowerCtx, member: FnDecl, first: Type | null) -> FnType {
    intrinsic :: ctx.typed.intrinsic_symbol else return mk_fn([], TY_UNRESOLVED, [])
    declared :: trait_member_type(intrinsic.id, member, ctx.typed)
    known :: first else return declared
    if declared.type_params.is_empty() || declared.params.is_empty() {
        return declared
    }
    bindings :: Map<i32, Type> {}
    unify_type_param(declared.params[0], backing_array_or(known), bindings)
    return FnType {
        .params = substitute_each_map(declared.params, bindings),
        .return_type = substitute_map(declared.return_type, bindings),
    }
}

// The array `t` holds, a distinct one's included ; `t` itself when it holds none.
backing_array_or :: fn(t: Type) -> Type {
    array :: array_backing(t) else return t
    return array
}

/// `member` of `Intrinsic` called on `operands` : the node of an array member, the
/// call of the member's declaration otherwise.
///
/// @param member       a member of `Intrinsic`.
/// @param signature    its signature at the call (`intrinsic_signature`).
/// @param operands     its arguments, each lowered for its parameter.
/// @param type         the call's result type.
/// @param span         the call.
/// @param callee_span  what names the callee.
lower_intrinsic_member :: fn(
    ctx: FnLowerCtx,
    member: FnDecl,
    signature: FnType,
    operands: LoweredExpr[],
    type: Type,
    span: Span,
    callee_span: Span,
) -> LoweredExpr {
    op :: array_member_op(Bc.intrinsic_id(member.name))
    if op != null {
        return array_op(op, operands, type, span, copied_operand_types(op, signature))
    }
    mangled :: intrinsic_instance_name(ctx, member, signature)
    note_member_origin(ctx, mangled, member, TRAIT_INTRINSIC)
    reached :: ReachedIntrinsic { .member = member.name, .signature = signature }
    ctx.project.referenced_intrinsics[mangled] = reached
    callee :: LoweredIdent {
        .span = callee_span,
        .type = signature,
        .symbol = named_fn_symbol(ctx, mangled),
    }
    return LoweredCall {
        .span = span,
        .type = type,
        .callee = callee,
        .args = operands,
    }
}

// The types the operation `op` reads its operands at : the copying operations'
// only (`array_op`).
copied_operand_types :: fn(op: ArrayOp, signature: FnType) -> Type[] {
    if op != .PushAll && op != .CopyTo {
        return []
    }
    return signature.params
}

/// The operation the member `id` of `Intrinsic` names, on an array ; null for a
/// member a call reaches.
///
/// @param id  the member.
array_member_op :: fn(id: Bc.IntrinsicId) -> ArrayOp | null = match id {
    .ArrayLen        -> .Len
    .ArrayPush       -> .Push
    .ArrayPushAll    -> .PushAll
    .ArrayCopyTo     -> .CopyTo
    .ArrayRemoveLast -> .RemoveLast
    .ArrayClear      -> .Clear
    .NotIntrinsic | .ByteLen | .ByteAt | .ByteSlice | .IsAscii | .Bytes | .BytesToString
        | .StringHash | .StringCompare | .F64ToBits | .BitsToF64 | .F32ToBits | .BitsToF32
        | .DeepCopy | .NewByteBuffer | .BufferLoadU8 | .BufferStoreU8 | .BufferMemoryCopy
        | .BufferInternString | .BufferWriteString
        | .RuntimeCollect | .RuntimeCountAllocations | .RuntimeStatistic
        | .SchedulerSpawn | .SchedulerPark | .SchedulerWake | .SchedulerSleepFor
        | .SchedulerCancel | .SchedulerCurrent | .SchedulerIsCancelled | .SchedulerIsLeaving
        | .SchedulerWatchReadable | .SchedulerWatchExit | .SchedulerMonitorEnter
        | .SchedulerMonitorGive | .SchedulerMonitorExit | .SchedulerTaskEnded
        | .SchedulerPublish | .SchedulerMutexLock | .SchedulerMutexUnlock | .SchedulerMutexWait
        | .WaitStop | .WaitFor
        | .WasmStreamRead | .WasmFutureWait | .WasmThreadNew | .WasmThreadSuspend | .WasmThreadResumeLater | .WasmThreadYield
        | .WasmStreamDrop | .WasmFutureDrop
        | .WasmThreadIndex | .WasmThreadExit
        | .AbortPanic | .TargetCurrentOs | .TargetCurrentArch
        | .FfiOpen | .FfiOpenPath | .FfiSymbol | .FfiCall | .FfiCallFrame -> null
}

// Whether `target` names `std/core`'s `Intrinsic`: its name first, which spares
// the lookup on every other method call.
names_intrinsic :: fn(ctx: FnLowerCtx, target: Expr) -> bool {
    ident :: as_ident(target) else return false
    if ident.name != TRAIT_INTRINSIC {
        return false
    }
    sym :: resolve_ident(ctx, ident.span) else return false
    return is_intrinsic_trait(sym, ctx.typed)
}

// The name of the member `member` of `Intrinsic`, apart from any declaration.
intrinsic_member_name :: fn(member: string) -> string =
    trait_member_mangle(CORE_MODULE, TRAIT_INTRINSIC, member)

/// A member of `Intrinsic` a call reached, at the instance its mangled name names.
ReachedIntrinsic :: struct {
    /// The member's name.
    member: string
    /// Its signature at that instance.
    signature: FnType
}

// The name of `member` of `Intrinsic` at the call whose signature is `signature`:
// a generic member takes one host per instance (`deep_copy` copies by the layout
// of the type it is handed), named after the types bound to its parameters.
intrinsic_instance_name :: fn(ctx: FnLowerCtx, member: FnDecl, signature: FnType) -> string {
    base :: intrinsic_member_name(member.name)
    intrinsic :: ctx.typed.intrinsic_symbol else return base
    declared :: trait_member_type(intrinsic.id, member, ctx.typed)
    if declared.type_params.is_empty() {
        return base
    }
    bindings :: Map<i32, Type> {}
    for i in 0..<declared.params.len() {
        unify_type_param(declared.params[i], signature.params[i], bindings)
    }
    bound :: declared.type_params.map((p) -> bindings[p.symbol.id] else TY_UNRESOLVED).collect()
    return "${base}${mono_suffix(bound)}"
}

/// The members of `trait_decl` a call reached, when it is `Intrinsic`, each a
/// bodyless declaration that names its member.
///
/// @param trait_decl   a trait of the module `typed`.
/// @param typed        the module declaring it.
/// @param project_ctx  holds `referenced_intrinsics`, and the dedupe set.
/// @return             one declaration per member reached and not surfaced yet.
surface_intrinsic_members :: fn(
    trait_decl: TraitDecl, typed: TypedProgram, project_ctx: LowerProjectCtx,
) -> LoweredDecl[] {
    out: LoweredDecl[]: []
    if intrinsic_trait_of(trait_decl, typed) == null {
        return out
    }
    for member in trait_decl.members {
        for [mangled, reached] in project_ctx.referenced_intrinsics {
            if reached.member != member.name || !claim_impl_member(project_ctx, mangled) {
                continue
            }
            out.push(intrinsic_member_decl(member, reached.signature, mangled, typed))
        }
    }
    return out
}

// The member `member` of `Intrinsic`, typed `reached` where a call reached it,
// as the bodyless declaration of its host named `mangled`.
intrinsic_member_decl :: fn(
    member: FnDecl,
    reached: FnType,
    mangled: string,
    typed: TypedProgram,
) -> LoweredFnDecl {
    params: LoweredParam[]: []
    for i in 0..<member.params.len() {
        name :: member.params[i].name
        params.push(LoweredParam {
            .name = name,
            .symbol = synth_param_or(null, name, typed),
            .type = reached.params[i],
        })
    }
    return LoweredFnDecl {
        .mangled     = mangled,
        .params      = params,
        .return_type = reached.return_type,
        .body        = null,
        .origin      = MonoEntry { ...stub_entry(member, typed), .mangled = mangled },
        .intrinsic   = member.name,
    }
}
