// vader/lower/concat_fusion: fuse a run of `s = s + …` appends into ONE concat.
//
// `s = s + a` then `s = s + b` lowers to two `concat_N` calls, and each one is a
// whole string construction: a right-sized byte buffer, one write per part, and
// an atom-table intern of the result. The first result is then thrown away — the
// second call's only use of it is to copy its bytes again. Building the string
// in k steps costs k buffers and k interns where one would do.
//
// So the pass rewrites `concat_M(concat_N(s, a…), b…)` — the shape the two
// statements form — into `concat_{N+M-1}(s, a…, b…)`. It runs from
// `lower_block` right after each statement is lowered, which is what makes it
// cheap and what keeps it safe: the two statements are ADJACENT by construction,
// so nothing can read `s` between them, and a third append fuses against the
// pair the previous step already produced.
//
// Fusing goes through `lower_concat_chain` rather than building the call by
// hand, so the merged operand list also gets the adjacent-literal fold
// (`string_lit.vader`): `s = s + "a"` then `s = s + "b"` lands on
// `concat_2(s, "ab")`, not `concat_3(s, "a", "b")`.

module "vader/lower"

import "toolchain/span"
import "vader/lower/ir"

// One `s = s + …` append statement, destructured. `args` is the concat call's
// full operand list — `args[0]` is the `s` being appended to, the rest is what
// this statement adds.
CfAppend :: struct {
    span:   Span
    target: LoweredIdent
    args:   LoweredExpr[]
}

/// Fuse the last two statements of `stmts` when both append to the same local.
///
/// A no-op unless the tail is exactly the `s = s + …` / `s = s + …` shape. Call
/// it after every statement a block lowers: a run of k appends collapses to one
/// concat by folding pairwise, left to right.
///
/// @param ctx    the lowering context — `lower_concat_chain` mints the fused
///               arity's `concat_N` through it.
/// @param stmts  the block's statements so far ; rewritten in place.
fuse_concat_tail :: fn(ctx: FnLowerCtx, stmts: LoweredStmt[]) -> void {
    n :: stmts.len()
    if n < 2 {
        return
    }
    last :: cf_append_of(ctx, stmts[n - 1]) ?? return
    prev :: cf_append_of(ctx, stmts[n - 2]) ?? return
    if prev.target.symbol.id != last.target.symbol.id {
        return
    }
    // What the SECOND statement appends used to be evaluated after `s` already
    // held the intermediate. Reading `s` there would see a value the fusion
    // deletes, so a mention of it anywhere in those operands blocks the fuse.
    added :: last.args[1..<last.args.len()]
    // A push onto `s` hidden in an operand DOES observe it here.
    if exprs_mention_symbol(added, last.target.symbol.id, ANY_MENTION) {
        return
    }
    merged: LoweredExpr[]: []
    merged.push_all(prev.args)
    merged.push_all(added)
    stmts[n - 2] = LoweredAssign {
        .span = prev.span,
        .target = prev.target,
        .value = lower_concat_chain(ctx, merged, prev.span),
    }
    stmts.remove_last()
}

// Destructure `s = concat_N(s, …)`, or `null` for anything else. The target must
// be a plain local: a captured one is rebound by this very assignment, so it lives
// in a cell, arrives as a `LoweredCellSet` and never reaches here — which is what rules out a closure
// observing the intermediate.
//
// The self-referential first argument is checked BEFORE `cf_is_concat_call`:
// it disqualifies just as much and costs an index plus a compare, where the
// concat check is a map probe. Every `x = f(a, b)` in the tree reaches this.
cf_append_of :: fn(ctx: FnLowerCtx, st: LoweredStmt) -> CfAppend | null {
    if !(st is LoweredAssign) {
        return null
    }
    target :: st.target
    if !(target is LoweredIdent) {
        return null
    }
    value :: st.value
    if !(value is LoweredCall) {
        return null
    }
    if value.args.len() == 0 {
        return null
    }
    head :: value.args[0]
    if !(head is LoweredIdent) {
        return null
    }
    if head.symbol.id != target.symbol.id {
        return null
    }
    if !cf_is_concat_call(ctx, value) {
        return null
    }
    return CfAppend { .span = st.span, .target = target, .args = value.args }
}

// True when `call` is the synthesised `concat_N` for its own arity. Keyed on the
// symbol id in `concat_fn_syms`, not on the mangle — the name is ours to change.
cf_is_concat_call :: fn(ctx: FnLowerCtx, call: LoweredCall) -> bool {
    callee :: call.callee
    if !(callee is LoweredIdent) {
        return false
    }
    sym :: ctx.project.concat_fn_syms[i32(call.args.len())] ?? return false
    return sym.id == callee.symbol.id
}

// Any appearance at all counts: the fusion deletes the intermediate a read of `s`
// would see, whatever reads it.
ANY_MENTION :: MentionKinds { .push_target = true, .array_len = true }
