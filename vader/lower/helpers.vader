// vader/lower/helpers — AST construction helpers shared across passes.
//
// Synthetic-symbol minting, AND / OR-chain assembly, cell and closure-env
// initialisation. The IR's own constructors (`mk_lowered_call`, `mk_void_block`,
// `wrap_as_block`) are `vader/lower/ir`. Kept on the lower side rather
// than the typecheck side since every consumer lives in `vader/lower/`.

module "vader/lower"

import "std/collections"
import "toolchain/ast"
import "vader/core/symbol"
import "vader/front/typecheck"
import "vader/core/types"
import "toolchain/span"
import "vader/lower/ir"

/// `expr`, the value of `node`, through the `into` the typecheck recorded for it
/// toward `slot`, told to the callee verifier (`verify_callees.vader`).
///
/// EVERY call-building path must route its args through here, receiver included :
/// nothing downstream runs an `into`. The integer a value is held in is not the
/// lowering's to decide : the CFG converts it to its slot's
/// (`midir/storage.vader`).
///
/// @param node  the value's AST node.
/// @param expr  the lowered value.
/// @param slot  the type the value converts into.
/// @param span  span to attribute a synthesised `into` call to.
prepare_into :: fn(
    ctx: FnLowerCtx, node: Expr, expr: LoweredExpr, slot: Type, span: Span,
) -> LoweredExpr {
    prepared :: recorded_conversion(ctx, node, .Into, expr, slot, span)
    observe_replacement(ctx, node, .Into, expr, prepared)
    surface_array_into_trait(ctx, prepared.type, slot)
    return prepared
}

// `expr`, the value of `node`, through the `into` the typecheck recorded for the
// site `role` plays at `node`, toward a value of type `slot` ; `expr` itself when
// it recorded none.
recorded_conversion :: fn(
    ctx: FnLowerCtx, node: Expr, role: CallRole, expr: LoweredExpr, slot: Type, span: Span,
) -> LoweredExpr {
    into :: recorded_target(ctx, node, role, expr.type)
    if into is UfcsMember {
        return build_member_call_or_inline(into, [expr], slot, span)
    }
    return expr
}

/// Lower `value` and prepare it for the slot of type `slot` it flows into: an
/// `Into` coercion applies when the slot calls for one.
///
/// @param value  the value's AST node.
/// @param slot   the declared type of the slot.
/// @param span   span to attribute a synthesised `into` call to.
lower_for_slot :: fn(ctx: FnLowerCtx, value: Expr, slot: Type, span: Span) -> LoweredExpr =
    prepare_into(ctx, value, lower_expr(ctx, value), slot, span)

/// Lower `value`, then run the conversion the typecheck accepted on it, if any. For
/// a value whose slot type is not at hand where it is lowered: the target is the one
/// the typecheck filed (`TypedProgram.into_coercions`).
///
/// @param value  the value's AST node.
/// @return       the lowered value, through its `into` when the typecheck accepted one.
lower_converted :: fn(ctx: FnLowerCtx, value: Expr) -> LoweredExpr {
    target :: ctx.typed.into_coercions[value.id] ?? return lower_expr(ctx, value)
    return lower_for_slot(ctx, value, ctx.types.apply(target), value.span)
}

/// Lower a call's arguments, then prepare each one for the param slot it binds to.
/// Every argument is lowered before the first one is prepared.
///
/// `params` is the callee's FULL param list and `first_slot` the index the first
/// element of `args` binds to : 0 for a plain call, 1 on the UFCS paths where the
/// receiver already took `params[0]`. Args past the end of `params` (a variadic
/// tail, or a signature the lowerer couldn't resolve) pass through untouched.
///
/// The arguments are lowered in source order (`lower_in_order`). What the call
/// evaluates ahead of them, its callee or a method's receiver, is the caller's
/// to keep ahead (`bind_one_before_hoisted`).
///
/// @param ctx         the fn-body context.
/// @param args        the call's arguments, in source order.
/// @param params      the callee's declared param types.
/// @param first_slot  index in `params` that `args[0]` binds to.
/// @return            a fresh list, each argument lowered and prepared for its slot.
lower_call_args :: fn(
    ctx: FnLowerCtx,
    args: CallArg[],
    params: Type[],
    first_slot: i64,
) -> LoweredExpr[] {
    lowered: LoweredExpr[]: []
    for arg in args {
        mark :: ctx.pending_awaits.len()
        value :: lower_expr(ctx, arg.value)
        bind_before_hoisted(ctx, lowered, mark)
        lowered.push(value)
    }
    out: LoweredExpr[]: []
    for i in 0..<lowered.len() {
        slot :: first_slot + i
        if slot >= params.len() {
            out.push(lowered[i])
        } else {
            value :: args[i].value
            out.push(prepare_into(ctx, value, lowered[i], params[slot], value.span))
        }
    }
    return out
}

/// Lower `operands` in source order, as a call does its arguments.
///
/// An `await` hoists to the statement's sink, ahead of the whole expression : the
/// operands lowered before it would then run after it. An operand that hoists one
/// first binds every operand before it that may read a different value once
/// statements run, in the sink ahead of what it hoisted (`bind_before_hoisted`).
/// Outside async nothing hoists and this is a plain loop.
///
/// @param ctx       the fn-body context.
/// @param operands  the expressions, in the order the source evaluates them.
/// @return          each one lowered, in the same order.
lower_in_order :: fn(ctx: FnLowerCtx, operands: Expr[]) -> LoweredExpr[] {
    out: LoweredExpr[]: []
    for operand in operands {
        mark :: ctx.pending_awaits.len()
        value :: lower_expr(ctx, operand)
        bind_before_hoisted(ctx, out, mark)
        out.push(value)
    }
    return out
}

/// `value`, lowered before what was lowered since sink length `mark` : itself, or,
/// when that hoisted an `await`, the local it is bound to ahead of it. For the
/// operand a two-operand form evaluates first, and for a call's callee or
/// receiver once its arguments are lowered.
///
/// @param ctx    the fn-body context.
/// @param value  the operand lowered first.
/// @param mark   the sink length when the later operands began.
/// @return       what to read in its place.
bind_one_before_hoisted :: fn(ctx: FnLowerCtx, value: LoweredExpr, mark: i64) -> LoweredExpr {
    if ctx.pending_awaits.len() == mark || bound_by_sink(ctx, value) {
        return value
    }
    prelude: LoweredStmt[]: []
    bound :: bind_unless_invariant(ctx, value, "operand", value.span, prelude)
    hoist_prelude_before(ctx, prelude, mark)
    return bound
}

// When the operand lowered since sink length `mark` hoisted an `await`, each of
// `earlier` that may read a different value once statements run is bound to a
// local placed ahead of it, and replaced by that local.
bind_before_hoisted :: fn(ctx: FnLowerCtx, earlier: LoweredExpr[], mark: i64) -> void {
    if ctx.pending_awaits.len() == mark {
        return
    }
    prelude: LoweredStmt[]: []
    for i in 0..<earlier.len() {
        value :: earlier[i]
        if !bound_by_sink(ctx, value) {
            earlier[i] = bind_unless_invariant(ctx, value, "operand", value.span, prelude)
        }
    }
    hoist_prelude_before(ctx, prelude, mark)
}

// Whether `value` reads a local a statement of the sink binds : an `await`'s
// target, an operand bound before. Such a local is written only by statements
// ahead of it in the sink, so the read gives the same value after the awaits
// hoisted later.
bound_by_sink :: fn(ctx: FnLowerCtx, value: LoweredExpr) -> bool {
    if value !is LoweredIdent {
        return false
    }
    for stmt in ctx.pending_awaits {
        if stmt is LoweredAwait && stmt.target.id == value.symbol.id {
            return true
        }
        if stmt is LoweredLet && stmt.symbol.id == value.symbol.id {
            return true
        }
    }
    return false
}

/// `expr`, lowered after the statements already in `prelude` : when it hoists an
/// `await` to the sink, they move ahead of it there (`hoist_prelude_before`), so
/// they still run first.
///
/// @param ctx      the fn-body context.
/// @param expr     the operand, in source order after what `prelude` evaluates.
/// @param prelude  the statements run before it ; emptied when they move.
/// @return         `expr`, lowered.
lower_after_prelude :: fn(ctx: FnLowerCtx, expr: Expr, prelude: LoweredStmt[]) -> LoweredExpr {
    mark :: ctx.pending_awaits.len()
    value :: lower_expr(ctx, expr)
    hoist_prelude_before(ctx, prelude, mark)
    return value
}

// When what was lowered since sink length `mark` hoisted an `await`, the
// statements a value runs ahead of it (its prelude) move into the sink ahead of
// that `await`, so they still run first. `prelude` is left empty.
hoist_prelude_before :: fn(ctx: FnLowerCtx, prelude: LoweredStmt[], mark: i64) -> void {
    if ctx.pending_awaits.len() == mark || prelude.len() == 0 {
        return
    }
    hoisted: LoweredStmt[]: []
    drain_pending_from(ctx, hoisted, mark)
    ctx.pending_awaits.push_all(prelude)
    prelude.clear()
    ctx.pending_awaits.push_all(hoisted)
}

/// Mint a synthetic local symbol unique within the entry's body.
/// `hint` becomes part of the name (`__<hint>_<n>`) ; IDs are negative
/// so they can't collide with resolver-minted positive IDs.
/// @param ctx   the fn-body context (carries `uniq` + project counter).
/// @param hint  short kebab-case-ish tag describing the synth slot.
/// @return      the freshly minted symbol.
fresh_synthetic_symbol :: fn(ctx: FnLowerCtx, hint: string) -> Symbol {
    n :: ctx.uniq
    ctx.uniq = n + 1
    next_id :: next_project_synthetic_id(ctx.project)
    return Symbol {
        .id         = next_id,
        .kind       = .Synthetic,
        .name       = "__${hint}_${n}",
        .module     = ctx.typed.resolved.path,
        .module_name = ctx.typed.resolved.path,
        .visibility = .Private,
        .defined_at = null,
    }
}

/// Pack a sequence of statements into a single statement, transparent
/// to control flow. Single-element lists return that statement directly ;
/// otherwise the lowerer wraps the sequence into a `LoweredBlock`
/// inside a `LoweredExprStmt`.
/// @param span   span to attach to the wrapping stmt.
/// @param stmts  statements to wrap.
/// @return       a single stmt that runs every input stmt in order.
wrap_stmts :: fn(span: Span, stmts: LoweredStmt[]) -> LoweredStmt {
    if stmts.len() == 1 { return stmts[0] }
    block :: mk_void_block(stmts, span)
    return LoweredExprStmt { .span = span, .expr = block }
}

/// Flatten a block's trailing expression into its `stmts` list. Useful
/// when a block needs to be re-typed to `void` (no-else `if`, for-in
/// body) and any trailing value should be evaluated then discarded.
/// @param block  the block to re-shape.
/// @return       the stmts list, with the trailing expression appended
///               as an `LoweredExprStmt` when one is present.
block_stmts_with_trailing :: fn(block: LoweredBlock) -> LoweredStmt[] {
    trailing :: block.trailing ?? return block.stmts
    out: LoweredStmt[]: []
    for stmt in block.stmts { out.push(stmt) }
    out.push(LoweredExprStmt { .span = trailing.span, .expr = trailing })
    return out
}

/// Combine a list of boolean expressions with short-circuit OR. Empty
/// input degrades to `false` ; a single element returns itself.
/// @param span   span attached to every synthesised binary node.
/// @param parts  individual boolean expressions.
/// @return       the OR-chained expression.
or_all :: fn(span: Span, parts: LoweredExpr[]) -> LoweredExpr = chain_all(span, parts, .Or)

/// Combine a list of boolean expressions with short-circuit AND, left to
/// right — a later part is only evaluated once every earlier one held. Empty
/// input degrades to `true` ; a single element returns itself.
/// @param span   span attached to every synthesised binary node.
/// @param parts  individual boolean expressions.
/// @return       the AND-chained expression.
and_all :: fn(span: Span, parts: LoweredExpr[]) -> LoweredExpr = chain_all(span, parts, .And)

chain_all :: fn(span: Span, parts: LoweredExpr[], op: LoweredBinaryOp) -> LoweredExpr {
    if parts.len() == 0 {
        return LoweredBoolLit { .span = span, .type = TY_BOOL, .value = op == .And }
    }
    accumulator: LoweredExpr = parts[0]
    for i in 1..<parts.len() {
        accumulator = LoweredBinary {
            .span = span, .type = TY_BOOL, .op = op,
            .left = accumulator, .right = parts[i],
        }
    }
    return accumulator
}

/// Initialisation result for a let-binding whose owning slot may need
/// heap-promotion to a `Cell<T>`. The lowerer threads `slot_type` into
/// the binding's static type and `value` into its initialiser.
CellInit :: struct {
    value:     LoweredExpr
    slot_type: Type
}

// Whether `symbol_id` names a binding that lives in a heap cell: a closure
// captures it and an assignment rebinds it (`closure_analysis`).
lives_in_cell :: fn(ctx: FnLowerCtx, symbol_id: i32) -> bool {
    return symbol_id in ctx.project.closures.cell_symbols
}

/// Wrap the initialiser in `LoweredCellNew` when `symbol` is captured
/// by an inner lambda and rebound (`lives_in_cell`) ; any other slot returns its
/// input verbatim.
/// @param ctx         the fn-body context.
/// @param symbol      the binding's symbol.
/// @param value       the initialiser expression.
/// @param value_type  the statically-known slot type.
/// @param span        span attached to the cell-new node when emitted.
/// @return            the `(value, slot_type)` to use for the binding.
lower_cell_init :: fn(
    ctx: FnLowerCtx, symbol: Symbol, value: LoweredExpr, value_type: Type, span: Span,
) -> CellInit {
    if !lives_in_cell(ctx, symbol.id) {
        return CellInit { .value = value, .slot_type = value_type }
    }
    cell :: LoweredCellNew {
        .span = span, .type = TY_UNRESOLVED, .value = value, .value_type = value_type,
    }
    return CellInit { .value = cell, .slot_type = TY_UNRESOLVED }
}

/// `let <name> = <value>` for a user-visible binding, heap-promoted to a cell
/// when an inner lambda captures it and something rebinds it (`lower_cell_init`).
/// Every binding a closure can capture goes through here: the closure reads such
/// a capture through `CellGet`, so a slot left holding the bare value reads garbage.
///
/// @param symbol      the binding's symbol.
/// @param name        its display name.
/// @param value       the initialiser.
/// @param value_type  the statically-known slot type.
/// @param span        span of the `let` and of the cell-new when emitted.
cell_aware_let :: fn(
    ctx: FnLowerCtx, symbol: Symbol, name: string, value: LoweredExpr, value_type: Type, span: Span,
) -> LoweredStmt {
    init :: lower_cell_init(ctx, symbol, value, value_type, span)
    return LoweredLet {
        .span = span, .name = name, .symbol = symbol, .type = init.slot_type, .value = init.value,
    }
}

// Where a closure's env keeps each capture, in capture order: `cap_<N>`, holding
// its value at its declared type in the fn making the closure — the type of its own
// slot — or, for a capture that lives in a cell, that cell. Computed once per
// closure, so the env literal that writes a field and the lifted body that reads it
// agree.
env_slots :: fn(ctx: FnLowerCtx, captures: Capture[]) -> EnvSlot[] {
    slots: EnvSlot[]: []
    for i in 0..<captures.len() {
        symbol :: captures[i].symbol
        value_type: Type | null: if lives_in_cell(ctx, symbol.id) {
            null
        } else {
            declared_type_of_symbol(ctx, symbol) ?? captures[i].type
        }
        slots.push(EnvSlot { .field = "cap_${i}", .value_type = value_type })
    }
    return slots
}

// The env struct's fields, one per slot ; a cell is an opaque ref.
env_struct_fields :: fn(slots: EnvSlot[]) -> LoweredStructField[] {
    fields: LoweredStructField[]: []
    for slot in slots {
        field_type :: slot.value_type ?? TY_UNRESOLVED
        fields.push(LoweredStructField { .name = slot.field, .type = field_type })
    }
    return fields
}

// The env literal's fields: each capture's value, or its cell, as the fn being
// lowered right now reaches it.
env_lit_fields :: fn(ctx: FnLowerCtx, span: Span, captures: Capture[], slots: EnvSlot[]) -> LoweredStructLitField[] {
    fields: LoweredStructLitField[]: []
    for i in 0..<captures.len() {
        symbol :: captures[i].symbol
        value_type :: slots[i].value_type
        value :: if value_type != null {
            try_route_through_env(ctx, symbol, span, value_type) ?? LoweredIdent {
                .span = span,
                .type = value_type,
                .symbol = instance_symbol(ctx, symbol),
            }
        } else {
            env_cell(ctx, symbol, span, captures[i].type)
        }
        fields.push(LoweredStructLitField { .name = slots[i].field, .value = value })
    }
    return fields
}

// The slots keyed by captured symbol id, for the lifted body.
slots_by_symbol :: fn(captures: Capture[], slots: EnvSlot[]) -> MutableMap<i32, EnvSlot> {
    map :: MutableMap<i32, EnvSlot> {}
    for i in 0..<captures.len() {
        map[captures[i].symbol.id] = slots[i]
    }
    return map
}

// The cell an env literal stores for the rebound capture `symbol`, as the fn being
// lowered right now reaches it: `env.cap_N` when that fn is itself a lifted body
// that captured it, a plain ident otherwise — to the instance's clone inside an
// inlined generator, since the capture lists name the resolver's symbols. `type`
// is the binding's type, used only for the plain ident.
//
// Every lift sharing a rebound capture holds a ref to the SAME cell, so the env
// carries the ref, not the value — which is why this stops one step short of
// `try_route_through_env`, whose job is reading the value back out.
//
// A lift nested inside another must not read a bare ident for a symbol the
// enclosing LIFTED fn does not own as a local: `midir` cannot resolve it and
// replaces the whole entry block with `unreachable`.
env_cell :: fn(ctx: FnLowerCtx, symbol: Symbol, span: Span, type: Type) -> LoweredExpr {
    lifted :: ctx.lifted_context
    if lifted != null {
        slot :: lifted.captures[symbol.id]
        if slot != null {
            return env_field(lifted, slot.field, span, TY_UNRESOLVED)
        }
    }
    return LoweredIdent { .span = span, .type = type, .symbol = instance_symbol(ctx, symbol) }
}

// `env.<field>` in a lifted body, read at `type`.
env_field :: fn(lifted: LiftedFnContext, field: string, span: Span, type: Type) -> LoweredFieldAccess = LoweredFieldAccess {
    .span = span,
    .type = type,
    .target = LoweredIdent { .span = span, .type = lifted.env_type, .symbol = lifted.env_symbol },
    .field = field,
}

/// Return a copy of `block` with `prefix` spliced in before its statements,
/// preserving the block's `span` / `type` / `trailing`. Used to splice a
/// fn-entry prologue (captured-param cell promotion) or a loop variable's
/// binding ahead of an already-lowered body.
/// @param prefix  statements to run first, in order.
/// @param block   the body to prepend onto.
/// @return        a fresh `LoweredBlock` ; `block` is returned untouched when
///                `prefix` is empty.
prepend_stmts_to_block :: fn(prefix: LoweredStmt[], block: LoweredBlock) -> LoweredBlock {
    if prefix.len() == 0 { return block }
    stmts: LoweredStmt[]: []
    stmts.push_all(prefix)
    stmts.push_all(block.stmts)
    return LoweredBlock { ...block, .stmts = stmts }
}

// ---- operands --------------------------------------------------------------
//
// An operand evaluated once but read later — by a loop at every step, or twice
// in one expression — is bound to a fresh local first, unless the later read
// provably yields the same value. What may run in between decides which rule
// answers that : `is_invariant_operand` when a loop body may, `is_stable_operand`
// when only other operands may. `is_effect_free_read` answers the question an
// operand that may be skipped or moved raises instead : whether it does any work.

// A fresh local bound to `value` in `out`, and the ident that reads it.
bind_to_local :: fn(
    ctx: FnLowerCtx, value: LoweredExpr, type: Type, name: string, span: Span,
    out: LoweredStmt[],
) -> LoweredIdent {
    symbol :: fresh_synthetic_symbol(ctx, name)
    out.push(LoweredLet {
        .span = span, .name = symbol.name, .symbol = symbol, .type = type, .value = value,
    })
    return LoweredIdent { .span = span, .type = type, .symbol = symbol }
}

// `value` itself when it is invariant, else a local bound to it in `out`.
bind_unless_invariant :: fn(
    ctx: FnLowerCtx, value: LoweredExpr, name: string, span: Span, out: LoweredStmt[],
) -> LoweredExpr = if is_invariant_operand(ctx, value) {
    value
} else {
    bind_to_local(ctx, value, value.type, name, span, out)
}

// `value` itself when it is stable, else a local bound to it in `out`.
bind_unless_stable :: fn(
    ctx: FnLowerCtx, value: LoweredExpr, name: string, span: Span, out: LoweredStmt[],
) -> LoweredExpr = if is_stable_operand(value) {
    value
} else {
    bind_to_local(ctx, value, value.type, name, span, out)
}

// Whether `value` reads the same however much code runs before the read — a loop
// body included : a literal, or a name nothing rebinds — a fn, a const, a local or
// parameter no assignment rebinds (`rebind_free` ; a `for` variable only within
// one iteration of its own loop, the one place it is read).
// @partial: every other expression may do work or read a different value.
is_invariant_operand :: fn(ctx: FnLowerCtx, value: LoweredExpr) -> bool = @partial match value {
    is LoweredIdent -> value.symbol.kind == .Fn || value.symbol.kind == .Const
        || origin_symbol_id(ctx.project, value.symbol) in ctx.typed.resolved.rebind_free
    _ -> is_literal(value)
}

// Whether `value` reads the same when only other operands run before the read —
// calls, but no statement of the enclosing fn : a literal, or a local read
// directly. A call cannot rebind a local it does not capture, and a captured one
// it can rebind lives in a cell, read through it, not as an ident.
is_stable_operand :: fn(value: LoweredExpr) -> bool = value is LoweredIdent || is_literal(value)

// Whether evaluating `value` does nothing but read — a stable operand, or a field,
// a cell or an array length reached from one — so skipping it, or moving it,
// loses no effect.
// @partial: every other expression may do work.
is_effect_free_read :: fn(value: LoweredExpr) -> bool = @partial match value {
    is LoweredFieldAccess -> is_effect_free_read(value.target)
    is LoweredUnionField  -> is_effect_free_read(value.target)
    is LoweredCellGet     -> is_effect_free_read(value.target)
    is LoweredArrayLen    -> is_effect_free_read(value.target)
    _                     -> is_stable_operand(value)
}

// Whether `first` and `second`, evaluated in either order, give the same values —
// the second stable, or both reads that run nothing.
reads_independently :: fn(first: LoweredExpr, second: LoweredExpr) -> bool =
    is_stable_operand(second) || is_effect_free_read(first) && is_effect_free_read(second)

// @partial: only the literal nodes are literals.
is_literal :: fn(value: LoweredExpr) -> bool = @partial match value {
    is LoweredIntLit | LoweredCharLit | LoweredBoolLit -> true
    is LoweredFloatLit | LoweredStringLit | LoweredNullLit -> true
    _ -> false
}

// `value` alone when `prelude` is empty, else a block running `prelude` first.
with_prelude :: fn(prelude: LoweredStmt[], value: LoweredExpr, span: Span) -> LoweredExpr {
    if prelude.len() == 0 {
        return value
    }
    return LoweredBlock {
        .span = span, .type = value.type, .stmts = prelude, .trailing = value,
    }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_or_all_empty_emits_false :: fn() -> void {
    span :: empty_span()
    result :: or_all(span, [])
    match result {
        is LoweredBoolLit -> { assert_eq(result.value, false) }
        _ -> {}
    }
}

@test test_or_all_single_returns_input :: fn() -> void {
    span :: empty_span()
    only: LoweredExpr: LoweredBoolLit { .span = span, .type = TY_BOOL, .value = true }
    parts: LoweredExpr[]: []
    parts.push(only)
    result :: or_all(span, parts)
    // single-element chain returns the input unchanged
    match result {
        is LoweredBoolLit -> { assert_eq(result.value, true) }
        _ -> {}
    }
}
