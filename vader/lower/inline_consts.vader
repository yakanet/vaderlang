// vader/lower/inline_consts — route module-level const decls to their read sites.
//
// A non-scalar const reference can't be emitted as a bare ident: `build_ident`
// has no const-load case (the CFG design inlines consts out). This pass classifies
// every `LoweredConstDecl`, records how its read sites resolve, consumed at
// CFG-build time by `vader/midir/build.vader::build_ident`, and keeps the choice in
// `project.const_routes` for the lowered dump. The buckets, in the order tried :
//
//   - data pool : an array literal whose elements are all bakeable (primitives,
//     strings, or named-struct literals, `try_data_pool`), or a bakeable struct
//     literal, pooled as the single element of an aggregate entry and read as
//     `pool[k][0]` (`try_pool_struct`). Registered once in `project.data_pool`
//     and read back via a `data.const` op, so the value exists in one place
//     instead of being rebuilt. A use that reads the constant fresh calls an
//     accessor that builds it again (`const_fresh_wrap`).
//   - fn-wrap : an array literal of `FN_WRAP_MIN_ELEMENTS`+ elements (struct /
//     string elements that the data pool can't hold, e.g. `INTRINSICS`). The
//     const decl is REPLACED IN PLACE by a synthetic 0-arg accessor fn
//     `__const_<name>` returning the literal ; each reference lowers to one
//     `call` instead of re-emitting the whole literal. In-place replacement
//     keeps the accessor at the const's fn-table position so emission order
//     stays stable.
//   - inline  : everything else (scalars, small lists, a struct literal that is
//     not bakeable). The value is recorded verbatim and `build_ident` re-builds
//     it at each read site. Scalars normally fold earlier in
//     `lower_expr.vader::lower_ident` ; recording them here is a safety net for
//     any reference that didn't fold.
//
// A module const is frozen at every level, so the data pool is the default route
// (`KEYWORDS`, `TOKEN_TYPES`, …), and fn-wrap is reached only by consts whose
// elements aren't bakeable. `tests/snippets/const_fn_wrap` guards that path.

module "vader/lower"

import "std/collections"
AST :: import "toolchain/ast"
import "vader/resolver/symbol"
import "vader/comptime"
import "vader/types"

// Break-even point : the `call` at each read site is cheaper than re-emitting
// `2 * N` ops to rebuild the literal once N passes this threshold.
FN_WRAP_MIN_ELEMENTS :: usize(4)

/// Classify every const decl in `project`, record its read-site routing on
/// `project.const_inline`, `const_fn_wrap` and `const_fresh_wrap`, and its route
/// on `project.const_routes`, replacing fn-wrapped const decls with their
/// synthetic accessor fns. Mutates `project` in place.
///
/// @param project      the lowered project ; its `modules` + const maps are mutated.
/// @param project_ctx  the working ctx : accessor fns mint their ids from its live
///                     `next_synthetic_id` counter (`next_project_synthetic_id`),
///                     the one pool every synthetic decl draws from, so no two
///                     synthetic decls share an id. Resolver-minted ids are
///                     positive, so the negative synthetic range never touches them.
inline_consts :: fn(project: LoweredProject, project_ctx: LowerProjectCtx) -> void {
    for module_id in project.modules.keys() {
        m :: project.modules[module_id] ?? continue
        new_decls: LoweredDecl[]: []
        changed := false
        for d in m.decls {
            if d is LoweredConstDecl {
                sym :: d.origin.symbol
                if sym is Symbol {
                    storage :: store_const(project, project_ctx, d, sym, new_decls)
                    project.const_routes.push(ConstRoute {
                        .symbol = sym,
                        .type = d.type,
                        .storage = storage,
                    })
                    if storage !is InlineConst {
                        changed = true
                        continue
                    }
                }
            }
            new_decls.push(d)
        }
        if changed {
            project.modules[module_id] = LoweredModule {
                .module_id    = m.module_id,
                .display_path = m.display_path,
                .decls        = new_decls,
            }
        }
    }
}

// Store `d` in the first bucket that takes it, appending to `decls` the accessor
// it needs, and say which.
store_const :: fn(
    project: LoweredProject,
    project_ctx: LowerProjectCtx,
    d: LoweredConstDecl,
    sym: Symbol,
    decls: LoweredDecl[],
) -> ConstStorage {
    // Data-pool bucket : a bakeable array or struct literal is materialised once
    // into `.rodata` (native) / a data segment (wasm) / an in-memory const buffer
    // (VM), and every read site sharing it lowers to a `data.const` view.
    // Takes priority over fn-wrap, which would `array.new` + refill at each call.
    // What is not bakeable falls through.
    pooled :: pool(d, sym, project)
    if pooled != null {
        // A use that must not share the pooled value calls an accessor that
        // builds it again.
        if sym.id in project_ctx.typed.fresh.constants {
            pooled.rebuilt_by = add_accessor(project_ctx, d, sym, decls, project.const_fresh_wrap)
        }
        return pooled
    }
    if should_fn_wrap(d.value) {
        accessor :: add_accessor(project_ctx, d, sym, decls, project.const_fn_wrap)
        return AccessorConst { .accessor = accessor }
    }
    project.const_inline[sym.id] = d.value
    return InlineConst {}
}

// Mint the accessor that builds `d`, register it in `wraps` and append it to
// `decls` ; its mangled name.
add_accessor :: fn(
    project_ctx: LowerProjectCtx,
    d: LoweredConstDecl,
    sym: Symbol,
    decls: LoweredDecl[],
    wraps: MutableMap<i32, ConstFnWrap>,
) -> string {
    fn_symbol :: const_accessor_symbol(sym, next_project_synthetic_id(project_ctx))
    wraps[sym.id] = ConstFnWrap { .fn_symbol = fn_symbol, .call_type = d.type }
    accessor :: synthesize_const_fn(d, fn_symbol)
    decls.push(accessor)
    return accessor.mangled
}

// `d` in the data pool : an array literal as an entry, a struct literal as the
// single element of one ; null when it does not pool.
pool :: fn(d: LoweredConstDecl, sym: Symbol, project: LoweredProject) -> PooledConst | null {
    array :: try_data_pool(d, sym, project) ?? return try_pool_struct(d, sym, project)
    return array
}

// fn-wrap eligibility : a bulky array literal. Smaller arrays + every other
// shape (scalars, non-bakeable struct literals) route through the inline bucket.
should_fn_wrap :: fn(value: LoweredExpr) -> bool {
    if value is LoweredArrayLit { return value.elements.len() >= FN_WRAP_MIN_ELEMENTS }
    return false
}

// Route an array constant into the project data pool : register a
// `DataPoolEntry`, point the const's read sites at a `LoweredDataConst` (via
// `const_inline`, which `build_ident` rebuilds as the `data.const` op), and
// report success so the caller drops the decl. Returns false for a shape it
// cannot pool (an element that is not bakeable, a non-array), which keeps the
// fn-wrap / inline buckets.
//
// Poolable elements : integer / char / bool / float literals (each reduced to an
// `i64` bit pattern), string literals (kept verbatim), and struct literals whose
// fields are poolable (`is_bakeable_struct`).
try_data_pool :: fn(
    cd: LoweredConstDecl, symbol: Symbol, project: LoweredProject,
) -> PooledConst | null {
    if cd.type is ArrayType as arr_type {
        if pool_literal_of(cd.value) is LoweredArrayLit as lit {
            element_type_name :: display_type(arr_type.element)
            entry :: render_data_pool_entry(lit, element_type_name)
            if entry != null {
                pool_index :: project.data_pool.len()
                project.data_pool.push(entry)
                project.const_inline[symbol.id] = LoweredDataConst {
                    .span = lit.span, .type = cd.type, .pool_index = pool_index,
                }
                return PooledConst { .pool_index = pool_index }
            }
        }
    }
    return null
}

// Route a bakeable struct const into the data pool, as the single element of an
// aggregate entry : every read becomes `pool[k][0]`, a pointer to one static
// object. Sound only because a module const is frozen at every level (the effect
// summary reports a write into one, T3070 / T3072), so nothing can write into the
// shared `.rodata` object. A const whose declared type is not the struct itself (`X: Value: …`)
// keeps the inline bucket: its reads must carry the declared type.
try_pool_struct :: fn(
    cd: LoweredConstDecl, symbol: Symbol, project: LoweredProject,
) -> PooledConst | null {
    if cd.type !is StructType || cd.value !is LoweredStructLit {
        return null
    }
    span :: cd.value.span
    pool_type :: mk_array(cd.type)
    wrapped :: LoweredArrayLit {
        .span     = span,
        .type     = pool_type,
        .elements = [cd.value],
    }
    entry :: render_data_pool_entry(wrapped, display_type(cd.type)) ?? return null
    pool_index :: project.data_pool.len()
    project.data_pool.push(entry)
    project.const_inline[symbol.id] = LoweredIndex {
        .span        = span,
        .type        = cd.type,
        .target      = LoweredDataConst {
            .span       = span,
            .type       = pool_type,
            .pool_index = pool_index,
        },
        .index       = LoweredIntLit {
            .span  = span,
            .type  = mk_primitive("usize"),
            .value = 0,
        },
        .bounds_safe = true,
    }
    return PooledConst { .pool_index = pool_index, .element = true }
}

// The array literal a const's value pools from, expanding the repeat form.
//
// `[0] * 4` lowers to an `array.repeat` intrinsic over a literal LHS and a literal
// count, which is the idiomatic way to declare a fixed-size table. A non-constant
// count, or anything else, returns null and takes the fn-wrap / inline bucket.
pool_literal_of :: fn(value: LoweredExpr) -> LoweredExpr | null {
    if value is LoweredArrayLit { return value }
    if value is LoweredIntrinsicCall {
        if value.name != INTRINSIC_ARRAY_REPEAT || value.args.len() != 2 {
            return null
        }
        if value.args[0] is LoweredArrayLit as base {
            if value.args[1] is LoweredIntLit as count {
                if count.value <= 0 { return null }
                elements: LoweredExpr[]: []
                for _ in 0..<count.value {
                    for el in base.elements { elements.push(el) }
                }
                return LoweredArrayLit {
                    .span = base.span, .type = base.type, .elements = elements,
                }
            }
        }
    }
    return null
}

// Build the pooled entry for an array literal, or null when an element isn't
// poolable. A `string[]` becomes a `StrDataPoolEntry` (values verbatim) ;
// every other element type takes the primitive bit-pattern path.
render_data_pool_entry :: fn(lit: LoweredArrayLit, element_name: string) -> DataPoolEntry | null {
    if element_name == "string" {
        values :: render_string_items(lit) ?? return null
        return StrDataPoolEntry { .values = values }
    }
    // A union element is boxed, each with its own member: never a packed scalar.
    rendered :: if array_element_type(lit.type) is UnionType {
        null
    } else {
        render_data_items(lit, element_name)
    }
    if rendered != null {
        return PrimDataPoolEntry { .element_type_name = element_name, .items = rendered }
    }
    // Aggregate (struct / nested-array elements) : bakeable only when every leaf
    // is a constant literal and every struct is a named, non-generic struct (its
    // symbol-id keys the baked value ; `midir` recurses over the same literal).
    if is_bakeable_array(lit) {
        return AggregateDataPoolEntry { .element_type_name = element_name, .literal = lit }
    }
    return null
}

// Recursive bakeability gate. Mirrors `midir/build::lowered_to_bc_value` exactly :
// a node accepted here must be convertible there. Conservative — anything not a
// constant literal / named-struct / array falls through to fn-wrap.
is_bakeable_array :: fn(lit: LoweredArrayLit) -> bool {
    for el in lit.elements {
        if !is_bakeable_value(el) { return false }
    }
    return true
}

is_bakeable_value :: fn(el: LoweredExpr) -> bool {
    if el is LoweredIntLit    { return true }
    if el is LoweredFloatLit  { return true }
    if el is LoweredBoolLit   { return true }
    if el is LoweredCharLit   { return true }
    if el is LoweredStringLit { return true }
    if el is LoweredArrayLit { return is_bakeable_array(el) }
    if el is LoweredStructLit { return is_bakeable_struct(el) }
    return false
}

// A named, non-generic struct literal whose fields are all bakeable. Tuples
// (`TupleType`) and generic instances are rejected — the baked struct is resolved
// at the backend by `symbol_id` alone, which a tuple lacks and a generic shares
// across monomorphized instances.
is_bakeable_struct :: fn(s: LoweredStructLit) -> bool {
    if s.type is StructType as st {
        if st.args.len() > 0 { return false }
        for f in s.fields {
            if !is_bakeable_value(f.value) { return false }
        }
        return true
    }
    return false
}

// Collect every element's string value, or null when any element isn't a plain
// string literal (interpolation lowers to a builder, never reaching here).
render_string_items :: fn(lit: LoweredArrayLit) -> string[] | null {
    out: string[]: []
    for el in lit.elements {
        if el is LoweredStringLit { out.push(el.value) } else { return null }
    }
    return out
}

// Collect every element's raw bit pattern as `i64`, or null when any element
// isn't a poolable primitive literal (int / char / bool / float). `element_name`
// is the array's element type name — needed to pick the f32 vs f64 width when
// reinterpreting a float literal's IEEE-754 bits.
render_data_items :: fn(lit: LoweredArrayLit, element_name: string) -> i64[] | null {
    out: i64[]: []
    for el in lit.elements {
        bits :: data_item_bits(el, element_name) ?? return null
        out.push(bits)
    }
    return out
}

// Raw `i64` bit pattern of a poolable primitive literal, or null otherwise.
// Floats are reinterpreted via `to_bits()` at the element's natural width
// (`f32` keeps the low 32 bits), matching `vm/virt_reader_bc::value_from_bits`.
data_item_bits :: fn(el: LoweredExpr, element_name: string) -> i64 | null {
    if el is LoweredIntLit  { return el.value }
    if el is LoweredCharLit { return i64(el.value) }
    if el is LoweredBoolLit { return if el.value { 1 } else { 0 } }
    if el is LoweredFloatLit {
        if element_name == "f32" { return i64(u64(f32(el.value).to_bits())) }
        return i64(el.value.to_bits())
    }
    return null
}

// The accessor fn's symbol, carrying a FRESH synthetic id (`synth_id`, always
// negative) — distinct from the const's own id, so it can never collide with a
// real symbol id in the DCE's by-id index. (Reusing the const id, the prior
// design, let an unrelated id shift collide the accessor with another symbol,
// so the DCE dropped it and the emit hit a dangling `__const_*` callee — GATE
// B1.) The lowered DCE seeds every accessor as a root ;
// `midir/build.vader::build_ident` emits each const reference as a 0-arg `call`
// to this symbol, looked up through `project.const_fn_wrap[const symbol id]`.
const_accessor_symbol :: fn(orig_sym: Symbol, synth_id: i32) -> Symbol = Symbol {
    .id         = synth_id,
    .kind       = .Fn,
    .name       = "__const_${orig_sym.name}",
    .module     = orig_sym.module,
    .module_name = orig_sym.module,
    .visibility = .Private,
    .defined_at = orig_sym.defined_at,
}

// Build the synthetic 0-arg accessor fn for a fn-wrapped const : the body is a
// block whose trailing expression is the const's value, and the origin reuses
// the const's MonoEntry with the symbol swapped for the `fn_symbol` built by
// `const_accessor_symbol`.
synthesize_const_fn :: fn(cd: LoweredConstDecl, fn_symbol: Symbol) -> LoweredFnDecl {
    synth_entry :: MonoEntry {
        .id             = cd.origin.id,
        .is_main        = false,
        .mangled        = cd.origin.mangled,
        .decl           = cd.origin.decl,
        .symbol         = fn_symbol,
        .subst          = cd.origin.subst,
        .type_arguments = cd.origin.type_arguments,
        .module         = cd.origin.module,
    }
    no_stmts: LoweredStmt[]: []
    no_params: LoweredParam[]: []
    return LoweredFnDecl {
        .mangled     = "__const_${cd.mangled}",
        .params      = no_params,
        .return_type = cd.type,
        .body        = LoweredBlock {
            .span     = span_of(cd.value),
            .type     = cd.type,
            .stmts    = no_stmts,
            .trailing = cd.value,
        },
        .origin = synth_entry,
    }
}
