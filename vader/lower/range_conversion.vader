// vader/lower/range_conversion — `Hour(x)` and `x in Hour`, a value against
// the bounds of an integer type ; `Weekday(x)` and `x in Weekday`, against the values
// of an enum ; `char(x)` and `x in char`, against the Unicode scalar values ; and the
// value a generic instance gets back through a `T` it binds to a range.
//
// The tested values are runs of integers : a range is one, an enum one per stretch
// of consecutive values, `char` two, around the surrogates. A value is tested only
// against what its own type does not already decide : `u8` into `-5..=5` needs no
// test below. A conversion stops the program off them, in every build : a type's
// values are what it promises. `x in T` gives the test's outcome, a constant where
// the type of `x` decides it.

module "vader/lower"

import "toolchain/ast"
import "toolchain/span"
import "vader/core/types"
import "vader/front/typecheck"
import "vader/lower/ir"
import "vader/support/integer"

/// The conversion `call`, `T(value)`, into the range `target`.
///
/// @param call    the conversion, its single argument the value.
/// @param target  the range converted into, at this instance (`instance_range`).
/// @return        the value, checked where it may leave the range, as a value of
///                `target`.
lower_range_conversion :: fn(ctx: FnLowerCtx, call: CallExpr, target: RangeType) -> LoweredExpr {
    observe_no_call(ctx, call, .Call, "range check")
    value :: lower_expr(ctx, call.args[0].value)
    source :: values_of(ctx, call.args[0].value, value)
    return checked_into_range(ctx, value, source, target, call.span)
}

/// The conversion `call`, `E(value)`, into the enum `target`.
///
/// @param call    the conversion, its single argument the value.
/// @param target  an enum without variant data.
/// @return        the value, the program stopped where it is none of `target`'s
///                values, as a value of `target`.
lower_enum_conversion :: fn(ctx: FnLowerCtx, call: CallExpr, target: EnumType) -> LoweredExpr {
    reason :: "value out of range: no value of `${target.symbol.name}`"
    return lower_runs_conversion(ctx, call, enum_value_runs(target), target, reason)
}

/// The conversion `call`, `char(value)`, from an integer.
///
/// @param call  the conversion, its single argument an integer.
/// @return      the value, the program stopped where it is no Unicode scalar value.
lower_char_conversion :: fn(ctx: FnLowerCtx, call: CallExpr) -> LoweredExpr {
    reason :: "value out of range: no Unicode scalar value"
    return lower_runs_conversion(ctx, call, CHAR_VALUES, TY_CHAR, reason)
}

// The conversion `call`, its single argument an integer, into a value of `result`,
// the program stopped with `reason` where it lies in none of `runs`.
lower_runs_conversion :: fn(
    ctx: FnLowerCtx,
    call: CallExpr,
    runs: Interval[],
    result: Type,
    reason: string,
) -> LoweredExpr {
    observe_no_call(ctx, call, .Call, "value check")
    value :: lower_expr(ctx, call.args[0].value)
    source :: values_of(ctx, call.args[0].value, value)
    return checked_into(ctx, value, source, runs, result, reason, call.span)
}

/// The type a call or an operator of type `type` at this instance is lowered at :
/// the integer `borrowed` is held in, when it reaches a member that range borrows
/// from its integer (`borrowed_range`), whose value it is ; `type` otherwise.
///
/// @param borrowed  the range `borrowed_range` found, or null.
/// @param type      the call's or the operator's type at this instance.
produced_type :: fn(borrowed: RangeType | null, type: Type) -> Type {
    if borrowed == null {
        return type
    }
    return range_representation(borrowed)
}

/// `value`, a call or an operator lowered at `produced_type`, checked against the
/// range `borrowed` its instance binds the type parameter it is a value of.
///
/// @param borrowed  the range `borrowed_range` found, or null.
/// @return          `value`, unchanged when there is no such range.
kept_in_range :: fn(
    ctx: FnLowerCtx,
    value: LoweredExpr,
    borrowed: RangeType | null,
    span: Span,
) -> LoweredExpr {
    if borrowed == null {
        return value
    }
    return checked_into_range(ctx, value, integer_values(value.type), borrowed, span)
}

/// The range whose value `e` stands for, through a type parameter its instance binds
/// to it, where `e` reaches a member the range borrows from its integer : that
/// member hands back a value of the integer (`a + b` of two `Hour` may be 30). An
/// operator does, its arithmetic the integer's ; a call does when it reaches a
/// member through the parameter's bound or one chosen against it
/// (`calls_borrowed_member`).
///
/// @param e  a call or an operator.
/// @return   null for any other `e` : a generic fn's `T`, a conversion `T(x)`,
///           which checks its own, give values of the range.
borrowed_range :: fn(ctx: FnLowerCtx, e: Expr) -> RangeType | null {
    if !ctx.types.subst.binds_refinement {
        return null
    }
    target :: bound_range(ctx.types.subst, ctx.types.raw_expr_type(e)) ?? return null
    if e is CallExpr && !calls_borrowed_member(recorded_callee(ctx, e, .Call)) {
        return null
    }
    return target
}

// Whether `callee` is a member an instance serves with the impl of the integer a
// range is held in : one reached through a type parameter's bound, or an impl
// member chosen against the parameter.
calls_borrowed_member :: fn(callee: Callee | null) -> bool {
    if callee is DirectFn {
        return callee.per_instance
    }
    return callee is BoundMember
}

/// The integer type `t`, as the typecheck recorded it, is at this instance : a
/// range as it is, a type parameter the instance binds to one that range.
///
/// @param t  a type the typecheck recorded.
/// @return   null when `t` is no integer type here.
instance_range :: fn(ctx: FnLowerCtx, t: Type) -> RangeType | null {
    held :: ctx.types.apply(t)
    if held is RangeType {
        return held
    }
    return null
}

// `value` converted into the range `target` (`checked_into`).
checked_into_range :: fn(
    ctx: FnLowerCtx,
    value: LoweredExpr,
    source: Interval | null,
    target: RangeType,
    span: Span,
) -> LoweredExpr {
    reason :: "value out of range: not in ${display_range(target)}"
    return checked_into(ctx, value, source, [target.bounds], target, reason, span)
}

// `value` converted into a value of `result`, the program stopped with `reason` where
// it lies in none of `runs`. Only what `source`, the values it can take, does not
// already decide is tested, on the value itself when it is stable, else on a local
// holding it as a range of `source`.
checked_into :: fn(
    ctx: FnLowerCtx,
    value: LoweredExpr,
    source: Interval | null,
    runs: Interval[],
    result: Type,
    reason: string,
    span: Span,
) -> LoweredExpr {
    known :: source ?? return converted(value, result, span)
    if decided_inside(known, runs) == true {
        return converted(value, result, span)
    }
    compared :: RangeType { .bounds = known }
    if is_stable_operand(value) {
        tests :: stops_outside(value, known, runs, compared, reason, span)
        return with_prelude(tests, converted(value, result, span), span)
    }
    stmts: LoweredStmt[]: []
    bound :: bind_to_local(ctx, value, compared, "in_range", span, stmts)
    stmts.push_all(stops_outside(bound, known, runs, compared, reason, span))
    return with_prelude(stmts, checked_read(bound, result, span), span)
}

// The checked local `bound` as a value of `result` : a read at `result` for a range,
// converted only where the CFG holds the two in different integers ; a conversion
// otherwise (`char`).
checked_read :: fn(bound: LoweredIdent, result: Type, span: Span) -> LoweredExpr {
    if result is RangeType {
        return LoweredIdent { ...bound, .type = result }
    }
    return LoweredCast { .span = span, .type = result, .value = bound }
}

// `value`, which the conversion has proved a value of `result`, as one : itself when
// it is, a literal of `result` for an integer literal into a range or an enum, else
// converted.
converted :: fn(value: LoweredExpr, result: Type, span: Span) -> LoweredExpr {
    if equals_type(value.type, result) {
        return value
    }
    if value is LoweredIntLit && result is RangeType | EnumType {
        return LoweredIntLit { ...value, .type = result }
    }
    return LoweredCast { .span = span, .type = result, .value = value }
}

// Stop the program with `reason` where `value`, holding `source`, lies in none of
// `runs`. Over two runs, `char`'s, the second is tested only past the first : a
// value of the first makes one comparison. Over more, the test stays one condition,
// linear in the runs.
stops_outside :: fn(
    value: LoweredExpr,
    source: Interval,
    runs: Interval[],
    compared: Type,
    reason: string,
    span: Span,
) -> LoweredStmt[] {
    reachable :: reachable_runs(source, runs)
    if reachable.len() != 2 {
        return [stop_if(outside_test(value, source, runs, compared, span), reason, span)]
    }
    first :: reachable[0]
    beyond :: Interval { ...source, .lo = first.hi + 1, .lo_open = false }
    second :: stop_if(outside_test(value, beyond, [reachable[1]], compared, span), reason, span)
    stmts: LoweredStmt[]: []
    if may_lie_below(source, first) {
        stmts.push(stop_if(bound_test(value, .Lt, first.lo, compared, span), reason, span))
    }
    if is_single_value(first) {
        stmts.push(second)
        return [if_then(bound_test(value, .Neq, first.lo, compared, span), stmts, span)]
    }
    stmts.push(if_then(bound_test(value, .Gt, integer_bound(first, true), compared, span), [second], span))
    return stmts
}

/// The test `binary`, `x in T` or `x !in T`, `T` an integer type, `char` or an enum.
///
/// @param binary  the test, its right operand the type the typecheck recorded.
/// @return        whether `x` lies within `T`'s bounds, or is one of the values of
///                the enum or of `char`, negated for `!in` ; a constant where the
///                type of `x` decides it.
lower_in_type :: fn(ctx: FnLowerCtx, binary: BinaryExpr) -> LoweredExpr {
    observe_no_call(ctx, binary, .Operator, "bounds")
    span :: binary.span
    negated :: binary.op == .NotIn
    value :: lower_expr(ctx, binary.left)
    runs :: tested_runs(ctx, ctx.types.raw_expr_type(binary.right))
        ?? return stub(span, TY_BOOL, "`in` over a type with no integer bounds")
    source :: values_of(ctx, binary.left, value)
        ?? return stub(span, TY_BOOL, "`in` on a value of no integer type")
    outcome :: decided_inside(source, runs)
    if outcome != null {
        return decided(value, outcome != negated, span)
    }
    compared :: RangeType { .bounds = source }
    stmts: LoweredStmt[]: []
    tested: LoweredExpr = value
    if !is_stable_operand(value) && comparison_count(source, runs) > 1 {
        tested = bind_to_local(ctx, value, compared, "in_x", span, stmts)
    }
    if negated {
        return with_prelude(stmts, outside_test(tested, source, runs, compared, span), span)
    }
    return with_prelude(stmts, inside_test(tested, source, runs, compared, span), span)
}

// The values `x in t` tests against, `t` as this instance reads it : an enum's runs of
// values, the Unicode scalar values, an integer type's bounds ; null for any other
// type.
tested_runs :: fn(ctx: FnLowerCtx, t: Type) -> Interval[] | null {
    if t is EnumType && t.data == null {
        return enum_value_runs(t)
    }
    if is_char(t) {
        return CHAR_VALUES
    }
    held :: instance_range(ctx, t) ?? return null
    return [held.bounds]
}

// `outcome`, once `value` has run for what it does.
decided :: fn(value: LoweredExpr, outcome: bool, span: Span) -> LoweredExpr {
    known :: LoweredBoolLit { .span = span, .type = TY_BOOL, .value = outcome }
    if is_effect_free_read(value) {
        return known
    }
    return with_prelude([LoweredExprStmt { .span = span, .expr = value }], known, span)
}

// Whether a value of `source` may lie below `bounds`, and above them : a lower end
// below every `i64` holds every value past it, an upper end past `i64` as far as
// it reaches (`upper_at_most`).
may_lie_below :: fn(source: Interval, bounds: Interval) -> bool =
    !bounds.lo_open && (source.lo_open || source.lo < bounds.lo)

may_lie_above :: fn(source: Interval, bounds: Interval) -> bool = !upper_at_most(source, bounds)

// The values the converted value can take : a literal's own, those of a value a
// widening cast holds (`u32(b)` with `b: u8`), those of its type as the typecheck
// recorded it, a range's bounds included, else of the type it is lowered at ; a
// distinct's, its backing's.
values_of :: fn(ctx: FnLowerCtx, arg: Expr, lowered: LoweredExpr) -> Interval | null {
    widened :: widened_values(lowered)
    if widened != null {
        return widened
    }
    recorded :: lowered_values(ctx.types.raw_expr_type(arg))
    if recorded != null {
        return recorded
    }
    return lowered_values(lowered.type)
}

// The values a value of type `t` lies in : its range's bounds, a distinct's
// backing's ; null for a type that is no integer.
lowered_values :: fn(t: Type) -> Interval | null = integer_values(strip_distinct(t))

// The values of `e`, a literal or a cast widening an integer with no loss, through
// any number of such casts ; null for any other expression.
widened_values :: fn(e: LoweredExpr) -> Interval | null {
    if e is LoweredIntLit {
        return interval(e.value, e.value)
    }
    if e !is LoweredCast {
        return null
    }
    inner :: cast_source_values(e.value) ?? return null
    outer :: lowered_values(e.type) ?? return null
    if !interval_within(inner, outer) {
        return null
    }
    return inner
}

// The values of `e`, a cast's operand : those `widened_values` reads, else its type's.
cast_source_values :: fn(e: LoweredExpr) -> Interval | null {
    widened :: widened_values(e)
    if widened != null {
        return widened
    }
    return lowered_values(e.type)
}

// The parts of `runs` a value of `source` may lie in, each cut to `source`.
reachable_runs :: fn(source: Interval, runs: Interval[]) -> Interval[] {
    out: Interval[]: []
    for run in runs {
        met :: interval_meet(run, source) ?? continue
        out.push(met)
    }
    return out
}

// Whether a value of `source` lies in one of `runs` whatever it is : false when none
// is reachable, true when one holds all of `source` ; null when only the value tells.
decided_inside :: fn(source: Interval, runs: Interval[]) -> bool | null {
    reachable :: reachable_runs(source, runs)
    if reachable.len() == 0 {
        return false
    }
    if reachable.len() == 1 && same_interval(reachable[0], source) {
        return true
    }
    return null
}

// How many comparisons `inside_test` makes on a value of `source`.
comparison_count :: fn(source: Interval, runs: Interval[]) -> i64 {
    count: i64 = 0
    for run in reachable_runs(source, runs) {
        if is_single_value(run) {
            count += 1
        } else {
            count += ends_tested(source, run)
        }
    }
    return count
}

// How many ends of `run`, within `source`, a value of `source` may pass.
ends_tested :: fn(source: Interval, run: Interval) -> i64 {
    count: i64 = 0
    if may_lie_below(source, run) {
        count += 1
    }
    if may_lie_above(source, run) {
        count += 1
    }
    return count
}

is_single_value :: fn(run: Interval) -> bool = run.lo == run.hi && !run.lo_open && !run.hi_open

// Whether `value`, holding `source`, lies in one of `runs` : one test per reachable
// run, each comparing only the ends `source` may pass ; `false` when none is
// reachable. Every bound compared lies within `source`, so `compared`, the range of
// `source`, holds it.
inside_test :: fn(
    value: LoweredExpr,
    source: Interval,
    runs: Interval[],
    compared: Type,
    span: Span,
) -> LoweredExpr {
    parts: LoweredExpr[]: []
    for run in reachable_runs(source, runs) {
        parts.push(run_test(value, source, run, compared, span))
    }
    return or_all(span, parts)
}

// Whether `value`, holding `source`, lies in none of `runs` : past an end of the
// one reachable run, or in none of several ; `true` when none is reachable.
outside_test :: fn(
    value: LoweredExpr,
    source: Interval,
    runs: Interval[],
    compared: Type,
    span: Span,
) -> LoweredExpr {
    reachable :: reachable_runs(source, runs)
    if reachable.len() != 1 {
        return maybe_negate(inside_test(value, source, runs, compared, span), true, span)
    }
    run :: reachable[0]
    if is_single_value(run) {
        return bound_test(value, .Neq, run.lo, compared, span)
    }
    tests: LoweredExpr[]: []
    if may_lie_below(source, run) {
        tests.push(bound_test(value, .Lt, run.lo, compared, span))
    }
    if may_lie_above(source, run) {
        tests.push(bound_test(value, .Gt, integer_bound(run, true), compared, span))
    }
    return or_all(span, tests)
}

// Whether `value` lies in `run`, a run within `source` : is its one value, or passes
// none of the ends `source` may pass.
run_test :: fn(
    value: LoweredExpr,
    source: Interval,
    run: Interval,
    compared: Type,
    span: Span,
) -> LoweredExpr {
    if is_single_value(run) {
        return bound_test(value, .Eq, run.lo, compared, span)
    }
    tests: LoweredExpr[]: []
    if may_lie_below(source, run) {
        tests.push(bound_test(value, .Gte, run.lo, compared, span))
    }
    if may_lie_above(source, run) {
        tests.push(bound_test(value, .Lte, integer_bound(run, true), compared, span))
    }
    return and_all(span, tests)
}

// `value op bound`, the bound a literal of `compared`.
bound_test :: fn(
    value: LoweredExpr,
    op: LoweredBinaryOp,
    bound: i64,
    compared: Type,
    span: Span,
) -> LoweredExpr = LoweredBinary {
    .span = span,
    .type = TY_BOOL,
    .op = op,
    .left = value,
    .right = LoweredIntLit { .span = span, .type = compared, .value = bound },
}

// `if stop { @unreachable(reason) }` : a value off its type stops the program, in
// every build.
stop_if :: fn(stop: LoweredExpr, reason: string, span: Span) -> LoweredStmt {
    trap :: LoweredExprStmt {
        .span = span,
        .expr = LoweredUnreachable { .span = span, .type = TY_VOID, .reason = reason },
    }
    return if_then(stop, [trap], span)
}

// `if cond { body }`.
if_then :: fn(cond: LoweredExpr, body: LoweredStmt[], span: Span) -> LoweredStmt = LoweredExprStmt {
    .span = span,
    .expr = LoweredIf {
        .span = span,
        .type = TY_VOID,
        .cond = cond,
        .then_block = mk_void_block(body, span),
        .else_block = null,
    },
}
