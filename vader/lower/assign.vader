// vader/lower/assign — assignment and index / slice lowering.
//

module "vader/lower"

import "std/collections"
import "toolchain/ast"
import "vader/core/symbol"
import "vader/front/typecheck"
import "vader/core/types"
import "toolchain/span"
import "vader/lower/ir"

lower_assign :: fn(ctx: FnLowerCtx, assign_stmt: AssignStmt) -> LoweredStmt {
    compound :: compound_assign_op(assign_stmt) != null
    if takes_place_order(ctx, assign_stmt, compound) {
        return lower_place_assign(ctx, assign_stmt, compound)
    }
    value :: lower_converted(ctx, assign_stmt.value)
    return lower_assign_one(ctx, assign_stmt.target, value, assign_stmt.span)
}

// Whether the place's operands, or the read of a compound place, need an order of
// their own : a compound place with operands uses them twice, and in async a value
// may hoist an `await` past them. A bare name has no operands.
takes_place_order :: fn(ctx: FnLowerCtx, s: AssignStmt, compound: bool) -> bool {
    if s.target is IdentExpr {
        return compound && ctx.in_async
    }
    return compound || ctx.in_async
}

// `target = value`, or `lhs op= rhs` whose `lhs` node is both the target and the
// left operand of `value`. The operands of the place (an index, a receiver that
// is not itself a place) are evaluated once, first, then the value ; the write,
// and the read of `lhs op rhs`, both lower them to that one value
// (`bound_operands`). The place itself is read at the write : a name, a field or
// an array element does no work, and with `rhs` lowered ahead, nothing suspends
// between the read and the write.
lower_place_assign :: fn(ctx: FnLowerCtx, s: AssignStmt, compound: bool) -> LoweredStmt {
    // A compound assignment in a block of `rhs` gets a table of its own ; this one
    // is back before this statement's write lowers.
    outer :: ctx.bound_operands
    ctx.bound_operands = MutableMap<i64, LoweredExpr> {}
    stmts: LoweredStmt[]: []
    bind_place_operands(ctx, s.target, stmts)
    mark :: ctx.pending_awaits.len()
    value_expr :: s.value
    if compound && ctx.in_async && value_expr is BinaryExpr {
        ctx.bound_operands[value_expr.right.id] = lower_expr(ctx, value_expr.right)
    }
    value :: lower_converted(ctx, s.value)
    hoist_prelude_before(ctx, stmts, mark)
    stmts.push(lower_assign_one(ctx, s.target, value, s.span))
    ctx.bound_operands = outer
    return wrap_stmts(s.span, stmts)
}

// Bind the operands of the place `target` : a field's receiver, an element's
// receiver and index.
bind_place_operands :: fn(ctx: FnLowerCtx, target: Expr, out: LoweredStmt[]) -> void {
    // @partial: only a field or an element has operands ; a bare name has none.
    @partial match target {
        is FieldExpr -> { bind_place_receiver(ctx, target.target, out) }
        is IndexExpr -> {
            bind_place_receiver(ctx, target.target, out)
            bind_place_operand(ctx, target.index, out)
        }
        _ -> {}
    }
}

// A receiver that is itself a place — a name, a field, an array element — is read
// again, so only its own operands are bound. Any other is bound whole, an element
// an `Index` impl returns included : its read is a call.
bind_place_receiver :: fn(ctx: FnLowerCtx, receiver: Expr, out: LoweredStmt[]) -> void {
    // @partial: a name, a field or an element may be a place ; anything else is a value.
    @partial match receiver {
        is IdentExpr | FieldExpr -> { bind_place_operands(ctx, receiver, out) }
        is IndexExpr -> {
            if ctx.types.expr_type(receiver.target) is ArrayType {
                bind_place_operands(ctx, receiver, out)
            } else {
                bind_place_operand(ctx, receiver, out)
            }
        }
        _ -> { bind_place_operand(ctx, receiver, out) }
    }
}

// `rhs` runs between the read and the write, so the operand stays in place only
// when nothing can rebind it.
bind_place_operand :: fn(ctx: FnLowerCtx, operand: Expr, out: LoweredStmt[]) -> void {
    mark :: ctx.pending_awaits.len()
    value :: lower_expr(ctx, operand)
    hoist_prelude_before(ctx, out, mark)
    bound :: bind_unless_invariant(ctx, value, "place_operand", value.span, out)
    ctx.bound_operands[operand.id] = bound
}

/// One write to one target, with the value ALREADY lowered.
///
/// Every assignment funnels through here — the plain `a = v` and each element of
/// a destructuring assignment alike — because the two special shapes below are
/// invisible in the target's syntax: an `m[k]` over an `IndexSet` impl is a
/// `set_at` call, and a captured local is a write THROUGH a cell. A caller that
/// built its own `LoweredAssign` would drop the map write on the floor and
/// corrupt the captured slot.
lower_assign_one :: fn(
    ctx: FnLowerCtx, target: Expr, value: LoweredExpr, span: Span,
) -> LoweredStmt {
    via_index_set :: try_lower_index_set_assign(ctx, target, value, span)
    if via_index_set != null { return via_index_set }
    // Reassignment to a captured local : write into its cell rather than
    // overwriting the slot.
    via_cell :: try_lower_cell_set_assign(ctx, target, value, span)
    if via_cell != null { return via_cell }
    place :: lower_assign_target(ctx, target)
    surface_array_into_trait(ctx, value.type, place.type)
    return LoweredAssign {
        .span = span,
        .target = place,
        .value = value,
    }
}

try_lower_cell_set_assign :: fn(
    ctx: FnLowerCtx, assign_target: Expr, value: LoweredExpr, span: Span,
) -> LoweredStmt | null {
    target_ident :: as_ident(assign_target) ?? return null
    if target_ident is IdentExpr {
        symbol :: resolve_ident(ctx, target_ident.span) ?? return null
        if symbol is Symbol {
            if !lives_in_cell(ctx, symbol.id) { return null }
            value_type :: ctx.types.expr_type(target_ident)
            // The cell holds the binding as declared, whatever a narrowing says of it
            // where the write stands.
            declared :: declared_type_of_symbol(ctx, symbol) ?? value_type
            surface_array_into_trait(ctx, value.type, declared)
            return LoweredCellSet {
                .span = span,
                .target = env_cell(ctx, symbol, target_ident.span, value_type),
                .value = value,
                .value_type = declared,
            }
        }
    }
    return null
}

// `[t0, _, ...rest] = value` — read every element into its own temp, THEN write.
//
// The two phases are the whole point: writing as we read would make
// `[a, b] = [b, a]` assign `a = b` and then read the NEW `a` back into `b`.
// The source is bound once too, so `[a, b] = f()` calls `f` a single time. A
// `_` reads nothing; a `...rest` builds its fresh tail array in the read phase.
lower_destructuring_assign :: fn(ctx: FnLowerCtx, s: DestructureAssignStmt) -> LoweredStmt {
    span :: s.span
    value_ty :: ctx.types.expr_type(s.value)
    src_sym :: fresh_synthetic_symbol(ctx, "destr_src")
    stmts: LoweredStmt[]: [
        LoweredLet {
            .span = span, .name = src_sym.name, .symbol = src_sym,
            .type = value_ty, .value = lower_expr(ctx, s.value),
        },
    ]
    src :: synth_ident(src_sym, value_ty, span)
    backing :: destructure_backing(value_ty)
    writes: Expr[]: []
    reads: LoweredExpr[]: []
    for i in 0..<s.targets.len() {
        match t :: s.targets[i] {
            is PlaceTarget    -> {
                elem_ty :: ctx.types.expr_type(t.place)
                tmp :: fresh_synthetic_symbol(ctx, "destr_el")
                stmts.push(LoweredLet {
                    .span = span, .name = tmp.name, .symbol = tmp, .type = elem_ty,
                    .value = destructured_leaf(ctx, t.place, src, backing, elem_ty, span, i),
                })
                writes.push(t.place)
                reads.push(synth_ident(tmp, elem_ty, span))
            }
            is RestTarget     -> {
                // The typechecker only lets a rest through over an array source.
                arr :: array_backing(value_ty) ?? continue
                elem_ty :: ctx.types.apply(arr.element)
                tail_ty :: mk_array(elem_ty)
                tmp :: fresh_synthetic_symbol(ctx, "destr_rest")
                stmts.push(LoweredLet {
                    .span = span, .name = tmp.name, .symbol = tmp, .type = tail_ty,
                    .value = LoweredArrayLit { .span = span, .type = tail_ty, .elements = [] },
                })
                tail :: synth_ident(tmp, tail_ty, span)
                emit_tail_copy(ctx, tail, i, src, elem_ty, span, stmts)
                writes.push(t.place)
                reads.push(tail)
            }
            is WildcardTarget -> {}
        }
    }
    for i in 0..<writes.len() {
        stmts.push(lower_assign_one(ctx, writes[i], reads[i], span))
    }
    return wrap_stmts(span, stmts)
}

// The element `index` of `src` for the place `place`, read at the place's type ;
// when the typecheck accepted a conversion into the place (filed on the place, as
// the value has no node of its own), read at the source's element type and run its
// `into` ; an integer element read at its own type.
destructured_leaf :: fn(
    ctx: FnLowerCtx,
    place: Expr,
    src: LoweredExpr,
    backing: Type,
    place_type: Type,
    span: Span,
    index: i64,
) -> LoweredExpr {
    source_type :: element_type_at(backing, index, place_type)
    if ctx.typed.into_coercions[place.id] != null {
        leaf :: build_leaf_access(src, backing, source_type, span, index, null)
        return prepare_into(ctx, place, leaf, place_type, span)
    }
    if source_type !is RangeType {
        return build_leaf_access(src, backing, place_type, span, index, null)
    }
    return build_leaf_access(src, backing, source_type, span, index, null)
}

// The type element `index` of `backing` holds ; `fallback` for any other shape.
element_type_at :: fn(backing: Type, index: i64, fallback: Type) -> Type {
    if backing is ArrayType {
        return backing.element
    }
    if backing is TupleType && index < backing.elements.len() {
        return backing.elements[index]
    }
    return fallback
}

/// Lvalue lowerer — bypasses the match-narrowing `LoweredCast` wrap that
/// `lower_ident` applies on use-site reads. The bytecode emitter resolves
/// assignment slots via the raw `LoweredIdent` ; a cast in target position
/// breaks that pattern match.
lower_assign_target :: fn(ctx: FnLowerCtx, target: Expr) -> LoweredExpr {
    if target is IdentExpr {
        symbol :: resolve_ident(ctx, target.span)
        if symbol is Symbol {
            return LoweredIdent {
                .span = target.span, .type = ctx.types.expr_type(target), .symbol = symbol,
            }
        }
    }
    // An element written into an array, or into the backing of a distinct with no
    // `IndexSet` of its own : the slot itself, never the `Index` read of a distinct
    // that has one (`index_route`).
    if target is IndexExpr {
        receiver :: ctx.types.expr_type(target.target)
        if index_route(receiver, core_trait_key(TRAIT_INDEX_SET), ctx.typed) == .Array {
            observe_no_call(ctx, target, .IndexWrite, "element")
            return LoweredIndex {
                .span = target.span, .type = ctx.types.expr_type(target),
                .target = lower_expr(ctx, target.target),
                .index  = lower_expr(ctx, target.index),
            }
        }
    }
    return lower_expr(ctx, target)
}

// `arr[lo..<hi]` / `arr[lo..=hi]` over an array-typed receiver lowers
// to `LoweredArraySlice` (zero-copy view). Other index expressions
// (single-element access, an impl's `Index`) keep the generic
// `LoweredIndex` shape or call the member the key picked.

lower_index :: fn(ctx: FnLowerCtx, expr: IndexExpr, type: Type) -> LoweredExpr {
    target_type :: ctx.types.expr_type(expr.target)
    if array_backing(target_type) != null {
        sliced :: try_lower_range_slice(ctx, expr, type)
        if sliced != null {
            return observed(ctx, expr, .IndexRead, sliced)
        }
    }
    // What the index calls, as the typecheck recorded it. A receiver dispatching
    // through `Index` at run time (a trait value, a union of its implementors, a
    // bounded `T` this instance erases) : a virtual `Index.at(c, i)` call, so the
    // receiver's tag picks the impl, mirroring the `c.at(i)` method form
    // (`method_target`). `s[i]` on a `string`, a user struct or a distinct
    // with its own `Index<I, T>` impl : a direct call to the member the key picked.
    callee :: recorded_target(ctx, expr, .IndexRead, target_type)
    target_value :: lower_expr(ctx, expr.target)
    mark :: ctx.pending_awaits.len()
    index :: lower_expr(ctx, expr.index)
    target :: bind_one_before_hoisted(ctx, target_value, mark)
    if callee is RecordedVirtual {
        read :: virtual_call(ctx, callee.trait_key, METHOD_AT, target, [index], type, expr.span)
        return observed(ctx, expr, .IndexRead, read)
    }
    if callee is UfcsMember {
        at :: mk_lowered_call(callee.symbol, [target, index], type, expr.span)
        return observed(ctx, expr, .IndexRead, at)
    }
    element :: LoweredIndex {
        .span = expr.span,
        .type = type,
        .target = target,
        .index = index,
    }
    return observed(ctx, expr, .IndexRead, element)
}

// The zero-copy view `arr[r]` for a `Range` index, literal or value ; null for any
// other index.
try_lower_range_slice :: fn(ctx: FnLowerCtx, expr: IndexExpr, type: Type) -> LoweredExpr | null {
    match range_lit :: expr.index {
        is RangeExpr -> {
            parts :: lower_in_order(ctx, [expr.target, range_lit.lower, range_lit.upper])
            hi_value :: adjust_hi_inclusive(parts[2], range_lit.inclusive, range_lit.span)
            return LoweredArraySlice {
                .span = expr.span,
                .type = type,
                .target = parts[0],
                .lo = parts[1],
                .hi = hi_value,
            }
        }
        _            -> {}
    }
    // Range-typed *value* index (`let r = 0..<n ; arr[r]`) — bind the
    // range to a temp so the three field reads (`.start`, `.end`,
    // `.inclusive`) share one evaluation, then emit the slice.
    idx_type :: ctx.types.expr_type(expr.index)
    if idx_type is StructType {
        if !is_core_struct(idx_type, STRUCT_RANGE) { return null }
        span :: expr.span
        stmts: LoweredStmt[]: []
        // The target is evaluated ahead of the range, as written.
        first_value :: lower_expr(ctx, expr.target)
        mark :: ctx.pending_awaits.len()
        range_value :: lower_expr(ctx, expr.index)
        target_value :: bind_one_before_hoisted(ctx, first_value, mark)
        target :: if reads_independently(target_value, range_value) {
            target_value
        } else {
            bind_unless_stable(ctx, target_value, "slice_target", span, stmts)
        }
        range_sym :: fresh_synthetic_symbol(ctx, "slice_r")
        range_binding :: LoweredLet {
            .span = span, .name = range_sym.name, .symbol = range_sym,
            .type = idx_type, .value = range_value,
        }
        range_ref :: LoweredIdent { .span = span, .type = idx_type, .symbol = range_sym }
        bound_type :: if idx_type.args.len() > 0 { idx_type.args[0] } else { TY_I64 }
        lo_value :: LoweredFieldAccess {
            .span = span,
            .type = bound_type,
            .target = range_ref,
            .field = "start",
        }
        hi_raw :: LoweredFieldAccess {
            .span = span,
            .type = bound_type,
            .target = range_ref,
            .field = "end",
        }
        hi_value :: adjust_hi_inclusive_dynamic(hi_raw, LoweredFieldAccess {
            .span = span, .type = TY_BOOL, .target = range_ref, .field = "inclusive",
        }, span)
        stmts.push(range_binding)
        return LoweredBlock {
            .span = span, .type = type, .stmts = stmts,
            .trailing = LoweredArraySlice {
                .span = span,
                .type = type,
                .target = target,
                .lo = lo_value,
                .hi = hi_value,
            },
        }
    }
    return null
}

adjust_hi_inclusive_dynamic :: fn(hi: LoweredExpr, inclusive: LoweredExpr, span: Span) -> LoweredExpr {
    one :: LoweredIntLit { .span = span, .type = TY_I64, .value = 1 }
    zero :: LoweredIntLit { .span = span, .type = TY_I64, .value = 0 }
    delta :: LoweredIf {
        .span = span, .type = TY_I64, .cond = inclusive,
        .then_block = wrap_as_block(one, span),
        .else_block = wrap_as_block(zero, span),
    }
    return LoweredBinary {
        .span = span, .type = TY_I64, .op = .Add,
        .left = hi, .right = delta,
    }
}

try_lower_index_set_assign :: fn(
    ctx: FnLowerCtx, assign_target: Expr, value: LoweredExpr, span: Span,
) -> LoweredStmt | null {
    target :: assign_target
    // @partial: only an `m[k]` (IndexExpr) LHS can be an IndexSet assign; every
    // other Expr target → null (handled by the regular assign path).
    @partial match target {
        is IndexExpr -> {
            target_type :: ctx.types.expr_type(target.target)
            // What the write calls, as the typecheck recorded it. A receiver
            // dispatching through `IndexSet` at run time (a trait value, a union of
            // its implementors, a bounded `T` this instance erases) : a virtual
            // `IndexSet.set_at(c, i, v)` call, mirroring the read-side `Index.at`
            // one in `lower_index`.
            callee :: recorded_target(ctx, target, .IndexWrite, target_type)
            if callee is RecordedVirtual {
                receiver :: lower_expr(ctx, target.target)
                args: LoweredExpr[]: [lower_expr(ctx, target.index), value]
                method :: METHOD_SET_AT
                call :: virtual_call(ctx, callee.trait_key, method, receiver, args, TY_VOID, span)
                observe_lowered(ctx, target, .IndexWrite, call)
                return LoweredExprStmt { .span = span, .expr = call }
            }
            // An array store is `lower_assign_target`'s.
            if callee !is UfcsMember {
                return null
            }
            observe_symbol(ctx, target, .IndexWrite, callee.symbol)
            // Build `set_at(target, index, value)` direct call.
            receiver :: lower_expr(ctx, target.target)
            index :: lower_expr(ctx, target.index)
            args: LoweredExpr[]: []
            args.push(receiver)
            args.push(index)
            args.push(value)
            return LoweredExprStmt {
                .span = span,
                .expr = mk_lowered_call(callee.symbol, args, TY_VOID, span),
            }
        }
        _ -> { return null }
    }
}

