// vader/lower/singleton — a `@singleton` function as its init and its accessor.
//
// `@singleton f :: fn() -> T { body }` runs `body` once per program and hands every
// call the instance it built. The body is lowered as a function of its own, the
// init, and `f` becomes an accessor over two global slots of the program
// (`LoweredProject.globals`): its state, and the instance.
//
//     if state == READY { return instance }
//     if state == STARTED { trap: called while it initialises }
//     state = STARTED
//     instance = init()
//     state = READY
//     return instance
//
// A `void` singleton runs its body once and keeps no instance, as does one that
// never returns. The init has an identity of its own, as an extern's import has:
// a synthetic symbol and mangle, so it never shares a function slot with `f`.

module "vader/lower"

import "toolchain/span"
import "vader/front/comptime"
import "vader/front/resolver/symbol"
import "vader/front/typecheck"
import "vader/types"

AST :: import "toolchain/ast"

// The states a singleton goes through ; a global slot starts at zero.
STARTED: i64: 1
READY: i64: 2

/// Lower the `@singleton` function `fn_decl`: its body into a synthesised init, and
/// itself into the accessor that runs the init once.
///
/// @param project_ctx  the lowering of the project, which keeps the init and the
///                     global slots.
/// @param entry        the identity of `fn_decl`.
/// @param typed        the module that typed it.
/// @param subst        its (empty) substitution.
/// @param fn_decl      a function without parameters or type parameters.
/// @param return_type  the type of the instance.
/// @return             the accessor, under `fn_decl`'s identity.
lower_singleton :: fn(
    project_ctx: LowerProjectCtx,
    entry: MonoEntry,
    typed: TypedProgram,
    subst: Substitution,
    fn_decl: AST.FnDecl,
    return_type: Type,
) -> LoweredFnDecl {
    ctx :: new_fn_lower_ctx(project_ctx, entry, typed, subst, return_type)
    init :: synthetic_symbol(next_synthetic_id(ctx), .Fn, "${entry.mangled}\$singleton")
    init_entry :: MonoEntry {
        ...entry,
        .mangled = init.name,
        .symbol = init,
    }
    project_ctx.synth_decls.push(LoweredFnDecl {
        .mangled     = init.name,
        .params      = [],
        .return_type = return_type,
        .body        = lower_fn_body(fn_decl, typed, project_ctx, init_entry, subst, return_type),
        .origin      = init_entry,
    })
    span :: fn_decl.span
    state :: new_global(ctx, "${fn_decl.name}.state", TY_I32, span)
    instance :: instance_slot(ctx, fn_decl.name, return_type, span)
    reentered :: LoweredUnreachable {
        .span   = span,
        .type   = TY_VOID,
        .reason = "singleton `${fn_decl.name}` called while it initialises",
    }
    stmts: LoweredStmt[]: [
        when_state(state, READY, LoweredReturn { .span = span, .value = instance }),
        when_state(state, STARTED, LoweredExprStmt { .span = span, .expr = reentered }),
        set_global(state, state_value(span, STARTED)),
        keep_instance(instance, mk_lowered_call(init, [], return_type, span), span),
        set_global(state, state_value(span, READY)),
        LoweredReturn { .span = span, .value = instance },
    ]
    return LoweredFnDecl {
        .mangled     = entry.mangled,
        .params      = [],
        .return_type = return_type,
        .body        = arm_block(stmts, span),
        .origin      = entry,
    }
}

// Add a global slot of the singleton `ctx` lowers, named `name`, of type `type`,
// and read it.
new_global :: fn(ctx: FnLowerCtx, name: string, type: Type, span: Span) -> LoweredGlobalGet {
    slot :: ctx.project.globals.len()
    ctx.project.globals.push(GlobalSlot {
        .name = name,
        .type = type,
        .module = ctx.typed.resolved.path,
    })
    return LoweredGlobalGet {
        .span = span,
        .type = type,
        .slot = slot,
    }
}

// The slot keeping the instance of singleton `name`, or null when it has none to
// keep: it returns `void`, or never returns.
instance_slot :: fn(
    ctx: FnLowerCtx, name: string, type: Type, span: Span,
) -> LoweredGlobalGet | null {
    if is_void(type) || type is NeverType {
        return null
    }
    return new_global(ctx, "${name}.instance", type, span)
}

set_global :: fn(slot: LoweredGlobalGet, value: LoweredExpr) -> LoweredStmt = LoweredGlobalSet {
    .span  = slot.span,
    .slot  = slot.slot,
    .value = value,
}

// `instance = built`, or just `built` when there is no instance to keep.
keep_instance :: fn(
    instance: LoweredGlobalGet | null, built: LoweredExpr, span: Span,
) -> LoweredStmt {
    if instance == null {
        return LoweredExprStmt { .span = span, .expr = built }
    }
    return set_global(instance, built)
}

state_value :: fn(span: Span, value: i64) -> LoweredExpr = LoweredIntLit {
    .span  = span,
    .type  = TY_I32,
    .value = value,
}

// `if state == value { body }`.
when_state :: fn(state: LoweredGlobalGet, value: i64, body: LoweredStmt) -> LoweredStmt {
    branch :: LoweredIf {
        .span       = state.span,
        .type       = TY_VOID,
        .cond       = equals_primop(state, state_value(state.span, value), state.span),
        .then_block = arm_block([body], state.span),
        .else_block = null,
    }
    return LoweredExprStmt { .span = state.span, .expr = branch }
}
