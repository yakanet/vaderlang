// vader/lower/singleton: a `@singleton` function as its init and its accessor.
//
// `@singleton f :: fn() -> T { body }` runs `body` once per program and hands every
// call the instance it built. The body is lowered as a function of its own, the
// init, and `f` becomes an accessor over global slots of the program
// (`LoweredProject.globals`): its state, the instance, and in a program whose
// threads may share it, its gate (`init_gate.vader`).
//
// A program that never loads `std/runtime/scheduler` has one thread:
//
//     if state == READY { return instance }
//     if state == STARTED { trap: called while it initialises }
//     state = STARTED
//     instance = init()
//     state = READY
//     return instance
//
// Otherwise a thread that finds another running the init waits for it, and the
// state goes from IDLE to READY alone: `keep`, a function of its own, builds the
// instance unless a thread it waited for did.
//
//     if state == READY { return instance }
//     <run keep under the gate, trap: called while it initialises>
//     return instance
//
//     keep: if state == READY { return } ; instance = init() ; state = READY
//
// A `void` singleton runs its body once and keeps no instance, as does one that
// never returns. The init has an identity of its own, as an extern's import has:
// a synthetic symbol and mangle, so it never shares a function slot with `f`.

module "vader/lower"

import "toolchain/span"
import "vader/core/mono"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/typecheck"
import "vader/lower/ir"

AST :: import "toolchain/ast"

// Past `STARTED` (`global_slot.vader`), the state of a singleton whose instance is
// built.
READY: i64: 2

/// Lower the `@singleton` function `fn_decl`: its body into a synthesised init, and
/// itself into the accessor that runs the init once.
///
/// @param project_ctx  the lowering of the project, which keeps the init and the
///                     global slots.
/// @param entry        the identity of `fn_decl`.
/// @param typed        the module that typed it.
/// @param subst        its (empty) substitution.
/// @param fn_decl      a function without parameters or type parameters.
/// @param return_type  its declared return.
/// @return             the accessor, under `fn_decl`'s identity.
lower_singleton :: fn(
    project_ctx: LowerProjectCtx,
    entry: MonoEntry,
    typed: TypedProgram,
    subst: Substitution,
    fn_decl: AST.FnDecl,
    return_type: Type,
) -> LoweredFnDecl {
    ctx :: new_fn_lower_ctx(project_ctx, entry, typed, subst, return_type)
    init :: synthetic_symbol(next_synthetic_id(ctx), .Fn, "${entry.mangled}\$singleton")
    init_entry :: MonoEntry {
        ...entry,
        .mangled = init.name,
        .symbol = init,
        .is_main = false,
    }
    init_decl :: lowered_fn_of(fn_decl, typed, project_ctx, init_entry, subst, [], return_type)
    project_ctx.synth_decls.push(init_decl)
    instance_type :: init_decl.return_type
    span :: fn_decl.span
    state :: new_global(ctx.project, ctx.typed.resolved.path, "${fn_decl.name}.state", TY_I32, span)
    instance :: instance_slot(ctx, fn_decl.name, instance_type, span)
    built :: mk_lowered_call(init, [], instance_type, span)
    reentered :: LoweredExprStmt {
        .span = span,
        .expr = LoweredUnreachable {
            .span   = span,
            .type   = TY_VOID,
            .reason = "singleton `${fn_decl.name}` called while it initialises",
        },
    }
    stmts: LoweredStmt[]: [
        when_state(state, READY, LoweredReturn { .span = span, .value = instance }),
    ]
    fns :: ctx.typed.gate_runtime
    if fns == null {
        stmts.push_all([
            when_state(state, STARTED, reentered),
            set_global(state, state_value(span, STARTED)),
            keep_instance(instance, built, span),
            set_global(state, state_value(span, READY)),
        ])
    } else {
        register_gate_fns(ctx)
        keep :: keep_fn(ctx, entry, state, keep_instance(instance, built, span), span)
        stmts.push_all(gated_build(
            ctx.project, fns, ctx.typed.resolved.path, fn_decl.name, keep, reentered, span,
        ))
    }
    stmts.push(LoweredReturn { .span = span, .value = instance })
    return LoweredFnDecl {
        .mangled     = entry.mangled,
        .params      = [],
        .return_type = instance_type,
        .body        = mk_void_block(stmts, span),
        .origin      = entry,
    }
}

// The function that builds the instance with `kept` and makes `state` READY, unless
// it is READY already: a thread the gate made wait finds the instance built.
keep_fn :: fn(
    ctx: FnLowerCtx, entry: MonoEntry, state: LoweredGlobalGet, kept: LoweredStmt, span: Span,
) -> Symbol {
    keep :: synthetic_symbol(next_synthetic_id(ctx), .Fn, "${entry.mangled}\$keep")
    stmts: LoweredStmt[]: [
        when_state(state, READY, LoweredReturn { .span = span, .value = null }),
        kept,
        set_global(state, state_value(span, READY)),
    ]
    ctx.project.synth_decls.push(gate_build_fn(entry, keep.name, keep, stmts, span))
    return keep
}

// The slot keeping the instance of singleton `name`, or null when it has none to
// keep: it returns `void`, or never returns.
instance_slot :: fn(
    ctx: FnLowerCtx, name: string, type: Type, span: Span,
) -> LoweredGlobalGet | null {
    if is_void(type) || type is NeverType {
        return null
    }
    return new_global(ctx.project, ctx.typed.resolved.path, "${name}.instance", type, span)
}

// `instance = built`, or just `built` when there is no instance to keep.
keep_instance :: fn(
    instance: LoweredGlobalGet | null, built: LoweredExpr, span: Span,
) -> LoweredStmt {
    if instance == null {
        return LoweredExprStmt { .span = span, .expr = built }
    }
    return set_global(instance, built)
}
