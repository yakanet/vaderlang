// vader/lower/entry_types — type-table accessor for a lowering pass.
//
// Hides the `(TypedProgram,
// Substitution)` pair behind a single accessor — lower passes call
// `expr_type(view, e)` rather than `substitute(typed.expr_types[e.id]
// ?? TY_UNRESOLVED, subst)`. The boundary lets future changes (e.g.
// materialising substituted bodies on `MonoEntry`) touch one file.

module "vader/lower"

import "std/abort"
import "std/collections"
import "toolchain/ast"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/typecheck"
import "toolchain/span"

/// Per-entry view over the typed program with substitution applied at
/// every read. The struct holds both inputs ; the accessor functions
/// short-circuit when `subst` is empty.
EntryTypes :: struct {
    typed: TypedProgram
    subst: Substitution
}

/// Build an `EntryTypes` view for `(typed, subst)`.
/// @param typed  the module's typed program.
/// @param subst  the entry's substitution (may be empty).
/// @return       a fresh view.
make_entry_types :: fn(typed: TypedProgram, subst: Substitution) -> EntryTypes {
    return EntryTypes { .typed = typed, .subst = subst }
}

/// Apply the entry's substitution to an arbitrary type. A range stays a range,
/// the backend reading the integer it is held in, but in a union
/// (`laid_out_unions`).
/// @param self  the entry-types view.
/// @param t     the type to rewrite.
/// @return      the rewritten type (may be `t` itself).
apply :: fn(self: EntryTypes, t: Type) -> Type = laid_out_unions(substitute(t, self.subst))

// ---- declaration-level reads ----------------------------------------------
//
// What the lowering reads off the typecheck's tables beside the per-expression
// ones, its unions laid out as `apply` lays them out.

/// The signature the typecheck recorded for the fn `callee`.
/// @param owner   the typed program declaring `callee`.
/// @param callee  a fn's symbol.
/// @return        null when the typecheck recorded no signature.
fn_signature :: fn(owner: TypedProgram, callee: Symbol) -> FnType | null =
    recorded_signature(owner.decl_types[callee.id])

/// The signature the typecheck recorded for the impl member `decl`.
/// @param owner  the typed program declaring the impl.
/// @param decl   one of its members.
/// @return       null when the typecheck recorded no signature.
impl_member_signature :: fn(owner: TypedProgram, decl: FnDecl) -> FnType | null =
    recorded_signature(owner.impl_method_decl_types[decl.name_span.hash()])

// `t`, a signature the typecheck recorded ; null for no signature.
recorded_signature :: fn(t: Type | null) -> FnType | null {
    if t !is FnType {
        return null
    }
    laid_out :: laid_out_unions(t)
    if laid_out is FnType {
        return laid_out
    }
    return null
}

/// The type `entry` implements its trait for : the receiver of each of its members.
/// @param entry  an impl.
impl_self_type :: fn(entry: ImplEntry) -> Type = laid_out_unions(entry.for_type)

/// The element a `for` over a value of `iter_type` binds, by the typecheck's own
/// rule (`for_in_element`).
/// @param iter_type  the iterated value's type.
/// @param typed      the module being lowered, for the impl tables.
iterated_element :: fn(iter_type: Type, typed: TypedProgram) -> Type =
    laid_out_unions(for_in_element(iter_type, typed))

/// The arguments `concrete` implements the trait `trait_key` at, as the typecheck
/// recorded them (`lookup_struct_trait_args`).
/// @param concrete   an implementing type.
/// @param trait_key  the trait.
/// @param typed      the module being lowered.
/// @return           null when it records no single argument list.
recorded_trait_args :: fn(concrete: Type, trait_key: string, typed: TypedProgram) -> Type[] | null {
    recorded :: lookup_struct_trait_args(concrete, trait_key, typed) ?? return null
    laid_out: Type[]: []
    for t in recorded {
        laid_out.push(laid_out_unions(t))
    }
    return laid_out
}

// Apply the entry's substitution to a `Type | null` lookup result,
// falling back to `TY_UNRESOLVED` on misses. The lookup-and-substitute
// pattern repeats across every per-table accessor — centralised here
// so a future side-table rekey only touches one match site.
apply_or_unresolved :: fn(self: EntryTypes, raw: Type | null) -> Type {
    if raw is null { return TY_UNRESOLVED }
    return apply(self, raw)
}

/// Per-expression type, with substitution applied. Falls back to
/// `TY_UNRESOLVED` when the node has no recorded type (matches the
/// inline lookups it replaces).
/// @param self  the entry-types view.
/// @param expr  the AST expression node.
/// @return      the resolved type.
expr_type :: fn(self: EntryTypes, expr: Expr) -> Type {
    return apply_or_unresolved(self, self.typed.expr_types[expr.id])
}

/// Per-expression type WITHOUT applying the entry substitution — the raw
/// recorded type. Needed where a type parameter must stay visible despite the
/// entry's subst binding it : whether a `for`'s iterable was a type parameter, which
/// only its instance can refuse. The substituting `expr_type` stays the default
/// everywhere else.
/// @param self  the entry-types view.
/// @param expr  the AST expression node.
/// @return      the recorded type, no substitution applied; `TY_UNRESOLVED`
///              on a miss.
raw_expr_type :: fn(self: EntryTypes, expr: Expr) -> Type {
    raw :: self.typed.expr_types[expr.id] ?? return TY_UNRESOLVED
    return raw
}

/// Per-local-binding type. Same fallback convention as `expr_type`.
///
/// Keyed on `name_span`, NOT `span` — `assign_binding_types`
/// (`vader/front/typecheck/stmt.vader`) writes a `SimpleBinding`'s type under
/// `sb.name_span.hash()`, and the resolver mints the local Symbol on the same
/// `name_span`. The two coincide for every parser-produced binding
/// (`span == name_span == name_tok.span`), so this was invisible — until a
/// materialised default-method body clone (`substitute_body.vader::
/// stamp_binding_spans`) stamps `span` and `name_span` with DISTINCT synthetic
/// spans. Reading `span` then missed the `name_span`-keyed type and the local
/// collapsed to `?` (a method call on it tripped the emit/bytecode/emit ICE). Read the
/// authoritative `name_span`.
/// @param self     the entry-types view.
/// @param binding  the `SimpleBinding` AST node.
/// @return         the resolved type.
local_type :: fn(self: EntryTypes, binding: SimpleBinding) -> Type {
    return apply_or_unresolved(self, self.typed.local_types[binding.name_span.hash()])
}

/// The type recorded under `key`, concretised through the entry's substitution
/// — or null when the slot holds nothing a lowering pass can use.
///
/// For the SPAN-keyed slots a loop variable lands in (`loop_var_type_key`).
/// Those are shared: a generic combinator's `for x in self` over an
/// `Iterator<T>` param records the declared `T` ONCE, for every instance that
/// will ever be lowered. Reading it raw hands `T` to whatever builds the step
/// type, and midir then looks for a field on a `[T, Continuation]` no instance
/// ever materialised.
///
/// Null means "ask your own fallback", and covers three cases: no entry, an
/// entry the typer left unresolved, and a type param that outlived the
/// substitution — the last one meaning this body is being lowered generically
/// rather than as an instance, so only the caller's iterator type (or fused
/// chain element) is concrete.
///
/// @param self  the entry-types view.
/// @param key   the span hash the type was recorded under.
/// @return      the concrete type, or null when the caller must fall back.
concrete_local_type :: fn(self: EntryTypes, key: u64) -> Type | null {
    raw :: self.typed.local_types[key] ?? return null
    if raw is UnresolvedType {
        return null
    }
    concrete :: apply(self, raw)
    if type_contains_type_param(concrete) {
        return null
    }
    return concrete
}

/// Per-fn-param type.
/// @param self   the entry-types view.
/// @param param  the `FnParam` AST node.
/// @return       the resolved type.
param_type :: fn(self: EntryTypes, param: FnParam) -> Type {
    return apply_or_unresolved(self, self.typed.param_types[param.span.hash()])
}

/// Per-type-expression type.
/// @param self       the entry-types view.
/// @param type_expr  the `TypeExpr` AST node.
/// @return           the resolved type.
type_expr_type :: fn(self: EntryTypes, type_expr: TypeExpr) -> Type {
    return apply_or_unresolved(self, self.typed.type_expr_types[type_expr.span.hash()])
}

/// Per-type-expression type WITHOUT the entry substitution, ranges kept : what
/// `@min(T)` reads a range's bounds off.
/// @param self       the entry-types view.
/// @param type_expr  the `TypeExpr` AST node.
/// @return           the recorded type ; `TY_UNRESOLVED` on a miss.
raw_type_expr_type :: fn(self: EntryTypes, type_expr: TypeExpr) -> Type {
    raw :: self.typed.type_expr_types[type_expr.span.hash()] ?? return TY_UNRESOLVED
    return raw
}

/// The type the typecheck recorded for a type expression it narrows on (an `is T`
/// pattern or test), through the entry's substitution.
///
/// Keyed by node id, not span : the clones of a default method keep the trait's
/// spans. A missing entry is a compiler bug, stopped here rather than resolved
/// again in a scope that may be the wrong one.
///
/// @param self       the entry-types view.
/// @param type_expr  the `TypeExpr` AST node.
recorded_type_expr :: fn(self: EntryTypes, type_expr: TypeExpr) -> Type {
    recorded :: self.typed.expr_types[type_expr.id]
        ?? panic("lower: type expression at ${source_position(type_expr.span)} is not recorded")
    return apply(self, recorded)
}

/// The type of field `name` of the struct `struct_symbol`, as the typecheck
/// resolved it in the struct's own module : a field's type may name what the
/// module using the struct does not see. Type parameters stay as written, for
/// the caller to substitute ; a missing entry panics (`recorded_type_expr`).
///
/// @param typed          any module's typed program : the table is shared.
/// @param struct_symbol  the struct's declaration symbol.
/// @param name           the field.
declared_field_type :: fn(typed: TypedProgram, struct_symbol: Symbol, name: string) -> Type {
    declared :: lookup_pre_resolved_field(struct_symbol.id, name, typed)
        ?? panic("lower: no type recorded for `${struct_symbol.name}.${name}`")
    return laid_out_unions(declared)
}

/// The type declared at `name_span` (`declared_type_at`), through the entry's
/// substitution.
///
/// @param self       the entry being lowered.
/// @param name_span  a declaration's name span.
/// @return           unresolved when nothing is declared there.
declared_type :: fn(self: EntryTypes, name_span: Span) -> Type =
    apply_or_unresolved(self, declared_type_at(self.typed, name_span))


// ---- tests ----------------------------------------------------------------

import "std/testing"
import "vader/core/symbol"

@test test_apply_is_identity_under_empty_subst :: fn() -> void {
    typed :: empty_typed_program()
    view  :: make_entry_types(typed, new_substitution())
    same  :: apply(view, TY_I64)
    assert_eq(display_type(same), "i64")
}

// The loop-var slot a generic combinator's `for x in self` writes: one entry,
// span-keyed, shared by every instance lowered from that body.
LOOP_VAR_KEY: u64: 42

type_param_t :: fn() = Symbol {
    .id         = 7,
    .kind       = .TypeParam,
    .name       = "T",
    .module     = "test",
    .module_name = "test",
    .visibility = .Private,
    .defined_at = null,
}

@test test_concrete_local_type_refuses_an_unsubstituted_param :: fn() -> void {
    typed :: empty_typed_program()
    typed.local_types[LOOP_VAR_KEY] = mk_type_param(type_param_t())
    // Empty substitution — the body is being lowered generically, not as an
    // instance. Carrying `T` out of here is what built a step type whose fields
    // no instance ever materialised.
    view :: make_entry_types(typed, new_substitution())
    assert(concrete_local_type(view, LOOP_VAR_KEY) == null, "an unbound `T` yields null")
}

@test test_concrete_local_type_applies_the_instance_substitution :: fn() -> void {
    typed :: empty_typed_program()
    typed.local_types[LOOP_VAR_KEY] = mk_type_param(type_param_t())
    subst :: new_substitution()
    subst.type_params[7] = TY_STRING
    view :: make_entry_types(typed, subst)
    got :: concrete_local_type(view, LOOP_VAR_KEY) ?? TY_UNRESOLVED
    assert_eq(display_type(got), "string")
}

@test test_concrete_local_type_refuses_an_unresolved_slot :: fn() -> void {
    typed :: empty_typed_program()
    typed.local_types[LOOP_VAR_KEY] = TY_UNRESOLVED
    view :: make_entry_types(typed, new_substitution())
    assert(concrete_local_type(view, LOOP_VAR_KEY) == null, "`?` is not an answer")
}

@test test_concrete_local_type_misses_on_an_absent_slot :: fn() -> void {
    view :: make_entry_types(empty_typed_program(), new_substitution())
    assert(concrete_local_type(view, LOOP_VAR_KEY) == null, "no entry yields null")
}

@test test_apply_substitutes_type_param :: fn() -> void {
    typed :: empty_typed_program()
    subst :: new_substitution()
    symbol :: Symbol {
        .id         = 11,
        .kind       = .TypeParam,
        .name       = "T",
        .module     = "test",
        .module_name = "test",
        .visibility = .Private,
        .defined_at = null,
    }
    subst.type_params[11] = TY_STRING
    view :: make_entry_types(typed, subst)
    rewritten :: apply(view, mk_array(mk_type_param(symbol)))
    assert_eq(display_type(rewritten), "string[]")
}
