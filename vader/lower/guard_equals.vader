// vader/lower/guard_equals — the `Equals` methods a vtable dispatches to.
//
// A virtual call picks its impl from the RECEIVER's tag alone, and hands the other
// operand over unchecked. An erased `T: Equals` body — a `MutableMap<K, _>`,
// `x in xs`, `assert_eq` — instantiated on a union reaches a `Point` receiver with a
// `Label` operand, and `Point.equals` would read the `Label` as a `Point`. So every
// `Equals` vtable slot routes through a guard that answers for an operand of another
// type before the impl ever sees it:
//
//     Point$Equals$equals$guard(self: Point, other: any) =
//         other is Point && Point$Equals$equals(self, other as Point)
//
// A primitive's guard compares directly: its `Equals` is the built-in `==`, which
// the native build has no host binding for. A receiver that does not carry its own
// tag (`carries_own_tag`) keeps its plain entry, since a tag test cannot tell it
// apart: an enum or a distinct boxes under its representation's tag, and a generic
// instance whose body other instances share has none (refused beside another
// variant in a `T: Equals` union).

module "vader/lower"

import "std/collections"
import "toolchain/ast"
import "toolchain/span"
import "vader/front/comptime"
import "vader/front/resolver/symbol"
import "vader/front/typecheck"
import "vader/types"

/// Route every `Equals` vtable slot whose receiver carries its own tag through a
/// guard fn — see the file header. Runs before `collect_vtable_entries`, which then
/// registers the guards in the slots their impls leave.
///
/// @param project      the lowered project ; its modules gain the guard fns.
/// @param project_ctx  mints the guards' symbol ids.
guard_equals_slots :: fn(project: LoweredProject, project_ctx: LowerProjectCtx) -> void {
    equals_key :: core_trait_key(TRAIT_EQUALS)
    // A primitive's impl may be lowered twice under one mangle ; it gets one guard.
    guarded :: MutableSet<string> {}
    for [_, m] in project.modules {
        // Pushed after the walk : a guard keeps its impl's slot, and must not be
        // guarded in turn.
        guards: LoweredDecl[]: []
        for i in 0..<m.decls.len() {
            d :: m.decls[i]
            if d !is LoweredFnDecl {
                continue
            }
            slot :: d.origin.vtable_slot ?? continue
            if slot.trait_key != equals_key || slot.method != METHOD_EQUALS || d.params.len() != 2 {
                continue
            }
            receiver :: d.params[0].type
            if !carries_own_tag(receiver) {
                continue
            }
            unslotted :: MonoEntry { ...d.origin, .vtable_slot = null }
            m.decls[i] = LoweredFnDecl { ...d, .origin = unslotted }
            if guarded.add(d.mangled) {
                guards.push(guard_for(d, receiver, project_ctx))
            }
        }
        m.decls.push_all(guards)
    }
}

// `other is R && impl(self, other)`.
guard_for :: fn(d: LoweredFnDecl, receiver: Type, project_ctx: LowerProjectCtx) -> LoweredDecl {
    span :: empty_span()
    self_param :: guard_param("self", receiver, project_ctx)
    other_param :: guard_param("other", TY_ANY, project_ctx)
    self_ref :: synth_ident(self_param.symbol, receiver, span)
    other_ref :: synth_ident(other_param.symbol, TY_ANY, span)
    other_as_receiver :: LoweredCast {
        .span = span,
        .type = receiver,
        .value = other_ref,
    }
    same_type :: type_check(other_ref, receiver, span)
    answer :: if receiver is PrimitiveType | RangeType {
        equals_primop(self_ref, other_as_receiver, span)
    } else {
        mk_lowered_call(fn_symbol_of(d), [self_ref, other_as_receiver], TY_BOOL, span)
    }
    // A symbol of its own, so the DCE reaches the guard through the vtable slot only.
    id :: next_project_synthetic_id(project_ctx)
    symbol :: synthetic_symbol(id, .Fn, "${d.mangled}\$guard")
    return LoweredFnDecl {
        .mangled = symbol.name,
        .params = [self_param, other_param],
        .return_type = TY_BOOL,
        .body = wrap_as_block(and_all(span, [same_type, answer]), span),
        .origin = MonoEntry {
            ...d.origin,
            .mangled = symbol.name,
            .symbol = symbol,
        },
    }
}

guard_param :: fn(name: string, type: Type, project_ctx: LowerProjectCtx) = LoweredParam {
    .name = name,
    .symbol = synthetic_symbol(next_project_synthetic_id(project_ctx), .Param, name),
    .type = type,
}
