// vader/lower/value_abi_report — which composites cross a call in registers, for the report.
//
// A composite small enough crosses a call boundary in registers rather than as a
// heap object. What a bare `Type` decides (a tuple, a distinct over one, the size
// of a leaf, the byte bound) is `vader/core/types/value_abi.vader`, which
// `vader/midir/value_return` asks before it scalarises a return. This file answers
// the same question for the report of the sites a value ABI reaches
// (`$VADER_OPT_REPORT`), with what needs the lowered program: a struct's field
// types, which only its lowered decl carries, and whether a return hands back a
// value it built. It emits nothing.
//
// `T | null` counts: a fallible lookup returns one, and the crossing needs one
// register for the tag, which `ValueAbiSite.nullable` records. A parameter the
// callee writes through counts as well, though a callee handed a copy would be a
// different function: the report does not read the effect summary.

module "vader/lower"

import "std/collections"
import "std/string_builder"
import "vader/core/types"
import "vader/front/typecheck"
import "toolchain/span"
import "vader/core/symbol"
import "vader/lower/ir"

/// One place a value-ABI candidate crosses a call boundary.
ValueAbiSite :: struct {
    /// Mangled name of the function the crossing belongs to.
    fn_name: string
    /// `return`, or the parameter's name.
    position: string
    /// The candidate's rendered type, for a reader scanning the report.
    type_name: string
    /// Payload size in bytes — the axis the 16-byte bound is about.
    bytes: i64
    /// The site is `T | null`: the crossing needs a tag register on top of the
    /// payload.
    nullable: bool
    /// A RETURN whose every `return` hands back a value the callee built.
    ///
    /// The gate a struct return needs before it can be scalarised — see
    /// `returns_only_fresh_composites`. False on a parameter, which the question
    /// does not apply to.
    fresh: bool
}

/// Payload size of `t` under the value-ABI rule, or -1 when it does not qualify.
///
/// Qualifying means: a composite — tuple, distinct, struct, or one of those
/// under a `| null` — whose every leaf is a NON-REFERENCE primitive, summed
/// without padding, no wider than `VALUE_ABI_MAX_BYTES`. The sum ignores padding
/// because the answer only has to be CONSERVATIVE: under-counting can reject
/// something the ABI would have taken, never admit something it would refuse.
///
/// A bare primitive answers -1: there is nothing to unbox, it already crosses in
/// a register.
///
/// @param t        the type at the crossing.
/// @param structs  lowered struct decls keyed by `LoweredStructDecl.mangled`.
/// @param typed    the typed project — `shape_mangle` needs it to spell the key
///                 a `StructType` maps to.
value_abi_size :: fn(
    t: Type, structs: MutableMap<string, LoweredStructDecl>, typed: TypedProject,
) -> i64 = value_abi_sized(value_abi_payload(t), structs, typed, VALUE_ABI_MAX_BYTES)

/// What a `T | null` promises, or `t` itself.
///
/// A wider union keeps its variants and so fails the size walk at its own
/// `_ -> -1` — there is no case to special-case.
value_abi_payload :: fn(t: Type) -> Type = subtract_type(t, TY_NULL)

// `t`'s payload size, or -1. `budget` is what is left of the 16 bytes: it bounds
// the total AND the recursion, since a struct field that is itself a struct
// costs at least one byte per level and an empty struct is rejected outright. A
// separate depth cap would be a second constant free to disagree with this one —
// `Node { next: Node }` terminates on the budget.
value_abi_sized :: fn(
    t: Type, structs: MutableMap<string, LoweredStructDecl>, typed: TypedProject, budget: i64,
) -> i64 {
    if budget <= 0 {
        return -1
    }
    direct :: value_abi_type_size(t)
    if direct >= 0 {
        return over(direct, budget)
    }
    if t !is StructType {
        return -1
    }
    // An empty struct is a tag, not a payload: nothing crosses, so there is
    // nothing here for the value ABI to make cheaper.
    key :: shape_mangle(t, typed) ?? return -1
    decl :: structs[key] ?? return -1
    if decl.fields.len() == 0 {
        return -1
    }
    total: i64 = 0
    for f in decl.fields {
        leaf :: value_abi_leaf_size(f.type)
        size :: if leaf >= 0 {
            leaf
        } else {
            value_abi_sized(f.type, structs, typed, budget - total - 1)
        }
        if size < 0 || total + size > budget {
            return -1
        }
        total = total + size
    }
    return total
}

over :: fn(size: i64, budget: i64) -> i64 = if size > budget { -1 } else { size }

/// Whether every `return` in `body` hands back a value the callee BUILT, so no
/// caller can hold the object it returns.
///
/// The condition a struct return needs and a tuple does not. A tuple has no
/// observable identity, its elements never being written (T3101), so handing
/// back its elements is the same value by another route. A struct has reference
/// semantics: returning one the callee received from elsewhere, and rebuilding
/// it at the caller, would break an alias someone else still holds. Building it on the spot at
/// every return is the proof that nobody does — and it makes the `@value`
/// question moot rather than answering it.
///
/// `null` counts as built: it holds nothing to alias.
returns_only_fresh_composites :: fn(body: LoweredBlock) -> bool {
    return block_returns_fresh(body)
}

block_returns_fresh :: fn(b: LoweredBlock) -> bool {
    for st in b.stmts {
        if !stmt_returns_fresh(st) {
            return false
        }
    }
    return true
}

// @partial: only the statements that can CARRY a return matter. Every other
// variant holds no `return` of its own, so it cannot break the property.
stmt_returns_fresh :: fn(st: LoweredStmt) -> bool = @partial match st {
    is LoweredReturn -> is_fresh_composite(st.value)
    is LoweredLoop   -> block_returns_fresh(st.body)
    is LoweredLabelledBlock -> block_returns_fresh(st.body)
    is LoweredExprStmt -> expr_returns_fresh(st.expr)
    _ -> true
}

// A returned value the callee minted here, or nothing at all.
is_fresh_composite :: fn(v: LoweredExpr | null) -> bool {
    if v == null {
        return true
    }
    if v is LoweredStructLit {
        return true
    }
    // A literal `null` is the absent case of a `T | null` return.
    return v is LoweredNullLit
}

// An `if` / `match` in statement position holds the arms a return lives in.
// @partial: the two nesting expressions ; anything else carries no return.
expr_returns_fresh :: fn(e: LoweredExpr) -> bool = @partial match e {
    is LoweredIf    -> block_returns_fresh(e.then_block) && else_returns_fresh(e.else_block)
    is LoweredBlock -> block_returns_fresh(e)
    _ -> true
}

else_returns_fresh :: fn(b: LoweredBlock | null) -> bool {
    if b == null {
        return true
    }
    return block_returns_fresh(b)
}

// ---- report ---------------------------------------------------------------

/// Render which crossings a value ABI would reach.
///
/// Returns "" when the report is off or nothing qualifies, so the caller can
/// print unconditionally.
///
/// @param ctx      carries the cached `$VADER_OPT_REPORT` flag — the env is read
///                 once per lowering run, never per site.
/// @param project  the finished lowered project ; the sweep needs every decl, so
///                 this runs after the last pass that can still add one.
/// @param typed    the typed project, for `shape_mangle`.
render_value_abi_report :: fn(
    ctx: LowerProjectCtx, project: LoweredProject, typed: TypedProject,
) -> string {
    if !ctx.opt_report {
        return ""
    }
    structs :: index_struct_decls(project)
    sites: ValueAbiSite[]: []
    for [_, m] in project.modules {
        for d in m.decls {
            if d is LoweredFnDecl {
                collect_value_abi_sites(d, structs, typed, sites)
            }
        }
    }
    if sites.len() == 0 {
        return ""
    }
    returns: i64 = 0
    nullables: i64 = 0
    fresh_returns: i64 = 0
    for s in sites {
        // A parameter can never be named `return` — it is a keyword.
        if s.position == "return" {
            returns = returns + 1
            if s.fresh {
                fresh_returns = fresh_returns + 1
            }
        }
        if s.nullable {
            nullables = nullables + 1
        }
    }
    out :: StringBuilder {}
    out.append("\n[VADER_OPT_REPORT] composites that could cross a call in registers\n")
    out.append("  (every leaf a non-reference primitive, payload at most ")
    out.append("${VALUE_ABI_MAX_BYTES} bytes)\n")
    out.append("  returns: ${returns}   parameters: ${sites.len() - returns}")
    out.append("   of which `T | null`: ${nullables}\n")
    out.append("  returns whose every `return` builds its value on the spot: ${fresh_returns}\n")
    out.append("    (the gate a STRUCT return needs ; a tuple has no identity to break)\n\n  sites:\n")
    for s in sites {
        tag :: if s.nullable { " +tag" } else { "" }
        mint :: if s.position == "return" && s.fresh { " fresh" } else { "" }
        out.append("    ${s.fn_name}  ${s.position}: ${s.type_name} (${s.bytes} B${tag})${mint}\n")
    }
    return out.to_string()
}

// Lowered struct decls under the mangle every other consumer dedups on, so a
// `StructType` at a crossing finds its decl through `shape_mangle` rather than
// through a key this file would own alone.
index_struct_decls :: fn(project: LoweredProject) -> MutableMap<string, LoweredStructDecl> {
    out :: MutableMap<string, LoweredStructDecl> {}
    for [_, m] in project.modules {
        for d in m.decls {
            if d is LoweredStructDecl {
                out[d.mangled] = d
            }
        }
    }
    return out
}

// Every crossing `fd` carries: its return type, then each parameter.
collect_value_abi_sites :: fn(
    fd: LoweredFnDecl, structs: MutableMap<string, LoweredStructDecl>, typed: TypedProject,
    out: ValueAbiSite[],
) -> void {
    body :: fd.body
    fresh :: body != null && returns_only_fresh_composites(body)
    push_site(
        out, fd.mangled, "return", fd.return_type,
        value_abi_size(fd.return_type, structs, typed), fresh)
    for p in fd.params {
        size :: value_abi_size(p.type, structs, typed)
        if size < 0 {
            continue
        }
        push_site(out, fd.mangled, p.name, p.type, size, false)
    }
}

// `size` comes from the caller, which already had to compute it to decide.
push_site :: fn(
    out: ValueAbiSite[], fn_name: string, position: string, t: Type, size: i64, fresh: bool,
) -> void {
    if size < 0 {
        return
    }
    out.push(ValueAbiSite {
        .fn_name = fn_name,
        .position = position,
        .type_name = display_type(t),
        .bytes = size,
        .nullable = t is UnionType,
        .fresh = fresh,
    })
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_value_abi_reads_through_a_nullable :: fn() -> void {
    pair :: mk_tuple([TY_CHAR, TY_I64])
    assert_eq(display_type(value_abi_payload(mk_union([pair, TY_NULL]))), "[char, i64]")
}

@test
test_value_abi_keeps_a_three_way_union_whole :: fn() -> void {
    wide :: mk_union([TY_I32, TY_F64, TY_NULL])
    assert_eq(value_abi_type_size(value_abi_payload(wide)), -1)
}

value_abi_test_sym :: fn() -> Symbol = Symbol {
    .id = 9001,
    .kind = .TypeAlias,
    .name = "Coord",
    .module = "test",
    .module_name = "test",
    .visibility = .Private,
    .defined_at = null,
}

@test
test_fresh_returns_accepts_a_built_struct :: fn() -> void {
    // `return Pair { .a = c }` — the callee minted it, so no caller can be
    // holding it.
    body :: fresh_test_body([
        LoweredReturn {
            .span = empty_span(),
            .value = LoweredStructLit {
                .span = empty_span(),
                .type = TY_I32,
                .fields = [],
            },
        },
    ])
    assert(returns_only_fresh_composites(body), "a struct literal is freshly built")
}

@test
test_fresh_returns_accepts_null :: fn() -> void {
    // The absent case of a `T | null` holds nothing to alias.
    body :: fresh_test_body([
        LoweredReturn { .span = empty_span(), .value = LoweredNullLit { .span = empty_span(), .type = TY_NULL } },
    ])
    assert(returns_only_fresh_composites(body), "null holds nothing to alias")
}

@test
test_fresh_returns_refuses_a_forwarded_value :: fn() -> void {
    // `return self.cached` hands back an object the caller may already hold —
    // rebuilding it at the call site would break that alias.
    body :: fresh_test_body([
        LoweredReturn {
            .span = empty_span(),
            .value = LoweredIdent {
                .span = empty_span(),
                .type = TY_I32,
                .symbol = value_abi_test_sym(),
            },
        },
    ])
    assert(!returns_only_fresh_composites(body), "a forwarded value may be aliased")
}

@test
test_fresh_returns_looks_inside_an_if :: fn() -> void {
    // The early `return null` of an iterator's `next` lives in an `if` arm.
    forwarded :: LoweredReturn {
        .span = empty_span(),
        .value = LoweredIdent {
            .span = empty_span(),
            .type = TY_I32,
            .symbol = value_abi_test_sym(),
        },
    }
    nested :: LoweredExprStmt {
        .span = empty_span(),
        .expr = LoweredIf {
            .span = empty_span(),
            .type = TY_VOID,
            .cond = LoweredNullLit { .span = empty_span(), .type = TY_NULL },
            .then_block = fresh_test_body([forwarded]),
            .else_block = null,
        },
    }
    assert(!returns_only_fresh_composites(fresh_test_body([nested])), "an arm's return counts")
}

fresh_test_body :: fn(stmts: LoweredStmt[]) -> LoweredBlock = mk_void_block(stmts, empty_span())
