// vader/lower/lower_impl_member — impl-member resolution, mangling, Into-coercion and casts.
//

module "vader/lower"

import "std/collections"
import "std/iter"

import "toolchain/ast"
import "vader/diagnostics"
import "vader/typecheck"
import "vader/resolver/symbol"
import "vader/types"
import "vader/comptime"
import "toolchain/span"

UfcsMember :: struct {
    symbol: Symbol
    /// True when the member is the identity `fn(self) = self` (e.g. string's
    /// `Display.to_string`). `build_member_call_or_inline` then inlines the call
    /// to the receiver instead of emitting a real call. Defaults `false`.
    is_identity: bool = false
    /// Declared types of the member's arguments, receiver EXCLUDED, so a call site
    /// can prepare each one for its slot (`helpers::lower_call_args`).
    /// Sourced from `impl_member_arg_types` ; empty when the member's signature
    /// isn't in the frontend table, and callers then pass their args through as-is.
    arg_types: Type[] = []
}

// True when `m` is the trivial identity `fn(self) = self` — expression-bodied,
// exactly one param (`self`), body a bare reference to that param. Such a member
// is inlined to its receiver at the call site (`build_member_call_or_inline`).
is_identity_member :: fn(m: FnDecl) -> bool {
    if !m.is_expression_bodied { return false }
    if m.params.len() != 1 { return false }
    b :: m.body ?? return false
    if !b.stmts.is_empty() { return false }
    t :: b.trailing ?? return false
    if t is IdentExpr { return t.name == m.params[0].name }
    return false
}

/// Build a call to a resolved impl member, OR inline its body when trivial.
/// Today (P1) only the identity `fn(self) = self` is inlined — the call collapses
/// to the receiver (`args[0]`), eliminating the call (e.g. every `string`-part
/// `${…}` interpolation's no-op `to_string`). All other members emit the direct
/// `LoweredCall` exactly as before. The single hook every "resolve impl member +
/// build call" site should route through (P2 will extend it to general
/// expression bodies via value-substitution).
build_member_call_or_inline :: fn(member: UfcsMember, args: LoweredExpr[], ret: Type, span: Span) -> LoweredExpr! {
    // Identity uses `self` exactly once, so returning the (already-lowered)
    // receiver evaluates it once — no temp / double-eval concern.
    if member.is_identity && args.len() == 1 { return args[0] }
    return mk_lowered_call(member.symbol, args, ret, span)
}

// Queue a generic-struct instance for impl-member materialisation : its members
// (re)materialise via `drain_generic_fn_instances` and land in the vtable so a
// virtual `recv.method()` resolves at emit. Deduped per receiver via
// `seen_generic_impl_recv`. Shared by the erased-receiver path
// (`build_ufcs_member`) and a generic struct literal.
queue_generic_impl_receiver :: fn(ctx: FnLowerCtx, recv: StructType) -> void {
    // Distinct→backing on the receiver's args before keying/queuing — the
    // queued instance must match the registry's raw backing instance, not a
    // separate distinct one. Distinct ends at the lowering boundary.
    mono_args :: strip_distinct_each(recv.args)
    recv_key :: "${recv.symbol.name}${mixed_any_suffix(ctx.project.impls, mono_args)}"
    if ctx.project.seen_generic_impl_recv.contains(recv_key) { return }
    ctx.project.seen_generic_impl_recv.add(recv_key)
    ctx.project.pending_generic_impl_recv.push(GenericInstance {
        .symbol = recv.symbol, .args = mono_args, .display_key = recv_key,
    })
}

// `is Trait` membership rows are now seeded from the frontend's
// `struct_traits_by_sym` at emit (`build_impl_table_from_vtable`), covering
// every interned struct tag incl. generic instances. Host-produced structs
// (IOError, returned by `@intrinsic` io fns) become vtable-eligible because
// `lower_call.vader::mark_produced_structs` marks a call's return-type structs
// as constructed, so the existing `vtable_gate` surfaces their impl methods.
// The old per-is-check `materialize_trait_check_impls` force-hook is gone.

// An impl-member match carried across the scan as the `@intrinsic` fallback —
// a named struct (not a bare tuple) so its fields keep their types through the
// `| null` union and narrow cleanly after the null guard.
ImplMemberMatch :: struct {
    entry:  ImplEntry
    member: FnDecl
}

/// Resolve `target_type`'s impl member : in its impl of `trait_key` (any impl when
/// empty), the member `name`. Keying on the trait keeps a same-named member of
/// another trait the type implements from being the one called.
///
/// Owns the one invariant every lookup shares: a user impl (with a real
/// body) shadows an `@intrinsic` builtin of the same (type, member) —
/// `i32 implements Display -> "..."` must win over the std_core intrinsic
/// `Display`. Single pass: return the first non-intrinsic match immediately;
/// remember the first intrinsic match as a fallback and use it only when no
/// user impl turns up.
resolve_impl_member :: fn(
    ctx: FnLowerCtx,
    target_type: Type,
    trait_key: string,
    name: string,
) -> UfcsMember | null {
    target_name :: type_surface_name(target_type)
    if target_name == "" { return null }
    target :: impl_base_key(target_type)
    fallback: ImplMemberMatch | null = null
    candidates: ImplEntry[]: if trait_key == "" { ctx.project.impls.impls_on(target) } else {
        ctx.project.impls.impls_of(target, trait_key)
    }
    for entry in covering_first(candidates, target_type) {
        decl :: entry.decl
        m :: select_member(entry, name) ?? continue
        if !impl_is_intrinsic(decl) {
            return build_ufcs_member(ctx, target_type, target_name, m, entry, is_identity_member(m))
        }
        // An `@intrinsic` fallback is bodyless → never an inlineable identity.
        if fallback == null { fallback = ImplMemberMatch { .entry = entry, .member = m } }
    }
    if fallback != null {
        return build_ufcs_member(
            ctx, target_type, target_name, fallback.member, fallback.entry, false,
        )
    }
    return null
}

// The member named `name` the impl `entry` declares.
select_member :: fn(entry: ImplEntry, name: string) -> FnDecl | null {
    for m in entry.decl.members {
        if m.name == name { return m }
    }
    return null
}

// Resolve a member by NAME, whatever trait declares it : what the lowering calls
// on its own account (a `concat_N` buffer, an interpolation's `to_string`).
find_impl_member_for :: fn(ctx: FnLowerCtx, target_type: Type, method_name: string) -> UfcsMember | null =
    resolve_impl_member(ctx, target_type, "", method_name)

/// The vtable slot an impl member of `trait_key` fills ; null for a static member,
/// which is reached through a type and never dispatched on a value.
///
/// @param trait_key  the trait the impl implements.
/// @param member     the impl member.
member_vtable_slot :: fn(trait_key: string, member: FnDecl) -> VtableSlot | null =
    if has_self_param(member) {
        VtableSlot { .trait_key = trait_key, .method = member.name }
    } else {
        null
    }

// The instance suffix of the member `entry` materialises for `target_type`. A
// generic-struct receiver picks up the materialised member's instance suffix. The
// materialiser erases the args to `Any` for generic impls (`Range<i32>` →
// `count__Any`) so the shared erased body's sibling self-calls resolve to one
// name ; an impl on one instance keeps the concrete suffix (`Wrapper<i32>` →
// `count__i32`). Primitive receivers (`string implements Display`) have no args →
// empty suffix.
// @partial: only struct/array receivers carry an arg suffix; primitive/etc. have none → "".
receiver_suffix :: fn(ctx: FnLowerCtx, entry: ImplEntry, target_type: Type) -> string =
    @partial match target_type {
        // Generic impl : structure-free `__Any` × arity so the call-site name
        // matches the single deduped body regardless of the receiver's concrete
        // args (see `mixed_any_suffix`). Concrete-instantiation impls keep their
        // concrete args.
        is StructType -> if entry.is_generic {
            mixed_any_suffix(ctx.project.impls, target_type.args)
        } else {
            args_suffix(target_type.args)
        }
        // Blanket array impl (`T[] implements Contains`) : materialise one
        // CONCRETE body per element type (`contains__i32`) so the member's `==`
        // devirtualises to the element primop — distinct from the struct
        // generic-erasure path (`__Any`).
        is ArrayType -> args_suffix([target_type.element])
        _ -> ""
    }

/// Build the `UfcsMember` for `member` of `entry`'s impl on `target_type` :
/// the deterministic mangle, plus the side-tables that surface / materialise it.
build_ufcs_member :: fn(
    ctx: FnLowerCtx,
    target_type: Type,
    target_name: string,
    member: FnDecl,
    entry: ImplEntry,
    is_identity: bool,
) -> UfcsMember {
    decl :: entry.decl
    // Synthesise a Fn symbol carrying the member's deterministic mangle so the
    // call site resolves to the synth decl's mangle index
    // (`function_index_by_mangle`, consulted first in the CFG call emit). The
    // `id = 0` placeholder is harmless : the mangle path resolves before the
    // symbol-id lookup ever runs.
    //
    // The module prefix is the IMPL's owning module (`entry.module`), NOT the
    // caller's (`ctx`). For an intrinsic like `string implements Display`
    // reached from `println` in std/io, the mangle must read `std_core$…`,
    // matching where the impl is declared / its surfaced decl is registered
    // (GATE B). Same-module user impls are unaffected (entry.module == ctx's).
    //
    // Then what tells its members from another impl of the trait on that base
    // (`ImplEntry.overload_suffix`), as every materialiser names them.
    impl_name :: "${mangle_module_id(entry.module)}$${target_name}$${decl.trait_name}"
    suffix :: receiver_suffix(ctx, entry, target_type)
    overload :: entry.overload_suffix
    mangled :: "${impl_name}$${member.name}${suffix}${overload}"
    // Record the call so the post-lowering pass surfaces referenced stdlib impl
    // members : bodyless (`@intrinsic`) → import ; with-body (e.g. `i32
    // implements Hash -> u64(self)`) → materialised real fn.
    ctx.project.referenced_impl_mangles.add(mangled)
    note_member_origin(ctx, mangled, member, entry.trait_key)
    // Array impl (`T[] implements Contains` / `Into`, `MonType[] implements …`) :
    // the generic-impl materialiser is struct-instance-driven and never reaches an
    // array receiver, so record the element type and the member keyed by this
    // call-site mangle. `surface_array_impl_members` materialises one concrete
    // body per element (substituting `T → element`, so e.g. `contains`'s `==`
    // devirtualises).
    if target_type is ArrayType {
        ctx.project.array_member_uses[mangled] = ArrayMemberUse {
            .element = target_type.element,
            .member_span = member.span,
        }
    }
    // Generic-struct receiver (`MutableMap<Any, bool>`) : the regular
    // materialiser only covers instances in `evaluated.instances`, so an ERASED
    // receiver reached only from a deduped erased free-fn body (`add`'s `value
    // in self.inner`) never gets its impl members. Queue it for
    // `drain_generic_fn_instances` to materialise (struct analogue of
    // `array_member_uses`).
    if target_type is StructType {
        if entry.is_generic { queue_generic_impl_receiver(ctx, target_type) }
    }
    return UfcsMember {
        .symbol = Symbol {
            .id         = 0,
            .kind       = .Fn,
            .name       = mangled,
            .module     = ctx.typed.resolved.path,
            .module_name = ctx.typed.resolved.path,
            .visibility = .Private,
            .defined_at = null,
        },
        .is_identity = is_identity,
        .arg_types = impl_member_arg_types(ctx, target_type, member, entry),
    }
}

// Declared types of the member's arguments, receiver EXCLUDED.
//
// Read from the frontend's `impl_methods` table — the very table the typer keyed
// this dispatch on, so the slot types here are the ones it type-checked the call
// against, and its `ty` is already receiver-dropped (`ufcs_method_type`). The
// table is complete on the ENTRY module whatever the impl's own module :
// `merge_external_impl_methods` broadcasts every foreign impl onto it. Keys
// mirror the typer's two probes — exact display key, then base name.
//
// Empty when the member has no entry (a receiver shape the typer keyed
// differently) — the caller then passes its args through untouched rather than
// guessing a slot type.
impl_member_arg_types :: fn(
    ctx: FnLowerCtx,
    recv_type: Type,
    member: FnDecl,
    entry: ImplEntry,
) -> Type[] {
    entry_typed :: ctx.project.typed.modules[ctx.project.loaded.entry] ?? return []
    candidates :: impl_candidates(entry_typed, recv_type, "::${member.name}")
    if candidates.len() == 0 {
        return []
    }
    // The impl's own member among several impls of one trait (`Add<f64>`,
    // `Add<Vec2>`).
    impl_key :: entry.decl.span.hash()
    found := candidates[0]
    for m in candidates {
        if m.impl_key == impl_key {
            found = m
        }
    }
    if found.ty is FnType as ft { return ft.params }
    return []
}

/// Materialise the member `method` of `trait_key` for every array variant of
/// `receiver`, a union a virtual call dispatches on : an array impl's member is
/// built only for the elements a call names (`array_member_uses`), and a union's
/// array reaches it through the vtable alone.
///
/// @param receiver   the virtual call's receiver type ; anything but a union is left.
/// @param trait_key  the trait the call dispatches through.
/// @param method     the member it calls.
surface_array_variants :: fn(
    ctx: FnLowerCtx,
    receiver: Type,
    trait_key: string,
    method: string,
) -> void {
    if receiver !is UnionType {
        return
    }
    for v in receiver.variants {
        if v is ArrayType {
            _ :: resolve_impl_member(ctx, v, trait_key, method)
        }
    }
}

/// `receiver.method(args)` dispatched by the receiver's tag through `trait_key` : every
/// primitive implementor enters the trait's vtable (`virtually_dispatched_traits`),
/// and so does every array variant of a union receiver (`surface_array_variants`).
///
/// @param receiver     the lowered receiver ; a value of the trait, a union of its
///                     implementors, an erased bounded `T`.
/// @param type         the call's result type.
/// @param param_types  the member's parameter types, which a scalar argument is
///                     retagged for ; empty when every argument is already boxed or
///                     concrete.
virtual_call :: fn(
    ctx: FnLowerCtx,
    trait_key: string,
    method: string,
    receiver: LoweredExpr,
    args: LoweredExpr[],
    type: Type,
    span: Span,
    param_types: Type[] = [],
) -> LoweredVirtualCall! {
    ctx.project.virtually_dispatched_traits.add(trait_key)
    surface_array_variants(ctx, type_of(receiver), trait_key, method)
    return LoweredVirtualCall {
        .span        = span,
        .type        = type,
        .trait_name  = trait_key,
        .method      = method,
        .receiver    = receiver,
        .args        = args,
        .param_types = param_types,
    }
}

// The member `name` of `entry`, built for `receiver`.
member_named :: fn(
    ctx: FnLowerCtx,
    entry: ImplEntry,
    receiver: Type,
    name: string,
) -> UfcsMember | null {
    m :: select_member(entry, name) ?? return null
    surface :: type_surface_name(receiver)
    return build_ufcs_member(ctx, receiver, surface, m, entry, is_identity_member(m))
}

/// True when an `@intrinsic` impl. Lets a user impl shadow the builtin in
/// `find_impl_member_for`. (Mirrors `vader/resolver/materialize.vader::is_intrinsic`,
/// kept local to avoid a resolver→lower import.)
impl_is_intrinsic :: fn(decl: ImplDecl) -> bool {
    for d in decl.decorators {
        if d.name == "intrinsic" { return true }
    }
    return false
}

// Nominal token a receiver type registers UFCS impls under. Exhaustive over
// `Type` (no `_`) : the non-nominal shapes (fn / union / trait / type-param /
// meta / self / unresolved / free-numeric / never / any) have no single
// surface name and resolve through other paths, so they map to "" explicitly —
// listing them trips T3013 if a new *nominal* Type variant is added that ought
// to carry a UFCS surface.
type_surface_name :: fn(t: Type) -> string = match t {
    is PrimitiveType -> t.name
    is StructType    -> t.symbol.name
    is EnumType      -> t.symbol.name
    // Distinct (newtype) dispatches operators / UFCS under its own nominal
    // name (opaque — an impl on the distinct, never the backing's).
    is DistinctType -> t.symbol.name
    // Generic-shape pattern + concrete receiver agree on a canonical token :
    // `T[]` and `i32[]` both surface as `[]` for UFCS lookup.
    is ArrayType          -> "[]"
    is TupleType          -> "()"
    is FnType             -> ""
    is UnionType          -> ""
    is TraitType          -> ""
    is TypeParamType      -> ""
    is TypeMetaType       -> ""
    is SelfType           -> ""
    is UnresolvedType     -> ""
    is FreeIntType        -> ""
    is FreeCharType       -> ""
    is FreeFloatType      -> ""
    is NeverType          -> ""
    is AnyType            -> ""
}


/// `T(value)` cast-call detector. Returns a `LoweredCast` when the callee
/// is a type-shaped symbol (builtin primitive, struct, or type alias) or a type
/// written in place (`i32[](row)`, `(i32 | string)(x)`), with a single arg. For non-numeric targets the typer already routed the arg
/// through `try_into` ; the lowered arg is then handed back verbatim only when
/// the cast is a true identity — unwrapping a distinct still stamps its target,
/// see `emit_value_cast`.
try_lower_cast_call :: fn(ctx: FnLowerCtx, call: CallExpr, type: Type) -> LoweredExpr! | null {
    if call.args.len() != 1 { return null }
    if call.callee !is IdentExpr && ctx.types.expr_type(call.callee) is TypeMetaType {
        return emit_value_cast(ctx, call, type)
    }
    callee_ident :: as_ident(call.callee) ?? return null
    callee_symbol :: resolve_ident(ctx, callee_ident.span) ?? return null
    // Follow an import binding first : a renamed import (`{ Info as I }`) and a
    // cross-module distinct both carry their kind and their `alias_types` entry
    // on the DEFINING symbol, not on the binding.
    type_redir :: ctx.typed.resolved.imports_to[callee_symbol.id]
    type_sym :: if type_redir is null { callee_symbol } else { type_redir }
    // @partial: only type-introducing symbol kinds are type-shaped callees; the rest are not.
    is_type_shaped :: @partial match type_sym.kind {
        .BuiltinType -> true
        .Struct      -> true
        .TypeAlias   -> true
        _            -> false
    }
    // A non-generic type alias (`Foo :: i64`) or a distinct newtype is a
    // ConstDecl, so its symbol kind is `.Const` — but it resolves into
    // `alias_types`. Recognise such a type-valued const as a cast/wrap callee
    // too (without this, `Foo(x)` / `Instant(x)` lowers to a bogus call).
    is_type_const :: !(ctx.typed.resolved.alias_types[type_sym.id] is null)
    if !is_type_shaped && !is_type_const { return null }
    return emit_value_cast(ctx, call, type)
}

/// Emit the lowered form of a single-arg cast/wrap `T(value)` to `type`. Shared
/// by the direct-ident path (`try_lower_cast_call`) and the namespace path
/// (`nsM.T(value)` in `try_lower_namespace_call`). The caller has already
/// confirmed this is a cast (type-shaped callee / TypeMetaType) with one arg.
emit_value_cast :: fn(ctx: FnLowerCtx, call: CallExpr, type: Type) -> LoweredExpr! {
    // The cast itself calls nothing ; an `into` it runs is its value's site.
    observe_no_call(ctx, call, .Call, "cast")
    // The checked type, not the lowered one : a variant literal lowers to its
    // bare index and no longer says it is an enum.
    source :: enum_type_or_unwrap(ctx, ctx.types.expr_type(call.args[0].value))
    if source is EnumType && enum_data_of(source, type) != null {
        return lower_enum_data_slot(ctx, lower_expr(ctx, call.args[0].value), source, call.span)
    }
    if source is EnumType && source.data != null && type !is EnumType {
        value :: as_written_value(ctx, call.args[0].value, lower_expr(ctx, call.args[0].value))
        return LoweredCast { .span = call.span, .type = type, .value = value }
    }
    arg :: lower_expr(ctx, call.args[0].value)
    arg_type :: type_of(arg)
    // `Target(value)` probes for `value : Source` where
    // `Source implements Into<Target>`. When the Into impl exists, the
    // typer's `tryInto` lifts `value` to `into(value)` ; we recreate
    // that lift at lower time. The numeric-primitive cast then wraps
    // the lifted call for byte-parity (`cast → i32 / call into(u)`).
    coerced :: try_emit_into_coercion(ctx, arg, arg_type, type, call.span)
    observe_replacement(ctx, call.args[0].value, .Into, arg, coerced ?? arg)
    inner :: if coerced == null { arg } else { coerced }
    if type is PrimitiveType {
        n :: type.name
        if n == "string" || n == "bool" || n == "void" || n == "null" {
            // A true identity cast (`string(s)` on a `string`) hands the arg back
            // untouched. UNWRAPPING a distinct is not that: `string(n)` where
            // `n : Name` must stamp `string`, or the lowered tree keeps carrying
            // `Name` and anything reading the result's type resolves against the
            // distinct. That is how `string(n).trim()` lowered to a field access
            // and panicked in midir with "no field `trim` on `Name`" — while
            // binding the cast first, or calling `trim(string(n))`, both worked.
            // The wrap direction below already stamps; this is the missing half.
            // Free at runtime: `bc_type_of(distinct) == bc_type_of(backing)`.
            if equals_type(type_of(inner), type) {
                return inner
            }
            return LoweredCast { .span = call.span, .type = type, .value = inner }
        }
        return LoweredCast { .span = call.span, .type = type, .value = inner }
    }
    // Distinct `X :: P` wrap — `X(v)` is a pure representation no-op (X shares
    // P's backend repr) ; stamp the distinct type so the lowered tree stays
    // well-typed. `bc_type_of(distinct) == bc_type_of(backing)`, so the cast
    // emit is a no-op too. (Unwrap `P(x)` rides the `PrimitiveType` arm above.)
    if type is DistinctType { return LoweredCast { .span = call.span, .type = type, .value = inner } }
    // Any other target stamps itself too, unless the arg already has it : leaving a
    // distinct over a struct or an array for its backing (`i32[](row)`), whose
    // `Display` must be the backing's, or widening into a union (`(i32 | string)(3)`).
    if equals_type(type_of(inner), type) {
        return inner
    }
    return LoweredCast {
        .span = call.span,
        .type = type,
        .value = inner,
    }
}

// Build the `into(arg)` coercion call. `callee_name` is the resolved impl-member
// mangle the emit phase binds via `function_index_by_mangle` (the `id = 0`
// placeholder is inert — the mangle path runs before the symbol-id lookup).
// `callee_module` is informational on that path, so callers pass the impl's
// owning module when resolved and the caller's module on the bare fallback.
mk_into_call :: fn(
    arg: LoweredExpr, result_type: Type, span: Span, callee_name: string, callee_module: string,
) -> LoweredCall! {
    return LoweredCall {
        .span = span, .type = result_type,
        .callee = LoweredIdent {
            .span = span, .type = result_type,
            .symbol = Symbol {
                .id = 0, .kind = .Fn, .name = callee_name,
                .module = callee_module,
                .module_name = callee_module,
                .visibility = .Private, .defined_at = null,
            },
        },
        .args = [arg],
    }
}

// The bare `into` placeholder — emit can't resolve it to a member mangle. A
// generic `Into` impl on a struct reaches it : the coercion path builds no
// erased-instance mangle.
mk_bare_into_call :: fn(ctx: FnLowerCtx, arg: LoweredExpr, result_type: Type, span: Span) -> LoweredCall! =
    mk_into_call(arg, result_type, span, METHOD_INTO, ctx.typed.resolved.path)

// `T[] -> Iterator<T>` value-slot coercion. Returns `into(arr)` resolved to the
// member the typechecker judged it by — std/core's `T[] implements
// Into<Iterator<T>!>` unless an impl on the array's own instance converts to that
// very iterator — typed as the target `Iterator<T>` existential : value slots
// dispatch `it.next()` virtually, so the member must box the iterator into the
// trait (unlike the for-in path, which has a raw-array fast path and never builds
// one). `build_ufcs_member` mangles the member (`std_core$[]$Into$into__<element>`)
// and records it in `array_member_uses`, which `surface_array_impl_members`
// materialises.
try_array_iter_coercion :: fn(
    ctx: FnLowerCtx, arg: LoweredExpr, arg_type: Type, target_type: Type, span: Span,
) -> LoweredExpr! | null {
    if arg_type is ArrayType {
        if target_type is TraitType {
            if target_type.symbol.name != TRAIT_ITERATOR { return null }
            if target_type.args.len() != 1 { return null }
            // `into` returns `array_iter(self)`, a generator: its state struct
            // and `Iterator` impl are synthesised when that call is lowered, so
            // there is nothing named to pre-register here.
            found :: array_into_member(ctx, arg_type, target_type)
            if found == null { return mk_bare_into_call(ctx, arg, target_type, span) }
            return call_into_member(ctx, found, arg, arg_type, target_type, span)
        }
    }
    return null
}

// The `into` member an `array` converts toward `target` through : the one the
// typechecker judged the conversion by (`into_method_toward`), never another
// `Into` of the same array (`MonType[] implements Into<Label>`).
array_into_member :: fn(ctx: FnLowerCtx, array: Type, target: Type) -> ImplMemberMatch | null {
    chosen :: into_method_toward(ctx.typed, array, target) ?? return null
    candidates :: ctx.project.impls.impls_for(array, core_trait_key(TRAIT_INTO))
    return impl_declaring(candidates, chosen)
}

// `into(arg)` through the member `found` names, mangled as its materialiser names
// it for `source`.
call_into_member :: fn(
    ctx: FnLowerCtx,
    found: ImplMemberMatch,
    arg: LoweredExpr,
    source: Type,
    target: Type,
    span: Span,
) -> LoweredExpr! {
    name :: type_surface_name(source)
    member :: build_ufcs_member(ctx, source, name, found.member, found.entry, false)
    return mk_lowered_call(member.symbol, [arg], target, span)
}

// Among `candidates`, the impl declaring the member the typechecker chose.
impl_declaring :: fn(candidates: ImplEntry[], chosen: ImplMethod) -> ImplMemberMatch | null {
    member :: chosen.decl ?? return null
    for entry in candidates {
        for m in entry.decl.members {
            if m.span == member.span {
                return ImplMemberMatch { .entry = entry, .member = m }
            }
        }
    }
    return null
}

/// `Target(value)` where `value : Source` and `Source implements Into<Target>`
/// emits `LoweredCall { callee: into, args: [value] }`.
try_emit_into_coercion :: fn(
    ctx: FnLowerCtx, arg: LoweredExpr, arg_type: Type, target_type: Type, span: Span,
) -> LoweredExpr! | null {
    // An array into an `Iterator` finds its `into` by the target's base too : core's
    // generic impl has no exact pair for the scan below to find.
    array_iter :: try_array_iter_coercion(ctx, arg, arg_type, target_type, span)
    if array_iter != null { return array_iter }
    src_name :: type_surface_name(arg_type)
    if src_name == "" { return null }
    // Identity-coercion guard : `T(value)` where `value: T` is a no-op
    // ; never inject `into(self)` against the surrounding type.
    if equals_type(arg_type, target_type) { return null }
    // Representation-unwrap guard : `P(value)` where `value : X` and `X :: P`
    // EXTRACTS the backing, it does not convert — the two share a repr, so there
    // is nothing to run. Without this, a newtype that implements `Into<P>` cannot
    // be written at all: the body has no other way to reach its representation,
    // so `P(self)` lifts to `into(self)` and recurses until the stack goes.
    if arg_type is DistinctType {
        if equals_type(arg_type.backing, target_type) {
            return null
        }
    }
    // The typechecker chose the `into` member when it accepted the coercion ;
    // find its impl rather than choosing again. The registry answers first :
    // most coerced types have no `Into` impl, and the typechecker's key builds
    // both types' full keys.
    candidates :: ctx.project.impls.impls_for(arg_type, core_trait_key(TRAIT_INTO))
    if candidates.len() == 0 { return null }
    chosen :: into_impl_method(ctx.typed, arg_type, target_type) ?? return null
    found :: impl_declaring(candidates, chosen) ?? return null
    entry :: found.entry
    m :: found.member
    // Resolve to the impl member's materialised mangle so emit binds the call — the
    // bare `into` placeholder resolves to neither symbol id nor mangle. A generic
    // impl's member is mangled per erased instance, which this path does not build.
    if entry.is_generic { return mk_bare_into_call(ctx, arg, target_type, span) }
    // An impl on one instance (`Wrapper<MonType>`, `MonType[]`) is materialised per
    // instance ; `build_ufcs_member` names it as the materialiser does and records an
    // array's element.
    if entry.instance {
        return call_into_member(ctx, found, arg, arg_type, target_type, span)
    }
    // The mangle mirrors `impl_member_mangled` (the materialiser's own fn in
    // `lower_impl_member_list`), overload suffix included.
    decl :: entry.decl
    suffix :: entry.overload_suffix
    mangled :: "${mangle_module_id(entry.module)}$${src_name}$${decl.trait_name}$${m.name}${suffix}"
    ctx.project.referenced_impl_mangles.add(mangled)
    note_member_origin(ctx, mangled, m, entry.trait_key)
    return mk_into_call(arg, target_type, span, mangled, entry.module)
}
