// vader/lower/dump/dump: `# Lower` snapshot dump.
//
// Walks every in-scope `LoweredModule`, module ids sorted alphabetically, and
// renders its storage, its declarations as Vader (`body.vader`) and its
// vtable rows ; then what the lowering materialised in the other modules
// (`decisions.vader`). A declaration prints under its qualified name
// (`names.vader`), its mangled name in a trailing comment :
//
//   # Lower
//
//   ## <module display path>
//     storage
//       const <name>: <type>  <inline | accessor <fn> | data pool #k[, element 0]>
//       global #<slot> <type>  <name>
//     <name> :: fn(<params>) -> <type> {  // <mangled>
//         <one statement per line>
//     }
//     <name> :: struct { <field>: <type>, … }  // <mangled>
//     <name>: <type>: <value>  // <mangled>
//     vtable <trait>.<method> for <type>  <fn>
//
//   ## lowered in dependencies
//     <module display path>
//       <storage lines>
//       fn <name>  // <mangled>
//       struct <name>  // <mangled>

module "vader/lower/dump"

import "std/collections"
import "std/sort"
import "std/string"
import "vader/core/types"
import "vader/front/resolver"
import "vader/front/typecheck"
import "vader/lower/ir"
import "vader/support/text"

/// Render the project's `# Lower` dump as a single string. Only modules in
/// `scope` are rendered in full (the entry's subtree by default, `--module` to
/// widen) ; of the others, the dump names what the lowering materialised.
///
/// @param project  the lowered project.
/// @param typed    the typed project it was lowered from, which names its declarations.
/// @param scope    in-scope module ids / prefixes (see `module_in_scope`).
/// @return         the formatted dump (no trailing newline).
export dump_lowered :: fn(project: LoweredProject, typed: TypedProject, scope: string[]) -> string {
    lines: string[]: []
    lines.push("# Lower")
    dependencies: string[]: []
    names :: new_dump_names(project, typed)
    for module_id in sort(project.modules.keys(), compare_ascending) {
        module :: project.modules[module_id] ?? continue
        if !module_in_scope(module.display_path, scope) {
            lowered :: dependency_lines(names, project, module)
            if lowered.len() > 0 {
                dependencies.push("  ${module.display_path}")
                push_indented(dependencies, lowered, "    ")
            }
            continue
        }
        lines.push("")
        lines.push("## ${module.display_path}")
        storage :: storage_lines(project, module_id)
        if storage.len() > 0 {
            lines.push("  storage")
            push_indented(lines, storage, "    ")
        }
        for decl in module.decls {
            emit_decl(names, lines, decl, "  ")
        }
        push_indented(lines, vtable_lines(names, module), "  ")
    }
    if dependencies.len() > 0 {
        lines.push("")
        lines.push("## lowered in dependencies")
        lines.push_all(dependencies)
    }
    return lines.join("\n")
}

push_indented :: fn(lines: string[], items: string[], indent: string) -> void {
    for item in items {
        lines.push("${indent}${item}")
    }
}

emit_decl :: fn(names: DumpNames, lines: string[], decl: LoweredDecl, indent: string) -> void {
    match decl {
        is LoweredFnDecl -> {
            emit_fn(names, lines, decl, indent)
        }
        is LoweredStructDecl -> {
            fields :: "struct ${fields_text(decl.fields)}"
            lines.push("${indent}${declared_text(names, decl.mangled)} :: ${fields}"
                + mangle_comment(names, decl.mangled))
        }
        is LoweredConstDecl -> {
            declared :: "${declared_text(names, decl.mangled)}: ${display_type(decl.type)}"
            value :: slot_value_text(names, decl.value, decl.type, indent)
            lines.push("${indent}${declared}: ${value}${mangle_comment(names, decl.mangled)}")
        }
    }
}

// A function without a body (`@extern`, `@intrinsic`) prints its signature alone.
emit_fn :: fn(names: DumpNames, lines: string[], decl: LoweredFnDecl, indent: string) -> void {
    signature :: "fn(${params_text(decl.params)}) -> ${display_type(decl.return_type)}"
    head :: "${indent}${declared_text(names, decl.mangled)} :: ${signature}"
    comment :: mangle_comment(names, decl.mangled)
    body :: decl.body
    if body == null {
        lines.push("${head}${comment}")
        return
    }
    lines.push("${head} {${comment}")
    emit_body(names, lines, body, "${indent}${INDENT_STEP}")
    lines.push("${indent}}")
}

params_text :: fn(params: LoweredParam[]) -> string {
    shown: string[]: []
    for param in params {
        shown.push("${param.name}: ${display_type(param.type)}")
    }
    return shown.join(", ")
}

fields_text :: fn(fields: LoweredStructField[]) -> string {
    if fields.len() == 0 {
        return "{}"
    }
    shown: string[]: []
    for field in fields {
        shown.push("${field.name}: ${display_type(field.type)}")
    }
    return "{ ${shown.join(", ")} }"
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_dump_empty_project_header_only :: fn() -> void {
    project :: empty_test_project()
    assert_eq(dump_lowered(project, new_typed_project(FreshReads {}), []), "# Lower")
}

empty_test_project :: fn() -> LoweredProject {
    return new_lowered_project()
}
