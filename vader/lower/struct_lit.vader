// vader/lower/struct_lit: struct / tuple / array literals and enum-variant folding.
//

module "vader/lower"

import "std/collections"
import "std/iter"
import "vader/lower/ir"

import "toolchain/ast"
import "vader/support/diagnostics"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/typecheck"
import "toolchain/span"
import "std/abort"

lower_struct_lit :: fn(ctx: FnLowerCtx, lit: StructLitExpr, type: Type) -> LoweredExpr {
    // Index the literal's provided values by name so we can walk the
    // struct decl in declaration order ; this yields a canonical field
    // ordering even when the source literal reorders
    // fields or omits ones with defaults.
    provided :: Map<string, Expr> {}
    // Bind each `...spread` source to a synthetic temp so it's
    // evaluated exactly once even when several fields inherit from it.
    // An omitted field reads from the last source that holds it.
    spread_stmts: LoweredStmt[]: []
    spreads: LiteralSpread[] | null = null
    for item in lit.items {
        match item {
            is StructLitField -> { provided[item.name] = item.value }
            is StructLitSpread -> {
                value :: lower_expr(ctx, item.expr)
                spread :: literal_spread(ctx, type, fresh_synthetic_symbol(ctx, "spread"), value)
                spreads = with_spread(spreads, spread)
                spread_stmts.push(
                    LoweredLet {
                        .span = item.span,
                        .name = spread.symbol.name,
                        .symbol = spread.symbol,
                        .type = spread.type,
                        .value = value,
                    },
                )
            }
        }
    }
    fields :: build_struct_lit_fields(ctx, type, provided, lit, spreads)
    return with_prelude(spread_stmts, new_struct_lit(ctx, type, fields, lit.span), lit.span)
}

// A `...spread` of a struct literal, its source bound to a temp.
LiteralSpread :: struct {
    symbol: Symbol
    /// The type of the temp : the literal's, or that of the base the source is.
    type: Type
    /// The fields of the base the source is ; null when the source is of the
    /// literal's struct and holds every field.
    fields: Map<string, StructFieldInfo> | null
}

// The spread of a literal of `type` whose source `value` is bound to `symbol`.
literal_spread :: fn(ctx: FnLowerCtx, type: Type, symbol: Symbol, value: LoweredExpr) -> LiteralSpread {
    source :: struct_backing(value.type)
    literal :: struct_backing(type)
    if source == null || literal == null || source.symbol.id == literal.symbol.id {
        return LiteralSpread { .symbol = symbol, .type = type, .fields = null }
    }
    return LiteralSpread {
        .symbol = symbol,
        .type = value.type,
        .fields = ctx.typed.struct_fields[source.symbol.id]
            ?? panic("lower: no fields recorded for `${source.symbol.name}`"),
    }
}

// `spreads` with `spread` last : the list is made at the first spread of a literal.
with_spread :: fn(spreads: LiteralSpread[] | null, spread: LiteralSpread) -> LiteralSpread[] {
    if spreads == null {
        return [spread]
    }
    spreads.push(spread)
    return spreads
}

// The last of `spreads` whose source holds the field `name`, null when none does.
last_spread_holding :: fn(spreads: LiteralSpread[] | null, name: string) -> LiteralSpread | null {
    listed :: spreads ?? return null
    found: LiteralSpread | null = null
    for spread in listed {
        fields :: spread.fields
        if fields == null || name in fields {
            found = spread
        }
    }
    return found
}

// The literal of a value of struct `type`. Every literal of a declared struct is
// built here: its construction is noted (`note_construction`) and its tag erased
// (`erase_generic_struct_tag`), both from the concrete `type`.
new_struct_lit :: fn(
    ctx: FnLowerCtx, type: Type, fields: LoweredStructLitField[], span: Span,
) -> LoweredStructLit {
    note_construction(ctx, type)
    // Reconcile the box's runtime type-index with the trait-impl vtable's receiver
    // key. `materialize_impl_for_instance` registers a generic impl's vtable row
    // under the REF-ERASED self (`Ready<Boom>` → `Ready<Any>`, via
    // `keep_concrete_or_erase`) so every ref-arg instance shares one row ; a
    // NON-generic construction site would otherwise mint the CONCRETE tag
    // (`Ready<Boom>`): identical layout, divergent tag → `vtable miss`. Inside a
    // generic fn body the carried subst already erases the lit's type to
    // `Ready<Any>` ; this generalises that same erasure to the non-generic site.
    // Primitive args stay concrete (`Ready<i32>` unchanged) so their devirtualised
    // dispatch is preserved.
    box_type :: erase_generic_struct_tag(ctx, type)
    return LoweredStructLit {
        .span = span,
        .type = box_type,
        .fields = fields,
    }
}

// Record that `type` is constructed: its generic instance for the impl fixpoint,
// its symbol for the vtable members of a stdlib struct.
//
// A value whose generic instance is not queued has no impl members, and a virtual
// call on it (`for`, `collect`, `count` dispatching `next`) misses its vtable row
// at run time.
note_construction :: fn(ctx: FnLowerCtx, type: Type) -> void {
    // `struct_backing` unwraps a struct-backed distinct newtype (`Color :: Rgb`)
    // so the construction still registers against the backing struct symbol.
    st_backing :: struct_backing(type)
    if st_backing != null {
        if !st_backing.args.is_empty() { queue_generic_impl_receiver(ctx, st_backing) }
        // Record the construction so `surface_stdlib_impl_externs` can surface a
        // NON-generic stdlib struct's vtable members only when the struct is
        // actually built (`StringChars` via `chars()`), not for every snippet
        // that merely virtually dispatches its trait.
        ctx.project.constructed_struct_symbols.add(st_backing.symbol.id)
    }
}

// Erase a generic struct instance's runtime TAG exactly as
// `materialize_impl_for_instance` erases the impl self : keep every argument
// `kept_argument` keeps, collapse every other ref arg to `Any`
// (`build_mixed_args_list`, the shared kernel). So `Ready<Boom>` and
// `Ready<User>` intern to the single `Ready<Any>` tag the erased vtable row is
// keyed on, while `Ready<i32>` stays concrete
// (devirtualised dispatch preserved). A non-generic struct (no args), and any
// non-struct type, is returned verbatim ; the empty-args guard also skips the
// allocation on the common non-generic literal. The box LAYOUT is already
// ref-erased upstream, so this only touches the identity tag.
//
// The tag/vtable-key agreement funnels through `type_intern_key` (context-free,
// keys faithfully on args) : erasure can't live there because the decision is
// context-dependent (which arguments are kept depends on the project's impls), so
// the lowering layer owns it.
erase_generic_struct_tag :: fn(ctx: FnLowerCtx, t: Type) -> Type {
    if t is StructType {
        if t.args.is_empty() { return t }
        return mk_struct(t.symbol, build_mixed_args_list(ctx.project.impls, t.args))
    }
    return t
}


// `.North` resolves through context : the surrounding slot's expected
// type pins the enum. Look up the variant's integer index off the
// resolved `EnumType` and emit a `LoweredIntLit`. Falls back to a
// stub when the context isn't an enum (defensive: earlier
// diagnostics should have caught the bad use).
lower_dot_variant :: fn(ctx: FnLowerCtx, expr: DotVariantExpr, type: Type) -> LoweredExpr {
    resolved :: enum_type_or_unwrap(ctx, type)
    // @partial: only EnumType carries variant indices; every other Type is a
    // non-enum context here → stub (earlier diagnostics apply).
    @partial match resolved {
        is EnumType -> {
            index :: resolved.indices[expr.variant] ?? return unknown_variant(expr, resolved, type)
            return LoweredIntLit { .span = expr.span, .type = resolved, .value = index }
        }
        _ -> { return stub(expr.span, type, "`.${expr.variant}` against non-enum context type") }
    }
}

// A stub for `expr`, a variant `enum_type` does not have.
unknown_variant :: fn(expr: DotVariantExpr, enum_type: EnumType, type: Type) -> LoweredExpr =
    stub(expr.span, type, "unknown variant `${expr.variant}` on `${enum_type.symbol.name}`")

// A field access on an enum-typed receiver : `v.field` the typecheck recorded
// as a variant-data read (`enum_data_reads`) reads its table slot, and any
// other access names a variant and folds to its integer. Null for anything
// else ; the caller falls back to a regular field access.
try_lower_enum_field :: fn(ctx: FnLowerCtx, expr: FieldExpr, type: Type) -> LoweredExpr | null {
    enum_type :: enum_type_or_unwrap(ctx, ctx.types.expr_type(expr.target))
    // Keep this check ahead of the table : a speculative typecheck walk (an
    // overload candidate that lost) can leave a stale entry for a receiver the
    // final walk typed as something else.
    if enum_type !is EnumType {
        return null
    }
    if ctx.typed.enum_data_reads[expr.id] != null {
        slot :: lower_enum_data_slot(ctx, lower_expr(ctx, expr.target), enum_type, expr.span)
        return LoweredFieldAccess {
            .span = expr.span, .type = type, .target = slot, .field = expr.field,
        }
    }
    index :: enum_type.indices[expr.field] ?? return null
    return LoweredIntLit { .span = expr.span, .type = enum_type, .value = index }
}

// Resolve `expr` to its namespace import-binding symbol when it is the bare
// alias ident of a `<alias>.<member>` access (kind `ImportBinding`) ; null
// otherwise. Shared by the namespace member lowerings (calls, reads), each
// passing the receiver of the member access.
as_namespace_binding :: fn(ctx: FnLowerCtx, expr: Expr) -> Symbol | null {
    ident :: as_ident(expr) ?? return null
    sym :: resolve_ident(ctx, ident.span) ?? return null
    if sym.kind == .ImportBinding { return sym }
    return null
}

// Unwrap the StructType-as-Enum placeholder if needed (same trick as
// `lower_match::unwrap_enum_type`).
enum_type_or_unwrap :: fn(ctx: FnLowerCtx, type: Type) -> Type {
    // @partial: only an EnumType or an enum-kind StructType placeholder needs
    // unwrapping; every other Type is returned verbatim.
    @partial match type {
        is EnumType -> { return type }
        is StructType -> {
            if type.symbol.kind != .Enum { return type }
            real :: ctx.typed.decl_types[type.symbol.id]
            if real is EnumType { return real }
            return type
        }
        _ -> { return type }
    }
}

// Return a `FnLowerCtx` whose `typed` / `types` view belongs to `module_id`,
// so an AST expr that originated in that module (a struct field DEFAULT from a
// foreign struct decl) resolves its idents / expr-types against the right
// module's tables instead of the construction site's. No-op (returns `ctx`)
// when the module isn't in the project's typed set.
ctx_in_owning_module :: fn(ctx: FnLowerCtx, module_id: string, decl: StructDecl, args: Type[]) -> FnLowerCtx {
    owner_typed :: ctx.project.evaluated.typed.modules[module_id] ?? return ctx
    // Thread the instance's type-args into the subst so a field DEFAULT that
    // references the struct's own type-param (`ekeys: K[] = []`) lowers with `K`
    // bound to the concrete instance arg: MIXED (primitive → concrete so the
    // array lands RAW, ref → `Any`), matching the instance's mixed field layout
    // (`build_mixed_subst`). Without this the default lowers in the owner's
    // ERASED view (`K = Any` → boxed array) while the construction + later usage
    // are monomorphised (`K = i32` → raw): a box-vs-raw representation mismatch
    // that silently corrupts the struct cross-module.
    own_args :: build_mixed_subst(ctx.project.impls, decl.type_params, args, owner_typed)
    merged :: merge_subst(ctx.subst, own_args)
    ensure_closure_analysis(ctx.project, owner_typed)
    return FnLowerCtx {
        ...ctx,
        .typed = owner_typed,
        .types = make_entry_types(owner_typed, merged),
        .subst = merged,
        .instance = null,
        .jump_frames = [],
    }
}

build_struct_lit_fields :: fn(
    ctx: FnLowerCtx, type: Type,
    provided: Map<string, Expr>, lit: StructLitExpr,
    spreads: LiteralSpread[] | null,
) -> LoweredStructLitField[] {
    out: LoweredStructLitField[]: []
    // `struct_backing` unwraps a struct-backed distinct newtype so declared-order
    // field building walks the backing struct's fields. A non-struct type (or a
    // struct with no recorded fields) degrades to source order (defensive
    // fallback).
    st :: struct_backing(type) ?? return fallback_provided_order(ctx, lit)
    fields :: ctx.typed.struct_fields[st.symbol.id] ?? return fallback_provided_order(ctx, lit)
    site: DefaultSite | null = null
    for [_, field] in fields {
        field_decl :: field.decl
        field_type :: literal_field_type(ctx, st, field_decl)
        user_value :: provided[field_decl.name]
        if user_value is null {
            // Omitted field : inherit from the last `...spread`
            // source that holds it via a field access, else fall back to the
            // declared default.
            spread :: last_spread_holding(spreads, field_decl.name)
            if spread != null {
                out.push(
                    LoweredStructLitField {
                        .name = field_decl.name,
                        .value = LoweredFieldAccess {
                            .span = lit.span,
                            .type = field_type,
                            .target = LoweredIdent {
                                .span = lit.span,
                                .type = spread.type,
                                .symbol = spread.symbol,
                            },
                            .field = field_decl.name,
                        },
                    },
                )
                continue
            }
            // A field DEFAULT (`id: i64 = UNASSIGNED_NODE_ID`) is an AST expr from
            // the module of the struct that writes the field: its idents resolve
            // against that module's `resolved.idents`, not the construction site's.
            default :: field_decl.default
            if default != null {
                current :: default_site(ctx, st, field, site)
                site = current
                out.push(LoweredStructLitField {
                    .name = field_decl.name,
                    .value = lower_field_default(current, field_decl, default, field_type),
                })
            }
        } else {
            value :: lower_for_slot(ctx, user_value, field_type, user_value.span)
            out.push(LoweredStructLitField { .name = field_decl.name, .value = value })
        }
    }
    return out
}

// A literal's field type : its declaration's, through the entry's substitution.
literal_field_type :: fn(ctx: FnLowerCtx, st: StructType, field: StructField) -> Type =
    ctx.types.apply(declared_field_type(ctx.typed, st.symbol, field.name))

// Build a `LoweredStructLit` for a compiler-SYNTHESISED construction of a
// stdlib/core struct (Range, Field, …), ordering the
// provided already-lowered fields by the struct's DECLARATION order instead of
// trusting the call site to hand-match it. midir consumes struct-lit fields
// positionally (`build_struct_lit` / `InstrStructNew` ignore the `.name`
// label), so a stdlib field reorder would otherwise silently write the wrong
// slot while the `.name` labels look safe. This binds the order to the declared
// fields, exactly like user literals go through `build_struct_lit_fields`.
//
// A field the site does not provide takes its declared default, as in a user
// literal, so a defaulted field can join a core struct without its synthesising
// site naming it. Panics on an unrecorded struct or a declared field with
// neither a value nor a default: both are compiler invariants for a
// synthesised build (fail loud, never a silent wrong-slot write).
build_core_struct_lit :: fn(ctx: FnLowerCtx, type: Type, fields: LoweredStructLitField[], span: Span) -> LoweredExpr {
    st :: struct_backing(type)
    if st == null {
        panic("build_core_struct_lit: not a struct type")
    }
    declared :: ctx.typed.struct_fields[st.symbol.id]
        ?? panic("build_core_struct_lit: struct fields not indexed for ${st.symbol.name}")
    ordered: LoweredStructLitField[]: []
    site: DefaultSite | null = null
    for [_, field] in declared {
        field_decl :: field.decl
        provided :: find_lowered_field(fields, field_decl.name)
        if provided != null {
            ordered.push(provided)
            continue
        }
        default :: field_decl.default
        if default == null {
            panic("build_core_struct_lit: missing field `${field_decl.name}` for ${st.symbol.name}")
        }
        current :: default_site(ctx, st, field, site)
        site = current
        field_type :: literal_field_type(ctx, st, field_decl)
        ordered.push(
            LoweredStructLitField {
                .name = field_decl.name,
                .value = lower_field_default(current, field_decl, default, field_type),
            },
        )
    }
    return new_struct_lit(ctx, type, ordered, span)
}

// Linear lookup of a provided field by name: synthesised core structs have
// only a handful of fields, so no map is warranted.
find_lowered_field :: fn(fields: LoweredStructLitField[], name: string) -> LoweredStructLitField | null {
    for f in fields {
        if f.name == name {
            return f
        }
    }
    return null
}

// Defensive fallback : when the struct decl can't be reached, emit
// fields in source order (the previous behaviour).
fallback_provided_order :: fn(ctx: FnLowerCtx, lit: StructLitExpr) -> LoweredStructLitField[] {
    out: LoweredStructLitField[]: []
    for item in lit.items {
        match item {
            is StructLitField -> {
                value :: lower_expr(ctx, item.value)
                out.push(LoweredStructLitField { .name = item.name, .value = value })
            }
            is StructLitSpread -> {}
        }
    }
    return out
}

lower_seq_lit :: fn(ctx: FnLowerCtx, lit: SeqLitExpr, type: Type) -> LoweredExpr {
    // Tuples share the parser shape `[a, b, c]` with arrays: disambiguate
    // by the resolved type. Tuple-typed literals (and tuple-backed distinct
    // newtypes, via `tuple_backing`) become struct lits with synthetic
    // `_0` / `_1` / ... fields ; the bytecode emit reads them off the same
    // struct layout the typer pins (distinct wrappers strip at the emit boundary).
    elements :: lower_in_order(ctx, lit.elements)
    tuple :: tuple_backing(type)
    if tuple != null {
        fields: LoweredStructLitField[]: []
        for i in 0..<elements.len() {
            surface_array_into_trait(ctx, elements[i].type, tuple.elements[i])
            fields.push(LoweredStructLitField { .name = "_${i}", .value = elements[i] })
        }
        return LoweredStructLit { .span = lit.span, .type = type, .fields = fields }
    }
    element_slot :: array_element_type(type)
    for e in elements {
        surface_array_into_trait(ctx, e.type, element_slot)
    }
    return LoweredArrayLit { .span = lit.span, .type = type, .elements = elements }
}
