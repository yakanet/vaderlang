// vader/lower/range — `a..<b` / `a..=b` range lowering.
//
// Desugars an
// `AST.RangeExpr` into a `Range { .start, .end, .inclusive, .cursor }`
// struct literal so for-in can dispatch through the standard Iterator
// impl rather than a bespoke fast path.
//
// The struct's symbol comes from the project context's
// `core_symbols["Range"]` cache. When `std/core` isn't reachable, the
// lowered shape falls back to a `LoweredUnreachable` carrying the
// reason — same defensive shape every other "deferred" lowerer uses.

module "vader/lower"

import "vader/support/diagnostics"
import "toolchain/ast"
import "vader/resolver/symbol"
import "vader/types"

/// Lower a `RangeExpr` into a `Range` struct literal.
/// @param ctx          the fn-body context.
/// @param expr         the source range.
/// @param result_type  the surrounding context's expected type.
/// @return             the lowered struct literal (or unreachable on miss).
lower_range_expr :: fn(ctx: FnLowerCtx, expr: RangeExpr, result_type: Type) -> LoweredExpr {
    range_symbol :: ctx.project.core_symbols[STRUCT_RANGE]
    match range_symbol {
        is null -> {
            return LoweredUnreachable {
                .span = expr.span, .type = result_type,
                .reason = "`std/core::Range` not reachable — cannot lower range expression",
            }
        }
        is Symbol -> {
            if range_symbol.kind != .Struct {
                return LoweredUnreachable {
                    .span = expr.span, .type = result_type,
                    .reason = "`std/core::Range` resolved to a non-struct symbol",
                }
            }
            return build_range_lit(ctx, expr, result_type)
        }
    }
}

build_range_lit :: fn(ctx: FnLowerCtx, expr: RangeExpr, result_type: Type) -> LoweredExpr {
    span :: expr.span
    // `start` and `cursor` both take the lower bound, which is evaluated once.
    stmts: LoweredStmt[]: []
    lower_value :: lower_expr(ctx, expr.lower)
    mark :: ctx.pending_awaits.len()
    upper_bound :: lower_expr(ctx, expr.upper)
    kept_lower :: bind_one_before_hoisted(ctx, lower_value, mark)
    lower_bound :: bind_unless_stable(ctx, kept_lower, "range_lo", span, stmts)
    inclusive :: LoweredBoolLit { .span = span, .type = TY_BOOL, .value = expr.inclusive }
    fields :: [
        LoweredStructLitField { .name = "start",     .value = lower_bound },
        LoweredStructLitField { .name = "end",       .value = upper_bound },
        LoweredStructLitField { .name = "inclusive", .value = inclusive },
        LoweredStructLitField { .name = "cursor",    .value = lower_bound },
    ]
    return with_prelude(stmts, build_core_struct_lit(ctx, result_type, fields, span), span)
}

// End-to-end tests for `lower_range_expr` need a wired-up
// `FnLowerCtx` that the lowerer can thread through ; the test
// scaffolding to build one stub-free without dragging in the resolver
// + typechecker is more code than the function under test. The
// behaviour is exercised by the snippet harness via the range fixtures
// (e.g. `tests/snippets/for_range`).
