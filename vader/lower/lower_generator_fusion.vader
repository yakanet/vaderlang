// vader/lower/lower_generator_fusion — inline a consumed `generator` body into the
// chain that consumes it.
//
// A generator call fuses one of two ways, decided by the shape of its body, never
// by its name:
//   - a COMBINATOR (`map`, `filter`, `chain`, … — a body whose root loops iterate
//     its source params) is a chain LAYER: its source loop fuses with the source
//     beneath it, and its inner body runs per element (`try_descend_gen_combinator`) ;
//   - any other generator is a chain SOURCE: its whole body is inlined at the
//     bottom of the chain, each `yield` feeding the stage above
//     (`try_descend_gen_source`) — `for v in gen(args)` is the one-stage case.
// Either way the body lowers in its own ctx — its module, its instance
// substitution, its `GenInstance` names — with the consumer installed as the
// `yield` sink: no state-machine struct, no boxed `Iterator`, no virtual `next()`.

module "vader/lower"

import "std/collections"
import "vader/diagnostics"
AST :: import "toolchain/ast"
import "vader/resolver/symbol"
import "vader/types"
import "vader/typecheck"
import "toolchain/span"

// The yielded element type for a `generator` fn, from the typecheck-side
// registry (`register_generator_iter_impls`) substituted by the call's instance
// subst. Null when the fn isn't registered (declines fusion). Shared by the
// direct-call and combinator fusion sites.
genstate_element :: fn(typed: TypedProgram, fn_name: string, subst: Substitution) -> Type | null {
    raw :: typed.iter_element_types[gen_state_name(fn_name)] ?? return null
    return substitute(raw, subst)
}

// Build the yield sink for a generator inlined into a `for` consumer. For a
// plain `for x in <gen>` the sink binds the single consumer variable. For a
// `for [k, v] in <gen>` destructure the sink binds a fresh element temp and the
// `let [k, v] := <temp>` destructure is baked into the FRONT of the consumer
// body — lowered HERE, in the consumer's `ctx`, where the pattern leaves (k, v)
// resolve. (Doing it at yield time would splice into the generator's own ctx,
// where those leaf symbols don't resolve — the destructure would silently drop.)
build_gen_sink :: fn(
    ctx: FnLowerCtx!, pattern: AST.LetBinding | null,
    binding_symbol: Symbol, binding_name: string,
    element_type: Type, body: LoweredBlock, span: Span,
) -> GenInlineSink {
    if pattern is AST.TupleBinding {
        elem_sym :: fresh_synthetic_symbol(ctx, "gen_elem")
        destructure :: emit_for_pattern_destructure(ctx, pattern, elem_sym, element_type, span)
        return GenInlineSink {
            .binding_symbol = elem_sym,
            .binding_name = elem_sym.name,
            .element_type = element_type,
            .body = prepend_stmts_to_block(destructure, body),
        }
    }
    return GenInlineSink {
        .binding_symbol = binding_symbol,
        .binding_name = binding_name,
        .element_type = element_type,
        .body = body,
    }
}

// The generator's owning-module typed program: `ctx.typed` when the call is
// same-module, else the project table. Null when the module isn't loaded.
resolve_owner_typed :: fn(ctx: FnLowerCtx, module: string) -> TypedProgram | null {
    if module == ctx.typed.resolved.path { return ctx.typed }
    m :: ctx.project.typed.modules[module]
    if m is TypedProgram { return m }
    return null
}

/// A call's callee — its symbol, module and declaration — and its arguments in
/// parameter order, a UFCS receiver first.
CallTarget :: struct {
    callee: Symbol
    owner:  TypedProgram
    decl:   AST.FnDecl
    args:   AST.Expr[]
}

// The target of `f(args)` or `recv.f(args)` ; null for any other callee shape, a
// callee with no declaration in a loaded module, or one the arguments do not
// fill parameter for parameter.
call_target :: fn(ctx: FnLowerCtx, call: AST.CallExpr) -> CallTarget | null {
    callee :: combinator_effective_callee(call.callee)
    if callee is AST.FieldExpr {
        if ctx.typed.ufcs_receiver_types[callee.id] == null {
            return null
        }
    } else if callee !is AST.IdentExpr {
        return null
    }
    symbol :: callee_symbol(ctx, call, callee) ?? return null
    owner :: resolve_owner_typed(ctx, symbol.module) ?? return null
    decl :: owner.fn_decls[symbol.id] ?? return null
    args: AST.Expr[]!: []
    if callee is AST.FieldExpr {
        args.push(callee.target)
    }
    for a in call.args {
        args.push(a.value)
    }
    if decl.params.len() != args.len() {
        return null
    }
    return CallTarget {
        .callee = symbol,
        .owner = owner,
        .decl = decl,
        .args = args,
    }
}

// The symbol `callee` names: a UFCS callee resolves through its receiver, an
// ident through itself — to the overload typecheck picked, when it is not the
// first one, which is the one the resolver binds an overloaded name to.
callee_symbol :: fn(ctx: FnLowerCtx, call: AST.CallExpr, callee: AST.Expr) -> Symbol | null {
    if callee is AST.IdentExpr {
        if ctx.typed.overload_result_callees[callee.id] != null {
            picked :: ctx.types.expr_type(callee)
            if picked is FnType {
                return find_picked_overload_symbol(ctx, callee.name, picked)
            }
            return null
        }
    }
    receiver :: if callee is AST.FieldExpr { callee.target } else { callee }
    return combinator_callee_sym(ctx, call, receiver)
}

// The declared signature of `callee`, null when typecheck recorded none.
fn_signature :: fn(owner: TypedProgram, callee: Symbol) -> FnType | null {
    t :: owner.decl_types[callee.id]
    if t is FnType {
        return t
    }
    return null
}

// `decl`'s type parameters as the resolver bound them, in declaration order ;
// null when one has no symbol.
declared_type_params :: fn(decl: AST.FnDecl, owner: TypedProgram) -> Symbol[] | null {
    out: Symbol[]!: []
    for tp in decl.type_params {
        out.push(find_type_param_in_resolved(owner.resolved, tp.name, tp.span) ?? return null)
    }
    return out
}

// The binding of each of `type_params`, listed as they are, once each pattern is
// unified with its actual in order — the first binding of a parameter wins ;
// null when one stays unbound.
unify_type_args :: fn(ctx: FnLowerCtx, patterns: Type[], actuals: Type[], type_params: Symbol[]) -> Type[] | null {
    bindings :: MutableMap<i32, Type> {}
    order: i32[]!: []
    for k in 0..<patterns.len() {
        unify_params(patterns[k], actuals[k], bindings, order, ctx)
    }
    out: Type[]!: []
    for tp in type_params {
        out.push(bindings[tp.id] ?? return null)
    }
    return out
}

// `value` bound to `instance`'s clone of the parameter `p` — the symbol the
// inlined body reads.
bind_instance_param :: fn(
    ctx: FnLowerCtx!, instance: GenInstance, owner: TypedProgram, p: AST.FnParam, value: LoweredExpr,
    slot: Type,
) -> LoweredStmt {
    symbol :: lookup_local_symbol(ctx.project, owner.resolved, p.span) ?? panic(
        "inlined call: parameter `${p.name}` has no symbol",
    )
    return cell_aware_let(ctx, clone_of(instance, symbol), p.name, value, slot, p.span)
}

// The ctx a body inlined as `instance` lowers under: its module, its instance
// substitution and its instance's names.
instance_ctx :: fn(
    ctx: FnLowerCtx!, decl: AST.FnDecl, owner: TypedProgram, subst: Substitution, instance: GenInstance!,
) -> FnLowerCtx! {
    return_type :: substitute(return_type_of(decl, make_entry_types(owner, subst)), subst)
    inner :: new_fn_lower_ctx(ctx.project, stub_entry(decl, owner), owner, subst, return_type)
    inner.instance = instance
    return inner
}

// `body` lowered under `inner`, an instance's ctx. Meanwhile the instance's
// callee counts as being inlined, so it is not inlined again from inside itself.
lower_instance_body :: fn(ctx: FnLowerCtx!, inner: FnLowerCtx!, body: AST.BlockExpr) -> LoweredBlock {
    instance :: inner.instance ?? panic("an instance body lowered with no instance")
    entered :: ctx.project.inlining_generators.add(instance.generator_id)
    lowered :: lower_block(inner, body, false, null)
    if entered {
        ctx.project.inlining_generators.remove(instance.generator_id)
    }
    return lowered
}

// Strip distinct wrappers off `args`, require all-concrete, then bind each type
// parameter to its argument — the shared tail of every generator subst. Concrete
// whatever the arguments: an inlined body is never shared, so erasing its
// references would only lose the types its values have. Null when an argument
// stays a free type parameter (the caller bails to the boxed path).
subst_from_concrete :: fn(fn_decl: AST.FnDecl, owner_typed: TypedProgram, args: Type[]) -> Substitution | null {
    concrete :: strip_distinct_each(args)
    if !all_concrete(concrete) { return null }
    return build_fn_concrete_subst(fn_decl, owner_typed, concrete)
}

// ---- chained generator combinators (Increment 3) --------------------------
//
// A generator whose FIRST param is the source iterator — `map`/`filter`
// (`generator fn<T, U>(self: Iterator<T>, f) -> Iterator<U> { for x in self { … } }`)
// — consumed in a chain (`xs.map(f)`). Unlike a direct call, `self` is
// itself an iterator we want to FUSE into, not materialise: binding `let self =
// xs` would leave a boxed array iterator. So a generator combinator is a
// `descend_chain` LAYER (`IterChainKind.Generator`) whose source recurses into the
// receiver — the generator body's `for <lv> in self { <inner> }` becomes the source loop binding
// `<lv>`, and `<inner>` (lowered in the gen-ctx with the outer sink) routes each
// `yield e` to the consumer. Nested combinators thread sinks so the whole chain
// flattens to one loop.

// One source loop of a generator combinator body — `[<prelude>] for <loopvar> in
// <param> { <inner> }`, fused over `source` (the `descend_chain` of the arg bound
// to that param). A combinator with more than one source param (`chain`) carries
// the extra loops beyond the primary `self` loop in `GenComboLayer.extra_sources`.
GenSourceBinding :: struct {
    source:  IterChain      // the param's arg chain
    loop_id: usize          // the loop's `ForStmt.id`, in the generator's module
    loopvar: Symbol         // the loop's binding variable
    inner:   AST.BlockExpr  // the loop body (contains the yield)
    prelude: AST.Stmt[]     // counter `let`s ahead of this loop (take/skip/enumerate)
}

// The inlined body of a generator combinator layer, carried on `IterChain`.
GenComboLayer :: struct {
    decl:        AST.FnDecl      // the generator combinator
    subst:       Substitution    // its instance substitution
    owner:       TypedProgram    // the module the generator is defined in
    loop_id:     usize           // the primary loop's `ForStmt.id`, in `owner`
    loopvar:     Symbol          // the body's primary `for <loopvar> in self` variable
    inner:       AST.BlockExpr   // the primary for-loop body (contains the yield)
    arg_sym:     Symbol | null   // the single non-self DATA param's symbol (map's `f`) ; null for a 0-arg combinator (`enumerate`) or when the non-self param is itself a source (`chain`)
    arg_expr:    AST.Expr | null // the call's non-self DATA argument (map's `f`, …) ; null as above
    output_elem: Type            // the combinator's yielded element type
    instance:    GenInstance!    // the names this layer's body lowers under
    prelude:     AST.Stmt[]      // counter `let`s ahead of the primary source loop (take/skip/enumerate)
    // Additional source loops beyond the primary `self` loop, in body order —
    // one per extra source param (`chain`'s `other`). Empty for every single-
    // source combinator (map / filter / take / skip / enumerate / flat_map).
    extra_sources: GenSourceBinding[] = []
}

// Recognise `<recv>.gen_combinator(arg)` (UFCS) or `gen_combinator(<recv>, arg)`
// where the callee is a `generator` fn whose body is one or more `for <lv> in
// <param> { <inner> }` source loops (map/filter/take/skip/enumerate: one loop over
// `self` ; `chain`: two, over `self` and `other`). Returns a `Generator` chain
// layer whose primary source is `descend_chain(<recv>)` and whose extra source
// params fuse independently, else null (the chain falls back to the boxed path).
try_descend_gen_combinator :: fn(ctx: FnLowerCtx!, call: AST.CallExpr) -> IterChain | null {
    fluent :: unpack_fluent_combinator(ctx, call) ?? return null
    callee_sym :: combinator_callee_sym(ctx, call, fluent.receiver) ?? return null
    owner :: resolve_owner_typed(ctx, callee_sym.module) ?? return null
    decl :: owner.fn_decls[callee_sym.id] ?? return null
    if !fn_is_generator(decl) { return null }
    // v1: `self` plus zero (`enumerate`) or one (map/filter/take/skip/chain) non-self param.
    if decl.params.len() != 1 && decl.params.len() != 2 { return null }
    loops :: extract_gen_source_loops(decl) ?? return null

    // The primary loop iterates `self` (param 0) ; its source is the receiver.
    primary :: find_source_loop(loops, 0) ?? return null
    source :: descend_chain(ctx, fluent.receiver, true) ?? return null
    primary_loopvar :: lookup_local_symbol(
        ctx.project, owner.resolved, primary.loopvar_span,
    ) ?? return null

    // Classify the non-self param (param 1, if any): a SOURCE — its own loop, as in
    // `chain`'s `other` — fuses as an extra source ; otherwise it's DATA (map's `f`,
    // take's `n`), bound once ahead of the loops.
    param1_loop :: find_source_loop(loops, 1)
    // The non-self param is DATA (map's `f`, take's `n`) unless it has its own source
    // loop — `chain`'s `other`, which fuses as an extra source instead.
    arg_is_data :: decl.params.len() == 2 && param1_loop is null
    extra_sources: GenSourceBinding[]!: []
    if param1_loop is GenSourceLoop {
        other_expr :: fluent.fn_arg ?? return null
        other_src :: descend_chain(ctx, other_expr, true) ?? return null
        other_loopvar :: lookup_local_symbol(
            ctx.project,
            owner.resolved,
            param1_loop.loopvar_span,
        ) ?? return null
        extra_sources.push(GenSourceBinding {
            .source = other_src,
            .loop_id = param1_loop.loop_id,
            .loopvar = other_loopvar,
            .inner = param1_loop.inner,
            .prelude = param1_loop.prelude,
        })
    }
    // No 3-source combinator exists — reject any loop over param ≥ 2.
    if loops.len() > 1 + extra_sources.len() { return null }

    // The non-self DATA arg (null for a 0-arg / all-source combinator) — seeds the
    // instance subst (map/filter's transform carries the element concretely) and is
    // bound once ahead of the loops.
    data_arg :: if arg_is_data { fluent.fn_arg } else { null }
    subst_opt :: gen_combo_subst(ctx, decl, owner, callee_sym, fluent.receiver, data_arg, chain_element_type(source))
    if subst_opt is null { return null }
    arg_sym :: if arg_is_data { combinator_arg_sym(ctx, decl, owner) } else { null }
    if arg_is_data && arg_sym is null { return null }

    // Direction A: the call result is the concrete `__genstate_<fn>` struct, not
    // `Iterator<U>` — take the yielded element from the registered element.
    output_elem :: genstate_element(ctx.typed, decl.name, subst_opt) ?? return null

    // Minted last: a descent that gives up must leave no ids, clones or captures behind.
    instance :: new_gen_instance(ctx.project, callee_sym, decl, owner) ?? return null
    cloned_extras: GenSourceBinding[]!: []
    for extra in extra_sources {
        cloned_extras.push(GenSourceBinding {
            ...extra,
            .loopvar = clone_of(instance, extra.loopvar),
        })
    }
    cloned_arg :: if arg_sym is Symbol { clone_of(instance, arg_sym) } else { null }
    return mk_generator_chain(source, GenComboLayer {
        .decl = decl, .subst = subst_opt, .owner = owner,
        .loop_id = primary.loop_id, .loopvar = clone_of(instance, primary_loopvar),
        .inner = primary.inner,
        .arg_sym = cloned_arg, .arg_expr = data_arg, .output_elem = output_elem,
        .prelude = primary.prelude, .extra_sources = cloned_extras, .instance = instance,
    }, call.span)
}

// The source loop over param `param_index`, or null when no loop iterates it.
find_source_loop :: fn(loops: GenSourceLoop[], param_index: usize) -> GenSourceLoop | null {
    for l in loops { if l.param_index == param_index { return l } }
    return null
}

// The symbol of a combinator's single non-self param (`decl.params[1]`), or null
// for a 0-arg combinator (`enumerate`, whose only param is `self`).
combinator_arg_sym :: fn(ctx: FnLowerCtx!, decl: AST.FnDecl, owner: TypedProgram) -> Symbol | null {
    if decl.params.len() < 2 { return null }
    return lookup_local_symbol(ctx.project, owner.resolved, decl.params[1].span)
}

// One source loop of a generator combinator body, tagged with the PARAM it
// iterates. `prelude` is the run of non-loop statements ahead of it — a leading
// counter `let` for `take`/`skip`/`enumerate` (`i: usize = 0`), empty otherwise.
GenSourceLoop :: struct {
    param_index:  usize
    loop_id:      usize
    loopvar_span: Span
    inner:        AST.BlockExpr
    prelude:      AST.Stmt[]
}

// Split a generator combinator body into its ordered source loops. Each top-level
// `for <lv> in <param_k> { <inner> }` statement is a source loop over param k ;
// every other statement (a counter `let`) accrues as the `prelude` of the NEXT
// loop. Null when the body dangles statements after its last loop, or has no loop
// at all — shapes the fusion doesn't model. map/filter/take/skip/enumerate yield a
// single loop over `self` ; `chain` yields two (over `self` and `other`).
extract_gen_source_loops :: fn(decl: AST.FnDecl) -> GenSourceLoop[] | null {
    body :: decl.body ?? return null
    if body.trailing != null { return null }
    if body.stmts.len() == 0 { return null }
    loops: GenSourceLoop![]!: []
    pending: AST.Stmt[]! = []
    for stmt in body.stmts {
        matched :: match_source_loop(stmt, decl)
        if matched is GenSourceLoop {
            loops.push(GenSourceLoop { ...matched, .prelude = pending })
            pending = []
        } else {
            // A prelude runs once, outside every source loop: a `yield` there would
            // splice the consumer body where none of its jumps has a loop to reach.
            if stmt_has_yield(stmt) {
                return null
            }
            pending.push(stmt)
        }
    }
    // A dangling prelude after the last loop isn't a fusible shape.
    if pending.len() > 0 { return null }
    if loops.len() == 0 { return null }
    return loops
}

// The source loop `stmt` forms — `for <lv> in <param_k> { <inner> }`, tagged with
// param k — or null when it isn't a top-level loop over one of `decl`'s params. The
// returned `prelude` is empty ; the caller fills it with the preceding non-loop run.
match_source_loop :: fn(stmt: AST.Stmt, decl: AST.FnDecl) -> GenSourceLoop | null {
    if stmt is AST.ForStmt {
        if stmt.form is AST.InFor as inf {
            if inf.iter is AST.IdentExpr as it {
                for i in 0..<decl.params.len() {
                    if decl.params[i].name == it.name {
                        return GenSourceLoop {
                            .param_index = i,
                            .loop_id = stmt.id,
                            .loopvar_span = loop_var_span(inf.loop_var, stmt.span),
                            .inner = stmt.body,
                            .prelude = [],
                        }
                    }
                }
            }
        }
    }
    return null
}

// The resolved callee symbol of a combinator call — the free-fn symbol for a UFCS
// `recv.name(arg)` (via the receiver type) or a direct `name(recv, arg)` ident.
combinator_callee_sym :: fn(ctx: FnLowerCtx, call: AST.CallExpr, receiver: AST.Expr) -> Symbol | null {
    // Unwrap an explicit type-arg wrapper (`chain<T>(...)`) to the inner callee,
    // mirroring `unpack_fluent_combinator`, so the sym resolves.
    @partial match combinator_effective_callee(call.callee) as fe {
        is AST.FieldExpr -> {
            found :: find_free_fn_ufcs(ctx, ctx.types.expr_type(receiver), fe.field)
            if found is UfcsMember { return found.symbol }
            return null
        }
        is AST.IdentExpr -> {
            sym :: resolve_ident(ctx, fe.span) ?? return null
            // A directly-called imported combinator resolves to the `import`
            // ImportBinding ; follow it to the OWNER fn so `resolve_owner_typed`
            // + `gen_state_symbol` see the defining module.
            return follow_import_binding(ctx, sym)
        }
        _                -> { return null }
    }
}

// The instance substitution for a generator combinator: empty when non-generic,
// else inferred by unifying the generic signature's params with the receiver +
// arg types (`unify_params` — the same engine `infer_type_args` uses, but driven
// from the normalised `(receiver, fn_arg)` so it works for UFCS and direct alike).
// Null when a type param stays unbound (bail to the struct/boxed path).
gen_combo_subst :: fn(
    ctx: FnLowerCtx, decl: AST.FnDecl, owner: TypedProgram, callee_sym: Symbol,
    receiver: AST.Expr, fn_arg: AST.Expr | null, source_elem: Type,
) -> Substitution | null {
    if decl.type_params.len() == 0 { return new_substitution() }
    // 0-arg combinator (`enumerate`): no fn arg to infer from — `self`'s only type
    // param IS the source element, so bind it straight from the fused source's
    // concrete element type (`substitute` then rewrites it through the yielded
    // element, tuple included). `source_elem` is post-fusion concrete, with no
    // erased-head ambiguity — the same unambiguous binding the 1-arg path uses.
    if fn_arg is null { return subst_from_concrete(decl, owner, [source_elem]) }
    ft :: owner.decl_types[callee_sym.id]
    if ft is FnType {
        if ft.params.len() < 2 { return null }
        bindings :: MutableMap<i32, Type> {}
        order: i32[]!: []
        // Bind the SOURCE element type-param from the post-fusion concrete
        // `source_elem`, NOT from the receiver's (possibly erased) type. `self` is
        // `Iterator<T>` for every combinator, so its element `T` is `params[0]`'s
        // trait arg. This retires the old "unify arg before receiver" ordering
        // hack (which only existed to stop an erased head binding `T = Any` first).
        // For a concrete head `source_elem` equals the receiver's element, so the
        // result (and the `order` / `concrete_args`) is byte-identical to the old
        // path — see the task #25 note in project_stream_fusion_generators.
        source_bound := false
        if ft.params[0] is TraitType as p0 {
            if p0.args.len() >= 1 {
                unify_params(p0.args[0], source_elem, bindings, order, ctx)
                source_bound = true
            }
        }
        // Non-`Iterator<T>` self shouldn't occur for these combinators ; keep the
        // receiver-unify fallback so an unexpected shape behaves as before.
        if !source_bound {
            unify_params(ft.params[0], default_if_free(ctx.types.expr_type(receiver)), bindings, order, ctx)
        }
        // Then the fn arg, for any param it introduces beyond the source element
        // (map's `U` from `f: fn(T) -> U`). `T` is already pinned, and
        // `unify_params` keeps the first binding, so a concrete arg just agrees.
        unify_params(ft.params[1], default_if_free(ctx.types.expr_type(fn_arg)), bindings, order, ctx)
        concrete_args: Type[]!: []
        for id in order {
            v :: bindings[id] ?? return null
            concrete_args.push(v)
        }
        return subst_from_concrete(decl, owner, concrete_args)
    }
    return null
}

// Emit a `Generator` chain layer: each source loop binds its loop var to every
// source element and runs the combinator's inner body, whose `yield e` routes (via
// the shared gen-ctx sink) to the OUTER template's binding + body. The single non-
// self DATA param (map's `f`, …) is already bound, by `bind_layer_operands` ;
// multi-source combinators (`chain`) fuse each source loop in body order, all
// into the same sink.
emit_fused_gen_combinator :: fn(
    ctx: FnLowerCtx!,
    chain: IterChain,
    outer_span: Span,
    template: BodyTemplate,
    recurse: fn(FnLowerCtx!, AST.Expr) -> LoweredExpr,
) -> LoweredStmt[] {
    src :: chain.source
    layer :: chain.gen_layer
    if src is null { return [] }
    if layer is null { return [] }

    // Shared gen-ctx with the OUTER template installed as the yield sink — every
    // source loop routes its yields to the same consumer body.
    gen_ctx :: inline_gen_ctx(ctx, layer.decl, layer.owner, layer.subst, layer.instance, template, chain.span)

    out: LoweredStmt[]!: []
    // The primary `self` loop, then each extra source loop (chain's `other`), fused
    // in body order — all binding into the shared sink.
    primary_binding :: GenSourceBinding {
        .source = src, .loop_id = layer.loop_id, .loopvar = layer.loopvar,
        .inner = layer.inner, .prelude = layer.prelude,
    }
    // The source chain emits inside this window and may hold another layer of the
    // same generator: the id leaves with the frame that put it there.
    entered :: ctx.project.inlining_generators.add(layer.instance.generator_id)
    out.push_all(fuse_source_loop(ctx, gen_ctx, primary_binding, outer_span, chain.span, recurse))
    for extra in layer.extra_sources {
        out.push_all(fuse_source_loop(ctx, gen_ctx, extra, outer_span, chain.span, recurse))
    }
    if entered {
        ctx.project.inlining_generators.remove(layer.instance.generator_id)
    }
    return wrap_instance_exit(layer.instance, chain.span, out)
}

// Fuse one source loop of a generator combinator: lower its inner body in the
// shared gen-ctx (yields route to the installed sink), then emit its prelude (a
// counter `let`, sibling of the loop so inner counter refs resolve) followed by the
// fused source loop binding the loop var to each element.
fuse_source_loop :: fn(
    ctx: FnLowerCtx!, gen_ctx: FnLowerCtx!, binding: GenSourceBinding,
    outer_span: Span, span: Span, recurse: fn(FnLowerCtx!, AST.Expr) -> LoweredExpr,
) -> LoweredStmt[] {
    // The loop over the source is the source's consumer: its own jumps land in
    // the source's code.
    gen_ctx.jump_frames.push(chain_jump_frame(binding.loop_id, binding.source))
    inner_lowered :: lower_block(gen_ctx, binding.inner, false, binding.loop_id)
    frame :: pop_jump_frame(gen_ctx)
    inner_template :: BodyTemplate {
        .binding_name = binding.loopvar.name,
        .binding_symbol = binding.loopvar,
        .element_type = chain_element_type(binding.source),
        .user_body = resumable_body(frame, inner_lowered),
    }
    emitted :: emit_fused_chain(ctx, binding.source, outer_span, inner_template, recurse)
    out: LoweredStmt[]!: []
    if binding.prelude.len() > 0 {
        prelude_expr: AST.Expr: AST.BlockExpr { .span = span, .stmts = binding.prelude, .trailing = null }
        prelude_lowered :: recurse(gen_ctx, prelude_expr)
        if prelude_lowered is LoweredBlock { out.push_all(prelude_lowered.stmts) }
    }
    out.push_all(exit_block(frame, span, emitted))
    return out
}

// ---- a generator as a chain source -----------------------------------------
//
// A call to a `generator` that is not a combinator — `zip(a, b)`, `xs.window(3)`, a
// user generator over a range — heads a chain as a SOURCE: its whole body is
// inlined at the bottom of the chain, each `yield` feeding the stage above. A bare
// `for v in gen(args)` is the one-stage case. No generator is special-cased:
// whatever its body does, the consumer is spliced at its yields.

/// A generator call heading a chain, carried on `IterChain.gen_source`.
GenSourceCall :: struct {
    decl:     AST.FnDecl
    owner:    TypedProgram
    subst:    Substitution
    /// The call's arguments in parameter order — a UFCS receiver first.
    args:     AST.Expr[]
    instance: GenInstance!
}

// `call` as a chain source when it calls a generator with every parameter given
// and its instance and element type resolve ; null otherwise.
try_descend_gen_source :: fn(ctx: FnLowerCtx!, call: AST.CallExpr) -> IterChain | null {
    target :: call_target(ctx, call) ?? return null
    decl :: target.decl
    owner :: target.owner
    if !fn_is_generator(decl) || decl.body == null {
        return null
    }
    subst :: gen_source_subst(ctx, target, call) ?? return null
    element :: genstate_element(ctx.typed, decl.name, subst) ?? return null
    if element == TY_VOID {
        return null
    }
    // Minted last: a descent that gives up must leave no ids or clones behind.
    instance :: new_gen_instance(ctx.project, target.callee, decl, owner) ?? return null
    return IterChain {
        .kind = .GenSource,
        .range_lower = null, .range_upper = null, .inclusive = false,
        .element_type = element,
        .gen_source = GenSourceCall {
            .decl = decl, .owner = owner, .subst = subst, .args = target.args,
            .instance = instance,
        },
        .source = null, .span = call.span,
    }
}

// The instance substitution of a generator source: each declared parameter unified
// with its argument's type, then the result with the call's own type (a type
// parameter only the result names). One left unbound declines.
gen_source_subst :: fn(ctx: FnLowerCtx, target: CallTarget, call: AST.CallExpr) -> Substitution | null {
    decl :: target.decl
    if decl.type_params.len() == 0 {
        return new_substitution()
    }
    signature :: fn_signature(target.owner, target.callee) ?? return null
    patterns: Type[]!: []
    actuals: Type[]!: []
    for k in 0..<target.args.len() {
        patterns.push(signature.params[k])
        actuals.push(default_if_free(ctx.types.expr_type(target.args[k])))
    }
    patterns.push(signature.return_type)
    actuals.push(default_if_free(ctx.types.expr_type(call)))
    type_params :: declared_type_params(decl, target.owner) ?? return null
    concrete :: unify_type_args(ctx, patterns, actuals, type_params) ?? return null
    return subst_from_concrete(decl, target.owner, concrete)
}

// Each argument bound, in parameter order, to the instance's clone of the
// parameter — the symbol the inlined body reads.
bind_gen_source_operands :: fn(
    ctx: FnLowerCtx!, chain: IterChain, recurse: fn(FnLowerCtx!, AST.Expr) -> LoweredExpr,
    out: LoweredStmt[]!,
) -> IterChain {
    gs :: chain.gen_source ?? return chain
    for k in 0..<gs.decl.params.len() {
        arg :: recurse(ctx, gs.args[k])
        out.push(bind_instance_param(ctx, gs.instance, gs.owner, gs.decl.params[k], arg, type_of(arg)))
    }
    return chain
}

// The generator's body lowered in its own ctx — its module, its instance — with
// `template` installed as the `yield` sink.
emit_fused_gen_source :: fn(ctx: FnLowerCtx!, chain: IterChain, template: BodyTemplate) -> LoweredStmt[] {
    gs :: chain.gen_source ?? panic(UNBOUND_CHAIN)
    body :: gs.decl.body ?? panic("generator source: the generator has no body")
    gen_ctx :: inline_gen_ctx(ctx, gs.decl, gs.owner, gs.subst, gs.instance, template, chain.span)
    lowered :: lower_instance_body(ctx, gen_ctx, body)
    return wrap_instance_exit(gs.instance, chain.span, block_stmts_with_trailing(lowered))
}

// The ctx a generator body is inlined under: its module and instance substitution,
// its instance's names, and `template` — the consumer — as the `yield` sink.
inline_gen_ctx :: fn(
    ctx: FnLowerCtx!, decl: AST.FnDecl, owner: TypedProgram, subst: Substitution,
    instance: GenInstance!, template: BodyTemplate, span: Span,
) -> FnLowerCtx! {
    gen_ctx :: instance_ctx(ctx, decl, owner, subst, instance)
    gen_ctx.gen_inline_sink = build_gen_sink(
        ctx, template.pattern, template.binding_symbol, template.binding_name,
        template.element_type, template.user_body, span,
    )
    return gen_ctx
}
