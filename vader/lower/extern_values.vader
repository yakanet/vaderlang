// vader/lower/extern_values — an `@extern` taking an enum with variant data.
//
// Such an enum stores its variant's rank, and C expects the value the source
// writes after `=`. The declaration lowers to two functions: a Vader one under
// the declaration's own name and symbol, which converts each such argument and
// calls the import, and the import itself under a name of its own, taking the
// width the enum's header writes. A call reaches the Vader one whether it names
// the declaration or holds it as a value, on either backend, so no call site
// converts anything.

module "vader/lower"

import "toolchain/ast"
import "toolchain/span"
import "vader/core/mono"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/typecheck"
import "vader/lower/ir"
import "vader/support/integer"

/// Whether `fn_decl` is an `@extern` that has to lower through
/// `lower_extern_through_values`: one of its parameters is an enum with
/// variant data.
///
/// @param fn_decl  the declaration.
/// @param params   its parameters, typed.
/// @param typed    the declaring module, to read an enum behind its symbol.
takes_enum_values :: fn(fn_decl: FnDecl, params: LoweredParam[], typed: TypedProgram) -> bool {
    if fn_decl.body != null || !decorators_have(fn_decl.decorators, "extern") {
        return false
    }
    for p in params {
        if data_enum_of(p.type, typed) != null {
            return true
        }
    }
    return false
}

/// Lower `@extern` `entry`, which takes an enum with variant data, to the Vader
/// function that converts each such argument to its written value, at the width
/// the header writes, and calls the import. The function keeps the
/// declaration's name, symbol and parameters; the import goes to
/// `project_ctx.synth_decls`, which the module driver drains beside it.
///
/// @param project_ctx  the project being lowered.
/// @param entry        the declaration's entry, as `stub_entry` builds it.
/// @param typed        the declaring module.
/// @param subst        the empty substitution of a non-generic fn.
/// @param fn_decl      the declaration, for its span.
/// @param params       its parameters, typed.
/// @param return_type  its result.
/// @return             the Vader function.
lower_extern_through_values :: fn(
    project_ctx: LowerProjectCtx,
    entry: MonoEntry,
    typed: TypedProgram,
    subst: Substitution,
    fn_decl: FnDecl,
    params: LoweredParam[],
    return_type: Type,
) -> LoweredFnDecl {
    ctx :: new_fn_lower_ctx(project_ctx, entry, typed, subst, return_type)
    span :: fn_decl.span
    import_symbol :: synthetic_symbol(next_synthetic_id(ctx), .Fn, import_mangle(entry.mangled))
    own_params: LoweredParam[]: []
    import_params: LoweredParam[]: []
    args: LoweredExpr[]: []
    for p in params {
        // An `@extern`'s parameters have no use-site to take a symbol from, so
        // they share id 0; a body needs one id per parameter.
        own :: Symbol { ...p.symbol, .id = next_synthetic_id(ctx) }
        own_params.push(LoweredParam { ...p, .symbol = own })
        arg :: synth_ident(own, p.type, span)
        enum_type :: data_enum_of(p.type, typed)
        if enum_type == null {
            import_params.push(p)
            args.push(arg)
            continue
        }
        width :: crossing_type(enum_type)
        import_params.push(LoweredParam { ...p, .type = width })
        args.push(
            LoweredCast {
                .span = span,
                .type = width,
                .value = lower_enum_value(ctx, arg, enum_type, span),
            },
        )
    }
    // Its own symbol, so neither of the two identities `emit/bytecode/emit` indexes a
    // function by is shared with the Vader function.
    import_origin :: MonoEntry {
        ...entry,
        .mangled = import_symbol.name,
        .symbol = import_symbol,
    }
    project_ctx.synth_decls.push(
        LoweredFnDecl {
            .mangled = import_symbol.name,
            .params = import_params,
            .return_type = return_type,
            .body = null,
            .origin = import_origin,
        },
    )
    call :: mk_lowered_call(import_symbol, args, return_type, span)
    return LoweredFnDecl {
        .mangled = entry.mangled,
        .params = own_params,
        .return_type = return_type,
        .body = forwarding_block(call, return_type, span),
        .origin = entry,
    }
}

// The mangle the import answers to. No other synthesised function takes this
// suffix (`$v`, `$guard`), so no mangle collides. The C name does not keep the
// `$`: a function named `<name>_extern_import` in the same module would meet
// this one there, and `cc` refuses the second definition.
import_mangle :: fn(mangled: string) -> string = "${mangled}\$extern_import"

// The integer `e` crosses at: the width its header writes, which typecheck
// requires (T3050), else the narrowest holding its values.
crossing_type :: fn(e: EnumType) =
    machine_integer_type(e.written_width ?? narrowest_width(e.values))

// `return call`, or `call` alone when nothing comes back.
forwarding_block :: fn(call: LoweredExpr, return_type: Type, span: Span) -> LoweredBlock {
    if is_void(return_type) {
        return mk_void_block([LoweredExprStmt { .span = span, .expr = call }], span)
    }
    return wrap_as_block(call, span)
}

// The enum with variant data `t` is, or null.
data_enum_of :: fn(t: Type, typed: TypedProgram) -> EnumType | null {
    enum_type :: lift_enum_placeholder(t, typed)
    if enum_type is EnumType && enum_type.data != null {
        return enum_type
    }
    return null
}
