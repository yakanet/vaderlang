// vader/lower/string_lit — string + interpolation lowering, with Display coercion.
//
// A text-only string literal becomes a single `LoweredStringLit`. A literal with
// any `${expr}` segment lowers to ONE right-sized byte buffer (`lower_interp_buffer`)
// when some part is a directly-writable primitive (int / uint / bool) — each
// writes its bytes straight in, no throwaway interned string per part. A purely
// text + `${string}` / `${Display}` interpolation has no digit to format, so it
// stays on the leaner all-string concat path (`lower_concat_chain`, the shared
// `concat_N`, same shape as `+`). Interpolated
// `${Display}` values render through what the typecheck recorded (`render_part`).
// The buffer primitives live in the force-loaded `std/core` prelude, so
// resolution always succeeds.

module "vader/lower"

import "std/collections"
import "std/abort"
import "vader/lower/ir"

import "toolchain/ast"
import "vader/support/diagnostics"
import "vader/support/integer"
import "vader/core/symbol"
import "vader/front/typecheck"
import "vader/core/types"
import "toolchain/span"

lower_string_lit :: fn(ctx: FnLowerCtx, expr: StringLitExpr, type: Type) -> LoweredExpr {
    string_type :: TY_STRING
    if !has_interp_part(expr) {
        body := ""
        for part in expr.parts {
            match part {
                is StringLitText -> { body = body + part.value }
                _ -> {}
            }
        }
        return LoweredStringLit { .span = expr.span, .type = string_type, .value = body }
    }

    // Build into one exact-sized byte buffer : text + each `${value}` writes its
    // bytes straight in, so a `${int}` formats its digits with no throwaway
    // interned string (the old `value.to_string()` per part). Interned once at
    // `finish`.
    return lower_interp_buffer(ctx, expr)
}

// Lower a flattened string `+` chain (`operands` are the lowered leaves, in
// order) to a single interned string : a call to the shared, arity-specialised
// `concat_N` (`vader/lower/concat.vader`). `concat_N` is one right-sized
// byte buffer written part-by-part and interned once — no StringBuilder struct /
// parts array, one intern for the whole chain, ANY arity (no magic 2/3/4, no
// cliff). It is synthesised on first use of arity N and shared across every
// N-leaf concat ; the call site stays one `call`.
lower_concat_chain :: fn(ctx: FnLowerCtx, operands: LoweredExpr[], span: Span) -> LoweredExpr {
    leaves :: fold_literal_runs(operands, span)
    n :: leaves.len()
    string_type :: TY_STRING
    // A 1-leaf chain reaches here three ways : the all-string `${}` path can
    // collect a single operand, an all-literal `+` chain folds down to one
    // literal, and a chain of empty literals collapses to `""`.
    if n == 1 {
        return leaves[0]
    }
    sym :: get_or_create_concat(ctx, i32(n)) ?? return unreachable_buffer("concat_${n} unresolved")
    return mk_lowered_call(sym, leaves, string_type, span)
}

/// Collapse adjacent literal leaves of a concat chain into one literal, and drop
/// the empty ones.
///
/// `"a" + "b" + x + "c" + "d"` collects five leaves and would emit a `concat_5`
/// that allocates a buffer, writes five parts and interns the result at run
/// time. Three of those parts are known here, so the chain becomes `["ab", x,
/// "cd"]` — a `concat_3`. An ALL-literal chain folds to a single
/// `LoweredStringLit`, which the caller returns directly : the whole
/// concatenation then costs nothing at run time, the bytes being interned once
/// as a comptime atom.
///
/// The leaves are already lowered, so a `LoweredStringLit` here is a genuine
/// compile-time constant — a `const` local still arrives as a `LoweredIdent` and
/// is left alone.
///
/// @param operands  the flattened chain leaves, in order. Returned as-is when
///                  nothing folds, so the common chain pays no copy.
/// @param span      the whole chain's span — carried by the `""` fallback when
///                  every leaf was an empty literal and nothing else is left.
/// @return          the folded leaves, always at least one.
fold_literal_runs :: fn(operands: LoweredExpr[], span: Span) -> LoweredExpr[] {
    if !has_foldable_leaf(operands) {
        return operands
    }
    out: LoweredExpr[]: []
    for op in operands {
        if op is LoweredStringLit {
            // An empty part writes nothing ; carrying it would cost an operand,
            // a `byte_len` call and a zero-length write per concat. Dropping it
            // first is also what lets `"e" + "" + "f"` reach a single `"ef"`.
            if op.value == "" {
                continue
            }
            if merge_into_literal_tail(out, op) {
                continue
            }
        }
        out.push(op)
    }
    if out.len() == 0 {
        return [LoweredStringLit { .span = span, .type = TY_STRING, .value = "" }]
    }
    return out
}

// True when `fold_literal_runs` would change something : an empty literal to
// drop, or two adjacent literals to merge. The shape a `${}` lowers to —
// `"x=" + v + ", y=" + w` — has neither, so it keeps its own operand array and
// the fold costs one scan instead of a fresh array plus a copy per leaf.
has_foldable_leaf :: fn(operands: LoweredExpr[]) -> bool {
    after_literal := false
    for op in operands {
        if op is LoweredStringLit {
            if op.value == "" || after_literal {
                return true
            }
            after_literal = true
        } else {
            after_literal = false
        }
    }
    return false
}

// Append `lit`'s bytes to `out`'s trailing leaf when that leaf is itself a
// literal, and report whether it happened. The merged span covers the whole run,
// so a diagnostic on the folded value still points at every part the user wrote.
merge_into_literal_tail :: fn(out: LoweredExpr[], lit: LoweredStringLit) -> bool {
    last :: out.len()
    if last == 0 {
        return false
    }
    prev :: out[last - 1]
    if prev is LoweredStringLit {
        out[last - 1] = LoweredStringLit {
            .span = Span { .start = prev.span.start, .end = lit.span.end },
            .type = prev.type,
            .value = prev.value + lit.value,
        }
        return true
    }
    return false
}

// ICE for the (provably-dead) std/core buffer-API resolution guards — std/core
// is the force-loaded prelude, so these never fire. A resolution miss here is a
// broken toolchain, not a user error, so we PANIC (fail loud) rather than emit a
// degraded `stub` that would silently miscompile every `${…}` / `+`.
unreachable_buffer :: fn(why: string) -> LoweredExpr =
    unreachable("lower_string_lit: ${why} (std/core must be force-loaded)")

// A `LoweredIdent` referencing a synthetic local (buffer / offset / param).
synth_ident :: fn(sym: Symbol, ty: Type, span: Span) -> LoweredExpr =
    LoweredIdent { .span = span, .type = ty, .symbol = sym }

// Resolve a `std/core` free fn by name (the Writer / Buffer API). Returns `null`
// only if std/core wasn't loaded, which the force-loaded prelude rules out.
resolve_writer_fn :: fn(ctx: FnLowerCtx, name: string) -> Symbol | null =
    lookup_core_symbol(ctx, name)

// The `Buffer` the std/core writer API fn `writer` takes as its `self`. Shared by
// `lower_interp_buffer` and `synthesize_concat_fn` (both size + write a buffer).
// `null` when the fn type can't be resolved.
writer_buffer :: fn(ctx: FnLowerCtx, writer: Symbol) -> Type | null {
    ft :: lookup_fn_type_anywhere(ctx, writer)
    if ft !is FnType || ft.params.len() == 0 {
        return null
    }
    return ft.params[0]
}

// The longest decimal text of an integer of 64 bits or fewer : `i64.min` with its
// sign, `u64.max`. A writer writes past its buffer when it is short.
INTEGER_TEXT_BYTES: i64: 20

// How a `${value}` part writes into the buffer. `Str` also covers verbatim text.
// How a part contributes : `Text` = verbatim literal, `Str` = a runtime string,
// the rest = a primitive that formats its bytes directly.
WriterKind :: enum(u8) { Text, Str, Signed, Unsigned, Bool, Display }

// The writer of a bare primitive ; `.Display` for any other type, which renders
// through its `Display` (`render_part`) — a distinct included, whose own `Display`
// may differ from its backing's (`Instant`'s ISO-8601 form over `distinct i64`).
classify_kind :: fn(t: Type) -> WriterKind {
    if t is RangeType {
        return integer_writer(t.bounds)
    }
    if t is PrimitiveType {
        if t.name == "bool"   { return .Bool }
        if t.name == "string" { return .Str }
    }
    return .Display
}

// Interpolation → ONE exact-sized byte buffer when some part is a directly
// writable primitive (int / uint / bool) : those write their digits straight in,
// skipping the throwaway interned string the old `value.to_string()` minted per
// `${int}`. The buffer is sized up front — verbatim text bytes + bounds (≤ 20 per
// int, ≤ 5 per bool) + the runtime `byte_len` of string / `${Display}` parts — so
// it never grows ; `off` threads through the offset-returning `write_*`
// primitives, interned once. A purely text + `${string}` / `${Display}`
// interpolation has no digit to format, so it stays on the leaner all-string
// `concat_N` path (`lower_concat_chain`). Each part is lowered once.
lower_interp_buffer :: fn(ctx: FnLowerCtx, expr: StringLitExpr) -> LoweredExpr {
    string_type :: TY_STRING
    span :: expr.span
    // Lower every part once, classifying interpolated values by type ; a
    // `${Display}` part is rendered here, and joins the strings.
    values: LoweredExpr[]: []
    kinds: WriterKind[]: []
    has_direct := false
    for part in expr.parts {
        match part {
            is StringLitText -> {
                values.push(LoweredStringLit { .span = part.span, .type = string_type, .value = part.value })
                kinds.push(.Text)
            }
            is StringLitInterp -> {
                mark :: ctx.pending_awaits.len()
                inner :: lower_expr(ctx, part.expr)
                bind_before_hoisted(ctx, values, mark)
                shown :: default_if_free(shown_type(ctx, part.expr, inner))
                rendered :: render_part(ctx, part.expr, inner, shown, span)
                if rendered != null {
                    observe_replacement(ctx, part.expr, .Display, inner, rendered)
                    values.push(rendered)
                    kinds.push(.Str)
                } else {
                    k :: classify_kind(strip_distinct(shown))
                    if k == .Signed || k == .Unsigned || k == .Bool { has_direct = true }
                    observe_no_call(ctx, part.expr, .Display, "writer")
                    values.push(inner)
                    kinds.push(k)
                }
            }
        }
    }
    // Every part is a string : the all-string `concat_N`.
    if !has_direct {
        return lower_concat_chain(ctx, values, span)
    }

    // Resolve the std/core buffer API.
    nbb_sym :: resolve_writer_fn(ctx, "new_byte_buffer") ?? return unreachable_buffer("new_byte_buffer")
    finish_sym :: resolve_writer_fn(ctx, "finish_buffer") ?? return unreachable_buffer("finish_buffer")
    blen_sym :: resolve_writer_fn(ctx, "byte_len") ?? return unreachable_buffer("byte_len")
    wstr_sym :: resolve_writer_fn(ctx, "write_string_at") ?? return unreachable_buffer("write_string_at")
    wint_sym :: resolve_writer_fn(ctx, "write_int") ?? return unreachable_buffer("write_int")
    wuint_sym :: resolve_writer_fn(ctx, "write_unsigned") ?? return unreachable_buffer("write_unsigned")
    wbool_sym :: resolve_writer_fn(ctx, "write_bool") ?? return unreachable_buffer("write_bool")
    // Buffer type from `write_string_at`'s self param.
    buffer_type :: writer_buffer(ctx, wstr_sym) ?? return unreachable_buffer("Buffer")
    register_nongeneric_imported_fn(ctx, nbb_sym)
    register_nongeneric_imported_fn(ctx, finish_sym)
    register_nongeneric_imported_fn(ctx, blen_sym)
    register_nongeneric_imported_fn(ctx, wstr_sym)
    register_nongeneric_imported_fn(ctx, wint_sym)
    register_nongeneric_imported_fn(ctx, wuint_sym)
    register_nongeneric_imported_fn(ctx, wbool_sym)

    // Process parts : bind each string / `${Display}` to a tmp (referenced twice —
    // size + write — so `${f()}` isn't evaluated twice), accumulate the static byte
    // bound + the runtime `byte_len` size terms, and record what to write.
    stmts: LoweredStmt[]: []
    write_values: LoweredExpr[]: []
    write_kinds: WriterKind[]: []
    const_bytes: i64 = 0
    runtime_size: LoweredExpr | null = null
    for i in 0..<values.len() {
        v :: values[i]
        k :: kinds[i]
        if k == .Signed {
            const_bytes = const_bytes + INTEGER_TEXT_BYTES
            write_values.push(v)
            write_kinds.push(.Signed)
        } else if k == .Unsigned {
            const_bytes = const_bytes + INTEGER_TEXT_BYTES
            write_values.push(v)
            write_kinds.push(.Unsigned)
        } else if k == .Bool {
            const_bytes = const_bytes + 5
            write_values.push(v)
            write_kinds.push(.Bool)
        } else if k == .Text {
            if v is LoweredStringLit { const_bytes = const_bytes + v.value.byte_len() }
            write_values.push(v)
            write_kinds.push(.Str)
        } else {
            // A string — bind to a tmp, add a runtime `byte_len` size term.
            tmp_sym :: fresh_synthetic_symbol(ctx, "p")
            stmts.push(LoweredLet {
                .span = span,
                .name = tmp_sym.name,
                .symbol = tmp_sym,
                .type = string_type,
                .value = v,
            })
            tmp_ref :: synth_ident(tmp_sym, string_type, span)
            blen_call :: mk_lowered_call(blen_sym, [tmp_ref], TY_I64, span)
            if runtime_size == null { runtime_size = blen_call } else {
                runtime_size = LoweredBinary { .span = span, .type = TY_I64, .op = .Add, .left = runtime_size, .right = blen_call }
            }
            write_values.push(tmp_ref)
            write_kinds.push(.Str)
        }
    }
    // size = const_bytes + Σ byte_len(str tmps).
    const_lit :: LoweredIntLit { .span = span, .type = TY_I64, .value = const_bytes }
    size: LoweredExpr = const_lit
    if runtime_size != null {
        size = LoweredBinary { .span = span, .type = TY_I64, .op = .Add, .left = const_lit, .right = runtime_size }
    }
    buf_sym :: fresh_synthetic_symbol(ctx, "buf")
    stmts.push(LoweredLet {
        .span = span, .name = buf_sym.name, .symbol = buf_sym, .type = buffer_type,
        .value = mk_lowered_call(nbb_sym, [size], buffer_type, span),
    })
    off_sym :: fresh_synthetic_symbol(ctx, "off")
    stmts.push(LoweredLet {
        .span = span, .name = off_sym.name, .symbol = off_sym, .type = TY_I64,
        .value = LoweredIntLit { .span = span, .type = TY_I64, .value = 0 },
    })
    // `off = buf.write_X(off, value)` per part — the write returns the new offset.
    for i in 0..<write_values.len() {
        wv :: write_values[i]
        wsym :: match write_kinds[i] {
            .Signed                 -> wint_sym
            .Unsigned               -> wuint_sym
            .Bool                   -> wbool_sym
            .Str | .Text | .Display -> wstr_sym
        }
        call :: mk_lowered_call(wsym, [synth_ident(buf_sym, buffer_type, span), synth_ident(off_sym, TY_I64, span), wv], TY_I64, span)
        stmts.push(LoweredAssign { .span = span, .target = synth_ident(off_sym, TY_I64, span), .value = call })
    }
    return LoweredBlock {
        .span = span, .type = string_type, .stmts = stmts,
        .trailing = mk_lowered_call(finish_sym, [synth_ident(buf_sym, buffer_type, span), synth_ident(off_sym, TY_I64, span)], string_type, span),
    }
}

// The writer of an integer of `values` : the signed one where a value may be
// negative.
integer_writer :: fn(values: Interval) -> WriterKind {
    if values.lo < 0 {
        return .Signed
    }
    return .Unsigned
}

// What renders the interpolated `value` of type `shown`, as the typecheck recorded
// it : its `Display` member, called or inlined, or the vtable's. Null when the
// interpolation writes the value itself — an integer, a `bool`, a `string`, or a
// distinct over one with no `Display` of its own — a bound's settled on such an
// instance included.
render_part :: fn(
    ctx: FnLowerCtx,
    node: Expr,
    value: LoweredExpr,
    shown: Type,
    span: Span,
) -> LoweredExpr | null {
    callee :: recorded_callee(ctx, node, .Display)
    if writes_part(ctx, callee, shown) {
        return null
    }
    target :: callee_target(ctx, callee, shown)
    if target is UfcsMember {
        return build_member_call_or_inline(target, [value], TY_STRING, span)
    }
    // A member dispatched at run time ; a value no writer takes (one that never
    // exists) renders through the vtable too.
    display :: core_trait_key(TRAIT_DISPLAY)
    return virtual_call(ctx, display, METHOD_TO_STRING, value, [], TY_STRING, span)
}

// Whether the interpolation writes a part of type `shown` itself : the typecheck
// recorded no call, or the type it settles on is one the interpolation writes — a
// bound's member at its instance, a part typed only once unrolled (`@field` in a
// `@comptime for`, recorded as erroneous).
writes_part :: fn(ctx: FnLowerCtx, callee: Callee | null, shown: Type) -> bool {
    if callee is Builtin {
        return shown !is NeverType
    }
    if callee == null || callee is BoundMember | ErroneousCallee | UnsettledCallee {
        return writes_itself(ctx, shown)
    }
    return false
}

// Whether the interpolation writes a value of type `t` itself : an integer, a
// `bool`, a `string`, or a distinct over one with no `Display` of its own.
writes_itself :: fn(ctx: FnLowerCtx, t: Type) -> bool {
    if t is DistinctType {
        own :: ctx.project.impls.impls_of(impl_base_key(t), core_trait_key(TRAIT_DISPLAY))
        return own.len() == 0 && writes_itself(ctx, t.backing)
    }
    return classify_kind(t) != .Display
}

// The type whose `Display` renders an interpolated value : its checked type when
// that is an enum, which the lowered value may not say (a bound folded at comptime
// is typed by the integer the enum is stored in).
shown_type :: fn(ctx: FnLowerCtx, source: Expr, lowered: LoweredExpr) -> Type {
    checked :: enum_type_or_unwrap(ctx, ctx.types.expr_type(source))
    return if checked is EnumType { checked } else { lowered.type }
}

has_interp_part :: fn(expr: StringLitExpr) -> bool {
    for part in expr.parts {
        match part {
            is StringLitInterp -> { return true }
            _ -> {}
        }
    }
    return false
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// A literal leaf. Its span line matters only to the merge test, which builds its
// leaves with `fold_test_lit_at` instead.
fold_test_lit :: fn(value: string) -> LoweredExpr = fold_test_lit_at(value, 1)

// A literal leaf whose span sits on `line` — the marker the merge test reads
// back: folding keeps the run's FIRST start and its LAST end.
fold_test_lit_at :: fn(value: string, line: i32) -> LoweredExpr = LoweredStringLit {
    .span = Span {
        .start = Position { .file = "t", .line = line, .column = 1, .offset = 0 },
        .end = Position { .file = "t", .line = line, .column = 2, .offset = 1 },
    },
    .type = TY_STRING, .value = value,
}

// An opaque (non-literal) leaf — what a variable operand lowers to.
fold_test_opaque :: fn(name: string) -> LoweredExpr = fold_test_opaque_at(name, 1)

// The same, on a chosen symbol id — what a test distinguishing two locals needs.
fold_test_opaque_at :: fn(name: string, id: i32) -> LoweredExpr = LoweredIdent {
    .span = empty_span(), .type = TY_STRING,
    .symbol = Symbol {
        .id = id, .kind = .Local, .name = name, .module = "test",
        .module_name = "test",
        .visibility = .Private, .defined_at = null,
    },
}

// Fold `leaves` and render the result as `lit:<value>` / `var:<name>` entries
// joined by `|`, so each test reads as one input/output line.
fold_test_run :: fn(leaves: LoweredExpr[]) -> string {
    out := ""
    for leaf in fold_literal_runs(leaves, empty_span()) {
        if out != "" {
            out = out + "|"
        }
        // @partial: the fixtures build literal and ident leaves only ; `?` marks
        // a leaf shape a future test forgot to teach this renderer about.
        out = out + @partial match leaf {
            is LoweredStringLit -> "lit:${leaf.value}"
            is LoweredIdent     -> "var:${leaf.symbol.name}"
            _                   -> "?"
        }
    }
    return out
}

@test test_fold_literal_runs_all_literals :: fn() -> void {
    leaves: LoweredExpr[]: [fold_test_lit("a"), fold_test_lit("b"), fold_test_lit("c")]
    assert_eq(fold_test_run(leaves), "lit:abc")
}

@test test_fold_literal_runs_keeps_opaque_leaves_apart :: fn() -> void {
    leaves: LoweredExpr[]: [
        fold_test_lit("a"), fold_test_lit("b"), fold_test_opaque("x"),
        fold_test_lit("c"), fold_test_lit("d"),
    ]
    assert_eq(fold_test_run(leaves), "lit:ab|var:x|lit:cd")
}

@test test_fold_literal_runs_drops_empty_literals :: fn() -> void {
    leaves: LoweredExpr[]: [fold_test_lit(""), fold_test_opaque("x"), fold_test_lit("")]
    assert_eq(fold_test_run(leaves), "var:x")
}

// An empty literal between two literals must not break the run — dropping it
// first is what lets `"e" + "" + "f"` reach a single `"ef"`.
@test test_fold_literal_runs_empty_does_not_break_a_run :: fn() -> void {
    leaves: LoweredExpr[]: [fold_test_lit("e"), fold_test_lit(""), fold_test_lit("f")]
    assert_eq(fold_test_run(leaves), "lit:ef")
}

// Every leaf empty : the caller needs a leaf to return, so `""` survives.
@test test_fold_literal_runs_all_empty_yields_one_empty :: fn() -> void {
    assert_eq(fold_test_run([fold_test_lit(""), fold_test_lit("")]), "lit:")
}

@test test_fold_literal_runs_opaque_only_is_unchanged :: fn() -> void {
    assert_eq(fold_test_run([fold_test_opaque("x"), fold_test_opaque("y")]), "var:x|var:y")
}

// The merged literal must span the WHOLE run, so a diagnostic on the folded
// value still points at every part the user wrote.
@test test_fold_literal_runs_merged_span_covers_the_run :: fn() -> void {
    leaves: LoweredExpr[]: [fold_test_lit_at("a", 7), fold_test_lit_at("b", 8), fold_test_lit_at("c", 9)]
    merged :: fold_literal_runs(leaves, empty_span())[0]
    if merged is LoweredStringLit {
        assert_eq(merged.span.start.line, 7)
        assert_eq(merged.span.end.line, 9)
    } else {
        assert(false, "an all-literal run folds to a literal")
    }
}

// A chain with nothing to fold keeps its own array — the early-out that spares
// the common `"x=" + v + ", y=" + w` shape a copy per leaf.
@test test_fold_literal_runs_returns_the_input_when_nothing_folds :: fn() -> void {
    mixed: LoweredExpr[]: [fold_test_lit("a"), fold_test_opaque("x")]
    pair: LoweredExpr[]: [fold_test_lit("a"), fold_test_lit("b")]
    empty: LoweredExpr[]: [fold_test_lit(""), fold_test_opaque("x")]
    assert(!has_foldable_leaf(mixed), "no adjacent pair and no empty leaf")
    assert(has_foldable_leaf(pair), "two adjacent literals merge")
    assert(has_foldable_leaf(empty), "an empty literal is dropped")
}
