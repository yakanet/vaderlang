// vader/lower/dump — `# Lower` snapshot dump.
//
// Walks every non-stdlib
// `LoweredModule`, sorts module ids alphabetically, and renders each
// module's decls in a compact tree form :
//
//   # Lower
//
//   ## <module display path>
//     fn <mangled>(<params>) -> <type>
//       <body…>
//     struct <mangled> { <field>: <type>, … }
//     const <mangled>: <type> =
//       <expr…>
//
// Expression rendering uses a fixed indent scheme so the `# Lower` dump
// stays stable across runs.

module "vader/lower"

import "std/collections"
import "std/sort"
import "std/string"
import "std/string_builder"
import "vader/diagnostics"
import "vader/resolver"
import "vader/resolver/symbol"
import "vader/types"
import "vader/text"

/// Render the project's `# Lower` dump as a single string. Only modules in
/// `scope` are rendered (the entry's subtree by default, `--module` to widen),
/// so dependencies — stdlib or otherwise — stay out of the dump.
/// @param project  the lowered project.
/// @param scope    in-scope module ids / prefixes (see `module_in_scope`).
/// @return         the formatted dump (no trailing newline).
export dump_lowered :: fn(project: LoweredProject, scope: string[]) -> string {
    lines: string[]! = []
    lines.push("# Lower")
    module_ids :: sort(project.modules.keys(), (a: string, b: string) -> compare_ascending(a, b))
    for module_id in module_ids {
        module :: project.modules[module_id] ?? continue
        if !module_in_scope(module.display_path, scope) { continue }
        lines.push("")
        lines.push("## ${module.display_path}")
        for decl in module.decls {
            emit_decl(lines, decl, "  ")
        }
    }
    return lines.join("\n")
}

emit_decl :: fn(lines: string[]!, decl: LoweredDecl, indent: string) -> void {
    match decl {
        is LoweredFnDecl -> {
            params :: render_params(decl.params)
            lines.push("${indent}fn ${decl.mangled}(${params}) -> ${display_type(decl.return_type)}")
            match decl.body {
                is null -> { lines.push("${indent}  <extern / signature only>") }
                is LoweredBlock as body -> { emit_block(lines, body, "${indent}  ") }
            }
        }
        is LoweredStructDecl -> {
            fields :: render_fields(decl.fields)
            lines.push("${indent}struct ${decl.mangled} { ${fields} }")
        }
        is LoweredConstDecl -> {
            lines.push("${indent}const ${decl.mangled}: ${display_type(decl.type)} =")
            emit_expr(lines, decl.value, "${indent}  ")
        }
    }
}


render_params :: fn(params: LoweredParam[]) -> string {
    sb := StringBuilder {}
    for i in 0..<params.len() {
        if i > 0 { sb.append(", ") }
        sb.append("${params[i].name}: ${display_type(params[i].type)}")
    }
    return sb.to_string()
}

render_fields :: fn(fields: LoweredStructField[]) -> string {
    sb := StringBuilder {}
    for i in 0..<fields.len() {
        if i > 0 { sb.append(", ") }
        sb.append("${fields[i].name}: ${display_type(fields[i].type)}")
    }
    return sb.to_string()
}

emit_block :: fn(lines: string[]!, block: LoweredBlock, indent: string) -> void {
    for stmt in block.stmts {
        emit_stmt(lines, stmt, indent)
    }
    if block.trailing !is null {
        lines.push("${indent}~>")
        emit_expr(lines, block.trailing, "${indent}  ")
    }
}

emit_stmt :: fn(lines: string[]!, stmt: LoweredStmt, indent: string) -> void {
    match stmt {
        is LoweredLet -> {
            inline_value :: expr_inline(stmt.value)
            match inline_value {
                is string -> {
                    lines.push("${indent}let ${stmt.name}: ${display_type(stmt.type)} = ${inline_value}")
                }
                is null -> {
                    lines.push("${indent}let ${stmt.name}: ${display_type(stmt.type)} =")
                    emit_expr(lines, stmt.value, "${indent}  ")
                }
            }
        }
        is LoweredAssign -> {
            lines.push("${indent}assign")
            lines.push("${indent}  target:")
            emit_expr(lines, stmt.target, "${indent}    ")
            lines.push("${indent}  value:")
            emit_expr(lines, stmt.value, "${indent}    ")
        }
        is LoweredCellSet -> {
            // `LoweredCellSet` is intentionally not rendered — it carries no
            // surface syntax, so the dump omits it to stay readable.
        }
        is LoweredExprStmt -> {
            emit_expr(lines, stmt.expr, indent)
        }
        is LoweredReturn -> {
            match stmt.value {
                is null -> { lines.push("${indent}return") }
                _ -> {
                    inline_value :: expr_inline(stmt.value)
                    match inline_value {
                        is string -> { lines.push("${indent}return ${inline_value}") }
                        is null -> {
                            lines.push("${indent}return")
                            emit_expr(lines, stmt.value, "${indent}  ")
                        }
                    }
                }
            }
        }
        is LoweredYield -> {
            inline_value :: expr_inline(stmt.value)
            match inline_value {
                is string -> { lines.push("${indent}yield ${inline_value}") }
                is null -> {
                    lines.push("${indent}yield")
                    emit_expr(lines, stmt.value, "${indent}  ")
                }
            }
        }
        is LoweredAwait -> {
            inline_awaited :: expr_inline(stmt.awaited)
            match inline_awaited {
                is string -> { lines.push("${indent}await ${inline_awaited} -> ${stmt.target.name}") }
                is null -> {
                    lines.push("${indent}await -> ${stmt.target.name}")
                    emit_expr(lines, stmt.awaited, "${indent}  ")
                }
            }
        }
        is LoweredLoop -> {
            cond_suffix :: render_loop_cond(stmt.cond)
            label_suffix :: render_label(stmt.label)
            lines.push("${indent}loop${cond_suffix}${label_suffix}")
            emit_block(lines, stmt.body, "${indent}  ")
        }
        is LoweredBreak -> {
            lines.push("${indent}break${render_label(stmt.label)}")
        }
        is LoweredContinue -> {
            lines.push("${indent}continue${render_label(stmt.label)}")
        }
        is LoweredDeferPush -> {
            lines.push("${indent}defer.push")
            emit_expr(lines, stmt.thunk, "${indent}  ")
        }
        is LoweredDeferPopExec -> {
            lines.push("${indent}defer.pop_exec ${stmt.count}")
        }
    }
}

render_loop_cond :: fn(cond: LoweredExpr | null) -> string {
    if cond == null { return "" }
    inline_value :: expr_inline(cond)
    match inline_value {
        is string -> { return " while (${inline_value})" }
        is null -> { return " while (<…>)" }
    }
}

render_label :: fn(label: string | null) -> string {
    match label {
        is null -> { return "" }
        is string -> { return " :${label}" }
    }
}

emit_expr :: fn(lines: string[]!, expr: LoweredExpr, indent: string) -> void {
    inline_value :: expr_inline(expr)
    match inline_value {
        is string -> { lines.push("${indent}${inline_value}") }
        is null -> { emit_expr_compound(lines, expr, indent) }
    }
}

emit_expr_compound :: fn(lines: string[]!, expr: LoweredExpr, indent: string) -> void {
    match expr {
        is LoweredCall -> {
            lines.push("${indent}call :${display_type(expr.type)}")
            lines.push("${indent}  callee:")
            emit_expr(lines, expr.callee, "${indent}    ")
            for i in 0..<expr.args.len() {
                lines.push("${indent}  arg${i}:")
                emit_expr(lines, expr.args[i], "${indent}    ")
            }
        }
        is LoweredVirtualCall -> {
            lines.push("${indent}vcall ${expr.trait_name}.${expr.method} :${display_type(expr.type)}")
            lines.push("${indent}  recv:")
            emit_expr(lines, expr.receiver, "${indent}    ")
            for i in 0..<expr.args.len() {
                lines.push("${indent}  arg${i}:")
                emit_expr(lines, expr.args[i], "${indent}    ")
            }
        }
        is LoweredFieldAccess -> {
            lines.push("${indent}.${expr.field} :${display_type(expr.type)}")
            emit_expr(lines, expr.target, "${indent}  ")
        }
        is LoweredIndex -> {
            lines.push("${indent}index :${display_type(expr.type)}")
            lines.push("${indent}  on:")
            emit_expr(lines, expr.target, "${indent}    ")
            lines.push("${indent}  ix:")
            emit_expr(lines, expr.index, "${indent}    ")
        }
        is LoweredUnary -> {
            lines.push("${indent}${unary_op_name(expr.op)} :${display_type(expr.type)}")
            emit_expr(lines, expr.operand, "${indent}  ")
        }
        is LoweredBinary -> {
            lines.push("${indent}${binary_op_name(expr.op)} :${display_type(expr.type)}")
            lines.push("${indent}  l:")
            emit_expr(lines, expr.left, "${indent}    ")
            lines.push("${indent}  r:")
            emit_expr(lines, expr.right, "${indent}    ")
        }
        is LoweredIf -> {
            lines.push("${indent}if :${display_type(expr.type)}")
            lines.push("${indent}  cond:")
            emit_expr(lines, expr.cond, "${indent}    ")
            lines.push("${indent}  then:")
            emit_block(lines, expr.then_block, "${indent}    ")
            match expr.else_block {
                is null -> {}
                is LoweredBlock as else_block -> {
                    lines.push("${indent}  else:")
                    emit_block(lines, else_block, "${indent}    ")
                }
            }
        }
        is LoweredBlock -> {
            lines.push("${indent}block :${display_type(expr.type)}")
            emit_block(lines, expr, "${indent}  ")
        }
        is LoweredStructLit -> {
            lines.push("${indent}${display_type(expr.type)} {")
            for field in expr.fields {
                inline_field :: expr_inline(field.value)
                match inline_field {
                    is string -> { lines.push("${indent}  ${field.name}: ${inline_field}") }
                    is null -> {
                        lines.push("${indent}  ${field.name}:")
                        emit_expr(lines, field.value, "${indent}    ")
                    }
                }
            }
            lines.push("${indent}}")
        }
        is LoweredArrayLit -> {
            lines.push("${indent}array :${display_type(expr.type)}")
            for element in expr.elements {
                emit_expr(lines, element, "${indent}  ")
            }
        }
        is LoweredDataConst -> {
            lines.push("${indent}data_const #${expr.pool_index} :${display_type(expr.type)}")
        }
        is LoweredCast -> {
            lines.push("${indent}cast → ${display_type(expr.type)}")
            emit_expr(lines, expr.value, "${indent}  ")
        }
        is LoweredTypeCheck -> {
            lines.push("${indent}is ${display_type(expr.check_type)} :bool")
            emit_expr(lines, expr.value, "${indent}  ")
        }
        is LoweredIntrinsicCall -> {
            lines.push("${indent}@${expr.name} :${display_type(expr.type)}")
            for arg in expr.args {
                emit_expr(lines, arg, "${indent}  ")
            }
        }
        is LoweredArraySlice -> {
            lines.push("${indent}slice :${display_type(expr.type)}")
            lines.push("${indent}  on:")
            emit_expr(lines, expr.target, "${indent}    ")
            lines.push("${indent}  lo:")
            emit_expr(lines, expr.lo, "${indent}    ")
            lines.push("${indent}  hi:")
            emit_expr(lines, expr.hi, "${indent}    ")
        }
        // Variants rendered via the fallback — render
        // their canonical kind tag so they don't show up empty.
        _ -> {
            lines.push("${indent}${expr_kind_label(expr)}")
        }
    }
}

// Compact-line renderer. Returns `null` when the expr needs a vertical
// expansion (`emit_expr_compound` handles those). Renders literals,
// ident, unreachable → single line ; everything else returns null.
expr_inline :: fn(expr: LoweredExpr) -> string | null = @partial match expr {
    is LoweredIntLit      -> { "int(${format_int_value(expr.value, expr.type)}) :${display_type(expr.type)}" }
    is LoweredFloatLit    -> { "float(${expr.value}) :${display_type(expr.type)}" }
    is LoweredBoolLit     -> { "${expr.value}" }
    is LoweredNullLit     -> { "null" }
    is LoweredCharLit     -> { "char(0x${hex_string(expr.value)})" }
    is LoweredStringLit   -> { "${quote_simple(expr.value)} :string" }
    is LoweredIdent       -> { "${expr.symbol.name} :${display_type(expr.type)}" }
    is LoweredUnreachable -> { "unreachable(\"${expr.reason}\") :${display_type(expr.type)}" }
    _                     -> { null }
}

import "std/numbers"
/// Print `value` as a decimal string ; for `u32` / `u64` / `usize` types
/// reinterpret the i64 storage as the matching unsigned width so the
/// snapshot keeps `int(18446744073700000000)` rather than the sign-flipped
/// `int(-9551616)`.
format_int_value :: fn(value: i64, t: Type) -> string {
    if t is PrimitiveType {
        if t.name == "u64" || t.name == "usize" {
            if value < 0 { return "${u64(value)}" }
        }
        if t.name == "u32" {
            if value < 0 { return "${u32(value)}" }
        }
    }
    return "${value}"
}

hex_string :: fn(value: u32) -> string = to_hex(u64(value))

unary_op_name :: fn(op: LoweredUnaryOp) -> string = match op {
    .Neg    -> "neg"
    .Not    -> "not"
    .BitNot -> "bitnot"
}

export binary_op_name :: fn(op: LoweredBinaryOp) -> string = match op {
    .Add    -> "add"
    .Sub    -> "sub"
    .Mul    -> "mul"
    .Div    -> "div"
    .Mod    -> "mod"
    .Shl    -> "shl"
    .Shr    -> "shr"
    .BitAnd -> "bitand"
    .BitOr  -> "bitor"
    .BitXor -> "bitxor"
    .And    -> "and"
    .Or     -> "or"
    .Eq     -> "eq"
    .Neq    -> "neq"
    .Lt     -> "lt"
    .Lte    -> "lte"
    .Gt     -> "gt"
    .Gte    -> "gte"
}

// Per-variant label fallback for shapes rendered via `e.kind`.
// @partial: debug kind label — only a few shapes are named, the rest fall to "<unknown>".
expr_kind_label :: fn(expr: LoweredExpr) -> string = @partial match expr {
    is LoweredArrayLen     -> "LoweredArrayLen"
    is LoweredArrayPush    -> "LoweredArrayPush"
    is LoweredStringSlice  -> "LoweredStringSlice"
    is LoweredCellNew      -> "LoweredCellNew"
    is LoweredCellGet      -> "LoweredCellGet"
    is LoweredMakeClosure  -> "LoweredMakeClosure"
    is LoweredTypeConst    -> "LoweredTypeConst"
    _ -> "<unknown>"
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_dump_empty_project_header_only :: fn() -> void {
    project :: empty_test_project()
    assert_eq(dump_lowered(project, []), "# Lower")
}

empty_test_project :: fn() -> LoweredProject {
    return new_lowered_project()
}
