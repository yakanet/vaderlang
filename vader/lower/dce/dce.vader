// vader/lower/dce/dce: whole-program dead-function elimination.
//
// `prune_unreachable_fns` walks the call graph from the program roots
// (main, `@export` / `@extern`, optionally `@test`, plus every fn when
// the project has no `main`) and drops `LoweredFnDecl`s that nothing
// transitively references. A virtual call reaches the impl fn of a
// receiver only when reachable code holds a value of that receiver's
// struct: one a literal builds, a call returns, a constant holds or a root
// receives. The vtable keeps the entries whose fn survives. Structs and
// consts are preserved verbatim. The backends (bytecode / C / wasm) all consume the
// resulting `LoweredProject`, so pruning here is shared rather than
// per-emitter.
//
// Generic-fn instances share their generic's symbol id (Vader mono does
// not allocate a fresh id per instance : `instance_symbol` reuses
// `fn_sym.id` and distinguishes instances by mangle). The call
// graph is therefore followed by MANGLE first, then symbol id. That keeps
// DCE-survival ⟺ emit-resolvable : the emitter
// (`emit/bytecode/emit.vader::emit_bytecode_from_cfg`) reserves every fn under BOTH keys
// and resolves symbol-id-then-mangle, and a generic instance necessarily comes
// in through the mangle: `vader/lower/mono_fn.vader::build_fn_instance_decl` leaves
// its `origin.symbol` null on purpose. So a fn the emitter can resolve at a call
// site is exactly a fn this pass marks reachable.

module "vader/lower/dce"

import "std/collections"
import "std/iter"
import "toolchain/ast"
import "vader/core/symbol"
import "vader/core/types"
import "vader/lower/ir"

/// Drop functions unreachable from the program roots, returning a new
/// `LoweredProject`. Structs and consts survive verbatim.
///
/// @param lp          the lowered project to prune.
/// @param keep_tests  when true, `@test` fns count as roots (for the
///                    test-runner build) ; regular run / build drops them.
/// @return            a new `LoweredProject` with unreachable fns removed.
export prune_unreachable_fns :: fn(lp: LoweredProject, keep_tests: bool) -> LoweredProject {
    by_sym_id :: MutableMap<i32, LoweredDecl> {}
    by_mangle :: MutableMap<string, LoweredDecl> {}
    reachable_sym :: MutableSet<i32> {}
    reachable_mangle :: MutableSet<string> {}
    worklist: LoweredDecl[]: []
    // Struct symbols reachable code holds a value of (`visit_value`).
    built :: MutableSet<i32> {}
    // Every struct a type names counts, not only the outer one: a value can come
    // back nested in an array or a field, built where no literal is seen (by the
    // host, say).
    note_built :: fn(t: Type) -> void {
        st :: struct_backing(t)
        if st != null {
            built.add(st.symbol.id)
        }
    }

    has_main :: project_has_main(lp)

    // Index every fn decl + seed the worklist with roots. Generic
    // instances (type_arguments non-empty) key by mangle ; everything
    // else keys by symbol id.
    for [module_id, m] in lp.modules {
        is_entry :: module_id == lp.entry
        for d in m.decls {
            if d is LoweredFnDecl {
                sym :: d.origin.symbol
                // Index on exactly what the EMITTER indexes on, whether the decl
                // carries a symbol (`emit/bytecode/emit.vader::reserve_cfg_function`),
                // never on "is it a generic instance". The two are not the same
                // question, and answering the second broke the header invariant:
                //
                // A non-dispatching (Erased) generic instance KEEPS its symbol, and
                // the materialiser then collapses every sibling instance of that
                // symbol onto ONE emitted decl (erasure dedupe, `vader/lower/mono_fn.vader`).
                // The surviving decl carries whichever suffix sorted first, while
                // the call sites each name their own, so the emitter resolves them
                // through `function_index_by_symbol_id`. Indexing such a decl here
                // by MANGLE made its survival depend on a call site naming that
                // exact suffix, which is precisely what the dedupe guarantees won't
                // happen: DCE pruned a decl the emitter was about to resolve, and
                // the build died on `unresolved callee`.
                if sym is Symbol {
                    by_sym_id[sym.id] = d
                } else {
                    // Materialised impl members (`MutableMap.Index.at`) and
                    // dispatching generic instances (`put__i32__bool`) carry a
                    // synthetic NULL-symbol origin: their only identity is the
                    // mangle, so index them by mangle.
                    by_mangle[d.mangled] = d
                }
                if is_fn_root(d, is_entry, has_main, keep_tests) {
                    mark_reachable(d, reachable_sym, reachable_mangle)
                    worklist.push(d)
                    // A root with a body is called from outside the program,
                    // which builds the arguments it receives.
                    if d.body != null {
                        for param in d.params {
                            for_each_type(param.type, note_built)
                        }
                    }
                }
            } else if d is LoweredConstDecl {
                // Const initializers always survive ; walk their bodies so
                // any fn they call stays live.
                worklist.push(d)
            }
        }
    }

    // Fn-wrapped const accessors, and those that build a pooled const again for a
    // fresh read, stand in for the const decls `inline_consts` hoisted out, and
    // const initializers always survive (the `LoweredConstDecl`
    // arm above pushes every one). Each accessor carries a FRESH synthetic id, so
    // the call graph can't reach it by id ; seed it as a root here (a plain loop,
    // NOT a `visit_fn` closure capture, capturing `const_fn_wrap` in the closure
    // corrupts under GC) so it survives and its body, the const value: is walked.
    for w in chain(lp.const_fn_wrap.values(), lp.const_fresh_wrap.values()) {
        accessor :: by_sym_id[w.fn_symbol.id]
        if accessor != null && reachable_sym.add(w.fn_symbol.id) {
            worklist.push(accessor)
        }
    }

    // Index vtable entries by `"trait|method"` once so the virtual-call drain
    // is an O(1) bucket lookup, not an O(vtable) rescan per outer pass.
    impls_by_vtable_key :: MutableMap<string, LoweredVtableEntry[]> {}
    for e in lp.vtable_entries {
        key :: "${e.trait_name}|${e.method_name}"
        impls_by_vtable_key.get_or_put_with(key, () -> []).push(e)
    }

    pending_virtual: string[]: []
    pending_seen :: MutableSet<string> {}

    // Const accessors are seeded as roots above, so a `LoweredIdent` referencing
    // a fn-wrapped const need not mark anything here (its by-id lookup misses:
    // the accessor lives under its own synthetic id, not the const's).
    visit_fn :: fn(id: i32, name: string) -> void {
        inst :: by_mangle[name]
        if inst != null {
            if reachable_mangle.add(name) {
                worklist.push(inst)
            }
            return
        }
        named :: by_sym_id[id]
        if named != null {
            if reachable_sym.add(id) {
                worklist.push(named)
            }
        }
    }
    visit_virtual :: fn(trait_name: string, method: string) -> void {
        key :: "${trait_name}|${method}"
        if pending_seen.add(key) {
            pending_virtual.push(key)
        }
    }
    visit_value :: fn(t: Type) -> void {
        for_each_type(t, note_built)
    }

    // `inline_consts` moved these consts out of the decls, where the worklist
    // never meets them: their values are walked here.
    for value in lp.const_inline.values() {
        for_each_lowered_ref_in_expr(value, visit_fn, visit_virtual, visit_value)
    }
    for entry in lp.data_pool {
        if entry is AggregateDataPoolEntry {
            for_each_lowered_ref_in_expr(entry.literal, visit_fn, visit_virtual, visit_value)
        }
    }

    // Reachability fixpoint : drain the worklist (each decl's body adds
    // its callees and the structs it holds values of), then re-process
    // pending virtual calls: an impl fn counts once its (trait, method) pair
    // is seen and a value of its receiver is held. The outer loop repeats
    // until a virtual drain adds nothing new. `cursor`
    // is NOT reset across passes : the worklist only grows, so a stable
    // cursor walks each decl exactly once. `for i in 0..<n` can't replace
    // the inner loop: it would snapshot the bound and miss appends.
    cursor: i64 = 0
    for {
        for cursor < worklist.len() {
            d :: worklist[cursor]
            cursor += 1
            for_each_lowered_ref(d, visit_fn, visit_virtual, visit_value)
        }
        before :: worklist.len()
        for key in pending_virtual {
            bucket :: impls_by_vtable_key[key]
            if bucket != null {
                for e in bucket {
                    if receiver_is_built(e.struct_type, built) {
                        visit_fn(e.fn_symbol.id, e.fn_symbol.name)
                    }
                }
            }
        }
        if worklist.len() == before { break }
    }

    // Filter each module's fn decls ; keep structs + consts verbatim.
    out_modules :: MutableMap<string, LoweredModule> {}
    for [module_id, m] in lp.modules {
        kept: LoweredDecl[]: []
        for d in m.decls {
            if fn_survives(d, reachable_sym, reachable_mangle) { kept.push(d) }
        }
        out_modules[module_id] = LoweredModule {
            .module_id = m.module_id,
            .display_path = m.display_path,
            .decls = kept,
        }
    }
    vtable_entries: LoweredVtableEntry[]: []
    for e in lp.vtable_entries {
        if entry_survives(e, by_mangle, reachable_sym, reachable_mangle) {
            vtable_entries.push(e)
        }
    }
    return LoweredProject {
        ...lp,
        .modules = out_modules,
        .vtable_entries = vtable_entries,
    }
}

// True when a virtual call can land on a receiver of type `t`: reachable code
// holds a value of its struct. A receiver that is not a struct (a primitive, an
// enum, an array) is always taken. The test is per struct symbol: one instance
// of a generic struct built keeps the impls of all its instances.
receiver_is_built :: fn(t: Type, built: MutableSet<i32>) -> bool {
    st :: struct_backing(t) ?? return true
    return st.symbol.id in built
}

// True when the fn of vtable entry `e` survives, looked up under the key
// `visit_fn` marks it by: its mangle when a decl is indexed so, its symbol id
// otherwise.
entry_survives :: fn(
    e: LoweredVtableEntry,
    by_mangle: MutableMap<string, LoweredDecl>,
    reachable_sym: MutableSet<i32>,
    reachable_mangle: MutableSet<string>,
) -> bool {
    if by_mangle[e.fn_symbol.name] != null {
        return e.fn_symbol.name in reachable_mangle
    }
    return e.fn_symbol.id in reachable_sym
}

/// Mark a root fn reachable under the key its decl is indexed by: symbol id when
/// it carries a symbol, mangle otherwise. Same split as the indexing above and as
/// the emitter's reservation; keep the three in step.
///
/// Generic-fn instances share their generic's symbol id, so they are keyed,
/// marked and checked by mangle ; everything else by symbol id. When the index,
/// the mark and the survival check disagree, a fn can survive DCE that emit
/// cannot resolve, or the reverse, with no error.
mark_reachable :: fn(
    fn_decl: LoweredFnDecl, reachable_sym: MutableSet<i32>, reachable_mangle: MutableSet<string>,
) -> void {
    sym :: fn_decl.origin.symbol
    if sym is Symbol {
        reachable_sym.add(sym.id)
    } else {
        reachable_mangle.add(fn_decl.mangled)
    }
}

/// True when the decl survives the prune: a fn when it was reached, under the
/// key it is indexed by. Structs and consts always survive.
fn_survives :: fn(
    d: LoweredDecl, reachable_sym: MutableSet<i32>, reachable_mangle: MutableSet<string>,
) -> bool {
    if d is LoweredFnDecl {
        sym :: d.origin.symbol
        if sym is Symbol {
            return sym.id in reachable_sym
        }
        return d.mangled in reachable_mangle
    }
    return true
}

/// Root test : `main`, bodyless fns (`@extern` import shims), any
/// `@export` / `@extern` fn, `@test` when `keep_tests`, and (when the
/// project exposes no `main`): every fn of the ENTRY module. A no-main build
/// keeps its own whole surface ; dependencies (every non-entry module) are
/// pruned to the set reachable from the roots.
is_fn_root :: fn(fn_decl: LoweredFnDecl, is_entry: bool, has_main: bool, keep_tests: bool) -> bool {
    if is_entry && !has_main { return true }
    if fn_decl.body == null { return true }
    if fn_decl.origin.is_main { return true }
    ast :: fn_decl.origin.decl
    if ast is FnDecl {
        for dec in ast.decorators {
            if dec.name == "export" { return true }
            if dec.name == "extern" { return true }
            if keep_tests && dec.name == "test" { return true }
        }
    }
    return false
}

/// Whether the project exposes a top-level `main` fn (a fn with a body
/// flagged `origin.is_main`). When false, every user decl stays a root.
project_has_main :: fn(lp: LoweredProject) -> bool {
    for [_, m] in lp.modules {
        for d in m.decls {
            if d is LoweredFnDecl {
                if d.body != null && d.origin.is_main { return true }
            }
        }
    }
    return false
}
