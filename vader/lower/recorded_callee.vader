// vader/lower/recorded_callee — what a call runs, read off the typecheck's record.
//
// The typecheck files what each call site invokes (`TypedProgram.call_sites`,
// `vader/front/typecheck/call_sites.vader`). The lowering reads it here instead of
// choosing the callee again ; a site the record leaves to the lowering (a value of
// fn type, a member settled at each instance) keeps the lowering's own route.

module "vader/lower"

import "std/collections"
import "toolchain/ast"
import "toolchain/span"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/typecheck"

/// Index every free fn's symbol by its declaration's node id
/// (`LowerProjectCtx.fn_symbols`). A module's `fn_overloads` lists the fns it
/// declares, and its `fn_decls` their declarations.
///
/// @param typed        every module's typed program.
/// @param project_ctx  the context the index is built on.
populate_fn_symbols :: fn(typed: TypedProject, project_ctx: LowerProjectCtx) -> void {
    for [_, module_typed] in typed.modules {
        for [_, overloads] in module_typed.resolved.fn_overloads {
            for sym in overloads {
                decl :: module_typed.fn_decls[sym.id] ?? continue
                project_ctx.fn_symbols[decl.id] = sym
            }
        }
    }
}

/// The free fn the typecheck recorded at the site `role` plays at `node`, as the
/// symbol its declaring module gives it. Null for any other callee: an impl member,
/// a member dispatched through a trait, a value of fn type.
///
/// @param ctx   the fn-body context ; its module is the one `node` was checked in.
/// @param node  the site : a call, a fn named or taken as a value.
/// @param role  the part the site plays at `node`.
recorded_fn_symbol :: fn(ctx: FnLowerCtx, node: Expr, role: CallRole = .Call) -> Symbol | null {
    callee :: recorded_callee(ctx, node, role)
    if callee !is DirectFn {
        return null
    }
    return ctx.project.fn_symbols[callee.decl.id]
}

/// What the typecheck recorded at the site `role` plays at `node`.
///
/// @param node  the site.
/// @param role  the part the site plays at `node`.
recorded_callee :: fn(ctx: FnLowerCtx, node: Expr, role: CallRole) -> Callee | null =
    sites_of(ctx.typed.call_sites, role)[node.id]

/// A member called through its trait's vtable, the value's tag picking the impl.
RecordedVirtual :: struct {
    trait_key: string
}

/// What a site calls at an instance : an impl member, or a member through its
/// trait's vtable.
RecordedTarget :: UfcsMember | RecordedVirtual

/// What the site `role` plays at `node` calls at this instance, as the typecheck
/// recorded it : the impl member it names, or, for one chosen against a type
/// parameter, the member of the impl serving the instance ; for a bound's member,
/// the member of the impl of the bound's trait the instance implements, or the
/// vtable when the instance leaves the bound erased ; the vtable for a member of a
/// trait value or of a union. Null for a free fn, a value of fn type, no call, and
/// the `equals` of the parts a structural `==` compares.
///
/// @param node      the site.
/// @param role      the part the site plays at `node`.
/// @param receiver  the receiver's type at this instance ; an enum's surface type.
recorded_target :: fn(
    ctx: FnLowerCtx,
    node: Expr,
    role: CallRole,
    receiver: Type,
) -> RecordedTarget | null = callee_target(ctx, recorded_callee(ctx, node, role), receiver)

/// What `callee`, a site's record, calls on `receiver` at this instance : see
/// `recorded_target`.
///
/// @param callee    the site's record ; null for a site with none.
/// @param receiver  the receiver's type at this instance.
callee_target :: fn(
    ctx: FnLowerCtx,
    callee: Callee | null,
    receiver: Type,
) -> RecordedTarget | null {
    if callee == null {
        return null
    }
    return match callee {
        is DirectFn    -> settled_direct_member(ctx, callee, receiver)
        is BoundMember -> bound_target(ctx, callee, receiver)
        is TraitMember -> RecordedVirtual { .trait_key = callee.trait_key }
        is FnValue | Builtin | ErroneousCallee | UnsettledCallee | EachOf -> null
    }
}

/// The impl that runs the member `callee` names on `receiver` at this instance :
/// the one that declares it, or, for a member chosen against a type parameter, the
/// impl serving the instance. Null for a free fn.
///
/// @param callee    a site's record.
/// @param receiver  the receiver's type at this instance.
recorded_impl :: fn(ctx: FnLowerCtx, callee: DirectFn, receiver: Type) -> ImplEntry | null {
    entry :: ctx.project.impls.member_entry(callee.decl) ?? return null
    if !callee.per_instance {
        return entry
    }
    return ctx.project.impls.serving_impl(entry, impl_receiver(entry, receiver))
}

// The member `callee` names, built for `receiver` ; null for a free fn.
settled_direct_member :: fn(
    ctx: FnLowerCtx,
    callee: DirectFn,
    receiver: Type,
) -> UfcsMember | null {
    entry :: ctx.project.impls.member_entry(callee.decl) ?? return null
    target :: impl_receiver(entry, receiver)
    own_args :: own_args_of(ctx, callee, entry)
    if !callee.per_instance {
        return member_or_instance(ctx, target, callee.decl, entry, own_args)
    }
    serving :: ctx.project.impls.serving_impl(entry, target)
    return member_named(ctx, serving, target, callee.decl.name, own_args)
}

/// The trait a site recorded as `callee` dispatches through at run time on
/// `receiver`, as `callee_target` would find it, without building the impl member
/// it would otherwise call : a trait value's member, or a bound's the instance
/// leaves erased.
///
/// @param callee    the site's record ; null for a site with none.
/// @param receiver  the receiver's type at this instance.
dispatch_trait :: fn(callee: Callee | null, receiver: Type) -> string | null {
    if callee is TraitMember {
        return callee.trait_key
    }
    if callee is BoundMember && dispatches_at_run_time(receiver) {
        return callee.trait_key
    }
    return null
}

// A bound's member on `receiver` : through the vtable when the instance leaves the
// bound erased, else the impl of the bound's trait the instance implements.
bound_target :: fn(
    ctx: FnLowerCtx,
    callee: BoundMember,
    receiver: Type,
) -> RecordedTarget | null {
    if dispatches_at_run_time(receiver) {
        return RecordedVirtual { .trait_key = callee.trait_key }
    }
    return settled_bound_member(ctx, callee, receiver)
}

// Whether a value of type `t` picks its impl by its tag : an erased or still open
// type parameter, a trait value, a union.
dispatches_at_run_time :: fn(t: Type) -> bool = t is AnyType | TypeParamType | TraitType | UnionType

// The member of the bound's trait `receiver` implements : the impl at the bound's
// trait arguments when several impls of the trait cover it.
settled_bound_member :: fn(
    ctx: FnLowerCtx,
    callee: BoundMember,
    receiver: Type,
) -> UfcsMember | null {
    // A trait without arguments is implemented once on a type.
    if callee.trait_args.len() > 0 {
        args: Type[]: []
        for a in callee.trait_args {
            args.push(ctx.types.apply(a))
        }
        entry :: ctx.project.impls.impl_at_args(receiver, callee.trait_key, args)
        if entry != null {
            return member_named(ctx, entry, receiver, callee.member, callee.own_args)
        }
    }
    own :: resolve_impl_member(ctx, receiver, callee.trait_key, callee.member, callee.own_args)
    if own != null || receiver !is EnumType || callee.trait_key != core_trait_key(TRAIT_HASH) {
        return own
    }
    // An enum's built-in `Hash` is its stored integer's ; its built-in `Equals` is
    // the comparison itself, which the caller emits.
    held :: machine_integer_type(receiver.repr)
    return resolve_impl_member(ctx, held, callee.trait_key, callee.member)
}

// `receiver` as the impl `entry` is written for : a distinct reaches its backing's
// impl through its backing, an enum its repr's.
impl_receiver :: fn(entry: ImplEntry, receiver: Type) -> Type {
    if receiver !is DistinctType | EnumType || impl_base_key(receiver) == entry.target {
        return receiver
    }
    if receiver is DistinctType {
        return impl_receiver(entry, receiver.backing)
    }
    if receiver is EnumType {
        return machine_integer_type(receiver.repr)
    }
    return receiver
}

/// Whether a site recorded as `callee` runs an `equals` the comparison primop
/// answers : an enum's built-in one, or a bound's on an instance whose `T` is an
/// enum or a primitive.
///
/// @param callee  the record of a method call, or a method value, on an enum or
///                primitive receiver.
runs_builtin_equals :: fn(callee: Callee | null) -> bool {
    if callee is Builtin {
        return true
    }
    return callee is BoundMember && callee.trait_key == core_trait_key(TRAIT_EQUALS)
}

/// The type arguments the site `role` plays at `node` gives the generic fn `fn_sym`,
/// in its declaration's order, at this instance : those the typecheck recorded,
/// and, for one a call left to the instance (`count(it)` with `it: I` and
/// `I: Iterator<i32>`, which only the instance's own `I` settles), the binding the
/// arguments' types give at this instance. Null for a fn that takes none, and when
/// one stays unbound.
///
/// @param node    the call, or the name of a fn used as a value.
/// @param role    `.Call` or `.Reference`.
/// @param fn_sym  the fn it designates.
recorded_type_args :: fn(
    ctx: FnLowerCtx, node: Expr, role: CallRole, fn_sym: Symbol,
) -> Type[] | null {
    callee :: recorded_callee(ctx, node, role)
    if callee !is DirectFn || callee.decl.type_params.len() == 0 {
        return null
    }
    owner :: resolve_owner_typed(ctx, fn_sym.module) ?? return null
    declared :: declared_type_params(callee.decl, owner) ?? return null
    recorded :: callee.bindings ?? MutableMap<i32, Type> {}
    bindings :: MutableMap<i32, Type> {}
    for [id, bound] in recorded {
        bindings[id] = ctx.types.apply(bound)
    }
    if node is CallExpr && leaves_unbound(declared, bindings) {
        bind_at_instance(ctx, node, fn_signature(owner, fn_sym), bindings)
    }
    out: Type[]: []
    for tp in declared {
        out.push(bindings[tp.id] ?? return null)
    }
    return out
}

/// The instance of a generic fn named as a value at `node` (`name_of`, `M.f`, an
/// alias `g` of one, `id<i32>`), at the type arguments the typecheck recorded there,
/// registered for materialisation. Null when the site names none, or when a type
/// argument is not concrete at this instance.
///
/// @param node  the name.
/// @param type  the instance's fn type, as the site takes it.
recorded_fn_reference :: fn(ctx: FnLowerCtx, node: Expr, type: Type) -> LoweredIdent | null {
    fn_sym :: recorded_fn_symbol(ctx, node, .Reference) ?? return null
    mangled :: recorded_instance_mangle(ctx, node, .Reference, fn_sym) ?? return null
    return LoweredIdent { .span = node.span, .type = type, .symbol = instance_symbol(fn_sym, mangled) }
}

/// Whether the binding at `name_span` aliases a generic fn (`g :: id`) : it has no
/// slot, each use names the fn.
///
/// @param name_span  the binding's name.
is_fn_alias :: fn(ctx: FnLowerCtx, name_span: Span) -> bool {
    sym :: ctx.typed.resolved.idents[name_span.hash()] ?? return false
    return ctx.typed.fn_aliases[sym.id] != null
}

// Whether `bindings` leaves one of `declared` unbound.
leaves_unbound :: fn(declared: Symbol[], bindings: MutableMap<i32, Type>) -> bool {
    for tp in declared {
        if bindings[tp.id] == null {
            return true
        }
    }
    return false
}

// Bind each type parameter of the callee's signature `callee_type` that `bindings`
// leaves unbound, by unifying its parameters with the types the call's arguments
// take at this instance — a UFCS receiver first.
bind_at_instance :: fn(
    ctx: FnLowerCtx,
    call: CallExpr,
    callee_type: Type | null,
    bindings: MutableMap<i32, Type>,
) -> void {
    if callee_type !is FnType {
        return
    }
    args: Expr[]: []
    if call.callee is FieldExpr && ctx.typed.ufcs_receiver_types[call.callee.id] != null {
        args.push(call.callee.target)
    }
    for a in call.args {
        args.push(a.value)
    }
    for k in 0..<args.len() {
        if k >= callee_type.params.len() {
            break
        }
        actual :: default_if_free(ctx.types.apply(ctx.types.raw_expr_type(args[k])))
        unify_params(callee_type.params[k], actual, bindings, ctx)
    }
}
