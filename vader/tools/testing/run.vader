// vader/tools/testing/run: compile the tests of a module and run them on the VM.
//
// The module of an entry is loaded with its tests, and the compiler writes into it
// the entry that calls each by its rank (`vader/front/resolver/tests_stage.vader`).
// `lower_tests` lowers it with that entry as a root and names the tests from the
// reading the entry was written from, which is all `vader test --list` needs;
// `compile_tests` compiles it to bytecode and prepares the VM. Each test then runs
// alone on that VM (`run_test`), as a call of the entry: a trap fails it, a return
// passes it. What a compile reports goes to the caller, who prints it or shows its
// errors.

module "vader/tools/testing"

import "std/iter"
import "std/path"
import "std/time"
import "toolchain/ast"
import "toolchain/diagnostics"
import "vader/emit/bytecode"
import "vader/front/resolver"
import "vader/lower/dce"
import "vader/lower/ir"
import "vader/pipeline"
import "vader/vm"

/// The tests of one entry, lowered: what a listing names, before anything is
/// compiled to bytecode.
export LoweredTests :: struct {
    entry:   TestEntry
    /// The lowered project, pruned of what neither its entry nor a test reaches.
    project: LoweredProject
    /// The mangled name of the entry the tests run through (`tests$$run`), ""
    /// when the module declares none.
    runner:  string
    /// Every test of the entry module, each at its rank.
    tests:   DiscoveredTest[]
}

/// Why the VM cannot run the tests of a module that compiles: it refuses the
/// bytecode, or the module calls C the interpreter cannot reach.
export ModuleRefused :: struct {
    /// Worded to follow `vader test:`.
    message: string
}

/// The run of one test.
export TestRun :: struct {
    took:    Duration
    /// The message of the trap that failed it, null when it passed.
    failure: string | null = null
}

/// Lower the module of `entry` and find its tests.
///
/// @param entry               the module to compile (`test_entries`).
/// @param include_path_flags  search roots before every other (`--include-paths`).
/// @param project_root        the project of the run, null outside one.
/// @param diagnostics         takes what the front end and the lowering report,
///                            warnings included.
/// @return                    null when one of them is an error.
export lower_tests :: fn(
    entry: TestEntry,
    include_path_flags: string[],
    project_root: string | null,
    diagnostics: Diagnostic[],
) -> LoweredTests | null {
    pipeline :: prepare_evaluated_project_with(
        entry.path,
        include_path_flags,
        project_root,
        under_test = true,
    )
    declared :: declared_in_entry(pipeline.loaded)
    lowered :: lower_to_entry_from(pipeline)
    reported :: lowered.pre_diags + lowered.lower_diags
    diagnostics.push_all(reported)
    if any_error_diag(reported) {
        return null
    }
    runner :: runner_of(lowered.lowered)
    roots: i64[]: []
    if runner != null {
        roots.push(runner.origin.decl.id)
    }
    tests: DiscoveredTest[]: []
    for [test, rank] in declared.indexed() {
        tests.push(DiscoveredTest {
            .rank = rank,
            .display = test.name,
            .module = entry.module,
            .path = test.file.to_path(),
            .line = test.line,
        })
    }
    return LoweredTests {
        .entry = entry,
        .project = prune_unreachable_fns(lowered.lowered, roots),
        .runner = if runner == null { "" } else { runner.mangled },
        .tests = tests,
    }
}

// The tests of the entry module of `loaded`, each at the rank the entry the
// compiler wrote calls it by.
declared_in_entry :: fn(loaded: LoadedProject) -> DeclaredTest[] {
    module :: loaded.modules[loaded.entry] else return []
    return tests_declared(module.module.files.map((f) -> f.program).collect())
}

// The entry the compiler wrote into the entry module of `lp` to run its tests,
// null when the module declares none.
runner_of :: fn(lp: LoweredProject) -> LoweredFnDecl | null {
    module :: lp.modules[lp.entry] else return null
    for d in module.decls.filter_is<LoweredFnDecl>() {
        ast :: d.origin.decl
        if ast is FnDecl && ast.name == TESTS_ENTRY {
            return d
        }
    }
    return null
}

/// Compile the tests of `lowered` to bytecode, and prepare the VM that runs them.
///
/// @param lowered       the tests of a module, lowered (`lower_tests`).
/// @param project_root  as for `lower_tests`: its C is what the module's foreign
///                      calls reach.
/// @param diagnostics   takes what the back end reports.
/// @return              null when one of `diagnostics` is an error.
/// @error               `ModuleRefused` when the VM refuses the bytecode, or a
///                      foreign call has no adapter it can reach.
export compile_tests :: fn(
    lowered: LoweredTests,
    project_root: string | null,
    diagnostics: Diagnostic[],
) -> VmState | ModuleRefused | null {
    // No `debug` table: the VM never reads it.
    module :: cfg_to_bytecode(
        lowered.project,
        module_name_from_file(lowered.entry.path),
        EmitOptions {
            .optimize = true,
            .keep_mangles = [lowered.runner],
            .want_debug = false,
        },
        diagnostics,
    )
    if any_error_diag(diagnostics) {
        return null
    }
    state :: prepare(module) else is VerifyError {
        return ModuleRefused { .message = display_verify_error(state) }
    }
    problem :: attach_ffi_adapters(state, project_root, lowered.entry.path)
    if problem != null {
        return ModuleRefused { .message = problem }
    }
    return state
}

/// Run `test` alone on `state`, as a call of the entry of `lowered`. The threads it
/// leaves running are cancelled and fail it (`exec_fn`).
///
/// @param lowered  the tests of a module, lowered (`lower_tests`).
/// @param state    the VM `compile_tests` prepared for `lowered`.
/// @param test     one of the tests of `lowered`.
export run_test :: fn(lowered: LoweredTests, state: VmState, test: DiscoveredTest) -> TestRun {
    began :: monotonic()
    outcome :: exec_fn(state, lowered.runner, [I64Val(test.rank)])
    took :: began.since()
    if outcome is Trap {
        return TestRun { .took = took, .failure = outcome.message }
    }
    return TestRun { .took = took }
}
