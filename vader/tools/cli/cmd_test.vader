// vader/tools/cli/test — the `vader test` command.
//
// Discovers `@test` fns under a path, compiles ONE representative per module
// (so a test sees only that module's own import closure), runs them, and
// reports. The largest single command, split out so
// the dispatch in `main.vader` stays readable.
//
// Same module as `main.vader`: imports are file-scoped, declarations are not.

module "vader/tools/cli"

import "std/io"
import "std/iter"
import "std/path"
import "std/string"
import "std/collections"
import "cli"
import "std/process"
import "toolchain/ast"
import "vader/front/parser"
import "vader/front/resolver"
import "vader/lower/dce"
import "vader/lower/ir"
import "vader/emit/bytecode"
import "vader/pipeline"
import "vader/support/diagnostics"
import "vader/vm"
TTY :: import "std/tty"

/// `vader test [path]` — discover `@test` fns under `path` (default `.`),
/// compile each module keeping the tests as roots, and run every test in
/// isolation on the VM. A trap (e.g. a failed `assert`) is a FAIL ; clean
/// return is a pass.
///
/// @param args  positional args ; `args[0]` is the target path (file or dir).
/// @return      0 when every test passed, 1 on any failure, 2 when no `.vader`
///              files / no `@test` fns were found.
cmd_test :: fn(args: string[]) -> i32 {
    parsed :: parse_action("test", args)
    if parsed is i32 {
        return parsed
    }
    if reject_extra_positionals("test", parsed) {
        return 1
    }
    from_args :: parsed.action_file()
    target :: if from_args.as_string() == "" { ".".to_path() } else { from_args }
    files :: discover_vader_files(target)
    if files.len() == 0 {
        eprintln("vader test: no .vader files found under ${target}")
        return 2
    }
    reps :: test_entries(target, files)
    // A folder to walk is not an entry: the project is the one `vader test` runs
    // in, as for `vader build` with no argument. Spelled `""`, the working
    // directory, so that module ids stay relative to it.
    project_root :: project_at("")
    if project_root != null && checked_manifest("test", project_root) == null {
        return 1
    }
    ran :: MutableSet<string> {}
    total_pass := 0
    total_fail := 0
    files_with_tests := 0
    for rep in reps {
        le :: lower_to_entry(rep, project_root)
        if !flush_build_diags(le.pre_diags, le.lower_diags) {
            total_fail += 1
            continue
        }
        // keep_tests=true : `@test` fns survive the lower-level prune ; the
        // emit-level prune keeps them via EmitOptions.keep_mangles below.
        pruned :: prune_unreachable_fns(le.lowered, true)
        all_tests :: find_tests(pruned)
        // Run each unique @test once across the whole invocation.
        fresh: DiscoveredTest[]: []
        for t in all_tests {
            if !(t.mangled in ran) { fresh.push(t) }
        }
        if fresh.len() == 0 {
            continue
        }
        files_with_tests += 1
        println(rep)
        mangles :: fresh.map((t) -> t.mangled).collect()
        cfg_diags: Diagnostic[]: []
        module :: cfg_to_bytecode(
            pruned, module_name_from_file(rep),
            // `vader test` runs bytecode in the VM, which never reads `debug`.
            EmitOptions { .optimize = true, .keep_mangles = mangles, .want_debug = false },
            cfg_diags,
        )
        if !flush_build_diags([], cfg_diags) {
            total_fail += 1
            continue
        }
        state :: prepare(module)
        if state is VerifyError {
            eprintln("vader test: ${display_verify_error(state)}")
            total_fail += 1
            continue
        }
        problem :: attach_ffi_adapters(state, project_root, rep)
        if problem != null {
            eprintln("vader test: ${problem}")
            total_fail += 1
            continue
        }
        for t in fresh {
            ran.add(t.mangled)
            match tr :: exec_fn(state, t.mangled) {
                is Ok   -> {
                    println("  ${TTY.green("ok")} ${t.display}")
                    total_pass += 1
                }
                is Trap -> {
                    println("  ${TTY.red("FAIL")} ${t.display}")
                    println("    ${tr.message}")
                    total_fail += 1
                }
            }
        }
    }
    total :: total_pass + total_fail
    if total == 0 && files_with_tests == 0 {
        eprintln("vader test: no @test functions found under ${target}")
        return 2
    }
    println("")
    pass_part :: TTY.green("${total_pass} pass")
    fail_text :: "${total_fail} fail"
    fail_part :: if total_fail > 0 { TTY.red(fail_text) } else { fail_text }
    println("${total} tests | ${pass_part} | ${fail_part}")
    if total_fail == 0 {
        return 0
    }
    return 1
}

// Directories never descended into during `@test` discovery.
SKIP_TEST_DIRS: string[]: ["node_modules", "dist", "build", ".git", "target"]

/// One discovered `@test` fn : its mangled name (the VM entry) + the display
/// name shown in the report (the fn's source name).
DiscoveredTest :: struct {
    mangled: string
    display: string
}

/// Collect every `@test` fn in a lowered project : a `LoweredFnDecl` with a body
/// whose origin AST `FnDecl` carries a `@test` decorator. Display name is the
/// fn's source name (the rare `@test("custom")` string arg is not surfaced).
find_tests :: fn(lp: LoweredProject) -> DiscoveredTest[] {
    out: DiscoveredTest[]: []
    for [_, m] in lp.modules {
        for d in m.decls {
            if d is LoweredFnDecl {
                if d.body == null {
                    continue
                }
                ast :: d.origin.decl
                if ast is FnDecl {
                    if has_test_decorator(ast) {
                        out.push(DiscoveredTest {
                            .mangled = d.mangled,
                            .display = ast.name,
                        })
                    }
                }
            }
        }
    }
    return out
}

has_test_decorator :: fn(ast: FnDecl) -> bool {
    for dec in ast.decorators {
        if dec.name == "test" {
            return true
        }
    }
    return false
}

/// Recursively collect every `.vader` file under `target` (or `target` itself
/// when it's a single `.vader` file). Skips `SKIP_TEST_DIRS` + dot-entries.
discover_vader_files :: fn(target: Path) -> Path[] {
    out: Path[]: []
    if !exists(target.as_string()) { return out }
    if is_dir(target.as_string()) {
        walk_test_dir(target, out)
    } else if target.extension() == "vader" {
        out.push(target)
    }
    return out
}

walk_test_dir :: fn(dir: Path, out: Path[]) -> void {
    entries :: read_dir(dir.as_string())
    if entries is IOError {
        return
    }
    for name in entries {
        if name.starts_with(".") {
            continue
        }
        if name in SKIP_TEST_DIRS {
            continue
        }
        // `dir / name` is `join` — it handles the separator, unlike the
        // "${dir}/${name}" this used to build, which doubled the slash on a `dir`
        // already ending in one.
        full :: dir / name
        if is_dir(full.as_string()) {
            walk_test_dir(full, out)
        } else if name.ends_with(".vader") {
            out.push(full)
        }
    }
}

/// The entries `vader test` compiles for `target`. A file named on the command
/// line runs as given: the loader takes its whole folder module as the entry, so
/// the tests of its sibling files run with it, whatever the file itself holds.
///
/// @param target  the path the command was given.
/// @param files   the `.vader` files under it (`discover_vader_files`).
test_entries :: fn(target: Path, files: Path[]) -> Path[] {
    if target.extension() == "vader" {
        return files
    }
    return pick_module_representatives(files)
}

/// One entry per module that holds a test. Only the entry module of a compile is
/// lowered with its bodies, so a module's tests run only when it is the entry:
/// none runs through a module that imports it.
pick_module_representatives :: fn(files: Path[]) -> Path[] {
    by_dir :: MutableMap<string, Path[]> {}
    for f in files {
        // `parent()` yields "" for a bare filename ; the old `dir_of` said "."
        // and the grouping below keys on it, so preserve that.
        parent_dir :: f.parent().as_string()
        d :: if parent_dir == "" { "." } else { parent_dir }
        by_dir.get_or_put_with(d, () -> []).push(f)
    }
    out: Path[]: []
    for [d, group] in by_dir {
        for rep in group_representatives(d, group, group.map(file_facts).collect()) {
            out.push(rep)
        }
    }
    return out
}

/// The entries for the files of one directory: the directory itself when they
/// form one folder module that holds a test, else each file that holds one.
///
/// @param dir    the directory.
/// @param group  its `.vader` files.
/// @param facts  what each of them declares and holds, in the same order.
group_representatives :: fn(dir: string, group: Path[], facts: FileFacts[]) -> Path[] {
    if group.len() > 1 && is_folder_module(facts) {
        if facts.any_match((f) -> f.has_tests) {
            return [dir.to_path()]
        }
        return []
    }
    out: Path[]: []
    for i in 0..<group.len() {
        if facts[i].has_tests {
            out.push(group[i])
        }
    }
    return out
}

/// What test discovery needs from one file: the module it declares, and whether it
/// holds a test.
///
/// Read ONCE per file. The previous shape re-read every file for each question it
/// asked, and this function's whole history is about discovery being slow.
FileFacts :: struct {
    declared:  string
    /// Whether a line of the file opens with `@test`.
    has_tests: bool = false
}

// `declared` is "" for a file that declares no module (R2020 territory) or cannot
// be read — the callers treat that as "not a folder module", the conservative
// answer. A file that cannot be read counts as holding a test, so that its
// compile reports why rather than the file being skipped in silence.
file_facts :: fn(f: Path) -> FileFacts {
    src :: read_file_string(f.as_string())
    if src is IOError {
        return FileFacts { .declared = "", .has_tests = true }
    }
    header :: parse_module_header(src, f.as_string())
    declared :: if header is ModuleHeader { header.name } else { "" }
    return FileFacts { .declared = declared, .has_tests = holds_a_test(src) }
}

// Whether a line of `src` opens with `@test`.
holds_a_test :: fn(src: string) -> bool {
    for line in src.split("\n") {
        if line.trim().starts_with("@test") {
            return true
        }
    }
    return false
}

/// True when every file declares the SAME module — the language's own definition
/// of a folder module (a folder holds at most one module; mixed names are R2022).
/// A folder module is compiled once, as its directory: taking each of its files
/// for a module of its own would compile the whole folder once per file.
is_folder_module :: fn(facts: FileFacts[]) -> bool {
    if facts.len() == 0 {
        return false
    }
    first :: facts[0].declared
    if first == "" {
        return false
    }
    for f in facts {
        if f.declared != first {
            return false
        }
    }
    return true
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_same_declared_module_is_a_folder_module :: fn() -> void {
    facts :: [
        FileFacts { .declared = "probe" },
        FileFacts { .declared = "probe" },
    ]
    assert(is_folder_module(facts), "files declaring one module are one folder module")
}

@test test_per_file_modules_are_not_a_folder_module :: fn() -> void {
    facts :: [
        FileFacts { .declared = "probe/entry" },
        FileFacts { .declared = "probe/lib" },
    ]
    assert(!is_folder_module(facts), "different declared modules are not one module")
}

@test test_a_file_without_a_module_decl_is_not_a_folder_module :: fn() -> void {
    // Conservative: an unreadable or header-less file means "treat each file
    // separately" rather than silently collapsing the group.
    facts :: [
        FileFacts { .declared = "" },
        FileFacts { .declared = "probe" },
    ]
    assert(!is_folder_module(facts), "a missing module decl blocks the collapse")
}

@test test_a_module_without_tests_gets_no_representative :: fn() -> void {
    group :: ["probe/a.vader".to_path(), "probe/b.vader".to_path()]
    facts :: [FileFacts { .declared = "probe" }, FileFacts { .declared = "probe" }]
    assert_eq(group_representatives("probe", group, facts).len(), 0)
}

@test test_a_folder_module_with_a_test_is_its_folder :: fn() -> void {
    group :: ["probe/a.vader".to_path(), "probe/b.vader".to_path()]
    facts :: [
        FileFacts { .declared = "probe" },
        FileFacts { .declared = "probe", .has_tests = true },
    ]
    reps :: group_representatives("probe", group, facts)
    assert_eq(reps.len(), 1)
    assert_eq(reps[0].as_string(), "probe")
}

@test test_an_imported_per_file_module_keeps_its_own_entry :: fn() -> void {
    // Its tests run only as an entry: lowering the importer reaches none of them.
    group :: ["probe/entry.vader".to_path(), "probe/lib.vader".to_path()]
    facts :: [
        FileFacts { .declared = "probe/entry", .has_tests = true },
        FileFacts { .declared = "probe/lib", .has_tests = true },
    ]
    assert_eq(group_representatives("probe", group, facts).len(), 2)
}

@test test_holds_a_test_reads_line_starts :: fn() -> void {
    assert(holds_a_test("x :: 1\n@test\nt :: fn() -> void {}"), "a decorator line")
    assert(holds_a_test("    @test t :: fn() -> void {}"), "an indented one")
    assert(!holds_a_test("// runs no `@test`\nx :: 1"), "a mention in a comment")
}
