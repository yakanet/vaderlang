// vader/tools/cli/cmd_test: the `vader test` command.
//
// Its options, the `--filter` values it reads, and its report
// (`test_report.vader`). Finding the tests, compiling ONE entry per module (so a
// test sees only that module's own import closure) and running them belong to
// `vader/tools/testing`, which the test runner of the repository shares.
//
// Same module as `main.vader`: imports are file-scoped, declarations are not.

module "vader/tools/cli"

import "cli"
import "std/collections"
import "std/console"
import "std/glob"
import "std/io"
import "std/iter"
import "std/path"
import "std/string"
import "std/time"
import "vader/pipeline"
import "vader/support/diagnostics"
import "vader/tools/testing"

/// `vader test [path]`: discover `@test` fns under `path` (default `.`),
/// compile each module keeping the tests as roots, and run every test in
/// isolation on the VM. A trap (e.g. a failed `assert`) is a FAIL ; clean
/// return is a pass. `--filter` keeps the tests a glob matches (repeated, those
/// one of them matches; `-` reads them from stdin), `--list` names them without
/// running them, `--reporter=json` reports for a tool (`test_report.vader`).
///
/// @param args  positional args ; `args[0]` is the target path (file or dir).
/// @return      0 when every test passed, 1 on any failure, a module that does
///              not compile or an invalid filter, 2 when no `.vader` files / no
///              `@test` fns were found, or none the filter keeps.
cmd_test :: fn(args: string[]) -> i32 {
    began :: monotonic()
    parsed :: parse_action("test", args)
    if parsed is i32 {
        return parsed
    }
    if reject_extra_positionals("test", parsed) {
        return 1
    }
    filter_values :: parsed.string_flags("filter")
    filters :: read_test_filters(filter_values) else return 1
    reporter :: TestReporter {
        .format = report_format(parsed.string_flag("reporter", "text")),
        .listing = parsed.bool_flag("list"),
    }
    from_args :: parsed.action_file()
    target :: if from_args.as_string() == "" { ".".to_path() } else { from_args }
    files :: discover_vader_files(target)
    if files.len() == 0 {
        eprintln("vader test: no .vader files found under ${target.to_native()}")
        return 2
    }
    entries :: test_entries(target, files, filters)
    // A folder to walk is not an entry: the project is the one `vader test` runs
    // in, as for `vader build` with no argument. Spelled `""`, the working
    // directory, so that module ids stay relative to it.
    project_root :: project_at("")
    if project_root != null && checked_manifest("test", project_root) == null {
        return 1
    }
    ran :: Set<string> {}
    total_pass := 0
    total_fail := 0
    files_with_tests := 0
    for entry in entries {
        rep :: entry.path
        diagnostics: Diagnostic[]: []
        lowered :: entry.lower_tests(project_root, diagnostics)
        print_diagnostics(diagnostics)
        if lowered == null {
            reporter.module_failed(entry.module, rep, DOES_NOT_COMPILE)
            total_fail += 1
            continue
        }
        // Run each unique @test once across the whole invocation.
        fresh: DiscoveredTest[]: []
        for t in lowered.tests {
            if t.mangled !in ran && keeps(filters, t) {
                fresh.push(t)
                ran.add(t.mangled)
            }
        }
        if fresh.len() == 0 {
            continue
        }
        files_with_tests += 1
        reporter.module_header(entry.module, rep)
        if reporter.listing {
            for t in fresh {
                reporter.listed(t)
            }
            continue
        }
        compile_diagnostics: Diagnostic[]: []
        state :: lowered.compile_tests(fresh, project_root, compile_diagnostics)
        print_diagnostics(compile_diagnostics)
        if state == null {
            reporter.module_failed(entry.module, rep, DOES_NOT_COMPILE)
            total_fail += 1
            continue
        }
        if state is ModuleRefused {
            eprintln("vader test: ${state.message}")
            reporter.module_failed(entry.module, rep, state.message)
            total_fail += 1
            continue
        }
        for t in fresh {
            reporter.started(t)
            run :: state.run_test(t)
            failure :: run.failure
            if failure == null {
                reporter.passed(t, run.took)
                total_pass += 1
            } else {
                reporter.failed(t, run.took, failure)
                total_fail += 1
            }
        }
    }
    total :: total_pass + total_fail
    if total == 0 && files_with_tests == 0 {
        if filters.len() > 0 {
            options :: filter_options(filter_values)
            eprintln("vader test: no test under ${target.to_native()} matches ${options}")
        } else {
            eprintln("vader test: no @test functions found under ${target.to_native()}")
        }
        return 2
    }
    if !reporter.listing {
        reporter.summary(total_pass, total_fail, began.since())
    }
    if total_fail == 0 {
        return 0
    }
    return 1
}

// Why a module reports no test: its diagnostics are already on stderr.
DOES_NOT_COMPILE :: "the module does not compile"

// ---- --filter ---------------------------------------------------------------

// The filters of `--filter`, or null after saying which value is none. Each
// value is one filter, but `-` stands for the lines of stdin, a blank line
// none.
read_test_filters :: fn(values: string[]) -> TestFilter[] | null {
    texts :: filter_texts(values) else {
        eprintln("vader test: --filter -: ${texts.msg}")
        return null
    }
    filters :: parse_test_filters(texts)
    if filters is InvalidFilter {
        eprintln("vader test: invalid --filter `${filters.text}`: ${filters.reason}")
        return null
    }
    return filters
}

// The `--filter` options `values` come from, for a message.
filter_options :: fn(values: string[]) -> string =
    values.map((value) -> "`--filter ${value}`").collect().join(" or ")

// The values of `--filter`, `-` replaced by the lines of stdin.
filter_texts :: fn(values: string[]) -> string[] | IOError {
    texts: string[]: []
    for value in values {
        if value != "-" {
            texts.push(value)
            continue
        }
        input :: read_stdin_to_end() else return input
        for line in input.split("\n") {
            text :: line.trim()
            if text != "" {
                texts.push(text)
            }
        }
    }
    return texts
}
