// vader/tools/cli/build: the `vader build` command.
//
// The flags, a `.virt` input, the C for several targets at once
// (`--seed-targets`), and the diagnostic rendering. A project folder, of either
// kind, is built by the driver stream (`toolchain/build`); turning a prepared
// program into what the flags ask for, the split build included, is
// `vader/pipeline/output.vader`, which both paths share.
//
// Same module as `main.vader`: imports are file-scoped, declarations are not.

module "vader/tools/cli"

import "std/collections"
import "std/io"
import "std/iter"
import "std/path"
import "std/process"
import "std/string"
import "cli"
import "vader/support/target"
import "vader/front/resolver"
import "vader/bytecode"
import "vader/vm"
import "vader/pipeline"
Build :: import "toolchain/build"
import "vader/support/diagnostics"
import "vader/emit/c" { EmitOptions as CEmitOptions }
import "std/sort"

// ----------------------------------------------------------- build


// Split a comma-separated `--include-paths=a,b,c` flag value into a list (empty
// for an absent/empty flag). These prepend the module search order (GCC `-I`).
parse_include_path_flag :: fn(raw: string) -> string[] =
    if raw == "" { [] } else { raw.split(",") }

cmd_build :: fn(args: string[]) -> i32 {
    parsed :: parse_action("build", args)
    if parsed is i32 {
        return parsed
    }
    // Under `--run`, what follows the path is the program's.
    run :: parsed.bool_flag("run")
    if !run && reject_extra_positionals("build", parsed) {
        return 1
    }

    // `--target` is validated here rather than deeper, so a malformed target
    // costs nothing: `--target=native` (the old spelling) would otherwise be
    // swallowed in silence and the build would quietly produce something else.
    // `parse_target` names the offending fragment.
    target_flag :: parsed.string_flag("target", "")
    emit :: parsed.string_flag("emit", "executable")
    if emit == "bytecode" {
        eprintln("vader build --emit=bytecode: not yet implemented; "
            + "`--emit=bytecode-text` writes the text form")
        return 2
    }
    build_target: Target | null = null
    if target_flag != "" {
        parsed_target :: parse_target(target_flag)
        if parsed_target is TargetParseError {
            eprintln("vader build --target=${target_flag}: ${parsed_target.reason} "
                + "`${parsed_target.fragment}`")
            return 2
        }
        if parsed_target is Target { build_target = parsed_target }
    }

    // Read before the `--emit` branch so a seed request that cannot be honoured
    // is NAMED. Under the default `--emit=executable` it used to be dropped in
    // silence, and the build handed back one ordinary host binary.
    seed_flag :: parsed.string_flag("seed-targets", "")
    if seed_flag != "" && emit != "c" {
        eprintln("vader build: `--seed-targets` emits C for several targets — it needs `--emit=c`")
        return 2
    }
    if seed_flag != "" && target_flag != "" {
        eprintln("vader build: `--seed-targets` carries its own target list — drop `--target=${target_flag}`")
        return 2
    }
    no_split :: parsed.bool_flag("no-split")
    seed_targets :: seed_target_list(seed_flag, no_split) ?? return 2
    if run && emit != "executable" {
        eprintln("vader ${RUN_COMMAND}: `--emit=${emit}` produces no program to run")
        return 2
    }
    if run && build_target != null && build_target != host_target() {
        eprintln("vader ${RUN_COMMAND}: a program built for `${display_target(build_target)}` "
            + "does not run on this `${display_target(host_target())}` machine")
        return 2
    }

    request :: BuildRequest {
        .emit = emit,
        .out = parsed.string_flag("out", ""),
        .release = parsed.bool_flag("release"),
        .verify = parsed.bool_flag("verify"),
        .cc = parsed.string_flag("cc", default_cc()),
        .ldflags = parsed.string_flag("ldflags", ""),
        .include_paths = parse_include_path_flag(parsed.string_flag("include-paths", "")),
        .target = build_target,
        .seed_targets = seed_targets,
        .no_split = no_split,
    }
    // No argument is the current folder: a project, described by its
    // `build.vader` or its `vader.json`.
    selected :: parsed.string_flag("entry", "")
    input :: resolve_input("build", action_input(parsed), selected)
    if input is i32 {
        return input
    }
    // The C of several targets at once is the seed's shape, emitted from one file.
    if seed_flag != "" && input !is FileInput {
        eprintln("vader build: a project folder does not take `--seed-targets`; "
            + "name the entry file instead")
        return 2
    }
    no_hooks :: parsed.bool_flag("no-hooks")
    if no_hooks && input is DrivenProject {
        eprintln("vader build: `--no-hooks` ignores the `${DRIVER_FILENAME}` of `${input.dir}`, "
            + "which leaves nothing to build; name the entry file instead")
        return 1
    }
    if !run {
        return build_input(input, selected, request, no_hooks)
    }
    binary :: binary_to_run(input, selected, request)
    if binary is i32 {
        return binary
    }
    code :: build_input(input, selected, request, no_hooks)
    if code != 0 {
        return code
    }
    return run_built(binary, parsed.positionals.skip(1).collect())
}

// Build what `input` names, `selected` choosing among a project's entries.
build_input :: fn(
    input: ProjectInput,
    selected: string,
    request: BuildRequest,
    no_hooks: bool,
) -> i32 {
    match input {
        is FileInput -> {
            // A named file bypasses the driver of the folder the build runs in,
            // and has to: `bootstrap/build.sh` compiles the compiler by name, and
            // could not depend on a driver to do it. But silently skipping a
            // project's own rules is worse than the extra line — a house rule
            // that stops applying the moment you name a file is a rule nobody
            // can trust. `--no-hooks` says "I know" and quiets this.
            if !no_hooks && find_build_driver(current_working_directory()) != null {
                eprintln("vader build: `${DRIVER_FILENAME}` not applied — a named file bypasses it (use `vader build` alone, or --no-hooks to silence)")
            }
            return build_file(input.file, request)
        }
        is ManifestProject -> { return run_manifest_project(input, selected, request, .Build) }
        is DrivenProject -> {
            driver_request :: DriverRequest { .selected = selected, .build = request }
            return run_build_driver("build", input.dir, driver_request)
        }
    }
}

// How the messages about the program to run name the command.
RUN_COMMAND :: "build --run"

// Where the build of `input` writes the one program it makes, `selected` choosing
// among a project's entries, before the linker adds a `.exe`; the exit code
// after saying why `input` does not make exactly one. `selected` has already
// narrowed a `vader.json`'s entries.
binary_to_run :: fn(input: ProjectInput, selected: string, request: BuildRequest) -> Path | i32 {
    match input {
        is FileInput -> { return output_path(request.out, strip_input_suffix(input.file)) }
        is ManifestProject -> {
            entry :: sole_entry(RUN_COMMAND, input.dir, input.entries) ?? return 2
            return entry_binary(input.dir, entry.name, request)
        }
        is DrivenProject -> {
            // The driver declares the entries: it runs once to describe them all,
            // which compiles nothing.
            project :: described_project(RUN_COMMAND, input.dir, .Describe, "") ?? return 1
            described :: project_entries(input.dir, project.entries)
            entries :: chosen_entries(RUN_COMMAND, input.dir, described, selected) ?? return 1
            entry :: sole_entry(RUN_COMMAND, input.dir, entries) ?? return 2
            return entry_binary(input.dir, entry.name, request)
        }
    }
}

// The binary a build of the project `dir` writes for its entry `name`.
entry_binary :: fn(dir: string, name: string, request: BuildRequest) -> Path =
    output_path(request.out, project_entry_stem(dir, name, request.release, request.target))

// Run the program a build wrote at `binary` with `program_args`, on this
// process's terminal, and answer its exit code; 1 after saying why it did not
// run to an exit.
run_built :: fn(binary: Path, program_args: string[]) -> i32 {
    exe :: linked_binary(binary.as_string())
    if exe == null {
        eprintln("vader ${RUN_COMMAND}: the build left no program at `${binary}`")
        return 1
    }
    argv :: [launchable(exe)]
    argv.push_all(program_args)
    outcome :: run_attached(argv)
    if outcome is ProcessError {
        eprintln("vader ${RUN_COMMAND}: ${outcome.message()}")
        return 1
    }
    return outcome
}

// `path` as a program to launch. A name without a folder would be looked up on
// `PATH`, so one in the current folder is named through it.
launchable :: fn(path: string) -> string {
    if path.to_path().parent() == "" {
        return "./${path}"
    }
    return path
}

// The targets `--seed-targets` lists, empty without it, or null after saying
// why the list cannot be honoured: the seed set is split by construction, one
// unit per module shared across targets, so `--no-split` is refused rather than
// accepted and ignored.
seed_target_list :: fn(seed_flag: string, no_split: bool) -> Target[] | null {
    if seed_flag == "" {
        return []
    }
    if no_split {
        eprintln("vader build: `--seed-targets` always emits split C — drop `--no-split`")
        return null
    }
    return parse_target_list(seed_flag)
}

// The output a file builds to without `--out`: its path minus `.vader`, or minus
// `.virt` for a bytecode dump.
strip_input_suffix :: fn(file: Path) -> Path =
    if file.extension() == "virt" {
        file.as_string().trim_suffix(".virt").to_path()
    } else {
        file.as_string().trim_suffix(".vader").to_path()
    }

// Build or check the `vader.json` project through the driver that file stands
// for (`build_from_manifest`), run in this process: the engine every
// `build.vader` drives, with no driver to compile.
run_manifest_project :: fn(
    project: ManifestProject,
    selected: string,
    request: BuildRequest,
    mode: DriverMode,
) -> i32 {
    driver_request :: DriverRequest {
        .mode = mode,
        .selected = selected,
        .build = BuildRequest { ...request, .project_root = project.dir },
    }
    return Build.build_from_manifest(driver_request, project.manifest)
}

// Build one entry file as `request` asks, its outputs named after it without
// its extension unless `--out` names them.
build_file :: fn(file: Path, request: BuildRequest) -> i32 {
    stem :: strip_input_suffix(file)
    // A `.virt` input already holds its bytecode: there is no front end to run,
    // and so nothing to split.
    if file.extension() == "virt" {
        return build_virt(file, stem, request)
    }
    if request.emit == "c" && request.seed_targets.len() > 0 {
        return emit_c_for_targets(file, output_path(request.out, stem), request)
    }
    b :: prepared_program(file, request, "build") ?? return 1
    return emit_program(b, file, stem, request)
}

// Build a `.virt` text bytecode dump: its bytecode is already there, so there
// is nothing to prepare and nothing to split.
build_virt :: fn(file: Path, stem: Path, request: BuildRequest) -> i32 {
    module :: virt_module(file) ?? return 1
    b :: CfgBytecode {
        .entry = virt_entry_mangled(module),
        .pre_diags = [],
        .lower_diags = [],
        .in_scope_files = [],
        .module = module,
    }
    return emit_program(b, file, stem, BuildRequest { ...request, .no_split = true })
}

// `file` prepared as `request` asks, or null after printing what keeps it from
// being emitted. Its diagnostics print either way. `command` names the
// messages.
prepared_program :: fn(file: Path, request: BuildRequest, command: string) -> CfgBytecode | null {
    b :: prepare_program(file, request)
    if !ready_to_emit(b, command, file) {
        return null
    }
    return b
}

// Whether a prepared program may be emitted or run: no error among its
// diagnostics, which print either way, and an entry point (`entry_problem`).
ready_to_emit :: fn(b: CfgBytecode, command: string, file: Path) -> bool {
    if !flush_build_diags(b.pre_diags, b.lower_diags) {
        return false
    }
    problem :: entry_problem(b, file)
    if problem != null {
        eprintln("vader ${command}: ${problem}")
        return false
    }
    return true
}

// Render the merged pipeline diagnostics to stderr and report whether the
// build may proceed : any error-severity diagnostic aborts the build
// (return false) ; warnings / info still print.
flush_build_diags :: fn(pre: Diagnostic[], lower: Diagnostic[]) -> bool {
    all :: merge_diagnostics(pre, lower)
    if all.len() > 0 {
        eprintln(all.dump_diagnostics_with_file())
    }
    return !any_error_diag(all)
}

// Read a `.virt` text dump and reconstruct its `BytecodeModule`, or say why not.
virt_module :: fn(file: Path) -> BytecodeModule | null {
    src :: read_file_string(file.as_string())
    if src is IOError {
        eprintln("vader build: cannot read ${file}")
        return null
    }
    module :: parse_virt_bc(src)
    if module is VirtParseError {
        eprintln(module.display_virt_parse_error("vader build", file.as_string()))
        return null
    }
    return module
}

// Mangled name of the entry fn (the `is_main` function), or `""` when none.
virt_entry_mangled :: fn(module: BytecodeModule) -> string {
    for f in module.functions {
        if f.is_main {
            return f.name
        }
    }
    return ""
}

/// Emit the split C for SEVERAL targets against one shared atom universe.
///
/// The seed's shape. Atom ids are positions, so each target's own literal pool
/// numbers them differently and every file ends up differing by renumbering
/// alone — measured at 7026 renumbered lines against 2 of real content. Unioning
/// the pools first makes the ids agree, so the emitted C differs only where the
/// code does.
///
/// The union is SORTED rather than first-seen: the ids must not depend on the
/// order the targets were listed in.
///
/// @param file                the entry source.
/// @param out                 output stem. Units every target agreed on are
///                            written once as `<out>-<module>.c`; the ones that
///                            differ go to `<out>.<os>-<arch>-<module>.c`,
///                            beside the shared `<out>.split.h` / `.split.g.c`.
/// @param request             the targets to emit for (`seed_targets`, at least
///                            one), and what every target's front end shares:
///                            `--release`, which changes the bytecode, the search
///                            roots and `--verify`.
/// @return                    0 on success, 1 when any target fails to build.
emit_c_for_targets :: fn(file: Path, out: Path, request: BuildRequest) -> i32 {
    targets :: request.seed_targets
    mods: CfgBytecode[]: []
    for t in targets {
        b :: prepared_program(file, BuildRequest { ...request, .target = t }, "build") ?? return 1
        mods.push(b)
    }
    universe :: union_of_string_pools(mods)
    // The type table needs the same treatment as the atom table, and for the
    // same reason: it is index-addressed, so one extra type on one target shifts
    // every slot after it. Measured without this, from a single lambda in a
    // `@target` body: 11 282 renumbered lines against 238 of real content, and
    // shared units fell from 37 to 7.
    // Keyed ONCE per module, then reused by the union and by every rebase —
    // `bc_type_key` recurses through composite types, so re-deriving it per pass
    // re-walks that graph for every target.
    type_keys :: mods.map((m) -> type_keys_of(m.module)).collect()
    type_universe :: union_of_type_tables(type_keys)
    // ONE header name for every target. It holds the struct typedefs, the
    // prototypes and the atom count — all identical once the universe is shared
    // — so per-target copies would differ in nothing but their own `#include`
    // line, which is what a first attempt produced: 39 files "differing" on
    // line 1 alone.
    header_name :: split_header_name(out)
    progs: CProgram[]: []
    for i in 0..<targets.len() {
        // A literal a target holds but the universe does not means the pools were
        // unioned after something already emitted. Left unchecked it is a SILENT
        // atom alias — the id lands on whatever sits at that slot — so it is
        // named here instead.
        gaps :: atom_universe_gaps(mods[i].module.strings, universe)
        if gaps.len() > 0 {
            eprintln("vader build: atom universe misses ${gaps.len()} literal(s) for "
                + "${display_target(targets[i])}, first `${gaps[0]}`")
            return 1
        }
        progs.push(
            emit_c_split(
                rebase_types(mods[i].module, type_keys[i], type_universe),
                CEmitOptions {
                    ...native_c_options(mods[i].entry),
                    .atom_universe = universe,
                },
                header_name,
            ),
        )
    }
    return write_deduplicated(out, targets, progs)
}

// Write the programs with everything identical stored ONCE.
//
// A unit is shared when every target emitted the same bytes for it, and only
// then; the rest go under `<out>.<os>-<arch>.split.<k>.c`. Which units differ is
// data, not a rule — with one `@target` body in the closure it was exactly one
// out of 39, 28 KB against 11.3 MB.
write_deduplicated :: fn(out: Path, targets: Target[], progs: CProgram[]) -> i32 {
    first :: progs[0]
    // The shared header USUALLY matches across targets, because the `@extern`
    // declarations and their shims — the part a target changes most — live in
    // their own header. It does not have to: the synthetic type names
    // (`__Tuple_N`, `__lambda_env_N`) are numbered AFTER target selection, so a
    // function reached by one target only shifts every id behind it and the
    // header diverges by pure renumbering. `to_wide` / `from_wide`, called on
    // Windows and dead-stripped elsewhere, moved the whole table by two.
    //
    // So it falls back the same way the imports header and the globals unit
    // already do — one copy per target directory, found first on the include
    // path — rather than refusing a build whose output is perfectly valid.
    if progs.all_match((pr) -> pr.header == first.header) {
        if write_out(split_header_path(out), first.header) != 0 {
            return 1
        }
    } else {
        for i in 0..<targets.len() {
            target :: display_target(targets[i])
            if ensure_target_dir(out, target) != 0 {
                return 1
            }
            name :: split_header_name(out)
            if write_out("${out.parent()}/${target}/${name}".to_path(), progs[i].header) != 0 {
                return 1
            }
        }
    }
    // The imports header keeps a fixed NAME, so the units never mention a
    // target. When the targets agree it sits beside the shared header; when
    // they do not, each goes in a directory of its own and the build puts the
    // right one first on the include path.
    if progs.all_match((pr) -> pr.imports == first.imports) {
        if write_out(imports_header_path(out), first.imports) != 0 {
            return 1
        }
    } else {
        for i in 0..<targets.len() {
            target :: display_target(targets[i])
            if ensure_target_dir(out, target) != 0 {
                return 1
            }
            name :: imports_header_name(split_header_name(out))
            if write_out("${out.parent()}/${target}/${name}".to_path(), progs[i].imports) != 0 {
                return 1
            }
        }
    }
    if progs.all_match((pr) -> pr.globals == first.globals) {
        if write_out(split_globals_path(out), first.globals) != 0 {
            return 1
        }
    } else {
        for i in 0..<targets.len() {
            // Through `unit_path`, not a second spelling of the rule: the build
            // scripts compile one target directory, and the `.split.g.c` form
            // this used to write matched neither that nor the shared-globals
            // line. Masked today because every target's globals are identical,
            // so this branch never runs — and it would have surfaced as a
            // missing symbol at link time, far from the cause.
            if ensure_target_dir(out, display_target(targets[i])) != 0 {
                return 1
            }
            if write_out(unit_path(out, display_target(targets[i]), GLOBALS_UNIT), progs[i].globals) != 0 {
                return 1
            }
        }
    }
    // Units match by name: a target may hold one another lacks, as the unit of
    // a `CLibrary` only Windows reaches (`KERNEL32`). It goes in the directory
    // of each target that has it.
    for name in every_unit_name(progs) {
        shared :: unit_named(first, name)
        if shared != null && progs.all_match((pr) -> unit_named(pr, name) == shared) {
            if write_out(unit_path(out, "", name), shared) != 0 {
                return 1
            }
            continue
        }
        for i in 0..<targets.len() {
            text :: unit_named(progs[i], name) ?? continue
            if ensure_target_dir(out, display_target(targets[i])) != 0 {
                return 1
            }
            if write_out(unit_path(out, display_target(targets[i]), name), text) != 0 {
                return 1
            }
        }
    }
    return 0
}

// The names of the units any of `progs` holds, each once, in first-seen order.
every_unit_name :: fn(progs: CProgram[]) -> string[] {
    names: string[]: []
    for prog in progs {
        for name in prog.unit_names {
            if !(name in names) {
                names.push(name)
            }
        }
    }
    return names
}

// The unit `prog` names `name`, null when it holds none.
unit_named :: fn(prog: CProgram, name: string) -> string | null {
    for k in 0..<prog.unit_names.len() {
        if prog.unit_names[k] == name {
            return prog.units[k]
        }
    }
    return null
}

// `<os>-<arch>,<os>-<arch>,…`, or null after naming what is wrong: a fragment that
// names no target, or no target at all.
parse_target_list :: fn(spec: string) -> Target[] | null {
    out: Target[]: []
    for part in spec.split(",") {
        if part == "" {
            continue
        }
        parsed :: parse_target(part)
        if parsed is TargetParseError {
            eprintln("vader build --seed-targets: ${parsed.reason} `${parsed.fragment}`")
            return null
        }
        if parsed is Target {
            out.push(parsed)
        }
    }
    if out.len() == 0 {
        eprintln("vader build --seed-targets: no target named")
        return null
    }
    return out
}

// Every non-empty literal any target uses, sorted. Sorted and not first-seen so
// the ids are a property of the SET, not of the order the targets were given.
union_of_string_pools :: fn(mods: CfgBytecode[]) -> string[] {
    seen: MutableSet<string>: MutableSet<string> {}
    out: string[]: []
    for m in mods {
        for s in m.module.strings {
            if s != "" && seen.add(s) {
                out.push(s)
            }
        }
    }
    return sort(out, (a: string, b: string) -> compare_ascending(a, b))
}

/// Create the directory a per-target unit goes in. Idempotent — several units
/// share it, and the imports header may have made it already.
///
/// @param out     the `--out` stem.
/// @param target  the target's display name.
/// @return        0, or 1 after reporting why the directory could not be made.
ensure_target_dir :: fn(out: Path, target: string) -> i32 {
    dir :: "${out.parent()}/${target}"
    mk :: create_dir(dir)
    if mk is IOError {
        eprintln("vader build --seed-targets: cannot create `${dir}`: ${mk.message()}")
        return 1
    }
    return 0
}

