// vader/tools/cli/driver: the build-driver path, for a project folder with a
// `build.vader`.
//
// A project drives its own build by putting a `build.vader` at its root, holding
// a `build` fn (a reserved name, the way `main` is in a program). `vader build`,
// `check`, `run`, `dump`, `lint` and `graph` given that folder compile the driver
// and run it as a process of their own, which they serve the builds it
// configures (`driver_process.vader`, ADR 0145). The driver imports only
// `lib/`, so it compiles in a fraction of a second.
//
// Why a GENERATED entry rather than teaching the lowerer a second entry name:
// `is_main_decl` (`lower/decl.vader`) recognises the entry by the
// literal name `main`, and widening it would make every project's `build` fn an
// entry point. Worse, a driver compiled directly would be silently ELIMINATED:
// `lower/dce/dce.vader` roots only `is_main` and `@extern` decls, so `build`
// disappears and `emit_main` falls back to its `return 0` stub: a binary that
// does nothing, with no diagnostic. The generated `main` makes `build` reachable,
// so no DCE rule has to change.
//
// The shim is written BESIDE the driver, declaring the SAME module, and calls
// `build` directly rather than importing it. A single `.vader` file at a
// project root is not importable by module name (the loader maps a module to a
// folder of the same name), so `import "build"` cannot resolve a root-level
// `build.vader`: sharing the module sidesteps that, and needs no directory
// creation, which `std/io` cannot do anyway.

module "vader/tools/cli"

import "std/env"
import "std/console"
import "std/fs"
import "std/io"
import "std/iter"
import "std/path"
import "std/string"
import "std/string_builder"
import "toolchain/diagnostics"
import "crypto"
AST :: import "toolchain/ast"
Parse :: import "toolchain/parser"
import "toolchain/project"
import "toolchain/protocol"
import "vader/front/resolver"
import "toolchain/span"
import "vader/pipeline"
import "vader/support/text"
Server :: import "vader/build_server"

// ---- discovery ------------------------------------------------------------

/// Filename of the generated entry, written beside the driver. Named so it reads
/// as machine-written in a directory listing.
export DRIVER_ENTRY_FILENAME :: "vader_build_entry.vader"

// The module a driver's entry imports: the contract between a `build.vader`
// and the build it drives.
DRIVER_CONTRACT_MODULE :: "toolchain/build"

/// Locate the project's build driver.
///
/// Looked up in `root` only: no walk up the tree. A driver governs the project
/// it sits in, so finding one two directories up would silently build something
/// the user did not mean, the way a stray `Makefile` never does.
///
/// A `build.vader` is a driver when it declares `module "build"`
/// (`holds_build_driver`, the one rule every command and editor reads).
///
/// @param root  directory to look in: normally the invocation directory.
/// @return      path to the driver file, or `null` when the project has none,
///              in which case `vader build` keeps its current behaviour.
export find_build_driver :: fn(root: string) -> string | null {
    if !holds_build_driver(root) {
        return null
    }
    return join_path(root, DRIVER_FILENAME)
}

// ---- caching the driver binary --------------------------------------------

/// Key identifying what the cached driver binary was built from.
///
/// Two inputs decide that binary: the driver source, hashed by content, and the
/// build contract it is compiled against, the fingerprint of `lib/toolchain`,
/// which the driver also sends back in its configuration. A new `vader` with the
/// same `lib/toolchain` speaks the same protocol, so it reuses the driver.
///
/// What it deliberately does NOT catch: editing the rest of `lib/` (`std/`, the
/// C runtime) under a cached driver, which keeps the code it was linked with.
/// Delete `build/driver/` to force a rebuild.
///
/// @param driver_path  the project's `build.vader`.
/// @param fingerprint  the fingerprint of `lib/toolchain` (`contract_fingerprint`).
/// @return             a key that changes when either input does.
driver_input_key :: fn(driver_path: string, fingerprint: string) -> string {
    src :: read_file_string(driver_path)
    driver_hash :: match src {
        is string  -> src.hash()
        is IOError -> 0
    }
    return "${driver_hash}-${fingerprint}"
}

/// True when the driver of the project `root` can be reused for `key`.
///
/// Both halves matter: the stamp says what the binary was built from, and the
/// binary has to still be there: `build/` is a directory users delete.
///
/// @param root  the project folder.
/// @param key   the key of the current inputs (`driver_input_key`).
driver_is_current :: fn(root: string, key: string) -> bool {
    if linked_binary(driver_binary_path(root)) == null {
        return false
    }
    recorded :: read_file_string(driver_stamp_path(root)) else return false
    return recorded.trim() == key
}

// The driver binary of the project `root`.
driver_binary_path :: fn(root: string) -> string = join_path(driver_dir(root), "driver")

// The fingerprint of the build contract of the `lib/` this `vader` reads, which
// every driver it serves is compiled against: read once, `vader info` asking
// twice.
toolchain_fingerprint :: fn() -> string | IOError = toolchain_contract().fingerprint

ToolchainContract :: struct {
    fingerprint: string | IOError
}

@singleton
toolchain_contract :: fn() -> ToolchainContract =
    ToolchainContract { .fingerprint = read_toolchain_fingerprint() }

read_toolchain_fingerprint :: fn() -> string | IOError {
    library :: sidecar_root(LIBRARY_ROOT_DIR, LIBRARY_ROOT_MARKER) else return IOError {
        .msg = "no `lib/` beside `vader`",
    }
    return contract_fingerprint(library)
}

// ---- the compiler's digest ------------------------------------------------

/// A SHA-256 of the running compiler's executable, null when it cannot be read:
/// the compiler decides what everything it builds or writes holds.
compiler_digest :: fn() -> string | null =
    match exe :: read_file_bytes(current_executable_location(), READ_LIMIT_DEFAULT) {
        is u8[]    -> sha256(exe)
        is IOError -> null
    }

// ---- generated entry ------------------------------------------------------

/// Render the entry module that calls a driver's `build`.
///
/// The `main` the lowerer insists on, around the driver's `build`: `run_driver`
/// stops the builds it left open, and carries the fingerprint of the
/// `lib/toolchain` the driver is compiled against. Everything else the driver
/// builds itself through `new_build_context`.
///
/// @param fingerprint  the fingerprint of `lib/toolchain` (`contract_fingerprint`).
/// @return             the module source, ready to write next to a `module "..."`
///                     folder named `DRIVER_ENTRY_MODULE`.
export render_driver_entry :: fn(fingerprint: string) -> string {
    out :: StringBuilder {}
    // The banner is what `sweep_generated` deletes on; this shim escapes the
    // sweep only because it is written at the project root, outside the
    // generated tree.
    out.append("${Server.GENERATED_BANNER}\n")
    out.append("//\n")
    out.append("// Entry shim for this project's `${DRIVER_FILENAME}`: it shares that file's\n")
    out.append("// module so it can call `build` without an import, and gives the lowerer the\n")
    out.append("// `main` it recognises as the entry. Written before each driven build and\n")
    out.append("// removed after; delete it freely.\n")
    out.append("\n")
    out.append("module \"${DRIVER_MODULE}\"\n")
    out.append("\n")
    out.append("import \"${DRIVER_CONTRACT_MODULE}\"\n")
    out.append("\n")
    out.append("main :: fn(args: string[]) -> i32 {\n")
    out.append("    return run_driver(\"${fingerprint}\", build, args)\n")
    out.append("}\n")
    return out.to_string()
}

/// Path of the generated entry: beside the driver, sharing its module.
///
/// @param root  the project root, where the driver lives.
export driver_entry_path :: fn(root: string) -> string =
    join_path(root, DRIVER_ENTRY_FILENAME)

/// The `build.vader` of a project that declares `manifest`: the driver a
/// `vader.json` stands for, written out. `vader eject` writes it for a
/// project's `vader.json`, `vader new --build=driver` for its single entry.
///
/// `emit_native` rather than a hand-rolled drain, because `emit_native` IS that
/// drain (`toolchain/build::drain`) and a file that reimplements it would teach
/// the long way round. Declares `DRIVER_MODULE` because a single file at a
/// project root is not importable by module name; the compiler writes an entry
/// shim beside it that shares the module. See `vader/tools/cli/driver.vader`.
///
/// @param manifest  the search roots, entries and assets to declare.
render_driver :: fn(manifest: Manifest) -> string {
    out :: StringBuilder {}
    out.append("// ${DRIVER_FILENAME}: this project drives its own build.\n")
    out.append("//\n")
    out.append("// `vader build`, `check` and `run` given this folder compile this file and run\n")
    out.append("// `build`. Draining `ctx.messages()` IS the build, and `emit_native` is the\n")
    out.append("// shortcut that drains it. To lint or generate, plug a `BuildPlugin` with\n")
    out.append("// `ctx.use`, or walk the messages yourself; a `ctx.report(span, msg)` fails\n")
    out.append("// the build.\n")
    out.append("//\n")
    out.append("// `vader check`, `run` and `info` run this file without building: a step after\n")
    out.append("// the build (install, package) checks `ctx.mode() == .Build` first.\n")
    out.append("//\n")
    out.append("// The project folder is a module search root. Add another source directory\n")
    out.append("// through `ctx.include_paths` when you need one.\n")
    out.append("\n")
    out.append("module \"${DRIVER_MODULE}\"\n")
    out.append("\n")
    out.append("import \"${DRIVER_CONTRACT_MODULE}\"\n")
    out.append("\n")
    out.append("build :: fn(args: string[]) -> i32 {\n")
    out.append("    ctx :: new_build_context(args)\n")
    for root in manifest.include_paths {
        out.append("    ctx.include_paths.push(${string_literal(root)})\n")
    }
    for entry in manifest.entries {
        out.append("    ctx.add_entry(${string_literal(entry.name)}, ${string_literal(entry.path)})\n")
    }
    for asset in manifest.assets {
        out.append("    ctx.add_asset(${string_literal(asset)})\n")
    }
    out.append("    return ctx.emit_native()\n")
    out.append("}\n")
    return out.to_string()
}

// `text` as a Vader string literal: raw when it holds a `$` or a `\` that a
// raw literal can carry as is (`$VADER_HOME`), escaped otherwise.
string_literal :: fn(text: string) -> string {
    if (r"$" in text || "\\" in text) && holds_raw(text) {
        return "r\"${text}\""
    }
    return quote_vader(text)
}

// Whether a raw literal holds `text` as is: no `"`, which would end it, and no
// control character, which it cannot escape.
holds_raw :: fn(text: string) -> bool {
    for c in text {
        if c == '"' || u32(c) < 0x20 {
            return false
        }
    }
    return true
}

// ---- validation -----------------------------------------------------------

/// Check that a driver file declares a usable `build`, before anything is built.
///
/// Without this the failure surfaces as a compile error inside the GENERATED
/// entry: pointing at machine-written code for a mistake in the user's file.
/// Parsing the driver first costs one parse and lets the diagnostic land on the
/// driver itself, or on nothing at all when the fn is simply absent.
///
/// Parse errors are left alone: the real build reports them against the driver
/// with full spans, and duplicating them here would double every message.
///
/// @param path  the driver file, already known to exist.
/// @return      the diagnostic to report, or `null` when the driver is usable.
/// @error       H6001 when no `build` fn is declared ; H6002 when one is declared
///              with a signature the generated entry cannot call.
export validate_driver :: fn(path: string) -> Diagnostic | null {
    source :: match s :: read_file_string(path) {
        is string  -> s
        is IOError -> ""
    }
    if source == "" {
        return null
    }
    parsed :: Parse.parse_source(source, path)
    if parsed.errors.len() > 0 {
        return null
    }
    for d in parsed.program.decls.filter_is<AST.FnDecl>() {
        if d.name == DRIVER_ENTRY {
            return signature_problem(d)
        }
    }
    // Anchor on the file's first character: there is no declaration to point at,
    // and `empty_span()` would render as `<synthetic>`, naming no file at all.
    return hook_error(.MissingBuildEntry, file_head_span(path),
        "add `${DRIVER_ENTRY} :: fn(args: string[]) -> void`")
}

// The generated entry hands `build` to `run_driver`, which calls it, so two
// shapes have to hold: one parameter, and an `i32` result. The result matters: a
// failure that reports nothing (a binary not written, an asset not copied)
// reaches the exit only through it. A wrong parameter TYPE is still left to the
// typechecker, which names expected and actual better than this could.
signature_problem :: fn(f: AST.FnDecl) -> Diagnostic | null {
    if f.params.len() != 1 {
        return hook_error(.InvalidBuildEntrySignature, f.name_span,
            "`${DRIVER_ENTRY}` takes one parameter, `args: string[]`, and got ${f.params.len()}")
    }
    if !returns_i32(f) {
        return hook_error(.InvalidBuildEntrySignature, f.name_span,
            "`${DRIVER_ENTRY}` must return `i32`, the build's exit status")
    }
    return null
}

// True when the declared return type is spelled `i32`. Textual on purpose: this
// runs on a parsed, un-resolved AST, where there is no type to compare against.
returns_i32 :: fn(f: AST.FnDecl) -> bool {
    rt :: f.return_type else return false
    if rt is AST.IdentExpr {
        return rt.name == "i32"
    }
    return false
}

// ---- running the driver ---------------------------------------------------

/// Compile the project's driver and run it, serving it the builds it configures.
///
/// The driver decides what to build, so this function's job is to hand control
/// over: write the entry shim, build it, start the driver with its launch
/// arguments, serve its builds (`serve_driver`), and clean the shim up.
///
/// @param command  the command running the driver, which names its messages.
/// @param root     project root, where the driver and the shim live.
/// @param request  what the command asks of the builds. Its `cc` and `ldflags`
///                 also compile the driver itself.
/// @return         the worst of the builds' codes and the driver's exit code,
///                 or 1 when the driver could not be built or started.
/// @error          H6001 when the driver declares no `build`: surfaced as a
///                 compile error on the generated entry's call to it.
export run_build_driver :: fn(command: string, root: string, request: DriverRequest) -> i32 {
    driver :: find_build_driver(root) else return 1
    problem :: validate_driver(driver)
    if problem is Diagnostic {
        eprintln(dump_diagnostics_with_file([problem]))
        return 1
    }
    fingerprint :: toolchain_fingerprint() else is IOError {
        eprintln("vader ${command}: cannot read the build contract: ${fingerprint.msg}")
        return 1
    }
    key :: driver_input_key(driver, fingerprint)
    binary :: driver_binary_path(root)
    cc :: cc_or_default(request.build.cc)
    // A driver produces the same binary every time its inputs are unchanged,
    // which for anyone iterating on their project is every build but the first.
    if !driver_is_current(root, key) {
        build_code :: rebuild_driver(command, root, key, fingerprint, cc, request.build.ldflags)
        if build_code != 0 {
            return build_code
        }
    }
    exe :: linked_binary(binary) else {
        eprintln("vader ${command}: the driver build left no binary at ${binary.to_native()}")
        return 1
    }
    launch :: DriverLaunch {
        .project_root = root,
        .mode = request.mode,
        .cc = cc,
        .ldflags = request.build.ldflags,
    }
    argv :: [exe]
    argv.push_all(launch_args(launch))
    rooted :: DriverRequest {
        ...request,
        .build = BuildRequest { ...request.build, .project_root = root },
    }
    return serve_driver(command, argv, rooted, fingerprint)
}

/// Whether the project `root`'s driver is compiled as it stands, from its
/// `build.vader` and this toolchain's `lib/toolchain`: what `run_build_driver`
/// would run to describe the project without compiling first.
///
/// @param root  the project folder, holding a `build.vader`.
export driver_is_compiled :: fn(root: string) -> bool {
    driver :: find_build_driver(root) else return false
    fingerprint :: toolchain_fingerprint() else return false
    return driver_is_current(root, driver_input_key(driver, fingerprint))
}

// Write the entry shim, compile the driver, record what it was built from.
//
// The shim is removed whether or not the build worked: leaving a generated file
// behind after a failure is how a stale one gets compiled next time. The stamp is
// written only on success, so a failed build never looks fresh.
rebuild_driver :: fn(
    command: string,
    root: string,
    key: string,
    fingerprint: string,
    cc: string,
    ldflags: string,
) -> i32 {
    entry :: driver_entry_path(root)
    written :: write_file(entry, render_driver_entry(fingerprint)) else is IOError {
        eprintln("vader ${command}: cannot write the build entry at ${entry.to_native()}: "
            + written.msg)
        return 1
    }
    // Artefacts go under `build/`, not the project root: a driven build should
    // not litter the directory the user works in. `create_dir` makes the path
    // rather than requiring it to exist.
    artefacts :: driver_dir(root)
    made :: create_dir(artefacts) else is IOError {
        eprintln("vader ${command}: cannot create ${artefacts.to_native()}: ${made.msg}")
        remove_entry(entry)
        return 1
    }
    // The driver is a normal native build, always a debug one: it does little,
    // the project being compiled by `vader`. `toolchain/build` resolves in the
    // toolchain's `lib/`, and the driver's module through the entry's folder.
    // It does NOT inherit the user's `--no-split`, since a driver is a build
    // artefact nobody diffs or ships. It is built for this machine, the only one
    // whose toolchain it can invoke, whatever `--target` says of the project.
    request :: BuildRequest {
        .cc = cc,
        .ldflags = ldflags,
        .cc_jobs = DRIVER_CC_JOBS,
    }
    binary :: driver_binary_path(root)
    code :: build_driver_binary(command, Path(entry), Path(binary), request)
    remove_entry(entry)
    if code != 0 {
        return code
    }
    // A stamp we cannot write is not fatal: it only costs the next build a
    // rebuild, which is what happens today anyway.
    write_file(driver_stamp_path(root), key)
    return 0
}

// How many `cc` a driver's own build runs at once. Fewer than the user's own
// build, which runs one per processor: several driven builds may run at once,
// and one per processor each oversubscribes the machine. Eight is a floor on
// the runners this project targets (GitHub's are 4-core).
DRIVER_CC_JOBS: i32: 8

// Compile the driver's entry shim into its binary.
build_driver_binary :: fn(
    command: string,
    entry: Path,
    binary: Path,
    request: BuildRequest,
) -> i32 {
    b :: prepared_program(entry, request, command) else return 1
    return emit_program(b, entry, binary, request)
}

// Best-effort deletion: a leftover shim is a nuisance, not a failure, so the
// error is dropped. It matters that this really unlinks: a blanked file left in
// the project root would be a `.vader` that declares nothing.
remove_entry :: fn(path: string) -> void {
    remove(path)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_find_driver_absent :: fn() -> void {
    found :: find_build_driver("/nonexistent-project-root")
    assert(found == null, "a project without build.vader has no driver")
}

@test test_entry_shares_the_driver_module :: fn() -> void {
    src :: render_driver_entry("9f86d081")
    assert("module \"build\"" in src, "entry declares the driver's own module")
}

@test test_entry_does_not_import_the_driver :: fn() -> void {
    // A root-level `build.vader` is not importable by module name, so sharing
    // the module is the point: an import here would not resolve.
    src :: render_driver_entry("9f86d081")
    assert(!("import \"build\"" in src), "entry does not import what it shares a module with")
}

@test test_entry_calls_build_and_returns :: fn() -> void {
    src :: render_driver_entry("9f86d081")
    assert("run_driver(\"9f86d081\", build, args)" in src, "entry runs build, fingerprinted")
    assert("main :: fn(args: string[]) -> i32" in src, "entry declares the main the lowerer needs")
}

@test test_entry_is_marked_generated :: fn() -> void {
    src :: render_driver_entry("9f86d081")
    assert("do not edit" in src, "generated file says so")
}

@test test_entry_sits_beside_the_driver :: fn() -> void {
    // Same folder as the driver, so both contribute to one multi-file module.
    assert_eq(driver_entry_path("/some-project"), "/some-project/vader_build_entry.vader")
}

@test test_validate_driver_missing_build :: fn() -> void {
    // A driver with no `build` must be caught before anything is generated.
    path :: join_path(temp_dir(), "vader_driver_probe_missing.vader")
    write_file(path, "module \"build\"\n\nother :: fn() -> void {}\n")
    problem :: validate_driver(path)
    assert(problem is Diagnostic, "a driver without `build` is a problem")
    if problem is Diagnostic {
        assert_eq(problem.code.id, "H6001")
    }
}

@test test_validate_driver_wrong_arity :: fn() -> void {
    path :: join_path(temp_dir(), "vader_driver_probe_arity.vader")
    write_file(path, "module \"build\"\n\nbuild :: fn() -> void {}\n")
    problem :: validate_driver(path)
    assert(problem is Diagnostic, "a nullary `build` cannot be called by the entry")
    if problem is Diagnostic {
        assert_eq(problem.code.id, "H6002")
    }
}

@test test_validate_driver_accepts_the_expected_shape :: fn() -> void {
    path :: join_path(temp_dir(), "vader_driver_probe_ok.vader")
    write_file(path, "module \"build\"\n\nbuild :: fn(args: string[]) -> i32 { return 0 }\n")
    assert(validate_driver(path) == null, "the documented shape validates")
}

@test test_validate_driver_rejects_a_void_build :: fn() -> void {
    // A `void` driver could not fail a build: that is how a reported problem
    // used to exit 0.
    path :: join_path(temp_dir(), "vader_driver_probe_void.vader")
    write_file(path, "module \"build\"\n\nbuild :: fn(args: string[]) -> void {}\n")
    problem :: validate_driver(path)
    assert(problem is Diagnostic, "a void `build` cannot carry an exit status")
    if problem is Diagnostic {
        assert_eq(problem.code.id, "H6002")
    }
}

@test test_validate_driver_stays_quiet_on_parse_errors :: fn() -> void {
    // The real build reports these against the driver with full spans; saying
    // it twice would double every message.
    path :: join_path(temp_dir(), "vader_driver_probe_broken.vader")
    write_file(path, "module \"build\"\n\nbuild :: fn(args: string[]) -> i32 { (((\n")
    assert(validate_driver(path) == null, "parse errors are left to the real build")
}

@test
test_ejected_driver_declares_what_the_manifest_does :: fn() -> void {
    src :: render_driver(Manifest {
        .include_paths = [r"$VADER_HOME/third_party", "vendor"],
        .entries = [ManifestEntry { .name = "app", .path = "src/main.vader" }],
        .assets = ["data"],
    })
    assert(r"""ctx.include_paths.push(r"$VADER_HOME/third_party")""" in src, "a toolchain root is raw")
    assert("ctx.include_paths.push(\"vendor\")" in src, "a plain root is plain")
    assert("ctx.add_entry(\"app\", \"src/main.vader\")" in src, "the entry is added")
    assert("ctx.add_asset(\"data\")" in src, "and the asset")
    assert("module \"build\"" in src, "the driver declares `module \"build\"`")
    assert("ctx.mode() == .Build" in src, "and teaches when a step after the build runs")
}

@test
test_string_literal_escapes_what_a_raw_literal_cannot_hold :: fn() -> void {
    assert_eq(string_literal("a\"\$b"), "\"a\\\"\\\$b\"")
}

@test
test_a_driver_is_current_for_the_inputs_its_stamp_records :: fn() -> void {
    root :: join_path(temp_dir(), "vader_driver_probe_stamp")
    create_dir(driver_dir(root))
    write_file(driver_binary_path(root), "")
    write_file(driver_stamp_path(root), "key\n")
    assert(driver_is_current(root, "key"), "a driver of the same inputs is taken")
    assert(!driver_is_current(root, "other"), "a driver of other inputs is not")
    remove(root, RemoveOptions { .recursive = true })
}
