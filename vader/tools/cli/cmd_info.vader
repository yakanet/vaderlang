// vader/tools/cli/cmd_info: `vader info [--json] [<folder>]`, what a project folder
// describes.
//
// The entries, the module search roots, the assets and the source stages of a
// project, whichever of its `vader.json` and its `build.vader` describes it: for
// the second, the driver runs to describe itself and compiles nothing, and its
// stages are those it described then. A readable report by
// default, JSON with `--json` for tools. A path it resolves takes the
// separators of the OS; what the project declares is shown as written.
//
// Same module as `main.vader`: imports are file-scoped, declarations are not.

module "vader/tools/cli"

import "cli"
Json :: import "json"
import "std/collections"
import "std/console"
import "std/fs"
import "std/path"
import "std/string"
import "std/string_builder"
import "toolchain/ast"
import "toolchain/project"
import "toolchain/stage"
import "vader/front/resolver"
import "vader/pipeline"

/// `vader info [--json] [<folder>]`: print what a project folder describes.
///
/// @param args  the action's zone, then the folder, the current one by default.
/// @return      0, or 1 when the folder describes no project.
cmd_info :: fn(args: string[]) -> i32 {
    parsed :: parse_action("info", args)
    if parsed is i32 {
        return parsed
    }
    if reject_extra_positionals("info", parsed) {
        return 1
    }
    info :: project_info(
        action_input(parsed).as_string(),
        !parsed.bool_flag("no-driver-build"),
        parsed.bool_flag("no-hooks"),
    )
    if info is i32 {
        return info
    }
    if parsed.bool_flag("json") {
        println(render_info_json(info))
    } else {
        println(render_info_text(info))
    }
    return 0
}

// What `vader info` reports of a project.
ProjectInfo :: struct {
    /// The file that describes it, its `build.vader` or its `vader.json`.
    described_by: string
    /// Absolute when `project_info` builds it.
    root:         string
    /// What it declares, in the shape of a `vader.json`.
    manifest:     Manifest
    /// The source stages a load of it runs, in that order.
    stages:       ListedStage[] = []
}

// What the project folder `dir` describes, or the exit code after saying it
// describes none. A project with no entry is described all the same: saying so
// is the report's job. A driver not compiled as it stands is compiled first
// when `may_compile`; none runs under `no_hooks`.
project_info :: fn(dir: string, may_compile: bool, no_hooks: bool) -> ProjectInfo | i32 {
    if !is_dir(dir) {
        eprintln(not_a_folder("info", dir))
        return 1
    }
    described_by :: project_description("info", dir, ", so it describes no project") else return 1
    if no_hooks && described_by == DRIVER_FILENAME {
        eprintln(ignored_driver("info", dir, ""))
        return 1
    }
    manifest :: declared_project(dir, described_by, may_compile)
    if manifest is i32 {
        return manifest
    }
    return ProjectInfo {
        .described_by = described_by,
        .root = normalized_path(dir),
        .manifest = manifest,
        .stages = listed_source_stages(dir.to_posix()),
    }
}

// What the project `dir` declares in `described_by`, or the exit code after
// saying why it could not be read: `DRIVER_NOT_COMPILED_EXIT` for a driver not
// compiled as it stands, unless `may_compile`.
declared_project :: fn(dir: string, described_by: string, may_compile: bool) -> Manifest | i32 {
    if described_by == MANIFEST_FILENAME {
        manifest :: checked_manifest("info", dir) else return 1
        return manifest
    }
    if !may_compile && !driver_is_compiled(dir) {
        eprintln("vader info: the `${DRIVER_FILENAME}` of `${dir.to_native()}` is not compiled "
            + "as it stands; `vader build` compiles it")
        return DRIVER_NOT_COMPILED_EXIT
    }
    described :: described_project("info", dir, .Describe, "") else return 1
    return described
}

// The report a reader takes in: one labelled line per fact, each path with the
// absolute one it resolves to.
render_info_text :: fn(info: ProjectInfo) -> string {
    resolution :: resolve_paths(info)
    out :: StringBuilder {}
    out.append("project  ${info.root.to_native()} (${info.described_by})\n")
    for entry in resolution.entries {
        out.append("entry    ${entry.declared} -> ${entry.path.to_native()}${text_mark(entry)}\n")
    }
    if resolution.entries.len() == 0 {
        out.append("entry    none\n")
    }
    for root in resolution.roots {
        out.append("root     ${root.declared} -> ${root.path.to_native()}${text_mark(root)}\n")
    }
    for asset in resolution.assets {
        out.append("asset    ${asset.declared} -> ${asset.path.to_native()}${text_mark(asset)}\n")
    }
    for stage in info.stages {
        out.append("stage    ${stage_line(stage)}\n")
    }
    out.append("output   ${resolution.debug_output.to_native()} (debug)\n")
    out.append("output   ${resolution.release_output.to_native()} (release)")
    return out.to_string()
}

// A source stage in the text report: its name, where it comes from, the
// decorators it reads and those it writes, and whether a body stage follows it.
stage_line :: fn(stage: ListedStage) -> string {
    line :: StringBuilder {}
    line.append("${stage.spec.name} (${origin_of_stage(stage)})")
    if stage.spec.given.len() > 0 {
        line.append(" reads ${displayed_givens(stage.spec.given)}")
    }
    if stage.spec.generates.len() > 0 {
        line.append(" ; writes ${displayed_givens(stage.spec.generates)}")
    }
    if stage.gives_bodies {
        line.append(" ; gives bodies")
    }
    return line.to_string()
}

displayed_givens :: fn(givens: Given[]) -> string = givens.map(display_given).collect().join(", ")

// `driver` or `compiler`, where a stage comes from.
origin_of_stage :: fn(stage: ListedStage) -> string = if stage.from_driver { "driver" } else { "compiler" }

// A decorator a stage reads or writes: `@displayable`, or `@Greeting of `app``.
display_given :: fn(given: Given) -> string = match given {
    is DecoratedWith   -> "@${DecoratorName(given.marker).text}"
    is DecoratorOrigin -> "@${given.name} of `${given.module}`"
}

// What follows a resolved path in the text report: `(missing)`, the origin of a
// search root, or nothing.
text_mark :: fn(p: ResolvedPath) -> string {
    if !p.found         { return " (missing)" }
    if p.origin != null { return " (${p.origin})" }
    return ""
}

// The report a tool reads: the project in the shape of a `vader.json`, with
// `kind` (`manifest` or `driver`), `root`, and where its paths lead under
// `resolved`.
render_info_json :: fn(info: ProjectInfo) -> string {
    report :: Map<string, Json.JsonValue> {}
    report["kind"] = Json.JsonString { .value = kind_of(info) }
    report["root"] = Json.JsonString { .value = info.root.to_native() }
    write_manifest_json(report, info.manifest)
    report["resolved"] = resolution_json(resolve_paths(info))
    report["stages"] = stages_json(info.stages)
    return Json.stringify(Json.JsonObject { .entries = report }, 2)
}

// The `resolved` of the JSON report: `entries` by name, `roots` and `assets` by
// the path as declared, each with its absolute `path` and its `status`, `found`
// or `missing`, a found root with its `origin`; and the `output` folder of each
// profile.
resolution_json :: fn(resolution: Resolution) -> Json.JsonValue {
    output :: Map<string, Json.JsonValue> {}
    output["debug"] = Json.JsonString { .value = resolution.debug_output.to_native() }
    output["release"] = Json.JsonString { .value = resolution.release_output.to_native() }
    out :: Map<string, Json.JsonValue> {}
    out["entries"] = paths_json(resolution.entries, "name")
    out["roots"] = paths_json(resolution.roots, "declared")
    out["assets"] = paths_json(resolution.assets, "declared")
    out["output"] = Json.JsonObject { .entries = output }
    return Json.JsonObject { .entries = out }
}

// The `stages` of the JSON report, in the order they run: each with its `name`,
// its `origin` (`compiler` or `driver`), the decorators it reads (`given`) and
// writes (`generates`), each a `decorator` and, when a module declares it, its
// `module`, and whether a body stage of its name follows it (`bodies`).
stages_json :: fn(stages: ListedStage[]) -> Json.JsonValue {
    items: Json.JsonValue[]: []
    for stage in stages {
        item :: Map<string, Json.JsonValue> {}
        item["name"] = Json.JsonString { .value = stage.spec.name }
        item["origin"] = Json.JsonString { .value = origin_of_stage(stage) }
        item["given"] = givens_json(stage.spec.given)
        item["generates"] = givens_json(stage.spec.generates)
        item["bodies"] = Json.JsonBool { .value = stage.gives_bodies }
        items.push(Json.JsonObject { .entries = item })
    }
    return Json.JsonArray { .items = items }
}

// The decorators of `givens` in the JSON report, each its `decorator`, then the
// `module` that declares it, none for the compiler's.
givens_json :: fn(givens: Given[]) -> Json.JsonValue {
    items: Json.JsonValue[]: []
    for given in givens {
        item :: Map<string, Json.JsonValue> {}
        if given is DecoratedWith {
            item["decorator"] = Json.JsonString { .value = DecoratorName(given.marker).text }
        } else {
            item["decorator"] = Json.JsonString { .value = given.name }
            item["module"] = Json.JsonString { .value = given.module }
        }
        items.push(Json.JsonObject { .entries = item })
    }
    return Json.JsonArray { .items = items }
}

// `paths` as a JSON array, what the project writes for each under `label`.
paths_json :: fn(paths: ResolvedPath[], label: string) -> Json.JsonValue {
    items: Json.JsonValue[]: []
    for p in paths {
        item :: Map<string, Json.JsonValue> {}
        item[label] = Json.JsonString { .value = p.declared }
        item["path"] = Json.JsonString { .value = p.path.to_native() }
        item["status"] = Json.JsonString { .value = status_of(p) }
        if p.origin != null {
            item["origin"] = Json.JsonString { .value = p.origin }
        }
        items.push(Json.JsonObject { .entries = item })
    }
    return Json.JsonArray { .items = items }
}

status_of :: fn(p: ResolvedPath) -> string {
    if p.found {
        return "found"
    }
    return "missing"
}

// `driver` or `manifest`, the `kind` of `vader info --json`.
kind_of :: fn(info: ProjectInfo) -> string {
    if info.described_by == DRIVER_FILENAME {
        return "driver"
    }
    return "manifest"
}

// ---- where the paths lead -------------------------------------------------

// A path the project declares, resolved against its folder.
ResolvedPath :: struct {
    /// What the project writes: an entry's name, a search root or an asset.
    declared: string
    /// Absolute, without `.` or `..`.
    path:     string
    found:    bool
    /// A found search root's `toolchain` or `project`: whose modules it serves,
    /// which the library marker decides, never the spelling.
    origin:   string | null = null
}

// Where the paths of a project lead: the text and the JSON report read the same.
Resolution :: struct {
    entries:        ResolvedPath[]
    roots:          ResolvedPath[]
    assets:         ResolvedPath[]
    debug_output:   string
    release_output: string
}

resolve_paths :: fn(info: ProjectInfo) -> Resolution {
    entries: ResolvedPath[]: []
    for entry in info.manifest.entries {
        entries.push(resolved(entry.name, join_path(info.root, entry.path)))
    }
    bundled :: sidecar_root(LIBRARY_ROOT_DIR, LIBRARY_ROOT_MARKER)
    roots: ResolvedPath[]: []
    for root in info.manifest.include_paths {
        roots.push(resolved_root(root, manifest_root(info.root, root, bundled)))
    }
    assets: ResolvedPath[]: []
    for asset in info.manifest.assets {
        assets.push(resolved(asset, join_path(info.root, asset)))
    }
    return Resolution {
        .entries = entries,
        .roots = roots,
        .assets = assets,
        .debug_output = project_output_dir(info.root, false, null),
        .release_output = project_output_dir(info.root, true, null),
    }
}

// What the project writes as `declared`, at `path`.
resolved :: fn(declared: string, path: string) -> ResolvedPath {
    full :: normalized_path(path)
    return ResolvedPath {
        .declared = declared,
        .path = full,
        .found = exists(full),
    }
}

// The search root the project writes as `declared`, at `dir`.
resolved_root :: fn(declared: string, dir: string) -> ResolvedPath {
    root :: resolved(declared, dir)
    if !is_dir(root.path) {
        return ResolvedPath { ...root, .found = false }
    }
    return ResolvedPath { ...root, .origin = origin_label(origin_of_root(root.path)) }
}

origin_label :: fn(origin: ModuleOrigin) -> string {
    if origin == .Toolchain {
        return "toolchain"
    }
    return "project"
}

// ---- tests ----------------------------------------------------------------

import "std/iter"
import "std/testing"

@test
test_info_json_carries_the_project_in_the_shape_of_a_manifest :: fn() -> void {
    info :: ProjectInfo {
        .described_by = DRIVER_FILENAME,
        .root = "game",
        .manifest = Manifest {
            .include_paths = ["vendor"],
            .entries = [ManifestEntry { .name = "app", .path = "src/main.vader" }],
            .assets = ["sprite.png"],
        },
    }
    parsed :: Json.parse(render_info_json(info))
    if parsed !is Json.JsonObject {
        assert(false, "the report is a JSON object")
        return
    }
    assert_eq(
        parsed.entries.keys().collect().join(","),
        "kind,root,includePaths,entries,assets,resolved,stages",
    )
    kind :: parsed.entries["kind"]
    assert(kind is Json.JsonString && kind.value == "driver", "a driven project says so")
}

@test
test_info_json_of_a_manifest_carries_its_name_and_version :: fn() -> void {
    info :: ProjectInfo {
        .described_by = MANIFEST_FILENAME,
        .root = "game",
        .manifest = Manifest { .name = "game", .version = "1.2.0" },
    }
    parsed :: Json.parse(render_info_json(info))
    if parsed !is Json.JsonObject {
        assert(false, "the report is a JSON object")
        return
    }
    assert_eq(
        parsed.entries.keys().collect().join(","),
        "kind,root,name,version,includePaths,entries,assets,resolved,stages",
    )
}

@test
test_info_text_names_the_file_that_describes_the_project :: fn() -> void {
    info :: ProjectInfo {
        .described_by = MANIFEST_FILENAME,
        .root = "game",
        .manifest = Manifest {},
    }
    assert("project  game (vader.json)" in render_info_text(info), "the description file is named")
}

@test
test_info_text_marks_a_missing_root :: fn() -> void {
    info :: ProjectInfo {
        .described_by = MANIFEST_FILENAME,
        .root = "game",
        .manifest = Manifest { .include_paths = ["no/such/folder"] },
    }
    marked :: "${to_native("no/such/folder")} (missing)"
    assert(marked in render_info_text(info), "a missing root is marked")
}

@test
test_info_json_marks_a_missing_root :: fn() -> void {
    info :: ProjectInfo {
        .described_by = MANIFEST_FILENAME,
        .root = "game",
        .manifest = Manifest { .include_paths = ["no/such/folder"] },
    }
    report :: render_info_json(info)
    assert("\"status\": \"missing\"" in report, "a missing root is marked")
    assert(!("\"origin\"" in report), "a missing root has no origin")
}

@test
test_info_text_says_a_project_has_no_entry :: fn() -> void {
    info :: ProjectInfo {
        .described_by = DRIVER_FILENAME,
        .root = "game",
        .manifest = Manifest {},
    }
    assert("entry    none" in render_info_text(info), "an empty project says so")
}

@test
test_info_text_lists_the_source_stages_in_the_order_they_run :: fn() -> void {
    greeter :: SourceSpec {
        .name = "greeter",
        .given = [DecoratorOrigin { .module = "app", .name = "Greeting" }],
        .generates = [DecoratedWith { .marker = .Displayable }],
    }
    info :: ProjectInfo {
        .described_by = DRIVER_FILENAME,
        .root = "game",
        .manifest = Manifest {},
        .stages = [
            ListedStage {
                .spec = greeter,
                .from_driver = true,
                .gives_bodies = true,
            },
        ],
    }
    line :: "stage    greeter (driver) reads @Greeting of `app` ; writes @displayable ; gives bodies"
    assert(line in render_info_text(info), render_info_text(info))
}

@test
test_a_project_lists_the_source_stages_of_the_compiler :: fn() -> void {
    listed :: listed_source_stages(null)
    assert(listed.any_match((s) -> s.spec.name == "displayable" && !s.from_driver), "`displayable`")
}
