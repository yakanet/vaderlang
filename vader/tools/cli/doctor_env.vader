// vader/tools/cli/doctor_env: what `vader doctor` reads from the environment.
//
// Split from `cmd_doctor.vader` because it answers a different question: not
// "is the toolchain present" but "is what the RUNTIME will read what the user
// meant". The two share the `Check` shape and nothing else.
//
// The GC settings are read by `runtime/c/rt/gc_heap.c`, which stops every
// program at start on a value it cannot read whole, this one included: a
// setting seen here is one the runtime took as written.
//
// Same module as `cmd_doctor.vader`: imports are file-scoped, declarations are not.

module "vader/tools/cli"

import "std/env"
import "std/string"

// One GC setting the runtime reads as a number, and what it sets.
EnvSetting :: struct {
    name: string
    effect: string
}

GC_SETTINGS: EnvSetting[]: [
    EnvSetting { .name = "VADER_GC_YOUNG_BYTES", .effect = "initial size of a young semi-space" },
    EnvSetting { .name = "VADER_GC_YOUNG_CAP", .effect = "ceiling of adaptive young growth" },
    EnvSetting { .name = "VADER_GC_YOUNG_MAX", .effect = "hard limit of a young semi-space" },
    EnvSetting {
        .name = "VADER_GC_YOUNG_RATIO",
        .effect = "young target = old live / ratio, 0 turns adaptive sizing off",
    },
    EnvSetting {
        .name = "VADER_GC_OLD_MAX",
        .effect = "size of the old reservation, in place of the RAM share",
    },
    EnvSetting {
        .name = "VADER_GC_RAM_PERCENT",
        .effect = "share of physical RAM the old reservation is computed from",
    },
]

// One environment toggle the runtime reads, and what being on does.
//
// A table rather than a check apiece: only the consequence differs.
EnvToggle :: struct {
    name:      string
    /// `.Warn` when being on changes what the program does or costs orders of
    /// magnitude; `.Ok` when it only adds output.
    status:    CheckStatus
    effect:    string
    /// On whatever its value, `0` included, as the scheduler reads its clock.
    any_value: bool = false
}

ENV_TOGGLES: EnvToggle[]: [
    EnvToggle {
        .name = "VADER_GC_STRESS", .status = .Warn,
        .effect = "every allocation collects, 100 to 10000 times slower",
    },
    EnvToggle {
        .name = "VADER_GC_STRESS_MAJOR", .status = .Warn,
        .effect = "every allocation forces a full major collect",
    },
    EnvToggle {
        .name = "VADER_GC_CHECK_BOX", .status = .Warn,
        .effect = "box tags are validated on every access",
    },
    EnvToggle {
        .name = "VADER_GC_SCAN_ALL_OLD", .status = .Warn,
        .effect = "every minor rescans the whole old generation",
    },
    EnvToggle {
        .name = "VADER_GC_POISON", .status = .Warn,
        .effect = "every minor fills the young space it abandons with 0xA5",
    },
    EnvToggle {
        .name = "VADER_GC_NO_CSTACK_SCAN", .status = .Warn,
        .effect = "the collector skips its conservative stack scan and can free live objects",
    },
    EnvToggle {
        .name = "VADER_ASYNC_VIRTUAL_CLOCK",
        .status = .Warn,
        .effect = "async runs on a virtual clock: timers do not wait",
        .any_value = true,
    },
    EnvToggle {
        .name = "VADER_ALLOC_BY_TYPE", .status = .Ok,
        .effect = "allocations by type at exit",
    },
    EnvToggle { .name = "VADER_GC_PROFILE",   .status = .Ok, .effect = "GC stats at exit" },
    EnvToggle { .name = "VADER_GC_HISTOGRAM", .status = .Ok, .effect = "old live-set histogram" },
    EnvToggle { .name = "VADER_ATOM_PROFILE", .status = .Ok, .effect = "atom-table stats" },
    EnvToggle { .name = "VADER_PROFILE",      .status = .Ok, .effect = "per-pass compile timings" },
]

// Every environment override in force, one check each. Unset variables produce
// nothing: a report listing what is NOT set would bury what is.
check_environment :: fn() -> Check[] {
    out: Check[]: []
    for setting in GC_SETTINGS {
        raw :: get_env(setting.name) ?? continue
        if raw == "" {
            continue
        }
        out.push(check_ok(env_check_name(setting.name), setting.effect, "${setting.name}=${raw}"))
    }
    for toggle in ENV_TOGGLES {
        raw :: get_env(toggle.name) ?? continue
        if !toggle.is_on(raw) {
            continue
        }
        out.push(Check {
            .name = env_check_name(toggle.name),
            .status = toggle.status,
            .summary = toggle.effect,
            .detail = "${toggle.name}=${raw}",
        })
    }
    // Reported because it silently replaces the host default: a build that
    // invokes an unexpected compiler is otherwise hard to trace back to the shell.
    cc_env :: get_env("CC")
    if cc_env != null && cc_env != "" {
        out.push(check_ok(
            "cc-env",
            "`CC` names the C compiler used when `--cc` is absent",
            "CC=${cc_env}",
        ))
    }
    if out.len() == 0 {
        out.push(check_ok("environment", "no runtime override in force", ""))
    }
    return out
}

// Whether `toggle` set to `raw` is on, as the runtime reads it. `=false` is ON,
// which is worth reporting rather than guessing at, and is why the detail echoes
// the value verbatim.
is_on :: fn(toggle: EnvToggle, raw: string) = toggle.any_value || raw.is_flag_value_on()

// Check key for an environment variable: the lowercased name, so `--json`
// consumers key on `vader_gc_old_max` rather than on a report position.
env_check_name :: fn(var_name: string) = var_name.to_lower()
