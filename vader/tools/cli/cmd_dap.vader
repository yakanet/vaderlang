// vader/tools/cli/dap: the `vader dap` command.
//
// Serves the Debug Adapter Protocol over stdio, driving the embedded VM as a
// step debugger. Compiles with `want_debug` so the bytecode carries per-op
// positions, which is what makes stepping map back to source lines.
//
// Same module as `main.vader`: imports are file-scoped, declarations are not.

module "vader/tools/cli"

import "std/io"
import "std/path"
import "cli"
import "vader/emit/bytecode"
import "vader/pipeline"
import "vader/support/diagnostics"
import "vader/front/resolver"
import "vader/vm"
import "vader/tools/dap"
import "vader/lower/dce"

// `vader dap` : Debug Adapter Protocol server on stdio (VSCode F5). Drives the
// bytecode VM. The compile step is injected as a callback so `vader/tools/dap` stays
// free of a `vader/tools/cli` dependency (which would close an import cycle): the
// pipeline (lower → cfg → bytecode → prepare) lives here.
cmd_dap :: fn(args: string[]) -> i32 {
    parsed :: parse_action("dap", args)
    if parsed is i32 {
        return parsed
    }
    return run_dap_server(compile_for_dap)
}

// Compile a launch-target `.vader` to a `DapProgram`.
//   want_debug = true  : the DAP path is the debug path, the per-op `debug`
//                        table backs breakpoints, stepping, and the stack view.
//   optimize   = false : the "-O0 of the debugger". Skips
//                        slot coalescing + the single-expr inliner, so slots map
//                        1:1 to source locals (accurate Variables view) and
//                        lines stay monotone (clean stepping). A one-off
//                        debuggee doesn't need the optimiser.
compile_for_dap :: fn(program: string) -> DapProgram {
    // The DAP layer hands over a raw string (it is compiler internals, outside
    // this refactor); wrap once here so the body speaks `Path` like the rest.
    path :: program.to_path()
    // The debugger is handed a file by the editor, which knows no project: like
    // the language server, it takes the nearest project above the file. A
    // driven one is prepared first, as `vader run --project` does, for its
    // search roots and the modules it generates.
    project_root :: find_project_root(program)
    if project_root != null && is_driven_project(project_root) {
        _ :: prepared_project("dap", project_root, "") ?? return DapProgram {
            .state = null,
            .entry_index = -1,
            .error = "the build driver of `${project_root}` describes no project; the adapter's log says why",
        }
    }
    le :: lower_to_entry(path, project_root)
    pruned :: prune_unreachable_fns(le.lowered, false)
    cfg_diags: Diagnostic[]: []
    opts :: EmitOptions { .optimize = false, .keep_mangles = [], .want_debug = true }
    module :: cfg_to_bytecode(pruned, module_name_from_file(path), opts, cfg_diags)
    diags :: le.pre_diags + le.lower_diags + cfg_diags
    if any_error_diag(diags) {
        rendered :: diags.dump_diagnostics_with_file()
        return DapProgram { .state = null, .entry_index = -1, .error = rendered }
    }
    state :: prepare_debug(module)
    if state is VerifyError {
        return DapProgram { .state = null, .entry_index = -1, .error = display_verify_error(state) }
    }
    problem :: attach_ffi_adapters(state, project_root, path)
    if problem != null {
        return DapProgram { .state = null, .entry_index = -1, .error = problem }
    }
    entry :: entry_index_for_file(module, le.lowered, path, state.main_index)
    return DapProgram { .state = state, .entry_index = entry, .error = "" }
}
