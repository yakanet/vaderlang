// vader/tools/cli/cmd_new: the `vader new` command.
//
// Scaffolds a project, so the first one does not have to be reverse-engineered
// from the test fixtures. What a project actually needs is small, and none of it
// is discoverable:
//
//   * a `vader.json`, which declares the program (`entries`), so that the folder
//     builds and runs as it is, and where extra search roots go
//     (`includePaths`).
//   * `src/main.vader` declaring `module "src"`: the module name is the folder
//     name, and the compiler does not infer it from the filesystem.
//   * a `.gitignore` covering `build/`, where every artefact lands.
//
// What describes the BUILD is a choice: `--build`, or a question on a terminal:
// a `vader.json`, a `build.vader` the project drives itself with, or neither. The
// three are exclusive rather than layered, because a driver supersedes the
// manifest as the build's description instead of sitting on top of it. Offered as
// a choice, a driven build is not taught as the default, which is what had kept
// it out of the first cut.
//
// Same module as `main.vader`: imports are file-scoped, declarations are not.

module "vader/tools/cli"

import "cli"
import "std/io"
import "std/iter"
import "std/path"
import "std/process"
import "std/string"
import "std/string_builder"
TTY :: import "std/tty"
import "vader/front/resolver"
import "vader/support/version"

/// What describes a new project's build. Three exclusive shapes, not three
/// layers: a driver supersedes the manifest as the build's description rather
/// than sitting on top of it.
BuildSetup :: enum(u8) {
    /// Nothing but the program, run by naming its file: only its own folder is
    /// searched, which is enough for a single module and nothing more.
    None,
    /// A `vader.json`, declaring the program so that the folder builds and runs
    /// as it is, and holding the extra search roots.
    Manifest,
    /// A `build.vader`, which `vader build` finds and runs so the project decides
    /// its own compilation (SPEC §11). Needs the compiler's own sources
    /// reachable: `vader doctor` reports that as `compiler-sources`.
    Driver,
}

/// Folder the entry module lives in, and therefore the module it declares.
SOURCE_DIR :: "src"

/// Entry file written inside `SOURCE_DIR`.
ENTRY_FILENAME :: "main.vader"

// ---- the command ----------------------------------------------------------

/// `vader new [name]`: write a minimal project and say what each file is for.
///
/// With a name, it creates that directory; without one, it initialises the
/// working directory in place. The two differ in what counts as "already taken":
/// creating refuses ANY existing content, since writing into a directory the user
/// did not mean to name is the mistake that cannot be undone; in place, only an
/// existing `vader.json` refuses, because a directory with files in it is the
/// normal case: you are adding a manifest to work already started.
///
/// @param args  the action's zone; the optional name is the one positional, and
///              `--git` the only flag read.
/// @return      0 when every file was written, 1 on a rejected target or a
///              failed write. A `--git` that could not run is a warning, not a
///              failure: the project is already on disk by then.
cmd_new :: fn(args: string[]) -> i32 {
    parsed :: parse_action("new", args)
    if parsed is i32 {
        return parsed
    }
    if reject_extra_positionals("new", parsed) {
        return 1
    }
    // EVERY question first, then the writes. Asking after the files exist would
    // leave a half-made project behind a cancellation.
    asking :: TTY.is_tty()
    if asking {
        intro("vader new ${VADER_VERSION}")
    }
    chosen :: choose_target(parsed.action_file().as_string())
    if chosen is PromptError {
        return refuse(asking, unanswered(chosen))
    }
    // Checked before the other questions: a name typed on the command line that
    // cannot take the project should not wait for two more answers to be refused.
    target :: resolve_target(chosen)
    if target is ScaffoldError {
        return refuse(asking, target.msg)
    }
    setup :: choose_build(parsed)
    if setup is PromptError {
        return refuse(asking, unanswered(setup))
    }
    wants_git :: choose_git(parsed)
    if wants_git is PromptError {
        return refuse(asking, unanswered(wants_git))
    }
    written :: scaffold(target, setup)
    if written is ScaffoldError {
        return refuse(asking, written.msg)
    }
    complaint := ""
    if wants_git {
        complaint = init_git(target.dir) ?? ""
    }
    git_initialised :: wants_git && complaint == ""
    if asking {
        note(report_heading(target), report_files(setup, git_initialised))
        outro("next: ${next_commands(target, setup).join(", then ")}")
    } else {
        println(report(target, setup, git_initialised))
    }
    // After the report, so the warning is the last thing read rather than buried
    // above the list of files.
    if complaint != "" {
        eprintln(complaint)
    }
    return 0
}

// Say why no project was made, closing the session when one is open, and fail.
refuse :: fn(asking: bool, why: string) -> i32 {
    if asking {
        cancel(why)
    } else {
        eprintln("vader new: ${why}")
    }
    return 1
}

// Why no project was made when a question went unanswered. The step on screen
// already shows why it stopped, unless it could not be drawn at all.
unanswered :: fn(e: PromptError) -> string {
    if e.reason == .NoTerminal {
        return e.message
    }
    return "no project was made"
}

// ---- asking ---------------------------------------------------------------
//
// The prompts appear ONLY on a terminal, and only for what the command line did
// not already say. A pipe (a script, CI, an agent) gets exactly the behaviour
// this command shipped with, which is why none of its tests had to change: they
// spawn through a pipe and never see a question.

// What to scaffold. A name on the command line settles it; without one, a
// terminal is asked, Enter taking the working directory, and a pipe keeps the
// documented default of filling it.
choose_target :: fn(typed: string) -> string | PromptError {
    if typed != "" {
        return typed
    }
    if !TTY.is_tty() {
        return IN_PLACE
    }
    question :: "Where should the project be created? (Enter for this folder)"
    return text(question, IN_PLACE, target_problem)
}

// Why the folder answered cannot take the project, null when it can: the
// question is asked again instead of failing once every other is answered.
target_problem :: fn(answer: string) -> string | null {
    target :: resolve_target(answer)
    if target is ScaffoldError {
        return target.msg
    }
    return null
}

// Which build shape to scaffold. `--build` settles it; without the flag a
// terminal is asked and a pipe keeps the documented default, a manifest.
choose_build :: fn(parsed: ParsedArgs) -> BuildSetup | PromptError {
    named :: parsed.string_flag("build", "")
    if named != "" {
        return setup_named(named)
    }
    if !TTY.is_tty() {
        return .Manifest
    }
    picked :: select("How should this project build?", build_choices())
    if picked is PromptError {
        return picked
    }
    return setup_named(NEW_BUILD_SETUPS[picked].name)
}

// The prompt's options, rendered FROM the flag's declared values rather than
// restated beside them, so that a shape and its flag cannot drift apart.
build_choices :: fn() -> Choice[] =
    NEW_BUILD_SETUPS.map((v) -> Choice { .label = v.name, .hint = v.help }).collect()

// The flag's value, and the prompt's answer: both arrive as a name from
// `NEW_BUILD_SETUPS`, so one function decodes both. `std/cli` has already
// rejected anything outside the declared set, so the fall-through is unreachable
// rather than a real default.
setup_named :: fn(named: string) -> BuildSetup {
    if named == "none" {
        return .None
    }
    if named == "driver" {
        return .Driver
    }
    return .Manifest
}

// Whether to run `git init`. A `--git` in either spelling is a decision already
// made: only its ABSENCE on a terminal is a question, and off a terminal it
// stays the documented default of no.
choose_git :: fn(parsed: ParsedArgs) -> bool | PromptError {
    if parsed.flags["git"] != null {
        return parsed.bool_flag("git")
    }
    if !TTY.is_tty() {
        return false
    }
    return confirm("Initialise a git repository?", false)
}

// ---- the target -----------------------------------------------------------

/// What `vader new` decided to write, and where.
NewProject :: struct {
    /// Directory to write into, spelled as the user typed it: a relative path
    /// stays relative, so the report echoes what they can `cd` to.
    dir:      string
    /// The manifest's `name`: the directory's own last segment.
    name:     string
    /// True when this fills the working directory rather than a named one,
    /// which is what decides whether the report has a `cd` line to offer.
    in_place: bool
}

/// A refusal, with the sentence the user reads. Separate from a diagnostic:
/// diagnostic codes are for problems in a `.vader` file, and nothing here is
/// one, so no code is allocated.
ScaffoldError :: struct {
    msg: string
}

/// The path standing for "the working directory": what a bare `vader new` gets.
IN_PLACE :: "."

// Decide where to write, or refuse. See `cmd_new` for why the two modes differ.
resolve_target :: fn(raw: string) -> NewProject | ScaffoldError {
    if raw == "" {
        return ScaffoldError { .msg = "expected a project name, or none to fill this directory" }
    }
    if raw.starts_with("-") {
        return ScaffoldError { .msg = "`${raw}` looks like a flag, not a project name" }
    }
    // The project, and its one entry, take the folder's name.
    name :: project_name(raw)
    problem :: entry_name_problem(name)
    if problem != null {
        named :: "the project takes its folder's name, `${name}`"
        return ScaffoldError { .msg = "${named}, which ${problem}" }
    }
    if raw == IN_PLACE {
        if exists(join_path(IN_PLACE, MANIFEST_FILENAME)) {
            return ScaffoldError {
                .msg = "already a project: this directory holds a `${MANIFEST_FILENAME}`",
            }
        }
        return NewProject {
            .dir = IN_PLACE,
            .name = name,
            .in_place = true,
        }
    }
    if exists(raw) {
        if !is_dir(raw) {
            return ScaffoldError { .msg = "`${raw}` exists and is not a directory" }
        }
        entries :: read_dir(raw)
        if entries is IOError {
            return ScaffoldError { .msg = "`${raw}` cannot be read: ${entries.message()}" }
        }
        if entries.len() > 0 {
            hint :: "name a new directory, or run `vader new` inside it to fill it in place"
            return ScaffoldError { .msg = "`${raw}` exists and is not empty: ${hint}" }
        }
    }
    return NewProject {
        .dir = raw,
        .name = name,
        .in_place = false,
    }
}

// The name a project takes: its folder's, the working directory's in place.
project_name :: fn(raw: string) -> string {
    if raw == IN_PLACE {
        return directory_name(current_working_directory())
    }
    return directory_name(raw)
}

/// Last segment of a path, whatever separator wrote it: the project's name.
///
/// Windows hands `current_working_directory` back `/`-separated already, but a
/// name the user TYPED can carry either, so it is normalised here rather than
/// assumed.
directory_name :: fn(path: string) -> string {
    name :: path.to_posix().to_path().normalize().filename()
    if name == "" {
        return path
    }
    return name
}

// ---- writing --------------------------------------------------------------

// Write the three files. Creating `<dir>/src` creates `<dir>` on the way: the
// intrinsic is `mkdir -p`, and an existing directory is success.
scaffold :: fn(project: NewProject, setup: BuildSetup) -> null | ScaffoldError {
    made :: create_dir(join_path(project.dir, SOURCE_DIR))
    if made is IOError {
        return ScaffoldError {
            .msg = "cannot create `${project.dir}/${SOURCE_DIR}`: ${made.message()}",
        }
    }
    if setup == .Manifest {
        manifest :: write_one(
            join_path(project.dir, MANIFEST_FILENAME),
            render_manifest(project.name),
        )
        if manifest is ScaffoldError {
            return manifest
        }
    }
    if setup == .Driver {
        driver :: write_one(
            join_path(project.dir, DRIVER_FILENAME),
            render_driver(scaffolded_manifest(project.name)),
        )
        if driver is ScaffoldError {
            return driver
        }
    }
    entry :: write_one(
        join_path(join_path(project.dir, SOURCE_DIR), ENTRY_FILENAME),
        render_entry(project.name),
    )
    if entry is ScaffoldError {
        return entry
    }
    return write_one(join_path(project.dir, ".gitignore"), render_gitignore())
}

write_one :: fn(path: string, content: string) -> null | ScaffoldError {
    res :: write_file_string(path, content)
    if res is IOError {
        return ScaffoldError { .msg = "cannot write `${path}`: ${res.message()}" }
    }
    return null
}

/// The manifest: the identity, the include-path list the loader consults, the
/// one program `vader build` makes, named after the project, and the assets. An
/// empty list is not filler: it is where a second search root, or a file to
/// copy beside the binary, goes.
render_manifest :: fn(name: string) -> string =
    stringify_manifest(scaffolded_manifest(name), 4) + "\n"

/// The entry module. It declares `module "${SOURCE_DIR}"` because the module IS
/// the folder: the one rule about the layout that nothing else states.
render_entry :: fn(name: string) -> string {
    greeting :: string_literal("hello from ${name}")
    out :: StringBuilder {}
    out.append("// ${SOURCE_DIR}/${ENTRY_FILENAME}: entry point of ${name}.\n")
    out.append("\n")
    out.append("module \"${SOURCE_DIR}\"\n")
    out.append("\n")
    out.append("import \"std/io\"\n")
    out.append("\n")
    out.append("main :: fn() -> i32 {\n")
    out.append("    println(${greeting})\n")
    out.append("    return 0\n")
    out.append("}\n")
    return out.to_string()
}

// What a scaffolded project declares: its name, a first version, and one entry
// named after it. The manifest says it in JSON (`render_manifest`), the driver
// in code (`render_driver`), which has no place for the name and the version.
scaffolded_manifest :: fn(name: string) -> Manifest = Manifest {
    .name = name,
    .version = "0.1.0",
    .entries = [ManifestEntry { .name = name, .path = "${SOURCE_DIR}/${ENTRY_FILENAME}" }],
}

/// One line: `build/` holds every artefact, the binary, the generated C, a
/// driver's own build, and the generated module tree.
render_gitignore :: fn() -> string = "build/\n"

// `--git`, and it WARNS rather than fails: the scaffold is already on disk by the
// time this runs, so refusing after the fact would leave a project plus an error.
init_git :: fn(dir: string) -> string | null {
    res :: spawn(["git", "init", dir])
    if res is ProcessError {
        hint :: "the project is written, initialise it yourself"
        return "vader new: `git init` could not run (${res.msg}): ${hint}"
    }
    if res.exit != 0 {
        return "vader new: `git init` exited ${res.exit}: ${res.stderr.trim()}"
    }
    return null
}

// ---- reporting ------------------------------------------------------------

// What was written and what each file is for: the part that makes this a
// teaching command rather than three `write_file_string` calls.
report :: fn(project: NewProject, setup: BuildSetup, git_initialised: bool) -> string {
    out :: StringBuilder {}
    out.append("vader new: ${report_heading(project)}\n")
    for line in report_files(setup, git_initialised) {
        out.append("  ${line}\n")
    }
    out.append("\n")
    for command in next_commands(project, setup) {
        out.append("  ${command}\n")
    }
    return out.to_string()
}

// Where the project went.
report_heading :: fn(project: NewProject) -> string {
    if project.in_place {
        return "initialised ${project.name} here"
    }
    return "wrote ${project.dir}/"
}

// One line per file written, with what it is for.
report_files :: fn(setup: BuildSetup, git_initialised: bool) -> string[] {
    lines: string[]: []
    if setup == .Manifest {
        purpose :: "declares the program; `vader build` writes it to build/"
        lines.push(file_line(MANIFEST_FILENAME, purpose))
    }
    if setup == .Driver {
        lines.push(file_line(DRIVER_FILENAME, "drives the build; run it with a bare `vader build`"))
    }
    entry :: "${SOURCE_DIR}/${ENTRY_FILENAME}"
    lines.push(file_line(entry, "module \"${SOURCE_DIR}\", holding `main`"))
    lines.push(file_line(".gitignore", "build/ (every artefact lands there)"))
    if git_initialised {
        lines.push(file_line(".git", "a git repository was initialised here"))
    }
    return lines
}

// A file written, then what it is for, in a column the longest name leaves.
file_line :: fn(file: string, purpose: string) -> string = "${file.pad_end(16, ' ')}${purpose}"

// What to type next, one command each.
next_commands :: fn(project: NewProject, setup: BuildSetup) -> string[] {
    commands: string[]: []
    if !project.in_place {
        commands.push("cd ${project.dir}")
    }
    commands.push(first_command(setup))
    return commands
}

// What to type first in a new project: build it when something describes its
// build, else run its one file.
first_command :: fn(setup: BuildSetup) -> string = match setup {
    .Driver   -> "vader build"
    .Manifest -> "vader run ."
    .None     -> "vader run ${SOURCE_DIR}/${ENTRY_FILENAME}"
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_entry_declares_the_folder_as_its_module :: fn() -> void {
    // The one rule the scaffold exists to state: module name = folder name.
    src :: render_entry("demo")
    assert("module \"src\"" in src, "the entry declares `module \"src\"`")
    assert("main :: fn() -> i32" in src, "and holds a `main` the lowerer recognises")
}

@test test_manifest_carries_the_project_name :: fn() -> void {
    manifest :: render_manifest("my-app")
    assert("\"name\": \"my-app\"" in manifest, "the name reaches the manifest")
    assert("\"includePaths\": []" in manifest, "and the include-path list is there to fill")
    assert("\"assets\": []" in manifest, "and so is the asset list")
}

@test test_new_refuses_a_folder_whose_name_cannot_name_a_binary :: fn() -> void {
    assert(resolve_target("my app") is ScaffoldError, "a space cannot name a binary")
}

@test test_the_reader_accepts_the_scaffolded_manifest :: fn() -> void {
    project :: join_path(temp_dir(), "vader_new_manifest")
    create_dir(project)
    manifest :: join_path(project, MANIFEST_FILENAME)
    write_file_string(manifest, render_manifest("my-app"))
    m :: read_manifest(project)
    remove_file(manifest)
    assert_eq(m.problems.len(), 0)
    assert_eq(m.entries.len(), 1)
    assert_eq(m.entries[0].name, "my-app")
    assert_eq(m.entries[0].path, "src/main.vader")
}

@test test_a_flag_is_not_a_project_name :: fn() -> void {
    // `vader new --nope` reaches here only if the parser did not claim it; the
    // message must not then read as "creating directory --nope".
    target :: resolve_target("--nope")
    assert(target is ScaffoldError, "a leading dash is refused")
}

@test test_directory_name_takes_the_last_segment :: fn() -> void {
    assert_eq(directory_name("tmp/my-app"), "my-app")
    assert_eq(directory_name("my-app"), "my-app")
    assert_eq(directory_name("my-app/"), "my-app")
}

@test test_report_names_the_next_command :: fn() -> void {
    text :: report(
        NewProject { .dir = "demo", .name = "demo", .in_place = false },
        .Manifest,
        false,
    )
    assert("cd demo" in text, "a created project says how to enter it")
    assert("vader run ." in text, "and what to run once inside")
}

@test test_in_place_report_skips_the_cd :: fn() -> void {
    text :: report(
        NewProject { .dir = ".", .name = "demo", .in_place = true },
        .Manifest,
        false,
    )
    assert(!("cd " in text), "there is nowhere to cd to")
    assert("vader run ." in text, "the run line still applies")
}

@test test_report_names_only_what_was_written :: fn() -> void {
    // The three shapes are exclusive, so the report must not mention a file the
    // scaffold did not write.
    demo :: NewProject { .dir = "demo", .name = "demo", .in_place = false }
    bare :: report(demo, .None, false)
    assert(!(MANIFEST_FILENAME in bare), "`none` writes no manifest, so names none")
    assert(!(DRIVER_FILENAME in bare), "and no driver either")

    driven :: report(demo, .Driver, false)
    assert(DRIVER_FILENAME in driven, "`driver` names the driver")
    assert(!(MANIFEST_FILENAME in driven), "and supersedes the manifest rather than adding to it")
    // A driven project is built by a bare `vader build`, not by naming the entry.
    assert("vader build" in driven, "the next command matches the shape")
}

@test test_driver_template_declares_the_build_module :: fn() -> void {
    // A root-level file is not importable by module name; the compiler writes an
    // entry shim beside it that shares this module.
    src :: render_driver(scaffolded_manifest("demo"))
    assert("module \"build\"" in src, "the driver declares `module \"build\"`")
    assert("build :: fn(args: string[]) -> i32" in src, "with the reserved shape")
    assert("add_entry(\"demo\", \"src/main.vader\")" in src, "and adds the entry, named after the project")
    assert("return ctx.emit_native()" in src, "and returns what the build answered")
}

@test test_build_flag_beats_the_question :: fn() -> void {
    // Only the flag's ABSENCE is a question; `std/cli` has already rejected any
    // value outside the declared set by the time this runs.
    assert(setup_named("none") == .None, "none")
    assert(setup_named("driver") == .Driver, "driver")
    assert(setup_named("manifest") == .Manifest, "manifest")
}
