// vader/tools/cli/dump: the `vader dump --stage=<s>` command.
//
// Reads the flags and prints the stage `vader/tools/dump` renders: the dump on
// stdout, the diagnostics of the C stage on stderr.
//
// Same module as `main.vader`, so the argument helpers stay reachable without
// exporting them: imports are file-scoped, declarations are not.

module "vader/tools/cli"

import "cli"
import "std/console"
import "std/string"
import "vader/support/target"
import "vader/tools/dump"

// ----------------------------------------------------------- dump

cmd_dump :: fn(args: string[]) -> i32 {
    parsed :: parse_action("dump", args)
    if parsed is i32 {
        return parsed
    }
    if reject_extra_positionals("dump", parsed) {
        return 1
    }
    stage :: parsed.string_flag("stage", "")
    annotate :: parsed.bool_flag("annotate")
    line_directives :: parsed.bool_flag("line-directives")
    file :: parsed.action_file()
    // `--module=a,b` scopes the module-filtered dumps to those modules and their
    // submodules (`--module=vader` for the whole compiler); empty is the entry
    // module's subtree.
    include_path_flags :: parse_include_path_flag(parsed.string_flag("include-paths", ""))
    module_arg :: parsed.string_flag("module", "")
    module_filter: string[] = []
    if module_arg != "" {
        module_filter = module_arg.split(",")
    }
    if stage == "" || file == "" {
        eprintln("vader dump: expected --stage=<stage> <path>")
        eprintln("run \"vader help dump\" for the stage list")
        return 1
    }
    // `--target` holds for every stage: the resolver selects the `@target` bodies
    // by it, so a front-end dump that ignored it would render for this machine.
    target_arg :: parsed.string_flag("target", "")
    // Empty is this machine, which the pipeline spells `null`.
    target :: if target_arg == "" { null } else { parse_target(target_arg) }
    if target is TargetParseError {
        eprintln("vader dump --target=${target_arg}: ${target.reason} `${target.fragment}`")
        return 2
    }
    resolved :: single_entry("dump", file, parsed)
    if resolved is i32 {
        return resolved
    }
    input :: DumpInput {
        .file = resolved.file,
        .modules = module_filter,
        .include_paths = include_path_flags,
        .target = target,
        .project_root = resolved.project_root,
        .annotate = annotate,
        .line_directives = line_directives,
        .verify_bounds = bounds_verification_enabled(),
    }
    return print_stage(dump_stage(input, stage))
}

// Print what a stage rendered, and return its exit code.
print_stage :: fn(output: StageOutput) -> i32 {
    print(output.out)
    eprint(output.err)
    return output.code
}
