// vader/tools/cli/dump_worker: a process that dumps the stages of many files.
//
// Prototype of a test-runner worker: it reads one case per line on stdin and
// writes the dumps `vader dump --stage=<S>` would print for it, without starting
// a process per stage. A case line is `<path>\t<modules>\t<stages>`, the modules
// and the stages each a comma list, the modules possibly empty. Before each
// stage the worker writes a line `\u{1e}<stage>` and after it
// `\u{1e}end <code> <micros>`, the exit code `vader dump` would have had and the
// time the stage took; after the last one, a line `\u{1e}done <micros>`, the
// time the case took.
//
// The stages from `evaluated-ast` on share one front end and one lowering per
// case (`DumpInput`), which `vader dump` runs once per stage.
//
// The `vm` stage is a measurement shortcut, not the runner's design, which
// redirects the program's streams inside the VM: it runs the case through
// `run_source`, the path of `vader run <path>`, with this process's descriptors
// swapped for the run (stdin reads `/dev/null`, stdout and stderr go to two files
// of the folder given as the worker's argument). Its text is the captured stdout,
// a line `\u{1e}stderr`, then the captured stderr. POSIX only.
//
// Same module as `main.vader`: the stages are those of `vader/tools/dump`.

module "vader/tools/cli"

import "std/console"
import "std/ffi"
import "std/fs"
import "std/io"
import "std/option"
import "std/path"
import "std/string"
import "std/time"
import "vader/support/target"
import "vader/tools/dump"
Posix :: import "system/posix"

/// `vader dump-worker <folder>`: dump the stages of each case read on stdin, until
/// stdin ends.
///
/// @param args  `args[0]`, the folder the `vm` stage captures a run's output in.
/// @return      0 once stdin has ended.
cmd_dump_worker :: fn(args: string[]) -> i32 {
    capture :: if args.len() > 0 { args[0] } else { "." }
    target :: parse_target("linux-x86_64").or_null()
    for {
        line :: read_line()
        if line is IOError {
            return 0
        }
        if line != "" {
            run_case(line.split("\t"), target, capture)
        }
    }
}

// Dump the stages of the case `parts`, a case line split on its tabs.
run_case :: fn(parts: string[], target: Target | null, capture: string) -> void {
    modules: string[]: if parts[1] == "" { [] } else { parts[1].split(",") }
    input :: DumpInput {
        .file = Path(parts[0]),
        .modules = modules,
        .target = target,
        .annotate = true,
    }
    began :: monotonic()
    for stage in parts[2].split(",") {
        println("\u{1e}${stage}")
        stage_began :: monotonic()
        code :: run_worker_stage(stage, input, capture)
        println("\u{1e}end ${code} ${stage_began.since().to_micros()}")
    }
    println("\u{1e}done ${began.since().to_micros()}")
}

// Run one stage as `vader dump --stage=<stage> --target=linux-x86_64` would, the
// bytecode stage with `--annotate` as the snapshots take it.
run_worker_stage :: fn(stage: string, input: DumpInput, capture: string) -> i32 {
    if stage == "vm" {
        return run_captured(input.file, capture)
    }
    return print_stage(dump_stage(input, stage))
}

// ---- a run inside the worker ----------------------------------------------

WORKER_UNISTD :: CLibrary {
    .name = "",
    .headers = ["<unistd.h>"],
}

@extern(WORKER_UNISTD, "dup")
worker_dup :: fn(fd: i32) -> i32

@extern(WORKER_UNISTD, "dup2")
worker_dup2 :: fn(fd: i32, onto: i32) -> i32

// Run `file` through `run_source` with descriptors 0, 1 and 2 swapped for the
// run, then print what it wrote. Returns what `run_source` returns, which a
// process would truncate to 8 bits.
run_captured :: fn(file: Path, capture: string) -> i32 {
    out_path :: "${capture}/out"
    err_path :: "${capture}/err"
    saved :: [worker_dup(0), worker_dup(1), worker_dup(2)]
    write_flags :: Posix.O_WRONLY | Posix.O_CREAT | Posix.O_TRUNC
    opened :: [
        Posix.sys_open("/dev/null", Posix.O_RDONLY, 0),
        Posix.sys_open(out_path, write_flags, 0o644),
        Posix.sys_open(err_path, write_flags, 0o644),
    ]
    for fd in 0..<3 {
        worker_dup2(opened[fd], fd)
    }
    code :: run_source(file, [file.as_string()], null)
    for fd in 0..<3 {
        worker_dup2(saved[fd], fd)
        Posix.sys_close(saved[fd])
        Posix.sys_close(opened[fd])
    }
    print(captured(out_path))
    println("\u{1e}stderr")
    print(captured(err_path))
    return code
}

captured :: fn(path: string) -> string = match text :: read_file_string(path) {
    is string  -> text
    is IOError -> ""
}
