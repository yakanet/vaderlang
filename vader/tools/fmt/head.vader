// vader/tools/fmt/head: a declaration's head on one line, as `vader fmt` writes it.
//
// The LSP hover shows the signature of the declaration under the cursor. It is
// rendered here from the parsed declaration, with the printer in `flat` mode : a
// head the source wraps across lines (a long parameter list, a union continued
// on `|` lines) reads on one line, and a string, a char or a comment inside it is
// never taken for its end. `format_decl_head` leaves out the decorators, `export`
// and the body ; `format_decl_display` adds the decorators, `export` and the
// members' heads a hover shows. A head comes with the names it writes, which a
// caller resolves to link them (`vader doc`).

module "vader/tools/fmt"

import "std/iter"
import "std/string"
p :: import "toolchain/ast"
import "toolchain/span"
import "vader/front/parser"

/// A name a head wrote: where it lies in the text, and the node it comes from,
/// by which a caller resolves it.
export WrittenName :: struct {
    /// Byte offset of the name's first byte in the text.
    start: i64
    /// Byte offset just past the name's last byte.
    end: i64
    /// The span of an identifier, the key the resolver binds it under; or a
    /// member access (`Ns.Name`), whose range covers both sides of its dot.
    node: Span | p.FieldExpr
}

/// A rendering, with the names it wrote.
export NamedText :: struct {
    text:  string
    /// In the order they were written: a member access after the name it
    /// starts with.
    names: WrittenName[]
}

/// Longest const, field or variant head shown before it is cut with ` …` : a
/// table written over many lines is a value, not a signature. A union alias is
/// never cut: its `|` chain IS the signature.
HEAD_VALUE_MAX: i64: 120

/// Render the head of a declaration on one line : `area :: fn(a: i32) -> i32`,
/// `Point :: struct`, `Kind :: enum(u8)`, `Add :: trait<Rhs = Self>`,
/// `Value :: I32Val | I64Val`, `MASK: u32: 0xFFFF`.
///
/// @param source  the document the declaration's spans index into: literals
///                are sliced from it verbatim.
/// @param d       the declaration ; an import, an impl or an `assert` has no head
///                and renders as "".
/// @return        the head, without decorators, `export` or body.
export format_decl_head :: fn(source: string, d: p.Decl) -> NamedText {
    h :: head_printer(source)
    match d {
        is p.FnDecl -> {
            emit_fn_head(h, d, true)
        }
        is p.StructDecl -> {
            h.write(d.name)
            h.write(" :: struct")
            h.emit_type_params(d.type_params)
        }
        is p.EnumDecl -> {
            h.write(d.name)
            h.write(" :: enum")
            if d.header.len() > 0 {
                h.emit_comma_list(d.header, "(", ")", false, true, emit_type_expr_item)
            }
        }
        is p.TraitDecl -> {
            h.write(d.name)
            h.write(" :: trait")
            h.emit_type_params(d.type_params)
            h.emit_type_expr_with_prefix(": ", d.requires)
        }
        is p.TypeAliasDecl -> {
            h.write(d.name)
            h.emit_type_params(d.type_params)
            h.write(" :: ")
            h.emit_type_expr(d.aliased)
        }
        is p.ConstDecl -> {
            return const_head(h, d)
        }
        is p.ImportDecl | p.ImplDecl | p.AssertDecl -> {}
    }
    return h.finish_named()
}

/// Render a struct field's head on one line : `name: T`, `name: T = default`.
///
/// @param source  the document the field's spans index into.
/// @param f       the field.
/// @return        the head, cut past `HEAD_VALUE_MAX` bytes.
export format_field_head :: fn(source: string, f: p.StructField) -> NamedText {
    h :: head_printer(source)
    h.write(f.name)
    h.write(": ")
    h.emit_type_expr(f.ty)
    h.emit_expr_with_prefix(" = ", f.default)
    return cut_head(h.finish_named(), HEAD_VALUE_MAX)
}

/// Render an enum variant's head on one line : `Name`, `Name = 3`,
/// `Name { .id = "T3009", .message = "…" }`.
///
/// @param source  the document the variant's spans index into.
/// @param v       the variant.
/// @return        the head, cut past `HEAD_VALUE_MAX` bytes.
export format_variant_head :: fn(source: string, v: p.EnumVariant) -> NamedText {
    h :: head_printer(source)
    h.write(v.name)
    data :: v.data
    if data !is null {
        h.write(" ")
        h.emit_comma_list(data, "{", "}", true, true, emit_struct_lit_item)
    }
    value_span :: v.value_span
    if value_span is Span {
        h.write(" = ")
        h.write(h.source_slice(value_span))
    }
    return cut_head(h.finish_named(), HEAD_VALUE_MAX)
}

/// Render an impl's head on one line: `Box<T> implements<T> Display`, without
/// its decorators or its members.
///
/// @param source  the document the impl's spans index into.
/// @param d       the impl.
export format_impl_head :: fn(source: string, d: p.ImplDecl) -> NamedText {
    h :: head_printer(source)
    h.emit_impl_head(d)
    return h.finish_named()
}

/// Render the trait an impl implements, with its arguments: `Add<Meters>`.
///
/// @param source  the document the impl's spans index into.
/// @param d       the impl.
export format_impl_trait :: fn(source: string, d: p.ImplDecl) -> string {
    h :: head_printer(source)
    h.emit_trait_ref(d)
    return h.finish()
}

/// Render a type expression on one line: `Box<T>`, `i32 | null`.
///
/// @param source  the document the type's spans index into.
/// @param t       the type expression.
export format_type_expr :: fn(source: string, t: p.TypeExpr) -> string =
    format_type_expr_named(source, t).text

/// Render a type expression on one line, with the names it writes.
///
/// @param source  the document the type's spans index into.
/// @param t       the type expression.
export format_type_expr_named :: fn(source: string, t: p.TypeExpr) -> NamedText {
    h :: head_printer(source)
    h.emit_type_expr(t)
    return h.finish_named()
}

/// Render an expression on one line as a head writes it, a parameter's default
/// for one, with the names it writes.
///
/// @param source  the document the expression's spans index into.
/// @param e       the expression.
export format_expr_named :: fn(source: string, e: p.Expr) -> NamedText {
    h :: head_printer(source)
    h.emit_expr(e)
    return h.finish_named()
}

// ---- display --------------------------------------------------------------

/// Most members a display lists under a struct, an enum or a trait before it
/// ends the list with a count of the rest.
DISPLAY_MEMBERS_MAX: i64: 16

/// Render a declaration as a hover shows it : its decorators one per line,
/// `export` when it is public, then its head. A fn whose head would pass `width`
/// columns takes one parameter per line, and a struct, an enum or a trait lists
/// the heads of its members, the first `DISPLAY_MEMBERS_MAX` of them.
///
/// @param source  the document the declaration's spans index into.
/// @param d       the declaration ; an import, an impl or an `assert` has no head
///                and renders as "".
/// @param width   the column past which a fn breaks its parameter list.
/// @return        the rendering, lines joined by `\n`, no trailing newline.
/// @example
///   source :: "module \"m\"\n@test\nexport ok :: fn() -> void {}\n"
///   decls :: parse_source(source, "m.vader").program.decls
///   println(format_decl_display(source, decls[0], 60))
export format_decl_display :: fn(source: string, d: p.Decl, width: i64) -> string {
    head :: format_decl_head(source, d).text
    if head == "" {
        return ""
    }
    lines: string[]: []
    for deco in p.decl_decorators(d) {
        lines.push(decorator_text(source, deco))
    }
    prefix :: export_prefix(d)
    lines.push(prefix + display_head(source, d, head, width - prefix.text_width()))
    members :: member_heads(source, d)
    if members.len() > 0 {
        lines[lines.len() - 1] = lines[lines.len() - 1] + " {"
        for i in 0..<members.len() {
            if i == DISPLAY_MEMBERS_MAX {
                lines.push("    // … ${members.len() - i} more")
                break
            }
            lines.push("    " + members[i])
        }
        lines.push("}")
    }
    return lines.join("\n")
}

/// Render a struct field as a hover shows it : `@internal` when the field is
/// restricted to its module, then its head.
///
/// @param source  the document the field's spans index into.
/// @param f       the field.
export format_field_display :: fn(source: string, f: p.StructField) -> string {
    head :: format_field_head(source, f).text
    if f.visibility == .Private {
        return "@internal " + head
    }
    return head
}

// `export ` for a public declaration, "" otherwise.
export_prefix :: fn(d: p.Decl) -> string {
    if p.decl_is_public(d) {
        return "export "
    }
    return ""
}

// `@name(args)` on one line.
decorator_text :: fn(source: string, deco: p.Decorator) -> string {
    h :: head_printer(source)
    h.emit_decorator(deco)
    return h.finish()
}

// `head`, unless `d` is a fn whose head passes `width` columns : then its
// parameters go one per line, each closed by a comma, the layout `vader fmt`
// gives a parameter list too long for its line.
display_head :: fn(source: string, d: p.Decl, head: string, width: i64) -> string {
    if d is p.FnDecl && head.text_width() > width && d.params.len() > 0 {
        h :: head_printer(source)
        emit_fn_head(h, d, false)
        return h.finish()
    }
    return head
}

// `name :: fn<T>(a: A, b: B) -> R`, the parameters on one line when `inline`,
// one per line otherwise.
emit_fn_head :: fn(h: Printer, d: p.FnDecl, inline: bool) -> void {
    h.write(d.name)
    h.write(" :: fn")
    h.emit_type_params(d.type_params)
    h.emit_comma_list(d.params, "(", ")", false, inline, emit_fn_param)
    h.emit_type_expr_with_prefix(" -> ", d.return_type)
}

// The heads of what `d` declares inside its braces : a struct's fields, an
// enum's variants, a trait's methods. Empty for every other declaration.
member_heads :: fn(source: string, d: p.Decl) -> string[] {
    out: string[]: []
    match d {
        is p.StructDecl -> {
            for f in d.fields {
                out.push(format_field_display(source, f))
            }
        }
        is p.EnumDecl -> {
            for v in d.variants {
                out.push(format_variant_head(source, v).text + ",")
            }
        }
        is p.TraitDecl -> {
            for m in d.members {
                out.push(format_decl_head(source, m).text)
            }
        }
        is p.FnDecl | p.TypeAliasDecl | p.ConstDecl | p.ImportDecl | p.ImplDecl | p.AssertDecl -> {}
    }
    return out
}

// A comment-free printer that keeps every construct on one line and notes the
// names it writes.
head_printer :: fn(source: string) -> Printer {
    h :: new_printer(source, CommentMap { .comments = [], .cursor = 0 })
    h.flat = true
    h.names = []
    return h
}

// What `h` wrote, with the names it noted.
finish_named :: fn(h: Printer) -> NamedText = NamedText {
    .text = h.finish(),
    .names = h.names ?? [],
}

// `NAME :: value`, `NAME: T: value`, or their `@comptime` form: the operand the
// parser kept, not the helper call it desugared the const into.
const_head :: fn(h: Printer, d: p.ConstDecl) -> NamedText {
    h.write(d.name)
    if d.ty is null {
        h.write(" :: ")
    } else {
        h.write(": ")
        h.emit_type_expr(d.ty)
        h.write(": ")
    }
    if is_inline_comptime(d) {
        h.write("@comptime ")
    }
    value :: written_value(d)
    h.emit_expr(value)
    if is_bitor_chain(value) {
        return h.finish_named()
    }
    return cut_head(h.finish_named(), HEAD_VALUE_MAX)
}

// `head` kept to its first line and to `limit` bytes, a cut marked ` …`, with the
// names that end before the cut. A block value (a lambda body) still breaks lines
// in flat mode, hence the first line. The cut backs off to a UTF-8 lead byte, so
// it never splits a character.
cut_head :: fn(head: NamedText, limit: i64) -> NamedText {
    text :: head.text
    end := first_line_len(text)
    if end == text.byte_len() && end <= limit {
        return head
    }
    if end > limit {
        end = limit
        for end > 0 && text.byte_at(end).is_utf8_continuation() {
            end -= 1
        }
    }
    return NamedText {
        .text = text.byte_slice(0, end).trim() + " …",
        .names = head.names.filter((n: WrittenName) -> n.end <= end).collect(),
    }
}

// Byte length of `text`'s first line: all of it when it holds no newline.
first_line_len :: fn(text: string) -> i64 {
    for i in 0..<text.byte_len() {
        if text.byte_at(i) == '\n' {
            return i
        }
    }
    return text.byte_len()
}

// ---- tests ----------------------------------------------------------------

import "std/string_builder"
import "std/testing"

// The head of the last declaration in `decl`, with its names.
named_head_of :: fn(decl: string) -> NamedText {
    source :: "module \"t\"\n${decl}\n"
    decls :: parse_source(source, "t.vader").program.decls
    return format_decl_head(source, decls[decls.len() - 1])
}

// The head of the last declaration in `decl`.
head_of :: fn(decl: string) -> string = named_head_of(decl).text

// The text of each name the head of the last declaration in `decl` notes, in
// order, joined by `,`.
names_of :: fn(decl: string) -> string {
    head :: named_head_of(decl)
    texts :: head.names.map((n: WrittenName) -> head.text.byte_slice(n.start, n.end))
    return texts.collect().join(",")
}

// A constant whose value is a table of `count` times `item`, on one line.
long_table :: fn(item: string, count: i64) -> string {
    table :: StringBuilder {}
    table.append("TABLE :: [")
    for i in 0..<count {
        if i > 0 {
            table.append(", ")
        }
        table.append(item)
    }
    table.append("]")
    return table.to_string()
}

@test
test_head_wrapped_parameter_list :: fn() -> void {
    decl :: "area :: fn(\n    // the shape to measure\n    shape: Shape,\n    scale: i32 = 1,\n) -> i32 {\n    return scale\n}"
    assert_eq(head_of(decl), "area :: fn(shape: Shape, scale: i32 = 1) -> i32")
}

@test
test_head_union_on_continuation_lines :: fn() -> void {
    assert_eq(head_of("Value :: I32Val\n       | I64Val\n       | F64Val"), "Value :: I32Val | I64Val | F64Val")
}

@test
test_head_literals_are_not_its_end :: fn() -> void {
    assert_eq(head_of("u :: fn(url: string = \"http://x(\") -> i32 = 1"), "u :: fn(url: string = \"http://x(\") -> i32")
    assert_eq(head_of("BANNER :: \"// Generated\""), "BANNER :: \"// Generated\"")
}

@test
test_head_trait_type_parameter_defaults :: fn() -> void {
    decl :: "Add :: trait<Rhs = Self, Out = Self> {\n    add :: fn(self, other: Rhs) -> Out\n}"
    assert_eq(head_of(decl), "Add :: trait<Rhs = Self, Out = Self>")
}

@test
test_head_enum_and_struct_stop_before_the_body :: fn() -> void {
    assert_eq(head_of("Kind :: enum(u8) {\n    A,\n    B,\n}"), "Kind :: enum(u8)")
    assert_eq(head_of("Point :: struct {\n    x: i32\n}"), "Point :: struct")
}

@test
test_head_notes_the_names_it_writes :: fn() -> void {
    decl :: "area :: fn(s: Box<Shape>, k: Ns.Kind) -> i32 = 0"
    assert_eq(names_of(decl), "Box,Shape,Ns,Ns.Kind,i32")
}

@test
test_head_cut_keeps_the_names_before_the_cut :: fn() -> void {
    // `TABLE :: [` then `ONE, ` again and again: the names whole before the cut.
    kept :: (HEAD_VALUE_MAX - "TABLE :: [".byte_len()) / "ONE, ".byte_len()
    assert_eq(names_of(long_table("ONE", 41)).split(",").len(), kept)
}

@test
test_head_long_value_is_cut :: fn() -> void {
    head :: head_of(long_table("1000", 41))
    assert(head.ends_with(" …"), "a long table value is cut")
    assert(head.byte_len() <= HEAD_VALUE_MAX + 4, "the cut keeps the limit")
}

// The display of the only declaration in `decl`.
display_of :: fn(decl: string, width: i64) -> string {
    source :: "module \"t\"\n${decl}\n"
    decls :: parse_source(source, "t.vader").program.decls
    return format_decl_display(source, decls[decls.len() - 1], width)
}

@test
test_display_decorators_and_export :: fn() -> void {
    assert_eq(display_of("@test\nexport ok :: fn() -> void {}", 60), "@test\nexport ok :: fn() -> void")
}

@test
test_display_long_fn_breaks_its_parameters :: fn() -> void {
    decl :: "area :: fn(shape: Shape, scale: i32 = 1) -> i32 = scale"
    assert_eq(display_of(decl, 80), "area :: fn(shape: Shape, scale: i32 = 1) -> i32")
    assert_eq(display_of(decl, 20), "area :: fn(\n    shape: Shape,\n    scale: i32 = 1,\n) -> i32")
}

@test
test_display_struct_lists_its_fields :: fn() -> void {
    decl :: "export Point :: struct {\n    x: i32\n    @internal\n    y: i32 = 0\n}"
    assert_eq(display_of(decl, 60), "export Point :: struct {\n    x: i32\n    @internal y: i32 = 0\n}")
}

@test
test_display_enum_lists_its_variants :: fn() -> void {
    assert_eq(display_of("Kind :: enum(u8) {\n    A,\n    B = 4,\n}", 60), "Kind :: enum(u8) {\n    A,\n    B = 4,\n}")
}

@test
test_display_long_member_list_is_counted :: fn() -> void {
    variants :: StringBuilder {}
    for i in 0..<20 {
        variants.append("    V${i},\n")
    }
    display :: display_of("Big :: enum {\n${variants.to_string()}}", 60)
    assert(display.contains("    V15,\n    // … 4 more\n}"), "the list stops after the cap")
    assert(!display.contains("V16"), "nothing past the cap is shown")
}

@test
test_display_trait_lists_its_methods :: fn() -> void {
    decl :: "Shape :: trait {\n    area :: fn(self) -> f64\n    describe :: fn(self) -> string = \"x\"\n}"
    assert_eq(display_of(decl, 60), "Shape :: trait {\n    area :: fn(self) -> f64\n    describe :: fn(self) -> string\n}")
}
