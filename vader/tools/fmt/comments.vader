// vader/tools/fmt/comments: the comments of a file, for the printer.
//
// The tree holds no comment: the lexer keeps their spans beside the tokens
// (`tokenize_with_docs`), and they become an offset-keyed map. The printer
// consults the map at every AST-node boundary and interleaves matching comments
// at the right indentation.

module "vader/tools/fmt"

import "std/string"
import "toolchain/span"
import "vader/front/lexer"

/// Classification of a scanned comment. VaderDoc is `///` only ; `/**` is
/// recognised as a plain `Block` since SPEC §3 dropped the block-form
/// doc-comment.
export CommentKind :: enum(u8) {
    Line,     // `// ...`, or the `#!` line opening the file
    DocLine,  // `/// ...`: VaderDoc form, which semantic tokens colours apart.
              //   The formatter treats them like `Line` for round-trip
              //   equality (text is verbatim).
    Block,    // `/* ... */` (may contain nested `/* ... */`)
}

/// One scanned comment, ready for replay by the printer.
export Comment :: struct {
    // Byte offset (inclusive) of the leading `/` in the source.
    offset:      i64
    // Byte offset (exclusive) past the comment's closing token.
    end_offset:  i64
    // 1-based source line of `offset`: used to decide leading vs trailing.
    line:        i32
    // 1-based source line where the comment ends. For line comments
    // `end_line == line` ; for block comments it tracks the closing `*/`.
    // Needed so blank-line preservation between the comment and the next
    // node doesn't misfire on multi-line block comments.
    end_line:    i32
    kind:        CommentKind
    // Verbatim source slice including delimiters. Re-emitted as-is.
    text:        string
    // A line comment with code before it on its source line : it ends that
    // line in the output too, instead of leading the node that follows.
    after_code:  bool = false
}

/// Sorted-and-cursor view of every comment in a source file. `comments`
/// is ordered by byte offset ; `cursor` points at the next un-emitted
/// comment so the printer's `take_*` methods can advance through them in
/// document order.
export CommentMap :: struct {
    comments: Comment[]
    cursor:   i64
}

/// Collect every comment of `source`, as the lexer skips it: a `#!` opening
/// line counts as a line comment, and one inside a `${...}` belongs to its string
/// literal, which the printer copies whole.
///
/// @param source  the text of the file.
export scan_comments :: fn(source: string) -> CommentMap =
    comments_of(source, tokenize_with_docs(source, "").comments)

/// The comments of `source` at `spans`, which a lexing of `source` kept: what
/// `scan_comments` gives, for a caller that already holds them.
///
/// @param source  the text of the file.
/// @param spans   the comments' spans (`ParsedSource.comments`).
export comments_of :: fn(source: string, spans: Span[]) -> CommentMap {
    out: Comment[]: []
    for span in spans {
        out.push(comment_at(source, span))
    }
    return CommentMap { .comments = out, .cursor = 0 }
}

// The comment `span` covers in `source`.
comment_at :: fn(source: string, span: Span) -> Comment {
    text :: span.text_in(source)
    return Comment {
        .offset     = span.start.offset,
        .end_offset = span.end.offset,
        .line       = span.start.line,
        .end_line   = span.end.line,
        .kind       = comment_kind(text),
        .text       = text,
        .after_code = text.starts_with("//") && code_before_on_line(source, span.start.offset),
    }
}

comment_kind :: fn(text: string) -> CommentKind {
    if text.starts_with("///") {
        return .DocLine
    }
    if text.starts_with("/*") {
        return .Block
    }
    return .Line
}

// True when a non-blank byte precedes `at` on its own line.
code_before_on_line :: fn(source: string, at: i64) -> bool {
    k := at
    for k > 0 {
        k = k - 1
        c :: source.byte_at(k)
        if c == '\n' || c == '\r' { return false }
        if c != ' ' && c != '\t'  { return true }
    }
    return false
}

// True when at least one un-emitted comment has `offset < before`. The
// printer uses this to decide whether a separator line is needed between
// the leading-comment run and the AST node that follows.
export has_before :: fn(self: CommentMap, before: i64) -> bool {
    if self.cursor >= self.comments.len() { return false }
    c :: self.comments[self.cursor]
    return c.offset < before
}

// Whether a comment still queued starts in `[start, end)` at an offset `inside`
// does not take. Consumes nothing.
holds_comment :: fn(
    self: CommentMap,
    start: i64,
    end: i64,
    inside: fn(i64) -> bool,
) -> bool {
    for i in self.cursor..<self.comments.len() {
        c :: self.comments[i]
        if c.offset >= end {
            return false
        }
        if c.offset >= start && !inside(c.offset) {
            return true
        }
    }
    return false
}

/// Source line of the first comment still queued, when it starts before
/// `before` ; null otherwise. Consumes nothing.
///
/// @param before  byte offset the comment must start before.
export first_line_before :: fn(self: CommentMap, before: i64) -> i32 | null {
    if self.cursor >= self.comments.len() {
        return null
    }
    c :: self.comments[self.cursor]
    return if c.offset < before { c.line } else { null }
}

// Return every un-emitted comment whose `offset < before` and advance the
// cursor past them. The printer calls this just before emitting each
// AST node so leading comments land at the right position.

export take_before :: fn(self: CommentMap, before: i64) -> Comment[] {
    out: Comment[]: []
    for self.cursor < self.comments.len() {
        c :: self.comments[self.cursor]
        if c.offset >= before { break }
        out.push(c)
        self.cursor = self.cursor + 1
    }
    return out
}

// The comments of `all` that lie inside `span`, none of them taken.
comments_within :: fn(all: CommentMap, span: Span) -> CommentMap {
    inside: Comment[]: []
    for c in all.comments {
        if c.offset >= span.start.offset && c.end_offset <= span.end.offset {
            inside.push(c)
        }
    }
    return CommentMap { .comments = inside, .cursor = 0 }
}

// Drain every remaining comment (used at end-of-file to flush trailing
// comments after the last decl).
export drain_remaining :: fn(self: CommentMap) -> Comment[] {
    out: Comment[]: []
    for self.cursor < self.comments.len() {
        out.push(self.comments[self.cursor])
        self.cursor = self.cursor + 1
    }
    return out
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_scan_comments_kinds :: fn() -> void {
    cm :: scan_comments("#!/usr/bin/env vader\n/// doc\nx :: 1 // note\n/* block */\n")
    assert_eq(cm.comments.len(), 4)
    assert(cm.comments[0].kind == .Line, "the `#!` line is a line comment")
    assert(cm.comments[1].kind == .DocLine, "`///` is a doc line")
    assert(cm.comments[2].after_code, "`// note` follows code")
    assert(cm.comments[3].kind == .Block, "`/* */` is a block")
}
