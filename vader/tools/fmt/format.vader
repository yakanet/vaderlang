// vader/tools/fmt/format: top-level entry points for the formatter.

module "vader/tools/fmt"

import "std/string"
import "vader/front/parser"
import "vader/support/diagnostics"

/// Outcome of a `format_source` call : either the formatted output or the
/// list of parser diagnostics that prevented formatting. Callers
/// pattern-match on the union to decide whether to write back / print to
/// stdout / forward errors.
export FormatResult :: ParseFailure | Formatted

/// The parser emitted at least one error ; formatting was skipped because
/// round-trip parity can't hold on a partial AST.
export ParseFailure :: struct {
    diagnostics: Diagnostic[]
}

/// Successful format: `output` is the canonical text of the input source.
export Formatted :: struct {
    output: string
}

/// Parse `source`, build a `CommentMap`, run the printer, and return the
/// formatted source string. The result is idempotent
/// (`format_source(format_source(s).output, p) == s` for any clean
/// `format_source(s, p)` result) and parse-equivalent to the input.
///
/// @param source  the raw `.vader` source bytes.
/// @param path    informational: used as the `Program.file` field for
///                diagnostic provenance ; reading is done from `source`.
/// @return        `Formatted` on success, `ParseFailure` carrying every
///                parser diagnostic otherwise.
/// @example
///   r :: format_source("export x :: 42", "demo.vader")
///   match r {
///       is Formatted    -> println(r.output)
///       is ParseFailure -> for d in r.diagnostics { eprintln(d.render()) }
///   }
export format_source :: fn(source: string, path: string) -> FormatResult {
    // A byte order mark is no program text, and the output has none: the spans
    // the printer reads its comments by are those of the text after it.
    text :: source.trim_prefix("\u{FEFF}")
    pr :: parse_source_with_docs(text, path)
    if pr.errors.len() > 0 {
        // Don't format files with parse errors: round-trip parity cannot
        // hold when the AST is partial.
        return ParseFailure { .diagnostics = pr.errors }
    }
    pp :: new_printer(text, comments_of(text, pr.comments))
    output :: pp.emit_program(pr.program)
    return Formatted { .output = output }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_fmt_keeps_a_negation_of_a_number :: fn() -> void {
    // Without the parens, the `-` would reparse as part of the literal.
    fmt_keeps("a :: -(5)", "-(5)")
    fmt_keeps("b :: -(5).abs()", "-(5.abs())")
    fmt_keeps("c :: -(5.0).to_string()", "-(5.0.to_string())")
    fmt_keeps("d :: -5.abs()", "-5.abs()")
}

@test
test_fmt_keeps_the_comptime_of_a_loop :: fn() -> void {
    // Without it, the loop runs at run time over what it unrolled at compile time.
    fmt_leaves(
        "module \"t\"\n\nf :: fn() -> void {\n    @comptime for f in @fields(Pair) {\n        g(f)\n    }\n}\n",
    )
}

@test
test_fmt_keeps_the_comments_after_a_quote_in_an_interpolation :: fn() -> void {
    // The `"` and the `'` inside the `${...}` belong to the literal.
    fmt_keeps("g :: \"x \${f(\"ALLOC'D\")} y\"\n\n// after\nh :: 1", "// after")
}

@test
test_fmt_keeps_line_break_before_operator :: fn() -> void {
    fmt_keeps("s :: fn() -> i32 = 1\n    + 2", "= 1\n    + 2")
    fmt_keeps("f :: fn(x: i32 | null) -> i32 = x\n    ?? 0", "x\n    ?? 0")
}

@test
test_fmt_keeps_line_break_before_operator_past_block_comment :: fn() -> void {
    fmt_keeps("s :: fn() -> i32 = 1\n    /* note */\n    + 2", "= 1\n    /* note */\n    + 2")
}

@test
test_fmt_keeps_operator_leading_past_block_comment_on_its_line :: fn() -> void {
    fmt_keeps("s :: fn() -> i32 = 1\n    /* note */ + 2", "= 1\n    /* note */\n    + 2")
}

@test
test_fmt_keeps_line_break_after_operator :: fn() -> void {
    fmt_keeps("s :: fn() -> i32 = 1 +\n    2", "1 +\n    2")
}

@test
test_fmt_keeps_comment_between_operands :: fn() -> void {
    fmt_keeps("s :: fn() -> i32 = 1\n    // the rest\n    + 2", "1\n    // the rest\n    + 2")
}

@test
test_fmt_keeps_line_break_after_body_equals :: fn() -> void {
    fmt_keeps("s :: fn() -> i32 =\n    1 + 2", "=\n    1 + 2")
}

@test
test_fmt_indents_a_tighter_operand_deeper :: fn() -> void {
    // `%` binds tighter than `+` : its continuation is one level further in.
    fmt_keeps("s :: fn() -> i32 = 1\n    + 4\n    % 3", "= 1\n    + 4\n        % 3")
}

@test
test_fmt_adds_no_line_break :: fn() -> void {
    // A chain past `MAX_LINE` written on one line stays on one line.
    long :: "s :: fn() -> string = \"${"a" * 50}\" + \"${"b" * 50}\""
    fmt_keeps(long, "\"${"a" * 50}\" + \"${"b" * 50}\"")
}

@test
test_fmt_lays_a_fitting_union_on_one_line :: fn() -> void {
    fmt_keeps("T ::\n    | A\n    | B", "T :: A | B")
}

@test
test_fmt_keeps_an_assert_message :: fn() -> void {
    fmt_leaves("module \"t\"\n@assert(1 + 1 == 2, \"sum holds\")\n")
    fmt_leaves("module \"t\"\n@assert(true, r\"costs $5\")\n")
}

@test
test_fmt_keeps_a_shebang :: fn() -> void {
    fmt_leaves("#!/usr/bin/env vader\nmodule \"t\"\n")
}

@test
test_fmt_keeps_the_blank_line_after_a_shebang :: fn() -> void {
    fmt_leaves("#!/usr/bin/env vader\n\n// Header.\n\nmodule \"t\"\n")
}

@test
test_fmt_keeps_a_shebang_after_a_byte_order_mark :: fn() -> void {
    shebang :: "#!/usr/bin/env vader\nmodule \"t\"\n"
    assert_eq(formatted("\u{FEFF}${shebang}"), shebang)
}

@test
test_fmt_drops_the_byte_order_mark_before_a_comment :: fn() -> void {
    // A mark that opens the file is no program text: the lexer skips it.
    header :: "// Header.\n\nmodule \"t\"\n"
    assert_eq(formatted("\u{FEFF}${header}"), header)
}

@test
test_fmt_keeps_a_file_holding_only_a_shebang :: fn() -> void {
    fmt_leaves("#!/usr/bin/env vader\n")
}

@test
test_fmt_opens_a_file_of_comments_on_its_first_line :: fn() -> void {
    fmt_leaves("// One.\n// Two.\n")
}

@test
test_fmt_reads_no_comment_in_a_shebang :: fn() -> void {
    fmt_leaves("#!/usr/bin/env -S vader run //x\nmodule \"t\"\n")
}

@test
test_fmt_aligns_trailing_comments_by_codepoint :: fn() -> void {
    // `é` is two bytes and one column.
    fmt_leaves("module \"t\"\n\na :: \"été\"  // one\nb :: \"abcd\" // two\n")
}

@test
test_fmt_keeps_a_lookup_table_ending_a_block :: fn() -> void {
    // The last `if` of a block is laid out as a statement, although it parses as
    // the block's trailing expression.
    fmt_leaves("module \"t\"\n\nf :: fn(k: i32) -> i32 {\n    if k != 7 {\n        if k > 0  { return 1 }\n        if k > 10 { return 2 }\n    }\n    return 0\n}\n")
    fmt_leaves("module \"t\"\n\nf :: fn(k: i32) -> i32 {\n    for i in 0..<k {\n        if i > 0  { return 1 }\n        if i > 10 { return 2 }\n    }\n    return 0\n}\n")
}

@test
test_fmt_expands_a_lone_if_ending_a_block :: fn() -> void {
    expanded :: "    if k > 0 {\n        g()\n    }\n"
    fmt_keeps("f :: fn(k: i32) -> void {\n    g()\n    if k > 0 { g() }\n}", expanded)
    fmt_keeps("f :: fn(k: i32) -> void {\n    if k > 0 { g() }\n}", expanded)
    chain :: "    if k > 0 {\n        g()\n    } else if k < 0 {\n        g()\n    }\n"
    fmt_keeps("f :: fn(k: i32) -> void {\n    g()\n    if k > 0 { g() } else if k < 0 { g() }\n}", chain)
}

@test
test_fmt_keeps_a_conditional_value_ending_a_block :: fn() -> void {
    fmt_leaves("module \"t\"\n\nf :: fn(k: i32) -> i32 {\n    j :: k + 1\n    if j > 0 { 1 } else { 2 }\n}\n")
}

@test
test_fmt_keeps_the_comments_inside_an_exploded_list :: fn() -> void {
    fmt_leaves(r"""
        module "t"

        g :: fn(
            // the first
            a: i32,
            b: i32,
        ) -> i32 = a + b

        main :: fn() -> i32 {
            p :: P {
                .a = 1,
                // the second
                .b = 2,
                .c = 3, // trailing
            }
            q :: g(
                1,
                // the second argument
                [
                    1,
                    // last
                ],
            )
            r :: h([
                1,
                // the second
                2,
            ])
            return 0
        }
        """)
}

@test
test_fmt_keeps_a_comment_after_the_last_item_of_a_list :: fn() -> void {
    fmt_leaves(r"""
        module "t"

        import "p" {
            a as b,
            c as _, // drop c
        }

        f :: fn(
            a: i32,
            // reserved
        ) -> void {
            use(a)
        }

        out: i32[]: [
            // filled below
        ]
        """)
}

@test
test_fmt_leaves_a_list_on_its_line_when_the_comment_is_not_its_own :: fn() -> void {
    // A comment in a receiver is not the arguments'.
    fmt_leaves(r"""
        module "t"

        f :: fn() -> void {
            ys :: xs.filter(fn(x: i32) -> bool {
                // even
                return x % 2 == 0
            }).map(double)
            q :: g(a + b, (y) -> y)
        }
        """)
}

@test
test_fmt_explodes_a_list_a_comment_sits_in :: fn() -> void {
    exploded :: "    q :: g(\n        1,\n        // the second\n        2,\n    )\n"
    fmt_keeps("f :: fn() -> void {\n    q :: g(1,\n        // the second\n        2)\n}", exploded)
    block :: "    r :: g(\n        1,\n        /* inline */\n        2,\n    )\n"
    fmt_keeps("f :: fn() -> void {\n    r :: g(1, /* inline */ 2)\n}", block)
}

@test
test_fmt_leaves_a_comment_before_an_expression_body_to_the_body :: fn() -> void {
    // The parameters end at their `)`: what follows `=` or `->` is the body's.
    fmt_leaves(r"""
        module "t"

        g :: fn(a: i32) =
            // explain g
            a + 1
        """)
    fmt_keeps("h :: (x: i32) ->\n    // c\n    x + 1", "h :: (x: i32) -> x + 1")
}

// Formatting `source` must give it back unchanged.
fmt_leaves :: fn(source: string) -> void {
    assert_eq(formatted(source), source)
}

// `source` formatted ; "" when it does not parse.
formatted :: fn(source: string) -> string {
    r :: format_source(source, "t.vader")
    if r is Formatted {
        return r.output
    }
    assert(false, "must parse: ${source}")
    return ""
}

fmt_keeps :: fn(decl: string, needle: string) -> void {
    r :: format_source("module \"t\"\n${decl}\n", "t.vader")
    match r {
        is Formatted    -> { assert(needle in r.output, "fmt must keep `${needle}`") }
        is ParseFailure -> { assert(false, "must parse: ${decl}") }
    }
}
