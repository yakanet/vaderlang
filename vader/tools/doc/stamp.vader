// vader/tools/doc/stamp: whether `build/doc/` holds what `vader doc` would write.
//
// The data depends on the files the load read, on the roots it searched, on the
// entry, the scope and the project's `vader.json`, and on the compiler. The
// stamp, written last beside the data, holds a key over all of them and the
// folders of the files the load read, so that checking it reads those folders
// alone: a file no load reached changes nothing. The key describes what the load
// saw, so that a file changed, added or removed while it ran shows at the next
// check. Not covered: a folder that comes, inside an unchanged root, to shadow a
// loaded module or to join one from the generated tree.
//
// What a run leaves out of the scope follows from the key (the scope and the
// roots), so the stamp keeps it, for an up-to-date run to say it again.

module "vader/tools/doc"

import "crypto"
import "std/collections"
import "std/io"
import "std/iter"
import "std/path"
import "std/sort"
import "std/string"
import "vader/front/resolver"
import "vader/support/diagnostics"

/// What the data depends on beside the files the load reads, taken before the
/// load.
export DocInputs :: struct {
    /// The modules documented (`doc_scope`).
    scope: DiscoveredModule[]
    /// The file the load starts from.
    entry: string
    /// The project folder, null for none.
    project_root: string | null
    /// The folders the load searches beside the project's roots, as
    /// `--include-paths` names them.
    include_paths: string[]
    /// The lines of the key beside the files: the compiler, the entry, the
    /// project and its `vader.json`, the roots searched, the scope. Empty when
    /// the compiler cannot be read: no stamp is then written or matched.
    header: string[]
}

/// Take what the data of `scope` depends on, beside the files the load reads.
///
/// @param scope          the modules documented (`doc_scope`).
/// @param entry          the file the load starts from.
/// @param project_root   the project folder, null for none.
/// @param include_paths  the folders the load searches beside the project's
///                       roots.
/// @param compiler       a digest of the running compiler, null when it cannot
///                       be read.
export doc_inputs :: fn(
    scope: DiscoveredModule[],
    entry: string,
    project_root: string | null,
    include_paths: string[],
    compiler: string | null,
) -> DocInputs {
    inputs :: DocInputs {
        .scope = scope,
        .entry = entry,
        .project_root = project_root,
        .include_paths = include_paths,
        .header = [],
    }
    digest :: compiler ?? return inputs
    root :: project_root ?? ""
    inputs.header.push("compiler ${digest}")
    inputs.header.push("entry ${entry_key(entry)}")
    inputs.header.push("project ${normalized_root(root)}")
    inputs.header.push("manifest ${manifest_hash(root)}")
    // The synthetic entry is no file: the folder `search_roots` takes from it
    // would put the working directory in the key.
    entry_folder :: normalized_path(dir_of(entry))
    ignored: Diagnostic[]: []
    for searched in search_roots(entry, include_paths, project_root, doc_overlay(), ignored).paths {
        folder :: normalized_path(searched.dir)
        if entry != SYNTHETIC_ENTRY || folder != entry_folder {
            inputs.header.push("root ${folder} ${searched.prefix} ${searched.merge}")
        }
    }
    for m in scope {
        inputs.header.push("scope ${m.name} ${normalized_path(m.folder)}")
    }
    return inputs
}

/// What the data under `dir` left out of its scope, when it is what a run on
/// `inputs` would write: its index is there, and its stamp's key is the key of
/// what the folders it names hold now.
///
/// @param dir     the folder the data goes to.
/// @param inputs  what the data depends on beside the files the load reads.
/// @return        one line per module left out, null when the data is not up to
///                date.
export fresh_doc_data :: fn(dir: string, inputs: DocInputs) -> string[] | null {
    if inputs.header.len() == 0 || !exists(join_path(dir, INDEX_FILE)) {
        return null
    }
    stamp :: read_stamp(dir) ?? return null
    if stamp.key != input_key(inputs, disk_lines(stamp.folders)) {
        return null
    }
    return stamp.left_out
}

/// The key of the stamp of the data under `dir`: what the data was written
/// from, the same for the same data; null when the data has no stamp, as after
/// a run that reported an error.
///
/// @param dir  the folder of the data.
export doc_data_key :: fn(dir: string) -> string | null {
    stamp :: read_stamp(dir) ?? return null
    return stamp.key
}

/// Write the stamp of the data `checked` gave under `dir`, last: its key over
/// what the load saw, the folders of the files it read, and what it left out.
/// A stamp that cannot be written costs a run more, nothing else.
///
/// @param dir       the folder the data goes to.
/// @param inputs    what the data depends on beside the files the load read.
/// @param checked   the load the data comes from.
/// @param left_out  one line per module of the scope the data leaves out.
export write_stamp :: fn(
    dir: string,
    inputs: DocInputs,
    checked: DocCheck,
    left_out: string[],
) -> void {
    if inputs.header.len() == 0 {
        return
    }
    seen :: loaded_lines(checked)
    lines: string[]: [input_key(inputs, seen.lines)]
    lines.push_all(seen.folders)
    lines.push_all(left_out.map((l: string) -> LEFT_OUT_LINE + l).collect())
    write_file_string(join_path(dir, STAMP_FILE), lines.join("\n") + "\n")
}

// The stamp's file name in the data folder.
STAMP_FILE :: "stamp"

// What opens a line of the stamp that names a module left out; a folder, absolute,
// cannot open with it.
LEFT_OUT_LINE :: "left out "

// What a stamp records: its key on its first line, then a line per folder and
// per module left out.
Stamp :: struct {
    key: string
    /// The folders of the files the load read, sorted.
    folders: string[]
    left_out: string[]
}

// The stamp under `dir`, null when there is none.
read_stamp :: fn(dir: string) -> Stamp | null {
    text :: read_file_string(join_path(dir, STAMP_FILE))
    if text is IOError {
        return null
    }
    lines :: text.trim().split("\n")
    stamp :: Stamp { .key = lines[0], .folders = [], .left_out = [] }
    for i in 1..<lines.len() {
        line :: lines[i]
        if line.starts_with(LEFT_OUT_LINE) {
            stamp.left_out.push(line.trim_prefix(LEFT_OUT_LINE))
        } else {
            stamp.folders.push(line)
        }
    }
    return stamp
}

// The folders of the files a load read, and the lines of the key that describe
// what they hold.
FolderLines :: struct {
    folders: string[]
    lines: string[]
}

// What `checked` read: each folder on disk holding a file it read, then each of
// those files with the hash of the content the load read. A module the load made
// up (the entry without a project, the baked target constants) has no folder on
// disk, and is left out.
loaded_lines :: fn(checked: DocCheck) -> FolderLines {
    by_folder :: MutableMap<string, SourceFile[]> {}
    for [_, loaded] in checked.project.modules {
        for file in loaded.module.files {
            folder :: normalized_path(dir_of(file.path))
            if is_dir(folder) {
                by_folder.get_or_put_with(folder, () -> []).push(file)
            }
        }
    }
    folders :: sort(by_folder.keys(), compare_ascending)
    lines: string[]: []
    for folder in folders {
        lines.push("folder ${folder}")
        files :: by_folder[folder] ?? []
        for file in sort(files, by_path) {
            lines.push(file_line(file.path, file.content))
        }
    }
    return FolderLines { .folders = folders, .lines = lines }
}

// What `folders` hold now, in the lines `loaded_lines` writes: their source
// files as the loader takes them, an empty or unreadable one left out as it
// leaves it out. A folder gone holds nothing.
disk_lines :: fn(folders: string[]) -> string[] {
    lines: string[]: []
    for folder in folders {
        lines.push("folder ${folder}")
        names :: read_dir(folder)
        if names is IOError {
            continue
        }
        for path in source_files_in(folder, names) {
            content :: read_file_string(path)
            if content is IOError || content == "" {
                continue
            }
            lines.push(file_line(path, content))
        }
    }
    return lines
}

// Whether `a` goes before `b`, the files of one folder in the order its listing
// gives them.
by_path :: fn(a: SourceFile, b: SourceFile) -> bool = compare_ascending(a.path, b.path)

// The line of the key for the file `path` holding `content`.
file_line :: fn(path: string, content: string) -> string =
    "file ${path.to_path().filename()} ${content.hash()}"

// The key of the data a run on `inputs` writes, the folders of the files it read
// holding what `lines` say.
input_key :: fn(inputs: DocInputs, lines: string[]) -> string =
    sha256(inputs.header.join("\n") + "\n" + lines.join("\n"))

// The hash of the `vader.json` of the project `root`, "" without one.
manifest_hash :: fn(root: string) -> string {
    if root == "" {
        return ""
    }
    text :: read_file_string(join_path(root, MANIFEST_FILENAME))
    if text is IOError {
        return ""
    }
    return "${text.hash()}"
}

// The entry as the key writes it: the synthetic one as it is, any other file
// normalized.
entry_key :: fn(entry: string) -> string {
    if entry == SYNTHETIC_ENTRY {
        return entry
    }
    return normalized_path(entry)
}

// The project folder `root` as `normalized_path` spells it, "" for none.
normalized_root :: fn(root: string) -> string {
    if root == "" {
        return ""
    }
    return normalized_path(root)
}

/// `path` absolute and normalized, `\` read as `/`: one spelling for a file,
/// whatever the loader or the command line wrote. The data names its files from
/// a folder spelled this way.
///
/// @param path  a `/`- or `\`-separated path, relative to the working directory
///              or absolute.
export normalized_path :: fn(path: string) -> string =
    absolute_path(path.to_posix()).to_path().normalize().as_string()

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_normalized_path_reads_backslashes_as_slashes :: fn() -> void {
    assert_eq(normalized_path(r"C:\Temp\doc\.\shapes"), "C:/Temp/doc/shapes")
}
