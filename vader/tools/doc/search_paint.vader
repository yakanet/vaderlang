// vader/tools/doc/search_paint: the colours of `vader doc --search` on a terminal.
//
// The 16 colours of the terminal, which follow its theme, in the roles of the
// site's code: keywords, types, constants, strings, comments; the name declared
// in bold, the module in the green of the logo, its place dimmed. Off a
// terminal, or under `NO_COLOR`, every helper gives its text back as it is.

module "vader/tools/doc"

import "std/collections"
import "std/iter"
import "std/string"
TTY :: import "std/tty"
import "toolchain/span"
Ty :: import "vader/core/types"
Lex :: import "vader/front/lexer"

// What a piece of text is, for its colour. Each is a role: two roles may share
// a colour today and part later.
Paint :: enum {
    Module,
    Place,
    Keyword,
    Type,
    Constant,
    String,
    Comment,
    Name,
    Label,
    Code,
    Plain,
}

// `s` in the colour of `paint`, as it is when the text is not coloured.
painted :: fn(ctx: TextCtx, paint: Paint, s: string) -> string {
    if !ctx.colored || s == "" {
        return s
    }
    return match paint {
        .Module   -> TTY.sgr("1;32", s)
        .Place    -> TTY.dim(s)
        .Keyword  -> TTY.magenta(s)
        .Type     -> TTY.cyan(s)
        .Constant -> TTY.yellow(s)
        .String   -> TTY.green(s)
        .Comment  -> TTY.dim(s)
        .Name     -> TTY.bold(s)
        .Label    -> TTY.bold(s)
        .Code     -> TTY.cyan(s)
        .Plain    -> s
    }
}

// The lines of a paragraph of prose, the code between its backticks painted
// without them, a span that runs over a line included. A paragraph whose
// backticks do not pair keeps them all; a blank line ends a paragraph.
painted_paragraphs :: fn(ctx: TextCtx, lines: string[]) -> string[] {
    if !ctx.colored {
        return lines
    }
    out: string[]: []
    start: i64 = 0
    for i in 0..=lines.len() {
        if i == lines.len() || lines[i].trim() == "" {
            out.push_all(painted_paragraph(ctx, lines[start..<i]))
            if i < lines.len() {
                out.push(lines[i])
            }
            start = i + 1
        }
    }
    return out
}

// The lines of one paragraph, painted as `painted_paragraphs` says.
painted_paragraph :: fn(ctx: TextCtx, lines: string[]) -> string[] {
    ticks: i64 = 0
    for line in lines {
        ticks += line.split("`").len() - 1
    }
    if ticks % 2 == 1 {
        return lines
    }
    out: string[]: []
    inside := false
    for line in lines {
        parts :: line.split("`")
        painted_line: string[]: []
        for i in 0..<parts.len() {
            if i > 0 {
                inside = !inside
            }
            if inside {
                painted_line.push(painted(ctx, .Code, parts[i]))
            } else {
                painted_line.push(parts[i])
            }
        }
        out.push(painted_line.join(""))
    }
    return out
}

// A name as a query writes it, its module in the module's colour and the rest
// in bold: `std/io.read_file_bytes`.
painted_qualified :: fn(ctx: TextCtx, name: string) -> string {
    dot :: name.index_of('.', 0)
    if dot < 0 {
        return painted(ctx, .Module, name)
    }
    rest :: name.byte_slice(dot, name.byte_len())
    return painted(ctx, .Module, name.byte_slice(0, dot)) + painted(ctx, .Name, rest)
}

// A line of Vader with its words, strings and characters painted as the lexer
// reads them, and its comments; `name`, the name it declares, in bold.
painted_code :: fn(ctx: TextCtx, line: string, name: string) -> string {
    if !ctx.colored {
        return line
    }
    out: string[]: []
    for piece in code_pieces(line, name) {
        out.push(painted(ctx, piece.paint, piece.text))
    }
    return out.join("")
}

// A piece of a line of code and the colour it takes.
CodePiece :: struct {
    text: string
    paint: Paint
}

// The pieces of `line`, in order: the lexer's tokens and comments, and the
// text between them, plain. A line cut out of a longer literal lexes with
// errors, which leave their text plain.
code_pieces :: fn(line: string, name: string) -> CodePiece[] {
    lexed :: Lex.tokenize_with_docs(line, "")
    line_cut :: LineCut { .line = line, .comments = lexed.comments }
    for t in lexed.tokens {
        line_cut.cut_comments_before(t.span.start.offset)
        line_cut.cut(t.span, token_paint(t, name))
    }
    line_cut.plain_until(line.byte_len())
    return line_cut.pieces
}

// A line being cut into pieces, up to its byte `at`.
LineCut :: struct {
    line: string
    comments: Span[]
    pieces: CodePiece[] = []
    at: i64 = 0
    // The first of `comments` not cut yet.
    next_comment: i64 = 0
}

// Cut the comments that start before `offset`.
cut_comments_before :: fn(self: LineCut, offset: i64) -> void {
    for self.next_comment < self.comments.len() {
        comment :: self.comments[self.next_comment]
        if comment.start.offset >= offset {
            return
        }
        self.cut(comment, .Comment)
        self.next_comment += 1
    }
}

// Cut `span` of the line as a piece in `paint`, after the plain text before it.
// An empty span cuts nothing.
cut :: fn(self: LineCut, span: Span, paint: Paint) -> void {
    if span.end.offset <= span.start.offset || span.start.offset < self.at {
        return
    }
    self.plain_until(span.start.offset)
    self.pieces.push(CodePiece { .text = span.text_in(self.line), .paint = paint })
    self.at = span.end.offset
}

// Cut the text from `at` to `end` as a plain piece.
plain_until :: fn(self: LineCut, end: i64) -> void {
    if end <= self.at {
        return
    }
    self.pieces.push(CodePiece { .text = self.line.byte_slice(self.at, end), .paint = .Plain })
    self.at = end
}

// The colour of the token `t`.
token_paint :: fn(t: Lex.Token, name: string) -> Paint {
    if is_quoted(t.kind) {
        return .String
    }
    if t.kind == .Ident {
        return word_paint(t.text, name)
    }
    if t.text in Lex.KEYWORDS {
        return .Keyword
    }
    return .Plain
}

// Whether a token of `kind` is a piece of a string or of a character.
is_quoted :: fn(kind: Lex.TokenKind) =
    kind == .StringBegin || kind == .StringPart || kind == .StringEnd || kind == .CharLit

// The colour of the identifier `word`: `name`, a constant, a type, or none.
word_paint :: fn(word: string, name: string) -> Paint {
    if word == name {
        return .Name
    }
    if is_constant_name(word) {
        return .Constant
    }
    if word.byte_at(0) in 'A'..='Z' || Ty.is_scalar_type_name(word) || word == "never" {
        return .Type
    }
    return .Plain
}

// Whether `word` is written as a constant: upper-case letters, digits and `_`,
// two at least.
is_constant_name :: fn(word: string) -> bool {
    if word.byte_len() < 2 || !(word.byte_at(0) in 'A'..='Z') {
        return false
    }
    for i in 0..<word.byte_len() {
        b :: word.byte_at(i)
        if !(b in 'A'..='Z' || b in '0'..='9' || b == '_') {
            return false
        }
    }
    return true
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// A context that asks for colours, over an empty catalog. `std/tty` paints only
// on a terminal: under a test the helpers may give their text back as it is,
// which the tests below allow for.
colored_ctx :: fn() -> TextCtx = TextCtx {
    .catalog = read_catalog([]),
    .base = "/",
    .here = "/",
    .colored = true,
    .places = MutableMap<string, string> {},
}

@test
test_search_paint_tells_constants_from_types :: fn() -> void {
    assert(is_constant_name("READ_LIMIT_DEFAULT"), "upper case and `_` is a constant")
    assert(!is_constant_name("IOError"), "a lower-case letter makes a type")
    assert(!is_constant_name("T"), "and so does a single letter")
}

@test
test_search_paint_keeps_unpaired_backticks :: fn() -> void {
    assert_eq(painted_paragraphs(colored_ctx(), ["a ` b"]).join("|"), "a ` b")
}

@test
test_search_paint_keeps_the_text_of_a_line_of_code :: fn() -> void {
    line :: "export f :: fn(c: char) -> bool = c == '\"' && \"a\\\"b\" != \"\"  // done"
    assert_eq(TTY.without_escapes(painted_code(colored_ctx(), line, "f")), line)
}

// The texts of the pieces of `line` painted in `paint`.
pieces_painted :: fn(line: string, paint: Paint) -> string[] {
    texts: string[]: []
    for piece in code_pieces(line, "") {
        if piece.paint == paint {
            texts.push(piece.text)
        }
    }
    return texts
}

@test
test_search_paint_paints_a_character_as_a_string :: fn() -> void {
    assert_eq(pieces_painted("b == '\"' && x", .String).join("|"), "'\"'")
}

@test
test_search_paint_follows_an_interpolation :: fn() -> void {
    // The quote and the apostrophe inside `${...}` belong to the string: what
    // follows it is code again.
    line :: "g :: \"x \${f(\"a'b\")} y\"  // done"
    assert_eq(pieces_painted(line, .Comment).join("|"), "// done")
}
