// vader/tools/doc/index: what `vader doc` says about each module.
//
// It reads the declarations the loader parsed with their vaderdoc
// (`check_scope`), never the files again: one parse, the build's own. An export
// or an impl becomes an entry with its head as the hover shows it
// (`vader/tools/fmt`), its vaderdoc split by its tags (`doc_sections` in
// `toolchain/ast`) and its members: the fields of a struct, the variants of an
// enum, the methods of a trait or an impl. What the source leaves unwritten (a
// return, a constant's type) comes from the typecheck of the same load.

module "vader/tools/doc"

import "std/collections"
import "std/iter"
import "std/path"
import "std/sort"
import "std/string"
import "toolchain/ast"
import "vader/front/resolver"
import "vader/support/diagnostics"
import "vader/tools/fmt"
Tc :: import "vader/front/typecheck"
Ty :: import "vader/core/types"

/// What `vader doc` documented of a scope, and what it had to leave out.
export Documented :: struct {
    /// The modules of the scope the load reached, in its order.
    modules: DocModule[]
    /// One line per module of the scope it did not reach, saying why.
    left_out: string[]
}

/// One documented module.
export DocModule :: struct {
    /// Its name, as its files declare it.
    path: string
    /// The first paragraph of its header, without the `path:` it opens with:
    /// what a list of modules shows.
    summary: string
    /// The header of its main file: the `//` lines above its `module` line.
    header: string
    /// Its files, in the order the loader read them, relative to the folder
    /// `index_modules` was given when they lie under it.
    files: string[]
    /// Its exports and its impls, file by file, in source order.
    decls: DocDecl[]
}

/// One export, or one impl.
export DocDecl :: struct {
    /// `<module>/<name>`, `<module>/<name>~<n>` for the n-th of an overloaded
    /// name, `<module>/<type>: <trait>` for an impl: where it is found, by a
    /// link or a search.
    id: string = ""
    /// Its name; `<type>: <trait>` for an impl.
    name: string
    /// `fn`, `struct`, `enum`, `trait`, `type`, `const` or `impl`.
    kind: string
    /// Its head as the hover shows it, `export` included, ending with the return
    /// typing gave a fn whose source writes none; each name in it that a reader
    /// can follow a link.
    signature: DocSegment[]
    /// What typing gave that the source leaves unwritten: the return of a fn,
    /// the type of a constant; empty otherwise.
    inferred: DocSegment[] = []
    /// The file that declares it, written as in `DocModule.files`.
    file: string
    /// The line of its name, from 1; of its first line for an impl.
    line: i32
    /// Its vaderdoc split by its tags, null without one.
    doc: DocSections | null
    /// The platforms an `@target` group exists on; empty for a declaration that
    /// exists on every platform.
    targets: string[] = []
    /// The trait an impl implements, with its arguments; "" for an export.
    trait_name: string = ""
    /// The type an impl is for; "" for an export.
    for_type: string = ""
    members: DocMember[] = []
}

/// A field of a struct, a variant of an enum, or a method of a trait or an impl.
export DocMember :: struct {
    /// `<id of its declaration>.<name>`.
    id: string = ""
    name: string
    /// `field`, `variant` or `method`.
    kind: string
    /// Its head as the hover shows it, ending with the return typing gave a
    /// method whose source writes none.
    signature: DocSegment[]
    /// The return typing gave a method whose source writes none; empty
    /// otherwise.
    inferred: DocSegment[] = []
    /// The line of its name, from 1.
    line: i32
    doc: DocSections | null
}

/// Document the modules of `scope`, as `project` loaded them.
///
/// A module of the scope is left out when the load did not reach its folder:
/// no search root of the project holds it, or another folder declaring the same
/// module comes first.
///
/// @param checked  the load and the typecheck of the scope (`check_scope`).
/// @param scope    the modules to document (`doc_scope`).
/// @param base     the absolute folder file paths are written relative to, when
///                 they lie under it, however the loader spelled them.
export index_modules :: fn(checked: DocCheck, scope: DiscoveredModule[], base: string) -> Documented {
    loaded :: module_index_by_name(checked.project)
    modules: DocModule[]: []
    left_out: string[]: []
    for wanted in scope {
        folder :: display_path(wanted.folder, base)
        found :: loaded[wanted.name]
        if found == null {
            left_out.push("`${wanted.name}` (`${folder}`) is under no search root")
        } else if !same_folder(found.module.id, wanted.folder) {
            left_out.push(
                "`${wanted.name}` (`${folder}`) is shadowed by the module of `${display_path(found.module.id, base)}`",
            )
        } else {
            modules.push(index_module(checked, found, base))
        }
    }
    return Documented { .modules = modules, .left_out = left_out }
}

// What documenting one file of a module needs.
FileContext :: struct {
    project: LoadedProject
    file: SourceFile
    /// The file as the data writes it (`display_path`).
    path: string
    /// The typed module, null when typing reached none.
    typed: Tc.TypedProgram | null
    /// The `@target` declarations of the module, as written.
    target_decls: FnDecl[]
}

// The documentation of the module `loaded` of `checked`, its files relative to
// `base`.
index_module :: fn(checked: DocCheck, loaded: LoadedModule, base: string) -> DocModule {
    module :: loaded.module
    typed :: checked.typed[module.id]
    files: string[]: []
    decls: DocDecl[]: []
    for file in module.files {
        ctx :: FileContext {
            .project = checked.project,
            .file = file,
            .path = display_path(file.path, base),
            .typed = typed,
            .target_decls = loaded.target_decls,
        }
        files.push(ctx.path)
        for d in file.program.decls {
            decl :: doc_decl(ctx, d) ?? continue
            decls.push(decl)
        }
    }
    assign_ids(module.module_name, decls)
    header :: module_header(module)
    return DocModule {
        .path = module.module_name,
        .summary = header_summary(header),
        .header = header,
        .files = files,
        .decls = decls,
    }
}

// The entry of `d`; null when `d` is neither an export nor an impl.
doc_decl :: fn(ctx: FileContext, d: Decl) -> DocDecl | null {
    if d is ImplDecl {
        return impl_decl(ctx, d)
    }
    if !decl_is_public(d) {
        return null
    }
    name_span :: decl_name_span(d) ?? return null
    inferred :: inferred_of(ctx, d)
    return DocDecl {
        .name = ctx.file.content.byte_slice(name_span.start.offset, name_span.end.offset),
        .kind = kind_of(d),
        .signature = signature_of(ctx, "export ", d, inferred),
        .inferred = inferred,
        .file = ctx.path,
        .line = name_span.start.line,
        .doc = sections_of(decl_doc(d)),
        .targets = targets_of(d, ctx.target_decls),
        .members = members_of(ctx, d),
    }
}

// The entry of the impl `d`, named after the type it is for and its trait.
impl_decl :: fn(ctx: FileContext, d: ImplDecl) -> DocDecl {
    for_type :: format_type_expr(ctx.file.content, d.for_type)
    trait_name :: format_impl_trait(ctx.file.content, d)
    return DocDecl {
        .name = "${for_type}: ${trait_name}",
        .kind = "impl",
        .signature = head_segments(ctx, format_impl_head(ctx.file.content, d)),
        .file = ctx.path,
        .line = d.span.start.line,
        .doc = sections_of(d.doc),
        .trait_name = trait_name,
        .for_type = for_type,
        .members = methods_of(ctx, d.members),
    }
}

// Give each entry of `module` its id, and each member its own: an overloaded
// name numbers its declarations in source order.
assign_ids :: fn(module: string, decls: DocDecl[]) -> void {
    counts :: MutableMap<string, i64> {}
    for d in decls {
        counts[d.name] = (counts[d.name] ?? 0) + 1
    }
    seen :: MutableMap<string, i64> {}
    for d in decls {
        n :: seen[d.name] ?? 0
        seen[d.name] = n + 1
        d.id = "${module}/${d.name}${overload_suffix(counts[d.name] ?? 0, n)}"
        for m in d.members {
            m.id = "${d.id}.${m.name}"
        }
    }
}

// `~n` for the n-th declaration of a name `count` declarations share, "" for a
// name only one declares.
overload_suffix :: fn(count: i64, n: i64) -> string {
    if count < 2 {
        return ""
    }
    return "~${n}"
}

// The kind an export is listed under: a constant whose value reads as a type is
// a `type`.
kind_of :: fn(d: Decl) -> string = match d {
    is FnDecl                             -> "fn"
    is StructDecl                         -> "struct"
    is EnumDecl                           -> "enum"
    is TraitDecl                          -> "trait"
    is TypeAliasDecl                      -> "type"
    is ConstDecl                          -> const_kind(d)
    is ImplDecl | AssertDecl | ImportDecl -> ""
}

const_kind :: fn(d: ConstDecl) -> string {
    if is_type_value(d.value) {
        return "type"
    }
    return "const"
}

// The platforms the `@target` group `d` heads exists on, sorted, from the
// module's `@target` declarations as written. Empty when the bare declaration has
// a body, its own or one the host provides: the function exists everywhere, and
// its other bodies are how, not where. Empty too when `d` heads no group.
targets_of :: fn(d: Decl, target_decls: FnDecl[]) -> string[] {
    if d !is FnDecl || target_selectors(d.decorators) == null {
        return []
    }
    oses: string[]: []
    for body in target_decls {
        if body.name != d.name {
            continue
        }
        selectors :: target_selectors(body.decorators) ?? continue
        if selectors.is_bare && has_body(body) {
            return []
        }
        for os in selectors.os {
            oses.push("${os}")
        }
    }
    return sort(oses, (a: string, b: string) -> a < b)
}

// Whether `fd` has a body: written, or provided by the host (`@extern`,
// `@intrinsic`).
has_body :: fn(fd: FnDecl) -> bool {
    if fd.body != null {
        return true
    }
    for dec in fd.decorators {
        if provides_body(dec.name) {
            return true
        }
    }
    return false
}

// The members of `d`: the fields of a struct, the variants of an enum, the
// methods of a trait. A field restricted to its module (`@internal`) is left
// out.
members_of :: fn(ctx: FileContext, d: Decl) -> DocMember[] = match d {
    is StructDecl -> d.fields.filter((f: StructField) -> f.visibility != .Private).map(
        (f: StructField) -> DocMember {
            .name = f.name,
            .kind = "field",
            .signature = head_segments(ctx, format_field_head(ctx.file.content, f)),
            .line = f.span.start.line,
            .doc = sections_of(f.doc),
        },
    ).collect()
    is EnumDecl -> d.variants.map(
        (v: EnumVariant) -> DocMember {
            .name = v.name,
            .kind = "variant",
            .signature = head_segments(ctx, format_variant_head(ctx.file.content, v)),
            .line = v.span.start.line,
            .doc = sections_of(v.doc),
        },
    ).collect()
    is TraitDecl -> methods_of(ctx, d.members)
    is FnDecl | TypeAliasDecl | ConstDecl | ImplDecl | AssertDecl | ImportDecl -> []
}

// The methods of a trait or an impl, as members: those its source writes, not
// those the typecheck added to an impl (a trait's default body, a host stub).
methods_of :: fn(ctx: FileContext, methods: FnDecl[]) -> DocMember[] =
    methods.filter((fd: FnDecl) -> !fd.materialized).map((fd: FnDecl) -> method_member(ctx, fd)).collect()

method_member :: fn(ctx: FileContext, fd: FnDecl) -> DocMember {
    inferred :: unwritten_return(ctx, fd)
    return DocMember {
        .name = fd.name,
        .kind = "method",
        .signature = signature_of(ctx, "", fd, inferred),
        .inferred = inferred,
        .line = fd.name_span.start.line,
        .doc = sections_of(fd.doc),
    }
}

// The signature of `d`: `prefix`, its head, and for a fn whose source writes no
// return, the return `inferred` typing gave it.
signature_of :: fn(
    ctx: FileContext,
    prefix: string,
    d: Decl,
    inferred: DocSegment[],
) -> DocSegment[] {
    out: DocSegment[]: []
    out.push_text(prefix)
    out.append_segments(head_segments(ctx, format_decl_head(ctx.file.content, d)))
    if d is FnDecl && inferred.len() > 0 {
        out.push_text(" -> ")
        out.append_segments(inferred)
    }
    return out
}

// What typing gave `d` that its source leaves unwritten: the return of a fn, the
// type of a constant; empty for every other declaration.
inferred_of :: fn(ctx: FileContext, d: Decl) -> DocSegment[] = match d {
    is FnDecl    -> unwritten_return(ctx, d)
    is ConstDecl -> unwritten_type(ctx, d)
    is StructDecl | EnumDecl | TraitDecl | TypeAliasDecl | ImplDecl | AssertDecl | ImportDecl -> []
}

// The return typing gave the fn `fd` when its source writes none: inferred from an
// expression body, or taken from the trait an impl method implements. Empty when
// the source writes it, and for a return a reader would not write (`void`,
// `never`) or typing could not settle.
unwritten_return :: fn(ctx: FileContext, fd: FnDecl) -> DocSegment[] {
    if fd.return_type != null || fd.comptime_synthetic {
        return []
    }
    typed :: ctx.typed ?? return []
    t :: Tc.declared_type_at(typed, fd.name_span)
    if t is Ty.FnType {
        return shown_type(t.return_type)
    }
    return []
}

// The type typing gave the constant `d` when its source writes none and its value
// is no type, empty otherwise.
unwritten_type :: fn(ctx: FileContext, d: ConstDecl) -> DocSegment[] {
    if d.ty != null || is_type_value(d.value) {
        return []
    }
    typed :: ctx.typed ?? return []
    t :: Tc.declared_type_at(typed, d.name_span) ?? return []
    return shown_type(t)
}

// `t` as a reader sees it, its nominal names linked; empty for what a reader
// would not write (`void`, `never`) and for what typing could not settle.
shown_type :: fn(t: Ty.Type) -> DocSegment[] {
    if t is Ty.UnresolvedType || t is Ty.NeverType || Ty.is_void(t) {
        return []
    }
    return type_segments(t)
}

// Whether `a` and `b` name the same folder, however each is spelled.
same_folder :: fn(a: string, b: string) -> bool =
    absolute_path(a).to_path().normalize() == absolute_path(b).to_path().normalize()

// `path` relative to the absolute folder `base` when it lies under it, absolute
// otherwise.
display_path :: fn(path: string, base: string) -> string =
    relative_to(absolute_path(path).to_path().normalize().as_string(), base)

// `doc` split by its tags, null without one.
sections_of :: fn(doc: DocComment | null) -> DocSections | null {
    text :: doc_text(doc)
    if text.trim().byte_len() == 0 {
        return null
    }
    return doc_sections(text)
}

/// The first sentence of `prose`: its first paragraph, lines joined, up to the
/// first period a blank or the end follows. What a list of entries shows.
///
/// @param prose  the prose of a vaderdoc (`DocSections.prose`).
export first_sentence :: fn(prose: string) -> string {
    paragraph :: first_paragraph(prose)
    n :: paragraph.byte_len()
    for i in 0..<n {
        if paragraph.byte_at(i) == '.' && (i + 1 == n || paragraph.byte_at(i + 1) == ' ') {
            return paragraph.byte_slice(0, i + 1)
        }
    }
    return paragraph
}

// The first paragraph of `text`, its lines trimmed and joined by a space.
first_paragraph :: fn(text: string) -> string {
    lines :: text.split("\n\n")[0].split("\n")
    return lines.map((line: string) -> line.trim()).collect().join(" ")
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_display_path_under_and_outside_its_base :: fn() -> void {
    assert_eq(display_path("/repo/lib/std/io/io.vader", "/repo"), "lib/std/io/io.vader")
    assert_eq(display_path("/repo/./lib/../lib/x.vader", "/repo"), "lib/x.vader")
    assert_eq(display_path("/other/x.vader", "/repo"), "/other/x.vader")
}

@test
test_overload_suffix_numbers_only_a_shared_name :: fn() -> void {
    assert_eq(overload_suffix(1, 0), "")
    assert_eq(overload_suffix(2, 1), "~1")
}

@test
test_first_sentence_stops_at_a_period_and_a_blank :: fn() -> void {
    assert_eq(first_sentence("Read `a.b`, then stop. More."), "Read `a.b`, then stop.")
}

@test
test_first_sentence_joins_the_lines_of_its_paragraph :: fn() -> void {
    assert_eq(first_sentence("One sentence\nwrapped\n\nNext paragraph."), "One sentence wrapped")
}
