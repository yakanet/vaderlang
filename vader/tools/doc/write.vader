// vader/tools/doc/write: the data `vader doc` writes, as JSON.
//
// `index.json` lists every module and every export, enough to search them;
// `modules/<path>.json` holds one module whole. The format is described in
// `docs/TOOLING.md` (*`vader doc`*), and its `version` is what a reader checks.

module "vader/tools/doc"

import "json"
import "std/collections"
import "std/io"
import "std/iter"
import "std/path"
import "std/string"
import "toolchain/ast"
import "vader/front/resolver"

/// The version of the data format, written in each file.
DOC_FORMAT_VERSION: f64: 1.0

/// Write the data of `modules` under `dir`: `index.json`, and one
/// `modules/<path>.json` per module. The stamp goes first, since the data stops
/// being what it says, then the module files the previous `index.json` listed,
/// so that a module no longer documented leaves none behind.
///
/// @param dir      the folder to write in, created when missing.
/// @param modules  the documented modules.
/// @error          `IOError` when a folder or a file cannot be written.
export write_doc_data :: fn(dir: string, modules: DocModule[]) -> null | IOError {
    remove_file(join_path(dir, STAMP_FILE))
    remove_previous_modules(dir)
    for m in modules {
        path :: module_file(dir, m.path)
        made :: create_dir(dir_of(path))
        if made is IOError {
            return made
        }
        written :: write_json(path, module_json(m))
        if written is IOError {
            return written
        }
    }
    made :: create_dir(dir)
    if made is IOError {
        return made
    }
    return write_json(join_path(dir, INDEX_FILE), index_json(modules))
}

// The index's file name in the data folder.
INDEX_FILE :: "index.json"

// Where the data of the module `path` goes under `dir`.
module_file :: fn(dir: string, path: string) -> string = join_path(dir, "modules/${path}.json")

// `value` indented in the file `path`, a newline at its end.
write_json :: fn(path: string, value: JsonValue) -> null | IOError =
    write_file_string(path, stringify_pretty(value, 2) + "\n")

// Remove the module files the `index.json` under `dir` lists, those under
// `modules/` only: a path read back from a file is not trusted to stay there.
// A missing or unreadable index lists none.
remove_previous_modules :: fn(dir: string) -> void {
    modules_dir :: Path(join_path(dir, "modules")).normalize()
    text :: read_file_string(join_path(dir, INDEX_FILE))
    if text is IOError {
        return
    }
    index :: parse(text)
    if index !is JsonObject {
        return
    }
    modules :: index.entries["modules"] ?? return
    if modules !is JsonArray {
        return
    }
    for m in modules.items {
        if m !is JsonObject {
            continue
        }
        path :: m.entries["path"] ?? continue
        if path !is JsonString {
            continue
        }
        file :: module_file(dir, path.value)
        if Path(file).normalize().starts_with(modules_dir) {
            remove_file(file)
        }
    }
}

// `index.json`: the modules, and every export, impl and member with what a list
// shows of it.
index_json :: fn(modules: DocModule[]) -> JsonValue {
    module_items: JsonValue[]: []
    entries: JsonValue[]: []
    for m in modules {
        item :: MutableMap<string, JsonValue> {}
        item["path"] = json_text(m.path)
        item["summary"] = json_text(m.summary)
        item["files"] = json_texts(m.files)
        module_items.push(JsonObject { .entries = item })
        for d in m.decls {
            entries.push(
                index_entry(m.path, d.id, d.name, d.kind, d.signature, d.doc, owner_of_decl(d)),
            )
            for member in d.members {
                entries.push(
                    index_entry(
                        m.path,
                        member.id,
                        member.name,
                        member.kind,
                        member.signature,
                        member.doc,
                        d.id,
                    ),
                )
            }
        }
    }
    root :: MutableMap<string, JsonValue> {}
    root["version"] = JsonNumber { .value = DOC_FORMAT_VERSION }
    root["modules"] = JsonArray { .items = module_items }
    root["entries"] = JsonArray { .items = entries }
    return JsonObject { .entries = root }
}

// One entry of `index.json`.
index_entry :: fn(
    module: string,
    id: string,
    name: string,
    kind: string,
    signature: DocSegment[],
    doc: DocSections | null,
    owner: string,
) -> JsonValue {
    entry :: MutableMap<string, JsonValue> {}
    entry["id"] = json_text(id)
    entry["module"] = json_text(module)
    entry["name"] = json_text(name)
    entry["kind"] = json_text(kind)
    entry["signature"] = json_text(segments_text(signature))
    entry["summary"] = json_text(summary_of(doc))
    entry["owner"] = json_text(owner)
    return JsonObject { .entries = entry }
}

// The id of the type the impl `d` is for: the declaration its head names first,
// when the type is that declaration, with or without type arguments. "" for
// another declaration, and for a type no declaration stands for (`T[]`, `string`).
owner_of_decl :: fn(d: DocDecl) -> string {
    if d.kind != "impl" || d.signature.len() == 0 {
        return ""
    }
    head :: d.signature[0]
    if head.module == "" || !(d.for_type == head.text || d.for_type.starts_with("${head.text}<")) {
        return ""
    }
    return doc_id(head.module, head.name)
}

// `modules/<path>.json`: one module whole.
module_json :: fn(m: DocModule) -> JsonValue {
    root :: MutableMap<string, JsonValue> {}
    root["version"] = JsonNumber { .value = DOC_FORMAT_VERSION }
    root["path"] = json_text(m.path)
    root["summary"] = json_text(m.summary)
    root["header"] = json_text(m.header)
    root["files"] = json_texts(m.files)
    root["decls"] = JsonArray { .items = m.decls.map(decl_json).collect() }
    return JsonObject { .entries = root }
}

// An export or an impl, its members included; `trait` and `for` for an impl.
decl_json :: fn(d: DocDecl) -> JsonValue {
    decl :: MutableMap<string, JsonValue> {}
    decl["id"] = json_text(d.id)
    decl["name"] = json_text(d.name)
    decl["kind"] = json_text(d.kind)
    decl["signature"] = segments_json(d.signature)
    decl["inferred"] = inferred_json(d.kind, d.inferred)
    decl["file"] = json_text(d.file)
    decl["line"] = JsonNumber { .value = f64(d.line) }
    decl["column"] = JsonNumber { .value = f64(d.column) }
    decl["doc"] = doc_json(d.doc)
    if d.kind == "impl" {
        decl["trait"] = json_text(d.trait_name)
        decl["for"] = json_text(d.for_type)
    }
    decl["targets"] = json_texts(d.targets)
    decl["members"] = JsonArray { .items = d.members.map(member_json).collect() }
    return JsonObject { .entries = decl }
}

// A field, a variant or a method.
member_json :: fn(m: DocMember) -> JsonValue {
    member :: MutableMap<string, JsonValue> {}
    member["id"] = json_text(m.id)
    member["name"] = json_text(m.name)
    member["kind"] = json_text(m.kind)
    member["signature"] = segments_json(m.signature)
    member["inferred"] = inferred_json(m.kind, m.inferred)
    member["line"] = JsonNumber { .value = f64(m.line) }
    member["column"] = JsonNumber { .value = f64(m.column) }
    member["doc"] = doc_json(m.doc)
    return JsonObject { .entries = member }
}

// What typing gave that the source leaves unwritten: `{ "type": T }` for a
// constant, `{ "return": T }` for a fn or a method, `null` for nothing.
inferred_json :: fn(kind: string, inferred: DocSegment[]) -> JsonValue {
    if inferred.len() == 0 {
        return JsonNull {}
    }
    out :: MutableMap<string, JsonValue> {}
    out[inferred_key(kind)] = segments_json(inferred)
    return JsonObject { .entries = out }
}

// A signature or a type: its segments in order, each `{ "text" }`, with the
// `module` and the `name` of the declaration a name links to.
segments_json :: fn(segments: DocSegment[]) -> JsonValue = JsonArray {
    .items = segments.map(segment_json).collect(),
}

segment_json :: fn(segment: DocSegment) -> JsonValue {
    out :: MutableMap<string, JsonValue> {}
    out["text"] = json_text(segment.text)
    if segment.module != "" {
        out["module"] = json_text(segment.module)
        out["name"] = json_text(segment.name)
    }
    return JsonObject { .entries = out }
}

inferred_key :: fn(kind: string) -> string {
    if kind == "const" {
        return "type"
    }
    return "return"
}

// A vaderdoc, `null` without one: its summary and its example as shown come
// from its sections.
doc_json :: fn(doc: DocSections | null) -> JsonValue {
    if doc == null {
        return JsonNull {}
    }
    params: JsonValue[]: []
    for p in doc.params {
        param :: MutableMap<string, JsonValue> {}
        param["name"] = json_text(p.name)
        param["text"] = json_text(p.text)
        params.push(JsonObject { .entries = param })
    }
    out :: MutableMap<string, JsonValue> {}
    out["summary"] = json_text(first_sentence(doc.prose))
    out["prose"] = json_text(doc.prose)
    out["params"] = JsonArray { .items = params }
    out["returns"] = json_texts(doc.returns)
    out["errors"] = json_texts(doc.errors)
    out["example"] = json_text(shown_example(doc))
    return JsonObject { .entries = out }
}

// The summary of a vaderdoc, "" without one.
summary_of :: fn(doc: DocSections | null) -> string {
    if doc == null {
        return ""
    }
    return first_sentence(doc.prose)
}

json_text :: fn(value: string) -> JsonValue = JsonString { .value = value }

json_texts :: fn(values: string[]) -> JsonValue = JsonArray {
    .items = values.map(json_text).collect(),
}
