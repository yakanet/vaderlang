// vader/tools/lsp/protocol/log: server-side logging via LSP `window/logMessage`, and
// the warnings the user must see, via `window/showMessage`.
//
// The client (VSCode, IntelliJ, …) renders these as plain lines in the
// `Vader Language Server` output channel, alongside the JSON-RPC trace.
// This lets us surface server-side state without polluting stdout
// (which is reserved for the JSON-RPC stream) or stderr (which most
// clients don't display).

module "vader/tools/lsp/protocol"

import "json"
import "std/collections"

/// Severity tag per LSP spec.
export LogLevel :: enum(i32) {
    Error = 1,
    Warning = 2,
    Info = 3,
    Log = 4,
    Debug = 5,
}

/// Emit a `window/logMessage` notification.
export log :: fn(level: LogLevel, message: string) -> void = notify("window/logMessage", level, message)

/// Show `message` to the user as a warning (`window/showMessage`): what the
/// server cannot do and the user has to act on, not a line of its log.
///
/// @param message  the text the editor shows.
export show_warning :: fn(message: string) -> void = notify("window/showMessage", .Warning, message)

// A `window/*Message` notification: `method`, carrying `message` at `level`.
notify :: fn(method: string, level: LogLevel, message: string) -> void {
    params_map :: MutableMap<string, JsonValue> {}
    params_map["type"]    = JsonNumber { .value = f64(i32(level)) }
    params_map["message"] = JsonString { .value = message }
    write_frame(encode_notification(method, JsonObject { .entries = params_map }))
}

export log_warn  :: fn(message: string) -> void { log(.Warning, message) }
export log_info  :: fn(message: string) -> void { log(.Info, message) }