// vader/tools/lsp/analysis/ast_walk: cursor-driven AST position finders.
//
// Shared "what AST node is under the cursor" traversals, factored out of the
// individual handlers so hover, typeDefinition, signatureHelp (and the
// completion / code-action layers) all descend the tree the same way :
//
//   - `enclosing_exprs`         : the full containing-expression chain, innermost
//                                 first (code actions). The base traversal that
//                                 `find_enclosing_call` filters.
//   - `find_enclosing_call`     : the innermost `CallExpr` containing the cursor
//                                 (signatureHelp): a thin filter over
//                                 `enclosing_exprs`.
//   - `find_expr_at`            : the smallest *typed* expression at a position
//                                 (hover, typeDefinition, completion receiver).
//   - `find_binding_rhs_type_at`: the inferred type of a `let` / `::` binding
//                                 whose *name* the cursor sits on (hover).
//
// Each is a visitor over `AST.inspect`, sharing the `span_contains` / `span_size`
// geometry from `protocol/position` (smallest-span-wins). Positions are 1-based,
// matching the AST `Span`.

module "vader/tools/lsp/analysis"

import "vader/core/types"
import "vader/front/typecheck"
import "vader/tools/lsp/protocol"
AST :: import "toolchain/ast"
import "toolchain/span"

// ---- smallest typed expression at a position ------------------------------

/// A document's typed view at a cursor : its file's declarations, its typed
/// program, and the cursor as the AST counts positions (1-based).
export TypedCursor :: struct {
    decls: AST.Decl[]
    typed: TypedProgram
    line: i32
    column: i32
}

/// The typed view of `file_path` at the 0-based LSP position, or null when the
/// file is no part of the typed project built for it.
///
/// @param state      the server state, which caches the typed project.
/// @param file_path  the document's filesystem path.
/// @param line       0-based line.
/// @param character  0-based character, in the negotiated encoding.
export typed_cursor :: fn(state: ServerState, file_path: string, line: i32, character: i32) -> TypedCursor | null {
    cached :: typed_project_for(state, file_path)
    entry :: cached.project.modules[cached.project.entry] ?? return null
    sf :: source_file_for_path(entry.module.files, file_path) ?? return null
    [l, column] :: state.span_point(file_path, line, character)
    return TypedCursor {
        .decls = sf.program.decls,
        .typed = cached.result.typed,
        .line = l,
        .column = column,
    }
}

/// The smallest expression under `cursor`, or null.
///
/// @param cursor  the typed view at the cursor.
export expr_under :: fn(cursor: TypedCursor) -> AST.Expr | null =
    find_expr_at(cursor.decls, cursor.line, cursor.column, cursor.typed)

/// Walk every fn body in `decls` looking for the smallest expression whose
/// span contains `(line, col)` AND has a `typed.expr_types` entry. Returns the
/// matching `AST.Expr`, or `null` on miss. Smallest match wins so hovering on
/// `x` in `f(x + y)` returns `x`, not the whole `f(...)` call.
///
/// @param decls  the file's top-level declarations to descend.
/// @param line   1-based cursor line.
/// @param col    1-based cursor column.
/// @param typed  the typed program (a node only matches if it carries a type).
/// @return       the innermost typed expression at the cursor, or `null`.
export find_expr_at :: fn(
    decls: AST.Decl[],
    line: i32,
    col: i32,
    typed: TypedProgram,
) -> AST.Expr | null = find_expr_with_mode(decls, line, col, .SmallestContaining, typed)

/// The receiver expression of a member access whose `.` sits at 1-based
/// `(line, dot_col)`: the outermost typed expression that *ends* exactly where
/// the dot begins. Spans encode `end` as one-past-the-last-char, so the receiver
/// of `recv.field` ends at the dot.
///
/// Anchors on the end column rather than "smallest node containing the column
/// just left of the dot" : that positional query mis-resolves a call receiver
/// (`f(a, b).m`) to its last argument, whose exclusive-end column overlaps the
/// closing `)`. The largest node ending at the dot is the call itself. Returns
/// `null` when nothing typed ends there (whitespace before the dot, an untyped
/// receiver): callers fall back to a positional lookup.
///
/// @param decls    the file's top-level declarations to descend.
/// @param line     1-based line of the dot.
/// @param dot_col  1-based column of the dot ; the receiver ends here.
/// @param typed    the typed program (a node only matches if it carries a type).
/// @return         the receiver expression, or `null`.
export find_receiver_before_dot :: fn(
    decls: AST.Decl[],
    line: i32,
    dot_col: i32,
    typed: TypedProgram,
) -> AST.Expr | null = find_expr_with_mode(decls, line, dot_col, .EndsAt, typed)

// Selection rule of the search : `SmallestContaining` keeps the innermost node
// over the cursor (hover / typeDefinition) ; `EndsAt` keeps the outermost node
// ending at `(line, col)` (completion receiver).
FindMode :: enum(u8) {
    SmallestContaining,
    EndsAt,
}

FindState :: struct {
    line: i32
    col: i32
    mode: FindMode
    best: AST.Expr | null = null
    best_size: u64 = 0
}

// Shared driver behind `find_expr_at` / `find_receiver_before_dot` : walks
// `decls`, keeping the best expression under `mode` (see `consider_expr`).
find_expr_with_mode :: fn(
    decls: AST.Decl[],
    line: i32,
    col: i32,
    mode: FindMode,
    typed: TypedProgram,
) -> AST.Expr | null {
    st :: FindState {
        .line = line,
        .col = col,
        .mode = mode,
    }
    for d in decls {
        AST.inspect(d, (n) -> find_step(n, typed, st))
    }
    return st.best
}

find_step :: fn(n: AST.Node, typed: TypedProgram, st: FindState) -> AST.Walk = match n {
    is AST.FnDecl -> own_code(n)
    is AST.Expr -> consider_expr(n, typed, st)
    is AST.ImportDecl | AST.StructDecl | AST.EnumDecl | AST.TraitDecl | AST.ImplDecl
        | AST.TypeAliasDecl | AST.ConstDecl | AST.AssertDecl | AST.Stmt | AST.Pattern -> .Descend
}

// A member the resolver materialized from its trait was not written in this
// file: its spans point into the trait's.
own_code :: fn(f: AST.FnDecl) -> AST.Walk {
    if f.materialized {
        return .Skip
    }
    return .Descend
}

consider_expr :: fn(e: AST.Expr, typed: TypedProgram, st: FindState) -> AST.Walk {
    if improves(e.span, st) && is_candidate(e, typed, st) {
        st.best = e
        st.best_size = span_size(e.span)
    }
    return .Descend
}

// Only a typed node is a candidate: no point reporting a node whose hover would
// show `?`, nor resolving a receiver the typed cache can't type. A namespace
// alias is a receiver all the same : in a type position (`bc.LocalGet { ... }`)
// it has no type, and its module lists the members.
//
// A block never is: the blank lines of a body would answer with the body's type,
// and an expression body's block has the span of the expression it wraps, which
// it would hide.
is_candidate :: fn(e: AST.Expr, typed: TypedProgram, st: FindState) -> bool {
    if e is AST.BlockExpr {
        return false
    }
    return typed.expr_types[e.id] != null
        || st.mode == .EndsAt && namespace_base_mod_id(e, typed) != null
}

// Whether a node spanning `sp` beats the best one so far : under `EndsAt` the
// outermost node ending exactly at the dot (the member-access receiver), under
// `SmallestContaining` the innermost node over the cursor.
improves :: fn(sp: Span, st: FindState) -> bool {
    if st.mode == .EndsAt {
        return sp.end.line == st.line && sp.end.column == st.col
            && (st.best == null || span_size(sp) > st.best_size)
    }
    return span_contains(sp, st.line, st.col) && (st.best == null || span_size(sp) < st.best_size)
}

// ---- inferred type of the binding whose name is under the cursor ----------

/// When `(line, col)` falls inside a `let` / `::` binding name, return the RHS
/// expression's inferred type. Returns `null` for any other cursor context.
///
/// @param decls  the file's top-level declarations to descend.
/// @param line   1-based cursor line.
/// @param col    1-based cursor column.
/// @param typed  the typed program: `expr_types` for a single name,
///               `local_types` for a destructuring slot.
/// @return       the binding's inferred type, or `null`.
export find_binding_rhs_type_at :: fn(
    decls: AST.Decl[],
    line: i32,
    col: i32,
    typed: TypedProgram,
) -> Type | null {
    st :: FindBindingState { .line = line, .col = col }
    for d in decls {
        if AST.inspect(d, (n) -> binding_step(n, typed, st)) {
            return st.ty
        }
    }
    return null
}

FindBindingState :: struct {
    line: i32
    col: i32
    ty: Type | null = null
}

binding_step :: fn(n: AST.Node, typed: TypedProgram, st: FindBindingState) -> AST.Walk = match n {
    is AST.FnDecl -> own_code(n)
    is AST.LetStmt -> found_binding(binding_type_at(n.binding, n.value, typed, st.line, st.col), st)
    is AST.MatchExpr -> header_binding(n, typed, st)
    is AST.ImportDecl | AST.StructDecl | AST.EnumDecl | AST.TraitDecl | AST.ImplDecl
        | AST.TypeAliasDecl | AST.ConstDecl | AST.AssertDecl | AST.AssignStmt
        | AST.DestructureAssignStmt | AST.ExprStmt | AST.ReturnStmt | AST.YieldStmt
        | AST.ForStmt | AST.BreakStmt | AST.ContinueStmt | AST.DeferStmt
        | AST.IntLitExpr | AST.FloatLitExpr | AST.BoolLitExpr | AST.NullLitExpr | AST.CharLitExpr
        | AST.StringLitExpr | AST.IdentExpr | AST.DotVariantExpr | AST.CallExpr | AST.FieldExpr
        | AST.IndexExpr | AST.UnaryExpr | AST.BinaryExpr | AST.NullCoalesceExpr | AST.IfExpr
        | AST.BlockExpr | AST.LambdaExpr | AST.StructLitExpr | AST.SeqLitExpr | AST.RangeExpr
        | AST.CastExpr | AST.GenericInstExpr | AST.IntrinsicCallExpr | AST.AwaitExpr
        | AST.FnTypeExpr | AST.ArrayTypeExpr | AST.Pattern -> .Descend
}

// The header's binding names the scrutinee : `match v :: f()` binds `v` to
// `f()`'s value, narrowed afterwards in each arm.
header_binding :: fn(m: AST.MatchExpr, typed: TypedProgram, st: FindBindingState) -> AST.Walk {
    binding :: m.binding ?? return .Descend
    return found_binding(binding_type_at(binding, m.scrutinee, typed, st.line, st.col), st)
}

// The walk stops at the binding under the cursor.
found_binding :: fn(ty: Type | null, st: FindBindingState) -> AST.Walk {
    if ty == null {
        return .Descend
    }
    st.ty = ty
    return .Stop
}

/// Type of the binding under the cursor in a `let`, or `null` when the cursor is
/// not on a bound name.
///
/// A single name reports the INITIALIZER's inferred type, which is the whole
/// point of this walk: `hover.vader` wants `origin: ? | null :: span_at(…)` to
/// surface what the typechecker resolved, not the `?` the user wrote.
/// `local_types` holds the DECLARED type, so it is only right where there is no
/// single initializer to read: a destructuring slot.
binding_type_at :: fn(
    b: AST.LetBinding,
    value: AST.Expr,
    typed: TypedProgram,
    line: i32,
    col: i32,
) -> Type | null {
    match b {
        is AST.SimpleBinding   -> {
            if span_contains(b.name_span, line, col) {
                return typed.expr_types[value.id]
            }
        }
        is AST.RestBinding     -> {
            // Keyed by the whole span, not `name_span`: `assign_binding_types`
            // writes it so, and the `...` makes the two start at different columns.
            if span_contains(b.name_span, line, col) {
                return typed.local_types[b.span.hash()]
            }
        }
        is AST.TupleBinding    -> {
            for element in b.elements {
                found :: binding_type_at(element, value, typed, line, col)
                if found != null {
                    return found
                }
            }
        }
        // `_ :: e` binds no name to hover.
        is AST.WildcardBinding -> {}
    }
    return null
}

// ---- innermost enclosing call --------------------------------------------

/// The innermost `CallExpr` whose span contains `(line, col)`, or `null`.
/// "Innermost" matters for nested calls like `f(g(|))`: we want `g` when the
/// cursor is between its parens, not the outer `f`.
///
/// A thin filter over `enclosing_exprs`, which already yields the containing
/// chain innermost-first : the first `CallExpr` in that chain is the smallest
/// call span over the cursor. Sharing the one traversal keeps the call walker
/// (signatureHelp) and the code-action walker from drifting apart.
///
/// @param decls  the file's top-level declarations to descend.
/// @param line   1-based cursor line.
/// @param col    1-based cursor column.
/// @return       the innermost enclosing `AST.CallExpr`, or `null`.
export find_enclosing_call :: fn(
    decls: AST.Decl[],
    line: i32,
    col: i32,
) -> AST.CallExpr | null {
    chain :: enclosing_exprs(decls, line, col)
    for i in 0..<chain.len() {
        e :: chain[i]
        if e is AST.CallExpr {
            return e
        }
    }
    return null
}

// ---- enclosing expression chain -------------------------------------------

/// Every expression whose span contains `(line, col)`, innermost first. The
/// code-action layer walks this chain to find the node a given action targets
/// (the enclosing match for match→if, the enclosing if for if→match, …) without
/// a per-node-kind walker. 1-based coords.
///
/// @param decls  the file's top-level declarations to descend.
/// @param line   1-based cursor line.
/// @param col    1-based cursor column.
/// @return       the containing expressions, innermost (smallest span) first.
export enclosing_exprs :: fn(decls: AST.Decl[], line: i32, col: i32) -> AST.Expr[] {
    st :: EncloseState { .line = line, .col = col }
    walk_enclosing(decls, st)
    return st.acc
}

EncloseState :: struct {
    line: i32
    col: i32
    acc: AST.Expr[] = []
    /// The statements containing the position, innermost first.
    stmts: Span[] = []
}

/// The spans of every expression and statement containing `(line, col)`, in no
/// particular order : what "extend selection" steps through. 1-based coords.
///
/// @param decls  the file's top-level declarations to descend.
/// @param line   1-based cursor line.
/// @param col    1-based cursor column.
export enclosing_spans :: fn(decls: AST.Decl[], line: i32, col: i32) -> Span[] {
    st :: EncloseState { .line = line, .col = col }
    walk_enclosing(decls, st)
    out: Span[]: []
    for e in st.acc {
        out.push(e.span)
    }
    out.push_all(st.stmts)
    return out
}

// A node is recorded once its children are, so both chains come out innermost
// first.
walk_enclosing :: fn(decls: AST.Decl[], st: EncloseState) -> void {
    for d in decls {
        AST.inspect(d, enclosing_step, (n) -> record_enclosing(n, st))
    }
}

enclosing_step :: fn(n: AST.Node) -> AST.Walk = match n {
    is AST.FnDecl -> own_code(n)
    is AST.ImportDecl | AST.StructDecl | AST.EnumDecl | AST.TraitDecl | AST.ImplDecl
        | AST.TypeAliasDecl | AST.ConstDecl | AST.AssertDecl | AST.Expr | AST.Stmt
        | AST.Pattern -> .Descend
}

record_enclosing :: fn(n: AST.Node, st: EncloseState) -> void {
    if !span_contains(n.span, st.line, st.col) {
        return
    }
    match n {
        is AST.Expr               -> { st.acc.push(n) }
        is AST.Stmt               -> { st.stmts.push(n.span) }
        is AST.Decl | AST.Pattern -> {}
    }
}
