// vader/tools/lsp/analysis/state: open-document tracking.
//
// The client pushes the file content via `didOpen` / `didChange` /
// `didClose` notifications. Semantic tokens read from the doc table ;
// goto-def + hover read from the per-document index built in parallel.

module "vader/tools/lsp/analysis"

import "json"
import "std/collections"
import "std/string"
import "vader/pipeline/check"
import "vader/front/resolver"
import "vader/support/target"
import "vader/front/typecheck"
import "vader/support/diagnostics"
import "vader/tools/lsp/protocol"
import "std/io"

Virt :: import "vader/front/virt"

/// Cached load+typecheck of one project, keyed by the entry file path it was
/// built for. Reused across typed requests (hover, diagnostics, inlay,
/// signature) within a quiescent edit window — `load_project` + the multi-
/// module typecheck re-parse ~30 stdlib modules each, so without this a burst
/// of requests between two edits pays that cost per request. Invalidated on
/// every didOpen / didChange / didClose (any doc change can alter any project
/// the overlay feeds).
export ProjectCache :: struct {
    entry_path: string
    project:    LoadedProject
    result:     CheckResult
    diags:      Diagnostic[]
    /// Module-name → `LoadedModule` map (`module_index_by_name`), built once per
    /// cache entry so per-request consumers (wildcard completion) don't rebuild
    /// it. Keyed by the logical `module "..."` name — the string an `import`
    /// uses — not the resolved filesystem path.
    module_name_index: MutableMap<string, LoadedModule>
    /// The project's references, built on the first request that reads them
    /// (`reference_index_of`).
    references:        ReferenceIndex | null = null
}

/// The references of `cached`, built once per cache entry : find-usages, rename
/// and each node a hierarchy expands all read them.
///
/// @param cached  a typed project from `typed_project_for`.
export reference_index_of :: fn(cached: ProjectCache) -> ReferenceIndex {
    kept :: cached.references
    if kept != null {
        return kept
    }
    built :: build_reference_index(cached.project, cached.result)
    cached.references = built
    return built
}

/// The sites of the last find-usages that reached past the document's project
/// (`workspace::reference_sites`), for the request that follows it on the same
/// target, such as a rename after a find-usages. Dropped on every edit.
export UsagesCache :: struct {
    entry_path: string
    /// The target, as the document's project keys it.
    key:        i64
    view:       ReferenceView
}

/// The navigation view of a project: loaded with NO target selection, so every
/// `@target` body is present.
///
/// PARSED ONLY, deliberately. `implementation` asks a syntactic question —
/// "which bodies does this declaration have" — and typing the other platforms'
/// code would be both wasted work and, if its diagnostics ever escaped into the
/// editor, exactly the property `@target` exists to remove.
export UnionCache :: struct {
    entry_path: string
    project:    LoadedProject
}

/// One LSP server instance's document table. The single shared state is
/// passed to every handler ; no globals.
export ServerState :: struct {
    /// uri → current document text. Empty string for closed documents.
    docs:                       MutableMap<string, string>
    /// Last load+typecheck, reused across typed requests. `null` after didOpen /
    /// didClose and after `flush_dirty_diagnostics` rebuilds it ; deliberately
    /// KEPT (stale) across a didChange, so the typed requests that arrive
    /// mid-edit-burst don't each re-typecheck the project — the burst's single
    /// rebuild happens once it settles. See `typed_project_for` +
    /// `flush_dirty_diagnostics`.
    cache:                      ProjectCache | null
    /// The entry `cache` displaced, kept so alternating between two files does
    /// not reload on every request. Invalidated with `cache`, always — a stale
    /// second slot is the same defect as a stale first one, twice as hard to
    /// notice.
    cache_prev:                 ProjectCache | null
    /// Last union (no-selection) load — the navigation view. Separate from
    /// `cache` because the cut happens at LOAD time: one `LoadedProject` cannot
    /// serve both the targeted diagnostics and the navigation over every body.
    /// Filled LAZILY, on the first request that needs it, so an editing session
    /// that never navigates never pays for it.
    union_cache:                UnionCache | null
    /// The last find-usages past the document's project ; null after any edit.
    usages:                     UsagesCache | null
    /// The folder the client opened, from `initialize` ; the working directory
    /// when it names none.
    workspace_root:             string
    /// path → the symbols of a workspace file read from the disk, and its
    /// modification time then (`workspace_symbols`).
    symbols:                    MutableMap<string, FileSymbols>
    /// uri → per-document goto-def + hover index. Rebuilt on every
    /// didOpen / didChange ; entry is removed (not just emptied) on
    /// didClose so a stale index never serves a closed-doc request.
    indices:                    MutableMap<string, DocIndex>
    /// uri → "diagnostics need a (re)publish". Set by `handle_did_change` and by
    /// a driven project settling on new roots, removed by `handle_did_close`
    /// (suppresses a closed doc), drained by
    /// `flush_dirty_diagnostics` once an edit burst settles (see
    /// vader/tools/lsp/main.vader). Decouples the per-keystroke typecheck from the
    /// quiescent-window typecheck — the whole point of the debounce.
    dirty:                      MutableMap<string, bool>
    /// The roots the host names, searched before a project's own — what the
    /// loader takes as `--include-paths`, for the index and the typed project
    /// alike : `--library-root` alone, when given. Empty otherwise, and the roots
    /// are then the ones `vader build` would search for the same file.
    include_flags:              string[]
    /// True when the client advertised
    /// `capabilities.textDocument.definition.linkSupport = true` in
    /// `initialize`. Drives the definition response shape — `LocationLink[]`
    /// when supported (lets the editor underline the exact origin
    /// range on Ctrl/Cmd-hover), `Location` otherwise.
    definition_link_support:    bool
    /// The `character` counting unit negotiated at `initialize`
    /// (`general.positionEncodings`). Every byte ↔ (line, character)
    /// conversion routes through a `LineIndex` built with this. Defaults to
    /// `Utf16` — the LSP protocol default when the client offers nothing.
    position_encoding:          PositionEncoding
    /// True when the client advertised
    /// `capabilities.workspace.inlayHint.refreshSupport = true`. Lets the server
    /// push `workspace/inlayHint/refresh` after a rebuild so the client
    /// re-requests hints computed against the pre-edit source (e.g. right after
    /// a format edit) — otherwise their positions stay stale until the next edit.
    inlay_refresh_support:      bool
    /// True when the client advertised
    /// `capabilities.workspace.didChangeWatchedFiles.dynamicRegistration = true`:
    /// the server can then ask to hear of the files changed outside the editor
    /// (`register_file_watchers`).
    watched_files_support:      bool
    /// Monotonic id for server-INITIATED requests (the `*/refresh` pushes, the
    /// watcher registration). The client's response is ignored, so uniqueness
    /// is the only requirement.
    next_request_id:            i64
    /// uri → an open `.virt` document read back by the bytecode reader. Filled on
    /// the first request that needs it, dropped on every didOpen / didChange /
    /// didClose of that document : a large dump takes a noticeable fraction of a
    /// second to read, and the editor asks for hints on every scroll.
    virt_listings:              MutableMap<string, Virt.VirtListing | Virt.VirtParseError>
    /// uri → the line index of an open `.virt` document, rebuilt on every didOpen
    /// / didChange : each request on it converts a position, and indexing a large
    /// dump costs milliseconds.
    virt_line_indices:          MutableMap<string, LineIndex>
    /// project folder → what the server knows of a project its `build.vader`
    /// describes: the roots registered, the `vader info` run in flight.
    driven:                     MutableMap<string, DrivenProject>
}

export new_state :: fn(library_root: string) -> ServerState {
    return ServerState {
        .docs                    = MutableMap<string, string> {},
        .cache                   = null,
        .cache_prev              = null,
        .union_cache             = null,
        .usages                  = null,
        .workspace_root          = current_working_directory(),
        .symbols                 = MutableMap<string, FileSymbols> {},
        .indices                 = MutableMap<string, DocIndex> {},
        .dirty                   = MutableMap<string, bool> {},
        .include_flags           = if library_root.byte_len() > 0 { [library_root] } else { [] },
        .definition_link_support = false,
        .position_encoding       = .Utf16,
        .inlay_refresh_support   = false,
        .watched_files_support   = false,
        .next_request_id         = 1,
        .virt_listings           = MutableMap<string, Virt.VirtListing | Virt.VirtParseError> {},
        .virt_line_indices       = MutableMap<string, LineIndex> {},
        .driven                  = MutableMap<string, DrivenProject> {},
    }
}

/// True for a `.virt` document — the text bytecode. The server keeps its text
/// and answers hovers and inlay hints over its ops (`handle_virt_hover`,
/// `handle_virt_inlay_hint`), but never analyses it as Vader source.
///
/// @param uri  a document uri.
export is_virt_uri :: fn(uri: string) -> bool = uri.ends_with(".virt")

/// The line index of the open `.virt` document at `uri` — its text is the
/// index's `source` ; null when no such document is open.
///
/// @param uri  a `.virt` document uri.
export virt_line_index_for :: fn(self: ServerState, uri: string) -> LineIndex | null =
    self.virt_line_indices[uri]

/// The open `.virt` document at `uri` read back by the bytecode reader ; null
/// when no such document is open or the reader refuses it. Read once per
/// version of the document — a refusal is cached too.
///
/// @param uri  a `.virt` document uri.
export virt_listing_for :: fn(self: ServerState, uri: string) -> Virt.VirtListing | null {
    if self.virt_listings[uri] == null {
        li :: self.virt_line_indices[uri] ?? return null
        self.virt_listings[uri] = Virt.parse_virt_listing(li.source)
    }
    listing :: self.virt_listings[uri]
    return if listing is Virt.VirtListing { listing } else { null }
}

/// Look up the current text of `uri`, or `null` if the client never
/// opened it (or closed it since).
export source_for :: fn(self: ServerState, uri: string) -> string | null {
    return self.docs[uri]
}

/// Text of the file at `path`, preferring the open-document overlay (so unsaved
/// edits win) and falling back to reading it from disk. Empty string when the
/// file is neither open nor readable — the LineIndex then clamps every offset to
/// 0, degrading gracefully rather than crashing. Used to encode ranges for
/// cross-file results (goto-def / references targets in other modules).
///
export source_for_path :: fn(self: ServerState, path: string) -> string {
    open :: self.docs[path_to_uri(path)]
    if open is string { return open }
    disk :: read_file_string(path)
    if disk is string { return disk }
    return ""
}

/// A `LineIndex` for the file at `path` in the negotiated encoding: the open
/// document's own, or one built from the disk source. The single resolution
/// point for encoding a cross-file span's `character` offsets.
export line_index_for_path :: fn(self: ServerState, path: string) -> LineIndex {
    open :: self.indices[path_to_uri(path)]
    if open != null {
        return open.line_index
    }
    return new_line_index(self.source_for_path(path), self.position_encoding)
}

/// The 1-based line and codepoint column a `Span` gives the LSP position
/// `(line, character)` of the file at `path`: what the AST lookups compare
/// against, whatever `character` unit the client negotiated.
/// @param path       the document's filesystem path.
/// @param line       0-based LSP line.
/// @param character  0-based LSP character in the negotiated encoding.
/// @return           `[line, column]`, both 1-based.
export span_point :: fn(self: ServerState, path: string, line: i32, character: i32) -> [i32, i32] =
    [line + 1, lsp_span_column(self.line_index_for_path(path), line, character)]

/// Look up the per-document index for `uri`. Returns `null` when the
/// document was never opened, or after didClose. The two callers
/// (definition + hover) both swallow `null` into a JsonNull response.
export index_for :: fn(self: ServerState, uri: string) -> DocIndex | null {
    return self.indices[uri]
}

/// Load + typecheck the project rooted at `file_path`, reusing the cache when
/// no document changed since (the cache is cleared on every didOpen /
/// didChange / didClose). Module files are read through the in-memory `docs`
/// overlay first, so the result reflects unsaved edits, not the last-saved
/// file. The four typed handlers (hover, diagnostics, inlay, signature) all
/// route through here, so a burst of requests between two edits pays a single
/// load+typecheck.
///
/// @param self       the server state (carries the overlay + the cache).
/// @param file_path  the entry file's filesystem path (from `uri_to_path`).
/// @return           the cached-or-freshly-built project, typecheck result,
///                   and diagnostics.
export typed_project_for :: fn(self: ServerState, file_path: string) -> ProjectCache {
    cached :: self.cache
    if cached != null {
        if cached.entry_path == file_path { return cached }
        // The one it displaces is kept as the PREVIOUS entry. A single slot made
        // alternating between two open files reload on every request: measured
        // at 4.7 s for six member clicks across two files, ~1 s each. Two slots
        // turn that into two loads total, which is the common shape — bouncing
        // between a definition and its use.
        //
        // TWO, not more: each entry holds a whole typed project (~80 MB retained
        // for this tree), and this server has frozen an IDE once already.
        prev :: self.cache_prev
        if prev != null {
            if prev.entry_path == file_path {
                // Promote, so the pair keeps alternating for free.
                self.cache_prev = cached
                self.cache = prev
                return prev
            }
        }
    }
    // No extra seed, and `dump_types` off: the LSP reads expr_types (hover/defs)
    // but never the dump-only expr_kinds / node_spans tables.
    fc :: check_with_modules(self, file_path, [])
    entry :: ProjectCache {
        .entry_path = file_path, .project = fc.project, .result = fc.result, .diags = fc.diags,
        .module_name_index = module_index_by_name(fc.project),
    }
    self.cache_prev = self.cache
    self.cache = entry
    return entry
}

/// Load and typecheck `file_path` together with the modules `extra_seeds` names,
/// for a request that must see the modules importing the file's own module :
/// find-usages. The project is not kept : the seed set belongs to one request,
/// and such a project holds most of the workspace ; `usages` keeps its answer.
///
/// @param self         the server state (carries the overlay).
/// @param file_path    the entry file's filesystem path.
/// @param extra_seeds  the modules to load beside what the entry imports.
export check_with_modules :: fn(
    self: ServerState, file_path: string, extra_seeds: string[],
) -> FileCheck =
    check_file(
        file_path, doc_overlay(self), self.include_flags, project_of_document(file_path), false,
        null, extra_seeds,
    )

/// The navigation view for `file_path`, loaded once and cached.
///
/// Loaded with `AllTargets`, so a body this machine does not build is present:
/// `implementation` on a bare `@target` declaration must list the Windows body
/// from a Mac, and the targeted load has already dropped it.
///
/// NEVER read this for diagnostics. Under it another platform's code is
/// resolved, which is the blind spot `@target` exists to create on purpose.
///
/// @param self       the server state (carries the overlay + the cache).
/// @param file_path  the entry file's filesystem path.
/// @return           the cached-or-freshly-loaded union project.
export union_project_for :: fn(self: ServerState, file_path: string) -> LoadedProject {
    cached :: self.union_cache
    if cached != null {
        if cached.entry_path == file_path {
            return cached.project
        }
    }
    project :: load_project_with_overlay(
        file_path, doc_overlay(self), self.include_flags, project_of_document(file_path),
        AllTargets {},
    )
    self.union_cache = UnionCache { .entry_path = file_path, .project = project }
    return project
}

/// Pick the `SourceFile` of `files` whose `path` matches the requested
/// document. A module can span several files (a folder module — every
/// `vader/lower/*.vader` shares `module "vader/lower"`), so a per-document
/// request must walk the file the user actually opened, never another one:
/// its AST nodes would put that file's hints, hovers and signatures at that
/// file's positions. Null when no file matches, so the handler yields nothing
/// rather than another file's data.
export source_file_for_path :: fn(files: SourceFile[], file_path: string) -> SourceFile | null {
    for f in files {
        if f.path == file_path { return f }
    }
    return null
}

/// Build a filesystem-path → current-text overlay from every open document,
/// for the resolver to consult before the disk, to discover modules as to read
/// them. `docs` is keyed by uri ; the loader reads by path, so convert each key
/// via `uri_to_path`. An empty document is left to the disk.
///
/// @param self  the server state, holding the open documents.
export doc_overlay :: fn(self: ServerState) -> MutableMap<string, string> {
    overlay :: MutableMap<string, string> {}
    for [uri, text] in self.docs {
        if text != "" { overlay[uri_to_path(uri)] = text }
    }
    return overlay
}

// A `.virt` document's text arrived : index its lines now, read it back on the
// first request that needs the module.
track_virt_document :: fn(self: ServerState, uri: string, text: string) -> void {
    self.virt_listings.remove(uri)
    self.virt_line_indices[uri] = new_line_index(text, self.position_encoding)
}

/// `textDocument/didOpen` handler. Params shape :
///   { textDocument: { uri, languageId, version, text } }
export handle_did_open :: fn(self: ServerState, params: JsonValue) -> void {
    td :: get_field(params, "textDocument")
    uri :: get_string(td, "uri")
    if uri.byte_len() == 0 { return }
    text :: get_string(td, "text")
    self.docs[uri] = text
    if is_virt_uri(uri) {
        track_virt_document(self, uri, text)
        return
    }
    self.indices[uri] = build_index(uri, text, self.position_encoding)
    forget_analyses(self)
    publish_diagnostics_for_uri(self, uri)
}

/// `textDocument/didSave` handler. A saved `build.vader` may declare other
/// roots: its project describes itself again (`ensure_described`), its known
/// roots serving meanwhile. Params shape : { textDocument: { uri } }
export handle_did_save :: fn(self: ServerState, params: JsonValue) -> void {
    describe_again_if_driver(self, uri_to_path(get_string(get_field(params, "textDocument"), "uri")))
}

// Have the project of `path` describe itself again when `path` is its
// `build.vader`: the roots it declares may have changed.
describe_again_if_driver :: fn(self: ServerState, path: string) -> void {
    if path.ends_with("/${DRIVER_FILENAME}") {
        _ :: ensure_described(self, dir_of(path))
    }
}

// Forget the typed analyses: a document opened or closed changes what they
// were built from.
forget_analyses :: fn(self: ServerState) -> void {
    self.cache = null
    self.cache_prev = null
    self.usages = null
}

/// `textDocument/didChange` handler. With full-document sync the params
/// look like :
///   { textDocument: { uri, version }, contentChanges: [ { text } ] }
/// — we take the first contentChange's `text` as the new source.
export handle_did_change :: fn(self: ServerState, params: JsonValue) -> void {
    td :: get_field(params, "textDocument")
    uri :: get_string(td, "uri")
    if uri.byte_len() == 0 { return }
    changes :: get_field(params, "contentChanges")
    match changes {
        is JsonArray -> {
            if changes.items.len() > 0 {
                first :: changes.items[0]
                text :: get_string(first, "text")
                self.docs[uri] = text
                if is_virt_uri(uri) {
                    track_virt_document(self, uri, text)
                    return
                }
                self.indices[uri] = build_index(uri, text, self.position_encoding)
                // The sites of a find-usages moved with the text.
                self.usages = null
                // Debounced (see vader/tools/lsp/main.vader). Keep the now-stale typed
                // cache so requests during the edit burst don't each re-typecheck ;
                // just mark diagnostics dirty. The single rebuild + publish fires
                // at the burst settle point via `flush_dirty_diagnostics`.
                self.dirty[uri] = true
            }
        }
        _ -> {}
    }
}

/// `textDocument/didClose` handler. Drops the document and pushes an empty
/// diagnostics array so the client clears any squiggles.
export handle_did_close :: fn(self: ServerState, params: JsonValue) -> void {
    td :: get_field(params, "textDocument")
    uri :: get_string(td, "uri")
    if uri.byte_len() == 0 { return }
    // Removed rather than blanked: a blanked entry still answers as a real one.
    self.docs.remove(uri)
    if is_virt_uri(uri) {
        self.virt_line_indices.remove(uri)
        self.virt_listings.remove(uri)
        return
    }
    forget_analyses(self)
    self.dirty.remove(uri)
    self.indices.remove(uri)
    clear_diagnostics_for_uri(self, uri)
}

/// Recompute + publish diagnostics for every document a didChange marked dirty
/// since the last flush, then clear the dirty set. The event loop
/// (vader/tools/lsp/main.vader) calls this once an edit burst settles — so the project
/// is type-checked once per quiescent window instead of once per keystroke.
/// Nulls the cache before each publish so diagnostics reflect the current text,
/// not the stale typed project served during the burst. A doc closed mid-burst
/// is simply absent — `handle_did_close` removes its key.
export flush_dirty_diagnostics :: fn(self: ServerState) -> void {
    // Taken out first: publishing can mark documents again (a driven project
    // settling on its roots), and those marks are the next flush's.
    uris :: self.dirty.keys()
    self.dirty.clear()
    for uri in uris {
        self.cache = null
        self.cache_prev = null
        publish_diagnostics_for_uri(self, uri)
    }
    // The rebuild invalidates any inlay hints the client fetched against the
    // pre-edit source — most visibly right after a format edit, where every
    // position shifts. Ask the client to re-request them (LSP §3.17). Without
    // this the hints hang at their old positions until an unrelated edit.
    if uris.len() > 0 && self.inlay_refresh_support {
        send_inlay_hint_refresh(self)
    }
}

// Push a `workspace/inlayHint/refresh` request. The client answers by
// re-issuing `textDocument/inlayHint`, which now hits the fresh analysis. The
// response is ignored (a bare response frame carries no `method`, so `dispatch`
// drops it). Sent only when the client advertised `inlayHint.refreshSupport`.
send_inlay_hint_refresh :: fn(self: ServerState) -> void = send_request(self, "workspace/inlayHint/refresh", JsonNull {})

// Send the client a request whose response nothing waits on.
send_request :: fn(self: ServerState, method: string, params: JsonValue) -> void {
    id :: self.next_request_id
    self.next_request_id = self.next_request_id + 1
    write_frame(encode_request(id, method, params))
}

/// Ask the client to report what changes outside the editor in the `.vader`
/// files and the `vader.json` of the workspace (`workspace/didChangeWatchedFiles`):
/// a file created by `git checkout`, a sibling rewritten by a generator. LSP
/// offers no static registration for it, so this goes through
/// `client/registerCapability` once the connection is up. Nothing when the
/// client cannot register dynamically.
///
/// @param self  the server state, holding the client's capabilities.
export register_file_watchers :: fn(self: ServerState) -> void {
    if !self.watched_files_support {
        return
    }
    watchers: JsonValue[]: []
    for pattern in ["**/*.vader", "**/${MANIFEST_FILENAME}"] {
        watcher :: MutableMap<string, JsonValue> {}
        watcher["globPattern"] = JsonString { .value = pattern }
        watchers.push(JsonObject { .entries = watcher })
    }
    options :: MutableMap<string, JsonValue> {}
    options["watchers"] = JsonArray { .items = watchers }
    registration :: MutableMap<string, JsonValue> {}
    registration["id"]              = JsonString { .value = "vader-watched-files" }
    registration["method"]          = JsonString { .value = "workspace/didChangeWatchedFiles" }
    registration["registerOptions"] = JsonObject { .entries = options }
    params :: MutableMap<string, JsonValue> {}
    params["registrations"] = JsonArray { .items = [JsonObject { .entries = registration }] }
    send_request(self, "client/registerCapability", JsonObject { .entries = params })
}

/// `workspace/didChangeWatchedFiles` handler: files changed on disk outside the
/// editor. The typed analyses are forgotten, and every open document a changed
/// file can affect is marked for a new publish, since a sibling's change moves a
/// module's diagnostics; a changed `build.vader` has its project describe itself
/// again. A change to an open document's file is a save of text the server
/// already holds, and is skipped. Params shape : { changes: [ { uri, type } ] }
///
/// @param self    the server state.
/// @param params  the notification's params.
export handle_did_change_watched_files :: fn(self: ServerState, params: JsonValue) -> void {
    changes :: get_field(params, "changes")
    if changes !is JsonArray {
        return
    }
    changed: string[]: []
    for change in changes.items {
        uri :: get_string(change, "uri")
        if self.docs[uri] != null {
            continue
        }
        path :: uri_to_path(uri)
        changed.push(path)
        describe_again_if_driver(self, path)
    }
    if changed.len() == 0 {
        return
    }
    forget_analyses(self)
    self.union_cache = null
    for [uri, _] in self.docs {
        if !is_virt_uri(uri) && touches_document(changed, uri_to_path(uri)) {
            self.dirty[uri] = true
        }
    }
}

// Whether one of the files `changed` can move the analysis of the document at
// `path`: it sits in the document's project, or in its folder when it has none.
// Each document marked costs a typecheck of its own.
touches_document :: fn(changed: string[], path: string) -> bool {
    scope :: project_of_document(path) ?? dir_of(path)
    for file in changed {
        if file.starts_with("${scope}/") {
            return true
        }
    }
    return false
}

/// True iff a didChange has left some document's diagnostics pending a publish.
/// Drives the debounce gate in the event loop.
export has_dirty :: fn(self: ServerState) -> bool {
    for [_, needs_publish] in self.dirty {
        if needs_publish { return true }
    }
    return false
}

