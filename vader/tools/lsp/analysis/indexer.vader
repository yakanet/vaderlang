// vader/tools/lsp/analysis/indexer: per-document index for goto-def + hover.
//
// AST-based since the cross-module struct-collision fix unblocked
// `parse_source` from the LSP module surface (cf. fix(bytecode) commit).
// Each `build_index` call parses the document and walks `Program.decls`
// + every nested block to harvest :
//
//   * Top-level decls (`Fn`, `Struct`, `Enum`, `Trait`, `TypeAlias`,
//     `Const`): `scope_span = null` → visible file-wide.
//   * Fn parameters (`FnDecl.params`): `scope_span = body.span`.
//   * Local let-bindings (`LetStmt.binding`'s `SimpleBinding` /
//     `RestBinding` leaves, recursing through `TupleBinding`): scope
//     starts at the LetStmt and runs to the end of the enclosing block.
//   * For-in loop bindings (`ForStmt.form == InFor`): scope = loop
//     body block.
//   * Imports, as the compiler collects them (`collect_module_no_index`) :
//     renames (`import "p" { x as y }`) in `imports[]` for cross-file goto-def,
//     namespace aliases in `namespace_aliases`, the wildcard paths and the
//     names their modifier lists drop in `wildcards`.
//
//   * `match` header bindings: `match y :: e`, scoped to the match and
//     declared at their name token.
//
// Lambda captures and pattern destructuring inside match arms aren't indexed
// yet.

module "vader/tools/lsp/analysis"

import "std/string"
import "toolchain/ast"
import "vader/front/parser"
import "vader/front/lexer"
import "vader/tools/fmt"
import "vader/tools/lsp/protocol"
import "toolchain/span"

Rs :: import "vader/front/resolver"
import "vader/core/symbol"
import "std/collections"

/// What kind of declaration a DeclEntry points at. Drives the hover
/// signature template + helps clients decide on icon / styling.
export DeclKind :: enum(u8) {
    Fn,
    Struct,
    Enum,
    Trait,
    TypeAlias,
    Const,
    /// A struct field. Indexed so `img.pixels` has something to jump to: the
    /// struct's own name was the only thing recorded, so a field access resolved
    /// to nothing at all.
    Field,
    /// An enum variant, for the same reason: `.GeneratorReturnMustBeIterator`
    /// is a reference to one, and only the enum's own name was indexed.
    EnumVariant,
    // Intra-file bindings: visible only within `scope_span`.
    Param,
    Local,
    ForIn,
}

/// One indexed declaration or binding. `name_span` is what goto-def
/// jumps to ; `signature` and the vaderdoc of `node` (`entry_doc`) feed the
/// hover. `scope_span` is
/// `null` for file-wide visibility (top-level decls) and `Span` for
/// intra-file bindings.
export DeclEntry :: struct {
    name: string
    kind: DeclKind
    name_span: Span
    full_span: Span
    signature: string
    scope_span: Span | null
    /// The type this member belongs to: the struct for a field, the trait or
    /// the impl's for-type for a method. Empty for anything that is not a
    /// member.
    ///
    /// It is what makes `form.cond` land on `WhileFor.cond` rather than on
    /// whichever struct declares a `cond` first: the receiver's TYPE is known
    /// (the editor hovers it), so the owner is the half that was missing.
    owner: string = ""
    /// True when this top-level decl is `export`ed. Lets the cross-file resolver
    /// restrict a WILDCARD lookup to a module's public surface: a bare
    /// `import "p"` exposes only p's exports, so goto-def must not land on p's
    /// private decls. Always false for locals / params (never module-visible).
    exported: bool
    /// The declaration itself, which the hover renders ; null for a binding
    /// (a parameter, a local), whose `signature` says all there is.
    node: DeclNode | null = null
    /// True for a fn with type parameters of its own or of the trait or impl
    /// it belongs to : a call binds them, and the hover shows to what.
    generic: bool = false
}

/// What a `DeclEntry` declares : a declaration, or a member of one.
export DeclNode :: Decl | StructField | EnumVariant

/// Per-document index, rebuilt on every didOpen / didChange.
export DocIndex :: struct {
    uri: string
    /// The `module "…"` the document opens with ; "" when it has none.
    module: string
    source: string
    tokens: Token[]
    /// The document's tree, `///` blocks attached: what a handler walks instead
    /// of parsing `source` again.
    program: Program
    decls: DeclEntry[]
    /// The file's renames: `import "p" { x as y }` binds `local` `y` to `p`'s
    /// `imported_name` `x`.
    imports: Rs.ImportInfo[]
    /// Namespace alias → module path, from `Name :: import "p"`.
    ///
    /// `Name.member` is the ONLY spelling allowed once an alias is taken (T3078),
    /// and the alias names a module, not a value, so no receiver type can be read
    /// off it : this binding is goto-def's one way back to the module.
    namespace_aliases: MutableMap<string, string>
    /// The file's wildcard imports: bare `import "p"`, and `import "p" { … }`,
    /// a wildcard with modifiers: with the names each modifier list drops. A
    /// wildcard binds no rename: every export of `p` enters scope
    /// unqualified, so the cross-file resolver falls back to these paths to
    /// locate an unqualified name (see `resolver::resolve`).
    wildcards: Rs.FileImports
    /// `break` / `continue` → the loop it targets, for goto-definition on a
    /// loop jump.
    loop_jumps: LoopJump[]
    /// Byte ↔ (line, character) map for this document, in the negotiated
    /// encoding. Powers the incoming position resolvers below and the outgoing
    /// range encoders for same-document spans.
    line_index: LineIndex
}

/// One `break` / `continue` and the loop it targets. Mirrors the compiler's
/// resolution (typecheck `resolve_loop_target`) : a bare jump targets the
/// innermost loop ; `break <name>` / `continue <name>` the nearest enclosing
/// loop whose iteration variable or label is `<name>`.
export LoopJump :: struct {
    /// The whole `break` / `continue <name>` statement span (the click target).
    jump_span: Span
    /// The targeted `for` loop's span (goto lands at its start).
    target_span: Span
}

/// Build the index for a freshly-opened or modified document.
/// @param encoding  the negotiated LSP position encoding (from `ServerState`).
export build_index :: fn(uri: string, source: string, encoding: PositionEncoding) -> DocIndex {
    parsed :: parse_source_with_docs(source, uri)
    entries: DeclEntry[]: []
    for d in parsed.program.decls {
        if d !is ImportDecl {
            collect_decl(d, source, entries)
        }
    }
    collected :: Rs.collect_module_no_index(parsed.program, uri, SymbolFactory {})
    imports: Rs.ImportInfo[]: []
    namespace_aliases :: MutableMap<string, string> {}
    for [_, info] in collected.imports {
        // A namespace alias names the module itself : no imported name.
        if info.imported_name == null {
            namespace_aliases[info.local] = info.path
        } else {
            imports.push(info)
        }
    }
    return DocIndex {
        .uri = uri,
        .module = module_name_of(parsed.program),
        .source = source,
        .tokens = parsed.tokens,
        .program = parsed.program,
        .decls = entries,
        .imports = imports,
        .namespace_aliases = namespace_aliases,
        .wildcards = collected.files[0],
        .loop_jumps = collect_loop_jumps(parsed.program.decls),
        .line_index = new_line_index(source, encoding),
    }
}

// The module a program declares, "" without a header.
module_name_of :: fn(program: Program) -> string {
    header :: program.module ?? return ""
    return header.name
}

// ---- loop-jump index (goto-definition on `break` / `continue`) ------------

// One enclosing loop as the jump resolver sees it.
LjFrame :: struct { span: Span, binding: string | null, label: string | null }

/// Collect every `break` / `continue` → target-loop mapping. Lambdas are not
/// descended (a jump there can't target an enclosing loop) ; unresolved jumps
/// (outside any loop, or a name matching nothing) are simply not recorded.
collect_loop_jumps :: fn(decls: Decl[]) -> LoopJump[] {
    out: LoopJump[]: []
    for d in decls {
        lj_decl(d, out)
    }
    return out
}

lj_decl :: fn(d: Decl, out: LoopJump[]) -> void {
    match d {
        is FnDecl    -> { lj_fn_body(d.body, out) }
        is ImplDecl  -> { for m in d.members { lj_fn_body(m.body, out) } }
        is TraitDecl -> { for m in d.members { lj_fn_body(m.body, out) } }
        _            -> {}
    }
}

lj_fn_body :: fn(body: BlockExpr | null, out: LoopJump[]) -> void {
    if body is BlockExpr {
        stack: LjFrame[]: []
        lj_block(body, stack, out)
    }
}

lj_block :: fn(b: BlockExpr, stack: LjFrame[], out: LoopJump[]) -> void {
    for s in b.stmts {
        lj_stmt(s, stack, out)
    }
    t :: b.trailing
    if t != null {
        lj_expr(t, stack, out)
    }
}

lj_stmt :: fn(s: Stmt, stack: LjFrame[], out: LoopJump[]) -> void {
    match s {
        is ForStmt               -> {
            stack.push(LjFrame { .span = s.span, .binding = lj_for_binding(s), .label = s.label })
            lj_block(s.body, stack, out)
            stack.remove_last()
        }
        is BreakStmt             -> { lj_record(s.span, s.label, stack, out) }
        is ContinueStmt          -> { lj_record(s.span, s.label, stack, out) }
        is ExprStmt              -> { lj_expr(s.expr, stack, out) }
        is LetStmt               -> { lj_expr(s.value, stack, out) }
        is AssignStmt            -> { lj_expr(s.value, stack, out) }
        is DestructureAssignStmt -> { lj_expr(s.value, stack, out) }
        is ReturnStmt            -> {
            rv :: s.value
            if rv != null {
                lj_expr(rv, stack, out)
            }
        }
        is YieldStmt             -> { lj_expr(s.value, stack, out) }
        is DeferStmt             -> {
            match ds :: s.body {
                is DeferStmtBody  -> { lj_stmt(ds.stmt, stack, out) }
                is DeferBlockBody -> { lj_block(ds.block, stack, out) }
            }
        }
    }
}

// Only container expressions can host a nested `break` / `continue` in a
// statement position ; leaves and lambdas (a jump there is illegal) are skipped.
lj_expr :: fn(e: Expr, stack: LjFrame[], out: LoopJump[]) -> void {
    @partial match e {
        is BlockExpr -> { lj_block(e, stack, out) }
        is IfExpr    -> {
            lj_expr(e.cond, stack, out)
            lj_block(e.then_block, stack, out)
            match ei :: e.else_branch {
                is IfElseIf    -> { lj_expr(ei.branch, stack, out) }
                is IfElseBlock -> { lj_block(ei.block, stack, out) }
                is null        -> {}
            }
        }
        is MatchExpr -> { for arm in e.arms { lj_expr(arm.body, stack, out) } }
        _            -> {}
    }
}

// The for-in iteration variable, or null for a variable-less loop (`while`-
// style, infinite, `_`, or a `for [k, v]` destructure): those are targeted by
// a label, not a single variable.
lj_for_binding :: fn(f: ForStmt) -> string | null {
    i :: f.form
    if i is InFor {
        nv :: i.loop_var
        if nv is NamedVar {
            if nv.name != "_" {
                return nv.name
            }
        }
    }
    return null
}

lj_record :: fn(jump_span: Span, label: string | null, stack: LjFrame[], out: LoopJump[]) -> void {
    target :: lj_resolve(stack, label)
    if target != null {
        out.push(LoopJump { .jump_span = jump_span, .target_span = target.span })
    }
}

// Bare jump → innermost loop ; labeled jump → nearest enclosing loop matching
// by iteration variable or label (innermost-first). Null when unresolved.
lj_resolve :: fn(stack: LjFrame[], label: string | null) -> LjFrame | null {
    n :: stack.len()
    if n == 0        { return null }
    if label == null { return stack[n - 1] }
    name :: label
    i := n
    for i > 0 {
        i = i - 1
        frame :: stack[i]
        fb :: frame.binding
        if fb != null && fb == name {
            return frame
        }
        fl :: frame.label
        if fl != null && fl == name {
            return frame
        }
    }
    return null
}

/// The loop a `break` / `continue` under (line, character) targets, or null.
/// The whole jump statement is the click target (keyword + optional name).
export loop_jump_at :: fn(idx: DocIndex, line: i32, character: i32) -> Span | null {
    offset :: li_offset(idx.line_index, line, character)
    for lj in idx.loop_jumps {
        if offset >= lj.jump_span.start.offset && offset < lj.jump_span.end.offset {
            return lj.target_span
        }
    }
    return null
}

/// Find the decl whose name matches the identifier under (line, character).
/// Both are 0-based per LSP. Returns null when no Ident token covers
/// the position. Innermost scope wins.
export find_at :: fn(idx: DocIndex, line: i32, character: i32) -> DeclEntry | null {
    offset :: li_offset(idx.line_index, line, character)
    name :: token_name_at(idx.tokens, offset)
    if name.byte_len() == 0 {
        return null
    }
    declared :: binding_declared_at(idx.decls, name, offset)
    if declared != null {
        return declared
    }
    return lookup_innermost(idx.decls, name, offset)
}

// The binding named `name` whose own name sits at `offset` : a parameter is
// declared before the body its scope covers.
binding_declared_at :: fn(decls: DeclEntry[], name: string, offset: i64) -> DeclEntry | null {
    for d in decls {
        at :: d.name_span
        covers :: at.start.offset <= offset && offset < at.end.offset
        if covers && d.name == name && is_binding_kind(d.kind) {
            return d
        }
    }
    return null
}

/// Return the identifier name at the click position, or `""` if no
/// Ident token covers it. Exposed for the cross-file resolver: it
/// needs the bare name after `find_at` returned `null` so it can
/// match against the import table.
export name_at :: fn(idx: DocIndex, line: i32, character: i32) -> string {
    offset :: li_offset(idx.line_index, line, character)
    return token_name_at(idx.tokens, offset)
}

/// Return the source span of the identifier token under the click
/// position, or `null` when no Ident covers it. The handler uses
/// this as the `originSelectionRange` of an LSP `LocationLink` so
/// the editor underlines exactly the clicked identifier on Ctrl/Cmd-
/// hover. Column-precise in the negotiated encoding (via `li_offset`).
export span_at :: fn(idx: DocIndex, line: i32, character: i32) -> Span | null {
    offset :: li_offset(idx.line_index, line, character)
    return token_span_at(idx.tokens, offset)
}

/// The name of the decorator or intrinsic under (line, character) (the `test`
/// of `@test`, the `size_of` of `@size_of(T)`), or `""` when the cursor is not
/// on one. The cursor may sit on the `@` or on the name; the name may be a
/// keyword (`@export`), so any token glued to an `@` counts.
///
/// @param idx        the document's index.
/// @param line       0-based line.
/// @param character  0-based character, in the negotiated encoding.
export decorator_name_at :: fn(idx: DocIndex, line: i32, character: i32) -> string {
    offset :: li_offset(idx.line_index, line, character)
    tokens :: idx.tokens
    for i in 0..<tokens.len() {
        t :: tokens[i]
        if offset < t.span.start.offset || offset >= t.span.end.offset {
            continue
        }
        if t.kind == .At {
            return glued_name(tokens, i, i + 1)
        }
        if i > 0 && tokens[i - 1].kind == .At {
            return glued_name(tokens, i - 1, i)
        }
        return ""
    }
    return ""
}

// The text of `tokens[name]` when it starts where the `@` at `tokens[at]` ends,
// "" otherwise: `@ test` is no decorator.
glued_name :: fn(tokens: Token[], at: i64, name: i64) -> string {
    if name >= tokens.len() {
        return ""
    }
    t :: tokens[name]
    if t.span.start.offset != tokens[at].span.end.offset || t.text.byte_len() == 0 {
        return ""
    }
    return t.text
}

/// The entry whose name starts at byte `offset`, or null.
///
/// @param idx     the document's index.
/// @param offset  a byte offset into the indexed document.
export entry_at_offset :: fn(idx: DocIndex, offset: i64) -> DeclEntry | null {
    for d in idx.decls {
        if d.name_span.start.offset == offset {
            return d
        }
    }
    return null
}

/// Look up a top-level decl by name (ignores scope). Used by the
/// cross-file resolver to find the target decl inside the imported
/// module's freshly-built index.
export find_toplevel :: fn(idx: DocIndex, name: string) -> DeclEntry | null {
    for d in idx.decls {
        if is_member_kind(d.kind) {
            continue
        }
        if d.scope_span is null {
            if d.name == name {
                return d
            }
        }
    }
    return null
}

/// Like `find_toplevel`, but only an `export`ed decl matches. Used to resolve a
/// name brought into scope by a bare `import "p"` wildcard, which exposes only
/// `p`'s public surface, so goto-def / hover never lands on a private decl.
export find_exported_toplevel :: fn(idx: DocIndex, name: string) -> DeclEntry | null {
    for d in idx.decls {
        if is_member_kind(d.kind) {
            continue
        }
        if d.scope_span is null && d.exported {
            if d.name == name {
                return d
            }
        }
    }
    return null
}

// The name of an `implements` block's target type, or "" when it is not a plain
// named type (`Box<T>`, a tuple, a union): there is then no single owner a
// receiver's type could match.
impl_owner_name :: fn(t: TypeExpr) -> string {
    if t is IdentExpr {
        return t.name
    }
    return ""
}

/// True for a kind that is only reachable THROUGH something else: a struct
/// field, an enum variant.
///
/// They are recorded with no `scope_span`, like a top-level decl, because they
/// are visible wherever their owner is rather than inside a lexical region. But
/// they are NOT names in scope: writing `pixels` bare is `R2006`. Every lookup
/// that answers "what does this NAME denote here" must therefore exclude them:
/// missing one made a call to `vm_required(…)` resolve to a struct field of that
/// name declared earlier in the file.
export is_member_kind :: fn(k: DeclKind) -> bool = k == .Field || k == .EnumVariant

/// Whether `k` is a binding local to a fn body (a parameter, a local, a `for`
/// variable) rather than a declaration.
export is_binding_kind :: fn(k: DeclKind) -> bool = k == .Param || k == .Local || k == .ForIn

/// Find the member `name` DECLARED BY `owner`: the precise lookup.
///
/// `find_member` answers "some declaration of this name", which is a coin flip
/// for a field: `cond`, `span` and `name` recur across structs. This answers
/// "this type's member", which is the question the user asked by clicking
/// `form.cond`.
///
/// @param idx    the document index to search.
/// @param owner  the declaring type's name, from the receiver's type.
/// @param name   the member name.
/// @return       the matching member, or null.
export find_member_of :: fn(idx: DocIndex, owner: string, name: string) -> DeclEntry | null {
    for d in idx.decls {
        if d.owner != owner {
            continue
        }
        if d.name == name {
            return d
        }
    }
    return null
}

/// Find a METHOD by name: a fn declared inside a `trait` or an `implements`
/// block.
///
/// Such a member is recorded by `top_entry` like any top-level fn (its
/// `scope_span` is null, and `exported` is false because the visibility belongs
/// to the enclosing trait). That is exactly why the cross-file resolver missed
/// it: its wildcard lookup restricts to EXPORTED top-level decls, and a member
/// never is one.
///
/// Struct FIELDS match too: `e.cond` is the same question as `e.len()`, and
/// both are what sits after a dot. The kind filter is what keeps this from
/// being a second `find_toplevel`: a name that denotes a struct, an enum or a
/// const must not be offered as the target of `x.name`.
///
/// @param idx   the document index to search.
/// @param name  the member name, as written after the dot.
/// @return      the first matching fn or field, or null.
export find_member :: fn(idx: DocIndex, name: string) -> DeclEntry | null {
    for d in idx.decls {
        if d.kind != .Fn && d.kind != .Field && d.kind != .EnumVariant {
            continue
        }
        if d.name == name {
            return d
        }
    }
    return null
}

/// Find the rename that binds `name` in this file. Returns null on miss.
export find_import :: fn(idx: DocIndex, name: string) -> Rs.ImportInfo | null {
    for i in idx.imports {
        if i.local == name {
            return i
        }
    }
    return null
}

// ---- top-level decl collection -------------------------------------------

collect_decl :: fn(d: Decl, source: string, entries: DeclEntry[]) -> void {
    match d {
        is FnDecl        -> {
            // `__comptime_NAME` synthetic fns (from the `NAME :: @comptime …`
            // desugar, parser.vader::desugar_comptime_const) are compiler-internal:
            // the user's symbol is the CONST, indexed separately below, so they
            // are not outline symbols. Still walk the body so goto-def works on
            // locals inside the block.
            if !d.comptime_synthetic {
                entries.push(
                    top_entry(
                        d.name,
                        .Fn,
                        d.name_span,
                        d.span,
                        d,
                        d.visibility == .Public,
                        source,
                        "",
                        d.type_params.len() > 0,
                    ),
                )
            }
            index_fn_body(d, source, entries)
        }
        is StructDecl    -> {
            entries.push(
                top_entry(d.name, .Struct, d.name_span, d.span, d, d.visibility == .Public, source),
            )
            // Fields too, for the same reason trait members are indexed just
            // below: `img.pixels` is a reference to one, and without an entry
            // goto-def has nothing to land on. Recorded at top level (no
            // `scope_span`): a field is reachable through any value of the
            // struct, not only inside its declaration.
            // `f.span` twice: `StructField` records no separate name span, so
            // the jump lands on the field's line and the highlight covers the
            // whole declaration rather than just the name.
            for f in d.fields {
                entries.push(top_entry(f.name, .Field, f.span, f.span, f, false, source, d.name))
            }
        }
        is EnumDecl      -> {
            entries.push(
                top_entry(d.name, .Enum, d.name_span, d.span, d, d.visibility == .Public, source),
            )
            for v in d.variants {
                entries.push(
                    top_entry(v.name, .EnumVariant, v.span, v.span, v, false, source, d.name),
                )
            }
        }
        is TraitDecl     -> {
            entries.push(
                top_entry(d.name, .Trait, d.name_span, d.span, d, d.visibility == .Public, source),
            )
            // Trait members are fn decls: index their names too so
            // goto-def on a method-name reference can land somewhere.
            for m in d.members {
                entries.push(
                    top_entry(
                        m.name,
                        .Fn,
                        m.name_span,
                        m.span,
                        m,
                        false,
                        source,
                        d.name,
                        d.type_params.len() + m.type_params.len() > 0,
                    ),
                )
            }
        }
        is TypeAliasDecl -> {
            entries.push(
                top_entry(
                    d.name,
                    .TypeAlias,
                    d.name_span,
                    d.span,
                    d,
                    d.visibility == .Public,
                    source,
                ),
            )
        }
        is ConstDecl     -> {
            entries.push(
                top_entry(
                    d.name,
                    const_kind(d),
                    d.name_span,
                    d.span,
                    d,
                    d.visibility == .Public,
                    source,
                ),
            )
        }
        is ImplDecl      -> {
            // Impl members are fn decls on the target type. They
            // contribute method names (for UFCS goto-def) and their
            // own params + body bindings.
            for m in d.members {
                // SAM-sugar members (`Type implements Trait -> expr`) are
                // synthetic and nameless: the method name is resolved from the
                // trait later, not in the AST. Don't surface them as outline
                // symbols : an empty `name` is a falsy LSP `DocumentSymbol.name`
                // and crashes the whole `documentSymbol` response client-side.
                // Their body is still walked for intra-fn goto-def bindings.
                if m.name != "" {
                    // `owner` is the FOR-TYPE, not the trait: `b.show()` with
                    // `b: Beta` must reach Beta's impl, and the receiver's type
                    // is what names it. Only the plain `Type implements …` shape
                    // yields a name: a generic instantiation has no single one,
                    // and an empty owner degrades to the name-based lookup
                    // rather than pointing somewhere wrong.
                    entries.push(
                        top_entry(
                            m.name,
                            .Fn,
                            m.name_span,
                            m.span,
                            m,
                            false,
                            source,
                            impl_owner_name(d.for_type),
                            d.type_params.len() + m.type_params.len() > 0,
                        ),
                    )
                }
                index_fn_body(m, source, entries)
            }
        }
        is ImportDecl    -> {}
        is AssertDecl    -> {}
    }
}

top_entry :: fn(
    name: string,
    kind: DeclKind,
    name_span: Span,
    full_span: Span,
    node: DeclNode,
    exported: bool,
    source: string,
    owner: string = "",
    generic: bool = false,
) -> DeclEntry {
    // The declaring type, for a member. Empty for everything else, see
    // `DeclEntry.owner`.

    return DeclEntry {
        .name = name,
        .kind = kind,
        .name_span = name_span,
        .full_span = full_span,
        .signature = node_head(source, node),
        .scope_span = null,
        .owner = owner,
        .exported = exported,
        .node = node,
        .generic = generic,
    }
}

// The one-line head of `node`, as `vader/tools/fmt` renders it.
node_head :: fn(source: string, node: DeclNode) -> string = match node {
    is StructField -> format_field_head(source, node).text
    is EnumVariant -> format_variant_head(source, node).text
    is Decl        -> format_decl_head(source, node).text
}

// The vaderdoc written above `node`, null when it has none.
node_doc :: fn(node: DeclNode) -> DocComment | null = match node {
    is StructField -> node.doc
    is EnumVariant -> node.doc
    is Decl        -> decl_doc(node)
}

/// The vaderdoc of the declaration `d` indexes, as text.
///
/// @param d  an entry of a document index.
/// @return   "" when it has none, and for a binding, which has no declaration.
export entry_doc :: fn(d: DeclEntry) -> string {
    node :: d.node ?? return ""
    return doc_text(node_doc(node))
}

// The kind of a module constant : `.TypeAlias` for a distinct type or an alias,
// `.Const` for a value.
const_kind :: fn(d: ConstDecl) -> DeclKind {
    if is_type_value(d.value) {
        return .TypeAlias
    }
    return .Const
}

binding_entry :: fn(
    name: string,
    kind: DeclKind,
    name_span: Span,
    scope: Span,
    signature: string,
) -> DeclEntry {
    return DeclEntry {
        .name = name,
        .kind = kind,
        .name_span = name_span,
        .full_span = name_span,
        .signature = signature,
        .scope_span = scope,
        .exported = false,
    }
}

// ---- local bindings of a fn body ---------------------------------------

index_fn_body :: fn(f: FnDecl, source: string, entries: DeclEntry[]) -> void {
    body :: f.body ?? return
    // Params live for the whole body.
    index_params(f.params, body.span, source, entries)
    w :: LocalIndex { .source = source, .entries = entries }
    inspect(body, (n) -> enter_local(n, w), (n) -> leave_local(n, w))
}

index_params :: fn(ps: FnParam[], scope: Span, source: string, entries: DeclEntry[]) -> void {
    for p in ps {
        sig :: param_signature_slice(p.span, p.name, source)
        entries.push(binding_entry(p.name, .Param, p.name_span, scope, sig))
    }
}

// The walk over a body. `blocks` holds the spans of the blocks around the
// current node, innermost last: a local's scope ends with the innermost one.
LocalIndex :: struct {
    source: string
    entries: DeclEntry[]
    blocks: Span[] = []
}

enter_local :: fn(n: Node, w: LocalIndex) -> Walk = match n {
    is BlockExpr -> enter_block(n, w)
    is LetStmt -> index_let(n, w)
    is ForStmt -> index_loop_var(n, w)
    is MatchExpr -> index_match_binding(n, w)
    is LambdaExpr -> index_lambda_params(n, w)
    // No binding this index records lives in a type or a pattern.
    is FnTypeExpr | ArrayTypeExpr | Pattern -> .Skip
    is Decl | AssignStmt | DestructureAssignStmt | ExprStmt | ReturnStmt | YieldStmt | BreakStmt
        | ContinueStmt | DeferStmt | IntLitExpr | FloatLitExpr | BoolLitExpr | NullLitExpr
        | CharLitExpr | StringLitExpr | IdentExpr | DotVariantExpr | CallExpr | FieldExpr
        | IndexExpr | UnaryExpr | BinaryExpr | NullCoalesceExpr | IfExpr | StructLitExpr
        | SeqLitExpr | RangeExpr | CastExpr | GenericInstExpr | IntrinsicCallExpr
        | AwaitExpr -> .Descend
}

leave_local :: fn(n: Node, w: LocalIndex) -> void {
    if n is BlockExpr {
        w.blocks.remove_last()
    }
}

enter_block :: fn(b: BlockExpr, w: LocalIndex) -> Walk {
    w.blocks.push(b.span)
    return .Descend
}

// A local's scope runs from its `let` to the end of the enclosing block:
// anything before the `let` in the same block stays unresolved against it.
index_let :: fn(l: LetStmt, w: LocalIndex) -> Walk {
    scope :: Span { .start = l.span.start, .end = w.blocks[w.blocks.len() - 1].end }
    collect_let_binding(l.binding, scope, w.source, local_type_hint(l, w.source), w.entries)
    return .Descend
}

// A for-in binding's scope is the loop's body block.
index_loop_var :: fn(f: ForStmt, w: LocalIndex) -> Walk {
    form :: f.form
    if form !is InFor {
        return .Descend
    }
    match nv :: form.loop_var {
        is NamedVar       -> {
            sig :: "for " + nv.name + " in ..."
            w.entries.push(binding_entry(nv.name, .ForIn, nv.span, f.body.span, sig))
        }
        // `for [k, v] in ...` : index each leaf as a body-scoped local.
        is DestructureVar -> {
            collect_let_binding(nv.pattern, f.body.span, w.source, "", w.entries)
        }
        is DiscardVar     -> {}
    }
    return .Descend
}

// `match y :: e` declares `y` for the whole match.
index_match_binding :: fn(m: MatchExpr, w: LocalIndex) -> Walk {
    if m.binding != null {
        collect_let_binding(m.binding, m.span, w.source, "", w.entries)
    }
    return .Descend
}

// A lambda's params live for its body, as a fn's do.
index_lambda_params :: fn(l: LambdaExpr, w: LocalIndex) -> Walk {
    index_params(l.params, l.body.span, w.source, w.entries)
    return .Descend
}

collect_let_binding :: fn(
    b: LetBinding,
    scope: Span,
    source: string,
    type_hint: string,
    entries: DeclEntry[],
) -> void {
    match b {
        is SimpleBinding   -> {
            sig :: local_sig(b.name, type_hint, b.span.start.offset, scope.end.offset, source)
            entries.push(binding_entry(b.name, .Local, b.name_span, scope, sig))
        }
        is RestBinding     -> {
            sig :: local_sig(b.name, type_hint, b.span.start.offset, scope.end.offset, source)
            entries.push(binding_entry(b.name, .Local, b.name_span, scope, sig))
        }
        is TupleBinding    -> {
            // Destructuring : we can't decompose a single annotation/
            // literal-suffix into per-element types without the
            // typechecker, so every element gets the fallback source
            // slice as its signature.
            for elt in b.elements {
                collect_let_binding(elt, scope, source, "", entries)
            }
        }
        is WildcardBinding -> {}
    }
}

// Build a hover-friendly signature for a local binding. When the
// caller passed a `type_hint` (extracted from `LetStmt.ty` annotation
// or a literal `1_u64` suffix), render `<name>: <type>` like a
// fn-parameter signature. Otherwise fall back to slicing the source
// line for `<name> := <expr>`: readable, just less precise.
local_sig :: fn(
    name: string,
    type_hint: string,
    decl_start: i64,
    scope_end: i64,
    source: string,
) -> string {
    if type_hint.byte_len() > 0 {
        return name + ": " + type_hint
    }
    return slice_to_eol(source, decl_start, scope_end)
}

// Best-effort type hint for a `LetStmt` without consulting the typechecker :
// an explicit annotation `let a: T = …` slices `T` from the AST ; otherwise
// `""` and the caller falls back to a source slice that includes the expression.
local_type_hint :: fn(l: LetStmt, source: string) = if l.ty != null {
    type_expr_slice(l.ty, source)
} else { "" }

// Slice the source for a `TypeExpr` reference. The parser tags every
// node with `span`, so a verbatim re-slice keeps annotations like
// `MyType(i32)` or `T?` intact.
type_expr_slice :: fn(t: Expr, source: string) =
    source.byte_slice(t.span.start.offset, t.span.end.offset).trim()

// ---- signature helpers ---------------------------------------------------

// Slice up to the end of the current line: used for local-binding
// signatures (`x :: expr` form). Caps at `upper` so we don't read past
// the enclosing block.
slice_to_eol :: fn(source: string, start: i64, upper: i64) -> string {
    cap :: source.byte_len()
    up: i64: if upper > cap { cap } else { upper }
    cursor: i64 = start
    for cursor < up {
        b :: source.byte_at(cursor)
        if b == '\n' {
            break
        }
        cursor = cursor + 1
    }
    return source.byte_slice(start, cursor).trim()
}

// Slice the source for a span: used to render `x: T` for params and
// `for x in ...` for for-in bindings. Falls back to the bare name on
// degenerate spans.
param_signature_slice :: fn(span: Span, fallback: string, source: string) -> string {
    if span.end.offset > span.start.offset {
        return source.byte_slice(span.start.offset, span.end.offset).trim()
    }
    return fallback
}

// ---- vaderdoc ------------------------------------------------------------

/// The spans of `name` in the `@param name` tags of the vaderdoc of `d`.
///
/// @param source  the text of the file declaring `d`.
/// @param path    that file, as the spans name it: not the URI the index parsed it
///                under.
/// @param d       a declaration of that file.
/// @param name    the name of one of its parameters.
export param_tag_spans :: fn(source: string, path: string, d: DeclEntry, name: string) -> Span[] {
    node :: d.node ?? return []
    doc :: node_doc(node) ?? return []
    out: Span[]: []
    for line in doc.lines {
        at :: param_tag_offset(line, name)
        if at < 0 {
            continue
        }
        column :: i32(at - line_start_offset(source, at)) + 1
        start :: Position {
            ...line.span.start,
            .file = path,
            .offset = at,
            .column = column,
        }
        end :: Position {
            ...start,
            .offset = at + name.byte_len(),
            .column = column + i32(name.len()),
        }
        out.push(Span { .start = start, .end = end })
    }
    return out
}

// Where `name` sits in the doc line `line` when it reads `/// @param name …`,
// else -1.
param_tag_offset :: fn(line: DocCommentLine, name: string) -> i64 {
    body :: line.text.left_trim()
    if doc_tag(body) != "@param" {
        return -1
    }
    rest :: body.byte_slice("@param".byte_len(), body.byte_len()).left_trim()
    if doc_param_name(rest) != name {
        return -1
    }
    return line.span.end.offset - rest.byte_len()
}

// ---- token-based position resolution -------------------------------------

token_name_at :: fn(tokens: Token[], offset: i64) -> string {
    for t in tokens {
        if t.kind != .Ident {
            continue
        }
        if t.span.start.offset <= offset && offset < t.span.end.offset {
            return t.text
        }
    }
    return ""
}

token_span_at :: fn(tokens: Token[], offset: i64) -> Span | null {
    for t in tokens {
        if t.kind != .Ident {
            continue
        }
        if t.span.start.offset <= offset && offset < t.span.end.offset {
            return t.span
        }
    }
    return null
}

// Find the entry matching `name` whose scope most tightly contains
// `offset`. Top-level (scope_span = null) acts as a fallback.
lookup_innermost :: fn(decls: DeclEntry[], name: string, offset: i64) -> DeclEntry | null {
    has_best := false
    best_idx: i64 = 0
    best_size: i64 = 0
    i: i64 = 0
    n :: decls.len()
    for i < n {
        d :: decls[i]
        if d.name != name || is_member_kind(d.kind) {
            i = i + 1
            continue
        }
        match sp :: d.scope_span {
            is null -> {
                if !has_best {
                    best_idx = i
                    best_size = 0
                    has_best = true
                }
            }
            is Span -> {
                if sp.start.offset <= offset && offset < sp.end.offset {
                    size :: sp.end.offset - sp.start.offset
                    if !has_best || best_size == 0 || size < best_size {
                        best_idx = i
                        best_size = size
                        has_best = true
                    }
                }
            }
        }
        i = i + 1
    }
    if !has_best {
        return null
    }
    return decls[best_idx]
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_index_modifier_list_is_a_wildcard :: fn() -> void {
    src :: "module \"t\"\n\nimport \"std/string\" { split as cut, join as _ }\n"
    idx :: build_index("t.vader", src, .Utf16)
    assert_eq(idx.wildcards.paths.len(), 1)
    assert_eq(idx.wildcards.paths[0], "std/string")
    assert_eq(idx.imports.len(), 1)
    assert_eq(idx.imports[0].local, "cut")
    assert_eq(idx.imports[0].imported_name ?? "", "split")
}

@test
test_index_modifier_list_drops_its_names :: fn() -> void {
    src :: "module \"t\"\n\nimport \"std/string\" { split as cut, join as _ }\n"
    idx :: build_index("t.vader", src, .Utf16)
    assert(Rs.drops(idx.wildcards, "std/string", "split"), "a renamed name leaves the wildcard")
    assert(Rs.drops(idx.wildcards, "std/string", "join"), "an excluded name leaves the wildcard")
}

@test
test_index_type_constants_as_types :: fn() -> void {
    src :: "module \"t\"\n\nCelsius :: f64\nMixed :: i32 | string | null\nCoord :: [i32, i32]\n"
        + "Names :: List<string>\nHour :: i32 in 0..=23\nNode :: Ns.Node\nMAX :: 42\n"
        + "BOTH :: A | B\nPAIR :: [\"a\", \"b\"]\n"
    idx :: build_index("t.vader", src, .Utf16)
    kinds: string[]: []
    for d in idx.decls {
        kinds.push("${d.name}=${d.kind == .TypeAlias}")
    }
    want :: "Celsius=true Mixed=true Coord=true Names=true Hour=true Node=true MAX=false "
        + "BOTH=false PAIR=false"
    assert_eq(kinds.join(" "), want)
}

@test
test_index_doc_of_an_internal_field :: fn() -> void {
    src :: "module \"t\"\n\nS :: struct {\n    /// Hidden.\n    @internal\n    y: i32 = 0\n}\n"
    idx :: build_index("t.vader", src, .Utf16)
    docs: string[]: []
    for d in idx.decls {
        docs.push("${d.name}=${entry_doc(d)}")
    }
    assert_eq(docs.join(" "), "S= y=Hidden.")
}
