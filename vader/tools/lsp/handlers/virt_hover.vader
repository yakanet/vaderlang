// vader/tools/lsp/handlers/virt_hover — `textDocument/hover` over a `.virt` document.
//
// Hovering the first word of a line — an op or a directive — shows its entry in
// the text bytecode's reference (`vader/front/virt/ops.md`, read by `op_doc`).

module "vader/tools/lsp/handlers"

import "json"
import "std/string"
import "vader/tools/lsp/analysis"
import "vader/tools/lsp/protocol"

Virt :: import "vader/front/virt"

/// The hover for `params` in a `.virt` document : the reference entry of the
/// line's first word when the cursor is on it, null anywhere else.
///
/// @param state   the server state, which holds the document's text.
/// @param params  the `textDocument/hover` params.
export handle_virt_hover :: fn(state: ServerState, params: JsonValue) -> JsonValue {
    li :: state.virt_line_index_for(position_uri(params)) ?? return JsonNull {}
    cursor :: word_under_cursor(li, params) ?? return JsonNull {}
    if cursor.word != 0 {
        return JsonNull {}
    }
    doc :: Virt.op_doc(word_text(li.source, cursor.words[0])) ?? return JsonNull {}
    return markdown_hover(code_fence(doc.forms.join("\n")) + "\n\n" + doc.text)
}

