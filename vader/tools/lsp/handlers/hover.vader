// vader/tools/lsp/handlers/hover: `textDocument/hover` handler.
//
// The client sends `{ textDocument: { uri }, position: { line, character } }`
// (both 0-based). A hover on a declaration reads like an IDE's quick
// documentation :
//
//     vader/front/parser › IntrinsicSpec    the module, and the owning type
//     ```
//     @intrinsic                            decorators, `export`, the head :
//     export arg_kind :: fn(                a long parameter list one per line,
//         spec: IntrinsicSpec,              a struct's fields, an enum's variants
//         i: i64,
//     ) -> IntrinsicArgKind
//     ```
//     ---
//     The vaderdoc, its tags as sections.
//     *intrinsics.vader*                    the declaring file
//
// A value without a declaration of its own (a local, a sub-expression) shows its
// inferred type, and `@name` the decorator's or the intrinsic's documentation.
//
// The code fences carry no language on purpose. VS Code colours an unlabelled
// fence with the language of the editor that asked, and LSP4IJ colours it with
// the TextMate grammar of the requesting file, whereas a `vader` label sends
// LSP4IJ looking for an IntelliJ language of that name and it renders the block
// uncoloured.
//
// Response shape per LSP §3.17.16 : `{ contents: { kind, value }, range? }`.
// We omit `range` : the client highlights the word under the cursor on its own.

module "vader/tools/lsp/handlers"

import "json"
import "std/collections"
import "std/iter"
import "std/path"
import "std/string"
import "vader/tools/fmt"
import "vader/tools/lsp/analysis"
import "vader/tools/lsp/protocol"
import "vader/core/types"
AST :: import "toolchain/ast"
Parser :: import "vader/front/parser"

/// Column past which a hover breaks a fn's parameter list, one per line.
DISPLAY_WIDTH: i64: 60

/// Build the hover response payload for the position carried in `params`.
/// Returns a `Hover` object on hit, `JsonNull` on miss.
export handle_hover :: fn(state: ServerState, params: JsonValue) -> JsonValue {
    uri :: position_uri(params)
    if uri == "" { return JsonNull {} }
    line :: position_line(params)
    character :: position_character(params)

    idx :: state.index_for(uri) ?? return JsonNull {}
    builtin :: builtin_hover(idx.decorator_name_at(line, character))
    if builtin != null {
        return builtin
    }

    // A declaration shows itself : its parameters' names, its members, its
    // docs say more than the type of the value it names. A binding (a local, a
    // parameter) is the exception : its source text may leave the type out, so
    // the inferred type below says more.
    hit :: resolve_hit_at(state, uri, idx, line, character)
    if hit != null && !is_binding_kind(hit.target.kind) {
        return decl_hover(hit, generic_instance(state, uri, idx, hit, line, character))
    }

    // Value-position hovers: a local, an argument, an intermediate
    // sub-expression: surface their inferred type here.
    typed_payload :: try_typed_hover(state, uri, idx, line, character)
    if typed_payload != null {
        return typed_payload
    }

    // A binding the typecheck did not type : its source signature.
    if hit != null {
        return markdown_hover(code_fence(hit.target.signature))
    }
    return JsonNull {}
}

// Resolve the cursor position to a decl and the file declaring it : a local /
// top-level one via the document index, or an imported one via the cross-file
// resolver. Returns null when the cursor isn't on a resolvable name.
resolve_hit_at :: fn(state: ServerState, uri: string, idx: DocIndex, line: i32, character: i32) -> ExternalHit | null {
    // The SAME member lookup goto-def uses, and in the same order. Without it
    // the two disagreed on one token: Ctrl+click on `ctx.string_array_tag`
    // landed on the field while the tooltip described the FUNCTION of that
    // name. A tooltip that documents a different declaration than the jump is
    // worse than no tooltip: it is confidently wrong.
    by_type :: member_by_type(state, uri, idx, line, character)
    if by_type != null {
        return by_type
    }
    found :: idx.find_at(line, character)
    if found != null {
        return ExternalHit {
            .uri    = uri,
            .target = found,
            .module = idx.module,
            .source = idx.source,
        }
    }
    nm :: idx.name_at(line, character)
    return resolve(state, idx, nm, cursor_follows_a_dot(idx, line, character))
}

// ---- payload encoding ----------------------------------------------------

// The hover of a declaration : its module and owner, its display in a code
// fence, then its vaderdoc and the file that declares it. `instance` is the
// type a generic fn takes at the hovered call, "" elsewhere.
decl_hover :: fn(hit: ExternalHit, instance: string) -> JsonValue {
    d :: hit.target
    parts: string[]: []
    header :: container_line(hit.module, d.owner)
    if header.byte_len() > 0 {
        parts.push(header)
    }
    parts.push(code_fence(decl_display(hit.source, d)))
    if instance.byte_len() > 0 {
        parts.push("called here as `${instance}`")
    }
    doc :: entry_doc(d)
    if doc.byte_len() > 0 {
        parts.push("---")
        parts.push(format_vaderdoc(doc))
    }
    parts.push("*${uri_to_path(hit.uri).to_path().filename()}*")
    return markdown_hover(parts.join("\n\n"))
}

// The declaration `d` names, as `vader/tools/fmt` displays it : decorators, `export`,
// the head and the members ; a binding's one-line signature.
decl_display :: fn(source: string, d: DeclEntry) -> string {
    match node :: d.node {
        is null             -> { return d.signature }
        is AST.StructField  -> { return format_field_display(source, node) }
        is AST.EnumVariant  -> { return format_variant_head(source, node) }
        is AST.Decl         -> { return format_decl_display(source, node, DISPLAY_WIDTH) }
    }
}

// The type the generic fn the cursor names takes there, as the typecheck bound
// its type parameters, or "" : `hit` is no generic fn, the cursor is on its
// declaration, or on no typed expression.
generic_instance :: fn(
    state: ServerState, uri: string, idx: DocIndex, hit: ExternalHit, line: i32, character: i32,
) -> string {
    if !hit.target.generic || is_declaration_site(uri, idx, hit, line, character) {
        return ""
    }
    cursor :: typed_cursor(state, uri_to_path(uri), line, character) ?? return ""
    found :: expr_under(cursor) ?? return ""
    ty :: cursor.typed.expr_types[found.id] ?? return ""
    return display_type(ty)
}

// Whether the cursor is on the name `hit` declares.
is_declaration_site :: fn(uri: string, idx: DocIndex, hit: ExternalHit, line: i32, character: i32) -> bool {
    if hit.uri != uri {
        return false
    }
    at :: idx.span_at(line, character) ?? return false
    return at.start.offset == hit.target.name_span.start.offset
}

// `module › Owner`, either half left out when empty.
container_line :: fn(module: string, owner: string) -> string {
    if owner.byte_len() == 0 {
        return module
    }
    if module.byte_len() == 0 {
        return owner
    }
    return module + " › " + owner
}

// `code` in an unlabelled fence (see the file header for why no language).
code_fence :: fn(code: string) -> string = "```\n" + code + "\n```"

// A `Hover` payload whose contents are the Markdown `body`.
markdown_hover :: fn(body: string) -> JsonValue {
    obj :: MutableMap<string, JsonValue> {}
    obj["contents"] = markup_json(body)
    return JsonObject { .entries = obj }
}

// A Markdown `MarkupContent` holding `body`.
markup_json :: fn(body: string) -> JsonValue {
    markup :: MutableMap<string, JsonValue> {}
    markup["kind"]  = JsonString { .value = "markdown" }
    markup["value"] = JsonString { .value = body }
    return JsonObject { .entries = markup }
}

// ---- decorators and intrinsics ------------------------------------------

// The hover of the decorator or intrinsic called `name`, or null when the
// compiler knows neither (or `name` is empty : the cursor is on no `@name`).
builtin_hover :: fn(name: string) -> JsonValue | null {
    if name.byte_len() == 0 {
        return null
    }
    deco :: Parser.decorator_spec(name)
    if deco != null {
        return markdown_hover(["decorator", code_fence(deco.usage), "---", deco.doc].join("\n\n"))
    }
    intrinsic :: Parser.intrinsic_spec(name) ?? return null
    return markdown_hover(["intrinsic", code_fence(intrinsic.signature), "---", intrinsic.doc].join("\n\n"))
}

// ---- vaderdoc ------------------------------------------------------------

// Re-flow vaderdoc into Markdown sections, the way an IDE lays out its quick
// documentation : the prose as written (Markdown joins its wrapped lines into
// paragraphs), then **Params** with each name as code, **Returns**, **Errors**,
// and the shown lines of the **Example** in a code fence.
format_vaderdoc :: fn(raw: string) -> string {
    sections :: AST.doc_sections(raw)
    parts: string[]: []
    if sections.prose.byte_len() > 0 {
        parts.push(sections.prose)
    }
    if sections.params.len() > 0 {
        parts.push("**Params**\n" + bullets(sections.params.map(param_item).collect()))
    }
    if sections.returns.len() > 0 {
        parts.push("**Returns** " + sections.returns.join(" "))
    }
    if sections.errors.len() > 0 {
        parts.push("**Errors**\n" + bullets(sections.errors))
    }
    code :: AST.shown_example(sections)
    if code.byte_len() > 0 {
        parts.push("**Example**\n" + code_fence(code))
    }
    return parts.join("\n\n")
}

// A `@param` as a bullet reads : its name as code, then what it says.
param_item :: fn(p: AST.DocParam) -> string {
    if p.text.byte_len() == 0 {
        return "`" + p.name + "`"
    }
    return "`" + p.name + "`: " + p.text
}

// `items` as a Markdown bullet list.
bullets :: fn(items: string[]) -> string {
    out: string[]: []
    for item in items {
        out.push("- " + item)
    }
    return out.join("\n")
}

// ---- typed-hover lookup --------------------------------------------------

/// Run the typechecker for `uri` and return a Hover payload with the
/// inferred type at (line, character), `name: T` on a named value. Returns
/// `null` on miss so the caller can fall through to the decl hover.
try_typed_hover :: fn(self: ServerState, uri: string, idx: DocIndex, line: i32, character: i32) -> JsonValue | null {
    file_path :: uri_to_path(uri)
    if file_path == "" {
        return null
    }
    cursor :: typed_cursor(self, file_path, line, character) ?? return null
    // Binding-name hover first : when the cursor sits on a `let` /
    // `::` binding name, show the RHS's inferred type instead of the
    // (often `?` placeholder) declared type. Useful when the user
    // wrote `origin: ? | null :: index.span_at(...)` and wants the
    // LSP to surface what the typechecker resolved to.
    binding_ty :: find_binding_rhs_type_at(cursor.decls, cursor.line, cursor.column, cursor.typed)
    if binding_ty != null {
        return type_hover(idx.name_at(line, character), binding_ty)
    }
    found :: expr_under(cursor) ?? return null
    ty :: cursor.typed.expr_types[found.id] ?? return null
    return type_hover(expr_name(found), ty)
}

// The name an expression is read through (an identifier's), or "".
expr_name :: fn(e: AST.Expr) -> string {
    if e is AST.IdentExpr {
        return e.name
    }
    return ""
}

/// `name: T` in a code fence, or the type alone when the value has no name.
type_hover :: fn(name: string, ty: Type) -> JsonValue {
    if name.byte_len() == 0 {
        return markdown_hover(code_fence(display_type(ty)))
    }
    return markdown_hover(code_fence(name + ": " + display_type(ty)))
}

// The cursor-position AST walkers (`find_expr_at`, `find_binding_rhs_type_at`)
// live in `vader/tools/lsp/analysis/ast_walk`: shared with typeDefinition and the
// completion / code-action layers.

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_vaderdoc_sections :: fn() -> void {
    doc :: "Render the thing.\n\n@param source  the text.\n@param path    where it\n               came from.\n@return        the output."
    assert_eq(format_vaderdoc(doc), "Render the thing.\n\n**Params**\n- `source`: the text.\n- `path`: where it came from.\n\n**Returns** the output.")
}

@test
test_vaderdoc_example_becomes_a_code_fence :: fn() -> void {
    doc :: "Add.\n@example\n  x :: add(1, 2)\n  println(x)"
    assert_eq(format_vaderdoc(doc), "Add.\n\n**Example**\n```\nx :: add(1, 2)\nprintln(x)\n```")
}

@test
test_vaderdoc_errors_are_listed :: fn() -> void {
    assert_eq(format_vaderdoc("@error C4002 when a value fails"), "**Errors**\n- C4002 when a value fails")
}

@test
test_vaderdoc_continuation_joins_its_tag :: fn() -> void {
    assert_eq(format_vaderdoc("@return the head,\n        cut short.\n\nMore prose."), "More prose.\n\n**Returns** the head, cut short.")
}
