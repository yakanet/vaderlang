// vader/tools/lsp/handlers/inlay_hint — `textDocument/inlayHint` handler.
//
// For each `let x := expr` (or `name :: expr`) without an explicit type
// annotation, emit a hint carrying the inferred type rendered *between*
// the two characters of the binding operator — `name :i64: value` for
// `::`, `name :i64= value` for `:=`. Mirrors the Rust-analyzer / TS-server
// UX so the editor shows what inference resolved to without forcing the
// user to hand-annotate.
//
// A fn or lambda written without a return type gets the one it has, `-> i32`,
// in front of its `=`, `{` or `->`; when it returns nothing and its body ends on
// a value, that value is marked as discarded.
//
// LSP §3.17 InlayHint shape :
//   { position: { line, character }, label: "i32", kind: 1 /* Type */,
//     paddingLeft: false, paddingRight: false }
//
// Positions are 0-based ; the Vader `Span` is 1-based, so every
// emitted coordinate gets `-1` for translation.

module "vader/tools/lsp/handlers"

import "std/collections"
import "json"
import "std/string"
import "vader/support/diagnostics"
import "vader/resolver"
import "vader/typecheck"
import "vader/types"
import "vader/tools/lsp/protocol"
import "vader/tools/lsp/analysis"
AST :: import "toolchain/ast"
import "toolchain/span"

/// Build the inlay-hint array for the document carried in `params`.
/// Returns a `JsonArray` (possibly empty) — the LSP spec mandates an
/// array response, never a null.
export handle_inlay_hint :: fn(state: ServerState, params: JsonValue) -> JsonValue {
    uri :: position_uri(params)
    if uri == "" { return JsonArray { .items = [] } }
    file_path :: uri_to_path(uri)
    if file_path == "" { return JsonArray { .items = [] } }

    cached :: typed_project_for(state, file_path)
    project :: cached.project
    result :: cached.result
    entry :: project.modules[project.entry] ?? return JsonArray { .items = [] }
    sf :: source_file_for_path(entry.module.files, file_path) ?? return JsonArray { .items = [] }

    hints: JsonValue[]: []
    ctx :: HintCtx {
        .typed   = result.typed,
        .content = sf.content,
        .li      = new_line_index(sf.content, state.position_encoding),
    }
    for decl in sf.program.decls {
        collect_from_decl(decl, ctx, hints)
    }
    return JsonArray { .items = hints }
}

// What the walkers need at every level : the typed side-tables the hints read
// from, the file text, which `emit_operator_hint` and the return-type hints scan
// for the real binding operator or separator rather than assuming a canonical
// spacing, and the line index that turns a byte offset into a `character` in the
// negotiated encoding.
HintCtx :: struct {
    typed:   TypedProgram
    content: string
    li:      LineIndex
}

// ---- AST walkers ---------------------------------------------------------

collect_from_decl :: fn(d: AST.Decl, ctx: HintCtx, out: JsonValue[]) -> void {
    match d {
        is AST.FnDecl -> {
            emit_fn_return_hints(d, ctx, out)
            match b :: d.body {
                is null          -> {}
                is AST.BlockExpr -> { collect_from_block(b, ctx, out) }
            }
        }
        is AST.ImplDecl -> {
            for m in d.members {
                // A trait default copied into the impl carries the trait's body
                // under synthetic spans that point nowhere in this file.
                if m.materialized {
                    continue
                }
                emit_fn_return_hints(m, ctx, out)
                match b :: m.body {
                    is null          -> {}
                    is AST.BlockExpr -> { collect_from_block(b, ctx, out) }
                }
            }
        }
        is AST.ConstDecl -> {
            // Skip when the user already annotated the type.
            if d.ty is null {
                emit_const_hint(d, ctx, out)
            }
        }
        is AST.ImportDecl | AST.StructDecl | AST.EnumDecl | AST.TraitDecl
         | AST.TypeAliasDecl | AST.AssertDecl -> {}
    }
}

collect_from_block :: fn(b: AST.BlockExpr, ctx: HintCtx, out: JsonValue[]) -> void {
    for s in b.stmts { collect_from_stmt(s, ctx, out) }
    if b.trailing !is null {
        collect_from_expr(b.trailing, ctx, out)
    }
}

collect_from_stmt :: fn(s: AST.Stmt, ctx: HintCtx, out: JsonValue[]) -> void {
    match s {
        is AST.LetStmt               -> {
            // Skip when the user already annotated the binding type.
            match s.ty {
                is null -> { emit_let_hint(s, ctx, out) }
                _       -> {}
            }
            collect_from_let_value(s, ctx, out)
        }
        is AST.ExprStmt              -> { collect_from_expr(s.expr, ctx, out) }
        is AST.ReturnStmt            -> {
            if s.value !is null {
                collect_from_expr(s.value, ctx, out)
            }
        }
        is AST.YieldStmt             -> { collect_from_expr(s.value, ctx, out) }
        is AST.AssignStmt            -> {
            collect_from_expr(s.target, ctx, out)
            collect_from_expr(s.value, ctx, out)
        }
        is AST.DestructureAssignStmt -> {
            for place in AST.assign_places(s) {
                collect_from_expr(place, ctx, out)
            }
            collect_from_expr(s.value, ctx, out)
        }
        is AST.ForStmt               -> {
            match w :: s.form {
                is AST.WhileFor    -> { collect_from_expr(w.cond, ctx, out) }
                is AST.InFor       -> { collect_from_expr(w.iter, ctx, out) }
                is AST.InfiniteFor -> {}
            }
            collect_from_block(s.body, ctx, out)
        }
        is AST.BreakStmt             -> {}
        is AST.ContinueStmt          -> {}
        is AST.DeferStmt             -> {
            match dsb :: s.body {
                is AST.DeferStmtBody  -> { collect_from_stmt(dsb.stmt, ctx, out) }
                is AST.DeferBlockBody -> { collect_from_block(dsb.block, ctx, out) }
            }
        }
    }
}

collect_from_expr :: fn(e: AST.Expr, ctx: HintCtx, out: JsonValue[]) -> void {
    // Surface an implicit `.into()` coercion carried on this value, if any.
    check_into_hint(e, ctx, out)
    // Recurse into every child expression : nested coercions (a coerced arg
    // inside `f(g(arr))`) and nested `let`/`const` type hints inside
    // block-bearing exprs both need the full walk.
    match e {
        is AST.CallExpr -> {
            collect_from_expr(e.callee, ctx, out)
            for a in e.args { collect_from_expr(a.value, ctx, out) }
        }
        is AST.FieldExpr -> { collect_from_expr(e.target, ctx, out) }
        is AST.IndexExpr -> {
            collect_from_expr(e.target, ctx, out)
            collect_from_expr(e.index, ctx, out)
        }
        is AST.UnaryExpr -> { collect_from_expr(e.operand, ctx, out) }
        is AST.BinaryExpr -> {
            collect_from_expr(e.left, ctx, out)
            collect_from_expr(e.right, ctx, out)
        }
        is AST.BlockExpr -> { collect_from_block(e, ctx, out) }
        is AST.IfExpr -> {
            collect_from_expr(e.cond, ctx, out)
            collect_from_block(e.then_block, ctx, out)
            match ei :: e.else_branch {
                is null            -> {}
                is AST.IfElseIf    -> { collect_from_expr(ei.branch, ctx, out) }
                is AST.IfElseBlock -> { collect_from_block(ei.block, ctx, out) }
            }
        }
        is AST.MatchExpr -> {
            collect_from_expr(e.scrutinee, ctx, out)
            for arm in e.arms {
                if arm.guard != null { collect_from_expr(arm.guard, ctx, out) }
                collect_from_expr(arm.body, ctx, out)
            }
        }
        is AST.LambdaExpr -> {
            emit_lambda_return_hints(e, true, ctx, out)
            collect_from_block(e.body, ctx, out)
        }
        is AST.StructLitExpr -> {
            for item in e.items {
                match item {
                    is AST.StructLitField  -> { collect_from_expr(item.value, ctx, out) }
                    is AST.StructLitSpread -> { collect_from_expr(item.expr, ctx, out) }
                }
            }
        }
        is AST.SeqLitExpr -> {
            for el in e.elements { collect_from_expr(el, ctx, out) }
        }
        is AST.RangeExpr -> {
            collect_from_expr(e.lower, ctx, out)
            collect_from_expr(e.upper, ctx, out)
        }
        is AST.AwaitExpr -> { collect_from_expr(e.inner, ctx, out) }
        is AST.CastExpr -> { collect_from_expr(e.value, ctx, out) }
        is AST.GenericInstExpr -> { collect_from_expr(e.callee, ctx, out) }
        is AST.IntrinsicCallExpr -> {
            for a in e.args { collect_from_expr(a, ctx, out) }
        }
        is AST.StringLitExpr -> {
            for part in e.parts {
                if part is AST.StringLitInterp { collect_from_expr(part.expr, ctx, out) }
            }
        }
        // Leaves : literals, idents, dot-variants, type-position exprs.
        _ -> {}
    }
}

/// Emit a ghost `.into()` hint when `e`'s value is implicitly coerced via
/// `Into` (recorded by the typechecker in `typed.into_coercions`, keyed by
/// `Expr.id`). Anchors at the exclusive end of the value, so the zero-padding
/// label reads as `value.into()`.
check_into_hint :: fn(e: AST.Expr, ctx: HintCtx, out: JsonValue[]) -> void {
    if ctx.typed.into_coercions[e.id] is null { return }
    line :: e.span.end.line - 1
    out.push(build_hint(line, li_character(ctx.li, line, e.span.end.offset), ".into()", .None))
}

// ---- hint emission -------------------------------------------------------

/// Where a type hint must be inserted, 0-based as the LSP wants it.
HintAnchor :: struct {
    line:      i32
    character: i32
}

/// Locate the binding operator between `name_span` and `value_span`, and return
/// the anchor that lands the hint BETWEEN its two characters.
///
/// The operator is found by scanning the source, not computed from the value's
/// column. The previous arithmetic (`value.column - 3`) hard-coded "two operator
/// chars plus exactly one space", so any other spelling misplaced the hint :
/// `x ::  1` pushed it past the operator, `x::1` before it, and a value on the
/// NEXT line yielded a negative character (an invalid LSP position). Anchoring on
/// the operator itself is spacing- and layout-independent.
///
/// The scan tracks LINES only ; the character comes from `li_character`, the one
/// place that knows the negotiated encoding. Counting columns here by hand would
/// count BYTES — one multi-byte codepoint between the name and the operator (say
/// `x /* café */ :: 1`) and the hint drifts, which is precisely the class of bug
/// `protocol/line_index` exists to prevent.
///
/// @param li          the document index, in the negotiated position encoding.
/// @param content     the full file text ; the spans index into it via `offset`.
/// @param name_span   the bound name — its `end` (exclusive) starts the scan.
/// @param value_span  the value — its `start` bounds the scan.
/// @return            the 0-based anchor ; falls back to the value's own position
///                    less the canonical 3 columns (clamped to 0) when no operator
///                    is found in range, so a surprising span degrades the
///                    placement instead of dropping the hint.
operator_hint_anchor :: fn(
    li: LineIndex, content: string, name_span: Span, value_span: Span,
) -> HintAnchor {
    limit :: value_span.start.offset
    line: i32 = name_span.end.line - 1
    if limit <= content.byte_len() {
        for off in name_span.end.offset..<limit {
            byte :: content.byte_at(off)
            if byte == '\n' {
                line += 1
                continue
            }
            if byte == '\r' {
                // CRLF advances on its LF ; a lone CR opens a line on its own.
                if off + 1 >= limit || content.byte_at(off + 1) != '\n' {
                    line += 1
                }
                continue
            }
            // `::` or `:=` — the hint inserts before the operator's SECOND char.
            if byte == ':' && off + 1 < limit {
                next :: content.byte_at(off + 1)
                if next == ':' || next == '=' {
                    return HintAnchor {
                        .line = line, .character = li_character(li, line, off + 1),
                    }
                }
            }
        }
    }
    value_line :: value_span.start.line - 1
    // The historical placement was `value.column - 3` on a 1-BASED column ;
    // `li_character` is 0-based, so the same spot is `- 2` here.
    fallback :: li_character(li, value_line, value_span.start.offset) - 2
    return HintAnchor {
        .line = value_line,
        .character = if fallback > 0 { fallback } else { 0 },
    }
}

/// Push a type hint nested *inside* the binding operator, so the line reads
/// `name :u8: value` (`::`) or `name :u8= value` (`:=`) — the type sits between
/// the operator's two characters. See `operator_hint_anchor` for the placement.
emit_operator_hint :: fn(
    ctx: HintCtx, name_span: Span, value_span: Span, label: string, out: JsonValue[],
) -> void {
    anchor :: operator_hint_anchor(ctx.li, ctx.content, name_span, value_span)
    out.push(build_hint(anchor.line, anchor.character, label, .None))
}

/// Emit the inferred-type hint for a `let` binding.
///
/// Currently handles the `SimpleBinding` case ; tuple-destructuring
/// bindings are skipped (each leaf would need its own hint, and the
/// static type isn't always useful on the destructure itself).
emit_let_hint :: fn(ls: AST.LetStmt, ctx: HintCtx, out: JsonValue[]) -> void {
    match sb :: ls.binding {
        is AST.SimpleBinding -> {
            ty :: ctx.typed.local_types[sb.name_span.hash()] ?? return
            if ty is UnresolvedType { return }
            if ty is FreeIntType { return }
            if ty is FreeFloatType { return }
            emit_operator_hint(ctx, sb.name_span, ls.value.span, display_type(ty), out)
        }
        _                    -> {}
    }
}

/// Same shape as `emit_let_hint`, but for top-level `ConstDecl`. The
/// type comes from `declared_type_at`: that's the final defaulted
/// form (`FreeInt`→`i32`, `FreeFloat`→`f64`), whereas `expr_types`
/// keeps the un-defaulted free type. Type-alias constants (`Type ::
/// i32 | string`) get `TY_TYPE` ; we skip those — they're already
/// self-describing.
emit_const_hint :: fn(cd: AST.ConstDecl, ctx: HintCtx, out: JsonValue[]) -> void {
    ty :: declared_type_at(ctx.typed, cd.name_span) ?? return
    if ty is UnresolvedType { return }
    if ty is TypeMetaType { return }
    emit_operator_hint(ctx, cd.name_span, cd.value.span, display_type(ty), out)
}

// ---- return hints --------------------------------------------------------

/// Emit the hints of a fn written without a return type. Its return type, when
/// it hands one back (`fn(x: i32) = x + 1`, or an impl member taking its trait's),
/// goes in front of the `=` of an expression body or on the `{` of a block body.
emit_fn_return_hints :: fn(d: AST.FnDecl, ctx: HintCtx, out: JsonValue[]) -> void {
    if d.return_type != null || d.comptime_synthetic {
        return
    }
    body :: d.body ?? return
    declared :: declared_type_at(ctx.typed, d.name_span) ?? return
    if declared !is FnType {
        return
    }
    anchor :: fn_return_anchor(ctx, body.span.start, d.is_expression_bodied)
    emit_return_hints(declared.return_type, body, anchor, ctx, out)
}

// A lambda bound without an annotation shows its whole type, return included, in
// the let hint: its own return hint would repeat it. Its discarded value, if any,
// is still marked.
collect_from_let_value :: fn(s: AST.LetStmt, ctx: HintCtx, out: JsonValue[]) -> void {
    value :: s.value
    if s.ty == null && value is AST.LambdaExpr {
        emit_lambda_return_hints(value, false, ctx, out)
        collect_from_block(value.body, ctx, out)
        return
    }
    collect_from_expr(value, ctx, out)
}

/// Emit the hints of a lambda written without a return type. Its return type
/// goes in front of the `->` of the arrow form, or on the `{` of the `fn(...)`
/// form, which has none.
///
/// @param e            the lambda.
/// @param show_return  false when a hint nearby already shows the return type.
/// @param ctx          the walk context.
/// @param out          the hints so far.
emit_lambda_return_hints :: fn(
    e: AST.LambdaExpr,
    show_return: bool,
    ctx: HintCtx,
    out: JsonValue[],
) -> void {
    if e.return_type != null {
        return
    }
    lambda_type :: ctx.typed.expr_types[e.id] ?? return
    if lambda_type !is FnType {
        return
    }
    returned :: lambda_type.return_type
    if is_void(returned) {
        emit_discarded_hint(e.body, ctx, out)
    } else if show_return && carries_value(returned) {
        start :: e.body.span.start
        anchor :: anchor_before_token(ctx.li, ctx.content, start, "->") ?? anchor_at(ctx.li, start)
        emit_return_type_hint(returned, anchor, out)
    }
}

/// A body that returns nothing gets its discarded last value marked; any other
/// gets its return type at `anchor`.
emit_return_hints :: fn(
    returned: Type, body: AST.BlockExpr, anchor: HintAnchor, ctx: HintCtx, out: JsonValue[],
) -> void {
    if is_void(returned) {
        emit_discarded_hint(body, ctx, out)
    } else if carries_value(returned) {
        emit_return_type_hint(returned, anchor, out)
    }
}

emit_return_type_hint :: fn(returned: Type, anchor: HintAnchor, out: JsonValue[]) -> void {
    out.push(build_hint(anchor.line, anchor.character, "-> ${display_type(returned)}", .Right))
}

/// Mark the last expression of a body that returns nothing when it has a value:
/// the value is evaluated, then dropped.
emit_discarded_hint :: fn(body: AST.BlockExpr, ctx: HintCtx, out: JsonValue[]) -> void {
    trailing :: body.trailing ?? return
    value :: ctx.typed.expr_types[trailing.id] ?? return
    if !carries_value(value) {
        return
    }
    anchor :: anchor_at(ctx.li, trailing.span.end)
    out.push(build_hint(anchor.line, anchor.character, "(discarded ${display_type(value)})", .Left))
}

// Whether a hint can name `t` as a value: not void, not `never`, resolved, and
// not a free literal the let hints also leave out.
carries_value :: fn(t: Type) -> bool =
    !is_void(t) && t !is NeverType && t !is UnresolvedType && t !is FreeIntType
    && t !is FreeFloatType

/// Where a fn's return-type hint goes: before the `=` of an expression body,
/// on the `{` of a block body.
fn_return_anchor :: fn(
    ctx: HintCtx,
    body_start: Position,
    is_expression_bodied: bool,
) -> HintAnchor {
    on_body :: anchor_at(ctx.li, body_start)
    if is_expression_bodied {
        return anchor_before_token(ctx.li, ctx.content, body_start, "=") ?? on_body
    }
    return on_body
}

/// The anchor in front of `token` when only whitespace separates it from
/// `start`. Lines are tracked while stepping back; the character comes from
/// `li_character`, which knows the negotiated encoding.
///
/// @param li       the document index, in the negotiated position encoding.
/// @param content  the full file text.
/// @param start    where the body begins.
/// @param token    the separator before the body, `=` or `->`.
/// @return         the 0-based anchor, or null when something else precedes the body.
anchor_before_token :: fn(
    li: LineIndex,
    content: string,
    start: Position,
    token: string,
) -> HintAnchor | null {
    off := start.offset
    line: i32 = start.line - 1
    for off > 0 && off <= content.byte_len() && is_layout_byte(content.byte_at(off - 1)) {
        off -= 1
        if content.byte_at(off) == '\n' {
            line -= 1
        }
    }
    width :: token.byte_len()
    if off < width || !content.matches_at(off - width, token) {
        return null
    }
    return HintAnchor { .line = line, .character = li_character(li, line, off - width) }
}

// The 0-based anchor of a 1-based span position.
anchor_at :: fn(li: LineIndex, pos: Position) -> HintAnchor {
    line :: pos.line - 1
    return HintAnchor { .line = line, .character = li_character(li, line, pos.offset) }
}

is_layout_byte :: fn(b: u8) -> bool = b == ' ' || b == '\t' || b == '\n' || b == '\r'

/// Which side of a hint gets the editor's spacing: a type nested in an operator
/// hugs both neighbours, a return type stands before its separator, a discard
/// note after its value.
HintPadding :: enum {
    None
    Left
    Right
}

build_hint :: fn(line: i32, character: i32, label: string, padding: HintPadding) -> JsonValue {
    position :: MutableMap<string, JsonValue> {}
    position["line"]      = JsonNumber { .value = f64(line) }
    position["character"] = JsonNumber { .value = f64(character) }

    hint :: MutableMap<string, JsonValue> {}
    hint["position"]     = JsonObject { .entries = position }
    hint["label"]        = JsonString { .value = label }
    // InlayHintKind.Type = 1 (LSP §3.17.21).
    hint["kind"]         = JsonNumber { .value = 1.0 }
    hint["paddingLeft"]  = JsonBool { .value = padding == .Left }
    hint["paddingRight"] = JsonBool { .value = padding == .Right }
    return JsonObject { .entries = hint }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

test_pos :: fn(offset: i64, line: i32, column: i32) -> Position =
    Position { .file = "t.vader", .offset = offset, .line = line, .column = column }

// `operator_hint_anchor` reads only the name's `end` and the value's `start`, so
// the other endpoint of each span is filler.
name_ending_at :: fn(offset: i64, line: i32, column: i32) -> Span =
    Span { .start = test_pos(0, 1, 1), .end = test_pos(offset, line, column) }

// The anchor for `content`, indexed in utf-16 as a default LSP client would
// negotiate — so the tests exercise the same conversion path as the handler.
anchor_of :: fn(content: string, name_span: Span, value_span: Span) -> HintAnchor =
    operator_hint_anchor(new_line_index(content, .Utf16), content, name_span, value_span)

value_starting_at :: fn(offset: i64, line: i32, column: i32) -> Span =
    Span { .start = test_pos(offset, line, column), .end = test_pos(offset, line, column) }

// A 0-based `character` of C inserts before the (C+1)-th 1-based column, so
// anchoring on the FIRST operator char's 1-based column lands between the two.
@test
test_anchor_canonical_spacing :: fn() -> void {
    // `x :: 1` — the shape the old arithmetic was tuned for.
    a :: anchor_of("x :: 1", name_ending_at(1, 1, 2), value_starting_at(5, 1, 6))
    assert_eq(a.line, 0)
    assert_eq(a.character, 3)
}

@test
test_anchor_survives_extra_space :: fn() -> void {
    // `x ::  1` — two spaces before the value. `value.column - 3` gave 4, which
    // pushed the hint PAST the operator.
    a :: anchor_of("x ::  1", name_ending_at(1, 1, 2), value_starting_at(6, 1, 7))
    assert_eq(a.character, 3)
}

@test
test_anchor_survives_no_space :: fn() -> void {
    // `x::1` — no spaces at all. `value.column - 3` gave 1, i.e. BEFORE the
    // operator, splitting `x` from `::`.
    a :: anchor_of("x::1", name_ending_at(1, 1, 2), value_starting_at(3, 1, 4))
    assert_eq(a.character, 2)
}

@test
test_anchor_accepts_mutable_operator :: fn() -> void {
    // `:=` anchors exactly like `::`.
    a :: anchor_of("x := 1", name_ending_at(1, 1, 2), value_starting_at(5, 1, 6))
    assert_eq(a.character, 3)
}

@test
test_anchor_follows_vertical_alignment :: fn() -> void {
    // `abc  :: 1` — padded name→operator gap, which is why the anchor can't be
    // derived from the NAME either.
    a :: anchor_of("abc  :: 1", name_ending_at(3, 1, 4), value_starting_at(8, 1, 9))
    assert_eq(a.character, 6)
}

@test
test_anchor_stays_on_the_operator_line :: fn() -> void {
    // Value on the NEXT line : the hint belongs on the operator's line, and the
    // old arithmetic put it on the value's line at a bogus column.
    a :: anchor_of("x ::\n    1", name_ending_at(1, 1, 2), value_starting_at(9, 2, 5))
    assert_eq(a.line, 0)
    assert_eq(a.character, 3)
}

@test
test_anchor_falls_back_without_an_operator :: fn() -> void {
    // No `::` / `:=` in range — degrade to the historical placement rather than
    // dropping the hint.
    a :: anchor_of("x = 1", name_ending_at(1, 1, 2), value_starting_at(4, 1, 5))
    assert_eq(a.line, 0)
    assert_eq(a.character, 2)
}

@test
test_anchor_never_emits_a_negative_character :: fn() -> void {
    // The fallback is clamped : a value in column 1 would otherwise compute -2,
    // which is an invalid LSP position.
    a :: anchor_of("x\n1", name_ending_at(1, 1, 2), value_starting_at(2, 2, 1))
    assert_eq(a.line, 1)
    assert_eq(a.character, 0)
}


// `anchor_before_token` steps back from the body over layout only, so the anchor
// lands ON the separator, even when it closes the previous line.
token_anchor_of :: fn(content: string, body: Position, token: string) -> HintAnchor | null =
    anchor_before_token(new_line_index(content, .Utf16), content, body, token)

@test
test_return_anchor_finds_the_equals_on_the_previous_line :: fn() -> void {
    // `f :: fn(x: i32) =` then `    x * 2` : the body starts at offset 22.
    content :: "f :: fn(x: i32) =\n    x * 2"
    a :: token_anchor_of(content, test_pos(22, 2, 5), "=") ?? return fail("no anchor")
    assert_eq(a.line, 0)
    assert_eq(a.character, 16)
}

@test
test_return_anchor_finds_a_lambda_arrow :: fn() -> void {
    a :: token_anchor_of("(x: i32) -> x + 1", test_pos(12, 1, 13), "->") ?? return fail("no anchor")
    assert_eq(a.line, 0)
    assert_eq(a.character, 9)
}

@test
test_return_anchor_without_the_token_is_none :: fn() -> void {
    assert(token_anchor_of("x -> y", test_pos(5, 1, 6), "=") == null, "`=` is not before `y`")
}
