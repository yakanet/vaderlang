// vader/tools/lsp/handlers/workspace_symbol: `workspace/symbol`, the declarations of the
// whole workspace by name.
//
// The editor's "go to symbol" box (Cmd+T in VS Code, Cmd+Alt+O in IntelliJ).
// The search and the per-file cache are `analysis/workspace_symbols`.

module "vader/tools/lsp/handlers"

import "json"
import "std/collections"
import "vader/tools/lsp/analysis"
import "vader/tools/lsp/protocol"

/// Most symbols one search returns : the box shows the first screenful, and the
/// user types on to narrow it.
WORKSPACE_SYMBOL_LIMIT: i64: 200

/// Resolve `workspace/symbol` : the declarations whose name matches the query.
///
/// @param state   the server state.
/// @param params  the request params (`query`).
/// @return        a `SymbolInformation[]`, best match first.
export handle_workspace_symbol :: fn(state: ServerState, params: JsonValue) -> JsonValue {
    out: JsonValue[]: []
    for s in find_workspace_symbols(state, get_string(params, "query"), WORKSPACE_SYMBOL_LIMIT) {
        obj :: MutableMap<string, JsonValue> {}
        obj["name"]          = JsonString { .value = s.name }
        obj["kind"]          = JsonNumber { .value = f64(symbol_kind(s.kind, s.owner)) }
        obj["location"]      = location_json(path_to_uri(s.path), s.range)
        obj["containerName"] = JsonString { .value = container_line(s.module, s.owner) }
        out.push(JsonObject { .entries = obj })
    }
    return JsonArray { .items = out }
}
