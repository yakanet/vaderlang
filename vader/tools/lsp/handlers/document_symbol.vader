// vader/tools/lsp/handlers/document_symbol — `textDocument/documentSymbol` handler.
//
// Powers the editor outline, breadcrumbs and the Cmd+Shift+O / Ctrl+F12 symbol
// picker. Maps the per-document index's file-wide `DeclEntry[]`
// (`indexer.vader`) to a `DocumentSymbol[]` : every top-level declaration
// (`scope_span == null`), fn / struct / enum / trait / type-alias / const, a
// type holding its members as children : a struct's fields, an enum's
// variants, a trait's methods, and the methods its `implements` blocks in the
// document define. Intra-file bindings (params, locals, for-in vars) carry a
// scope and are excluded.
//
// Reuses `range_json` / `span_to_range_json` / `position_uri` from
// `vader/tools/lsp/protocol` and the per-document index from `vader/tools/lsp/analysis`.

module "vader/tools/lsp/handlers"

import "json"
import "std/collections"
import "vader/tools/lsp/protocol"
import "vader/tools/lsp/analysis"

/// Build the `DocumentSymbol[]` response for the document named in `params`
/// (`{ textDocument: { uri } }`).
///
/// @param params  the request params carrying `textDocument.uri`.
/// @return        a `DocumentSymbol[]` JSON array ; empty when the document was
///                never indexed (`documentSymbol` is array-typed, never null).
export handle_document_symbol :: fn(state: ServerState, params: JsonValue) -> JsonValue {
    uri :: position_uri(params)
    idx :: state.index_for(uri)
    match idx {
        is null     -> { return JsonArray { .items = [] } }
        is DocIndex -> { return outline_json(idx) }
    }
}

/// The declarations at the top of the outline : every `DeclEntry` with no
/// enclosing scope, but the members of a type the document declares, which
/// nest under it (`members_of`). A method of a type declared elsewhere (`i32
/// implements Display`) stays at the top. Intra-file bindings (params / locals /
/// for-in vars) carry a `scope_span` and are filtered out.
toplevel_symbols :: fn(idx: DocIndex) -> DeclEntry[] {
    out: DeclEntry[]: []
    for d in idx.decls {
        if d.scope_span != null || is_member_kind(d.kind) {
            continue
        }
        if d.owner.byte_len() > 0 && declares_type(idx, d.owner) {
            continue
        }
        out.push(d)
    }
    return out
}

/// The members of the type `owner` declares in the document, in source order :
/// fields, variants, trait methods, and the methods of its `implements` blocks.
///
/// @param idx    the document's index.
/// @param owner  the type's name.
members_of :: fn(idx: DocIndex, owner: string) -> DeclEntry[] {
    out: DeclEntry[]: []
    for d in idx.decls {
        if d.owner == owner {
            out.push(d)
        }
    }
    return out
}

// Whether the document declares a type named `name` at top level.
declares_type :: fn(idx: DocIndex, name: string) -> bool {
    for d in idx.decls {
        if d.name == name && is_type_decl(d.kind) {
            return true
        }
    }
    return false
}

// Whether `k` declares a type that may hold members.
is_type_decl :: fn(k: DeclKind) -> bool =
    k == .Struct || k == .Enum || k == .Trait || k == .TypeAlias || k == .Const

// Map a `DeclKind` onto its LSP `SymbolKind` wire number (LSP §3.17). Top-level
// kinds get their natural icon ; the intra-file kinds (filtered out before
// encoding) fall back to Variable so the function stays total over the enum.
lsp_symbol_kind :: fn(k: DeclKind) -> i32 = match k {
    .Fn        -> 12   // Function
    .Struct    -> 23   // Struct
    .Enum      -> 10   // Enum
    .Trait     -> 11   // Interface
    .TypeAlias -> 5    // Class
    .Const     -> 14   // Constant
    .Field     -> 8    // Field
    .EnumVariant -> 22   // EnumMember
    .Param     -> 13   // Variable
    .Local     -> 13   // Variable
    .ForIn     -> 13   // Variable
}

// The outline of the document : its top-level declarations, each type with its
// members as children.
outline_json :: fn(idx: DocIndex) -> JsonValue {
    items: JsonValue[]: []
    for e in toplevel_symbols(idx) {
        children: JsonValue[]: []
        if is_type_decl(e.kind) {
            for m in members_of(idx, e.name) {
                children.push(symbol_json(m, idx.line_index, []))
            }
        }
        items.push(symbol_json(e, idx.line_index, children))
    }
    return JsonArray { .items = items }
}

// `range` spans the whole declaration ; `selectionRange` is just the name (what
// the editor reveals + selects on pick).
symbol_json :: fn(e: DeclEntry, li: LineIndex, children: JsonValue[]) -> JsonValue {
    obj :: MutableMap<string, JsonValue> {}
    obj["name"]           = JsonString { .value = e.name }
    obj["kind"]           = JsonNumber { .value = f64(symbol_kind(e.kind, e.owner)) }
    obj["range"]          = range_json(e.full_span.span_to_range_json(li))
    // The LSP requires `selectionRange ⊆ range`. A malformed `name_span` (a
    // synthetic decl whose name span sits outside its full span) would otherwise
    // make the client reject the ENTIRE `documentSymbol` response — fall back to
    // the full span when the name span isn't contained.
    sel :: if span_encloses(e.full_span, e.name_span) { e.name_span } else { e.full_span }
    obj["selectionRange"] = range_json(sel.span_to_range_json(li))
    if children.len() > 0 {
        obj["children"] = JsonArray { .items = children }
    }
    if e.owner.byte_len() > 0 {
        obj["detail"] = JsonString { .value = e.owner }
    }
    return JsonObject { .entries = obj }
}

// The `SymbolKind` a declaration of `kind` shows with : Method (6) for a fn
// member of the type `owner`, its kind's otherwise.
symbol_kind :: fn(kind: DeclKind, owner: string) -> i32 {
    if kind == .Fn && owner.byte_len() > 0 {
        return 6
    }
    return lsp_symbol_kind(kind)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// `name` of the i-th top-level symbol, or "" out of range — keeps the asserts
// terse without a find helper.
sym_name_at :: fn(syms: DeclEntry[], i: i64) -> string {
    if i >= syms.len() { return "" }
    return syms[i].name
}

@test
test_toplevel_symbols_lists_decls_in_order :: fn() -> void {
    src :: """
Color :: enum { Red, Green }

Point :: struct { x: i32, y: i32 }

add :: fn(a: i32, b: i32) -> i32 {
    sum :: a + b
    return sum
}

MAX :: 10
"""
    idx :: build_index("t.vader", src, .Utf16)
    syms :: toplevel_symbols(idx)
    // The intra-fn binding `sum` (Local) must NOT appear — only the 4 decls.
    assert_eq(syms.len(), 4)
    assert_eq(sym_name_at(syms, 0), "Color")
    assert_eq(sym_name_at(syms, 1), "Point")
    assert_eq(sym_name_at(syms, 2), "add")
    assert_eq(sym_name_at(syms, 3), "MAX")
}

@test
test_members_nest_under_their_type :: fn() -> void {
    src :: """
Point :: struct {
    x: i32
}

Point implements Display {
    to_string :: fn(self) -> string = "p"
}

i32 implements Shape {
    area :: fn(self) -> i32 = 0
}
"""
    idx :: build_index("t.vader", src, .Utf16)
    syms :: toplevel_symbols(idx)
    // `Point`, then `area` : the method of a type declared elsewhere stays on top.
    assert_eq(syms.len(), 2)
    assert_eq(sym_name_at(syms, 0), "Point")
    assert_eq(sym_name_at(syms, 1), "area")
    members :: members_of(idx, "Point")
    assert_eq(members.len(), 2)
    assert_eq(sym_name_at(members, 0), "x")
    assert_eq(sym_name_at(members, 1), "to_string")
}

@test
test_lsp_symbol_kind_mapping :: fn() -> void {
    assert_eq(lsp_symbol_kind(.Fn), 12)
    assert_eq(lsp_symbol_kind(.Struct), 23)
    assert_eq(lsp_symbol_kind(.Enum), 10)
    assert_eq(lsp_symbol_kind(.Trait), 11)
    assert_eq(lsp_symbol_kind(.TypeAlias), 5)
    assert_eq(lsp_symbol_kind(.Const), 14)
}

@test
test_sam_synthetic_impl_member_not_a_symbol :: fn() -> void {
    // SAM-sugar impl members (`Type implements Trait -> expr`) are nameless in
    // the AST — the method name is resolved from the trait later. They must not
    // surface as outline symbols : an empty `DocumentSymbol.name` is falsy and
    // crashes the whole `documentSymbol` response client-side (the bug this
    // guards — `MutableSet<T> implements Contains<T> -> value in self.inner`).
    src :: """
Box :: struct { v: i32 }

Box implements Contains<i32> -> value == self.v
"""
    idx :: build_index("t.vader", src, .Utf16)
    syms :: toplevel_symbols(idx)
    // Only `Box` — the SAM member contributes no (empty-named) symbol.
    assert_eq(syms.len(), 1)
    assert_eq(sym_name_at(syms, 0), "Box")
}

@test
test_comptime_const_synthetic_fn_not_a_symbol :: fn() -> void {
    // `NAME :: @comptime { … }` desugars to a synthetic `__comptime_NAME` fn,
    // compiler-internal: the outline shows the const alone, and every surfaced
    // symbol's name span stays inside its full span (a client drops the whole
    // response otherwise).
    src :: """
K :: @comptime {
    1 + 2
}
"""
    idx :: build_index("t.vader", src, .Utf16)
    syms :: toplevel_symbols(idx)
    // Only the const `K` — the synthetic `__comptime_K` fn is excluded.
    assert_eq(syms.len(), 1)
    assert_eq(sym_name_at(syms, 0), "K")
    // And every surfaced symbol's name span is contained in its full span.
    for s in syms {
        assert(span_encloses(s.full_span, s.name_span), "name_span ⊆ full_span")
    }
}

@test
test_toplevel_symbols_excludes_params_and_locals :: fn() -> void {
    src :: """
helper :: fn(arg: i32) -> i32 {
    tmp :: arg + 1
    return tmp
}
"""
    idx :: build_index("t.vader", src, .Utf16)
    syms :: toplevel_symbols(idx)
    // Only `helper` — `arg` (Param) and `tmp` (Local) are scoped, not file-wide.
    assert_eq(syms.len(), 1)
    assert_eq(sym_name_at(syms, 0), "helper")
}
