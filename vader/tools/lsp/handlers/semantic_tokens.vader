// vader/tools/lsp/handlers/semantic_tokens: `textDocument/semanticTokens/full` handler.
//
// LSP encodes semantic tokens as a flat `i32[]` array of 5-tuples :
//
//   [ deltaLine, deltaStartChar, length, tokenType, tokenModifiers, ...]
//
// `deltaLine` is line distance from the previous token. `deltaStartChar`
// is the column distance: relative to the previous token's start when
// `deltaLine == 0`, absolute (0-based) when starting a new line. We
// produce tokens in document order so this encoding is straightforward.
//
// Positions are 0-based. Producers fill each `RawToken`'s byte offsets and stay
// encoding-agnostic ; `reencode_columns` then derives every `column` + `length` in
// the negotiated position encoding (utf-8 / utf-16 / utf-32) through the
// document's `LineIndex`, so multi-byte and astral content lands correctly.

module "vader/tools/lsp/handlers"

import "std/string"
import "json"
import "std/collections"
import "std/sort"
import "vader/front/lexer"
import "vader/tools/fmt"
import "vader/tools/lsp/protocol"
import "vader/tools/lsp/analysis"
AST :: import "toolchain/ast"

// ---- handler --------------------------------------------------------------

/// Handle `textDocument/semanticTokens/full`. Returns the JSON value to
/// ship as the `result` field: either `{ data: [...] }` or `null` when
/// the document is unknown / closed.
/// @param state   shared server state.
/// @param params  request params : `{ textDocument: { uri } }`.
/// @return        `{ data: [...] }` or `null`.
export handle_semantic_tokens_full :: fn(state: ServerState, params: JsonValue) -> JsonValue {
    idx :: state.index_for(position_uri(params)) ?? return JsonNull {}
    if idx.source.byte_len() == 0 {
        return JsonNull {}
    }
    result :: MutableMap<string, JsonValue> {}
    result["data"] = encode_delta(document_tokens(idx))
    return JsonObject { .entries = result }
}

// ---- producer -------------------------------------------------------------

// Every token of the document `idx` holds, from all three producers, with its
// column and length in the encoding of its line index, in document order.
document_tokens :: fn(idx: DocIndex) -> RawToken[] {
    tokens: RawToken[]: []
    collect_token_kinds(idx.tokens, tokens)
    collect_comment_kinds(idx.source, tokens)
    collect_ast_idents(idx, tokens)
    reencode_columns(tokens, idx.line_index)
    return in_document_order(tokens)
}

// Derive every token's `column` + `length` from its byte offsets in the negotiated
// encoding. Run once, after all producers have filled the offsets. This is the
// sole place the position encoding is applied: producers stay encoding-agnostic.
reencode_columns :: fn(out: RawToken[], li: LineIndex) -> void {
    for i in 0..<out.len() {
        column :: li_character(li, out[i].line, out[i].start_offset)
        out[i].column = column
        out[i].length = li_character(li, out[i].line, out[i].end_offset) - column
    }
}

// ---- lexer tokens → semantic tokens --------------------------------------

collect_token_kinds :: fn(lexed: Token[], out: RawToken[]) -> void {
    for i in 0..<lexed.len() {
        token_type :: semantic_type_at(lexed, i) ?? continue
        push_span(out, lexed[i].span, token_type)
    }
}

// The semantic type of `tokens[i]`. The `!` of `!is` / `!in` is part of the
// negated operator, so it is a keyword too: as an operator, the two halves would
// colour differently (mirrors the `!is` / `!in` patterns in the TextMate grammar).
semantic_type_at :: fn(tokens: Token[], i: i64) -> TokenType | null {
    t :: tokens[i]
    negates :: i + 1 < tokens.len() && (tokens[i + 1].kind == .KwIs || tokens[i + 1].kind == .KwIn)
    if t.kind == .Bang && negates {
        return .Keyword
    }
    return classify_token(t)
}

// The semantic type of `t`, `null` for a kind this pass leaves without a token.
// Exhaustive over `TokenKind` (no wildcard) so a new variant (a new keyword in
// particular) trips T3013 here instead of silently going uncoloured, the exact
// drift that once left `yield` / `const` unhighlighted.
classify_token :: fn(t: Token) -> TokenType | null = match t.kind {
    // Keywords: mirrors `front/lexer/keywords.vader::lookup_keyword`.
    .KwFn | .KwStruct | .KwTrait | .KwImplements | .KwEnum | .KwIf | .KwElse
        | .KwMatch | .KwIs | .KwFor | .KwIn | .KwReturn | .KwYield | .KwAwait | .KwDefer
        | .KwBreak | .KwContinue | .KwImport | .KwAs | .KwExport | .KwTrue
        | .KwFalse | .KwNull | .KwSelf | .KwConst -> .Keyword

    .IntLit | .FloatLit -> .Number

    // Operators + interpolation delimiters.
    .InterpOpen | .InterpClose
        | .Plus | .Minus | .Star | .Slash | .Percent | .PlusPercent | .MinusPercent | .StarPercent
        | .Amp | .Pipe | .Caret | .Tilde | .Shl | .Shr
        | .Eq | .Neq | .Same | .NotSame | .Lt | .Lte | .Gt | .Gte
        | .AndAnd | .OrOr | .Bang | .QuestionQuestion
        | .Assign | .PlusAssign | .MinusAssign | .StarAssign | .SlashAssign | .PercentAssign
        | .PlusPercentAssign | .MinusPercentAssign | .StarPercentAssign
        | .DeclConst | .DeclVar | .RangeExcl | .RangeIncl
        | .Arrow | .FatArrow -> .Operator

    // No token in THIS lexer-driven pass. Identifiers are deliberately skipped:
    // with only the lexer we can't tell function / parameter / variable apart,
    // and mis-typing them makes clients (LSP4IJ) underline every word; the
    // AST-driven pass (`ast_tokens.vader::collect_ast_idents`) paints idents.
    //
    // String and char literals are skipped for the same reason one level up: the
    // lexer sees ONE `StringPart` spanning the whole literal body, so a `string`
    // token over it FLATTENS what the TextMate grammar paints in two colours:
    // escape sequences (`\t`, `\n`) lost theirs the moment the LSP loaded. The
    // shared grammar (`editors/common/vader.tmLanguage.json`) already owns
    // strings, escapes included, so the semantic layer only degrades them.
    // `.InterpOpen` / `.InterpClose` keep their operator token above: they
    // delimit a real expression, not literal text.
    //
    // Punctuation / brackets / layout / `@` / `$` / `...` carry no token.
    .Ident | .Eof | .Newline | .DotDotDot | .At | .Dollar
        | .CharLit | .StringBegin | .StringPart | .StringEnd
        | .LParen | .RParen | .LBracket | .RBracket | .LBrace | .RBrace
        | .Comma | .Dot | .Colon -> null
}

// ---- comments → semantic tokens ------------------------------------------

collect_comment_kinds :: fn(source: string, out: RawToken[]) -> void {
    for c in scan_comments(source).comments {
        out.push_all(comment_to_raw(c))
    }
}

// Returns one or more RawTokens for a comment :
//   - regular `Line` / `Block` : one Comment-typed token covering the full span.
//   - `DocLine` (`///`) : multiple tokens, the leading `///` + body as
//     comment (documentation modifier), `@param`/`@return`/etc. as
//     decorator (documentation modifier), `@param`'s name as parameter
//     (documentation modifier).
comment_to_raw :: fn(c: Comment) -> RawToken[] {
    out: RawToken[]: []
    // Base case : non-doc comments emit a single comment-typed token.
    match c.kind {
        .Line | .Block -> {
            // A multi-line block comment is one token over its whole span; the
            // client re-wraps it.
            out.push(make_comment_token(c))
            return out
        }
        .DocLine -> {
            collect_doc_line_tokens(c, out)
            return out
        }
    }
}

// The token of the comment `c`. `Comment` carries no end column, so its end is
// derived from the text's byte length ; `reencode_columns` turns the offsets into
// column + length.
make_comment_token :: fn(c: Comment) -> RawToken = RawToken {
    .line         = c.line - 1,
    .token_type   = .Comment,
    .start_offset = c.offset,
    .end_offset   = c.offset + c.text.byte_len(),
}

// `c.text` is the full source slice including the `///` prefix. Tokenise the
// vaderdoc tag the line opens, if any (`AST.doc_tag` : a tag counts at the start
// of a line only, the rule every reader of vaderdoc follows), and the parameter a
// `@param` names (`AST.doc_param_name`). The comment body itself is intentionally NOT covered by a base
// token : LSP semantic tokens forbid overlap, and a base-comment token spanning
// the whole line would either swallow the tag tokens (when the client favours
// the earlier token at each character) or break the spec contract. The `///`
// prefix and narrative therefore keep their TextMate coloring from
// `comment.line.documentation.vader` ; only the tag fragments receive
// semantic-token treatment.
collect_doc_line_tokens :: fn(c: Comment, out: RawToken[]) -> void {
    text :: c.text
    n :: text.byte_len()
    body :: text.byte_slice(3, n).left_trim()
    tag :: AST.doc_tag(body)
    if tag == "" {
        return
    }
    // Byte offsets into `text` ; `reencode_columns` later turns the absolute
    // offsets into columns in the negotiated encoding.
    at :: n - body.byte_len()
    tag_end :: at + tag.byte_len()
    out.push(doc_tag_token(c, at, tag_end, .Decorator))
    if tag != "@param" {
        return
    }
    rest :: text.byte_slice(tag_end, n).left_trim()
    name :: AST.doc_param_name(rest)
    if name.byte_len() > 0 {
        name_start :: n - rest.byte_len()
        out.push(doc_tag_token(c, name_start, name_start + name.byte_len(), .Parameter))
    }
}

// The token of a tag fragment, `start` to `end` bytes into the comment `c`.
doc_tag_token :: fn(c: Comment, start: i64, end: i64, kind: TokenType) -> RawToken = RawToken {
    .line         = c.line - 1,
    .token_type   = kind,
    .modifiers    = modifier_bit(.Documentation),
    .start_offset = c.offset + start,
    .end_offset   = c.offset + end,
}

// ---- sorting + delta encoding ---------------------------------------------

// `tokens` in the order `encode_delta` reads them: by line, then by column. Each
// producer emits in source order, one after the other. Stable: tokens at one
// position keep their order.
in_document_order :: fn(tokens: RawToken[]) -> RawToken[] =
    sort(tokens, (a, b) -> a.line < b.line || (a.line == b.line && a.column < b.column))

encode_delta :: fn(tokens: RawToken[]) -> JsonValue {
    out: JsonValue[]: []
    previous_line: i32 = 0
    previous_column: i32 = 0
    for r in tokens {
        delta_line :: r.line - previous_line
        delta_column := r.column
        if delta_line == 0 { delta_column = r.column - previous_column }
        out.push(JsonNumber { .value = f64(delta_line) })
        out.push(JsonNumber { .value = f64(delta_column) })
        out.push(JsonNumber { .value = f64(r.length) })
        out.push(JsonNumber { .value = f64(i32(r.token_type)) })
        out.push(JsonNumber { .value = f64(r.modifiers) })
        previous_line = r.line
        previous_column = r.column
    }
    return JsonArray { .items = out }
}

// ---- tests ----------------------------------------------------------------

import "std/iter"
import "std/testing"

// The tokens `handle_semantic_tokens_full` encodes, so tests can inspect classifications +
// overlaps. The colocated tests assert codepoint-equivalent columns, so index in
// utf-16 (BMP codepoint == 1 utf-16 unit).
build_sorted_for_test :: fn(source: string, uri: string) -> RawToken[] =
    document_tokens(build_index(uri, source, .Utf16))

// The first documentation-modifier token of `kind` on `line`, `null` if none.
// Test helper for doc-comment tag positioning.
doc_token :: fn(toks: RawToken[], line: i32, kind: TokenType) -> RawToken | null =
    toks.find(t -> t.line == line && t.token_type == kind && t.modifiers != 0)

// Count tokens that start inside the extent of an earlier token on the same
// line. The LSP semantic-tokens spec forbids overlap ; clients render it
// inconsistently, so this must stay zero.
count_token_overlaps :: fn(toks: RawToken[]) -> i32 {
    overlaps := 0
    cur_line: i32 = -1
    line_end: i32 = 0
    for t in toks {
        if t.line != cur_line {
            cur_line = t.line
            line_end = t.column + t.length
        } else {
            if t.column < line_end { overlaps = overlaps + 1 }
            end :: t.column + t.length
            if end > line_end { line_end = end }
        }
    }
    return overlaps
}

// Regression guard for the four shapes that used to emit a full-`span` token
// overlapping an inner type / argument token : a decorator with args, typed
// struct fields, typed fn params, and an intrinsic call.
@test
test_no_overlapping_tokens :: fn() -> void {
    src :: "module \"t\"\n\n@extern(\"now\")\nclock :: fn(a: i32, b: i32) -> i64\n\nPoint :: struct {\n    x: i32\n    y: i32\n}\n\nmain :: fn() -> void {\n    n :: @size_of(i32)\n    p :: Point { .x = 1, .y = 2 }\n}\n"
    toks :: build_sorted_for_test(src, "file:///t.vader")
    assert_eq(count_token_overlaps(toks), 0)
}

// Token lengths must be in codepoints (UTF-16 units), not bytes : a 2-byte `é`
// is one codepoint, so a token covering accented text must not run long and
// overlap its neighbour. `// café` is 7 codepoints / 8 bytes.
//
// Carried by a COMMENT since the string-literal token this used to assert on is
// no longer emitted (`classify_token` leaves literals to TextMate): the length
// path under test (`reencode_columns`) is shared by every producer.
@test
test_multibyte_token_length :: fn() -> void {
    toks :: build_sorted_for_test("// café\nx :: 1\n", "file:///t.vader")
    comment :: toks.find(t -> t.line == 0 && t.token_type == .Comment)
    assert(comment != null && comment.length == 7, "the comment on line 0 is 7 codepoints long")
}

// The literal-skipping policy itself : a string (with an escape) and a char
// literal must contribute NO token, or the client's TextMate colouring of the
// escape is overridden the moment the LSP loads. The interpolation delimiters
// and the expression inside them still get theirs.
@test
test_literals_emit_no_token :: fn() -> void {
    toks :: build_sorted_for_test("x :: \"a\\tb\"\ny :: 'c'\n", "file:///t.vader")
    assert(!toks.any_match(t -> t.token_type == .String), "no token may claim TokenType.String")
    // Sanity : the pass still runs and paints the non-literal parts.
    assert(toks.len() > 0, "the token pass still produces tokens")
}

// Doc-comment tags carry source columns, not within-comment byte offsets : an
// indented `/// @param x` (a trait-method doc) places `@param` at the comment's
// column + `/// ` (4 + 4 = 8) and `x` at 15.
@test
test_doc_tag_columns :: fn() -> void {
    indented :: build_sorted_for_test("M :: trait {\n    /// @param x ok.\n    f :: fn(x: i32) -> i32\n}\n", "file:///d.vader")
    tag :: doc_token(indented, 1, .Decorator)
    assert(tag != null && tag.column == 8, "`@param` at column 8")
    name :: doc_token(indented, 1, .Parameter)
    assert(name != null && name.column == 15, "`x` at column 15")
}

// A tag mentioned inside a sentence is prose : only a line it opens is a tag.
@test
test_doc_tag_inside_prose_is_not_a_tag :: fn() -> void {
    toks :: build_sorted_for_test("/// café @param y ok.\ng :: fn(y: i32) -> i32\n", "file:///d.vader")
    assert(doc_token(toks, 0, .Decorator) == null, "no tag inside prose")
}

// Is there a token of `kind` at exactly (`line`, `column`) spanning `length`?
token_at :: fn(toks: RawToken[], line: i32, column: i32, length: i32, kind: TokenType) -> bool =
    toks.any_match(t -> t.line == line && t.column == column
        && t.length == length && t.token_type == kind)

// Call sites must carry `Function`, through BOTH callee shapes: a method call
// (`out.push(…)`, tagged on the field span) and a bare free-fn call
// (`mk_primitive(…)`). Asserted on the full pipeline, so a later pass
// overwriting the tag with `Variable` would fail here.
//
// This is the server half of the "call-site names lose their colour under the
// LSP" report: the tag IS emitted, so a client rendering them in the default
// foreground is missing a semantic-token → attributes mapping.
@test
test_call_sites_are_tagged_function :: fn() -> void {
    src :: "main :: fn() -> void {\n    out.push(1)\n    mk_primitive(\"i64\")\n}\n"
    toks :: build_sorted_for_test(src, "file:///c.vader")
    assert(token_at(toks, 1, 8, 4, .Function), "`push` tagged Function")
    assert(token_at(toks, 2, 4, 12, .Function), "`mk_primitive` tagged Function")
}

// A `match` header's binding is a local like any other : its name is tagged where
// it is declared (`match x ::`) as well as where it is read.
@test
test_match_binding_names_are_tagged :: fn() -> void {
    src :: "f :: fn(v: i32 | string) -> i32 = match n :: v {\n    is i32    -> n\n    is string -> 0\n}\n"
    toks :: build_sorted_for_test(src, "file:///a.vader")
    assert(token_at(toks, 0, 40, 1, .Variable), "`n` of `match n :: v` tagged Variable")
    assert(token_at(toks, 1, 17, 1, .Variable), "`n` read in an arm tagged Variable")
}

// The token starting at (`line`, `column`), `null` if there is none.
token_starting_at :: fn(toks: RawToken[], line: i32, column: i32) -> RawToken | null =
    toks.find(t -> t.line == line && t.column == column)

// Struct fields carry `Property`, not the `Variable` catch-all: in all three
// positions they appear in. Clients colour `Variable` as a *reassignable local*
// (LSP4IJ underlines it), which is wrong twice over for a field.
@test
test_struct_fields_are_property :: fn() -> void {
    src :: "Opts :: struct { release: bool }\n\nread :: fn(o: Opts) -> bool = o.release\n"
    toks :: build_sorted_for_test(src, "file:///f.vader")
    assert(token_at(toks, 0, 17, 7, .Property), "field declaration is Property")
    assert(token_at(toks, 2, 32, 7, .Property), "`o.release` read is Property")
    lit :: build_sorted_for_test("Opts :: struct { release: bool }\n\nmk :: fn() -> Opts = Opts { .release = true }\n", "file:///g.vader")
    assert(token_at(lit, 2, 29, 7, .Property), "`.release = …` in a struct literal is Property")
}

// A module const is `static` + `readonly`, which is what makes a client resolve it
// to its constant colour instead of painting `SCREAMING_SNAKE` as a mutable local.
@test
test_module_const_carries_static_readonly :: fn() -> void {
    toks :: build_sorted_for_test("MAX :: 42\n\nget :: fn() -> i32 = MAX\n", "file:///c.vader")
    expected :: modifier_bit(.Static) | modifier_bit(.Readonly)
    read :: token_starting_at(toks, 2, 21)
    assert(read != null && read.modifiers == expected, "`MAX` read is static + readonly")
}

@test
test_yield_const_classified_as_keyword :: fn() -> void {
    // Regression: `yield` / `const` were the two keywords the old if-cascade
    // forgot, leaving them uncoloured. The exhaustive `match` now covers them.
    sp :: empty_file_span("t.vader")
    yield_type :: classify_token(make_token(.KwYield, "yield", sp))
    assert(yield_type == TokenType.Keyword, "`yield` is a keyword")
    const_type :: classify_token(make_token(.KwConst, "const", sp))
    assert(const_type == TokenType.Keyword, "`const` is a keyword")
}

// The semantic type of the token starting at byte `offset`, or `null` if none.
token_type_at :: fn(toks: RawToken[], offset: i64) -> TokenType | null {
    token :: toks.find(t -> t.start_offset == offset) ?? return null
    return token.token_type
}

@test
test_bang_is_in_paint_as_keyword :: fn() -> void {
    // `!is` / `!in` : the leading `!` paints as a keyword (not an operator) so
    // the negated operator colours as one unit: mirrors the TextMate grammar.
    assert(lexer_kind_at("x !is y\n", 2) == TokenType.Keyword, "the `!` of `!is` is a keyword")
    assert(lexer_kind_at("x !in y\n", 2) == TokenType.Keyword, "the `!` of `!in` is a keyword")
    // A bare `!` (logical not) still classifies as an operator.
    assert(lexer_kind_at("!x\n", 0) == TokenType.Operator, "a bare `!` is an operator")
}

// The type the lexer-driven pass gives the token at `offset` of `src`.
lexer_kind_at :: fn(src: string, offset: i64) -> TokenType | null {
    out: RawToken[]: []
    collect_token_kinds(tokenize(src, "t.vader").tokens, out)
    return token_type_at(out, offset)
}

@test
test_resolver_refines_param_use :: fn() -> void {
    // The `x` in `return x` is a parameter USE ; only the resolver-refinement
    // pass can paint it Parameter (Phase-1 can't tell a param-use from a local).
    // Guards the refine↔reencode ordering: `refine_via_resolver` probes the
    // resolver map by a codepoint column derived from the token's byte offset,
    // NOT the RawToken.column (which is 0 until the later reencode pass). Both `x`
    // occurrences (the param decl and its use) must end up Parameter.
    toks :: build_sorted_for_test("add :: fn(x: i32) -> i32 {\n    return x + 1\n}\n", "file:///r.vader")
    assert_eq(toks.filter(t -> t.token_type == .Parameter).count(), 2)
}


