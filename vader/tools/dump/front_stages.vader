// vader/tools/dump/front_stages: the dump stages of the front end.
//
// Tokens, syntax tree, resolved symbols, types, call sites, effects, evaluated
// constants, and the bodies the `@target` selection kept. Each renders its
// stage and its diagnostics to a `StageOutput` (`dump.vader`).

module "vader/tools/dump"

import "std/collections"
import "std/env"
import "std/path"
import "std/sort"
import "std/string"
import "std/string_builder"
import "toolchain/ast"
import "vader/core/types"
import "vader/front/comptime"
import "vader/front/effects"
import "vader/front/lexer"
import "vader/front/parser"
import "vader/front/resolver"
import "vader/front/typecheck"
import "vader/pipeline"
import "vader/pipeline/check"
import "vader/support/diagnostics"
import "vader/support/target"
import "vader/support/text"

// The tokens, then the lexer's diagnostics.
lexer_stage :: fn(input: DumpInput) -> StageOutput {
    source :: read_source(input)
    if source is StageOutput {
        return source
    }
    lexed :: tokenize(source, input.file.as_string())
    return with_diags("${lexed.dump_tokens()}\n", lexed.errors)
}

// `# AST` and the syntax tree as indented JSON, then the parser's diagnostics.
parser_stage :: fn(input: DumpInput) -> StageOutput {
    source :: read_source(input)
    if source is StageOutput {
        return source
    }
    parsed :: parse_source(source, input.file.as_string())
    return with_diags("${dump_program(parsed.program)}\n", parsed.errors)
}

// The symbols of each module in scope, then the diagnostics of the loader and
// of the resolver.
resolver_stage :: fn(input: DumpInput) -> StageOutput {
    project :: input.loaded_project()
    resolved :: resolve_loaded_project(project, dump_scope(input.modules, project))
    return with_diags("${dump_project(resolved)}\n", project.diags + resolver_diags(resolved))
}

// The modules of `input`, loaded but not checked.
loaded_project :: fn(input: DumpInput) -> LoadedProject = load_project(
    input.file.as_string(),
    input.include_paths,
    input.project_root,
    input.target,
)

// Resolve every loaded module. The modules out of `scope` stay loaded for the
// imports that reach them, but are not resolved here.
resolve_loaded_project :: fn(project: LoadedProject, scope: string[]) -> ResolvedProject {
    core_seed :: build_core_seed(project)
    mod_index :: module_index_by_name(project)
    materialize_impl_members(project, mod_index, core_seed)
    modules: ResolvedModule[]: []
    resolved_by_id :: Map<string, ResolvedModule> {}
    for [id, lm] in project.modules {
        if !module_in_scope(lm.module.display_path, scope) {
            continue
        }
        rm :: resolve_module_files(
            lm.module.files,
            lm.module.files[0].path,
            lm.module.display_path,
            project.factory,
            lm.collected,
            mod_index,
            core_seed,
        )
        modules.push(rm)
        resolved_by_id[id] = rm
    }
    wire_targets :: wire_imports(project)
    // The orphan rule reads the import bindings `wire_imports` redirects to the
    // module that owns each target, so it runs after it.
    for [id, lm] in project.modules {
        rm :: resolved_by_id[id] else continue
        run_orphan_rule_check_for_module(lm, id, rm.idents, wire_targets, rm.diags)
    }
    return ResolvedProject { .modules = modules }
}

// The diagnostics of the body walks, module by module.
resolver_diags :: fn(resolved: ResolvedProject) -> Diagnostic[] {
    all: Diagnostic[]: []
    for m in resolved.modules {
        all.push_all(m.diags)
    }
    return all
}

// The type of each declaration and typed expression of the modules in scope,
// then the diagnostics.
typecheck_stage :: fn(input: DumpInput) -> StageOutput {
    fc :: input.checked(true)
    typed :: dump_program_with_others(
        fc.result.typed,
        true,
        fc.result.others,
        entry_scope(input, fc),
    )
    return with_diags("${typed}\n", fc.diags)
}

// The callee of each call site of the modules in scope, then the diagnostics.
callees_stage :: fn(input: DumpInput) -> StageOutput {
    // `dump_types` records the span of each site, the position the dump prints.
    fc :: input.checked(true)
    sites :: dump_call_sites_project(fc.result.typed, fc.result.others, entry_scope(input, fc))
    return with_diags(sites, fc.diags)
}

// The effect summary of each function of the modules in scope, then the
// diagnostics.
effects_stage :: fn(input: DumpInput) -> StageOutput {
    fc :: input.checked(false)
    return with_diags(dump_effects(fc.effects, entry_scope(input, fc)), fc.diags)
}

// The load and typecheck of `input`, with the side tables of the typed dumps
// when `dump_types`. It is the check the LSP runs too, so the editor and these
// dumps agree.
checked :: fn(input: DumpInput, dump_types: bool) -> FileCheck = check_file(
    input.file.as_string(),
    Map<string, string> {},
    input.include_paths,
    input.project_root,
    dump_types,
    input.target,
)

// The scope of a dump of `fc`: the `--module` list of `input`, else the entry's
// subtree.
entry_scope :: fn(input: DumpInput, fc: FileCheck) -> string[] =
    scope_or_entry(input.modules, fc.result.typed.resolved.display_path)

// The evaluated constants of the modules in scope, as Markdown, then the
// diagnostics as a Markdown section.
comptime_stage :: fn(input: DumpInput) -> StageOutput {
    pipeline :: input.evaluated_pipeline()
    scope :: input.scope_of()
    evaluated :: "${dump_evaluated(pipeline.evaluated, scope)}\n"
    diags :: pipeline_diags_in_scope(pipeline, [], scope)
    if diags.len() == 0 {
        return StageOutput { .out = evaluated }
    }
    return StageOutput { .out = "${evaluated}${diags.markdown_diagnostics()}\n" }
}

// ---- targets ----------------------------------------------------------------

// The constants the compiler baked for the target, then which body each
// `@target` group selected, one line per group.
//
// It needs no toolchain, so it answers for every target from any machine: the
// cross-target corpus reads it rather than the emitted C, where both branches of
// an `if VADER_OS == ...` survive.
targets_stage :: fn(input: DumpInput) -> StageOutput {
    project :: input.loaded_project()
    out :: StringBuilder {}
    // Read back from the module the compiler generated, not rendered from
    // `input.target`: a build that bakes the host's OS for another target must
    // show here.
    out.append("# Baked\n")
    baked :: project.modules[BAKED_FOLDER]
    if baked is LoadedModule {
        for f in baked.module.files {
            for d in f.program.decls {
                if d is ConstDecl {
                    out.append("${d.name} = ${render_baked_value(d.value)}\n")
                }
            }
        }
    } else {
        out.append("(none)\n")
    }
    out.append("\n# Selected body\n")
    cwd :: current_working_directory()
    lines: string[]: []
    for [_, lm] in project.modules {
        for f in lm.module.files {
            for d in f.program.decls {
                if d is FnDecl && selected_by_target(d) {
                    group :: "${mangle_module_id(lm.module.display_path)}\$${d.name}"
                    lines.push("${group} <- ${body_origin(d, cwd)}")
                }
            }
        }
    }
    for line in sort(lines, (a: string, b: string) -> compare_ascending(a, b)) {
        out.append("${line}\n")
    }
    if lines.len() == 0 {
        out.append("(none)\n")
    }
    return StageOutput { .out = out.to_string() }
}

// Where the body of `fd` starts, relative to `cwd` like every diagnostic: a
// stdlib body resolves through an absolute path, which a committed snapshot must
// not hold.
body_origin :: fn(fd: FnDecl, cwd: string) -> string {
    body :: fd.body
    if body is BlockExpr {
        return "${relative_to(body.span.start.file, cwd)}:${body.span.start.line}"
    }
    return "(no body)"
}

// The baked constants are `.Darwin` / `.Arm64` by construction: a bare variant
// against the ascribed slot, and nothing else. Any other shape means the
// generator changed, and printing `(unexpected)` says so rather than rendering
// something plausible. Reading the qualified form too would blunt exactly that:
// a generator going back to `Os.Darwin` would render as if nothing had moved.
render_baked_value :: fn(e: Expr) -> string {
    if e is DotVariantExpr {
        return ".${e.variant}"
    }
    return "(unexpected)"
}

// A group member survives selection with its `@target` decorator stripped only
// when it was merged; a lone bare declaration keeps it. Either way, what marks a
// declaration as belonging to a group is that it once carried `@target`, which
// after merging is only visible on the ones that did NOT merge. So report on the
// declarations the selection produced, not on the decorator.
selected_by_target :: fn(fd: FnDecl) = decorators_have(fd.decorators, "target")
