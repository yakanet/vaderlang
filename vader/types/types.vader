// vader/types/types — the Type IR.
//
// Every Vader value gets exactly one
// Type. The discriminated union has 18 variants ; constructors are
// plain factories (no hash-consing for MVP — `equals_type` in
// `type_ops.vader` walks structurally instead of relying on reference
// identity). Interning lands when a downstream hot path needs it.

module "vader/types"

import "std/collections"
import "std/string_builder"
import "vader/resolver/symbol"

// ---- variants -------------------------------------------------------------

export PrimitiveType :: struct {
    name: string
}

export StructType :: struct {
    symbol: Symbol
    args:   Type[]
    /// When true, mutation through this slot is rejected at typecheck — same
    /// role as `ArrayType.immutable`, and like it the bit stops at the bytecode
    /// boundary (`type_intern_key` / `bc_type_of` / `val_type_of_type` ignore
    /// it, so an immutable struct has the layout of a mutable one).
    immutable: bool
}

export EnumType :: struct {
    symbol:        Symbol
    /// Backing integer type : written in the header, else inferred.
    repr:          string
    /// What a variant stores, keyed by name : its written value, or for an enum
    /// with variant data its rank (0, 1, 2… in declaration order).
    indices:       MutableMap<string, i64>
    /// The struct each variant carries a constant value of, from the header ;
    /// null for an enum without variant data.
    data:          StructType | null = null
    /// Written value per rank, for an enum with variant data ; empty for any
    /// other enum, whose stored integer IS the value.
    values:        i64[] = []
    /// The width the header writes, or null when it leaves it out: `repr` for
    /// an enum without variant data, the width of the written values for one
    /// with variant data, whose rank is stored at an inferred width.
    written_width: string | null = null
}

/// Distinct (newtype) over a primitive — nominal at typecheck, but its
/// backend representation IS the backing primitive (zero-cost, register
/// scalar, no box). Declared as `Name :: <primitive>` ; constructed via
/// `Name(v)` (wrap) and unwrapped via `Backing(d)` — both no-op at runtime.
/// Operators and methods are opaque : only impls on the distinct type
/// apply, nothing is inherited from the backing (`Instant + Instant` is a
/// type error unless an `Add` impl exists). Modeled on `EnumType` — it rides
/// its backing's `ValType` — not on `StructType` (which is a boxed `Ref`).
export DistinctType :: struct {
    symbol:  Symbol
    /// The underlying type the value is represented as. A primitive
    /// (`Meters :: i64`) or a composite — array (`BigInt :: u32[]`),
    /// struct, or tuple alias. Classifiers must recurse into it
    /// (`val_type_of_type`, `array_backing`, `struct_backing`, …)
    /// rather than assume a primitive.
    backing: Type
}

export TraitType :: struct {
    symbol:    Symbol
    args:      Type[]
    /// Same role as `StructType.immutable` : a read-only trait value refuses its
    /// `self!` members. Ignored by type identity and by the bytecode. No default, so
    /// a rebuild that forgets it does not compile — copy it with `...t`.
    immutable: bool
}

export UnionType :: struct {
    /// Canonical : sorted by `display_type` output, deduped.
    variants: Type[]
}

export FnType :: struct {
    params:      Type[]
    /// Per-parameter `!` mutation marker (`fn(u8[]!) -> void`). A parallel vector
    /// rather than a bit inside each param `Type`, so the notion stays confined to
    /// this one IR node — `StructType` / `TupleType` / … and the whole
    /// substitute / unify / erase machinery keep ignoring it.
    ///
    /// Empty means no parameter is marked ; it is never a same-length all-`false`
    /// vector. Every constructor that rebuilds an `FnType` from another must carry
    /// it over (`mk_fn_like`) or the marker is silently lost.
    params_mutable: bool[] = []
    return_type: Type
}

export ArrayType :: struct {
    element:   Type
    /// When true, mutation through this slot is rejected at typecheck.
    immutable: bool
}

export TupleType :: struct {
    /// Heterogeneous fixed-arity sequence (≥ 2 elements).
    elements:  Type[]
    /// When true, mutation through this slot is rejected at typecheck. See
    /// `StructType.immutable`.
    immutable: bool
}

export TypeParamType :: struct {
    symbol: Symbol
    /// Set on a read-only view of `T` : an unmarked `Self` reached through `T`
    /// (`-> Self`, `fn(Self)`). A written `T` never carries it.
    immutable: bool = false
}

export TypeMetaType :: struct {}
export SelfType :: struct {}
export UnresolvedType :: struct {}

/// Erased "any" reference — synthesised by the erasure-dedupe pass
/// for fields of monomorphized generic structs so identical concrete
/// monos (e.g. `Pair__string__i64` vs `Pair__i32__bool`) can share a
/// single C-emit shape. Surface name `Any`. Maps to `ValType.Any` at
/// the bytecode level (same wide-ref representation as Ref).
export AnyType :: struct {}
/// Untyped int literal — flexible until placed in a typed context.
export FreeIntType :: struct {}
/// Untyped float literal — flexible until placed in a typed context.
export FreeFloatType :: struct {}
/// Untyped char LITERAL — flexible until placed in a typed context. A char
/// literal carries a compile-time codepoint, so it coerces to an integer type
/// (with a bounds check) the same way a free int does ; absent any numeric
/// context it defaults to `char`. Note: only LITERALS get this type — a `char`
/// variable stays the concrete `char` and never auto-coerces to an integer.
export FreeCharType :: struct {}
/// Bottom type for `return` / `panic` etc. — assignable to anything.
export NeverType :: struct {}

/// The Type IR — discriminated union over every kind of Vader value.
export Type ::
    | PrimitiveType
    | StructType
    | EnumType
    | TraitType
    | UnionType
    | FnType
    | ArrayType
    | TupleType
    | TypeParamType
    | TypeMetaType
    | SelfType
    | UnresolvedType
    | FreeIntType
    | FreeFloatType
    | FreeCharType
    | NeverType
    | AnyType
    | DistinctType

// ---- name registries ------------------------------------------------------

/// Target-ABI metadata for one primitive — the single source of truth every
/// pass consults instead of re-listing names. Row order is load-bearing:
/// `resolver/builtins` mints builtin symbol IDs in this order (embedded in
/// snapshots), so new primitives append at the end. Consumer-owned mappings
/// (bytecode `ValType`, typecheck `ReprRange`, lower `WriterKind`, c-emit C
/// spellings) map a row onto their own enum rather than living here, so
/// `vader/types` stays a near-leaf. `is_signed` / `is_float` are only meaningful
/// with `is_int` / respectively; `size` is bytes (align == size on the 64-bit
/// target).
export PrimitiveMeta :: struct {
    name:      string
    size:      i64
    is_int:    bool
    is_signed: bool
    is_float:  bool
    /// The value is a handle the runtime follows, not storage the slot owns.
    /// `string` is an interned atom the collector tracks ; `CPointer` addresses
    /// memory the Vader side does not own. A pass deciding whether a value can
    /// be copied into registers, embedded in a flat layout, or taken the address
    /// of has to ask this — the size alone says `CPointer` is eight bytes like a
    /// `u64`, and that is the wrong answer.
    is_reference: bool = false
}

export PRIMITIVE_META: PrimitiveMeta[]: [
    PrimitiveMeta { .name = "i8",     .size = 1,  .is_int = true,  .is_signed = true,  .is_float = false },
    PrimitiveMeta { .name = "i16",    .size = 2,  .is_int = true,  .is_signed = true,  .is_float = false },
    PrimitiveMeta { .name = "i32",    .size = 4,  .is_int = true,  .is_signed = true,  .is_float = false },
    PrimitiveMeta { .name = "i64",    .size = 8,  .is_int = true,  .is_signed = true,  .is_float = false },
    PrimitiveMeta { .name = "isize",  .size = 8,  .is_int = true,  .is_signed = true,  .is_float = false },
    PrimitiveMeta { .name = "u8",     .size = 1,  .is_int = true,  .is_signed = false, .is_float = false },
    PrimitiveMeta { .name = "u16",    .size = 2,  .is_int = true,  .is_signed = false, .is_float = false },
    PrimitiveMeta { .name = "u32",    .size = 4,  .is_int = true,  .is_signed = false, .is_float = false },
    PrimitiveMeta { .name = "u64",    .size = 8,  .is_int = true,  .is_signed = false, .is_float = false },
    PrimitiveMeta { .name = "usize",  .size = 8,  .is_int = true,  .is_signed = false, .is_float = false },
    PrimitiveMeta { .name = "f32",    .size = 4,  .is_int = false, .is_signed = false, .is_float = true  },
    PrimitiveMeta { .name = "f64",    .size = 8,  .is_int = false, .is_signed = false, .is_float = true  },
    PrimitiveMeta { .name = "bool",   .size = 1,  .is_int = false, .is_signed = false, .is_float = false },
    PrimitiveMeta { .name = "char",   .size = 4,  .is_int = false, .is_signed = false, .is_float = false },
    PrimitiveMeta { .name = "string", .size = 4,  .is_int = false, .is_signed = false, .is_float = false, .is_reference = true },
    PrimitiveMeta { .name = "void",   .size = 0,  .is_int = false, .is_signed = false, .is_float = false },
    PrimitiveMeta { .name = "null",   .size = 0,  .is_int = false, .is_signed = false, .is_float = false },
    PrimitiveMeta { .name = "CPointer", .size = 8, .is_int = false, .is_signed = false, .is_float = false, .is_reference = true },
]

/// The `PrimitiveMeta` row for `name`, or null when `name` is not a primitive.
export primitive_meta :: fn(name: string) -> PrimitiveMeta | null {
    for m in PRIMITIVE_META {
        if m.name == name { return m }
    }
    return null
}

export is_primitive_name :: fn(name: string) -> bool = primitive_meta(name) != null

/// Whether `name` is a primitive the runtime reaches through a handle.
///
/// False for anything that is not a primitive at all — the question only has a
/// meaning for a row of the table.
export is_reference_name :: fn(name: string) -> bool {
    m :: primitive_meta(name)
    return m != null && m.is_reference
}

export is_int_name :: fn(name: string) -> bool {
    m :: primitive_meta(name)
    return m != null && m.is_int
}

/// Whether a range whose lower bound has type `t` counts in place: a primitive
/// integer, or a free integer or `char` literal. A `for` over such a range written
/// in place walks a counter instead of stepping a `Range`.
///
/// @param t  the lower bound's type.
export is_counting_type :: fn(t: Type) -> bool = match t {
    is PrimitiveType -> is_int_name(t.name)
    is FreeIntType | FreeCharType -> true
    is FreeFloatType | StructType | EnumType | DistinctType | ArrayType | TupleType -> false
    is UnionType | FnType | TraitType | TypeParamType | SelfType | AnyType -> false
    is NeverType | UnresolvedType | TypeMetaType -> false
}

export is_signed_int_name :: fn(name: string) -> bool {
    m :: primitive_meta(name)
    return m != null && m.is_int && m.is_signed
}

export is_unsigned_int_name :: fn(name: string) -> bool {
    m :: primitive_meta(name)
    return m != null && m.is_int && !m.is_signed
}

export is_float_name :: fn(name: string) -> bool {
    m :: primitive_meta(name)
    return m != null && m.is_float
}

export is_numeric_name :: fn(name: string) -> bool {
    m :: primitive_meta(name)
    return m != null && (m.is_int || m.is_float)
}

/// Size in bytes of a primitive (0 for `void` / `null` / non-primitive).
export primitive_size :: fn(name: string) -> i64 {
    m :: primitive_meta(name) ?? return 0
    return m.size
}

/// Alignment in bytes — equal to size on the 64-bit target.
export primitive_align :: fn(name: string) -> i64 = primitive_size(name)

/// Width in bytes of the SLOT that carries a `t` — a struct field, a local, a
/// parameter. Not the size of the object a reference points at.
///
/// This is what `@size_of` reports, and the operational truth is
/// `bytecode::val_type_of_type` composed with `c_emit::c_type_for_val_bare`:
/// those two decide the C declaration, and any disagreement with this function
/// is a bug here. It lives in `vader/types` because `vader/comptime` folds
/// `@size_of` and cannot reach `vader/bytecode` without inverting an import
/// edge; the colocated tests below pin one case per class against the emitted C.
///
/// A concrete reference is EIGHT bytes, not sixteen: since T12 a struct, array,
/// tuple or fn value rides as a bare `void*` and recovers its tag from the
/// object header. Only an ERASED slot — a trait object, a union, `any` — still
/// carries a `vader_box_t`, whose tag it needs because no single object header
/// answers for every variant it may hold.
///
/// @return  0 for the comptime-only and unsized kinds — they name no storage.
export slot_byte_size :: fn(t: Type) -> i64 = match t {
    is PrimitiveType -> primitive_size(t.name)
    // An enum rides its `repr`, so `enum(u8)` is one byte and the i32 default
    // four. Reporting a uniform 16 was the difference between a packed array of
    // enums and one that is four times denser.
    is EnumType     -> primitive_size(t.repr)
    is DistinctType -> slot_byte_size(t.backing)
    is StructType | ArrayType | TupleType | FnType   -> REF_SLOT_BYTES
    is TraitType | UnionType | AnyType               -> BOX_SLOT_BYTES
    is TypeMetaType | TypeParamType | SelfType | UnresolvedType
     | FreeIntType | FreeFloatType | FreeCharType | NeverType -> 0
}

/// Alignment in bytes of that slot.
///
/// Every scalar aligns to its own width on the 64-bit target ; a `vader_box_t`
/// is 16 bytes wide but its widest member is a word, so it aligns to 8.
export slot_byte_align :: fn(t: Type) -> i64 {
    size :: slot_byte_size(t)
    if size > WORD_BYTES {
        return WORD_BYTES
    }
    return size
}

/// A concrete heap reference — `void*` since T12.
export REF_SLOT_BYTES: i64: 8

/// An erased slot — `vader_box_t`, a tag plus a word of payload.
export BOX_SLOT_BYTES: i64: 16

/// Pointer width on the 64-bit target.
export WORD_BYTES: i64: 8

/// Friendly type-name aliases that collapse to a canonical primitive
/// (`int → i32`, …). Consumed by the resolver's builtin scope and typecheck's
/// `primitive_from_name`. `[alias, canonical]` rows.
export PRIMITIVE_ALIASES: string[][]: [
    ["int", "i32"], ["long", "i64"], ["float", "f32"], ["double", "f64"], ["byte", "u8"],
]

/// Canonical primitive name for `name` if it is a friendly alias, else `name`
/// unchanged.
export resolve_primitive_alias :: fn(name: string) -> string {
    for a in PRIMITIVE_ALIASES {
        if a[0] == name { return a[1] }
    }
    return name
}

/// Names of stdlib core traits used for compiler-driven dispatch. Kept as
/// plain string constants so cross-module symbol lookup goes through
/// resolved imports rather than a privileged registry.
export TRAIT_DISPLAY    :: @type_name(Display)
export TRAIT_ERROR      :: @type_name(Error)
export TRAIT_EQUALS     :: @type_name(Equals)
export TRAIT_COMPARABLE :: @type_name(Comparable)
export TRAIT_ADD        :: @type_name(Add)
export TRAIT_SUB        :: @type_name(Sub)
export TRAIT_MUL        :: @type_name(Mul)
export TRAIT_DIV        :: @type_name(Div)
export TRAIT_REM        :: @type_name(Rem)
export TRAIT_HASH       :: @type_name(Hash)
export TRAIT_CLONE      :: @type_name(Clone)
export TRAIT_STEP       :: @type_name(Step)
export TRAIT_INTO       :: @type_name(Into)
export TRAIT_ITERATOR   :: @type_name(Iterator)
export TRAIT_ASYNC      :: @type_name(Async)
export TRAIT_CONTAINS   :: @type_name(Contains)
export TRAIT_INDEX      :: @type_name(Index)
export TRAIT_INDEX_SET  :: @type_name(IndexSet)

/// `impl_base_key` of a nominal declaration — the symbol ids are unique across
/// every kind, so the id alone names it.
///
/// @param sym  the declaration's symbol — not an import binding.
export declaration_key :: fn(sym: Symbol) -> string = "#${sym.id}"

/// Mangle a module display path into a name-fragment usable in a mangled
/// symbol: `/` and `.` both become `_`, every other byte passes through.
/// Centralised here so the lowerer's name-mangling sites, the trait keys and the
/// CLI's entry-point name share one scheme and can't drift — a mismatch would
/// desync the VM's `export main <index>` directive from the emitted fn name.
///
/// @param module_id  the module display path (e.g. `"std/string"`).
/// @return           the mangled fragment (e.g. `"std_string"`).
export mangle_module_id :: fn(module_id: string) -> string {
    out: u8[]: [] * module_id.byte_len()
    for i in 0..<module_id.byte_len() {
        b :: module_id.byte_at(i)
        if b == '/' || b == '.' {
            out.push('_')
        } else {
            out.push(b)
        }
    }
    return out.bytes_to_string()
}

/// A trait's identity across modules, named the way the bytecode names a struct
/// or a fn : its declaring module's mangled name, then its own —
/// `"std_core$Display"`, `"a$Animal"`. Two traits with the same name in
/// different modules get different keys. It keys the trait side of the impl
/// tables, and the trait half of a vtable key (`"std_core$Display.to_string"`).
///
/// @param trait_sym  the trait's declaration symbol — not an import binding.
export trait_key_of :: fn(trait_sym: Symbol) -> string =
    "${mangle_module_id(trait_sym.module_name)}\$${trait_sym.name}"

/// The `trait_key` of a `std/core` trait, from its `TRAIT_*` name.
///
/// @param name  a `TRAIT_*` constant.
export core_trait_key :: fn(name: string) -> string = "std_core\$${name}"

/// Whether `t` implements `trait_key` with no impl : every enum implements
/// `Equals`, comparing by variant, and `Hash`, so it keys a `MutableMap`. A boxed
/// enum carries its integer, whose `Equals` and `Hash` a vtable reaches. No impl is
/// registered, so the run-time `is Trait` test does not see these.
///
/// @param t          the implementing type.
/// @param trait_key  the trait asked for.
export has_builtin_impl :: fn(t: Type, trait_key: string) -> bool =
    t is EnumType &&
        (trait_key == core_trait_key(TRAIT_EQUALS) || trait_key == core_trait_key(TRAIT_HASH))

/// The trait name inside a `trait_key` — what a message shows the user.
///
/// @param key  a `trait_key`.
export trait_key_name :: fn(key: string) -> string {
    start := key.byte_len()
    for start > 0 && key.byte_at(start - 1) != '$' {
        start -= 1
    }
    return key.byte_slice(start, key.byte_len())
}

/// Names of stdlib core structs the compiler refers to by symbol.
export STRUCT_RANGE          :: @type_name(Range)

/// `std/core::Continuation` and its variants — what an `Iterator.next` pairs its
/// element with. The lowerer builds the comparison, so the spellings live beside
/// the type.
export ENUM_CONTINUATION     :: @type_name(Continuation)
export CONTINUATION_STOP     :: "Stop"
export CONTINUATION_CONTINUE :: "Continue"
export STRUCT_SUSPENDED      :: @type_name(Suspended)
export STRUCT_FIELD          :: @type_name(Field)

/// Method names the compiler dispatches by, paired with the `TRAIT_*` above
/// (`Add::add`, `Comparable::compare`, `Iterator::next`, …). Same rationale as
/// the trait names: one source so a rename touches one line.
export METHOD_ADD       :: "add"
export METHOD_SUB       :: "sub"
export METHOD_MUL       :: "mul"
export METHOD_DIV       :: "div"
export METHOD_REM       :: "rem"
export METHOD_EQUALS    :: "equals"
export METHOD_COMPARE   :: "compare"
export METHOD_CONTAINS  :: "contains"
export METHOD_INTO      :: "into"
export METHOD_NEXT      :: "next"
export METHOD_RESUME    :: "resume"
export METHOD_CANCEL    :: "cancel"
export METHOD_TO_STRING :: "to_string"
export METHOD_AT        :: "at"
export METHOD_SET_AT    :: "set_at"

// ---- constructors ---------------------------------------------------------

export mk_primitive :: fn(name: string) -> Type = PrimitiveType { .name = name }

/// A nominal struct type. `immutable` is a REQUIRED parameter, deliberately —
/// the same discipline `mk_array` enforces. A field default would let a rebuild
/// site (substitution, `Self` resolution, distinct-stripping) drop the bit in
/// silence, which is exactly how the previous chantier lost `FnParam.mutable`
/// through AST cloning. Deriving from an existing struct ⇒ pass `s.immutable` ;
/// minting a fresh one ⇒ `false` (a value is mutable unless a slot says otherwise).
export mk_struct :: fn(symbol: Symbol, args: Type[], immutable: bool) -> Type =
    StructType { .symbol = symbol, .args = args, .immutable = immutable }

/// A fresh trait type ; a rebuild from an existing one spreads it (`...t`) instead,
/// which keeps its read-only bit.
///
/// @param immutable  the bit — `false` for the raw type a written slot then defaults.
export mk_trait :: fn(symbol: Symbol, args: Type[], immutable: bool) -> Type = TraitType {
    .symbol = symbol,
    .args = args,
    .immutable = immutable,
}

/// Distinct (newtype) over `backing` — see `DistinctType`. `backing` is a
/// primitive, an array, a struct or a tuple (`distinct_backing` decides), and
/// holds the distinct's read-only bit.
export mk_distinct :: fn(symbol: Symbol, backing: Type) -> Type = DistinctType { .symbol = symbol, .backing = backing }

export mk_array :: fn(element: Type, immutable: bool) -> Type = ArrayType { .element = element, .immutable = immutable }

/// Rebuild an `FnType` from `src`, carrying its `params_mutable` vector over.
///
/// Use this — not `mk_fn` — whenever the result derives from an existing fn type
/// (substitution, `Self` resolution, distinct-stripping). `mk_fn` yields an
/// unmarked vector, so reaching for it on a derived type drops the `!` markers
/// silently, which is exactly how a marked callback would slip past the
/// contravariance check.
///
/// A parameter `src` wrote as a type parameter, bare or as a union variant, lends
/// what it is now bound to : `fn(T)` with `T` bound to `Cfg!` mutates its argument,
/// and is marked so, as is `fn(T | null)`.
///
/// @param src     the fn type the result derives from.
/// @param params  the rewritten parameter types — must keep `src`'s arity and order.
/// @param ret     the rewritten return type.
export mk_fn_like :: fn(src: FnType, params: Type[], ret: Type) -> FnType {
    if !relays_any(src, params) {
        return FnType { .params = params, .params_mutable = src.params_mutable, .return_type = ret }
    }
    marks: bool[]: []
    for i in 0..<params.len() {
        marks.push(param_mutable_at(src, i) || relays_at(src, params, i))
    }
    return FnType { .params = params, .params_mutable = marks, .return_type = ret }
}

/// Whether parameter `i` of `f` carries the `!` mutation marker. Reads through the
/// parallel vector's "empty means none marked" convention, so an unmarked fn type
/// answers false without allocating a same-length all-`false` run.
///
/// @param f  the fn type.
/// @param i  the parameter's index.
export param_mutable_at :: fn(f: FnType, i: usize) -> bool {
    if i >= f.params_mutable.len() {
        return false
    }
    return f.params_mutable[i]
}

// Parameter `i`, written with a type parameter at its top level — bare, or as a
// variant (`T | null`) — now bound, in full, to a type of which some variant grants
// mutation : marked as `x: Cfg! | Other` would be.
relays_at :: fn(src: FnType, params: Type[], i: usize) -> bool =
    type_param_at_top(src.params[i]) && !type_param_at_top(params[i]) &&
        type_may_grant_mutation(params[i])

/// Whether `t` is a type parameter, or a union holding one as a variant — a `T` at
/// the top level of a parameter or an argument.
///
/// @param t  the type to ask.
export type_param_at_top :: fn(t: Type) -> bool {
    if t is UnionType {
        for v in t.variants {
            if v is TypeParamType {
                return true
            }
        }
        return false
    }
    return t is TypeParamType
}

// Scanned first so the common case — nothing to relay — allocates no marker vector.
relays_any :: fn(src: FnType, params: Type[]) -> bool {
    for i in 0..<params.len() {
        if relays_at(src, params, i) {
            return true
        }
    }
    return false
}

/// Rebuild an `FnType` that DROPS its leading parameter (UFCS curries the
/// receiver away), shifting the marker vector by one so the remaining markers
/// stay aligned with the remaining parameters.
///
/// @param src  the fn type before the receiver is dropped ; it has one at least.
export mk_fn_drop_self :: fn(src: FnType) -> FnType {
    marks: bool[]: if src.params_mutable.len() > 1 {
        src.params_mutable[1..<src.params_mutable.len()]
    } else {
        []
    }
    return FnType {
        .params         = src.params[1..<src.params.len()],
        .params_mutable = if true in marks { marks } else { [] },
        .return_type    = src.return_type,
    }
}

/// A tuple type. `immutable` is required for the same reason as in `mk_struct`.
export mk_tuple :: fn(elements: Type[], immutable: bool) -> Type =
    TupleType { .elements = elements, .immutable = immutable }

export mk_fn :: fn(params: Type[], return_type: Type) -> Type {
    return FnType { .params = params, .return_type = return_type }
}

/// Whether mutation through a slot of type `t` is rejected at typecheck.
///
/// Only the three REFERENCE shapes and a trait value carry the bit — a primitive, an
/// enum or a distinct-over-primitive is a value, copied into the slot, so "the
/// referent is read-only" has no meaning for it. A `DistinctType` answers for its backing,
/// where its bit lives : `strip_distinct` and the `*_backing` unwraps hand the
/// backing out as it is, bit included.
export type_is_immutable :: fn(t: Type) -> bool = match t {
    is ArrayType     -> t.immutable
    is StructType    -> t.immutable
    is TupleType     -> t.immutable
    is TraitType     -> t.immutable
    is TypeParamType -> t.immutable
    is DistinctType  -> type_is_immutable(t.backing)
    is PrimitiveType | EnumType | UnionType | FnType
     | TypeMetaType | SelfType | UnresolvedType | FreeIntType | FreeFloatType
     | FreeCharType | NeverType | AnyType -> false
}

/// Whether `t` EXPLICITLY grants mutation at its own level — what `!` writes.
///
/// NOT the complement of `type_is_immutable`: a primitive carries no bit either
/// way, so neither answers true for it. On a union the bit lives on the variants
/// (`with_immutable` distributes it), so the union grants mutation only when every
/// variant carrying a bit does (`carries_mutability_bit`).
///
/// @param t  the type to ask.
export type_grants_mutation :: fn(t: Type) -> bool = match t {
    is ArrayType    -> !t.immutable
    is StructType   -> !t.immutable
    is TupleType    -> !t.immutable
    is UnionType    -> variants_grant_mutation(t.variants)
    is DistinctType -> type_grants_mutation(t.backing)
    is TraitType    -> !t.immutable
    is PrimitiveType | EnumType | FnType | TypeParamType | TypeMetaType
     | SelfType | UnresolvedType | FreeIntType | FreeFloatType | FreeCharType
     | NeverType | AnyType -> false
}

/// Whether ANY level of `t` could hand out mutation — the "some variant" dual of
/// `type_grants_mutation`. False for a scalar, a frozen array / struct / tuple / trait
/// value, or a union of those ; a distinct type answers for its backing.
///
/// An unbound type parameter answers false: inside a generic body `T` grants
/// nothing, and the call that binds it is where an argument is judged. `Self` or an
/// unresolved type answers true — nothing is known yet.
///
/// @param t  the type to ask.
export type_may_grant_mutation :: fn(t: Type) -> bool = match t {
    is ArrayType | StructType | TupleType | TraitType -> !type_is_immutable(t)
    is UnionType     -> any_variant(t.variants, type_may_grant_mutation)
    is DistinctType  -> type_may_grant_mutation(t.backing)
    is SelfType | AnyType | UnresolvedType -> true
    is PrimitiveType | EnumType | FnType | TypeParamType | TypeMetaType | FreeIntType
     | FreeFloatType | FreeCharType | NeverType -> false
}

any_variant :: fn(variants: Type[], holds: fn(Type) -> bool) -> bool {
    for v in variants {
        if holds(v) {
            return true
        }
    }
    return false
}

variants_grant_mutation :: fn(variants: Type[]) -> bool =
    any_variant(variants, carries_mutability_bit) && !any_variant(variants, type_withholds_mutation)

/// Whether `t` carries a mutability marker of its own level — the three reference
/// shapes, a trait value, a union, whose variants carry theirs, and a distinct over
/// one of them, whose backing holds its bit. A primitive, an enum or `null` is a value, copied
/// out : `with_immutable` leaves it alone, so `Value!` over `ArrayVal | BoolVal`
/// reads as `ArrayVal! | BoolVal`.
///
/// @param t  the type to ask.
export carries_mutability_bit :: fn(t: Type) -> bool =
    t is ArrayType | StructType | TupleType | UnionType | TraitType ||
        (t is DistinctType && carries_mutability_bit(t.backing))

/// Whether some level `t` hands out is read-only by its own marker : a frozen array,
/// struct, tuple or trait value, or a union holding one (`Point | null` from an
/// unmarked return). Unlike `type_is_immutable`, which a union answers false, this is
/// the question a mutation of the VALUE asks.
///
/// @param t  the type to ask.
export type_withholds_mutation :: fn(t: Type) -> bool {
    // A loop, not `any_variant` : a fn value here gives every caller a GC root
    // frame.
    if t is UnionType {
        for v in t.variants {
            if type_is_immutable(v) {
                return true
            }
        }
        return false
    }
    return type_is_immutable(t)
}

/// Raw union constructor. Callers that need flattening + dedup must go
/// through `union_of` in `type_ops.vader`.
export mk_union :: fn(variants: Type[]) -> Type = UnionType { .variants = variants }

export mk_type_param :: fn(symbol: Symbol) -> Type = TypeParamType { .symbol = symbol }

export TY_TYPE       :: TypeMetaType {}
export TY_SELF       :: SelfType {}
export TY_UNRESOLVED :: UnresolvedType {}
export TY_FREE_INT   :: FreeIntType {}
export TY_FREE_FLOAT :: FreeFloatType {}
export TY_FREE_CHAR  :: FreeCharType {}
export TY_NEVER      :: NeverType {}
export TY_ANY        :: AnyType {}
export TY_VOID       :: PrimitiveType { .name = "void" }
export TY_BOOL       :: PrimitiveType { .name = "bool" }
export TY_STRING     :: PrimitiveType { .name = "string" }
export TY_NULL       :: PrimitiveType { .name = "null" }
export TY_CPOINTER   :: PrimitiveType { .name = "CPointer" }

/// Whether `t` is the `null` type.
///
/// @param t  the type to test.
export is_null_type :: fn(t: Type) -> bool = t is PrimitiveType && t.name == "null"

// ---- display --------------------------------------------------------------

/// Render `t` as a human-readable string. The format is fixed so dumps
/// stay stable across snapshots.
///
/// Fast path : leaf types whose display form is a single constant
/// string skip the builder entirely. Profiling showed `display_type`
/// was the top source of small-string allocs (`string` 66×, `void`
/// 20×, every primitive 5–10× per typecheck) because each call went
/// through `StringBuilder {} + append + to_string` even for primitives
/// whose name was already a canonical `.rodata` literal.
export display_type :: fn(t: Type) -> string {
    match t {
        is PrimitiveType  -> { return t.name }
        is TypeParamType  -> { if !t.immutable { return t.symbol.name } }
        is EnumType       -> { return t.symbol.name }
        is DistinctType   -> { if !type_grants_mutation(t) { return t.symbol.name } }
        is UnresolvedType -> { return "?" }
        is NeverType      -> { return "never" }
        is FreeIntType    -> { return "{integer}" }
        is FreeFloatType  -> { return "{float}" }
        is FreeCharType   -> { return "{char}" }
        is SelfType       -> { return "Self" }
        is TypeMetaType   -> { return "type" }
        is AnyType        -> { return "Any" }
        _                 -> {}  // fall through for composite types
    }
    sb :: StringBuilder {}
    sb.write_type(t)
    return sb.to_string()
}

/// Render `t` WITHOUT any mutability marker — the key form.
///
/// Every side-table keyed on a rendered type must use this: mutability is not
/// part of what such a table is keyed on, so rendering it would look up
/// `"Cfg!"` where registration wrote `"Cfg"` and the lookup would miss —
/// silently, since a miss just means "nothing recorded".
export display_type_key :: fn(t: Type) -> string {
    // Fast path, and it reaches FURTHER than `display_type`'s : with the
    // mutability marker off, a nominal type with no args renders to the name it
    // already carries. `StringBuilder {}` costs two allocations before the first
    // character (the struct, then its `parts`), so the builder existed only to
    // hand back a string the type was holding.
    match t {
        is PrimitiveType -> {
            return t.name
        }
        is EnumType | DistinctType | TypeParamType -> {
            return t.symbol.name
        }
        is StructType | TraitType                  -> {
            if t.args.len() == 0 {
                return t.symbol.name
            }
        }
        _                                          -> {}  // fall through for composite types
    }
    sb :: StringBuilder {}
    sb.write_type_mut(t, false)
    return sb.to_string()
}

/// The impl tables' key for a type's BASE — the declaration a nominal type
/// instantiates (`Foo<i32>` and `Foo<T>` alike), as `#<symbol id>`, so two
/// same-named types from different modules never share an entry. Keys
/// `impl_methods`, `iter_element_types`, `index_*_types`, the trait membership
/// tables and the registry's `ImplEntry.target`, so generic instantiations
/// dispatch through the same entry as the underlying impl.
export impl_base_key :: fn(t: Type) -> string {
    // @partial: only nominal types (Struct/Trait/Enum/Distinct) have a
    // declaration ; every other Type variant (PrimitiveType, TupleType, FnType,
    // UnionType, …) is its own base, so its rendering is the key — a primitive
    // is unique by name.
    //
    // ArrayType collapses to the element-independent key `"[]"` so a CONCRETE
    // array (`BlockId[][]`) matches a blanket `T[] implements …` impl (registered
    // under the same `"[]"` key) ; the param-named `"T[]"` would match no
    // concrete array. An impl on a concrete array (`i32[]`) registers under its
    // own key and is read first, and one on a partly generic array (`T[][]`) is
    // refused (T3090), so the collapse can't mis-match.
    @partial match t {
        is StructType | TraitType | EnumType | DistinctType -> { return declaration_key(t.symbol) }
        is ArrayType -> { return "[]" }
        // A KEY, so the mutability-free rendering : a tuple / fn / union receiver
        // must key the same whether or not its slot is mutable, else registration
        // and lookup drift and the dispatch misses in silence.
        _ -> { return display_type_key(t) }
    }
}


write_type :: fn(sb: StringBuilder, t: Type) -> void { sb.write_type_mut(t, true) }

// `show_mut = false` renders the SHAPE only — see `display_type_key`.
write_type_mut :: fn(sb: StringBuilder, t: Type, show_mut: bool) -> void {
    match t {
        is PrimitiveType -> { sb.append(t.name) }
        is StructType    -> {
            sb.write_named_mut(t.symbol.name, t.args, show_mut)
            if show_mut && !t.immutable { sb.append_char('!') }
        }
        is EnumType       -> { sb.append(t.symbol.name) }
        is DistinctType   -> {
            sb.append(t.symbol.name)
            if show_mut && type_grants_mutation(t) { sb.append_char('!') }
        }
        is TraitType      -> {
            sb.write_named_mut(t.symbol.name, t.args, show_mut)
            if show_mut && !t.immutable { sb.append_char('!') }
        }
        is TypeParamType  -> {
            // A read-only view has no spelling of its own : a written `T` is the
            // type parameter itself.
            if show_mut && t.immutable { sb.append("readonly ") }
            sb.append(t.symbol.name)
        }
        is TypeMetaType   -> { sb.append("type") }
        is SelfType       -> { sb.append("Self") }
        is UnresolvedType -> { sb.append("?") }
        is NeverType      -> { sb.append("never") }
        is FreeIntType    -> { sb.append("{integer}") }
        is FreeFloatType  -> { sb.append("{float}") }
        is FreeCharType   -> { sb.append("{char}") }
        is ArrayType      -> {
            // `(A | B)[]` is unambiguous ; bare `A | B[]` would read as
            // `A | (B[])` since `[]` binds tighter than `|`. Same for
            // bare fn types like `fn() -> A`.
            needs_parens :: t.element is UnionType || t.element is FnType
            if needs_parens { sb.append_char('(') }
            sb.write_type_mut(t.element, show_mut)
            if needs_parens { sb.append_char(')') }
            sb.append("[]")
            // A SUFFIX, and on the mutable form — exactly what the source spells.
            // The old `const ` prefix was ambiguous in the two places it mattered:
            // on a union it read as governing every variant (`u8[] | Err`
            // marks only the array — the bit is distributed), and on a nested
            // array it attached to the wrong level (`Array(const Array(i32))`
            // printed `i32[][]`, suggesting the OUTER array was frozen).
            if show_mut && !t.immutable { sb.append_char('!') }
        }
        is TupleType -> {
            sb.append_char('[')
            sb.write_type_list_mut(t.elements, ", ", show_mut)
            sb.append_char(']')
            if show_mut && !t.immutable { sb.append_char('!') }
        }
        is FnType -> {
            sb.append("fn(")
            first := true
            for i in 0..<t.params.len() {
                if !first { sb.append(", ") }
                first = false
                // The marker now rides the param's TYPE, which renders its own
                // `!` just above — `params_mutable` is the same fact recorded a
                // second time, so rendering it too printed `Cfg[]!!`.
                sb.write_type_mut(t.params[i], show_mut)
            }
            sb.append(") -> ")
            sb.write_type_mut(t.return_type, show_mut)
        }
        is UnionType -> { sb.write_type_list_mut(t.variants, " | ", show_mut) }
        is AnyType   -> { sb.append("Any") }
    }
}

write_named_mut :: fn(sb: StringBuilder, name: string, args: Type[], show_mut: bool) -> void {
    sb.append(name)
    if args.len() == 0 { return }
    sb.append_char('<')
    sb.write_type_list_mut(args, ", ", show_mut)
    sb.append_char('>')
}

write_type_list_mut :: fn(sb: StringBuilder, items: Type[], sep: string, show_mut: bool) -> void {
    first := true
    for it in items {
        if !first { sb.append(sep) }
        first = false
        sb.write_type_mut(it, show_mut)
    }
}

// ---- canonical key + walk -------------------------------------------------

/// Stable single-line key for a type. Used by mono-instance DCE and
/// any side-table keyed on Type identity. Distinct types always
/// produce distinct keys ; equivalent types always produce equal keys.
export canonical_key :: fn(t: Type) -> string {
    match t {
        is PrimitiveType -> { return "p${t.name}" }
        // No immutability marker: the bit is outside struct / tuple identity
        // (`equals_type`), so it must stay out of the key too — else one type
        // would answer to two keys and every side-table keyed on it would split.
        is StructType -> { return "s${t.symbol.id}<${canonical_args_key(t.args)}>" }
        is TraitType  -> { return "t${t.symbol.id}<${canonical_args_key(t.args)}>" }
        is ArrayType  -> {
            if t.immutable { return "ac(${canonical_key(t.element)})" }
            return "am(${canonical_key(t.element)})"
        }
        is TupleType      -> { return "T<${canonical_args_key(t.elements)}>" }
        is FnType         -> { return "F<${canonical_args_key(t.params)}>>${canonical_key(t.return_type)}" }
        is UnionType      -> { return "U<${canonical_args_key(t.variants)}>" }
        is TypeParamType  -> { return "P${t.symbol.id}" }
        is EnumType       -> { return "e${t.symbol.id}" }
        is DistinctType   -> { return "d${t.symbol.id}" }
        is TypeMetaType   -> { return "M" }
        is SelfType       -> { return "S" }
        is UnresolvedType -> { return "?" }
        is NeverType      -> { return "!" }
        is FreeIntType    -> { return "FI" }
        is FreeCharType   -> { return "FC" }
        is FreeFloatType  -> { return "FF" }
        is AnyType        -> { return "A" }
    }
}

/// Compose an arg-list canonical key — used as the inner key in
/// mono-instance DCE and impl-method indexing.
export canonical_args_key :: fn(args: Type[]) -> string {
    if args.len() == 0 { return "" }
    sb :: StringBuilder {}
    first := true
    for a in args {
        if !first { sb.append(",") }
        first = false
        sb.append(canonical_key(a))
    }
    return sb.to_string()
}

/// Walk `t` and every nested type (struct/trait args, array element,
/// tuple elements, fn params + return, union variants) calling `visit`
/// on each. Pre-order, root included.
export for_each_type :: fn(t: Type, visit: fn(Type) -> void) -> void {
    visit(t)
    match t {
        is StructType -> { for a in t.args { for_each_type(a, visit) } }
        is TraitType  -> { for a in t.args { for_each_type(a, visit) } }
        is ArrayType  -> { for_each_type(t.element, visit) }
        is TupleType  -> { for el in t.elements { for_each_type(el, visit) } }
        is FnType     -> {
            for p in t.params { for_each_type(p, visit) }
            for_each_type(t.return_type, visit)
        }
        is UnionType -> { for v in t.variants { for_each_type(v, visit) } }
        is DistinctType -> { for_each_type(t.backing, visit) }
        _ -> {}
    }
}

/// Whether `t` or a type nested in it satisfies `pred` — `for_each_type`'s walk,
/// stopping at the first type that does.
///
/// @param t     the type to walk.
/// @param pred  the test, applied root first.
export any_type :: fn(t: Type, pred: fn(Type) -> bool) -> bool {
    if pred(t) {
        return true
    }
    // @partial: only these variants nest other types ; every other one is a leaf.
    @partial match t {
        is StructType   -> { return any_type_each(t.args, pred) }
        is TraitType    -> { return any_type_each(t.args, pred) }
        is ArrayType    -> { return any_type(t.element, pred) }
        is TupleType    -> { return any_type_each(t.elements, pred) }
        is FnType       -> { return any_type_each(t.params, pred) || any_type(t.return_type, pred) }
        is UnionType    -> { return any_type_each(t.variants, pred) }
        is DistinctType -> { return any_type(t.backing, pred) }
        _ -> { return false }
    }
}

any_type_each :: fn(ts: Type[], pred: fn(Type) -> bool) -> bool {
    for t in ts {
        if any_type(t, pred) {
            return true
        }
    }
    return false
}

/// True when `t` carries a `DistinctType` anywhere in its tree. Guards
/// `strip_distinct` so the common (distinct-free) type returns unchanged
/// without a rebuild.
export contains_distinct :: fn(t: Type) -> bool {
    if t is DistinctType { return true }
    if t is StructType { for a in t.args { if contains_distinct(a) { return true } } }
    if t is TraitType { for a in t.args { if contains_distinct(a) { return true } } }
    if t is ArrayType { return contains_distinct(t.element) }
    if t is TupleType { for el in t.elements { if contains_distinct(el) { return true } } }
    if t is FnType {
        for p in t.params { if contains_distinct(p) { return true } }
        return contains_distinct(t.return_type)
    }
    if t is UnionType { for v in t.variants { if contains_distinct(v) { return true } } }
    return false
}

/// Replace every `DistinctType` in `t` with its backing, recursively.
///
/// A distinct (newtype) has no runtime identity (Axe E) — it monomorphises,
/// boxes and lays out exactly as its backing primitive, so the backend must
/// never see one inside a monomorphisation instance key. Applied to type-args
/// at every instance-registration source (`lower_generic_call`, `lower_ufcs`,
/// `instances.add`, the direct `GenericInstance` builders) so `MutableMap<BlockId>`
/// IS `MutableMap<i32>` for the whole lowerer / comptime / emit pipeline — one
/// raw instance, no separate erased instance to collide with the genuine one.
/// Nominal distinctness is a typechecker-only concept; it ends here, at the
/// lowering boundary.
///
/// @param t  any type, possibly carrying distincts nested anywhere.
/// @return   the structurally-identical type with all distincts collapsed
///           (returns `t` unchanged when it carries none).
export strip_distinct :: fn(t: Type) -> Type {
    // Fast path : a primitive (the common type-arg) can't carry a distinct, so
    // skip the structural `contains_distinct` walk on the hot classifier path.
    if t is PrimitiveType { return t }
    if !contains_distinct(t) { return t }
    if t is DistinctType { return strip_distinct(t.backing) }
    if t is StructType { return mk_struct(t.symbol, strip_distinct_each(t.args), t.immutable) }
    if t is TraitType { return TraitType { ...t, .args = strip_distinct_each(t.args) } }
    if t is ArrayType { return mk_array(strip_distinct(t.element), t.immutable) }
    if t is TupleType { return mk_tuple(strip_distinct_each(t.elements), t.immutable) }
    if t is FnType { return mk_fn_like(t, strip_distinct_each(t.params), strip_distinct(t.return_type)) }
    if t is UnionType { return mk_union(strip_distinct_each(t.variants)) }
    return t
}

/// The backing array of `t` — `t` itself when it's an array, or the array a
/// distinct newtype wraps (`BigInt :: u32[]` → `u32[]`). `null` for anything
/// else. Lets the STRUCTURAL array ops (index, `len`/`push`, literal coercion,
/// for-in) forward through an array-backed distinct newtype while its trait
/// impls (operator overloads) stay nominal on the distinct's own key.
///
/// Unwraps only the OUTER distinct — the element type is preserved verbatim, so
/// `LocalId[]` stays `LocalId[]` (NOT `strip_distinct`, which would deep-strip
/// the element to `i32[]` and corrupt `arr[i]`'s type).
export array_backing :: fn(t: Type) -> ArrayType | null {
    if t is ArrayType { return t }
    if t is DistinctType { return array_backing(t.backing) }
    return null
}

/// The backing struct of `t` — `t` itself when it's a struct, or the struct a
/// distinct newtype wraps (`Color :: Rgb` → `Rgb`). `null` for anything else.
/// Lets the STRUCTURAL struct ops (field access, struct-literal construction)
/// forward through a struct-backed distinct newtype while its trait impls
/// (operator overloads) stay nominal on the distinct's own key.
///
/// Unwraps only the OUTER distinct — the struct's type args are preserved
/// verbatim (mirror of `array_backing`).
export struct_backing :: fn(t: Type) -> StructType | null {
    if t is StructType { return t }
    if t is DistinctType { return struct_backing(t.backing) }
    return null
}

/// The backing tuple of `t` — `t` itself when it's a tuple, or the tuple a
/// distinct newtype wraps (`Coord :: [i32, i32]` → `[i32, i32]`). `null` for
/// anything else. Lets the STRUCTURAL tuple ops (positional `.0` access,
/// literal construction, `[a, b]` destructure) forward through a tuple-backed
/// distinct newtype while its trait impls stay nominal on the distinct's key.
export tuple_backing :: fn(t: Type) -> TupleType | null {
    if t is TupleType { return t }
    if t is DistinctType { return tuple_backing(t.backing) }
    return null
}

/// The primitive `t` is represented as — `t` itself when it's a primitive, or
/// the primitive a distinct newtype wraps, through any number of distinct
/// layers (`Handle :: CPointer` → `CPointer`). `null` for anything else. What
/// `==` compares two scalars by.
export scalar_backing :: fn(t: Type) -> PrimitiveType | null {
    if t is PrimitiveType { return t }
    if t is DistinctType { return scalar_backing(t.backing) }
    return null
}

/// The type a mixed instance keeps for the type argument `t` ; null when `t`
/// erases to `Any`, i.e. when the instance shares its body with every other
/// instance erasing there. Every site that depends on the split asks this one
/// question — the monomorphiser's flavor gate, substitutions and instance
/// suffix, and the `is` tests that cannot see through a shared body (T3087) —
/// so they always agree on the instance.
///
/// A primitive is kept, and so is a newtype over one, as its backing. An enum
/// with variant data is kept as itself : it stores its variant's rank, so
/// boxing it would leave `i64(v)` in the shared body reading the rank where
/// the written value is meant. Every other type erases.
///
/// @param t  a concrete type argument of the instance.
export kept_type_argument :: fn(t: Type) -> Type | null {
    backing :: strip_distinct(t)
    if backing is PrimitiveType {
        return backing
    }
    if backing is EnumType && backing.data != null {
        return backing
    }
    return null
}

/// Whether a value of `t` carries no tag of its own to test at run time : an erased
/// type parameter, or an instance of a generic struct whose body the instances
/// erasing one of its arguments share (T3087).
///
/// @param t  a variant of a union.
export is_untagged :: fn(t: Type) -> bool {
    if t is AnyType || t is TypeParamType {
        return true
    }
    if t is StructType {
        for arg in t.args {
            if arg !is UnresolvedType && kept_type_argument(arg) == null {
                return true
            }
        }
    }
    return false
}

/// Whether a boxed value of `t` is tagged as `t` itself, so a runtime `is t` tells it
/// from a value of any other type. Not an enum nor a distinct
/// (`boxes_as_representation`), nor a type with no tag to test (`is_untagged`).
///
/// @param t  the type of the value boxed.
export carries_own_tag :: fn(t: Type) -> bool = match t {
    is StructType -> !is_untagged(t)
    is ArrayType | PrimitiveType -> true
    is EnumType | DistinctType | AnyType | TypeParamType -> false
    // Never the receiver of an impl.
    is UnionType | TupleType | TraitType | FnType | SelfType | TypeMetaType -> false
    is NeverType | UnresolvedType | FreeIntType | FreeFloatType | FreeCharType -> false
}

/// Whether a boxed value of type `t` carries its representation's runtime type
/// rather than its own : an enum boxes as its integer, a distinct as its
/// backing. A trait dispatched on such a value reaches its own impl only where
/// its type is known statically.
///
/// @param t  the type of the value boxed.
export boxes_as_representation :: fn(t: Type) -> bool = t is EnumType || t is DistinctType

/// Map `strip_distinct` over a type-arg list. Always returns a fresh array
/// with each element passed through `strip_distinct`.
/// @param args  the concrete type arguments.
/// @return      `args` with every distinct collapsed to its backing.
export strip_distinct_each :: fn(args: Type[]) -> Type[] {
    out: Type[]: []
    for a in args { out.push(strip_distinct(a)) }
    return out
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "toolchain/ast"

@test
test_display_primitive :: fn() -> void {
    assert_eq(display_type(mk_primitive("i32")), "i32")
    assert_eq(display_type(mk_primitive("string")), "string")
}

@test
test_display_array :: fn() -> void {
    // The marker is a SUFFIX on the MUTABLE form — exactly what the source spells,
    // so a dump round-trips as written. The read-only form is bare (it is the
    // default), and `display_type_key` drops the marker for side-table keys.
    mut_arr :: mk_array(mk_primitive("i32"), false)
    assert_eq(display_type(mut_arr), "i32[]!")
    // the KEY form never carries the marker — that is what keeps a side table
    // keyed the same whether the slot is mutable or not
    assert_eq(display_type_key(mut_arr), "i32[]")
    ro :: mk_array(mk_primitive("i32"), true)
    assert_eq(display_type(ro), "i32[]")
    // Nested : each level carries its own marker, which the old `const ` prefix
    // could not express (it printed `i32[][]` for a frozen INNER array).
    outer_mut :: mk_array(mk_array(mk_primitive("i32"), true), false)
    assert_eq(display_type(outer_mut), "i32[][]!")
}

@test
test_display_tuple :: fn() -> void {
    el0: Type: mk_primitive("i32")
    el1: Type: mk_primitive("string")
    t :: mk_tuple([el0, el1], false)
    assert_eq(display_type(t), "[i32, string]!")
}

@test
test_display_fn :: fn() -> void {
    p0: Type: mk_primitive("i32")
    p1: Type: mk_primitive("string")
    f :: mk_fn([p0, p1], mk_primitive("bool"))
    assert_eq(display_type(f), "fn(i32, string) -> bool")
}

@test
test_display_union :: fn() -> void {
    v0: Type: mk_primitive("i32")
    v1: Type: mk_primitive("string")
    u :: mk_union([v0, v1])
    assert_eq(display_type(u), "i32 | string")
}

@test
test_display_struct_with_args :: fn() -> void {
    factory :: SymbolFactory {}
    sym :: factory.make(.Struct, "MutableMap", "test", "test", .Public, null)
    a0: Type: mk_primitive("string")
    a1: Type: mk_primitive("i32")
    s :: mk_struct(sym, [a0, a1], false)
    assert_eq(display_type(s), "MutableMap<string, i32>!")
}

@test
test_display_struct_without_args :: fn() -> void {
    factory :: SymbolFactory {}
    sym :: factory.make(.Struct, "Point", "test", "test", .Public, null)
    s :: mk_struct(sym, [], false)
    assert_eq(display_type(s), "Point!")
}

@test
test_display_singletons :: fn() -> void {
    assert_eq(display_type(TY_TYPE), "type")
    assert_eq(display_type(TY_SELF), "Self")
    assert_eq(display_type(TY_UNRESOLVED), "?")
    assert_eq(display_type(TY_NEVER), "never")
    assert_eq(display_type(TY_FREE_INT), "{integer}")
    assert_eq(display_type(TY_FREE_FLOAT), "{float}")
}

@test
test_display_type_param :: fn() -> void {
    factory :: SymbolFactory {}
    sym :: factory.make(.TypeParam, "T", "test", "test", .Private, null)
    tp :: mk_type_param(sym)
    assert_eq(display_type(tp), "T")
}

@test
test_is_primitive_name :: fn() -> void {
    assert(is_primitive_name("i32"), "i32 is primitive")
    assert(is_primitive_name("string"), "string is primitive")
    assert(!is_primitive_name("MyStruct"), "user types are not primitive")
}

@test
test_primitive_meta_partition :: fn() -> void {
    assert(is_int_name("usize") && is_unsigned_int_name("usize"), "usize is unsigned int")
    assert(is_signed_int_name("i64") && !is_unsigned_int_name("i64"), "i64 is signed int")
    assert(is_float_name("f32") && !is_int_name("f32"), "f32 is float not int")
    assert(!is_numeric_name("char") && !is_numeric_name("string"), "char/string not numeric")
    // An atom id, not the retired `{ptr, len}` fat pointer.
    assert_eq(primitive_size("string"), 4)
    assert_eq(primitive_size("i32"), 4)
    assert_eq(resolve_primitive_alias("byte"), "u8")
    assert_eq(resolve_primitive_alias("i32"), "i32")
}

@test
test_slot_size_of_a_string_is_an_atom_id :: fn() -> void {
    // `typedef vader_atom_t vader_string_t` — a u32. The `{ptr, len}` fat
    // pointer this used to report went out of the runtime with T12.
    assert_eq(slot_byte_size(mk_primitive("string")), 4)
}

@test
test_slot_size_of_a_byte_enum_is_one :: fn() -> void {
    // `enum(u8)` emits a `uint8_t` field ; a uniform 16 was the difference
    // between a packed array of enums and one four times larger.
    assert_eq(slot_byte_size(slot_size_test_enum("u8")), 1)
}

@test
test_slot_size_of_a_default_enum_is_four :: fn() -> void {
    assert_eq(slot_byte_size(slot_size_test_enum("i32")), 4)
}

@test
test_slot_size_of_a_concrete_ref_is_a_word :: fn() -> void {
    // Since T12 a struct field emits `void*`, not a `vader_box_t`.
    assert_eq(slot_byte_size(mk_array(mk_primitive("i32"), false)), REF_SLOT_BYTES)
}

@test
test_slot_size_of_an_erased_slot_is_a_box :: fn() -> void {
    // A union has no single object header to recover a tag from, so it keeps
    // the boxed slot.
    either :: mk_union([mk_primitive("i32"), mk_primitive("string")])
    assert_eq(slot_byte_size(either), BOX_SLOT_BYTES)
}

@test
test_slot_size_of_an_abstract_kind_is_zero :: fn() -> void {
    assert_eq(slot_byte_size(TY_NEVER), 0)
}

@test
test_slot_align_caps_at_a_word :: fn() -> void {
    either :: mk_union([mk_primitive("i32"), mk_primitive("string")])
    assert_eq(slot_byte_align(either), WORD_BYTES)
}

@test
test_slot_align_of_a_narrow_scalar_is_its_width :: fn() -> void {
    assert_eq(slot_byte_align(mk_primitive("i16")), 2)
}

slot_size_test_enum :: fn(repr: string) -> Type = EnumType {
    .symbol = slot_size_test_sym(),
    .repr = repr,
    .indices = MutableMap<string, i64> {},
}

slot_size_test_sym :: fn() -> Symbol = Symbol {
    .id = 9002,
    .kind = .TypeAlias,
    .name = "Color",
    .module = "test",
    .module_name = "test",
    .visibility = .Private,
    .defined_at = null,
}

@test
test_display_nested :: fn() -> void {
    // fn(i32[], string) -> i32 | null
    arr: Type: mk_array(mk_primitive("i32"), false)
    str: Type: mk_primitive("string")
    i32_t: Type: mk_primitive("i32")
    null_t: Type: mk_primitive("null")
    ret :: mk_union([i32_t, null_t])
    f :: mk_fn([arr, str], ret)
    assert_eq(display_type(f), "fn(i32[]!, string) -> i32 | null")
}
