// vader/midir/build: LoweredAST → CFG converter.
//
// Walks each `LoweredFnDecl` in the
// project and produces a `CFGFunction` : expressions become
// three-address `Instruction` sequences with named tmp locals ;
// control flow (`LoweredIf`, `LoweredLoop`, `break`, `continue`,
// `return`) becomes basic blocks with explicit terminators. The
// result is reducible (the source has no `goto`), which is what the
// structurer needs to recover WASM-style nesting at emit time.
//
// Strings are interned into a project-level pool reused verbatim by
// the CFG → bytecode emitter ; const decls are inlined at every read
// site, matching the existing bytecode emitter's policy.

module "vader/midir"

import "std/collections"
import "std/ffi"
import "vader/core/mono"
import "vader/support/diagnostics"
import "vader/support/integer"
import "vader/lower/ir"
import "vader/core/symbol"
import "vader/core/types"
import "std/abort"

/// Project-level interning context — accumulates strings into a single
/// pool shared by every fn's CFG.
ProjectCtx :: struct {
    strings:      string[]
    string_index: MutableMap<string, i32>
    /// Const symbol id → accessor fn (fn-wrap bucket), forwarded from the
    /// `LoweredProject` so `build_ident` can lower a const reference to a
    /// `call` on its synthetic `__const_<name>` fn.
    const_fn_wrap: MutableMap<i32, ConstFnWrap>
    /// Const symbol id → lowered value (inline bucket) — `build_ident`
    /// re-builds it at each read site.
    const_inline:  MutableMap<i32, LoweredExpr>
    /// Const symbol id → the accessor that builds a const of the data pool again
    /// (`LoweredProject.const_fresh_wrap`).
    const_fresh_wrap: MutableMap<i32, ConstFnWrap>
    /// `@extern` fn symbol id → the indices of its CALLBACK parameters.
    ///
    /// Read off the DECLARATION, not off the callee expression's recorded type:
    /// a UFCS call records the call's RESULT type on the callee ident, so asking
    /// the expression
    /// would silently answer "no callbacks here" and emit a fn value into C.
    /// A symbol names one declaration, which is also what makes an overload pick
    /// unambiguous.
    extern_callbacks: MutableMap<i32, MutableSet<i64>>
    /// Where `build_ident` reports an ident with no local. LOUD on purpose: the
    /// symbol resolved, so a miss here is the COMPILER losing a binding, and the
    /// recovery value is a `TermUnreachable` that replaces the whole entry block
    /// — the surrounding code vanishes with nothing to read. `lower_ident` was
    /// made loud for that exact reason after two bisections ; this is its twin.
    diags: Diagnostic[]
    /// The global slots of the program (`LoweredProject.globals`).
    globals: GlobalSlot[]
    /// What each struct's fields and each function's parameters are held as
    /// (`storage.vader`).
    slots: SlotTypes
}

new_project_ctx :: fn(lp: LoweredProject, diags: Diagnostic[]) -> ProjectCtx {
    externs :: MutableMap<i32, MutableSet<i64>> {}
    slot_types :: SlotTypes {}
    for [_, m] in lp.modules {
        for d in m.decls {
            note_slot_types(slot_types, d)
            if d is LoweredFnDecl {
                if fn_metadata(d).is_extern {
                    sym :: d.origin.symbol
                    if sym is Symbol {
                        slots :: MutableSet<i64> {}
                        for i in 0..<d.params.len() {
                            if d.params[i].type is FnType {
                                slots.add(i)
                            }
                        }
                        if slots.len() > 0 {
                            externs[sym.id] = slots
                        }
                    }
                }
            }
        }
    }
    return ProjectCtx {
        .strings = [],
        .string_index = MutableMap<string, i32> {},
        .const_fn_wrap = lp.const_fn_wrap,
        .const_inline  = lp.const_inline,
        .const_fresh_wrap = lp.const_fresh_wrap,
        .extern_callbacks = externs,
        .diags            = diags,
        .globals          = lp.globals,
        .slots            = slot_types,
    }
}

// Note what the struct or the function `d` declares holds its fields or its
// parameters as.
note_slot_types :: fn(
    slots: SlotTypes,
    d: LoweredFnDecl | LoweredStructDecl | LoweredConstDecl,
) -> void {
    if d is LoweredStructDecl {
        note_struct_fields(slots, make_struct_decl(d))
    } else if d is LoweredFnDecl {
        params: Type[]: []
        for p in d.params {
            params.push(p.type)
        }
        note_params(slots, d.mangled, d.origin.symbol, params, d.body == null)
    }
}

intern_string_pool :: fn(ctx: ProjectCtx, s: string) -> i32 {
    fresh :: i32(ctx.strings.len())
    idx :: ctx.string_index.get_or_put(s, fresh)
    if idx == fresh {
        ctx.strings.push(s)
    }
    return idx
}

/// Mutable block accumulator. The CFG-side `BasicBlock` is immutable ;
/// during construction we mutate `instructions` (append) and
/// `terminator` (set once). `freeze_block` converts to the final form.
MutableBlock :: struct {
    id:           BlockId
    instructions: Instruction[]
    terminator:   Terminator | null
    span:         Span
}

/// One enclosing loop's break / continue targets.
LoopFrame :: struct {
    label:     string | null
    header_id: BlockId      // continue target
    exit_id:   BlockId      // break target
    /// Runs before every jump to the header — see `build_back_edge`.
    step:      LoweredStmt[]
    /// A `LoweredLabelledBlock`: only a `break` naming it reaches it, so a bare
    /// jump looks past it and `header_id` is unused.
    block:     bool = false
}

/// Per-function build context. `current` tracks the basic block under
/// construction ; null means control already left (Return / Unreachable
/// terminator emitted).
FnCtx :: struct {
    project:         ProjectCtx
    mangled:         string
    origin:          MonoEntry
    return_type:     Type
    params:          CFGParam[]
    locals:          CFGLocal[]
    local_by_sym_id: MutableMap<i32, LocalId>
    blocks:          MutableBlock[]
    loop_stack:      LoopFrame[]
    current:         BlockId | null
}


// ============================================================================
// Project-level orchestration
// ============================================================================

/// Top-level entry — walk the lowered project, emit one `CFGModule` per
/// lowered module.
///
/// @param lp     the lowered project from the lowerer pass.
/// @param diags  accumulator for what the build reports: an identifier it cannot
///               place (M5007), with an `unreachable` put in its place.
/// @return       a fresh `CFGProject` with one entry per lowered module.
export build_cfg_project :: fn(lp: LoweredProject, diags: Diagnostic[]) -> CFGProject {
    ctx :: new_project_ctx(lp, diags)
    modules :: MutableMap<string, CFGModule> {}
    for [module_id, m] in lp.modules {
        functions: CFGFunction[]: []
        externs: CFGExternDecl[]: []
        struct_decls: CFGStructDecl[]: []
        for d in m.decls {
            match d {
                is LoweredFnDecl -> {
                    if d.body is null {
                        externs.push(make_extern_decl(d, lp.libraries))
                    } else {
                        cfg_opt :: convert_function(d, ctx)
                        if cfg_opt !is null { functions.push(cfg_opt) }
                    }
                }
                is LoweredStructDecl -> { struct_decls.push(make_struct_decl(d)) }
                is LoweredConstDecl -> {
                    // Inlined-out at lowering time ; nothing to carry forward.
                }
            }
        }
        modules[module_id] = CFGModule {
            .module_id    = m.module_id,
            .display_path = m.display_path,
            .functions    = functions,
            .externs      = externs,
            .struct_decls = struct_decls,
        }
    }
    return CFGProject {
        .modules         = modules,
        .vtable_entries  = lp.vtable_entries,
        .strings         = ctx.strings,
        .data_pool       = convert_data_pool(lp.data_pool),
        .globals         = lp.globals,
        .trait_membership = lp.trait_membership,
    }
}

import "vader/core/bytecode"

// Convert each lower-side `DataPoolEntry` into its bytecode `BcDataEntry`
// variant, at the lower→CFG boundary.
// Primitive arrays reinterpret their `i64` bits as `u64` (`u64(i64)` — the
// runtime reads each element at its natural width, low bits) ; string arrays
// carry their values through to `midir::emit`, which interns them ; aggregate
// arrays recurse over the carried literal into a `BcAggregateData`.
convert_data_pool :: fn(entries: DataPoolEntry[]) -> BcDataEntry[] {
    out: BcDataEntry[]: []
    for e in entries {
        match e {
            is StrDataPoolEntry -> { out.push(BcStrData { .values = e.values }) }
            is PrimDataPoolEntry -> {
                items: u64[]: []
                for v in e.items { items.push(u64(v)) }
                out.push(BcPrimData {
                    .kind  = array_kind_from_name(e.element_type_name),
                    .items = items,
                })
            }
            is AggregateDataPoolEntry -> {
                elements: BcDataValue[]: []
                for el in e.literal.elements { elements.push(lowered_to_bc_value(el)) }
                out.push(BcAggregateData {
                    .element_type_name = e.element_type_name,
                    .elements          = elements,
                })
            }
        }
    }
    return out
}

// Recursively lower one constant literal into a baked `BcDataValue`. Mirrors
// `lower/inline_consts::is_bakeable_value` — the producer only routes shapes this
// handles, so an unexpected node is an internal error (a primitive leaf falls
// through to the `BcValPrim` tail). Struct identity is carried by `symbol_id`
// (resolved to a type-index at each backend) ; arrays/leaves by element kind name.
lowered_to_bc_value :: fn(el: LoweredExpr) -> BcDataValue {
    if el is LoweredStringLit { return BcValStr { .value = el.value } }
    if el is LoweredStructLit {
        fields: BcDataValue[]: []
        for f in el.fields { fields.push(lowered_to_bc_value(f.value)) }
        return BcValStruct { .symbol_id = struct_symbol_id(el.type), .fields = fields }
    }
    if el is LoweredArrayLit {
        elements: BcDataValue[]: []
        for e in el.elements { elements.push(lowered_to_bc_value(e)) }
        return BcValArray { .element_type_name = array_element_name(el.type), .elements = elements }
    }
    name :: representation_name(el.type)
    return BcValPrim { .kind = array_kind_from_name(name), .bits = bc_value_bits(el, name) }
}

// `symbol_id` of a named struct type (the producer rejects non-`StructType`s).
struct_symbol_id :: fn(t: Type) -> i32 {
    if t is StructType { return t.symbol.id }
    return -1
}

// Element type name of an array type, as the backend reads it
// (`representation_name`), for the runtime element kind.
array_element_name :: fn(t: Type) -> string {
    if t is ArrayType { return representation_name(t.element) }
    return ""
}

// Raw `u64` bit pattern of a primitive leaf — int/char/bool verbatim, floats
// reinterpreted via `to_bits` at the element's natural width. Mirrors
// `inline_consts::data_item_bits`.
bc_value_bits :: fn(el: LoweredExpr, name: string) -> u64 {
    if el is LoweredIntLit  { return u64(el.value) }
    if el is LoweredCharLit { return u64(el.value) }
    if el is LoweredBoolLit { return if el.value { 1 } else { 0 } }
    if el is LoweredFloatLit {
        if name == "f32" { return u64(f32(el.value).to_bits()) }
        return el.value.to_bits()
    }
    // Unreachable : the producer's `is_bakeable_value` only admits int/char/bool/
    // float leaves here (string/struct/array are handled before this tail). A hit
    // means the gate and this converter drifted out of sync.
    panic("midir: lowered_to_bc_value reached a non-primitive leaf (is_bakeable/converter drift)")
}


// ============================================================================
// Function-level conversion
// ============================================================================

FnMetadata :: struct {
    extern_name: string
    is_extern:   bool
    /// See `BcImport.c_variadic_fixed`.
    c_variadic_fixed: i32
}

import "toolchain/ast"
import "toolchain/span"

/// Extract source-level metadata bytecode-emit needs to route a fn to
/// imports.
fn_metadata :: fn(d: LoweredFnDecl) -> FnMetadata {
    extern_name := d.mangled
    is_extern := false
    c_variadic_fixed: i32 = -1
    fn_decl :: d.origin.decl
    if fn_decl is FnDecl {
        extern_name = extern_symbol_of(fn_decl)
        // A body is the Vader function an `@extern` taking an enum with variant
        // data lowers to (`lower/extern_values.vader`), not the import.
        is_extern = d.body == null && decorators_have(fn_decl.decorators, "extern")
        c_variadic_fixed = c_variadic_fixed_of(fn_decl.decorators)
    }
    return FnMetadata {
        .extern_name = extern_name,
        .is_extern   = is_extern,
        .c_variadic_fixed = c_variadic_fixed,
    }
}

/// The fixed-argument count a `@c_variadic(N)` declares, or `-1`.
///
/// @param decorators  the declaration's decorators.
c_variadic_fixed_of :: fn(decorators: Decorator[]) -> i32 {
    for d in decorators {
        if d.name == "c_variadic" && d.args.len() == 1 {
            a :: d.args[0]
            if a is IntLitExpr {
                return i32(int_literal_value(a))
            }
        }
    }
    return -1
}

make_struct_decl :: fn(d: LoweredStructDecl) -> CFGStructDecl {
    fields: CFGStructField[]: []
    for f in d.fields {
        fields.push(CFGStructField { .name = f.name, .type = f.type })
    }
    return CFGStructDecl {
        .mangled = d.mangled,
        .fields  = fields,
        .origin  = d.origin,
    }
}

make_extern_decl :: fn(
    d: LoweredFnDecl,
    libraries: MutableMap<i64, CLibrary>,
) -> CFGExternDecl {
    meta :: fn_metadata(d)
    library :: library_of(d, libraries)
    params: CFGParam[]: []
    for i in 0..<d.params.len() {
        p :: d.params[i]
        params.push(CFGParam {
            .name = p.name, .symbol = p.symbol, .type = p.type, .local = LocalId(i32(i)),
        })
    }
    return CFGExternDecl {
        .mangled     = d.mangled,
        .params      = params,
        .return_type = d.return_type,
        .origin      = d.origin,
        .extern_name = meta.extern_name,
        .is_extern   = meta.is_extern,
        .c_header    = header_of(d, library),
        .c_variadic_fixed = meta.c_variadic_fixed,
        .library     = library,
    }
}

// The `CLibrary` the declaration `d` names, or null.
library_of :: fn(
    d: LoweredFnDecl,
    libraries: MutableMap<i64, CLibrary>,
) -> CLibrary | null {
    decl :: d.origin.decl
    if decl is FnDecl {
        return libraries[decl.id]
    }
    return null
}

// The header that owns the prototype of `d` (`extern_header`), or `""`.
header_of :: fn(d: LoweredFnDecl, library: CLibrary | null) -> string {
    decl :: d.origin.decl
    if decl is FnDecl {
        return extern_header(decl, library)
    }
    return ""
}

/// Convert one body-having `LoweredFnDecl` into a `CFGFunction`.
/// Returns `null` for bodyless fns (caller routes them through
/// `make_extern_decl` instead).
convert_function :: fn(d: LoweredFnDecl, project: ProjectCtx) -> CFGFunction | null {
    if d.body is null { return null }
    body :: d.body

    params: CFGParam[]: []
    locals: CFGLocal[]: []
    local_by_sym_id :: MutableMap<i32, LocalId> {}

    // Params occupy local slots 0..N-1.
    for p in d.params {
        slot :: i32(locals.len())
        locals.push(CFGLocal { .name = p.name, .type = p.type, .symbol = p.symbol })
        local_by_sym_id[p.symbol.id] = LocalId(slot)
        params.push(CFGParam {
            .name = p.name, .symbol = p.symbol, .type = p.type, .local = LocalId(slot),
        })
    }

    fn_ctx :: FnCtx {
        .project         = project,
        .mangled         = d.mangled,
        .origin          = d.origin,
        .return_type     = d.return_type,
        .params          = params,
        .locals          = locals,
        .local_by_sym_id = local_by_sym_id,
        .blocks          = [],
        .loop_stack      = [],
        .current         = null,
    }

    entry :: new_block(fn_ctx, body.span)
    fn_ctx.current = entry

    trailing :: build_block_value(fn_ctx, body, d.return_type)

    // Implicit return : if the current block still lacks a terminator,
    // emit one with the trailing expression.
    if fn_ctx.current !is null {
        cur :: fn_ctx.blocks[i64(fn_ctx.current)]
        if cur.terminator is null {
            cur.terminator = TermReturn {
                .values = implicit_return_values(trailing, d.return_type),
                .span = body.span,
            }
        }
    }

    frozen: BasicBlock[]: []
    for b in fn_ctx.blocks { frozen.push(freeze_block(b)) }
    return CFGFunction {
        .mangled     = d.mangled,
        .params      = params,
        .return_type = d.return_type,
        .locals      = fn_ctx.locals,
        .blocks      = frozen,
        .entry       = entry,
        .origin      = d.origin,
    }
}

freeze_block :: fn(b: MutableBlock) -> BasicBlock {
    if b.terminator is null {
        // Defensive : a block escaped without a terminator. Emit
        // Unreachable so downstream passes don't crash.
        return BasicBlock {
            .id = b.id, .instructions = b.instructions, .span = b.span,
            .terminator = TermUnreachable { .reason = "missing terminator", .span = b.span },
        }
    }
    return BasicBlock {
        .id = b.id, .instructions = b.instructions, .span = b.span,
        .terminator = b.terminator,
    }
}

// ============================================================================
// Block / statement / expression builders
// ============================================================================

/// Build a block body. Returns the LocalId carrying the trailing expr's
/// value, held as the block's type (or null when the block is void / control
/// flow ended mid-body).
build_block_body :: fn(fn_ctx: FnCtx, b: LoweredBlock) -> LocalId | null =
    build_block_value(fn_ctx, b, b.type)

// A block's statements, then its trailing value as a slot of type `slot` holds it ;
// null when it has none or control left mid-body.
// A fn that returns nothing hands back no value, even when its body ends on one:
// that last expression was built for its effect.
implicit_return_values :: fn(trailing: LocalId | null, return_type: Type) -> LocalId[] {
    if trailing == null || is_void(return_type) {
        return []
    }
    return [trailing]
}

build_block_value :: fn(fn_ctx: FnCtx, b: LoweredBlock, slot: Type) -> LocalId | null {
    for s in b.stmts {
        if fn_ctx.current is null { return null }
        build_stmt(fn_ctx, s)
    }
    if fn_ctx.current is null { return null }
    if b.trailing is null { return null }
    return build_held(fn_ctx, b.trailing, slot)
}

// Exhaustive over `LoweredStmt` (a closed compiler union) so a new variant trips
// T3013 here rather than being silently dropped — the coroutine markers below
// were exactly such a silent drop (midir-1).
build_stmt :: fn(fn_ctx: FnCtx, s: LoweredStmt) -> void {
    match s {
        is LoweredLet -> {
            v :: s.value
            if is_dest_passing_shape(v) {
                // Destination-passing : declare the slot first and build the
                // value-`if` / `match` / `&&` `||` straight into it — no
                // intermediate result temp, no copy. Only these join-slot shapes
                // take this path, so a plain `let` keeps its build-then-bind slot
                // order (declaring first would renumber every let's slots).
                dst :: declare_local(fn_ctx, s.name, s.type, s.symbol)
                fn_ctx.local_by_sym_id[s.symbol.id] = dst
                if fn_ctx.current !is null {
                    build_expr_into(fn_ctx, v, dst)
                }
            } else {
                value_local :: build_held(fn_ctx, v, s.type)
                dst :: declare_local(fn_ctx, s.name, s.type, s.symbol)
                fn_ctx.local_by_sym_id[s.symbol.id] = dst
                if value_local !is null {
                    if fn_ctx.current !is null {
                        emit(fn_ctx, InstrMove { .dst = dst, .src = value_local, .span = s.span })
                    }
                }
            }
        }
        is LoweredAssign -> { build_assign(fn_ctx, s) }
        is LoweredGlobalSet -> {
            value :: build_held(fn_ctx, s.value, fn_ctx.project.globals[s.slot].type)
            if value !is null {
                emit(fn_ctx, InstrGlobalSet {
                    .span = s.span,
                    .slot = i32(s.slot),
                    .value = value,
                    .type = fn_ctx.project.globals[s.slot].type,
                })
            }
        }
        is LoweredCellSet -> {
            cell :: build_expr(fn_ctx, s.target)
            value :: build_held(fn_ctx, s.value, s.value_type)
            if cell !is null {
                if value !is null {
                    emit(fn_ctx, InstrCellSet {
                        .cell = cell, .value = value, .value_type = s.value_type, .span = s.span,
                    })
                }
            }
        }
        is LoweredDeferPush -> {
            // `thunk` builds to a closure (make-closure) in `value` ; push it onto
            // the frame's defer-stack. Drained by `InstrDeferPopExec` at each exit.
            value :: build_expr(fn_ctx, s.thunk)
            if value !is null {
                emit(fn_ctx, InstrDeferPush { .value = value, .span = s.span })
            }
        }
        is LoweredDeferPopExec -> {
            emit(fn_ctx, InstrDeferPopExec { .count = s.count, .span = s.span })
        }
        is LoweredExprStmt -> {
            // Side-effect only: the resulting local is discarded.
            build_expr(fn_ctx, s.expr)
        }
        is LoweredReturn -> {
            values: LocalId[]: []
            if s.value !is null {
                // A value that produced no local (control left inside it) is none.
                built :: build_held(fn_ctx, s.value, fn_ctx.return_type)
                if built != null {
                    values.push(built)
                }
            }
            terminate(fn_ctx, TermReturn { .values = values, .span = s.span })
        }
        is LoweredLoop -> { build_loop(fn_ctx, s) }
        is LoweredLabelledBlock -> { build_labelled_block(fn_ctx, s) }
        is LoweredBreak -> {
            frame :: resolve_loop_frame(fn_ctx, s.label)
            terminate(fn_ctx, TermBranch { .target = frame.exit_id, .span = s.span })
        }
        is LoweredContinue -> {
            build_back_edge(fn_ctx, resolve_loop_frame(fn_ctx, s.label), s.span)
        }
        is LoweredYield | LoweredAwait -> {
            // Transient coroutine-suspension markers. The coroutine transform
            // (`lower/coroutine.vader`) rewrites them into the resumable state
            // machine BEFORE midir ; reaching one here means that pass missed it.
            // Panic loudly rather than silently drop it (which miscompiled the
            // async / generator path — midir-1).
            panic("midir: coroutine marker (LoweredYield/LoweredAwait) reached build_stmt, so the coroutine transform missed it")
        }
    }
}

build_assign :: fn(fn_ctx: FnCtx, s: LoweredAssign) -> void {
    target :: s.target
    if target is LoweredIdent {
        slot_opt :: fn_ctx.local_by_sym_id[target.symbol.id]
        // Reported as a read of such a name is (`build_ident`), not dropped.
        if slot_opt is null {
            fn_ctx.project.diags.push(lower_error(.UnresolvedIdent, target.span,
                "`${target.symbol.name}` is assigned but has no local in this function: " +
                    "the typecheck should have refused it (T3041)"))
            return
        }
        value :: build_held(fn_ctx, s.value, fn_ctx.locals[i64(slot_opt)].type) ?? return
        emit(fn_ctx, InstrMove { .dst = slot_opt, .src = value, .span = s.span })
        return
    }
    if target is LoweredFieldAccess {
        tgt :: build_expr(fn_ctx, target.target)
        value :: build_held(fn_ctx, s.value, place_slot(fn_ctx, tgt, target))
        if tgt is null { return }
        if value is null { return }
        emit(fn_ctx, InstrFieldSet {
            .target = tgt, .field = target.field, .value = value,
            .barrierless = false, .span = s.span,
        })
        return
    }
    if target is LoweredUnionField {
        tgt :: build_expr(fn_ctx, target.target)
        value :: build_held(fn_ctx, s.value, place_slot(fn_ctx, tgt, target))
        if tgt == null || value == null {
            return
        }
        emit(fn_ctx, InstrUnionFieldSet {
            .span = s.span,
            .target = tgt,
            .field = target.field,
            .value = value,
        })
        return
    }
    if target is LoweredIndex {
        tgt :: build_expr(fn_ctx, target.target)
        idx :: build_expr(fn_ctx, target.index)
        value :: build_held(fn_ctx, s.value, place_slot(fn_ctx, tgt, target))
        if tgt is null { return }
        if idx is null { return }
        if value is null { return }
        emit(fn_ctx, InstrArraySet {
            .target = tgt, .index = idx, .value = value, .span = s.span,
            .bounds_safe = target.bounds_safe,
        })
        return
    }
    panic("midir/build: assignment to something that is no place in `${fn_ctx.mangled}`: " +
        "typecheck should have refused it (T3082)")
}

// The type the place `place` holds a value as, `holder` the local holding it : the
// field or element as its holder lays it out, else the type the lowering gave the
// place.
place_slot :: fn(
    fn_ctx: FnCtx,
    holder: LocalId | null,
    place: LoweredFieldAccess | LoweredUnionField | LoweredIndex,
) -> Type {
    held :: holder ?? return place.type
    holder_type :: fn_ctx.locals[i64(held)].type
    slots :: fn_ctx.project.slots
    laid_out :: match place {
        is LoweredFieldAccess -> field_slot(slots, holder_type, place.field)
        is LoweredUnionField  -> field_slot(slots, holder_type, place.field)
        is LoweredIndex       -> element_slot(holder_type)
    }
    return laid_out ?? place.type
}

// A loop with no condition starts its body in its header. A header that only
// forwards to the body has no test of its own: the C emitter could not write
// the loop as a `while` when its body opens with `if c { break }`.
build_loop :: fn(fn_ctx: FnCtx, s: LoweredLoop) -> void {
    header_id :: new_block(fn_ctx, s.span)
    exit_id :: new_block(fn_ctx, s.span)

    if fn_ctx.current !is null {
        terminate(fn_ctx, TermBranch { .target = header_id, .span = s.span })
    }

    fn_ctx.current = header_id
    cond :: s.cond
    if cond !is null {
        body_id :: new_block(fn_ctx, s.body.span)
        split :: operand_edges(cond).on_true < 2
        if !branch_on_cond(fn_ctx, cond, body_id, exit_id, split).on_true {
            terminate(fn_ctx, TermBranch { .target = exit_id, .span = s.span })
        }
        fn_ctx.current = body_id
    }

    frame :: LoopFrame {
        .label = s.label, .header_id = header_id, .exit_id = exit_id, .step = s.step,
    }
    fn_ctx.loop_stack.push(frame)
    build_block_body(fn_ctx, s.body)
    if fn_ctx.current !is null {
        build_back_edge(fn_ctx, frame, s.span)
    }
    // pop loop frame
    new_stack: LoopFrame[]: []
    for i in 0..<fn_ctx.loop_stack.len() - 1 {
        new_stack.push(fn_ctx.loop_stack[i])
    }
    fn_ctx.loop_stack = new_stack

    fn_ctx.current = exit_id
}

// The body, then the exit a `break <label>` reaches early. The region is recorded:
// nothing in the CFG says where the `block` that jump leaves has to open.
build_labelled_block :: fn(fn_ctx: FnCtx, s: LoweredLabelledBlock) -> void {
    entry_id :: new_block(fn_ctx, s.span)
    exit_id :: new_block(fn_ctx, s.span)
    if fn_ctx.current !is null {
        terminate(fn_ctx, TermBranch { .target = entry_id, .span = s.span })
    }
    fn_ctx.loop_stack.push(LoopFrame {
        .label = s.label, .header_id = exit_id, .exit_id = exit_id, .step = [], .block = true,
    })
    fn_ctx.current = entry_id
    build_block_body(fn_ctx, s.body)
    if fn_ctx.current !is null {
        terminate(fn_ctx, TermBranch { .target = exit_id, .span = s.span })
    }
    fn_ctx.loop_stack.remove_last()
    fn_ctx.current = exit_id
}

// Run `frame`'s step, then go back to its header. Each jump builds its own copy:
// one step block every `continue` reaches is a latch, which the structurer takes
// for the join of the conditional around the `continue`.
build_back_edge :: fn(fn_ctx: FnCtx, frame: LoopFrame, span: Span) -> void {
    for st in frame.step {
        build_stmt(fn_ctx, st)
    }
    if fn_ctx.current !is null {
        terminate(fn_ctx, TermBranch { .target = frame.header_id, .span = span })
    }
}

// The loop a `break` / `continue` targets. The typechecker refuses a jump with no
// loop to reach (T3015, T3067), so one that finds none here is a lowering bug —
// dropping it would compile the jump as falling through. A bare jump looks past a
// labelled block: only a `break` naming it reaches it.
resolve_loop_frame :: fn(fn_ctx: FnCtx, label: string | null) -> LoopFrame {
    if label is null {
        j := fn_ctx.loop_stack.len() - 1
        for j >= 0 {
            frame :: fn_ctx.loop_stack[j]
            if !frame.block { return frame }
            j -= 1
        }
        panic("midir/build: `${fn_ctx.mangled}` has a `break` / `continue` outside any loop")
    }
    // Extract the non-null label once — the c-emit's `string | null`
    // comparison currently mis-boxes when crossing a field vs a param
    // boundary ; comparing two `string` locals is unambiguous.
    needle :: label
    i := fn_ctx.loop_stack.len() - 1
    for i >= 0 {
        frame :: fn_ctx.loop_stack[i]
        if frame.label !is null {
            if frame.label == needle { return frame }
        }
        i -= 1
    }
    panic("midir/build: `${fn_ctx.mangled}` jumps to a loop labelled `${needle}` "
        + "that no enclosing loop carries")
}

// ============================================================================
// Expression conversion
// ============================================================================

build_expr :: fn(fn_ctx: FnCtx, e: LoweredExpr) -> LocalId | null {
    if fn_ctx.current is null { return null }
    match e {
        is LoweredIntLit    -> { return emit_const(fn_ctx, e.type, ConstInt { .value = e.value }, e.span) }
        is LoweredFloatLit  -> { return emit_const(fn_ctx, e.type, ConstFloat { .value = e.value }, e.span) }
        is LoweredBoolLit   -> { return emit_const(fn_ctx, e.type, ConstBool { .value = e.value }, e.span) }
        is LoweredNullLit   -> { return emit_const(fn_ctx, e.type, ConstNull {}, e.span) }
        is LoweredCharLit   -> { return emit_const(fn_ctx, e.type, ConstChar { .value = i32(u32(e.value)) }, e.span) }
        is LoweredStringLit -> {
            idx :: intern_string_pool(fn_ctx.project, e.value)
            return emit_const(fn_ctx, e.type, ConstString { .index = idx }, e.span)
        }
        is LoweredIdent         -> { return build_ident(fn_ctx, e) }
        is LoweredCall          -> { return build_call(fn_ctx, e) }
        is LoweredVirtualCall   -> { return build_virtual_call(fn_ctx, e) }
        is LoweredFieldAccess   -> { return build_field_access(fn_ctx, e) }
        is LoweredUnionField    -> { return build_union_field(fn_ctx, e) }
        is LoweredIndex         -> { return build_index(fn_ctx, e) }
        is LoweredUnary         -> { return build_unary(fn_ctx, e) }
        is LoweredBinary        -> { return build_binary(fn_ctx, e) }
        is LoweredIf            -> { return build_if(fn_ctx, e, null) }
        is LoweredBlock         -> { return build_block_body(fn_ctx, e) }
        is LoweredStructLit     -> { return build_struct_lit(fn_ctx, e) }
        is LoweredArrayLit      -> { return build_array_lit(fn_ctx, e) }
        is LoweredCast          -> { return build_cast(fn_ctx, e) }
        is LoweredTypeCheck     -> { return build_type_check(fn_ctx, e) }
        is LoweredUnreachable   -> { return build_unreachable_type(fn_ctx, e.type, e.span, e.reason) }
        is LoweredIntrinsicCall -> { return build_intrinsic_call(fn_ctx, e) }
        is LoweredArrayLen      -> { return build_array_len(fn_ctx, e) }
        is LoweredArrayPush     -> { return build_array_push(fn_ctx, e) }
        is LoweredArraySlice    -> { return build_array_slice(fn_ctx, e) }
        is LoweredCellNew       -> { return build_cell_new(fn_ctx, e) }
        is LoweredCellGet       -> { return build_cell_get(fn_ctx, e) }
        is LoweredMakeClosure   -> { return build_make_closure(fn_ctx, e) }
        is LoweredDataConst     -> { return build_data_const(fn_ctx, e) }
        is LoweredGlobalGet     -> { return build_global_get(fn_ctx, e) }
        is LoweredTypeConst     -> { return build_type_const(fn_ctx, e) }
    }
}

build_type_const :: fn(fn_ctx: FnCtx, e: LoweredTypeConst) -> LocalId | null {
    dst :: fresh_tmp(fn_ctx, "type_const", e.type)
    emit(fn_ctx, InstrTypeConst { .dst = dst, .type = e.type, .value_type = e.value, .span = e.span })
    return dst
}

// The value `e` reads, as it is stored : its local's slot, or what
// `build_module_ident` builds for an ident with none.
stored_ident :: fn(fn_ctx: FnCtx, e: LoweredIdent) -> LocalId | null {
    local :: fn_ctx.local_by_sym_id[e.symbol.id]
    if local != null {
        return stored_slot(fn_ctx, local, e)
    }
    value :: build_module_ident(fn_ctx, e) ?? return null
    return stored_slot(fn_ctx, value, e)
}

// The slot `slot` the ident `e` reads, as it stores it : itself, or, where the read
// narrows a union to a variant, the variant recovered.
stored_slot :: fn(fn_ctx: FnCtx, slot: LocalId, e: LoweredIdent) -> LocalId {
    slot_type :: fn_ctx.locals[i64(slot)].type
    if slot_type is UnionType && !equals_type(slot_type, e.type) {
        return cast_local(fn_ctx, slot, e.type, "narrow", e.span)
    }
    return slot
}

build_ident :: fn(fn_ctx: FnCtx, e: LoweredIdent) -> LocalId | null {
    stored :: stored_ident(fn_ctx, e) ?? return null
    return read_as(fn_ctx, stored, e.type, e.span)
}

// The value of an ident with no local in this function, at the type its
// declaration gives it : a function reference, or a module constant. A constant
// arrives at its declared type, so a read the typecheck narrowed still takes the
// variant out of it (`stored_slot`). The `inline_consts` pass routed every
// non-scalar const either to a synthetic accessor fn (fn-wrap) or to an inlined
// value. A fn-wrapped const lowers to a 0-arg `call` ; an inline const re-builds
// its value here. (Scalar consts usually fold in `lower_ident` upstream, but the
// inline map catches any that didn't.)
build_module_ident :: fn(fn_ctx: FnCtx, e: LoweredIdent) -> LocalId | null {
    if e.symbol.kind == .Fn {
        dst :: fresh_tmp(fn_ctx, "fn_ref", e.type)
        emit(fn_ctx, InstrFnRef {
            .dst = dst, .fn_symbol = e.symbol, .type = e.type, .span = e.span,
        })
        return dst
    }
    wrap :: const_accessor(fn_ctx, e)
    if wrap is ConstFnWrap {
        dst :: fresh_tmp(fn_ctx, "const_init", wrap.call_type)
        no_args: LocalId[]: []
        emit(fn_ctx, InstrCall {
            .dsts = [dst],
            .callee = wrap.fn_symbol,
            .args = no_args,
            .type = wrap.call_type,
            .span = e.span,
        })
        return dst
    }
    inline_value :: fn_ctx.project.const_inline[e.symbol.id]
    if inline_value !is null { return build_expr(fn_ctx, inline_value) }
    fn_ctx.project.diags.push(lower_error(
        .UnresolvedIdent, e.span,
        "`${e.symbol.name}` resolved to a symbol with no local in this function, so a binding was lost between the resolver and here"))
    return build_unreachable_type(fn_ctx, e.type, e.span, "unresolved ident ${e.symbol.name}")
}

// The accessor a read of const `e` calls: for a use that must not share a value of
// the data pool, the one that builds it again ; otherwise the const's own, when
// the lowering wrapped it.
const_accessor :: fn(fn_ctx: FnCtx, e: LoweredIdent) -> ConstFnWrap | null {
    if e.fresh {
        fresh :: fn_ctx.project.const_fresh_wrap[e.symbol.id]
        if fresh != null {
            return fresh
        }
    }
    return fn_ctx.project.const_fn_wrap[e.symbol.id]
}

build_call :: fn(fn_ctx: FnCtx, e: LoweredCall) -> LocalId | null {
    callee_id :: e.callee
    if callee_id is LoweredIdent {
        if callee_id.symbol.kind == .Fn {
            slots :: fn_ctx.project.extern_callbacks[callee_id.symbol.id]
            params :: params_of(fn_ctx.project.slots, callee_id.symbol)
            args :: if slots is MutableSet<i64> {
                build_extern_args(fn_ctx, e.args, params, slots, callee_id.symbol.name) ?? return null
            } else {
                build_args(fn_ctx, e.args, params) ?? return null
            }
            dst :: if is_void(e.type) || e.type is NeverType { null } else { fresh_tmp(fn_ctx, "call", e.type) }
            emit(fn_ctx, InstrCall {
                .dsts = if dst == null { [] } else { [dst] },
                .callee = callee_id.symbol,
                .args = args,
                .type = e.type,
                .span = e.span,
            })
            return end_after_no_return(fn_ctx, e, dst)
        }
    }
    callee :: build_expr(fn_ctx, e.callee) ?? return null
    args :: build_args(fn_ctx, e.args, param_types_of(e.callee.type)) ?? return null
    dst :: if is_void(e.type) || e.type is NeverType { null } else { fresh_tmp(fn_ctx, "call_ind", e.type) }
    emit(fn_ctx, InstrCallIndirect {
        .dst = dst, .callee = callee, .args = args,
        .fn_type = e.callee.type, .type = e.type, .span = e.span,
    })
    return end_after_no_return(fn_ctx, e, dst)
}

// A call typed `never` does not come back: it gets no result slot, and the block
// ends there, so nothing is emitted for a result it never produces (the `drop` of
// a statement call, the `return` of a `-> never` body). `null` is the builder's
// "this path diverged".
end_after_no_return :: fn(fn_ctx: FnCtx, e: LoweredCall, dst: LocalId | null) -> LocalId | null {
    if e.type is NeverType {
        terminate(fn_ctx, TermUnreachable { .reason = "a no-return call returned", .span = e.span })
        return null
    }
    return dst
}

/// Arguments of an `@extern` call, where a fn-typed parameter is a CALLBACK.
///
/// A foreign callee receives the function's ADDRESS, not a Vader fn value — see
/// `core/bytecode/op::FnAddr`. Only a direct reference to a named fn can supply one.
///
/// This is the AUTHORITY, and it refuses rather than degrading: falling back to
/// a fn value here would hand C a `vader_fn_t` to jump into, which is a wild
/// pointer no test distinguishes from a passing one.
/// `front/typecheck/call::reject_indirect_callbacks` reports the same condition where
/// the user can read it; reaching the panic means it missed a shape.
///
/// @param fn_ctx  the function being built.
/// @param args    the call's arguments.
/// @param slots   parameter indices that are callbacks, from the DECLARATION.
/// @param callee  the callee's name, for the failure message.
build_extern_args :: fn(
    fn_ctx: FnCtx,
    args: LoweredExpr[],
    params: Type[],
    slots: MutableSet<i64>,
    callee: string,
) -> LocalId[] | null {
    out: LocalId[]: []
    for i in 0..<args.len() {
        a :: args[i]
        if !slots.contains(i) {
            local :: build_held(fn_ctx, a, type_at(params, i)) ?? return null
            out.push(local)
            continue
        }
        if a !is LoweredIdent {
            panic("midir/build: argument ${i + 1} of `${callee}` is a callback that names no function. Typecheck should have refused it (T3080)")
        }
        if a.symbol.kind != .Fn {
            panic("midir/build: argument ${i + 1} of `${callee}` names `${a.symbol.name}`, which is not a function. Typecheck should have refused it (T3080)")
        }
        // `TY_CPOINTER`, not the fn type. The slot holds a `.text` address, and
        // a fn-typed slot is a `ValType.Ref` — which `c_emit` puts in the frame's
        // `raw[]`, where `vader_gc_scan_raw` dereferences it as an object header
        // with no heap-membership check. `emit_fn_addr` makes the same choice for
        // the temp; a slot is the other half of it.
        dst :: fresh_tmp(fn_ctx, "fn_addr", TY_CPOINTER)
        emit(fn_ctx, InstrFnAddr {
            .dst = dst, .fn_symbol = a.symbol, .type = a.type, .span = a.span,
        })
        out.push(dst)
    }
    return out
}

// Each of `args` as the parameter of `params` it fills holds it, where known.
build_args :: fn(fn_ctx: FnCtx, args: LoweredExpr[], params: Type[]) -> LocalId[] | null {
    out: LocalId[]: []
    for i in 0..<args.len() {
        local :: build_held(fn_ctx, args[i], type_at(params, i)) ?? return null
        out.push(local)
    }
    return out
}

build_virtual_call :: fn(fn_ctx: FnCtx, e: LoweredVirtualCall) -> LocalId | null {
    receiver :: build_expr(fn_ctx, e.receiver) ?? return null
    args :: build_args(fn_ctx, e.args, e.param_types) ?? return null
    dst :: if is_void(e.type) { null } else { fresh_tmp(fn_ctx, "vcall", e.type) }
    emit(fn_ctx, InstrVirtualCall {
        .dst = dst, .trait_name = e.trait_name, .method = e.method,
        .receiver = receiver, .args = args, .type = e.type, .span = e.span,
        .param_types = e.param_types,
    })
    return dst
}

build_field_access :: fn(fn_ctx: FnCtx, e: LoweredFieldAccess) -> LocalId | null {
    stored :: stored_field(fn_ctx, e) ?? return null
    return read_as(fn_ctx, stored, e.type, e.span)
}

// The field `e` reads, as its holder stores it (`field_read_type`).
stored_field :: fn(fn_ctx: FnCtx, e: LoweredFieldAccess) -> LocalId | null {
    target :: build_expr(fn_ctx, e.target) ?? return null
    read :: field_read_type(fn_ctx, target, e)
    dst :: fresh_tmp(fn_ctx, "field", read)
    emit(fn_ctx, InstrFieldGet {
        .dst = dst, .target = target, .field = e.field, .type = read, .span = e.span,
    })
    return dst
}

build_union_field :: fn(fn_ctx: FnCtx, e: LoweredUnionField) -> LocalId | null {
    stored :: stored_union_field(fn_ctx, e) ?? return null
    return read_as(fn_ctx, stored, e.type, e.span)
}

// The common field `e` reads, as its holder stores it (`field_read_type`).
stored_union_field :: fn(fn_ctx: FnCtx, e: LoweredUnionField) -> LocalId | null {
    target :: build_expr(fn_ctx, e.target) ?? return null
    read :: field_read_type(fn_ctx, target, e)
    dst :: fresh_tmp(fn_ctx, "field", read)
    emit(fn_ctx, InstrUnionFieldGet {
        .span = e.span,
        .dst = dst,
        .target = target,
        .type = read,
        .field = e.field,
    })
    return dst
}

// The type the field `place` of `holder` is read at : the field's own as its holder
// lays it out when the read narrows it to a range held in another integer
// (`read_type`), else the read's.
field_read_type :: fn(
    fn_ctx: FnCtx,
    holder: LocalId,
    place: LoweredFieldAccess | LoweredUnionField,
) -> Type {
    if !is_stored_as_integer(place.type) {
        return place.type
    }
    return read_type(place_slot(fn_ctx, holder, place), place.type)
}

build_index :: fn(fn_ctx: FnCtx, e: LoweredIndex) -> LocalId | null {
    target :: build_expr(fn_ctx, e.target)
    index :: build_expr(fn_ctx, e.index)
    if target is null { return null }
    if index is null { return null }
    dst :: fresh_tmp(fn_ctx, "idx", e.type)
    emit(fn_ctx, InstrArrayGet {
        .dst = dst, .target = target, .index = index, .type = e.type, .span = e.span,
        .bounds_safe = e.bounds_safe,
    })
    return dst
}

// A unary operation is computed in an integer holding its operand's values and its
// result's (`computation_width`) : `-h` on an `Hour` is an `i8`, then held as the
// result's integer.
build_unary :: fn(fn_ctx: FnCtx, e: LoweredUnary) -> LocalId | null {
    width :: computation_width(e.operand.type, null, e.type)
    operand :: build_held(fn_ctx, e.operand, width) ?? return null
    computed :: computed_type(e.type, width)
    dst :: fresh_tmp(fn_ctx, "unop", computed)
    emit(fn_ctx, InstrUnOp {
        .dst = dst, .op = e.op, .operand = operand, .type = computed, .span = e.span,
    })
    return held_in(fn_ctx, dst, e.type, e.span)
}

// A binary operation is computed in an integer holding both operands' values and
// its result's (`binary_width`), each operand converted to it as it is built ;
// the result is then held as its own type's integer.
build_binary :: fn(fn_ctx: FnCtx, e: LoweredBinary) -> LocalId | null {
    if is_short_circuit_op(e.op) { return build_short_circuit(fn_ctx, e, null) }
    width :: binary_width(fn_ctx, e)
    lhs :: build_held(fn_ctx, e.left, width) ?? return null
    rhs :: build_held(fn_ctx, e.right, width) ?? return null
    computed :: computed_type(e.type, width)
    dst :: fresh_tmp(fn_ctx, binary_op_name(e.op), computed)
    emit(fn_ctx, InstrBinOp {
        .dst = dst, .op = e.op, .lhs = lhs, .rhs = rhs, .type = computed, .span = e.span,
    })
    return held_in(fn_ctx, dst, e.type, e.span)
}

// The integer `e` is computed in (`computation_width`) ; a test of a narrowed local
// against a constant compares in the integer the local is stored in (`stored_test`),
// so the local is read as it is stored.
binary_width :: fn(fn_ctx: FnCtx, e: LoweredBinary) -> RangeType | null {
    if !is_stored_as_integer(e.type) {
        stored :: stored_test(fn_ctx, e)
        if stored != null {
            return stored
        }
    }
    return computation_width(e.left.type, e.right.type, e.type)
}

// The integer the test `e` compares in when one operand is a constant and the other
// a local the typecheck narrowed (`narrowed_local_width`) ; null otherwise.
stored_test :: fn(fn_ctx: FnCtx, e: LoweredBinary) -> RangeType | null {
    if e.right is LoweredIntLit {
        return narrowed_local_width(fn_ctx, e.left, e.right.type)
    }
    if e.left is LoweredIntLit {
        return narrowed_local_width(fn_ctx, e.right, e.left.type)
    }
    return null
}

// The integer holding `e`, a local the typecheck narrowed to a range held in another
// integer, as it is stored, and a constant of type `constant` ; null when `e` is no
// such local.
narrowed_local_width :: fn(fn_ctx: FnCtx, e: LoweredExpr, constant: Type) -> RangeType | null {
    if e !is LoweredIdent {
        return null
    }
    slot :: fn_ctx.local_by_sym_id[e.symbol.id] ?? return null
    stored :: fn_ctx.locals[i64(slot)].type
    if !narrowed_read(stored, e.type) {
        return null
    }
    held :: held_integer(stored) ?? return null
    return computation_width(stored, constant, TY_BOOL) ?? machine_integer_type(held)
}

build_short_circuit :: fn(fn_ctx: FnCtx, e: LoweredBinary, dest: LocalId | null) -> LocalId | null {
    lhs :: build_expr(fn_ctx, e.left) ?? return null

    is_and :: e.op == .And
    // Destination-passing : `&&` / `||` is a phi-slot builder like `build_if`
    // (its result is written from both branches, read after the join), so when a
    // `dest` is supplied write straight into it — no `and_res` / `or_res` temp,
    // no copy at the `let x = a && b` / `if c { a && b }` use site.
    result :: if dest !is null {
        dest
    } else {
        declare_local(fn_ctx, if is_and { "and_res" } else { "or_res" }, e.type, null)
    }

    then_id :: new_block(fn_ctx, e.right.span)
    else_id :: new_block(fn_ctx, e.right.span)
    join_id :: new_block(fn_ctx, e.span)

    terminate(fn_ctx, TermCondBranch {
        .cond = lhs,
        .then_block = then_id,
        .else_block = else_id,
        .span = e.span,
    })

    fn_ctx.current = then_id
    if is_and {
        rhs :: build_expr(fn_ctx, e.right)
        if rhs !is null {
            if fn_ctx.current !is null {
                emit(fn_ctx, InstrMove { .dst = result, .src = rhs, .span = e.right.span })
            }
        }
    } else {
        true_local :: fresh_tmp(fn_ctx, "k", e.type)
        emit(fn_ctx, InstrConst {
            .dst = true_local, .value = ConstBool { .value = true },
            .type = e.type, .span = e.span,
        })
        emit(fn_ctx, InstrMove { .dst = result, .src = true_local, .span = e.span })
    }
    if fn_ctx.current !is null {
        terminate(fn_ctx, TermBranch { .target = join_id, .span = e.span })
    }

    fn_ctx.current = else_id
    if is_and {
        false_local :: fresh_tmp(fn_ctx, "k", e.type)
        emit(fn_ctx, InstrConst {
            .dst = false_local, .value = ConstBool { .value = false },
            .type = e.type, .span = e.span,
        })
        emit(fn_ctx, InstrMove { .dst = result, .src = false_local, .span = e.span })
    } else {
        rhs :: build_expr(fn_ctx, e.right)
        if rhs !is null {
            if fn_ctx.current !is null {
                emit(fn_ctx, InstrMove { .dst = result, .src = rhs, .span = e.right.span })
            }
        }
    }
    if fn_ctx.current !is null {
        terminate(fn_ctx, TermBranch { .target = join_id, .span = e.span })
    }

    fn_ctx.current = join_id
    return result
}

// True for the shapes that build their result through a cross-block join —
// `if` / `match` (if-chains, `if_res`), blocks that end in one, and short-circuit
// `&&` / `||` (`and_res` / `or_res`). These are the phi-slot builders whose
// result slot `build_expr_into` can supply, so a `let x = <shape>` writes
// straight into the binding rather than a temp + copy. Single source of truth
// for the shape set — `build_expr_into`'s dispatch below mirrors it.
is_dest_passing_shape :: fn(e: LoweredExpr) -> bool {
    if e is LoweredIf | LoweredBlock {
        return true
    }
    if e is LoweredBinary {
        return is_short_circuit_op(e.op)
    }
    return false
}

is_short_circuit_op :: fn(op: LoweredBinaryOp) -> bool = op == .And || op == .Or

// Destination-passing : build `e` so its value lands in `dest` (a pre-existing
// slot), eliding the intermediate temp + copy where the shape allows. A value
// `if` / `match` / short-circuit `&&` `||` writes its arms straight into `dest` ;
// anything else is built normally and moved once. This is what collapses a
// value-`match`'s per-arm `if_res` slots onto one, and it is shape-independent :
// any nesting of if / block / match is handled by the mutual recursion rather
// than a structural pattern-match on the lowerer output. The special-cased set
// mirrors `is_dest_passing_shape`.
build_expr_into :: fn(fn_ctx: FnCtx, e: LoweredExpr, dest: LocalId) -> void {
    // No `current is null` early-return here : `build_expr` below (and `build_if`
    // / `build_block_into`) already handle a departed block, and narrowing
    // `current` up front would make the post-`build_expr` re-check read as dead.
    if e is LoweredIf {
        build_if(fn_ctx, e, dest)
        return
    }
    if e is LoweredBlock {
        build_block_into(fn_ctx, e, dest)
        return
    }
    if e is LoweredBinary {
        if is_short_circuit_op(e.op) {
            build_short_circuit(fn_ctx, e, dest)
            return
        }
    }
    val :: build_held(fn_ctx, e, fn_ctx.locals[i64(dest)].type)
    if fn_ctx.current !is null && val !is null {
        emit(fn_ctx, InstrMove { .dst = dest, .src = val, .span = e.span })
    }
}

// A block built in destination-passing position : its statements run, then its
// trailing value lands in `dest`.
build_block_into :: fn(fn_ctx: FnCtx, b: LoweredBlock, dest: LocalId) -> void {
    for s in b.stmts {
        if fn_ctx.current is null {
            return
        }
        build_stmt(fn_ctx, s)
    }
    if fn_ctx.current is null {
        return
    }
    if b.trailing !is null {
        build_expr_into(fn_ctx, b.trailing, dest)
    }
}

// Build one `if`-arm block : route its value into `result` when the `if` is
// value-typed (so a nested value-if / match arm coalesces onto `result` instead
// of allocating its own slot), else just run it for effect.
build_if_arm :: fn(fn_ctx: FnCtx, block: LoweredBlock, result: LocalId | null) -> void {
    if result !is null {
        build_block_into(fn_ctx, block, result)
    } else {
        build_block_body(fn_ctx, block)
    }
}

// An `if` branches on each operand of an `&&`, `||` or `!` condition in turn —
// `a && b` tests `a`, then `b`, with no `and_res` slot to fill and test again —
// unless two tests would share a target the C emitter can only reach by a
// `goto`: a then-arm that does not leave at once, behind an `||`, or an else-arm
// behind an `&&`. With no `else`, a false condition goes straight to the join.
// Rationale and measurements: `docs/adr/0028`.
build_if :: fn(fn_ctx: FnCtx, e: LoweredIf, dest: LocalId | null) -> LocalId | null {
    result :: if dest !is null {
        dest
    } else if is_void(e.type) {
        null
    } else {
        declare_local(fn_ctx, "if_res", e.type, null)
    }
    else_block :: e.else_block
    then_id :: new_block(fn_ctx, e.then_block.span)
    join_id :: new_block(fn_ctx, e.span)
    else_id :: if else_block != null { new_block(fn_ctx, else_block.span) } else { join_id }
    edges :: operand_edges(e.cond)
    leaves :: only_leaves(e.then_block)
    split :: (edges.on_true < 2 || leaves) && (edges.on_false < 2 || else_block == null || leaves)
    reach :: branch_on_cond(fn_ctx, e.cond, then_id, else_id, split)
    if !reach.on_true && !reach.on_false {
        return null
    }
    if reach.on_true {
        fn_ctx.current = then_id
        build_if_arm(fn_ctx, e.then_block, result)
        terminate(fn_ctx, TermBranch { .target = join_id, .span = e.then_block.span })
    }
    if else_block != null && reach.on_false {
        fn_ctx.current = else_id
        build_if_arm(fn_ctx, else_block, result)
        terminate(fn_ctx, TermBranch { .target = join_id, .span = else_block.span })
    }
    fn_ctx.current = join_id
    return result
}

/// Which of a condition's two targets control can reach.
CondReach :: struct {
    on_true: bool
    on_false: bool
}

// Branch to `on_true` when `cond` holds and to `on_false` otherwise, swapping the
// targets under a `!`. With `split`, each operand of an `&&` or `||` is tested in
// turn; without, it is evaluated as a value and tested once. An operand that
// diverges leaves a target unreachable — `a || <diverges>` still reaches
// `on_true` through `a`.
branch_on_cond :: fn(
    fn_ctx: FnCtx,
    cond: LoweredExpr,
    on_true: BlockId,
    on_false: BlockId,
    split: bool,
) -> CondReach {
    if cond is LoweredUnary && cond.op == .Not {
        swapped :: branch_on_cond(fn_ctx, cond.operand, on_false, on_true, split)
        return CondReach { .on_true = swapped.on_false, .on_false = swapped.on_true }
    }
    if split && cond is LoweredBinary && is_short_circuit_op(cond.op) {
        next :: new_block(fn_ctx, cond.right.span)
        if cond.op == .And {
            left :: branch_on_cond(fn_ctx, cond.left, next, on_false, split)
            if !left.on_true {
                return left
            }
            fn_ctx.current = next
            right :: branch_on_cond(fn_ctx, cond.right, on_true, on_false, split)
            return CondReach {
                .on_true = right.on_true,
                .on_false = left.on_false || right.on_false,
            }
        }
        left :: branch_on_cond(fn_ctx, cond.left, on_true, next, split)
        if !left.on_false {
            return left
        }
        fn_ctx.current = next
        right :: branch_on_cond(fn_ctx, cond.right, on_true, on_false, split)
        return CondReach {
            .on_true = left.on_true || right.on_true,
            .on_false = right.on_false,
        }
    }
    unreached :: CondReach { .on_true = false, .on_false = false }
    local :: build_expr(fn_ctx, cond) ?? return unreached
    if fn_ctx.current is null {
        return unreached
    }
    terminate(fn_ctx, TermCondBranch {
        .cond = local,
        .then_block = on_true,
        .else_block = on_false,
        .span = cond.span,
    })
    return CondReach { .on_true = true, .on_false = true }
}

/// How many edges the tests of a condition send to its true target and to its
/// false one, when it branches on each operand.
OperandEdges :: struct {
    on_true: i32
    on_false: i32
}

operand_edges :: fn(cond: LoweredExpr) -> OperandEdges {
    if cond is LoweredUnary && cond.op == .Not {
        swapped :: operand_edges(cond.operand)
        return OperandEdges { .on_true = swapped.on_false, .on_false = swapped.on_true }
    }
    if cond is LoweredBinary && is_short_circuit_op(cond.op) {
        left :: operand_edges(cond.left)
        right :: operand_edges(cond.right)
        if cond.op == .And {
            return OperandEdges {
                .on_true = right.on_true,
                .on_false = left.on_false + right.on_false,
            }
        }
        return OperandEdges {
            .on_true = left.on_true + right.on_true,
            .on_false = right.on_false,
        }
    }
    return OperandEdges { .on_true = 1, .on_false = 1 }
}

// Whether `block` only leaves: a lone `break`, `continue`, or `return` of a
// literal or a name.
only_leaves :: fn(block: LoweredBlock) -> bool {
    if block.trailing != null || block.stmts.len() != 1 {
        return false
    }
    s :: block.stmts[0]
    if s is LoweredBreak | LoweredContinue {
        return true
    }
    if s is LoweredReturn {
        v :: s.value
        return v == null || v is LoweredIntLit | LoweredBoolLit | LoweredNullLit | LoweredIdent
    }
    return false
}

build_struct_lit :: fn(fn_ctx: FnCtx, e: LoweredStructLit) -> LocalId | null {
    field_locals: LocalId[]: []
    field_slots :: literal_slots(fn_ctx.project.slots, e.type)
    for i in 0..<e.fields.len() {
        local :: build_held(fn_ctx, e.fields[i].value, type_at(field_slots, i)) ?? return null
        field_locals.push(local)
    }
    dst :: fresh_tmp(fn_ctx, "struct", e.type)
    emit(fn_ctx, InstrStructNew {
        .dst = dst, .type = e.type, .fields = field_locals,
        .stack = false, .span = e.span,
    })
    return dst
}

build_array_lit :: fn(fn_ctx: FnCtx, e: LoweredArrayLit) -> LocalId | null {
    elems: LocalId[]: []
    slot :: element_slot(e.type)
    for el in e.elements {
        local :: build_held(fn_ctx, el, slot) ?? return null
        elems.push(local)
    }
    dst :: fresh_tmp(fn_ctx, "arr", e.type)
    emit(fn_ctx, InstrArrayNew {
        .dst = dst, .type = e.type, .length = i32(e.elements.len()),
        .elements = elems, .stack = false, .span = e.span,
    })
    return dst
}

build_cast :: fn(fn_ctx: FnCtx, e: LoweredCast) -> LocalId | null {
    value :: build_cast_source(fn_ctx, e) ?? return null
    return cast_local(fn_ctx, value, e.type, "cast", e.span)
}

// The value `e` converts. Into an integer, a read the typecheck narrowed is taken as
// its slot stores it : the value lies in the narrower range, so converting the
// stored one gives the same integer (`i64(n)` past `n in Hour` reads `n` once, not
// as a byte widened back).
build_cast_source :: fn(fn_ctx: FnCtx, e: LoweredCast) -> LocalId | null {
    if !is_stored_as_integer(e.type) {
        return build_expr(fn_ctx, e.value)
    }
    return build_stored(fn_ctx, e.value)
}

// `e` built as its slot stores it when it is a read, a read the typecheck narrowed
// left unconverted for its caller to convert once ; any other value as it builds.
build_stored :: fn(fn_ctx: FnCtx, e: LoweredExpr) -> LocalId | null {
    // @partial: only a read has a form stored apart from its use ; any other value
    // builds as it is.
    @partial match e {
        is LoweredIdent       -> { return stored_ident(fn_ctx, e) }
        is LoweredFieldAccess -> { return stored_field(fn_ctx, e) }
        is LoweredUnionField  -> { return stored_union_field(fn_ctx, e) }
        is LoweredCellGet     -> { return stored_cell(fn_ctx, e) }
        _ -> { return build_expr(fn_ctx, e) }
    }
}

build_type_check :: fn(fn_ctx: FnCtx, e: LoweredTypeCheck) -> LocalId | null {
    value :: build_expr(fn_ctx, e.value) ?? return null
    dst :: fresh_tmp(fn_ctx, "type_check", e.type)
    emit(fn_ctx, InstrTypeCheck {
        .dst = dst, .value = value, .check_type = e.check_type, .span = e.span,
    })
    return dst
}

build_unreachable_type :: fn(fn_ctx: FnCtx, type: Type, span: Span, reason: string) -> LocalId | null {
    if fn_ctx.current is null { return null }
    placeholder :: if is_void(type) { null } else { declare_local(fn_ctx, "unreachable", type, null) }
    terminate(fn_ctx, TermUnreachable { .reason = reason, .span = span })
    return placeholder
}

build_intrinsic_call :: fn(fn_ctx: FnCtx, e: LoweredIntrinsicCall) -> LocalId | null {
    args :: build_args(fn_ctx, e.args, e.param_types) ?? return null
    dst :: if is_void(e.type) { null } else { fresh_tmp(fn_ctx, "intrinsic", e.type) }
    emit(fn_ctx, InstrIntrinsic {
        .span = e.span,
        .dst = dst,
        .name = e.name,
        .args = args,
        .param_types = e.param_types,
    })
    return dst
}

build_array_len :: fn(fn_ctx: FnCtx, e: LoweredArrayLen) -> LocalId | null {
    target :: build_expr(fn_ctx, e.target) ?? return null
    dst :: fresh_tmp(fn_ctx, "len", e.type)
    emit(fn_ctx, InstrArrayLen { .dst = dst, .target = target, .span = e.span })
    return dst
}

build_array_push :: fn(fn_ctx: FnCtx, e: LoweredArrayPush) -> LocalId | null {
    target :: build_expr(fn_ctx, e.target)
    value :: build_held(fn_ctx, e.value, element_slot(e.target.type))
    if target is null { return null }
    if value is null { return null }
    emit(fn_ctx, InstrArrayPush { .target = target, .value = value, .span = e.span, .cached = e.cached })
    return null
}

build_array_slice :: fn(fn_ctx: FnCtx, e: LoweredArraySlice) -> LocalId | null {
    target :: build_expr(fn_ctx, e.target)
    lo :: build_held(fn_ctx, e.lo, TY_I64)
    hi :: build_held(fn_ctx, e.hi, TY_I64)
    if target is null { return null }
    if lo is null { return null }
    if hi is null { return null }
    dst :: fresh_tmp(fn_ctx, "slice", e.type)
    emit(fn_ctx, InstrArraySlice {
        .dst = dst, .type = e.type, .target = target, .lo = lo, .hi = hi, .span = e.span,
    })
    return dst
}

build_data_const :: fn(fn_ctx: FnCtx, e: LoweredDataConst) -> LocalId | null {
    dst :: fresh_tmp(fn_ctx, "data_const", e.type)
    emit(fn_ctx, InstrDataConst {
        .dst = dst, .type = e.type, .pool_index = i32(e.pool_index), .span = e.span,
    })
    return dst
}

build_global_get :: fn(fn_ctx: FnCtx, e: LoweredGlobalGet) -> LocalId | null {
    dst :: fresh_tmp(fn_ctx, "global", e.type)
    emit(fn_ctx, InstrGlobalGet {
        .span = e.span,
        .dst = dst,
        .type = e.type,
        .slot = i32(e.slot),
    })
    return dst
}

build_cell_new :: fn(fn_ctx: FnCtx, e: LoweredCellNew) -> LocalId | null {
    value :: build_held(fn_ctx, e.value, e.value_type) ?? return null
    dst :: fresh_tmp(fn_ctx, "cell", e.type)
    emit(fn_ctx, InstrCellNew {
        .dst = dst, .value = value, .value_type = e.value_type, .span = e.span,
    })
    return dst
}

build_cell_get :: fn(fn_ctx: FnCtx, e: LoweredCellGet) -> LocalId | null {
    stored :: stored_cell(fn_ctx, e) ?? return null
    return read_as(fn_ctx, stored, e.type, e.span)
}

// The value of the cell `e` reads, as the cell stores it (`read_type`).
stored_cell :: fn(fn_ctx: FnCtx, e: LoweredCellGet) -> LocalId | null {
    target :: build_expr(fn_ctx, e.target) ?? return null
    dst :: fresh_tmp(fn_ctx, "cell_get", read_type(e.value_type, e.type))
    emit(fn_ctx, InstrCellGet {
        .dst = dst, .cell = target, .value_type = e.value_type, .span = e.span,
    })
    return dst
}

build_make_closure :: fn(fn_ctx: FnCtx, e: LoweredMakeClosure) -> LocalId | null {
    env :: build_expr(fn_ctx, e.env) ?? return null
    dst :: fresh_tmp(fn_ctx, "closure", e.type)
    emit(fn_ctx, InstrMakeClosure {
        .dst = dst,
        .fn_symbol = e.fn_symbol,
        .env = env,
        .type = e.type,
        .span = e.span,
    })
    return dst
}

// ============================================================================
// Bookkeeping helpers
// ============================================================================

// `e`, built, as a slot of type `slot` holds it : an integer literal the slot's
// integer holds is built at that integer, with nothing left to convert ; an integer
// read is taken as it is stored and converted once (`held_use_in`).
build_held :: fn(fn_ctx: FnCtx, e: LoweredExpr, slot: Type | null) -> LocalId | null {
    if fn_ctx.current is null {
        return null
    }
    if e is LoweredIntLit {
        target :: stored_conversion(e.type, slot) ?? return build_expr(fn_ctx, e)
        if holds_value(target.values, e.value) {
            constant :: ConstInt { .value = e.value }
            return emit_const(fn_ctx, machine_integer_type(target), constant, e.span)
        }
    }
    if !is_stored_as_integer(e.type) {
        value :: build_expr(fn_ctx, e) ?? return null
        return held_in(fn_ctx, value, slot, e.span)
    }
    stored :: build_stored(fn_ctx, e) ?? return null
    return held_use_in(fn_ctx, stored, e.type, slot, e.span)
}

emit :: fn(fn_ctx: FnCtx, instr: Instruction) -> void {
    if fn_ctx.current is null { return }
    fn_ctx.blocks[i64(fn_ctx.current)].instructions.push(instr)
}

emit_const :: fn(fn_ctx: FnCtx, type: Type, value: ConstValue, span: Span) -> LocalId {
    dst :: fresh_tmp(fn_ctx, "k", type)
    emit(fn_ctx, InstrConst { .dst = dst, .value = value, .type = type, .span = span })
    return dst
}

terminate :: fn(fn_ctx: FnCtx, t: Terminator) -> void {
    if fn_ctx.current is null { return }
    cur :: fn_ctx.blocks[i64(fn_ctx.current)]
    if cur.terminator is null { cur.terminator = t }
    fn_ctx.current = null
}

new_block :: fn(fn_ctx: FnCtx, span: Span) -> BlockId {
    id :: BlockId(i32(fn_ctx.blocks.len()))
    fn_ctx.blocks.push(MutableBlock {
        .id = id, .instructions = [], .terminator = null, .span = span,
    })
    return id
}

declare_local :: fn(fn_ctx: FnCtx, name: string, type: Type, symbol: Symbol | null) -> LocalId {
    id :: LocalId(i32(fn_ctx.locals.len()))
    fn_ctx.locals.push(CFGLocal { .name = name, .type = type, .symbol = symbol })
    return id
}

// `value` converted to `type`, into a new local named after `hint`.
cast_local :: fn(fn_ctx: FnCtx, value: LocalId, type: Type, hint: string, span: Span) -> LocalId {
    dst :: fresh_tmp(fn_ctx, hint, type)
    emit(fn_ctx, InstrCast { .dst = dst, .value = value, .type = type, .span = span })
    return dst
}

fresh_tmp :: fn(fn_ctx: FnCtx, hint: string, type: Type) -> LocalId {
    return declare_local(fn_ctx, "\$${hint}_${fn_ctx.locals.len()}", type, null)
}

