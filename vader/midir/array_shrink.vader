// vader/midir/array_shrink: which calls may shorten an array.
//
// The range analysis keeps what it knows of an array's length across an
// instruction that cannot shorten one (`ranges/transfer.vader`, `transfer`). Only
// `remove_last` and `clear` shorten an array (`ArrayOps` in `std/core`); every
// other change makes it longer, which leaves `i < len(xs)` true.
//
// A call may shorten an array when its callee's body does, or calls something
// that may: the smallest fixed point over the call graph (`call_graph.vader`),
// so a recursive function that shortens nothing is known not to. A callee the
// project does not define is assumed to shorten one.
//
// A bodyless function is judged by what the host does for it
// (`extern_shrinks_by_itself`); it runs program code only through
// `ForeignCallbacks` (`call_graph.vader`).

module "vader/midir"

import "std/iter"
import "vader/support/fixpoint"

Bc :: import "vader/core/bytecode"
import "vader/midir/select"

/// Per node of a project's call graph, whether running it may shorten an array.
/// Built by `summarise_array_shrinking`, read through `shrink_predicate`.
export ShrinkSummary :: struct {
    @internal
    calls: CallGraph
    @internal
    may_shrink: bool[]
}

/// Work out, for every function of `p`, whether calling it may shorten an array.
///
/// @param p  the CFG ; read only.
export summarise_array_shrinking :: fn(p: CFGProject) -> ShrinkSummary {
    calls :: build_call_graph(p)
    may_shrink: bool[]: []
    for node in calls.nodes {
        may_shrink.push(node_shrinks_by_itself(node))
    }
    solve_reachability(calls.graph, may_shrink)
    return ShrinkSummary { .calls = calls, .may_shrink = may_shrink }
}

/// Whether running `ins` may shorten an array, as the range analysis asks it
/// (`RangeContext.shrinks`).
///
/// @param summary  the project's summary.
export shrink_predicate :: fn(summary: ShrinkSummary) -> fn(Instruction) -> bool =
    fn(ins: Instruction) {
        // Asked of every instruction the analysis steps over: the common answers
        // build no callee list.
        if !instruction_runs_code(ins) {
            return false
        }
        may_shrink :: summary.may_shrink
        if ins is InstrCall {
            return may_shrink[callee_node(summary.calls.index, ins.callee)]
        }
        callees :: instruction_callees(summary.calls.index, ins)
        return is_shrinking_intrinsic(ins) || callees.any_match((callee) -> may_shrink[callee])
    }

/// One line on what the summary concluded, for `$VADER_OPT_REPORT`.
///
/// @param s  the project's summary.
export shrink_summary_line :: fn(s: ShrinkSummary) -> string {
    nodes :: s.calls.nodes
    is_function :: (i: i64) -> nodes[i] is CFGFunction
    functions :: count_where(nodes.len(), is_function)
    shrinking :: count_where(nodes.len(), (i) -> is_function(i) && s.may_shrink[i])
    by_their_body :: count_where(
        nodes.len(),
        (i) -> is_function(i) && node_shrinks_by_itself(nodes[i]),
    )
    indirect :: s.may_shrink[s.calls.index.indirect]
    callbacks :: s.may_shrink[s.calls.index.foreign_callbacks]
    return "${shrinking} of ${functions} functions may shorten an array " +
        "(${by_their_body} by their own body) ; an indirect call may: ${indirect}, " +
        "a callback handed to C may: ${callbacks}"
}

// How many of `0..<n` satisfy `pred`.
count_where :: fn(n: i64, pred: fn(i64) -> bool) -> i64 = (0..<n).filter(pred).count()

// What a node does by itself, its calls left out.
node_shrinks_by_itself :: fn(node: CallNode) -> bool = match node {
    is CFGFunction                      -> body_shrinks_by_itself(node)
    is CFGExternDecl                    -> extern_shrinks_by_itself(node)
    is IndirectCalls | ForeignCallbacks -> false
    is UnknownCallee                    -> true
}

body_shrinks_by_itself :: fn(f: CFGFunction) -> bool =
    f.blocks.any_match((block) -> block.instructions.any_match(is_shrinking_intrinsic))

is_shrinking_intrinsic :: fn(ins: Instruction) -> bool =
    ins is InstrIntrinsic && intrinsic_shortens_array(ins.name)

// An intrinsic no op serves is assumed to shorten an array.
intrinsic_shortens_array :: fn(name: string) -> bool {
    op :: intrinsic_op_for_name(name) ?? return true
    return Bc.op_shortens_array(op)
}

// Foreign code (`@extern`) is lent an array's buffer, never the header that holds
// its length.
extern_shrinks_by_itself :: fn(e: CFGExternDecl) -> bool {
    if e.is_extern {
        return false
    }
    op :: intrinsic_op_for_mangled(e.mangled)
    if op != null {
        return Bc.op_shortens_array(op)
    }
    return Bc.intrinsic_may_shorten_array(Bc.intrinsic_id_for(e.mangled))
}
