// vader/midir/wit: the WIT type of an `@extern` a WASM build imports.
//
// Derived here, where the Vader types are whole, for the declarations that name
// a `WasmInterface`; the bytecode carries it (`BcImport.wit`) to the WASM
// emitter. A scalar is the WIT scalar of its width and signedness, a `string` a
// `string`, an enum without variant data whose values are its ranks an `enum`,
// `void | E` a `result<_, E>`, `WasmStream<T>` a `stream<T>` and `WasmFuture<T>`
// a `future<T>`. A type is named in WIT as in Vader, in kebab case. Any other
// type is `WitUnsupported`: the native build does not care, a WASM build stops
// on it.

module "vader/midir"

import "std/collections"
import "std/iter"
import "vader/core/types"
import "vader/core/wit"

// The WIT type of the function `params` and `result` declare.
wit_function_of :: fn(params: CFGParam[], result: Type) -> WitFunction = WitFunction {
    .params = params.map(wit_param_of).collect(),
    .result = wit_type_or_none(result),
}

wit_param_of :: fn(p: CFGParam) -> WitParam =
    WitParam { .name = wit_name(p.name), .type = wit_type_of(p.type) }

// The WIT type of `t`, null for `void`.
wit_type_or_none :: fn(t: Type) -> WitType | null {
    if is_void(t) {
        return null
    }
    return wit_type_of(t)
}

wit_type_of :: fn(t: Type) -> WitType {
    // @partial: every other type has no WIT form yet.
    found: WitType | null: @partial match t {
        is PrimitiveType -> wit_scalar_of(t.name)
        is RangeType     -> wit_scalar_of(storage_integer(t).name)
        is EnumType      -> wit_enum_of(t)
        is UnionType     -> wit_result_of(t)
        is StructType    -> wit_core_struct_of(t)
        _                -> null
    }
    return found else unsupported(t)
}

// `WasmStream<T>` and `WasmFuture<T>`, the async types of WIT.
wit_core_struct_of :: fn(t: StructType) -> WitType | null {
    if t.args.len() != 1 {
        return null
    }
    if is_core_struct(t, STRUCT_WASM_STREAM) {
        return WitStream { .element = wit_type_of(t.args[0]) }
    }
    if is_core_struct(t, STRUCT_WASM_FUTURE) {
        return WitFuture { .value = wit_type_or_none(t.args[0]) }
    }
    return null
}

unsupported :: fn(t: Type) -> WitUnsupported =
    WitUnsupported { .reason = "no WIT form yet for `${display_type(t)}`" }

wit_scalar_of :: fn(name: string) -> WitScalar | null = match name {
    "bool"   -> .Bool
    "i8"     -> .S8
    "u8"     -> .U8
    "i16"    -> .S16
    "u16"    -> .U16
    "i32"    -> .S32
    "u32"    -> .U32
    "i64"    -> .S64
    "u64"    -> .U64
    "f32"    -> .F32
    "f64"    -> .F64
    "char"   -> .Char
    "string" -> .String
    _        -> null
}

// An enum whose values are its ranks, as a WIT `enum` numbers its cases.
wit_enum_of :: fn(t: EnumType) -> WitEnum | null {
    if t.data != null {
        return null
    }
    cases: string[]: [""] * t.indices.len()
    for [name, value] in t.indices {
        if value < 0 || value >= cases.len() {
            return null
        }
        cases[value] = wit_name(name)
    }
    if cases.any_match((c) -> c == "") {
        return null
    }
    return WitEnum { .name = wit_name(t.symbol.name), .cases = cases }
}

// `void | E`: a `result` whose only payload is the error.
wit_result_of :: fn(t: UnionType) -> WitResult | null {
    if t.variants.len() != 2 || !t.variants.any_match(is_void) {
        return null
    }
    error :: t.variants.find((v) -> !is_void(v)) else return null
    return WitResult { .error = wit_type_of(error) }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// Whether `t` is the scalar `s`.
is_scalar :: fn(t: WitType, s: WitScalar) -> bool = t is WitScalar && t == s

@test
test_wit_of_scalars :: fn() -> void {
    assert(is_scalar(wit_type_of(TY_I64), .S64), "`i64` is `s64`")
    assert(is_scalar(wit_type_of(TY_I32), .S32), "`i32` is `s32`")
    assert(is_scalar(wit_type_of(TY_F64), .F64), "`f64` is `f64`")
}

@test
test_wit_of_void_or_error_is_a_result :: fn() -> void {
    union :: UnionType { .variants = [TY_BOOL, TY_VOID] }
    result :: wit_type_of(union)
    assert(result is WitResult && result.ok == null, "`void | bool` is `result<_, bool>`")
}

@test
test_wit_of_void_alone_is_unsupported :: fn() -> void {
    assert(wit_type_of(TY_VOID) is WitUnsupported, "`void` alone is no value")
}
