// vader/midir/ranges_report — the range analysis's verdicts, rendered: one line
// per site for `vader dump --stage=ranges`, and the totals of a whole build for
// `$VADER_OPT_REPORT` (`ranges_verdicts.vader` for the verdicts).

module "vader/midir"

import "std/collections"
import "std/io"
import "std/sort"
import "std/string_builder"
import "vader/front/resolver"
import "vader/lower"

// ---- report ---------------------------------------------------------------

/// How many sites of one kind got each verdict.
VerdictCounts :: struct {
    already_safe: i32 = 0
    proven: i32 = 0
    unproven: i32 = 0
    certain_fault: i32 = 0
    unreachable: i32 = 0
}

/// The verdicts of every function of one module, or of the whole project.
RangeTally :: struct {
    accesses: VerdictCounts = VerdictCounts {}
    checked: VerdictCounts = VerdictCounts {}
    /// Functions whose analysis did not settle.
    gave_up: i32 = 0
}

/// Print to stderr the range analysis's verdicts on every module of `p`,
/// totalled for the project and per module, with each certain fault listed.
/// The caller gates it on `$VADER_OPT_REPORT`; the CFG is left as it is.
///
/// @param p  the CFG after every midir pass, as the bytecode emitter receives
///           it.
export report_ranges :: fn(p: CFGProject) -> void {
    summary :: summarise_array_shrinking(p)
    shrinks :: shrink_predicate(summary)
    total :: RangeTally {}
    // The same analysis with every call forgetting the lengths, so the report
    // shows what the call summaries add.
    without_summaries :: RangeTally {}
    modules: [string, RangeTally][]: []
    faults: string[]: []
    for [_, m] in p.modules {
        tally :: RangeTally {}
        for fn_ in m.functions {
            r :: analyse_function_ranges(fn_, shrinks)
            tally_function(tally, r)
            tally_function(total, r)
            tally_function(without_summaries, analyse_function_ranges(fn_, instruction_runs_code))
            for site in r.sites {
                if site.verdict == .CertainFault {
                    at :: source_position(site.span)
                    faults.push("    [${at}] ${site.what} in ${r.mangled}\n")
                }
            }
        }
        if site_count(tally.accesses) + site_count(tally.checked) > 0 {
            modules.push([m.display_path, tally])
        }
    }
    out :: StringBuilder {}
    out.append("\n[VADER_OPT_REPORT] range analysis: array accesses and checked operations\n")
    out.append("  accesses: ${counts_line(total.accesses)}\n")
    out.append("  checked:  ${counts_line(total.checked)}\n")
    out.append("  functions with no fixed point: ${total.gave_up}\n")
    out.append("  without call summaries:\n")
    out.append("    accesses: ${counts_line(without_summaries.accesses)}\n")
    out.append("    checked:  ${counts_line(without_summaries.checked)}\n")
    out.append("  call summaries: ${summary_line(summary)}\n")
    out.append("\n  per module, accesses: proven + already safe / sites, checked: proven / sites\n")
    for [path, tally] in sort(modules, (a, b) -> a.0 < b.0) {
        out.append("    ${path}: ${tally_line(tally)}\n")
    }
    if faults.len() > 0 {
        out.append("\n  certain faults:\n")
        for fault in faults {
            out.append(fault)
        }
    }
    eprintln(out.to_string())
}

tally_function :: fn(tally: RangeTally, r: FunctionRanges) -> void {
    if r.gave_up {
        tally.gave_up += 1
    }
    for site in r.sites {
        if site.arithmetic {
            count_verdict(tally.checked, site.verdict)
        } else {
            count_verdict(tally.accesses, site.verdict)
        }
    }
}

count_verdict :: fn(c: VerdictCounts, v: RangeVerdict) -> void {
    match v {
        .AlreadySafe  -> { c.already_safe += 1 }
        .Proven       -> { c.proven += 1 }
        .Unproven     -> { c.unproven += 1 }
        .CertainFault -> { c.certain_fault += 1 }
        .Unreachable  -> { c.unreachable += 1 }
    }
}

site_count :: fn(c: VerdictCounts) -> i32 =
    c.already_safe + c.proven + c.unproven + c.certain_fault + c.unreachable

counts_line :: fn(c: VerdictCounts) -> string =
    "${site_count(c)} sites: proven ${c.proven}, already safe ${c.already_safe}, " +
        "unproven ${c.unproven}, certain faults ${c.certain_fault}, unreachable ${c.unreachable}"

tally_line :: fn(t: RangeTally) -> string =
    "accesses ${t.accesses.proven} + ${t.accesses.already_safe} / ${site_count(t.accesses)}, " +
        "checked ${t.checked.proven} / ${site_count(t.checked)}"

// ---- dump -----------------------------------------------------------------

/// The range analysis's verdicts for every function of the modules in `scope`,
/// one line per array access and checked operation: `vader dump --stage=ranges`.
///
/// @param p      the CFG after every midir pass, as the bytecode emitter
///               receives it.
/// @param scope  the modules to render (`module_in_scope`).
export dump_ranges_project :: fn(p: CFGProject, scope: string[]) -> string {
    sb :: StringBuilder {}
    sb.append("# ranges\n")
    shrinks :: shrink_predicate(summarise_array_shrinking(p))
    for [_, m] in p.modules {
        if !module_in_scope(m.display_path, scope) || m.functions.len() == 0 {
            continue
        }
        sb.append("\n## ${m.display_path}\n")
        for fn_ in m.functions {
            write_function_ranges(analyse_function_ranges(fn_, shrinks), sb)
        }
    }
    return sb.to_string()
}

write_function_ranges :: fn(r: FunctionRanges, sb: StringBuilder) -> void {
    if r.sites.len() == 0 {
        return
    }
    sb.append("\nfn ${r.mangled}\n")
    if r.gave_up {
        sb.append("  no fixed point within ${MAX_ROUNDS} rounds\n")
    }
    for site in r.sites {
        at :: "${site.span.start.line}:${site.span.start.column}"
        sb.append("  ${at} ${site.what} -> ${verdict_label(site.verdict)}\n")
    }
}

verdict_label :: fn(v: RangeVerdict) -> string = match v {
    .AlreadySafe  -> "already safe"
    .Proven       -> "proven"
    .Unproven     -> "unproven"
    .CertainFault -> "certain fault"
    .Unreachable  -> "unreachable"
}
