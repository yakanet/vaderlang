// vader/midir/select/intrinsics: mangled name -> dedicated bytecode op.
//
// Stdlib `@intrinsic` impl members, and a few free fns, map to a dedicated
// bytecode op rather than a host-provided import, e.g. `a + b` on `i32` and
// `a.add(b)` both emit the same `i32.add` op ; the `Buffer` byte ops
// (`load_u8` / `store_u8` / `memory_copy` / `intern_string` /
// `write_string`) map to the Target-ABI memory opcodes. The table is built at
// compile time from the declarations' names, through the mangler
// (`vader/core/mangle`): no mangled name is spelled here.

module "vader/midir/select"

import "std/abort"
import "std/collections"
import "vader/core/bytecode"
import "vader/core/mangle"
import "vader/core/symbol"
import "vader/core/types"

/// True when the call's mangled name resolves to a dedicated
/// bytecode op (e.g. `std_core$i32$Add$add` -> `i32.add`). Returns
/// the pre-built op to push, or `null` for non-intrinsic calls.
///
/// @param mangled  the fn's mangled name (from `MonoEntry.mangled`).
/// @return         the matching bytecode op, or `null` when no
///                 intrinsic applies: caller emits a regular `Call`.
export intrinsic_op_for_mangled :: fn(mangled: string) -> Op | null = OPS_BY_HOST[mangled]

// The op of each host an op serves, by mangled name.
OPS_BY_HOST: Map<string, Op>: @comptime {
    out :: Map<string, Op> {}
    // Add / Sub / Mul / Div and Equals of every primitive, through op_select: the
    // SAME authority the operators use, so `a.add(b)` and `.equals()` never drift
    // from `a + b` and `==`. Narrow ints alias onto their class, floats onto
    // F64*, and Div is unsigned-aware. An integer `equals` lands on its class's
    // op (a `u8` on `I32Eq`): a vtable wrapper built from this answer is what an
    // erased instance reaches when it compares a union member tagged `u8`, and
    // the native build binds no host import for it.
    for name in scalar_type_names() {
        val :: val_type_of_primitive_name(name)
        if is_numeric_name(name) {
            out[primitive_member_mangle(name, TRAIT_ADD, METHOD_ADD)] = checked_arith_op(val, .Add)
            out[primitive_member_mangle(name, TRAIT_SUB, METHOD_SUB)] = checked_arith_op(val, .Sub)
            out[primitive_member_mangle(name, TRAIT_MUL, METHOD_MUL)] = checked_arith_op(val, .Mul)
            out[primitive_member_mangle(name, TRAIT_DIV, METHOD_DIV)] = div_op(val)
        }
        out[primitive_member_mangle(name, TRAIT_EQUALS, METHOD_EQUALS)] = cmp_eq(val)
    }
    out[primitive_member_mangle("string", TRAIT_COMPARABLE, METHOD_COMPARE)] = StringCompare {}
    // Float <-> raw-bits reinterpret: NOT the numeric `f64(x)` / `u64(b)` casts,
    // these return the exact IEEE bit pattern, a `union` cast in C.
    out[primitive_member_mangle("f64", @type_name(FloatBits), "to_bits")] = F64ToBits {}
    out[primitive_member_mangle("u64", @type_name(BitsFloat), "from_bits")] = BitsToF64 {}
    out[primitive_member_mangle("f32", @type_name(Float32Bits), "to_bits")] = F32ToBits {}
    out[primitive_member_mangle("u32", @type_name(Bits32Float), "from_bits")] = BitsToF32 {}
    // The Target ABI memory opcodes: the abstract `Buffer`'s methods
    // (`lib/std/core/buffer.vader`, whose trait the module keeps private), and
    // its allocation, which takes no operand: the object is always a `Buffer`.
    out[declaration_mangle(CORE_MODULE, "new_byte_buffer")] = BufferNew {}
    buffer :: (method: string) -> primitive_member_mangle(@type_name(Buffer), "ByteAccess", method)
    out[buffer("load_u8")] = LoadU8 {}
    out[buffer("store_u8")] = StoreU8 {}
    out[buffer("memory_copy")] = MemoryCopy {}
    out[buffer("intern_string")] = BufferToString {}
    out[buffer("write_string")] = BufferWriteString {}
    return out
}

/// Fail loud when a host import is wired to nothing. Called on every import of
/// the final table, in every build mode (`emit_bytecode_from_cfg`,
/// `emit/bytecode/emit.vader`).
///
/// A non-`@extern` import served by neither a dedicated bytecode op
/// (`intrinsic_op_for_mangled`) nor a known host (`BcImport.host`) would lower to an
/// unbound `call.import` and trap at runtime. `@extern` imports resolve at link
/// time and are exempt.
///
/// @param imp  an import of the final table.
export assert_host_import_wired :: fn(imp: BcImport) -> void {
    if imp.is_extern { return }
    if intrinsic_op_for_mangled(imp.mangled_name) != null { return }
    if imp.host != .NotIntrinsic { return }
    panic("bytecode emit: host import `${imp.mangled_name}` is wired to nothing. Name it by a member of `Intrinsic` that `IntrinsicId` lists (+ its `vm/host.vader::dispatch_import` and `emit/c/host.vader::import_shim` arms), or give it a dedicated op in `intrinsic_op_for_mangled`")
}

/// Map an InstrIntrinsic's canonical name onto its dedicated Op, or null when
/// the name maps to none. The emitter panics on `null` rather than emit a
/// function-truncating stub.
///
/// The name says which op, not which type: `ArrayReserve` comes back with no
/// type index (-1), and the bytecode emitter, which holds the type table, gives
/// it that of the array the call builds.
///
/// @param name  the intrinsic's canonical name (`InstrIntrinsic.name`).
export intrinsic_op_for_name :: fn(name: string) -> Op | null {
    if name == "size_of.type"      { return SizeOfType {} }
    if name == "array.reserve"     { return ArrayReserve { .type_id = -1 } }
    if name == "array.repeat"      { return ArrayRepeat {} }
    if name == "array.push_all"    { return ArrayPushAll {} }
    if name == "array.copy"        { return ArrayCopy {} }
    if name == "array.remove_last" { return ArrayRemoveLast {} }
    if name == "array.clear"       { return ArrayClear {} }
    return null
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_hosts_named_by_their_declaration_have_their_op :: fn() -> void {
    to_bits :: intrinsic_op_for_mangled(r"std_core$f64$FloatBits$to_bits")
    assert(to_bits is F64ToBits, "to_bits")
    load :: intrinsic_op_for_mangled(r"std_core$Buffer$ByteAccess$load_u8")
    assert(load is LoadU8, "load_u8")
    compare :: intrinsic_op_for_mangled(r"std_core$string$Comparable$compare")
    assert(compare is StringCompare, "compare")
}

@test test_intrinsic_op_for_mangled_i32_add :: fn() -> void {
    op :: intrinsic_op_for_mangled(r"std_core$i32$Add$add")
    assert(op is CheckedArith && op.op == .Add && op.kind == .I32, "i32 add -> checked i32 add")
}

@test test_narrow_and_unsigned_arith_map_correctly :: fn() -> void {
    // Widening + unsigned-aware Div must match the operator path (op_select).
    assert(intrinsic_op_for_mangled(r"std_core$u8$Div$div") is U32Div, "u8 div -> U32Div")
    assert(intrinsic_op_for_mangled(r"std_core$u64$Div$div") is U64Div, "u64 div -> U64Div")
    i8_add :: intrinsic_op_for_mangled(r"std_core$i8$Add$add")
    assert(i8_add is CheckedArith && i8_add.kind == .I8, "i8 add -> checked i8 add")
    u64_add :: intrinsic_op_for_mangled(r"std_core$u64$Add$add")
    assert(u64_add is CheckedArith && u64_add.kind == .U64, "u64 add -> checked u64 add")
    assert(intrinsic_op_for_mangled(r"std_core$f32$Mul$mul") is F64Mul, "f32 mul -> F64Mul")
    assert(intrinsic_op_for_mangled(r"std_core$f32$Equals$equals") is F64Eq, "f32 equals -> F64Eq")
    assert(intrinsic_op_for_mangled(r"std_core$u8$Equals$equals") is I32Eq, "u8 equals -> I32Eq")
}

@test test_free_buffer_allocation_maps_to_buffer_new :: fn() -> void {
    assert(intrinsic_op_for_mangled(r"std_core$new_byte_buffer") is BufferNew, "new_byte_buffer")
}

@test test_intrinsic_op_for_mangled_unknown_returns_null :: fn() -> void {
    op :: intrinsic_op_for_mangled(r"std_core$Foo$Bar$baz")
    assert_eq(op is null, true)
}

@test test_intrinsic_op_for_mangled_regular_fn_returns_null :: fn() -> void {
    op :: intrinsic_op_for_mangled(r"user_module$main")
    assert_eq(op is null, true)
}
