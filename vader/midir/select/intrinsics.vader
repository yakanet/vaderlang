// vader/midir/select/intrinsics: the dedicated bytecode op of a member of
// `Intrinsic`.
//
// The members of `Intrinsic` that an op serves map to it rather than to a
// host-provided import: `Intrinsic.buffer_load_u8` and its siblings to the
// Target-ABI memory opcodes, `Intrinsic.f64_to_bits` to its reinterpret.

module "vader/midir/select"

import "std/abort"
import "vader/core/bytecode"

/// The dedicated op of the member `id` of `Intrinsic`, pre-built to push ; null
/// for a member a host serves, or one the lowering turns into an array node.
/// Exhaustive, so a new member is a decision here.
///
/// @param id  the member, from the import's `intrinsic`.
export member_op :: fn(id: IntrinsicId) -> Op | null = match id {
    // The Target ABI memory opcodes: the members of `Intrinsic` behind the
    // abstract `Buffer`'s methods (`lib/std/core/buffer.vader`), and its
    // allocation, which takes no operand: the object is always a `Buffer`.
    .NewByteBuffer      -> BufferNew {}
    .BufferLoadU8       -> LoadU8 {}
    .BufferStoreU8      -> StoreU8 {}
    .BufferMemoryCopy   -> MemoryCopy {}
    .BufferInternString -> BufferToString {}
    .BufferWriteString  -> BufferWriteString {}
    .StringCompare      -> StringCompare {}
    .F64ToBits          -> F64ToBits {}
    .BitsToF64          -> BitsToF64 {}
    .F32ToBits          -> F32ToBits {}
    .BitsToF32          -> BitsToF32 {}
    // Lowered as array nodes, never reaching a call.
    .ArrayLen | .ArrayPush | .ArrayPushAll | .ArrayCopyTo | .ArrayRemoveLast
        | .ArrayClear -> null
    // Served by a host.
    .NotIntrinsic | .ByteLen | .ByteAt | .ByteSlice | .IsAscii | .Bytes | .BytesToString
        | .StringHash | .DeepCopy
        | .RuntimeCollect | .RuntimeCountAllocations | .RuntimeStatistic
        | .SchedulerSpawn | .SchedulerPark | .SchedulerWake | .SchedulerSleepFor
        | .SchedulerCancel | .SchedulerCurrent | .SchedulerIsCancelled | .SchedulerIsLeaving
        | .SchedulerWatchReadable | .SchedulerWatchExit | .SchedulerMonitorEnter
        | .SchedulerMonitorGive | .SchedulerMonitorExit | .SchedulerTaskEnded
        | .SchedulerPublish | .SchedulerMutexLock | .SchedulerMutexUnlock | .SchedulerMutexWait
        | .WaitStop | .WaitFor
        | .WasmStreamRead | .WasmFutureWait | .WasmThreadNew | .WasmThreadSuspend | .WasmThreadResumeLater | .WasmThreadYield
        | .WasmStreamDrop | .WasmFutureDrop
        | .WasmThreadIndex | .WasmThreadExit
        | .AbortPanic | .TargetCurrentOs | .TargetCurrentArch
        | .FfiOpen | .FfiOpenPath | .FfiSymbol | .FfiCall | .FfiCallFrame -> null
}

/// Fail loud when an import is wired to nothing. Called on every import of
/// the final table, in every build mode (`emit_bytecode_from_cfg`,
/// `emit/bytecode/emit.vader`).
///
/// A non-`@extern` import that names no member of `Intrinsic` (`BcImport.intrinsic`)
/// would lower to an unbound `call.import` and trap at runtime. `@extern` imports
/// resolve at link time and are exempt.
///
/// @param imp  an import of the final table.
export assert_import_wired :: fn(imp: BcImport) -> void {
    if imp.is_extern || imp.intrinsic != .NotIntrinsic {
        return
    }
    panic("bytecode emit: import `${imp.mangled_name}` is wired to nothing: it names no member of `Intrinsic` that `IntrinsicId` lists")
}

/// Map an InstrIntrinsic's canonical name onto its dedicated Op, or null when
/// the name maps to none. The emitter panics on `null` rather than emit a
/// function-truncating stub.
///
/// The name says which op, not which type: `ArrayReserve` comes back with no
/// type index (-1), and the bytecode emitter, which holds the type table, gives
/// it that of the array the call builds.
///
/// @param name  the intrinsic's canonical name (`InstrIntrinsic.name`).
export intrinsic_op_for_name :: fn(name: string) -> Op | null {
    if name == "size_of.type"      { return SizeOfType {} }
    if name == "array.reserve"     { return ArrayReserve { .type_id = -1 } }
    if name == "array.repeat"      { return ArrayRepeat {} }
    if name == "array.push_all"    { return ArrayPushAll {} }
    if name == "array.copy"        { return ArrayCopy {} }
    if name == "array.remove_last" { return ArrayRemoveLast {} }
    if name == "array.clear"       { return ArrayClear {} }
    return null
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_intrinsic_members_have_their_op :: fn() -> void {
    assert(member_op(.BufferLoadU8) is LoadU8, "buffer_load_u8")
    assert(member_op(.StringCompare) is StringCompare, "string_compare")
    assert(member_op(.F64ToBits) is F64ToBits, "f64_to_bits")
    assert(member_op(.BitsToF64) is BitsToF64, "bits_to_f64")
    assert(member_op(.F32ToBits) is F32ToBits, "f32_to_bits")
    assert(member_op(.BitsToF32) is BitsToF32, "bits_to_f32")
    assert(member_op(.NewByteBuffer) is BufferNew, "new_byte_buffer")
}

@test test_a_member_a_host_serves_has_no_op :: fn() -> void {
    assert(member_op(.ByteLen) == null, "byte_len")
    assert(member_op(.NotIntrinsic) == null, "no member")
}
