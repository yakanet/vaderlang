// vader/midir/select/intrinsics: mangled name → dedicated bytecode op.
//
// Stdlib `@intrinsic` impl members, and a few free fns, map to a dedicated
// bytecode op rather than a host-provided import — e.g. `a + b` on `i32` and
// `a.add(b)` both emit the same `i32.add` op ; the `Buffer` byte ops
// (`load_u8` / `store_u8` / `memory_copy` / `intern_string` /
// `write_string`) map to the Target-ABI memory opcodes.
//
// Expanded here as an if-cascade since Vader has no map-literal
// syntax and a per-startup `MutableMap` fill costs the same lookup
// with extra heap traffic.

module "vader/midir/select"

import "std/abort"
import "vader/core/bytecode"
import "vader/core/symbol"
import "vader/core/types"

/// True when the call's mangled name resolves to a dedicated
/// bytecode op (e.g. `std_core$i32$Add$add` → `i32.add`). Returns
/// the pre-built op to push, or `null` for non-intrinsic calls.
///
/// @param mangled  the fn's mangled name (from `MonoEntry.mangled`).
/// @return         the matching bytecode op, or `null` when no
///                 intrinsic applies — caller emits a regular `Call`.
export intrinsic_op_for_mangled :: fn(mangled: string) -> Op | null {
    // Numeric arithmetic (Add / Sub / Mul / Div) for every primitive width,
    // routed through op_select's `arith_op` / `div_op` so a method call
    // (`a.add(b)`) emits the SAME op as the operator (`a + b`) : narrow ints
    // alias onto I32*, 64-bit onto I64*, floats onto F64*, and Div is
    // unsigned-aware (U32Div / U64Div). See `primitive_arith_op`.
    arith :: primitive_arith_op(mangled)
    if arith != null {
        return arith
    }
    // Equality. `@intrinsic <T> implements Equals` synthesises a bodyless `equals`
    // member. Every primitive goes through op_select's `cmp_eq` — the same
    // authority the operator uses — so `.equals()` can't drift from `==` (see
    // `primitive_cmp_op`).
    cmp :: primitive_cmp_op(mangled)
    if cmp != null {
        return cmp
    }
    // Ordering. `@intrinsic string implements Comparable` : its `compare` is an op.
    if mangled == r"std_core$string$Comparable$compare" {
        return StringCompare {}
    }
    // Target ABI memory opcodes — the abstract `Buffer`'s `@intrinsic` methods
    // (`lib/std/core/buffer.vader`), and its allocation `new_byte_buffer`.
    // `buffer.new` takes no operand — the allocated object is always a `Buffer`,
    // so its type is the BUFFER sentinel by definition.
    if mangled == r"std_core$new_byte_buffer" {
        return BufferNew {}
    }
    if mangled == r"std_core$Buffer$ByteAccess$load_u8" {
        return LoadU8 {}
    }
    if mangled == r"std_core$Buffer$ByteAccess$store_u8" {
        return StoreU8 {}
    }
    if mangled == r"std_core$Buffer$ByteAccess$memory_copy" {
        return MemoryCopy {}
    }
    if mangled == r"std_core$Buffer$ByteAccess$intern_string" {
        return BufferToString {}
    }
    if mangled == r"std_core$Buffer$ByteAccess$write_string" {
        return BufferWriteString {}
    }
    // Float ↔ raw-bits reinterpret (`lib/std/core` FloatBits / BitsFloat).
    // NOT the numeric `f64(x)` / `u64(b)` casts — these return the exact IEEE
    // bit pattern. Lower to a `union` cast in C (no runtime symbol).
    if mangled == r"std_core$f64$FloatBits$to_bits" {
        return F64ToBits {}
    }
    if mangled == r"std_core$u64$BitsFloat$from_bits" {
        return BitsToF64 {}
    }
    if mangled == r"std_core$f32$Float32Bits$to_bits" {
        return F32ToBits {}
    }
    if mangled == r"std_core$u32$Bits32Float$from_bits" {
        return BitsToF32 {}
    }
    return null
}

// Add / Sub / Mul / Div for any numeric primitive, resolved through op_select's
// `checked_arith_op` / `div_op` — the SAME authority the operator path uses, so the
// method mangle can never drift from `a + b`'s op. Covers every width (the
// narrow ints i8/i16/u8/u16/u32 and f32, which the explicit arms
// above never listed) ; `div_op` keeps u32/u64 division unsigned.
primitive_arith_op :: fn(mangled: string) -> Op | null {
    add :: strip_core_member(mangled, r"$Add$add")
    if add != null && is_numeric_name(add) {
        return checked_arith_op(val_type_of_primitive_name(add), .Add)
    }
    sub :: strip_core_member(mangled, r"$Sub$sub")
    if sub != null && is_numeric_name(sub) {
        return checked_arith_op(val_type_of_primitive_name(sub), .Sub)
    }
    mul :: strip_core_member(mangled, r"$Mul$mul")
    if mul != null && is_numeric_name(mul) {
        return checked_arith_op(val_type_of_primitive_name(mul), .Mul)
    }
    div :: strip_core_member(mangled, r"$Div$div")
    if div != null && is_numeric_name(div) {
        return div_op(val_type_of_primitive_name(div))
    }
    return null
}

// The Equals op for every primitive, via op_select's `cmp_eq` — same authority as
// the operator, so `.equals()` can't drift from `==`. An integer of any width
// lands on its class's op (a `u8` on `I32Eq`) : a vtable wrapper built from this
// answer is what an erased instance reaches when it compares a union member
// tagged `u8`, and the native build binds no host import for it.
primitive_cmp_op :: fn(mangled: string) -> Op | null {
    eq :: strip_core_member(mangled, r"$Equals$equals")
    if eq != null && is_scalar_type_name(eq) {
        return cmp_eq(val_type_of_primitive_name(eq))
    }
    return null
}

/// Fail loud when a bodyless `@intrinsic` host import is not wired into the
/// manifest. Called per-import at emit (`emit/bytecode/emit.vader::reserve_cfg_extern`).
///
/// A non-`@extern` import whose mangle is served by NEITHER a dedicated
/// bytecode op (`intrinsic_op_for_mangled`) NOR a recognised `IntrinsicId`
/// (`intrinsic_id_for`) would lower to an unbound `call.import` and trap at
/// runtime — exactly the cos/tan gap the intrinsic audit surfaced. This closes
/// the host-wiring chain at compile time : bodyless ⟹ `@intrinsic` (T3062) ⟹
/// recognised here ⟹ served by the VM + c_emit dispatch (T3013 on both matchs).
/// `@extern` imports resolve at link time and are exempt.
///
/// @param mangled    the import's mangled host name.
/// @param is_extern  true for `@extern` foreign symbols (exempt) ; false for
///                   `@intrinsic`-style stdlib host bindings (must be wired).
export assert_host_import_wired :: fn(mangled: string, is_extern: bool) -> void {
    if is_extern { return }
    if intrinsic_op_for_mangled(mangled) != null { return }
    if intrinsic_id_for(mangled) != .NotIntrinsic { return }
    panic("bytecode emit: bodyless `@intrinsic` host `${mangled}` is not wired into intrinsic_manifest — add it to `intrinsic_id_for` (+ its `vm/host.vader::dispatch_import` and `emit/c/host.vader::import_shim` arms), or give it a dedicated op in `intrinsic_op_for_mangled`")
}

/// Map an InstrIntrinsic's canonical name onto its dedicated Op, or null when
/// the name maps to none. The emitter panics on `null` rather than emit a
/// function-truncating stub.
///
/// @param name  the intrinsic's canonical name (`InstrIntrinsic.name`).
export intrinsic_op_for_name :: fn(name: string) -> Op | null {
    if name == "size_of.type"      { return SizeOfType {} }
    if name == "array.repeat"      { return ArrayRepeat {} }
    if name == "array.push_all"    { return ArrayPushAll {} }
    if name == "array.copy"        { return ArrayCopy {} }
    if name == "array.remove_last" { return ArrayRemoveLast {} }
    if name == "array.clear"       { return ArrayClear {} }
    return null
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_arms_pinned_to_manifest_grammar :: fn() -> void {
    // Every arm's key must equal what `primitive_member_mangle` builds — a
    // drift in the `$` grammar or segment order breaks this test instead of
    // silently de-opting the op back to a plain Call at emit time. Keeps the
    // fast literal cascade above, but pins every arm to the one authority.
    cases :: [
        // arithmetic — every numeric width (routed through op_select)
        ["i8", "Add", "add"], ["i16", "Sub", "sub"], ["i32", "Mul", "mul"],
        ["i64", "Div", "div"],
        ["u8", "Div", "div"], ["u16", "Mul", "mul"], ["u32", "Div", "div"],
        ["u64", "Sub", "sub"],
        ["f32", "Add", "add"], ["f32", "Div", "div"],
        ["f64", "Add", "add"], ["f64", "Sub", "sub"], ["f64", "Mul", "mul"],
        ["f64", "Div", "div"],
        // equality (op-backed) — equals for every primitive
        ["i32", "Equals", "equals"], ["i64", "Equals", "equals"],
        ["u8", "Equals", "equals"], ["u64", "Equals", "equals"],
        ["f32", "Equals", "equals"], ["f64", "Equals", "equals"],
        ["bool", "Equals", "equals"], ["char", "Equals", "equals"],
        ["string", "Equals", "equals"],
        // ordering (op-backed) — `string` only
        ["string", "Comparable", "compare"],
        ["Buffer", "ByteAccess", "load_u8"], ["Buffer", "ByteAccess", "store_u8"],
        ["Buffer", "ByteAccess", "memory_copy"], ["Buffer", "ByteAccess", "intern_string"],
        ["Buffer", "ByteAccess", "write_string"],
        ["f64", "FloatBits", "to_bits"], ["u64", "BitsFloat", "from_bits"],
        ["f32", "Float32Bits", "to_bits"], ["u32", "Bits32Float", "from_bits"],
    ]
    for c in cases {
        m :: primitive_member_mangle(c[0], c[1], c[2])
        assert(intrinsic_op_for_mangled(m) != null, "arm drifted from grammar: ${m}")
    }
}

@test test_intrinsic_op_for_mangled_i32_add :: fn() -> void {
    op :: intrinsic_op_for_mangled(r"std_core$i32$Add$add")
    assert(op is CheckedArith && op.op == .Add && op.kind == .I32, "i32 add → checked i32 add")
}

@test test_narrow_and_unsigned_arith_map_correctly :: fn() -> void {
    // Widening + unsigned-aware Div must match the operator path (op_select).
    assert(intrinsic_op_for_mangled(r"std_core$u8$Div$div") is U32Div, "u8 div → U32Div")
    assert(intrinsic_op_for_mangled(r"std_core$u64$Div$div") is U64Div, "u64 div → U64Div")
    i8_add :: intrinsic_op_for_mangled(r"std_core$i8$Add$add")
    assert(i8_add is CheckedArith && i8_add.kind == .I8, "i8 add → checked i8 add")
    u64_add :: intrinsic_op_for_mangled(r"std_core$u64$Add$add")
    assert(u64_add is CheckedArith && u64_add.kind == .U64, "u64 add → checked u64 add")
    assert(intrinsic_op_for_mangled(r"std_core$f32$Mul$mul") is F64Mul, "f32 mul → F64Mul")
    assert(intrinsic_op_for_mangled(r"std_core$f32$Equals$equals") is F64Eq, "f32 equals → F64Eq")
    assert(intrinsic_op_for_mangled(r"std_core$u8$Equals$equals") is I32Eq, "u8 equals → I32Eq")
}

@test test_free_buffer_allocation_maps_to_buffer_new :: fn() -> void {
    assert(intrinsic_op_for_mangled(r"std_core$new_byte_buffer") is BufferNew, "new_byte_buffer")
}

@test test_intrinsic_op_for_mangled_unknown_returns_null :: fn() -> void {
    op :: intrinsic_op_for_mangled(r"std_core$Foo$Bar$baz")
    assert_eq(op is null, true)
}

@test test_intrinsic_op_for_mangled_regular_fn_returns_null :: fn() -> void {
    op :: intrinsic_op_for_mangled(r"user_module$main")
    assert_eq(op is null, true)
}
