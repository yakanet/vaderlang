// vader/midir/storage : the integer a value is held in, at each flow point.
//
// A lowered value carries the type the typecheck gave it ; the CFG decides what
// integer holds it, a distinct's being the one it is over.
//
// - Where a value moves into a slot (a local, a field, an element, a parameter, a
//   result, a cell, a global, a slice's bounds), it is converted to the slot's integer when the two
//   differ (an `Hour`, held in a `u8`, into an `i64` slot), an integer literal
//   built at that integer rather than converted. A union slot holds an integer in
//   the variant of its own integer, else in the narrowest holding its values.
// - An operation is computed in an integer holding every value of its operands and
//   of its result, its operands converted to it first (`a + b` on two `0..=200` is
//   a `u16` sum of two `u8`), its result then held in the integer its type is.
// - A read the typecheck narrows to a range held in another integer (`n` past
//   `n in Hour`, `n: i64`) reads the slot as it is stored, then converts once, to
//   the integer of where it goes ; a test of a narrowed local against a constant
//   compares in the integer the local is stored in.
//
// `verify.vader` holds every flow point and every operation to this under
// `--verify`.

module "vader/midir"

import "std/collections"
import "toolchain/span"
import "vader/bytecode"
import "vader/comptime"
import "vader/support/integer"
import "vader/resolver/symbol"
import "vader/types"

/// The integer a value of type `value` is converted to as a slot of type `slot`
/// holds it ; null when it goes in as it is : no integer, no slot known, a slot
/// holding no integer, or one holding it in its own integer.
///
/// @param value  the value's type.
/// @param slot   the slot's type, or null when unknown.
stored_conversion :: fn(value: Type, slot: Type | null) -> MachineInteger | null {
    known :: slot ?? return null
    if value is RangeType && known is RangeType && same_interval(value.bounds, known.bounds) {
        return null
    }
    held :: held_integer(value) ?? return null
    target :: integer_member(known, held) ?? return null
    if target.name == held.name {
        return null
    }
    return target
}

// The integer a slot of type `slot` holds a value of the integer `held` as : the
// slot's own, or in a union the variant taking it, `held` itself if it is one,
// else the narrowest holding its values. Null for a slot holding no integer.
integer_member :: fn(slot: Type, held: MachineInteger) -> MachineInteger | null {
    direct :: held_integer(slot)
    if direct != null || slot !is UnionType {
        return direct
    }
    found: MachineInteger | null = null
    for v in slot.variants {
        candidate :: held_integer(v) ?? continue
        if candidate.name == held.name {
            return candidate
        }
        if interval_within(held.values, candidate.values) && narrower(candidate, found) {
            found = candidate
        }
    }
    return found
}

// Whether `candidate` is narrower than `found`, or `found` is none.
narrower :: fn(candidate: MachineInteger, found: MachineInteger | null) -> bool {
    if found == null {
        return true
    }
    return candidate.bits < found.bits
}

/// `value`, a local of the function `fn_ctx` builds, as a slot of type `slot` holds
/// it (`stored_conversion`) : itself, or its conversion into a new local.
///
/// @param value  the value, built.
/// @param slot   the type of the slot it moves into, or null when unknown.
/// @return       the local holding the value as the slot does.
held_in :: fn(fn_ctx: FnCtx, value: LocalId, slot: Type | null, span: Span) -> LocalId {
    target :: stored_conversion(fn_ctx.locals[i64(value)].type, slot) ?? return value
    return cast_local(fn_ctx, value, machine_integer_type(target), "cast", span)
}

/// `value`, a read of type `use` built as its slot stores it (`build_stored`), as a
/// slot of type `slot` holds it : converted once, straight from how it is stored to
/// the integer the slot holds the use in (`stored_conversion`) ; read as the use
/// (`read_as`) where the slot holds it as it is. The read lies in `use`, so the
/// stored value converts to that integer as the use would.
///
/// @param value  the read, as stored.
/// @param use    the type the typecheck gave the read.
/// @param slot   the type of the slot it moves into, or null when unknown.
/// @return       the local holding the value as the slot does.
held_use_in :: fn(
    fn_ctx: FnCtx,
    value: LocalId,
    use: Type,
    slot: Type | null,
    span: Span,
) -> LocalId {
    target :: stored_conversion(use, slot) ?? return read_as(fn_ctx, value, use, span)
    stored :: held_integer(fn_ctx.locals[i64(value)].type)
    if stored != null && stored.name == target.name {
        return value
    }
    return cast_local(fn_ctx, value, machine_integer_type(target), "cast", span)
}

/// `value`, a local of the function `fn_ctx` builds, as a use of type `use` reads
/// it : itself, or, held in another integer than the use's (a narrowed read), its
/// conversion into a new local of the use's type.
///
/// @param value  the value, read at the type its slot is stored at.
/// @param use    the type the typecheck gave the read.
read_as :: fn(fn_ctx: FnCtx, value: LocalId, use: Type, span: Span) -> LocalId {
    if !narrowed_read(fn_ctx.locals[i64(value)].type, use) {
        return value
    }
    return cast_local(fn_ctx, value, use, "cast", span)
}

/// The type a slot of type `held` is read at for a use of type `use` : its own when
/// the use holds its values in another integer (`narrowed_read`), else the use's.
///
/// @param held  the type the slot is stored at.
/// @param use   the type the typecheck gave the read.
read_type :: fn(held: Type, use: Type) -> Type {
    if narrowed_read(held, use) {
        return held
    }
    return use
}

// Whether a use of type `use` holds the values of a slot of type `held` in another
// integer than the slot does : a read the typecheck narrowed to a range.
narrowed_read :: fn(held: Type, use: Type) -> bool {
    if held is RangeType && use is RangeType && same_interval(held.bounds, use.bounds) {
        return false
    }
    stored :: held_integer(held) ?? return false
    used :: held_integer(use) ?? return false
    return stored.name != used.name
}

// ---- operations -----------------------------------------------------------

/// The integer type an operation is computed in when the integer types it involves
/// differ : one holding every value of `left`, `right` and the result's, each read
/// through any distinct. `Slot == w` (`Slot` over `Hour`, `w: i64`) compares in
/// `i64`, and `a + b` on a distinct over `Int in 0..=200`, a `0..=400`, adds in `u16`.
///
/// @param left    the left operand's type.
/// @param right   the right operand's type ; null for a unary operation.
/// @param result  the operation's type : an integer, or the `bool` of a test,
///                which takes no part.
/// @return        null when the integer types are one, or an operand is no integer.
computation_width :: fn(left: Type, right: Type | null, result: Type) -> RangeType | null {
    if left is RangeType && same_bounds(left, right) && same_bounds(left, result) {
        return null
    }
    width :: computation_integer(left, right, result) ?? return null
    return machine_integer_type(width)
}

// Whether `other` is a range of `left`'s bounds, or none (a unary operation, the
// `bool` of a test holds no integer of its own).
same_bounds :: fn(left: RangeType, other: Type | null) -> bool {
    if other is RangeType {
        return same_interval(left.bounds, other.bounds)
    }
    return other == null || !is_stored_as_integer(other)
}

// The machine integer of `computation_width`.
computation_integer :: fn(left: Type, right: Type | null, result: Type) -> MachineInteger | null {
    l :: held_integer(left) ?? return null
    as_integer :: held_integer(result)
    r :: operand_width(right, l)
    if r == null {
        return null
    }
    if r.name == l.name && (as_integer == null || as_integer.name == l.name) {
        return null
    }
    values := interval_join(l.values, r.values)
    if as_integer != null {
        values = interval_join(values, as_integer.values)
    }
    return narrowest_machine_integer(values)
}

// The integer of the right operand ; `left`'s for a unary operation, null when it
// is no integer.
operand_width :: fn(right: Type | null, left: MachineInteger) -> MachineInteger | null {
    if right == null {
        return left
    }
    return held_integer(right)
}

/// The type an operation of type `result` computed in `width` gives : that integer,
/// or `result` itself for a test or when there is no other width.
///
/// @param result  the operation's type.
/// @param width   the integer it is computed in (`computation_width`), or null.
computed_type :: fn(result: Type, width: RangeType | null) -> Type {
    known :: width ?? return result
    if !is_stored_as_integer(result) {
        return result
    }
    return known
}

// ---- slot types -----------------------------------------------------------

/// The slot types nothing local to an instruction says : each struct's fields as
/// its instance lays them out, each function's parameters.
SlotTypes :: struct {
    /// Each struct's fields, in layout order, by its layout key (`layout_key`).
    fields:          MutableMap<string, CFGStructField[]> = MutableMap<string, CFGStructField[]> {}
    /// The fields of each struct that takes no type argument, by its symbol : the
    /// same layout, found without building its key.
    plain_fields:    MutableMap<i32, CFGStructField[]> = MutableMap<i32, CFGStructField[]> {}
    callees:         CalleeLookup = CalleeLookup {}
    /// Parameter types of each function, at its position in `callees`.
    function_params: Type[][] = []
    /// Parameter types of each import, at its position in `callees`.
    import_params:   Type[][] = []
}

/// Note the fields of the struct `d` lays out.
note_struct_fields :: fn(slots: SlotTypes, d: CFGStructDecl) -> void {
    slots.fields[layout_key(d.origin, d.mangled)] = d.fields
    sym :: d.origin.symbol ?? return
    if d.origin.type_arguments.len() == 0 {
        slots.plain_fields[sym.id] = d.fields
    }
}

/// The key a struct is laid out under : the intern key of its type, or its mangle
/// for a struct no symbol declares. `emit.vader::reserve_cfg_struct` reserves the
/// layout under it, and a value's type finds it by its own intern key.
///
/// @param origin   what the struct was laid out from.
/// @param mangled  its mangled name.
layout_key :: fn(origin: MonoEntry, mangled: string) -> string {
    sym :: origin.symbol ?? return mangled
    return type_intern_key(mk_struct(sym, origin.type_arguments))
}

/// Note the parameter types of a function, or of an import (`is_import`).
///
/// @param mangled  its mangled name.
/// @param symbol   its origin's symbol ; null for a synthetic one.
note_params :: fn(
    slots: SlotTypes,
    mangled: string,
    symbol: Symbol | null,
    params: Type[],
    is_import: bool,
) -> void {
    if is_import {
        index_import(slots.callees, mangled, symbol, i32(slots.import_params.len()))
        slots.import_params.push(params)
        return
    }
    index_function(slots.callees, mangled, symbol, i32(slots.function_params.len()))
    slots.function_params.push(params)
}

/// The parameter types of the function or import a direct call to `callee` runs ;
/// none when the project declares it nowhere.
///
/// @param callee  the symbol the call names.
params_of :: fn(slots: SlotTypes, callee: Symbol) -> Type[] {
    function :: function_called(slots.callees, callee)
    if function != null {
        return slots.function_params[function]
    }
    imported :: import_called(slots.callees, callee) ?? return []
    return slots.import_params[imported]
}

/// The type each field of a literal of type `t` is held as, in the literal's order,
/// which is its layout's : a tuple's elements, a struct's fields as its instance
/// lays them out ; none when no layout is known.
///
/// @param t  the literal's type.
literal_slots :: fn(slots: SlotTypes, t: Type) -> Type[] {
    tuple :: tuple_backing(t)
    if tuple != null {
        return tuple.elements
    }
    fields :: laid_out_fields(slots, t) ?? return []
    out: Type[]: []
    for f in fields {
        out.push(f.type)
    }
    return out
}

/// The type the field `name` of a value of type `t` is held as : a struct's field as
/// its instance lays it out, a union's common field as a variant does ; null when
/// no layout is known.
///
/// @param t     the type of the value holding the field.
/// @param name  the field's name.
field_slot :: fn(slots: SlotTypes, t: Type, name: string) -> Type | null {
    if t is UnionType {
        for v in t.variants {
            found :: field_slot(slots, v, name) ?? continue
            return found
        }
        return null
    }
    fields :: laid_out_fields(slots, t) ?? return null
    for f in fields {
        if f.name == name {
            return f.type
        }
    }
    return null
}

// The fields of the struct a value of type `t` is, in layout order ; null for a
// type no struct the project lays out is.
laid_out_fields :: fn(slots: SlotTypes, t: Type) -> CFGStructField[] | null {
    if t is StructType && t.args.len() == 0 {
        return slots.plain_fields[t.symbol.id]
    }
    return slots.fields[type_intern_key(t)]
}

/// The type an element of an array of type `t` is held as ; null for any other
/// type.
///
/// @param t  the array's type.
element_slot :: fn(t: Type) -> Type | null {
    array :: array_backing(t) ?? return null
    return array.element
}

/// The type at position `i` of `types` ; null past its end.
///
/// @param types  slot types, by position : parameters, results, literal fields.
type_at :: fn(types: Type[], i: i64) -> Type | null {
    if i >= types.len() {
        return null
    }
    return types[i]
}
