// vader/midir/verify — structural self-check of a `CFGProject`.
//
// The CFG carries invariants that no type in `cfg.vader` expresses. A
// `BlockId` is an `i32`, so nothing stops a terminator naming a block that
// does not exist; a `LocalId` is an `i32`, so nothing stops an instruction
// reading a slot past the end of `locals`. The emitter meets such a shape
// late and panics (`emit/bytecode/emit.vader`),
// naming the function it was emitting rather than the pass that broke it.
//
// This module checks the same invariants at a pass boundary and reports
// every violation in one run. Pure read over the CFG — no mutation, no IO —
// wired behind `--verify`, so a normal build does not pay for it.
//
// Symbol resolution (`I7002`) mirrors `emit/bytecode/emit.vader` exactly, and the two
// chains differ in a way that is load-bearing:
//   - `InstrCall` resolves through fn-mangle, fn-symbol, import-symbol, then
//     import-mangle (`resolve_direct_call`).
//   - `InstrFnRef` / `InstrFnAddr` / `InstrMakeClosure` resolve through
//     fn-symbol ONLY — a fn taken as a
//     value has no import path, so an extern-only match is still a break.
// Widening either chain here turns a real break into a pass.

module "vader/midir"

import "std/collections"
import "toolchain/span"
import "vader/support/diagnostics"
import "vader/support/integer"
import "vader/core/symbol"
import "vader/core/types"
import "vader/front/typecheck"

// ---- resolution tables ----------------------------------------------------

// The functions and the externs of a project, and what a check reads of them :
// where a call finds them (`slots.callees`, positions in `functions` and in
// `externs`), what their parameters and each struct's fields are held as.
// Built once per project : rebuilding per function would make the verifier
// quadratic on the self-host. The call graph (`call_graph.vader`) resolves
// through it too, so a callee is found the same way by both.
CfgResolution :: struct {
    functions: CFGFunction[]
    externs:   CFGExternDecl[]
    slots:     SlotTypes
}

// Mirrors `reserve_cfg_function` / `reserve_cfg_extern` (`CalleeLookup`).
build_cfg_resolution :: fn(project: CFGProject) -> CfgResolution {
    functions: CFGFunction[]: []
    externs: CFGExternDecl[]: []
    slots :: SlotTypes {}
    for [_module_id, m] in project.modules {
        for f in m.functions {
            note_params(slots, f.mangled, f.origin.symbol, param_types(f.params), false)
            functions.push(f)
        }
        for e in m.externs {
            note_params(slots, e.mangled, e.origin.symbol, param_types(e.params), true)
            externs.push(e)
        }
        for d in m.struct_decls {
            note_struct_fields(slots, d)
        }
    }
    return CfgResolution {
        .functions = functions,
        .externs = externs,
        .slots = slots,
    }
}

// The type of each of `params`, in order.
param_types :: fn(params: CFGParam[]) -> Type[] {
    out: Type[]: []
    for p in params {
        out.push(p.type)
    }
    return out
}

// `InstrCall`'s full fallback chain.
callee_resolves :: fn(r: CfgResolution, callee: Symbol) -> bool {
    callees :: r.slots.callees
    return function_called(callees, callee) != null || import_called(callees, callee) != null
}

// ---- entry point ----------------------------------------------------------

/// Check every structural invariant of `project`, pushing one diagnostic per
/// violation.
///
/// Reports all violations rather than stopping at the first : a shape break
/// usually surfaces at several sites, and the set is what identifies the
/// producer.
///
/// @param project  the CFG to check. Read only.
/// @param after    name of the pass that just produced `project`, carried
///                 into every detail so the report names the producer
///                 rather than the verifier.
/// @param diags    accumulator ; violations are pushed as `I7xxx` errors.
export verify_cfg :: fn(project: CFGProject, after: string, diags: Diagnostic[]) -> void {
    resolution :: build_cfg_resolution(project)
    for [_module_id, m] in project.modules {
        for f in m.functions { verify_cfg_function(f, resolution, after, diags) }
    }
}

verify_cfg_function :: fn(
    fn_: CFGFunction, resolution: CfgResolution, after: string, diags: Diagnostic[],
) -> void {
    where :: "after `${after}`, in `${fn_.mangled}`"

    // I7008 — the entry is block 0 by convention (`cfg.vader:27`), and the
    // structurer's dominator walk starts there unconditionally.
    if fn_.entry != 0 {
        diags.push(internal_error(.EntryBlockNotZero, fn_span(fn_),
            "${where}: entry is bb${fn_.entry}"))
    }

    // Block ids first, and reachability only when they hold : `walk_rpo`
    // indexes `blocks` by id without a bounds check, so running it on a CFG
    // with a dangling successor crashes the verifier instead of reporting it.
    ids_ok :: verify_block_ids(fn_, where, diags)
    // Reads are only checked where they can run. An unreachable block is NOT
    // a break: `build_cfg_project` mints dead join blocks by design when every
    // arm of a match returns, and the structurer never visits them. When the
    // ids are broken there is no sound walk, so every block is treated as live.
    reachable :: if ids_ok { reachable_blocks(fn_) } else { all_blocks(fn_) }
    reported :: diags.len()
    verify_locals(fn_, reachable, where, diags)
    // The storage check reads each local's type : only once every local id holds.
    locals_ok :: diags.len() == reported
    verify_fn_references(fn_, resolution, reachable, where, diags)
    verify_return_arity(fn_, reachable, where, diags)
    if locals_ok {
        verify_storage(fn_, resolution, reachable, where, diags)
    }
}

// I7013 : every value goes into a slot that holds it in its own integer
// (`storage.vader`) : a local, a field, an element, a parameter, a result, a cell,
// a global ; the operands of an operation, and an integer result, are held in one
// integer ; no local keeps a free literal's type, which no integer holds. A flow
// point the build left unconverted, or a pass that rewired a value into another
// slot, would otherwise reach the emitter, which reads an operation's width off
// one operand and passes a store through as it is.
verify_storage :: fn(
    fn_: CFGFunction,
    resolution: CfgResolution,
    reachable: MutableSet<BlockId>,
    where: string,
    diags: Diagnostic[],
) -> void {
    check :: StorageCheck {
        .fn_ = fn_,
        .slots = resolution.slots,
        .where = where,
        .diags = diags,
    }
    // A free literal's type has no integer to hold it : the lowering defaults it.
    for l in fn_.locals {
        if free_member(l.type) != null {
            detail :: "${where}: the local `${l.name}` has the free type `${display_type(l.type)}`"
            diags.push(internal_error(.StorageMismatch, fn_span(fn_), detail))
        }
    }
    for b in fn_.blocks {
        if !reachable.contains(b.id) {
            continue
        }
        for ins in b.instructions {
            check_instruction_storage(check, ins)
        }
        t :: b.terminator
        if t is TermReturn {
            check_return_storage(check, t)
        }
    }
}

// What a storage check reads and reports against.
StorageCheck :: struct {
    fn_: CFGFunction
    slots: SlotTypes
    where: string
    diags: Diagnostic[]
}

// The slots `ins` moves values into, each value checked against its slot.
check_instruction_storage :: fn(check: StorageCheck, ins: Instruction) -> void {
    slots :: check.slots
    match ins {
        is InstrMove      -> { check_slot(check, ins.src, local_type(check, ins.dst), ins.span) }
        is InstrFieldSet  -> {
            if holds_integer(check, ins.value) {
                slot :: field_slot(slots, local_type(check, ins.target), ins.field)
                check_slot(check, ins.value, slot, ins.span)
            }
        }
        is InstrUnionFieldSet -> {
            if holds_integer(check, ins.value) {
                slot :: field_slot(slots, local_type(check, ins.target), ins.field)
                check_slot(check, ins.value, slot, ins.span)
            }
        }
        is InstrArraySet  -> {
            check_slot(check, ins.value, element_slot(local_type(check, ins.target)), ins.span)
        }
        is InstrArrayPush -> {
            check_slot(check, ins.value, element_slot(local_type(check, ins.target)), ins.span)
        }
        is InstrStructNew -> {
            check_values(check, ins.fields, literal_slots(slots, ins.type), ins.span)
        }
        is InstrArrayNew  -> {
            slot :: element_slot(ins.type)
            for el in ins.elements {
                check_slot(check, el, slot, ins.span)
            }
        }
        is InstrGlobalSet -> { check_slot(check, ins.value, ins.type, ins.span) }
        is InstrCellNew   -> { check_slot(check, ins.value, ins.value_type, ins.span) }
        is InstrCellSet   -> { check_slot(check, ins.value, ins.value_type, ins.span) }
        is InstrCall      -> {
            check_values(check, ins.args, params_of(slots, ins.callee), ins.span)
        }
        is InstrCallIndirect -> {
            check_values(check, ins.args, param_types_of(ins.fn_type), ins.span)
        }
        is InstrVirtualCall -> { check_values(check, ins.args, ins.param_types, ins.span) }
        is InstrIntrinsic   -> { check_values(check, ins.args, ins.param_types, ins.span) }
        is InstrArraySlice  -> {
            check_slot(check, ins.lo, TY_I64, ins.span)
            check_slot(check, ins.hi, TY_I64, ins.span)
        }
        is InstrBinOp       -> { check_operation(check, ins.lhs, ins.rhs, ins.type, ins.span) }
        is InstrUnOp        -> { check_operation(check, ins.operand, null, ins.type, ins.span) }
        // No slot to fill : a constant, a read, a conversion, a closure, a deferred
        // block.
        is InstrConst | InstrFnRef | InstrFnAddr | InstrFieldGet
         | InstrUnionFieldGet | InstrArrayGet | InstrArrayLen
         | InstrDataConst | InstrGlobalGet | InstrTypeCheck | InstrTypeConst | InstrCast
         | InstrCellGet | InstrMakeClosure | InstrDeferPush | InstrDeferPopExec -> {}
    }
}

// The values a return hands back, against the function's result or, scalarised,
// its elements.
check_return_storage :: fn(check: StorageCheck, t: TermReturn) -> void {
    results :: check.fn_.scalarised_results
    if results.len() > 1 {
        check_values(check, t.values, results, t.span)
        return
    }
    if t.values.len() == 1 {
        check_slot(check, t.values[0], check.fn_.return_type, t.span)
    }
}

// Each of `values` against the slot of `slots` at its position, where known.
check_values :: fn(check: StorageCheck, values: LocalId[], slots: Type[], span: Span) -> void {
    for i in 0..<values.len() {
        check_slot(check, values[i], type_at(slots, i), span)
    }
}

// Whether the local `l` holds an integer : only then has its slot to be looked up.
holds_integer :: fn(check: StorageCheck, l: LocalId) -> bool =
    held_integer(local_type(check, l)) != null

// I7013 when `value` goes into a slot of type `slot` that holds it in another
// integer than its own ; nothing for a slot unknown.
check_slot :: fn(check: StorageCheck, value: LocalId, slot: Type | null, span: Span) -> void {
    held :: local_type(check, value)
    target :: stored_conversion(held, slot) ?? return
    detail :: "${check.where}: `${display_type(held)}` held in `${stored_name(held)}` " +
        "goes into a slot of `${display_type(slot ?? held)}` held in `${target.name}`"
    check.diags.push(internal_error(.StorageMismatch, span, detail))
}

// I7013 when the integer operands of an operation, or its integer result, are held
// in different integers : the emitter computes in the left operand's.
check_operation :: fn(
    check: StorageCheck,
    left: LocalId,
    right: LocalId | null,
    result: Type,
    span: Span,
) -> void {
    l :: held_integer(local_type(check, left)) ?? return
    if right != null {
        r :: held_integer(local_type(check, right))
        check_same_integer(check, l, r, "its right operand", span)
    }
    check_same_integer(check, l, held_integer(result), "its result", span)
}

// I7013 when `other`, an integer of an operation whose left operand is held in
// `left`, is held in another ; nothing for no integer.
check_same_integer :: fn(
    check: StorageCheck,
    left: MachineInteger,
    other: MachineInteger | null,
    what: string,
    span: Span,
) -> void {
    known :: other ?? return
    if known.name == left.name {
        return
    }
    detail :: "${check.where}: an operation's left operand is held in `${left.name}`, " +
        "${what} in `${known.name}`"
    check.diags.push(internal_error(.StorageMismatch, span, detail))
}

local_type :: fn(check: StorageCheck, l: LocalId) -> Type = check.fn_.locals[i64(l)].type

// The name of the integer a value of type `t` is held in ; the type itself for none.
stored_name :: fn(t: Type) -> string {
    held :: held_integer(t) ?? return display_type(t)
    return held.name
}

// I7010 — every `return` hands back what the signature will declare.
//
// The invariant the value ABI introduces, and the one worth checking here: the
// arity has to survive from `scalarise_value_returns` to three backends, and a
// `CFGFunction` rebuild that drops `scalarised_results` leaves the body handing
// back two values under a signature that promises one. Nothing downstream
// compares the two — the C emitter writes the signature from the field and the
// body from the terminator, and the mismatch surfaces as a stack-depth ICE in a
// different function, or not at all.
verify_return_arity :: fn(
    fn_: CFGFunction, reachable: MutableSet<BlockId>, where: string, diags: Diagnostic[],
) -> void {
    // A scalarised fn hands back its elements ; every other fn hands back one
    // value, or none when it returns void.
    expected :: if fn_.scalarised_results.len() > 1 {
        fn_.scalarised_results.len()
    } else if is_void(fn_.return_type) {
        0
    } else {
        1
    }
    for b in fn_.blocks {
        if !reachable.contains(b.id) {
            continue
        }
        t :: b.terminator
        if t !is TermReturn {
            continue
        }
        // An empty `return` on a value-returning fn is the dead trailing return
        // the lowerer emits when every path already returned ; `c_emit` turns it
        // into a trap. Not a break.
        if t.values.len() == 0 || t.values.len() == expected {
            continue
        }
        // A `void` fn whose last statement is a `@no_return` call returns that
        // call's result, typed `never`. Nothing is produced and no backend reads
        // it — the terminator just names the divergent value.
        if returns_only_never(fn_, t.values) {
            continue
        }
        diags.push(internal_error(.ReturnArityMismatch, t.span,
            "${where}: bb${b.id} returns ${t.values.len()} value(s), the signature declares ${expected}"))
    }
}

// ---- structural checks ----------------------------------------------------

// I7004 — every BlockId a terminator names must address a real block, and a
// block's `id` must equal its index : `predecessors_of` and the emitter both
// index `blocks` by id, so a mismatch silently reads the wrong block.
// Returns false when any id is broken, which disables the reachability walk.
verify_block_ids :: fn(fn_: CFGFunction, where: string, diags: Diagnostic[]) -> bool {
    block_count :: i32(fn_.blocks.len())
    ok: bool = true
    for i in 0..<fn_.blocks.len() {
        b :: fn_.blocks[i]
        if b.id != i32(i) {
            diags.push(internal_error(.BlockIdOutOfRange, b.span,
                "${where}: block at index ${i32(i)} carries id bb${b.id}"))
            ok = false
        }
        for succ in successors_of(b) {
            if i32(succ) >= 0 && i32(succ) < block_count { continue }
            diags.push(internal_error(.BlockIdOutOfRange, b.span,
                "${where}: bb${b.id} branches to bb${succ}, but the fn has ${block_count} blocks"))
            ok = false
        }
    }
    return ok
}

// I7005 / I7006 — a LocalId indexes `locals`, and a local that is read must be
// written somewhere.
//
// The write check is deliberately weak : it asks for ONE write anywhere in the
// fn, not for a write that dominates the read. Def-before-use needs the
// dominator tree, and `compute_dominators` is only sound on a reducible CFG —
// itself one of the things a broken pass can violate. A cheap check that never
// false-positives beats a precise one that fires on its own broken input.
verify_locals :: fn(
    fn_: CFGFunction, reachable: MutableSet<BlockId>, where: string, diags: Diagnostic[],
) -> void {
    local_count :: i32(fn_.locals.len())
    written :: MutableSet<LocalId> {}
    // Params are written by the implicit entry store the translator emits
    // (`cfg.vader::CFGParam.local`), which may carry no instruction of its own.
    for p in fn_.params { written.add(p.local) }
    for b in fn_.blocks {
        for ins in b.instructions {
            multi :: multi_dsts(ins)
            if multi != null {
                for l in multi { written.add(l) }
            } else {
                d :: dst_of(ins)
                if d != null { written.add(d) }
            }
        }
    }

    // One report per offending slot : a bad local is usually read in a loop,
    // and N copies of the same line bury the other violations.
    ranged :: MutableSet<LocalId> {}
    unwritten :: MutableSet<LocalId> {}
    report :: (id: LocalId, sp: Span, site: string) -> {
        if i32(id) < 0 || i32(id) >= local_count {
            if !ranged.add(id) {
                return
            }
            diags.push(internal_error(.LocalIdOutOfRange, sp,
                "${where}: ${site} names local ${id}, but the fn has ${local_count} locals"))
            return
        }
        if written.contains(id) { return }
        if !unwritten.add(id)   { return }
        diags.push(internal_error(.LocalReadNeverWritten, sp,
            "${where}: local ${id} `${fn_.locals[i32(id)].name}` is read by ${site} but never written"))
    }

    for b in fn_.blocks {
        if !reachable.contains(b.id) { continue }
        for ins in b.instructions {
            for_each_read_local(ins, (l: LocalId) -> { report(l, ins.span, "bb${b.id}") })
            d :: dst_of(ins)
            if d != null && (i32(d) < 0 || i32(d) >= local_count) {
                report(d, ins.span, "bb${b.id}")
            }
        }
        for_each_read_in_terminator(b.terminator, (l: LocalId) -> {
            report(l, b.span, "bb${b.id}'s terminator")
        })
    }
}

// I7002 — the emitter's four unresolved-callee panics, as one check. Reachable blocks only:
// `emit_cfg_function_body` walks from the entry, so a
// reference in a dead block never resolves and never breaks the emit. The
// file header explains why the call chain and the fn-as-value chain differ.
verify_fn_references :: fn(
    fn_: CFGFunction, resolution: CfgResolution, reachable: MutableSet<BlockId>,
    where: string, diags: Diagnostic[],
) -> void {
    for b in fn_.blocks {
        if !reachable.contains(b.id) { continue }
        for ins in b.instructions {
            match ins {
                is InstrCall -> {
                    if callee_resolves(resolution, ins.callee) { continue }
                    diags.push(internal_error(.UnresolvedFnReference, ins.span,
                        "${where}: call to `${ins.callee.name}` (symbol ${ins.callee.id}) matches no emitted fn and no import"))
                }
                // One arm for the three: they carry `span` / `dst` /
                // `fn_symbol` at the same positions, so the shared fields read
                // straight off the union — and the fn-as-value rule keeps one
                // site rather than three copies to hold in step.
                is InstrFnRef | InstrFnAddr | InstrMakeClosure -> {
                    if function_called(resolution.slots.callees, ins.fn_symbol) != null { continue }
                    diags.push(internal_error(.UnresolvedFnReference, ins.span,
                        "${where}: ${fn_value_kind(ins)} `${ins.fn_symbol.name}` (symbol ${ins.fn_symbol.id}) was never materialised"))
                }
                _ -> {}
            }
        }
    }
}

// ---- helpers --------------------------------------------------------------

// Blocks the entry can reach, via the shared RPO walk.
reachable_blocks :: fn(fn_: CFGFunction) -> MutableSet<BlockId> {
    out :: MutableSet<BlockId> {}
    // `walk_rpo` reads `visited[entry]` before testing anything, so an empty
    // block list would index past the end.
    if fn_.blocks.len() == 0 { return out }
    for b in reverse_postorder(fn_) { out.add(b) }
    return out
}

// Every block, for the degraded path where a broken id makes the RPO walk
// unsound. Checking a read in a block that may be dead beats skipping it.
all_blocks :: fn(fn_: CFGFunction) -> MutableSet<BlockId> {
    out :: MutableSet<BlockId> {}
    for b in fn_.blocks { out.add(b.id) }
    return out
}

// Names the three fn-as-value instructions apart in the detail line: an
// unresolved fn-addr points at a callback, a closure at a capture, and the
// two are chased through different passes.
fn_value_kind :: fn(ins: InstrFnRef | InstrFnAddr | InstrMakeClosure) = match ins {
    is InstrFnRef       -> "fn-ref"
    is InstrFnAddr      -> "fn-addr"
    is InstrMakeClosure -> "closure over"
}

// Whether every value the terminator names is `never` — the result of a
// divergent call, which produces nothing to hand back.
returns_only_never :: fn(fn_: CFGFunction, values: LocalId[]) -> bool {
    for v in values {
        if i64(v) !in 0..<fn_.locals.len() {
            return false
        }
        if fn_.locals[i64(v)].type !is NeverType {
            return false
        }
    }
    return true
}
