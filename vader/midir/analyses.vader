// vader/midir/analyses — shared CFG analyses + traversals.
//
// Pure data — no IO, no diagnostics.
// Used by the structurer (`emit.vader`), DCE (`cfg_dce.vader`), escape
// (`escape.vader`) and any future Mid-IR pass.
//
// Operand-walking helpers (`for_each_read_local`,
// `for_each_read_in_terminator`) thread a closure that gets called on
// every LocalId read. `dst_of` returns the single LocalId written by
// an instruction (or null for pure side-effecting ops + zero-result
// calls). `instruction_has_side_effect` keeps DCE from dropping ops
// whose dst is unread but whose execution observably mutates state.

module "vader/midir"

import "std/collections"
import "std/iter"

// ---- successor / predecessor edges ---------------------------------------

/// Successors of a block, derived from its terminator.
export successors_of :: fn(b: BasicBlock) -> BlockId[]! {
    match b.terminator as t {
        is TermBranch      -> { return [t.target] }
        is TermCondBranch  -> { return [t.then_block, t.else_block] }
        is TermReturn      -> { return [] }
        is TermUnreachable -> { return [] }
    }
}

/// Predecessor lists keyed by BlockId. The returned array is dense
/// (one entry per block, possibly empty).
export predecessors_of :: fn(fn_: CFGFunction) -> BlockId[][] {
    // The inner lists must be mutable to be filled, the outer only read — and the
    // element is covariant into the read-only array the signature promises, so
    // `out` returns as-is.
    out: BlockId[][]: filled(fn_.blocks.len(), () -> [])
    for b in fn_.blocks {
        for succ in successors_of(b) { out[i32(succ)].push(b.id) }
    }
    return out
}

// ---- side-effect classification ------------------------------------------

/// True when the instruction has observable effect outside its `dst`
/// slot: it writes memory, or runs code that may (`instruction_runs_code`).
/// DCE keeps these alive even when their result local is unread. Every other
/// instruction writes at most its `dst`: `InstrDeferPush` only queues a thunk,
/// which runs at the `InstrDeferPopExec` reported here.
export instruction_has_side_effect :: fn(ins: Instruction) -> bool =
    instruction_runs_code(ins) ||
        ins is InstrFieldSet | InstrArraySet | InstrArrayPush | InstrCellSet

/// True when executing the instruction runs code the CFG does not show: a
/// call of any kind, an intrinsic, or the deferred blocks a scope exit pops.
/// That code may change any memory the function reaches, an array's length
/// included.
export instruction_runs_code :: fn(ins: Instruction) -> bool =
    ins is InstrCall | InstrCallIndirect | InstrVirtualCall | InstrIntrinsic | InstrDeferPopExec

// ---- operand walks --------------------------------------------------------

/// Apply `visit` to every local read by the instruction (its operands).
export for_each_read_local :: fn(ins: Instruction, visit: fn(LocalId) -> void) -> void {
    match ins {
        is InstrConst  -> {}
        is InstrFnRef  -> {}
        is InstrFnAddr -> {}
        is InstrMove   -> { visit(ins.src) }
        is InstrBinOp  -> {
            visit(ins.lhs)
            visit(ins.rhs)
        }
        is InstrUnOp         -> { visit(ins.operand) }
        is InstrCall         -> { for a in ins.args { visit(a) } }
        is InstrCallIndirect -> {
            visit(ins.callee)
            for a in ins.args { visit(a) }
        }
        is InstrVirtualCall -> {
            visit(ins.receiver)
            for a in ins.args { visit(a) }
        }
        is InstrFieldGet -> { visit(ins.target) }
        is InstrFieldSet -> {
            visit(ins.target)
            visit(ins.value)
        }
        is InstrArrayGet -> {
            visit(ins.target)
            visit(ins.index)
        }
        is InstrArraySet -> {
            visit(ins.target)
            visit(ins.index)
            visit(ins.value)
        }
        is InstrArrayLen  -> { visit(ins.target) }
        is InstrArrayPush -> {
            visit(ins.target)
            visit(ins.value)
        }
        is InstrArraySlice -> {
            visit(ins.target)
            visit(ins.lo)
            visit(ins.hi)
        }
        is InstrStringSlice -> {
            visit(ins.target)
            visit(ins.lo)
            visit(ins.hi)
        }
        is InstrStructNew -> { for f in ins.fields { visit(f) } }
        is InstrArrayNew  -> { for e in ins.elements { visit(e) } }
        is InstrTypeCheck -> { visit(ins.value) }
        is InstrTypeConst -> {}
        is InstrDataConst -> {}
        is InstrCast      -> { visit(ins.value) }
        is InstrCellNew   -> { visit(ins.value) }
        is InstrCellGet   -> { visit(ins.cell) }
        is InstrCellSet   -> {
            visit(ins.cell)
            visit(ins.value)
        }
        is InstrMakeClosure  -> { visit(ins.env) }
        is InstrIntrinsic    -> { for a in ins.args { visit(a) } }
        is InstrDeferPush    -> { visit(ins.value) }
        is InstrDeferPopExec -> {}
    }
}

/// Apply `visit` to every local read by the terminator.
export for_each_read_in_terminator :: fn(t: Terminator, visit: fn(LocalId) -> void) -> void {
    match t {
        is TermCondBranch -> {
            visit(t.cond)
        }
        is TermReturn -> {
            for v in t.values {
                visit(v)
            }
        }
        is TermBranch          -> {}
        is TermUnreachable     -> {}
    }
}

// ---- natural loops --------------------------------------------------------

/// Natural-loop bodies, keyed by header block id. A back-edge u→v
/// exists when v dominates u ; the natural loop's body is
/// `{v} ∪ all blocks that reach u without going through v`. Returns
/// one entry per back-edge target. Pure-fn — caller passes the preds
/// + idom they already computed.
export natural_loop_bodies :: fn(
    fn_: CFGFunction, preds: BlockId[][], idom: i32[],
) -> MutableMap<BlockId, MutableSet<BlockId>> {
    out :: MutableMap<BlockId, MutableSet<BlockId>> {}
    for h in 0..<fn_.blocks.len() {
        h_id :: BlockId(h)
        back_edge_sources: BlockId[]: []
        for p in preds[h] {
            if dominates(idom, h_id, p) {
                back_edge_sources.push(p)
            }
        }
        if back_edge_sources.len() == 0 {
            continue
        }
        body :: MutableSet<BlockId> {}
        body.add(h_id)
        stack: BlockId[] = back_edge_sources.clone()
        for stack.len() > 0 {
            cur :: stack[stack.len() - 1]
            stack = stack[0..<stack.len() - 1]
            if body.contains(cur) {
                continue
            }
            body.add(cur)
            for p in preds[i32(cur)] {
                if p != h_id { stack.push(p) }
            }
        }
        out[h_id] = body
    }
    return out
}

// ---- use counts -----------------------------------------------------------

/// Per-LocalId read count across the whole fn body. Every read in an
/// instruction or terminator counts once. Used by copy folding, the
/// stack scheduler, and any pass that needs use-counts.
export count_uses :: fn(fn_: CFGFunction) -> MutableMap<LocalId, i32> {
    counts :: MutableMap<LocalId, i32> {}
    bump :: (l: LocalId) -> {
        existing :: counts[l]
        match existing {
            is null -> { counts[l] = 1 }
            _ -> { counts[l] = existing + 1 }
        }
    }
    for b in fn_.blocks {
        for ins in b.instructions { for_each_read_local(ins, bump) }
        for_each_read_in_terminator(b.terminator, bump)
    }
    return counts
}

// ---- dominator analysis ---------------------------------------------------

/// Reverse-postorder of the CFG starting from the entry. Stable
/// across runs. Used by every dataflow analysis that wants to visit
/// predecessors before successors (forward flow) or successors
/// before predecessors (backward).
export reverse_postorder :: fn(fn_: CFGFunction) -> BlockId[] {
    order: BlockId[]: []
    visited: bool[]: [false] * fn_.blocks.len()
    walk_rpo(fn_, fn_.entry, visited, order)
    // Reverse in place.
    out: BlockId[]: [] * order.len()
    i := order.len()
    for i > 0 {
        i = i - 1
        out.push(order[i])
    }
    return out
}

/// Each block's position in `rpo`, indexed by block id; -1 for a block the
/// entry cannot reach.
///
/// @param rpo  a function's blocks in reverse postorder.
/// @param n    the function's block count.
export rpo_positions :: fn(rpo: BlockId[], n: usize) -> i32[] {
    positions: i32[]: [-1] * n
    for i in 0..<rpo.len() {
        positions[i32(rpo[i])] = i32(i)
    }
    return positions
}

walk_rpo :: fn(fn_: CFGFunction, b: BlockId, visited: bool[], order: BlockId[]) -> void {
    if visited[i32(b)] { return }
    visited[i32(b)] = true
    for s in successors_of(fn_.blocks[i32(b)]) { walk_rpo(fn_, s, visited, order) }
    order.push(b)
}

/// Cooper-Harvey-Kennedy iterative dominator computation. Returns
/// `idom[b]` = immediate dominator of `b` (entry's idom is itself ;
/// unreachable blocks return -1 — interpreted as "no known idom").
export compute_dominators :: fn(fn_: CFGFunction, preds: BlockId[][]) -> i32[] {
    n :: fn_.blocks.len()
    idom: i32[]: [-1] * n
    idom[i32(fn_.entry)] = i32(fn_.entry)
    rpo :: reverse_postorder(fn_)
    changed := true
    for changed {
        changed = false
        for b in rpo {
            if b == fn_.entry { continue }
            new_idom := -1
            for p in preds[i32(b)] {
                if idom[i32(p)] == -1 { continue }
                if new_idom == -1 {
                    new_idom = i32(p)
                } else {
                    new_idom = i32(intersect_dom_tree(p, BlockId(new_idom), idom))
                }
            }
            if new_idom != -1 && idom[i32(b)] != new_idom {
                idom[i32(b)] = new_idom
                changed = true
            }
        }
    }
    return idom
}

/// Lowest-common-ancestor in a (post-)dominator tree. Walks `a`'s
/// ancestor chain into a set, then walks `b`'s chain until hitting a
/// known ancestor. We fall back to the LCA walk because block IDs
/// don't follow RPO order after CFG construction (block IDs reflect
/// creation order in the converter, not RPO).
export intersect_dom_tree :: fn(a: BlockId, b: BlockId, idom: i32[]) -> BlockId {
    seen :: MutableSet<i32> {}
    x := a
    for x != -1 && !seen.contains(i32(x)) {
        seen.add(i32(x))
        next :: BlockId(idom[i32(x)])
        if next == x { break }
        x = next
    }
    y := b
    for y != -1 {
        if seen.contains(i32(y)) {
            return y
        }
        next :: BlockId(idom[i32(y)])
        if next == y {
            break
        }
        y = next
    }
    return BlockId(-1)
}

/// True iff `a` dominates `b` (every path from entry to `b` passes
/// through `a`). Walks `b`'s idom chain.
export dominates :: fn(idom: i32[], a: BlockId, b: BlockId) -> bool {
    cur := b
    for cur != -1 {
        if cur == a {
            return true
        }
        next :: BlockId(idom[i32(cur)])
        if next == cur {
            return cur == a
        }
        cur = next
    }
    return false
}

// ---- liveness -------------------------------------------------------------

/// Per-block live-in / live-out sets. Standard backward dataflow on
/// the use/def of each block. Used by DCE (kill-dead-stores).
export Liveness :: struct {
    live_in:  MutableSet<LocalId>![]
    live_out: MutableSet<LocalId>![]
}

export compute_liveness :: fn(fn_: CFGFunction) -> Liveness {
    n :: fn_.blocks.len()
    use_: MutableSet<LocalId>[]: [] * n
    def_: MutableSet<LocalId>[]: [] * n
    for i in 0..<n {
        b :: fn_.blocks[i]
        u :: MutableSet<LocalId> {}
        d :: MutableSet<LocalId> {}
        for ins in b.instructions {
            for_each_read_local(ins, (l: LocalId) -> {
                if !d.contains(l) { u.add(l) }
            })
            multi :: multi_dsts(ins)
            if multi != null {
                for l in multi { d.add(l) }
            } else {
                ds :: dst_of(ins)
                if ds != null { d.add(ds) }
            }
        }
        for_each_read_in_terminator(b.terminator, (l: LocalId) -> {
            if !d.contains(l) { u.add(l) }
        })
        use_.push(u)
        def_.push(d)
    }

    succs: BlockId[][]: [] * n
    for b in fn_.blocks { succs.push(successors_of(b)) }

    live_in:  MutableSet<LocalId>[]: filled(n, () -> MutableSet<LocalId> {})
    live_out: MutableSet<LocalId>[]: filled(n, () -> MutableSet<LocalId> {})

    // Double-buffered fixpoint : recompute each block's live_out / live_in into
    // two reusable SCRATCH sets (cleared each round), then SWAP a scratch with
    // the stored set only when it actually changed. The old set becomes the next
    // scratch — so the fixpoint allocates zero sets per iteration×block (it minted
    // a fresh `out` + `in_set` every round before — millions of dead allocations
    // once a block stabilised). The clear()ed scratch keeps its backing arrays.
    scratch_out := MutableSet<LocalId> {}
    scratch_in  := MutableSet<LocalId> {}
    changed := true
    for changed {
        changed = false
        i := n
        for i > 0 {
            i = i - 1
            scratch_out.clear()
            for s in succs[i] {
                for l in live_in[i32(s)] { scratch_out.add(l) }
            }
            scratch_in.clear()
            for l in use_[i] { scratch_in.add(l) }
            for l in scratch_out { if !def_[i].contains(l) { scratch_in.add(l) } }
            if !sets_equal(scratch_out, live_out[i]) {
                old_out :: live_out[i]
                live_out[i] = scratch_out
                scratch_out = old_out
                changed = true
            }
            if !sets_equal(scratch_in, live_in[i]) {
                old_in :: live_in[i]
                live_in[i] = scratch_in
                scratch_in = old_in
                changed = true
            }
        }
    }
    return Liveness { .live_in = live_in, .live_out = live_out }
}

sets_equal :: fn(a: MutableSet<LocalId>, b: MutableSet<LocalId>) -> bool {
    if a.len() != b.len() {
        return false
    }
    for x in a {
        if x !in b {
            return false
        }
    }
    return true
}

// ---- dst extraction -------------------------------------------------------

/// The locals an instruction writes when there are SEVERAL — a call handing back
/// a scalarised composite — or null when `dst_of` answers for it.
///
/// Deliberately not a `visit` callback: the definition walks that need this run
/// over every instruction of every function, and a closure there costs two heap
/// objects per instruction. `compute_liveness` alone visits 312k of them.
/// The pair `multi_dsts` + `dst_of` is the whole rule, and it allocates nothing.
export multi_dsts :: fn(ins: Instruction) -> LocalId[] | null {
    if ins is InstrCall {
        return ins.dsts
    }
    return null
}

/// The local an instruction writes to, or `null` for pure side-
/// effecting ops (FieldSet, ArraySet, …), zero-result calls — and a call
/// handing back SEVERAL values, where there is no single answer. Ask
/// `multi_dsts` first when every written local matters, or `writes_local`
/// about one.
export dst_of :: fn(ins: Instruction) -> LocalId | null {
    match ins {
        is InstrConst             -> { return ins.dst }
        is InstrMove              -> { return ins.dst }
        is InstrBinOp             -> { return ins.dst }
        is InstrUnOp              -> { return ins.dst }
        is InstrFieldGet          -> { return ins.dst }
        is InstrArrayGet          -> { return ins.dst }
        is InstrArrayLen          -> { return ins.dst }
        is InstrArraySlice        -> { return ins.dst }
        is InstrStringSlice       -> { return ins.dst }
        is InstrStructNew         -> { return ins.dst }
        is InstrArrayNew          -> { return ins.dst }
        is InstrTypeCheck         -> { return ins.dst }
        is InstrTypeConst         -> { return ins.dst }
        is InstrCast              -> { return ins.dst }
        is InstrCellNew           -> { return ins.dst }
        is InstrCellGet           -> { return ins.dst }
        is InstrMakeClosure       -> { return ins.dst }
        is InstrFnRef             -> { return ins.dst }
        is InstrFnAddr            -> { return ins.dst }
        is InstrDataConst         -> { return ins.dst }
        is InstrCall              -> { return call_single_dst(ins) }
        is InstrCallIndirect      -> { return ins.dst }
        is InstrVirtualCall       -> { return ins.dst }
        is InstrIntrinsic         -> { return ins.dst }
        is InstrFieldSet          -> { return null }
        is InstrArraySet          -> { return null }
        is InstrArrayPush         -> { return null }
        is InstrCellSet           -> { return null }
        is InstrDeferPush         -> { return null }
        is InstrDeferPopExec      -> { return null }
    }
}

/// Whether `ins` writes `local`, one of several results included. Allocates
/// nothing, for the same reason as `multi_dsts`.
export writes_local :: fn(ins: Instruction, local: LocalId) -> bool {
    dsts :: multi_dsts(ins)
    if dsts != null {
        return local in dsts
    }
    dst :: dst_of(ins) ?? return false
    return dst == local
}
