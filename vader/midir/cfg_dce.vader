// vader/midir/cfg_dce — CFG-level cleanup on each `CFGFunction`.
//
//   Pass 0 — `fold_moves` : copy-fold `producer.dst=X ; Move dst=Y src=X`
//            where X is single-use, so the producer writes directly into
//            Y and the Move drops. Unlocks const-folding through let-
//            bindings (`a :: 7 ; b :: 5 ; a*b` would otherwise stall at
//            the moves). It must NOT reorder across an intervening READ of
//            the Move's destination — see `tests/snippets/swap_reassign`.
//   Pass 1 — `compact_locals` (drop unreferenced locals, renumber).
//
// Dead-instruction elimination used to sit between the two and is gone :
// it removed 73 ops out of 129 772 on the compiler itself for ~10,5 % of the
// emit time. Record : `.claude/plans/2026-09-13-audit-optimisations-transparentes.md`.

module "vader/midir"

import "std/collections"

/// Top-level entry — apply all CFG-level optimisations to every fn in
/// the project. Pure : returns a fresh CFGProject sharing unchanged
/// modules with the input.
export eliminate_dead_cfg :: fn(p: CFGProject!) -> CFGProject {
    new_modules :: MutableMap<string, CFGModule> {}
    for [module_id, m] in p.modules {
        new_fns: CFGFunction[]!: []
        for f in m.functions { new_fns.push(optimise_function(f)) }
        new_modules[module_id] = CFGModule {
            .module_id    = m.module_id,
            .display_path = m.display_path,
            .functions    = new_fns,
            .externs      = m.externs,
            .struct_decls = m.struct_decls,
        }
    }
    return CFGProject { ...p, .modules = new_modules }
}

optimise_function :: fn(f: CFGFunction) -> CFGFunction = compact_locals(fold_moves(f))

// ============================================================================
// Pass 0 — fold_moves : copy-fold producer → Move chains
// ============================================================================

fold_moves :: fn(f: CFGFunction) -> CFGFunction {
    use_count :: count_uses(f)
    param_locals: MutableSet<LocalId>: MutableSet<LocalId> {}
    for p in f.params { param_locals.add(p.local) }

    new_blocks: BasicBlock[]!: []
    for b in f.blocks {
        new_blocks.push(BasicBlock {
            .id           = b.id,
            .instructions = fold_moves_in_block(b, use_count, param_locals),
            .terminator   = b.terminator,
            .span         = b.span,
        })
    }
    return CFGFunction { ...f, .blocks = new_blocks }
}

fold_moves_in_block :: fn(
    b: BasicBlock, use_count: MutableMap<LocalId, i32>, param_locals: MutableSet<LocalId>,
) -> Instruction[] {
    folded: Instruction[]!: []
    for i in 0..<b.instructions.len() {
        ins :: b.instructions[i]
        if !(ins is InstrMove) { folded.push(ins)  continue }
        if ins is InstrMove {
            if param_locals.contains(ins.src) { folded.push(ins)  continue }
            count_opt :: use_count[ins.src]
            count :: if count_opt is i32 as c { c } else { 0 }
            if count != 1 { folded.push(ins)  continue }
            // Walk back through folded to find the producer of `m.src`.
            // Folding rewrites the producer to write `m.dst` at the
            // producer's (earlier) position, so any instruction BETWEEN the
            // producer and this Move that touches `m.dst` would then observe
            // the wrong value. Bail when such an intervening instr WRITES
            // `m.dst` (stale-value resurrection) OR READS it — the latter is
            // the swap/rotate idiom `a = b ; b = c` : folding `b = (a+b)` up
            // past `a = b` makes the `a = b` read the not-yet-clobbered
            // slot's new value, doubling instead of swapping.
            mdst :: ins.dst
            producer_idx: i64 = -1
            intervening := false
            // Reused mutable cell for the closure below — declared once, reset
            // per iteration (a fresh `[false]` per step would heap-allocate on
            // every backward step).
            reads_cell: bool[]!: [false]
            j: i64 = i64(folded.len()) - 1
            for j >= 0 {
                cand :: folded[usize(j)]
                cdst_opt :: dst_of(cand)
                if cdst_opt is LocalId {
                    if cdst_opt == ins.src { producer_idx = j  break }
                    if cdst_opt == mdst { intervening = true  break }
                }
                reads_cell[0] = false
                for_each_read_local(cand, (l: LocalId) -> {
                    if l == mdst { reads_cell[0] = true }
                })
                if reads_cell[0] { intervening = true  break }
                j = j - 1
            }
            if producer_idx < 0 || intervening { folded.push(ins)  continue }
            producer :: folded[usize(producer_idx)]
            if instruction_has_side_effect(producer) { folded.push(ins)  continue }
            rewritten :: with_dst(producer, ins.dst)
            folded[usize(producer_idx)] = rewritten
            // Move drops — don't push it. continue the outer loop.
        }
    }
    return folded
}

// ============================================================================
// Pass 1 — compact_locals : drop unreferenced locals + renumber survivors
//
// Walks every instruction + terminator collecting referenced locals.
// Params + side-effecting dsts always count (the slot must exist for
// `local.set` to land even when the value goes unread). Builds a new
// `locals[]` containing only referenced entries, renumbers every read
// + write to the compact index space. Pure instructions whose dst
// renumbered to -1 (unused) drop entirely.
// ============================================================================

compact_locals :: fn(f: CFGFunction) -> CFGFunction {
    n :: f.locals.len()
    referenced: bool[]!: [false] * n
    // Params keep their slots regardless.
    for p in f.params { if usize(p.local) < n { referenced[usize(p.local)] = true } }

    for b in f.blocks {
        for ins in b.instructions {
            for_each_read_local(ins, (l: LocalId) -> {
                if usize(l) < n { referenced[usize(l)] = true }
            })
            // Side-effecting dst must keep its slot.
            if instruction_has_side_effect(ins) {
                multi :: multi_dsts(ins)
                if multi != null {
                    for l in multi {
                        if usize(l) < n { referenced[usize(l)] = true }
                    }
                } else {
                    d :: dst_of(ins)
                    if d != null && usize(d) < n { referenced[usize(d)] = true }
                }
            }
        }
        for_each_read_in_terminator(b.terminator, (l: LocalId) -> {
            if usize(l) < n { referenced[usize(l)] = true }
        })
    }

    // Short-circuit when nothing drops.
    dropped_any := false
    for pc in f.params.len()..<n { if !referenced[pc] { dropped_any = true  break } }
    if !dropped_any { return f }

    // Build remap + new locals.
    remap: i32[]!: [] * n
    new_locals: CFGLocal[]!: [] * n
    for i in 0..<n {
        if !referenced[i] { remap.push(-1)  continue }
        remap.push(i32(new_locals.len()))
        new_locals.push(f.locals[i])
    }

    // Remap params via the same map.
    new_params: CFGParam[]!: [] * f.params.len()
    for p in f.params {
        new_params.push(CFGParam {
            .name = p.name, .symbol = p.symbol, .type = p.type,
            .local = LocalId(remap[usize(p.local)]),
        })
    }

    // Drop pure instructions whose dst → -1 ; remap survivors.
    new_blocks: BasicBlock[]!: [] * f.blocks.len()
    for b in f.blocks {
        out: Instruction[]!: [] * b.instructions.len()
        for ins in b.instructions {
            d :: dst_of(ins)
            if d is LocalId {
                if usize(d) < remap.len() && remap[usize(d)] < 0 {
                    if !instruction_has_side_effect(ins) { continue }
                }
            }
            out.push(remap_instr(ins, remap))
        }
        new_blocks.push(BasicBlock {
            .id           = b.id,
            .instructions = out,
            .terminator   = remap_terminator(b.terminator, remap),
            .span         = b.span,
        })
    }
    return CFGFunction { ...f, .params = new_params, .locals = new_locals, .blocks = new_blocks }
}

remap_local :: fn(m: i32[], l: LocalId) -> LocalId {
    if usize(l) < m.len() { return LocalId(m[usize(l)]) }
    return l
}

remap_local_opt :: fn(m: i32[], l: LocalId | null) -> LocalId | null {
    if l is null { return null }
    if l is LocalId { return remap_local(m, l) }
    return null
}

remap_locals :: fn(m: i32[], ls: LocalId[]) -> LocalId[] {
    out: LocalId[]!: []
    for l in ls { out.push(remap_local(m, l)) }
    return out
}

remap_instr :: fn(ins: Instruction, m: i32[]) -> Instruction {
    if ins is InstrConst {
        return InstrConst { .span = ins.span, .dst = remap_local(m, ins.dst), .value = ins.value, .type = ins.type }
    }
    if ins is InstrMove {
        return InstrMove { .span = ins.span, .dst = remap_local(m, ins.dst), .src = remap_local(m, ins.src) }
    }
    if ins is InstrBinOp {
        return InstrBinOp {
            .span = ins.span, .dst = remap_local(m, ins.dst), .op = ins.op,
            .lhs = remap_local(m, ins.lhs), .rhs = remap_local(m, ins.rhs), .type = ins.type,
        }
    }
    if ins is InstrUnOp {
        return InstrUnOp {
            .span = ins.span, .dst = remap_local(m, ins.dst), .op = ins.op,
            .operand = remap_local(m, ins.operand), .type = ins.type,
        }
    }
    if ins is InstrCall {
        return InstrCall {
            .span = ins.span,
            .dsts = remap_locals(m, ins.dsts),
            .callee = ins.callee,
            .args = remap_locals(m, ins.args),
            .type = ins.type,
        }
    }
    if ins is InstrCallIndirect {
        return InstrCallIndirect {
            .span = ins.span, .dst = remap_local_opt(m, ins.dst),
            .callee = remap_local(m, ins.callee), .args = remap_locals(m, ins.args),
            .fn_type = ins.fn_type, .type = ins.type,
        }
    }
    if ins is InstrVirtualCall {
        return InstrVirtualCall {
            .span = ins.span, .dst = remap_local_opt(m, ins.dst),
            .trait_name = ins.trait_name, .method = ins.method,
            .receiver = remap_local(m, ins.receiver), .args = remap_locals(m, ins.args),
            .type = ins.type,
        }
    }
    if ins is InstrFnRef {
        return InstrFnRef { .span = ins.span, .dst = remap_local(m, ins.dst), .fn_symbol = ins.fn_symbol, .type = ins.type }
    }
    if ins is InstrFnAddr {
        return InstrFnAddr { .span = ins.span, .dst = remap_local(m, ins.dst), .fn_symbol = ins.fn_symbol, .type = ins.type }
    }
    if ins is InstrFieldGet {
        return InstrFieldGet {
            .span = ins.span, .dst = remap_local(m, ins.dst),
            .target = remap_local(m, ins.target), .field = ins.field, .type = ins.type,
        }
    }
    if ins is InstrFieldSet {
        return InstrFieldSet {
            .span = ins.span, .target = remap_local(m, ins.target),
            .field = ins.field, .value = remap_local(m, ins.value), .barrierless = ins.barrierless,
        }
    }
    if ins is InstrArrayGet {
        return InstrArrayGet {
            .span = ins.span, .dst = remap_local(m, ins.dst),
            .target = remap_local(m, ins.target), .index = remap_local(m, ins.index),
            .type = ins.type,
            .bounds_safe = ins.bounds_safe,
        }
    }
    if ins is InstrArraySet {
        return InstrArraySet {
            .span = ins.span, .target = remap_local(m, ins.target),
            .index = remap_local(m, ins.index), .value = remap_local(m, ins.value),
            .bounds_safe = ins.bounds_safe,
        }
    }
    if ins is InstrArrayLen {
        return InstrArrayLen { .span = ins.span, .dst = remap_local(m, ins.dst), .target = remap_local(m, ins.target), .resolve_buf = ins.resolve_buf }
    }
    if ins is InstrArrayPush {
        return InstrArrayPush {
            .span = ins.span, .target = remap_local(m, ins.target),
            .value = remap_local(m, ins.value), .cached = ins.cached,
        }
    }
    if ins is InstrArraySlice {
        return InstrArraySlice {
            .span = ins.span, .dst = remap_local(m, ins.dst), .type = ins.type,
            .target = remap_local(m, ins.target), .lo = remap_local(m, ins.lo), .hi = remap_local(m, ins.hi),
        }
    }
    if ins is InstrStringSlice {
        return InstrStringSlice {
            .span = ins.span, .dst = remap_local(m, ins.dst), .type = ins.type,
            .target = remap_local(m, ins.target), .lo = remap_local(m, ins.lo), .hi = remap_local(m, ins.hi),
        }
    }
    if ins is InstrStructNew {
        return InstrStructNew {
            .span = ins.span, .dst = remap_local(m, ins.dst), .type = ins.type,
            .fields = remap_locals(m, ins.fields), .stack = ins.stack,
        }
    }
    if ins is InstrArrayNew {
        return InstrArrayNew {
            .span = ins.span, .dst = remap_local(m, ins.dst), .type = ins.type,
            .length = ins.length, .elements = remap_locals(m, ins.elements), .stack = ins.stack,
        }
    }
    if ins is InstrDataConst {
        return InstrDataConst { .span = ins.span, .dst = remap_local(m, ins.dst), .pool_index = ins.pool_index, .type = ins.type }
    }
    if ins is InstrTypeCheck {
        return InstrTypeCheck {
            .span = ins.span, .dst = remap_local(m, ins.dst),
            .value = remap_local(m, ins.value), .check_type = ins.check_type,
        }
    }
    if ins is InstrTypeConst {
        return InstrTypeConst { .span = ins.span, .dst = remap_local(m, ins.dst), .value_type = ins.value_type, .type = ins.type }
    }
    if ins is InstrCast {
        return InstrCast {
            .span = ins.span, .dst = remap_local(m, ins.dst),
            .value = remap_local(m, ins.value), .type = ins.type,
        }
    }
    if ins is InstrCellNew {
        return InstrCellNew {
            .span = ins.span, .dst = remap_local(m, ins.dst),
            .value = remap_local(m, ins.value), .value_type = ins.value_type,
        }
    }
    if ins is InstrCellGet {
        return InstrCellGet {
            .span = ins.span, .dst = remap_local(m, ins.dst),
            .cell = remap_local(m, ins.cell), .value_type = ins.value_type,
        }
    }
    if ins is InstrCellSet {
        return InstrCellSet {
            .span = ins.span, .cell = remap_local(m, ins.cell),
            .value = remap_local(m, ins.value), .value_type = ins.value_type,
        }
    }
    if ins is InstrMakeClosure {
        return InstrMakeClosure {
            .span = ins.span, .dst = remap_local(m, ins.dst), .fn_symbol = ins.fn_symbol,
            .env = remap_local(m, ins.env), .env_type = ins.env_type, .type = ins.type,
        }
    }
    if ins is InstrIntrinsic {
        return InstrIntrinsic {
            .span = ins.span, .dst = remap_local_opt(m, ins.dst),
            .name = ins.name, .args = remap_locals(m, ins.args),
        }
    }
    // `InstrDeferPush.value` is a read operand (`for_each_read_local` visits it),
    // so `compact_locals` renumbers it and it MUST be remapped here too — else
    // the deferred thunk reads a stale slot after compaction.
    if ins is InstrDeferPush {
        return InstrDeferPush { .span = ins.span, .value = remap_local(m, ins.value) }
    }
    // `InstrDeferPopExec` carries no LocalId ; every remaining instruction has
    // no operand to remap, so passing it through unchanged is correct.
    return ins
}

remap_terminator :: fn(t: Terminator, m: i32[]) -> Terminator {
    if t is TermBranch          { return t }
    if t is TermUnreachable     { return t }
    if t is TermCondBranch {
        return TermCondBranch {
            .cond = remap_local(m, t.cond),
            .then_block = t.then_block,
            .else_block = t.else_block,
            .join = t.join,
            .span = t.span,
        }
    }
    if t is TermReturn     {
        return TermReturn { .values = remap_locals(m, t.values), .span = t.span }
    }
    return t
}

/// Rebuild an instruction with its `dst` changed to `new_dst`. Pure
/// producers only — callers must check `instruction_has_side_effect`
/// first. Returns the input unchanged when the variant has no dst.
with_dst :: fn(ins: Instruction, new_dst: LocalId) -> Instruction {
    if ins is InstrConst {
        return InstrConst { .span = ins.span, .dst = new_dst, .value = ins.value, .type = ins.type }
    }
    if ins is InstrMove {
        return InstrMove { .span = ins.span, .dst = new_dst, .src = ins.src }
    }
    if ins is InstrBinOp {
        return InstrBinOp { .span = ins.span, .dst = new_dst, .op = ins.op, .lhs = ins.lhs, .rhs = ins.rhs, .type = ins.type }
    }
    if ins is InstrUnOp {
        return InstrUnOp { .span = ins.span, .dst = new_dst, .op = ins.op, .operand = ins.operand, .type = ins.type }
    }
    if ins is InstrFieldGet {
        return InstrFieldGet { .span = ins.span, .dst = new_dst, .target = ins.target, .field = ins.field, .type = ins.type }
    }
    if ins is InstrArrayGet {
        return InstrArrayGet { .span = ins.span, .dst = new_dst, .target = ins.target, .index = ins.index, .type = ins.type, .bounds_safe = ins.bounds_safe }
    }
    if ins is InstrArrayLen {
        return InstrArrayLen { .span = ins.span, .dst = new_dst, .target = ins.target, .resolve_buf = ins.resolve_buf }
    }
    if ins is InstrArraySlice {
        return InstrArraySlice { .span = ins.span, .dst = new_dst, .target = ins.target, .lo = ins.lo, .hi = ins.hi, .type = ins.type }
    }
    if ins is InstrStringSlice {
        return InstrStringSlice {
            .span = ins.span, .dst = new_dst, .type = ins.type,
            .target = ins.target, .lo = ins.lo, .hi = ins.hi,
        }
    }
    if ins is InstrStructNew {
        return InstrStructNew { .span = ins.span, .dst = new_dst, .type = ins.type, .fields = ins.fields, .stack = ins.stack }
    }
    if ins is InstrArrayNew {
        return InstrArrayNew {
            .span = ins.span, .dst = new_dst, .type = ins.type,
            .elements = ins.elements, .length = ins.length, .stack = ins.stack,
        }
    }
    if ins is InstrDataConst {
        return InstrDataConst { .span = ins.span, .dst = new_dst, .pool_index = ins.pool_index, .type = ins.type }
    }
    if ins is InstrTypeCheck {
        return InstrTypeCheck { .span = ins.span, .dst = new_dst, .value = ins.value, .check_type = ins.check_type }
    }
    if ins is InstrTypeConst {
        return InstrTypeConst { .span = ins.span, .dst = new_dst, .value_type = ins.value_type, .type = ins.type }
    }
    if ins is InstrCast {
        return InstrCast { .span = ins.span, .dst = new_dst, .value = ins.value, .type = ins.type }
    }
    if ins is InstrCellNew {
        return InstrCellNew { .span = ins.span, .dst = new_dst, .value = ins.value, .value_type = ins.value_type }
    }
    if ins is InstrCellGet {
        return InstrCellGet { .span = ins.span, .dst = new_dst, .cell = ins.cell, .value_type = ins.value_type }
    }
    if ins is InstrMakeClosure {
        return InstrMakeClosure {
            .span = ins.span, .dst = new_dst, .fn_symbol = ins.fn_symbol,
            .env = ins.env, .env_type = ins.env_type, .type = ins.type,
        }
    }
    if ins is InstrFnRef {
        return InstrFnRef { .span = ins.span, .dst = new_dst, .fn_symbol = ins.fn_symbol, .type = ins.type }
    }
    if ins is InstrFnAddr {
        return InstrFnAddr { .span = ins.span, .dst = new_dst, .fn_symbol = ins.fn_symbol, .type = ins.type }
    }
    return ins
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "vader/types"
import "toolchain/span"

// `fold_moves_in_block` holds every decision the pass makes ; `fold_moves` is the
// per-block plumbing around it. Testing the inner fn keeps the fixtures to the
// three things it reads — a block, the use counts, and the param slots — instead
// of a whole CFGFunction with its MonoEntry.

fm_i32 :: fn() -> Type = PrimitiveType { .name = "i32" }

fm_sym :: fn() -> Symbol = Symbol {
    .id = 1, .kind = .Fn, .name = "f", .module = "test",
    .module_name = "test", .visibility = .Private, .defined_at = null,
}

fm_binop :: fn(dst: LocalId, lhs: LocalId, rhs: LocalId) -> Instruction = InstrBinOp {
    .span = empty_span(), .dst = dst, .op = .Add,
    .lhs = lhs, .rhs = rhs, .type = fm_i32(),
}

fm_move :: fn(dst: LocalId, src: LocalId) -> Instruction = InstrMove {
    .span = empty_span(), .dst = dst, .src = src,
}

fm_call :: fn(dst: LocalId, arg: LocalId) -> Instruction = InstrCall {
    .span = empty_span(),
    .dsts = [dst],
    .callee = fm_sym(),
    .args = [arg],
    .type = fm_i32(),
}

fm_block :: fn(instrs: Instruction[]) -> BasicBlock = BasicBlock {
    .id = BlockId(0), .instructions = instrs,
    .terminator = TermUnreachable { .span = empty_span(), .reason = "test fixture" },
    .span = empty_span(),
}

/// Use counts as `count_uses` would report them, spelled out per test so each
/// case states the single-use precondition it depends on.
fm_uses :: fn(pairs: [LocalId, i32][]) -> MutableMap<LocalId, i32> {
    m :: MutableMap<LocalId, i32> {}
    for [l, n] in pairs {
        m[l] = n
    }
    return m
}

fm_no_params :: fn() -> MutableSet<LocalId> = MutableSet<LocalId> {}

@test
test_fold_moves_rewrites_single_use_producer :: fn() -> void {
    // `t2 = t0 + t1 ; Move t3 <- t2` folds to `t3 = t0 + t1`, Move dropped.
    out :: fold_moves_in_block(
        fm_block([fm_binop(LocalId(2), LocalId(0), LocalId(1)), fm_move(LocalId(3), LocalId(2))]),
        fm_uses([[LocalId(2), 1]]), fm_no_params(),
    )
    assert_eq(out.len(), usize(1))
    first :: out[0]
    assert(first is InstrBinOp, "producer survives as the binop")
    if first is InstrBinOp {
        assert_eq(i32(first.dst), 3)
    }
}

@test
test_fold_moves_keeps_move_when_source_used_twice :: fn() -> void {
    out :: fold_moves_in_block(
        fm_block([fm_binop(LocalId(2), LocalId(0), LocalId(1)), fm_move(LocalId(3), LocalId(2))]),
        fm_uses([[LocalId(2), 2]]), fm_no_params(),
    )
    assert_eq(out.len(), usize(2))
}

@test
test_fold_moves_keeps_move_when_source_is_a_param :: fn() -> void {
    params :: MutableSet<LocalId> {}
    params.add(LocalId(2))
    out :: fold_moves_in_block(
        fm_block([fm_binop(LocalId(2), LocalId(0), LocalId(1)), fm_move(LocalId(3), LocalId(2))]),
        fm_uses([[LocalId(2), 1]]), params,
    )
    assert_eq(out.len(), usize(2))
}

@test
test_fold_moves_bails_on_intervening_read_of_destination :: fn() -> void {
    // The swap / rotate idiom, and the bug this guard exists for : with
    // `t2 = t0 + t1 ; t0 = t1 + t1 ; Move t1 <- t2`, folding the producer up to
    // write `t1` makes the middle instruction read the already-clobbered slot.
    // `examples/fibonacci` printed 2^49 instead of fib(50) when it did.
    // End-to-end guard : `tests/snippets/swap_reassign`.
    out :: fold_moves_in_block(
        fm_block([
            fm_binop(LocalId(2), LocalId(0), LocalId(1)),
            fm_binop(LocalId(0), LocalId(1), LocalId(1)),
            fm_move(LocalId(1), LocalId(2)),
        ]),
        fm_uses([[LocalId(2), 1]]), fm_no_params(),
    )
    assert_eq(out.len(), usize(3))
    last :: out[2]
    assert(last is InstrMove, "the Move must survive")
}

@test
test_fold_moves_bails_on_intervening_write_of_destination :: fn() -> void {
    // `t3` is written between the producer and the Move : folding would
    // resurrect the stale value the intervening write had replaced.
    out :: fold_moves_in_block(
        fm_block([
            fm_binop(LocalId(2), LocalId(0), LocalId(1)),
            fm_binop(LocalId(3), LocalId(0), LocalId(0)),
            fm_move(LocalId(3), LocalId(2)),
        ]),
        fm_uses([[LocalId(2), 1]]), fm_no_params(),
    )
    assert_eq(out.len(), usize(3))
}

@test
test_fold_moves_keeps_move_when_producer_has_a_side_effect :: fn() -> void {
    // A call writes its `dst` AND does something else ; rewriting its `dst`
    // would move where the effect's result lands without moving the effect.
    out :: fold_moves_in_block(
        fm_block([fm_call(LocalId(2), LocalId(0)), fm_move(LocalId(3), LocalId(2))]),
        fm_uses([[LocalId(2), 1]]), fm_no_params(),
    )
    assert_eq(out.len(), usize(2))
}

@test
test_fold_moves_leaves_a_move_with_no_producer_alone :: fn() -> void {
    // Nothing in this block writes `t2`, so there is nothing to fold into.
    out :: fold_moves_in_block(
        fm_block([fm_move(LocalId(3), LocalId(2))]),
        fm_uses([[LocalId(2), 1]]), fm_no_params(),
    )
    assert_eq(out.len(), usize(1))
}
