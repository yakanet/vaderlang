// vader/midir/dump — pretty-printer for the Mid-IR CFG.
//
// Produces a stable, human-readable
// text rendering used by `vader dump --stage=cfg <file>` and by
// snapshot tests. Locals are referenced as `%<index>` ; blocks as
// `bb<index>`. Spans are omitted to keep the output focused on the
// structure.

module "vader/midir"

import "std/string_builder"
import "vader/resolver"
import "vader/resolver/symbol"
import "vader/types"

/// Optional filter / shape controls for `dump_cfg_project`.
export DumpCfgOptions :: struct {
    /// Only modules in this scope are rendered (the entry's subtree by default,
    /// `--module` to widen) ; dependencies stay out. See `module_in_scope`.
    scope: string[]
    /// When false, the project-level string pool is not appended.
    include_strings: bool
}

export dump_cfg_project :: fn(p: CFGProject, opts: DumpCfgOptions) -> string {
    sb :: StringBuilder {}
    sb.append("# CFG\n")
    for [_, m] in p.modules {
        if !module_in_scope(m.display_path, opts.scope) { continue }
        if m.functions.len() == 0 && m.externs.len() == 0 && m.struct_decls.len() == 0 {
            continue
        }
        sb.append("\n## ${m.display_path}\n")
        for fn_ in m.functions {
            sb.append("\n")
            dump_function(fn_, sb)
        }
    }
    if opts.include_strings && p.strings.len() > 0 {
        sb.append("\n## strings\n")
        for i in 0..<p.strings.len() {
            sb.append("  ${i}: \"${p.strings[i]}\"\n")
        }
    }
    return sb.to_string()
}

dump_function :: fn(fn_: CFGFunction, sb: StringBuilder!) -> void {
    sb.append("fn ${fn_.mangled}(")
    first := true
    for p in fn_.params {
        if !first { sb.append(", ") }
        first = false
        sb.append("%${p.local}: ${display_type(p.type)}")
    }
    sb.append(") -> ${display_type(fn_.return_type)}\n")
    sb.append("  locals:\n")
    for i in 0..<fn_.locals.len() {
        l :: fn_.locals[i]
        sb.append("    %${i} ${l.name}: ${display_type(l.type)}")
        if l.symbol !is null {
            sb.append(" (${kind_name(l.symbol.kind)} ${l.symbol.name})")
        }
        sb.append("\n")
    }
    for b in fn_.blocks { dump_block(b, sb) }
}

dump_block :: fn(b: BasicBlock, sb: StringBuilder!) -> void {
    sb.append("  bb${b.id}:\n")
    for ins in b.instructions { sb.append("    ${dump_instr(ins)}\n") }
    sb.append("    ${dump_terminator(b.terminator)}\n")
}

dump_instr :: fn(ins: Instruction) -> string {
    match ins {
        is InstrConst        -> { return "%${ins.dst} = const ${dump_const(ins.value)} :${display_type(ins.type)}" }
        is InstrBinOp        -> { return "%${ins.dst} = binop ${i32(ins.op)} %${ins.lhs} %${ins.rhs} :${display_type(ins.type)}" }
        is InstrUnOp         -> { return "%${ins.dst} = unop ${i32(ins.op)} %${ins.operand} :${display_type(ins.type)}" }
        is InstrCall         -> { return "${dump_dst(ins.dst)}call ${ins.callee.name}(${dump_args(ins.args)}) :${display_type(ins.type)}" }
        is InstrCallIndirect -> { return "${dump_dst(ins.dst)}call_indirect %${ins.callee}(${dump_args(ins.args)}) :${display_type(ins.type)}" }
        is InstrFnRef        -> { return "%${ins.dst} = fn_ref ${ins.fn_symbol.name} :${display_type(ins.type)}" }
        is InstrFnAddr       -> { return "%${ins.dst} = fn_addr ${ins.fn_symbol.name} :${display_type(ins.type)}" }
        is InstrVirtualCall  -> {
            extra :: if ins.args.len() > 0 { ", ${dump_args(ins.args)}" } else { "" }
            return "${dump_dst(ins.dst)}vcall ${ins.trait_name}.${ins.method}(recv=%${ins.receiver}${extra}) :${display_type(ins.type)}"
        }
        is InstrFieldGet    -> { return "%${ins.dst} = field_get %${ins.target}.${ins.field} :${display_type(ins.type)}" }
        is InstrFieldSet    -> { return "field_set %${ins.target}.${ins.field} = %${ins.value}" }
        is InstrArrayGet    -> { return "%${ins.dst} = array_get %${ins.target}[%${ins.index}] :${display_type(ins.type)}" }
        is InstrArraySet    -> { return "array_set %${ins.target}[%${ins.index}] = %${ins.value}" }
        is InstrArrayLen    -> { return "%${ins.dst} = array_len %${ins.target}" }
        is InstrArrayPush   -> { return "array_push %${ins.target}, %${ins.value}" }
        is InstrArraySlice  -> { return "%${ins.dst} = array_slice %${ins.target}[%${ins.lo}..%${ins.hi}] :${display_type(ins.type)}" }
        is InstrStringSlice -> { return "%${ins.dst} = string_slice_cp %${ins.target}[%${ins.lo}..%${ins.hi}] :${display_type(ins.type)}" }
        is InstrStructNew   -> {
            tag :: if ins.stack { "[stack]" } else { "" }
            args :: dump_args(ins.fields)
            return "%${ins.dst} = struct_new${tag} ${display_type(ins.type)}(${args})"
        }
        is InstrArrayNew -> {
            tag :: if ins.stack { "[stack]" } else { "" }
            return "%${ins.dst} = array_new${tag} ${display_type(ins.type)}[${ins.length}](${dump_args(ins.elements)})"
        }
        is InstrDataConst    -> { return "%${ins.dst} = data_const ${ins.pool_index} :${display_type(ins.type)}" }
        is InstrTypeCheck    -> { return "%${ins.dst} = type_check %${ins.value} is ${display_type(ins.check_type)}" }
        is InstrTypeConst    -> { return "%${ins.dst} = type_const ${display_type(ins.value_type)}" }
        is InstrCast         -> { return "%${ins.dst} = cast %${ins.value} :${display_type(ins.type)}" }
        is InstrCellNew      -> { return "%${ins.dst} = cell_new %${ins.value} :${display_type(ins.value_type)}" }
        is InstrCellGet      -> { return "%${ins.dst} = cell_get %${ins.cell} :${display_type(ins.value_type)}" }
        is InstrCellSet      -> { return "cell_set %${ins.cell} = %${ins.value} :${display_type(ins.value_type)}" }
        is InstrMakeClosure  -> { return "%${ins.dst} = make_closure ${ins.fn_symbol.name} env=%${ins.env} :${display_type(ins.type)}" }
        is InstrIntrinsic    -> { return "${dump_dst(ins.dst)}intrinsic ${ins.name}(${dump_args(ins.args)})" }
        is InstrMove         -> { return "%${ins.dst} = move %${ins.src}" }
        is InstrDeferPush    -> { return "defer.push %${ins.value}" }
        is InstrDeferPopExec -> { return "defer.pop_exec ${ins.count}" }
    }
}

dump_terminator :: fn(t: Terminator) -> string {
    match t {
        is TermBranch     -> { return "branch -> bb${t.target}" }
        is TermCondBranch -> { return "cond_branch %${t.cond} ? bb${t.then_block} : bb${t.else_block}" }
        is TermReturn     -> {
            if t.value == null { return "return" }
            return "return %${t.value}"
        }
        is TermUnreachable  -> { return "unreachable ; ${t.reason}" }
    }
}

dump_const :: fn(v: ConstValue) -> string {
    match v {
        is ConstInt    -> { return "int(${v.value})" }
        is ConstFloat  -> { return "float(${v.value})" }
        is ConstBool   -> { return "bool(${v.value})" }
        is ConstChar   -> { return "char(${v.value})" }
        is ConstString -> { return "string(#${v.index})" }
        is ConstNull   -> { return "null" }
    }
}

dump_dst :: fn(d: LocalId | null) -> string {
    if d == null { return "" }
    return "%${d} = "
}

dump_args :: fn(a: LocalId[]) -> string {
    sb :: StringBuilder {}
    first := true
    for x in a {
        if !first { sb.append(", ") }
        first = false
        sb.append("%${x}")
    }
    return sb.to_string()
}
