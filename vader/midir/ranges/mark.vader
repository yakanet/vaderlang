// vader/midir/ranges/mark: mark every array access the range analysis proves in bounds.
//
// A native build that proves bounds (`proves_bounds`, `vader/pipeline`) runs the
// range analysis (`verdicts.vader`) on each function as the bytecode
// emitter receives it, and marks `bounds_safe` every array access it proves. The
// C emitter then drops that access's index check, or keeps it with a message of
// its own under `$VADER_VERIFY_BOUNDS` (`emit_slot_array_local`). The VM ignores
// the mark and checks every access.
//
// An access is judged as in `--release`, where checked operations wrap, and a
// call through the summary of what may shorten an array (`vader/midir/array_shrink.vader`).

module "vader/midir/ranges"

import "std/collections"
import "std/iter"
import "vader/midir"

/// Mark `bounds_safe` every array access of `p` the range analysis proves in
/// bounds.
///
/// @param p  the CFG after every other midir pass, as the bytecode emitter
///           receives it.
/// @return   `p` with those accesses marked.
export mark_proven_accesses :: fn(p: CFGProject) -> CFGProject {
    shrinks :: shrink_predicate(summarise_array_shrinking(p))
    out :: MutableMap<string, CFGModule> {}
    for [id, m] in p.modules {
        functions :: m.functions.map((f) -> mark_in_function(f, shrinks)).collect()
        out[id] = CFGModule { ...m, .functions = functions }
    }
    return CFGProject { ...p, .modules = out }
}

// `fn_` with every access the analysis proves marked `bounds_safe`.
mark_in_function :: fn(fn_: CFGFunction, shrinks: fn(Instruction) -> bool) -> CFGFunction {
    proven :: proven_accesses(fn_, shrinks)
    if proven.len() == 0 {
        return CFGFunction { ...fn_ }
    }
    return CFGFunction { ...fn_, .blocks = fn_.blocks.map((b) -> mark_block(b, proven)).collect() }
}

// The accesses of `fn_` the analysis proves in bounds, each as its `pos_key`.
proven_accesses :: fn(fn_: CFGFunction, shrinks: fn(Instruction) -> bool) -> MutableSet<i64> {
    proven :: MutableSet<i64> {}
    if !may_prove_an_access(fn_) {
        return proven
    }
    for site in analyse_function_ranges(fn_, shrinks, false).sites {
        if site.verdict == .Proven {
            proven.add(pos_key(site.block, site.position))
        }
    }
    return proven
}

// Whether the analysis could prove an access of `fn_`. It proves one against a
// length of its own array, which an `array_len` brings in, or one another access
// to it left: a function whose checked accesses each index an array it neither
// measures nor indexes at two sites proves nothing, and skips the fixed point.
may_prove_an_access :: fn(fn_: CFGFunction) -> bool {
    measured :: MutableSet<LocalId> {}
    sites :: MutableMap<LocalId, i64> {}
    checked :: MutableSet<LocalId> {}
    for b in fn_.blocks {
        for ins in b.instructions {
            if ins is InstrArrayLen {
                measured.add(ins.target)
            }
            target :: indexed_array(ins) ?? continue
            sites[target] = (sites[target] ?? 0) + 1
            if is_checked_access(ins) {
                checked.add(target)
            }
        }
    }
    for target in checked {
        if target in measured || (sites[target] ?? 0) > 1 {
            return true
        }
    }
    return false
}

// The array an access indexes, checked or not.
indexed_array :: fn(ins: Instruction) -> LocalId | null {
    if ins is InstrArrayGet {
        return ins.target
    }
    if ins is InstrArraySet {
        return ins.target
    }
    return null
}

// Whether `ins` is an array access that still checks its index.
is_checked_access :: fn(ins: Instruction) = ins is InstrArrayGet | InstrArraySet && !already_safe(ins)

// `b` with each access `proven` names marked `bounds_safe`.
mark_block :: fn(b: BasicBlock, proven: MutableSet<i64>) -> BasicBlock {
    marked: Instruction[]: []
    for position in 0..<b.instructions.len() {
        ins :: b.instructions[position]
        if pos_key(b.id, position) in proven {
            marked.push(marked_safe(ins))
        } else {
            marked.push(ins)
        }
    }
    return BasicBlock { ...b, .instructions = marked }
}

// `ins`, an array access, marked `bounds_safe`.
marked_safe :: fn(ins: Instruction) -> Instruction {
    if ins is InstrArrayGet {
        return InstrArrayGet { ...ins, .bounds_safe = true }
    }
    if ins is InstrArraySet {
        return InstrArraySet { ...ins, .bounds_safe = true }
    }
    return ins
}
