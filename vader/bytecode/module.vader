// vader/bytecode/module — in-memory bytecode module shape, the lingua
// franca shared by the bytecode emitter (T2), the VM, and the C / WASM
// emitters (T1 / T4).
//
// This is the single in-memory module
// shape : the self-host VM consumes it directly (the former runtime-only
// `vader/vm/op.Module` + its parsers were retired in the VM consolidation).
// It carries the full information the bytecode emitter writes and the C-emit
// / VM later read : per-fn signatures, per-local val-types, struct symbol-ids,
// the full import/export tables, and the vtable map.
//
// Construction sites :
//   - the bytecode emitter (`vader/bytecode/emit`) builds a fresh
//     `BytecodeModule` per project ;
//   - the .virt readers (`vader/vm/virt_reader_bc` for C-emit ; `virt_reader`
//     → `bc_to_vm` for the VM) build one from a text dump.
//
// Consumers : `vader/c_emit/emit` lowers it to a single C source file ;
// `vader/vm/exec` runs it directly.

module "vader/bytecode"

import "std/abort"


/// One Vader function body, post-lowering.
///
/// `is_main` is propagated from `MonoEntry.isMain` through the IR layers
/// so the VM and the C-emit can locate the entry without re-parsing the
/// mangled name. `locals` are *additional* locals declared after the
/// params ; slot index of `locals[i]` is `signature.params.len() + i`.
/// `debug[i]` corresponds to `body[i]`, with `null` meaning "no source
/// span for this op" — handy for synthesised ops (struct.new_stack,
/// trampoline shims). `jump_table[i]` is the resolved target pc for
/// branching ops (`Branch` / `BranchIf` / `If` / `Else`) and `-1` for
/// every other op ; both downstream consumers (VM exec, c-emit) read this
/// same shape regardless of which front-end produced the module.
export BcFunction :: struct {
    name: string
    is_main: bool
    signature: BcSignature
    locals: BcLocal[]!
    body: Op[]!
    debug: (DebugPos | null)[]!
    jump_table: i32[]!
}

/// Static signature of a fn-shaped slot. The VM only consults `params`
/// / `results` (which carry the stack-erased `ValType`s) ; the C-emit
/// reads `param_types` / `result_types` to apply B1 (nullable-ref inline
/// rep) and the path-γ erasure boundary at the call site. Both pairs of
/// arrays are parallel — `param_types[i]` is the `BcType` index of
/// `params[i]`, and `result_types[i]` of `results[i]`.
export BcSignature :: struct {
    params: ValType[]
    /// What the callee leaves on the operand stack, in the order the caller
    /// receives it.
    ///
    /// A VOID return carries ONE entry holding `ValType.Void`, not the empty
    /// array — the shape this signature has always had, kept so the void type
    /// stays rooted in the bytecode DCE and every emitted type index stays put.
    /// `bc_result_arity` is the ONLY reader that knows this: ask it, never
    /// `results.len()`, when the question is how many values cross.
    ///
    /// More than one is what lets a small composite cross in registers rather
    /// than as a heap object. It is also the shape WASM takes natively
    /// (`(func (result i32 i32))`), which is why the C backend is the one that
    /// degrades — to out-params — and not the IR.
    /// Plan: `.claude/plans/2026-09-22-tuple-value-abi.md`.
    results: ValType[]
    param_types: i32[]               // parallel to params, length identical
    /// `BcType` indices, parallel to `results`.
    result_types: i32[]
    /// Source parameter names, parallel to `params` — populated by the CFG
    /// emitter for the debugger's Variables view. Empty (not per-index) on
    /// paths that don't carry names (imports, synth wrappers, `.virt` reload) ;
    /// consumers fall back to `arg<i>`.
    param_names: string[]
    /// Per-parameter `!` marker, parallel to `params`. Empty (not per-index) on
    /// every path that has no reason to carry it.
    ///
    /// The bit exists for ONE consumer: the `@extern` shim, which must know
    /// whether C receives `const void*` or `void*`, and whether a scalar is
    /// passed by value or by address. `ArrayType.immutable` otherwise stops at
    /// this boundary on purpose (the layout is the same either way) — this
    /// vector is the deliberate exception, not a widening of the notion.
    param_mutable: bool[] = []
    /// Per-parameter `@c_pointer`, parallel to `params`. Empty when none.
    ///
    /// Set only for an `@extern` import: it says the foreign callee receives the
    /// parameter's ADDRESS rather than its value, so the shim spills it to a
    /// stack temporary and passes `&tmp`. `param_mutable` then says whether C
    /// writes through it.
    param_by_address: bool[] = []
}

/// The single `ValType` a signature leaves on the stack, `Void` when it leaves
/// none — and a PANIC when it leaves several.
///
/// The panic is the point. A caller of this function has not been taught about
/// multi-value; returning `Void` or `results[0]` there would mis-compile in
/// silence, which is the failure mode `hazard_ir_hint_plumbing` records. Every
/// site that must handle arity asks `results.len()` instead, and the panic is
/// what says the site was missed. It can only fire on bytecode this compiler
/// emitted, never on user input.
export bc_single_result :: fn(sig: BcSignature) -> ValType {
    if sig.results.len() == 0 {
        return .Void
    }
    if sig.results.len() > 1 {
        panic("bytecode: `bc_single_result` reached a signature with ${sig.results.len()} results — this consumer was not taught about arity")
    }
    return sig.results[0]
}

/// `BcType` index of the single return slot, 0 (the void slot) when there is
/// none. Panics on several, for the reason `bc_single_result` gives.
export bc_single_result_type :: fn(sig: BcSignature) -> i32 {
    if sig.result_types.len() == 0 {
        return 0
    }
    if sig.result_types.len() > 1 {
        panic("bytecode: `bc_single_result_type` reached a signature with ${sig.result_types.len()} results — this consumer was not taught about arity")
    }
    return sig.result_types[0]
}

/// How many values the callee leaves on the operand stack.
///
/// Zero for a void return: the representation spells that as a single
/// `ValType.Void` entry rather than the empty arrays, so
/// asking `results.len()` directly would count one value where none is pushed.
export bc_result_arity :: fn(sig: BcSignature) -> usize =
    if sig.results.len() == 1 && sig.results[0] == .Void { 0 } else { sig.results.len() }

/// One declared local — name + stack-erased `ValType`. The C-emit
/// re-derives the underlying `BcType` from the fn's signature when it
/// needs the richer info (e.g. for B1 / boundary reshaping).
export BcLocal :: struct {
    name: string
    val: ValType
}

/// Per-op source mapping. `file` is the absolute path of the source
/// file ; `line` and `column` are 1-based.
export DebugPos :: struct {
    file: string
    line: i32
    column: i32
}

/// One external symbol expected from the host. Two flavours, switched
/// on `is_extern` :
///   - `@extern` decls (`is_extern = true`) — foreign symbol resolved
///     by the host linker (libc, user-supplied .o).
///   - `@intrinsic` stdlib ops (`is_extern = false`) — c-emit's shim
///     switch routes these to runtime helpers (`vader_*`) rather than
///     emitting an extern declaration.
export BcImport :: struct {
    extern_name: string              // user-facing name in source
    mangled_name: string
    signature: BcSignature
    is_extern: bool
    /// Header to `#include` instead of synthesising a prototype, or `""`.
    /// See `FnMetadata.c_header`.
    c_header: string = ""
    /// Library to open before resolving the symbol, or `""` for the default
    /// scope. See `FnMetadata.c_library` — the VM needs it, the linker does not.
    c_library: string = ""
    /// How many of a VARIADIC callee's parameters are fixed, `-1` when it is not
    /// variadic. From `@c_variadic(N)`.
    ///
    /// The interpreter needs it and cannot derive it: a variadic callee called
    /// through a non-variadic cast reads its variadic arguments from the wrong
    /// place on darwin-arm64, where they travel on the stack rather than in
    /// registers. `cc` gets the same fact from `@c_header`; nothing gave it to us.
    c_variadic_fixed: i32 = -1
}

/// One symbol exposed to the host (`@export` fns). `extern_name` is
/// the user-facing C name ; `fn_index` keys the parent module's
/// `functions[]`.
export BcExport :: struct {
    extern_name: string
    fn_index: i32
}

/// One row of the impl table — `struct_type_index implements trait_name`.
/// Materialised side-by-side with the per-(trait, method) vtable so
/// `is Trait` patterns can be answered without walking every fn name.
/// We use an explicit-row representation (rather than a map keyed by
/// struct type-index) to keep the shape data-only (no map encoding into
/// Vader maps).
export ImplEntry :: struct {
    struct_type_index: i32
    trait_name: string
}

/// One vtable, keyed by `<TraitName>.<MethodName>`, listing the
/// (receiver type-index → fn-index) mapping the `virtual.call` op
/// indexes in O(1). Built by the bytecode emitter from every
/// `T implements Trait { … }` decl. The .virt text format itself
/// doesn't carry vtable directives — they're rebuilt by the VM's
/// `build_vtables` from mangled fn names.
export VtableEntry :: struct {
    receiver_type_index: i32
    fn_index: i32
}

/// One `(trait, method) → entries[]` row of the vtable table.
export VtableRow :: struct {
    key: string                      // "<Trait>.<method>"
    entries: VtableEntry[]!
}

/// Top-level holder. Read-only after construction.
///
/// - `types`    — the type table. Indices referenced by `struct.*`,
///                `array.*`, `type_check`, `ref.cast`, and `BcSignature`.
/// - `strings`  — interned string-literal pool. `string.const N` reads
///                this directly ; the C-emit hoists each entry to a
///                static `vader_string_t`.
/// - `data_pool`— pre-materialised primitive arrays. `data.const N` op
///                references entries here ; the C-emit lowers each into
///                a `.rodata` block.
/// - `functions`— every Vader-side fn body, in emission order. `Call`
///                ops reference these by index.
/// - `imports`  — external symbols. `call.import` references these by
///                index ; the C-emit emits a per-import shim that the
///                in-module call points to.
/// - `exports`  — symbols exposed to the host. The C-emit uses these to
///                pick `main`'s linkage.
/// - `impl_table`— rows of `T implements Trait`.
/// - `vtables`  — per-(trait, method) virtual-dispatch table.
export BytecodeModule :: struct {
    name: string
    types: BcType[]
    strings: string[]
    data_pool: BcDataEntry[]
    functions: BcFunction[]
    imports: BcImport[]
    exports: BcExport[]
    impl_table: ImplEntry[]
    vtables: VtableRow[]
}
