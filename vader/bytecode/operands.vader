// vader/bytecode/operands — what the printed operands of an op point at.
//
// `write_op_refs` (dump.vader) prints an op as its name then its operands ; an
// operand that is a table index is printed from an `OperandRef` saying what it
// names — a function, a type, a struct field, a pool string, a host import, a
// data-pool entry or a local slot. `operand_refs` collects those refs, so a tool
// reading a `.virt` line can follow an operand to the entry it names ;
// `annotate_op` renders them.

module "vader/bytecode"

import "std/string_builder"

/// What a table-index operand names.
export OperandKind :: enum {
    Function,
    Type,
    /// A field of a struct type (`OperandRef.owner`).
    Field,
    String,
    Import,
    Data,
    Local,
}

/// One table-index operand : the table it indexes, and the index — a slot for
/// `.Local`, a field position for `.Field`.
export OperandRef :: struct {
    kind:  OperandKind
    index: i32
    /// For `.Field`, the struct type the field belongs to.
    owner: i32 = -1
}

/// The operands `write_op` prints after `op`'s name, in order, each with what it
/// points at — null for a word that names nothing (the inner op name of a
/// `return.lit`).
///
/// @param op  the op whose operands to describe.
/// @return    one entry per printed operand, up to the last index ; empty for an
///            op whose operands point at nothing.
export operand_refs :: fn(op: Op) -> (OperandRef | null)[] {
    refs: (OperandRef | null)[]!: []
    write_op_refs(StringBuilder {}, refs, op)
    return refs
}

// Print `mnemonic` then the number of each operand, noting what each names.
printed :: fn(out: StringBuilder!, refs: (OperandRef | null)[]!, mnemonic: string, operands: OperandRef[]) -> void {
    out.append(mnemonic)
    for operand in operands {
        out.append(" ${operand.index}")
        refs.push(operand)
    }
}

refer :: fn(kind: OperandKind, index: i32) -> OperandRef = OperandRef { .kind = kind, .index = index }

refer_field :: fn(owner: i32, index: i32) -> OperandRef = OperandRef {
    .kind  = .Field,
    .index = index,
    .owner = owner,
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_operand_refs_of_a_field_read :: fn() -> void {
    refs :: operand_refs(StructGet { .type_id = 7, .field_index = 2 })
    assert_eq(refs.len(), 2)
    first :: refs[0]
    if first == null {
        assert(false, "the type operand points at the type table")
        return
    }
    assert(first.kind == .Type && first.index == 7, "`struct.get 7 2` names type 7")
    second :: refs[1]
    assert(second != null && second.kind == .Field && second.index == 2, "then field 2 of it")
}

@test
test_operand_refs_of_a_plain_op :: fn() -> void {
    assert_eq(operand_refs(Drop {}).len(), 0)
}
