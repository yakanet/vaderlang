// vader/bytecode/type_classify — typecheck `Type` → bytecode shapes.
//
// Shared by `vader/bytecode/emit` (per-decl interning) and any
// future pass that needs to project a `Type` into the bytecode IR
// (e.g. the data-pool encoder, the WASM emit, the LSP type-info
// renderer).
//
// The trap to know before touching anything here : `bc_type_of` is the
// CONTEXT-FREE projection and collapses every composite to a
// `BcPrimitive{.val=Ref}` placeholder ; `bc_type_of_with_ctx` is the production
// path (reached through `intern_type`) and is the only one that recursively
// interns nested types into accurate `BcArray` / `BcUnion` / `BcFn` / `BcStruct`
// shapes. Reaching for the former where the latter is meant degrades the type
// silently — a missing arm there once collapsed every tuple to an opaque `ref`.

module "vader/bytecode"

import "vader/types"
import "vader/resolver/symbol"
import "vader/diagnostics"

/// Cache key for `intern_type`. Primitives skip the `display_type`
/// allocation by keying directly on the primitive name (already a
/// stable interned string the typechecker passes around).
///
/// **Immutability is deliberately absent from every key here.** The
/// `immutable` bit on `ArrayType` / `StructType` / `TupleType` is a
/// typecheck-only notion : an immutable value has the layout of a mutable
/// one, so the two MUST collapse to a single type-table slot. Adding it
/// would fork the type table (and the emitted C) on a distinction the
/// runtime cannot observe. Same rule in `val_type_of_type` / `bc_type_of`.
///
/// @param t  the type to key.
/// @return   the key string ; pass to `MutableMap<string, i32>`.
export type_intern_key :: fn(t: Type) -> string = match t {
    is PrimitiveType as p -> p.name
    // Key structs / traits by source position (`symbol_key`) + recursive
    // arg keys, NOT by `display_type` (bare name). Two import shapes of the
    // same decl resolve to distinct symbols but share a source position, so
    // they collapse to one slot — and `reserve_struct` keys identically, so
    // a referenced struct dedupes with its reserved definition instead of
    // minting an orphan `ref`.
    is StructType as s    -> "Struct#${symbol_key(s.symbol)}<${type_key_join(s.args, "|")}>"
    is TraitType as tr    -> "Trait#${symbol_key(tr.symbol)}<${type_key_join(tr.args, "|")}>"
    // Enums lower to their `repr` primitive — share the bare primitive's slot.
    is EnumType as e      -> e.repr
    // Distinct (newtype) shares its backing primitive's slot, exactly like an
    // enum shares its `repr` — no separate type-table entry, so it rides the
    // backing's zero-cost representation end to end.
    is DistinctType as d  -> type_intern_key(d.backing)
    is ArrayType as a     -> "Array<${type_intern_key(a.element)}>"
    is UnionType as u     -> "Union<${type_key_join(u.variants, "|")}>"
    is TupleType as p     -> "Tuple<${type_key_join(p.elements, "|")}>"
    is FnType as f        -> "Fn(${type_key_join(f.params, ",")})->${type_intern_key(f.return_type)}"
    is TypeParamType      -> display_type(t)
    is TypeMetaType       -> display_type(t)
    is SelfType           -> display_type(t)
    is UnresolvedType     -> display_type(t)
    is FreeIntType        -> display_type(t)
    is FreeCharType       -> display_type(t)
    is FreeFloatType      -> display_type(t)
    is NeverType          -> display_type(t)
    is AnyType            -> "Any"
}

/// A tuple's ELEMENT keys as a C-safe identifier fragment: `[i32, string]`
/// becomes `i32_string`. Built from the elements rather than the tuple's own
/// `type_intern_key`, which already starts with `Tuple<` and would spell the
/// word twice.
///
/// Long shapes fall back to a hash. C99 only guarantees 63 significant
/// characters in an internal identifier, and a nested shape reached 611: two
/// names differing past a compiler's limit would silently become ONE struct.
/// The threshold keeps the ordinary cases readable in a debugger and only the
/// monsters opaque.
///
/// @param elements  the tuple's element types, in order.
tuple_shape_name :: fn(elements: Type[]) -> string {
    // The hash is taken over the EXACT key, never over the sanitised spelling.
    // `c_safe_key` is many-to-one -- it collapses each run of characters C
    // rejects into one `_`, so `Box<i32>` and `Box_i32<>` spell alike -- and
    // hashing the spelling would collapse the same pairs a second time instead
    // of separating them. Two distinct tuple types then took one C struct name
    // and `cc` refused the file outright.
    //
    // So the discriminant is unconditional: the spelling is for the reader, the
    // hash is what makes the name an identity.
    exact :: type_key_join(elements, "_")
    digest :: fnv1a_hex(exact)
    spelled :: c_safe_key(exact)
    if spelled.byte_len() <= TUPLE_NAME_MAX - SHAPE_DIGEST_LEN - 1 {
        return "${spelled}_${digest[0..<SHAPE_DIGEST_LEN]}"
    }
    return "${elements.len()}_${digest}"
}

/// Hex digits of the shape digest kept when the name is also spelled out. Eight
/// is 32 bits of separation, which is what distinguishes two shapes that
/// sanitise alike; the unspelled form keeps all sixteen.
SHAPE_DIGEST_LEN: usize : 8

/// Longest tuple shape spelled in full.
///
/// C99 guarantees 63 significant characters in an INTERNAL identifier, and the
/// emitter wraps this fragment in 23 more: `vader_struct_` (13) + `__Tuple_`
/// (8) + `_t` (2). What is left is 40. Past that, two shapes differing only
/// beyond the limit would be ONE struct to a compiler that applies the
/// guarantee, so the name is hashed instead of spelled.
TUPLE_NAME_MAX: usize : 40

/// FNV-1a over the shape, as 16 hex digits. Only reached for a shape too long
/// to spell; a collision would merge two distinct structs, so `intern_type`'s
/// key map stays the authority on identity — this only names what it interned.
fnv1a_hex :: fn(s: string) -> string {
    h: u64 = 0xcbf29ce484222325
    for b in s.bytes() {
        h = (h ^ u64(b)) * 0x100000001b3
    }
    out := ""
    for i in 0..<16 {
        shift :: u64((15 - i) * 4)
        nibble :: (h >> shift) & 0xF
        out = out + "0123456789abcdef"[usize(nibble)..<usize(nibble) + 1]
    }
    return out
}

/// A type key as a C-safe identifier fragment. Every run of characters C would
/// reject collapses to a single `_`.
///
/// @param key  a `type_intern_key` result, or a join of several.
c_safe_key :: fn(key: string) -> string {
    out := ""
    prev_underscore := false
    for b in key.bytes() {
        if (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') {
            out = out + "${char(b)}"
            prev_underscore = false
        } else if !prev_underscore {
            out = out + "_"
            prev_underscore = true
        }
    }
    return out
}

// Source-position identity for a symbol — file:offset when the decl has a
// span, else a synthetic `id` fallback.
// The MODULE, not the file. A module resolves to exactly one folder, which the
// compiler guarantees, so `module + name` identifies a declaration everywhere —
// a checkout, a `dist/` bundle where `lib/` sits beside the binary, a staged
// temp directory. The source PATH identified the same thing, but only within one
// machine's layout: it leaked absolute paths into C struct names
// (`$Cell_Struct__private_var_folders_…`), which made the emitted C differ
// between two build directories and pushed single identifiers past 2 KB.
symbol_key :: fn(sym: Symbol) -> string {
    if sym.module_name == "" {
        return "id${sym.id}"
    }
    return "${sym.module_name}.${sym.name}"
}

// Join each type's intern key with `sep`. Recurses through `type_intern_key`
// so a struct nested in an arg / variant carries its source-position key.
type_key_join :: fn(args: Type[], sep: string) -> string {
    out := ""
    for i in 0..<args.len() {
        prefix :: if i > 0 { sep } else { "" }
        out = "${out}${prefix}${type_intern_key(args[i])}"
    }
    return out
}

/// Stack-class of a `Type`. Primitive types map by name. The two reference
/// shapes now carry an HONEST distinction (T12):
///   - `.Ref` — a CONCRETE heap object of a statically-known shape (struct,
///     array, fn, tuple). Carried as a raw `void*` under T12 (tag recoverable
///     from the object header).
///   - `.Any` — an ERASED / dynamic value (trait object, union, generic
///     type-param, meta, self, `any`, unresolved). Carried as a tagged
///     `vader_box_t` — it may hold a boxed primitive or a variable variant.
/// c_emit still collapses both to `vader_box_t` until the T12 c_emit flip
/// (B1b), so this reclassification is byte-identical on the native target.
///
/// @param t  the type to classify.
/// @return   the `ValType` the operand stack carries for this slot.
export val_type_of_type :: fn(t: Type) -> ValType = match t {
    is PrimitiveType as p -> val_type_of_primitive_name(p.name)
    is StructType         -> ValType.Ref
    // Enums ride the operand stack as their backing integer repr, not a boxed
    // ref.
    is EnumType      as e -> val_type_of_primitive_name(e.repr)
    // Distinct (newtype) rides its backing primitive's stack repr — zero-cost,
    // exactly like an enum rides its `repr`. This is what makes `x :: i64`
    // a register scalar, not a boxed `Ref`.
    is DistinctType  as d -> val_type_of_type(d.backing)
    is ArrayType          -> ValType.Ref
    is FnType             -> ValType.Ref
    is TupleType          -> ValType.Ref
    // Erased / dynamic → `.Any` (tagged box). A trait object may box a
    // distinct-primitive impl; a union carries a variable variant; generic
    // type-params / meta / self / `any` are erased.
    is TraitType          -> ValType.Any
    is UnionType          -> ValType.Any
    is TypeParamType      -> ValType.Any
    is TypeMetaType       -> ValType.Any
    is SelfType           -> ValType.Any
    is AnyType            -> ValType.Any
    is UnresolvedType     -> ValType.Any
    is FreeIntType        -> ValType.I32
    is FreeCharType       -> ValType.Char
    is FreeFloatType      -> ValType.F64
    is NeverType          -> ValType.Void
}

/// Context-aware translation : recursively interns element / param /
/// return types so the resulting `BcType` carries the right type-table
/// indices for composite shapes : Struct/Trait → `BcRef { trait_name }`,
/// Array → `BcArray { element }`, Union → `BcUnion { variants }`,
/// Fn → `BcFn { params, return_type }`.
/// Tuple synthesises an anonymous struct keyed by the caller-provided
/// slot index ; the caller passes its own table position so the synth
/// name (`__Tuple_<idx>`) stays stable.
///
/// Exhaustive over `Type` by design (no `_` fall-through) : the bare
/// types that have no first-class bytecode shape (type-params, meta,
/// self, unresolved, free numerics, never) collapse to an opaque
/// `BcRef { "" }`, but listing them keeps the match honest, so adding a
/// new `Type` variant trips T3013 here instead of silently degrading to
/// `ref` (the failure mode that hid the missing `Tuple` case).
///
/// @param t           the type to translate.
/// @param ctx         the emit context — nested types intern through it.
/// @param slot_index  this type's own table position, reserved by the
///                    caller. Used only to name synthesised tuple
///                    structs (`__Tuple_<slot_index>`) stably.
/// @return            the `BcType` for the type table.
export bc_type_of_with_ctx :: fn(t: Type, ctx: EmitterCtx!, slot_index: i32) -> BcType {
    match t {
        is PrimitiveType as p -> { return BcPrimitive { .val = val_type_of_primitive_name(p.name) } }
        is EnumType as e      -> { return BcPrimitive { .val = val_type_of_primitive_name(e.repr) } }
        is DistinctType as d  -> { return bc_type_of_with_ctx(d.backing, ctx, slot_index) }
        is StructType as s    -> { return BcRef { .trait_name = s.symbol.name } }
        is TraitType as tt    -> { return BcRef { .trait_name = tt.symbol.name } }
        is ArrayType as a     -> { return BcArray { .element = intern_type(a.element, ctx) } }
        is UnionType as u     -> {
            variant_indices: i32[]! = []
            for v in u.variants { variant_indices.push(intern_type(v, ctx)) }
            return BcUnion { .variants = variant_indices }
        }
        is FnType as f -> {
            param_indices: i32[]! = []
            for p in f.params { param_indices.push(intern_type(p, ctx)) }
            return BcFn {
                .params = param_indices,
                .return_type = intern_type(f.return_type, ctx),
            }
        }
        // Anonymous struct with positional fields `_0`, `_1`, … , named after
        // the tuple's SHAPE so `[i32, string]` and `[bool, string]` still emit
        // distinct C structs.
        //
        // The name must not depend on the slot's RANK in the type table: a rank
        // shifts when anything interned earlier differs, and a name that shifts
        // makes identical modules emit different C. `type_intern_key` is the
        // same key `intern_type` dedupes on, so two tuples share a name exactly
        // when they share a slot.
        is TupleType as p -> {
            fields: BcField[]! = []
            for i in 0..<p.elements.len() {
                fields.push(BcField {
                    .name       = "_${i}",
                    .type_index = intern_type(p.elements[i], ctx),
                })
            }
            return BcStruct {
                .name      = "__Tuple_${tuple_shape_name(p.elements)}",
                .fields    = fields,
                .c_name    = "",
                .symbol_id = -1,
            }
        }
        // No first-class bytecode shape — opaque `ref`. Listed explicitly
        // (not a `_` catch-all) so a new `Type` variant trips T3013.
        is TypeParamType  -> { return OPAQUE_REF }
        is TypeMetaType   -> { return OPAQUE_REF }
        is SelfType       -> { return OPAQUE_REF }
        is UnresolvedType -> { return OPAQUE_REF }
        is FreeIntType    -> { return OPAQUE_REF }
        is FreeCharType   -> { return OPAQUE_REF }
        is FreeFloatType  -> { return OPAQUE_REF }
        is NeverType      -> { return OPAQUE_REF }
        is AnyType        -> { return OPAQUE_REF }
    }
}

/// Opaque `ref` for a `Type` with no first-class bytecode shape.
OPAQUE_REF :: BcRef { .trait_name = "" }

import "vader/lower"
import "toolchain/span"

/// Map a primitive name to its `ValType`. Unknown names degrade to
/// `Any` so the upstream typechecker has the only say in rejecting
/// the source.
///
/// @param name  the primitive name (`"i32"`, `"string"`, …).
/// @return      the matching `ValType` ; `Any` for unrecognised names.
export val_type_of_primitive_name :: fn(name: string) -> ValType {
    // The FFI pointer's SOURCE spelling is `CPointer` while its `.virt`
    // spelling is `pointer` — two namespaces, mapped here rather than by
    // teaching `parse_val_type` a name the text format never writes.
    if name == "CPointer" {
        return ValType.Pointer
    }
    parsed :: parse_val_type(name) ?? return ValType.Any
    return parsed
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_val_type_of_type_primitive :: fn() -> void {
    v :: val_type_of_type(mk_primitive("i32"))
    match v {
        .I32 -> {}
        _    -> assert_eq("expected I32", "")
    }
}

@test test_val_type_of_type_unknown_primitive_degrades_to_any :: fn() -> void {
    v :: val_type_of_type(mk_primitive("madeup"))
    match v {
        .Any -> {}
        _    -> assert_eq("expected Any", "")
    }
}

@test test_type_intern_key_primitive_uses_name :: fn() -> void {
    key :: type_intern_key(mk_primitive("i32"))
    assert_eq(key, "i32")
}


@test test_type_of_int_literal :: fn() -> void {
    p :: Position { .file = "<test>", .offset = 0, .line = 1, .column = 1 }
    sp :: Span { .start = p, .end = p }
    lit :: LoweredIntLit { .span = sp, .type = mk_primitive("i32"), .value = 42 }
    t :: type_of(lit)
    match t {
        is PrimitiveType as prim -> assert_eq(prim.name, "i32")
        _ -> assert_eq("expected primitive", "")
    }
}


// The immutability bit must NOT cross into the bytecode. Two otherwise identical
// types differing only by it have to collapse to one type-table slot and one
// stack class — an immutable value has the layout of a mutable one, so emitting
// two shapes would be both useless and a byte-green risk. The invariant holds by
// construction today (`BcStruct` / `BcArray` have no field to carry the bit),
// which is exactly why it needs a test: nothing else would stop someone adding
// one. Covers all three carriers.
@test test_immutability_never_reaches_the_bytecode :: fn() -> void {
    factory :: SymbolFactory {}
    sym :: factory.make(.Struct, "Cfg", "test", "test", .Public, null)
    i32_ty: Type = mk_primitive("i32")

    mutable_struct   :: mk_struct(sym, [], false)
    immutable_struct :: mk_struct(sym, [], true)
    assert_eq(type_intern_key(mutable_struct), type_intern_key(immutable_struct))
    assert_eq(i32(val_type_of_type(mutable_struct)), i32(val_type_of_type(immutable_struct)))

    assert_eq(type_intern_key(mk_array(i32_ty, false)), type_intern_key(mk_array(i32_ty, true)))
    assert_eq(
        type_intern_key(mk_tuple([i32_ty, i32_ty], false)),
        type_intern_key(mk_tuple([i32_ty, i32_ty], true)),
    )
    assert_eq(
        i32(val_type_of_type(mk_tuple([i32_ty, i32_ty], false))),
        i32(val_type_of_type(mk_tuple([i32_ty, i32_ty], true))),
    )
}
