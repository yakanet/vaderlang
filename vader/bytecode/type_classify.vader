// vader/bytecode/type_classify — typecheck `Type` → bytecode shapes.
//
// Shared by `vader/bytecode/emit` (per-decl interning) and any
// future pass that needs to project a `Type` into the bytecode IR
// (e.g. the data-pool encoder, the WASM emit, the LSP type-info
// renderer).
//
// `bc_type_of_with_ctx` (reached through `intern_type`) interns a type's nested
// types into their own `BcArray` / `BcUnion` / `BcFn` / `BcStruct` entries.

module "vader/bytecode"

import "vader/diagnostics"
import "vader/integer"
import "vader/resolver/symbol"
import "vader/types"

/// Cache key for `intern_type`. Primitives skip the `display_type`
/// allocation by keying directly on the primitive name (already a
/// stable interned string the typechecker passes around).
///
/// @param t  the type to key.
/// @return   the key string ; pass to `MutableMap<string, i32>`.
export type_intern_key :: fn(t: Type) -> string = match t {
    is PrimitiveType -> t.name
    // Key structs / traits by their declaration (`symbol_key`) + recursive
    // arg keys, NOT by `display_type` (bare name), which two same-named types
    // of two modules share. `reserve_struct` keys identically, so a referenced
    // struct dedupes with its reserved definition instead of minting an orphan
    // `ref`.
    is StructType -> "Struct#${symbol_key(t.symbol)}<${argument_keys(t.args)}>"
    is TraitType  -> "Trait#${symbol_key(t.symbol)}<${argument_keys(t.args)}>"
    // Enums lower to their `repr` primitive — share the bare primitive's slot.
    is EnumType      -> t.repr.name
    // Distinct (newtype) shares its backing primitive's slot, exactly like an
    // enum shares its `repr` — no separate type-table entry, so it rides the
    // backing's zero-cost representation end to end.
    is DistinctType   -> type_intern_key(t.backing)
    // A range rides its representation the same way.
    is RangeType      -> storage_integer(t).name
    is ArrayType      -> "Array<${type_intern_key(t.element)}>"
    is UnionType      -> "Union<${type_key_join(t.variants, "|")}>"
    is TupleType      -> "Tuple<${type_key_join(t.elements, "|")}>"
    is FnType         -> "Fn(${type_key_join(t.params, ",")})->${type_intern_key(t.return_type)}"
    is TypeParamType  -> display_type(t)
    is InferVar       -> leaked_infer_var(t)
    is TypeMetaType   -> display_type(t)
    is SelfType       -> display_type(t)
    is UnresolvedType -> display_type(t)
    is FreeIntType    -> display_type(t)
    is FreeCharType   -> display_type(t)
    is FreeFloatType  -> display_type(t)
    is NeverType      -> display_type(t)
    is AnyType        -> "Any"
}

/// A tuple's ELEMENT keys as a C-safe identifier fragment: `[i32, string]`
/// becomes `i32_string`. Built from the elements rather than the tuple's own
/// `type_intern_key`, which already starts with `Tuple<` and would spell the
/// word twice.
///
/// Long shapes fall back to a hash. C99 only guarantees 63 significant
/// characters in an internal identifier, and a nested shape reached 611: two
/// names differing past a compiler's limit would silently become ONE struct.
/// The threshold keeps the ordinary cases readable in a debugger and only the
/// monsters opaque.
///
/// @param elements  the tuple's element types, in order.
tuple_shape_name :: fn(elements: Type[]) -> string {
    // The hash is taken over the EXACT key, never over the sanitised spelling.
    // `c_safe_key` is many-to-one -- it collapses each run of characters C
    // rejects into one `_`, so `Box<i32>` and `Box_i32<>` spell alike -- and
    // hashing the spelling would collapse the same pairs a second time instead
    // of separating them. Two distinct tuple types then took one C struct name
    // and `cc` refused the file outright.
    //
    // So the discriminant is unconditional: the spelling is for the reader, the
    // hash is what makes the name an identity.
    exact :: type_key_join(elements, "_")
    digest :: fnv1a_hex(exact)
    spelled :: c_safe_key(exact)
    if spelled.byte_len() <= TUPLE_NAME_MAX - SHAPE_DIGEST_LEN - 1 {
        return "${spelled}_${digest[0..<SHAPE_DIGEST_LEN]}"
    }
    return "${elements.len()}_${digest}"
}

/// Hex digits of the shape digest kept when the name is also spelled out. Eight
/// is 32 bits of separation, which is what distinguishes two shapes that
/// sanitise alike; the unspelled form keeps all sixteen.
SHAPE_DIGEST_LEN: i64 : 8

/// Longest tuple shape spelled in full.
///
/// C99 guarantees 63 significant characters in an INTERNAL identifier, and the
/// emitter wraps this fragment in 23 more: `vader_struct_` (13) + `__Tuple_`
/// (8) + `_t` (2). What is left is 40. Past that, two shapes differing only
/// beyond the limit would be ONE struct to a compiler that applies the
/// guarantee, so the name is hashed instead of spelled.
TUPLE_NAME_MAX: i64 : 40

/// FNV-1a over the shape, as 16 hex digits. Only reached for a shape too long
/// to spell; a collision would merge two distinct structs, so `intern_type`'s
/// key map stays the authority on identity — this only names what it interned.
fnv1a_hex :: fn(s: string) -> string {
    h: u64 = 0xcbf29ce484222325
    for k in 0..<s.byte_len() {
        b :: s.byte_at(k)
        h = (h ^ u64(b)) *% 0x100000001b3
    }
    out := ""
    for i in 0..<16 {
        shift :: u64((15 - i) * 4)
        nibble :: (h >> shift) & 0xF
        out = out + "0123456789abcdef"[i64(nibble)..<i64(nibble) + 1]
    }
    return out
}

/// A type key as a C-safe identifier fragment. Every run of characters C would
/// reject collapses to a single `_`.
///
/// @param key  a `type_intern_key` result, or a join of several.
c_safe_key :: fn(key: string) -> string {
    out := ""
    prev_underscore := false
    for i in 0..<key.byte_len() {
        b :: key.byte_at(i)
        if (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') {
            out = out + "${char(b)}"
            prev_underscore = false
        } else if !prev_underscore {
            out = out + "_"
            prev_underscore = true
        }
    }
    return out
}

// The identity of a declaration that stays the same from one build to the next,
// unlike a symbol id : its module and its name, else a synthetic `id` fallback.
// The MODULE, not the file. A module resolves to exactly one folder, which the
// compiler guarantees, so `module + name` identifies a declaration everywhere —
// a checkout, a `dist/` bundle where `lib/` sits beside the binary, a staged
// temp directory. A source path would leak an absolute path into C struct names,
// which must not differ between two build directories.
symbol_key :: fn(sym: Symbol) -> string {
    if sym.module_name == "" {
        return "id${sym.id}"
    }
    return "${sym.module_name}.${sym.name}"
}

// Join each type's intern key with `sep`. Recurses through `type_intern_key`
// so a struct nested in an arg / variant carries its declaration's key.
type_key_join :: fn(args: Type[], sep: string) -> string {
    out := ""
    for i in 0..<args.len() {
        prefix :: if i > 0 { sep } else { "" }
        out = "${out}${prefix}${type_intern_key(args[i])}"
    }
    return out
}

// A struct's or trait's type arguments as its instance keys them : an enum by its
// declaration, since an instance over an enum is its own (`kept_type_argument`)
// and must not share its integer's tag and vtable rows ; any other type as a value
// of it keys. `argument_hash` and `same_argument_class` follow the same rule.
argument_keys :: fn(args: Type[]) -> string {
    out := ""
    separator := ""
    for a in args {
        out = "${out}${separator}${argument_key(a)}"
        separator = "|"
    }
    return out
}

argument_key :: fn(t: Type) -> string {
    backing :: strip_distinct(t)
    if backing is EnumType {
        return "Enum#${symbol_key(backing.symbol)}"
    }
    return type_intern_key(t)
}

/// Stack-class of a `Type`. Primitive types map by name. The two reference
/// shapes now carry an HONEST distinction (T12):
///   - `.Ref` — a CONCRETE heap object of a statically-known shape (struct,
///     array, fn, tuple). Carried as a raw `void*` under T12 (tag recoverable
///     from the object header).
///   - `.Any` — an ERASED / dynamic value (trait object, union, generic
///     type-param, meta, self, `any`, unresolved). Carried as a tagged
///     `vader_box_t` — it may hold a boxed primitive or a variable variant.
/// c_emit still collapses both to `vader_box_t` until the T12 c_emit flip
/// (B1b), so this reclassification is byte-identical on the native target.
///
/// @param t  the type to classify.
/// @return   the `ValType` the operand stack carries for this slot.
export val_type_of_type :: fn(t: Type) -> ValType = match t {
    is PrimitiveType -> val_type_of_primitive_name(t.name)
    is StructType    -> .Ref
    // Enums ride the operand stack as their backing integer repr, not a boxed
    // ref.
    is EnumType -> val_type_of_primitive_name(t.repr.name)
    // Distinct (newtype) rides its backing primitive's stack repr — zero-cost,
    // exactly like an enum rides its `repr`. This is what makes `x :: i64`
    // a register scalar, not a boxed `Ref`.
    is DistinctType -> val_type_of_type(t.backing)
    is RangeType    -> val_type_of_primitive_name(storage_integer(t).name)
    is ArrayType    -> .Ref
    is FnType       -> .Ref
    is TupleType    -> .Ref
    // Erased / dynamic → `.Any` (tagged box). A trait object may box a
    // distinct-primitive impl; a union carries a variable variant; generic
    // type-params / meta / self / `any` are erased.
    is TraitType          -> .Any
    is UnionType          -> .Any
    is TypeParamType      -> .Any
    is InferVar           -> leaked_infer_var(t)
    is TypeMetaType       -> .Any
    is SelfType           -> .Any
    is AnyType            -> .Any
    is UnresolvedType     -> .Any
    is FreeIntType        -> .I32
    is FreeCharType       -> .Char
    is FreeFloatType      -> .F64
    is NeverType          -> .Void
}

/// Context-aware translation : recursively interns element / param /
/// return types so the resulting `BcType` carries the right type-table
/// indices for composite shapes : Struct/Trait → `BcRef { trait_name }`,
/// Array → `BcArray { element }`, Union → `BcUnion { variants }`,
/// Fn → `BcFn { params, return_type }`.
/// Tuple synthesises an anonymous struct keyed by the caller-provided
/// slot index ; the caller passes its own table position so the synth
/// name (`__Tuple_<idx>`) stays stable.
///
/// Exhaustive over `Type` by design (no `_` fall-through) : the bare
/// types that have no first-class bytecode shape (type-params, meta,
/// self, unresolved, free numerics, never) collapse to an opaque
/// `BcRef { "" }`, but listing them keeps the match honest, so adding a
/// new `Type` variant trips T3013 here instead of silently degrading to
/// `ref` (the failure mode that hid the missing `Tuple` case).
///
/// @param t           the type to translate.
/// @param ctx         the emit context — nested types intern through it.
/// @param slot_index  this type's own table position, reserved by the
///                    caller. Used only to name synthesised tuple
///                    structs (`__Tuple_<slot_index>`) stably.
/// @return            the `BcType` for the type table.
export bc_type_of_with_ctx :: fn(t: Type, ctx: EmitterCtx, slot_index: i32) -> BcType {
    match t {
        is PrimitiveType -> { return BcScalar { .val = val_type_of_primitive_name(t.name) } }
        is EnumType | RangeType -> { return BcScalar { .val = val_type_of_type(t) } }
        is DistinctType  -> { return bc_type_of_with_ctx(t.backing, ctx, slot_index) }
        is StructType    -> { return BcRef { .trait_name = t.symbol.name } }
        is TraitType     -> { return BcRef { .trait_name = trait_key_of(t.symbol) } }
        is ArrayType     -> { return BcArray { .element = intern_type(t.element, ctx) } }
        is UnionType     -> {
            variant_indices: i32[]: []
            for v in t.variants { variant_indices.push(intern_type(v, ctx)) }
            return BcUnion { .variants = variant_indices }
        }
        is FnType -> {
            param_indices: i32[]: []
            for p in t.params { param_indices.push(intern_type(p, ctx)) }
            return BcFn {
                .params = param_indices,
                .return_type = intern_type(t.return_type, ctx),
            }
        }
        // Anonymous struct with positional fields `_0`, `_1`, … , named after
        // the tuple's SHAPE so `[i32, string]` and `[bool, string]` still emit
        // distinct C structs.
        //
        // The name must not depend on the slot's RANK in the type table: a rank
        // shifts when anything interned earlier differs, and a name that shifts
        // makes identical modules emit different C. `type_intern_key` is the
        // same key `intern_type` dedupes on, so two tuples share a name exactly
        // when they share a slot.
        is TupleType -> {
            fields: BcField[]: []
            for i in 0..<t.elements.len() {
                fields.push(BcField {
                    .name       = "_${i}",
                    .type_index = intern_type(t.elements[i], ctx),
                })
            }
            return BcStruct {
                .name      = "__Tuple_${tuple_shape_name(t.elements)}",
                .fields    = fields,
                .c_name    = "",
                .symbol_id = -1,
            }
        }
        // No first-class bytecode shape — opaque `ref`. Listed explicitly
        // (not a `_` catch-all) so a new `Type` variant trips T3013.
        is TypeParamType  -> { return OPAQUE_REF }
        is InferVar       -> { leaked_infer_var(t) }
        is TypeMetaType   -> { return OPAQUE_REF }
        is SelfType       -> { return OPAQUE_REF }
        is UnresolvedType -> { return OPAQUE_REF }
        is FreeIntType    -> { return OPAQUE_REF }
        is FreeCharType   -> { return OPAQUE_REF }
        is FreeFloatType  -> { return OPAQUE_REF }
        is NeverType      -> { return OPAQUE_REF }
        is AnyType        -> { return OPAQUE_REF }
    }
}

/// Opaque `ref` for a `Type` with no first-class bytecode shape.
OPAQUE_REF :: BcRef { .trait_name = "" }

/// Map a primitive name to its `ValType`. Unknown names degrade to
/// `Any` so the upstream typechecker has the only say in rejecting
/// the source.
///
/// @param name  the primitive name (`"i32"`, `"string"`, …).
/// @return      the matching `ValType` ; `Any` for unrecognised names.
export val_type_of_primitive_name :: fn(name: string) -> ValType {
    // The FFI pointer's SOURCE spelling is `CPointer` while its `.virt`
    // spelling is `pointer` — two namespaces, mapped here rather than by
    // teaching `parse_val_type` a name the text format never writes.
    if name == "CPointer" {
        return .Pointer
    }
    parsed :: parse_val_type(name) ?? return .Any
    return parsed
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_val_type_of_type_integer :: fn() -> void {
    v :: val_type_of_type(TY_I32)
    match v {
        .I32 -> {}
        _    -> assert_eq("expected I32", "")
    }
}

@test test_val_type_of_type_unknown_primitive_degrades_to_any :: fn() -> void {
    v :: val_type_of_type(mk_primitive("madeup"))
    match v {
        .Any -> {}
        _    -> assert_eq("expected Any", "")
    }
}

@test test_type_intern_key_integer_uses_its_name :: fn() -> void {
    key :: type_intern_key(TY_I32)
    assert_eq(key, "i32")
}

// ---- POC : structural hash key ---------------------------------------------

FNV_OFFSET_64: u64: 0xCBF2_9CE4_8422_2325
FNV_PRIME_64:  u64: 0x100_0000_01B3

// A single FNV-1a step over 64-bit WORDS barely avalanches — the multiply only
// carries bits upward, so structurally similar inputs (sequential symbol ids,
// neighbouring name hashes) collide. Finalise each step instead.
mix64 :: fn(h: u64, v: u64) -> u64 {
    x := (h ^ v) *% FNV_PRIME_64
    x = (x ^ (x >> 33)) *% 0xFF51_AFD7_ED55_8CCD
    x = (x ^ (x >> 29)) *% 0xC4CE_B9FE_1A85_EC53
    return x ^ (x >> 32)
}

/// `type_intern_key` as a 64-bit structural hash — same collapsing rules, no
/// string. The key exists to index a table of ~1 600 slots and is rebuilt half a
/// million times per self-build; every level of the recursion allocates and
/// interns, so the string IS the cost.
export type_intern_hash :: fn(t: Type) -> u64 = match t {
    // The BARE cases carry no prefix in `type_intern_key`, so two of them with
    // the same text collapse to one slot there and MUST collapse here too — no
    // per-variant tag, or the table forks where the string merged.
    is PrimitiveType  -> bare_hash(t.name)
    is EnumType       -> bare_hash(t.repr.name)
    is AnyType        -> bare_hash("Any")
    is TypeParamType | TypeMetaType | SelfType | UnresolvedType
     | FreeIntType | FreeCharType | FreeFloatType | NeverType -> bare_hash(display_type(t))
    is InferVar       -> leaked_infer_var(t)
    is DistinctType   -> type_intern_hash(t.backing)
    is RangeType      -> bare_hash(storage_integer(t).name)
    // The composite cases DO carry a distinct prefix (`Struct#`, `Array<`, …),
    // so a tag mirrors what the string already separates.
    is StructType     -> argument_hashes(mix64(mix64(FNV_OFFSET_64, 1), symbol_hash(t.symbol)), t.args)
    is TraitType      -> argument_hashes(mix64(mix64(FNV_OFFSET_64, 2), symbol_hash(t.symbol)), t.args)
    is ArrayType      -> mix64(mix64(FNV_OFFSET_64, 3), type_intern_hash(t.element))
    is UnionType      -> type_args_hash(mix64(FNV_OFFSET_64, 4), t.variants)
    is TupleType      -> type_args_hash(mix64(FNV_OFFSET_64, 5), t.elements)
    is FnType         -> mix64(type_args_hash(mix64(FNV_OFFSET_64, 6), t.params), type_intern_hash(t.return_type))
}

bare_hash :: fn(name: string) -> u64 = mix64(FNV_OFFSET_64, name.hash())

symbol_hash :: fn(sym: Symbol) -> u64 {
    if sym.module_name == "" {
        return mix64(mix64(FNV_OFFSET_64, 101), u64(u32(sym.id)))
    }
    return mix64(mix64(FNV_OFFSET_64, sym.module_name.hash()), sym.name.hash())
}

type_args_hash :: fn(seed: u64, args: Type[]) -> u64 {
    h := seed
    for a in args {
        h = mix64(h, type_intern_hash(a))
    }
    return mix64(h, u64(args.len()))
}

// `argument_keys` as a hash, folded as `type_args_hash` folds.
argument_hashes :: fn(seed: u64, args: Type[]) -> u64 {
    h := seed
    for a in args {
        h = mix64(h, argument_hash(a))
    }
    return mix64(h, u64(args.len()))
}

argument_hash :: fn(t: Type) -> u64 {
    backing :: strip_distinct(t)
    if backing is EnumType {
        return mix64(mix64(FNV_OFFSET_64, 7), symbol_hash(backing.symbol))
    }
    return type_intern_hash(t)
}

/// Do `a` and `b` land on the same type-table slot — i.e. would
/// `type_intern_key` produce the same string for both?
///
/// Exists so a `type_intern_hash` hit can be VERIFIED without rebuilding the
/// key. A 64-bit hash alone is not an identity: a collision would silently merge
/// two slots, and the merge shows up as a mis-typed field access at runtime, far
/// from here. This walk allocates nothing, so verifying stays far cheaper than
/// the string it replaces.
///
/// It mirrors `type_intern_key`'s COLLAPSING, not structural equality: an enum
/// and its repr primitive are the same slot, and so are a distinct and its
/// backing, and a range and its representation.
export same_intern_class :: fn(a: Type, b: Type) -> bool {
    if a is DistinctType { return same_intern_class(a.backing, b) }
    if b is DistinctType { return same_intern_class(a, b.backing) }
    // Two ranges of one bounds are held alike : no storage to look up.
    if a is RangeType && b is RangeType && same_interval(a.bounds, b.bounds) {
        return true
    }
    if a is PrimitiveType | EnumType | RangeType || b is PrimitiveType | EnumType | RangeType {
        name :: bare_intern_name(a)
        return name != "" && name == bare_intern_name(b)
    }
    if a is StructType { return b is StructType && same_symbol_class(a.symbol, b.symbol) && same_argument_list(a.args, b.args) }
    if a is TraitType  { return b is TraitType  && same_symbol_class(a.symbol, b.symbol) && same_argument_list(a.args, b.args) }
    if a is ArrayType  { return b is ArrayType  && same_intern_class(a.element, b.element) }
    if a is UnionType  { return b is UnionType  && same_class_list(a.variants, b.variants) }
    if a is TupleType  { return b is TupleType  && same_class_list(a.elements, b.elements) }
    if a is FnType {
        return b is FnType && same_class_list(a.params, b.params) && same_intern_class(a.return_type, b.return_type)
    }
    return bare_intern_name(a) == bare_intern_name(b)
}

// The bare (prefix-less) key `type_intern_key` gives this type, or `""` when it
// has a composite key instead.
bare_intern_name :: fn(t: Type) -> string = match t {
    is PrimitiveType -> t.name
    is EnumType      -> t.repr.name
    is RangeType     -> storage_integer(t).name
    is AnyType       -> "Any"
    is TypeParamType | TypeMetaType | SelfType | UnresolvedType
     | FreeIntType | FreeCharType | FreeFloatType | NeverType -> display_type(t)
    is InferVar      -> leaked_infer_var(t)
    is StructType | TraitType | ArrayType | UnionType | TupleType | FnType | DistinctType -> ""
}

same_symbol_class :: fn(a: Symbol, b: Symbol) -> bool {
    if a.module_name == "" || b.module_name == "" {
        return a.module_name == b.module_name && a.id == b.id
    }
    return a.module_name == b.module_name && a.name == b.name
}

same_class_list :: fn(a: Type[], b: Type[]) -> bool {
    if a.len() != b.len() { return false }
    for i in 0..<a.len() {
        if !same_intern_class(a[i], b[i]) { return false }
    }
    return true
}

same_argument_list :: fn(a: Type[], b: Type[]) -> bool {
    if a.len() != b.len() { return false }
    for i in 0..<a.len() {
        if !same_argument_class(a[i], b[i]) { return false }
    }
    return true
}

// `same_intern_class` for a type argument : an enum matches only itself.
same_argument_class :: fn(a: Type, b: Type) -> bool {
    left :: strip_distinct(a)
    right :: strip_distinct(b)
    if left is EnumType || right is EnumType {
        return left is EnumType && right is EnumType && same_symbol_class(left.symbol, right.symbol)
    }
    return same_intern_class(a, b)
}
