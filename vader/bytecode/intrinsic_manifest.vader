// vader/bytecode/intrinsic_manifest — single authority on the `@intrinsic`
// host-mangle grammar and host-intrinsic identity.
//
// Two related jobs, both so the host-mangle grammar lives in ONE place:
//
//   1. Primitive-member grammar. The lowerer PRODUCES impl-member mangles
//      (`<module>$<Type>$<Trait>$<method>`, `lower/impl_member.vader`); this is
//      the consumer-side authority the VM re-derivations (`vm/host`, `vm/exec`)
//      route through instead of re-encoding the `std_core$` prefix / `$`
//      separator inline. `primitive_member_mangle` + the strip helpers, pinned
//      to the real mangler by the colocated tests.
//
//   2. Host-intrinsic identity. `intrinsic_id_for` classifies a host import's
//      mangled name into an `IntrinsicId` — THE single classification both
//      backends (`vm/host::dispatch_import`, `emit/c/host::import_shim`) dispatch
//      on, so the two can't drift and a new host trips T3013 at both sites.
//
// Still inlined elsewhere (folding through here is a follow-up): the arith /
// buffer bytecode-op table in `intrinsics.vader` (already verify-pinned).

module "vader/bytecode"

import "std/abort"
import "std/string"
import "vader/core/types"

// Mangled module fragment for `std/core` (`mangle_module_id("std/core")`).
// Pinned against the real mangler by `test_core_module_matches_mangler`.
CORE_MODULE :: "std_core"

// Prefix + member suffixes as module-level literals so the hot recognisers do
// ZERO per-call string building (only the kind slice allocates). Pinned against
// `CORE_MODULE` + `primitive_member_mangle` by the colocated tests, so they
// can't drift from the grammar even though they're spelled out here.
CORE_PREFIX    :: r"std_core$"
EQUALS_SUFFIX  :: r"$Equals$equals"
DISPLAY_SUFFIX :: r"$Display$to_string"

/// The mangle of a `std/core` primitive `@intrinsic` impl member:
/// `("i32", "Equals", "equals")` → `"std_core$i32$Equals$equals"`. THE grammar
/// authority for building a primitive host mangle — never inline the `$`
/// separator or the `std_core$` prefix at a call site.
///
/// @param kind    the receiver primitive kind (`"i32"`, `"string"`, …).
/// @param trait_  the trait segment (`"Equals"`, `"Display"`, …).
/// @param method  the method segment (`"equals"`, `"to_string"`, …).
/// @return        the fully mangled host-import name.
export primitive_member_mangle :: fn(kind: string, trait_: string, method: string) -> string =
    "${CORE_MODULE}$${kind}$${trait_}$${method}"

// Whether `mangled` is an integer width's bodyless `@intrinsic Equals` member.
is_int_equals :: fn(mangled: string) -> bool {
    kind :: strip_core_member(mangled, EQUALS_SUFFIX)
    return kind != null && is_int_name(kind)
}

/// True iff `mangled` is a primitive `<T>$Display$to_string` host : one of the
/// eight integer widths, plus `f32` / `f64` / `bool` / `char` / `string`.
///
/// @param mangled  the host import's mangled name.
export is_display_to_string :: fn(mangled: string) -> bool {
    kind :: strip_core_member(mangled, DISPLAY_SUFFIX)
    return kind != null && is_scalar_type_name(kind) && kind != "void" && kind != "null"
}

/// Subset of `is_display_to_string` covering the unsigned integers : the VM
/// carries them in a signed value, which a `u32` or a `u64` past the signed range
/// leaves negative, so they take the unsigned reinterpret path.
///
/// @param mangled  the host import's mangled name.
export is_unsigned_display :: fn(mangled: string) -> bool {
    kind :: strip_core_member(mangled, DISPLAY_SUFFIX) ?? return false
    return is_unsigned_int_name(kind)
}

// Return the `<kind>` slice of a `std_core$<kind><suffix>` mangle, or null when
// the prefix / suffix don't match. Lengths come from the constant strings — no
// hand-counted byte offsets, no per-call string build (both `CORE_PREFIX` and
// `suffix` are module-level literals). Only the returned kind slice allocates.
strip_core_member :: fn(mangled: string, suffix: string) -> string | null {
    if !mangled.starts_with(CORE_PREFIX) || !mangled.ends_with(suffix) { return null }
    return mangled.byte_slice(CORE_PREFIX.byte_len(), mangled.byte_len() - suffix.byte_len())
}

// ---- host intrinsic identity ----------------------------------------------

/// Identity of a recognised host `@intrinsic` import, keyed on the mangled name
/// by `intrinsic_id_for`. THE single classification the two backends
/// (`vm/host::dispatch_import`, `emit/c/host::import_shim`) dispatch on, so the
/// host-mangle grammar lives in one place and the two can't drift. The union of
/// what either backend serves — a backend that doesn't serve a variant handles
/// it in a grouped fallthrough arm, but the exhaustive `match` forces that to be
/// a conscious decision (a new variant here trips T3013 at both sites).
export IntrinsicId :: enum(u8) {
    NotIntrinsic,
    // std/core string + bytes
    ByteLen, ByteAt, ByteSlice, IsAscii,
    Bytes, BytesToString, StringHash,
    StringEquals,
    // primitive members (recognised via the grammar helpers, any width)
    PrimIntEquals, PrimDisplayToString,
    // std/runtime
    RuntimeCollect, RuntimeCollections, RuntimeBytesUsed, RuntimeBytesCopied,
    // std/runtime — cooperative async scheduler (std/async backend)
    SchedNow, SchedArm, SchedPark,
    // std/process — non-blocking subprocess (backs spawn_async ; spawn = block_on)
    // std/tty + std/env + std/abort
    AbortPanic,
    // std/target — the OS the process is RUNNING on, not the one it was built
    // for. `VADER_OS` answers the latter and is a baked constant, not a host.
    TargetCurrentOs, TargetCurrentArch,
    // std/tty raw mode — what `cli/prompt` reads keys through
    // vader/vm — dynamic foreign calls, the VM's answer to `@extern`. NOT in
    // `std/`: they amount to running arbitrary native code.
    FfiOpen, FfiOpenPath, FfiSymbol, FfiCall, FfiCallFrame,
}

/// Classify a host import's mangled name into its `IntrinsicId`, or
/// `NotIntrinsic` when it isn't a recognised host (e.g. an `@extern` symbol or
/// a since-removed one). The primitive-member checks come first: the erased
/// map-key `key.equals` path is the hot one, and each helper bails on the first
/// `starts_with(std_core$)` for the free-function mangles below.
///
/// @param mangled  the import's mangled name (`BcImport.mangled_name`).
export intrinsic_id_for :: fn(mangled: string) -> IntrinsicId {
    if is_int_equals(mangled)        { return .PrimIntEquals }
    if is_display_to_string(mangled) { return .PrimDisplayToString }

    if mangled == r"vader_vm$ffi_open"                   { return .FfiOpen }
    if mangled == r"vader_vm$ffi_symbol"                 { return .FfiSymbol }
    if mangled == r"vader_vm$ffi_call"                    { return .FfiCall }
    if mangled == r"vader_vm$ffi_open_path"              { return .FfiOpenPath }
    if mangled == r"vader_vm$ffi_call_frame"             { return .FfiCallFrame }

    if mangled == r"std_core$byte_len"                   { return .ByteLen }
    if mangled == r"std_core$byte_at"                    { return .ByteAt }
    if mangled == r"std_core$byte_slice"                 { return .ByteSlice }
    if mangled == r"std_core$is_ascii"                   { return .IsAscii }

    if mangled == r"std_core$bytes"                      { return .Bytes }
    if mangled == r"std_core$bytes_to_string"            { return .BytesToString }
    if mangled == primitive_member_mangle("string", "Hash", "hash") { return .StringHash }
    if mangled == r"std_core$string$Equals$equals"       { return .StringEquals }

    if mangled == r"std_runtime$collect"                 { return .RuntimeCollect }
    if mangled == r"std_runtime$collections"             { return .RuntimeCollections }
    if mangled == r"std_runtime$bytes_used"              { return .RuntimeBytesUsed }
    if mangled == r"std_runtime$bytes_copied"            { return .RuntimeBytesCopied }

    if mangled == r"std_runtime$sched_now"               { return .SchedNow }
    if mangled == r"std_runtime$sched_arm"               { return .SchedArm }
    if mangled == r"std_runtime$sched_park"              { return .SchedPark }


    if mangled == r"std_target$current_os"               { return .TargetCurrentOs }
    if mangled == r"std_target$current_arch"             { return .TargetCurrentArch }
    if mangled == r"std_abort$panic"                     { return .AbortPanic }
    return .NotIntrinsic
}

/// Whether a call to host `id` can trigger a collection — the question
/// `c_emit`'s `compute_may_alloc` asks of every op to decide which fns need a
/// GC frame. `false` is a promise that the native implementation never reaches
/// `vader_gc_alloc`: a fn whose only safepoint would be this call skips its
/// shadow-stack frame, so a wrong `false` leaves live refs unrooted across a
/// collection.
///
/// Not the question `vm/host`'s `is_impure_host` answers, which is whether a
/// comptime evaluation may call the host: `current_os` depends on the machine
/// and never collects, `bytes` depends on nothing and allocates.
///
/// @param id  the host's classification, from `intrinsic_id_for`.
export intrinsic_may_collect :: fn(id: IntrinsicId) -> bool = match id {
    // Reads of the atom (`vader.h`, `vader_runtime.c`): its length, one byte,
    // the hash and the ASCII flag set at intern.
    .ByteLen | .ByteAt | .StringHash | .IsAscii -> false
    // A slice of the atom takes an atom-table slot, grown by `realloc`.
    .ByteSlice -> false
    // Constants of the runtime's own build.
    .TargetCurrentOs | .TargetCurrentArch -> false
    // Allocate: a view header, an interned string, the rendered text.
    .Bytes | .BytesToString | .PrimDisplayToString -> true
    // Served by the VM only; natively these are Vader, never a host call.
    .StringEquals | .PrimIntEquals -> true
    // Unclassified — conservatively a safepoint.
    .RuntimeCollect | .RuntimeCollections | .RuntimeBytesUsed | .RuntimeBytesCopied -> true
    .SchedNow | .SchedArm | .SchedPark | .AbortPanic -> true
    .FfiOpen | .FfiOpenPath | .FfiSymbol | .FfiCall | .FfiCallFrame | .NotIntrinsic -> true
}

/// Whether a call to host `id` can shorten an array of the program: the question
/// midir's call summaries ask of a host function no op serves
/// (`vader/midir/array_shrink.vader`). `false` lets the range analysis keep the
/// lengths it knows across the call, so a wrong `false` lets an index go
/// unchecked against an array that got shorter.
///
/// @param id  the host's classification, from `intrinsic_id_for`.
export intrinsic_may_shorten_array :: fn(id: IntrinsicId) -> bool = match id {
    // Read a string or a primitive, or build a fresh value from one.
    .ByteLen | .ByteAt | .ByteSlice | .IsAscii | .StringHash | .StringEquals -> false
    .Bytes | .BytesToString | .PrimDisplayToString | .PrimIntEquals -> false
    // The collector moves objects and never changes a length; the rest only read.
    .RuntimeCollect | .RuntimeCollections | .RuntimeBytesUsed | .RuntimeBytesCopied -> false
    // The scheduler's state is the runtime's own, not a program array.
    .SchedNow | .SchedArm | .SchedPark -> false
    // Constants of the build ; `panic` never returns.
    .TargetCurrentOs | .TargetCurrentArch | .AbortPanic -> false
    // Foreign code is lent a buffer, never the header that holds its length.
    .FfiOpen | .FfiOpenPath | .FfiSymbol | .FfiCall | .FfiCallFrame -> false
    // Unrecognised: conservatively may.
    .NotIntrinsic -> true
}

/// Fail loud when a bodyless `@intrinsic` host import is not wired into the
/// manifest. Called per-import at emit (`midir/emit.vader::reserve_cfg_extern`).
///
/// A non-`@extern` import whose mangle is served by NEITHER a dedicated
/// bytecode op (`intrinsic_op_for_mangled`) NOR a recognised `IntrinsicId`
/// (`intrinsic_id_for`) would lower to an unbound `call.import` and trap at
/// runtime — exactly the cos/tan gap the intrinsic audit surfaced. This closes
/// the host-wiring chain at compile time : bodyless ⟹ `@intrinsic` (T3062) ⟹
/// recognised here ⟹ served by the VM + c_emit dispatch (T3013 on both matchs).
/// `@extern` imports resolve at link time and are exempt.
///
/// @param mangled    the import's mangled host name.
/// @param is_extern  true for `@extern` foreign symbols (exempt) ; false for
///                   `@intrinsic`-style stdlib host bindings (must be wired).
export assert_host_import_wired :: fn(mangled: string, is_extern: bool) -> void {
    if is_extern { return }
    if intrinsic_op_for_mangled(mangled) != null { return }
    if intrinsic_id_for(mangled) != .NotIntrinsic { return }
    panic("bytecode emit: bodyless `@intrinsic` host `${mangled}` is not wired into intrinsic_manifest — add it to `intrinsic_id_for` (+ its `vm/host.vader::dispatch_import` and `emit/c/host.vader::import_shim` arms), or give it a dedicated op in `intrinsic_op_for_mangled`")
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "vader/lower"

@test test_core_module_matches_mangler :: fn() -> void {
    // Pins the manifest's grammar against the real producer — if the module
    // mangling scheme changes, this test breaks instead of the backends silently.
    assert_eq(CORE_MODULE, mangle_module_id("std/core"))
}

@test test_grammar_constants_consistent :: fn() -> void {
    // The hoisted literals must equal what `primitive_member_mangle` builds, so
    // the perf hoist can't drift from the grammar.
    assert_eq(CORE_PREFIX, "${CORE_MODULE}$")
    assert_eq("${CORE_PREFIX}i32${EQUALS_SUFFIX}", primitive_member_mangle("i32", "Equals", "equals"))
    assert_eq("${CORE_PREFIX}u64${DISPLAY_SUFFIX}", primitive_member_mangle("u64", "Display", "to_string"))
}

@test test_primitive_member_mangle :: fn() -> void {
    assert_eq(primitive_member_mangle("i32", "Equals", "equals"), r"std_core$i32$Equals$equals")
    assert_eq(primitive_member_mangle("string", "Display", "to_string"), r"std_core$string$Display$to_string")
}

@test test_is_int_equals :: fn() -> void {
    assert(is_int_equals(r"std_core$i32$Equals$equals"), "i32 equals")
    assert(!is_int_equals(r"std_core$string$Equals$equals"), "string is no int width")
    assert(!is_int_equals(r"std_io$write"), "non-core bails on prefix")
    assert(!is_int_equals(r"user_mod$Foo$Bar$baz"), "user mangle")
}

@test test_display_classifiers :: fn() -> void {
    assert_eq(is_display_to_string(r"std_core$char$Display$to_string"), true)
    assert_eq(is_display_to_string(r"std_core$char$Equals$equals"), false)
    assert_eq(is_unsigned_display(r"std_core$u64$Display$to_string"), true)
    assert_eq(is_unsigned_display(r"std_core$i64$Display$to_string"), false)
    assert_eq(is_unsigned_display(r"std_core$u8$Display$to_string"), true)
}

@test test_intrinsic_may_collect :: fn() -> void {
    collects :: (mangled: string) -> intrinsic_may_collect(intrinsic_id_for(mangled))
    assert(!collects(r"std_core$byte_at"), "a byte read never collects")
    assert(!collects(r"std_core$string$Hash$hash"), "the hash is cached on the atom")
    assert(collects(r"std_core$bytes"), "a view allocates its header")
    assert(collects(r"user_mod$foo"), "an unknown host stays a safepoint")
}

@test test_intrinsic_id_for :: fn() -> void {
    // `std_io$write` is deliberately absent: it is ordinary Vader now, written
    // over `sys/io::sys_write`.
    assert(intrinsic_id_for(r"std_io$write") == .NotIntrinsic, "io write is no longer a host")
    // Same shape: `std/math` became `@extern`, so re-adding a Math variant would
    // silently route it back through `dispatch_import` while the declaration says
    // otherwise — an import neither backend serves.
    assert(intrinsic_id_for(r"std_math$sqrt") == .NotIntrinsic, "math sqrt is no longer a host")
    assert(intrinsic_id_for(r"std_core$i32$Equals$equals") == .PrimIntEquals, "int equals")
    assert(intrinsic_id_for(r"std_core$u8$Display$to_string") == .PrimDisplayToString, "display")
    assert(intrinsic_id_for(r"std_core$string$Equals$equals") == .StringEquals, "string equals not int")
    assert(intrinsic_id_for(r"user_mod$foo") == .NotIntrinsic, "unknown → NotIntrinsic")
}
