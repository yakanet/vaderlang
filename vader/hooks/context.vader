// vader/hooks/context — the build-driver contract.
//
// `vader/hooks` is the ONE module a project's `build.vader` imports; everything
// else under `vader/` is compiler implementation. A driver builds a context,
// configures it, then pulls `messages()` to drive the compilation:
//
//     module "build"
//
//     import "vader/hooks"
//
//     build :: fn(args: string[]) -> void {
//         ctx :: new_build_context(args)
//         ctx.load_from_vader_config()
//         ctx.add_build_file("src/main.vader")
//         for msg in ctx.messages() { … }
//     }
//
// `build` is a reserved name in `build.vader`, the way `main` is in a program —
// no decorator is involved. The driver is compiled and run NATIVELY, not through
// the comptime VM: it reads the compiler's own AST nodes, and the VM has its own
// value representation (per-module type indices and atom ids), which no shared
// layout can reconcile. See
// `.claude/plans/2026-08-26-metacompilation-hook.md` §4 and §11.

module "vader/hooks"

import "vader/diagnostics"
import "std/collections"
import "std/io"
import "std/path"
import "vader/resolver"
import "std/string" { join as join_strings }
import "vader/pipeline"
AST :: import "vader/parser"

// ---- context --------------------------------------------------------------

/// Everything a build driver configures, plus the entry files it queues.
///
/// A driver mutates this in place, so it takes `BuildContext!` wherever it is
/// threaded. The fields carry what `vader.json` and the `vader build` flags
/// carry today; a driver that sets them is authoritative — the manifest is only
/// consulted when it asks, via `load_from_vader_config`.
export BuildContext :: struct {
    /// Project root as the compiler resolved it: the folder holding
    /// `vader.json`, or the invocation folder when the project has no manifest.
    /// NOT guaranteed absolute — the stdlib exposes no `cwd()`, so this is
    /// whatever the compiler passed, which may be relative to the invocation
    /// directory. Join onto it rather than assuming a prefix.
    project_root:   string
    /// Module search roots, GCC `-I` style, highest precedence first. Left
    /// empty by `new_build_context` — a driver either fills it or calls
    /// `load_from_vader_config`.
    include_paths:  string[]!
    /// Where generated modules land, relative to `project_root`.
    generated_root: string
    /// Binary to produce, relative to `project_root`. Empty means "derive it
    /// from the entry file", the way `vader build` does without `--out`.
    out:            string
    /// Optimise, and drop `#line` from the emitted C.
    release:        bool
    /// C compiler for the link step.
    cc:             string
    /// Raw linker flags, whitespace-split and appended verbatim.
    ldflags:        string
    /// What draining `messages()` produces. `.Native` by default — a build
    /// system builds; a driver that only observes leaves the loop at
    /// `BeforeEmit` rather than setting this.
    target:         BuildTarget
    /// C emitted by a `.C`-targeted drain, in queue order.
    @internal
    c_sources:      string[]! = []
    /// Modules the driver asked for in the CURRENT round, awaiting a flush.
    /// Emptied by `flush_generated` once the round reaches `BeforeEmit` — the
    /// driver has had every chance to emit by then.
    @internal
    pending:        GeneratedModule[]! = []
    /// Generated files written this build, in the order they landed. The sweep
    /// runs before the first round, so this set is authoritative for this run.
    @internal
    generated:      string[]! = []
    /// Entry files, in the order `add_build_file` queued them. Read by the
    /// driver loop, never written directly — the order is what makes a build
    /// reproducible, so it stays behind `add_build_file`.
    @internal
    build_files:    string[]! = []
    /// Diagnostics the driver reported, in the order it reported them. Drained
    /// by the compiler once the driver returns.
    @internal
    diagnostics:    Diagnostic[]! = []
}

/// Default location of generated modules, relative to the project root.
///
/// Gitignored by convention (`build/` already is): the generated tree is a
/// build artefact, reproducible from the driver plus the sources it reads.
export DEFAULT_GENERATED_ROOT :: "build/generated"

/// Build a context carrying the defaults a driver would otherwise restate.
///
/// The project root comes from `args`, not from the process working directory:
/// the stdlib exposes no `cwd()` (`std/env` has only `get_env`, and the C runtime
/// no `getcwd`), so threading it is the only way a driver can know where it is.
/// The compiler passes the root it resolved as `args[1]`; invoked bare, the root
/// is left empty rather than guessed.
///
/// @param args  the driver's argv. `args[0]` is the driver binary, `args[1]`
///              the project root when the compiler supplied one.
/// @return      a context with `project_root` set (empty when `args` carried
///              none), no include paths, and `generated_root` at
///              `DEFAULT_GENERATED_ROOT`. Returned MUTABLE: the whole contract
///              is that the driver fills it in, so an immutable result would
///              refuse `ctx.out = …` (T3070).
export new_build_context :: fn(args: string[]) -> BuildContext! = BuildContext {
    .project_root   = project_root_from(args),
    .include_paths  = [],
    .generated_root = DEFAULT_GENERATED_ROOT,
    .out            = "",
    .release        = false,
    .cc             = DEFAULT_CC,
    .ldflags        = "",
    .target         = .Native,
}

/// What a drained `messages()` leaves behind.
export BuildTarget :: enum(u8) {
    /// Link a binary at `out`.
    Native,
    /// Emit C only, collected by `emit_c`.
    C,
    /// Produce nothing — for a driver that drains the stream purely to observe.
    None,
}

/// C compiler assumed when a driver names none. `cc` rather than a specific
/// toolchain: it is what every platform's default install provides.
export DEFAULT_CC :: "cc"

// Project root as `args` reports it, falling back to the empty string when the
// driver was invoked bare. An empty root is not an error here — a driver may set
// `project_root` itself; the compiler reports H6xxx when the build starts with
// no usable root.
project_root_from :: fn(args: string[]) -> string {
    if args.len() >= 2 {
        return args[1]
    }
    return ""
}

// ---- configuration --------------------------------------------------------

/// Queue an entry file for compilation.
///
/// Order is preserved and load-bearing: it fixes the order modules are read,
/// and therefore symbol-id assignment, which is what keeps a build byte-identical
/// across runs.
///
/// @param ctx   the context being configured.
/// @param path  entry `.vader` file, relative to `project_root`.
export add_build_file :: fn(ctx: BuildContext!, path: string) -> void {
    ctx.build_files.push(path)
}

/// Entry files queued so far, in order.
///
/// @return the queued paths — empty when the driver has queued none, which the
///         compiler surfaces as an error rather than compiling nothing.
export build_files_of :: fn(ctx: BuildContext) -> string[] = ctx.build_files

/// Refill `include_paths` from the project `vader.json`.
///
/// A convenience for projects that keep a manifest — never a prerequisite. A
/// driver that sets `include_paths` itself has no reason to call this, and a
/// project without a manifest gets an empty list rather than a diagnostic.
///
/// @param ctx  the context being configured; its `include_paths` is REPLACED,
///             not appended to, so calling this after setting them by hand
///             discards the hand-set values.
export load_from_vader_config :: fn(ctx: BuildContext!) -> void {
    if ctx.project_root == "" {
        return
    }
    manifest :: read_manifest(ctx.project_root)
    fresh: string[]! = []
    for p in manifest.include_paths {
        fresh.push(p)
    }
    ctx.include_paths = fresh
}

// ---- driving the compilation ----------------------------------------------

/// Drive the compilation and yield what the pipeline produces.
///
/// Nothing compiles until the first message is pulled, so a driver configures
/// the context first and iterates second. Each queued entry file is run through
/// the front end (`load → resolve + typecheck → comptime`), yielding one
/// `TypecheckedMessage` per module, then a `PhaseMessage`, and finally one
/// `CompleteMessage` for the whole run.
///
/// **Every** typed module is yielded, the stdlib included — a driver that only
/// cares about its own code filters on `module_name`. Reporting the full set is
/// the honest default: which modules are "the project" is the driver's policy,
/// not this function's.
///
/// Every declaration is delivered exactly ONCE per queued entry, however many
/// generation rounds that entry takes — see `TypecheckedMessage`. A module with
/// nothing new is not yielded at all. The "once" is per ENTRY, not per build: two
/// entries sharing a module both report it, which is already true of the stdlib.
///
/// Batched per file rather than streamed per declaration: Vader is
/// single-threaded here, so the compiler fills a phase and hands it over. The
/// loop shape is the same either way, and the order is specified rather than
/// dependent on scheduling — which is what keeps a driven build reproducible.
///
/// A driver that generates code makes the stream LOOP: the phases from
/// `Typechecked` to `BeforeEmit` repeat once per generation round, and the back
/// end runs only after the last one. Declarations are still delivered once each
/// (see `emit_module`), so an observing driver cannot tell the difference.
///
/// @param ctx  the configured context. An empty `build_files` yields only
///             `CompleteMessage` — the caller reports H6003.
/// @return     a lazy stream of messages, in pipeline order.
/// @error      H6006 when generation never settles ; H6008 when a generated
///             module cannot be written. Both land on `ctx.diagnostics`.
export messages :: fn(ctx: BuildContext!) -> Iterator<Message> {
    // Configuration is read ONCE, here. Mutating `ctx.out` / `ctx.release` / …
    // after the first pull is therefore ignored uniformly, rather than honoured
    // for entries not yet reached — a stream cannot re-read what it already
    // acted on, and half-applying a change is worse than ignoring it.
    target  :: ctx.target
    release :: ctx.release
    cc      :: ctx.cc
    ldflags :: ctx.ldflags
    out     :: ctx.out
    if ctx.build_files.len() == 0 {
        ctx.diagnostics.push(hook_error(.NoBuildFiles, empty_span(),
            "call `ctx.add_build_file(...)` before iterating `messages()`"))
        yield CompleteMessage { .code = 1 }
        return
    }
    // Generated modules of an EARLIER build would still resolve, and — file
    // names being content hashes — a module whose text changed would sit beside
    // its own previous version and collide with it. Swept BEFORE the first front
    // end rather than after the last: a build that fails never reaches its own
    // cleanup, and the guarantee that matters is about the build starting now.
    // NOT an ordinary include path: the generated root MERGES into a module an
    // earlier root already provided, which is what lets a driver emit into the
    // project's own module instead of a separate one it would have to import
    // (and could not, without a cycle).
    generated :: generated_root_of(ctx)
    _ :: sweep_generated(generated)
    code := 0
    for file in ctx.build_files {
        entry :: Path(join_path(ctx.project_root, file))
        // Declarations are delivered ONCE per build — the Jai property, without
        // Jai's incremental typechecker. What is tracked is the FILE, not the
        // module, and that precision is load-bearing: when a driver emits into a
        // module it also inspects (the `@derive` shape — read `app`'s structs,
        // generate into `app`), the next round re-delivers that module carrying
        // ONLY the generated file's declarations. A lint rule over the
        // hand-written ones therefore still fires exactly once. File paths are
        // stable across rounds — a generated one IS its own content hash.
        //
        // So a driver accumulates in its own variables across rounds rather than
        // guarding against seeing the same declaration twice.
        delivered :: MutableSet<string> {}
        round := 0
        for {
            // Front end. The pipeline stays live to the end of the round, which
            // is what lets the back end reuse it instead of re-running ~45% of
            // the build.
            pipeline :: prepare_evaluated_project_with(entry, ctx.include_paths, generated)
            for [_, loaded] in pipeline.loaded.modules {
                fresh :: undelivered_decls(loaded.module.files, delivered)
                // Nothing new in this module: say nothing about it at all,
                // rather than yield an empty message a driver would have to
                // skip.
                if fresh.len() == 0 {
                    continue
                }
                yield TypecheckedMessage {
                    .module_name  = loaded.module.module_name,
                    .declarations = fresh,
                }
            }
            yield PhaseMessage { .phase = .Typechecked }
            yield PhaseMessage { .phase = .Evaluated }

            // Last exit before anything is written. A driver that only observes
            // leaves the loop here — and one that generates has had every chance
            // to call `emit_module` by now, which is why the flush FOLLOWS this
            // yield instead of preceding it.
            yield PhaseMessage { .phase = .BeforeEmit }
            regenerated :: flush_generated(ctx)
            if regenerated.len() > 0 {
                round += 1
                if round < MAX_GENERATION_ROUNDS {
                    continue
                }
                // Not a hang — a driver whose emitted text never stabilises. The
                // detail names what was still moving, since that is the only
                // clue to which rule is unstable.
                ctx.diagnostics.push(hook_error(.GenerationDidNotSettle, empty_span(),
                    "`${join_strings(regenerated, "`, `")}` still changed after ${MAX_GENERATION_ROUNDS} rounds"))
                code = 1
                break
            }
            // Nothing moved: this is the fixed point, and the last round's
            // pipeline is the one the back end gets.
            if target == .None {
                break
            }
            lowered :: lower_to_entry_from(pipeline)
            yield PhaseMessage { .phase = .Lowered }

            built :: emit_one(ctx, lowered, entry, target, release, cc, ldflags, out, ctx.build_files.len())
            if built != 0 {
                code = built
            }
            yield PhaseMessage { .phase = .OutputWritten }
            break
        }
    }
    yield CompleteMessage { .code = code }
}


// Top-level declarations of the files not yet delivered, marking them delivered
// as it goes. Returns empty when the module has nothing new — see the delivery
// note in `messages`.
//
// Filters the FILES and hands them to `concat_file_decls`, rather than
// concatenating here: that keeps its single-file fast path, which returns the
// file's own `decls` with no copy. Single-file modules are the common case, and
// this runs for every module of the project on every round.
undelivered_decls :: fn(files: SourceFile[], delivered: MutableSet<string>!) -> AST.Decl[] {
    fresh: SourceFile[]! = []
    for f in files {
        if f.path in delivered {
            continue
        }
        _ :: delivered.add(f.path)
        fresh.push(f)
    }
    return concat_file_decls(fresh)
}

// Carry one lowered entry to its output, per `ctx.target`. Diagnostics land on
// the context so they interleave with the driver's own reports in order.
emit_one :: fn(
    ctx: BuildContext!, lowered: LoweredEntry!, entry: Path,
    target: BuildTarget, release: bool, cc: string, ldflags: string, out: string, entries: usize,
) -> i32 {
    // One `out` cannot name N binaries: the second would overwrite the first in
    // silence. Refuse rather than pick a winner.
    if out != "" && entries > 1 {
        ctx.diagnostics.push(hook_error(.AmbiguousOutput, empty_span(),
            "`ctx.out` names one binary but ${entries} entries are queued — leave it empty to derive a name per entry"))
        return 1
    }
    cfg :: prepare_cfg_bytecode_from(lowered, entry, !release)
    for d in cfg.pre_diags {
        ctx.diagnostics.push(d)
    }
    for d in cfg.lower_diags {
        ctx.diagnostics.push(d)
    }
    // BOTH bags, as `flush_build_diags` does for `vader build <file>`: a lowering
    // error still leaves bytecode behind, so gating on `pre_diags` alone would
    // emit C from it, link a binary, and report success — a silently wrong build.
    if any_error_diag(cfg.pre_diags) || any_error_diag(cfg.lower_diags) {
        return 1
    }
    c :: c_source_of(cfg, release)
    if target == .C {
        ctx.c_sources.push(c)
        return 0
    }
    binary :: if out != "" {
        join_path(ctx.project_root, out)
    } else {
        strip_input_suffix(entry).as_string()
    }
    return link_native(c, Path(binary), cc, release, ldflags)
}

// ---- producing output -----------------------------------------------------

/// Compile the queued entries into native binaries.
///
/// This is what makes a driver a build system rather than an observer. Each
/// queued file is compiled to `ctx.out` — or, when that is empty, to the entry's
/// own name minus its extension, which is what `vader build` does without
/// `--out`.
///
/// Front-end and lowering diagnostics are **accumulated onto the context**, not
/// printed, so they interleave with the driver's own reports in the order they
/// happened and `flush_reports` prints them all at once.
///
/// @param ctx  the configured context ; queue entries with `add_build_file`.
/// @return     0 when every entry built, 1 as soon as one failed. A driver
///             normally returns this from `build`.
export emit_native :: fn(ctx: BuildContext!) -> i32 {
    ctx.target = .Native
    return drain(ctx)
}

/// Compile the queued entries to C, without linking.
///
/// The counterpart of `emit_native` for a driver that wants the source — to
/// post-process it, to hand it to another toolchain, or just to look. Mirrors
/// `--target=c`.
///
/// @param ctx  the configured context ; queue entries with `add_build_file`.
/// @return     one C source per queued entry, in queue order. Empty when a
///             front end rejected an entry — the reports say why.
export emit_c :: fn(ctx: BuildContext!) -> string[] {
    ctx.target = .C
    _ :: drain(ctx)
    return ctx.c_sources
}

// Drain the stream, ignoring every message but the last. This is what makes
// `emit_native` / `emit_c` shortcuts rather than a second implementation: there
// is one build path, and a driver that observes sees the same one.
drain :: fn(ctx: BuildContext!) -> i32 {
    code := 1
    for msg in ctx.messages() {
        if msg is CompleteMessage as c {
            code = c.code
        }
    }
    return code
}

// ---- reporting ------------------------------------------------------------

/// Report a problem from the driver, anchored in the user's source.
///
/// Accumulates; `flush_reports` prints. The driver describes the problem and the
/// registry owns the code (`H6004`) — a project's lint rules should never have
/// to allocate diagnostic ids, and every driver report stays greppable under one
/// code.
///
/// Pass the tightest span the user can act on: a decl's `name_span` rather than
/// its `span`, a field rather than the struct holding it.
///
/// @param ctx      the context accumulating the report.
/// @param span     smallest source range the user can act on.
/// @param message  what is wrong, lowercase and without a trailing period —
///                 backtick identifiers, as the registry style requires.
export report :: fn(ctx: BuildContext!, span: Span, message: string) -> void {
    ctx.diagnostics.push(hook_error(.HookReport, span, message))
}

/// Reports accumulated so far, in order.
///
/// @return the driver's diagnostics. Inspect them to decide an exit status;
///         `flush_reports` is what puts them on the wire.
export reports_of :: fn(ctx: BuildContext) -> Diagnostic[] = ctx.diagnostics

/// Print every accumulated report, in the compiler's own diagnostic format.
///
/// A driver has to call this: under this model the driver IS the process, so
/// there is no host left to drain the reports for it. Accumulating first and
/// printing once keeps the order the driver produced — which is what makes a
/// driven build's output reproducible.
///
/// @param ctx  the context holding the reports.
/// @return     true when at least one report was printed, so a driver can pick
///             its exit status without counting them itself.
export flush_reports :: fn(ctx: BuildContext) -> bool {
    if ctx.diagnostics.len() == 0 {
        return false
    }
    eprintln(dump_diagnostics_with_file(ctx.diagnostics))
    return true
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_new_context_takes_root_from_args :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    assert_eq(ctx.project_root, "/tmp/proj")
}

@test test_new_context_bare_args_leaves_root_empty :: fn() -> void {
    ctx :: new_build_context(["driver"])
    assert_eq(ctx.project_root, "")
}

@test test_new_context_defaults_generated_root :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    assert_eq(ctx.generated_root, DEFAULT_GENERATED_ROOT)
}

@test test_new_context_has_no_include_paths :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    assert_eq(ctx.include_paths.len(), 0)
}

@test test_add_build_file_preserves_order :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    ctx.add_build_file("a.vader")
    ctx.add_build_file("b.vader")
    queued :: ctx.build_files_of()
    assert_eq(queued.len(), 2)
    assert_eq(queued[0], "a.vader")
    assert_eq(queued[1], "b.vader")
}

@test test_no_build_files_by_default :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    assert_eq(ctx.build_files_of().len(), 0)
}

@test test_load_config_without_root_is_a_noop :: fn() -> void {
    ctx :: new_build_context(["driver"])
    ctx.load_from_vader_config()
    assert_eq(ctx.include_paths.len(), 0)
}

@test test_load_config_missing_manifest_yields_empty :: fn() -> void {
    // `read_manifest` returns an empty Manifest for a missing / malformed file,
    // so a project without `vader.json` is not an error — it just has no roots.
    ctx :: new_build_context(["driver", "/nonexistent-project-root"])
    ctx.load_from_vader_config()
    assert_eq(ctx.include_paths.len(), 0)
}

@test test_report_accumulates_in_order :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    ctx.report(empty_span(), "first problem")
    ctx.report(empty_span(), "second problem")
    reports :: ctx.reports_of()
    assert_eq(reports.len(), 2)
    assert_eq(reports[0].detail, "first problem")
    assert_eq(reports[1].detail, "second problem")
}

@test test_report_carries_the_registry_code :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    ctx.report(empty_span(), "something")
    assert_eq(ctx.reports_of()[0].code.id, "H6004")
}

@test test_no_reports_by_default :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    assert_eq(ctx.reports_of().len(), 0)
}

@test test_messages_without_entries_reports_h6003 :: fn() -> void {
    ctx :: new_build_context(["driver", "/tmp/proj"])
    // Draining the stream is what triggers the check ; a configured-but-unread
    // context is not yet a mistake.
    for _ in ctx.messages() {}
    reports :: ctx.reports_of()
    assert_eq(reports.len(), 1)
    assert_eq(reports[0].code.id, "H6003")
}
