// vader/build_server/dispatch: a build served to its driver, one event at a time.
//
// Lock-step, as the stream is: the driver opens with its `ConfigureFrame` and
// what it asked for before pulling the stream, then for each event `vader`
// sends, the driver answers with its requests (modules to generate, reports).
// Either closes with `NextFrame`, or `StopFrame` when its loop is over. Past
// the end, the build takes requests until the driver's exit stops it. Whatever
// stands on the other side is a `DriverPeer`: the driver a `vader.json` stands
// for, in this process (`ManifestPeer`), or a driver process behind its pipes.

module "vader/build_server"

import "std/console"
import "std/glob"
import "std/iter"
import "toolchain/diagnostics"
import "toolchain/project"
import "toolchain/protocol"
import "vader/front/resolver"
import "vader/pipeline"

// ---- peers ----------------------------------------------------------------

/// The driver a build is served to: what `vader` tells it, and what it answers.
export DriverPeer :: trait {
    /// Hand the driver an event.
    send :: fn(self, frame: ServerFrame) -> null | ProtocolError
    /// The driver's next frame, waited for. A driver that hung up stopped.
    receive :: fn(self) -> DriverFrame | ProtocolError
}

/// The driver a `vader.json` stands for, in `vader`'s own process: it configures
/// the build from the file, reads no module, and lets every event pass.
export ManifestPeer :: struct {
    /// The file, read and found without problems: its reader checks the entry
    /// names and the assets.
    manifest: Manifest
    /// The C toolchain the command named, which a `vader.json` does not change.
    cc: string
    ldflags: string
    @internal
    configured: bool = false
}

ManifestPeer implements DriverPeer {
    send :: fn(self, frame: ServerFrame) -> null | ProtocolError = null

    receive :: fn(self) -> DriverFrame | ProtocolError {
        if self.configured {
            return NextFrame {}
        }
        self.configured = true
        return ConfigureFrame {
            .fingerprint = "",
            .entries = self.manifest.entries,
            .include_paths = self.manifest.include_paths,
            .assets = self.manifest.assets,
            .modules = [],
            .target = .Native,
            .cc = self.cc,
            .ldflags = self.ldflags,
        }
    }
}

/// The driver of a `vader.json` project, for the build `request` asks.
///
/// @param request   what the command asks ; its C toolchain is the build's.
/// @param manifest  the project's file, read and found without problems.
export manifest_peer :: fn(request: DriverRequest, manifest: Manifest) -> ManifestPeer =
    ManifestPeer {
        .manifest = manifest,
        .cc = cc_or_default(request.build.cc),
        .ldflags = request.build.ldflags,
    }

// ---- serving --------------------------------------------------------------

/// Serve the build a driver configures, as the command asked: its events go to
/// the driver, its requests to the build, until the driver stops it.
///
/// Once the driver had its say on the end, the build prints what it holds, and
/// still takes what the driver reports or emits until it stops the build at its
/// exit: a module emitted then is one no round writes.
///
/// @param peer              the driver.
/// @param request           what the command asks.
/// @param description_file  the file describing the project, relative to it:
///                          `vader.json`, `build.vader`.
/// @return                  the build's exit code: 1 once its diagnostics hold an
///                          error, the driver's reports included.
/// @error                   `ProtocolError` when the driver breaks the protocol,
///                          once said: nothing it sends from there on is read.
export serve :: fn(
    peer: DriverPeer,
    request: DriverRequest,
    description_file: string,
) -> i32 | ProtocolError {
    opening :: peer.receive() else is ProtocolError {
        return protocol_failure(opening.msg)
    }
    // A driver that stops before configuring a build started none.
    if opening is StopFrame {
        return 0
    }
    if opening !is ConfigureFrame {
        return protocol_failure("the driver opened with another frame than its configuration")
    }
    session :: new_session(request, description_file, opening) else is GlobError {
        return protocol_failure("a module pattern does not parse: ${session.message()}")
    }
    // A module asked for before the stream is pulled, generated from data the
    // entries import, is read by the first round.
    opened :: answer(peer, session) else is ProtocolError {
        return protocol_failure(opened.msg)
    }
    if opened is StopFrame {
        return close_session(session, 0)
    }
    code := 0
    for event in build_events(session) {
        sent :: peer.send(frame_of(session, event)) else is ProtocolError {
            return protocol_failure(sent.msg)
        }
        answered :: answer(peer, session) else is ProtocolError {
            return protocol_failure(answered.msg)
        }
        if event is CompleteFrame {
            code = event.code
        }
        if answered is StopFrame {
            return close_session(session, code)
        }
    }
    close_session(session, code)
    stopped :: answer(peer, session) else is ProtocolError {
        return protocol_failure(stopped.msg)
    }
    return close_session(session, code)
}

// Take the driver's requests until it lets the build go on: the frame that
// closed them, `NextFrame` or `StopFrame`.
answer :: fn(peer: DriverPeer, session: BuildSession) -> NextFrame | StopFrame | ProtocolError {
    for {
        match frame :: peer.receive() {
            is ProtocolError                 -> {
                return frame
            }
            is EmitModuleFrame | ReportFrame -> {
                taken :: take_request(session, frame) else is ProtocolError {
                    return taken
                }
            }
            is NextFrame | StopFrame         -> {
                return frame
            }
            is ConfigureFrame                -> {
                return ProtocolError { .msg = "the driver configured its build twice" }
            }
        }
    }
}

/// Take a request of the driver: a module to generate, written at the end of the
/// round, or a report.
///
/// @param session  the build.
/// @param frame    what the driver asks.
/// @error          `ProtocolError` for a report under a code that is no hook code.
export take_request :: fn(
    session: BuildSession,
    frame: EmitModuleFrame | ReportFrame,
) -> null | ProtocolError {
    if frame is EmitModuleFrame {
        session.queue_module(frame.name, frame.source)
        return null
    }
    return take_report(session, frame)
}

// The report of the driver, under the hook code it names.
take_report :: fn(session: BuildSession, frame: ReportFrame) -> null | ProtocolError {
    for code in HookCode {
        if CodeInfo(code).id == frame.code {
            session.diagnostics.push(hook_error(code, frame.span, frame.detail))
            return null
        }
    }
    return ProtocolError { .msg = "`${frame.code}` is no hook code" }
}

/// The frame that tells a driver `event`: of a module, the declarations that
/// cross; of the end, the build's outcome so far, the driver's reports included,
/// and the files it generated.
///
/// @param session  the build.
/// @param event    what the build produced.
export frame_of :: fn(session: BuildSession, event: BuildEvent) -> ServerFrame = match event {
    is ModuleTypechecked -> TypecheckedFrame {
        .module_name = event.module_name,
        .declarations = concat_file_decls(event.files).filter(crosses).collect(),
    }
    is PhaseFrame        -> event
    is CompleteFrame     -> CompleteFrame {
        .code = session_outcome(session, event.code),
        .generated = session.generated,
    }
}

protocol_failure :: fn(problem: string) -> ProtocolError {
    eprintln("vader: the build driver broke the protocol: ${problem}")
    return ProtocolError { .msg = problem }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "toolchain/span"

// A driver that answers each event with the frames a test lined up, and writes
// down what it was sent.
ScriptedPeer :: struct {
    answers: DriverFrame[]
    sent: ServerFrame[] = []
    at: i64 = 0
}

ScriptedPeer implements DriverPeer {
    send :: fn(self, frame: ServerFrame) -> null | ProtocolError {
        self.sent.push(frame)
        return null
    }

    receive :: fn(self) -> DriverFrame | ProtocolError {
        if self.at >= self.answers.len() {
            return ProtocolError { .msg = "the script is over" }
        }
        frame :: self.answers[self.at]
        self.at += 1
        return frame
    }
}

// The code of the build `peer` drives, -1 when it breaks the protocol.
served :: fn(peer: ScriptedPeer) -> i32 =
    serve(peer, request_for("/tmp/proj"), "build.vader") else -1

// A configuration with no entry, reading every module.
entryless :: fn() -> ConfigureFrame = ConfigureFrame {
    .fingerprint = "",
    .entries = [],
    .include_paths = [],
    .assets = [],
    .modules = ["**"],
    .target = .Native,
    .cc = "cc",
    .ldflags = "",
}

@test
test_serve_ends_a_build_without_entries_on_its_failure :: fn() -> void {
    peer :: ScriptedPeer { .answers = [entryless(), NextFrame {}, NextFrame {}, StopFrame {}] }
    assert_eq(served(peer), 1)
    assert_eq(peer.sent.len(), 1)
    assert(peer.sent[0] is CompleteFrame, "the stream is its end alone")
}

@test
test_serve_takes_the_reports_sent_before_the_stream :: fn() -> void {
    report :: ReportFrame {
        .code = "H6004",
        .span = empty_span(),
        .detail = "a rule of the project",
    }
    peer :: ScriptedPeer {
        .answers = [entryless(), report, NextFrame {}, NextFrame {}, StopFrame {}],
    }
    assert_eq(served(peer), 1)
    // The report reached the build before it ran: nothing compiles.
    assert_eq(peer.sent.len(), 1)
    sent :: peer.sent[0]
    assert(sent is CompleteFrame && sent.code == 1, "the end carries the failure")
}

@test
test_serve_takes_the_requests_of_the_driver_until_it_stops_the_build :: fn() -> void {
    report :: ReportFrame {
        .code = "H6004",
        .span = empty_span(),
        .detail = "made once the loop was over",
    }
    peer :: ScriptedPeer {
        .answers = [entryless(), NextFrame {}, NextFrame {}, report, StopFrame {}],
    }
    assert_eq(served(peer), 1)
    assert_eq(peer.at, peer.answers.len())
}

@test
test_serve_builds_nothing_for_a_driver_that_stops_before_configuring :: fn() -> void {
    peer :: ScriptedPeer { .answers = [StopFrame {}] }
    assert_eq(served(peer), 0)
    assert_eq(peer.sent.len(), 0)
}

@test
test_serve_closes_a_build_the_driver_stops_before_the_stream :: fn() -> void {
    peer :: ScriptedPeer { .answers = [entryless(), StopFrame {}] }
    assert_eq(served(peer), 0)
    assert_eq(peer.sent.len(), 0)
}

@test
test_a_report_is_taken_under_its_hook_code :: fn() -> void {
    report :: ReportFrame {
        .code = "H6004",
        .span = empty_span(),
        .detail = "a rule of the project",
    }
    session :: test_session(request_for("/tmp/proj"), [])
    assert(take_report(session, report) == null, "`H6004` is a hook code")
    assert_eq(session.diagnostics[0].code.id, "H6004")
    assert_eq(session.diagnostics[0].detail, "a rule of the project")
}

@test
test_a_report_under_another_code_is_refused :: fn() -> void {
    report :: ReportFrame {
        .code = "T3001",
        .span = empty_span(),
        .detail = "a forged type error",
    }
    session :: test_session(request_for("/tmp/proj"), [])
    assert(take_report(session, report) is ProtocolError, "a driver reports under hook codes")
    assert_eq(session.diagnostics.len(), 0)
}

@test
test_serve_refuses_a_driver_that_does_not_open_with_its_configuration :: fn() -> void {
    peer :: ScriptedPeer { .answers = [NextFrame {}] }
    served :: serve(peer, request_for("/tmp/proj"), "build.vader")
    assert(served is ProtocolError, "a driver opens with its configuration")
    assert_eq(peer.sent.len(), 0)
}

@test
test_a_manifest_peer_configures_then_lets_every_event_pass :: fn() -> void {
    manifest :: Manifest {
        .include_paths = ["vendor"],
        .entries = [ManifestEntry { .name = "app", .path = "src/main.vader" }],
        .assets = [],
    }
    peer :: manifest_peer(request_for("/tmp/proj"), manifest)
    opening :: peer.receive()
    if opening !is ConfigureFrame {
        assert(false, "the peer opens with its configuration")
        return
    }
    assert_eq(opening.entries[0].name, "app")
    assert_eq(opening.include_paths[0], "vendor")
    assert_eq(opening.modules.len(), 0)
    assert(peer.receive() is NextFrame, "then it lets the build go on")
}
