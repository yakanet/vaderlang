// vader/cli/project: what the argument of `build`, `run`, `check`, `dump`,
// `lint` or `graph` names.
//
// A file is compiled as it is. A folder is a project, described by exactly one
// of its `build.vader` (the project drives its own build) and its `vader.json`
// (the `entries` it declares): with both, nothing says which description wins,
// and with neither, nothing says what to compile.
//
// Same module as `main.vader`: imports are file-scoped, declarations are not.

module "vader/cli"

import "std/io"
import "std/iter"
import "std/path"
import "std/string"
Time :: import "std/time"
import "vader/pipeline"
import "vader/resolver"

/// What the argument of `build`, `run`, `check`, `dump`, `lint` or `graph` names.
ProjectInput :: FileInput | ManifestProject | DrivenProject

/// A file, compiled as it is.
FileInput :: struct {
    file: Path
}

/// A folder whose `vader.json` declares the programs to compile.
ManifestProject :: struct {
    dir:      string
    /// The entries to work on: every one, or the one `--entry` names.
    entries:  ProjectEntry[]
    /// The `vader.json`, read and found without problems.
    manifest: Manifest
}

/// A folder whose `build.vader` decides what to compile.
DrivenProject :: struct {
    dir: string
}

/// One program of a project: an entry of its `vader.json`, or one its
/// `build.vader` adds.
ProjectEntry :: struct {
    /// Its key in `entries`, which names the binary.
    name: string
    /// The entry file, joined onto the project folder.
    file: Path
}

// What the argument `path` of `command` names, or the exit code after saying
// why it names nothing to compile: 2 for an `--entry` (`selected`) that has
// nothing to choose from, 1 otherwise.
resolve_input :: fn(command: string, path: Path, selected: string) -> ProjectInput | i32 {
    dir :: path.as_string()
    if !is_dir(dir) {
        if selected != "" {
            eprintln("vader ${command}: `--entry` chooses among a project's entries, "
                + "and `${path}` is not a folder")
            return 2
        }
        return FileInput { .file = path }
    }
    described_by :: project_description(command, dir, "; name the entry file instead") ?? return 1
    if described_by == DRIVER_FILENAME {
        return DrivenProject { .dir = dir }
    }
    manifest :: checked_manifest(command, dir) ?? return 1
    entries :: select_entries(command, dir, manifest, selected) ?? return 1
    return ManifestProject {
        .dir = dir,
        .entries = entries,
        .manifest = manifest,
    }
}

// The file that describes the project folder `dir`, its `build.vader` or its
// `vader.json`, or null after saying it holds both or neither; `otherwise`
// ends the second message.
project_description :: fn(command: string, dir: string, otherwise: string) -> string | null {
    has_driver :: find_build_driver(dir) != null
    has_manifest :: exists(join_path(dir, MANIFEST_FILENAME))
    if has_driver && has_manifest {
        eprintln("vader ${command}: `${dir}` holds both a `${DRIVER_FILENAME}` and a "
            + "`${MANIFEST_FILENAME}`; keep the one that describes its build")
        return null
    }
    if has_driver {
        return DRIVER_FILENAME
    }
    if has_manifest {
        return MANIFEST_FILENAME
    }
    eprintln("vader ${command}: `${dir}` holds neither a `${DRIVER_FILENAME}` nor a "
        + "`${MANIFEST_FILENAME}`${otherwise}")
    return null
}

/// One file to work on, and the project it belongs to.
EntryInProject :: struct {
    file:         Path
    /// The project folder, null for a file on its own.
    project_root: string | null
}

// The one file `command` works on: the file `path` names, or the only entry of
// the project folder it names (the one `selected` names among several). The
// exit code after saying why there is none.
single_entry :: fn(command: string, path: Path, selected: string) -> EntryInProject | i32 {
    input :: resolve_input(command, path, selected)
    if input is i32 {
        return input
    }
    match input {
        is FileInput -> { return EntryInProject { .file = input.file, .project_root = null } }
        is ManifestProject -> {
            entry :: sole_entry(command, input.dir, input.entries) ?? return 2
            return EntryInProject { .file = entry.file, .project_root = input.dir }
        }
        is DrivenProject -> {
            // The driver chooses the entry and generates first, so that
            // `command` reads fresh generated code.
            project :: described_project(command, input.dir, .Prepare, selected) ?? return 1
            register_project_roots(input.dir, project.include_paths)
            entries :: project_entries(input.dir, project.entries)
            entry :: sole_entry(command, input.dir, entries) ?? return 2
            return EntryInProject { .file = entry.file, .project_root = input.dir }
        }
    }
}

// The project the `build.vader` of the folder `dir` describes, its driver run
// in `mode` with `selected` as `--entry`. The driver writes the description to
// a temporary file, read back and removed at once, so that its own output never
// mixes with it. Null after the driver, or this function, said why there is
// none.
described_project :: fn(
    command: string,
    dir: string,
    mode: DriverMode,
    selected: string,
) -> Manifest | null {
    // Unique to this run: the language server may describe the project while a
    // command in a terminal prepares it.
    path :: join_path(temp_dir(), "vader-project-${i64(Time.monotonic())}.json")
    request :: DriverRequest {
        .mode = mode,
        .selected = selected,
        .description = path,
    }
    if run_build_driver(command, dir, request) != 0 {
        return null
    }
    project :: read_driver_description(path)
    remove_file(path)
    if project is IOError {
        eprintln("vader ${command}: the `${DRIVER_FILENAME}` of `${dir}` described no project; "
            + "does it drain `ctx.messages()`?")
        return null
    }
    return project
}

// The project `vader test` and `vader doctor` take: `dir`, the folder they run
// in, when it holds a `vader.json`; null otherwise.
project_at :: fn(dir: string) -> string | null {
    if !exists(join_path(dir, MANIFEST_FILENAME)) {
        return null
    }
    return dir
}

// The `vader.json` of the project `dir`, or null after saying what it gets
// wrong: `command` refuses a manifest with problems.
checked_manifest :: fn(command: string, dir: string) -> Manifest | null {
    manifest :: read_manifest(dir)
    if manifest.problems.len() == 0 {
        return manifest
    }
    path :: join_path(dir, MANIFEST_FILENAME)
    for problem in manifest.problems {
        eprintln("vader ${command}: `${path}`: ${problem}")
    }
    return null
}

// The entries `manifest` declares for the project `dir`, or the one `selected`
// names, or null after saying why there is nothing to compile.
select_entries :: fn(
    command: string,
    dir: string,
    manifest: Manifest,
    selected: string,
) -> ProjectEntry[] | null {
    if manifest.entries.len() == 0 {
        eprintln("vader ${command}: the `${MANIFEST_FILENAME}` of `${dir}` declares no entry; "
            + "add one, as in `\"entries\": { \"app\": \"src/main.vader\" }`")
        return null
    }
    return chosen_entries(command, dir, project_entries(dir, manifest.entries), selected)
}

// The `entries` of the project `dir`, their files joined onto it.
project_entries :: fn(dir: string, entries: ManifestEntry[]) -> ProjectEntry[] =
    entries.map((e) -> ProjectEntry {
        .name = e.name,
        .file = Path(join_path(dir, e.path)),
    }).collect()

// `entries` of a `vader.json`, or the one `selected` names among them, or null
// after saying it names none. A driver chooses among its own.
chosen_entries :: fn(
    command: string,
    dir: string,
    entries: ProjectEntry[],
    selected: string,
) -> ProjectEntry[] | null {
    if selected == "" {
        return entries
    }
    for entry in entries {
        if entry.name == selected {
            return [entry]
        }
    }
    eprintln("vader ${command}: `${dir}` declares no entry `${selected}`; "
        + "it declares ${entry_names(entries)}")
    return null
}

// The one entry of `entries`, or null after saying that `--entry` must choose,
// since `command` works on one program.
sole_entry :: fn(command: string, dir: string, entries: ProjectEntry[]) -> ProjectEntry | null {
    if entries.len() == 1 {
        return entries[0]
    }
    eprintln("vader ${command}: `vader ${command}` works on one program, and `${dir}` declares "
        + "${entry_names(entries)}; choose one with `--entry=<name>`")
    return null
}

// `app`, `tool`: the names of `entries`, for a message.
entry_names :: fn(entries: ProjectEntry[]) -> string =
    entries.map((e) -> "`${e.name}`").collect().join(", ")
