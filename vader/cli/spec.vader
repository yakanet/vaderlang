// vader/cli/spec — the CLI surface, declared once.
//
// Every action, every flag, every accepted value of an enumerated flag, with the
// text that documents it. `std/cli` parses from this table and `std/cli/help`
// renders from it, so a flag described here is a flag the compiler accepts and
// the help shows — there is no second copy to keep in step.
//
// It replaces four things that used to describe the surface separately: the
// 60-line `HELP` string, the `STAGES_LIST` constant, `cmd_build`'s chain of
// `target != …` comparisons, and `cmd_dump`'s twelve `stage == …` arms. They had
// already drifted — `HELP` advertised a `.vir` input the CLI has never
// recognised, promised a REPL for a bare `vader run`, and listed `fmt`'s flags
// that live in a parser of their own.
//
// Adding a flag means adding it here and reading it in the matching `cmd_*`.
// Adding a value to an enumerated flag means adding a `ValueSpec` here and an
// arm to the dispatch; the validation and the error message follow on their own.

module "vader/cli"

import "cli"
import "std/string"
Lsp :: import "vader/lsp"

/// One-line description of the program, for the help's title line.
export TAGLINE :: "the Vader compiler"

/// Flags every action accepts.
///
/// All three are parsed and stripped but wired into no pass yet — `GlobalOpts`
/// is built and never read. They say so rather than describing an effect they
/// don't have: a help entry that overstates is worse than one admitting its own
/// emptiness. They used to be "global options" consumed before the action was
/// even dispatched, which is what let the CLI steal `--allow-env` from a program
/// run under `vader run`.
export COMMON_FLAGS: FlagSpec[]: [
    FlagSpec {
        .name = "help",
        .kind = .Bool,
        .alias = "h",
        .help = "Show this action's options and exit",
    },
    FlagSpec {
        .name = "diagnostics",
        .help = "Reserved; diagnostic output format, no effect yet",
        .value_name = "format",
        .default_text = "text",
        .values = [
            ValueSpec { .name = "text", .help = "Human-readable" },
            ValueSpec { .name = "json", .help = "Machine-readable" },
        ],
    },
    FlagSpec {
        .name = "no-hooks",
        .kind = .Bool,
        .help = "Ignore the project's `build.vader`, and stay quiet about it",
    },
    FlagSpec {
        .name = "allow-env",
        .kind = .Bool,
        .help = "Reserved; no effect yet",
    },
    FlagSpec {
        .name = "no-bytecode-opt",
        .kind = .Bool,
        .help = "Reserved; no effect yet",
    },
]

// `--emit`'s four values: WHAT to produce. It used to be spelled `--target`, and
// the rename is the point — a target is a PLATFORM everywhere else (Rust, Zig,
// Go, Odin), and "produce C for Windows" needs both answers at once, which one
// flag cannot carry. `--emit` is Rust's name for this axis (`--emit=llvm-ir,asm`).
//
// `wasm` is gone from the list on purpose, and is not a loss: a `.wasm` module is
// `--emit=executable --target=wasm32-browser`, the executable OF that platform.
// The separation files it where it belongs instead of leaving it among artefact
// kinds it never resembled.
//
// `bytecode` / `bytecode-text` replace `ir` / `ir-text` to match the vocabulary
// the pipeline already uses everywhere else (`dump --stage=bytecode`, the
// `bytecode.snapshot.virt` files, SPEC's "Bytecode emitter"). The file
// extensions do not change: `.vir` and `.virt`.
EMIT_VALUES: ValueSpec[]: [
    ValueSpec { .name = "executable", .help = "Native binary, via the C emitter" },
    ValueSpec { .name = "c", .help = "The generated C source only" },
    ValueSpec { .name = "bytecode", .help = "Binary bytecode module (not yet implemented)" },
    ValueSpec { .name = "bytecode-text", .help = "Textual bytecode dump (not yet implemented)" },
]

// `check` takes the platform axis and the search roots, and nothing else: it
// produces no artefact, so every flag about HOW to emit would be noise.
CHECK_FLAGS: FlagSpec[]: [
    FlagSpec {
        .name = "target",
        .alias = "t",
        .help = "Platform to check against, as `<os>-<arch>`",
        .value_name = "os-arch",
        .default_text = "this machine",
    },
    FlagSpec {
        .name = "include-paths",
        .help = "Extra module search roots (GCC -I style), highest precedence",
        .value_name = "a,b",
    },
]

BUILD_FLAGS: FlagSpec[]: [
    FlagSpec {
        .name = "out",
        .alias = "o",
        .help = "Output path (`-` streams C to stdout)",
        .value_name = "path",
    },
    FlagSpec {
        .name = "emit",
        .alias = "e",
        .help = "What to produce",
        .value_name = "artefact",
        .default_text = "executable",
        .values = EMIT_VALUES,
    },
    // No `.values`: the target is a `<os>-<arch>` PAIR, not an enumeration —
    // spelling out five OSes times three architectures would be a worse help
    // text than the form itself. `vader/target::parse_target` validates it and
    // names the offending fragment.
    FlagSpec {
        .name = "target",
        .alias = "t",
        .help = "Platform to build for, as `<os>-<arch>`",
        .value_name = "os-arch",
        .default_text = "this machine",
    },
    FlagSpec {
        .name = "release",
        .kind = .Bool,
        .alias = "r",
        .help = "Optimise; default builds carry debug info",
    },
    FlagSpec {
        .name = "manifest",
        .kind = .Bool,
        .help = "Read vader.json instead of a single file (not yet implemented)",
    },
    FlagSpec {
        .name = "cc",
        .help = "Native only: C compiler to invoke",
        .value_name = "path",
        .default_text = "cc",
    },
    FlagSpec {
        .name = "ldflags",
        .help = "Native only: raw linker flags appended to the cc invocation",
        .value_name = "flags",
    },
    FlagSpec {
        .name = "include-paths",
        .help = "Extra module search roots (GCC -I style), highest precedence",
        .value_name = "a,b",
    },
    FlagSpec {
        .name = "parallel",
        .kind = .Int,
        .help = "Native only: compile the C across N parallel jobs",
        .value_name = "N",
        .default_text = "1",
    },
    FlagSpec {
        .name = "seed-targets",
        .help = "With --emit=c: emit split C for each target against one shared atom table",
        .value_name = "a,b",
    },
]

// The twelve IR stages. This array is the only list of them: `cmd_dump`
// dispatches on the name, but what is *accepted* — and what an unknown stage
// reports — comes from here.
DUMP_STAGES: ValueSpec[]: [
    ValueSpec { .name = "lexer", .help = "Token stream + diagnostics (text)" },
    ValueSpec { .name = "ast", .help = "Parser AST (JSON, spans elided)" },
    ValueSpec { .name = "resolved-ast", .help = "Per-module symbol table + import wiring" },
    ValueSpec { .name = "typed-ast", .help = "Per-decl + per-expression types" },
    ValueSpec { .name = "evaluated-ast", .help = "@comptime / @file values + generic instances" },
    ValueSpec {
        .name = "lowered-ast",
        .help = "Desugared tree (match / interpolation / defer expanded)",
    },
    ValueSpec { .name = "dced-ast", .help = "Lowered tree post reachability prune" },
    ValueSpec { .name = "targets", .help = "Which body each `@target` group selected" },
    ValueSpec { .name = "cfg", .help = "Mid-IR CFG (post DCE + escape annotation)" },
    ValueSpec { .name = "bytecode", .help = "Stack-machine ops + type/string/import tables" },
    ValueSpec { .name = "bytecode-cfg", .help = "Bytecode with CFG-level const-folding (text)" },
    ValueSpec { .name = "c", .help = "Generated C source" },
    ValueSpec { .name = "wasm", .help = "WebAssembly module (not yet implemented)" },
]

DUMP_FLAGS: FlagSpec[]: [
    FlagSpec {
        .name = "stage",
        .alias = "s",
        .help = "Which IR stage to dump",
        .value_name = "stage",
        .values = DUMP_STAGES,
    },
    FlagSpec {
        .name = "module",
        .help = "Scope the module-filtered dumps to these modules + submodules",
        .value_name = "a,b",
    },
    FlagSpec {
        .name = "target",
        .alias = "t",
        .help = "Platform to resolve `@target` against, as `<os>-<arch>`",
        .value_name = "os-arch",
        .default_text = "this machine",
    },
    FlagSpec {
        .name = "annotate",
        .kind = .Bool,
        .help = "bytecode only: resolve table indices inline as comments — a disassembly view, NOT re-parsable",
    },
]

// `fmt`'s two flags. They lived in `vader/fmt/cli.vader`'s own hand-rolled
// parser, which pushed any unrecognised token into the path list — so
// `vader fmt --nope dir/` reported `path not found: --nope` and exited 0.
FMT_FLAGS: FlagSpec[]: [
    FlagSpec {
        .name = "check",
        .kind = .Bool,
        .help = "Read-only; exit 1 if any file would change",
    },
    FlagSpec {
        .name = "stdout",
        .kind = .Bool,
        .help = "Write formatted output to stdout (single file)",
    },
]

// The three shapes a project's build can take, DEFAULT FIRST — this array is also
// what the interactive prompt offers, in this order, so the option under the
// cursor is the one a bare `vader new` would have taken anyway.
NEW_BUILD_SETUPS: ValueSpec[]: [
    ValueSpec {
        .name = "manifest",
        .help = "a `vader.json`, which makes the directory a module search root",
    },
    ValueSpec {
        .name = "driver",
        .help = "a `build.vader`, and the project drives its own build",
    },
    ValueSpec { .name = "none", .help = "no build file at all — a single program" },
]

NEW_FLAGS: FlagSpec[]: [
    FlagSpec {
        .name = "build",
        .help = "What describes this project's build",
        .value_name = "setup",
        .default_text = "manifest",
        .values = NEW_BUILD_SETUPS,
    },
    // On a terminal the ABSENCE of this flag is a question rather than a silent
    // no, so `--git=false` is how a script declines without being asked.
    FlagSpec {
        .name = "git",
        .kind = .Bool,
        .help = "Run `git init` too; on a terminal you are asked when it is omitted",
    },
]

// `doctor` probes the `cc` a build would invoke, so it takes the same override
// `build` does — checking a compiler other than the one you would pass is a
// check of nothing.
DOCTOR_FLAGS: FlagSpec[]: [
    FlagSpec {
        .name = "json",
        .kind = .Bool,
        .help = "Report as JSON, for CI and agents",
    },
    FlagSpec {
        .name = "cc",
        .help = "C compiler to probe",
        .value_name = "path",
        .default_text = "cc",
    },
]

/// Every action, in the order the help lists them.
///
/// `tail` states what an action does with positionals past the first, which is
/// what makes the argument boundary self-documenting: only `Forward` hands its
/// tail to another program, and it is the reason flags must precede the path.
export COMMANDS: CommandSpec[]: [
    CommandSpec {
        .name = "new",
        .summary = "Scaffold a project",
        .usage = "[name]",
        .flags = NEW_FLAGS,
        .tail = .None,
    },
    CommandSpec {
        .name = "run",
        .summary = "Compile and run a file on the VM",
        .usage = "<file> [program args...]",
        .flags = [],
        .tail = .Forward,
    },
    CommandSpec {
        .name = "build",
        .summary = "Compile a Vader source file",
        .usage = "<file>",
        .flags = BUILD_FLAGS,
        .tail = .None,
    },
    CommandSpec {
        .name = "fmt",
        .summary = "Format Vader sources in place",
        .usage = "[path]",
        .flags = FMT_FLAGS,
        .tail = .Paths,
    },
    CommandSpec {
        .name = "test",
        .summary = "Run @test functions",
        .usage = "[path]",
        .flags = [],
        .tail = .None,
    },
    CommandSpec {
        .name = "check",
        .summary = "Type-check without emitting — works for any target",
        .usage = "<file>",
        .flags = CHECK_FLAGS,
        .tail = .None,
    },
    CommandSpec {
        .name = "lint",
        .summary = "Project-wide lints kept out of the default build",
        .usage = "<file>",
        .flags = [],
        .tail = .None,
    },
    CommandSpec {
        .name = "dump",
        .summary = "Dump an IR stage",
        .usage = "<file>",
        .flags = DUMP_FLAGS,
        .tail = .None,
    },
    CommandSpec {
        .name = "lsp",
        .summary = "Run the Language Server (JSON-RPC over stdio)",
        .usage = "",
        .flags = Lsp.LSP_FLAGS,
        .tail = .None,
    },
    CommandSpec {
        .name = "dap",
        .summary = "Run the debug adapter (DAP over stdio)",
        .usage = "",
        .flags = [],
        .tail = .None,
    },
    CommandSpec {
        .name = "doctor",
        .summary = "Check the toolchain and the project here",
        .usage = "",
        .flags = DOCTOR_FLAGS,
        .tail = .None,
    },
    CommandSpec {
        .name = "help",
        .summary = "Show this message, or one action's options",
        .usage = "[action]",
        .flags = [],
        .tail = .None,
    },
    CommandSpec {
        .name = "version",
        .summary = "Show the compiler version",
        .usage = "",
        .flags = [],
        .tail = .None,
    },
]

/// Find an action by name.
///
/// @param name  the action as typed, e.g. `"build"`.
/// @return      its spec, or `null` when no action goes by that name.
export find_command :: fn(name: string) -> CommandSpec | null {
    for c in COMMANDS {
        if c.name == name {
            return c
        }
    }
    return null
}

/// The noun an action's positional argument goes by, read off its usage line.
///
/// `"<file>"` gives `file`, `"[name]"` gives `name`, `"[path]"` gives `path`, and
/// `""` — an action that takes no positional at all — gives `""`.
///
/// DERIVED rather than declared a second time: `usage` is already the one place
/// saying what an action's argument is, and a `noun` field beside it would be a
/// second place to keep in step. It is what lets one shared guard say "before the
/// file" for `build` and "before the name" for `new`.
///
/// @param cmd  the action.
/// @return     the bare noun, or `""` when the action takes no positional.
export positional_noun :: fn(cmd: CommandSpec) -> string {
    if cmd.usage == "" {
        return ""
    }
    head :: cmd.usage.split(" ")[0]
    return head.trim_prefix("<").trim_prefix("[").trim_suffix(">").trim_suffix("]")
}

/// An action's flags plus the common ones — what `std/cli::parse` is given.
///
/// Merged here rather than baked into each `COMMANDS` entry so the common set
/// stays visible as one list, and so the help can render the two blocks apart.
///
/// @param cmd  the action being parsed.
/// @return     the action's own flags first, then `COMMON_FLAGS`.
export command_specs :: fn(cmd: CommandSpec) -> FlagSpec[] = cmd.flags + COMMON_FLAGS

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_every_flag_is_documented :: fn() -> void {
    // There are no hidden flags: an empty `help` is a spec defect, since the
    // help renders straight from this table. Reserved flags say they are
    // reserved rather than carrying an empty description.
    for c in COMMANDS {
        for f in command_specs(c) {
            assert(f.help != "", "flag --${f.name} of `${c.name}` has no description")
        }
    }
}

@test test_valued_flags_name_their_value :: fn() -> void {
    // A flag taking a value must name it: without `value_name` it renders as
    // `--x=<value>`, which tells the reader nothing.
    //
    // This test does double duty now that `kind` defaults to `Str`. A `Bool`
    // declared by omission — `.kind = .Bool` forgotten — silently becomes a
    // `Str`, and would then demand a value and swallow the next token. It also
    // wouldn't have a `value_name`, so it trips here.
    for c in COMMANDS {
        for f in command_specs(c) {
            if f.kind == FlagKind.Bool {
                assert(f.value_name == "",
                    "--${f.name} of `${c.name}` is a Bool but names a value")
                continue
            }
            assert(f.value_name != "", "--${f.name} of `${c.name}` needs a value_name")
        }
    }
}

@test test_enumerated_values_are_documented :: fn() -> void {
    for c in COMMANDS {
        for f in command_specs(c) {
            for v in f.values {
                assert(v.help != "", "value `${v.name}` of --${f.name} has no description")
            }
        }
    }
}

@test test_aliases_are_unique_per_action :: fn() -> void {
    // Two flags of one action sharing an alias would make the shorter spelling
    // resolve to whichever came first in the array — a silent shadowing.
    for c in COMMANDS {
        specs :: command_specs(c)
        n :: specs.len()
        for i in 0..<n {
            if specs[i].alias == "" {
                continue
            }
            for j in i + 1..<n {
                assert(
                    specs[i].alias != specs[j].alias,
                    "`${c.name}`: --${specs[i].name} and --${specs[j].name} share alias -${specs[i].alias}",
                )
            }
        }
    }
}

@test test_positional_noun_reads_the_usage_line :: fn() -> void {
    // The noun the shared guard puts in its message. Deriving it is what keeps
    // one guard correct for every action instead of one copy per noun.
    for c in COMMANDS {
        noun :: positional_noun(c)
        assert(!(("[" in noun) || ("<" in noun)), "`${c.name}`: the brackets are stripped")
        assert(!(" " in noun), "`${c.name}`: the noun is one word")
    }
    build :: find_command("build")
    if build == null {
        assert(false, "`build` should be a known action")
        return
    }
    assert_eq(positional_noun(build), "file")
    lsp :: find_command("lsp")
    if lsp == null {
        assert(false, "`lsp` should be a known action")
        return
    }
    // An action with no usage tail takes no positional, and the guard reads that
    // as "reject the first one" rather than "name it".
    assert_eq(positional_noun(lsp), "")
}

@test test_find_command_hits_and_misses :: fn() -> void {
    build :: find_command("build")
    if build == null {
        assert(false, "`build` should be a known action")
        return
    }
    assert_eq(build.name, "build")
    assert(build.flags.len() > 0, "build carries its own flags")
    // `== null` rather than `assert_eq(…, null)`: the latter wants `Equals` on
    // the union and reaches for a host impl that isn't wired for `null`.
    assert(find_command("nope") == null, "an unknown action resolves to null")
}

@test test_run_is_the_only_forwarding_action :: fn() -> void {
    // The boundary's one asymmetry: only `run` hands its tail to another
    // program. If a second action ever forwards, the help and the "options must
    // come before the file" error both need to know.
    for c in COMMANDS {
        if c.tail == TailKind.Forward {
            assert_eq(c.name, "run")
        }
    }
}
