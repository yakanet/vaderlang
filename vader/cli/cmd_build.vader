// vader/cli/build — the `vader build` command.
//
// `--target=c` / `--target=native`, the monolithic and split paths, and the
// `cc` invocation for each. The shared pieces — front end, lower, bytecode,
// the C emit and the link — live in `vader/pipeline`; what stays here is the
// flag handling, the `.virt` input path, and the diagnostic rendering, none of
// which a build driver wants.
//
// Same module as `main.vader`: imports are file-scoped, declarations are not.

module "vader/cli"

import "std/collections"
import "std/io"
import "std/path"
import "std/string"
import "std/async"
import "cli"
import "std/process"
import "vader/parser"
import "vader/target"
import "vader/resolver"
import "vader/typecheck"
import "vader/lower"
import "vader/bytecode"
import "vader/vm"
import "vader/midir"
import "vader/pipeline"
import "vader/diagnostics"
import "vader/c_emit" { EmitOptions as CEmitOptions, default_emit_options as default_c_emit_options }
Prof :: import "vader/profile"

// ----------------------------------------------------------- build


// Split a comma-separated `--include-paths=a,b,c` flag value into a list (empty
// for an absent/empty flag). These prepend the module search order (GCC `-I`).
parse_include_path_flag :: fn(raw: string) -> string[] =
    if raw == "" { [] } else { raw.split(",") }

cmd_build :: fn(args: string[]) -> i32 {
    parsed :: parse_action("build", args)
    if parsed is i32 as code {
        return code
    }
    if reject_extra_positionals("build", parsed) {
        return 1
    }

    emit         :: parsed.string_flag("emit", "executable")
    target_flag  :: parsed.string_flag("target", "")
    use_manifest :: parsed.bool_flag("manifest")
    out_flag     :: parsed.string_flag("out", "")
    release      :: parsed.bool_flag("release")
    cc           :: parsed.string_flag("cc", "cc")
    ldflags      :: parsed.string_flag("ldflags", "")
    include_path_flags :: parse_include_path_flag(parsed.string_flag("include-paths", ""))

    // No target validation here: `--target`'s accepted set lives on its
    // `FlagSpec.values` in `spec.vader`, so the parser already rejected an
    // unknown one and named the alternatives.
    file :: action_file(parsed)
    // Split is the DEFAULT: one TU per module, compiled concurrently. `--no-split`
    // asks for the single monolithic TU, which is slower to compile and differs
    // from the split output only in ways nothing depends on any more.
    //
    // Two input shapes can only be served by the single TU, and they SELECT it
    // rather than being rejected: `--out=-` writes to stdout, which cannot
    // receive one file per module, and a `.virt` input carries a bytecode module
    // the split path has no front end to re-run. Neither is a user error — the
    // request names the only shape that can satisfy it.
    split :: !parsed.bool_flag("no-split")
        && out_flag != "-"
        && file.extension() != "virt"

    no_hooks :: parsed.bool_flag("no-hooks")
    root :: current_working_directory()
    driver :: if no_hooks { null } else { find_build_driver(root) }

    // No file: the project may drive its own build. A `build.vader` at the
    // invocation root takes over from here — it decides what to compile, since
    // the compiler is part of its own import closure. See `driver.vader`.
    if file == "" && !use_manifest {
        if driver != null {
            return run_build_driver(root, cc, ldflags)
        }
        eprintln("vader build: expected a file, --manifest (vader.json), or a `${DRIVER_FILENAME}` here")
        return 1
    }

    // A named file wins over the driver, and has to: `bootstrap/build.sh`
    // compiles the compiler by name, and could not depend on a driver to do it.
    // But silently skipping a project's own rules is worse than the extra line —
    // a house rule that stops applying the moment you name a file is a rule
    // nobody can trust. `--no-hooks` says "I know" and quiets this.
    if driver != null && file != "" {
        eprintln("vader build: `${DRIVER_FILENAME}` not applied — a named file bypasses it (use `vader build` alone, or --no-hooks to silence)")
    }

    if use_manifest {
        eprintln("vader build --emit=${emit}: --manifest mode not yet implemented")
        return 2
    }

    // Validated here rather than deeper, so a malformed target costs nothing:
    // `--target=native` (the old spelling) would otherwise be swallowed in
    // silence and the build would quietly produce something else.
    // `parse_target` names the offending fragment.
    build_target: Target | null = null
    if target_flag != "" {
        parsed_target :: parse_target(target_flag)
        if parsed_target is TargetParseError as e {
            eprintln("vader build --target=${target_flag}: ${e.reason} `${e.fragment}`")
            return 2
        }
        if parsed_target is Target as t { build_target = t }
    }

    // Read before the `--emit` branch so a seed request that cannot be honoured
    // is NAMED. Under the default `--emit=executable` it used to be dropped in
    // silence, and the build handed back one ordinary host binary.
    seed_flag :: parsed.string_flag("seed-targets", "")
    if seed_flag != "" && emit != "c" {
        eprintln("vader build: `--seed-targets` emits C for several targets — it needs `--emit=c`")
        return 2
    }
    if seed_flag != "" && target_flag != "" {
        eprintln("vader build: `--seed-targets` carries its own target list — drop `--target=${target_flag}`")
        return 2
    }

    if emit == "c" {
        if seed_flag != "" {
            // The seed set is split by construction — one unit per module, shared
            // across targets. `--no-split` cannot be honoured here, so say so
            // rather than accept and ignore it, as the two checks above do for
            // a wrong `--emit` and a redundant `--target`.
            if parsed.bool_flag("no-split") {
                eprintln("vader build: `--seed-targets` always emits split C — drop `--no-split`")
                return 2
            }
            ts :: parse_target_list(seed_flag)
            if ts.len() == 0 {
                return 2
            }
            out :: if out_flag != "" { out_flag.to_path() } else { strip_input_suffix(file) }
            return emit_c_for_targets(file, out, release, include_path_flags, ts)
        }
        return build_c(file, out_flag, release, include_path_flags, split, build_target)
    }
    if emit == "executable" {
        // 0: the user's own build owns the machine, so it keeps the full fan-out
        // the `--split` measurements were taken with.
        return build_native(file, out_flag, release, cc, ldflags, include_path_flags, split, build_target, 0)
    }

    if emit == "bytecode-text" {
        return build_bytecode_text(file, out_flag, include_path_flags, build_target)
    }
    // TODO: --emit=bytecode — the BINARY (.vir) module. `--emit=bytecode-text`
    // above covers the textual form; this one waits on a binary writer.
    // A wasm module is not an emit kind: it is `--emit=executable
    // --target=wasm32-browser`, and it waits on the wasm backend, not on this.
    eprintln("vader build --emit=${emit}: not yet implemented")
    return 2
}

/// `--emit=bytecode-text` — write the COMPLETE `.virt` module beside the input.
///
/// Distinct from `dump --stage=bytecode`, which is a VIEW of one module: this is
/// the whole linked image, every function it needs included, and it is what the
/// VM executes. The separation is the point — a dump narrows to what you are
/// reading, a build produces what actually runs.
///
/// @param file                entry source.
/// @param out_flag            `-o` value, or "" to derive `<input>.virt`.
/// @param include_path_flags  extra module search roots.
/// @param target              the platform to select `@target` bodies for.
/// @return                    0 on success, 1 on a write failure, 2 on a
///                            front-end error (already reported).
build_bytecode_text :: fn(
    file: Path, out_flag: string, include_path_flags: string[], target: Target | null,
) -> i32 {
    b :: prepare_cfg_bytecode_with(file, false, include_path_flags, target)
    // Same gate as every other emit path: errors abort, warnings still print.
    if !flush_build_diags(b.pre_diags, b.lower_diags) {
        return 2
    }
    out :: if out_flag != "" {
        out_flag.to_path()
    } else {
        "${strip_input_suffix(file)}.virt".to_path()
    }
    if write_out(out, dump_bytecode(b.module, b.entry)) != 0 {
        return 1
    }
    eprintln("vader build: wrote ${out}")
    return 0
}

// Lower `file` through the canonical CFG → bytecode → c_emit path (the same
// pipeline `dump --stage=c` uses) and return the generated C. Pipeline
// diagnostics go to stderr ; returns null when an error-severity diagnostic
// blocks the build, so the caller emits nothing and exits non-zero.
emit_c_source :: fn(file: Path, release: bool, include_path_flags: string[], target: Target | null) -> string | null {
    b :: prepared_module(file, release, include_path_flags, target)
    if b is null {
        return null
    }
    // Designate the program entry by mangled name (same source as the bytecode
    // stage's `export main N`) so the `main()` shim resolves the entry module's
    // `main` even when a multi-module input (the compiler imports `vader/lsp`,
    // which has its own `main`) flags several fns `is_main`.
    Prof.prof_begin(Prof.PHASE_CEMIT)
    c :: emit_c(b.module, CEmitOptions { .release = release, .entry_mangled = b.entry })
    Prof.prof_end(Prof.PHASE_CEMIT)
    // End of the compile pipeline — emit the per-pass profile (no-op unless
    // $VADER_PROFILE is set ; idempotent if the atexit fallback also fires).
    Prof.prof_dump()
    return c
}

// Front-end + lowering + bytecode for `file`, with build diagnostics flushed to
// stderr. Shared by the mono (`emit_c_source`) and split (`build_native_split`)
// paths. Debug build → populate the per-op `debug` table so the c-emit keeps
// `#line` ; release drops it (the seed + shipped compiler stay lean). Returns
// null when an error-severity diagnostic blocks the build.
prepared_module :: fn(file: Path, release: bool, include_path_flags: string[], target: Target | null) -> CfgBytecode | null {
    b :: prepare_cfg_bytecode_with(file, !release, include_path_flags, target)
    if !flush_build_diags(b.pre_diags, b.lower_diags) {
        return null
    }
    return b
}

// Render the merged pipeline diagnostics to stderr and report whether the
// build may proceed : any error-severity diagnostic aborts the build
// (return false) ; warnings / info still print.
flush_build_diags :: fn(pre: Diagnostic[], lower: Diagnostic[]) -> bool {
    all :: merge_diagnostics(pre, lower)
    if all.len() > 0 {
        eprintln(all.dump_diagnostics_with_file())
    }
    return !any_error_diag(all)
}

// `--target=c` : write the generated C to `--out` (default `<file>.c`).
// `--out=-` streams it to stdout, for piping into another tool.
build_c :: fn(file: Path, out_flag: string, release: bool, include_path_flags: string[], split: bool, target: Target | null) -> i32 {
    if split {
        out :: if out_flag != "" { out_flag.to_path() } else { strip_input_suffix(file) }
        prog :: emit_c_program_for(file, release, include_path_flags, out, target) ?? return 1
        return write_split_files(out, prog)
    }
    c_src :: emit_c_for_input(file, release, include_path_flags, target) ?? return 1
    if out_flag == "-" {
        print(c_src)
        return 0
    }
    out :: if out_flag != "" {
        out_flag.to_path()
    } else {
        "${strip_input_suffix(file)}.c".to_path()
    }
    return write_out(out, c_src)
}

// Emit C from either a `.vader` source (full front end) or a `.virt` text
// bytecode dump (`parse_virt_bc` → `emit_c`). A `.virt` input skips the
// lexer/parser/typer/lower/emit pipeline — the bytecode already exists.
emit_c_for_input :: fn(file: Path, release: bool, include_path_flags: string[], target: Target | null) -> string | null =
    if file.extension() == "virt" {
        emit_c_source_from_virt(file, release)
    } else {
        emit_c_source(file, release, include_path_flags, target)
    }

// Read a `.virt` text dump, reconstruct its `BytecodeModule`, and hand it to
// the C-emit. The entry fn is the module's `is_main` function (recovered from
// the dump's `export main N` directive).
emit_c_source_from_virt :: fn(file: Path, release: bool) -> string | null {
    src :: read_file_string(file.as_string())
    if src is IOError {
        eprintln("vader build: cannot read ${file}")
        return null
    }
    module :: parse_virt_bc(src)
    if module is VirtParseError as e {
        eprintln(e.display_virt_parse_error("vader build", file.as_string()))
        return null
    }
    return emit_c(module, CEmitOptions {
        .release = release,
        .entry_mangled = virt_entry_mangled(module),
    })
}

// Mangled name of the entry fn (the `is_main` function), or `""` when none.
virt_entry_mangled :: fn(module: BytecodeModule) -> string {
    for f in module.functions {
        if f.is_main {
            return f.name
        }
    }
    return ""
}

// `--target=native` : emit the C next to the binary, then invoke the C
// compiler to link it against the external runtime (`runtime/c/`). The `.c`
// is kept on a `cc` failure so the user can inspect the generated source.
build_native :: fn(file: Path, out_flag: string, release: bool, cc: string, ldflags: string, include_path_flags: string[], split: bool, target: Target | null, cc_jobs: i32) -> i32 {
    out :: if out_flag != "" { out_flag.to_path() } else { strip_input_suffix(file) }
    if split {
        return build_native_split(file, out, release, cc, ldflags, include_path_flags, target, cc_jobs)
    }
    // The CLI keeps its own C emission — it handles a `.virt` input and prints
    // diagnostics through `flush_build_diags` — but the LINK is shared with
    // `vader/pipeline`, so the two cannot drift on flags.
    c_src :: emit_c_for_input(file, release, include_path_flags, target)
    if c_src is null {
        return 1
    }
    return link_native(c_src, out, cc, release, ldflags, "")
}

// ----------------------------------------------------------- split build

// `--split --emit=executable` : emit the program as a header + globals TU + one
// function TU per Vader module, then compile them concurrently and link. The
// `.c` set is kept on failure for inspection.
build_native_split :: fn(file: Path, out: Path, release: bool, cc: string, ldflags: string, include_path_flags: string[], target: Target | null, cc_jobs: i32) -> i32 {
    prog :: emit_c_program_for(file, release, include_path_flags, out, target)
    if prog is null {
        return 1
    }
    if write_split_files(out, prog) != 0 {
        return 1
    }
    c_files :: split_c_files(out, prog.unit_names)
    rt :: runtime_c_root()

    // Splitting is what makes the compiles parallel, and it is also what stops
    // `cc` inlining across the cut — a definition another TU may call has to be
    // emitted as written. ThinLTO gives that back: the per-unit compiles stay
    // parallel, the link reads only summaries, and the optimisation that
    // follows imports across units. It brings the bench back to a monolithic
    // build's numbers — several workloads past it — for a few seconds of link,
    // where full LTO would serialise the whole optimisation instead.
    //
    // The worst case without it was a byte-scan loop whose per-byte read stayed
    // an out-of-line call, so the loop never vectorised.
    flavour :: cc_flavour(cc)

    // One `cc -c` per TU (+ the runtime), spawned concurrently so the OS
    // compiles them across cores. `all` joins a wave ; `block_on` drives the
    // cooperative scheduler from this synchronous entry.
    //
    // `cc_jobs` bounds how many run at once, 0 meaning no bound. It exists for
    // the case where the MACHINE, not this build, is the scarce resource — see
    // `DRIVER_CC_JOBS` at the driver's call site. A bound turns one wave into
    // ceil(n / cc_jobs) waves, each as long as its slowest unit, so it costs
    // some parallelism; that is why the user's own `--split` passes 0.
    argvs: string[][]! = []
    obj_files: string[]! = []
    for cf in c_files {
        obj :: "${cf}.o"
        obj_files.push(obj)
        argvs.push(cc_compile_argv(cc, cf.as_string(), obj, rt, release, flavour))
    }
    rt_obj :: "${out}.split.runtime.o"
    obj_files.push(rt_obj)
    argvs.push(cc_compile_argv(cc, "${rt}/vader_runtime.c", rt_obj, rt, release, flavour))

    wave :: if cc_jobs > 0 { usize(cc_jobs) } else { argvs.len() }
    results: (ProcessResult | ProcessError)[]! = []
    start: usize = 0
    for start < argvs.len() {
        stop :: if start + wave < argvs.len() { start + wave } else { argvs.len() }
        tasks: Async<ProcessResult | ProcessError>[]! = []
        for k in start..<stop {
            tasks.push(spawn_async(argvs[k]))
        }
        results.push_all(block_on(all(tasks)))
        start = stop
    }
    for r in results {
        if r is ProcessError as e {
            eprintln("vader build: ${e.message()}")
            eprintln("(generated C kept at ${out}.split.*.c)")
            return 1
        } else if r is ProcessResult as pr {
            if pr.exit != 0 {
                eprintln("vader build: ${cc} -c failed (exit ${pr.exit})")
                eprintln(pr.stderr)
                eprintln("(generated C kept at ${out}.split.*.c)")
                return 1
            }
        }
    }

    // Link the objects into the final binary (link is inherently serial).
    lres :: spawn(cc_link_argv(cc, obj_files, out, ldflags, release, flavour))
    if lres is ProcessError {
        eprintln("vader build: ${lres.message()}")
        return 1
    }
    if lres.exit != 0 {
        eprintln("vader build: ${cc} link failed (exit ${lres.exit})")
        eprintln(lres.stderr)
        return 1
    }
    eprintln("vader build: wrote ${out} (split: ${obj_files.len()} objects compiled in parallel)")
    return 0
}

// Prepare the module and emit it as a `CProgram`. The header basename embeds a
// `.split.` infix so it never collides with the runtime's `vader.h` when
// `--out` basename is `vader`. Null on a front-end error or `.virt` input.
emit_c_program_for :: fn(file: Path, release: bool, include_path_flags: string[], out: Path, target: Target | null) -> CProgram | null {
    // UNREACHABLE from the CLI: `split` (line 72) already excludes a `.virt`, and
    // both callers gate on it. Kept as the guard for a future third caller that
    // does not — the rule "a `.virt` has no front end to re-run" belongs next to
    // the code that would re-run it, not only in the flag computation.
    if file.extension() == "virt" {
        eprintln("vader build: split needs a `.vader` front end; `.virt` takes the single TU")
        return null
    }
    b :: prepared_module(file, release, include_path_flags, target)
    if b is null {
        return null
    }
    // The `#include` name is the header's basename (split TUs sit next to it) —
    // `filename` via `to_posix` also handles `\` on Windows.
    header_name :: "${canonicalise(out).filename()}.split.h"
    return emit_c_split(b.module, CEmitOptions { .release = release, .entry_mangled = b.entry }, header_name)
}

// Each module's per-index type keys — the shared input to the union and to
// every rebase.
keys_of_each :: fn(mods: BytecodeModule[]) -> string[][] {
    out: string[][]! = []
    for m in mods {
        out.push(type_keys_of(m))
    }
    return out
}

/// Emit the split C for SEVERAL targets against one shared atom universe.
///
/// The seed's shape. Atom ids are positions, so each target's own literal pool
/// numbers them differently and every file ends up differing by renumbering
/// alone — measured at 7026 renumbered lines against 2 of real content. Unioning
/// the pools first makes the ids agree, so the emitted C differs only where the
/// code does.
///
/// The union is SORTED rather than first-seen: the ids must not depend on the
/// order the targets were listed in.
///
/// @param file                the entry source.
/// @param out                 output stem. Units every target agreed on are
///                            written once as `<out>-<module>.c`; the ones that
///                            differ go to `<out>.<os>-<arch>-<module>.c`,
///                            beside the shared `<out>.split.h` / `.split.g.c`.
/// @param release             build at `-O3`; threaded through to each target's
///                            front end, since it changes the bytecode.
/// @param include_path_flags  `-I`-style module roots, as passed on the command
///                            line — the same set for every target.
/// @param targets             the targets to emit for, at least one.
/// @return                    0 on success, 1 when any target fails to build.
emit_c_for_targets :: fn(
    file: Path, out: Path, release: bool, include_path_flags: string[], targets: Target[],
) -> i32 {
    mods: CfgBytecode[]! = []
    for t in targets {
        b :: prepared_module(file, release, include_path_flags, t)
        if b is null {
            return 1
        }
        mods.push(b)
    }
    universe :: union_of_string_pools(mods)
    // The type table needs the same treatment as the atom table, and for the
    // same reason: it is index-addressed, so one extra type on one target shifts
    // every slot after it. Measured without this, from a single lambda in a
    // `@target` body: 11 282 renumbered lines against 238 of real content, and
    // shared units fell from 37 to 7.
    // Keyed ONCE per module, then reused by the union and by every rebase —
    // `bc_type_key` recurses through composite types, so re-deriving it per pass
    // re-walks that graph for every target.
    type_keys :: keys_of_each(modules_of(mods))
    type_universe :: union_of_type_tables(type_keys)
    // ONE header name for every target. It holds the struct typedefs, the
    // prototypes and the atom count — all identical once the universe is shared
    // — so per-target copies would differ in nothing but their own `#include`
    // line, which is what a first attempt produced: 39 files "differing" on
    // line 1 alone.
    header_name :: "${canonicalise(out).filename()}.split.h"
    progs: CProgram[]! = []
    for i in 0..<targets.len() {
        // A literal a target holds but the universe does not means the pools were
        // unioned after something already emitted. Left unchecked it is a SILENT
        // atom alias — the id lands on whatever sits at that slot — so it is
        // named here instead.
        gaps :: atom_universe_gaps(mods[i].module.strings, universe)
        if gaps.len() > 0 {
            eprintln("vader build: atom universe misses ${gaps.len()} literal(s) for ${targets[i]}, first `${gaps[0]}`")
            return 1
        }
        progs.push(
            emit_c_split(
                rebase_types(mods[i].module, type_keys[i], type_universe),
                CEmitOptions {
                    .release = release, .entry_mangled = mods[i].entry, .atom_universe = universe,
                },
                header_name,
            ),
        )
    }
    return write_deduplicated(out, targets, progs)
}

// Write the programs with everything identical stored ONCE.
//
// A unit is shared when every target emitted the same bytes for it, and only
// then; the rest go under `<out>.<os>-<arch>.split.<k>.c`. Which units differ is
// data, not a rule — with one `@target` body in the closure it was exactly one
// out of 39, 28 KB against 11.3 MB.
write_deduplicated :: fn(out: Path, targets: Target[], progs: CProgram[]) -> i32 {
    first :: progs[0]
    for i in 1..<progs.len() {
        // The targets must agree on WHICH modules exist, name by name — a
        // count alone would pass when one module replaced another.
        if !same_unit_names(progs[i].unit_names, first.unit_names) {
            eprintln("vader build --seed-targets: `${display_target(targets[i])}` and "
                + "`${display_target(targets[0])}` emitted different module sets")
            return 1
        }
    }
    // The shared header must be identical across targets, and now can be: the
    // `@extern` declarations and their shims — measured as the ONLY part a
    // target changes — live in their own header, written below. Anything else
    // diverging is a genuine surprise and has to stop the build, since taking
    // target 0's on faith would compile the others against declarations that
    // are not theirs and surface as a link error far from here.
    if !all_equal(headers_of(progs)) {
        eprintln("vader build --seed-targets: the targets emitted different SHARED headers, "
            + "which only the imports header is expected to carry")
        return 1
    }
    if write_out("${out}.split.h".to_path(), first.header) != 0 {
        return 1
    }
    // The imports header keeps a fixed NAME, so the units never mention a
    // target. When the targets agree it sits beside the shared header; when
    // they do not, each goes in a directory of its own and the build puts the
    // right one first on the include path.
    if all_equal(imports_of(progs)) {
        if write_out(imports_header_path(out), first.imports) != 0 {
            return 1
        }
    } else {
        for i in 0..<targets.len() {
            dir :: "${out.parent()}/${display_target(targets[i])}"
            mk :: create_dir(dir)
            if mk is IOError as e {
                eprintln("vader build --seed-targets: cannot create `${dir}`: ${e.message()}")
                return 1
            }
            name :: imports_header_name("${canonicalise(out).filename()}.split.h")
            if write_out("${dir}/${name}".to_path(), progs[i].imports) != 0 {
                return 1
            }
        }
    }
    if all_equal(globals_of(progs)) {
        if write_out("${out}.split.g.c".to_path(), first.globals) != 0 {
            return 1
        }
    } else {
        for i in 0..<targets.len() {
            // Through `unit_path`, not a second spelling of the rule: the build
            // scripts glob per-target files as `<stem>.<target>-*.c`, and the
            // `.split.g.c` form this used to write matched neither that nor the
            // shared-globals line. Masked today because every target's globals
            // are identical, so this branch never runs — and it would have
            // surfaced as a missing symbol at link time, far from the cause.
            if write_out(unit_path(out, display_target(targets[i]), GLOBALS_UNIT), progs[i].globals) != 0 {
                return 1
            }
        }
    }
    for k in 0..<first.units.len() {
        col: string[]! = []
        for pr in progs {
            col.push(pr.units[k])
        }
        name :: first.unit_names[k]
        if all_equal(col) {
            if write_out(unit_path(out, "", name), first.units[k]) != 0 {
                return 1
            }
        } else {
            for i in 0..<targets.len() {
                if write_out(unit_path(out, display_target(targets[i]), name), progs[i].units[k]) != 0 {
                    return 1
                }
            }
        }
    }
    return 0
}

headers_of :: fn(progs: CProgram[]) -> string[] {
    out: string[]! = []
    for pr in progs {
        out.push(pr.header)
    }
    return out
}

imports_of :: fn(progs: CProgram[]) -> string[] {
    out: string[]! = []
    for pr in progs {
        out.push(pr.imports)
    }
    return out
}

globals_of :: fn(progs: CProgram[]) -> string[] {
    out: string[]! = []
    for pr in progs {
        out.push(pr.globals)
    }
    return out
}

same_unit_names :: fn(a: string[], b: string[]) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0..<a.len() {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

all_equal :: fn(xs: string[]) -> bool {
    for i in 1..<xs.len() {
        if xs[i] != xs[0] {
            return false
        }
    }
    return true
}

// `<os>-<arch>,<os>-<arch>,…`. EMPTY on failure, after naming the offending
// fragment — a union return would distribute the `!` marker onto the element
// type, and an empty list is already the only invalid answer.
parse_target_list :: fn(spec: string) -> Target[] {
    out: Target[]! = []
    for part in spec.split(",") {
        if part == "" {
            continue
        }
        parsed :: parse_target(part)
        if parsed is TargetParseError as e {
            eprintln("vader build --seed-targets: ${e.reason} `${e.fragment}`")
            return []
        }
        if parsed is Target as t {
            out.push(t)
        }
    }
    if out.len() == 0 {
        eprintln("vader build --seed-targets: no target named")
    }
    return out
}

modules_of :: fn(mods: CfgBytecode[]) -> BytecodeModule[] {
    out: BytecodeModule[]! = []
    for m in mods {
        out.push(m.module)
    }
    return out
}

// Every non-empty literal any target uses, sorted. Sorted and not first-seen so
// the ids are a property of the SET, not of the order the targets were given.
union_of_string_pools :: fn(mods: CfgBytecode[]) -> string[] {
    seen: MutableSet<string>! = MutableSet<string> {}
    out: string[]! = []
    for m in mods {
        for s in m.module.strings {
            if s != "" && !seen.contains(s) {
                seen.add(s)
                out.push(s)
            }
        }
    }
    return sort(out, (a: string, b: string) -> compare_ascending(a, b))
}

// Path of the imports header beside `out`, under the FIXED name the shared
// header includes. A per-target build writes it into its own directory instead
// (see `write_deduplicated`), and the compile adds that directory ahead of the
// shared one on the include path.
//
// Built from `out` the same way `${out}.split.h` is, NOT from `out.parent()`:
// a bare `out` with no directory part yielded an empty parent and an absolute
// `/p.imports.h`, which only showed up on Windows — every test here had run
// with a directory in the path.
imports_header_path :: fn(out: Path) -> Path = "${out}${IMPORTS_HEADER_SUFFIX}".to_path()

// Write the split program : `<out>.split.h`, `<out>.split.g.c`, and
// `<out>.split.<k>.c` for each function unit. All co-located so each TU's
// `#include "<base>.split.h"` resolves relative to its own directory.
write_split_files :: fn(out: Path, prog: CProgram) -> i32 {
    if write_out("${out}.split.h".to_path(), prog.header) != 0 { return 1 }
    if write_out(imports_header_path(out), prog.imports) != 0 { return 1 }
    if write_out("${out}.split.g.c".to_path(), prog.globals) != 0 { return 1 }
    for k in 0..<prog.units.len() {
        if write_out(unit_path(out, "", prog.unit_names[k]), prog.units[k]) != 0 { return 1 }
    }
    return 0
}

// The `.c` files to compile : the globals TU + each function TU (the header is
// included, not compiled).
split_c_files :: fn(out: Path, unit_names: string[]) -> Path[] {
    files: Path[]! = ["${out}.split.g.c".to_path()]
    for n in unit_names {
        files.push(unit_path(out, "", n))
    }
    return files
}

// `<out>-<module>.c`, or `<out>.<target>-<module>.c` when the unit is
// target-specific. Named by MODULE and not by index: an index shifts every
// later unit the moment a module is added, which renames and rewrites files
// whose contents did not change — the same renumbering the atom table used to
// do, one level up.
unit_path :: fn(out: Path, target: string, unit: string) -> Path =
    if target == "" {
        "${out}-${unit}.c".to_path()
    } else {
        "${out}.${target}-${unit}.c".to_path()
    }

// `cc -c <src> -o <obj>` for one split TU (or the runtime). Same optimisation
// flags as the monolithic `cc_argv`, plus `-I <runtime>` so `#include "vader.h"`
// and the co-located split header resolve. One of these runs per object, in
// parallel.
cc_compile_argv :: fn(
    cc: string, src: string, obj: string, rt: string, release: bool, flavour: CcFlavour,
) -> string[] {
    argv: string[]! = [cc]
    argv.push_all(cc_opt_flags(release))
    argv.push_all(lto_flags(flavour, release, false))
    argv.push("-I")
    argv.push(rt)
    argv.push("-c")
    argv.push(src)
    argv.push("-o")
    argv.push(obj)
    return argv
}


/// Probe `cc --version`, once per build.
///
/// Order matters: a clang banner does not say "gcc", but a GCC one may be
/// spelled `cc (GCC) 14.2.0`, so clang is tested first and the GCC test is
/// case-insensitive.
///
/// @param cc  the C compiler this build invokes.
/// @return    the toolchain family, `Unknown` when the probe fails.
cc_flavour :: fn(cc: string) -> CcFlavour {
    r :: spawn([cc, "--version"])
    if r is ProcessError {
        return .Unknown
    }
    if r.exit != 0 {
        return .Unknown
    }
    banner :: r.stdout.to_lower()
    if "clang" in banner {
        return .Clang
    }
    if "gcc" in banner || "free software foundation" in banner {
        return .Gcc
    }
    return .Unknown
}

// (a no-op on macOS / MinGW).
cc_link_argv :: fn(
    cc: string, objs: string[], out: Path, ldflags: string, release: bool, flavour: CcFlavour,
) -> string[] {
    argv: string[]! = [cc]
    argv.push_all(lto_flags(flavour, release, true))
    argv.push_all(objs)
    push_ldflags(argv, ldflags)
    argv.push("-o")
    argv.push(out.as_string())
    argv.push_all(export_dynamic_flags())
    argv.push("-lm")
    return argv
}
