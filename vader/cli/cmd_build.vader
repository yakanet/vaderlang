// vader/cli/build — the `vader build` command.
//
// `--emit=c` / `--emit=executable`, the monolithic and split paths, and the
// `cc` invocation for each. The shared pieces — front end, lower, bytecode,
// the C emit and the link — live in `vader/pipeline`; what stays here is the
// flag handling, the `.virt` input path, and the diagnostic rendering, none of
// which a build driver wants.
//
// Same module as `main.vader`: imports are file-scoped, declarations are not.

module "vader/cli"

import "std/collections"
import "std/io"
import "std/iter"
import "std/path"
import "std/string"
import "std/async"
import "cli"
import "std/process"
import "vader/parser"
import "vader/target"
import "vader/resolver"
import "vader/typecheck"
import "vader/lower"
import "vader/bytecode"
import "vader/vm"
import "vader/midir"
import "vader/pipeline"
import "vader/diagnostics"
import "vader/c_emit" { EmitOptions as CEmitOptions }
Prof :: import "vader/profile"
import "std/sort"

// ----------------------------------------------------------- build


// Split a comma-separated `--include-paths=a,b,c` flag value into a list (empty
// for an absent/empty flag). These prepend the module search order (GCC `-I`).
parse_include_path_flag :: fn(raw: string) -> string[] =
    if raw == "" { [] } else { raw.split(",") }

// What a `vader build` asks for, read once from its flags. A project build
// hands one to each of its entries.
BuildRequest :: struct {
    emit:          string = "executable"
    /// `--out`, or `""` to derive the output from the entry.
    out:           string = ""
    release:       bool = false
    verify:        bool = false
    cc:            string
    ldflags:       string = ""
    include_paths: string[] = []
    target:        Target | null = null
    /// `--seed-targets`, empty without it.
    seed_targets:  Target[] = []
    no_split:      bool = false
    /// The project the entry belongs to, null for a file compiled on its own
    /// (`search_roots`).
    project_root:  string | null = null
}

cmd_build :: fn(args: string[]) -> i32 {
    parsed :: parse_action("build", args)
    if parsed is i32 {
        return parsed
    }
    if reject_extra_positionals("build", parsed) {
        return 1
    }

    // `--target` is validated here rather than deeper, so a malformed target
    // costs nothing: `--target=native` (the old spelling) would otherwise be
    // swallowed in silence and the build would quietly produce something else.
    // `parse_target` names the offending fragment.
    target_flag :: parsed.string_flag("target", "")
    emit :: parsed.string_flag("emit", "executable")
    build_target: Target | null = null
    if target_flag != "" {
        parsed_target :: parse_target(target_flag)
        if parsed_target is TargetParseError {
            eprintln("vader build --target=${target_flag}: ${parsed_target.reason} "
                + "`${parsed_target.fragment}`")
            return 2
        }
        if parsed_target is Target { build_target = parsed_target }
    }

    // Read before the `--emit` branch so a seed request that cannot be honoured
    // is NAMED. Under the default `--emit=executable` it used to be dropped in
    // silence, and the build handed back one ordinary host binary.
    seed_flag :: parsed.string_flag("seed-targets", "")
    if seed_flag != "" && emit != "c" {
        eprintln("vader build: `--seed-targets` emits C for several targets — it needs `--emit=c`")
        return 2
    }
    if seed_flag != "" && target_flag != "" {
        eprintln("vader build: `--seed-targets` carries its own target list — drop `--target=${target_flag}`")
        return 2
    }
    no_split :: parsed.bool_flag("no-split")
    seed_targets :: seed_target_list(seed_flag, no_split) ?? return 2

    request :: BuildRequest {
        .emit = emit,
        .out = parsed.string_flag("out", ""),
        .release = parsed.bool_flag("release"),
        .verify = parsed.bool_flag("verify"),
        .cc = parsed.string_flag("cc", default_cc()),
        .ldflags = parsed.string_flag("ldflags", ""),
        .include_paths = parse_include_path_flag(parsed.string_flag("include-paths", "")),
        .target = build_target,
        .seed_targets = seed_targets,
        .no_split = no_split,
    }
    // No argument is the current folder: a project, described by its
    // `build.vader` or its `vader.json`.
    selected :: parsed.string_flag("entry", "")
    input :: resolve_input("build", action_input(parsed), selected)
    if input is i32 {
        return input
    }
    no_hooks :: parsed.bool_flag("no-hooks")
    match input {
        is FileInput -> {
            // A named file bypasses the driver of the folder the build runs in,
            // and has to: `bootstrap/build.sh` compiles the compiler by name, and
            // could not depend on a driver to do it. But silently skipping a
            // project's own rules is worse than the extra line — a house rule
            // that stops applying the moment you name a file is a rule nobody
            // can trust. `--no-hooks` says "I know" and quiets this.
            if !no_hooks && find_build_driver(current_working_directory()) != null {
                eprintln("vader build: `${DRIVER_FILENAME}` not applied — a named file bypasses it (use `vader build` alone, or --no-hooks to silence)")
            }
            return build_file(input.file, strip_input_suffix(input.file), request)
        }
        is ManifestProject -> { return build_entries(input, request) }
        is DrivenProject -> {
            if no_hooks {
                eprintln("vader build: `--no-hooks` ignores the `${DRIVER_FILENAME}` of `${input.dir}`, "
                    + "which leaves nothing to build; name the entry file instead")
                return 1
            }
            if refuse_unforwarded_flags("build", parsed, DRIVEN_BUILD_REFUSES) {
                return 2
            }
            driver_request :: DriverRequest {
                .release = request.release,
                .selected = selected,
                .cc = request.cc,
                .ldflags = request.ldflags,
            }
            return run_build_driver("build", input.dir, driver_request)
        }
    }
}

// The flags of `vader build` a `build.vader` does not receive.
DRIVEN_BUILD_REFUSES :: ["out", "target", "emit", "no-split", "verify", "include-paths", "seed-targets"]

// The targets `--seed-targets` lists, empty without it, or null after saying
// why the list cannot be honoured: the seed set is split by construction, one
// unit per module shared across targets, so `--no-split` is refused rather than
// accepted and ignored.
seed_target_list :: fn(seed_flag: string, no_split: bool) -> Target[] | null {
    if seed_flag == "" {
        return []
    }
    if no_split {
        eprintln("vader build: `--seed-targets` always emits split C — drop `--no-split`")
        return null
    }
    return parse_target_list(seed_flag)
}

// The output a file builds to without `--out`: its path minus `.vader`, or minus
// `.virt` for a bytecode dump.
strip_input_suffix :: fn(file: Path) -> Path =
    if file.extension() == "virt" {
        file.as_string().trim_suffix(".virt").to_path()
    } else {
        file.as_string().trim_suffix(".vader").to_path()
    }

// Build the entries of a `vader.json` project into `build/<profile>-<target>/`,
// then copy its assets beside the binaries.
build_entries :: fn(project: ManifestProject, request: BuildRequest) -> i32 {
    if request.out != "" && sole_entry("build", project.dir, project.entries, "`--out` names one output") == null {
        return 2
    }
    output_dir :: project_output_dir(project.dir, request.release, request.target)
    binaries :: binary_folder(request.out, output_dir)
    if !ensure_dir(binaries) {
        return 1
    }
    in_project :: BuildRequest { ...request, .project_root = project.dir }
    for entry in project.entries {
        code :: build_file(entry.file, Path(join_path(output_dir, entry.name)), in_project)
        if code != 0 {
            return code
        }
    }
    // The assets a program reads beside itself, so only a binary needs them.
    if request.emit == "executable" && !copy_assets(project.dir, project.assets, binaries) {
        return 1
    }
    return 0
}

// The folder a project build writes its binaries to: that of `--out` when
// `out_flag` names one, else `output_dir`.
binary_folder :: fn(out_flag: string, output_dir: string) -> string {
    if out_flag != "" {
        return folder_of(Path(out_flag))
    }
    return output_dir
}

// What an artefact is written to: `--out` when `out_flag` names it, else the
// path derived from the entry.
output_path :: fn(out_flag: string, derived: Path) -> Path {
    if out_flag != "" {
        return out_flag.to_path()
    }
    return derived
}

// Build one entry file as `request` asks. `stem` is what its outputs are named
// after without `--out`: the entry without its extension for a file, the
// entry's name in the output folder for a project.
build_file :: fn(file: Path, stem: Path, request: BuildRequest) -> i32 {
    // Split is the DEFAULT: one TU per module, compiled concurrently. `--no-split`
    // asks for the single monolithic TU, which is slower to compile and differs
    // from the split output only in ways nothing depends on any more.
    //
    // Two input shapes can only be served by the single TU, and they SELECT it
    // rather than being rejected: `--out=-` writes to stdout, which cannot
    // receive one file per module, and a `.virt` input carries a bytecode module
    // the split path has no front end to re-run. Neither is a user error — the
    // request names the only shape that can satisfy it.
    split :: !request.no_split
        && request.out != "-"
        && file.extension() != "virt"

    if request.emit == "c" {
        if request.seed_targets.len() > 0 {
            out :: output_path(request.out, stem)
            return emit_c_for_targets(file, out, request)
        }
        return build_c(file, stem, request, split)
    }
    if request.emit == "executable" {
        // 0: the user's own build owns the machine, so it keeps the full fan-out
        // the `--split` measurements were taken with.
        out :: output_path(request.out, stem)
        return build_native(file, out, request, split, 0)
    }

    if request.emit == "bytecode-text" {
        out :: output_path(request.out, "${stem}.virt".to_path())
        return build_bytecode_text(file, out, request)
    }
    // TODO: --emit=bytecode — the BINARY (.vir) module. `--emit=bytecode-text`
    // above covers the textual form; this one waits on a binary writer.
    eprintln("vader build --emit=${request.emit}: not yet implemented")
    return 2
}

/// `--emit=bytecode-text` — write the COMPLETE `.virt` module beside the input.
///
/// Distinct from `dump --stage=bytecode`, which is a VIEW of one module: this is
/// the whole linked image, every function it needs included, and it is what the
/// VM executes. The separation is the point — a dump narrows to what you are
/// reading, a build produces what actually runs.
///
/// @param file     entry source.
/// @param out      the `.virt` to write.
/// @param request  the search roots, the target and `--verify`.
/// @return         0 on success, 1 on a write failure, 2 on a front-end error
///                 (already reported).
build_bytecode_text :: fn(file: Path, out: Path, request: BuildRequest) -> i32 {
    b :: prepare_cfg_bytecode_with(
        file, false, request.include_paths, request.project_root, request.target, request.verify,
    )
    // Same gate as every other emit path: errors abort, warnings still print.
    if !ready_to_emit(b, "build", file) {
        return 2
    }
    if write_out(out, dump_bytecode(b.module, b.entry)) != 0 {
        return 1
    }
    eprintln("vader build: wrote ${out}")
    return 0
}

// Lower `file` through the canonical CFG → bytecode → c_emit path (the same
// pipeline `dump --stage=c` uses) and return the generated C. Pipeline
// diagnostics go to stderr ; returns null when an error-severity diagnostic
// blocks the build, so the caller emits nothing and exits non-zero.
emit_c_source :: fn(file: Path, request: BuildRequest) -> string | null {
    b :: prepared_module(file, request) ?? return null
    return emit_c_of(b)
}

// The single-TU C of a prepared program.
emit_c_of :: fn(b: CfgBytecode) -> string {
    // Designate the program entry by mangled name (same source as the bytecode
    // stage's `export main N`) so the `main()` shim resolves the entry module's
    // `main` even when a multi-module input (the compiler imports `vader/lsp`,
    // which has its own `main`) flags several fns `is_main`.
    Prof.prof_begin(.CEmit)
    c :: emit_c(b.module, native_c_options(b.entry))
    Prof.prof_end(.CEmit)
    // End of the compile pipeline — emit the per-pass profile (no-op unless
    // $VADER_PROFILE is set ; idempotent if the atexit fallback also fires).
    Prof.prof_dump()
    return c
}

// Front-end + lowering + bytecode for `file`, with build diagnostics flushed to
// stderr. Shared by the mono (`emit_c_source`) and split (`build_native_split`)
// paths. Debug build → populate the per-op `debug` table so the c-emit keeps
// `#line` ; release drops it (the seed + shipped compiler stay lean). Returns
// null when an error-severity diagnostic blocks the build.
prepared_module :: fn(file: Path, request: BuildRequest) -> CfgBytecode | null {
    b :: prepare_cfg_bytecode_with(
        file,
        !request.release,
        request.include_paths,
        request.project_root,
        request.target,
        request.verify,
        proves_bounds(request.release),
    )
    if !ready_to_emit(b, "build", file) {
        return null
    }
    return b
}

// Whether a prepared program may be emitted or run: no error among its
// diagnostics, which print either way, and an entry point. A module without
// `main` has nothing to start at.
ready_to_emit :: fn(b: CfgBytecode, command: string, file: Path) -> bool {
    if !flush_build_diags(b.pre_diags, b.lower_diags) {
        return false
    }
    if b.entry != "" {
        return true
    }
    eprintln("vader ${command}: `${file}` declares no `main`, the function a program starts at")
    return false
}

// Render the merged pipeline diagnostics to stderr and report whether the
// build may proceed : any error-severity diagnostic aborts the build
// (return false) ; warnings / info still print.
flush_build_diags :: fn(pre: Diagnostic[], lower: Diagnostic[]) -> bool {
    all :: merge_diagnostics(pre, lower)
    if all.len() > 0 {
        eprintln(all.dump_diagnostics_with_file())
    }
    return !any_error_diag(all)
}

// `--target=c` : write the generated C to `--out` (default `<file>.c`).
// `--out=-` streams it to stdout, for piping into another tool.
build_c :: fn(file: Path, stem: Path, request: BuildRequest, split: bool) -> i32 {
    if split {
        out :: output_path(request.out, stem)
        prog :: emit_c_program_for(file, request, out) ?? return 1
        return write_split_files(out, prog)
    }
    c_src :: emit_c_for_input(file, request) ?? return 1
    if request.out == "-" {
        print(c_src)
        return 0
    }
    return write_out(output_path(request.out, "${stem}.c".to_path()), c_src)
}

// Emit C from either a `.vader` source (full front end) or a `.virt` text
// bytecode dump (`parse_virt_bc` → `emit_c`). A `.virt` input skips the
// lexer/parser/typer/lower/emit pipeline — the bytecode already exists.
emit_c_for_input :: fn(file: Path, request: BuildRequest) -> string | null {
    if file.extension() != "virt" {
        return emit_c_source(file, request)
    }
    module :: virt_module(file) ?? return null
    return c_of_virt(module)
}

// Read a `.virt` text dump and reconstruct its `BytecodeModule`, or say why not.
virt_module :: fn(file: Path) -> BytecodeModule | null {
    src :: read_file_string(file.as_string())
    if src is IOError {
        eprintln("vader build: cannot read ${file}")
        return null
    }
    module :: parse_virt_bc(src)
    if module is VirtParseError {
        eprintln(module.display_virt_parse_error("vader build", file.as_string()))
        return null
    }
    return module
}

// The C of a `.virt` module. The entry fn is the module's `is_main` function
// (recovered from the dump's `export main N` directive).
c_of_virt :: fn(module: BytecodeModule) -> string =
    emit_c(module, native_c_options(virt_entry_mangled(module)))

// Mangled name of the entry fn (the `is_main` function), or `""` when none.
virt_entry_mangled :: fn(module: BytecodeModule) -> string {
    for f in module.functions {
        if f.is_main {
            return f.name
        }
    }
    return ""
}

// `--emit=executable` : emit the C in `c/` beside the binary, then invoke the C
// compiler to link it against the external runtime (`runtime/c/`). The `.c`
// is kept, so the user can inspect the generated source.
build_native :: fn(file: Path, out: Path, request: BuildRequest, split: bool, cc_jobs: i32) -> i32 {
    if split {
        return build_native_split(file, out, request, cc_jobs)
    }
    // The CLI keeps its own C emission — it handles a `.virt` input and prints
    // diagnostics through `flush_build_diags` — but the LINK is shared with
    // `vader/pipeline`, so the two cannot drift on flags.
    quote_dir :: quote_include_dir(file)
    if file.extension() == "virt" {
        module :: virt_module(file) ?? return 1
        native :: native_flags(module)
        return link_native(c_of_virt(module), out, request.cc, request.release, request.ldflags, "", quote_dir, native)
    }
    b :: prepared_module(file, request) ?? return 1
    native :: native_flags(b.module)
    return link_native(emit_c_of(b), out, request.cc, request.release, request.ldflags, "", quote_dir, native)
}

// ----------------------------------------------------------- split build

// `--split --emit=executable` : emit the program as a header + globals TU + one
// function TU per Vader module, then compile them concurrently and link. The
// units and their objects go to `c/` beside the binary (`intermediate_stem`),
// and stay there after the link, failed or not, for inspection.
build_native_split :: fn(file: Path, out: Path, request: BuildRequest, cc_jobs: i32) -> i32 {
    cc :: request.cc
    release :: request.release
    ldflags :: request.ldflags
    b :: prepared_module(file, request) ?? return 1
    native :: native_flags(b.module)
    if report_missing_archives(native) {
        return 1
    }
    work :: intermediate_stem(out) ?? return 1
    prog :: split_program(b, work)
    if write_split_files(work, prog) != 0 {
        return 1
    }
    c_files :: split_c_files(work, prog.unit_names)
    rt :: runtime_c_root()

    // Splitting is what makes the compiles parallel, and it is also what stops
    // `cc` inlining across the cut — a definition another TU may call has to be
    // emitted as written. ThinLTO gives that back: the per-unit compiles stay
    // parallel, the link reads only summaries, and the optimisation that
    // follows imports across units. It brings the bench back to a monolithic
    // build's numbers — several workloads past it — for a few seconds of link,
    // where full LTO would serialise the whole optimisation instead.
    //
    // The worst case without it was a byte-scan loop whose per-byte read stayed
    // an out-of-line call, so the loop never vectorised.
    flavour :: cc_flavour(cc)

    // One `cc -c` per TU (+ the runtime), spawned concurrently so the OS
    // compiles them across cores. `all` joins a wave ; `block_on` drives the
    // cooperative scheduler from this synchronous entry.
    //
    // `cc_jobs` bounds how many run at once, 0 meaning no bound. It exists for
    // the case where the MACHINE, not this build, is the scarce resource — see
    // `DRIVER_CC_JOBS` at the driver's call site. A bound turns one wave into
    // ceil(n / cc_jobs) waves, each as long as its slowest unit, so it costs
    // some parallelism; that is why the user's own `--split` passes 0.
    argvs: string[][]: []
    obj_files: string[]: []
    quote_dir :: quote_include_dir(file)
    for cf in c_files {
        obj :: "${cf}.o"
        obj_files.push(obj)
        source :: cf.as_string()
        argvs.push(
            cc_compile_argv(cc, source, obj, rt, release, flavour, quote_dir, native.includes),
        )
    }
    rt_obj :: "${work}.split.runtime.o"
    obj_files.push(rt_obj)
    rt_src :: "${rt}/vader_runtime.c"
    argvs.push(
        cc_compile_argv(cc, rt_src, rt_obj, rt, release, flavour, quote_dir, native.includes),
    )

    wave :: if cc_jobs > 0 { i64(cc_jobs) } else { argvs.len() }
    results: (ProcessResult | ProcessError)[]: []
    start: i64 = 0
    for start < argvs.len() {
        stop :: if start + wave < argvs.len() { start + wave } else { argvs.len() }
        tasks: Async<ProcessResult | ProcessError>[]: []
        for k in start..<stop {
            tasks.push(spawn_async(argvs[k]))
        }
        results.push_all(block_on(join_all(tasks)))
        start = stop
    }
    for r in results {
        if r is ProcessError {
            eprintln("vader build: ${r.message()}")
            eprintln("(generated C kept in ${folder_of(work)})")
            return 1
        } else if r is ProcessResult {
            if r.exit != 0 {
                eprintln("vader build: ${cc} -c failed (exit ${r.exit})")
                eprintln(r.stderr)
                eprintln("(generated C kept in ${folder_of(work)})")
                return 1
            }
        }
    }

    // Link the objects into the final binary (link is inherently serial).
    // The link runs alone, so it may use what the compiles were bounded to.
    link_jobs :: if cc_jobs > 0 { cc_jobs } else { processor_count() }
    lres :: spawn(
        cc_link_argv(cc, obj_files, out, ldflags, release, flavour, link_jobs, native.links),
    )
    if lres is ProcessError {
        eprintln("vader build: ${lres.message()}")
        return 1
    }
    if lres.exit != 0 {
        eprintln("vader build: ${cc} link failed (exit ${lres.exit})")
        eprintln(lres.stderr)
        return 1
    }
    eprintln("vader build: wrote ${out} (split: ${obj_files.len()} objects compiled in parallel)")
    return 0
}

// Prepare the module and emit it as a `CProgram`. The header basename embeds a
// `.split.` infix so it never collides with the runtime's `vader.h` when
// `--out` basename is `vader`. Null on a front-end error or `.virt` input.
emit_c_program_for :: fn(file: Path, request: BuildRequest, out: Path) -> CProgram | null {
    // UNREACHABLE from the CLI: `split` (`build_file`) already excludes a `.virt`, and
    // both callers gate on it. Kept as the guard for a future third caller that
    // does not — the rule "a `.virt` has no front end to re-run" belongs next to
    // the code that would re-run it, not only in the flag computation.
    if file.extension() == "virt" {
        eprintln("vader build: split needs a `.vader` front end; `.virt` takes the single TU")
        return null
    }
    b :: prepared_module(file, request) ?? return null
    return split_program(b, out)
}

// The split C of a prepared program, its TUs including `<out>.split.h`.
split_program :: fn(b: CfgBytecode, out: Path) -> CProgram {
    // The `#include` name is the header's basename (split TUs sit next to it) —
    // `filename` via `to_posix` also handles `\` on Windows.
    header_name :: "${canonicalise(out).filename()}.split.h"
    return emit_c_split(b.module, native_c_options(b.entry), header_name)
}

/// Emit the split C for SEVERAL targets against one shared atom universe.
///
/// The seed's shape. Atom ids are positions, so each target's own literal pool
/// numbers them differently and every file ends up differing by renumbering
/// alone — measured at 7026 renumbered lines against 2 of real content. Unioning
/// the pools first makes the ids agree, so the emitted C differs only where the
/// code does.
///
/// The union is SORTED rather than first-seen: the ids must not depend on the
/// order the targets were listed in.
///
/// @param file                the entry source.
/// @param out                 output stem. Units every target agreed on are
///                            written once as `<out>-<module>.c`; the ones that
///                            differ go to `<out>.<os>-<arch>-<module>.c`,
///                            beside the shared `<out>.split.h` / `.split.g.c`.
/// @param request             the targets to emit for (`seed_targets`, at least
///                            one), and what every target's front end shares:
///                            `--release`, which changes the bytecode, the search
///                            roots and `--verify`.
/// @return                    0 on success, 1 when any target fails to build.
emit_c_for_targets :: fn(file: Path, out: Path, request: BuildRequest) -> i32 {
    targets :: request.seed_targets
    mods: CfgBytecode[]: []
    for t in targets {
        b :: prepared_module(file, BuildRequest { ...request, .target = t }) ?? return 1
        mods.push(b)
    }
    universe :: union_of_string_pools(mods)
    // The type table needs the same treatment as the atom table, and for the
    // same reason: it is index-addressed, so one extra type on one target shifts
    // every slot after it. Measured without this, from a single lambda in a
    // `@target` body: 11 282 renumbered lines against 238 of real content, and
    // shared units fell from 37 to 7.
    // Keyed ONCE per module, then reused by the union and by every rebase —
    // `bc_type_key` recurses through composite types, so re-deriving it per pass
    // re-walks that graph for every target.
    type_keys :: mods.map((m) -> type_keys_of(m.module)).collect()
    type_universe :: union_of_type_tables(type_keys)
    // ONE header name for every target. It holds the struct typedefs, the
    // prototypes and the atom count — all identical once the universe is shared
    // — so per-target copies would differ in nothing but their own `#include`
    // line, which is what a first attempt produced: 39 files "differing" on
    // line 1 alone.
    header_name :: "${canonicalise(out).filename()}.split.h"
    progs: CProgram[]: []
    for i in 0..<targets.len() {
        // A literal a target holds but the universe does not means the pools were
        // unioned after something already emitted. Left unchecked it is a SILENT
        // atom alias — the id lands on whatever sits at that slot — so it is
        // named here instead.
        gaps :: atom_universe_gaps(mods[i].module.strings, universe)
        if gaps.len() > 0 {
            eprintln("vader build: atom universe misses ${gaps.len()} literal(s) for "
                + "${display_target(targets[i])}, first `${gaps[0]}`")
            return 1
        }
        progs.push(
            emit_c_split(
                rebase_types(mods[i].module, type_keys[i], type_universe),
                CEmitOptions {
                    ...native_c_options(mods[i].entry),
                    .atom_universe = universe,
                },
                header_name,
            ),
        )
    }
    return write_deduplicated(out, targets, progs)
}

// Write the programs with everything identical stored ONCE.
//
// A unit is shared when every target emitted the same bytes for it, and only
// then; the rest go under `<out>.<os>-<arch>.split.<k>.c`. Which units differ is
// data, not a rule — with one `@target` body in the closure it was exactly one
// out of 39, 28 KB against 11.3 MB.
write_deduplicated :: fn(out: Path, targets: Target[], progs: CProgram[]) -> i32 {
    first :: progs[0]
    for i in 1..<progs.len() {
        // The targets must agree on WHICH modules exist, name by name — a
        // count alone would pass when one module replaced another.
        if !progs[i].unit_names.content_equals(first.unit_names) {
            eprintln("vader build --seed-targets: `${display_target(targets[i])}` and "
                + "`${display_target(targets[0])}` emitted different module sets")
            return 1
        }
    }
    // The shared header USUALLY matches across targets, because the `@extern`
    // declarations and their shims — the part a target changes most — live in
    // their own header. It does not have to: the synthetic type names
    // (`__Tuple_N`, `__lambda_env_N`) are numbered AFTER target selection, so a
    // function reached by one target only shifts every id behind it and the
    // header diverges by pure renumbering. `to_wide` / `from_wide`, called on
    // Windows and dead-stripped elsewhere, moved the whole table by two.
    //
    // So it falls back the same way the imports header and the globals unit
    // already do — one copy per target directory, found first on the include
    // path — rather than refusing a build whose output is perfectly valid.
    if progs.all_match((pr) -> pr.header == first.header) {
        if write_out("${out}.split.h".to_path(), first.header) != 0 {
            return 1
        }
    } else {
        for i in 0..<targets.len() {
            target :: display_target(targets[i])
            if ensure_target_dir(out, target) != 0 {
                return 1
            }
            name :: "${canonicalise(out).filename()}.split.h"
            if write_out("${out.parent()}/${target}/${name}".to_path(), progs[i].header) != 0 {
                return 1
            }
        }
    }
    // The imports header keeps a fixed NAME, so the units never mention a
    // target. When the targets agree it sits beside the shared header; when
    // they do not, each goes in a directory of its own and the build puts the
    // right one first on the include path.
    if progs.all_match((pr) -> pr.imports == first.imports) {
        if write_out(imports_header_path(out), first.imports) != 0 {
            return 1
        }
    } else {
        for i in 0..<targets.len() {
            target :: display_target(targets[i])
            if ensure_target_dir(out, target) != 0 {
                return 1
            }
            name :: imports_header_name("${canonicalise(out).filename()}.split.h")
            if write_out("${out.parent()}/${target}/${name}".to_path(), progs[i].imports) != 0 {
                return 1
            }
        }
    }
    if progs.all_match((pr) -> pr.globals == first.globals) {
        if write_out("${out}.split.g.c".to_path(), first.globals) != 0 {
            return 1
        }
    } else {
        for i in 0..<targets.len() {
            // Through `unit_path`, not a second spelling of the rule: the build
            // scripts compile one target directory, and the `.split.g.c` form
            // this used to write matched neither that nor the shared-globals
            // line. Masked today because every target's globals are identical,
            // so this branch never runs — and it would have surfaced as a
            // missing symbol at link time, far from the cause.
            if ensure_target_dir(out, display_target(targets[i])) != 0 {
                return 1
            }
            if write_out(unit_path(out, display_target(targets[i]), GLOBALS_UNIT), progs[i].globals) != 0 {
                return 1
            }
        }
    }
    for k in 0..<first.units.len() {
        name :: first.unit_names[k]
        if progs.all_match((pr) -> pr.units[k] == first.units[k]) {
            if write_out(unit_path(out, "", name), first.units[k]) != 0 {
                return 1
            }
        } else {
            for i in 0..<targets.len() {
                if ensure_target_dir(out, display_target(targets[i])) != 0 {
                    return 1
                }
                if write_out(unit_path(out, display_target(targets[i]), name), progs[i].units[k]) != 0 {
                    return 1
                }
            }
        }
    }
    return 0
}

// `<os>-<arch>,<os>-<arch>,…`, or null after naming what is wrong: a fragment that
// names no target, or no target at all.
parse_target_list :: fn(spec: string) -> Target[] | null {
    out: Target[]: []
    for part in spec.split(",") {
        if part == "" {
            continue
        }
        parsed :: parse_target(part)
        if parsed is TargetParseError {
            eprintln("vader build --seed-targets: ${parsed.reason} `${parsed.fragment}`")
            return null
        }
        if parsed is Target {
            out.push(parsed)
        }
    }
    if out.len() == 0 {
        eprintln("vader build --seed-targets: no target named")
        return null
    }
    return out
}

// Every non-empty literal any target uses, sorted. Sorted and not first-seen so
// the ids are a property of the SET, not of the order the targets were given.
union_of_string_pools :: fn(mods: CfgBytecode[]) -> string[] {
    seen: MutableSet<string>: MutableSet<string> {}
    out: string[]: []
    for m in mods {
        for s in m.module.strings {
            if s != "" && seen.add(s) {
                out.push(s)
            }
        }
    }
    return sort(out, (a: string, b: string) -> compare_ascending(a, b))
}

// Path of the imports header beside `out`, under the FIXED name the shared
// header includes. A per-target build writes it into its own directory instead
// (see `write_deduplicated`), and the compile adds that directory ahead of the
// shared one on the include path.
//
// Built from `out` the same way `${out}.split.h` is, NOT from `out.parent()`:
// a bare `out` with no directory part yielded an empty parent and an absolute
// `/p.imports.h`, which only showed up on Windows — every test here had run
// with a directory in the path.
imports_header_path :: fn(out: Path) -> Path = "${out}${IMPORTS_HEADER_SUFFIX}".to_path()

// Write the split program : `<out>.split.h`, `<out>.split.g.c`, and
// `<out>.split.<k>.c` for each function unit. All co-located so each TU's
// `#include "<base>.split.h"` resolves relative to its own directory.
write_split_files :: fn(out: Path, prog: CProgram) -> i32 {
    if write_out("${out}.split.h".to_path(), prog.header) != 0 { return 1 }
    if write_out(imports_header_path(out), prog.imports) != 0 { return 1 }
    if write_out("${out}.split.g.c".to_path(), prog.globals) != 0 { return 1 }
    for k in 0..<prog.units.len() {
        if write_out(unit_path(out, "", prog.unit_names[k]), prog.units[k]) != 0 { return 1 }
    }
    return 0
}

// The `.c` files to compile : the globals TU + each function TU (the header is
// included, not compiled).
split_c_files :: fn(out: Path, unit_names: string[]) -> Path[] {
    files: Path[]: ["${out}.split.g.c".to_path()]
    for n in unit_names {
        files.push(unit_path(out, "", n))
    }
    return files
}

// `<out>-<module>.c`, or `<out>.<target>-<module>.c` when the unit is
// target-specific. Named by MODULE and not by index: an index shifts every
// later unit the moment a module is added, which renames and rewrites files
// whose contents did not change — the same renumbering the atom table used to
// do, one level up.
/// Where one split unit is written: `<out>-<unit>.c` when every target agreed on
/// it, `<out-dir>/<target>/<stem>.<unit>.c` when they did not — the directory
/// already says which target, so the name no longer repeats it.
///
/// A per-target unit sits in that target's directory, beside the imports header
/// that is already there — so a build compiles the flat shared set plus ONE
/// directory, and an obsolete unit stays visible instead of blending into the
/// flat listing.
///
/// @param out     the `--out` stem.
/// @param target  the target's display name, or `""` for a shared unit.
/// @param unit    the module's unit name.
/// @return        the path to write.
unit_path :: fn(out: Path, target: string, unit: string) -> Path =
    if target == "" {
        "${out}-${unit}.c".to_path()
    } else {
        "${out.parent()}/${target}/${out.filename()}.${unit}.c".to_path()
    }

/// Create the directory a per-target unit goes in. Idempotent — several units
/// share it, and the imports header may have made it already.
///
/// @param out     the `--out` stem.
/// @param target  the target's display name.
/// @return        0, or 1 after reporting why the directory could not be made.
ensure_target_dir :: fn(out: Path, target: string) -> i32 {
    dir :: "${out.parent()}/${target}"
    mk :: create_dir(dir)
    if mk is IOError {
        eprintln("vader build --seed-targets: cannot create `${dir}`: ${mk.message()}")
        return 1
    }
    return 0
}

// `cc -c <src> -o <obj>` for one split TU (or the runtime). Same optimisation
// flags and includes (`push_include_flags`) as the monolithic `cc_argv`. One of
// these runs per object, in parallel.
cc_compile_argv :: fn(
    cc: string,
    src: string,
    obj: string,
    rt: string,
    release: bool,
    flavour: CcFlavour,
    quote_dir: string,
    includes: string[],
) -> string[] {
    argv: string[]: [cc]
    argv.push_all(cc_opt_flags(release))
    argv.push_all(lto_flags(flavour, release, false, 0))
    push_include_flags(argv, rt, quote_dir)
    argv.push_all(includes)
    argv.push("-c")
    argv.push(src)
    argv.push("-o")
    argv.push(obj)
    return argv
}


/// Probe `cc --version`, once per build.
///
/// Order matters: a clang banner does not say "gcc", but a GCC one may be
/// spelled `cc (GCC) 14.2.0`, so clang is tested first and the GCC test is
/// case-insensitive.
///
/// @param cc  the C compiler this build invokes.
/// @return    the toolchain family, `Unknown` when the probe fails.
cc_flavour :: fn(cc: string) -> CcFlavour {
    r :: spawn([cc, "--version"])
    if r is ProcessError {
        return .Unknown
    }
    if r.exit != 0 {
        return .Unknown
    }
    banner :: r.stdout.to_lower()
    if "clang" in banner {
        return .Clang
    }
    if "gcc" in banner || "free software foundation" in banner {
        return .Gcc
    }
    return .Unknown
}

// (a no-op on macOS / MinGW).
cc_link_argv :: fn(
    cc: string, objs: string[], out: Path, ldflags: string, release: bool, flavour: CcFlavour,
    jobs: i32, links: string[],
) -> string[] {
    argv: string[]: [cc]
    argv.push_all(lto_flags(flavour, release, true, jobs))
    argv.push_all(objs)
    argv.push_all(links)
    push_ldflags(argv, ldflags)
    argv.push("-o")
    argv.push(out.as_string())
    push_math_library(argv)
    return argv
}
