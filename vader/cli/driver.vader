// vader/cli/driver — the build-driver path: `vader build` with no file argument.
//
// A project drives its own build by putting a `build.vader` at its root, holding
// a `build` fn (a reserved name, the way `main` is in a program). `vader build`
// with no file compiles that driver and runs it; the driver then decides what to
// compile, because the compiler is part of its own import closure.
//
// Why a GENERATED entry rather than teaching the lowerer a second entry name:
// `is_main_decl` (`lower/lower_decl.vader:572`) recognises the entry by the
// literal name `main`, and widening it would make every project's `build` fn an
// entry point. Worse, a driver compiled directly would be silently ELIMINATED —
// `lower/dce.vader:238` roots only `is_main` and `@export` decls, so `build`
// disappears and `emit_main` falls back to its `return 0` stub: a binary that
// does nothing, with no diagnostic. The generated `main` makes `build` reachable,
// so no DCE rule has to change.
//
// The shim is written BESIDE the driver, declaring the SAME module, and calls
// `build` directly rather than importing it. A single `.vader` file at a
// project root is not importable by module name (the loader maps a module to a
// folder of the same name), so `import "build"` cannot resolve a root-level
// `build.vader` — sharing the module sidesteps that, and needs no directory
// creation, which `std/io` cannot do anyway.
//
// The driver runs NATIVELY, not through the comptime VM: it reads the compiler's
// own AST nodes, and the VM has its own value representation (per-module type
// indices and atom ids) that no shared layout reconciles. See
// `.claude/plans/2026-08-26-metacompilation-hook.md` §4 and §11.

module "vader/cli"

import "std/io"
import "std/path"
import "std/string_builder"
import "std/async"
import "std/process"
import "vader/diagnostics"
AST :: import "vader/parser"
import "vader/resolver"

// ---- discovery ------------------------------------------------------------

/// Filename a project uses to drive its own build.
export DRIVER_FILENAME :: "build.vader"

/// Module name the driver file declares, and the entry module imports.
export DRIVER_MODULE :: "build"

/// Filename of the generated entry, written beside the driver. Named so it reads
/// as machine-written in a directory listing.
export DRIVER_ENTRY_FILENAME :: "vader_build_entry.vader"

/// Where a driven build puts the driver's binary and generated C, relative to
/// the project root. Under `build/` so a checkout's existing ignore rules cover
/// it — the driver is a build artefact like any other.
export DRIVER_ARTEFACT_DIR :: "build/driver"

/// Locate the project's build driver.
///
/// Looked up in `root` only — no walk up the tree. A driver governs the project
/// it sits in, so finding one two directories up would silently build something
/// the user did not mean, the way a stray `Makefile` never does.
///
/// @param root  directory to look in — normally the invocation directory.
/// @return      path to the driver file, or `null` when the project has none,
///              in which case `vader build` keeps its current behaviour.
export find_build_driver :: fn(root: string) -> string | null {
    candidate :: join_path(root, DRIVER_FILENAME)
    if exists(candidate) {
        return candidate
    }
    return null
}

// ---- compiler-source resolution -------------------------------------------

/// Include-path root under which `vader/hooks` resolves.
///
/// Mirrors `resolver::resolve_sidecar`'s shape: prefer the folder holding the
/// running binary (the `dist/` bundle layout, once it ships `vader/`), and fall
/// back to `root` — which is what a checkout gives, where `vader/` sits at the
/// project root. Returns a root CONTAINING `vader/`, not `vader/` itself, since
/// include paths are searched by module name.
///
/// @param root  invocation directory, used as the checkout fallback.
/// @return      a directory under which `vader/hooks/` is expected to resolve.
export compiler_source_root :: fn(root: string) -> string {
    beside_binary :: current_executable_location().dir_of()
    if exists(join_path(beside_binary, "vader/hooks")) {
        return beside_binary
    }
    // Walk up from the project. A checkout has `vader/` at its top, and a
    // project nested inside one — a test fixture, a sub-package — would
    // otherwise never see it. Same shape as `find_manifest_root`.
    dir := root
    for {
        if exists(join_path(dir, "vader/hooks")) {
            return dir
        }
        parent :: dir.dir_of()
        if parent == dir {
            return root
        }
        dir = parent
    }
}

// ---- generated entry ------------------------------------------------------

/// Render the entry module that calls a driver's `build`.
///
/// Kept to two statements on purpose: everything a driver needs it builds
/// itself through `new_build_context`, so this shim carries no policy — only the
/// `main` the lowerer insists on.
///
/// @return the module source, ready to write next to a `module "..."` folder
///         named `DRIVER_ENTRY_MODULE`.
export render_driver_entry :: fn() -> string {
    out :: StringBuilder {}
    out.append("// Generated by `vader build` — do not edit.\n")
    out.append("//\n")
    out.append("// Entry shim for this project's `${DRIVER_FILENAME}`: it shares that file's\n")
    out.append("// module so it can call `build` without an import, and gives the lowerer the\n")
    out.append("// `main` it recognises as the entry. Written before each driven build and\n")
    out.append("// removed after; delete it freely.\n")
    out.append("\n")
    out.append("module \"${DRIVER_MODULE}\"\n")
    out.append("\n")
    out.append("main :: fn(args: string[]) -> i32 {\n")
    out.append("    return build(args)\n")
    out.append("}\n")
    return out.to_string()
}

/// Path of the generated entry: beside the driver, sharing its module.
///
/// @param root  the project root, where the driver lives.
export driver_entry_path :: fn(root: string) -> string =
    join_path(root, DRIVER_ENTRY_FILENAME)

// ---- validation -----------------------------------------------------------

/// Check that a driver file declares a usable `build`, before anything is built.
///
/// Without this the failure surfaces as a compile error inside the GENERATED
/// entry — pointing at machine-written code for a mistake in the user's file.
/// Parsing the driver first costs one parse and lets the diagnostic land on the
/// driver itself, or on nothing at all when the fn is simply absent.
///
/// Parse errors are left alone: the real build reports them against the driver
/// with full spans, and duplicating them here would double every message.
///
/// @param path  the driver file, already known to exist.
/// @return      the diagnostic to report, or `null` when the driver is usable.
/// @error       H6001 when no `build` fn is declared ; H6002 when one is declared
///              with a signature the generated entry cannot call.
export validate_driver :: fn(path: string) -> Diagnostic | null {
    source :: match read_file_string(path) {
        is string as s -> s
        is IOError     -> ""
    }
    if source == "" {
        return null
    }
    parsed :: AST.parse_source(source, path)
    if parsed.errors.len() > 0 {
        return null
    }
    for d in parsed.program.decls {
        if d is AST.FnDecl as f {
            if f.name == DRIVER_MODULE_ENTRY {
                return signature_problem(f)
            }
        }
    }
    // Anchor on the file's first character: there is no declaration to point at,
    // and `empty_span()` would render as `<synthetic>`, naming no file at all.
    return hook_error(.MissingBuildEntry, file_head_span(path),
        "add `${DRIVER_MODULE_ENTRY} :: fn(args: string[]) -> void`")
}

// A span at the head of `path` — for a problem that is about the file itself
// rather than about anything written in it.
file_head_span :: fn(path: string) -> Span {
    at :: Position { .file = path, .offset = 0, .line = 1, .column = 1 }
    return Span { .start = at, .end = at }
}

/// Name of the fn a driver file must declare — reserved, the way `main` is.
export DRIVER_MODULE_ENTRY :: "build"

// The generated entry does `return build(args)`, so two shapes have to hold: one
// parameter, and an `i32` result. The result matters — a `void` driver could not
// fail a build, which is how a reported problem used to exit 0. A wrong parameter
// TYPE is still left to the typechecker, which names expected and actual better
// than this could.
signature_problem :: fn(f: AST.FnDecl) -> Diagnostic | null {
    if f.params.len() != 1 {
        return hook_error(.InvalidBuildEntrySignature, f.name_span,
            "`${DRIVER_MODULE_ENTRY}` takes one parameter, `args: string[]`, and got ${f.params.len()}")
    }
    if !returns_i32(f) {
        return hook_error(.InvalidBuildEntrySignature, f.name_span,
            "`${DRIVER_MODULE_ENTRY}` must return `i32` — the build's exit status")
    }
    return null
}

// True when the declared return type is spelled `i32`. Textual on purpose: this
// runs on a parsed, un-resolved AST, where there is no type to compare against.
returns_i32 :: fn(f: AST.FnDecl) -> bool {
    rt :: f.return_type ?? return false
    if rt is AST.IdentExpr as id {
        return id.name == "i32"
    }
    return false
}

// ---- running the driver ---------------------------------------------------

/// Compile the project's driver and run it.
///
/// The driver decides what to compile, so this function's whole job is to hand
/// control over: write the entry shim, build it, run it with the project root as
/// `args[1]`, and clean the shim up. The compiler's own sources are added to the
/// include paths so `import "vader/hooks"` resolves without the user configuring
/// anything.
///
/// @param root     project root — where the driver and the shim live.
/// @param cc       C compiler for the native link step.
/// @param ldflags  extra linker flags, threaded through unchanged.
/// @param units    parallel `cc` jobs, as `--parallel` requested.
/// @return         the driver's own exit code, or 1 when the driver could not be
///                 built or written.
/// @error          H6001 when the driver declares no `build` — surfaced as a
///                 compile error on the generated entry's call to it.
export run_build_driver :: fn(root: string, cc: string, ldflags: string, units: i32) -> i32 {
    driver :: find_build_driver(root) ?? return 1
    problem :: validate_driver(driver)
    if problem is Diagnostic as d {
        eprintln(dump_diagnostics_with_file([d]))
        return 1
    }

    entry :: driver_entry_path(root)
    written :: write_file_string(entry, render_driver_entry())
    if written is IOError as e {
        eprintln("vader build: cannot write the build entry at ${entry}: ${e.msg}")
        return 1
    }

    // Artefacts go under `build/`, not the project root: a driven build should
    // not litter the directory the user works in. `create_dir` makes the path
    // rather than requiring it to exist.
    artefacts :: join_path(root, DRIVER_ARTEFACT_DIR)
    made :: create_dir(artefacts)
    if made is IOError as ce {
        eprintln("vader build: cannot create ${artefacts}: ${ce.msg}")
        remove_entry(entry)
        return 1
    }
    binary :: join_path(artefacts, "driver")
    // The driver is a normal native build; `vader/hooks` resolves through the
    // compiler's own sources, and the driver's module through the entry's folder.
    code :: build_native(Path(entry), binary, false, cc, ldflags, [compiler_source_root(root)], units)
    // Remove the shim whether or not the build worked: leaving a generated file
    // behind after a failure is how a stale one gets compiled next time.
    remove_entry(entry)
    if code != 0 {
        return code
    }

    // Bounded: a driver is user code with no supervisor, and a `for { }` in one
    // would otherwise hang the build with no message and no way out. It runs as
    // a child process, so a timeout costs nothing more than naming one — no
    // instruction budget is possible (the driver is native, not VM-interpreted),
    // but a wall-clock bound is what actually catches an infinite loop.
    // `timeout` cancels its child on expiry, and `SpawnAsync.cancel` kills the
    // process — without that override the parent would unblock while the runaway
    // driver kept spinning a core.
    outcome :: block_on(timeout(DRIVER_TIMEOUT_MS, spawn_async([binary, root])))
    if outcome is TimeoutError {
        eprintln("vader build: the build driver did not finish within ${DRIVER_TIMEOUT_MS / 1000}s — killed")
        eprintln("(a loop in `${DRIVER_FILENAME}`? build with --no-hooks to skip it)")
        return 1
    }
    if outcome is ProcessError as pe {
        eprintln("vader build: cannot run the build driver: ${pe.message()}")
        return 1
    }
    if outcome is ProcessResult as result {
        print(result.stdout)
        eprint(result.stderr)
        return result.exit
    }
    return 1
}

/// How long a driver may run before the build gives up on it.
///
/// Generous on purpose: a driver compiles a real project, and a large one
/// legitimately takes minutes. This is a backstop against a hang, not a
/// performance budget — a driver that needs longer is better served by
/// `--no-hooks` and a manual build than by raising this.
export DRIVER_TIMEOUT_MS :: 600_000

// Best-effort deletion: a leftover shim is a nuisance, not a failure, so the
// error is dropped. It matters that this really unlinks — a blanked file left in
// the project root would be a `.vader` that declares nothing.
remove_entry :: fn(path: string) -> void {
    _ :: remove_file(path)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_find_driver_absent :: fn() -> void {
    found :: find_build_driver("/nonexistent-project-root")
    assert(found == null, "a project without build.vader has no driver")
}

@test test_entry_shares_the_driver_module :: fn() -> void {
    src :: render_driver_entry()
    assert("module \"build\"" in src, "entry declares the driver's own module")
}

@test test_entry_does_not_import_the_driver :: fn() -> void {
    // A root-level `build.vader` is not importable by module name, so sharing
    // the module is the point — an import here would not resolve.
    src :: render_driver_entry()
    assert(!("import \"build\"" in src), "entry does not import what it shares a module with")
}

@test test_entry_calls_build_and_returns :: fn() -> void {
    src :: render_driver_entry()
    assert("build(args)" in src, "entry calls build with argv")
    assert("main :: fn(args: string[]) -> i32" in src, "entry declares the main the lowerer needs")
}

@test test_entry_is_marked_generated :: fn() -> void {
    src :: render_driver_entry()
    assert("do not edit" in src, "generated file says so")
}

@test test_entry_sits_beside_the_driver :: fn() -> void {
    // Same folder as the driver, so both contribute to one multi-file module.
    assert_eq(driver_entry_path("/some-project"), "/some-project/vader_build_entry.vader")
}

@test test_compiler_source_root_falls_back_to_root :: fn() -> void {
    // No `vader/hooks` beside a bogus binary location, so the checkout fallback
    // wins — which is what a clone gives.
    root :: compiler_source_root("/some-project")
    assert(root == "/some-project" || exists(join_path(root, "vader/hooks")),
        "either the fallback root, or a real sidecar layout")
}

@test test_validate_driver_missing_build :: fn() -> void {
    // A driver with no `build` must be caught before anything is generated.
    path :: join_path(temp_dir(), "vader_driver_probe_missing.vader")
    _ :: write_file_string(path, "module \"build\"\n\nother :: fn() -> void {}\n")
    problem :: validate_driver(path)
    assert(problem is Diagnostic, "a driver without `build` is a problem")
    if problem is Diagnostic as d {
        assert_eq(d.code.id, "H6001")
    }
}

@test test_validate_driver_wrong_arity :: fn() -> void {
    path :: join_path(temp_dir(), "vader_driver_probe_arity.vader")
    _ :: write_file_string(path, "module \"build\"\n\nbuild :: fn() -> void {}\n")
    problem :: validate_driver(path)
    assert(problem is Diagnostic, "a nullary `build` cannot be called by the entry")
    if problem is Diagnostic as d {
        assert_eq(d.code.id, "H6002")
    }
}

@test test_validate_driver_accepts_the_expected_shape :: fn() -> void {
    path :: join_path(temp_dir(), "vader_driver_probe_ok.vader")
    _ :: write_file_string(path, "module \"build\"\n\nbuild :: fn(args: string[]) -> i32 { return 0 }\n")
    assert(validate_driver(path) == null, "the documented shape validates")
}

@test test_validate_driver_rejects_a_void_build :: fn() -> void {
    // A `void` driver could not fail a build — that is how a reported problem
    // used to exit 0.
    path :: join_path(temp_dir(), "vader_driver_probe_void.vader")
    _ :: write_file_string(path, "module \"build\"\n\nbuild :: fn(args: string[]) -> void {}\n")
    problem :: validate_driver(path)
    assert(problem is Diagnostic, "a void `build` cannot carry an exit status")
    if problem is Diagnostic as d {
        assert_eq(d.code.id, "H6002")
    }
}

@test test_validate_driver_stays_quiet_on_parse_errors :: fn() -> void {
    // The real build reports these against the driver with full spans; saying
    // it twice would double every message.
    path :: join_path(temp_dir(), "vader_driver_probe_broken.vader")
    _ :: write_file_string(path, "module \"build\"\n\nbuild :: fn(args: string[]) -> i32 { (((\n")
    assert(validate_driver(path) == null, "parse errors are left to the real build")
}
