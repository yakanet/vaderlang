// vader/cli/cmd_fix — apply the fixes the compiler names for itself.
//
// The fixes are the `!` a parameter's source writes where the compiler deduces it
// anyway (W0017) or where nothing needs it (W0018). Each warning's span is the `!`
// itself, so the edit is that one character, and the check that reported it has
// already said which. A body `@target` keeps out of the check is not seen : fix it
// with `--target` set to its platform.

module "vader/cli"

import "cli"
import "std/collections"
import "std/io"
import "std/path"
import "vader/diagnostics"
import "vader/pipeline/check"
import "vader/target"
import "vader/typecheck"

/// `vader fix [--target=<os>-<arch>] <file>` — remove, in every file of `<file>`'s
/// project, the parameters' `!` the check reports as deduced or needless.
///
/// @param args  positional args ; `args[0]` is the entry `.vader` file.
/// @return      0 once every file is rewritten, 1 on a missing file or a failed
///              write, 2 on a malformed `--target`.
export cmd_fix :: fn(args: string[]) -> i32 {
    parsed :: parse_action("fix", args)
    if parsed is i32 {
        return parsed
    }
    if reject_extra_positionals("fix", parsed) {
        return 1
    }
    file :: action_file(parsed)
    if file == "" {
        eprintln("vader fix: expected a file argument")
        return 1
    }
    target_flag :: parsed.string_flag("target", "")
    target :: parse_dump_target(target_flag)
    if target is TargetParseError {
        eprintln("vader fix --target=${target_flag}: ${target.reason} `${target.fragment}`")
        return 2
    }
    include_path_flags :: parse_include_path_flag(parsed.string_flag("include-paths", ""))
    overlay :: MutableMap<string, string> {}
    checked :: check_file(file.as_string(), overlay, include_path_flags, false, target)
    bangs :: MutableMap<string, usize[]!> {}
    for d in checked.diags {
        if !removes_marker(d) {
            continue
        }
        at :: d.primary.start
        offsets :: bangs[at.file]
        if offsets == null {
            bangs[at.file] = [at.offset]
        } else {
            offsets.push(at.offset)
        }
    }
    removed := 0
    for [path, offsets] in bangs {
        source :: read_file_string(path)
        if source is IOError {
            eprintln("vader fix: cannot read ${path}")
            return 1
        }
        edit :: without_markers(source, offsets)
        if write_file_string(path, edit.text) is IOError {
            eprintln("vader fix: cannot write ${path}")
            return 1
        }
        removed += edit.removed
    }
    eprintln("vader fix: removed ${removed} `!` in ${bangs.len()} file(s)")
    return 0
}

// Whether `d` names a `!` to remove.
removes_marker :: fn(d: Diagnostic) -> bool {
    id :: d.code.id
    return id == CodeInfo(WarningCode.DeducedMutabilityMarker).id ||
        id == CodeInfo(WarningCode.NeedlessMutabilityMarker).id
}

// A source with markers removed, and how many were.
MarkerEdit :: struct {
    text: string
    removed: i32
}

// `source` with the `!` at each of `offsets` removed. An offset that does not hold a
// `!` — a file edited since the check — is left alone.
without_markers :: fn(source: string, offsets: usize[]) -> MarkerEdit {
    bytes :: source.bytes()
    drop :: MutableSet<usize> {}
    for offset in offsets {
        if offset < bytes.len() && bytes[offset] == '!' {
            _ :: drop.add(offset)
        }
    }
    out: u8[]: []
    for i in 0..<bytes.len() {
        if !(i in drop) {
            out.push(bytes[i])
        }
    }
    return MarkerEdit { .text = bytes_to_string(out), .removed = i32(drop.len()) }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_without_markers_keeps_an_offset_off_its_bang :: fn() -> void {
    edit :: without_markers("f :: fn(a: i32[]!, b: Box!)", [16, 25, 3])
    assert_eq(edit.text, "f :: fn(a: i32[], b: Box)")
}
