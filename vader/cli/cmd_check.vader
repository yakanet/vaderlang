// vader/cli/cmd_check — type-check without emitting.
//
// The compensation for compile-time target selection. A body whose `@target`
// does not match is never resolved or typed, so on any one machine the code for
// every OTHER platform is unchecked — the same blind spot the `#ifdef` walls in
// `runtime/c/` had, which is where the two Windows bugs of 2026-08 came from.
//
// This closes it, and cheaply: type-checking needs NO TOOLCHAIN, so
// `check --target=windows-x86_64` runs from a Mac with no mingw in sight. A CI
// loop over every supported target costs seconds and answers "does the Windows
// code still compile" without a Windows machine.
//
// Why not `build --dry-run`: `--dry-run` conventionally means "do everything,
// write nothing", which would still reach `cc` and fail to find a cross
// compiler. Stopping at the type-checker is the whole point, not an
// optimisation. `cargo check` draws the line in the same place.
//
// Why not `dump --stage=typed-ast`: that is an INSPECTION tool. It prints the
// AST on stdout and exits 0 whatever the diagnostics say, deliberately — you
// want to see the tree despite the errors. A gate wants the opposite: nothing on
// stdout, diagnostics on stderr, non-zero on failure. Same pipeline, opposite
// contract.

module "vader/cli"

import "std/io"
import "std/path"
import "std/string"
import "cli"
import "vader/pipeline"
import "vader/support/target"

/// `vader check [--target=<os>-<arch>] <path>`: run the front end and report.
///
/// A project folder has each entry checked, or the one `--entry` names: those of
/// its `vader.json`, or those its `build.vader` adds, the driver running its own
/// rules on the way.
///
/// @param args  positional args ; `args[0]` is the entry `.vader` file or a
///              project folder.
/// @return      0 when the front end is clean, 1 on any error-severity
///              diagnostic, a missing file or a folder that names no entry, 2 on
///              a malformed `--target` or an `--entry` given with a file.
export cmd_check :: fn(args: string[]) -> i32 {
    parsed :: parse_action("check", args)
    if parsed is i32 {
        return parsed
    }
    if reject_extra_positionals("check", parsed) {
        return 1
    }
    file :: action_file(parsed)
    if file == "" {
        eprintln("vader check: expected a file or a project folder")
        return 1
    }
    target_flag :: parsed.string_flag("target", "")
    target: Target | null = null
    if target_flag != "" {
        parsed_target :: parse_target(target_flag)
        if parsed_target is TargetParseError {
            eprintln("vader check --target=${target_flag}: ${parsed_target.reason} "
                + "`${parsed_target.fragment}`")
            return 2
        }
        if parsed_target is Target {
            target = parsed_target
        }
    }
    include_path_flags :: parse_include_path_flag(parsed.string_flag("include-paths", ""))
    selected :: parsed.string_flag("entry", "")
    input :: resolve_input("check", file, selected)
    if input is i32 {
        return input
    }
    match input {
        is FileInput -> { return exit_code_of(check_entry(input.file, include_path_flags, target, null)) }
        is ManifestProject -> {
            request :: BuildRequest { .target = target, .include_paths = include_path_flags }
            return run_manifest_project(input, selected, request, .Check)
        }
        is DrivenProject -> {
            driver_request :: DriverRequest {
                .mode = .Check,
                .selected = selected,
                .build = BuildRequest { .target = target, .include_paths = include_path_flags },
            }
            return run_build_driver("check", input.dir, driver_request)
        }
    }
}

// Run the front end and the lowering over `file`, within `project_root` (null
// for a file on its own), print what they report, and say whether nothing among
// it is an error.
check_entry :: fn(file: Path, include_path_flags: string[], target: Target | null, project_root: string | null) -> bool {
    // Lowering too, not just the front end. It needs no toolchain — it produces
    // IR, not C — and without it the gate answered "the Windows code resolves
    // and type-checks", which is not what `vader check` promises. An `await`
    // in a short-circuit operand (M5009) inside a `@target(.Windows)` body
    // passed `check` and failed the build. As for `build`, a program the front
    // end rejected is not lowered.
    le :: lower_to_entry_with(file, include_path_flags, project_root, target)
    // Diagnostics on STDERR, and stdout stays empty on success: a gate is read by
    // a script before it is read by a person.
    return flush_build_diags(le.pre_diags, le.lower_diags)
}

// 0 for a clean check, 1 when it reported an error.
exit_code_of :: fn(clean: bool) -> i32 {
    if clean {
        return 0
    }
    return 1
}
