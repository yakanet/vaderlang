// vader/fmt/comments — comment pre-scan.
//
// The lexer drops every `//` and `/* */` comment before the token stream
// reaches the parser (cf. vader/lexer/lexer.vader::consume_block_comment).
// To preserve comments across format passes we re-scan the raw source in a
// dedicated pass and build an offset-keyed map. The printer consults the
// map at every AST-node boundary and interleaves matching comments at the
// right indentation.

module "vader/fmt"


/// Classification of a scanned comment. VaderDoc is `///` only ; `/**` is
/// recognised as a plain `Block` since SPEC §3 dropped the block-form
/// doc-comment.
export CommentKind :: enum(u8) {
    Line,     // `// …`
    DocLine,  // `/// …` — VaderDoc form. Tagged at scan time so a future
              //   `vader doc` extractor can pick them out without
              //   re-walking the source. The formatter still treats them
              //   like `Line` for round-trip equality (text is verbatim).
    Block,    // `/* … */` (may contain nested `/* … */`)
}

/// One scanned comment, ready for replay by the printer.
export Comment :: struct {
    // Byte offset (inclusive) of the leading `/` in the source.
    offset:      usize
    // Byte offset (exclusive) past the comment's closing token.
    end_offset:  usize
    // 1-based source line of `offset` — used to decide leading vs trailing.
    line:        i32
    // 1-based source line where the comment ends. For line comments
    // `end_line == line` ; for block comments it tracks the closing `*/`.
    // Needed so blank-line preservation between the comment and the next
    // node doesn't misfire on multi-line block comments.
    end_line:    i32
    kind:        CommentKind
    // Verbatim source slice including delimiters. Re-emitted as-is.
    text:        string
    // A line comment with code before it on its source line : it ends that
    // line in the output too, instead of leading the node that follows.
    after_code:  bool = false
}

/// Sorted-and-cursor view of every comment in a source file. `comments`
/// is ordered by byte offset ; `cursor` points at the next un-emitted
/// comment so the printer's `take_*` methods can advance through them in
/// document order.
export CommentMap :: struct {
    comments: Comment[]
    cursor:   usize
}

/// Walk the source and collect every comment span. Mirrors the lexer's
/// classification : single-line `//` consumes to end-of-line ; block `/* */`
/// supports nesting (depth counter), like the lexer's `consume_block_comment`.
/// String literals are skipped so a `"contains // pseudo-comment"` literal
/// doesn't fool the scanner.
/// @param source source code
export scan_comments :: fn(source: string) -> CommentMap {
    out: Comment[]!: []
    sb :: source.bytes()
    n :: sb.len()
    i: usize = 0
    line: i32 = 1
    for i < n {
        b :: sb[i]

        // Newline tracking. `\n` only — CR is normalised elsewhere.
        if b == '\n' {
            line = line + 1
            i = i + 1
            continue
        }

        // `//` line comment (or `///` vaderdoc line).
        if b == '/' && i + 1 < n && sb[i + 1] == '/' {
            start :: i
            start_line :: line
            is_doc :: i + 2 < n && sb[i + 2] == '/'
            j: usize = i + 2
            for j < n && sb[j] != '\n' {
                j = j + 1
            }
            text :: sb[start..<j].bytes_to_string()
            kind: CommentKind: if is_doc { .DocLine } else { .Line }
            out.push(Comment {
                .offset     = start,
                .end_offset = j,
                .line       = start_line,
                .end_line   = start_line,
                .kind       = kind,
                .text       = text,
                .after_code = code_before_on_line(sb, start),
            })
            i = j
            continue
        }

        // `/* … */` block comment, nesting-aware. SPEC §3 dropped the
        // `/** … */` doc-comment form ; `/**` is treated as a plain block
        // comment to keep round-trip semantics for any legacy source.
        if b == '/' && i + 1 < n && sb[i + 1] == '*' {
            start :: i
            start_line :: line
            j: usize = i + 2
            depth: i32 = 1
            for j < n && depth > 0 {
                cur :: sb[j]
                if cur == '\n' {
                    line = line + 1
                    j = j + 1
                    continue
                }
                if cur == '/' && j + 1 < n && sb[j + 1] == '*' {
                    depth = depth + 1
                    j = j + 2
                    continue
                }
                if cur == '*' && j + 1 < n && sb[j + 1] == '/' {
                    depth = depth - 1
                    j = j + 2
                    continue
                }
                j = j + 1
            }
            text :: sb[start..<j].bytes_to_string()
            kind: CommentKind: .Block
            out.push(Comment {
                .offset = start,
                .end_offset = j,
                .line = start_line,
                .end_line = line,
                .kind = kind,
                .text = text,
            })
            i = j
            continue
        }

        // String literals — skip the entire span so embedded `//` / `/*` don't
        // confuse the scanner. We don't handle interpolation specially since
        // we don't care what's *inside* the literal, only the closing quote.
        if b == '"' {
            // Triple-quoted ?
            if i + 2 < n && sb[i + 1] == '"' && sb[i + 2] == '"' {
                j: usize = i + 3
                for j + 2 < n {
                    if sb[j] == '"' && sb[j + 1] == '"' && sb[j + 2] == '"' {
                        j = j + 3
                        break
                    }
                    if sb[j] == '\n' { line = line + 1 }
                    j = j + 1
                }
                i = j
                continue
            }
            // Plain `"…"`, handling escape `\"` and `\\`. The scanner doesn't
            // recurse into `${expr}` interpolation : a closing `"` inside an
            // interp expression is rare and we accept the small risk of
            // misclassification.
            j: usize = i + 1
            for j < n {
                c :: sb[j]
                if c == '\\' && j + 1 < n {
                    j = j + 2
                    continue
                }
                if c == '"' {
                    j = j + 1
                    break
                }
                if c == '\n' { line = line + 1 }
                j = j + 1
            }
            i = j
            continue
        }

        // Raw string `r"…"`.
        if b == 'r' && i + 1 < n && sb[i + 1] == '"' {
            j: usize = i + 2
            for j < n {
                c :: sb[j]
                if c == '"' {
                    j = j + 1
                    break
                }
                if c == '\n' { line = line + 1 }
                j = j + 1
            }
            i = j
            continue
        }

        // Char literal `'…'`. Same escape rules as strings.
        if b == '\'' {
            j: usize = i + 1
            for j < n {
                c :: sb[j]
                if c == '\\' && j + 1 < n {
                    j = j + 2
                    continue
                }
                if c == '\'' {
                    j = j + 1
                    break
                }
                j = j + 1
            }
            i = j
            continue
        }

        i = i + 1
    }

    return CommentMap { .comments = out, .cursor = 0 }
}

// True when a non-blank byte precedes `at` on its own line.
code_before_on_line :: fn(sb: u8[], at: usize) -> bool {
    k := at
    for k > 0 {
        k = k - 1
        c :: sb[k]
        if c == '\n'              { return false }
        if c != ' ' && c != '\t' { return true }
    }
    return false
}

// True when at least one un-emitted comment has `offset < before`. The
// printer uses this to decide whether a separator line is needed between
// the leading-comment run and the AST node that follows.
export has_before :: fn(self: CommentMap, before: usize) -> bool {
    if self.cursor >= self.comments.len() { return false }
    c :: self.comments[self.cursor]
    return c.offset < before
}

/// Source line of the first comment still queued, when it starts before
/// `before` ; null otherwise. Consumes nothing.
///
/// @param before  byte offset the comment must start before.
export first_line_before :: fn(self: CommentMap, before: usize) -> i32 | null {
    if self.cursor >= self.comments.len() {
        return null
    }
    c :: self.comments[self.cursor]
    return if c.offset < before { c.line } else { null }
}

// Return every un-emitted comment whose `offset < before` and advance the
// cursor past them. The printer calls this just before emitting each
// AST node so leading comments land at the right position.

export take_before :: fn(self: CommentMap!, before: usize) -> Comment[] {
    out: Comment[]!: []
    for self.cursor < self.comments.len() {
        c :: self.comments[self.cursor]
        if c.offset >= before { break }
        out.push(c)
        self.cursor = self.cursor + 1
    }
    return out
}

// Drain every remaining comment (used at end-of-file to flush trailing
// comments after the last decl).
export drain_remaining :: fn(self: CommentMap!) -> Comment[] {
    out: Comment[]!: []
    for self.cursor < self.comments.len() {
        out.push(self.comments[self.cursor])
        self.cursor = self.cursor + 1
    }
    return out
}
