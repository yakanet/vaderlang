// vader/core/bytecode/intrinsic_manifest: the host-intrinsic identity.
//
// `IntrinsicId` names every host: THE single classification both backends
// (`vm/host::dispatch_import`, `emit/c/host::import_shim`) dispatch on, so the two
// can't drift and a new host trips T3013 at both sites. A host called through
// `std/core`'s `Intrinsic` is found by its member's name (`host_for`), one still
// declared by a bodyless `@intrinsic` function by its mangled name
// (`intrinsic_id_for`), computed through the mangler (`vader/core/mangle`): no
// mangled name is spelled here.
//
// The arith / buffer bytecode-op table is the selection module's
// (`vader/midir/select/intrinsics.vader`): which op a host lowers to is a choice of
// the emitter, not part of the format.

module "vader/core/bytecode"

import "std/collections"
import "std/string"
import "vader/core/mangle"
import "vader/core/symbol"
import "vader/core/types"

// ---- host intrinsic identity ----------------------------------------------

/// The member of `std/core`'s `Intrinsic` a host is called through ; `""` for a
/// host still declared by a bodyless `@intrinsic` function.
export HostMember :: struct {
    member: string
}

/// Identity of a host: named by its member of `std/core`'s `Intrinsic`
/// (`host_for`), or for a host still declared by a bodyless `@intrinsic`
/// function, by its mangled name (`intrinsic_id_for`). THE single classification
/// the two backends (`vm/host::dispatch_import`, `emit/c/host::import_shim`)
/// dispatch on, so the two can't drift. The union of what either backend serves:
/// a backend that doesn't serve a variant handles it in a grouped fallthrough
/// arm, but the exhaustive `match` forces that to be a conscious decision (a new
/// variant here trips T3013 at both sites).
export IntrinsicId :: enum(HostMember) {
    NotIntrinsic            { .member = "" },
    // std/core string + bytes
    ByteLen                 { .member = "byte_len" },
    ByteAt                  { .member = "byte_at" },
    ByteSlice               { .member = "byte_slice" },
    IsAscii                 { .member = "is_ascii" },
    Bytes                   { .member = "bytes" },
    BytesToString           { .member = "bytes_to_string" },
    StringHash              { .member = "string_hash" },
    // std/core values
    DeepCopy                { .member = "" },
    // std/runtime
    RuntimeCollect          { .member = "collect" },
    RuntimeCollections      { .member = "collections" },
    RuntimeBytesUsed        { .member = "bytes_used" },
    RuntimeBytesCopied      { .member = "bytes_copied" },
    RuntimeAllocatedBytes   { .member = "allocated_bytes" },
    RuntimeAllocations      { .member = "allocations" },
    RuntimeCountAllocations { .member = "count_allocations" },
    // std/runtime/scheduler
    SchedulerSpawn          { .member = "spawn_thread" },
    SchedulerPark           { .member = "park" },
    SchedulerWake           { .member = "wake" },
    SchedulerSleepFor       { .member = "sleep_for" },
    SchedulerCancel         { .member = "cancel_thread" },
    SchedulerCurrent        { .member = "current_thread" },
    SchedulerIsCancelled    { .member = "is_cancelled" },
    SchedulerIsLeaving      { .member = "is_leaving" },
    SchedulerWatchReadable  { .member = "watch_readable" },
    SchedulerWatchExit      { .member = "watch_exit" },
    // std/runtime/wait: a read or a write that parks while another thread runs
    WaitReadable            { .member = "wait_readable" },
    WaitReadableFor         { .member = "wait_readable_for" },
    WaitWritable            { .member = "wait_writable" },
    WaitWritableFor         { .member = "wait_writable_for" },
    WaitStop                { .member = "stop_waiting" },
    // std/abort
    AbortPanic              { .member = "panic" },
    // std/target: the OS the process is RUNNING on, not the one it was built
    // for. `VADER_OS` answers the latter and is a baked constant, not a host.
    TargetCurrentOs         { .member = "current_os" },
    TargetCurrentArch       { .member = "current_arch" },
    // vader/vm: dynamic foreign calls, the VM's answer to `@extern`. NOT in
    // `std/`: they amount to running arbitrary native code.
    FfiOpen                 { .member = "ffi_open" },
    FfiOpenPath             { .member = "ffi_open_path" },
    FfiSymbol               { .member = "ffi_symbol" },
    FfiCall                 { .member = "ffi_call" },
    FfiCallFrame            { .member = "ffi_call_frame" },
}

/// Classify the mangled name of a host still declared by a bodyless `@intrinsic`
/// function (`deep_copy` and its instances) into its `IntrinsicId`, or
/// `NotIntrinsic` when it isn't one (e.g. an `@extern` symbol, or a host called
/// through `Intrinsic`, which `host_for` finds by its member).
///
/// @param mangled  the import's mangled name (`BcImport.mangled_name`).
export intrinsic_id_for :: fn(mangled: string) -> IntrinsicId =
    if copies_deep(mangled) { .DeepCopy } else { .NotIntrinsic }

/// The host a bodyless declaration calls: the one its member of `std/core`'s
/// `Intrinsic` names, else for a host still declared by a bodyless `@intrinsic`
/// function, the one its mangled name classifies (`intrinsic_id_for`).
///
/// @param member   the member of `Intrinsic` it names (`LoweredFnDecl.intrinsic`),
///                 `""` for none.
/// @param mangled  its mangled name.
export host_for :: fn(member: string, mangled: string) -> IntrinsicId =
    HOSTS_BY_MEMBER[member] else intrinsic_id_for(mangled)

/// The host an import calls: none for an `@extern`, else `host_for`. What the
/// emitter sets and what a `.virt` re-read restores.
///
/// @param is_extern  whether the import is an `@extern`.
/// @param member     the member of `Intrinsic` it names, `""` for none.
/// @param mangled    its mangled name.
export import_host :: fn(is_extern: bool, member: string, mangled: string) -> IntrinsicId {
    if is_extern {
        return .NotIntrinsic
    }
    return host_for(member, mangled)
}

/// The member of `Intrinsic` that names the host `id` ; `""` for none.
///
/// @param id  a host.
export host_member :: fn(id: IntrinsicId) -> string = HostMember(id).member

/// How a message names the host `id` an import of `mangled` calls: as the member
/// of `Intrinsic` a program wrote, `Intrinsic.current_os`, else by `mangled`.
///
/// @param id       the host.
/// @param mangled  the import's mangled name.
export display_host :: fn(id: IntrinsicId, mangled: string) -> string {
    member :: host_member(id)
    if member == "" {
        return mangled
    }
    return "${TRAIT_INTRINSIC}.${member}"
}

// Every host a member of `Intrinsic` names, by the member's name.
HOSTS_BY_MEMBER: Map<string, IntrinsicId>: @comptime {
    out :: Map<string, IntrinsicId> {}
    for id in IntrinsicId {
        member :: host_member(id)
        if member != "" {
            out[member] = id
        }
    }
    return out
}

// Whether `mangled` names `deep_copy`, or one of its instances: it takes one
// host per type it copies.
copies_deep :: fn(mangled: string) = mangled == DEEP_COPY || mangled.starts_with(DEEP_COPY_INSTANCES)

// The host of `deep_copy`, and what its instances at a given type start with.
DEEP_COPY :: @comptime declaration_mangle(CORE_MODULE, "deep_copy")
DEEP_COPY_INSTANCES :: @comptime instance_prefix(DEEP_COPY)

/// Whether a call to host `id` can trigger a collection: the question
/// `c_emit`'s `compute_may_alloc` asks of every op to decide which fns need a
/// GC frame. `false` is a promise that the native implementation never reaches
/// `vader_gc_alloc`: a fn whose only safepoint would be this call skips its
/// shadow-stack frame, so a wrong `false` leaves live refs unrooted across a
/// collection.
///
/// Not the question `vm/host`'s `comptime_refusal` answers, which is whether a
/// comptime evaluation may call the host: `current_os` depends on the machine
/// and never collects, `bytes` depends on nothing and allocates.
///
/// @param id  the host, from `host_for`.
export intrinsic_may_collect :: fn(id: IntrinsicId) -> bool = match id {
    // Reads of the atom (`vader.h`, `runtime/c/rt/atoms.c`): its length, one byte,
    // the hash and the ASCII flag set at intern.
    .ByteLen | .ByteAt | .StringHash | .IsAscii -> false
    // A slice of the atom takes an atom-table slot, grown by `realloc`.
    .ByteSlice -> false
    // Make a stack, queue a thread, read a handle or a flag, or note a watch:
    // `malloc`, `mmap` and the OS, never the collector.
    .SchedulerSpawn | .SchedulerWake | .SchedulerCurrent | .SchedulerIsCancelled -> false
    .SchedulerIsLeaving | .SchedulerWatchReadable | .SchedulerWatchExit | .WaitStop -> false
    // Other threads run, and collect, before these return.
    .SchedulerPark | .SchedulerSleepFor | .SchedulerCancel -> true
    .WaitReadable | .WaitReadableFor | .WaitWritable | .WaitWritableFor -> true
    // Constants of the runtime's own build.
    .TargetCurrentOs | .TargetCurrentArch -> false
    // Allocate: a view header, an interned string, the rendered text, a copy.
    .Bytes | .BytesToString | .DeepCopy -> true
    // Unclassified: conservatively a safepoint.
    .RuntimeCollect | .RuntimeCollections | .RuntimeBytesUsed | .RuntimeBytesCopied -> true
    .RuntimeAllocatedBytes | .RuntimeAllocations | .RuntimeCountAllocations -> true
    .AbortPanic -> true
    .FfiOpen | .FfiOpenPath | .FfiSymbol | .FfiCall | .FfiCallFrame | .NotIntrinsic -> true
}

/// Whether a call to host `id` can shorten an array of the program: the question
/// midir's call summaries ask of a host function no op serves
/// (`vader/midir/array_shrink.vader`). `false` lets the range analysis keep the
/// lengths it knows across the call, so a wrong `false` lets an index go
/// unchecked against an array that got shorter.
///
/// @param id  the host, from `host_for`.
export intrinsic_may_shorten_array :: fn(id: IntrinsicId) -> bool = match id {
    // Read a string or a primitive, or build a fresh value from one.
    .ByteLen | .ByteAt | .ByteSlice | .IsAscii | .StringHash -> false
    .Bytes | .BytesToString -> false
    // A copy is a fresh value: the copied one is only read.
    .DeepCopy -> false
    // The collector moves objects and never changes a length; the rest only read.
    .RuntimeCollect | .RuntimeCollections | .RuntimeBytesUsed | .RuntimeBytesCopied -> false
    .RuntimeAllocatedBytes | .RuntimeAllocations | .RuntimeCountAllocations -> false
    // Nothing runs before they return.
    .SchedulerSpawn | .SchedulerWake | .SchedulerCurrent | .SchedulerIsCancelled -> false
    .SchedulerIsLeaving | .SchedulerWatchReadable | .SchedulerWatchExit | .WaitStop -> false
    // Other threads run before these return, and may shorten any array they
    // reach.
    .SchedulerPark | .SchedulerSleepFor | .SchedulerCancel -> true
    .WaitReadable | .WaitReadableFor | .WaitWritable | .WaitWritableFor -> true
    // Constants of the build ; `panic` never returns.
    .TargetCurrentOs | .TargetCurrentArch | .AbortPanic -> false
    // Foreign code is lent a buffer, never the header that holds its length.
    .FfiOpen | .FfiOpenPath | .FfiSymbol | .FfiCall | .FfiCallFrame -> false
    // Unrecognised: conservatively may.
    .NotIntrinsic -> true
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_the_impls_of_the_primitives_are_no_hosts :: fn() -> void {
    assert(intrinsic_id_for(r"std_core$i32$Equals$equals") == .NotIntrinsic, "i32 equals")
    assert(intrinsic_id_for(r"std_core$string$Hash$hash") == .NotIntrinsic, "string hash")
    assert(intrinsic_id_for(r"std_core$u8$Display$to_string") == .NotIntrinsic, "u8 display")
}

@test test_hosts_and_members_name_each_other :: fn() -> void {
    for id in IntrinsicId {
        member :: host_member(id)
        if member != "" {
            assert(host_for(member, "") == id, member)
        }
    }
    assert(host_for("no_such_member", "") == .NotIntrinsic, "an unknown member")
}

@test test_intrinsic_may_collect :: fn() -> void {
    member_collects :: (member: string) -> intrinsic_may_collect(host_for(member, ""))
    assert(!member_collects("byte_at"), "a byte read never collects")
    assert(!member_collects("string_hash"), "the hash is cached on the atom")
    assert(member_collects("bytes"), "a view allocates its header")
    assert(intrinsic_may_collect(intrinsic_id_for(r"user_mod$foo")), "an unknown host stays a safepoint")
}

@test test_intrinsic_id_for :: fn() -> void {
    // `std_console$write` is deliberately absent: it is ordinary Vader now, written
    // over `sys/io::sys_write`.
    assert(intrinsic_id_for(r"std_console$write") == .NotIntrinsic, "console write is no longer a host")
    // Same shape: `std/math` became `@extern`, so re-adding a Math variant would
    // silently route it back through `dispatch_import` while the declaration says
    // otherwise: an import neither backend serves.
    assert(intrinsic_id_for(r"std_math$sqrt") == .NotIntrinsic, "math sqrt is no longer a host")
    assert(intrinsic_id_for(r"user_mod$foo") == .NotIntrinsic, "unknown -> NotIntrinsic")
    assert(intrinsic_id_for(r"std_core$deep_copy__snippet_Shape") == .DeepCopy, "deep copy instance")
    assert(intrinsic_id_for(r"std_core$deep_copy_tree") == .NotIntrinsic, "a longer name is another fn")
}
