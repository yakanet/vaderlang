// vader/core/bytecode/intrinsic_manifest: each member of `Intrinsic`.
//
// `IntrinsicId` names every member of `std/core`'s `Intrinsic`, found by the
// member's name (`intrinsic_id`). The compiler serves each in code of its own:
// the op selection (`vader/midir/select/intrinsics.vader`) maps a member to its
// op, and the lowering turns the array members into nodes
// (`vader/lower/intrinsic_member.vader`). Both decide for every member by an
// exhaustive `match`, so a new one trips T3013 there, as in the effect summary.
//
// No call to a member survives the selection, so nothing asks what may happen
// during one: the services a backend serves are `Runtime`'s
// (`runtime_service.vader`).

module "vader/core/bytecode"

import "std/collections"

/// The member of `std/core`'s `Intrinsic` a variant names.
export IntrinsicMember :: struct {
    member: string
}

/// The members of `std/core`'s `Intrinsic` (`intrinsic_id`).
export IntrinsicId :: enum(IntrinsicMember) {
    // std/core strings: reads of the atom, and the comparison of two.
    ByteLen       { .member = "byte_len" },
    ByteAt        { .member = "byte_at" },
    ByteSlice     { .member = "byte_slice" },
    IsAscii       { .member = "is_ascii" },
    StringHash    { .member = "string_hash" },
    StringCompare { .member = "string_compare" },
    // std/core floats: the bits reinterpreted.
    F64ToBits { .member = "f64_to_bits" },
    BitsToF64 { .member = "bits_to_f64" },
    F32ToBits { .member = "f32_to_bits" },
    BitsToF32 { .member = "bits_to_f32" },
    // std/core arrays: lowered as typed nodes.
    ArrayLen        { .member = "array_len" },
    ArrayPush       { .member = "array_push" },
    ArrayPushAll    { .member = "array_push_all" },
    ArrayCopyTo     { .member = "array_copy_to" },
    ArrayRemoveLast { .member = "array_remove_last" },
    ArrayClear      { .member = "array_clear" },
    // std/core buffer: the Target ABI memory opcodes.
    NewByteBuffer      { .member = "new_byte_buffer" },
    BufferLoadU8       { .member = "buffer_load_u8" },
    BufferStoreU8      { .member = "buffer_store_u8" },
    BufferMemoryCopy   { .member = "buffer_memory_copy" },
    BufferInternString { .member = "buffer_intern_string" },
    BufferWriteString  { .member = "buffer_write_string" },
}

/// The member `member` of `std/core`'s `Intrinsic` ; null for none.
///
/// @param member  the member's name (`LoweredFnDecl.intrinsic`), `""` for none.
export intrinsic_id :: fn(member: string) -> IntrinsicId | null = IDS_BY_MEMBER[member]

/// The member of `Intrinsic` an import names: none for an `@extern`, else
/// `intrinsic_id`. What the emitter sets and what a `.virt` re-read restores.
///
/// @param is_extern  whether the import is an `@extern`.
/// @param member     the member it names, `""` for none.
export import_intrinsic :: fn(is_extern: bool, member: string) -> IntrinsicId | null {
    if is_extern {
        return null
    }
    return intrinsic_id(member)
}

/// The name of the member `id`.
///
/// @param id  a member of `Intrinsic`.
export member_name :: fn(id: IntrinsicId) -> string = IntrinsicMember(id).member

// Every member of `Intrinsic`, by its name.
IDS_BY_MEMBER: Map<string, IntrinsicId>: @comptime {
    out :: Map<string, IntrinsicId> {}
    for id in IntrinsicId {
        out[member_name(id)] = id
    }
    return out
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_ids_and_members_name_each_other :: fn() -> void {
    for id in IntrinsicId {
        member :: member_name(id)
        assert(intrinsic_id(member) == id, member)
    }
    assert(intrinsic_id("no_such_member") == null, "an unknown member")
    assert(intrinsic_id("") == null, "no member")
}

// A member is an op or a service, never both: a lowered declaration names its
// member by name alone (`LoweredFnDecl.intrinsic`).
@test
test_no_member_is_both_an_op_and_a_service :: fn() -> void {
    for id in IntrinsicId {
        member :: member_name(id)
        assert(runtime_service(member) == null, member)
    }
}
