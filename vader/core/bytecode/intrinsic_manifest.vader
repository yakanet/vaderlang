// vader/core/bytecode/intrinsic_manifest: the identity of each member of `Intrinsic`.
//
// `IntrinsicId` names every member of `std/core`'s `Intrinsic`, found by the
// member's name (`intrinsic_id`). Every reader that must know a member decides
// for each by an exhaustive `match`, so a new member trips T3013 at each: the two
// backends (`vm/host::dispatch_import`, `emit/c/host::import_shim`), the op
// selection (`vader/midir/select/intrinsics.vader`), the lowering of the array
// members, the effect summary, and the questions below.
//
// Which op a member lowers to is the selection module's choice, not part of the
// format.

module "vader/core/bytecode"

import "std/collections"
import "vader/core/types"

// ---- member identity -------------------------------------------------------

/// The member of `std/core`'s `Intrinsic` a variant names ; `""` for none
/// (`NotIntrinsic`).
export MemberName :: struct {
    member: string
}

/// Identity of a member of `std/core`'s `Intrinsic` (`intrinsic_id`). A member a
/// host serves reaches the backends as an import ; one an op serves never does,
/// and the backends' `match` groups those in one arm.
export IntrinsicId :: enum(MemberName) {
    NotIntrinsic            { .member = "" },
    // std/core string + bytes
    ByteLen                 { .member = "byte_len" },
    ByteAt                  { .member = "byte_at" },
    ByteSlice               { .member = "byte_slice" },
    IsAscii                 { .member = "is_ascii" },
    Bytes                   { .member = "bytes" },
    BytesToString           { .member = "bytes_to_string" },
    StringHash              { .member = "string_hash" },
    // std/core: served by an op of their own
    StringCompare           { .member = "string_compare" },
    F64ToBits               { .member = "f64_to_bits" },
    BitsToF64               { .member = "bits_to_f64" },
    F32ToBits               { .member = "f32_to_bits" },
    BitsToF32               { .member = "bits_to_f32" },
    // std/core values
    DeepCopy                { .member = "deep_copy" },
    // std/core arrays: lowered as typed nodes, never a call
    ArrayLen                { .member = "array_len" },
    ArrayPush               { .member = "array_push" },
    ArrayPushAll            { .member = "array_push_all" },
    ArrayCopyTo             { .member = "array_copy_to" },
    ArrayRemoveLast         { .member = "array_remove_last" },
    ArrayClear              { .member = "array_clear" },
    // std/core buffer: the Target ABI memory opcodes
    NewByteBuffer           { .member = "new_byte_buffer" },
    BufferLoadU8            { .member = "buffer_load_u8" },
    BufferStoreU8           { .member = "buffer_store_u8" },
    BufferMemoryCopy        { .member = "buffer_memory_copy" },
    BufferInternString      { .member = "buffer_intern_string" },
    BufferWriteString       { .member = "buffer_write_string" },
    // std/runtime
    RuntimeCollect          { .member = "collect" },
    RuntimeCollections      { .member = "collections" },
    RuntimeBytesUsed        { .member = "bytes_used" },
    RuntimeBytesCopied      { .member = "bytes_copied" },
    RuntimeAllocatedBytes   { .member = "allocated_bytes" },
    RuntimeAllocations      { .member = "allocations" },
    RuntimeCountAllocations { .member = "count_allocations" },
    // std/runtime/scheduler
    SchedulerSpawn          { .member = "spawn_thread" },
    SchedulerPark           { .member = "park" },
    SchedulerWake           { .member = "wake" },
    SchedulerSleepFor       { .member = "sleep_for" },
    SchedulerCancel         { .member = "cancel_thread" },
    SchedulerCurrent        { .member = "current_thread" },
    SchedulerIsCancelled    { .member = "is_cancelled" },
    SchedulerIsLeaving      { .member = "is_leaving" },
    SchedulerTaskEnded      { .member = "task_ended" },
    SchedulerWatchReadable  { .member = "watch_readable" },
    SchedulerWatchExit      { .member = "watch_exit" },
    SchedulerMonitorEnter   { .member = "monitor_enter" },
    SchedulerMonitorGive    { .member = "monitor_give" },
    SchedulerMonitorExit    { .member = "monitor_exit" },
    SchedulerPublish        { .member = "publish" },
    SchedulerMutexLock      { .member = "mutex_lock" },
    SchedulerMutexUnlock    { .member = "mutex_unlock" },
    SchedulerMutexWait      { .member = "mutex_wait" },
    // std/runtime/wait: a read or a write that parks while another thread runs
    WaitReadable            { .member = "wait_readable" },
    WaitReadableFor         { .member = "wait_readable_for" },
    WaitWritable            { .member = "wait_writable" },
    WaitWritableFor         { .member = "wait_writable_for" },
    WaitBlockedReadFor      { .member = "wait_blocked_read_for" },
    WaitBlockedWriteFor     { .member = "wait_blocked_write_for" },
    WaitStop                { .member = "stop_waiting" },
    // std/core: the stream or the future a component function returns, which
    // only a WASM build reads
    WasmStreamRead          { .member = "wasm_stream_read" },
    WasmFutureWait          { .member = "wasm_future_wait" },
    // std/abort
    AbortPanic              { .member = "panic" },
    // std/target: the OS the process is RUNNING on, not the one it was built
    // for. `VADER_OS` answers the latter and is a baked constant, not a host.
    TargetCurrentOs         { .member = "current_os" },
    TargetCurrentArch       { .member = "current_arch" },
    // vader/vm: dynamic foreign calls, the VM's answer to `@extern`. NOT in
    // `std/`: they amount to running arbitrary native code.
    FfiOpen                 { .member = "ffi_open" },
    FfiOpenPath             { .member = "ffi_open_path" },
    FfiSymbol               { .member = "ffi_symbol" },
    FfiCall                 { .member = "ffi_call" },
    FfiCallFrame            { .member = "ffi_call_frame" },
}

/// The member `member` of `std/core`'s `Intrinsic` ; `NotIntrinsic` for none.
///
/// @param member  the member's name (`LoweredFnDecl.intrinsic`), `""` for none.
export intrinsic_id :: fn(member: string) -> IntrinsicId = IDS_BY_MEMBER[member] else .NotIntrinsic

/// The member of `Intrinsic` an import calls: none for an `@extern`, else
/// `intrinsic_id`. What the emitter sets and what a `.virt` re-read restores.
///
/// @param is_extern  whether the import is an `@extern`.
/// @param member     the member of `Intrinsic` it names, `""` for none.
export import_intrinsic :: fn(is_extern: bool, member: string) -> IntrinsicId {
    if is_extern {
        return .NotIntrinsic
    }
    return intrinsic_id(member)
}

/// The name of the member `id` ; `""` for none.
///
/// @param id  a member of `Intrinsic`.
export member_name :: fn(id: IntrinsicId) -> string = MemberName(id).member

/// How a message names the member `id`, as a program writes it:
/// `Intrinsic.current_os`.
///
/// @param id  a member other than `NotIntrinsic`.
export display_intrinsic :: fn(id: IntrinsicId) -> string = "${TRAIT_INTRINSIC}.${member_name(id)}"

// Every member of `Intrinsic`, by its name.
IDS_BY_MEMBER: Map<string, IntrinsicId>: @comptime {
    out :: Map<string, IntrinsicId> {}
    for id in IntrinsicId {
        member :: member_name(id)
        if member != "" {
            out[member] = id
        }
    }
    return out
}

/// Whether a call to the member `id` can trigger a collection: the question
/// `c_emit`'s `compute_may_alloc` asks of every op to decide which fns need a
/// GC frame. `false` is a promise that the native implementation never reaches
/// `vader_gc_alloc`: a fn whose only safepoint would be this call skips its
/// shadow-stack frame, so a wrong `false` leaves live refs unrooted across a
/// collection.
///
/// Not the question `vm/host`'s `comptime_refusal` answers, which is whether a
/// comptime evaluation may call the host: `current_os` depends on the machine
/// and never collects, `bytes` depends on nothing and allocates.
///
/// @param id  the member, from `intrinsic_id`.
export intrinsic_may_collect :: fn(id: IntrinsicId) -> bool = match id {
    // Reads of the atom (`vader.h`, `runtime/c/rt/atoms.c`): its length, one byte,
    // the hash and the ASCII flag set at intern.
    .ByteLen | .ByteAt | .StringHash | .IsAscii -> false
    // A slice of the atom takes an atom-table slot, grown by `realloc`.
    .ByteSlice -> false
    // Make a stack, queue a thread, read a handle or a flag, or note a watch:
    // `malloc`, `mmap` and the OS, never the collector.
    .SchedulerSpawn | .SchedulerWake | .SchedulerCurrent | .SchedulerIsCancelled -> false
    .SchedulerIsLeaving | .SchedulerWatchReadable | .SchedulerWatchExit | .WaitStop -> false
    .SchedulerTaskEnded -> false
    // Let the monitor go and allocate in the young generation again.
    .SchedulerMonitorExit -> false
    // Other threads run, and collect, before these return ; taking the monitor
    // to publish, or to give a value that reaches the young generation, first
    // empties the young generation of the worker.
    .SchedulerMonitorEnter | .SchedulerMonitorGive -> true
    // Publishing empties the young generation of the worker ; a worker that
    // waits for a mutex counts as stopped, and a major runs meanwhile.
    .SchedulerPublish | .SchedulerMutexLock -> true
    .SchedulerMutexUnlock -> false
    .SchedulerPark | .SchedulerSleepFor | .SchedulerCancel | .SchedulerMutexWait -> true
    .WaitReadable | .WaitReadableFor | .WaitWritable | .WaitWritableFor -> true
    .WaitBlockedReadFor | .WaitBlockedWriteFor -> true
    // Wait for the host, then make the array or the value read.
    .WasmStreamRead | .WasmFutureWait -> true
    // Constants of the runtime's own build.
    .TargetCurrentOs | .TargetCurrentArch -> false
    // Allocate: a view header, an interned string, the rendered text, a copy.
    .Bytes | .BytesToString | .DeepCopy -> true
    // Unclassified: conservatively a safepoint.
    .RuntimeCollect | .RuntimeCollections | .RuntimeBytesUsed | .RuntimeBytesCopied -> true
    .RuntimeAllocatedBytes | .RuntimeAllocations | .RuntimeCountAllocations -> true
    .AbortPanic -> true
    .FfiOpen | .FfiOpenPath | .FfiSymbol | .FfiCall | .FfiCallFrame | .NotIntrinsic -> true
    // Served by an op, which answers for itself: never called through an import.
    .StringCompare | .F64ToBits | .BitsToF64 | .F32ToBits | .BitsToF32
        | .ArrayLen | .ArrayPush | .ArrayPushAll | .ArrayCopyTo | .ArrayRemoveLast | .ArrayClear
        | .NewByteBuffer | .BufferLoadU8 | .BufferStoreU8 | .BufferMemoryCopy
        | .BufferInternString | .BufferWriteString -> true
}

/// Whether a call to the member `id` can shorten an array of the program: the question
/// midir's call summaries ask of a host function no op serves
/// (`vader/midir/array_shrink.vader`). `false` lets the range analysis keep the
/// lengths it knows across the call, so a wrong `false` lets an index go
/// unchecked against an array that got shorter.
///
/// @param id  the member, from `intrinsic_id`.
export intrinsic_may_shorten_array :: fn(id: IntrinsicId) -> bool = match id {
    // Read a string or a primitive, or build a fresh value from one.
    .ByteLen | .ByteAt | .ByteSlice | .IsAscii | .StringHash -> false
    .Bytes | .BytesToString -> false
    // A copy is a fresh value: the copied one is only read.
    .DeepCopy -> false
    // The collector moves objects and never changes a length; the rest only read.
    .RuntimeCollect | .RuntimeCollections | .RuntimeBytesUsed | .RuntimeBytesCopied -> false
    .RuntimeAllocatedBytes | .RuntimeAllocations | .RuntimeCountAllocations -> false
    // Nothing runs before they return.
    .SchedulerSpawn | .SchedulerWake | .SchedulerCurrent | .SchedulerIsCancelled -> false
    .SchedulerIsLeaving | .SchedulerWatchReadable | .SchedulerWatchExit | .WaitStop -> false
    .SchedulerTaskEnded -> false
    // No other thread of the worker runs while it waits for the monitor.
    .SchedulerMonitorEnter | .SchedulerMonitorGive | .SchedulerMonitorExit -> false
    .SchedulerPublish | .SchedulerMutexLock | .SchedulerMutexUnlock -> false
    // Other threads run before these return, and may shorten any array they
    // reach.
    .SchedulerPark | .SchedulerSleepFor | .SchedulerCancel | .SchedulerMutexWait -> true
    .WaitReadable | .WaitReadableFor | .WaitWritable | .WaitWritableFor -> true
    .WaitBlockedReadFor | .WaitBlockedWriteFor -> true
    .WasmStreamRead | .WasmFutureWait -> true
    // Constants of the build ; `panic` never returns.
    .TargetCurrentOs | .TargetCurrentArch | .AbortPanic -> false
    // Foreign code is lent a buffer, never the header that holds its length.
    .FfiOpen | .FfiOpenPath | .FfiSymbol | .FfiCall | .FfiCallFrame -> false
    // Unrecognised: conservatively may.
    .NotIntrinsic -> true
    // Served by an op, which answers for itself (`op_shortens_array`): never
    // called through an import.
    .StringCompare | .F64ToBits | .BitsToF64 | .F32ToBits | .BitsToF32
        | .ArrayLen | .ArrayPush | .ArrayPushAll | .ArrayCopyTo | .ArrayRemoveLast | .ArrayClear
        | .NewByteBuffer | .BufferLoadU8 | .BufferStoreU8 | .BufferMemoryCopy
        | .BufferInternString | .BufferWriteString -> true
}

/// Whether a call to the member `id` parks the thread that makes it until something
/// wakes it: what the task check asks of a function that only forwards to a member
/// (`vader/front/effects/task_primitives.vader`). A wrong `false` hides the parks of
/// a block holding a lock.
///
/// @param id  the member, from `intrinsic_id`.
export intrinsic_parks :: fn(id: IntrinsicId) -> bool = match id {
    .SchedulerPark | .SchedulerSleepFor | .SchedulerMutexWait -> true
    .WaitReadable | .WaitReadableFor | .WaitWritable | .WaitWritableFor -> true
    .WaitBlockedReadFor | .WaitBlockedWriteFor -> true
    // A wait for the host.
    .WasmStreamRead | .WasmFutureWait -> true
    // Cancelling another thread returns at once ; cancelling the running one never
    // returns.
    .SchedulerCancel -> false
    .SchedulerSpawn | .SchedulerWake | .SchedulerCurrent | .SchedulerIsCancelled -> false
    .SchedulerIsLeaving | .SchedulerWatchReadable | .SchedulerWatchExit | .WaitStop -> false
    .SchedulerTaskEnded -> false
    // A wait for the monitor or a mutex blocks the worker, it parks no thread.
    .SchedulerMonitorEnter | .SchedulerMonitorGive | .SchedulerMonitorExit -> false
    .SchedulerPublish | .SchedulerMutexLock | .SchedulerMutexUnlock -> false
    .ByteLen | .ByteAt | .ByteSlice | .IsAscii | .StringHash | .Bytes | .BytesToString -> false
    .DeepCopy | .AbortPanic | .TargetCurrentOs | .TargetCurrentArch -> false
    .RuntimeCollect | .RuntimeCollections | .RuntimeBytesUsed | .RuntimeBytesCopied -> false
    .RuntimeAllocatedBytes | .RuntimeAllocations | .RuntimeCountAllocations -> false
    .FfiOpen | .FfiOpenPath | .FfiSymbol | .FfiCall | .FfiCallFrame | .NotIntrinsic -> false
    .StringCompare | .F64ToBits | .BitsToF64 | .F32ToBits | .BitsToF32
        | .ArrayLen | .ArrayPush | .ArrayPushAll | .ArrayCopyTo | .ArrayRemoveLast | .ArrayClear
        | .NewByteBuffer | .BufferLoadU8 | .BufferStoreU8 | .BufferMemoryCopy
        | .BufferInternString | .BufferWriteString -> false
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_ids_and_members_name_each_other :: fn() -> void {
    for id in IntrinsicId {
        member :: member_name(id)
        if member != "" {
            assert(intrinsic_id(member) == id, member)
        }
    }
    assert(intrinsic_id("no_such_member") == .NotIntrinsic, "an unknown member")
    assert(intrinsic_id("") == .NotIntrinsic, "no member")
}

@test test_intrinsic_may_collect :: fn() -> void {
    member_collects :: (member: string) -> intrinsic_may_collect(intrinsic_id(member))
    assert(!member_collects("byte_at"), "a byte read never collects")
    assert(!member_collects("string_hash"), "the hash is cached on the atom")
    assert(member_collects("bytes"), "a view allocates its header")
    assert(intrinsic_may_collect(.NotIntrinsic), "no member stays a safepoint")
}

@test
test_intrinsic_parks_on_a_wait_and_not_on_a_cancel :: fn() -> void {
    assert(intrinsic_parks(.WaitReadableFor), "a wait with a deadline parks")
    assert(intrinsic_parks(.SchedulerSleepFor), "a sleep parks")
    assert(!intrinsic_parks(.SchedulerCancel), "a cancel returns at once")
}
