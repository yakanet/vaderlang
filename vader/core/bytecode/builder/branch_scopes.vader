// vader/core/bytecode/builder/branch_scopes — label-keyed scope stack and branch
// wiring.
//
// Two producers fill a function's jump table from a labelled scope stack:
// `builder.vader` building a body op by op, and `text/virt_reader.vader`
// replaying a `.virt` dump. The shared state is three arrays plus two cursors, so these take
// those directly rather than a carrier struct — `FunctionBuilder` and
// `ParserState` each keep their own fields and pass them in.
//
// `emit/bytecode/emit.vader` has a sibling that resolves by `BlockId` and prefers loop
// scopes on a tie: a different rule, not a copy of this one.

module "vader/core/bytecode/builder"

import "vader/core/bytecode"

/// Append `entry` to the grow-only `scopes` array at `sp_box[0]` and advance
/// the cursor. Reuses an already-allocated slot when one is available
/// (cursor < array length), saving an allocation per push for the second and
/// subsequent functions in a module.
///
/// @param scopes  the grow-only scope stack (shared across functions).
/// @param sp_box  1-element cursor — `[0]` is the logical top index.
/// @param entry   the scope to push.
export push_scope :: fn(scopes: ScopeEntry[], sp_box: i64[], entry: ScopeEntry) -> void {
    sp :: sp_box[0]
    if sp == scopes.len() {
        scopes.push(entry)
    } else {
        scopes[sp] = entry
    }
    sp_box[0] += 1
}

/// Wire one `br` / `br_if` against the innermost scope carrying `label`.
///
/// A loop label resolves immediately — its opener pc is known. A `block` / `if`
/// / `else` label targets a pc that does not exist yet, so the branch is
/// deferred to `drain_pending`. An unmatched label is left unwired: the caller
/// has already reported the malformed input.
///
/// @param scopes      the scope stack.
/// @param scope_sp    1-element scope cursor.
/// @param table       the jump table being filled.
/// @param pending     the pending-branch list.
/// @param pending_sp  1-element pending cursor.
/// @param label       the label the branch names.
/// @param pc          pc of the branch op.
export defer_or_resolve_branch :: fn(scopes: ScopeEntry[], scope_sp: i64[], table: i32[],
                                    pending: PendingBranch[], pending_sp: i64[],
                                    label: string, pc: i32) -> void {
    // Innermost match wins — walk down from the top of the stack.
    i := scope_sp[0] - 1
    for i >= 0 {
        if scopes[i].label == label {
            break
        }
        i -= 1
    }
    if i < 0 {
        return
    }
    target :: scopes[i]
    if target.is_loop {
        table[pc] = target.opener_pc + 1
        return
    }
    psp :: pending_sp[0]
    entry :: PendingBranch { .branch_pc = pc, .target_label = label }
    if psp == pending.len() {
        pending.push(entry)
    } else {
        pending[psp] = entry
    }
    pending_sp[0] += 1
}

/// When a scope ends, fill in every pending branch that named it. Branches
/// that didn't match the closing scope's label stay pending, compacted to the
/// front of the cursor window.
///
/// @param table       the jump table being filled.
/// @param pending     the pending-branch list.
/// @param pending_sp  1-element pending cursor.
/// @param label       label of the scope just closed.
/// @param is_loop     `true` for loops (back-edge target = opener + 1).
/// @param opener_pc   pc of the scope's opener (block / loop / if / else).
/// @param end_pc      pc of the matching `end` op.
export drain_pending :: fn(table: i32[], pending: PendingBranch[], pending_sp: i64[],
                           label: string, is_loop: bool, opener_pc: i32, end_pc: i32) -> void {
    psp :: pending_sp[0]
    new_sp: i64 = 0
    for i in 0..<psp {
        entry :: pending[i]
        if entry.target_label != label {
            pending[new_sp] = entry
            new_sp += 1
            continue
        }
        if is_loop {
            table[entry.branch_pc] = opener_pc + 1
        } else {
            table[entry.branch_pc] = end_pc + 1
        }
    }
    pending_sp[0] = new_sp
}
