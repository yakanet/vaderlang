// vader/core/bytecode/virt_tokens — how a `.virt` import line spells a path or a
// C type as one token. The writer (`vader/emit/virt`) encodes, the reader
// (`vader/front/virt`) decodes.

module "vader/core/bytecode"

import "std/iter"
import "std/string"

/// A path as one attribute token, losslessly: an attribute ends at a space and a
/// list item at a comma, so both are percent-encoded, and `%` with them.
///
/// @param text  the path.
export path_token :: fn(text: string) -> string =
    text.replace_all("%", "%25").replace_all(" ", "%20").replace_all(",", "%2C")

/// The path a `path_token` stands for.
///
/// @param token  the token read from an import line.
export path_from_token :: fn(token: string) -> string =
    token.replace_all("%2C", ",").replace_all("%20", " ").replace_all("%25", "%")

/// A list of paths as one attribute value, comma-separated.
///
/// @param texts  the paths.
export path_tokens :: fn(texts: string[]) -> string = texts.map(path_token).collect().join(",")

/// The paths a `path_tokens` value lists.
///
/// @param value  the attribute value read from an import line.
export paths_from_tokens :: fn(value: string) -> string[] =
    value.split(",").map(path_from_token).collect()

/// C type spellings as one token of an import line, whose attributes are
/// separated by spaces : each space is written `+`, which no C type contains.
/// `c_type_from_token` reads it back.
///
/// @param spelling  the C type, as `@c_type` names it, or several joined by `,`.
export c_type_token :: fn(spelling: string) -> string = spelling.replace_all(" ", "+")

/// The C type spelling a `c_type_token` stands for.
///
/// @param token  the token read from an import line.
export c_type_from_token :: fn(token: string) -> string = token.replace_all("+", " ")
