// vader/core/wit/cursor: the characters of a `.wit` file, read one at a time.
//
// The reader reads characters directly rather than tokens: a version (`@0.3.0`,
// `0.3.0-rc-1`) does not split into the tokens of the rest of the file. The
// cursor counts lines and columns for the spans, and keeps the `///` lines it
// steps over as the documentation of the item that follows them.

module "vader/core/wit"

import "std/ascii"
import "std/collections"
import "std/string"

WitParser :: struct {
    text: string
    file: string
    at: i64 = 0
    line: i32 = 1
    column: i32 = 1
    // The `///` lines read since the last item.
    doc: string[] = []
}

span :: fn(p: WitParser) -> WitSpan = WitSpan {
    .file = p.file,
    .line = p.line,
    .column = p.column,
}

at_end :: fn(p: WitParser) -> bool = p.at >= p.text.byte_len()

peek :: fn(p: WitParser) -> u8 = p.peek_at(0)

peek_at :: fn(p: WitParser, offset: i64) -> u8 {
    if p.at + offset >= p.text.byte_len() {
        return 0
    }
    return p.text.byte_at(p.at + offset)
}

advance :: fn(p: WitParser) -> void {
    if p.peek() == '\n' {
        p.line += 1
        p.column = 1
    } else {
        p.column += 1
    }
    p.at += 1
}

// Step over spaces and comments, keeping the text of `///` lines.
skip_space :: fn(p: WitParser) -> void {
    for !p.at_end() {
        b :: p.peek()
        if is_white_byte(b) {
            p.advance()
        } else if b == '/' && p.peek_at(1) == '/' {
            start :: p.at
            for !p.at_end() && p.peek() != '\n' {
                p.advance()
            }
            line :: p.text.byte_slice(start, p.at)
            if line.starts_with("///") {
                p.doc.push(line.byte_slice(3, line.byte_len()).trim())
            }
        } else if b == '/' && p.peek_at(1) == '*' {
            p.advance()
            p.advance()
            for !p.at_end() && !(p.peek() == '*' && p.peek_at(1) == '/') {
                p.advance()
            }
            p.advance()
            p.advance()
        } else {
            return
        }
    }
}

// The `///` lines read since the last item, as one text.
take_doc :: fn(p: WitParser) -> string {
    out :: p.doc.join("\n")
    p.doc.clear()
    return out
}

// The word at the cursor, not stepped over: an identifier or a keyword, `%`
// included.
word_here :: fn(p: WitParser) -> string = p.word_at(p.at)

// The word that starts at `start`.
word_at :: fn(p: WitParser, start: i64) -> string {
    end := start
    if end < p.text.byte_len() && p.text.byte_at(end) == '%' {
        end += 1
    }
    for end < p.text.byte_len() && is_word_byte(p.text.byte_at(end)) {
        end += 1
    }
    return p.text.byte_slice(start, end)
}

at_keyword :: fn(p: WitParser, keyword: string) -> bool = p.word_here() == keyword

// Step over the word at the cursor and return it, then the space after it.
word :: fn(p: WitParser) -> string {
    out :: p.word_here()
    for _ in 0..<out.byte_len() {
        p.advance()
    }
    p.skip_space()
    return out
}

// An identifier: a word, `%` taken off an escaped keyword.
identifier :: fn(p: WitParser) -> string | WitError {
    written :: p.word_here()
    if written == "" || written == "%" {
        return p.fail_here("expected a name")
    }
    p.word()
    if written.starts_with("%") {
        return written.byte_slice(1, written.byte_len())
    }
    return written
}

// Step over `b` when the text goes on with it.
skip :: fn(p: WitParser, b: u8) -> bool {
    if p.peek() != b {
        return false
    }
    p.advance()
    p.skip_space()
    return true
}

expect :: fn(p: WitParser, b: u8) -> void | WitError {
    if !p.skip(b) {
        return p.fail_here("expected `${char(b)}`")
    }
}

// Step over `->`.
skip_arrow :: fn(p: WitParser) -> bool {
    if p.peek() != '-' || p.peek_at(1) != '>' {
        return false
    }
    p.advance()
    p.advance()
    p.skip_space()
    return true
}

fail_here :: fn(p: WitParser, message: string) -> WitError {
    found :: if p.at_end() { "the end of the file" } else { "`${char(p.peek())}`" }
    return wit_error(p.span(), "${message}, found ${found}")
}

wit_error :: fn(span: WitSpan, message: string) -> WitError = WitError {
    .message = message,
    .span = span,
}

// The characters of a version, `0.3.0-rc-1+build`. A `.` ends it unless a
// character of the version follows: `@0.3.0.{a}` is the version `0.3.0`.
version :: fn(p: WitParser) -> string | WitError {
    start :: p.at
    for !p.at_end() && p.at_version_byte() {
        p.advance()
    }
    if p.at == start {
        return p.fail_here("expected a version")
    }
    out :: p.text.byte_slice(start, p.at)
    p.skip_space()
    return out
}

at_version_byte :: fn(p: WitParser) -> bool {
    b :: p.peek()
    if b == '.' {
        return is_word_byte(p.peek_at(1))
    }
    return is_word_byte(b) || b == '+'
}

// `package ns:name@version;`.
package_decl :: fn(p: WitParser) -> WitPackageName | WitError {
    p.word()
    name :: p.package_name() else return name
    if p.peek() == '{' {
        return p.fail_here("a nested package is not read yet")
    }
    end :: p.expect(';') else return end
    return name
}

// `ns:name@version`, the namespace `ns:inner` when it nests.
package_name :: fn(p: WitParser) -> WitPackageName | WitError {
    out :: p.namespaced_name() else return out
    if p.peek() == '@' && !p.at_gate() {
        p.advance()
        version :: p.version() else return version
        out.version = version
    }
    return out
}

// `ns:name`, without the version: a `use` writes it after the interface.
namespaced_name :: fn(p: WitParser) -> WitPackageName | WitError {
    parts: string[]: []
    first :: p.identifier() else return first
    parts.push(first)
    for p.skip(':') {
        part :: p.identifier() else return part
        parts.push(part)
    }
    if parts.len() < 2 {
        return p.fail_here("expected `namespace:name`")
    }
    return WitPackageName {
        .namespace = parts[0..<parts.len() - 1].join(":"),
        .name = parts[parts.len() - 1],
    }
}

// Whether the `@` at the cursor opens a gate rather than a version.
at_gate :: fn(p: WitParser) -> bool = match p.word_at(p.at + 1) {
    "since" | "unstable" | "deprecated" -> true
    _                                   -> false
}

// The gates in front of an item.
gate :: fn(p: WitParser) -> WitGate | WitError {
    out :: WitGate {}
    for p.peek() == '@' {
        span :: p.span()
        p.advance()
        kind :: p.word()
        opening :: p.expect('(') else return opening
        key :: p.identifier() else return key
        equals :: p.expect('=') else return equals
        value :: p.version() else return value
        closing :: p.expect(')') else return closing
        if key != "version" && key != "feature" {
            return wit_error(span, "unknown gate argument `${key}`")
        }
        match kind {
            "since"      -> {
                out.since = value
            }
            "unstable"   -> {
                out.unstable = value
            }
            "deprecated" -> {
                out.deprecated = value
            }
            _            -> {
                return wit_error(span, "unknown gate `@${kind}`")
            }
        }
    }
    return out
}

// Step over a `{ ... }` block, the blocks it nests included.
skip_braces :: fn(p: WitParser) -> void | WitError {
    opening :: p.expect('{') else return opening
    depth := 1
    for depth > 0 {
        if p.at_end() {
            return p.fail_here("expected `}`")
        }
        b :: p.peek()
        if b == '{' {
            depth += 1
        } else if b == '}' {
            depth -= 1
        }
        p.advance()
        p.skip_space()
    }
    p.doc.clear()
}

// Step past the next `b`.
skip_past :: fn(p: WitParser, b: u8) -> void | WitError {
    for !p.at_end() && p.peek() != b {
        p.advance()
        p.skip_space()
    }
    return p.expect(b)
}
