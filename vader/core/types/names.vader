// vader/core/types/names: the names the compiler gives a meaning to.
//
// The primitives and their slot sizes (`PRIMITIVE_META`), the core traits,
// structs and methods the compiler reaches by name (`TRAIT_*`, `STRUCT_*`,
// `METHOD_*`), the keys that name a declaration across modules (`declaration_key`,
// `trait_key_of`), and the types an `async fn` hands back (`erased_async_type`).

module "vader/core/types"

import "vader/core/symbol"
import "vader/support/integer"
import "vader/support/text"

// ---- primitives -----------------------------------------------------------

/// Target-ABI metadata for one primitive other than the integers, which
/// `vader/support/integer::MACHINE_INTEGERS` describes: the single source of truth every
/// pass consults instead of re-listing names. Row order is load-bearing:
/// `front/resolver/builtins` mints builtin symbol IDs in this order (embedded in
/// snapshots), so new primitives append at the end. Consumer-owned mappings
/// (bytecode `ValType`, c-emit C spellings) map a row onto their own enum rather
/// than living here, so `vader/core/types` stays a near-leaf. `size` is bytes (align ==
/// size on the 64-bit target).
export PrimitiveMeta :: struct {
    name:     string
    size:     i64
    is_float: bool = false
    /// The value is a handle the runtime follows, not storage the slot owns.
    /// `string` is an interned atom the collector tracks ; `CPointer` addresses
    /// memory the Vader side does not own. A pass deciding whether a value can
    /// be copied into registers, embedded in a flat layout, or taken the address
    /// of has to ask this: the size alone says `CPointer` is eight bytes like a
    /// `u64`, and that is the wrong answer.
    is_reference: bool = false
}

export PRIMITIVE_META: PrimitiveMeta[]: [
    PrimitiveMeta {
        .name = "f32",
        .size = 4,
        .is_float = true,
    },
    PrimitiveMeta {
        .name = "f64",
        .size = 8,
        .is_float = true,
    },
    PrimitiveMeta { .name = "bool", .size = 1 },
    PrimitiveMeta { .name = "char", .size = 4 },
    PrimitiveMeta {
        .name = "string",
        .size = 4,
        .is_reference = true,
    },
    PrimitiveMeta { .name = "void", .size = 0 },
    PrimitiveMeta { .name = "null", .size = 0 },
    PrimitiveMeta {
        .name = "CPointer",
        .size = 8,
        .is_reference = true,
    },
]

/// The `PrimitiveMeta` row for `name`, or null when `name` is not a primitive.
export primitive_meta :: fn(name: string) -> PrimitiveMeta | null {
    for m in PRIMITIVE_META {
        if m.name == name { return m }
    }
    return null
}

/// Map a builtin type name to a Type, or null when the name isn't a builtin
/// (caller falls back to symbol-driven resolution). Covers `type`, `Self` and
/// every primitive but the eight integers, which `std/core` declares.
export primitive_from_name :: fn(name: string) -> Type | null {
    if name == "type" { return TY_TYPE }
    if name == "Self" { return TY_SELF }
    if primitive_meta(name) == null {
        return null
    }
    return mk_primitive(name)
}

/// The name of the abstract integer a range type is written over (`Int in 0..=23`).
export INT_BASE_NAME :: "Int"

/// The name of the primitive `t` is : a primitive's own (`string`, `char`), the
/// machine integer a range of its bounds is (`machine_integer_name`) ; "" for any
/// other type, a range of other bounds included, and for none.
///
/// @param t  any type, or none.
export primitive_name :: fn(t: Type | null) -> string {
    if t is PrimitiveType {
        return t.name
    }
    if t is RangeType {
        return machine_integer_name(t.bounds)
    }
    return ""
}

/// Whether `name` spells a scalar type the compiler knows by name : a primitive
/// (`bool`, `string`, `f64`, …) or one of the eight machine integers.
export is_scalar_type_name :: fn(name: string) -> bool =
    primitive_meta(name) != null || is_int_name(name)

/// Whether `name` is a primitive the runtime reaches through a handle.
///
/// False for anything that is not a primitive at all: the question only has a
/// meaning for a row of the table.
export is_reference_name :: fn(name: string) -> bool {
    m :: primitive_meta(name)
    return m != null && m.is_reference
}

/// Whether `name` spells a machine integer (`machine_integer_named`).
export is_int_name :: fn(name: string) -> bool = machine_integer_named(name) != null

/// Whether `name` spells a signed machine integer.
export is_signed_int_name :: fn(name: string) -> bool {
    m :: machine_integer_named(name) ?? return false
    return m.is_signed
}

/// Whether `name` spells an unsigned machine integer.
export is_unsigned_int_name :: fn(name: string) -> bool {
    m :: machine_integer_named(name) ?? return false
    return !m.is_signed
}

export is_float_name :: fn(name: string) -> bool {
    m :: primitive_meta(name)
    return m != null && m.is_float
}

/// Whether `name` spells a machine integer or a float.
export is_numeric_name :: fn(name: string) -> bool = is_int_name(name) || is_float_name(name)

/// Size in bytes of a primitive or a machine integer (0 for `void` / `null` /
/// anything else).
export primitive_size :: fn(name: string) -> i64 {
    integer :: machine_integer_named(name)
    if integer != null {
        return integer.bits / 8
    }
    m :: primitive_meta(name) ?? return 0
    return m.size
}

// ---- core traits and keys -------------------------------------------------

/// Names of stdlib core traits used for compiler-driven dispatch. Kept as
/// plain string constants so cross-module symbol lookup goes through
/// resolved imports rather than a privileged registry.
export TRAIT_DISPLAY    :: @type_name(Display)
export TRAIT_ERROR      :: @type_name(Error)
export TRAIT_EQUALS     :: @type_name(Equals)
export TRAIT_COMPARABLE :: @type_name(Comparable)
export TRAIT_ADD        :: @type_name(Add)
export TRAIT_SUB        :: @type_name(Sub)
export TRAIT_MUL        :: @type_name(Mul)
export TRAIT_DIV        :: @type_name(Div)
export TRAIT_REM        :: @type_name(Rem)
export TRAIT_HASH       :: @type_name(Hash)
export TRAIT_CLONE      :: @type_name(Clone)
export TRAIT_STEP       :: @type_name(Step)
export TRAIT_INTO       :: @type_name(Into)
export TRAIT_ITERATOR   :: @type_name(Iterator)
export TRAIT_ASYNC      :: @type_name(Async)
export TRAIT_CONTAINS   :: @type_name(Contains)
export TRAIT_INDEX      :: @type_name(Index)
export TRAIT_INDEX_SET  :: @type_name(IndexSet)

/// `impl_base_key` of a nominal declaration: the symbol ids are unique across
/// every kind, so the id alone names it.
///
/// @param sym  the declaration's symbol, not an import binding.
export declaration_key :: fn(sym: Symbol) -> string = "#${sym.id}"

/// Mangle a module display path into a name-fragment usable in a mangled
/// symbol: a `_` of the path doubles and `/` becomes `_`, so `a/b` and `a_b`
/// mangle apart (`a_b`, `a__b`). Any other byte outside `[A-Za-z0-9]` becomes
/// `_` too, which only a path outside the module grammar can carry.
/// Centralised here so the lowerer's name-mangling sites, the trait keys and the
/// CLI's entry-point name share one scheme and can't drift: a mismatch would
/// desync the VM's `export main <index>` directive from the emitted fn name.
///
/// @param module_id  the module display path (e.g. `"std/string_builder"`).
/// @return           the mangled fragment (e.g. `"std_string__builder"`), an
///                   identifier that never holds a `$`.
export mangle_module_id :: fn(module_id: string) -> string {
    out: u8[]: [] * module_id.byte_len()
    for i in 0..<module_id.byte_len() {
        b :: module_id.byte_at(i)
        if b == '_' {
            out.push('_')
            out.push('_')
        } else if is_ident_byte(b) {
            out.push(b)
        } else {
            out.push('_')
        }
    }
    return out.bytes_to_string()
}

/// A trait's identity across modules, named the way the bytecode names a struct
/// or a fn : its declaring module's mangled name, then its own,
/// `"std_core$Display"`, `"a$Animal"`. Two traits with the same name in
/// different modules get different keys. It keys the trait side of the impl
/// tables, and the trait half of a vtable key (`"std_core$Display.to_string"`).
///
/// @param trait_sym  the trait's declaration symbol, not an import binding.
export trait_key_of :: fn(trait_sym: Symbol) -> string = qualified_symbol_name(trait_sym)

/// The `trait_key` of a `std/core` trait, from its `TRAIT_*` name.
///
/// @param name  a `TRAIT_*` constant.
export core_trait_key :: fn(name: string) -> string = "std_core\$${name}"

/// Whether `t` is the `std/core` trait `name`, told by its declaration rather
/// than its spelling: a user trait named `Iterator` is not the core one.
///
/// @param t     a trait type.
/// @param name  a `TRAIT_*` constant.
export is_core_trait :: fn(t: TraitType, name: string) -> bool =
    trait_key_of(t.symbol) == core_trait_key(name)

/// Whether `t` is the `std/core` struct `name`, told by its declaration rather
/// than its spelling: a struct of the program named `Range` is not the core one.
///
/// @param t     a struct type.
/// @param name  a `STRUCT_*` constant.
export is_core_struct :: fn(t: StructType, name: string) -> bool =
    t.symbol.module_name == "std/core" && t.symbol.name == name

/// Whether `t` is `std/ffi`'s `CLibrary`, the struct a binding names the C library
/// it calls with, told by its declaration rather than its spelling.
///
/// @param t  the candidate type.
export is_c_library :: fn(t: Type) -> bool {
    if t !is StructType {
        return false
    }
    return t.symbol.module_name == "std/ffi" && t.symbol.name == "CLibrary"
}

/// The argument of `t` when it is the one-argument `std/core` trait `name`:
/// `E` for `Iterator<E>`, `T` for `Async<T>`.
///
/// @param t     the type to read.
/// @param name  a `TRAIT_*` constant.
/// @return      null for any other type.
export core_trait_arg :: fn(t: Type, name: string) -> Type | null {
    if t is TraitType && is_core_trait(t, name) && t.args.len() > 0 {
        return t.args[0]
    }
    return null
}

/// Whether `t` implements `trait_key` with no impl : every enum implements
/// `Equals`, comparing by variant, and `Hash`, so it keys a `MutableMap`. A boxed
/// enum carries its integer, whose `Equals` and `Hash` a vtable reaches. No impl is
/// registered, so the run-time trait lookup does not see these : an `is Trait`
/// test of an enum is resolved before it runs.
///
/// @param t          the implementing type.
/// @param trait_key  the trait asked for.
export has_builtin_impl :: fn(t: Type, trait_key: string) -> bool =
    t is EnumType &&
        (trait_key == core_trait_key(TRAIT_EQUALS) || trait_key == core_trait_key(TRAIT_HASH))

/// The trait name inside a `trait_key`: what a message shows the user.
///
/// @param key  a `trait_key`.
export trait_key_name :: fn(key: string) -> string {
    start := key.byte_len()
    for start > 0 && key.byte_at(start - 1) != '$' {
        start -= 1
    }
    return key.byte_slice(start, key.byte_len())
}

/// The erased `Async<T>` an `async fn` declaring `result` hands its callers : the
/// `T` of a declared `Async<T>`, or the whole `result`, wrapped once. The call
/// site and the lowered declaration both take their type from here.
///
/// @param async_sym  the core `Async` trait.
/// @param result     the fn's declared return, substituted for the instance.
export erased_async_type :: fn(async_sym: Symbol, result: Type) -> Type =
    mk_trait(async_sym, [async_result_arg(async_inner_type(result))])

/// The raw value type a coroutine body produces : the `T` of a declared
/// `Async<T>` return (target form), or the declared return itself (transitional
/// `-> T`). NOT normalized: `void` stays `void` (the body is void-bodied) ; the
/// void→null step happens only where the erased `Async<...>` type is built.
export async_inner_type :: fn(t: Type) -> Type = core_trait_arg(t, TRAIT_ASYNC) ?? t

/// The `Async` type argument for an `async fn`'s declared result : `void`
/// normalizes to `null`, everything else passes through. The call site, the
/// lowered declaration and the resume type all read it here, so they agree.
export async_result_arg :: fn(result: Type) -> Type = if is_void(result) { TY_NULL } else { result }

// ---- core structs and methods ---------------------------------------------

/// Names of stdlib core structs the compiler refers to by symbol.
export STRUCT_RANGE          :: @type_name(Range)

/// `std/core::Continuation` and its variants: what an `Iterator.next` pairs its
/// element with. The lowerer builds the comparison, so the spellings live beside
/// the type.
export ENUM_CONTINUATION     :: @type_name(Continuation)
export CONTINUATION_STOP     :: "Stop"
export CONTINUATION_CONTINUE :: "Continue"
export STRUCT_SUSPENDED      :: @type_name(Suspended)
export STRUCT_FIELD          :: @type_name(Field)

/// Method names the compiler dispatches by, paired with the `TRAIT_*` above
/// (`Add::add`, `Comparable::compare`, `Iterator::next`, …). Same rationale as
/// the trait names: one source so a rename touches one line.
export METHOD_ADD       :: "add"
export METHOD_SUB       :: "sub"
export METHOD_MUL       :: "mul"
export METHOD_DIV       :: "div"
export METHOD_REM       :: "rem"
export METHOD_EQUALS    :: "equals"
export METHOD_COMPARE   :: "compare"
export METHOD_CONTAINS  :: "contains"
export METHOD_INTO      :: "into"
export METHOD_NEXT      :: "next"
export METHOD_RESUME    :: "resume"
export METHOD_CANCEL    :: "cancel"
export METHOD_TO_STRING :: "to_string"
export METHOD_AT        :: "at"
export METHOD_SET_AT    :: "set_at"

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_primitive_from_name_recognises_primitives :: fn() -> void {
    match p :: primitive_from_name("string") {
        is PrimitiveType -> { assert_eq(p.name, "string") }
        _                -> { assert(false, "string should be primitive") }
    }
    assert(primitive_from_name("usize") == null, "`usize` is no primitive")
    assert(primitive_from_name("int") == null, "`int` is no primitive")
}

@test
test_primitive_from_name_leaves_the_integers_to_std_core :: fn() -> void {
    assert(primitive_from_name("i32") == null, "`std/core` declares `i32`")
}

@test
test_primitive_from_name_returns_null_for_user_types :: fn() -> void {
    if primitive_from_name("MyStruct") !is null {
        assert(false, "user types should not be primitives")
    }
}

@test
test_mangle_module_id_doubles_underscores :: fn() -> void {
    assert_eq(mangle_module_id("std/core"), "std_core")
    assert_eq(mangle_module_id("std/string_builder"), "std_string__builder")
}

@test
test_mangle_module_id_keeps_slash_and_underscore_apart :: fn() -> void {
    assert(mangle_module_id("a/b") != mangle_module_id("a_b"), "`a/b` and `a_b` mangle apart")
}

@test
test_is_scalar_type_name :: fn() -> void {
    assert(is_scalar_type_name("i32"), "i32 is a scalar type")
    assert(is_scalar_type_name("string"), "string is a scalar type")
    assert(!is_scalar_type_name("MyStruct"), "a user type is no scalar type")
}

@test
test_primitive_meta_partition :: fn() -> void {
    assert(is_int_name("u64") && is_unsigned_int_name("u64"), "u64 is unsigned int")
    assert(is_signed_int_name("i64") && !is_unsigned_int_name("i64"), "i64 is signed int")
    assert(is_float_name("f32") && !is_int_name("f32"), "f32 is float not int")
    assert(!is_numeric_name("char") && !is_numeric_name("string"), "char/string not numeric")
    // An atom id, not the retired `{ptr, len}` fat pointer.
    assert_eq(primitive_size("string"), 4)
    assert_eq(primitive_size("i32"), 4)
}
