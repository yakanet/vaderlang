// vader/core/types/types: the Type IR.
//
// Every Vader value gets exactly one Type. The discriminated union has 20
// variants ; constructors are plain factories, with no hash-consing: `equals_type`
// walks structurally instead of relying on reference identity. This file holds the
// variants and their constructors, display, equality, canonical keys, the walks
// over a type, what a distinct is backed by and which values carry their tag.
//
// The rest of the module answers questions from types alone: integer types and the
// values a type holds (`integers.vader`), the names the compiler gives a meaning to
// (`names.vader`), canonical unions (`union.vader`), assignability and free
// literals (`assignable.vader`), substitution and unification (`substitution.vader`,
// `unify.vader`), the value ABI (`value_abi.vader`).

module "vader/core/types"

import "std/abort"
import "std/collections"
import "std/string_builder"
import "vader/core/symbol"
import "vader/support/integer"

// ---- variants -------------------------------------------------------------

export PrimitiveType :: struct {
    name: string
}

export StructType :: struct {
    symbol: Symbol
    args:   Type[]
}

export EnumType :: struct {
    symbol:        Symbol
    /// The integer a value is stored in : the width the header writes, else the
    /// narrowest holding the values ; for an enum with variant data, the narrowest
    /// holding its ranks.
    repr:          MachineInteger
    /// What a variant stores, keyed by name : its written value, or for an enum
    /// with variant data its rank (0, 1, 2… in declaration order).
    indices:       MutableMap<string, i64>
    /// The struct each variant carries a constant value of, from the header ;
    /// null for an enum without variant data.
    data:          StructType | null = null
    /// Written value per rank, for an enum with variant data ; empty for any
    /// other enum, whose stored integer IS the value.
    values:        i64[] = []
    /// The width the header writes, or null when it leaves it out: `repr` for
    /// an enum without variant data, the width of the written values for one
    /// with variant data, whose rank is stored at an inferred width.
    written_width: MachineInteger | null = null
}

/// Distinct (newtype) over a primitive: nominal at typecheck, but its
/// backend representation IS the backing primitive (zero-cost, register
/// scalar, no box). Declared as `Name :: <primitive>` ; constructed via
/// `Name(v)` (wrap) and unwrapped via `Backing(d)`: both no-op at runtime.
/// Operators and methods are opaque : only impls on the distinct type
/// apply, nothing is inherited from the backing (`Instant + Instant` is a
/// type error unless an `Add` impl exists). Modeled on `EnumType` (it rides
/// its backing's `ValType`) not on `StructType` (which is a boxed `Ref`).
export DistinctType :: struct {
    symbol:  Symbol
    /// The underlying type the value is represented as. A primitive
    /// (`Meters :: i64`) or a composite: array (`BigInt :: u32[]`),
    /// struct, or tuple alias. Classifiers must recurse into it
    /// (`val_type_of_type`, `array_backing`, `struct_backing`, …)
    /// rather than assume a primitive.
    backing: Type
}

/// A range of integers, `Int in lo..=hi` : a refinement of the integer, held in
/// the narrowest integer type that holds it (`range_representation`). Told apart
/// by its bounds alone, which are closed and within `i64` once declared ; a range
/// an expression computes may open past them.
export RangeType :: struct {
    bounds: Interval
    /// The alias it was declared as (`Hour`), for display ; "" for a range written
    /// in place or computed by an expression.
    name: string = ""
}

export TraitType :: struct {
    symbol:    Symbol
    args:      Type[]
}

export UnionType :: struct {
    /// Canonical : sorted by `display_type` output, deduped.
    variants: Type[]
}

export FnType :: struct {
    params:      Type[]
    return_type: Type
    /// The parameters this signature quantifies over : each use instantiates them
    /// afresh. Empty for a monomorphic signature, and for an instance.
    type_params: TypeParamType[] = []
}

export ArrayType :: struct {
    element: Type
}

export TupleType :: struct {
    /// Heterogeneous fixed-arity sequence (≥ 2 elements).
    elements: Type[]
}

export TypeParamType :: struct {
    symbol: Symbol
}

/// A flexible inference variable, minted fresh for one parameter of one
/// instantiation. Only the typecheck sees one : it is replaced by what it was
/// solved to before any type is recorded for a later pass.
export InferVar :: struct {
    id:     i32
    /// The declared parameter this variable instantiates.
    origin: Symbol
}

/// Stop the compiler on an inference variable met after the typecheck, which
/// replaces every one by what it was solved to : a later pass reading one would
/// build on a type nothing settled.
///
/// @param v  the variable.
@no_return
export leaked_infer_var :: fn(v: InferVar) -> void {
    panic("an inference variable for `${v.origin.name}` outlived the typecheck")
}

export TypeMetaType :: struct {}
export SelfType :: struct {}
export UnresolvedType :: struct {}

/// Erased "any" reference: synthesised by the erasure-dedupe pass
/// for fields of monomorphized generic structs so identical concrete
/// monos (e.g. `Pair__string__i64` vs `Pair__i32__bool`) can share a
/// single C-emit shape. Surface name `Any`. Maps to `ValType.Any` at
/// the bytecode level (same wide-ref representation as Ref).
export AnyType :: struct {}
/// Untyped int literal: flexible until placed in a typed context.
export FreeIntType :: struct {}
/// Untyped float literal: flexible until placed in a typed context.
export FreeFloatType :: struct {}
/// Untyped char LITERAL: flexible until placed in a typed context. A char
/// literal carries a compile-time codepoint, so it coerces to an integer type
/// (with a bounds check) the same way a free int does ; absent any numeric
/// context it defaults to `char`. Note: only LITERALS get this type, a `char`
/// variable stays the concrete `char` and never auto-coerces to an integer.
export FreeCharType :: struct {}
/// Bottom type for `return` / `panic` etc.: assignable to anything.
export NeverType :: struct {}

/// The Type IR: discriminated union over every kind of Vader value.
export Type ::
    | PrimitiveType
    | StructType
    | EnumType
    | TraitType
    | UnionType
    | FnType
    | ArrayType
    | TupleType
    | TypeParamType
    | TypeMetaType
    | SelfType
    | UnresolvedType
    | FreeIntType
    | FreeFloatType
    | FreeCharType
    | NeverType
    | AnyType
    | DistinctType
    | RangeType
    | InferVar

// ---- constructors ---------------------------------------------------------

/// The type the primitive `name` designates : one of the eight machine integers
/// as the range of its values (`i32` is `Int in -2147483648..=2147483647`), any
/// other primitive as itself.
///
/// @param name  a scalar type's name (`is_scalar_type_name`).
export mk_primitive :: fn(name: string) -> Type {
    m :: machine_integer_named(name) ?? return PrimitiveType { .name = name }
    return machine_integer_type(m)
}

/// A nominal struct type.
export mk_struct :: fn(symbol: Symbol, args: Type[]) -> Type =
    StructType { .symbol = symbol, .args = args }

/// A trait type, instantiated at `args`.
export mk_trait :: fn(symbol: Symbol, args: Type[]) -> Type =
    TraitType { .symbol = symbol, .args = args }

/// Distinct (newtype) over `backing`, see `DistinctType`. `backing` is a
/// primitive, an array, a struct or a tuple (`distinct_backing` decides).
export mk_distinct :: fn(symbol: Symbol, backing: Type) -> Type = DistinctType { .symbol = symbol, .backing = backing }

export mk_array :: fn(element: Type) -> Type = ArrayType { .element = element }

/// Rebuild an `FnType` that DROPS its leading parameter (UFCS curries the
/// receiver away).
///
/// @param src  the fn type before the receiver is dropped ; it has one at least.
export mk_fn_drop_self :: fn(src: FnType) -> FnType = FnType {
    .params      = src.params[1..<src.params.len()],
    .return_type = src.return_type,
    .type_params = src.type_params,
}

/// A tuple type, one element type per position.
export mk_tuple :: fn(elements: Type[]) -> Type = TupleType { .elements = elements }

/// A function type, quantified over `type_params` when it is generic.
export mk_fn :: fn(
    params: Type[], return_type: Type, type_params: TypeParamType[] = [],
) -> FnType = FnType {
    .params = params,
    .return_type = return_type,
    .type_params = type_params,
}

/// The parameter types of a callee's fn type.
///
/// @param callee_type  the callee's type ; anything but a fn type has none.
export param_types_of :: fn(callee_type: Type | null) -> Type[] {
    if callee_type is FnType {
        return callee_type.params
    }
    return []
}

/// Raw union constructor. Callers that need flattening + dedup must go
/// through `union_of` (`union.vader`).
export mk_union :: fn(variants: Type[]) -> Type = UnionType { .variants = variants }

export mk_type_param :: fn(symbol: Symbol) -> Type = TypeParamType { .symbol = symbol }

export TY_TYPE       :: TypeMetaType {}
export TY_SELF       :: SelfType {}
export TY_UNRESOLVED :: UnresolvedType {}
export TY_FREE_INT   :: FreeIntType {}
export TY_FREE_FLOAT :: FreeFloatType {}
export TY_FREE_CHAR  :: FreeCharType {}

/// Whether `t` is the type of a free literal : an integer, a float or a `char` one,
/// which takes the type of the slot it fills.
///
/// @param t  any type.
export is_free_numeric :: fn(t: Type) -> bool {
    // @partial: only the three Free* literal variants are free numerics; every
    // other type (concrete or composite) is not.
    @partial match t {
        is FreeIntType -> { return true }
        is FreeCharType -> { return true }
        is FreeFloatType -> { return true }
        _ -> { return false }
    }
}

/// Replace FreeInt with `i32`, FreeFloat with `f64`, FreeChar with `char`.
/// Used when a free literal escapes its bidirectional context and needs a
/// concrete type to flow into downstream phases.
export default_if_free :: fn(t: Type) -> Type {
    // @partial: only the three Free* literal variants default to a concrete
    // primitive; every other type is already concrete → returned unchanged.
    @partial match t {
        is FreeIntType   -> { return TY_I32 }
        is FreeFloatType -> { return TY_F64 }
        is FreeCharType  -> { return TY_CHAR }
        _ -> { return t }
    }
}
export TY_NEVER      :: NeverType {}
export TY_ANY        :: AnyType {}
export TY_VOID       :: PrimitiveType { .name = "void" }
export TY_BOOL       :: PrimitiveType { .name = "bool" }
export TY_STRING     :: PrimitiveType { .name = "string" }
export TY_CHAR       :: PrimitiveType { .name = "char" }
export TY_F64        :: PrimitiveType { .name = "f64" }
export TY_NULL       :: PrimitiveType { .name = "null" }
export TY_CPOINTER   :: PrimitiveType { .name = "CPointer" }

/// `i32`, the range of its values (`mk_primitive`) : what a free integer defaults to.
export TY_I32 :: RangeType {
    .bounds = Interval { .lo = -0x8000_0000, .hi = 0x7FFF_FFFF },
    .name = "i32",
}
/// `i64`, the range of its values : what an integer is computed on where no
/// narrower type is known.
export TY_I64 :: RangeType { .bounds = Interval { .lo = I64_MIN, .hi = I64_MAX }, .name = "i64" }

/// Whether `t` is the `null` type.
///
/// @param t  the type to test.
export is_null_type :: fn(t: Type) -> bool = t is PrimitiveType && t.name == "null"

/// True when `t` is the `void` primitive: by name, so a `void` built anywhere
/// passes, not only the `TY_VOID` singleton.
export is_void :: fn(t: Type) -> bool {
    if t is PrimitiveType { return t.name == "void" }
    return false
}

/// Whether `t` is `char`, not a distinct over it.
///
/// @param t  the type to test.
export is_char :: fn(t: Type) -> bool = t is PrimitiveType && t.name == "char"

// ---- display --------------------------------------------------------------

/// Render `t` as a human-readable string. The format is fixed so dumps
/// stay stable across snapshots, and side tables keyed on a rendered type use it.
///
/// Fast path : a type whose rendering is a name it already holds skips the
/// builder, which costs two allocations before the first character.
export display_type :: fn(t: Type) -> string {
    match t {
        is PrimitiveType                           -> { return t.name }
        is RangeType                               -> {
            if t.name != "" {
                return t.name
            }
        }
        is EnumType | DistinctType | TypeParamType -> { return t.symbol.name }
        is StructType | TraitType                  -> {
            if t.args.len() == 0 {
                return t.symbol.name
            }
        }
        is UnresolvedType -> { return "?" }
        is NeverType      -> { return "never" }
        is FreeIntType    -> { return "{integer}" }
        is FreeFloatType  -> { return "{float}" }
        is FreeCharType   -> { return "{char}" }
        is SelfType       -> { return "Self" }
        is TypeMetaType   -> { return "type" }
        is AnyType        -> { return "Any" }
        is InferVar       -> { return t.origin.name }
        _                 -> {}  // fall through for composite types
    }
    w :: TypeWriter { .sb = StringBuilder {} }
    w.write_type(t)
    return w.sb.to_string()
}

/// A name in a rendering, and the declaration it names.
export NamedRange :: struct {
    /// Byte offset of the name's first byte in the rendering.
    start: i64
    /// Byte offset just past the name's last byte.
    end: i64
    symbol: Symbol
}

/// A type's rendering, with the nominal names in it.
export TypeDisplay :: struct {
    text:  string
    /// In the order they are written.
    names: NamedRange[]
}

/// `t` rendered as `display_type` renders it, with where each nominal type's
/// name (struct, trait, enum, distinct) lands in the text and the declaration it
/// names: what a link to that declaration needs.
///
/// @param t  the type to render.
export display_type_names :: fn(t: Type) -> TypeDisplay {
    names: NamedRange[]: []
    w :: TypeWriter { .sb = StringBuilder {}, .names = names }
    w.write_type(t)
    return TypeDisplay { .text = w.sb.to_string(), .names = names }
}

/// `t` rendered as `display_type` renders it, with every nominal type (struct,
/// trait, enum, distinct) named by its declaring module as well:
/// `std_collections_MutableMap<string, vader_front_lexer_Token>`. Two same-named types
/// of different modules render apart, which an instance name needs.
///
/// @param t  the type to render.
export qualified_display_type :: fn(t: Type) -> string {
    // @partial: the types rendered by a name they already hold skip the builder.
    @partial match t {
        is PrimitiveType           -> { return t.name }
        is AnyType                 -> { return "Any" }
        is EnumType | DistinctType -> { return qualified_symbol_name(t.symbol) }
        is StructType              -> {
            if t.args.len() == 0 {
                return qualified_symbol_name(t.symbol)
            }
        }
        _ -> {}
    }
    w :: TypeWriter { .sb = StringBuilder {}, .qualified = true }
    w.write_type(t)
    return w.sb.to_string()
}

/// `sym`'s name prefixed by its declaring module, as an instance name carries it:
/// `pa$Point`, `std_collections$MutableMap`. Neither half holds a `$`, so the
/// type `C` of `a/b` (`a_b$C`) and the type `b_C` of `a` (`a$b_C`) name apart.
///
/// @param sym  a nominal type's declaration symbol.
export qualified_symbol_name :: fn(sym: Symbol) -> string =
    "${mangle_module_id(sym.module_name)}\$${sym.name}"

// `qualified` names each nominal type by its module (`qualified_display_type`).
nominal_name :: fn(sym: Symbol, qualified: bool) -> string {
    if qualified {
        return qualified_symbol_name(sym)
    }
    return sym.name
}

/// The impl tables' key for a type's BASE: the declaration a nominal type
/// instantiates (`Foo<i32>` and `Foo<T>` alike), as `#<symbol id>`, so two
/// same-named types from different modules never share an entry. Keys
/// `impl_methods`, `iter_element_types`, `index_*_types`, the trait membership
/// tables and the registry's `ImplEntry.target`, so generic instantiations
/// dispatch through the same entry as the underlying impl.
export impl_base_key :: fn(t: Type) -> string {
    // @partial: only nominal types (Struct/Trait/Enum/Distinct) have a
    // declaration ; every other Type variant is its own base, and the rest
    // (primitives, sentinels) are unique by their printed name.
    //
    // ArrayType collapses to the element-independent key `"[]"` so a CONCRETE
    // array (`BlockId[][]`) matches a blanket `T[] implements …` impl (registered
    // under the same `"[]"` key) ; the param-named `"T[]"` would match no
    // concrete array. An impl on a concrete array (`i32[]`) registers under its
    // own key and is read first, and one on a partly generic array (`T[][]`) is
    // refused (T3090), so the collapse can't mis-match.
    @partial match t {
        is StructType | TraitType | EnumType | DistinctType -> { return declaration_key(t.symbol) }
        is ArrayType -> { return "[]" }
        // A range is its integer to every impl.
        is RangeType -> { return storage_integer(t).name }
        // Two same-named types of two modules print alike inside one of these.
        is TupleType | FnType | UnionType -> { return canonical_key(t) }
        _ -> { return display_type(t) }
    }
}

/// The nominal symbol an impl written for `t` is keyed by ; null for
/// shapes that can't carry an impl (Primitive, Array, Fn, TypeParam,
/// Union, …). A distinct (newtype) is nominal, it carries its OWN impls
/// (`MyId implements Hash`), not the backing's, so it resolves to its own
/// symbol.
export type_to_target_symbol :: fn(t: Type) -> Symbol | null {
    // @partial: only the three nominal variants carry an impl target symbol;
    // every structural / primitive variant (Array, Fn, Union, …) carries none.
    @partial match t {
        is StructType -> { return t.symbol }
        is EnumType -> { return t.symbol }
        is DistinctType -> { return t.symbol }
        _ -> { return null }
    }
}

/// Whether `t` is a tuple, a fn or a union : a target keyed by its shape, having no
/// declaration of its own.
///
/// @param t  a type.
export is_structural :: fn(t: Type) -> bool = t is TupleType || t is FnType || t is UnionType

// A type's rendering under way: where it writes, how it names a nominal type,
// and the names it notes when a caller wants them (`display_type_names`).
TypeWriter :: struct {
    sb: StringBuilder
    /// Each nominal type named by its declaring module as well
    /// (`qualified_display_type`).
    qualified: bool = false
    /// The nominal names written so far, null when nobody asked.
    names: NamedRange[] | null = null
}

write_type :: fn(w: TypeWriter, t: Type) -> void {
    match t {
        is PrimitiveType           -> { w.sb.append(t.name) }
        is StructType | TraitType  -> { w.write_named(t.symbol, t.args) }
        is EnumType | DistinctType -> { w.write_nominal(t.symbol) }
        is RangeType               -> { w.sb.write_range(t, w.qualified) }
        is TypeParamType           -> { w.sb.append(t.symbol.name) }
        is TypeMetaType            -> { w.sb.append("type") }
        is SelfType                -> { w.sb.append("Self") }
        is UnresolvedType          -> { w.sb.append("?") }
        is NeverType               -> { w.sb.append("never") }
        is FreeIntType             -> { w.sb.append("{integer}") }
        is FreeFloatType           -> { w.sb.append("{float}") }
        is FreeCharType            -> { w.sb.append("{char}") }
        is ArrayType               -> {
            // `(A | B)[]` is unambiguous ; bare `A | B[]` would read as
            // `A | (B[])` since `[]` binds tighter than `|`. Same for
            // bare fn types like `fn() -> A`.
            needs_parens :: t.element is UnionType || t.element is FnType
            if needs_parens {
                w.sb.append_char('(')
            }
            w.write_type(t.element)
            if needs_parens {
                w.sb.append_char(')')
            }
            w.sb.append("[]")
        }
        is TupleType               -> {
            w.sb.append_char('[')
            w.write_type_list(t.elements, ", ")
            w.sb.append_char(']')
        }
        is FnType                  -> {
            w.sb.append("fn(")
            w.write_type_list(t.params, ", ")
            w.sb.append(") -> ")
            w.write_type(t.return_type)
        }
        is UnionType               -> { w.write_type_list(t.variants, " | ") }
        is AnyType                 -> { w.sb.append("Any") }
        is InferVar                -> { w.sb.append(t.origin.name) }
    }
}

write_named :: fn(w: TypeWriter, sym: Symbol, args: Type[]) -> void {
    w.write_nominal(sym)
    if args.len() == 0 {
        return
    }
    w.sb.append_char('<')
    w.write_type_list(args, ", ")
    w.sb.append_char('>')
}

// The name of the nominal type `sym` declares, noted when names are. The position
// is measured only then: `byte_len` walks the builder.
write_nominal :: fn(w: TypeWriter, sym: Symbol) -> void {
    names :: w.names
    if names == null {
        w.sb.append(nominal_name(sym, w.qualified))
        return
    }
    start :: w.sb.byte_len()
    w.sb.append(nominal_name(sym, w.qualified))
    names.push(NamedRange {
        .start = start,
        .end = w.sb.byte_len(),
        .symbol = sym,
    })
}

write_type_list :: fn(w: TypeWriter, items: Type[], sep: string) -> void {
    first := true
    for it in items {
        if !first {
            w.sb.append(sep)
        }
        first = false
        w.write_type(it)
    }
}

// ---- equality -------------------------------------------------------------

/// Structural equality. Recursive on unions / fns / arrays / tuples ; for
/// nominal types (Struct / Trait / Enum / TypeParam) we compare symbol ids.
export equals_type :: fn(a: Type, b: Type) -> bool = match a {
    is TypeMetaType   -> b is TypeMetaType
    is SelfType       -> b is SelfType
    is UnresolvedType -> b is UnresolvedType
    is NeverType      -> b is NeverType
    is FreeIntType    -> b is FreeIntType
    is FreeFloatType  -> b is FreeFloatType
    is FreeCharType   -> b is FreeCharType
    is AnyType        -> b is AnyType
    is PrimitiveType  -> b is PrimitiveType && a.name == b.name
    // Two ranges are equal by their bounds, whatever their names.
    is RangeType      -> b is RangeType && same_interval(a.bounds, b.bounds)
    is TypeParamType  -> b is TypeParamType && a.symbol.id == b.symbol.id
    is InferVar       -> b is InferVar && a.id == b.id
    // `StructType<EnumSym>` is the placeholder `type_from_expr` returns
    // for enum names ; treat it as equivalent to the real `EnumType` so
    // body-time assignability (annotation vs inferred) doesn't fight the
    // placeholder/proper distinction.
    is EnumType  -> if b is EnumType {
        a.symbol.id == b.symbol.id
    } else if b is StructType {
        b.symbol.id == a.symbol.id
    } else { false }
    is StructType  -> if b is StructType {
        nominal_eq(a.symbol.id, a.args, b.symbol.id, b.args)
    } else if b is EnumType {
        a.symbol.id == b.symbol.id
    } else { false }
    is TraitType -> b is TraitType && nominal_eq(a.symbol.id, a.args, b.symbol.id, b.args)
    is ArrayType -> b is ArrayType && equals_type(a.element, b.element)
    is TupleType -> b is TupleType && type_list_equals(a.elements, b.elements)
    is FnType    -> b is FnType && type_list_equals(a.params, b.params)
        && equals_type(a.return_type, b.return_type)
    is UnionType -> b is UnionType && type_list_equals(a.variants, b.variants)
    // Distinct (newtype) types : nominal identity by symbol id. A distinct
    // type equals only itself, never its backing primitive nor another
    // distinct over the same backing: that's the whole point.
    is DistinctType  -> b is DistinctType && a.symbol.id == b.symbol.id
}

nominal_eq :: fn(a_id: i32, a_args: Type[], b_id: i32, b_args: Type[]) -> bool {
    if a_id != b_id { return false }
    return type_list_equals(a_args, b_args)
}

/// Element-wise structural equality of two type lists (params, tuple
/// elements, union variants). Companion to `equals_type`: same per-element
/// `equals_type` comparison, length-checked first.
export type_list_equals :: fn(a: Type[], b: Type[]) -> bool {
    if a.len() != b.len() { return false }
    for i in 0..<a.len() {
        if !equals_type(a[i], b[i]) { return false }
    }
    return true
}

/// The variants of `t` when it is a union, `null` otherwise:
/// `union_variants(t) ?? [t]` reads any type as its list of variants.
///
/// @param t  the type to read.
export union_variants :: fn(t: Type) -> Type[] | null {
    if t is UnionType { return t.variants }
    return null
}

/// The type arguments a generic impl's bounds speak of : a struct's arguments,
/// an array's element. Empty for any other type.
///
/// @param t  the implementing type.
export type_arguments :: fn(t: Type) -> Type[] {
    if t is StructType {
        return t.args
    }
    if t is ArrayType {
        return [t.element]
    }
    no_arguments: Type[]: []
    return no_arguments
}

// ---- canonical key + walk -------------------------------------------------

/// Stable single-line key for a type. Used by mono-instance DCE and
/// any side-table keyed on Type identity. Distinct types always
/// produce distinct keys ; equivalent types always produce equal keys.
export canonical_key :: fn(t: Type) -> string {
    match t {
        is PrimitiveType -> { return "p${t.name}" }
        is StructType -> { return "s${t.symbol.id}<${canonical_args_key(t.args)}>" }
        is TraitType  -> { return "t${t.symbol.id}<${canonical_args_key(t.args)}>" }
        is ArrayType  -> { return "a(${canonical_key(t.element)})" }
        is TupleType      -> { return "T<${canonical_args_key(t.elements)}>" }
        is FnType         -> { return "F<${canonical_args_key(t.params)}>>${canonical_key(t.return_type)}" }
        is UnionType      -> { return "U<${canonical_args_key(t.variants)}>" }
        is TypeParamType  -> { return "P${t.symbol.id}" }
        is EnumType       -> { return "e${t.symbol.id}" }
        is DistinctType   -> { return "d${t.symbol.id}" }
        is RangeType      -> { return range_key(t) }
        is TypeMetaType   -> { return "M" }
        is SelfType       -> { return "S" }
        is UnresolvedType -> { return "?" }
        is NeverType      -> { return "!" }
        is FreeIntType    -> { return "FI" }
        is FreeCharType   -> { return "FC" }
        is FreeFloatType  -> { return "FF" }
        is AnyType        -> { return "A" }
        is InferVar       -> { return "I${t.id}" }
    }
}

// A machine integer's range keys by its name, as a primitive does : shorter to
// build than its bounds, and no primitive has the name of an integer.
range_key :: fn(r: RangeType) -> string {
    machine :: machine_integer_name(r.bounds)
    if machine != "" {
        return "p${machine}"
    }
    return "r${display_bounds(r.bounds)}"
}

/// Compose an arg-list canonical key: used as the inner key in
/// mono-instance DCE and impl-method indexing.
export canonical_args_key :: fn(args: Type[]) -> string {
    if args.len() == 0 { return "" }
    sb :: StringBuilder {}
    first := true
    for a in args {
        if !first { sb.append(",") }
        first = false
        sb.append(canonical_key(a))
    }
    return sb.to_string()
}

/// Walk `t` and every nested type (struct/trait args, array element,
/// tuple elements, fn params + return, union variants) calling `visit`
/// on each. Pre-order, root included.
export for_each_type :: fn(t: Type, visit: fn(Type) -> void) -> void {
    visit(t)
    match t {
        is StructType -> { for a in t.args { for_each_type(a, visit) } }
        is TraitType  -> { for a in t.args { for_each_type(a, visit) } }
        is ArrayType  -> { for_each_type(t.element, visit) }
        is TupleType  -> { for el in t.elements { for_each_type(el, visit) } }
        is FnType     -> {
            for p in t.params { for_each_type(p, visit) }
            for_each_type(t.return_type, visit)
        }
        is UnionType -> { for v in t.variants { for_each_type(v, visit) } }
        is DistinctType -> { for_each_type(t.backing, visit) }
        _ -> {}
    }
}

/// Whether `t` or a type nested in it satisfies `pred`: `for_each_type`'s walk,
/// stopping at the first type that does.
///
/// @param t     the type to walk.
/// @param pred  the test, applied root first.
export any_type :: fn(t: Type, pred: fn(Type) -> bool) -> bool {
    if pred(t) {
        return true
    }
    // @partial: only these variants nest other types ; every other one is a leaf.
    @partial match t {
        is StructType   -> { return any_type_each(t.args, pred) }
        is TraitType    -> { return any_type_each(t.args, pred) }
        is ArrayType    -> { return any_type(t.element, pred) }
        is TupleType    -> { return any_type_each(t.elements, pred) }
        is FnType       -> { return any_type_each(t.params, pred) || any_type(t.return_type, pred) }
        is UnionType    -> { return any_type_each(t.variants, pred) }
        is DistinctType -> { return any_type(t.backing, pred) }
        _ -> { return false }
    }
}

any_type_each :: fn(ts: Type[], pred: fn(Type) -> bool) -> bool {
    for t in ts {
        if any_type(t, pred) {
            return true
        }
    }
    return false
}

/// True when `t` carries a `DistinctType` anywhere in its tree. Guards
/// `strip_distinct` so the common (distinct-free) type returns unchanged
/// without a rebuild.
export contains_distinct :: fn(t: Type) -> bool {
    if t is DistinctType { return true }
    if t is StructType { for a in t.args { if contains_distinct(a) { return true } } }
    if t is TraitType { for a in t.args { if contains_distinct(a) { return true } } }
    if t is ArrayType { return contains_distinct(t.element) }
    if t is TupleType { for el in t.elements { if contains_distinct(el) { return true } } }
    if t is FnType {
        for p in t.params { if contains_distinct(p) { return true } }
        return contains_distinct(t.return_type)
    }
    if t is UnionType { for v in t.variants { if contains_distinct(v) { return true } } }
    return false
}

/// Replace every `DistinctType` in `t` with its backing, recursively.
///
/// A distinct (newtype) has no runtime identity (Axe E): it monomorphises,
/// boxes and lays out exactly as its backing primitive, so the backend must
/// never see one inside a monomorphisation instance key. Applied to type-args
/// at every instance-registration source (`lower/generic_call.vader`, `lower/ufcs.vader`,
/// `queue_generic_impl_receiver`, `materialize_shape`) so `MutableMap<BlockId>`
/// IS `MutableMap<i32>` for the whole lowerer / comptime / emit pipeline: one
/// raw instance, no separate erased instance to collide with the genuine one.
/// Nominal distinctness is a typechecker-only concept; it ends here, at the
/// lowering boundary.
///
/// @param t  any type, possibly carrying distincts nested anywhere.
/// @return   the structurally-identical type with all distincts collapsed
///           (returns `t` unchanged when it carries none).
export strip_distinct :: fn(t: Type) -> Type {
    // Fast path : a primitive or an integer (the common type-arg) can't carry a
    // distinct, so skip the structural `contains_distinct` walk on the hot
    // classifier path.
    if t is PrimitiveType | RangeType { return t }
    if !contains_distinct(t) { return t }
    if t is DistinctType { return strip_distinct(t.backing) }
    if t is StructType { return mk_struct(t.symbol, strip_distinct_each(t.args)) }
    if t is TraitType { return TraitType { ...t, .args = strip_distinct_each(t.args) } }
    if t is ArrayType { return mk_array(strip_distinct(t.element)) }
    if t is TupleType { return mk_tuple(strip_distinct_each(t.elements)) }
    if t is FnType {
        return mk_fn(strip_distinct_each(t.params), strip_distinct(t.return_type))
    }
    if t is UnionType { return mk_union(strip_distinct_each(t.variants)) }
    return t
}

/// The backing array of `t`: `t` itself when it's an array, or the array a
/// distinct newtype wraps (`BigInt :: u32[]` → `u32[]`). `null` for anything
/// else. Lets the STRUCTURAL array ops (index, `len`/`push`, literal coercion,
/// for-in) forward through an array-backed distinct newtype while its trait
/// impls (operator overloads) stay nominal on the distinct's own key.
///
/// Unwraps only the OUTER distinct: the element type is preserved verbatim, so
/// `LocalId[]` stays `LocalId[]` (NOT `strip_distinct`, which would deep-strip
/// the element to `i32[]` and corrupt `arr[i]`'s type).
export array_backing :: fn(t: Type) -> ArrayType | null {
    if t is ArrayType { return t }
    if t is DistinctType { return array_backing(t.backing) }
    return null
}

/// The backing struct of `t`: `t` itself when it's a struct, or the struct a
/// distinct newtype wraps (`Color :: Rgb` → `Rgb`). `null` for anything else.
/// Lets the STRUCTURAL struct ops (field access, struct-literal construction)
/// forward through a struct-backed distinct newtype while its trait impls
/// (operator overloads) stay nominal on the distinct's own key.
///
/// Unwraps only the OUTER distinct: the struct's type args are preserved
/// verbatim (mirror of `array_backing`).
export struct_backing :: fn(t: Type) -> StructType | null {
    if t is StructType { return t }
    if t is DistinctType { return struct_backing(t.backing) }
    return null
}

/// The backing tuple of `t`: `t` itself when it's a tuple, or the tuple a
/// distinct newtype wraps (`Coord :: [i32, i32]` → `[i32, i32]`). `null` for
/// anything else. Lets the STRUCTURAL tuple ops (positional `.0` access,
/// literal construction, `[a, b]` destructure) forward through a tuple-backed
/// distinct newtype while its trait impls stay nominal on the distinct's key.
export tuple_backing :: fn(t: Type) -> TupleType | null {
    if t is TupleType { return t }
    if t is DistinctType { return tuple_backing(t.backing) }
    return null
}

/// The scalar `t` is : `t` itself when it is a primitive or an integer, or the
/// scalar a distinct newtype wraps, through any number of distinct layers
/// (`Handle :: CPointer` → `CPointer`). `null` for anything else : what `==`
/// compares two scalars through.
export scalar_backing :: fn(t: Type) -> PrimitiveType | RangeType | null {
    if t is PrimitiveType | RangeType { return t }
    if t is DistinctType { return scalar_backing(t.backing) }
    return null
}

/// The data `src` carries when it is an enum whose header declares `target` as
/// its variant data (`Info(variant)`) ; null otherwise.
export enum_data_of :: fn(src: Type, target: Type) -> StructType | null {
    if src is EnumType {
        data :: src.data ?? return null
        if is_assignable(data, target) { return data }
    }
    return null
}

/// The type a mixed instance keeps for the type argument `t` ; null when `t`
/// erases to `Any`, i.e. when the instance shares its body with every other
/// instance erasing there. Every site that depends on the split asks this one
/// question, the monomorphiser's flavor gate, substitutions and instance
/// suffix, and the `is` tests that cannot see through a shared body (T3087),
/// so they always agree on the instance.
///
/// A primitive is kept, and so is a newtype over one, as its backing, a machine
/// integer under its integer's name (`range_representation`). An enum is kept as
/// itself (ADR 0100) : a shared body would read its arrays, stored in its integer,
/// as boxes, and reach its integer's impls rather than its own. Every other type
/// erases, any other range included : a test at run time cannot tell it from its
/// integer. The lowering alone keeps such a range (`kept_argument`), for the
/// instance at it to check what it gets back.
///
/// @param t  a concrete type argument of the instance.
export kept_type_argument :: fn(t: Type) -> Type | null {
    backing :: strip_distinct(t)
    if backing is PrimitiveType | EnumType {
        return backing
    }
    if is_machine_integer(backing) {
        return range_representation(backing)
    }
    return null
}

/// Whether a value of `t` carries no tag of its own to test at run time : an erased
/// type parameter, or an instance of a generic struct whose body the instances
/// erasing one of its arguments share (T3087).
///
/// @param t  a variant of a union.
export is_untagged :: fn(t: Type) -> bool {
    if t is AnyType || t is TypeParamType {
        return true
    }
    if t is StructType {
        for arg in t.args {
            if arg !is UnresolvedType && kept_type_argument(arg) == null {
                return true
            }
        }
    }
    return false
}

/// Whether a boxed value of `t` is tagged as `t` itself, so a runtime `is t` tells it
/// from a value of any other type. Not an enum nor a distinct
/// (`boxes_as_representation`), nor a type with no tag to test (`is_untagged`).
///
/// @param t  the type of the value boxed.
export carries_own_tag :: fn(t: Type) -> bool = match t {
    is StructType -> !is_untagged(t)
    is ArrayType | PrimitiveType -> true
    // A machine integer's value is tagged as that integer.
    is RangeType -> is_machine_range(t)
    is EnumType | DistinctType | AnyType | TypeParamType | InferVar -> false
    // Never the receiver of an impl.
    is UnionType | TupleType | TraitType | FnType | SelfType | TypeMetaType -> false
    is NeverType | UnresolvedType | FreeIntType | FreeFloatType | FreeCharType -> false
}

/// Whether a boxed value of type `t` carries its representation's runtime type
/// rather than its own : an enum boxes as its integer, a distinct as its
/// backing. A trait dispatched on such a value reaches its own impl only where
/// its type is known statically.
///
/// @param t  the type of the value boxed.
export boxes_as_representation :: fn(t: Type) -> bool =
    t is EnumType || t is DistinctType || is_refinement(t)

/// Map `strip_distinct` over a type-arg list. Always returns a fresh array
/// with each element passed through `strip_distinct`.
/// @param args  the concrete type arguments.
/// @return      `args` with every distinct collapsed to its backing.
export strip_distinct_each :: fn(args: Type[]) -> Type[] {
    out: Type[]: []
    for a in args { out.push(strip_distinct(a)) }
    return out
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_default_if_free :: fn() -> void {
    assert_eq(display_type(default_if_free(TY_FREE_INT)), "i32")
    assert(default_if_free(TY_FREE_INT) is RangeType, "FreeInt defaults to the range `i32`")
    assert(equals_type(default_if_free(TY_FREE_FLOAT), TY_F64), "FreeFloat defaults to f64")
    // Non-free types pass through.
    assert(equals_type(default_if_free(TY_I32), TY_I32), "i32 should pass through")
}

@test
test_display_primitive :: fn() -> void {
    assert_eq(display_type(TY_I32), "i32")
    assert_eq(display_type(TY_STRING), "string")
}

@test
test_display_array :: fn() -> void {
    assert_eq(display_type(mk_array(TY_I32)), "i32[]")
    assert_eq(display_type(mk_array(mk_array(TY_I32))), "i32[][]")
}

@test
test_display_tuple :: fn() -> void {
    el0: Type: TY_I32
    el1: Type: TY_STRING
    t :: mk_tuple([el0, el1])
    assert_eq(display_type(t), "[i32, string]")
}

@test
test_display_fn :: fn() -> void {
    p0: Type: TY_I32
    p1: Type: TY_STRING
    f :: mk_fn([p0, p1], TY_BOOL)
    assert_eq(display_type(f), "fn(i32, string) -> bool")
}

@test
test_display_union :: fn() -> void {
    v0: Type: TY_I32
    v1: Type: TY_STRING
    u :: mk_union([v0, v1])
    assert_eq(display_type(u), "i32 | string")
}

@test
test_display_struct_with_args :: fn() -> void {
    factory :: SymbolFactory {}
    sym :: factory.make(.Struct, "MutableMap", "test", "test", .Public, null)
    a0: Type: TY_STRING
    a1: Type: TY_I32
    s :: mk_struct(sym, [a0, a1])
    assert_eq(display_type(s), "MutableMap<string, i32>")
}

@test
test_display_struct_without_args :: fn() -> void {
    factory :: SymbolFactory {}
    sym :: factory.make(.Struct, "Point", "test", "test", .Public, null)
    s :: mk_struct(sym, [])
    assert_eq(display_type(s), "Point")
}

@test
test_display_type_names_locates_each_nominal_name :: fn() -> void {
    factory :: SymbolFactory {}
    map :: factory.make(.Struct, "MutableMap", "test", "test", .Public, null)
    point :: factory.make(.Struct, "Point", "test", "test", .Public, null)
    a0: Type: TY_STRING
    a1: Type: mk_struct(point, [])
    shown :: display_type_names(mk_array(mk_struct(map, [a0, a1])))
    assert_eq(shown.text, "MutableMap<string, Point>[]")
    assert_eq(shown.names.len(), 2)
    assert_eq(shown.text.byte_slice(shown.names[0].start, shown.names[0].end), "MutableMap")
    assert_eq(shown.text.byte_slice(shown.names[1].start, shown.names[1].end), "Point")
    assert_eq(shown.names[1].symbol.id, point.id)
}

@test
test_display_singletons :: fn() -> void {
    assert_eq(display_type(TY_TYPE), "type")
    assert_eq(display_type(TY_SELF), "Self")
    assert_eq(display_type(TY_UNRESOLVED), "?")
    assert_eq(display_type(TY_NEVER), "never")
    assert_eq(display_type(TY_FREE_INT), "{integer}")
    assert_eq(display_type(TY_FREE_FLOAT), "{float}")
}

@test
test_display_type_param :: fn() -> void {
    factory :: SymbolFactory {}
    sym :: factory.make(.TypeParam, "T", "test", "test", .Private, null)
    tp :: mk_type_param(sym)
    assert_eq(display_type(tp), "T")
}

@test
test_mk_primitive_builds_an_integer_as_its_range :: fn() -> void {
    byte :: mk_primitive("u8")
    assert(byte is RangeType && same_interval(byte.bounds, interval(0, 255)), "u8 is a range")
    assert(TY_BOOL is PrimitiveType, "bool is a primitive")
}

@test
test_range_of_machine_bounds_reads_as_that_integer :: fn() -> void {
    byte :: RangeType { .bounds = interval(0, 255), .name = "Byte" }
    assert_eq(display_type(RangeType { .bounds = interval(0, 255) }), "u8")
    assert_eq(display_type(byte), "Byte")
    assert_eq(canonical_key(byte), canonical_key(mk_primitive("u8")))
    assert_eq(impl_base_key(byte), "u8")
}

@test
test_display_nested :: fn() -> void {
    // fn(i32[], string) -> i32 | null
    arr: Type: mk_array(TY_I32)
    str: Type: TY_STRING
    i32_t: Type: TY_I32
    null_t: Type: TY_NULL
    ret :: mk_union([i32_t, null_t])
    f :: mk_fn([arr, str], ret)
    assert_eq(display_type(f), "fn(i32[], string) -> i32 | null")
}
