// vader/core/types/task_runtime: what a primitive of `std/task` is to a task, and which
// structs its tasks share.
//
// A primitive of `std/task` is a piece of the runtime: its body shares a task's state
// with the threads of the scheduler, which no task may race on. The compiler does not
// read that body: it reads what the primitive is to a task from its `@task_primitive`
// (`vader/front/effects/task_primitives.vader`), as a `TaskPrimitive`, which also says
// what the primitive does to the struct it is lent (a task, a channel, a lock's cell,
// an atomic), by the names of that struct's fields.
//
// The structs tasks share by design carry `@task_shared`. A task holding one reaches
// the same value as every other: the task check does not race them, and a deep copy
// keeps them instead of copying them. Both decorators are private to `std/task`, so no
// other module can write them.

module "vader/core/types"

import "std/iter"
import "vader/core/symbol"

AST :: import "toolchain/ast"

/// What a primitive is to a task. Each `i64` field names a parameter by its
/// position. Each `string` field names a field of the struct the primitive is lent
/// as its first parameter, `""` for none: a primitive that names none does nothing
/// to that struct that a task could see.
export TaskPrimitive :: struct {
    /// The fn a task runs.
    runs: i64 | null = null
    /// A value handed on to other tasks, which may do anything with it.
    gives: i64 | null = null
    /// The task whose end the call waits for, or the array of tasks when
    /// `joins_array`.
    joins: i64 | null = null
    /// The call waits for each task of the array `joins` names: a combinator returns
    /// once all of them ended.
    joins_array: bool = false
    /// The fn run holding a lock, handed the value the lock guards.
    exclusive: i64 | null = null
    /// The call may park the task that makes it.
    parks: bool = false
    /// The field the call assigns.
    writes: string = ""
    /// The array field the call grows.
    grows: string = ""
    /// The call returns a value another task handed on, which belongs to the caller
    /// from then on: a function value it returns was checked where it was handed.
    takes: bool = false
    /// The field the lock guards, which the call hands to the fn `exclusive` names.
    guards: string = ""
}

/// The field of `Task` that holds what the task returns, which `join` hands back.
export TASK_RESULT :: "result"

/// The module that declares the primitives, the structs tasks share, and the two
/// decorators that mark them.
export TASK_MODULE :: "std/task"

/// The decorator of `TASK_MODULE` that says what a primitive is to a task.
export TASK_PRIMITIVE_DECORATOR :: "task_primitive"

// The decorator of `TASK_MODULE` that marks a struct tasks share by design.
TASK_SHARED_DECORATOR :: "task_shared"

/// Whether `sym` declares a struct tasks share by design: every task holding one
/// reaches the same value, which a deep copy keeps instead of copying.
///
/// @param sym   the struct's declaration symbol.
/// @param decl  its declaration, null when unknown: read for `@task_shared`.
export is_task_shared :: fn(sym: Symbol, decl: AST.StructDecl | null) -> bool {
    if sym.module_name != TASK_MODULE || decl == null {
        return false
    }
    return decl.decorators.any_match((d) -> d.name == TASK_SHARED_DECORATOR)
}

/// Whether `sym` declares the struct of a task, as `join` tells one: a struct tasks
/// share by design that holds the field `TASK_RESULT`, which `join` hands back.
///
/// @param sym   the struct's declaration symbol.
/// @param decl  its declaration, null when unknown.
export is_task_struct :: fn(sym: Symbol, decl: AST.StructDecl | null) -> bool {
    if !is_task_shared(sym, decl) || decl == null {
        return false
    }
    return decl.fields.any_match((f) -> f.name == TASK_RESULT)
}

// ---- tests ----------------------------------------------------------------

import "std/abort"
import "std/testing"
import "toolchain/parser"

// The struct `name` of `source`.
parsed_struct :: fn(source: string, name: string) -> AST.StructDecl {
    decls :: parse_source(source, "t.vader").program.decls
    return decls.filter_is<AST.StructDecl>().find((d) -> d.name == name)
        else panic("`${name}` should parse")
}

@test
test_task_shared_struct_is_told_by_its_decorator :: fn() -> void {
    source :: "@task_shared\nGate :: struct { open: bool }\nDoor :: struct { open: bool }\n"
    factory :: SymbolFactory {}
    gate :: factory.make(.Struct, "Gate", "std/task", "std/task", .Private, null)
    door :: factory.make(.Struct, "Door", "std/task", "std/task", .Private, null)
    elsewhere :: factory.make(.Struct, "Gate", "app", "app", .Private, null)
    assert(is_task_shared(gate, parsed_struct(source, "Gate")), "a marked struct")
    assert(!is_task_shared(door, parsed_struct(source, "Door")), "an unmarked struct")
    assert(!is_task_shared(elsewhere, parsed_struct(source, "Gate")), "a struct of the program")
}

@test
test_task_struct_is_a_shared_struct_holding_the_result :: fn() -> void {
    source :: """
        @task_shared
        Task :: struct { result: i32[] }
        @task_shared
        Channel :: struct { messages: i32[] }
        Plain :: struct { result: i32[] }
        """
    factory :: SymbolFactory {}
    task :: factory.make(.Struct, "Task", "std/task", "std/task", .Private, null)
    channel :: factory.make(.Struct, "Channel", "std/task", "std/task", .Private, null)
    plain :: factory.make(.Struct, "Plain", "std/task", "std/task", .Private, null)
    assert(is_task_struct(task, parsed_struct(source, "Task")), "a shared struct with a result")
    assert(!is_task_struct(channel, parsed_struct(source, "Channel")), "a shared struct without")
    assert(!is_task_struct(plain, parsed_struct(source, "Plain")), "a result, not shared")
}
