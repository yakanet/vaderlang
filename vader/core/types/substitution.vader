// vader/core/types/substitution: type parameters replaced by what binds them.
//
// A `Substitution` maps `TypeParam.symbol.id` to a concrete `Type` and optionally
// rebinds `Self`. The lowerer threads one per monomorphisation entry through every
// type-table read, so generic declarations collapse to concrete types in the
// lowered IR. Unification fills a bare map of bindings instead, which
// `substitute_map` applies; an argument is matched against the erased shape of a
// signature nothing has bound yet (`erase_type_params`).

module "vader/core/types"

import "std/collections"

// ---- by a substitution ----------------------------------------------------

/// Mapping from `TypeParam.symbol.id` to a concrete replacement type.
/// `self_type` rebinds `Self` to its concrete carrier inside an impl ;
/// callers leave it `null` for non-impl entries.
export Substitution :: struct {
    type_params: MutableMap<i32, Type>
    self_type:   Type | null
    /// Whether a type parameter is bound to a type holding a range of no machine
    /// integer's bounds : the lowering checks what such a parameter hands back
    /// (`bound_range`), and nothing in an instance binding none.
    binds_refinement: bool = false
}

/// The range of no machine integer's bounds `subst` binds `t` to, when `t` is a
/// type parameter it binds to one : the bounds a value handed back through it is
/// checked against (`kept_in_range`).
///
/// @param subst  an instance's substitution.
/// @param t      a type as the typecheck recorded it.
export bound_range :: fn(subst: Substitution, t: Type) -> RangeType | null {
    if t !is TypeParamType {
        return null
    }
    return refinement_of(subst.type_params[t.symbol.id])
}

/// Build an empty substitution. Cheap : its map starts empty, and `substitute`
/// short-circuits when no entry matches.
/// @return  a fresh substitution with no type-param bindings.
export new_substitution :: fn() -> Substitution {
    return Substitution {
        .type_params = MutableMap<i32, Type> {},
        .self_type   = null,
    }
}

/// True when `subst` has no bindings: every accessor's hot path skips
/// the `substitute` walk in this case.
/// @param subst  the substitution under test.
/// @return       true when no type-param and no `self` binding exist.
export is_empty_substitution :: fn(subst: Substitution) -> bool {
    if !subst.type_params.is_empty() { return false }
    if !(subst.self_type is null) { return false }
    return true
}

/// Replace `TypeParam` and `Self` occurrences in `t` per `subst`.
/// Walks the Type tree structurally, rebuilding every composite on the way ; an
/// empty substitution hands `t` back as it is.
/// @param t      the type to rewrite.
/// @param subst  the substitution to apply.
/// @return       the rewritten type (`t` itself under an empty substitution).
export substitute :: fn(t: Type, subst: Substitution) -> Type {
    if is_empty_substitution(subst) {
        return t
    }
    return substitute_in(t, subst.type_params, subst.self_type)
}

/// `t` with every `Self` replaced by `self_ty`: a trait member's signature read at
/// the receiver's type (`fn(Self) -> Self` is `fn(T) -> T` on a `T`).
///
/// @param t          the type to rewrite.
/// @param self_type  the receiver's type.
export substitute_self :: fn(t: Type, self_type: Type) -> Type = substitute_in(t, null, self_type)

// ---- by a map of bindings -------------------------------------------------

/// Walk `t` and replace each `TypeParam` whose symbol id appears in `subst` with
/// the bound concrete type. The `_map` suffix tells this fn apart from
/// `substitute`, which takes a `Substitution`: both take a `Type` first, so UFCS
/// could not tell them apart in an overload set.
///
/// @param t      the type to substitute_in.
/// @param subst  the bindings, by type parameter symbol id.
export substitute_map :: fn(t: Type, subst: MutableMap<i32, Type>) -> Type =
    substitute_in(t, subst, null)

/// Each of `types` through `substitute_map`.
///
/// @param types  the types to substitute_in.
/// @param subst  the bindings, by type parameter symbol id.
export substitute_each_map :: fn(types: Type[], subst: MutableMap<i32, Type>) -> Type[] =
    substitute_each_in(types, subst, null)

/// `f` with every bound type parameter replaced: `substitute_map` on a fn type,
/// typed as one (the instance's signature). The parameters `subst` binds leave its
/// quantifier.
///
/// @param f      a generic signature.
/// @param subst  the bindings, by type parameter symbol id.
export substitute_fn_map :: fn(f: FnType, subst: MutableMap<i32, Type>) -> FnType =
    substitute_fn_in(f, subst, null)

// ---- the walk -------------------------------------------------------------

// `t` with each type parameter `bindings` binds, and `Self`, replaced. A union is
// rebuilt canonical (`union_of`): `T | null` with `T` erased to `Any` must sort by
// what it now displays.
// @partial: only a type parameter, `Self` and the composite variants carry what a
// substitution replaces; every other variant comes back as it is, a distinct
// included, whose backing holds no parameter.
substitute_in :: fn(
    t: Type,
    bindings: MutableMap<i32, Type> | null,
    self_type: Type | null,
) -> Type = @partial match t {
    is TypeParamType -> binding_of(t, bindings)
    is SelfType      -> self_type ?? t
    is ArrayType     -> mk_array(substitute_in(t.element, bindings, self_type))
    is TupleType     -> mk_tuple(substitute_each_in(t.elements, bindings, self_type))
    is StructType    -> mk_struct(t.symbol, substitute_each_in(t.args, bindings, self_type))
    is TraitType     -> TraitType { ...t, .args = substitute_each_in(t.args, bindings, self_type) }
    is FnType        -> substitute_fn_in(t, bindings, self_type)
    is UnionType     -> union_of(substitute_each_in(t.variants, bindings, self_type))
    _                -> t
}

substitute_each_in :: fn(
    types: Type[],
    bindings: MutableMap<i32, Type> | null,
    self_type: Type | null,
) -> Type[] {
    out: Type[]: []
    for t in types {
        out.push(substitute_in(t, bindings, self_type))
    }
    return out
}

// The parameters `bindings` binds leave the signature's quantifier.
substitute_fn_in :: fn(
    f: FnType,
    bindings: MutableMap<i32, Type> | null,
    self_type: Type | null,
) -> FnType = FnType {
    ...f,
    .params = substitute_each_in(f.params, bindings, self_type),
    .return_type = substitute_in(f.return_type, bindings, self_type),
    .type_params = unbound_quantifier(f.type_params, bindings),
}

// What `bindings` binds `tp` to, or `tp` itself.
binding_of :: fn(tp: TypeParamType, bindings: MutableMap<i32, Type> | null) -> Type {
    if bindings == null {
        return tp
    }
    return bindings[tp.symbol.id] ?? tp
}

// The parameters of `quantifier` that `bindings` leaves unbound: `quantifier`
// itself, not a copy, when it binds none of them.
unbound_quantifier :: fn(
    quantifier: TypeParamType[],
    bindings: MutableMap<i32, Type> | null,
) -> TypeParamType[] {
    if bindings == null || !binds_any(quantifier, bindings) {
        return quantifier
    }
    out: TypeParamType[]: []
    for tp in quantifier {
        if tp.symbol.id !in bindings {
            out.push(tp)
        }
    }
    return out
}

binds_any :: fn(quantifier: TypeParamType[], bindings: MutableMap<i32, Type>) -> bool {
    for tp in quantifier {
        if tp.symbol.id in bindings {
            return true
        }
    }
    return false
}

// ---- erasure --------------------------------------------------------------

/// `t` with every type parameter replaced by a wildcard: the shape to match an
/// argument against when nothing has bound the parameters yet : picking an
/// overload, fitting a UFCS receiver, inferring a generic struct literal's
/// arguments from its fields. `is_assignable` holds a type parameter opaque, so
/// those questions ask it about this shape instead of the declared one.
///
/// @param t  a type from a generic signature or declaration.
/// @return   `t`, its type parameters turned into `TY_UNRESOLVED`.
export erase_type_params :: fn(t: Type) -> Type =
    if type_contains_type_param(t) { erase_params_in(t) } else { t }

// The rebuilt shape is only ever an `is_assignable` target, so a union keeps its
// variants as they are (`mk_union`) rather than being re-normalised.
// @partial: only TypeParam and the composite variants can hold a type-param; every
// scalar / primitive variant is returned unchanged.
erase_params_in :: fn(t: Type) -> Type = @partial match t {
    is TypeParamType -> TY_UNRESOLVED
    is InferVar      -> TY_UNRESOLVED
    is ArrayType     -> mk_array(erase_params_in(t.element))
    is TupleType     -> mk_tuple(erase_each(t.elements))
    is StructType    -> mk_struct(t.symbol, erase_each(t.args))
    is TraitType     -> TraitType { ...t, .args = erase_each(t.args) }
    is FnType        -> mk_fn(erase_each(t.params), erase_params_in(t.return_type))
    is UnionType     -> mk_union(erase_each(t.variants))
    _                -> t
}

erase_each :: fn(types: Type[]) -> Type[] {
    out: Type[]: []
    for t in types {
        out.push(erase_params_in(t))
    }
    return out
}

// ---- what a type still waits on -------------------------------------------

/// True if `t` contains at least one `TypeParam`, or an inference variable,
/// anywhere in its shape : a slot that still waits on a type parameter.
///
/// @param t  the type to scan.
// @partial: only TypeParam and the composite variants can hold a type-param; every
// scalar / primitive variant has no inner type.
export type_contains_type_param :: fn(t: Type) -> bool = @partial match t {
    is TypeParamType | InferVar -> true
    is ArrayType  -> type_contains_type_param(t.element)
    is TupleType  -> any_contains_type_param(t.elements)
    is StructType -> any_contains_type_param(t.args)
    is TraitType  -> any_contains_type_param(t.args)
    is FnType     -> any_contains_type_param(t.params) || type_contains_type_param(t.return_type)
    is UnionType  -> any_contains_type_param(t.variants)
    _             -> false
}

/// Whether any of `ts` contains a type parameter or an inference variable
/// (`type_contains_type_param`).
///
/// @param ts  the types to scan.
export any_contains_type_param :: fn(ts: Type[]) -> bool {
    for t in ts { if type_contains_type_param(t) { return true } }
    return false
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "vader/core/symbol"

fresh_type_param :: fn(symbol_id: i32, name: string) -> Symbol =
    fresh_symbol(symbol_id, name, .TypeParam)

fresh_symbol :: fn(symbol_id: i32, name: string, kind: SymbolKind) -> Symbol {
    return Symbol {
        .id         = symbol_id,
        .kind       = kind,
        .name       = name,
        .module     = "test",
        .module_name = "test",
        .visibility = .Private,
        .defined_at = null,
    }
}

@test test_empty_substitution_is_identity :: fn() -> void {
    subst :: new_substitution()
    assert(is_empty_substitution(subst), "fresh substitution should be empty")
    same :: substitute(TY_I32, subst)
    assert_eq(display_type(same), "i32")
}

@test test_substitute_type_param :: fn() -> void {
    sym :: fresh_type_param(7, "T")
    subst :: new_substitution()
    subst.type_params[7] = TY_I64
    rewritten :: substitute(mk_type_param(sym), subst)
    assert_eq(display_type(rewritten), "i64")
}

@test test_substitute_into_array :: fn() -> void {
    sym :: fresh_type_param(3, "T")
    subst :: new_substitution()
    subst.type_params[3] = TY_STRING
    rewritten :: substitute(mk_array(mk_type_param(sym)), subst)
    assert_eq(display_type(rewritten), "string[]")
}

@test
test_substitute_self_reaches_trait_arguments :: fn() -> void {
    iterator :: mk_trait(fresh_symbol(9, "Iterator", .Trait), [TY_SELF])
    assert_eq(display_type(substitute_self(iterator, TY_I32)), "Iterator<i32>")
}

@test
test_substitute_keeps_the_quantifier_it_leaves_unbound :: fn() -> void {
    t :: TypeParamType { .symbol = fresh_type_param(1, "T") }
    u :: TypeParamType { .symbol = fresh_type_param(2, "U") }
    subst :: new_substitution()
    subst.type_params[1] = TY_I64
    instance :: substitute(mk_fn([t], u, [t, u]), subst)
    if instance !is FnType {
        assert(false, "a fn type stays a fn type")
        return
    }
    assert_eq(display_type(instance.params[0]), "i64")
    assert_eq(instance.type_params.len(), 1)
    assert_eq(instance.type_params[0].symbol.name, "U")
}
