// vader/core/symbol: symbol table primitives.
//
// Symbols are minted by the resolver as
// it walks the AST and consumed by every later phase. A symbol carries its
// kind, name, module, visibility and source span ; it holds no
// back-reference to its AST declaration.

module "vader/core/symbol"

import "toolchain/ast"
import "toolchain/span"

/// What a kind of symbol carries besides its identity.
export SymbolKindInfo :: struct {
    /// Stable display name, as dumps and diagnostics print it.
    label: string
}

/// What a symbol names ; `kind.label` is its display name.
export SymbolKind :: enum(SymbolKindInfo) {
    Fn            { .label = "fn" },
    Struct        { .label = "struct" },
    Enum          { .label = "enum" },
    Trait         { .label = "trait" },
    Impl          { .label = "impl" },
    TypeAlias     { .label = "type-alias" },
    Const         { .label = "const" },
    ImportBinding { .label = "import-binding" },
    Param         { .label = "param" },
    TypeParam     { .label = "type-param" },
    Local         { .label = "local" },
    Binding       { .label = "binding" },
    BuiltinType   { .label = "builtin-type" },
    BuiltinFn     { .label = "builtin-fn" },
    Synthetic     { .label = "synthetic" },
    /// The struct a `generator`'s call returns, holding its suspended state: the
    /// compiler declares it, so no source names it.
    GeneratorState { .label = "generator-state" },
}

export Symbol :: struct {
    id:          i32
    kind:        SymbolKind
    name:        string
    /// The module's IDENTITY: its physical folder. Compared for "same module"
    /// tests, and NOT usable as a stable key: it is an absolute path, so it
    /// differs between a checkout, a `dist/` bundle and a staged temp dir.
    module:      string
    /// The module's DECLARED name (`module "vader/core/types"`). One module resolves
    /// to exactly one folder, so this identifies the same thing as `module`
    /// while staying identical everywhere, which is what a type-intern key
    /// needs. Same split as `Module.id` vs `Module.display_path`.
    module_name: string
    visibility:  Visibility
    defined_at:  Span | null
}

/// Whether `sym` names a module constant, whose value is frozen.
///
/// @param sym  the symbol a name resolves to.
export is_frozen_const :: fn(sym: Symbol) -> bool = sym.kind == .Const

/// Whether a symbol of this kind names a local binding: a parameter, a local,
/// a pattern binding.
///
/// @param kind  the symbol's kind.
export is_local_binding :: fn(kind: SymbolKind) -> bool =
    kind == .Param || kind == .Local || kind == .Binding

/// Whether a symbol of this kind declares a type: a struct, a trait, an enum, a
/// type alias, a type parameter, a builtin type.
///
/// @param k  the symbol's kind.
// @partial: only type-introducing kinds are type kinds; every other SymbolKind → false.
export is_type_kind :: fn(k: SymbolKind) -> bool = @partial match k {
    .Struct | .GeneratorState | .Trait | .Enum | .TypeAlias | .TypeParam | .BuiltinType -> true
    _ -> false
}

// IDs start at 1 so dumps keyed on the id stay stable.
export SymbolFactory :: struct {
    next: i32 = 1
}

export make :: fn(
        self: SymbolFactory,
        kind: SymbolKind,
        name: string,
        module: string,
        module_name: string,
        visibility: Visibility,
        defined_at: Span | null,
    ) -> Symbol {
    id :: self.next
    self.next = id + 1
    return Symbol {
        .id         = id,
        .kind       = kind,
        .name       = name,
        .module      = module,
        .module_name = module_name,
        .visibility = visibility,
        .defined_at = defined_at,
    }
}
