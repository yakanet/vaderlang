// vader/core/mono/mono_entry: the specialised-decl entry shape.
//
// Defines `MonoEntry` : one concrete fn / struct / const / impl-member
// decl the lowerer is about to emit, carrying its source decl, owning
// module, substitution, type-args, stable id, and mangled name. The
// lowerer (`lower_decl`, `lower_lambda`, `lower_mono_*`) builds these and
// the bytecode emit / c emitter route on `id` / `mangled` / `is_main`.

module "vader/core/mono"

import "toolchain/ast"
import "toolchain/span"
import "vader/core/symbol"
import "vader/core/types"

/// One specialised decl. Carries every field downstream phases need to
/// emit a concrete function / struct / const : the source decl, its
/// owning module, the resolved substitution, the (possibly empty)
/// type-arg list, plus a stable `id` + `mangled` name used as routing
/// identity by the bytecode emit, the C emitter, and the binary writer.
export MonoEntry :: struct {
    /// Pipeline-stable numeric identity. Used by DCE root detection,
    /// VM entry-point lookup, and the C emitter's `main()` shim — none
    /// of them re-parse `mangled` to recover the entry's role. Assigned
    /// monotonically at construction.
    id: i32

    /// True iff the origin decl is the top-level `main` fn. Replaces
    /// the older `mangled.endsWith("\$main")` heuristic so back-ends are
    /// free to rename the externalised symbol without breaking routing.
    is_main: bool

    /// External / human-readable name : `main`, `List\$i32`, … Used by
    /// the C emitter for the C symbol, the binary writer for the
    /// section header, and `vader dump` for diagnostics.
    mangled: string

    /// Origin decl in the source AST. Multiple `MonoEntry` can share
    /// the same origin (different specialisations).
    decl: Decl

    /// The decl's symbol, when applicable. `ImplDecl` has none — its
    /// members ship as separate entries.
    symbol: Symbol | null

    /// Substitution mapping `TypeParam.symbol.id` to the concrete
    /// type-args. Empty for non-generic decls.
    subst: Substitution

    /// Concrete type-args in source order when this entry comes from a
    /// generic instantiation ; empty otherwise.
    type_arguments: Type[]

    /// Path of the module the origin decl lives in (`ResolvedModule.path`, the key
    /// of `TypedProject.modules`), where its resolver tables are looked up ; empty
    /// for an entry no module declares.
    module: string

    /// The vtable slot this fn fills when it is an impl member, or the guard that
    /// stands in for one (`vader/lower/guard_equals.vader`) ; null for every other
    /// fn. The vtables are built from it.
    vtable_slot: VtableSlot | null = null
}

/// The vtable slot an impl member fills : its trait's `trait_key` and the
/// method a `vcall` names — together the key `"${trait}.${method}"`.
export VtableSlot :: struct {
    trait_key:  string
    method: string
}

/// A stub source decl for a synthesised symbol, for the `decl` of its
/// `MonoEntry`: a `StructDecl` for a struct, a `FnDecl` otherwise, so a walker
/// that matches on the decl takes the arm of what the symbol names. Every field
/// is written out.
///
/// @param symbol  the synthesised symbol.
export stub_decl_for :: fn(symbol: Symbol) -> Decl {
    if symbol.kind == .Struct {
        struct_decl: Decl: StructDecl {
            .span = empty_span(),
            .id = UNASSIGNED_NODE_ID,
            .name = symbol.name,
            .name_span = empty_span(),
            .visibility = .Private,
            .type_params = [],
            .fields = [],
            .decorators = [],
        }
        return struct_decl
    }
    fn_decl: Decl: FnDecl {
        .span = empty_span(),
        .id = UNASSIGNED_NODE_ID,
        .name = symbol.name,
        .name_span = empty_span(),
        .visibility = .Private,
        .type_params = [],
        .params = [],
        .return_type = null,
        .body = null,
        .decorators = [],
        .sam_synthetic = false,
        .is_expression_bodied = false,
        .materialized = false,
    }
    return fn_decl
}
