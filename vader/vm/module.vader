// vader/vm/module — the VM's runtime state wrapper over a `BytecodeModule`.
//
// The VM executes a `vader/bytecode::BytecodeModule` directly. `VmState`
// pairs the module with the run-time state the executor needs in a ready-to-use
// shape, built once here rather than per `exec_entry` — the data pool
// materialised, the entry index, per-function tables. Each field's doc says what
// it caches and why.
//
// Same `vader/vm` module as the sibling `op.vader` (opcodes), `value.vader`
// (runtime values), and `virt_reader_bc.vader` (the `.virt` → `BytecodeModule`
// reader + the `reduce_*` projections `prepare` reuses).

module "vader/vm"

import "std/collections"
import "std/iter"
bc :: import "vader/bytecode"

/// Runtime state the executor threads through its call chain. `bc` is the
/// parsed module (read-only) ; `data_pool` is its data pool materialised to
/// runtime `ArrayVal`s ; `main_index` is the entry fn's index in `bc.functions`.
export VmState :: struct {
    bc:         bc.BytecodeModule
    /// The pool materialised, one header per entry, index-aligned with
    /// `bc.data_pool`. Each header is stamped with the type_id its `data.const`
    /// sites use and handed out as is: nothing writes through a pool entry.
    data_pool:  ArrayVal[]
    /// The value of each global slot, index-aligned with `bc.globals`.
    globals:    Value[]
    /// Entry fn's index in `bc.functions`.
    main_index: i32
    /// The `string[]` ArrayType index — stamped onto every host-produced string
    /// array (argv, `read_dir`, `split`) so `is string[]` narrows. Resolving it
    /// costs a linear type-table scan, so it is done once here rather than on
    /// every `exec_entry` (the comptime pass calls into the VM once PER staged
    /// decl, so a per-entry scan is O(decls x types)).
    string_array_type_id: i32
    /// The `u8[]` ArrayType index — stamped onto the array `bytes` materialises.
    u8_array_type_id: i32
    /// The `std/io$IOError` struct index — stamped onto host io error values.
    io_error_type_id: i32
    /// `fn name -> index`, so `exec_fn` / `exec_fn_value` resolve an entry by
    /// one lookup instead of a linear string-compare scan. The comptime pass
    /// resolves one entry per staged decl, which made that scan O(decls x fns).
    fn_index_by_name: MutableMap<string, i32>
    /// Manifest classification of each import, index-aligned with `bc.imports`,
    /// so `call.import` never re-runs `intrinsic_id_for` (which rebuilds and
    /// interns mangled names). A user `@extern` names a linker symbol, never a
    /// manifest entry, so it is recorded `NotIntrinsic` without classifying.
    import_ids: bc.IntrinsicId[]
    /// The code the VM runs (`reg_translate.vader`), index-aligned with
    /// `bc.functions`.
    @internal
    reg: RegModule
    /// Whether `reg` carries the `Line` ops a debugger stops at (`prepare_debug`).
    @internal
    debuggable: bool
}

/// Verify a `BytecodeModule` and wrap it in the runtime `VmState` `exec`
/// consumes. Materialises the data pool and resolves the entry index up front so
/// the hot loop never re-decodes either. A direct call to a small straight-line
/// leaf is replaced by the leaf's body first (`inline_leaf.vader`).
///
/// @param bc_mod  the parsed module (from `parse_virt_bc` or the builder).
/// @return        a `VmState` ready to pass to `exec`.
/// @error         a `VerifyError` when the bytecode is malformed (`verify.vader`),
///                when an arm could meet an operand tag it does not accept
///                (`tags.vader`), or when a function has no register form
///                (`reg_translate.vader`) ; nothing of it runs.
export prepare :: fn(bc_mod: bc.BytecodeModule) -> VmState | VerifyError = prepare_for(bc_mod, false)

/// `prepare` for a run a debugger drives: the code carries a `Line` op at every
/// source position, where the debugger may stop, and no call is inlined, so every
/// call is a frame the debugger can step into.
///
/// @param bc_mod  the parsed module.
/// @return        a `VmState` to pass to `exec_entry` with a `DebugController`.
/// @error         as `prepare`.
export prepare_debug :: fn(bc_mod: bc.BytecodeModule) -> VmState | VerifyError = prepare_for(bc_mod, true)

prepare_for :: fn(module: bc.BytecodeModule, debug: bool) -> VmState | VerifyError {
    if !debug {
        // An inlined body's operand tags come from the caller's arguments, no
        // longer from the leaf's signature: a module whose arguments the tags
        // prove only through that signature runs without inlining.
        inlined :: prepare_module(inline_leaf_calls(module), false)
        if inlined is VmState {
            return inlined
        }
    }
    return prepare_module(module, debug)
}

prepare_module :: fn(bc_mod: bc.BytecodeModule, debug: bool) -> VmState | VerifyError {
    depths :: verify_module(bc_mod)
    if depths is VerifyError {
        return depths
    }
    facts :: infer_module_tags(bc_mod, depths)
    mistyped :: check_module_tags(bc_mod, facts)
    if mistyped != null {
        return mistyped
    }
    import_ids: bc.IntrinsicId[]: [] * bc_mod.imports.len()
    for imp in bc_mod.imports {
        if imp.is_extern {
            import_ids.push(.NotIntrinsic)
        } else {
            import_ids.push(bc.intrinsic_id_for(imp.mangled_name))
        }
    }
    reg :: translate_module(bc_mod, import_ids, facts, debug)
    if reg is VerifyError {
        return reg
    }
    by_name :: MutableMap<string, i32> {}
    for i in 0..<bc_mod.functions.len() {
        by_name[bc_mod.functions[i].name] = i32(i)
    }
    data_pool :: reduce_data_pool(bc_mod.data_pool, bc_mod.types, bc.data_pool_type_ids(bc_mod))
    return VmState {
        .bc                   = bc_mod,
        .data_pool            = data_pool,
        .globals              = initial_globals(bc_mod),
        .main_index           = reduce_main_index(bc_mod.functions),
        .string_array_type_id = find_string_array_type_id(bc_mod.types),
        .u8_array_type_id     = find_u8_array_type_id(bc_mod.types),
        .io_error_type_id     = find_io_error_type_id(bc_mod.types),
        .fn_index_by_name     = by_name,
        .import_ids           = import_ids,
        .reg                  = reg,
        .debuggable           = debug,
    }
}

// The value of each global slot of `module` before it is first written.
initial_globals :: fn(module: bc.BytecodeModule) -> Value[] =
    module.globals.map((g) -> global_zero(field_valtype(module.types, g.type_id))).collect()

// What a global slot of class `val` holds until it is first written: zero for a
// number, `false`, the NUL char, the empty string, null for anything else.
global_zero :: fn(val: bc.ValType) -> Value = match val {
    .I8 | .I16 | .I32 | .U8 | .U16 | .U32  -> I32Val(0)
    .I64 | .Isize | .U64 | .Usize          -> I64Val(0)
    .F32 | .F64                            -> F64Val(0.0)
    .Bool                                  -> BoolVal(false)
    .Char                                  -> CharVal(char(u32(0)))
    .String                                -> StringVal("")
    .Null | .Void | .Pointer | .Ref | .Any -> NullVal {}
}
