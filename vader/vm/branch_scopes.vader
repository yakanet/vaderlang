// vader/vm/branch_scopes — label-keyed scope stack and branch wiring.
//
// Two producers fill a function's jump table from a labelled scope stack:
// `builder.vader` (building a body op by op) and `virt_reader.vader`
// (replaying a `.virt` dump). Both open scopes with `block` / `loop` / `if`,
// both resolve `br` / `br_if` against the innermost matching label, and both
// defer a forward branch until its scope closes. The state is four arrays plus
// two cursors, so the operations take those directly rather than a carrier
// struct — `FunctionBuilder` and `ParserState` each keep their own fields and
// pass them in.
//
// `midir/emit.vader` has a sibling of `defer_or_resolve_branch` that resolves
// by `BlockId` instead of by label, and prefers loop scopes on a tie; it is a
// different rule, not a copy of this one.

module "vader/vm"

/// Append `entry` to the grow-only `scopes` array at `sp_box[0]` and advance
/// the cursor. Reuses an already-allocated slot when one is available
/// (cursor < array length), saving an allocation per push for the second and
/// subsequent functions in a module.
///
/// @param scopes  the grow-only scope stack (shared across functions).
/// @param sp_box  1-element cursor — `[0]` is the logical top index.
/// @param entry   the scope to push.
push_scope :: fn(scopes: ScopeEntry[]!, sp_box: usize[]!, entry: ScopeEntry) -> void {
    sp :: sp_box[0]
    if sp == scopes.len() {
        scopes.push(entry)
    } else {
        scopes[sp] = entry
    }
    sp_box[0] += 1
}

/// Wire one `br` / `br_if` against the innermost scope carrying `label`.
///
/// A branch to a loop label resolves immediately — the loop's opener pc is
/// already known. A branch to a `block` / `if` / `else` label targets a pc
/// that does not exist yet, so it is appended to the pending list and drained
/// by `drain_pending` when that scope closes. An unmatched label is left
/// unwired: the caller has already reported the malformed input.
///
/// @param scopes      the scope stack.
/// @param scope_sp    1-element scope cursor.
/// @param table       the jump table being filled.
/// @param pending     the grow-only pending-branch list.
/// @param pending_sp  1-element pending cursor.
/// @param label       the branch's target label.
/// @param pc          pc of the branching op being wired.
defer_or_resolve_branch :: fn(scopes: ScopeEntry[], scope_sp: usize[], table: i32[]!,
                             pending: PendingBranch[]!, pending_sp: usize[]!,
                             label: string, pc: i32) -> void {
    // Innermost match wins — walk down from the top of the stack.
    i := i64(scope_sp[0]) - 1
    for i >= 0 {
        if scopes[usize(i)].label == label {
            break
        }
        i -= 1
    }
    if i < 0 {
        return
    }
    target :: scopes[usize(i)]
    if target.is_loop {
        table[usize(pc)] = target.opener_pc + 1
        return
    }
    psp :: pending_sp[0]
    entry :: PendingBranch { .branch_pc = pc, .target_label = label }
    if psp == pending.len() {
        pending.push(entry)
    } else {
        pending[psp] = entry
    }
    pending_sp[0] += 1
}

/// When a scope ends, fill in every pending branch that named it. Branches
/// that didn't match the closing scope's label stay pending, compacted to the
/// front of the cursor window.
///
/// @param table       the jump table being filled.
/// @param pending     the pending-branch list.
/// @param pending_sp  1-element pending cursor.
/// @param label       label of the scope just closed.
/// @param is_loop     `true` for loops (back-edge target = opener + 1).
/// @param opener_pc   pc of the scope's opener (block / loop / if / else).
/// @param end_pc      pc of the matching `end` op.
drain_pending :: fn(table: i32[]!, pending: PendingBranch[]!, pending_sp: usize[]!,
                    label: string, is_loop: bool, opener_pc: i32, end_pc: i32) -> void {
    psp :: pending_sp[0]
    new_sp: usize = 0
    for i in 0..<psp {
        entry :: pending[i]
        if entry.target_label != label {
            pending[new_sp] = entry
            new_sp += 1
            continue
        }
        if is_loop {
            table[usize(entry.branch_pc)] = opener_pc + 1
        } else {
            table[usize(entry.branch_pc)] = end_pc + 1
        }
    }
    pending_sp[0] = new_sp
}
