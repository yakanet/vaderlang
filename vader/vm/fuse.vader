// vader/vm/fuse — superinstructions, private to the interpreter.
//
// The bytecode a program ships is not the bytecode the VM has to dispatch. This
// pass rewrites each function's body once, at `prepare` time, folding adjacent op
// pairs into one — a dispatch turn costs the same whatever the op does, so a pair
// folded is a turn saved.
//
// PRIVATE to `vader/vm`, and it has to stay that way: nothing here is exported and
// `VmState.fused` is `@internal`, so the widening stops at the module edge. The
// shared `Op` union in `vader/bytecode` gains no variant, which is what keeps the
// `.virt` dumps, the C backend and every committed snapshot reading the same ops
// they always did.
//
// Two rewrites, both renumbering the pc space: adjacent pairs folded into one
// op, and the structural nops dropped. `jump_table` is rebuilt against the new
// indices, and an op that any branch LANDS ON is never absorbed into the pair
// before it.
//
// The debugger reads `body.debug[frame.pc]`, which is indexed in the ORIGINAL pc
// space. `exec_entry` therefore dispatches the unfused body whenever a
// `DebugController` is attached — the DAP compiles `optimize = false` anyway.

module "vader/vm"

// Wildcard, not the `bc ::` alias the rest of `vader/vm` uses: a union alias whose
// left operand is reached through a namespace alias does not parse as a TYPE —
// `VmOp :: Op | Get2` reads the `|` as an operator and reports T3017 / T3002.
import "vader/bytecode"

// ---- the fused op set -----------------------------------------------------

/// Two adjacent `local.get`s as one turn — the most frequent adjacent pair in the
/// tree by a wide margin.
Get2 :: struct {
    slot_a: i32
    slot_b: i32
}

/// `local.set A ; local.get B` — the statement boundary: finish storing into A,
/// begin reading B. `set N ; get N` never reaches here, the bytecode peephole
/// having already folded it to `local.tee`.
///
/// Fused unless slot A is NARROW: a narrow store routes through `narrow_mask`,
/// which the arm does not carry. The gate is per SLOT, not per function —
/// masking a wide valtype is identity (`narrow_mask` returns its argument), so a
/// wide store inside a function that merely contains a narrow slot is still a
/// plain column copy.
SetGet :: struct {
    set_slot: i32
    get_slot: i32
}

/// `local.get A ; <int>.const V`. `tag` is the stack tag the constant lands with,
/// resolved here so the arm stores a word instead of branching on a width.
GetConst :: struct {
    slot:  i32
    value: i64
    tag:   StackTag
}

/// What the interpreter actually dispatches: every shipped op, plus the fused
/// ones. `Op` is unchanged, so this widening is invisible outside `vader/vm`.
VmOp :: Op | Get2 | SetGet | GetConst

/// A function's dispatch-ready body, with its jump table rebuilt against it.
FusedBody :: struct {
    ops:        VmOp[]
    jump_table: i32[]
}

// ---- the pass -------------------------------------------------------------

/// Fuse every function of `mod`, in declaration order.
///
/// @param mod  the module whose functions to rewrite ; not mutated.
/// @return     one `FusedBody` per function, index-aligned with `mod.functions`.
fuse_module :: fn(mod: BytecodeModule) -> FusedBody[] {
    out: FusedBody[]! = [] * mod.functions.len()
    for f in mod.functions {
        out.push(fuse_body(f))
    }
    return out
}

/// Fuse one function body.
///
/// @param f  the function to rewrite ; not mutated.
/// @return   its dispatch-ready body and the jump table remapped to the new pc
///           space, with the pairs folded and the structural nops gone.
fuse_body :: fn(f: BcFunction) -> FusedBody {
    n :: f.body.len()
    // An op a branch lands on keeps its own index, so it is never absorbed into
    // the pair before it — otherwise the branch would arrive mid-superop.
    is_target :: mark_jump_targets(f.jump_table, n)
    ops: VmOp[]! = [] * n
    // Old pc → new pc. An absorbed op answers with its pair's index ; a dropped
    // one answers `-1`, which `remap_jump_table` resolves forward.
    remap: i32[]! = [0] * n
    i: usize = 0
    for i < n {
        op :: f.body[i]
        // `block` / `loop` / `end` carry NO runtime semantics — each arm is
        // `frame.pc + 1` and nothing else. They exist so `c_emit` can recover its
        // braces; the interpreter reaches every destination through `jump_table`.
        // Dropping them is safe because jumping to a nop is by definition jumping
        // to whatever follows it, and `remap_jump_table` reads the negative entry
        // below as "gone" and resolves such a branch forward to the next survivor.
        if op is Block | Loop | End {
            remap[i] = -1
            i = i + 1
            continue
        }
        remap[i] = i32(ops.len())
        if i + 1 < n && !is_target[i + 1] {
            fused :: fuse_pair(f, op, f.body[i + 1])
            if fused != null {
                ops.push(fused)
                remap[i + 1] = remap[i]
                i = i + 2
                continue
            }
        }
        ops.push(op)
        i = i + 1
    }
    return FusedBody { .ops = ops, .jump_table = remap_jump_table(f.jump_table, remap, ops.len()) }
}

/// The fused op for `a ; b`, or null when the pair has no rule.
///
/// @param f  the owning function — read for the set slot's valtype.
/// @param a  the first op of the adjacent pair.
/// @param b  the second — already known not to be a branch target.
fuse_pair :: fn(f: BcFunction, a: Op, b: Op) -> VmOp | null {
    if a is LocalGet {
        return get_pair(a.slot, b)
    }
    if a is LocalSet {
        // Per SLOT, not per function : `SetGet` stores straight into the columns,
        // so it is ruled out only when THIS slot is narrow.
        if is_narrow_valtype(slot_valtype(f, a.slot)) {
            return null
        }
        if b is LocalGet {
            return SetGet { .set_slot = a.slot, .get_slot = b.slot }
        }
    }
    return null
}

// Split out rather than nested in `fuse_pair`: testing `b` against several
// variants in one fn body and returning from each subtracts them from `b`'s type
// for the REST of the fn, so a later `b is LocalGet` in a sibling branch reports
// T3040 "test can never match". A separate fn is a separate narrowing scope.
get_pair :: fn(slot: i32, b: Op) -> VmOp | null {
    if b is LocalGet {
        return Get2 { .slot_a = slot, .slot_b = b.slot }
    }
    if b is I64Const {
        return GetConst { .slot = slot, .value = b.value, .tag = StackTag.I64 }
    }
    if b is I32Const {
        return GetConst { .slot = slot, .value = i64(b.value), .tag = StackTag.I32 }
    }
    return null
}
