// vader/vm/reg_code — the private code the register engine runs.
//
// `reg_translate.vader` turns each verified function into a `RegFunction` once, at
// `prepare`; `reg_exec.vader` runs it. A function's registers are a window of one
// register file shared by the whole execution: its parameters, its locals, its
// constants, then one register per operand-stack depth. A callee's window starts at the register
// holding its first argument, so arguments are never copied and its result lands
// where the caller expects it.
//
// A register operand is an offset from the frame's base.

module "vader/vm"

bc :: import "vader/bytecode"

// One register op. `a` / `b` / `c` name its three operands (`RegFunction.words`);
// the comment gives their meaning, registers written `r`. `i32`-wide: an array of
// a narrower enum is a byte array, whose every read tests whether it views a
// string's bytes.
RegOp :: enum(i32) {
    // r[a] <- r[b], all three columns.
    Move
    // r[a] <- r[b], bits and tag only: `b` is proven never to hold a reference.
    MoveScalar
    // Integer and float arithmetic: r[a] <- r[b] op r[c] ; unary ops read r[b].
    AddI32
    SubI32
    MulI32
    DivI32
    ModI32
    AndI32
    OrI32
    XorI32
    ShlI32
    ShrI32
    ShrUI32
    NegI32
    NotI32
    DivU32
    ModU32
    EqI32
    NeI32
    LtI32
    LeI32
    GtI32
    GeI32
    LtU32
    LeU32
    GtU32
    GeU32
    AddI64
    SubI64
    MulI64
    DivI64
    ModI64
    AndI64
    OrI64
    XorI64
    ShlI64
    ShrI64
    ShrUI64
    NegI64
    NotI64
    DivU64
    ModU64
    EqI64
    NeI64
    LtI64
    LeI64
    GtI64
    GeI64
    LtU64
    LeU64
    GtU64
    GeU64
    AddF64
    SubF64
    MulF64
    DivF64
    NegF64
    EqF64
    NeF64
    LtF64
    LeF64
    GtF64
    GeF64
    EqBool
    NeBool
    AndBool
    OrBool
    NotBool
    // r[a] <- r[b] as an i32 ; as an i64, sign- or zero-extended (`ToI64U`).
    ToI32
    ToI64
    ToI64U
    // pc <- a.
    Jump
    // pc <- a, a back edge: `b` original ops ran since the target (the comptime
    // step budget).
    JumpBack
    // pc <- a when r[b] is false / true.
    JumpIfFalse
    JumpIfTrue
    // pc <- a when r[b] op r[c] — a comparison fused with the branch reading it.
    // `>` and `>=` swap their operands onto `<` and `<=`.
    JumpEqI32
    JumpNeI32
    JumpLtI32
    JumpLeI32
    JumpLtU32
    JumpLeU32
    JumpEqI64
    JumpNeI64
    JumpLtI64
    JumpLeI64
    JumpLtU64
    JumpLeU64
    // Call function `a` with its arguments from r[b] ; its results land from r[b].
    Call
    // Call the function value on top of `c` arguments from r[b] ; `a` is its fn type.
    CallIndirect
    // Dispatch virtuals[a] on the receiver above its arguments from r[b].
    VirtualCall
    // Truncate r[a] to width `b`: 0 `u8`, 1 `i8`, 2 `u16`, 3 `i16` (`narrow_mask`).
    Narrow
    // Return r[a], or nothing when `a` is negative.
    Return
    // Return the `b` values from r[a].
    ReturnMany
    // The comptime step budget, counted on a back edge: `b` original ops ran since
    // the jump target.
    Budget
    // r[a] <- values[b], a reference built once.
    ConstRef
    // r[a] <- field `c` of the struct in r[b] ; field `c` of the struct in r[a] <- r[b].
    GetField
    SetField
    // r[a] <- element r[c] of the array in r[b] ; element r[b] of the array in r[a]
    // <- r[c] ; r[a] <- the length of the array in r[b] ; append r[b] to the array
    // in r[a].
    GetElement
    SetElement
    // `GetElement` / `SetElement` for `load_slot*` / `store_slot*`, which trap
    // under their own name.
    LoadSlot
    StoreSlot
    Length
    Append
    // Run boxed[a] on its operands from r[b] (`apply_boxed`) ; `c` packs the
    // values it pops, then eight bits up the values it pushes.
    Boxed
    // Call host import `a` with its arguments from r[b] ; its result lands in r[b].
    CallImport
    // Stop the run with texts[a].
    Trap
    // Push the closure in r[a] on the run's defer stack.
    DeferPush
    // Pop the last `a` deferred closures and run them, the last pushed first.
    DeferRun
    // An original op begins (`origin` names it): where a debugger may stop.
    // Emitted only in a translation for one (`prepare_debug`).
    Line
}

// One function, translated.
RegFunction :: struct {
    name:      string
    /// Its index in `BytecodeModule.functions`.
    index:     i32
    /// The ops ; op `k`'s operands are packed in `words[k]` (`pack_operands`).
    /// Flat columns, so fetching an op follows no pointer.
    ops:       RegOp[]!
    words:     i64[]!
    /// Original pc of each op, for trap messages.
    origin:    i32[]!
    /// The function's scalar constants, loaded into the registers from `slots`
    /// when a frame starts.
    consts:    i64[]!
    const_tags: StackTag[]!
    /// The references `ConstRef` loads.
    values:    Value![]!
    /// The ops `Boxed` runs.
    boxed:     bc.Op[]!
    /// The calls `VirtualCall` dispatches, and the vtable row of each (`-1` when
    /// no row has its key).
    virtuals:  bc.VirtualCall[]!
    virtual_rows: i32[]!
    texts:     string[]!
    /// Parameters, locals, then one register per operand-stack depth.
    registers: usize
    params:    usize
    /// Parameters plus locals: the registers a call resets.
    slots:     usize
}

// The translated module, index-aligned with `BytecodeModule.functions`.
RegModule :: struct {
    functions: RegFunction[]
}

// The widths `pack_operands` gives `a` and each of `b` / `c`, sign included.
OPERAND_A_BITS: i64: 22
OPERAND_BC_BITS: i64: 21

// `a`, `b`, `c` in one word — `a` in the low bits, then `b`, then `c` — or `null`
// when one does not fit its width.
pack_operands :: fn(a: i32, b: i32, c: i32) -> i64 | null {
    fits :: fits_signed(a, OPERAND_A_BITS) && fits_signed(b, OPERAND_BC_BITS)
        && fits_signed(c, OPERAND_BC_BITS)
    if !fits {
        return null
    }
    low :: i64(a) & ((1 << OPERAND_A_BITS) - 1)
    middle :: (i64(b) & ((1 << OPERAND_BC_BITS) - 1)) << OPERAND_A_BITS
    return low | middle | (i64(c) << (OPERAND_A_BITS + OPERAND_BC_BITS))
}

fits_signed :: fn(v: i32, bits: i64) = i64(v) >= -(1 << (bits - 1)) && i64(v) < 1 << (bits - 1)

operand_a :: fn(w: i64) = i32((w << (64 - OPERAND_A_BITS)) >> (64 - OPERAND_A_BITS))

operand_b :: fn(w: i64) = i32((w << OPERAND_BC_BITS) >> (64 - OPERAND_BC_BITS))

operand_c :: fn(w: i64) = i32(w >> (OPERAND_A_BITS + OPERAND_BC_BITS))

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_pack_operands_round_trip :: fn() -> void {
    for [a, b, c] in [[-1, 0, 7], [2_097_151, -1_048_576, 1_048_575], [-2_097_152, 5, -1]] {
        w :: pack_operands(a, b, c) ?? 0
        assert_eq(operand_a(w), a)
        assert_eq(operand_b(w), b)
        assert_eq(operand_c(w), c)
    }
}

@test
test_pack_operands_refuses_a_wide_operand :: fn() -> void {
    assert(pack_operands(2_097_152, 0, 0) == null, "a past 22 bits")
    assert(pack_operands(0, 1_048_576, 0) == null, "b past 21 bits")
}
