// vader/vm/reg_exec — the register engine: runs the `RegFunction`s
// `reg_translate.vader` produced.
//
// One register file serves the whole run, in three columns: raw bits, a
// `StackTag`, and the boxed `Value` a `.Ref` register holds. A frame is a window of it; the frame stack is three parallel
// arrays. `pc`, `base` and the running function's code are locals of the loop,
// reloaded only by a call or a return.
//
// Operand tags are not tested: `prepare` proved every one an arm relies on
// (`tags.vader`). What depends on a value stays checked here — a zero divisor,
// the call depth, the comptime step budget — and a trap message quotes the
// original pc.
//
// A trap runs every pending `defer` before it surfaces, the last pushed first, as
// the native runtime does ; a `defer` that traps in turn ends the unwind.

module "vader/vm"

bc :: import "vader/bytecode"

// The register file and frame stack of one run.
RegMachine :: struct {
    bits:  i64[]!
    tags:  StackTag[]!
    refs:  Value![]!
    run:   RunHost!
    /// Holds a `Boxed` op's operands while `apply_boxed` runs it.
    scratch: Frame!
    /// Per frame: the function, the first register of its window, and the pc its
    /// caller resumes at.
    frame_code:   RegFunction[]!
    frame_base:   usize[]!
    frame_return: usize[]!
    /// The closures `defer` pushed, for the whole run ; the live ones are
    /// `defers[0 ..< defer_count]`.
    defers:      Value[]!
    defer_count: usize
    /// The debugger driving the run, or `null`.
    debug: DebugSession! | null
}

// A debugger's state across the stops of one run.
DebugSession :: struct {
    controller: DebugController
    /// The line of the last `Line` op, so a line stops once, at its first op.
    last_line: i32
    /// How to resume after the last stop, and the frame depth it was taken at.
    step_mode:  StepMode
    step_depth: i32
}

// Grow the register file to at least `count` registers.
reserve_registers :: fn(m: RegMachine!, count: usize) -> void {
    for m.bits.len() < count {
        m.bits.push(0)
        m.tags.push(.Null)
        m.refs.push(NullVal {})
    }
}

// The value of register `at`, boxed.
register_value :: fn(m: RegMachine, at: usize) -> Value = match m.tags[at] {
    .Ref  -> m.refs[at]
    .I32  -> I32Val { .value = i32(m.bits[at]) }
    .I64  -> I64Val { .value = m.bits[at] }
    .F64  -> F64Val { .value = (u64(m.bits[at])).from_bits() }
    .Bool -> BoolVal { .value = m.bits[at] != 0 }
    .Char -> CharVal { .value = char(u32(m.bits[at])) }
    .Null -> NullVal {}
}

// Write a boxed value into register `at`.
set_register :: fn(m: RegMachine!, at: usize, value: Value!) -> void = match value {
    is I32Val -> {
        m.bits[at] = i64(value.value)
        m.tags[at] = .I32
    }
    is I64Val -> {
        m.bits[at] = value.value
        m.tags[at] = .I64
    }
    is F64Val -> {
        m.bits[at] = i64((value.value).to_bits())
        m.tags[at] = .F64
    }
    is BoolVal -> {
        m.bits[at] = if value.value { 1 } else { 0 }
        m.tags[at] = .Bool
    }
    is CharVal -> {
        m.bits[at] = i64(u32(value.value))
        m.tags[at] = .Char
    }
    is NullVal -> { m.tags[at] = .Null }
    _ -> {
        m.refs[at] = value
        m.tags[at] = .Ref
    }
}

// Copy register `from` into `to`, all three columns.
move_register :: fn(m: RegMachine!, to: usize, from: usize) -> void {
    m.bits[to] = m.bits[from]
    m.tags[to] = m.tags[from]
    m.refs[to] = m.refs[from]
}

/// Run `code.functions[entry_index]` ; see `exec_entry` for the parameters.
reg_run :: fn(
    state: VmState, code: RegModule, entry_index: i32, host_argv: string[], capture: Value[]! | null,
    is_comptime: bool, debug: DebugController | null,
) -> VmResult {
    entry_function :: state.bc.functions[usize(entry_index)]
    args :: build_main_args(entry_function, host_argv, state.string_array_type_id)
    if args is Trap {
        return args
    }
    session: DebugSession! | null: if debug != null {
        DebugSession { .controller = debug, .last_line = -1, .step_mode = .Continue, .step_depth = 0 }
    } else {
        null
    }
    m :: RegMachine {
        .bits         = [],
        .tags         = [],
        .refs         = [],
        .run          = new_run_host(),
        .scratch      = scratch_frame(),
        .frame_code   = [],
        .frame_base   = [],
        .frame_return = [],
        .defers       = [],
        .defer_count  = 0,
        .debug        = session,
    }
    reserve_registers(m, code.functions[usize(entry_index)].registers)
    for i in 0..<args.len() {
        set_register(m, i, args[i])
    }
    outcome :: reg_call(state, code, m, entry_index, 0, 0, 0, is_comptime)
    if outcome is Trap {
        unwind(state, code, m, is_comptime)
        return outcome
    }
    return finish_run(m, bc.bc_result_arity(entry_function.signature) == 1, capture)
}

// Run function `entry`, its arguments in the registers from `window`, as the frame
// at `depth0`, until it returns ; its results land from `window`. `resume` is the pc
// the frame below continues at, for the debugger's call stack.
reg_call :: fn(
    state: VmState, code: RegModule, m: RegMachine!, entry: i32, window: usize, depth0: usize, resume: usize,
    is_comptime: bool,
) -> Trap | null {
    f := code.functions[usize(entry)]
    if depth0 >= usize(MAX_FRAME_DEPTH) {
        return overflow_trap(f.name)
    }
    enter_frame(m, f, window)
    if depth0 < m.frame_code.len() {
        m.frame_code[depth0] = f
        m.frame_base[depth0] = window
        m.frame_return[depth0] = resume
    } else {
        grow_frame_records(m, f, window, resume)
    }
    step_budget :: if is_comptime { COMPTIME_STEP_BUDGET } else { STEP_BUDGET_UNREACHABLE }
    steps: i64 = 0
    depth: usize = depth0 + 1
    base: usize = window
    pc: usize = 0
    ops := f.ops
    words := f.words
    bits :: m.bits
    tags :: m.tags
    refs :: m.refs
    for {
        op :: ops[pc]
        w :: words[pc]
        match op {
            .Move -> {
                to :: base + usize(operand_a(w))
                from :: base + usize(operand_b(w))
                bits[to] = bits[from]
                tags[to] = tags[from]
                refs[to] = refs[from]
            }
            .MoveScalar -> {
                to :: base + usize(operand_a(w))
                from :: base + usize(operand_b(w))
                bits[to] = bits[from]
                tags[to] = tags[from]
            }
            .AddI32 -> { set_i32(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w)) + i32_of(bits, base, operand_c(w))) }
            .SubI32 -> { set_i32(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w)) - i32_of(bits, base, operand_c(w))) }
            .MulI32 -> { set_i32(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w)) * i32_of(bits, base, operand_c(w))) }
            .DivI32 -> {
                d :: i32_of(bits, base, operand_c(w))
                if d == 0 {
                    return Trap { .message = "i32.div by zero at pc=${f.origin[pc]}" }
                }
                set_i32(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w)) / d)
            }
            .ModI32 -> {
                d :: i32_of(bits, base, operand_c(w))
                if d == 0 {
                    return Trap { .message = "i32.mod by zero at pc=${f.origin[pc]}" }
                }
                set_i32(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w)) % d)
            }
            .AndI32 -> { set_i32(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w)) & i32_of(bits, base, operand_c(w))) }
            .OrI32  -> { set_i32(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w)) | i32_of(bits, base, operand_c(w))) }
            .XorI32 -> { set_i32(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w)) ^ i32_of(bits, base, operand_c(w))) }
            .ShlI32 -> { set_i32(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w)) << i32_of(bits, base, operand_c(w))) }
            .ShrI32 -> { set_i32(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w)) >> i32_of(bits, base, operand_c(w))) }
            .ShrUI32 -> {
                lhs :: u32(i32_of(bits, base, operand_b(w)))
                set_i32(bits, tags, base, operand_a(w), i32(lhs >> u32(i32_of(bits, base, operand_c(w)))))
            }
            .NegI32 -> { set_i32(bits, tags, base, operand_a(w), -i32_of(bits, base, operand_b(w))) }
            .NotI32 -> { set_i32(bits, tags, base, operand_a(w), ~i32_of(bits, base, operand_b(w))) }
            .DivU32 -> {
                d :: i32_of(bits, base, operand_c(w))
                if d == 0 {
                    return Trap { .message = "u32.div by zero at pc=${f.origin[pc]}" }
                }
                set_i32(bits, tags, base, operand_a(w), i32(u32(i32_of(bits, base, operand_b(w))) / u32(d)))
            }
            .ModU32 -> {
                d :: i32_of(bits, base, operand_c(w))
                if d == 0 {
                    return Trap { .message = "u32.rem by zero at pc=${f.origin[pc]}" }
                }
                set_i32(bits, tags, base, operand_a(w), i32(u32(i32_of(bits, base, operand_b(w))) % u32(d)))
            }
            .EqI32 -> { set_bool(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w)) == i32_of(bits, base, operand_c(w))) }
            .NeI32 -> { set_bool(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w)) != i32_of(bits, base, operand_c(w))) }
            .LtI32 -> { set_bool(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w)) < i32_of(bits, base, operand_c(w))) }
            .LeI32 -> { set_bool(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w)) <= i32_of(bits, base, operand_c(w))) }
            .GtI32 -> { set_bool(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w)) > i32_of(bits, base, operand_c(w))) }
            .GeI32 -> { set_bool(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w)) >= i32_of(bits, base, operand_c(w))) }
            .LtU32 -> { set_bool(bits, tags, base, operand_a(w), u32_of(bits, base, operand_b(w)) < u32_of(bits, base, operand_c(w))) }
            .LeU32 -> { set_bool(bits, tags, base, operand_a(w), u32_of(bits, base, operand_b(w)) <= u32_of(bits, base, operand_c(w))) }
            .GtU32 -> { set_bool(bits, tags, base, operand_a(w), u32_of(bits, base, operand_b(w)) > u32_of(bits, base, operand_c(w))) }
            .GeU32 -> { set_bool(bits, tags, base, operand_a(w), u32_of(bits, base, operand_b(w)) >= u32_of(bits, base, operand_c(w))) }
            .AddI64 -> { set_i64(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) + bits_of(bits, base, operand_c(w))) }
            .SubI64 -> { set_i64(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) - bits_of(bits, base, operand_c(w))) }
            .MulI64 -> { set_i64(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) * bits_of(bits, base, operand_c(w))) }
            .DivI64 -> {
                d :: bits_of(bits, base, operand_c(w))
                if d == 0 {
                    return Trap { .message = "i64.div by zero at pc=${f.origin[pc]}" }
                }
                set_i64(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) / d)
            }
            .ModI64 -> {
                d :: bits_of(bits, base, operand_c(w))
                if d == 0 {
                    return Trap { .message = "i64.rem by zero at pc=${f.origin[pc]}" }
                }
                set_i64(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) % d)
            }
            .AndI64 -> { set_i64(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) & bits_of(bits, base, operand_c(w))) }
            .OrI64  -> { set_i64(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) | bits_of(bits, base, operand_c(w))) }
            .XorI64 -> { set_i64(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) ^ bits_of(bits, base, operand_c(w))) }
            .ShlI64 -> { set_i64(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) << bits_of(bits, base, operand_c(w))) }
            .ShrI64 -> { set_i64(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) >> bits_of(bits, base, operand_c(w))) }
            .ShrUI64 -> {
                set_i64(bits, tags, base, operand_a(w), i64(u64(bits_of(bits, base, operand_b(w))) >> u64(bits_of(bits, base, operand_c(w)))))
            }
            .NegI64 -> { set_i64(bits, tags, base, operand_a(w), -bits_of(bits, base, operand_b(w))) }
            .NotI64 -> { set_i64(bits, tags, base, operand_a(w), ~bits_of(bits, base, operand_b(w))) }
            .DivU64 -> {
                d :: bits_of(bits, base, operand_c(w))
                if d == 0 {
                    return Trap { .message = "u64.div by zero at pc=${f.origin[pc]}" }
                }
                set_i64(bits, tags, base, operand_a(w), i64(u64(bits_of(bits, base, operand_b(w))) / u64(d)))
            }
            .ModU64 -> {
                d :: bits_of(bits, base, operand_c(w))
                if d == 0 {
                    return Trap { .message = "u64.rem by zero at pc=${f.origin[pc]}" }
                }
                set_i64(bits, tags, base, operand_a(w), i64(u64(bits_of(bits, base, operand_b(w))) % u64(d)))
            }
            .EqI64 -> { set_bool(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) == bits_of(bits, base, operand_c(w))) }
            .NeI64 -> { set_bool(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) != bits_of(bits, base, operand_c(w))) }
            .LtI64 -> { set_bool(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) < bits_of(bits, base, operand_c(w))) }
            .LeI64 -> { set_bool(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) <= bits_of(bits, base, operand_c(w))) }
            .GtI64 -> { set_bool(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) > bits_of(bits, base, operand_c(w))) }
            .GeI64 -> { set_bool(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) >= bits_of(bits, base, operand_c(w))) }
            .LtU64 -> { set_bool(bits, tags, base, operand_a(w), u64(bits_of(bits, base, operand_b(w))) < u64(bits_of(bits, base, operand_c(w)))) }
            .LeU64 -> { set_bool(bits, tags, base, operand_a(w), u64(bits_of(bits, base, operand_b(w))) <= u64(bits_of(bits, base, operand_c(w)))) }
            .GtU64 -> { set_bool(bits, tags, base, operand_a(w), u64(bits_of(bits, base, operand_b(w))) > u64(bits_of(bits, base, operand_c(w)))) }
            .GeU64 -> { set_bool(bits, tags, base, operand_a(w), u64(bits_of(bits, base, operand_b(w))) >= u64(bits_of(bits, base, operand_c(w)))) }
            .AddF64 -> { set_f64(bits, tags, base, operand_a(w), f64_of(bits, base, operand_b(w)) + f64_of(bits, base, operand_c(w))) }
            .SubF64 -> { set_f64(bits, tags, base, operand_a(w), f64_of(bits, base, operand_b(w)) - f64_of(bits, base, operand_c(w))) }
            .MulF64 -> { set_f64(bits, tags, base, operand_a(w), f64_of(bits, base, operand_b(w)) * f64_of(bits, base, operand_c(w))) }
            .DivF64 -> { set_f64(bits, tags, base, operand_a(w), f64_of(bits, base, operand_b(w)) / f64_of(bits, base, operand_c(w))) }
            .NegF64 -> { set_f64(bits, tags, base, operand_a(w), -f64_of(bits, base, operand_b(w))) }
            .EqF64 -> { set_bool(bits, tags, base, operand_a(w), f64_of(bits, base, operand_b(w)) == f64_of(bits, base, operand_c(w))) }
            .NeF64 -> { set_bool(bits, tags, base, operand_a(w), f64_of(bits, base, operand_b(w)) != f64_of(bits, base, operand_c(w))) }
            .LtF64 -> { set_bool(bits, tags, base, operand_a(w), f64_of(bits, base, operand_b(w)) < f64_of(bits, base, operand_c(w))) }
            .LeF64 -> { set_bool(bits, tags, base, operand_a(w), f64_of(bits, base, operand_b(w)) <= f64_of(bits, base, operand_c(w))) }
            .GtF64 -> { set_bool(bits, tags, base, operand_a(w), f64_of(bits, base, operand_b(w)) > f64_of(bits, base, operand_c(w))) }
            .GeF64 -> { set_bool(bits, tags, base, operand_a(w), f64_of(bits, base, operand_b(w)) >= f64_of(bits, base, operand_c(w))) }
            .EqBool  -> { set_bool(bits, tags, base, operand_a(w), (bits_of(bits, base, operand_b(w)) != 0) == (bits_of(bits, base, operand_c(w)) != 0)) }
            .NeBool  -> { set_bool(bits, tags, base, operand_a(w), (bits_of(bits, base, operand_b(w)) != 0) != (bits_of(bits, base, operand_c(w)) != 0)) }
            .AndBool -> { set_bool(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) != 0 && bits_of(bits, base, operand_c(w)) != 0) }
            .OrBool  -> { set_bool(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) != 0 || bits_of(bits, base, operand_c(w)) != 0) }
            .NotBool -> { set_bool(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w)) == 0) }
            .ToI32 -> { set_i32(bits, tags, base, operand_a(w), i32_of(bits, base, operand_b(w))) }
            .ToI64 -> { set_i64(bits, tags, base, operand_a(w), bits_of(bits, base, operand_b(w))) }
            .ToI64U -> {
                from :: base + usize(operand_b(w))
                n :: if tags[from] == .I32 { i64(u32(i32(bits[from]))) } else { bits[from] }
                set_i64(bits, tags, base, operand_a(w), n)
            }
            .Jump -> {
                pc = usize(operand_a(w))
                continue
            }
            .JumpBack -> {
                steps += i64(operand_b(w))
                if steps > step_budget {
                    return budget_trap(step_budget)
                }
                pc = usize(operand_a(w))
                continue
            }
            .JumpIfFalse -> {
                if bits_of(bits, base, operand_b(w)) == 0 {
                    pc = usize(operand_a(w))
                    continue
                }
            }
            .JumpIfTrue -> {
                if bits_of(bits, base, operand_b(w)) != 0 {
                    pc = usize(operand_a(w))
                    continue
                }
            }
            .JumpEqI32 -> {
                if i32_of(bits, base, operand_b(w)) == i32_of(bits, base, operand_c(w)) {
                    pc = usize(operand_a(w))
                    continue
                }
            }
            .JumpNeI32 -> {
                if i32_of(bits, base, operand_b(w)) != i32_of(bits, base, operand_c(w)) {
                    pc = usize(operand_a(w))
                    continue
                }
            }
            .JumpLtI32 -> {
                if i32_of(bits, base, operand_b(w)) < i32_of(bits, base, operand_c(w)) {
                    pc = usize(operand_a(w))
                    continue
                }
            }
            .JumpLeI32 -> {
                if i32_of(bits, base, operand_b(w)) <= i32_of(bits, base, operand_c(w)) {
                    pc = usize(operand_a(w))
                    continue
                }
            }
            .JumpEqI64 -> {
                if bits_of(bits, base, operand_b(w)) == bits_of(bits, base, operand_c(w)) {
                    pc = usize(operand_a(w))
                    continue
                }
            }
            .JumpNeI64 -> {
                if bits_of(bits, base, operand_b(w)) != bits_of(bits, base, operand_c(w)) {
                    pc = usize(operand_a(w))
                    continue
                }
            }
            .JumpLtI64 -> {
                if bits_of(bits, base, operand_b(w)) < bits_of(bits, base, operand_c(w)) {
                    pc = usize(operand_a(w))
                    continue
                }
            }
            .JumpLeI64 -> {
                if bits_of(bits, base, operand_b(w)) <= bits_of(bits, base, operand_c(w)) {
                    pc = usize(operand_a(w))
                    continue
                }
            }
            .JumpLtU32 -> {
                if u32_of(bits, base, operand_b(w)) < u32_of(bits, base, operand_c(w)) {
                    pc = usize(operand_a(w))
                    continue
                }
            }
            .JumpLeU32 -> {
                if u32_of(bits, base, operand_b(w)) <= u32_of(bits, base, operand_c(w)) {
                    pc = usize(operand_a(w))
                    continue
                }
            }
            .JumpLtU64 -> {
                if u64_of(bits, base, operand_b(w)) < u64_of(bits, base, operand_c(w)) {
                    pc = usize(operand_a(w))
                    continue
                }
            }
            .JumpLeU64 -> {
                if u64_of(bits, base, operand_b(w)) <= u64_of(bits, base, operand_c(w)) {
                    pc = usize(operand_a(w))
                    continue
                }
            }
            .Budget -> {
                steps += i64(operand_b(w))
                if steps > step_budget {
                    return budget_trap(step_budget)
                }
            }
            .Boxed -> {
                failed :: run_boxed(state, m, f, pc, base)
                if failed != null {
                    return failed
                }
            }
            .CallImport -> {
                failed :: call_import(state, m, operand_a(w), base + usize(operand_b(w)), f.origin[pc], is_comptime)
                if failed != null {
                    return failed
                }
            }
            .Trap -> { return Trap { .message = f.texts[usize(operand_a(w))] } }
            .DeferPush -> {
                closure :: register_value(m, base + usize(operand_a(w)))
                if m.defer_count < m.defers.len() {
                    m.defers[m.defer_count] = closure
                } else {
                    m.defers.push(closure)
                }
                m.defer_count += 1
            }
            .DeferRun -> {
                failed :: run_defers(state, code, m, f, pc, base + f.registers, depth, is_comptime)
                if failed != null {
                    return failed
                }
            }
            .Line -> {
                session :: m.debug
                if session != null {
                    stop_at_line(state, m, session, f, pc, depth)
                }
            }
            .ConstRef -> {
                to :: base + usize(operand_a(w))
                refs[to] = f.values[usize(operand_b(w))]
                tags[to] = .Ref
            }
            .GetField -> {
                target :: refs[base + usize(operand_b(w))]
                field :: operand_c(w)
                if target is StructVal && field >= 0 && usize(field) < target.fields.len() {
                    set_register(m, base + usize(operand_a(w)), target.fields[usize(field)])
                } else {
                    // Not a struct, or no such field: the same test, trapping.
                    failed :: read_struct_field(target, field, f.origin[pc], "struct.get")
                    if failed is Trap {
                        return failed
                    }
                }
            }
            .SetField -> {
                failed :: set_field(m, base, operand_a(w), operand_b(w), operand_c(w), f, pc)
                if failed != null {
                    return failed
                }
            }
            .GetElement | .LoadSlot -> {
                failed :: get_element(m, base, operand_a(w), operand_b(w), operand_c(w), f, pc, op == .LoadSlot)
                if failed != null {
                    return failed
                }
            }
            .SetElement | .StoreSlot -> {
                failed :: set_element(m, base, operand_a(w), operand_b(w), operand_c(w), f, pc, op == .StoreSlot)
                if failed != null {
                    return failed
                }
            }
            .Length -> {
                array :: array_in(m, base + usize(operand_b(w)), f, pc, "array.len")
                if array is Trap {
                    return array
                }
                set_i32(bits, tags, base, operand_a(w), i32(array.length))
            }
            .Append -> {
                array :: array_in(m, base + usize(operand_a(w)), f, pc, "array.push")
                if array is Trap {
                    return array
                }
                detach_array_view(array)
                array.elements.push(register_value(m, base + usize(operand_b(w))))
                array.length = array.length + 1
            }
            .Narrow -> { narrow_register(m, base + usize(operand_a(w)), operand_b(w)) }
            .Call | .CallIndirect | .VirtualCall -> {
                at :: base + usize(operand_b(w))
                index: i32 = operand_a(w)
                if op != .Call {
                    resolved :: resolve_dynamic_call(state, m, f, pc, op, w, at, is_comptime)
                    if resolved is Trap {
                        return resolved
                    }
                    index = resolved
                }
                // A negative index: a host primitive impl served the call.
                if index >= 0 {
                    callee :: code.functions[usize(index)]
                    steps += 1
                    if depth >= usize(MAX_FRAME_DEPTH) {
                        return overflow_trap(callee.name)
                    }
                    // `enter_frame` spelled out: a call grows nothing once the run
                    // is warm, and the helpers — which may — do not inline.
                    if bits.len() < at + callee.registers {
                        reserve_registers(m, at + callee.registers)
                    }
                    for r in at + callee.params..<at + callee.slots {
                        tags[r] = .Null
                    }
                    constants :: at + callee.slots
                    for k in 0..<callee.consts.len() {
                        bits[constants + k] = callee.consts[k]
                        tags[constants + k] = callee.const_tags[k]
                    }
                    if depth < m.frame_code.len() {
                        m.frame_code[depth] = callee
                        m.frame_base[depth] = at
                        m.frame_return[depth] = pc + 1
                    } else {
                        grow_frame_records(m, callee, at, pc + 1)
                    }
                    depth += 1
                    base = at
                    f = callee
                    ops = f.ops
                    words = f.words
                    pc = 0
                    continue
                }
            }
            .Return | .ReturnMany -> {
                many :: op == .ReturnMany
                result :: operand_a(w)
                if many {
                    for k in 0..<usize(operand_b(w)) {
                        move_register(m, base + k, base + usize(result) + k)
                    }
                } else if result >= 0 {
                    move_register(m, base, base + usize(result))
                }
                depth -= 1
                if depth == depth0 {
                    if many && depth0 == 0 {
                        return Trap { .message = "return: a multi-value return reached the outermost frame" }
                    }
                    return null
                }
                pc = m.frame_return[depth]
                base = m.frame_base[depth - 1]
                f = m.frame_code[depth - 1]
                ops = f.ops
                words = f.words
                continue
            }
        }
        pc += 1
    }
}

// The array register `at` holds, writable — the in-place ops grow or overwrite the
// very object the register holds.
array_in :: fn(m: RegMachine!, at: usize, f: RegFunction, pc: usize, label: string) -> ArrayVal! | Trap! {
    if m.tags[at] == .Ref {
        v :: m.refs[at]
        if v is ArrayVal {
            return v
        }
    }
    got :: describe_value_tag(register_value(m, at))
    return Trap { .message = "${label} receiver at pc=${f.origin[pc]}: expected array, got ${got}" }
}

// The pc of a trap message is read only once the op traps: `f.origin[pc]`.
set_field :: fn(m: RegMachine!, base: usize, obj: i32, value: i32, field: i32, f: RegFunction, pc: usize) -> Trap | null {
    target :: m.refs[base + usize(obj)]
    if target is StructVal {
        if field < 0 || usize(field) >= target.fields.len() {
            count :: target.fields.len()
            return Trap { .message = "struct.set field ${field} out of range (struct has ${count} fields) at pc=${f.origin[pc]}" }
        }
        target.fields[usize(field)] = register_value(m, base + usize(value))
        return null
    }
    failed :: read_struct(target, f.origin[pc], "struct.set receiver")
    return if failed is Trap { failed } else { null }
}

// `slot` for a `load_slot*`, which traps under its own name.
get_element :: fn(
    m: RegMachine!, base: usize, dst: i32, array_reg: i32, index_reg: i32, f: RegFunction, pc: usize, slot: bool,
) -> Trap | null {
    label :: if slot { "load_slot" } else { "array.get" }
    index :: i32(m.bits[base + usize(index_reg)])
    array :: array_in(m, base + usize(array_reg), f, pc, label)
    if array is Trap {
        return array
    }
    if index < 0 || usize(index) >= array.length {
        return Trap { .message = "${label} index ${index} out of bounds (len=${array.length}) at pc=${f.origin[pc]}" }
    }
    set_register(m, base + usize(dst), array.elements[array.offset + usize(index)])
    return null
}

// `slot` for a `store_slot*`, which traps under its own name.
set_element :: fn(
    m: RegMachine!, base: usize, array_reg: i32, index_reg: i32, value: i32, f: RegFunction, pc: usize, slot: bool,
) -> Trap | null {
    label :: if slot { "store_slot" } else { "array.set" }
    index :: i32(m.bits[base + usize(index_reg)])
    array :: array_in(m, base + usize(array_reg), f, pc, label)
    if array is Trap {
        return array
    }
    if index < 0 || usize(index) >= array.length {
        return Trap { .message = "${label} index ${index} out of bounds (len=${array.length}) at pc=${f.origin[pc]}" }
    }
    array.elements[array.offset + usize(index)] = register_value(m, base + usize(value))
    return null
}

// Truncate register `at` to a narrow width, as `narrow_mask` does: only an integer
// is touched, and it comes back an `I32`.
narrow_register :: fn(m: RegMachine!, at: usize, width: i32) -> void {
    if m.tags[at] != .I32 && m.tags[at] != .I64 {
        return
    }
    bits: i64: if width < 2 { 8 } else { 16 }
    m.bits[at] = i64(truncate_to_width(m.bits[at], bits, width == 1 || width == 3))
    m.tags[at] = .I32
}

// The function a `call.indirect` or `virtual.call` at `pc` reaches, its arguments
// rearranged from register `at` the way that callee's parameters read them ; `-1`
// when a host primitive impl served the call, its result already in `at`.
resolve_dynamic_call :: fn(
    state: VmState, m: RegMachine!, f: RegFunction, pc: usize, op: RegOp, w: i64, at: usize, is_comptime: bool,
) -> i32 | Trap {
    origin :: f.origin[pc]
    if op == .CallIndirect {
        return resolve_indirect(state, m, operand_a(w), at, usize(operand_c(w)), origin)
    }
    site :: usize(operand_a(w))
    return resolve_virtual(state, m, f.virtuals[site], f.virtual_rows[site], at, origin, is_comptime)
}

// The fn value above `arity` arguments from `at` ; an environment it carries
// becomes the first argument, the others moving up one register.
resolve_indirect :: fn(state: VmState, m: RegMachine!, type_id: i32, at: usize, arity: usize, origin: i32) -> i32 | Trap {
    value :: read_fn(register_value(m, at + arity), origin, "call.indirect receiver")
    if value is Trap {
        return value
    }
    checked :: validate_fn_index(value.function_index, state.bc.functions, origin, "call.indirect")
    if checked is Trap {
        return checked
    }
    callee :: state.bc.functions[usize(value.function_index)]
    env :: value.env
    expected :: if env != null { arity + 1 } else { arity }
    declared :: callee.signature.params.len()
    if declared != expected {
        incl :: if env != null { " (incl. env)" } else { "" }
        return Trap { .message = "call.indirect arity mismatch at pc=${origin}: caller supplied ${expected}${incl} but '${callee.name}' declares ${declared} param(s)" }
    }
    if env != null {
        i := arity
        for i > 0 {
            move_register(m, at + i, at + i - 1)
            i -= 1
        }
        set_register(m, at, env)
    }
    return value.function_index
}

// The impl behind a `virtual.call` for the receiver on top of its arguments,
// moved to `at` ahead of them ; `-1` when a host primitive impl served it.
resolve_virtual :: fn(
    state: VmState, m: RegMachine!, call: bc.VirtualCall, row: i32, at: usize, origin: i32, is_comptime: bool,
) -> i32 | Trap {
    count :: usize(call.parameter_count)
    top :: at + count - 1
    receiver :: register_value(m, top)
    type_id :: receiver_type_id_of(state, receiver)
    if type_id < 0 {
        tag :: describe_value_tag(receiver)
        return Trap { .message = "virtual.call '${call.vtable_key}' : receiver tag ${tag} has no type id at pc=${origin}" }
    }
    target :: lookup_vtable_row(state.bc.vtables, row, type_id)
    i := top
    for i > at {
        move_register(m, i, i - 1)
        i -= 1
    }
    set_register(m, at, receiver)
    if target >= 0 {
        if is_fn_index_out_of_range(target, state.bc.functions) {
            return fn_index_trap(target, origin, "virtual.call '${call.vtable_key}'")
        }
        callee :: state.bc.functions[usize(target)]
        if callee.signature.params.len() != count {
            declared :: callee.signature.params.len()
            return Trap { .message = "virtual.call '${call.vtable_key}' : impl '${callee.name}' expects ${declared} param(s) but call site supplied ${call.parameter_count} at pc=${origin}" }
        }
        return target
    }
    // A host-provided impl on a primitive has no vtable row: rebuild its host
    // mangle and dispatch it as an import.
    kind :: primitive_kind_at(state.bc.types, type_id)
    mangle :: intrinsic_host_mangle(kind, call.vtable_key)
    if kind == "" || mangle == "" {
        return Trap { .message = "virtual.call '${call.vtable_key}' : no impl for type ${type_id} at pc=${origin}" }
    }
    info :: primitive_impl_import(mangle, count)
    args: Value[]!: []
    for k in 0..<count {
        args.push(register_value(m, at + k))
    }
    outcome :: dispatch_import(
        info, args, 0, m.run.gc_state, m.run.sched_state, origin, state.string_array_type_id,
        state.u8_array_type_id, state.io_error_type_id, state.bc.types, is_comptime, debug_controller(m),
        bc.intrinsic_id_for(mangle),
    )
    if outcome is Trap {
        return outcome
    }
    set_register(m, at, outcome.value)
    return -1
}

// A frame with room for the operands and results of any boxed op.
scratch_frame :: fn() -> Frame! {
    width: usize: 8
    return Frame {
        .stack   = width.filled(() -> NullVal {}),
        .payload = [0] * width,
        .tag     = [.Null] * width,
        .sp      = 0,
        .pc      = 0,
    }
}

// Run the `Boxed` op at `pc` on the scratch frame, its operands and results in the
// registers from r[b].
run_boxed :: fn(state: VmState, m: RegMachine!, f: RegFunction, pc: usize, base: usize) -> Trap | null {
    w :: f.words[pc]
    at :: base + usize(operand_b(w))
    pops :: usize(operand_c(w) & 255)
    pushes :: usize(operand_c(w) >> 8)
    frame :: m.scratch
    // An `array.new` or `struct.new` pops one value per element or field.
    reserve_stack(frame, pops)
    for i in 0..<pops {
        frame.payload[i] = m.bits[at + i]
        frame.tag[i] = m.tags[at + i]
        frame.stack[i] = m.refs[at + i]
    }
    frame.sp = pops
    frame.pc = f.origin[pc]
    outcome :: apply_boxed(state, m.run, f.boxed[usize(operand_a(w))], frame, f.name)
    if outcome is Trap {
        return outcome
    }
    for i in 0..<pushes {
        m.bits[at + i] = frame.payload[i]
        m.tags[at + i] = frame.tag[i]
        m.refs[at + i] = frame.stack[i]
    }
    return null
}

// Call host import `index` with its arguments from register `at` ; its result
// lands in `at`.
call_import :: fn(state: VmState, m: RegMachine!, index: i32, at: usize, origin: i32, is_comptime: bool) -> Trap | null {
    info :: state.bc.imports[usize(index)]
    args: Value[]!: []
    for i in 0..<info.signature.params.len() {
        args.push(register_value(m, at + i))
    }
    outcome :: dispatch_import(
        info, args, 0, m.run.gc_state, m.run.sched_state, origin, state.string_array_type_id,
        state.u8_array_type_id, state.io_error_type_id, state.bc.types, is_comptime, debug_controller(m),
        state.import_ids[usize(index)],
    )
    if outcome is Trap {
        return outcome
    }
    if bc.bc_single_result(info.signature) != .Void {
        set_register(m, at, outcome.value)
    }
    return null
}

// The debugger driving the run, for the host's output hook.
debug_controller :: fn(m: RegMachine) -> DebugController | null {
    session :: m.debug
    return if session != null { session.controller } else { null }
}

// Make `f`'s frame at `base`: room for its registers, its locals cleared, its
// constants loaded.
enter_frame :: fn(m: RegMachine!, f: RegFunction, base: usize) -> void {
    reserve_registers(m, base + f.registers)
    for r in base + f.params..<base + f.slots {
        m.tags[r] = .Null
    }
    at :: base + f.slots
    for k in 0..<f.consts.len() {
        m.bits[at + k] = f.consts[k]
        m.tags[at + k] = f.const_tags[k]
    }
}

// `defer.pop_exec`: pop the last `count` deferred closures and run them, the last
// pushed first, from register `at` — above the frame running them, at `depth`.
run_defers :: fn(
    state: VmState, code: RegModule, m: RegMachine!, f: RegFunction, pc: usize, at: usize, depth: usize,
    is_comptime: bool,
) -> Trap | null {
    count :: operand_a(f.words[pc])
    if count <= 0 {
        return null
    }
    origin :: f.origin[pc]
    if m.defer_count < usize(count) {
        return Trap { .message = "defer.pop_exec underflow (count=${count}, have=${m.defer_count}) at pc=${origin}" }
    }
    first :: m.defer_count - usize(count)
    // Copied out: a thunk's own `defer`s reuse the slots above `first`.
    batch: FnVal![]!: []
    for k in first..<m.defer_count {
        thunk :: defer_thunk(state, m.defers[k], origin, "defer.pop_exec")
        if thunk is Trap {
            return thunk
        }
        batch.push(thunk)
    }
    m.defer_count = first
    k := batch.len()
    for k > 0 {
        k -= 1
        failed :: run_thunk(state, code, m, batch[k], at, depth, pc + 1, is_comptime)
        if failed != null {
            return failed
        }
    }
    return null
}

// The fn value a deferred closure holds, checked to take exactly its environment.
defer_thunk :: fn(state: VmState, closure: Value, origin: i32, label: string) -> FnVal | Trap {
    if closure !is FnVal {
        // The label is built only for the trap.
        return read_fn(closure, origin, "${label} entry")
    }
    checked :: validate_fn_index(closure.function_index, state.bc.functions, origin, label)
    if checked is Trap {
        return checked
    }
    callee :: state.bc.functions[usize(closure.function_index)]
    if callee.signature.params.len() != 1 {
        return Trap { .message = "defer thunk '${callee.name}' must take exactly one env param at pc=${origin}" }
    }
    return closure
}

// Run a deferred closure, its environment in register `at`.
run_thunk :: fn(
    state: VmState, code: RegModule, m: RegMachine!, thunk: FnVal!, at: usize, depth: usize, resume: usize,
    is_comptime: bool,
) -> Trap | null {
    reserve_registers(m, at + 1)
    if thunk.env != null {
        set_register(m, at, thunk.env)
    } else {
        m.tags[at] = .Null
    }
    return reg_call(state, code, m, thunk.function_index, at, depth, resume, is_comptime)
}

// A trap ended the run: run every pending `defer`, the last pushed first. One that
// traps in turn ends the unwind — its own trap is dropped for the first.
unwind :: fn(state: VmState, code: RegModule, m: RegMachine!, is_comptime: bool) -> void {
    for m.defer_count > 0 {
        m.defer_count -= 1
        thunk :: defer_thunk(state, m.defers[m.defer_count], 0, "panic unwind defer")
        if thunk is Trap {
            return
        }
        if run_thunk(state, code, m, thunk, 0, 0, 0, is_comptime) != null {
            return
        }
    }
}

// The `Line` op at `pc`: stop when its source line carries a breakpoint or ends
// the step in progress — at the line's first op only.
stop_at_line :: fn(state: VmState, m: RegMachine, session: DebugSession!, f: RegFunction, pc: usize, depth: usize) -> void {
    position :: state.bc.functions[usize(f.index)].debug[usize(f.origin[pc])] ?? return
    if position.line == session.last_line {
        return
    }
    session.last_line = position.line
    here :: i32(depth)
    breakpoint :: line_has_breakpoint(session.controller, position.file, position.line)
    if !breakpoint && !step_should_stop(session.step_mode, session.step_depth, here) {
        return
    }
    reason :: if breakpoint { "breakpoint" } else { "step" }
    session.step_mode = session.controller.on_pause(pause_context(state, m, reason, pc, depth))
    session.step_depth = here
}

// The paused call stack, innermost frame first. A caller's pc is the op after its
// call, so its line is the call site's.
pause_context :: fn(state: VmState, m: RegMachine, reason: string, pc: usize, depth: usize) -> PauseCtx {
    frames: PauseFrame[]!: []
    k := depth
    for k > 0 {
        k -= 1
        code :: m.frame_code[k]
        at :: if k == depth - 1 { pc } else { m.frame_return[k + 1] }
        slots: Value[]!: []
        for s in 0..<code.slots {
            slots.push(register_value(m, m.frame_base[k] + s))
        }
        frames.push(pause_frame(state.bc, state.bc.functions[usize(code.index)], slots, code.origin[at]))
    }
    return PauseCtx { .reason = reason, .frames = frames }
}

// Record a frame one deeper than any so far ; the record arrays are grow-only,
// and a shallower frame overwrites its slot in place.
grow_frame_records :: fn(m: RegMachine!, code: RegFunction, base: usize, resume: usize) -> void {
    m.frame_code.push(code)
    m.frame_base.push(base)
    m.frame_return.push(resume)
}

// The outermost frame returned, its value (if any) in register 0.
finish_run :: fn(m: RegMachine, has_value: bool, capture: Value[]! | null) -> VmResult {
    if capture != null {
        if has_value {
            capture[0] = register_value(m, 0)
        }
        return Ok { .value = 0 }
    }
    if !has_value {
        return Ok { .value = 0 }
    }
    code :: read_i32(register_value(m, 0), 0, "return from main")
    if code is Trap {
        return code
    }
    return Ok { .value = code.value }
}

bits_of :: fn(bits: i64[], base: usize, register: i32) = bits[base + usize(register)]

i32_of :: fn(bits: i64[], base: usize, register: i32) = i32(bits[base + usize(register)])

u64_of :: fn(bits: i64[], base: usize, register: i32) = u64(bits[base + usize(register)])

u32_of :: fn(bits: i64[], base: usize, register: i32) = u32(i32(bits[base + usize(register)]))

f64_of :: fn(bits: i64[], base: usize, register: i32) = (u64(bits[base + usize(register)])).from_bits()

set_i32 :: fn(bits: i64[]!, tags: StackTag[]!, base: usize, register: i32, v: i32) -> void {
    at :: base + usize(register)
    bits[at] = i64(v)
    tags[at] = .I32
}

set_i64 :: fn(bits: i64[]!, tags: StackTag[]!, base: usize, register: i32, v: i64) -> void {
    at :: base + usize(register)
    bits[at] = v
    tags[at] = .I64
}

set_f64 :: fn(bits: i64[]!, tags: StackTag[]!, base: usize, register: i32, v: f64) -> void {
    at :: base + usize(register)
    bits[at] = i64(v.to_bits())
    tags[at] = .F64
}

set_bool :: fn(bits: i64[]!, tags: StackTag[]!, base: usize, register: i32, v: bool) -> void {
    at :: base + usize(register)
    bits[at] = if v { 1 } else { 0 }
    tags[at] = .Bool
}
