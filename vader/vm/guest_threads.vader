// vader/vm/guest_threads: the threads of the program the VM runs are threads of
// the host.
//
// The primitives of `std/runtime/threads` reach the host's own: a guest thread
// runs on a virtual thread of the host, with a register file of its own, and
// parks with the interpreter's frames on its host stack, where the collector
// reads them. A guest switch is a host switch, so the guest's scheduler is the
// host's.

module "vader/vm"

bc :: import "vader/core/bytecode"
import "std/abort"
import "std/runtime/threads"

// Whether `id` is a primitive of `std/runtime/threads`, which the VM serves
// with its own state rather than through `dispatch_import`.
is_thread_primitive :: fn(id: bc.IntrinsicId) -> bool =
    id == .ThreadStartScheduler || id == .ThreadCreate || id == .ThreadSwitch || id == .ThreadCurrent

// Serve the thread primitive `id` on `args`.
// @partial: `serve_import` sends the thread primitives alone (`is_thread_primitive`).
serve_thread_primitive :: fn(
    state: VmState,
    id: bc.IntrinsicId,
    args: Value[],
    origin: i32,
    is_comptime: bool,
) -> HostCallResult = @partial match id {
    .ThreadStartScheduler | .ThreadCreate -> start_guest_thread(state, id, args[0], is_comptime)
    .ThreadSwitch                         -> switch_guest_thread(args[0], origin)
    .ThreadCurrent                        -> HostOk { .value = I64Val(current_thread()) }
    _                                     -> Trap { .message = "not a thread primitive" }
}

// Start the guest function `entry` on a host thread: the scheduler's when `id`
// is `start_scheduler`, a new thread's otherwise.
start_guest_thread :: fn(
    state: VmState,
    id: bc.IntrinsicId,
    entry: Value,
    is_comptime: bool,
) -> HostCallResult {
    if entry !is FnVal {
        return Trap { .message = "a thread's entry is not a function" }
    }
    if is_fn_index_out_of_range(entry.function_index, state.bc.functions) {
        return Trap { .message = "a thread's entry is not a function of the program" }
    }
    if state.reg.functions[entry.function_index].params != environment_params(entry) {
        return Trap { .message = "a thread's entry takes arguments" }
    }
    run :: () -> run_guest_thread(state, entry, is_comptime)
    if id == .ThreadStartScheduler {
        return HostOk { .value = I64Val(start_scheduler(run)) }
    }
    return HostOk { .value = I64Val(create_thread(run)) }
}

// The parameters a function value fills by itself: its environment, when it
// carries one.
environment_params :: fn(f: FnVal) -> i64 {
    if f.env != null {
        return 1
    }
    return 0
}

switch_guest_thread :: fn(to: Value, origin: i32) -> HostCallResult {
    handle :: read_i64(to, origin, "switch_to_thread")
    if handle is Trap {
        return handle
    }
    switch_to_thread(i64(handle))
    return HostOk { .value = NullVal {} }
}

// Run the guest function `entry` on a register file of its own. A trap ends
// the program, as it does on the native side: nothing waits for this thread to
// report it to.
run_guest_thread :: fn(state: VmState, entry: FnVal, is_comptime: bool) -> void {
    m :: empty_machine(null)
    outcome :: run_thunk(state, state.reg, m, entry, 0, 0, 0, is_comptime)
    if outcome is Trap {
        unwind(state, state.reg, m, is_comptime)
        panic("a guest thread trapped: ${outcome.message}")
    }
}
