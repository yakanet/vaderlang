// vader/vm/guest_threads: the virtual threads of the program the VM runs are
// virtual threads of the host.
//
// The primitives of `std/runtime/scheduler` reach the host's own: a guest
// thread runs on a thread of the host, with a register file of its own, and
// parks with the interpreter's frames on its host stack, where the collector
// reads them. The host's scheduler is the guest's, which numbers the guest
// threads as the host does as long as the host starts none of its own.
//
// A guest thread cancelled while it parks unwinds its host stack, whose defers
// run the guest's pending defers on its register file. The host cancels the
// threads it launched first, as it does for any thread of its own. When an
// entry returns, the guest threads still running are cancelled and waited for,
// so that a `@test` or a comptime evaluation leaves none behind for the next.
//
// Under a debugger each guest thread has a session of its own on the one
// controller: its own line and step, the same breakpoints and output. The
// interpreter runs on a single thread of the OS, so a stop freezes all of them,
// each of the others inside a call to the host.

module "vader/vm"

bc :: import "vader/core/bytecode"
import "std/abort"
import "std/collections"
import "std/io"
import "std/iter"
import "std/runtime/scheduler"
import "std/sort"
import "std/string"

// A guest thread that has not ended.
GuestThread :: struct {
    /// How a report names it: `task #N`.
    number: i64
    /// The host thread that launched it.
    launcher: i64
    /// Whether it has begun: one cancelled before runs nothing.
    started: bool = false
    /// Whether it was cancelled, and so is on its way out.
    cancelled: bool = false
    /// Its register file once it has begun, which a debugger reads its stack from.
    machine: RegMachine | null = null
}

// The guest threads of the process, which runs one entry at a time.
GuestThreads :: struct {
    /// By the handle of their host thread.
    live: Map<i64, GuestThread> = Map<i64, GuestThread> {}
    numbered: i64 = 0
    /// The thread that runs the entries, which cannot be cancelled.
    entry_thread: i64 = -1
    /// The thread waiting in `finish_guest_threads` for the last one to end, or -1.
    waiter: i64 = -1
    /// The register file of the entry while it runs.
    entry_machine: RegMachine | null = null
}

@singleton
guest_threads :: fn() -> GuestThreads = GuestThreads {}

// Serve `id` on `args` when it is a primitive of `std/runtime/scheduler`, which
// the VM serves with its own state, or `wait_readable` of `std/io`, which parks
// too; null for any other, which `dispatch_import` serves.
// @partial: the other intrinsics park no thread.
serve_thread_primitive :: fn(
    state: VmState,
    m: RegMachine,
    id: bc.IntrinsicId,
    args: Value[],
    origin: i32,
    is_comptime: bool,
) -> HostCallResult | null = @partial match id {
    .SchedSpawn         -> start_guest_thread(state, args[0], is_comptime, debug_controller(m))
    .SchedPark          -> parked()
    .SchedWake          -> on_i64(args[0], origin, "wake", (n) -> wake(n))
    .SchedSleepFor      -> on_i64(args[0], origin, "sleep_for", (n) -> sleep_for(n))
    .SchedWatchReadable -> on_i64(args[0], origin, "watch_readable", (n) -> watch_readable(n))
    .SchedWatchExit     -> on_i64(args[0], origin, "watch_exit", (n) -> watch_exit(n))
    .IoWaitReadable     -> on_i64(args[0], origin, "wait_readable", (n) -> wait_readable(n))
    .SchedCancel        -> cancel_guest_thread(args[0], origin)
    .SchedCurrent       -> HostOk { .value = I64Val(current_thread()) }
    _                   -> null
}

// Start the guest function `entry` on a thread of the host.
start_guest_thread :: fn(
    state: VmState,
    entry: Value,
    is_comptime: bool,
    debug: DebugController | null,
) -> HostCallResult {
    if entry !is FnVal {
        return Trap { .message = "a thread's entry is not a function" }
    }
    if is_fn_index_out_of_range(entry.function_index, state.bc.functions) {
        return Trap { .message = "a thread's entry is not a function of the program" }
    }
    if state.reg.functions[entry.function_index].params != environment_params(entry) {
        return Trap { .message = "a thread's entry takes arguments" }
    }
    threads :: guest_threads()
    threads.numbered += 1
    number :: threads.numbered
    session :: debug_session(debug, debugged_thread_id(number))
    launcher :: current_thread()
    thread :: spawn_thread(() -> run_guest_thread(state, entry, is_comptime, session))
    threads.live[thread] = GuestThread { .number = number, .launcher = launcher }
    return HostOk { .value = I64Val(thread) }
}

// The parameters a function value fills by itself: its environment, when it
// carries one.
environment_params :: fn(f: FnVal) -> i64 {
    if f.env != null {
        return 1
    }
    return 0
}

void_result :: fn() -> HostCallResult = HostOk { .value = NullVal {} }

parked :: fn() -> HostCallResult {
    park()
    return void_result()
}

// Run the host's own `primitive` on the `i64` the guest handed it, which a trap
// names as `name`.
on_i64 :: fn(
    value: Value,
    origin: i32,
    name: string,
    primitive: fn(i64) -> void,
) -> HostCallResult {
    n :: read_i64(value, origin, name)
    if n is Trap {
        return n
    }
    primitive(i64(n))
    return void_result()
}

// Cancel a guest thread: the entry's thread cannot be, which fails the run
// where the host's own check would stop the process, and a handle that names no
// guest thread names one that has ended.
cancel_guest_thread :: fn(thread: Value, origin: i32) -> HostCallResult {
    handle :: read_i64(thread, origin, "cancel_thread")
    if handle is Trap {
        return handle
    }
    target :: i64(handle)
    if target == guest_threads().entry_thread {
        return Trap { .message = "virtual threads: the main thread cannot be cancelled" }
    }
    cancel(target)
    return void_result()
}

// Cancel the guest thread `thread` if it has not ended. One that has not begun
// never runs, so it is forgotten here.
cancel :: fn(thread: i64) -> void {
    threads :: guest_threads()
    guest :: threads.live[thread] ?? return
    guest.cancelled = true
    if !guest.started {
        forget(threads, thread)
    }
    cancel_thread(thread)
}

// Run the guest function `entry` on a register file of its own. A trap ends the
// program, as it does on the native side: nothing waits for this thread to
// report it to.
run_guest_thread :: fn(
    state: VmState,
    entry: FnVal,
    is_comptime: bool,
    session: DebugSession | null,
) -> void {
    threads :: guest_threads()
    thread :: current_thread()
    m :: empty_machine(session)
    guest :: threads.live[thread]
    if guest != null {
        guest.started = true
        guest.machine = m
    }
    defer forget(threads, thread)
    // A cancellation runs it with the guest's frames still pending.
    defer unwind(state, state.reg, m, is_comptime)
    outcome :: run_thunk(state, state.reg, m, entry, 0, 0, 0, is_comptime)
    if outcome is Trap {
        if session != null {
            session.controller.on_fatal_trap(
                exception_stop(outcome.message, session.thread_id, debugged_threads(state)),
            )
        }
        panic("a guest thread trapped: ${outcome.message}")
    }
}

// The id a debugger knows the task of number `number` by.
debugged_thread_id :: fn(number: i64) -> i32 = i32(number) + MAIN_THREAD_ID

// The threads of a debugged run, the entry's first and then the tasks by number.
debugged_threads :: fn(state: VmState) -> PauseThread[] {
    threads :: guest_threads()
    entry_machine :: threads.entry_machine
    listed: PauseThread[]: [main_thread(() -> parked_stack(state, entry_machine))]
    for guest in sort(threads.live.values().collect(), (a, b) -> a.number < b.number) {
        machine :: guest.machine
        listed.push(PauseThread {
            .id    = debugged_thread_id(guest.number),
            .name  = "task #${guest.number}",
            .stack = () -> parked_stack(state, machine),
        })
    }
    return listed
}

// `thread` has ended: the last one wakes `finish_guest_threads`.
forget :: fn(threads: GuestThreads, thread: i64) -> void {
    threads.live.remove(thread)
    if threads.live.len() == 0 && threads.waiter >= 0 {
        wake(threads.waiter)
    }
}

/// Note the host thread about to run an entry, which no guest can cancel.
///
/// @param m  its register file, which a debugger reads its stack from.
note_entry_thread :: fn(m: RegMachine) -> void {
    threads :: guest_threads()
    threads.entry_thread = current_thread()
    threads.entry_machine = m
}

/// Cancel the guest threads still running once an entry has returned, and wait
/// until their defers have run, those of the threads cancelled before included.
///
/// @param announce  name each as a native program does when `main` returns.
/// @param debug     the debugger driving the run, or `null`: its client reads the
///                  names.
/// @return          the numbers of the threads this cancelled, the oldest first.
finish_guest_threads :: fn(announce: bool, debug: DebugController | null) -> i64[] {
    threads :: guest_threads()
    // The entry's frames have returned: a debugger stopping in a cancelled thread's
    // defers shows none.
    threads.entry_machine = null
    if threads.live.len() == 0 {
        return []
    }
    handles :: sort(
        threads.live.keys().collect(),
        (a, b) -> number_of(threads, a) < number_of(threads, b),
    )
    // Every name before any cancel, which would make the threads it launched
    // leave.
    numbers: i64[]: []
    for thread in handles {
        guest :: threads.live[thread] ?? continue
        if is_leaving(threads, guest) {
            continue
        }
        numbers.push(guest.number)
        if announce {
            announce_cancelled(guest.number, debug)
        }
    }
    for thread in handles {
        cancel(thread)
    }
    threads.waiter = current_thread()
    // Lets the threads cancelled before they began end before this returns.
    wake(threads.waiter)
    park()
    for threads.live.len() > 0 {
        park()
    }
    threads.waiter = -1
    return numbers
}

// Whether the end of an entry waits for `guest` without naming it: it was
// cancelled, or a thread that launched it was.
is_leaving :: fn(threads: GuestThreads, guest: GuestThread) -> bool {
    if guest.cancelled {
        return true
    }
    launcher :: threads.live[guest.launcher] ?? return false
    return is_leaving(threads, launcher)
}

number_of :: fn(threads: GuestThreads, thread: i64) -> i64 {
    guest :: threads.live[thread] ?? return 0
    return guest.number
}

// Name on stderr a thread `main`'s return cancels; a debugger's client reads that
// stream from the session.
announce_cancelled :: fn(number: i64, debug: DebugController | null) -> void {
    line :: "vader: task #${number} still runs when main returns: cancelled"
    if debug != null {
        debug.output_sink(STDERR_STREAM, "${line}\n")
    } else {
        eprintln(line)
    }
}

/// The outcome of a run whose `main` returned: the guest threads still running
/// are named on stderr and cancelled, and an exit code of 0 becomes 1.
///
/// @param outcome  what the run of `main` returned.
/// @param debug    the debugger driving the run, or `null`.
after_main :: fn(
    outcome: VmResult | StackOverflow,
    debug: DebugController | null,
) -> VmResult | StackOverflow {
    cancelled :: finish_guest_threads(true, debug)
    if cancelled.len() == 0 || outcome !is Ok || outcome.value != 0 {
        return outcome
    }
    return Ok { .value = 1 }
}

/// The outcome of an entry other than `main`: the guest threads still running
/// are cancelled, and the entry fails, naming them.
///
/// @param outcome  what the run of the entry returned.
/// @param what     the entry, as the failure names it: `the test`.
after_entry :: fn(outcome: VmResult | StackOverflow, what: string) -> VmResult | StackOverflow {
    cancelled :: finish_guest_threads(false, null)
    if cancelled.len() == 0 || outcome !is Ok {
        return outcome
    }
    names :: cancelled.map((n) -> "task #${n}").collect().join(", ")
    return Trap { .message = "${names} still running when ${what} returns: cancelled" }
}
