// vader/vm/virt_reader_bc — read a `.virt` text dump into a `BytecodeModule`.
//
// Sibling of `virt_reader.vader`, which parses the same `.virt` text into the
// runtime-only VM `Module`. This reader instead reconstructs the richer
// `vader/bytecode::BytecodeModule` that `c_emit::emit_c` consumes — so a
// hand-authored or dumped `.virt` can be compiled to C (`vader build x.virt
// --target=c`). Both readers share the hard part — the structured control-flow
// → linear op-stream + jump-table wiring (`ParserState`, `parse_op_line`,
// `wire_control_flow`) — via same-module visibility, and only diverge in the
// metadata they keep.
//
// Lossy-by-design vs the emitter's in-memory module: the `.virt` text carries
// no signature `BcType` indices (`param_types` / `result_type`), no struct
// `symbol_id`, and no debug spans. The first is RECONSTRUCTED here from the
// type table via `class_tag_of` (exact for scalar slots ; `0` for
// ref/any slots, which `c_emit::box_expr` ignores anyway — Ref/Any box to a
// bare value, no tag). A struct's `symbol_id` becomes its TYPE INDEX — the
// identity the data section names it by (`bytecode/dump`) — and `debug` all-null
// (`#line` directives are dropped from `.virt`-sourced C). The contract this
// upholds is *emitted-C equivalence* (`source → C` == `source → .virt → C`,
// modulo `#line`), not byte-identical module round-trip.

module "vader/vm"

bc :: import "vader/bytecode"

import "std/ffi"
import "std/string"
import "std/numbers"

/// A `.virt` line the reader could not interpret. The parse stops there.
///
/// Every non-blank line of a `.virt` dump carries meaning: outside a function
/// body it is one of the ten module directives, inside one it is an instruction
/// (comments and blank lines are already gone by the time either is reached). So
/// an uninterpretable line is never "extra text to step over" — it is a dump this
/// reader cannot rebuild faithfully, and reading past it would shift every
/// following pc while looking like a successful parse.
///
/// The reader used to step over such a line and carry on, and it cost: when an
/// opcode left the set while a stale `.virt` still carried it, a path-manipulation
/// snippet printed empty filenames instead of failing, and `UPDATE_SNAPSHOTS`
/// wrote that output over nine correct `vm.snapshot` oracles.
export VirtParseError :: struct {
    /// 1-based line number, ready for a `path:line:` diagnostic prefix.
    line_number: i64
    /// The offending line, comment already stripped — echoed under the message.
    line:        string
    /// What went wrong, e.g. ``unrecognised instruction `frobnicate` ``.
    reason:      string
}

/// Why a module-level directive could not be read — the reason without the
/// position.
///
/// A directive parser knows WHAT is wrong with its line but not WHERE the line
/// is; `parse_virt_bc` holds the line number and pairs the two into a
/// `VirtParseError`. Hence a named type rather than a bare `string | null`
/// return: a string says nothing about whether it is a value or a complaint, and
/// nothing stops a parser handing back a successful-looking one by accident.
export DirectiveError :: struct {
    /// One line, no position, e.g. ``struct `P`: field `a` has no `name:type` separator``.
    reason: string
}

/// Render the error as the two-line message both CLI entry points print: a
/// `command: path:line: reason` header, then the offending line indented under
/// it. Shared so the two call sites can't drift apart on the format.
///
/// @param e        the error to render.
/// @param command  the invoking command, e.g. `"vader run"` — heads the message.
/// @param path     the `.virt` file the error was read from.
/// @return         the full message, no trailing newline — `eprintln` adds one.
export display_virt_parse_error :: fn(e: VirtParseError, command: string, path: string) -> string =
    "${command}: ${path}:${e.line_number}: ${e.reason}\n  ${e.line}"

// Pair a directive parser's reason with the line it came from. Returns the
// positioned error, or null when the directive parsed — the caller still does its
// own `return`, since a helper cannot return on its behalf.
positioned :: fn(
    failure: DirectiveError | null, line_number: i64, line: string,
) -> VirtParseError | null {
    if failure is DirectiveError {
        return VirtParseError { .line_number = line_number, .line = line, .reason = failure.reason }
    }
    return null
}

/// Where one function of a `.virt` dump sits, by 0-based line.
export VirtFunctionLines :: struct {
    /// The `fn N …` header — where the parameters, which the dump leaves
    /// unnamed, are declared.
    header: i64
    /// Each `local` line, in slot order after the parameters.
    locals: i64[]
    /// Each op's line, in body order.
    ops:    i64[]
}

/// A `.virt` dump read back, with the 0-based line every indexed entry came
/// from — what a tool pointing back into the text needs.
export VirtListing :: struct {
    module:    bc.BytecodeModule
    /// One per function, by function index.
    functions: VirtFunctionLines[]
    /// The `type N` line of each type, by type index.
    types:     i64[]
    /// The `string N` line of each pool string, by string index.
    strings:   i64[]
    /// The `import N` line of each host import, by import index.
    imports:   i64[]
    /// The `data N` line of each data-pool entry, by pool index.
    data:      i64[]
    /// The `global N` line of each global slot, by slot index.
    globals:   i64[]
}

/// Parse a full `.virt` text dump into a `BytecodeModule` ready for `emit_c`.
///
/// @param source  the full `.virt` text (UTF-8).
/// @return        the reconstructed module, or the first line that defeated the
///                reader — never a partial module.
/// @error         `VirtParseError` as `parse_virt_listing` reports it.
export parse_virt_bc :: fn(source: string) -> bc.BytecodeModule | VirtParseError {
    listing :: parse_virt_listing(source)
    if listing is VirtParseError {
        return listing
    }
    return listing.module
}

/// Parse a full `.virt` text dump into a `BytecodeModule`, and note the line of
/// every function, local, op and pool entry.
///
/// Module-level directives (`module` / `type` / `string` / `data` / `import` /
/// `impl` / `vtable` / `export`) populate the module pools ; each `fn …` opens
/// a body where ops + the jump table are wired by the shared
/// `wire_control_flow`. The entry fn is taken from `export main N` (falling
/// back to the `$main`-suffix heuristic) and flagged `is_main`.
///
/// @param source  the full `.virt` text (UTF-8).
/// @return        the reconstructed module with its op lines, or the first line
///                that defeated the reader — never a partial module.
/// @error         `VirtParseError` on an unrecognised module directive; a
///                RECOGNISED directive whose payload doesn't parse (an unknown
///                type kind, a malformed struct field, a non-numeric index, a
///                bad hex blob); an unrecognised instruction; or a recognised
///                instruction whose operands don't parse. Each would otherwise
///                yield a module missing an operation or a pool entry, with
///                every index after it shifted.
export parse_virt_listing :: fn(source: string) -> VirtListing | VirtParseError {
    module_name := ""
    strings: string[]: []
    types: bc.BcType[]: []
    imports: bc.BcImport[]: []
    exports: bc.BcExport[]: []
    impl_table: bc.ImplEntry[]: []
    vtables: bc.VtableRow[]: []
    data_pool: bc.BcDataEntry[]: []
    globals: bc.BcGlobal[]: []
    functions: bc.BcFunction[]: []
    main_index := -1

    current_name := ""
    current_sig := bc.BcSignature {
        .params = [],
        .results = [.Void],
        .param_types = [],
        .result_types = [0],
        .param_names = [],
    }
    current_locals: bc.BcLocal[] = []
    current_header: i64 = 0
    current_local_lines: i64[] = []
    current_lines: i64[] = []
    function_lines: VirtFunctionLines[]: []
    type_lines: i64[]: []
    string_lines: i64[]: []
    import_lines: i64[]: []
    data_lines: i64[]: []
    global_lines: i64[]: []
    in_function := false

    state :: ParserState {
        .ops        = [],
        .table      = [],
        .scopes     = [],
        .scope_sp   = [0],
        .pending    = [],
        .pending_sp = [0],
    }

    lines :: source.split("\n")
    line_count :: lines.len()
    line_index: i64 = 0
    for line_index < line_count {
        line :: lines[line_index]
        line_index += 1
        cleaned :: strip_comment(line)
        if cleaned.byte_len() == 0 { continue }
        head :: head_of(cleaned)
        here :: line_index - 1

        if !in_function {
            // `vader dump --stage=bytecode` appends a `# Diagnostics` report
            // after the module when the compile raised warnings
            // (`cli/cmd_dump.vader::run_bytecode_stage` → `support/diagnostics/render.vader`).
            // It is prose, always terminal, and never bytecode — so it ends the
            // stream rather than failing it. Inside a function body a `#` is not
            // this block (the report is appended past the last `end`) and stays
            // an error.
            //
            // The deeper fix belongs in the CLI, not here: the sibling
            // `run_c_stage` already routes its diagnostics to STDERR precisely so
            // they can't contaminate a stdout another tool consumes. The bytecode
            // stage never got that treatment, and its combined stdout is now
            // frozen into the snapshot corpus (six `bytecode.snapshot.virt` carry
            // a report), so separating the streams is its own change.
            if head == "#"      { break }
            if head == "module" { module_name = parse_module_name(cleaned) continue }
            if head == "type" {
                failed :: positioned(parse_type_decl_bc(cleaned, types), line_index, cleaned)
                if failed is VirtParseError {
                    return failed
                }
                type_lines.push(here)
                continue
            }
            // Each pool directive below reports why it could not read its line. A
            // silent drop removed a whole pool entry and renumbered every index
            // after it — the pool analogue of the pc shift fixed for instructions.
            if head == "string" {
                failed :: positioned(parse_string_decl(cleaned, strings), line_index, cleaned)
                if failed is VirtParseError {
                    return failed
                }
                string_lines.push(here)
                continue
            }
            if head == "data" {
                failed :: positioned(
                    parse_data_decl_bc(cleaned, data_pool, strings), line_index, cleaned,
                )
                if failed is VirtParseError {
                    return failed
                }
                data_lines.push(here)
                continue
            }
            if head == "global" {
                failed :: positioned(parse_global_decl_bc(cleaned, globals), line_index, cleaned)
                if failed is VirtParseError {
                    return failed
                }
                global_lines.push(here)
                continue
            }
            if head == "import" {
                failed :: positioned(
                    parse_import_decl_bc(cleaned, imports, types), line_index, cleaned,
                )
                if failed is VirtParseError {
                    return failed
                }
                import_lines.push(here)
                continue
            }
            if head == "impl" {
                failed :: positioned(parse_impl_decl_bc(cleaned, impl_table), line_index, cleaned)
                if failed is VirtParseError {
                    return failed
                }
                continue
            }
            if head == "vtable" {
                failed :: positioned(parse_vtable_decl_bc(cleaned, vtables), line_index, cleaned)
                if failed is VirtParseError {
                    return failed
                }
                continue
            }
            if head == "export" {
                m :: parse_export_decl_bc(cleaned, exports)
                if m >= 0 { main_index = m }
                continue
            }
            if head == "fn" {
                current_name = read_fn_mangled_name(cleaned)
                current_sig = parse_signature_bc(cleaned, types)
                current_locals = []
                current_header = here
                current_local_lines = []
                current_lines = []
                state.ops = []
                state.table = []
                state.scope_sp[0] = 0
                state.pending_sp[0] = 0
                in_function = true
                continue
            }
            // The directive vocabulary above is closed, so anything left here is
            // a dump this reader doesn't understand. Skipping it drops a whole
            // pool entry — a missing `type` collapses a struct to nothing, a
            // missing `string` shifts every later pool index — with no sign at
            // the call site that the module came back incomplete.
            return VirtParseError {
                .line_number = line_index,
                .line        = cleaned,
                .reason      = "unrecognised module directive `${head}`",
            }
        }

        if head == "local" {
            current_locals.push(parse_local_decl_bc(cleaned))
            current_local_lines.push(here)
            continue
        }
        if cleaned == "end" && state.scope_sp[0] == 0 {
            debug: (bc.DebugPos | null)[]: []
            for _ in 0..<state.ops.len() { debug.push(null) }
            functions.push(bc.BcFunction {
                .name       = current_name,
                .is_main    = false,
                .signature  = current_sig,
                .locals     = current_locals,
                .body       = state.ops,
                .debug      = debug,
                .jump_table = state.table,
            })
            function_lines.push(VirtFunctionLines {
                .header = current_header,
                .locals = current_local_lines,
                .ops    = current_lines,
            })
            in_function = false
            continue
        }

        pc :: i32(state.ops.len())
        // Inside a body, position alone settles what this line is: comments and
        // blank lines are gone, `local` and the closing `end` were taken above,
        // so it is an instruction. A `null` back means either an opcode outside
        // the set or operands that don't parse — see `VirtParseError` for why
        // neither can be stepped over.
        op :: parse_op_line(cleaned, head) ?? return VirtParseError {
            .line_number = line_index,
            .line        = cleaned,
            .reason      = "unrecognised instruction `${head}`",
        }
        state.ops.push(op)
        state.table.push(-1)
        current_lines.push(here)
        wire_control_flow(state, cleaned, head, pc)
    }

    if main_index < 0 { main_index = find_main_by_suffix_bc(functions) }
    if main_index >= 0 && i64(main_index) < functions.len() {
        functions[main_index].is_main = true
    }

    module :: bc.BytecodeModule {
        .name       = module_name,
        .types      = types,
        .strings    = strings,
        .data_pool  = data_pool,
        .functions  = functions,
        .imports    = imports,
        .exports    = exports,
        .impl_table = impl_table,
        .vtables    = vtables,
        .globals    = globals,
    }
    return VirtListing {
        .module    = module,
        .functions = function_lines,
        .types     = type_lines,
        .strings   = string_lines,
        .imports   = import_lines,
        .data      = data_lines,
        .globals   = global_lines,
    }
}

// ---- module-level directive parsers ---------------------------------------

// Parse `global N <type> <name>` into `globals`, in slot order.
parse_global_decl_bc :: fn(cleaned: string, globals: bc.BcGlobal[]) -> DirectiveError | null {
    words :: cleaned.split(" ")
    if words.len() != 4 {
        return DirectiveError { .reason = "expected `global <index> <type> <name>`" }
    }
    type_id :: parse_int_in_base(words[2], 10)
    if type_id is ParseError {
        return DirectiveError { .reason = "global type index \"${words[2]}\" is not a number" }
    }
    globals.push(bc.BcGlobal { .name = words[3], .type_id = i32(type_id) })
    return null
}

parse_module_name :: fn(cleaned: string) -> string {
    return cleaned.trim_prefix("module ").trim()
}

/// Parse `type N <decl>` into the matching `BcType`, appended in ordinal order —
/// the index is implicit in the array position.
///
/// Returns the reason the line could not be read, or `null` on success. It used to
/// push a `BcRef { "" }` placeholder for anything it didn't recognise, on the
/// stated grounds of "keeping ordinals aligned". Aligned ordinals over a wrong
/// type buy nothing: an opaque ref where the emitter expects a struct makes every
/// downstream field access a miss, which is precisely blocker #1 of the self-host
/// bytecode audit. A dump this reader cannot type is a
/// dump it must refuse.
///
/// @param cleaned  the `type …` line, comment already stripped.
/// @param types    the type table, appended to in ordinal order.
/// @return         `null` when a type was appended, else why it could not be.
parse_type_decl_bc :: fn(cleaned: string, types: bc.BcType[]) -> DirectiveError | null {
    after_type :: cleaned.trim_prefix("type ").trim()
    first_space :: after_type.index_of(' ', 0)
    if first_space < 0 {
        return DirectiveError {
            .reason = "expected `type <index> <kind> …`, got no kind after the index",
        }
    }
    rest :: after_type.byte_slice(first_space + 1, after_type.byte_len()).trim()

    if rest.starts_with("struct ") {
        parsed :: parse_struct_type_bc(rest)
        if parsed is DirectiveError {
            return parsed
        }
        // Its index is its identity here: the data section names a baked struct
        // by type index, and `type_id_for_symbol` resolves it against this field.
        types.push(bc.BcStruct {
            .name      = parsed.name,
            .fields    = parsed.fields,
            .c_name    = parsed.c_name,
            .symbol_id = i32(types.len()),
        })
        return null
    }
    if rest.starts_with("scalar ") {
        kind :: rest.trim_prefix("scalar ").trim()
        types.push(bc.BcScalar { .val = vt_or_void(kind) })
        return null
    }
    if rest.starts_with("array ") {
        element_text :: rest.trim_prefix("array ").trim()
        parsed :: parse_int_in_base(element_text, 10)
        if parsed is ParseError {
            return DirectiveError {
                .reason = "array type: element index \"${element_text}\" is not a number",
            }
        }
        types.push(bc.BcArray { .element = i32(parsed) })
        return null
    }
    if rest.starts_with("ref ") {
        name :: unquote_name(rest.trim_prefix("ref ").trim())
        normalised :: if name == "_" { "" } else { name }
        types.push(bc.BcRef { .trait_name = normalised })
        return null
    }
    if rest.starts_with("fn ") { types.push(parse_fn_type_bc(rest)) return null }
    if rest.starts_with("union ") { types.push(parse_union_type_bc(rest)) return null }
    return DirectiveError { .reason = "unrecognised type kind in `${rest}`" }
}

/// Byte offset of the ` as "` that introduces a mirrored C type, or -1.
///
/// Scanned by hand: `std/string` has no substring search, and the one place
/// that needs it is this line format.
///
/// @param s  the text between `struct ` and `{`.
/// @return   the offset of the space starting ` as "`, or -1 when absent.
find_mirror_marker :: fn(s: string) -> i64 {
    for i in 0..<s.byte_len() {
        if s.matches_at(i, " as \"") {
            return i
        }
    }
    return -1
}

/// Parse `struct NAME { f0:tid0, f1:tid1 }` into a `BcStruct`, recovering the
/// full `BcField[]` (name + type-index). `symbol_id` isn't carried by `.virt`
/// → `-1`.
///
/// Field order IS the field index, so a dropped field silently renumbers every one
/// after it — the reader refuses the line rather than hand back a struct whose
/// slots no longer line up with the emitter's.
///
/// @param rest  the text after `type N `, starting at `struct `.
/// @return      the parsed struct, or why the line could not be read.
parse_struct_type_bc :: fn(rest: string) -> bc.BcStruct | DirectiveError {
    after_struct :: rest.trim_prefix("struct ")
    open :: after_struct.index_of('{', 0)
    raw_name :: before_first(after_struct, '{').trim()
    // The dump `quote_ident`-wraps a name carrying chars outside [A-Za-z0-9_$.]
    // (e.g. the `/` of a path-qualified synthetic Cell struct) in `"..."` by
    // `quote_string` ; unquote so `sanitise` derives the same C identifier as the
    // direct-source build.
    // `Name as "struct timespec"` — the mirrored C type, absent on an ordinary
    // struct. Split before unquoting: both halves are quoted independently.
    marker :: find_mirror_marker(raw_name)
    c_name :: if marker < 0 {
        ""
    } else {
        tail :: raw_name.byte_slice(marker + 5, raw_name.byte_len())
        end :: tail.index_of('"', 0)
        if end < 0 { "" } else { tail.byte_slice(0, end) }
    }
    bare :: if marker < 0 {
        raw_name
    } else {
        raw_name.byte_slice(0, marker)
    }
    name :: unquote_name(bare)
    fields: bc.BcField[]: []
    if open >= 0 {
        close :: after_struct.index_of('}', 0)
        if close < 0 || close <= open + 1 {
            return DirectiveError { .reason = "struct `${name}`: field list is not closed by `}`" }
        }
        inner :: after_struct.byte_slice(open + 1, close).trim()
        if inner.byte_len() > 0 {
            for part in inner.split(",") {
                pt :: part.trim()
                colon :: pt.index_of(':', 0)
                if colon < 0 {
                    return DirectiveError {
                        .reason = "struct `${name}`: field `${pt}` has no `name:type` separator",
                    }
                }
                fname :: pt.byte_slice(0, colon).trim()
                tidtext :: pt.byte_slice(colon + 1, pt.byte_len()).trim()
                tid :: parse_int_in_base(tidtext, 10)
                if tid is ParseError {
                    detail :: "field `${fname}` type index \"${tidtext}\" is not a number"
                    return DirectiveError { .reason = "struct `${name}`: ${detail}" }
                }
                fields.push(bc.BcField { .name = fname, .type_index = i32(tid) })
            }
        }
    }
    return bc.BcStruct { .name = name, .fields = fields, .c_name = c_name, .symbol_id = -1 }
}

/// Parse `fn (tid,tid) -> tid` (a fn-VALUE type — its slots are type indices,
/// not ValType names) into a `BcFn`.
parse_fn_type_bc :: fn(rest: string) -> bc.BcFn {
    open :: rest.index_of('(', 0)
    close :: rest.index_of(')', 0)
    params: i32[]: if open >= 0 && close >= 0 && close > open + 1 {
        parse_int_list(rest.byte_slice(open + 1, close).trim())
    } else {
        []
    }
    return_type := 0
    arrow :: rest.index_of('>', 0)
    if arrow >= 0 {
        ret_text :: rest.byte_slice(arrow + 1, rest.byte_len()).trim()
        parsed :: parse_int_in_base(ret_text, 10)
        if !(parsed is ParseError) { return_type = i32(parsed) }
    }
    return bc.BcFn { .params = params, .return_type = return_type }
}

parse_union_type_bc :: fn(rest: string) -> bc.BcUnion {
    after :: rest.trim_prefix("union ").trim()
    return bc.BcUnion { .variants = parse_int_list(after) }
}

/// Parse `import N [extern ]EXTERN_NAME MANGLED (sig) -> ret`. The `extern`
/// keyword (when present) shifts the name/mangled tokens by one.
parse_import_decl_bc :: fn(
    cleaned: string, imports: bc.BcImport[], types: bc.BcType[],
) -> DirectiveError | null {
    after :: cleaned.trim_prefix("import ")
    open :: after.index_of('(', 0)
    head_part :: before_first(after, '(')
    parts :: head_part.trim().split(" ")
    is_extern := false
    name_i: i64 = 1
    if parts.len() > 1 && parts[1] == "extern" { is_extern = true  name_i = 2 }
    if parts.len() < name_i + 2 {
        return DirectiveError {
            .reason = "expected `import <module> <name> …`, got ${parts.len()} field(s)",
        }
    }
    // `<lib>:<symbol>` when the symbol comes from a named library — see
    // `write_imports`. A bare name means the default resolution scope.
    raw_name :: parts[name_i]
    extern_name :: raw_name.byte_slice(raw_name.index_of(':', 0) + 1, raw_name.byte_len())
    mangled :: parts[name_i + 1]
    sig: bc.BcSignature: if open < 0 {
        bc.BcSignature {
            .params = [],
            .results = [.Void],
            .param_types = [],
            .result_types = [0],
            .param_names = [],
        }
    } else {
        parse_signature_bc(after.byte_slice(open, after.byte_len()), types)
    }
    // Attributes written between the mangled name and the signature, in any
    // order and all optional. Read by scanning rather than by position, so a new
    // one does not shift the others.
    c_header := ""
    c_variadic_fixed: i32 = -1
    result_type: i32 = 0
    param_types: i32[]: []
    param_c_out: bool[]: []
    param_by_address: bool[]: []
    param_c_types: string[] = []
    result_c_type := ""
    library :: read_library(raw_name)
    for i in (name_i + 2)..<parts.len() {
        attr :: parts[i]
        if library != null {
            read_library_attribute(library, attr)
        }
        if attr.starts_with("header=") {
            c_header = attr.trim_prefix("header=")
        }
        if attr.starts_with("variadic=") {
            parsed :: parse_int_in_base(attr.trim_prefix("variadic="), 10)
            if parsed !is ParseError {
                c_variadic_fixed = i32(parsed)
            }
        }
        if attr.starts_with("result_type=") {
            parsed :: parse_int_in_base(attr.trim_prefix("result_type="), 10)
            if parsed !is ParseError {
                result_type = i32(parsed)
            }
        }
        if attr.starts_with("param_types=") {
            for field in attr.trim_prefix("param_types=").split(",") {
                parsed :: parse_int_in_base(field, 10)
                param_types.push(if parsed is ParseError { 0 } else { i32(parsed) })
            }
        }
        if attr.starts_with("param_c_out=") {
            for field in attr.trim_prefix("param_c_out=").split(",") {
                param_c_out.push(field == "1")
            }
        }
        if attr.starts_with("param_by_address=") {
            for field in attr.trim_prefix("param_by_address=").split(",") {
                param_by_address.push(field == "1")
            }
        }
        if attr.starts_with("param_c_types=") {
            param_c_types = bc.c_type_from_token(attr.trim_prefix("param_c_types=")).split(",")
        }
        if attr.starts_with("result_c_type=") {
            result_c_type = bc.c_type_from_token(attr.trim_prefix("result_c_type="))
        }
    }
    // The result's type index is carried as an attribute rather than by
    // `write_signature`, which renders a union as `any` — so it is stitched back
    // in here. Without it a `string | null` result reads as a plain word and the
    // FFI hands the atom back as an integer.
    final_sig :: bc.BcSignature {
        .params = sig.params,
        .results = sig.results,
        // Only trust the attribute when it describes every parameter: a partial
        // list would misalign the block layout it feeds.
        .param_types = if param_types.len() == sig.params.len() {
            param_types
        } else {
            sig.param_types
        },
        // The attribute names ONE result type — an `@extern` returns one value
        // or none — so it overlays the single slot and leaves a void signature
        // void.
        .result_types = if result_type == 0 || sig.results.len() != 1 {
            sig.result_types
        } else {
            [result_type]
        },
        .param_names = sig.param_names,
        // Same rule as `param_types`: a list that does not cover every parameter
        // is not trusted, the flags being read positionally.
        .param_c_out = if param_c_out.len() == sig.params.len() {
            param_c_out
        } else {
            sig.param_c_out
        },
        .param_by_address = if param_by_address.len() == sig.params.len() {
            param_by_address
        } else {
            sig.param_by_address
        },
    }
    imports.push(bc.BcImport {
        .extern_name  = extern_name,
        .mangled_name = mangled,
        .signature    = final_sig,
        .is_extern    = is_extern,
        .c_header     = c_header,
        .c_variadic_fixed = c_variadic_fixed,
        // Positional like the flags : a list that does not cover every
        // parameter is not trusted.
        .param_c_types = if param_c_types.len() == sig.params.len() {
            param_c_types
        } else {
            []
        },
        .result_c_type = result_c_type,
        .library       = library,
    })
    return null
}

// The library an import names by `<lib>:` before its symbol, or null for one
// that names none. Its other fields follow as `library_*` attributes.
read_library :: fn(raw_name: string) -> CLibrary | null {
    colon :: raw_name.index_of(':', 0)
    if colon < 0 {
        return null
    }
    return CLibrary { .name = raw_name.byte_slice(0, colon) }
}

// Fill the field of `library` that `attr` carries, when it is a `library_*` one.
read_library_attribute :: fn(library: CLibrary, attr: string) -> void {
    if attr.starts_with("library_include=") {
        library.include = bc.path_from_token(attr.trim_prefix("library_include="))
    }
    if attr.starts_with("library_archives=") {
        library.archives = bc.paths_from_tokens(attr.trim_prefix("library_archives="))
    }
    if attr.starts_with("library_system=") {
        library.system = bc.paths_from_tokens(attr.trim_prefix("library_system="))
    }
}

parse_impl_decl_bc :: fn(cleaned: string, impl_table: bc.ImplEntry[]) -> DirectiveError | null {
    after :: cleaned.trim_prefix("impl ").trim()
    space :: after.index_of(' ', 0)
    if space < 0 {
        return DirectiveError { .reason = "expected `impl <type-index> <trait>`, got `${after}`" }
    }
    type_id_text :: after.byte_slice(0, space).trim()
    parsed :: parse_int_in_base(type_id_text, 10)
    if parsed is ParseError {
        return DirectiveError { .reason = "impl: type index \"${type_id_text}\" is not a number" }
    }
    trait_name :: after.byte_slice(space + 1, after.byte_len()).trim()
    impl_table.push(bc.ImplEntry { .struct_type_index = i32(parsed), .trait_name = trait_name })
    return null
}

parse_vtable_decl_bc :: fn(cleaned: string, vtables: bc.VtableRow[]) -> DirectiveError | null {
    after :: cleaned.trim_prefix("vtable ").trim()
    last_space :: last_index_of_space(after)
    if last_space < 0 {
        return DirectiveError {
            .reason = "expected `vtable <key> <type-index> <fn-index>`, got `${after}`",
        }
    }
    fn_text :: after.byte_slice(i64(last_space) + 1, after.byte_len()).trim()
    fn_parsed :: parse_int_in_base(fn_text, 10)
    if fn_parsed is ParseError {
        return DirectiveError { .reason = "vtable: fn index \"${fn_text}\" is not a number" }
    }
    head :: after.byte_slice(0, i64(last_space)).trim()
    second_space :: last_index_of_space(head)
    if second_space < 0 {
        return DirectiveError {
            .reason = "vtable: expected a key and a type index before the fn index, got `${head}`",
        }
    }
    type_text :: head.byte_slice(i64(second_space) + 1, head.byte_len()).trim()
    type_parsed :: parse_int_in_base(type_text, 10)
    if type_parsed is ParseError {
        return DirectiveError {
            .reason = "vtable: receiver type index \"${type_text}\" is not a number",
        }
    }
    key :: head.byte_slice(0, i64(second_space)).trim()
    register_vtable_row(vtables, key, bc.VtableEntry {
        .receiver_type_index = i32(type_parsed),
        .fn_index            = i32(fn_parsed),
    })
    return null
}

register_vtable_row :: fn(vtables: bc.VtableRow[], key: string, entry: bc.VtableEntry) -> void {
    for i in 0..<vtables.len() {
        if vtables[i].key == key { vtables[i].entries.push(entry) return }
    }
    fresh: bc.VtableEntry[]: [entry]
    vtables.push(bc.VtableRow { .key = key, .entries = fresh })
}

/// Parse `export NAME N`. Returns the fn index when `NAME == "main"` (the
/// entry directive), otherwise records a `BcExport` row and returns `-1`.
parse_export_decl_bc :: fn(cleaned: string, exports: bc.BcExport[]) -> i32 {
    after :: cleaned.trim_prefix("export ").trim()
    parts :: after.split(" ")
    if parts.len() < 2 { return -1 }
    parsed :: parse_int_in_base(parts[1], 10)
    if parsed is ParseError { return -1 }
    if parts[0] == "main" { return i32(parsed) }
    exports.push(bc.BcExport { .extern_name = parts[0], .fn_index = i32(parsed) })
    return -1
}

/// Parse a data-pool line into a `BcDataEntry`. Primitive arrays take the form
/// `data N <kind> hex"…"` (raw `u64` bits per element) ; string arrays take
/// `data N str "v0" "v1" …` (each value `quote_string`-escaped). Mirrors
/// `virt_reader::parse_data_decl` but keeps the unmaterialised form `emit_c`
/// lowers to `.rodata` (the VM reader materialises to values in `reduce_data_pool`).
parse_data_decl_bc :: fn(
    cleaned: string, data_pool: bc.BcDataEntry[], strings: string[],
) -> DirectiveError | null {
    after :: cleaned.trim_prefix("data ")
    sp1 :: after.index_of(' ', 0)
    if sp1 < 0 {
        return DirectiveError {
            .reason = "expected `data <index> <kind> <payload>`, got `${after}`",
        }
    }
    kind_payload :: after.byte_slice(sp1 + 1, after.byte_len())
    kind_name :: before_first(kind_payload, ' ')
    payload :: after_first(kind_payload, ' ')
    if kind_name == "str" {
        data_pool.push(bc.BcStrData { .values = parse_quoted_strings(payload) })
        return null
    }
    if kind_name == "agg" {
        data_pool.push(parse_agg_decl(payload, strings))
        return null
    }
    if kind_name == "structs" {
        data_pool.push(parse_structs_decl(payload, strings))
        return null
    }
    // Every other kind carries a `hex"…"` blob. A malformed one used to be
    // dropped, which removed a whole pool entry and renumbered every later index.
    if payload.byte_len() < 5 || !payload.starts_with("hex\"") {
        return DirectiveError {
            .reason = "data `${kind_name}`: expected a `hex\"…\"` payload, got `${payload}`",
        }
    }
    if !payload.ends_with("\"") {
        return DirectiveError {
            .reason = "data `${kind_name}`: hex payload is not closed by a quote",
        }
    }
    hex_body :: payload.byte_slice(4, payload.byte_len() - 1)
    kind :: bc.array_kind_from_name(kind_name)
    esz :: i64(bc.array_kind_element_size(kind))
    items: u64[] = []
    if esz > 0 {
        bytes_arr :: hex_to_bytes(hex_body)
        items = filled_indexed(bytes_arr.len() / esz, (i) -> read_le(bytes_arr, i * esz, esz))
    }
    data_pool.push(bc.BcPrimData { .kind = kind, .items = items })
    return null
}

/// Tokenise a `"v0" "v1" …` sequence into the decoded string values. Each token
/// is `quote_string`-escaped ; `\"` / `\\` / `\n` … are honoured via the same
/// `decode_escapes` the `string N "…"` section uses, so a value containing a
/// quote round-trips. Whitespace between tokens is skipped.
parse_quoted_strings :: fn(s: string) -> string[] {
    out: string[]: []
    n :: s.byte_len()
    i: i64 = 0
    for i < n {
        if s.byte_at(i) != '"' {
            i += 1
            continue
        }
        i += 1
        start :: i
        for i < n {
            if s.byte_at(i) == '\\' {
                i += 2
                continue
            }
            if s.byte_at(i) == '"' { break }
            i += 1
        }
        body :: s.byte_slice(start, i)
        out.push(decode_escapes(body))
        i += 1
    }
    return out
}

// Parse the `agg` payload `<elemname> <count> <value>…` into a `BcAggregateData`.
// Values are count-prefixed (no paren balancing) — see `dump::write_data_value`.
// `strings` resolves any `strref <i>` leaf back to its pooled value.
parse_agg_decl :: fn(payload: string, strings: string[]) -> bc.BcAggregateData {
    tokens :: tokenize_agg(payload)
    if tokens.len() < 2 {
        return bc.BcAggregateData { .element_type_name = "", .elements = [] }
    }
    element_type_name :: tokens[0]
    count :: token_to_int(tokens[1])
    pos: i32[]: [2]
    elements: bc.BcDataValue[]: []
    for _ in 0..<count { elements.push(parse_data_value(tokens, pos, strings)) }
    return bc.BcAggregateData { .element_type_name = element_type_name, .elements = elements }
}

// Parse the compact homogeneous-struct form `<symid> <nfields> <count> <field>…`
// (the dumper's `structs` header). Every element is a `BcValStruct` with the
// hoisted `symid` ; its `nfields` field values are read flat from the stream.
// The reconstructed aggregate's top-level `element_type_name` is left "" — it is
// informational only (both the VM's `bc_value_to_vm` and c-emit resolve struct
// identity from each element's `symbol_id`, never the aggregate name ; only a
// nested `BcValArray.element_type_name` is read).
parse_structs_decl :: fn(payload: string, strings: string[]) -> bc.BcAggregateData {
    tokens :: tokenize_agg(payload)
    if tokens.len() < 3 {
        return bc.BcAggregateData { .element_type_name = "", .elements = [] }
    }
    symbol_id :: token_to_int(tokens[0])
    nfields :: token_to_int(tokens[1])
    count :: token_to_int(tokens[2])
    pos: i32[]: [3]
    elements: bc.BcDataValue[]: []
    for _ in 0..<count {
        fields: bc.BcDataValue[]: []
        for _ in 0..<nfields { fields.push(parse_data_value(tokens, pos, strings)) }
        elements.push(bc.BcValStruct { .symbol_id = symbol_id, .fields = fields })
    }
    return bc.BcAggregateData { .element_type_name = "", .elements = elements }
}

// Recursive descent over the token stream (`pos` is a 1-element mutable cursor).
// `strings` resolves a `strref <i>` leaf to the `string N` pool value.
parse_data_value :: fn(tokens: string[], pos: i32[], strings: string[]) -> bc.BcDataValue {
    tag :: take_token(tokens, pos)
    if tag == "str" { return bc.BcValStr { .value = take_token(tokens, pos) } }
    if tag == "strref" {
        idx :: token_to_int(take_token(tokens, pos))
        value :: if idx >= 0 && i64(idx) < strings.len() { strings[idx] } else { "" }
        return bc.BcValStr { .value = value }
    }
    if tag == "struct" {
        symbol_id :: token_to_int(take_token(tokens, pos))
        nfields :: token_to_int(take_token(tokens, pos))
        fields: bc.BcDataValue[]: []
        for _ in 0..<nfields { fields.push(parse_data_value(tokens, pos, strings)) }
        return bc.BcValStruct { .symbol_id = symbol_id, .fields = fields }
    }
    if tag == "array" {
        element_type_name :: take_token(tokens, pos)
        n :: token_to_int(take_token(tokens, pos))
        elems: bc.BcDataValue[]: []
        for _ in 0..<n { elems.push(parse_data_value(tokens, pos, strings)) }
        return bc.BcValArray { .element_type_name = element_type_name, .elements = elems }
    }
    // Fall-through : a primitive leaf `<kind> <hex>` ; `tag` is the kind name.
    kind :: bc.array_kind_from_name(tag)
    esz :: i64(bc.array_kind_element_size(kind))
    bytes_arr :: hex_to_bytes(take_token(tokens, pos))
    bits :: if esz > 0 { read_le(bytes_arr, 0, esz) } else { u64(0) }
    return bc.BcValPrim { .kind = kind, .bits = bits }
}

// Read the token at the cursor and advance it ; "" past the end.
take_token :: fn(tokens: string[], pos: i32[]) -> string {
    if !in_range(pos[0], tokens.len()) { return "" }
    t :: tokens[pos[0]]
    pos[0] = pos[0] + 1
    return t
}

token_to_int :: fn(s: string) -> i32 {
    r :: parse_int_in_base(s, 10)
    if r is i64 { return i32(r) }
    return 0
}

// Quoted-aware whitespace tokeniser : a `"…"` run (escape-decoded) is one token.
tokenize_agg :: fn(s: string) -> string[] {
    out: string[]: []
    n :: s.byte_len()
    i: i64 = 0
    for i < n {
        if s.byte_at(i) == ' ' {
            i += 1
            continue
        }
        if s.byte_at(i) == '"' {
            i += 1
            start :: i
            for i < n {
                if s.byte_at(i) == '\\' {
                    i += 2
                    continue
                }
                if s.byte_at(i) == '"' { break }
                i += 1
            }
            out.push(decode_escapes(s.byte_slice(start, i)))
            i += 1
        } else {
            start :: i
            for i < n {
                if s.byte_at(i) == ' ' { break }
                i += 1
            }
            out.push(s.byte_slice(start, i))
        }
    }
    return out
}


// ---- function header / signature ------------------------------------------

/// Parse the `(p0,p1) -> r` slice of a `fn`/`import` line into a `BcSignature`.
/// The `.virt` carries only ValType names ; `param_types` / `result_type`
/// (BcType indices) are reconstructed via `class_tag_of` : exact for
/// scalar slots, `0` for ref/any (which `c_emit` doesn't tag).
parse_signature_bc :: fn(line: string, types: bc.BcType[]) -> bc.BcSignature {
    open :: line.index_of('(', 0)
    close :: line.index_of(')', 0)
    params: bc.ValType[]: []
    param_types: i32[]: []
    if open >= 0 && close >= 0 && close > open + 1 {
        inner :: line.byte_slice(open + 1, close)
        for p in inner.split(",") {
            v :: vt_or_void(p.trim())
            params.push(v)
            param_types.push(class_tag_of(types, v))
        }
    }
    result := bc.ValType.Void
    arrow :: line.index_of('>', 0)
    results: bc.ValType[]: []
    result_types: i32[]: []
    if arrow >= 0 {
        rtext :: line.byte_slice(arrow + 1, line.byte_len()).trim()
        // `-> i32` is one result and `-> (i32,i32)` several — the same split the
        // writer makes, so a single-value signature round-trips through the
        // format it has always used.
        if rtext.starts_with("(") && rtext.ends_with(")") {
            inner :: rtext[1..<rtext.len() - 1]
            for r in inner.split(",") {
                v :: vt_or_void(r.trim())
                results.push(v)
                result_types.push(class_tag_of(types, v))
            }
        } else {
            result = vt_or_void(rtext)
        }
    }
    if results.len() == 0 {
        // No parenthesised list, so the header named one result — or none, which
        // the representation spells as a single `Void` entry.
        results.push(result)
        result_types.push(class_tag_of(types, result))
    }
    return bc.BcSignature {
        .params      = params,
        .results     = results,
        .param_types = param_types,
        .result_types = result_types,
        .param_names = [],
    }
}

parse_local_decl_bc :: fn(cleaned: string) -> bc.BcLocal {
    after :: cleaned.trim_prefix("local ").trim()
    sp :: after.index_of(' ', 0)
    if sp < 0 { return bc.BcLocal { .name = after, .val = .Void } }
    nm :: after.byte_slice(0, sp)
    vtn :: after.byte_slice(sp + 1, after.byte_len()).trim()
    return bc.BcLocal { .name = nm, .val = vt_or_void(vtn) }
}

// ---- small reconstruction helpers -----------------------------------------

/// BcType index of the `BcScalar` whose stack class is `val`, or `0` when
/// none is materialised. Local mirror of `c_emit::class_tag_of` (the VM does
/// not import `vader/c_emit`). Ref/Any return `0`, harmless since
/// `box_expr` boxes Ref/Any as bare values without a tag.
class_tag_of :: fn(types: bc.BcType[], val: bc.ValType) -> i32 {
    for i in 0..<types.len() {
        t :: types[i]
        if t is bc.BcScalar {
            if t.val == val { return i32(i) }
        }
    }
    return 0
}

/// Strip the dump's `quote_ident` wrapping from a struct or trait name: a
/// `"..."`-quoted name (`"std/core.Error"`) is unquoted, its escapes read back by
/// `decode_escapes` (the dump writes it with `quote_string`). A bare name passes
/// through unchanged.
unquote_name :: fn(s: string) -> string {
    n :: s.byte_len()
    if n >= 2 && s.byte_at(0) == '"' && s.byte_at(n - 1) == '"' {
        return decode_escapes(s.byte_slice(1, n - 1))
    }
    return s
}

/// `parse_val_type` with a `Void` fallback for unrecognised spellings.
vt_or_void :: fn(name: string) -> bc.ValType {
    v :: bc.parse_val_type(name) ?? return .Void
    return v
}

/// Entry-point fallback when the `.virt` carried no `export main N` — the
/// first `$main`-suffixed fn, or `-1` when none.
find_main_by_suffix_bc :: fn(functions: bc.BcFunction[]) -> i32 {
    for i in 0..<functions.len() {
        if functions[i].name.ends_with(r"$main") { return i32(i) }
    }
    return -1
}

// ---- runtime projections (`prepare` reuses these) --------------------------
//
// `prepare` (module.vader) wraps a parsed `BytecodeModule` in a `VmState`,
// materialising the data pool to runtime `ArrayVal`s and resolving the entry
// index up front. Both helpers below back that wrapper ; `value_from_bits` is
// the per-element bit-pattern decoder they share.

// The entry is the `is_main` fn (set by `parse_virt_bc` from `export main N` or
// the `$main`-suffix fallback) ; -1 when there is none, which `exec_entry` refuses
// rather than run an arbitrary function.
reduce_main_index :: fn(funcs: bc.BcFunction[]) -> i32 {
    for i in 0..<funcs.len() {
        if funcs[i].is_main { return i32(i) }
    }
    return -1
}

// One header per pool entry, stamped with the type_id its `data.const` sites read
// it at (`type_ids`, from `bc.data_pool_type_ids`).
reduce_data_pool :: fn(entries: bc.BcDataEntry[], types: bc.BcType[], type_ids: i32[]) -> ArrayVal[] {
    out: ArrayVal[]: []
    for i in 0..<entries.len() {
        e :: entries[i]
        elements: Value[]: []
        if e is bc.BcStrData {
            for v in e.values { elements.push(StringVal(v)) }
        } else if e is bc.BcPrimData {
            for item in e.items { elements.push(value_from_bits(e.kind, item)) }
        } else if e is bc.BcAggregateData {
            for v in e.elements { elements.push(bc_value_to_vm(v, types)) }
        }
        out.push(ArrayVal {
            .type_id  = type_ids[i],
            .elements = elements,
            .offset   = 0,
            .length   = elements.len(),
        })
    }
    return out
}

// Materialise one recursive baked value into a VM `Value`. Struct identity is
// resolved from `symbol_id` against the module type table ; nested arrays carry
// type_id 0 (the VM is loosely typed — field access reads positionally).
bc_value_to_vm :: fn(v: bc.BcDataValue, types: bc.BcType[]) -> Value {
    if v is bc.BcValStr { return StringVal(v.value) }
    if v is bc.BcValPrim { return value_from_bits(v.kind, v.bits) }
    if v is bc.BcValStruct {
        fields: Value[]: []
        for f in v.fields { fields.push(bc_value_to_vm(f, types)) }
        return StructVal { .type_id = type_id_for_symbol(types, v.symbol_id), .fields = fields }
    }
    if v is bc.BcValArray {
        elems: Value[]: []
        for e in v.elements { elems.push(bc_value_to_vm(e, types)) }
        return ArrayVal { .type_id = 0, .elements = elems, .offset = 0, .length = elems.len() }
    }
    return I32Val(0)
}

// Type-table index of the `BcStruct` declared by `symbol_id`, or 0 when absent.
// The `type_id` IS load-bearing: `type_check` compares it, so a baked struct with
// the wrong one fails every `is` test. A `.virt`-parsed table resolves because each
// struct's `symbol_id` is its own index (`parse_type_decl_bc`).
type_id_for_symbol :: fn(types: bc.BcType[], symbol_id: i32) -> i32 {
    index :: bc.struct_symbol_type_index(types, symbol_id)
    return if index < 0 { 0 } else { index }
}

// Reinterpret an element's raw `u64` bit pattern per its `ArrayKind`. Mirrors
// `virt_reader::read_data_item`, reading from the materialised `u64` rather than
// a hex byte slice. f32/f64 bit-cast the low bits (f32 held in an `F64Val`, as
// elsewhere in the VM) ; `Boxed` never appears in a primitive data pool.
value_from_bits :: fn(kind: bc.ArrayKind, bits: u64) -> Value {
    if kind == .U8   { return I32Val(i32(bits & 0xff)) }
    if kind == .I8   {
        b :: bits & 0xff
        return I32Val(if b >= 0x80 { i32(b) - 256 } else { i32(b) })
    }
    if kind == .Bool { return BoolVal(bits != 0) }
    if kind == .U16  { return I32Val(i32(bits & 0xffff)) }
    if kind == .I16  {
        v :: bits & 0xffff
        return I32Val(if v >= 0x8000 { i32(v) - 0x1_0000 } else { i32(v) })
    }
    if kind == .U32  { return I32Val(i32(u32(bits))) }
    if kind == .I32  { return I32Val(i32(u32(bits))) }
    if kind == .Char { return CharVal(char(u32(bits))) }
    if kind == .U64  { return I64Val(i64(bits)) }
    if kind == .I64  { return I64Val(i64(bits)) }
    if kind == .F32  { return F64Val(f64(u32(bits).from_bits())) }
    if kind == .F64  { return F64Val(bits.from_bits()) }
    return I32Val(0)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_parse_virt_bc_roundtrips_struct_and_signature :: fn() -> void {
    // A minimal module exercising the metadata the VM reader drops: a struct
    // with typed fields, a fn with a typed signature + a declared local.
    // Single-line `\n`-joined to dodge triple-quote / `$`-interpolation rules.
    src :: "module demo\ntype 0 scalar i32\ntype 1 scalar void\ntype 2 struct Pair { lhs:0, rhs:0 }\nfn 0 add (i32,i32) -> i32\n  local acc i32\n  local.get 0\n  local.get 1\n  i32.add\n  return\nend\nexport main 0\n"
    m :: parse_virt_bc(src)
    if m is VirtParseError {
        assert(false, "well-formed dump should parse: line ${m.line_number}: ${m.reason}")
        return
    }
    assert_eq(m.name, "demo")
    assert_eq(m.types.len(), 3)
    // struct fields recovered (the VM reader keeps only a count)
    s :: m.types[2]
    if s is bc.BcStruct {
        assert_eq(s.name, "Pair")
        assert_eq(s.fields.len(), 2)
        assert_eq(s.fields[0].name, "lhs")
        assert_eq(s.fields[0].type_index, 0)
    } else {
        assert(false, "types[2] should parse as a BcStruct")
    }
    assert_eq(m.functions.len(), 1)
    f :: m.functions[0]
    assert_eq(f.name, "add")
    assert_eq(f.is_main, true)
    // signature ValTypes parsed, indices reconstructed (i32 -> type 0).
    // `assert(==)` not `assert_eq` : ValType has the built-in `==` but no
    // `Equals` trait impl (which `assert_eq`'s generic bound requires).
    assert_eq(f.signature.params.len(), 2)
    assert(f.signature.params[0] == .I32, "param 0 should be i32")
    assert_eq(f.signature.param_types[0], 0)
    assert(bc.bc_single_result(f.signature) == .I32, "result should be i32")
    assert_eq(bc.bc_single_result_type(f.signature), 0)
    // local ValType recovered
    assert_eq(f.locals.len(), 1)
    assert_eq(f.locals[0].name, "acc")
    assert(f.locals[0].val == .I32, "local acc should be i32")
    // body wired (4 ops) + parallel debug nulls
    assert_eq(f.body.len(), 4)
    assert_eq(f.debug.len(), 4)
}

// The two silent-skip paths this reader used to have. Each dropped its line and
// carried on, handing back a module that looked complete: the instruction case
// shifts every following pc, the directive case leaves a hole in a pool. Both
// now stop the parse and name the line — see `VirtParseError`.

@test test_parse_virt_listing_notes_each_line :: fn() -> void {
    // A comment, a blank line and a `local` take a line but no op ; a structured
    // `if` … `end` takes one op per line.
    lines :: [
        "module demo",
        "type 0 scalar i32",
        "fn 0 main () -> i32",
        "  local x i32",
        "  i32.const 1   ; one",
        "",
        r"  if $L0 void",
        r"  end $L0",
        "  return",
        "end",
        "export main 0",
    ]
    listing :: parse_virt_listing(lines.join("\n"))
    if listing is VirtParseError {
        assert(false, "well-formed dump should parse: ${listing.reason}")
        return
    }
    assert_eq(listing.functions.len(), 1)
    function :: listing.functions[0]
    assert_eq(function.ops.len(), listing.module.functions[0].body.len())
    ops :: function.ops
    assert_eq("${ops[0]} ${ops[1]} ${ops[2]} ${ops[3]}", "4 6 7 8")
    assert_eq("${function.header} ${function.locals[0]} ${listing.types[0]}", "2 3 1")
}

@test test_unknown_instruction_stops_the_parse :: fn() -> void {
    // `frobnicate` on line 5, between two real ops, is what a stale dump looks
    // like after an opcode leaves the set.
    src :: "module demo\ntype 0 scalar i32\nfn 0 main () -> i32\n  i32.const 1\n  frobnicate 7\n  return\nend\nexport main 0\n"
    r :: parse_virt_bc(src)
    if r is VirtParseError {
        assert_eq(r.line_number, 5)
        assert_eq(r.line, "frobnicate 7")
        assert("frobnicate" in r.reason, "the reason should name the opcode, got: ${r.reason}")
    } else {
        assert(false, "an unknown instruction must not be skipped silently")
    }
}

@test test_unknown_directive_stops_the_parse :: fn() -> void {
    src :: "module demo\ntype 0 scalar i32\nsprocket 3\nfn 0 main () -> i32\n  return\nend\nexport main 0\n"
    r :: parse_virt_bc(src)
    if r is VirtParseError {
        assert_eq(r.line_number, 3)
        assert("sprocket" in r.reason, "the reason should name the directive, got: ${r.reason}")
    } else {
        assert(false, "an unknown module directive must not be skipped silently")
    }
}

@test test_unquoted_string_stops_the_parse :: fn() -> void {
    // Dropping it would renumber every later `string.const`.
    src :: "module demo\nstring 0 hello\nstring 1 \"world\"\n"
    r :: parse_virt_bc(src)
    if r is VirtParseError {
        assert_eq(r.line_number, 2)
    } else {
        assert(false, "a string line without quotes must not be skipped silently")
    }
}

@test test_diagnostics_block_ends_the_module :: fn() -> void {
    // What `vader dump --stage=bytecode` writes for a compile that warned: the
    // module, then a report. The report parses as neither directive nor op, so
    // the reader has to recognise it as the end rather than choke on it.
    src :: "module demo\ntype 0 scalar i32\nfn 0 main () -> i32\n  return\nend\nexport main 0\n\n# Diagnostics\n[21:10] warning[W0001] use of deprecated declaration: `old_helper`\n"
    m :: parse_virt_bc(src)
    if m is VirtParseError {
        assert(false, "a trailing diagnostics block should end the module, not fail it: ${m.reason}")
        return
    }
    assert_eq(m.name, "demo")
    assert_eq(m.functions.len(), 1)
}

// Directive-level refusals. Each of these used to be swallowed: the parser
// dropped or degraded the entry and handed back a module that looked complete —
// a missing `type` collapsed a struct to an opaque ref (blocker #1 of the
// self-host audit), a dropped pool entry renumbered every index after it.
@test test_unknown_type_kind_stops_the_parse :: fn() -> void {
    src :: "module demo\ntype 0 wobble\nexport main 0\n"
    r :: parse_virt_bc(src)
    if r is VirtParseError {
        assert_eq(r.line_number, 2)
        assert("wobble" in r.reason, "the reason should name the kind, got: ${r.reason}")
    } else {
        assert(false, "an unknown type kind must not become a BcRef placeholder")
    }
}

@test test_malformed_struct_field_stops_the_parse :: fn() -> void {
    // Field order IS the field index, so dropping one renumbers the rest.
    src :: "module demo\ntype 0 struct P { a }\nexport main 0\n"
    r :: parse_virt_bc(src)
    if r is VirtParseError {
        assert_eq(r.line_number, 2)
        assert("separator" in r.reason, "should say what the field is missing")
    } else {
        assert(false, "a field with no `name:type` must not be skipped")
    }
}

@test test_malformed_pool_directives_stop_the_parse :: fn() -> void {
    // One case per pool: dropping an entry shifts every later index.
    cases :: [
        "impl zz Trait",
        "vtable K zz 1",
        "data 0 i32 nothex",
        "import m",
    ]
    for bad in cases {
        r :: parse_virt_bc("module demo\n${bad}\nexport main 0\n")
        if r is VirtParseError {
            assert_eq(r.line_number, 2)
            assert(r.reason != "", "`${bad}` should carry a reason")
        } else {
            assert(false, "`${bad}` must not be dropped silently")
        }
    }
}

@test test_malformed_operands_stop_the_parse :: fn() -> void {
    // A head the reader knows, operands it can't read: `parse_int_const_text`
    // returns null, the op never lands, and every later pc used to shift by one.
    src :: "module demo\ntype 0 scalar i32\nfn 0 main () -> i32\n  i32.const\n  return\nend\nexport main 0\n"
    r :: parse_virt_bc(src)
    if r is VirtParseError {
        assert_eq(r.line_number, 4)
    } else {
        assert(false, "an operand-less i32.const must not be skipped silently")
    }
}
