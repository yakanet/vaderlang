// vader/vm/host: host-import surface for the Vader-side VM.
//
// Every `call.import N` runs through `dispatch_import` here ; per-host
// arms unwrap the args from the caller stack, invoke the corresponding
// native stdlib intrinsic, and wrap the result back into an `Value`.
// The shape is a flat mangled-name cascade with trap-on-miss
// semantics.

module "vader/vm"

bc :: import "vader/core/bytecode"

import "std/io"
import "std/env"
import "std/tty"
import "std/process"
import "std/math"
import "std/string"
import "std/target"

/// Outcome of a successful host call. `value` is unused when the import
/// has `has_return == false` — the exec checks the import's signature
/// before pushing.
export HostCallResult :: HostOk | Trap
export HostOk :: struct { value: Value }

// An extern's integer argument `i`, its label built only when it is not one.
extern_word :: fn(v: Value, at_pc: i32, extern_name: string, i: i64) -> I64Val | Trap {
    if v is I64Val {
        return v
    }
    return read_i64(v, at_pc, "extern `${extern_name}` arg ${i}")
}

// Serve `ffi_call` or, `through_adapter`, `ffi_call_frame` to code the VM runs:
// an address, a descriptor and a frame, passed on as real byte arrays.
hosted_frame_call :: fn(
    stack: Value[], arg_base: i64, at_pc: i32, label: string, through_adapter: bool,
) -> string | Trap {
    ptr :: read_i64(stack[arg_base], at_pc, "${label} fn_ptr")
    if ptr is Trap { return ptr }
    desc_arr :: read_array(stack[arg_base + 1], at_pc, "${label} desc")
    if desc_arr is Trap { return desc_arr }
    frame_arr :: read_array(stack[arg_base + 2], at_pc, "${label} frame")
    if frame_arr is Trap { return frame_arr }
    // A VM array holds boxed `Value`s, not contiguous bytes, so both are
    // materialised into real `u8[]`. The host takes their address right
    // before the call, and nothing runs in between.
    desc :: array_bytes(desc_arr, desc_arr.length, at_pc, "${label} desc byte")
    if desc is Trap {
        return desc
    }
    own_bytes(frame_arr)
    frame: u8[]: []
    for i in 0..<frame_arr.length {
        b :: read_i64(frame_arr.elements[frame_arr.offset + i], at_pc, "${label} frame byte")
        if b is Trap { return b }
        frame.push(u8(b))
    }
    returned :: call_foreign(i64(ptr), through_adapter, desc, frame, -1)
    // `frame` is a COPY, and it carries BOTH what the callee wrote into a
    // lent area and the result itself, so it has to travel back whole.
    for i in 0..<frame_arr.length {
        at :: frame_arr.offset + i
        frame_arr.elements[at] = retyped_int(frame_arr.elements[at], i64(frame[i]))
    }
    return returned
}


/// Dispatch a host import. Matches on `id`, the import's manifest
/// classification — every arm pops the args from
/// `stack[arg_base ..]`, executes the host action, and returns either
/// `HostOk { value }` (the result pushed onto the caller's value stack) or a
/// `Trap` (surfaced verbatim). Hosts the VM doesn't serve (native-only C shims)
/// and non-intrinsics fall through the grouped arm to the unbound `Trap`.
///
/// @param info      the import descriptor (mangled name + signature).
/// @param stack     caller value stack — args live at `[arg_base ..]`.
/// @param arg_base  cursor of the first arg in `stack`.
/// @param gc_state  1-element box for the `std/runtime` collection
///                  counter — `collect` bumps `[0]`, `collections`
///                  reads it.
/// @param at_pc     pc of the calling `call.import` op, used for Trap
///                  diagnostics only.
/// @param string_array_type_id  the module's `string[]` ArrayType index
///                  (see `find_string_array_type_id`), stamped onto the
///                  arrays returned by `split` / `read_dir` so they narrow
///                  to `is string[]` in their `string[] | Error` union return.
/// @param u8_array_type_id  the module's `u8[]` ArrayType index (see
///                  `find_u8_array_type_id`), stamped onto the array `bytes`
///                  materialises so it narrows to `is u8[]`.
/// @param io_error_type_id  the `std/io$IOError` struct's type index (see
///                  `find_io_error_type_id`), stamped onto fabricated io
///                  error values by `mk_io_error` ; `-1` when io was never
///                  imported.
/// @param types     the module type table — an `@extern` lending an array needs
///                  its element width, which only the type table spells.
/// @param is_comptime  true when this dispatch runs inside a `@comptime`
///                  evaluation (`exec_fn_value` path). Gates the impure hosts
///                  (see `is_impure_host`) so a compile-time constant can never
///                  bake a non-reproducible value.
/// @param id        `intrinsic_id_for(info.mangled_name)`, classified by the
///                  caller — `prepare` does it once per import (`VmState.import_ids`),
///                  since the classification rebuilds and interns mangled names.
/// @param adapter   the address of the adapter an `@extern` is called through,
///                  `0` for none (`VmState.adapters`).
/// @return          `HostOk { value }` on success ; `Trap` on a missing
///                  import, malformed arg, host-level failure, or an impure host
///                  reached at comptime.
/// @error           traps with an `is_impure_comptime_trap_message` marker when
///                  `is_comptime` and the host is impure — `pipeline/comptime_vm` routes
///                  it to `C4016` rather than the generic `C4002`.
export dispatch_import :: fn(info: bc.BcImport, stack: Value[], arg_base: i64, gc_state: i64[], sched_state: i64[], at_pc: i32, string_array_type_id: i32, u8_array_type_id: i32, io_error_type_id: i32, types: bc.BcType[], is_comptime: bool, debug: DebugController | null, id: bc.IntrinsicId, adapter: i64) -> HostCallResult {
    // ---- compiler-internal `@extern` hosts ---------------------------------
    //
    // `@extern` is EXEMPT from the emit-time wiring check (`emit/bytecode/emit.vader` :
    // "@extern imports are link-resolved and exempt") — correct for user FFI,
    // which the C linker resolves, but it means an `@extern` the COMPILER ITSELF
    // uses is invisible to this dispatcher: the moment the compiler runs on its
    // own bytecode it traps as an unbound import. Serve the ones `vader/`
    // declares.
    //
    // Kept keyed on the C symbol rather than given `IntrinsicId`s : the
    // manifest is shared with `emit_c`, which already resolves these by linking,
    // so a new id there would force a redundant C-side arm.
    //
    // Guarded by `tests/extern_vm_handlers.test.ts` : any new `@extern` under
    // `vader/` must gain a handler here or that test fails.
    if info.is_extern {
        if is_profiler_bracket(info.extern_name) {
            return HostOk { .value = zero_value() }
        }
        return dispatch_extern(info, stack, arg_base, at_pc, types, debug, adapter)
    }
    // Comptime gate. It is NARROW on purpose, and narrower than it once was.
    //
    // Baking a non-reproducible value is the program author's business: a build
    // stamp is an ordinary thing to want, and Vader is not going to forbid it to
    // protect one program's invariant. THIS compiler's byte-identical bootstrap
    // is checked where it belongs, by `bootstrap/verify.sh` comparing stage1 to
    // stage2 — not by refusing every user a clock.
    //
    // An `@extern` never reaches here at all: `dispatch_extern` returned above.
    // So the clock, the environment, the filesystem and the subprocess table are
    // all reachable from a `@comptime` block, and that is the intent. What is
    // left refused answers for the MACHINE THE COMPILER RUNS ON — see
    // `is_impure_host`.
    if is_comptime && is_impure_host(id) {
        return impure_comptime_trap(info.mangled_name)
    }
    match id {
    // ---- std/string family ----------------------------------------------
    .ByteLen | .ByteAt | .ByteSlice | .IsAscii -> {
        // Run as register ops of their own (`string_byte_op`): translation leaves
        // them no `call.import`, so one reaching here is unbound.
    }
    .BytesToString -> {
        // bytes→string : the native interns the bytes verbatim (no UTF-8
        // validation) — straight from the view a `s.bytes()` reads, else
        // gathered out of the boxed u8 slots.
        arr :: read_array(stack[arg_base], at_pc, "bytes_to_string receiver")
        if arr is Trap { return arr }
        bs :: array_bytes(arr, arr.length, at_pc, "bytes_to_string byte")
        if bs is Trap {
            return bs
        }
        return HostOk { .value = StringVal(bs.bytes_to_string()) }
    }
    .Bytes -> {
        s :: read_string(stack[arg_base], at_pc, "bytes receiver")
        if s is Trap { return s }
        return HostOk { .value = bytes_to_value(string(s), u8_array_type_id) }
    }
    .StringHash -> {
        // String `Hash` reads the hash cached on the interned atom. Calling
        // `.hash()` on the Vader string here lowers to the native
        // `vader_string_hash` intrinsic in the VM's own build, so the VM and
        // native produce identical hashes for the same atom. u64 rides in I64Val.
        s :: read_string(stack[arg_base], at_pc, "hash receiver")
        if s is Trap { return s }
        return HostOk { .value = I64Val(i64(string(s).hash())) }
    }
    // `StringBuilder implements Display` is pure Vader ; the resolver
    // materialises its body (a `Buffer` filled by `write_string`, then interned),
    // so the VM runs a real fn — there is no host shim to dispatch here.
    // ---- std/core Display + Equals intrinsics ----------------------------
    // `@intrinsic string implements Equals` — structural string compare.
    // Reached when map key lookups dispatch `key.equals(other)` virtually
    // (the virtual.call intrinsic fallback in exec.vader rebuilds this mangle).
    .StringEquals -> {
        a :: read_string(stack[arg_base], at_pc, "equals receiver")
        if a is Trap { return a }
        b :: read_string(stack[arg_base + 1], at_pc, "equals arg")
        if b is Trap { return b }
        return HostOk { .value = BoolVal(string(a) == string(b)) }
    }
    // `@intrinsic <intwidth> implements Equals` — bodyless for every integer
    // width, so an erased map-key lookup (`MutableMap<Any, K>` with integer K)
    // dispatches `key.equals(other)` virtually and surfaces it as a host import
    // (mirror of the string arm above). Reached e.g. by `MutableSet<i32>`.
    // `read_i64` widens an `I32Val`, so every width compares on its i64 bits —
    // right for signed and unsigned alike.
    .PrimIntEquals -> {
        a :: read_i64(stack[arg_base], at_pc, "equals receiver")
        if a is Trap { return a }
        b :: read_i64(stack[arg_base + 1], at_pc, "equals arg")
        if b is Trap { return b }
        return HostOk { .value = BoolVal(i64(a) == i64(b)) }
    }
    // `<width> implements Display.to_string` for every primitive — the
    // VM emits the SPEC §9 canonical form via `display_value`. Width
    // doesn't matter at runtime (every integer collapses to `I32Val`),
    // so a single arm covers all the per-width manglings.
    .PrimDisplayToString -> {
        // An unsigned integer rides a signed carrier : a `u32` past
        // `i32.MAX` in an `I32Val`, a `u64` past `i64.MAX` in an `I64Val`.
        // Default `display_value` renders that bit pattern as signed (e.g.
        // `-9551616` instead of `18446744073700000000`). The lower pass routes
        // unsigned interpolations through this dispatch, which recovers the
        // unsigned form by reinterpreting the bit pattern.
        if bc.is_unsigned_display(info.mangled_name) {
            v :: stack[arg_base]
            // @partial: integer carriers reinterpret as unsigned; other tags trap.
            return @partial match v {
                is I64Val -> HostOk { .value = StringVal(u64(v).to_string()) }
                is I32Val -> HostOk { .value = StringVal(u64(u32(v)).to_string()) }
                // Any other Value tag means the lowerer routed a non-
                // integer through `<u_width>$Display$to_string`. Trap
                // loudly so the regression surfaces here instead of as a
                // mysteriously wrong rendering.
                _ -> Trap { .message = "${info.mangled_name} at pc=${at_pc}: expected integer Value, got ${describe_value_tag(v)}" }
            }
        }
        return HostOk { .value = StringVal(display_value(stack[arg_base])) }
    }
    // ---- std/runtime collection counters ---------------------------------
    // The Vader VM has no GC arena ; the snippet tests just need the
    // counter to be present + monotonic. `collect` bumps it, `collections`
    // returns the current value, `bytes_used` / `bytes_copied` stay at
    // zero (no real arena to measure).
    .RuntimeCollect -> {
        gc_state[0] = gc_state[0] + 1
        return HostOk { .value = NullVal {} }
    }
    .RuntimeCollections -> { return HostOk { .value = I32Val(i32(gc_state[0])) } }
    .RuntimeBytesUsed   -> { return HostOk { .value = I32Val(0) } }
    .RuntimeBytesCopied -> { return HostOk { .value = I32Val(0) } }
    // ---- std/runtime — cooperative async scheduler ----------------------
    // VM-side mirror of the C scheduler : `sched_state[0]` = now, `[1..]` =
    // pending deadlines. The VM always jumps the virtual clock (an interpreter
    // never real-sleeps) ; output depends only on deadline ordering, so it
    // matches native.
    .SchedNow -> { return HostOk { .value = I64Val(sched_state[0]) } }
    .SchedArm -> {
        d :: read_i64(stack[arg_base], at_pc, "sched_arm deadline")
        if d is Trap { return d }
        sched_state.push(i64(d))
        return HostOk { .value = NullVal {} }
    }
    .SchedPark -> {
        drop_due_timers(sched_state)
        if sched_state.len() <= 1 { return HostOk { .value = I32Val(1) } }  // deadlock
        nearest := sched_state[1]
        for i in 2..<sched_state.len() { if sched_state[i] < nearest { nearest = sched_state[i] } }
        sched_state[0] = nearest
        drop_due_timers(sched_state)
        return HostOk { .value = I32Val(0) }
    }
    // ---- std/tty + std/env ----------------------------------------------
    // Raw mode from the VM is the same call the native binary makes: the VM is
    // itself a native binary, so these are its own intrinsics. It matters because
    // Both re-enter the same host the compiled compiler binds to: an `Os` / `Arch`
    // ordinal rides in an i32 slot like any enum.
    // Dynamic foreign calls. A `@test` runs ON the VM, so these have to be
    // served here too — the arms forward to the same intrinsics the natively
    // compiled VM calls directly.
    .FfiOpen -> {
        name :: read_string(stack[arg_base], at_pc, "ffi_open name")
        if name is Trap { return name }
        return HostOk { .value = I64Val(ffi_open(string(name))) }
    }
    .FfiSymbol -> {
        lib :: read_i64(stack[arg_base], at_pc, "ffi_symbol lib")
        if lib is Trap { return lib }
        sym :: read_string(stack[arg_base + 1], at_pc, "ffi_symbol name")
        if sym is Trap { return sym }
        return HostOk { .value = I64Val(ffi_symbol(i64(lib), string(sym))) }
    }
    .FfiOpenPath -> {
        path :: read_string(stack[arg_base], at_pc, "ffi_open_path path")
        if path is Trap { return path }
        return HostOk { .value = I64Val(ffi_open_path(string(path))) }
    }
    .FfiCall -> {
        returned :: hosted_frame_call(stack, arg_base, at_pc, "ffi_call", false)
        if returned is Trap { return returned }
        return HostOk { .value = zero_value() }
    }
    .FfiCallFrame -> {
        returned :: hosted_frame_call(stack, arg_base, at_pc, "ffi_call_frame", true)
        if returned is Trap { return returned }
        return HostOk { .value = StringVal(returned) }
    }
    .TargetCurrentOs -> {
        return HostOk { .value = I32Val(i32(current_os())) }
    }
    .TargetCurrentArch -> {
        return HostOk { .value = I32Val(i32(current_arch())) }
    }
    // ---- std/abort -------------------------------------------------------
    .AbortPanic -> {
        message :: read_string(stack[arg_base], at_pc, "panic")
        if message is Trap { return message }
        return Trap { .message = "panic — ${string(message)}" }
    }
    // Non-intrinsics. Kept as an arm rather than a wildcard so a new
    // `IntrinsicId` variant still trips T3013 here.
    .NotIntrinsic -> {}
    }
    return Trap { .message = "unbound host import '${info.mangled_name}' at pc=${at_pc}" }
}

/// Whether `symbol` is the raw write syscall behind `std/io` — `write(2)` on POSIX,
/// which the Windows CRT also exports (as an alias of `_write`).
///
/// Recognised so the DAP routing below can send program output to the debug
/// client rather than the process's own stdout.
///
/// @param symbol  the import's foreign symbol name.
/// @return        whether it is the write syscall.
is_write_symbol :: fn(symbol: string) -> bool =
    symbol == "write" || symbol == "_write" || symbol == "WriteFile"

/// Whether `symbol` is Win32's `GetStdHandle`.
///
/// Under the debugger it is intercepted so the handle it returns is a POSIX
/// DESCRIPTOR (1 / 2) rather than a real Win32 handle. `debug_write` then reads
/// the same first argument on both platforms — `WriteFile`'s first three
/// parameters have the same shape as `write`'s — and nothing else has to know
/// which OS produced the call.
///
/// @param symbol  the import's foreign symbol name.
/// @return        whether it is `GetStdHandle`.
is_std_handle_symbol :: fn(symbol: string) -> bool = symbol == "GetStdHandle"

/// The POSIX descriptor a `GetStdHandle` argument stands for, under the
/// debugger. `STD_OUTPUT_HANDLE` is `(DWORD) -11`, `STD_ERROR_HANDLE` `(DWORD) -12`.
///
/// @param which  the `nStdHandle` argument.
/// @return       1 for stdout, 2 for stderr.
debug_std_descriptor :: fn(which: i64) -> i64 = if which == 0xFFFF_FFF4 { 2 } else { 1 }

// The first `count` bytes of `a` as a `u8[]`: the bytes it reads in place when it
// views a string, else its boxed slots gathered.
array_bytes :: fn(a: ArrayVal, count: i64, at_pc: i32, label: string) -> u8[] | Trap {
    raw :: a.raw
    if raw != null {
        return raw.bytes()[a.offset..<a.offset + count]
    }
    bs: u8[]: []
    for i in 0..<count {
        b :: read_i64(a.elements[a.offset + i], at_pc, label)
        if b is Trap {
            return b
        }
        bs.push(u8(b))
    }
    return bs
}

/// Route a `sys_write` through the debugger's output sink instead of the real
/// descriptor, and report the full count as written.
///
/// The argument shape is `sys_write(fd, buf, count)`; the sink takes a Stream
/// ordinal, which is `fd - 1` (descriptor 1 is `Stdout`, 2 is `Stderr`).
///
/// @param info      the import, for its name in trap messages.
/// @param stack     the operand stack.
/// @param arg_base  index of the first argument.
/// @param at_pc     program counter, for trap messages.
/// @param debug     the attached controller.
/// @return          the byte count, as the syscall would report it.
debug_write :: fn(info: bc.BcImport, stack: Value[], arg_base: i64, at_pc: i32, debug: DebugController) -> HostCallResult {
    fd :: read_i64(stack[arg_base], at_pc, "sys_write fd")
    if fd is Trap { return fd }
    arr :: read_array(stack[arg_base + 1], at_pc, "sys_write buf")
    if arr is Trap { return arr }
    count :: read_i64(stack[arg_base + 2], at_pc, "sys_write count")
    if count is Trap { return count }
    if count < 0 || i64(count) > arr.length {
        return Trap { .message = "sys_write at pc=${at_pc}: count ${i64(count)} exceeds the buffer" }
    }
    bs :: array_bytes(arr, i64(count), at_pc, "sys_write byte")
    if bs is Trap {
        return bs
    }
    debug.output_sink(i32(fd) - 1, bytes_to_string(bs))
    // `WriteFile` answers a bool, `write` a byte count.
    if bc.bc_single_result(info.signature) == .Bool {
        return HostOk { .value = BoolVal(true) }
    }
    return HostOk { .value = I64Val(i64(count)) }
}

// What a trap says when only a native build can make the call.
BUILD_NATIVELY :: "build the program with `vader build`"

// Why the library of `info` did not open. One that ships static archives never
// gets here: `adapter_reason` sends it through an adapter.
unopened_reason :: fn(info: bc.BcImport) -> string {
    library :: info.library ?? return "cannot open the running process"
    return "cannot open `${library.name}`"
}

// The address `info` is called at: its adapter, or the symbol its library
// exports. The declared library, or the default scope: `GetStdHandle` lives in
// `kernel32.dll`, which the running process exports nothing of.
callee_of :: fn(info: bc.BcImport, adapter: i64, at_pc: i32) -> I64Val | Trap {
    if adapter != 0 {
        return I64Val(adapter)
    }
    lib :: ffi_open(bc.library_name(info))
    if lib == 0 {
        return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: ${unopened_reason(info)}" }
    }
    sym :: ffi_symbol(lib, info.extern_name)
    if sym == 0 {
        return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: symbol not found" }
    }
    return I64Val(sym)
}

// Call `callee` on `frame`: an adapter takes the frame alone, a trampoline the
// slots `desc` classes.
call_foreign :: fn(callee: i64, through_adapter: bool, desc: u8[], frame: u8[], nfixed: i64) -> string {
    if through_adapter {
        return ffi_call_frame(callee, desc, frame)
    }
    return ffi_call(callee, desc, frame, nfixed)
}

/// Serve an `@extern` the VM meets at a `call.import`, by resolving its symbol
/// and calling through a trampoline, or through its adapter.
///
/// A trampoline covers integer, `bool` and pointer-width parameters, `f64`,
/// `string`, any number of lent arrays of integer elements of any width the
/// target spells, and `@c_struct` mirrors lent by address, up to eight
/// arguments. What it does not (`adapter_reason`) goes through the adapter the
/// driver built, which `cc` compiled against the real prototype; without one,
/// the call traps naming the reason, because calling with a mis-marshalled
/// frame would corrupt the stack instead of failing. A callback traps either
/// way: the interpreter has no address for a Vader function.
///
/// The library is `BcImport.library` when the declaration names one, else the
/// running process — which covers libc and anything linked into the binary.
///
/// @param info         the import, for its `extern_name` and signature.
/// @param stack        the operand stack.
/// @param arg_base     index of the first argument.
/// @param at_pc        program counter, for trap messages.
/// @param types        the module type table, for a lent array's element width.
/// @param debug        the DAP controller when one is attached, else null.
/// @param adapter      the address of the import's adapter, `0` for none.
/// @return             the callee's result, or a `Trap` naming what stopped it.
dispatch_extern :: fn(info: bc.BcImport, stack: Value[], arg_base: i64, at_pc: i32, types: bc.BcType[], debug: DebugController | null, adapter: i64) -> HostCallResult {
    // A foreign call at comptime is allowed — SPEC §14 *Sandbox*. What the compiler
    // owes ITSELF is checked by `bootstrap/verify.sh` (stage1 == stage2), not
    // here.
    params :: info.signature.params
    if adapter == 0 {
        reason :: adapter_reason(info, types)
        if reason != null {
            return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: ${reason}; ${BUILD_NATIVELY}" }
        }
    }
    // Under the DAP debugger, program output must NOT reach fd 1/2 directly —
    // in stdio transport that would corrupt the protocol stream. This is the
    // routing the `IoWrite` arm carried before `write` became ordinary Vader;
    // it has to live here now, because the VM no longer sees `write` at all,
    // only the `sys_write` beneath it.
    if debug != null && is_std_handle_symbol(info.extern_name) {
        which :: read_i64(stack[arg_base], at_pc, "GetStdHandle which")
        if which is Trap { return which }
        return HostOk { .value = I64Val(debug_std_descriptor(i64(which))) }
    }
    if debug != null && is_write_symbol(info.extern_name) {
        return debug_write(info, stack, arg_base, at_pc, debug)
    }
    callee :: callee_of(info, adapter, at_pc)
    if callee is Trap {
        return callee
    }

    // The call is described by DATA, not by its shape: one class per slot, then
    // a flat frame of eight-byte slots followed by whatever an ADDR slot points
    // into. `vader_ffi.h` owns the classes and the dispatch.
    desc: u8[]: [u8(FFI_VOID)]
    slot_words: i64[]: []
    addr_slots: i64[]: []
    data: u8[]: []
    borrowed: LentArray[]: []
    lent_structs: LentStruct[]: []
    for i in 0..<params.len() {
        v :: stack[arg_base + i]
        // Unreachable in practice — `exec` traps on `fn.addr` before the value
        // could reach here — but a `.virt` read from elsewhere need not have
        // come through that path. See `core/bytecode/op::FnAddr`.
        if v is FnVal {
            return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: argument ${i} is a callback, and the interpreter has no address for a Vader function" }
        }
        // Checked BEFORE the `@c_pointer` branch: a `@c_struct` parameter
        // carries that decorator too, and that branch reads a SCALAR. The shim
        // declares a real C struct and marshals by field name; nothing here can
        // build one at run time.
        if v is StructVal {
            fields :: mirrored_struct_fields(types, info.signature.param_types, i)
            if fields == null {
                return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: argument ${i} is a struct the type table does not describe" }
            }
            layout :: bc.c_struct_layout(fields, types)
            // Every offset from that field on is arithmetic the C compiler never
            // agreed to. A mirror field must be a C scalar; nothing in the
            // language can widen that, which is why the message states the shape
            // rather than offering a remedy.
            if layout.unknown_field != null {
                return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: argument ${i} mirrors a C struct whose field `${layout.unknown_field}` is not a C scalar and cannot be laid out" }
            }
            // The block is what the native shim's `struct stat p1;` is: storage
            // the callee writes through. Zero-filled, because padding the mirror
            // does not describe still travels.
            at :: data.len()
            // Rounded up to a floor, deliberately. The block's size is COMPUTED
            // from the declared fields, and only `cc` can confirm it matches the
            // real type — which it does, through the `_Static_assert` the native
            // build emits. A mirror that left a field out therefore fails to
            // compile, but nothing stops `vader run` on its own, and the callee
            // would then write past a block sized for a partial mirror. The
            // floor turns that into wrong values instead of a buffer overrun.
            floor :: bc.MIRROR_BLOCK_FLOOR
            room :: if layout.size > floor { layout.size } else { floor }
            for _pad in 0..<room {
                data.push(0)
            }
            filled :: serialise_mirror(data, at, v, fields, types, at_pc, info.extern_name, 0)
            if filled is Trap { return filled }
            desc.push(u8(FFI_ADDR))
            addr_slots.push(slot_words.len())
            slot_words.push(at)
            if bc.param_is_c_out(info.signature, i) {
                lent_structs.push(LentStruct { .target = v, .at = at, .fields = fields })
            }
            continue
        }
        if bc.param_is_by_address(info.signature, i) {
            // `@c_pointer`: the callee takes the ADDRESS of a scalar. Spill it
            // into the frame's data area and hand over that offset — the mirror
            // of the stack temporary the native shim spills to.
            w :: extern_word(v, at_pc, info.extern_name, i)
            if w is Trap { return w }
            width :: i64(bc.size_of_val_type(params[i]))
            if width == 0 || width > 8 {
                return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: `@c_pointer` on a ${bc.val_type_name(params[i])} parameter is not covered" }
            }
            desc.push(u8(FFI_ADDR))
            addr_slots.push(slot_words.len())
            slot_words.push(data.len())
            push_little_endian(data, i64(w), width)
        } else if v is ArrayVal {
            elem :: lent_element_val_type(types, v.type_id)
            if elem == null {
                return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: argument ${i} is an array whose element type the VM cannot lend (only integer elements are covered)" }
            }
            width :: i64(bc.size_of_val_type(elem))
            desc.push(u8(FFI_ADDR))
            addr_slots.push(slot_words.len())
            slot_words.push(data.len())
            raw :: v.raw
            if raw != null {
                // A string's own bytes, read-only as the native view is: lent as
                // they are, and nothing travels back.
                data.push_all(raw.bytes()[v.offset..<v.offset + v.length])
            } else {
                borrowed.push(LentArray { .target = v, .at = data.len(), .element = elem })
                for j in 0..<v.length {
                    cell :: v.elements[v.offset + j]
                    b :: if cell is I64Val { i64(cell) } else if cell is I32Val { i64(cell) } else {
                        failed :: read_i64(cell, at_pc, "extern `${info.extern_name}` element")
                        if failed is Trap { return failed }
                        i64(failed)
                    }
                    push_little_endian(data, b, width)
                }
            }
        } else if v is StringVal {
            // A `string` crosses as a NUL-terminated buffer in the frame's data
            // area — the same ADDR mechanism a lent array uses. The native shim
            // reaches the same place through `vader_string_to_cstr`.
            desc.push(u8(FFI_ADDR))
            addr_slots.push(slot_words.len())
            slot_words.push(data.len())
            data.push_all(string(v).bytes())
            data.push(0)
        } else if v is F64Val {
            desc.push(u8(FFI_F64))
            slot_words.push(i64(f64(v).to_bits()))
        } else if v is BoolVal {
            desc.push(u8(FFI_WORD))
            slot_words.push(if bool(v) { 1 } else { 0 })
        } else if v is NullVal {
            // `null` IS a pointer value — the null address — which is what the
            // native shim passes for a `CPointer | null`.
            desc.push(u8(FFI_WORD))
            slot_words.push(0)
        } else if v is CharVal {
            // Only an adapter takes one (`adapter_reason`), as the codepoint.
            desc.push(u8(FFI_WORD))
            slot_words.push(i64(u32(v)))
        } else {
            w :: extern_word(v, at_pc, info.extern_name, i)
            if w is Trap { return w }
            desc.push(u8(FFI_WORD))
            slot_words.push(i64(w))
        }
    }

    // A struct result comes back in a block of the frame, which the slot after
    // the arguments addresses (`runtime/c/vader_adapter.h`). Only an adapter
    // returns one.
    result_type :: bc.bc_single_result_type(info.signature)
    result_mirror :: bc.mirror_at(types, result_type)
    result_at :: data.len()
    if result_mirror != null {
        layout :: bc.c_struct_layout(result_mirror.fields, types)
        if layout.unknown_field != null {
            return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: its result mirrors a C struct whose field `${layout.unknown_field}` is not a C scalar and cannot be laid out" }
        }
        for _pad in 0..<layout.size {
            data.push(0)
        }
        desc.push(u8(FFI_ADDR))
        addr_slots.push(slot_words.len())
        slot_words.push(result_at)
    }

    // Bound once: an `@extern` returns one value or none, and re-asking costs a
    // call with two length tests where reading a field used to be free.
    result :: bc.bc_single_result(info.signature)
    desc[0] = if ffi_result_is_opt(types, result_type, .String) {
        u8(FFI_STR_OPT)
    } else {
        u8(ffi_result_class(result))
    }

    // An ADDR slot carries an offset into the WHOLE frame, so it only becomes
    // final once the slot area's width is known.
    base :: slot_words.len() * 8
    for si in addr_slots {
        slot_words[si] = slot_words[si] + base
    }
    frame: u8[]: []
    for w in slot_words {
        push_little_endian(frame, w, 8)
    }
    frame.push_all(data)
    // The frame carries the RESULT back as well as the arguments out, so a
    // value-returning call needs a slot even with no arguments. Without one the
    // frame is empty, `vader_array_bytes` reports a NULL pointer, and the
    // runtime's `fview.len < nargs * 8` guard reads `0 < 0` — so `getpid()`
    // wrote its result to address 0 and the interpreter took SIGSEGV.
    if frame.len() == 0 && result != .Void {
        push_little_endian(frame, 0, 8)
    }

    returned :: call_foreign(i64(callee), adapter != 0, desc, frame, i64(info.c_variadic_fixed))

    // What C wrote into a lent array has to travel back: the frame is a FLAT
    // COPY of the boxed elements, so without this a mutable lend —
    // `read_file_bytes` filling its buffer — would silently read back what it
    // sent. The native path needs no equivalent: it lends the array's own
    // storage, so the write lands in place.
    for b in borrowed {
        width :: i64(bc.size_of_val_type(b.element))
        // Only an integer class reaches `LentArray`, so unsigned is the whole
        // question — `lent_element_val_type` filtered the rest out.
        signed :: !bc.is_unsigned_val(b.element)
        for j in 0..<b.target.length {
            slot :: b.target.offset + j
            written :: read_little_endian(frame, base + b.at + j * width, width, signed)
            b.target.elements[slot] = retyped_int(b.target.elements[slot], written)
        }
    }
    // Same reason as the arrays above: the block is a copy, so a callee that
    // filled it has written somewhere the Vader struct cannot see.
    for ls in lent_structs {
        read_back_mirror(frame, base + ls.at, ls.target, ls.fields, types, 0)
    }
    if result_mirror != null {
        return HostOk { .value = mirror_value(frame, base + result_at, result_type, result_mirror, types) }
    }
    if result == .Void {
        return HostOk { .value = zero_value() }
    }
    // An `f32` result too: its adapter writes it back as a `double`.
    if result == .F64 || result == .F32 {
        return HostOk { .value = F64Val(u64(read_little_endian(frame, 0, 8, false)).from_bits()) }
    }
    // A `string` result comes back as the call's RETURN value, not through the
    // frame: it is an atom, and only C can turn the callee's pointer into one.
    if desc[0] == u8(FFI_STR_OPT) {
        if read_little_endian(frame, 0, 8, false) == 0 {
            return HostOk { .value = NullVal {} }
        }
        return HostOk { .value = StringVal(returned) }
    }
    if result == .String {
        return HostOk { .value = StringVal(returned) }
    }
    // `<pointer> | null`: NULL is C's "absent", and nothing downstream can tell
    // a null pointer from a pointer whose value is 0.
    if ffi_result_is_opt(types, result_type, .Pointer)
        && read_little_endian(frame, 0, 8, false) == 0 {
        return HostOk { .value = NullVal {} }
    }
    return extern_result(result, read_little_endian(frame, 0, 8, true))
}

/// Argument / result classes for `ffi_call` — mirrors `VADER_FFI_*` in
/// `runtime/c/vader_ffi.h`. The two must agree.
FFI_VOID :: 0
FFI_WORD :: 1
FFI_F64  :: 2
FFI_ADDR :: 3
FFI_STR  :: 4
FFI_STR_OPT :: 5

/// The class a result `ValType` is read back as.
///
/// @param result  the import's declared result.
/// @return        `FFI_VOID`, `FFI_F64`, or `FFI_WORD`.
ffi_result_class :: fn(result: bc.ValType) -> i32 {
    if result == .Void {
        return FFI_VOID
    }
    // Only an adapter returns an `f32`, as a `double` (`adapter_reason`).
    if result == .F64 || result == .F32 {
        return FFI_F64
    }
    if result == .String {
        return FFI_STR
    }
    return FFI_WORD
}

/// Whether the result slot is `want | null`, a two-variant union whose other
/// half is exactly `want`.
///
/// C says "absent" by returning NULL, and only the DECLARED type says whether a
/// zero word means that. The native path never has to ask: its shim reads the
/// sentinel (`r == NULL ? vader_box_null() : ...`). The VM calls the symbol
/// through `dlsym`, so it owns that reading — without it a failed `fopen` came
/// back as a pointer valued 0, `f == null` was false, and the next `fread`
/// dereferenced it.
///
/// Only `string` and `pointer` are asked for: for `i32 | null` a returned 0 is
/// a legitimate value, and collapsing it to `null` would corrupt the result.
///
/// @param types        the module type table.
/// @param result_type  the result slot's BcType index.
/// @param want         the non-`null` variant to match.
/// @return             whether the slot is exactly `want | null`.
ffi_result_is_opt :: fn(types: bc.BcType[], result_type: i32, want: bc.ValType) -> bool {
    if result_type < 0 || i64(result_type) >= types.len() {
        return false
    }
    u :: types[result_type]
    if u !is bc.BcUnion {
        return false
    }
    if u.variants.len() != 2 {
        return false
    }
    has_null := false
    has_want := false
    for vi in u.variants {
        if vi < 0 || i64(vi) >= types.len() {
            continue
        }
        v :: types[vi]
        if v is bc.BcScalar {
            if v.val == .Null { has_null = true }
            if v.val == want            { has_want = true }
        }
    }
    return has_null && has_want
}

/// One array lent to a foreign call, and where its bytes sit in the flat buffer
/// — everything the write-back needs once the callee has returned.

/// A `@c_struct` argument the callee writes through, to read back after the call.
LentStruct :: struct {
    target: StructVal
    /// Offset of the block inside the frame's data area.
    at:     i64
    fields: bc.BcField[]
}

/// The mirrored struct's fields for parameter `i`, or `null` when the type table
/// says nothing about it.
///
/// `param_types` is absent from a `.virt` re-read, which is why this returns an
/// option rather than trapping on an index.
mirrored_struct_fields :: fn(types: bc.BcType[], param_types: i32[], i: i64) -> bc.BcField[] | null {
    if i >= param_types.len() {
        return null
    }
    mirror :: bc.mirror_at(types, param_types[i]) ?? return null
    return mirror.fields
}

/// A mirrored field's own value class, for the sign of the read-back.
field_val_type :: fn(types: bc.BcType[], f: bc.BcField) -> bc.ValType =
    bc.c_field_val_type(f, types) ?? .I64

/// Read a mirrored struct back out of the frame block, descending into a nested
/// mirror. The mirror image of `serialise_mirror`, and it must stay one: a field
/// written at an offset has to be read from the same one.
///
/// @param frame   the frame the callee wrote into.
/// @param base    where this struct starts in it.
/// @param target  the Vader value to write back into.
/// @param fields  the mirror's fields at this level.
/// @param depth   guards a malformed self-referential mirror.
read_back_mirror :: fn(
    frame: u8[], base: i64, target: StructVal, fields: bc.BcField[],
    types: bc.BcType[], depth: i32,
) -> void {
    if depth >= bc.NEST_CAP {
        return
    }
    layout :: bc.c_struct_layout(fields, types)
    for j in 0..<fields.len() {
        nested :: bc.nested_mirror(fields[j], types)
        if nested != null {
            inner :: target.fields[j]
            if inner is StructVal {
                read_back_mirror(
                    frame, base + layout.offsets[j], inner, nested.fields,
                    types, depth + 1,
                )
            }
            continue
        }
        width :: bc.c_field_width(fields[j], types) ?? continue
        if target.fields[j] is F64Val {
            target.fields[j] = F64Val(read_float(frame, base + layout.offsets[j], width))
            continue
        }
        val :: field_val_type(types, fields[j])
        written :: read_little_endian(frame, base + layout.offsets[j], width, !bc.is_unsigned_val(val))
        target.fields[j] = mirror_field_value(val, written)
    }
}

// What a mirror field of class `val` holds once C wrote `raw` into it, in the
// carrier the interpreter keeps for that class (`extern_result` picks the same
// for a result): the declared class decides, not the value the field held.
mirror_field_value :: fn(val: bc.ValType, raw: i64) -> Value = match val {
    .Bool                                  -> BoolVal(raw != 0)
    .Char                                  -> CharVal(char(u32(raw & 0xFFFF_FFFF)))
    .I8 | .I16 | .I32 | .U8 | .U16 | .U32  -> I32Val(i32(raw))
    .I64 | .U64 | .Pointer                 -> I64Val(raw)
    // A float field is read by `read_float`; the rest is no mirror field
    // (`front/typecheck/decl::validate_mirror_fields`).
    .F32 | .F64 | .String | .Null | .Void | .Ref | .Any -> I64Val(raw)
}

// A fresh value of the mirror `mirror`, of type `type_index`, read from the
// block at `base`: what C returned by value.
mirror_value :: fn(frame: u8[], base: i64, type_index: i32, mirror: bc.BcStruct, types: bc.BcType[]) -> StructVal {
    value :: zeroed_mirror(type_index, mirror, types, 0)
    read_back_mirror(frame, base, value, mirror.fields, types, 0)
    return value
}

// A value of the mirror `mirror`, of type `type_index`, whose fields are all
// zero, nested mirrors included.
zeroed_mirror :: fn(type_index: i32, mirror: bc.BcStruct, types: bc.BcType[], depth: i32) -> StructVal {
    fields: Value[]: []
    for f in mirror.fields {
        nested :: bc.nested_mirror(f, types)
        if nested != null && depth < bc.NEST_CAP {
            fields.push(zeroed_mirror(f.type_index, nested, types, depth + 1))
        } else {
            fields.push(global_zero(field_valtype(types, f.type_index)))
        }
    }
    return StructVal { .type_id = type_index, .fields = fields }
}

// The C float of `width` bytes at `at` in `buf`.
read_float :: fn(buf: u8[], at: i64, width: i64) -> f64 {
    bits :: bc.read_le(buf, at, width)
    if width == 4 {
        return f64(u32(bits).from_bits())
    }
    return bits.from_bits()
}

// Write `value` into `buf` at `at` as the C float of `width` bytes.
write_float :: fn(buf: u8[], at: i64, value: f64, width: i64) -> void =
    bc.write_le(buf, at, width, float_bits(value, width))

// The bits of `value` as a C float of `width` bytes.
float_bits :: fn(value: f64, width: i64) -> u64 {
    if width == 4 {
        return u64(f32(value).to_bits())
    }
    return value.to_bits()
}

/// Write a mirrored struct into the frame block at `base`, descending into a
/// nested mirror.
///
/// The C side holds a nested struct INLINE, so its members sit at offsets inside
/// the same block; Vader holds it by pointer, so the recursion follows the
/// `StructVal` and keeps writing into the SAME block at the nested offsets.
///
/// @param data    the frame's data area, appended to before this runs.
/// @param base    where this struct starts in `data`.
/// @param sv      the Vader value to read from.
/// @param fields  the mirror's fields at this level.
/// @param depth   guards a malformed self-referential mirror.
/// @return        `null` on success, a `Trap` naming the field otherwise.
serialise_mirror :: fn(
    data: u8[], base: i64, sv: StructVal, fields: bc.BcField[], types: bc.BcType[],
    at_pc: i32, extern_name: string, depth: i32,
) -> Trap | null {
    if depth >= bc.NEST_CAP {
        return Trap { .message = "extern `${extern_name}` at pc=${at_pc}: mirror nests deeper than ${bc.NEST_CAP}" }
    }
    layout :: bc.c_struct_layout(fields, types)
    for j in 0..<fields.len() {
        nested :: bc.nested_mirror(fields[j], types)
        if nested != null {
            inner :: sv.fields[j]
            if inner !is StructVal {
                return Trap { .message = "extern `${extern_name}` at pc=${at_pc}: field `${fields[j].name}` mirrors a nested C struct but holds no value" }
            }
            t :: serialise_mirror(
                data, base + layout.offsets[j], inner, nested.fields, types,
                at_pc, extern_name, depth + 1,
            )
            if t is Trap { return t }
            continue
        }
        width :: bc.c_field_width(fields[j], types) ?? continue
        field :: sv.fields[j]
        if field is F64Val {
            write_float(data, base + layout.offsets[j], f64(field), width)
            continue
        }
        cell :: if field is I64Val || field is I32Val || field is BoolVal || field is CharVal {
            read_scalar_word(field, at_pc, "")
        } else {
            read_scalar_word(field, at_pc, "extern `${extern_name}` field `${fields[j].name}`")
        }
        if cell is Trap { return cell }
        write_little_endian(data, base + layout.offsets[j], i64(cell), width)
    }
    return null
}

/// Write `value` into `buf` at `at`, little-endian, over `width` bytes.
write_little_endian :: fn(buf: u8[], at: i64, value: i64, width: i64) -> void {
    v :: u64(value)
    for k in 0..<width {
        buf[at + k] = u8((v >> u64(k * 8)) & 0xFF)
    }
}

LentArray :: struct {
    target: ArrayVal
    at:     i64
    /// What the array holds — the stride of the spill and the read-back, and
    /// whether the read-back sign-extends.
    element: bc.ValType
}

/// The `ValType` of the elements an array value holds, or `null` when they are
/// not integers the lend can spill.
///
/// Read off the VALUE's `type_id`, not the import's signature: a `.virt` reload
/// carries no `BcType` indices for a signature (`virt_reader_bc` reconstructs
/// them as `0` for every ref slot), so a signature-derived width would be right
/// from source and wrong through the round-trip — the two paths must agree.
///
/// @param types          the module type table.
/// @param array_type_id  the `ArrayVal`'s own type index.
/// @return               the element's value class, or `null` when not lendable.
lent_element_val_type :: fn(types: bc.BcType[], array_type_id: i32) -> bc.ValType | null {
    if array_type_id < 0 || i64(array_type_id) >= types.len() {
        return null
    }
    t :: types[array_type_id]
    if t !is bc.BcArray {
        return null
    }
    if t.element < 0 || i64(t.element) >= types.len() {
        return null
    }
    element :: types[t.element]
    if element !is bc.BcScalar {
        return null
    }
    if !bc.is_integer_val(element.val) {
        return null
    }
    return element.val
}

/// Read `width` bytes of `buf` at `at` back as an integer.
///
/// The mirror of `push_little_endian` — same machine on both sides, so this is
/// a spill format and not a wire one.
///
/// @param buf     the flat lend buffer.
/// @param at      the element's first byte.
/// @param width   how many bytes it occupies.
/// @param signed  whether to sign-extend a narrow value.
/// @return        the integer C left there.
read_little_endian :: fn(buf: u8[], at: i64, width: i64, signed: bool) -> i64 {
    value: i64 = 0
    for k in 0..<width {
        value = value | (i64(buf[at + k]) << i64(k * 8))
    }
    if signed && width < 8 {
        sign_bit :: i64(1) << i64(width * 8 - 1)
        if (value & sign_bit) != 0 {
            value = value - (sign_bit << 1)
        }
    }
    return value
}


/// Append the low `width` bytes of `value` to `buf`, least significant first.
///
/// Little-endian unconditionally: every target we emit for is little-endian, and
/// the bytes are read back by the C callee on the SAME machine — this is a
/// spill, not a wire format.
///
/// @param buf    the flat lend buffer, appended to.
/// @param value  the scalar to spill.
/// @param width  how many bytes the foreign parameter occupies.
push_little_endian :: fn(buf: u8[], value: i64, width: i64) -> void {
    for k in 0..<width {
        buf.push(u8((value >> i64(k * 8)) & 0xFF))
    }
}

/// Rebuild `old`'s variant around a new integer, so a write-back preserves the
/// element class the array was built with.
///
/// @param old  the element being overwritten.
/// @param n    the byte C wrote.
/// @return     `n` wearing `old`'s variant.
retyped_int :: fn(old: Value, n: i64) -> Value {
    if old is I64Val {
        return I64Val(n)
    }
    // A mirror field may be `bool` or `char` — `front/typecheck/decl::validate_mirror_fields`
    // admits both. Handing back an `I32Val` would silently retype the field, so
    // it stops answering `is bool` after the call even though the byte is right.
    if old is BoolVal {
        return BoolVal(n != 0)
    }
    if old is CharVal {
        return CharVal(char(u32(n & 0xFFFF_FFFF)))
    }
    return I32Val(i32(n))
}

/// Read a mirror field as the machine word the block stores.
///
/// Wider than `read_i64` on purpose: a `bool` and a `char` are admitted mirror
/// field types (`front/typecheck/decl::validate_mirror_fields`) and the native shim
/// copies them with a plain C assignment, so the interpreter has to serialise
/// them too rather than trapping on a shape the front end allowed.
///
/// @param v      the field's value.
/// @param at_pc  program counter, for the trap message.
/// @param label  names the field in that message.
read_scalar_word :: fn(v: Value, at_pc: i32, label: string) -> I64Val | Trap {
    if v is BoolVal {
        return I64Val(if bool(v) { 1 } else { 0 })
    }
    if v is CharVal {
        return I64Val(i64(u32(v)))
    }
    return read_i64(v, at_pc, label)
}

/// Wrap a foreign call's raw machine result as the `Value` its declared return
/// type calls for.
///
/// @param result  the import's declared result class.
/// @param raw     the trampoline's `i64`.
/// @return        the wrapped value.
extern_result :: fn(result: bc.ValType, raw: i64) -> HostCallResult {
    // A `string` result is a `const char*` the callee owns; turning it into a
    // Vader string means measuring and interning it, which nothing here does.
    // Reporting the raw address as an integer would hand the caller a bogus
    // atom id, so refuse instead.
    if result == .String {
        return Trap { .message = "extern: a `string` result is not covered on the VM" }
    }
    if result == .Void {
        return HostOk { .value = zero_value() }
    }
    if result == .Bool {
        // The LOW 32 bits only. A Win32 `BOOL` is an `int`, and the x64 ABI
        // defines EAX alone on return — whatever the callee left in the upper
        // half of RAX is not part of the value. Testing all 64 turns a `FALSE`
        // from `FindNextFileW` into `true`, and the caller is a `for {}` that
        // only that result breaks: an infinite loop, not a one-off wrong branch.
        return HostOk { .value = BoolVal(i32(raw & 0xFFFF_FFFF) != 0) }
    }
    // A narrow integer keeps the carrier the VM uses for its width : `i32` and
    // below ride `I32Val`, everything wider rides `I64Val`.
    if result == .I32 || result == .U32
        || result == .I16 || result == .U16
        || result == .I8 || result == .U8
        || result == .Char {
        return HostOk { .value = I32Val(i32(raw)) }
    }
    return HostOk { .value = I64Val(raw) }
}

// A timer already due carries nothing: the program re-drives every task after a
// park, so each of them sees the clock it waited for. `state[0]` is the clock.
drop_due_timers :: fn(state: i64[]) -> void {
    i: i64 = 1
    for i < state.len() {
        if state[i] <= state[0] {
            state[i] = state[state.len() - 1]
            state.remove_last()
        } else {
            i += 1
        }
    }
}

// The C symbols of the profiler's brackets (`vader/support/profile`). The VM has
// no profiler, so they do nothing.
is_profiler_bracket :: fn(symbol: string) = symbol == "vader_prof_begin"
    || symbol == "vader_prof_end"
    || symbol == "vader_prof_dump"

// ---- comptime impurity gate -----------------------------------------------

// Stable marker embedded in the Trap message the comptime impurity gate
// produces. `pipeline/comptime_vm/resolve.vader` matches it (via
// `is_impure_comptime_trap_message`) to route the error to C4016 instead of the
// generic C4002 panic — the two modules share this one string so they can't
// drift.
IMPURE_COMPTIME_MARKER :: "is impure and cannot run at comptime"

// Build the Trap for a host reached during `@comptime` evaluation that answers
// for the machine the COMPILER is running on.
impure_comptime_trap :: fn(mangled: string) -> HostCallResult =
    Trap { .message = "host `${mangled}` ${IMPURE_COMPTIME_MARKER} — it answers for the machine the compiler runs on, so baking it would make the same source emit differently per builder" }

/// Report whether a Trap message came from the comptime impurity gate.
/// Used by `pipeline/comptime_vm/resolve.vader` to pick C4016 over C4002.
/// @param message  the `Trap.message` surfaced by a comptime VM run.
/// @return         true when the trap is an impure-host-at-comptime refusal.
export is_impure_comptime_trap_message :: fn(message: string) -> bool =
    IMPURE_COMPTIME_MARKER in message

// Which hosts a `@comptime` block may NOT reach.
//
// The question is NOT purity. Reading the clock or the environment at build time
// bakes a non-reproducible value, and that is the program author's call — a
// build stamp is an ordinary thing to want. Most of what this list used to hold
// left it when `std/io`, `std/time`, `std/env`, `std/tty` and `std/process`
// became Vader over `@extern`, and `dispatch_extern` returns before this gate,
// so none of them is refused any more. That is the intent, not an oversight.
//
// What stays refused answers for THE MACHINE THE COMPILER IS RUNNING ON. Baking
// one of those does not make a program non-reproducible — it makes the same
// SOURCE emit differently depending on who built it, which is a different thing
// and is not the author's call to make.
//
// This compiler's own byte-identical bootstrap is checked by
// `bootstrap/verify.sh`, comparing stage1 to stage2. That is the guarantee; this
// list is not it.
//
// Exhaustive over `IntrinsicId` so a newly added host must be classified here
// (T3013) rather than silently defaulting to servable.
is_impure_host :: fn(id: bc.IntrinsicId) -> bool = match id {
    // The DYNAMIC ffi — resolving a symbol by name out of a library chosen at
    // build time. Refused because what it reaches depends on the builder's
    // machine, the same reason as `current_os` below. A DECLARED `@extern` is
    // not refused and never reached this gate: it is checked against a real
    // prototype and names what it calls.
    .FfiOpen | .FfiOpenPath | .FfiSymbol | .FfiCall | .FfiCallFrame -> true
    // `current_os` answers for the machine the COMPILER is running on, so baking
    // it would make the output depend on who built it: a macOS emit and a Linux
    // emit of the same source would differ. That is exactly what `seed.sh check`
    // compares byte-for-byte, so letting this through would make the committed
    // seed unreproducible across platforms.
    .TargetCurrentOs | .TargetCurrentArch -> true
    // Raw mode mutates the terminal and reads keystrokes; the width is whatever
    // the window happens to be. Nothing here bakes reproducibly.
    // Scheduler : reads/advances the async clock — not reproducible at comptime
    // (you cannot `sleep` while baking a constant).
    .SchedNow | .SchedArm | .SchedPark -> true
    // Pure : the baked value depends only on the args, never external state.
    .ByteLen | .ByteAt | .ByteSlice | .IsAscii -> false
    .Bytes | .BytesToString | .StringHash | .StringEquals -> false
    .PrimIntEquals | .PrimDisplayToString -> false
    .RuntimeCollect | .RuntimeCollections | .RuntimeBytesUsed | .RuntimeBytesCopied -> false
    .AbortPanic -> false
    .NotIntrinsic -> false
}
