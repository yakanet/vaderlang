// vader/vm/host — host-import surface for the Vader-side VM.
//
// Every `call.import N` runs through `dispatch_import` here ; per-host
// arms unwrap the args from the caller stack, invoke the corresponding
// native stdlib intrinsic, and wrap the result back into an `Value`.
// The shape is a flat mangled-name cascade with trap-on-miss
// semantics. Lives in its own file (split out of
// `vader/vm/exec.vader` 2026-05-14) so the executor stays focused on
// the dispatch loop.

module "vader/vm"

bc :: import "vader/bytecode"

import "std/io"
import "std/env"
import "std/tty"
import "std/process"
import "std/math"
import "std/time"
import "std/string"
import "std/target"

/// Outcome of a successful host call. `value` is unused when the import
/// has `has_return == false` — the exec checks the import's signature
/// before pushing.
export HostCallResult :: HostOk | Trap
export HostOk :: struct { value: Value }

/// The `(fn_ptr, args, nargs)` triple the three `ffi_call_*` arms share.
/// `args` is materialised as a real Vader `i64[]` because the intrinsic takes
/// one — a VM `ArrayVal` holds boxed `Value`s, not contiguous words.
FfiCallArgs :: struct {
    fn_ptr: usize
    args:   i64[]
    nargs:  usize
}

/// Read and validate the three operands of an `ffi_call_*` host.
///
/// @param stack     the operand stack.
/// @param arg_base  index of the first argument.
/// @param at_pc     program counter, for the trap message.
/// @return          the triple, or a `Trap` naming the offending operand.
host_ffi_call_args :: fn(stack: Value[], arg_base: usize, at_pc: i32) -> FfiCallArgs | Trap {
    fn_ptr :: read_i64(stack[arg_base], at_pc, "ffi_call fn")
    if fn_ptr is Trap { return fn_ptr }
    arr :: read_array(stack[arg_base + 1], at_pc, "ffi_call args")
    if arr is Trap { return arr }
    n :: read_i64(stack[arg_base + 2], at_pc, "ffi_call nargs")
    if n is Trap { return n }
    if n.value < 0 || usize(n.value) > arr.length {
        return Trap { .message = "ffi_call at pc=${at_pc}: nargs ${n.value} exceeds the argument array" }
    }
    words: i64[]! = []
    for i in 0..<usize(n.value) {
        w :: read_i64(arr.elements[arr.offset + i], at_pc, "ffi_call arg ${i}")
        if w is Trap { return w }
        words.push(w.value)
    }
    return FfiCallArgs { .fn_ptr = usize(fn_ptr.value), .args = words, .nargs = usize(n.value) }
}

/// Pop two strings, run a binary predicate, wrap as `BoolVal`. Used
/// by `starts_with` / `ends_with` / `contains`.
host_str_pair_to_bool :: fn(stack: Value[], arg_base: usize, at_pc: i32, label: string, apply: fn(string, string) -> bool) -> HostCallResult {
    a :: read_string(stack[arg_base    ], at_pc, "${label} receiver")
    b :: read_string(stack[arg_base + 1], at_pc, "${label} arg")
    if a is Trap { return a }
    if b is Trap { return b }
    return HostOk { .value = BoolVal { .value = apply(a.value, b.value) } }
}

/// One f64 arg → one f64 result. Used by `std/math` unary intrinsics
/// (`sqrt` / `floor` / `ceil` / `round` / `abs`).
host_f64_unary :: fn(stack: Value[], arg_base: usize, at_pc: i32, label: string, apply: fn(f64) -> f64) -> HostCallResult {
    a :: read_f64(stack[arg_base], at_pc, label)
    if a is Trap { return a }
    return HostOk { .value = F64Val { .value = apply(a.value) } }
}

/// Two f64 args → one f64 result. Used by `std/math` binary intrinsics
/// (`pow` / `min` / `max`).
host_f64_binary :: fn(stack: Value[], arg_base: usize, at_pc: i32, label: string, apply: fn(f64, f64) -> f64) -> HostCallResult {
    a :: read_f64(stack[arg_base    ], at_pc, "${label} arg 0")
    b :: read_f64(stack[arg_base + 1], at_pc, "${label} arg 1")
    if a is Trap { return a }
    if b is Trap { return b }
    return HostOk { .value = F64Val { .value = apply(a.value, b.value) } }
}

/// Two integer args → bool. Reads both via `read_i64` (widening `I32Val`), so
/// it covers every integer width ; equality on the i64 bit pattern is correct
/// for signed and unsigned alike.
host_int_pair_to_bool :: fn(stack: Value[], arg_base: usize, at_pc: i32, label: string, apply: fn(i64, i64) -> bool) -> HostCallResult {
    a :: read_i64(stack[arg_base    ], at_pc, "${label} receiver")
    b :: read_i64(stack[arg_base + 1], at_pc, "${label} arg")
    if a is Trap { return a }
    if b is Trap { return b }
    return HostOk { .value = BoolVal { .value = apply(a.value, b.value) } }
}

/// Build the host-side value for a failed io intrinsic : a real
/// `std/io$IOError` instance when its struct is in the type table (so
/// `is IOError` narrows and `Error.message` dispatches), the legacy
/// tag-only `ErrorVal` otherwise (io never imported — unreachable from
/// the io arms in practice, kept as a defensive fallback).
mk_io_error :: fn(msg: string, io_error_type_id: i32) -> Value {
    if io_error_type_id < 0 { return ErrorVal { .message = msg } }
    return StructVal {
        .type_id = io_error_type_id,
        .fields = [StringVal { .value = msg }],
    }
}

/// Dispatch a host import. Matches on `intrinsic_id_for(info.mangled_name)`
/// (the single manifest classification) — every arm pops the args from
/// `stack[arg_base ..]`, executes the host action, and returns either
/// `HostOk { value }` (the result pushed onto the caller's value stack) or a
/// `Trap` (surfaced verbatim). Hosts the VM doesn't serve (native-only C shims)
/// and non-intrinsics fall through the grouped arm to the unbound `Trap`.
///
/// @param info      the import descriptor (mangled name + signature).
/// @param stack     caller value stack — args live at `[arg_base ..]`.
/// @param arg_base  cursor of the first arg in `stack`.
/// @param gc_state  1-element box for the `std/runtime` collection
///                  counter — `collect` bumps `[0]`, `collections`
///                  reads it.
/// @param at_pc     pc of the calling `call.import` op, used for Trap
///                  diagnostics only.
/// @param string_array_type_id  the module's `string[]` ArrayType index
///                  (see `find_string_array_type_id`), stamped onto the
///                  arrays returned by `split` / `read_dir` so they narrow
///                  to `is string[]` in their `string[] | Error` union return.
/// @param u8_array_type_id  the module's `u8[]` ArrayType index (see
///                  `find_u8_array_type_id`), stamped onto the array `bytes`
///                  materialises so it narrows to `is u8[]`.
/// @param io_error_type_id  the `std/io$IOError` struct's type index (see
///                  `find_io_error_type_id`), stamped onto fabricated io
///                  error values by `mk_io_error` ; `-1` when io was never
///                  imported.
/// @param is_comptime  true when this dispatch runs inside a `@comptime`
///                  evaluation (`exec_fn_value` path). Gates the impure hosts
///                  (see `is_impure_host`) so a compile-time constant can never
///                  bake a non-reproducible value.
/// @return          `HostOk { value }` on success ; `Trap` on a missing
///                  import, malformed arg, host-level failure, or an impure host
///                  reached at comptime.
/// @error           traps with an `is_impure_comptime_trap_message` marker when
///                  `is_comptime` and the host is impure — `comptime_vm` routes
///                  it to `C4016` rather than the generic `C4002`.
export dispatch_import :: fn(info: bc.BcImport, stack: Value[], arg_base: usize, gc_state: usize[]!, sched_state: usize[]!, at_pc: i32, string_array_type_id: i32, u8_array_type_id: i32, io_error_type_id: i32, is_comptime: bool, debug: DebugController | null) -> HostCallResult {
    id :: bc.intrinsic_id_for(info.mangled_name)
    // Comptime gate : impure hosts (clock / env / filesystem / stdin / subprocess
    // / terminal) read or mutate state outside the program. Running one during a
    // `@comptime` evaluation would bake a non-reproducible result and silently
    // break the byte-identical bootstrap (stage1 == stage2 — see the CT2 audit
    // item). Refuse with a Trap the `comptime_vm` pass routes to C4016 ; the pure
    // hosts (string / math / core / primitive / GC counter, plus stdout `write`
    // for debug) keep running.
    if is_comptime && is_impure_host(id) {
        return impure_comptime_trap(info.mangled_name)
    }
    // ---- compiler-internal `@extern` hosts ---------------------------------
    //
    // `@extern` is EXEMPT from the emit-time wiring check (`midir/emit.vader` :
    // "@extern imports are link-resolved and exempt") — correct for user FFI,
    // which the C linker resolves, but it means an `@extern` the COMPILER ITSELF
    // uses is invisible to this dispatcher: the moment the compiler runs on its
    // own bytecode it traps as an unbound import. Serve the ones `vader/`
    // declares.
    //
    // Kept keyed on the mangled name rather than given `IntrinsicId`s : the
    // manifest is shared with `emit_c`, which already resolves these by linking,
    // so a new id there would force a redundant C-side arm. Raw strings — a bare
    // `$` in a literal opens an interpolation.
    //
    // Guarded by `tests/extern_vm_handlers.test.ts` : any new `@extern` under
    // `vader/` must gain a handler here or that test fails.
    if info.mangled_name == r"vader_profile$vader_prof_begin" { return HostOk { .value = zero_value() } }
    if info.mangled_name == r"vader_profile$vader_prof_end"   { return HostOk { .value = zero_value() } }
    if info.mangled_name == r"vader_profile$vader_prof_dump"  { return HostOk { .value = zero_value() } }
    match id {
    // ---- std/string family ----------------------------------------------
    .ByteLen -> {
        // Internal fold target — `s.bytes().len()` lowers to a std_core$byte_len
        // import. String-only (a `u8[]` uses `.len()` directly).
        s :: read_string(stack[arg_base], at_pc, "byte_len")
        if s is Trap { return s }
        return HostOk { .value = I32Val { .value = i32(s.value.bytes().len()) } }
    }
    .ByteAt -> {
        // Header-free byte read — the fold target for a non-escaping `s.bytes()[i]`.
        // Bounds-checked to match the native `vader_string_byte_at` / `s.bytes()[i]`.
        s :: read_string(stack[arg_base    ], at_pc, "byte_at receiver")
        i :: read_i32   (stack[arg_base + 1], at_pc, "byte_at index")
        if s is Trap { return s }
        if i is Trap { return i }
        bs  :: s.value.bytes()
        idx :: usize(i.value)
        if idx >= bs.len() {
            return Trap { .message = "byte index out of bounds" }
        }
        return HostOk { .value = I32Val { .value = i32(bs[idx]) } }
    }
    .BytesToString -> {
        // bytes→string : the VM gathers the boxed u8 slots into a real `u8[]` and
        // lets the native intern them verbatim (no UTF-8 validation). Native
        // O(1)-reinterprets a borrowed slice.
        arr :: read_array(stack[arg_base], at_pc, "bytes_to_string receiver")
        if arr is Trap { return arr }
        raw: u8[]! = []
        for i in 0..<arr.length {
            b :: read_i32(arr.elements[arr.offset + i], at_pc, "bytes_to_string byte")
            if b is Trap { return b }
            raw.push(u8(b.value))
        }
        return HostOk { .value = StringVal { .value = raw.bytes_to_string() } }
    }
    .Bytes -> {
        // Native zero-copies a read-only `u8[]` view ; the VM materialises a copy
        // (boxed slots can't alias the interned bytes) — same values.
        s :: read_string(stack[arg_base], at_pc, "bytes receiver")
        if s is Trap { return s }
        return HostOk { .value = bytes_to_value(s.value, u8_array_type_id) }
    }
    .StringHash -> {
        // String `Hash` reads the FNV-1a-64 cached on the interned atom. Calling
        // `.hash()` on the Vader string here lowers to the native
        // `vader_string_hash` intrinsic in the VM's own build, so the VM and
        // native produce identical hashes for the same atom. u64 rides in I64Val.
        s :: read_string(stack[arg_base], at_pc, "hash receiver")
        if s is Trap { return s }
        return HostOk { .value = I64Val { .value = i64(s.value.hash()) } }
    }
    // `StringBuilder implements Display` moved to pure Vader in Target ABI S3 ;
    // the resolver materialises its body (a byte-Buffer read + `bytes_to_string`),
    // so the VM runs a real fn — there is no host shim to dispatch here.
    .StringIndexAt -> {
        s :: read_string(stack[arg_base    ], at_pc, "string[] receiver")
        i :: read_i32   (stack[arg_base + 1], at_pc, "string[] index")
        if s is Trap { return s }
        if i is Trap { return i }
        // Walk UTF-8 until the `i`-th codepoint, then decode it. An out-of-range
        // (or negative, wrapping huge) index traps — aligning the VM on the
        // native runtime (`vader_string_codepoint_at`, runtime/c/vader_runtime.c),
        // which raises the same message. Previously the VM baked U+0000, so an
        // OOB `s[i]` at comptime silently produced a NUL codepoint.
        sb :: s.value.bytes()
        target :: usize(i.value)
        cursor: usize = 0
        seen:   usize = 0
        n :: sb.len()
        for cursor < n {
            [cp, width] :: sb.utf8_decode_len(cursor)
            if seen == target { return HostOk { .value = CharVal { .value = cp } } }
            cursor = cursor + width
            seen   = seen + 1
        }
        return Trap { .message = "string codepoint index out of bounds" }
    }
    // ---- std/core Display + Equals intrinsics ----------------------------
    // `string implements Hash` is now pure Vader (FNV-1a-64 over `bytes()`,
    // `std/core/primitives.vader`) — the host arm + the old 31-bit `fnv1a31_low`
    // were retired (S6) so a single hash function is live across VM + native.
    // `@intrinsic string implements Equals` — structural string compare.
    // Reached when map key lookups dispatch `key.equals(other)` virtually
    // (the virtual.call intrinsic fallback in exec.vader rebuilds this mangle).
    .StringEquals -> {
        return host_str_pair_to_bool(stack, arg_base, at_pc, "equals", (a, b) -> a == b)
    }
    .StringNotEquals -> {
        return host_str_pair_to_bool(stack, arg_base, at_pc, "not_equals", (a, b) -> a != b)
    }
    // `@intrinsic <intwidth> implements Equals` — bodyless for every integer
    // width, so an erased map-key lookup (`MutableMap<Any, K>` with integer K)
    // dispatches `key.equals(other)` virtually and surfaces it as a host import
    // (mirror of the string arms above). Reached e.g. by `MutableSet<i32>`.
    .PrimIntEquals -> {
        return host_int_pair_to_bool(stack, arg_base, at_pc, "equals", (a: i64, b: i64) -> a == b)
    }
    .PrimIntNotEquals -> {
        return host_int_pair_to_bool(stack, arg_base, at_pc, "not_equals", (a: i64, b: i64) -> a != b)
    }
    // `<width> implements Display.to_string` for every primitive — the
    // VM emits the SPEC §9 canonical form via `display_value`. Width
    // doesn't matter at runtime (every integer collapses to `I32Val`),
    // so a single arm covers all the per-width manglings.
    .PrimDisplayToString -> {
        // `u32` / `u64` / `usize` literals exceeding `i64.MAX` ride the
        // same `I64Val` carrier as signed `i64`. Default `display_value`
        // renders that bit pattern as signed i64 (e.g. `-9551616` instead
        // of `18446744073700000000`). The lower pass routes wide
        // unsigned interpolations through this dispatch — recover the
        // unsigned form by reinterpreting the bit pattern.
        if bc.is_unsigned_display(info.mangled_name) {
            v :: stack[arg_base]
            // @partial: integer carriers reinterpret as unsigned; other tags trap.
            return @partial match v {
                is I64Val as i -> HostOk { .value = StringVal { .value = u64(i.value).to_string() } }
                is I32Val as i -> HostOk { .value = StringVal { .value = u64(u32(i.value)).to_string() } }
                // Any other Value tag means the lowerer routed a non-
                // integer through `<u_width>$Display$to_string`. Trap
                // loudly so the regression surfaces here instead of as a
                // mysteriously wrong rendering.
                _ -> Trap { .message = "${info.mangled_name} at pc=${at_pc}: expected integer Value, got ${describe_value_tag(v)}" }
            }
        }
        return HostOk { .value = StringVal { .value = display_value(stack[arg_base]) } }
    }
    // ---- std/runtime collection counters ---------------------------------
    // The Vader VM has no GC arena ; the snippet tests just need the
    // counter to be present + monotonic. `collect` bumps it, `collections`
    // returns the current value, `bytes_used` / `bytes_copied` stay at
    // zero (no real arena to measure).
    .RuntimeCollect -> {
        gc_state[0] = gc_state[0] + 1
        return HostOk { .value = NullVal {} }
    }
    .RuntimeCollections -> { return HostOk { .value = I32Val { .value = i32(gc_state[0]) } } }
    .RuntimeBytesUsed   -> { return HostOk { .value = I32Val { .value = 0 } } }
    .RuntimeBytesCopied -> { return HostOk { .value = I32Val { .value = 0 } } }
    // ---- std/runtime — cooperative async scheduler ----------------------
    // VM-side mirror of the C scheduler : `sched_state[0]` = now, `[1..]` =
    // pending deadlines. The VM always jumps the virtual clock (an interpreter
    // never real-sleeps) ; output depends only on deadline ordering, so it
    // matches native.
    .SchedNow -> { return HostOk { .value = I64Val { .value = i64(sched_state[0]) } } }
    .SchedArm -> {
        d :: read_i64(stack[arg_base], at_pc, "sched_arm deadline")
        if d is Trap { return d }
        sched_state.push(usize(d.value))
        return HostOk { .value = NullVal {} }
    }
    .SchedPark -> {
        if sched_state.len() <= 1 { return HostOk { .value = I32Val { .value = 1 } } }  // deadlock
        min_i: usize = 1
        for i in 2..<sched_state.len() { if sched_state[i] < sched_state[min_i] { min_i = i } }
        deadline :: sched_state[min_i]
        sched_state[min_i] = sched_state[sched_state.len() - 1]   // swap-remove
        sched_state.remove_last()
        if deadline > sched_state[0] { sched_state[0] = deadline }
        return HostOk { .value = I32Val { .value = 0 } }
    }
    // ---- std/time --------------------------------------------------------
    // `now_unix_ms` / `monotonic_ns` are module-private in std/time now ; reach
    // the native clock through the public `now()` / `monotonic()` (this host is
    // native, so these are native calls — no VM re-dispatch, no recursion).
    // ---- std/math --------------------------------------------------------
    .MathSqrt  -> { return host_f64_unary(stack, arg_base, at_pc, "sqrt",  (a) -> sqrt(a)) }
    .MathSin   -> { return host_f64_unary(stack, arg_base, at_pc, "sin",   (a) -> sin(a)) }
    .MathCos   -> { return host_f64_unary(stack, arg_base, at_pc, "cos",   (a) -> cos(a)) }
    .MathTan   -> { return host_f64_unary(stack, arg_base, at_pc, "tan",   (a) -> tan(a)) }
    .MathFloor -> { return host_f64_unary(stack, arg_base, at_pc, "floor", (a) -> floor(a)) }
    .MathCeil  -> { return host_f64_unary(stack, arg_base, at_pc, "ceil",  (a) -> ceil(a)) }
    .MathRound -> { return host_f64_unary(stack, arg_base, at_pc, "round", (a) -> round(a)) }
    .MathPow   -> { return host_f64_binary(stack, arg_base, at_pc, "pow", (a, b) -> pow(a, b)) }
    // ---- std/io fallible file ops ---------------------------------------
    // `read_file` / `write_file` are gone — `read_file_string` /
    // `write_file_string` are now pure-Vader wrappers over the byte
    // intrinsics below, so the VM executes their bytecode directly (which
    // calls `std_io$read_file_bytes` / `std_io$write_file_bytes`) — no
    // dedicated host arm.
    .IoReadFileBytes -> {
        path :: read_string(stack[arg_base], at_pc, "read_file_bytes")
        if path is Trap { return path }
        result :: read_file_bytes(path.value)
        // Early-return narrows `result` to `u8[]` on the success path. The
        // bytes are boxed as `u8` slots (riding in `I32Val`) tagged so they
        // narrow under `is u8[]` — mirrors the `bytes` arm above.
        if result is IOError {
            return HostOk { .value = mk_io_error(result.msg, io_error_type_id) }
        }
        return HostOk { .value = u8_array_to_value(result, u8_array_type_id) }
    }
    .IoWriteFileBytes -> {
        path :: read_string(stack[arg_base], at_pc, "write_file_bytes path")
        if path is Trap { return path }
        arr :: read_array(stack[arg_base + 1], at_pc, "write_file_bytes content")
        if arr is Trap { return arr }
        content: u8[]! = [] * arr.length
        for i in 0..<arr.length {
            b :: read_i32(arr.elements[arr.offset + i], at_pc, "write_file_bytes byte")
            if b is Trap { return b }
            content.push(u8(b.value))
        }
        result :: write_file_bytes(path.value, content)
        if result is IOError { return HostOk { .value = mk_io_error(result.msg, io_error_type_id) } }
        return HostOk { .value = NullVal {} }
    }
    .IoExists -> {
        path :: read_string(stack[arg_base], at_pc, "exists")
        if path is Trap { return path }
        return HostOk { .value = BoolVal { .value = exists(path.value) } }
    }
    .IoIsDir -> {
        path :: read_string(stack[arg_base], at_pc, "is_dir")
        if path is Trap { return path }
        return HostOk { .value = BoolVal { .value = is_dir(path.value) } }
    }
    .IoTempDir -> {
        return HostOk { .value = StringVal { .value = temp_dir() } }
    }
    .IoCurrentExecutableLocation -> {
        // Reached when a compile runs in the self-host VM: the resolver's
        // `resolve_sidecar` (module.vader) queries the exe location on every
        // stdlib-root resolution. Returns the VM process's own location; a
        // wrong sidecar just fails the marker check and falls back to cwd.
        return HostOk { .value = StringVal { .value = current_executable_location() } }
    }
    .IoCreateDir -> {
        path :: read_string(stack[arg_base], at_pc, "create_dir")
        if path is Trap { return path }
        result :: create_dir(path.value)
        if result is IOError { return HostOk { .value = mk_io_error(result.msg, io_error_type_id) } }
        return HostOk { .value = NullVal {} }
    }
    .IoRemoveFile -> {
        path :: read_string(stack[arg_base], at_pc, "remove_file")
        if path is Trap { return path }
        result :: remove_file(path.value)
        if result is IOError { return HostOk { .value = mk_io_error(result.msg, io_error_type_id) } }
        return HostOk { .value = NullVal {} }
    }
    .IoCurrentWorkingDirectory -> {
        // Same reason as the arm above: a compile running in the self-host VM
        // must still be able to ask where it was invoked from.
        return HostOk { .value = StringVal { .value = current_working_directory() } }
    }
    .IoReadDir -> {
        path :: read_string(stack[arg_base], at_pc, "read_dir")
        if path is Trap { return path }
        // `read_dir` returns `string[] | Error`. The early-return
        // guard narrows `result` to the array on the success path. Needed by
        // the resolver's module discovery (vader/resolver/discover.vader) when
        // the compiler runs itself through the VM.
        result :: read_dir(path.value)
        if result is IOError {
            return HostOk { .value = mk_io_error(result.msg, io_error_type_id) }
        }
        return HostOk { .value = string_array_to_value(result, string_array_type_id) }
    }
    // ---- std/process spawn (non-blocking) -------------------------------
    .ProcessSpawnStart -> {
        argv :: read_array(stack[arg_base], at_pc, "spawn_start argv")
        if argv is Trap { return argv }
        argv_strings: string[]! = []
        for i in 0..<argv.length {
            element :: read_string(argv.elements[argv.offset + i], at_pc, "spawn_start argv element")
            if element is Trap { return element }
            argv_strings.push(element.value)
        }
        return HostOk { .value = I64Val { .value = spawn_start(argv_strings) } }
    }
    .ProcessSpawnKill -> {
        handle :: read_i64(stack[arg_base], at_pc, "spawn_kill handle")
        if handle is Trap { return handle }
        spawn_kill(handle.value)
        return HostOk { .value = zero_value() }
    }
    .ProcessSpawnPoll -> {
        h :: read_i64(stack[arg_base], at_pc, "spawn_poll handle")
        if h is Trap { return h }
        return HostOk { .value = I32Val { .value = spawn_poll(h.value) } }
    }
    .ProcessSpawnTakeStdout -> {
        h :: read_i64(stack[arg_base], at_pc, "spawn_take_stdout handle")
        if h is Trap { return h }
        return HostOk { .value = StringVal { .value = spawn_take_stdout(h.value) } }
    }
    .ProcessSpawnTakeStderr -> {
        h :: read_i64(stack[arg_base], at_pc, "spawn_take_stderr handle")
        if h is Trap { return h }
        return HostOk { .value = StringVal { .value = spawn_take_stderr(h.value) } }
    }
    // ---- std/tty + std/env ----------------------------------------------
    .TtyIsTty -> {
        tag :: read_i32(stack[arg_base], at_pc, "is_tty stream")
        if tag is Trap { return tag }
        stream :: if tag.value == 1 { Stream.Stderr } else { Stream.Stdout }
        return HostOk { .value = BoolVal { .value = is_tty(stream) } }
    }
    // Raw mode from the VM is the same call the native binary makes: the VM is
    // itself a native binary, so these are its own intrinsics. It matters because
    // `vader test` runs every @test on the VM — a prompt test that could not
    // reach the terminal here would be untestable.
    .TtyRawModeBegin -> { return HostOk { .value = BoolVal { .value = raw_mode_begin() } } }
    .TtyRawModeEnd -> {
        raw_mode_end()
        return HostOk { .value = zero_value() }
    }
    .TtyColumns -> { return HostOk { .value = I32Val { .value = columns() } } }
    .TtyReadKeys -> {
        max :: read_i32(stack[arg_base], at_pc, "read_keys max")
        if max is Trap { return max }
        return HostOk { .value = StringVal { .value = read_keys(max.value) } }
    }
    // Both re-enter the same host the compiled compiler binds to: an `Os` / `Arch`
    // ordinal rides in an i32 slot like any enum.
    // Dynamic foreign calls. A `@test` runs ON the VM, so these have to be
    // served here too — the arms forward to the same intrinsics the natively
    // compiled VM calls directly.
    .FfiOpen -> {
        name :: read_string(stack[arg_base], at_pc, "ffi_open name")
        if name is Trap { return name }
        return HostOk { .value = I64Val { .value = i64(ffi_open(name.value)) } }
    }
    .FfiSymbol -> {
        lib :: read_i64(stack[arg_base], at_pc, "ffi_symbol lib")
        if lib is Trap { return lib }
        sym :: read_string(stack[arg_base + 1], at_pc, "ffi_symbol name")
        if sym is Trap { return sym }
        return HostOk { .value = I64Val { .value = i64(ffi_symbol(usize(lib.value), sym.value)) } }
    }
    .FfiCallInt -> {
        call :: host_ffi_call_args(stack, arg_base, at_pc)
        if call is Trap { return call }
        return HostOk { .value = I64Val { .value = ffi_call_int(call.fn_ptr, call.args, call.nargs) } }
    }
    .FfiCallIntLend -> {
        call :: host_ffi_call_args(stack, arg_base, at_pc)
        if call is Trap { return call }
        slot_arr :: read_array(stack[arg_base + 3], at_pc, "ffi_call_int_lend slots")
        if slot_arr is Trap { return slot_arr }
        lent :: read_array(stack[arg_base + 4], at_pc, "ffi_call_int_lend bytes")
        if lent is Trap { return lent }
        slots: i64[]! = []
        for i in 0..<slot_arr.length {
            sl :: read_i64(slot_arr.elements[slot_arr.offset + i], at_pc, "ffi_call_int_lend slot")
            if sl is Trap { return sl }
            if sl.value < 0 {
                return Trap { .message = "ffi_call_int_lend at pc=${at_pc}: negative slot" }
            }
            slots.push(sl.value)
        }
        // A VM array holds boxed `Value`s, not contiguous words, so the bytes
        // are materialised into a real `u8[]`. The host then takes ITS address
        // immediately before the call — nothing runs in between, so nothing can
        // move it.
        bs: u8[]! = []
        for i in 0..<lent.length {
            b :: read_i64(lent.elements[lent.offset + i], at_pc, "ffi_call_int_lend byte")
            if b is Trap { return b }
            bs.push(u8(b.value))
        }
        raw :: ffi_call_int_lend(call.fn_ptr, call.args, call.nargs, slots, bs)
        // `bs` is a COPY — a VM array holds boxed values, so the flat buffer had
        // to be built. What the callee wrote lives in that copy and nowhere
        // else, so hand it back element by element. Without this the VM reads
        // back exactly what it sent, which is how a lend that cannot be read
        // back looks from Vader.
        for i in 0..<lent.length {
            at :: lent.offset + i
            lent.elements[at] = retyped_int(lent.elements[at], i64(bs[i]))
        }
        return HostOk { .value = I64Val { .value = raw } }
    }
    .FfiCallVoid -> {
        call :: host_ffi_call_args(stack, arg_base, at_pc)
        if call is Trap { return call }
        ffi_call_void(call.fn_ptr, call.args, call.nargs)
        return HostOk { .value = zero_value() }
    }
    .FfiCallF64 -> {
        call :: host_ffi_call_args(stack, arg_base, at_pc)
        if call is Trap { return call }
        return HostOk { .value = F64Val { .value = ffi_call_f64(call.fn_ptr, call.args, call.nargs) } }
    }
    .TargetCurrentOs -> {
        return HostOk { .value = I32Val { .value = i32(current_os()) } }
    }
    .TargetCurrentArch -> {
        return HostOk { .value = I32Val { .value = i32(current_arch()) } }
    }
    .EnvGetEnv -> {
        name :: read_string(stack[arg_base], at_pc, "get_env name")
        if name is Trap { return name }
        value :: get_env(name.value)
        if value == null { return HostOk { .value = NullVal {} } }
        return HostOk { .value = StringVal { .value = value } }
    }
    // ---- std/abort -------------------------------------------------------
    .AbortPanic -> {
        message :: read_string(stack[arg_base], at_pc, "panic")
        if message is Trap { return message }
        return Trap { .message = "vader: panic — ${message.value}" }
    }
    // Hosts served natively (C shims) but not by the VM, plus non-intrinsics —
    // grouped so a new IntrinsicId variant still trips T3013 here.
    .IoReadLine | .IoReadStdin | .IoPollStdin | .IoSetStdinUnbuffered | .NotIntrinsic -> {}
    }
    // A user `@extern` reaches no arm above — it names a linker symbol, not a
    // known host. Resolve and call it dynamically rather than giving up.
    if info.is_extern {
        return dispatch_extern(info, stack, arg_base, at_pc, is_comptime, debug)
    }
    return Trap { .message = "unbound host import '${info.mangled_name}' at pc=${at_pc}" }
}

/// Whether `symbol` is the raw write syscall behind `std/io` — `write(2)` on POSIX,
/// which the Windows CRT also exports (as an alias of `_write`).
///
/// Two call sites need to recognise it: the comptime gate, which exempts
/// program output, and the DAP routing below.
///
/// @param symbol  the import's foreign symbol name.
/// @return        whether it is the write syscall.
is_write_symbol :: fn(symbol: string) -> bool =
    symbol == "write" || symbol == "_write" || symbol == "WriteFile"

/// Whether `symbol` is Win32's `GetStdHandle`.
///
/// Under the debugger it is intercepted so the handle it returns is a POSIX
/// DESCRIPTOR (1 / 2) rather than a real Win32 handle. `debug_write` then reads
/// the same first argument on both platforms — `WriteFile`'s first three
/// parameters have the same shape as `write`'s — and nothing else has to know
/// which OS produced the call.
///
/// @param symbol  the import's foreign symbol name.
/// @return        whether it is `GetStdHandle`.
is_std_handle_symbol :: fn(symbol: string) -> bool = symbol == "GetStdHandle"

/// The POSIX descriptor a `GetStdHandle` argument stands for, under the
/// debugger. `STD_OUTPUT_HANDLE` is `(DWORD) -11`, `STD_ERROR_HANDLE` `(DWORD) -12`.
///
/// @param which  the `nStdHandle` argument.
/// @return       1 for stdout, 2 for stderr.
debug_std_descriptor :: fn(which: i64) -> i64 = if which == 0xFFFF_FFF4 { 2 } else { 1 }

/// Route a `sys_write` through the debugger's output sink instead of the real
/// descriptor, and report the full count as written.
///
/// The argument shape is `sys_write(fd, buf, count)`; the sink takes a Stream
/// ordinal, which is `fd - 1` (descriptor 1 is `Stdout`, 2 is `Stderr`).
///
/// @param info      the import, for its name in trap messages.
/// @param stack     the operand stack.
/// @param arg_base  index of the first argument.
/// @param at_pc     program counter, for trap messages.
/// @param debug     the attached controller.
/// @return          the byte count, as the syscall would report it.
debug_write :: fn(info: bc.BcImport, stack: Value[], arg_base: usize, at_pc: i32, debug: DebugController) -> HostCallResult {
    fd :: read_i64(stack[arg_base], at_pc, "sys_write fd")
    if fd is Trap { return fd }
    arr :: read_array(stack[arg_base + 1], at_pc, "sys_write buf")
    if arr is Trap { return arr }
    count :: read_i64(stack[arg_base + 2], at_pc, "sys_write count")
    if count is Trap { return count }
    if count.value < 0 || usize(count.value) > arr.length {
        return Trap { .message = "sys_write at pc=${at_pc}: count ${count.value} exceeds the buffer" }
    }
    bs: u8[]! = []
    for i in 0..<usize(count.value) {
        b :: read_i64(arr.elements[arr.offset + i], at_pc, "sys_write byte")
        if b is Trap { return b }
        bs.push(u8(b.value))
    }
    debug.output_sink(i32(fd.value) - 1, bytes_to_string(bs))
    // `WriteFile` answers a bool, `write` a byte count.
    if info.signature.result == bc.ValType.Bool {
        return HostOk { .value = BoolVal { .value = true } }
    }
    return HostOk { .value = I64Val { .value = count.value } }
}

/// Serve an `@extern` the VM meets at a `call.import`, by resolving its symbol
/// and calling through a trampoline.
///
/// What is covered: integer, `bool` and pointer-width parameters, plus AT MOST
/// ONE lent byte array. Everything else — a floating parameter, a `string`, a
/// second array — traps naming the reason, because calling with a
/// mis-marshalled frame would corrupt the stack instead of failing.
///
/// The library is the running process: `BcImport` carries no library name yet,
/// so only symbols already linked into the binary resolve. That covers libc.
///
/// @param info         the import, for its `extern_name` and signature.
/// @param stack        the operand stack.
/// @param arg_base     index of the first argument.
/// @param at_pc        program counter, for trap messages.
/// @param is_comptime  true while a `@comptime` block is being evaluated.
/// @param debug        the DAP controller when one is attached, else null.
/// @return             the callee's result, or a `Trap` naming what stopped it.
dispatch_extern :: fn(info: bc.BcImport, stack: Value[], arg_base: usize, at_pc: i32, is_comptime: bool, debug: DebugController | null) -> HostCallResult {
    // Program OUTPUT is the one foreign call a `@comptime` block may make: it
    // does not change the baked value, which is the exemption `IoWrite` used to
    // carry before `write` became ordinary Vader. Everything else runs arbitrary
    // native code and cannot bake reproducibly.
    if is_comptime && !is_write_symbol(info.extern_name) {
        return impure_comptime_trap(info.mangled_name)
    }
    params :: info.signature.params
    if params.len() > 8 {
        return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: more than 8 arguments" }
    }
    // Under the DAP debugger, program output must NOT reach fd 1/2 directly —
    // in stdio transport that would corrupt the protocol stream. This is the
    // routing the `IoWrite` arm carried before `write` became ordinary Vader;
    // it has to live here now, because the VM no longer sees `write` at all,
    // only the `sys_write` beneath it.
    if debug != null && is_std_handle_symbol(info.extern_name) {
        which :: read_i64(stack[arg_base], at_pc, "GetStdHandle which")
        if which is Trap { return which }
        return HostOk { .value = I64Val { .value = debug_std_descriptor(which.value) } }
    }
    if debug != null && is_write_symbol(info.extern_name) {
        return debug_write(info, stack, arg_base, at_pc, debug)
    }
    // The declared library, or the default scope. `GetStdHandle` lives in
    // `kernel32.dll`, which the running process exports nothing of.
    lib :: ffi_open(info.c_library)
    if lib == 0 {
        where :: if info.c_library == "" { "the running process" } else { "`${info.c_library}`" }
        return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: cannot open ${where}" }
    }
    sym :: ffi_symbol(lib, info.extern_name)
    if sym == 0 {
        return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: symbol not found" }
    }

    words: i64[]! = []
    lent: u8[]! = []
    slots: i64[]! = []
    borrowed: LentArray[]! = []
    for i in 0..<params.len() {
        v :: stack[arg_base + i]
        // Checked BEFORE the `@c_pointer` branch: a `@c_struct` parameter
        // carries that decorator too, and that branch reads a SCALAR.
        //
        // Such a parameter crosses natively because the shim is SPECIALISED C —
        // it declares a real `struct timespec` and marshals by field name. The
        // VM calls through one generic trampoline and cannot build a C struct at
        // run time; that needs libffi, which we do not link. Say so rather than
        // let `read_i64` report "expected i64", which reads like a type error in
        // the user's own code.
        if v is StructVal {
            return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: argument ${i} is a `@c_struct`, which only the native backend can marshal (the VM has no libffi)" }
        }
        if extern_by_address(info.signature, i) {
            // `@c_pointer`: the callee takes the ADDRESS of a scalar. Spill it
            // into the lent buffer and hand over that offset — the mirror of
            // the stack temporary the native shim spills to. Like that
            // temporary, the spill is DROPPED after the call: `@c_pointer` is
            // the READ direction on both backends, and an out-param the caller
            // means to read back crosses as a mutable array instead.
            w :: read_i64(v, at_pc, "extern `${info.extern_name}` arg ${i}")
            if w is Trap { return w }
            width :: usize(size_of_val_type(params[i]))
            if width == 0 || width > 8 {
                return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: `@c_pointer` on a ${bc.val_type_name(params[i])} parameter is not covered" }
            }
            words.push(i64(lent.len()))
            slots.push(i64(i))
            push_little_endian(lent, w.value, width)
        } else if v is ArrayVal as arr {
            words.push(i64(lent.len()))
            slots.push(i64(i))
            borrowed.push(LentArray { .target = arr, .at = lent.len() })
            for j in 0..<arr.length {
                b :: read_i64(arr.elements[arr.offset + j], at_pc, "extern `${info.extern_name}` byte")
                if b is Trap { return b }
                // Only a BYTE array is lent. `is_extern_abi_element` admits any
                // primitive element, and the native shim widens correctly
                // (`vader_array_bytes` scales by the element size) — the VM
                // cannot, since an `ArrayVal` holds boxed values with no width.
                // Refuse rather than truncate: a silent `u8(256) == 0` would
                // corrupt the callee's buffer and diverge from native.
                if b.value < 0 || b.value > 255 {
                    return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: only a byte array can be lent on the VM, element ${j} is ${b.value}" }
                }
                lent.push(u8(b.value))
            }
        } else if v is BoolVal as b {
            words.push(if b.value { 1 } else { 0 })
        } else {
            // `null` IS a pointer value — the null address — which is what the
            // native shim passes for a `CPointer | null`. Nothing to refuse.
            if v is NullVal {
                words.push(0)
                continue
            }
            // A float argument is admitted by `validate_extern` and works
            // natively, so name the gap rather than letting `read_i64`'s
            // "expected i64" stand in for it — the two backends diverge here,
            // and the message has to say so.
            if v is F64Val {
                return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: argument ${i} is ${describe_value_tag(v)}, which the VM cannot pass yet (it works natively)" }
            }
            w :: read_i64(v, at_pc, "extern `${info.extern_name}` arg ${i}")
            if w is Trap { return w }
            words.push(w.value)
        }
    }

    n :: params.len()
    // `vader_ffi.h` has a `double` trampoline and no `float` one: a callee
    // returning `float` leaves only the low half of the result register
    // meaningful, so reading 64 bits of it would give an arbitrary value.
    if info.signature.result == bc.ValType.F32 {
        return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: a `f32` result is not covered" }
    }
    if info.signature.result == bc.ValType.F64 {
        if slots.len() > 0 {
            return Trap { .message = "extern `${info.extern_name}` at pc=${at_pc}: a lent argument with a floating result is not covered" }
        }
        return HostOk { .value = F64Val { .value = ffi_call_f64(sym, words, n) } }
    }
    raw :: if slots.len() > 0 {
        ffi_call_int_lend(sym, words, n, slots, lent)
    } else {
        ffi_call_int(sym, words, n)
    }
    // What C wrote into a lent array has to travel back: the buffer handed over
    // is a FLAT COPY of the boxed elements, so without this a mutable lend —
    // `read_file_bytes` filling its buffer — would silently read back what it
    // sent. The native path needs no equivalent: it lends the array's own
    // storage, so the write lands in place.
    for b in borrowed {
        for j in 0..<b.target.length {
            slot :: b.target.offset + j
            b.target.elements[slot] = retyped_int(b.target.elements[slot], i64(lent[b.at + j]))
        }
    }
    return extern_result(info.signature.result, raw)
}

/// One array lent to a foreign call, and where its bytes sit in the flat buffer
/// — everything the write-back needs once the callee has returned.
LentArray :: struct {
    target: ArrayVal
    at:     usize
}

/// Whether parameter `i` carries `@c_pointer`. Absent (not per-index) on every
/// signature that has no `@extern` behind it, hence the length guard.
///
/// @param sig  the import's signature.
/// @param i    parameter index.
/// @return     whether the callee receives the parameter's address.
extern_by_address :: fn(sig: bc.BcSignature, i: usize) -> bool {
    if i >= sig.param_by_address.len() {
        return false
    }
    return sig.param_by_address[i]
}

/// Append the low `width` bytes of `value` to `buf`, least significant first.
///
/// Little-endian unconditionally: every target we emit for is little-endian, and
/// the bytes are read back by the C callee on the SAME machine — this is a
/// spill, not a wire format.
///
/// @param buf    the flat lend buffer, appended to.
/// @param value  the scalar to spill.
/// @param width  how many bytes the foreign parameter occupies.
push_little_endian :: fn(buf: u8[]!, value: i64, width: usize) -> void {
    for k in 0..<width {
        buf.push(u8((value >> i64(k * 8)) & 0xFF))
    }
}

/// Rebuild `old`'s variant around a new integer, so a write-back preserves the
/// element class the array was built with.
///
/// @param old  the element being overwritten.
/// @param n    the byte C wrote.
/// @return     `n` wearing `old`'s variant.
retyped_int :: fn(old: Value, n: i64) -> Value {
    if old is I64Val {
        return I64Val { .value = n }
    }
    return I32Val { .value = i32(n) }
}

/// Wrap a foreign call's raw machine result as the `Value` its declared return
/// type calls for.
///
/// @param result  the import's declared result class.
/// @param raw     the trampoline's `i64`.
/// @return        the wrapped value.
extern_result :: fn(result: bc.ValType, raw: i64) -> HostCallResult {
    // A `string` result is a `const char*` the callee owns; turning it into a
    // Vader string means measuring and interning it, which nothing here does.
    // Reporting the raw address as an integer would hand the caller a bogus
    // atom id, so refuse instead.
    if result == bc.ValType.String {
        return Trap { .message = "extern: a `string` result is not covered on the VM" }
    }
    if result == bc.ValType.Void {
        return HostOk { .value = zero_value() }
    }
    if result == bc.ValType.Bool {
        return HostOk { .value = BoolVal { .value = raw != 0 } }
    }
    // A narrow integer keeps the carrier the VM uses for its width : `i32` and
    // below ride `I32Val`, everything wider rides `I64Val`.
    if result == bc.ValType.I32 || result == bc.ValType.U32
        || result == bc.ValType.I16 || result == bc.ValType.U16
        || result == bc.ValType.I8 || result == bc.ValType.U8
        || result == bc.ValType.Char {
        return HostOk { .value = I32Val { .value = i32(raw) } }
    }
    return HostOk { .value = I64Val { .value = raw } }
}

// ---- comptime impurity gate -----------------------------------------------

// Stable marker embedded in the Trap message the comptime impurity gate
// produces. `comptime_vm/resolve.vader` matches it (via
// `is_impure_comptime_trap_message`) to route the error to C4016 instead of the
// generic C4002 panic — the two modules share this one string so they can't
// drift.
IMPURE_COMPTIME_MARKER :: "is impure and cannot run at comptime"

// Build the Trap for an impure host reached during `@comptime` evaluation.
impure_comptime_trap :: fn(mangled: string) -> HostCallResult =
    Trap { .message = "host `${mangled}` ${IMPURE_COMPTIME_MARKER} — @comptime evaluation must be reproducible" }

/// Report whether a Trap message came from the comptime impurity gate.
/// Used by `comptime_vm/resolve.vader` to pick C4016 over C4002.
/// @param message  the `Trap.message` surfaced by a comptime VM run.
/// @return         true when the trap is an impure-host-at-comptime refusal.
export is_impure_comptime_trap_message :: fn(message: string) -> bool =
    IMPURE_COMPTIME_MARKER in message

// Classify a host by comptime purity. Impure hosts read or mutate the outside
// world (clock, environment, filesystem, stdin, subprocess, terminal) and so
// bake non-reproducibly. Exhaustive over `IntrinsicId` so a newly added host
// must be classified here (T3013) rather than silently defaulting to servable.
//
// `println` inside a `@comptime` block stays legal: writing to stdout does not
// change the baked value, and `write` is ordinary Vader now — it reaches
// `sys_write`, whose foreign-call gate `dispatch_extern` exempts for the same
// reason.
is_impure_host :: fn(id: bc.IntrinsicId) -> bool = match id {
    .IoExists | .IoIsDir | .IoTempDir | .IoReadDir | .IoReadFileBytes
        | .IoWriteFileBytes | .IoReadLine | .IoReadStdin | .IoPollStdin
        | .IoSetStdinUnbuffered | .IoCurrentExecutableLocation
        | .IoCurrentWorkingDirectory | .IoCreateDir | .IoRemoveFile -> true
    // Running arbitrary native code is impure by construction, and this is
    // what keeps a `@comptime` block from reaching the FFI at all (C4016) —
    // a build that dlopen'd a library would not be reproducible.
    .FfiOpen | .FfiSymbol | .FfiCallInt | .FfiCallVoid | .FfiCallF64
        | .FfiCallIntLend -> true
    .ProcessSpawnStart | .ProcessSpawnPoll | .ProcessSpawnKill
        | .ProcessSpawnTakeStdout | .ProcessSpawnTakeStderr -> true
    .TtyIsTty | .EnvGetEnv -> true
    // `current_os` answers for the machine the COMPILER is running on, so baking
    // it would make the output depend on who built it: a macOS emit and a Linux
    // emit of the same source would differ. That is exactly what `seed.sh check`
    // compares byte-for-byte, so letting this through would make the committed
    // seed unreproducible across platforms.
    .TargetCurrentOs | .TargetCurrentArch -> true
    // Raw mode mutates the terminal and reads keystrokes; the width is whatever
    // the window happens to be. Nothing here bakes reproducibly.
    .TtyRawModeBegin | .TtyRawModeEnd | .TtyColumns | .TtyReadKeys -> true
    // Scheduler : reads/advances the async clock — not reproducible at comptime
    // (you cannot `sleep` while baking a constant).
    .SchedNow | .SchedArm | .SchedPark -> true
    // Pure : the baked value depends only on the args, never external state.
    .ByteLen | .ByteAt -> false
    .Bytes | .BytesToString | .StringIndexAt | .StringHash
        | .StringEquals | .StringNotEquals -> false
    .PrimIntEquals | .PrimIntNotEquals | .PrimDisplayToString -> false
    .RuntimeCollect | .RuntimeCollections | .RuntimeBytesUsed | .RuntimeBytesCopied -> false
    .MathSqrt | .MathSin | .MathCos | .MathTan | .MathFloor | .MathCeil | .MathRound | .MathPow -> false
    .AbortPanic -> false
    .NotIntrinsic -> false
}

