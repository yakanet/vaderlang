// vader/vm/ffi — the VM's window onto `runtime/c/vader_ffi.h`.
//
// The native backend resolves an `@extern` through the linker and `c_emit`
// writes the call itself. The VM cannot: it learns a signature by reading
// bytecode, and C wants one at compile time. So it loads the library, resolves
// the symbol, and calls through a trampoline chosen by arity.
//
// Declared here rather than in `std/` on purpose. These five hosts amount to
// "run arbitrary native code", and putting them in the standard library would
// hand that to every program — a surface decision of its own. The compiler is
// the only caller today.
//
// Addresses ride `usize`, not the FFI pointer type: the committed seed predates
// that type, so the compiler's own sources cannot name it until the next
// reseed. `0` is the null address. Nothing here dereferences or offsets one —
// the value only travels from `ffi_symbol` to a call.

module "vader/vm"

/// Open a shared library by BARE name (`"sqlite3"`, not `"libsqlite3.so"`) —
/// the host decorates it per platform. An empty name yields the running
/// process, which is where a libc symbol lives.
///
/// @param name  the library's bare name, or `""` for the current process.
/// @return      an opaque handle, or `0` when the library is not found.
@intrinsic export ffi_open :: fn(name: string) -> usize

/// Resolve `symbol` in `lib`.
///
/// @param lib     a handle from `ffi_open`.
/// @param symbol  the exact linker name.
/// @return        the function's address, or `0` when absent.
@intrinsic export ffi_symbol :: fn(lib: usize, symbol: string) -> usize

/// Call `fn_ptr` with `nargs` integer-or-pointer arguments, reading the result
/// as an integer.
///
/// Every argument rides an `i64` slot: on every ABI we target, integers and
/// pointers of any width share the general registers, so one slot carries an
/// `int`, a `size_t` or a `void*` alike. Floating ARGUMENTS are not covered and
/// must be rejected before the call.
///
/// @param fn_ptr  the address from `ffi_symbol`.
/// @param args    argument slots, in order.
/// @param nargs   how many of `args` to pass — at most 8.
/// @return        the callee's result, widened to `i64`.
@intrinsic export ffi_call_int :: fn(fn_ptr: usize, args: i64[], nargs: usize) -> i64

/// As `ffi_call_int`, but every slot named in `slots` receives an ADDRESS INTO
/// `bytes` rather than the value in `args`.
///
/// The value sitting in `args` at a lent slot is read as the BYTE OFFSET its
/// address starts at, so ONE flat buffer serves every lent parameter of a call
/// — a foreign fn taking both a buffer and an out-param needs two addresses,
/// and a second lent array would be a second thing the GC could move.
///
/// The addresses are taken by the host, immediately before the call, and never
/// reach Vader — which is what `std/core/buffer.vader` asks of the frontend
/// ("never a machine address") and what makes the call safe: the array is
/// GC-managed and may move, and no Vader code runs between taking the addresses
/// and the call.
///
/// @param fn_ptr  the address from `ffi_symbol`.
/// @param args    argument slots ; each lent one holds an offset, not a value.
/// @param nargs   how many of `args` to pass — at most 8.
/// @param slots   which slots take an address, in any order.
/// @param bytes   the bytes to lend, for the duration of the call.
/// @return        the callee's result, widened to `i64`.
@intrinsic export ffi_call_int_lend :: fn(fn_ptr: usize, args: i64[], nargs: usize, slots: i64[], bytes: u8[]!) -> i64

/// `ffi_call_int` for a callee returning nothing.
@intrinsic export ffi_call_void :: fn(fn_ptr: usize, args: i64[], nargs: usize) -> void

/// `ffi_call_int` for a callee returning a `float` or a `double`. The ARGUMENTS
/// stay integer-or-pointer; only the result is floating.
@intrinsic export ffi_call_f64 :: fn(fn_ptr: usize, args: i64[], nargs: usize) -> f64

// ---- tests ----------------------------------------------------------------

import "std/testing"

// `strlen` is the probe throughout: every platform's C runtime exports it, it
// takes one pointer, and it writes NOTHING — so the tests leave the runner's own
// stdout alone. `write` and `getpid` would fail on Windows (the CRT spells the
// latter `_getpid`) and the first would interleave bytes into the test output.

@test test_ffi_resolves_a_libc_symbol :: fn() -> void {
    process :: ffi_open("")
    assert(process != 0, "the running process must expose its C runtime")
    assert(ffi_symbol(process, "strlen") != 0, "strlen must resolve")
}

@test test_ffi_missing_symbol_reports_zero :: fn() -> void {
    process :: ffi_open("")
    assert_eq(ffi_symbol(process, "vader_symbol_that_cannot_exist"), usize(0))
}

@test test_ffi_missing_library_reports_zero :: fn() -> void {
    assert_eq(ffi_open("vader_library_that_cannot_exist"), usize(0))
}

@test test_ffi_lends_bytes_to_a_foreign_call :: fn() -> void {
    sym :: ffi_symbol(ffi_open(""), "strlen")
    assert(sym != 0, "strlen must resolve")

    // NUL-terminated, since that is what `strlen` measures.
    bs: u8[]! = [104, 101, 108, 108, 111, 0]
    // Slot 0 takes the address; the `0` there is its offset into `bs`.
    args: i64[]! = [0]
    slots: i64[]! = [0]
    assert_eq(ffi_call_int_lend(sym, args, 1, slots, bs), 5)
}

@test test_ffi_lends_at_an_offset :: fn() -> void {
    sym :: ffi_symbol(ffi_open(""), "strlen")
    assert(sym != 0, "strlen must resolve")

    // The lent slot's value in `args` is an OFFSET into the buffer, not a
    // value: `strlen` here measures from the fourth byte, so a wrong offset
    // would read the leading zeros and report 0.
    buf: u8[]! = [0, 0, 0, 104, 105, 0]
    args: i64[]! = [3]
    slots: i64[]! = [0]
    assert_eq(ffi_call_int_lend(sym, args, 1, slots, buf), 2)
}

@test test_ffi_reads_back_what_c_wrote :: fn() -> void {
    sym :: ffi_symbol(ffi_open(""), "memset")
    assert(sym != 0, "memset must resolve")

    // The lend has to travel BOTH ways. On the VM the flat buffer is a copy of
    // the boxed elements, so without a write-back this reads `1, 2, 3, 4` — the
    // bytes it sent — and a mutable lend would be silently useless.
    buf: u8[]! = [1, 2, 3, 4]
    args: i64[]! = [0, 65, 4]
    slots: i64[]! = [0]
    ffi_call_int_lend(sym, args, 3, slots, buf)
    assert_eq(i64(buf[0]), 65)
    assert_eq(i64(buf[3]), 65)
}

@test test_ffi_lends_two_buffers_at_once :: fn() -> void {
    sym :: ffi_symbol(ffi_open(""), "memcpy")
    assert(sym != 0, "memcpy must resolve")

    // ONE flat buffer serving two lent parameters: destination at offset 0,
    // source at offset 3. The old trampoline lent a single array and could not
    // express this at all.
    buf: u8[]! = [0, 0, 0, 7, 8, 9]
    args: i64[]! = [0, 3, 3]
    slots: i64[]! = [0, 1]
    ffi_call_int_lend(sym, args, 3, slots, buf)
    assert_eq(i64(buf[0]), 7)
    assert_eq(i64(buf[2]), 9)
}
