// vader/vm/exec — the VM's entry points and the ops it runs on boxed values.
//
// `exec_entry` (and `exec` / `exec_fn` / `exec_fn_value` / `run_virt` over it)
// hands a `VmState` to the register engine (`reg_exec.vader`). The engine runs
// the ops it has no register form for through `apply_boxed`, on a scratch
// `Frame` holding their operands as a small operand stack — the SoA columns and
// the `push_val` / `peek_val` helpers below.
//
// Also here: the debugger's view of a paused frame (`pause_frame`), the narrow
// store truncation, and the trap builders both halves share.
//
// VM-level errors (malformed bytecode, a bad operand, a host-import miss) come
// back as a `Trap` with a labelled message — the runtime's generic "array index
// out of bounds" would otherwise mask compiler / parser bugs.
//
// Siblings: `value.vader` (Value projections, type matching, vtable lookup),
// `host.vader` (`dispatch_import`), `exec_bulk.vader` (the bulk op bodies).

module "vader/vm"

bc :: import "vader/bytecode"

import "std/io"
import "std/string"

// Maximum frame depth — guards against runaway recursion (the
// callee-frame allocation could otherwise grow unbounded). Picked
// well above what hand-written snippets need ; large enough that
// genuine recursive workloads pass, small enough to surface a Trap
// before the host runs out of memory.
MAX_FRAME_DEPTH :: 1024

// Step ceiling for comptime VM runs (`exec_fn_value`, capture != null) — a
// non-terminating `@comptime` loop must error, not hang the build. Generous
// enough for real computed tables (MD5_K is ~640 ops) ; a true infinite loop
// trips it in ~1s. A non-comptime run uses STEP_BUDGET_UNREACHABLE instead.
COMPTIME_STEP_BUDGET: i64: 100_000_000
/// Step budget for a run that is NOT `@comptime` — high enough that the guard
/// never fires (a machine dispatching a billion ops a second needs ~146 years to
/// reach it), so both paths share one guard shape.
STEP_BUDGET_UNREACHABLE: i64: 1 << 62

/// The operand stack `apply_boxed` runs an op on: the register engine copies the
/// op's operands in, and its results out (`reg_exec.vader::run_boxed`). `sp` is
/// the logical top ; `pc` is the op's original pc, for trap messages.
Frame :: struct {
    /// Live handles, not copies: an `ArrayVal` here is the object `array.push`
    /// grows in place, so the ELEMENT carries the marker too.
    stack:          Value![]!
    payload:        i64[]!
    tag:            StackTag[]!
    sp:             usize
    pc:             i32
}

// ---- SoA operand stack ----------------------------------------------------
// A `Frame`'s operand stack is stored column-major: scalar bits live in the
// `payload` (i64) column, the variant discriminant in `tag`, and only heap values
// in the `stack` (refs) column. A scalar write leaves the refs slot as a
// stale-but-valid `Value` (GC-safe, retention bounded by the stack's depth) and
// only a ref write updates it. `push_val` / `peek_val` bridge to a boxed `Value`.

/// Discriminant column for the SoA stack / slots. `enum(u8)` so a `tag[]`
/// packs one byte per entry ; scalar tags carry their bits in `payload`, `Ref`
/// keeps the boxed `Value` in the refs column.
StackTag :: enum(u8) { I32, I64, F64, Bool, Char, Null, Ref }

/// What a `.Null` slot reads back as. A freshly-grown refs column takes a fresh
/// `NullVal {}` rather than this: the column is `Value![]`, and a module const is
/// read-only. The filler is never dereferenced (its tag is not `StackTag.Ref`) but
/// stays valid so the GC's generic scan of the refs array never chases garbage.
NULL_VALUE :: NullVal {}

/// True when `t` marks a value `read_i32` accepts (i32 / char / i64 carriers).
/// Mirrors `read_i32`'s @partial match EXACTLY — a stricter test would reject
/// bytecode the boxed path accepted.
is_i32_tag :: fn(t: StackTag) = t == .I32 || t == .Char || t == .I64

/// Integer→integer `convert`, straight on the stack columns. True when it applied.
///
/// The boxed route allocates TWICE per execution — `peek_val` to read the operand,
/// `push_val` to carry the result back — to move a word that never leaves its
/// column. Answers exactly what `convert_value`'s `.I32` / `.I64` arms answer,
/// unsigned-source normalisation included: a `u8` / `u16` / `u32` arrives tagged
/// `I32` holding raw bits, so widening it must ZERO-extend rather than
/// sign-extend. Any other source tag or target falls through to the boxed path
/// unchanged.
convert_int_fast :: fn(frame: Frame!, target: ConvertTarget, from_name: string) -> bool {
    if target != .I32 && target != .I64 {
        return false
    }
    idx :: frame.sp - 1
    t :: frame.tag[idx]
    n: i64 = 0
    if t == .I32 {
        // Only a widening to i64 can see above bit 31 — an `.I32` target truncates
        // back to the same low word either way. `starts_with` is not the test: it
        // allocates a byte view per call, and this runs once per executed convert.
        if target == .I64 && from_name.byte_len() > 0 && from_name.byte_at(0) == 'u' {
            n = i64(u32(frame.payload[idx]))
        } else {
            n = i64(i32(frame.payload[idx]))
        }
    } else if t == .I64 {
        n = frame.payload[idx]
    } else if t == .Char {
        n = i64(u32(frame.payload[idx]))
    } else if t == .Bool {
        n = if frame.payload[idx] != 0 { 1 } else { 0 }
    } else {
        return false
    }
    if target == .I32 {
        frame.payload[idx] = i64(i32(n))
        frame.tag[idx] = .I32
    } else {
        frame.payload[idx] = n
        frame.tag[idx] = .I64
    }
    return true
}

/// Grow the three stack columns by one slot. Only `reserve_stack` calls it.
stack_grow :: fn(frame: Frame!) -> void {
    frame.payload.push(0)
    frame.tag.push(.Null)
    frame.stack.push(NullVal {})
}

/// Size `frame`'s three stack columns to at least `depth`, so a push inside the op
/// it runs never checks capacity. The columns are grow-only.
reserve_stack :: fn(frame: Frame!, depth: usize) -> void {
    for frame.payload.len() < depth {
        stack_grow(frame)
    }
}


/// Write `value` into the stack columns at `cursor` — sized by `reserve_stack`
/// (the caller bumps `sp`). Scalars land in payload + tag, heap values in the refs
/// column.
push_val :: fn(frame: Frame!, cursor: usize, value: Value!) -> void {
    match value {
        is I32Val -> {
            frame.payload[cursor] = i64(value)
            frame.tag[cursor] = .I32
        }
        is I64Val -> {
            frame.payload[cursor] = i64(value)
            frame.tag[cursor] = .I64
        }
        is F64Val -> {
            frame.payload[cursor] = i64(f64(value).to_bits())
            frame.tag[cursor] = .F64
        }
        is BoolVal -> {
            frame.payload[cursor] = if bool(value) { 1 } else { 0 }
            frame.tag[cursor] = .Bool
        }
        is CharVal -> {
            frame.payload[cursor] = i64(u32(value))
            frame.tag[cursor] = .Char
        }
        is NullVal -> { frame.tag[cursor] = .Null }
        _ -> {
            frame.stack[cursor] = value
            frame.tag[cursor] = .Ref
        }
    }
}

/// Materialise the stack value at absolute index `idx` as a boxed `Value`.
peek_val :: fn(frame: Frame, idx: usize) -> Value {
    match frame.tag[idx] {
        .Ref  -> { return frame.stack[idx] }
        .I32  -> { return I32Val(i32(frame.payload[idx])) }
        .I64  -> { return I64Val(frame.payload[idx]) }
        .F64  -> { return F64Val(u64(frame.payload[idx]).from_bits()) }
        .Bool -> { return BoolVal(frame.payload[idx] != 0) }
        .Char -> { return CharVal(char(u32(frame.payload[idx]))) }
        .Null -> { return NULL_VALUE }
    }
}

/// Peek stack slot `idx` as a WRITABLE array handle.
///
/// The in-place array opcodes (`array.push`, `array.set`, `memory_copy`) grow or
/// overwrite the very object the stack holds, so they need the handle itself and
/// not the unboxed copy `peek_val` hands out. Only a `.Ref` slot can hold an
/// array, which is why this reads `frame.stack` directly.
///
/// @param frame  the executing frame — mutable, because the rights on the value
///               can only come from the frame that owns it.
/// @param idx    slot index within the frame, as for `peek_val`.
/// @param at_pc  informational — the pc quoted in the trap message.
/// @param label  informational — names the operand in the trap message.
/// @return       the writable `ArrayVal`, or a `Trap` when the slot holds
///               anything else.
peek_array_mut :: fn(frame: Frame!, idx: usize, at_pc: i32, label: string) -> ArrayVal! | Trap! {
    if frame.tag[idx] == .Ref {
        v :: frame.stack[idx]
        if v is ArrayVal {
            return v
        }
    }
    return Trap {
        .message = "${label} at pc=${at_pc}: expected array, got ${describe_value_tag(peek_val(frame, idx))}",
    }
}


/// One frame of the paused call stack, as the debugger's `on_pause` reads it.
///
/// @param bc_mod   the running module, for the Variables projection.
/// @param fn_body  the frame's function.
/// @param slots    its parameters then locals, in slot order.
/// @param at_pc    the op it stands at, in `fn_body.body`'s pc space.
pause_frame :: fn(bc_mod: bc.BytecodeModule, fn_body: bc.BcFunction, slots: Value[], at_pc: i32) -> PauseFrame {
    file := ""
    line := 0
    if at_pc >= 0 && usize(at_pc) < fn_body.debug.len() {
        dbg :: fn_body.debug[usize(at_pc)]
        if dbg != null {
            file = dbg.file
            line = dbg.line
        }
    }
    return PauseFrame {
        .function_name = fn_body.name,
        .file          = file,
        .line          = line,
        .locals        = project_locals(slots, at_pc, fn_body, bc_mod),
    }
}

// Max nesting the Variables projection descends (also the cycle guard) and max
// array elements projected per level — bounds the eager snapshot.
DEBUG_MAX_DEPTH: i32: 5
DEBUG_MAX_ELEMS: usize: 64

// Render a frame's params + declared locals for the Variables view. Slots
// `[0..params)` are params (no source names in `BcSignature` → `arg0`, `arg1`,
// …) ; `locals[k]` lives at slot `params + k`. Accurate when the target is
// compiled `optimize = false` (no slot coalescing) — the DAP compile's mode.
project_locals :: fn(slots: Value[], at_pc: i32, fn_body: bc.BcFunction, bc_mod: bc.BytecodeModule) -> PauseVar[]! {
    param_count :: fn_body.signature.params.len()
    total_slots :: param_count + fn_body.locals.len()
    // Per-slot [first, last] touch pc — a slot's live window. A local shows only
    // when the current pc is inside it (`optimize = false` gives each source
    // local its own slot, so the window ≈ its lexical scope). This hides
    // not-yet-declared locals and the `v` of already-finished sibling loops.
    first: i32[]!: [-1] * total_slots
    last:  i32[]!: [-1] * total_slots
    for pc in 0..<fn_body.body.len() {
        s :: slot_touched_by(fn_body.body[pc])
        if s >= 0 && usize(s) < total_slots {
            if first[usize(s)] < 0 { first[usize(s)] = i32(pc) }
            last[usize(s)] = i32(pc)
        }
    }

    out: PauseVar[]!: []
    // Params live the whole frame — always shown, named from the signature
    // (`param_names`, empty on name-less paths → `arg<i>`).
    for p in 0..<param_count {
        if p < slots.len() {
            out.push(project_var(param_display_name(fn_body.signature, p), slots[p], bc_mod, 0))
        }
    }
    for k in 0..<fn_body.locals.len() {
        name :: fn_body.locals[k].name
        slot :: param_count + k
        // Hide compiler-synthesised temps (`$…` / `__…` / `if_res`) and locals
        // outside their live window at the current pc.
        if slot < slots.len() && is_source_local(name) && slot_in_scope(first, last, slot, at_pc) {
            out.push(project_var(name, slots[slot], bc_mod, 0))
        }
    }
    return out
}

// The local slot an op reads or writes, or -1 when it touches none.
slot_touched_by :: fn(op: bc.Op) -> i32 {
    if op is bc.LocalGet  { return op.slot }
    if op is bc.LocalSet  { return op.slot }
    if op is bc.LocalTee  { return op.slot }
    if op is bc.LocalField { return op.slot }
    return -1
}

// True when `slot`'s live window (`[first, last]` touch pc) contains `pc`.
slot_in_scope :: fn(first: i32[], last: i32[], slot: usize, pc: i32) -> bool {
    if first[slot] < 0 { return false }
    return first[slot] <= pc && pc <= last[slot]
}

// Source parameter name for slot `p`, or `arg<p>` when the signature carries no
// names (imports / synth wrappers / `.virt` reload).
param_display_name :: fn(sig: bc.BcSignature, p: usize) -> string {
    if p < sig.param_names.len() && sig.param_names[p] != "" { return sig.param_names[p] }
    return "arg${p}"
}

// Project a `Value` to a (possibly nested) `PauseVar` : its display string plus,
// for an array / struct within the depth budget, its elements / fields as
// children. Depth-bounded (which also breaks cycles) ; arrays cap at
// `DEBUG_MAX_ELEMS`.
project_var :: fn(name: string, v: Value, bc_mod: bc.BytecodeModule, depth: i32) -> PauseVar {
    children: PauseVar[]! = []
    if depth < DEBUG_MAX_DEPTH {
        if v is ArrayVal {
            shown :: if v.length > DEBUG_MAX_ELEMS { DEBUG_MAX_ELEMS } else { v.length }
            for i in 0..<shown {
                children.push(project_var("[${i}]", v.elements[v.offset + i], bc_mod, depth + 1))
            }
        } else if v is StructVal {
            children = project_struct_fields(v, bc_mod, depth)
        }
    }
    return PauseVar { .name = name, .value = display_value(v), .children = children }
}

// Project a struct's fields, naming each from the module type table's
// `BcStruct.fields` (falling back to `field<i>` if the entry isn't a struct or
// is shorter than the value's field list).
project_struct_fields :: fn(s: StructVal, bc_mod: bc.BytecodeModule, depth: i32) -> PauseVar[]! {
    out: PauseVar[]!: []
    names: string[]!: []
    if usize(s.type_id) < bc_mod.types.len() {
        entry :: bc_mod.types[usize(s.type_id)]
        if entry is bc.BcStruct {
            for fld in entry.fields { names.push(fld.name) }
        }
    }
    for i in 0..<s.fields.len() {
        fname :: if i < names.len() { names[i] } else { "field${i}" }
        out.push(project_var(fname, s.fields[i], bc_mod, depth + 1))
    }
    return out
}

/// Bounds-check a `function_index` against `functions`, for an index that comes
/// from a VALUE (a fn value, a vtable row, a deferred thunk) — an immediate one was
/// checked by the load-time verifier. Surfaces a Trap rather than indexing into
/// the array and letting the host runtime trap.
///
/// @param function_index  candidate index into `functions`.
/// @param functions       the running module's function table.
/// @param at_pc           pc of the op doing the lookup.
/// @param op_label        op-name prefix for the diagnostic message
///                        (`"call.indirect"`, `"defer.pop_exec"`, …).
/// @return                `null` on success, `Trap` if out of range.
/// @error                 `function_index < 0` or `>= functions.len()`.
validate_fn_index :: fn(function_index: i32, functions: bc.BcFunction[], at_pc: i32, op_label: string) -> Trap | null {
    if is_fn_index_out_of_range(function_index, functions) {
        return fn_index_trap(function_index, at_pc, op_label)
    }
    return null
}

// `VirtualCall` tests with this predicate and builds the trap only on failure: a
// fn that may build a `Trap` carries a GC frame, so calling `validate_fn_index`
// on the hot path pays that frame on every call.
is_fn_index_out_of_range :: fn(function_index: i32, functions: bc.BcFunction[]) = function_index < 0 || usize(function_index) >= functions.len()

fn_index_trap :: fn(function_index: i32, at_pc: i32, op_label: string) = Trap {
    .message = "${op_label} function ${function_index} out of range at pc=${at_pc}",
}

/// `==` / `!=` (`negate` true). The emitter routes `ref` / `any` / `null`
/// equality through `i32.eq`, treating the boxed identity bits as a 32-bit
/// word — but a `null` operand can't be read as an i32. Compare those by
/// null-identity (`null == null`, `null != anything-non-null`) ; everything
/// else falls back to the numeric i32 path.
apply_eq_binop :: fn(frame: Frame!, op_label: string, negate: bool) -> Trap | null {
    lt :: frame.tag[frame.sp - 2]
    rt :: frame.tag[frame.sp - 1]
    eq: bool = false
    if lt == .Null || rt == .Null {
        eq = lt == .Null && rt == .Null
    } else if is_i32_tag(lt) && is_i32_tag(rt) {
        // Fast path : both operands already sit unboxed in the payload column.
        eq = i32(frame.payload[frame.sp - 2]) == i32(frame.payload[frame.sp - 1])
    } else {
        // Anything else (a Ref, a bool, a mismatch) — go through the boxed path
        // so the diagnostic stays identical to the pre-SoA VM.
        left  :: read_i32(peek_val(frame, frame.sp - 2), frame.pc, op_label)
        right :: read_i32(peek_val(frame, frame.sp - 1), frame.pc, op_label)
        if left  is Trap { return left  }
        if right is Trap { return right }
        eq = left == right
    }
    frame.payload[frame.sp - 2] = if (if negate { !eq } else { eq }) { 1 } else { 0 }
    frame.tag[frame.sp - 2] = .Bool
    frame.sp = frame.sp - 1
    frame.pc = frame.pc + 1
    return null
}

/// Primitive kind ("string" / "char" / "i32" / …) of `types[type_id]`,
/// or "" when the slot isn't a primitive. Used by the virtual.call intrinsic
/// fallback to rebuild a host mangle.
primitive_kind_at :: fn(types: bc.BcType[], type_id: i32) -> string {
    if type_id < 0 || usize(type_id) >= types.len() { return "" }
    t :: types[usize(type_id)]
    if t is bc.BcPrimitive { return bc.val_type_name(t.val) }
    return ""
}

/// Build the host import mangle for an `@intrinsic` primitive impl member from
/// the receiver kind + a `"Trait.method"` vtable key — e.g.
/// `("string", "Hash.hash")` → `"std_core$string$Hash$hash"`. The mangle
/// grammar itself lives in `bytecode/intrinsic_manifest::primitive_member_mangle` ;
/// this only splits the vtable key. Returns "" when the kind is empty or the
/// key has no `.`.
intrinsic_host_mangle :: fn(kind: string, vtable_key: string) -> string {
    if kind == "" { return "" }
    dot :: vtable_key.index_of('.', 0)
    if dot < 0 { return "" }
    kb :: vtable_key.bytes()
    trait_name :: kb[0..<usize(dot)].bytes_to_string()
    method :: kb[usize(dot) + 1..<kb.len()].bytes_to_string()
    return bc.primitive_member_mangle(kind, trait_name, method)
}

/// Build the argv argument for a `fn(argv: string[]) -> i32` entry point.
/// `host_argv` carries the forwarded CLI args (argv[0] = program path, then the
/// program's own args) — set by `run_virt` from the `--` separator so the
/// compiler can run itself through the VM. When empty, falls back to a single
/// synthetic path element. Returns an empty arg list when `main` takes no
/// parameters.
///
/// `prepare` inferred every function's operand tags from its declared parameter
/// types (`tags.vader`), so a parameter that cannot hold a reference must not be
/// handed the array.
///
/// @param entry                  the entry fn.
/// @param host_argv              forwarded CLI argv, or empty for the synthetic
///                               path.
/// @param string_array_type_id   the module's `string[]` type-table index, used
///                               to tag the boxed array.
/// @return                       the `Value[]` to seed the main frame's slots.
/// @error                        a `Trap` when the entry takes more than one
///                               parameter, or one that cannot hold a `string[]`.
build_main_args :: fn(
    entry: bc.BcFunction,
    host_argv: string[],
    string_array_type_id: i32,
) -> Value![] | Trap {
    out: Value![]!: []
    params :: entry.signature.params
    if params.len() == 0 {
        return out
    }
    if params.len() > 1 {
        count :: params.len()
        message :: "entry function '${entry.name}' takes ${count} parameters; the host passes one"
        return Trap { .message = message }
    }
    if !tags_within(TAGS_REF, tags_of_val(params[0])) {
        class :: bc.val_type_name(params[0])
        message :: "entry function '${entry.name}' takes a ${class}, but the host passes a string[]"
        return Trap { .message = message }
    }
    // Pushed per branch rather than through a joined local : the fallback is a fresh
    // literal (mutable) and `host_argv` is a read-only borrow, so a join would have
    // to pick one mutability for both (T3074).
    if host_argv.len() == 0 {
        out.push(string_array_to_value(["<vader-vm>"], string_array_type_id))
    } else {
        out.push(string_array_to_value(host_argv, string_array_type_id))
    }
    return out
}

/// Run `main`. Thin wrapper over `exec_entry`.
///
/// @param state      the prepared VM state.
/// @param host_argv  forwarded CLI argv for a one-parameter `main`.
/// @return           `Ok(value)` when `main` returns ; the `Trap` of any VM-level
///                   error otherwise.
export exec :: fn(state: VmState, host_argv: string[]) -> VmResult = exec_entry(state, state.main_index, host_argv, null, false, null)

/// Run the fn named `mangled` as the entry — used by `vader test` to run each
/// `@test` fn in isolation. A `Trap` (e.g. a failed `assert`) is the test
/// failure ; `Ok` is a pass. The fn must take no arguments.
///
/// @param state    the prepared VM state.
/// @param mangled  the target fn's mangled name.
/// @return         the run outcome, or a `Trap` when no such fn exists.
export exec_fn :: fn(state: VmState, mangled: string) -> VmResult {
    idx :: state.fn_index_by_name[mangled]
    if !(idx is null) {
        no_args: string[]: []
        return exec_entry(state, idx, no_args, null, false, null)
    }
    return Trap { .message = "exec_fn: no function named '${mangled}'" }
}

/// Run the no-arg fn named `mangled` and return its full `Value` — the
/// primitive the VM-backed comptime fallback needs (the callee typically
/// returns an array / struct / wide int, which `exec_fn`'s i32 `VmResult`
/// cannot carry). Threads a 1-cell capture box through `exec_entry`, into which
/// the entry's raw return value is published.
///
/// The capture box is a live local across the run, so it (and the captured
/// value once written) stays a GC root through any collection inside the loop.
///
/// @param state    the prepared VM state.
/// @param mangled  the target fn's mangled name. Must take no arguments.
/// @return         `ValueOk { value }` carrying the return value, or `Trap`
///                 (no such fn, or a VM-level error during the run).
export exec_fn_value :: fn(state: VmState, mangled: string) -> ValueResult {
    idx :: state.fn_index_by_name[mangled]
    if !(idx is null) {
        no_args: string[]!: []
        capture: Value[]!: [zero_value()]
        outcome :: exec_entry(state, idx, no_args, capture, true, null)
        if outcome is Trap { return outcome }
        return ValueOk { .value = capture[0] }
    }
    return Trap { .message = "exec_fn_value: no function named '${mangled}'" }
}

// Mask an integer `Value` to a narrow ValType's width (`u8` / `u16` / `i8` /
// `i16`), mirroring the truncation a native narrow-storage slot applies. The VM
// stores every integer as a wide `I32Val` / `I64Val` with no width tag, and the
// bytecode's arith ops are width-aliased to the I32/I64 family (`op_select.vader`),
// so a sub-32-bit result (`u8 200 + 100` → 300) keeps the wide value. Native
// truncates for free via the C `uint8_t` field type ; this is the VM's
// equivalent for a struct literal's fields (`build_struct`) — the register engine
// truncates slots and returns itself (`Narrow`). Non-narrow ValTypes return `v`
// unchanged — `i32` / `i64` (and the unsigned `u32` / `u64`, read back through the
// unsigned view) already wrap at their width via native `i32` / `i64` overflow.
narrow_mask :: fn(v: Value, vt: bc.ValType) -> Value {
    // Only the sub-32-bit widths need masking ; i32/i64 (and the unsigned u32/u64
    // read back through the unsigned view) already wrap at their width.
    if !is_narrow_valtype(vt) { return v }
    bits: i64: if vt == .U8 || vt == .I8 { 8 } else { 16 }
    // A narrow slot only ever holds an int (carried as I32Val / I64Val).
    raw: i64 = 0
    if v is I32Val {
        raw = i64(v)
    } else if v is I64Val {
        raw = i64(v)
    } else {
        return v
    }
    return I32Val(truncate_to_width(raw, bits, vt == .I8 || vt == .I16))
}

// `raw` cut to its low `bits` bits, sign-extended when `signed`.
truncate_to_width :: fn(raw: i64, bits: i64, signed: bool) -> i32 {
    masked :: raw & ((1 << bits) - 1)
    // Top bit set ⇒ sign-extend.
    out :: if signed && masked & (1 << (bits - 1)) != 0 { masked - (1 << bits) } else { masked }
    return i32(out)
}

// Declared ValType of a local slot. Params occupy the low slots
// (`signature.params`), then the fn body's additional locals (`BcFunction` doc :
// slot of `locals[i]` is `params.len() + i`). Decides a `local.set`'s truncation.
slot_valtype :: fn(body: bc.BcFunction, slot: i32) -> bc.ValType {
    np :: body.signature.params.len()
    s :: usize(slot)
    if s < np { return body.signature.params[s] }
    li :: s - np
    if li < body.locals.len() { return body.locals[li].val }
    return .I32     // defensive : unknown slot ⇒ no masking
}

// True when `vt` is a sub-32-bit width whose stored VM value must be truncated
// to that width (`narrow_mask`).
is_narrow_valtype :: fn(vt: bc.ValType) = vt == .U8 || vt == .I8 || vt == .U16 || vt == .I16

// ValType of a struct field's declared type (`BcField.type_index` → type table).
// A non-primitive field returns `Ref` (never narrow), so `narrow_mask` no-ops.
// Backs the `struct.new` narrow-field mask : a struct literal builds its fields
// straight from the stack (`build_struct`) with no intervening narrow `local.set`.
field_valtype :: fn(types: bc.BcType[], type_index: i32) -> bc.ValType {
    if type_index < 0 || usize(type_index) >= types.len() { return .Ref }
    t :: types[usize(type_index)]
    if t is bc.BcPrimitive { return t.val }
    return .Ref
}

/// Run the module from `entry_index`. `exec` / `exec_fn` pick the entry (main vs a
/// named `@test`).
///
/// @param state        the prepared module.
/// @param entry_index  the function to start.
/// @param host_argv    forwarded CLI argv for a one-parameter entry.
/// @param capture      a 1-cell box the entry's return value is published into,
///                     or `null` for an exit code.
/// @param is_comptime  true for a comptime evaluation, which has a step budget.
/// @param debug        the debugger driving the run, or `null` ; with one, `state`
///                     comes from `prepare_debug`.
/// @return             the exit code, or the trap that stopped the run.
export exec_entry :: fn(
    state: VmState, entry_index: i32, host_argv: string[], capture: Value[]! | null, is_comptime: bool,
    debug: DebugController | null,
) -> VmResult {
    if entry_index < 0 || usize(entry_index) >= state.bc.functions.len() {
        return Trap { .message = "no entry function (index=${entry_index})" }
    }
    if debug != null && !state.debuggable {
        return Trap { .message = "a debugged run needs a state from `prepare_debug`" }
    }
    return reg_run(state, state.reg, entry_index, host_argv, capture, is_comptime, debug)
}

/// Build an `ArrayVal` of `type_id` with `length` initial elements
/// popped from the stack. If `length == 0`, allocates an empty
/// grow-only array ready for `array.push`.
///
/// @param type_id  index into `Module.types` — informational, not
///                 validated against `ArrayType` (the bytecode pipeline
///                 already guarantees consistency).
/// @param length   initial element count to consume from the stack.
/// @param frame    current top frame, mutated in place (sp/pc advanced).
/// @return         `null` on success, or a `Trap` if the stack is too short.
/// @error          stack underflow when `frame.sp < length`.
build_array :: fn(type_id: i32, length: i32, frame: Frame!) -> Trap | null {
    if length < 0 {
        return Trap { .message = "array.new length ${length} is negative at pc=${frame.pc}" }
    }
    needed :: usize(length)
    arg_base :: frame.sp - needed
    elements: Value[]!: [] * needed
    for element_index in 0..<needed {
        elements.push(peek_val(frame, arg_base + element_index))
    }
    new_array :: ArrayVal { .type_id = type_id, .elements = elements, .offset = 0, .length = elements.len() }
    push_val(frame, arg_base, new_array)
    frame.sp = arg_base + 1
    frame.pc = frame.pc + 1
    return null
}

/// Body of the `StructNew` arm — the .virt text format emits two
/// variants (`struct.new` and `struct.new_stack`) but the VM treats
/// them identically (the heap/stack split is a codegen concern).
/// Pops `field_count` values from `frame.stack` (in field-declaration
/// order), wraps them in a `StructVal`, and pushes the result.
///
/// @param types    the running module's type table.
/// @param type_id  the struct type's ordinal in `types`.
/// @param frame    current top frame, mutated in place (sp / pc advanced).
/// @return         `null` on success, or a `Trap` describing the failure.
/// @error          `type_id` out of range ; type-table entry isn't a
///                 `BcStruct` ; stack carries fewer than `field_count`
///                 values.
build_struct :: fn(types: bc.BcType[], type_id: i32, frame: Frame!) -> Trap | null {
    type_decl :: types[usize(type_id)]
    if !(type_decl is bc.BcStruct) {
        return Trap { .message = "struct.new type ${type_id} is not a struct at pc=${frame.pc}" }
    }
    field_count :: type_decl.fields.len()
    arg_base :: frame.sp - field_count
    fields: Value[]!: []
    for field_index in 0..<field_count {
        // Narrow-typed field ⇒ truncate to width, mirroring a C narrow struct
        // field ; the literal's field value comes straight off the stack with no
        // intervening narrow `local.set` to mask it (see narrow-int-width plan).
        fvt :: field_valtype(types, type_decl.fields[field_index].type_index)
        fields.push(narrow_mask(peek_val(frame, arg_base + field_index), fvt))
    }
    new_struct :: StructVal { .type_id = type_id, .fields = fields }
    push_val(frame, arg_base, new_struct)
    frame.sp = arg_base + 1
    frame.pc = frame.pc + 1
    return null
}

// ---- memory opcodes (Target ABI) — VM byte-heap helpers (decision D8) ----
//
// The VM backs a REAL byte-addressed heap : `ObjVal.bytes` is the raw inline
// payload (byte offsets), `ObjVal.slots` the boxed reference fields (slot
// indices). Each accessor re-derives from the obj on the stack — no base cached
// across an op, since every access hits `obj.bytes` / `obj.slots` fresh.

/// Body of the `buffer.new` arm. Pops `size` (usize) and pushes a zero-filled
/// `ObjVal` of that byte length. `type_id` is the inline immediate (D2).
/// `handle_cell[0]` is the monotonic synthetic-handle source (diagnostics).
///
/// @param type_id      the object's type-table ordinal (Buffer = the
///                     `VADER_TYPE_INDEX_BUFFER` sentinel, D3).
/// @param frame        current top frame, mutated in place (size popped, obj
///                     pushed in its place — net stack effect 0).
/// @param handle_cell  1-cell carrier for the monotonic handle counter.
/// @return             `null` on success, or a `Trap` on stack underflow /
///                     negative size.
/// @error              empty stack ; negative size.
build_buffer :: fn(frame: Frame!, handle_cell: i32[]!) -> Trap | null {
    size_unwrap :: read_i32(peek_val(frame, frame.sp - 1), frame.pc, "buffer.new size")
    if size_unwrap is Trap { return size_unwrap }
    if size_unwrap < 0 {
        return Trap {
            .message = "buffer.new size ${i32(size_unwrap)} is negative at pc=${frame.pc}",
        }
    }
    bytes: u8[]!: [] * usize(size_unwrap)
    for _ in 0..<usize(size_unwrap) {
        bytes.push(0)
    }
    handle_cell[0] = handle_cell[0] + 1
    push_val(frame, frame.sp - 1, ObjVal {
        .handle = handle_cell[0], .type_id = 0, .bytes = bytes, .slots = [],
    })
    frame.pc = frame.pc + 1
    return null
}

/// Validate a byte-region access for the typed load/store ops: the offset must
/// be non-negative and `[off, off + width)` must fall within `bytes_len`.
/// Centralises the bounds logic + trap wording shared by `load_bytes_op` and
/// `store_bytes_op` so the two stay in lockstep.
///
/// @param off        the raw signed offset popped off the stack.
/// @param width      byte width of the access (1 / 4 / 8).
/// @param bytes_len  length of the object's inline byte region.
/// @param label      op label for trap messages.
/// @param pc         current program counter, for trap provenance.
/// @return           the validated `usize` offset.
/// @error            negative offset ; range past the byte length.
check_byte_range :: fn(off: i32, width: usize, bytes_len: usize, label: string, pc: i32) -> usize | Trap {
    if off < 0 {
        return Trap { .message = "${label} offset ${off} is negative at pc=${pc}" }
    }
    o :: usize(off)
    if o + width > bytes_len {
        return Trap { .message = "${label} offset ${o} (+${width}) exceeds object byte length ${bytes_len} at pc=${pc}" }
    }
    return o
}

// The i32 in stack cell `at`, straight off the columns as `read_i32` reads it ;
// the label — `op`, then `what` — is built only when the read traps.
stack_i32 :: fn(frame: Frame, at: usize, op: string, what: string) -> i32 | Trap {
    if is_i32_tag(frame.tag[at]) {
        return i32(frame.payload[at])
    }
    failed :: read_i32(peek_val(frame, at), frame.pc, "${op} ${what}")
    return if failed is Trap { failed } else { i32(failed) }
}

// The object in stack cell `at` ; the label is built only when it is not one.
stack_obj :: fn(frame: Frame, at: usize, op: string) -> ObjVal | Trap {
    v :: peek_val(frame, at)
    if v is ObjVal {
        return v
    }
    return read_obj(v, frame.pc, "${op} receiver")
}

/// Shared front-half of the typed/byte loads (`load_u8` / `load_i32` /
/// `load_i64`). Validates `obj, off` on the stack and bounds, then returns the
/// `width` little-endian bytes at `off` as a zero-extended u64 — the caller
/// wraps it in the right `Value` and advances the stack/pc.
///
/// @param frame  current top frame ; not mutated here (the arm overwrites
///               `stack[sp-2]` and drops one slot).
/// @param width  byte width to read (1 / 4 / 8).
/// @param label  op label for trap messages.
/// @return       the raw value, or a `Trap` on underflow / bad obj / OOB.
/// @error        fewer than 2 stack slots ; non-object receiver ; negative or
///               out-of-range offset.
load_bytes_op :: fn(frame: Frame, width: usize, label: string) -> u64 | Trap {
    off_unwrap :: stack_i32(frame, frame.sp - 1, label, "offset")
    if off_unwrap is Trap { return off_unwrap }
    obj_unwrap :: stack_obj(frame, frame.sp - 2, label)
    if obj_unwrap is Trap { return obj_unwrap }
    off :: check_byte_range(off_unwrap, width, obj_unwrap.bytes.len(), label, frame.pc)
    if off is Trap { return off }
    return read_le(obj_unwrap.bytes, off, width)
}

/// Shared body of the typed/byte stores (`store_u8` / `store_i32` /
/// `store_i64`). The caller has already read the value off `stack[sp-1]` into
/// `value` (the raw bit pattern) and guaranteed `sp >= 3`. Validates `obj`
/// (sp-3) and `off` (sp-2), bounds-checks, writes `width` little-endian bytes,
/// then drops the three operands and advances pc.
///
/// @param frame  current top frame, mutated in place.
/// @param width  byte width to write (1 / 4 / 8).
/// @param value  the raw bit pattern whose low `width` bytes are stored.
/// @param label  op label for trap messages.
/// @return       `null` on success, or a `Trap` on bad obj / OOB offset.
/// @error        non-object receiver ; negative or out-of-range offset.
store_bytes_op :: fn(frame: Frame!, width: usize, value: u64, label: string) -> Trap | null {
    off_unwrap :: stack_i32(frame, frame.sp - 2, label, "offset")
    if off_unwrap is Trap { return off_unwrap }
    obj_unwrap :: stack_obj(frame, frame.sp - 3, label)
    if obj_unwrap is Trap { return obj_unwrap }
    off :: check_byte_range(off_unwrap, width, obj_unwrap.bytes.len(), label, frame.pc)
    if off is Trap { return off }
    write_le(obj_unwrap.bytes, off, width, value)
    frame.sp = frame.sp - 3
    frame.pc = frame.pc + 1
    return null
}

/// Body of the `memory_copy` arm. Pops `dst, dst_off, src, src_off, n` and
/// copies `n` bytes src→dst (raw byte regions). Bounds-checks both ends and
/// copies through a snapshot, so an overlapping self-copy stays well-defined
/// in the oracle (native lowers to `memcpy` and the lowerer guarantees no
/// overlap — the snapshot only hardens the VM reference impl).
///
/// @param frame  current top frame, mutated in place (5 operands dropped).
/// @return       `null` on success, or a `Trap` on underflow / bad obj / OOB.
/// @error        fewer than 5 stack slots ; non-object dst/src ; negative
///               length/offset ; source or dest range past the byte length.
do_memory_copy :: fn(frame: Frame!) -> Trap | null {
    n_unwrap :: read_i32(peek_val(frame, frame.sp - 1), frame.pc, "memory_copy n")
    if n_unwrap is Trap { return n_unwrap }
    src_off_unwrap :: read_i32(peek_val(frame, frame.sp - 2), frame.pc, "memory_copy src_off")
    if src_off_unwrap is Trap { return src_off_unwrap }
    src_unwrap :: read_obj(peek_val(frame, frame.sp - 3), frame.pc, "memory_copy src")
    if src_unwrap is Trap { return src_unwrap }
    dst_off_unwrap :: read_i32(peek_val(frame, frame.sp - 4), frame.pc, "memory_copy dst_off")
    if dst_off_unwrap is Trap { return dst_off_unwrap }
    dst_unwrap :: read_obj(peek_val(frame, frame.sp - 5), frame.pc, "memory_copy dst")
    if dst_unwrap is Trap { return dst_unwrap }
    if n_unwrap < 0 || src_off_unwrap < 0 || dst_off_unwrap < 0 {
        return Trap { .message = "memory_copy negative length/offset at pc=${frame.pc}" }
    }
    n :: usize(n_unwrap)
    src_off :: usize(src_off_unwrap)
    dst_off :: usize(dst_off_unwrap)
    if src_off + n > src_unwrap.bytes.len() {
        return Trap { .message = "memory_copy source range [${src_off}, ${src_off + n}) exceeds ${src_unwrap.bytes.len()} at pc=${frame.pc}" }
    }
    if dst_off + n > dst_unwrap.bytes.len() {
        return Trap { .message = "memory_copy dest range [${dst_off}, ${dst_off + n}) exceeds ${dst_unwrap.bytes.len()} at pc=${frame.pc}" }
    }
    snapshot: u8[]!: [] * n
    for i in 0..<n {
        snapshot.push(src_unwrap.bytes[src_off + i])
    }
    for i in 0..<n {
        dst_unwrap.bytes[dst_off + i] = snapshot[i]
    }
    frame.sp = frame.sp - 5
    frame.pc = frame.pc + 1
    return null
}

// ---- boxed ops ------------------------------------------------------------

/// Host state one run shares with every nested run it starts: the GC counter
/// `std/runtime` reads, the async scheduler's virtual clock and wake deadlines
/// (index 0 is `now`), and the handle source of `buffer.new`. Boxed cells, since
/// `dispatch_import` and `build_buffer` update them in place.
RunHost :: struct {
    gc_state:    usize[]!
    sched_state: usize[]!
    obj_handles: i32[]!
}

new_run_host :: fn() -> RunHost! = RunHost { .gc_state = [0], .sched_state = [0], .obj_handles = [0] }

// The trap of a comptime run past its step budget.
budget_trap :: fn(budget: i64) = Trap {
    .message = "comptime evaluation exceeded ${budget} steps (non-terminating @comptime?)",
}

// The trap of a call past `MAX_FRAME_DEPTH`.
overflow_trap :: fn(name: string) = Trap {
    .message = "call stack overflow (depth > ${MAX_FRAME_DEPTH}) at function '${name}'",
}

// The import `dispatch_import` serves a host-provided impl on a primitive through
// (`string implements Hash`) — it has no vtable row. Only the name, the arity and
// a non-void result are read.
primitive_impl_import :: fn(mangle: string, arity: usize) = bc.BcImport {
    .extern_name  = "",
    .mangled_name = mangle,
    .signature    = bc.BcSignature {
        .params       = [.Any] * arity,
        .results      = [.Any],
        .param_types  = [],
        .result_types = [0],
        .param_names  = [],
    },
    .is_extern    = false,
}

/// Run one op that reads and writes the operand stack of `frame` as boxed values,
/// and advance `frame.pc` — the register engine's path for the ops it does not
/// run itself, on a scratch frame holding the op's operands.
///
/// @param state    the prepared module.
/// @param run      the run's host state.
/// @param instr    the op.
/// @param frame    the frame whose stack holds the operands.
/// @param fn_name  the running function, for trap messages.
/// @return         `null` when the op ran.
/// @error          the `Trap` that stops the run.
apply_boxed :: fn(
    state: VmState, run: RunHost!, instr: bc.Op, frame: Frame!, fn_name: string,
) -> Trap | null {
    // @partial: the ops the register engine runs itself.
    @partial match instr {
        is bc.FnRef -> {
            push_val(frame, frame.sp, FnVal { .function_index = instr.function_index, .env = null })
            frame.sp = frame.sp + 1
            frame.pc = frame.pc + 1
        }
        is bc.MakeClosure -> {
            env_value :: peek_val(frame, frame.sp - 1)
            push_val(frame, frame.sp - 1, FnVal { .function_index = instr.function_index, .env = env_value })
            frame.pc = frame.pc + 1
        }
        is bc.StructNew -> {
            outcome :: build_struct(state.bc.types, instr.type_id, frame)
            if outcome is Trap { return outcome }
        }
        is bc.ArrayNew -> {
            outcome :: build_array(instr.type_id, instr.length, frame)
            if outcome is Trap { return outcome }
        }
        is bc.ArraySlice -> {
            outcome :: exec_array_slice(frame, instr)
            if outcome is Trap { return outcome }
        }
        is bc.ArrayRepeat -> {
            outcome :: exec_array_repeat(frame)
            if outcome is Trap { return outcome }
        }
        is bc.ArrayPushAll -> {
            outcome :: exec_array_push_all(frame)
            if outcome is Trap { return outcome }
        }
        is bc.ArrayCopy -> {
            outcome :: exec_array_copy(frame)
            if outcome is Trap { return outcome }
        }
        is bc.ArrayRemoveLast -> {
            array_unwrap :: peek_array_mut(frame, frame.sp - 1, frame.pc, "array.remove_last receiver")
            if array_unwrap is Trap { return array_unwrap }
            if array_unwrap.length == 0 {
                frame.tag[frame.sp - 1] = .Null
            } else {
                last :: array_unwrap.elements[array_unwrap.offset + array_unwrap.length - 1]
                // Shrink the SHARED backing when this array owns the tail —
                // same rule as `array.clear` below, and as the native
                // `vader_array_remove_last`. `data.const` hands out a fresh
                // header over the pool entry's `elements`, so a length
                // written only on the header is lost for a module-level
                // array: the next read rebuilds it from `elements.len()`.
                if array_unwrap.offset == 0 && array_unwrap.length == array_unwrap.elements.len() {
                    array_unwrap.elements.remove_last()
                }
                array_unwrap.length = array_unwrap.length - 1
                push_val(frame, frame.sp - 1, last)
            }
            frame.pc = frame.pc + 1
        }
        is bc.ArrayClear -> {
            array_unwrap :: peek_array_mut(frame, frame.sp - 1, frame.pc, "array.clear receiver")
            if array_unwrap is Trap { return array_unwrap }
            // Clear the SHARED backing when this array owns it, the way the
            // native runtime shrinks `buf->length` in `vader_array_clear`.
            // `data.const` hands out a FRESH header over the pool entry's
            // `elements`, which is how a module-level array is reached, so
            // rebinding the field here would leave that array untouched —
            // `push` mutates the shared backing and would still see three
            // elements after a `clear`. Emptying it in place keeps
            // `elements.len()` as the logical length, so nothing resurfaces
            // on the next push. A genuine slice view (offset != 0, or a
            // shorter prefix) detaches instead and keeps its isolation.
            if array_unwrap.offset == 0 && array_unwrap.length == array_unwrap.elements.len() {
                array_unwrap.elements.clear()
            } else {
                array_unwrap.elements = []
            }
            array_unwrap.offset = 0
            array_unwrap.length = 0
            frame.sp = frame.sp - 1
            frame.pc = frame.pc + 1
        }
        is bc.DataConst -> {
            shared :: state.data_pool[usize(instr.pool_index)]
            if shared.type_id == instr.type_id {
                push_val(frame, frame.sp, shared)
            } else {
                // A writable entry (or a site at another type_id) : a fresh
                // header over the same `elements`, as `.rodata` is shared
                // natively.
                push_val(frame, frame.sp, ArrayVal {
                    .type_id  = instr.type_id,
                    .elements = shared.elements,
                    .offset   = 0,
                    .length   = shared.elements.len(),
                })
            }
            frame.sp = frame.sp + 1
            frame.pc = frame.pc + 1
        }
        is bc.Convert -> {
            if !convert_int_fast(frame, instr.target, instr.from_name) {
                v :: peek_val(frame, frame.sp - 1)
                converted :: convert_value(v, instr.target, instr.from_name, frame.pc)
                if converted is Trap {
                    return Trap { .message = "${converted.message} (got ${describe_value_tag(v)}) in '${fn_name}'" }
                }
                push_val(frame, frame.sp - 1, converted)
            }
            frame.pc = frame.pc + 1
        }
        is bc.SizeOfType -> {
            top_val :: peek_val(frame, frame.sp - 1)
            if !(top_val is TypeVal) {
                return Trap { .message = "intrinsic size_of.type: expected type value, got ${describe_value_tag(top_val)} at pc=${frame.pc}" }
            }
            type_id :: top_val.type_id
            if type_id < 0 || usize(type_id) >= state.bc.types.len() {
                return Trap { .message = "intrinsic size_of.type: type ${type_id} out of range at pc=${frame.pc}" }
            }
            size :: bc.size_of_bc_type(state.bc.types[usize(type_id)])
            frame.payload[frame.sp - 1] = i64(size)
            frame.tag[frame.sp - 1] = .I64
            frame.pc = frame.pc + 1
        }
        is bc.I32Eq -> {
            outcome :: apply_eq_binop(frame, "i32.eq", false)
            if outcome is Trap { return outcome }
        }
        is bc.I32Ne -> {
            outcome :: apply_eq_binop(frame, "i32.ne", true)
            if outcome is Trap { return outcome }
        }
        is bc.BoolEq -> {
            left  :: read_bool(peek_val(frame, frame.sp - 2), frame.pc, "bool.eq")
            if left  is Trap { return left  }
            right :: read_bool(peek_val(frame, frame.sp - 1), frame.pc, "bool.eq")
            if right is Trap { return right }
            frame.payload[frame.sp - 2] = if left == right { 1 } else { 0 }
            frame.tag[frame.sp - 2] = .Bool
            frame.sp = frame.sp - 1
            frame.pc = frame.pc + 1
        }
        is bc.BoolNe -> {
            left  :: read_bool(peek_val(frame, frame.sp - 2), frame.pc, "bool.ne")
            if left  is Trap { return left  }
            right :: read_bool(peek_val(frame, frame.sp - 1), frame.pc, "bool.ne")
            if right is Trap { return right }
            frame.payload[frame.sp - 2] = if left != right { 1 } else { 0 }
            frame.tag[frame.sp - 2] = .Bool
            frame.sp = frame.sp - 1
            frame.pc = frame.pc + 1
        }
        is bc.BoolAnd -> {
            left  :: read_bool(peek_val(frame, frame.sp - 2), frame.pc, "bool.and")
            if left  is Trap { return left  }
            right :: read_bool(peek_val(frame, frame.sp - 1), frame.pc, "bool.and")
            if right is Trap { return right }
            frame.payload[frame.sp - 2] = if bool(left) && bool(right) { 1 } else { 0 }
            frame.tag[frame.sp - 2] = .Bool
            frame.sp = frame.sp - 1
            frame.pc = frame.pc + 1
        }
        is bc.BoolOr -> {
            left  :: read_bool(peek_val(frame, frame.sp - 2), frame.pc, "bool.or")
            if left  is Trap { return left  }
            right :: read_bool(peek_val(frame, frame.sp - 1), frame.pc, "bool.or")
            if right is Trap { return right }
            frame.payload[frame.sp - 2] = if bool(left) || bool(right) { 1 } else { 0 }
            frame.tag[frame.sp - 2] = .Bool
            frame.sp = frame.sp - 1
            frame.pc = frame.pc + 1
        }
        is bc.BoolNot -> {
            operand :: read_bool(peek_val(frame, frame.sp - 1), frame.pc, "bool.not")
            if operand is Trap { return operand }
            frame.payload[frame.sp - 1] = if !bool(operand) { 1 } else { 0 }
            frame.tag[frame.sp - 1] = .Bool
            frame.pc = frame.pc + 1
        }
        is bc.StringEq -> {
            left  :: read_string(peek_val(frame, frame.sp - 2), frame.pc, "string.eq")
            if left  is Trap { return left  }
            right :: read_string(peek_val(frame, frame.sp - 1), frame.pc, "string.eq")
            if right is Trap { return right }
            frame.payload[frame.sp - 2] = if left == right { 1 } else { 0 }
            frame.tag[frame.sp - 2] = .Bool
            frame.sp = frame.sp - 1
            frame.pc = frame.pc + 1
        }
        is bc.StringNe -> {
            left  :: read_string(peek_val(frame, frame.sp - 2), frame.pc, "string.ne")
            if left  is Trap { return left  }
            right :: read_string(peek_val(frame, frame.sp - 1), frame.pc, "string.ne")
            if right is Trap { return right }
            frame.payload[frame.sp - 2] = if left != right { 1 } else { 0 }
            frame.tag[frame.sp - 2] = .Bool
            frame.sp = frame.sp - 1
            frame.pc = frame.pc + 1
        }
        is bc.StringSliceCodepoints -> {
            outcome :: exec_string_slice_codepoints(frame)
            if outcome is Trap { return outcome }
        }
        is bc.RefEq -> {
            outcome :: value_ref_eq(peek_val(frame, frame.sp - 2), peek_val(frame, frame.sp - 1))
            frame.payload[frame.sp - 2] = if outcome { 1 } else { 0 }
            frame.tag[frame.sp - 2] = .Bool
            frame.sp = frame.sp - 1
            frame.pc = frame.pc + 1
        }
        is bc.RefNe -> {
            outcome :: value_ref_eq(peek_val(frame, frame.sp - 2), peek_val(frame, frame.sp - 1))
            frame.payload[frame.sp - 2] = if !outcome { 1 } else { 0 }
            frame.tag[frame.sp - 2] = .Bool
            frame.sp = frame.sp - 1
            frame.pc = frame.pc + 1
        }
        is bc.TypeCheck -> {
            matched :: type_matches(state, peek_val(frame, frame.sp - 1), instr.type_id)
            frame.payload[frame.sp - 1] = if matched { 1 } else { 0 }
            frame.tag[frame.sp - 1] = .Bool
            frame.pc = frame.pc + 1
        }
        is bc.TypeConst -> {
            push_val(frame, frame.sp, TypeVal { .type_id = instr.type_id })
            frame.sp = frame.sp + 1
            frame.pc = frame.pc + 1
        }
        is bc.BufferNew -> {
            outcome :: build_buffer(frame, run.obj_handles)
            if outcome is Trap { return outcome }
        }
        is bc.LoadU8 -> {
            raw :: load_bytes_op(frame, 1, "load_u8")
            if raw is Trap { return raw }
            frame.payload[frame.sp - 2] = i64(i32(raw))
            frame.tag[frame.sp - 2] = .I32
            frame.sp = frame.sp - 1
            frame.pc = frame.pc + 1
        }
        is bc.LoadI32 -> {
            raw :: load_bytes_op(frame, 4, "load_i32")
            if raw is Trap { return raw }
            frame.payload[frame.sp - 2] = i64(i32(raw))
            frame.tag[frame.sp - 2] = .I32
            frame.sp = frame.sp - 1
            frame.pc = frame.pc + 1
        }
        is bc.LoadI64 -> {
            raw :: load_bytes_op(frame, 8, "load_i64")
            if raw is Trap { return raw }
            frame.payload[frame.sp - 2] = i64(raw)
            frame.tag[frame.sp - 2] = .I64
            frame.sp = frame.sp - 1
            frame.pc = frame.pc + 1
        }
        is bc.LoadF64 -> {
            raw :: load_bytes_op(frame, 8, "load_f64")
            if raw is Trap { return raw }
            frame.payload[frame.sp - 2] = i64(((u64(raw)).from_bits()).to_bits())
            frame.tag[frame.sp - 2] = .F64
            frame.sp = frame.sp - 1
            frame.pc = frame.pc + 1
        }
        is bc.StoreU8 -> {
            val_unwrap :: stack_i32(frame, frame.sp - 1, "store_u8", "value")
            if val_unwrap is Trap { return val_unwrap }
            outcome :: store_bytes_op(frame, 1, u64(u8(val_unwrap)), "store_u8")
            if outcome is Trap { return outcome }
        }
        is bc.StoreI32 -> {
            val_unwrap :: stack_i32(frame, frame.sp - 1, "store_i32", "value")
            if val_unwrap is Trap { return val_unwrap }
            outcome :: store_bytes_op(frame, 4, u64(u32(val_unwrap)), "store_i32")
            if outcome is Trap { return outcome }
        }
        is bc.StoreI64 -> {
            val_unwrap :: read_i64(peek_val(frame, frame.sp - 1), frame.pc, "store_i64 value")
            if val_unwrap is Trap { return val_unwrap }
            outcome :: store_bytes_op(frame, 8, u64(val_unwrap), "store_i64")
            if outcome is Trap { return outcome }
        }
        is bc.StoreF64 -> {
            val_unwrap :: read_f64(peek_val(frame, frame.sp - 1), frame.pc, "store_f64 value")
            if val_unwrap is Trap { return val_unwrap }
            outcome :: store_bytes_op(frame, 8, f64(val_unwrap).to_bits(), "store_f64")
            if outcome is Trap { return outcome }
        }
        is bc.MemoryCopy -> {
            outcome :: do_memory_copy(frame)
            if outcome is Trap { return outcome }
        }
        is bc.BufferToString -> {
            // Pop buffer + len ; intern the leading `len` bytes verbatim as a
            // string (same semantics as `bytes_to_string` over a `u8[]`).
            len_unwrap :: read_i32(peek_val(frame, frame.sp - 1), frame.pc, "buffer_to_string len")
            if len_unwrap is Trap { return len_unwrap }
            obj_unwrap :: read_obj(peek_val(frame, frame.sp - 2), frame.pc, "buffer_to_string receiver")
            if obj_unwrap is Trap { return obj_unwrap }
            // width 0 ⇒ checks `0 <= len <= bytes_len`, returns the usize len.
            n :: check_byte_range(i32(len_unwrap), 0, obj_unwrap.bytes.len(), "buffer_to_string", frame.pc)
            if n is Trap { return n }
            push_val(frame, frame.sp - 2, StringVal(obj_unwrap.bytes[0..<n].bytes_to_string()))
            frame.sp = frame.sp - 1
            frame.pc = frame.pc + 1
        }
        is bc.BufferWriteString -> {
            outcome :: exec_buffer_write_string(frame)
            if outcome is Trap { return outcome }
        }
        is bc.F64ToBits -> {
            // Bit-reinterpret the TOS f64 as its raw u64 bits (held in an
            // I64Val — same 64 bits).
            fv :: read_f64(peek_val(frame, frame.sp - 1), frame.pc, "f64_to_bits")
            if fv is Trap { return fv }
            frame.payload[frame.sp - 1] = i64(f64(fv).to_bits())
            frame.tag[frame.sp - 1] = .I64
            frame.pc = frame.pc + 1
        }
        is bc.BitsToF64 -> {
            // Inverse : reinterpret the TOS u64 bit pattern (in an I64Val) as
            // an f64.
            iv :: read_i64(peek_val(frame, frame.sp - 1), frame.pc, "bits_to_f64")
            if iv is Trap { return iv }
            frame.payload[frame.sp - 1] = i64(u64(iv).from_bits().to_bits())
            frame.tag[frame.sp - 1] = .F64
            frame.pc = frame.pc + 1
        }
        is bc.F32ToBits -> {
            // f32→u32 bits. The VM holds f32 in an F64Val (exact, since f32
            // widens losslessly), so narrow back to f32 before the cast; the
            // u32 result rides in an I32Val.
            fv :: read_f64(peek_val(frame, frame.sp - 1), frame.pc, "f32_to_bits")
            if fv is Trap { return fv }
            frame.payload[frame.sp - 1] = i64(i32(f32(fv).to_bits()))
            frame.tag[frame.sp - 1] = .I32
            frame.pc = frame.pc + 1
        }
        is bc.BitsToF32 -> {
            // Inverse : reinterpret the TOS u32 bit pattern (in an I32Val) as
            // an f32, widened back into an F64Val for VM storage.
            iv :: read_i32(peek_val(frame, frame.sp - 1), frame.pc, "bits_to_f32")
            if iv is Trap { return iv }
            frame.payload[frame.sp - 1] = i64(f64(u32(iv).from_bits()).to_bits())
            frame.tag[frame.sp - 1] = .F64
            frame.pc = frame.pc + 1
        }
        _ -> {}
    }
    return null
}

// ---- entry --------------------------------------------------------------

/// CLI entry — read a `.virt` text dump from `path`, parse it, run it,
/// and return an exit code. Diagnostics go to stderr.
///
/// @param path  filesystem path to the `.virt` file.
/// @return      the i32 the program's `main` returned (or `0` if it
///              fell through without an explicit `return`) ; `1` when
///              the file can't be read, doesn't parse, or the VM trapped —
///              the error message goes to stderr in all three cases.
/// @error       missing file ; a line the `.virt` reader can't interpret ;
///              any VM trap surfaced by `exec`.
export run_virt :: fn(path: string, host_argv: string[]) -> i32 {
    source :: read_file_string(path)
    if source is IOError {
        eprintln("vader run: cannot read ${path}")
        return 1
    }
    module :: parse_virt_bc(source)
    if module is VirtParseError {
        eprintln(module.display_virt_parse_error("vader run", path))
        return 1
    }
    state :: prepare(module)
    if state is VerifyError {
        eprintln("vader run: ${display_verify_error(state)}")
        return 1
    }
    return match exec(state, host_argv) as o {
        is Ok   -> o.value
        is Trap -> {
            eprintln("vader vm: ${o.message}")
            1
        }
    }
}
