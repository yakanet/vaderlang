// vader/pipeline/emit — the native link.
//
// Bytecode → C → binary, monolithic: one C unit plus the external runtime, one
// `cc`. The split path (`--split`) stays in the CLI, which owns that flag;
// the monolithic build is the canonical one anyway (byte-identical, fully
// inlined).
//
// Here rather than in the CLI because a build driver has to be able to produce
// output, and re-implementing the link in every project is how flags drift —
// release opts, the runtime include path, `ldflags`. See the plan's §15
// (decision 13: the driver returns a binary).
//
// The CLI keeps its own `emit_c_source` / `prepared_module` pair: those carry
// its diagnostic renderer and its `.virt` input path, neither of which a driver
// wants. Only the link helpers moved.

module "vader/pipeline"

import "std/env"
import "std/io"
import "std/path"
import "std/string"
import "std/process"
import "std/target"
import "vader/diagnostics"
import "vader/resolver"
import "vader/bytecode"
import "vader/c_emit" { EmitOptions as CEmitOptions, default_emit_options as default_c_emit_options }

// Runtime root for `--target=native` linking — resolved next to the executable
// (dist bundle) then the cwd, via the shared `resolve_sidecar` probe (marker
// `vader.h`), so a bundled `vader` finds `runtime/c/` next to itself.
/// Directory holding the C runtime, for `--target=native` linking.
///
/// Beside the executable first (the `dist/` bundle layout), then the invocation
/// directory — the same sidecar probe the stdlib resolution uses.
export runtime_c_root :: fn() = resolve_sidecar("runtime/c", "vader.h")
/// The flags every C compile of emitted code takes, by build mode.
///
/// Release adds `-falign-functions=64`, measured as worth it on this codebase;
/// debug keeps `-O0 -g` so a `#line`-carrying build is steppable. Release alone
/// defines `NDEBUG`, which turns the checked arithmetic of `runtime/c/vader.h` from
/// stopping the run into wrapping (SPEC §Integer overflow). Both carry `-fwrapv`:
/// the wrapping operators and the arithmetic the compiler synthesises lower to the
/// C operator on a signed type, where C leaves an overflow undefined and a compiler
/// assumes none happens, gcc even at `-O0`. The emitter computes some `u32` / `u64`
/// arithmetic on signed C temporaries, so unsigned wrapping depends on the flag too.
export cc_opt_flags :: fn(release: bool) -> string[] = if release {
    ["-std=c11", "-O3", "-DNDEBUG", "-falign-functions=64", "-fwrapv"]
} else {
    ["-std=c11", "-O0", "-g", "-fwrapv"]
}

/// Which C toolchain `cc` is, since the two that matter spell link-time
/// optimisation differently.
export CcFlavour :: enum(u8) {
    /// clang / LLVM — ThinLTO.
    Clang
    /// GCC, including a MinGW toolchain — `-flto=auto`.
    Gcc
    /// Anything else, or a probe that failed. No LTO: an unrecognised compiler
    /// gets the plain split, which is correct everywhere, just not as fast.
    Unknown
}

/// LLVM's ceiling, in IR instructions, on a callee ThinLTO will import across
/// units. Its default is 100, which leaves out the container operations a split
/// build most wants inlined. Past this value the bench readings stop improving
/// monotonically — tuning it further would be fitting noise.
///
/// LLVM's knob, in LLVM's units, per callee — not a program-size threshold. It
/// behaves the same for a 20-function program and for the compiler.
THIN_LTO_IMPORT_LIMIT :: "300"

/// Link-time-optimisation flags for one `cc` invocation, or none.
///
/// Splitting into one TU per module is what makes the compiles parallel, and it
/// is also what stops `cc` inlining across the cut. LTO gives that back without
/// giving up the parallelism: the per-unit compiles stay parallel, and the
/// cross-unit work happens after — clang imports from summaries at the thin
/// link, GCC partitions and runs LTRANS across cores.
///
/// RELEASE ONLY, and that is not incidental: a debug build wants `-O0 -g` and a
/// fast turnaround, and the link stage of LTO optimises whatever it is given
/// regardless of how the objects were compiled. Wiring it unconditionally made a
/// debug `--split` build link at `-O3`, silently costing steppability — the very
/// drift the note below exists to prevent, on a flag family it did not yet cover.
///
/// @param flavour  the toolchain family.
/// @param release  false disables LTO entirely.
/// @param linking  true for the link step, which carries the extra knobs.
/// @param jobs     GCC's LTRANS job count on the link step; ignored otherwise.
/// @return         flags to append, empty when LTO does not apply.
export lto_flags :: fn(flavour: CcFlavour, release: bool, linking: bool, jobs: i32) -> string[] {
    if !release {
        return []
    }
    // `-O3` on the LINK line is what drives the LTO backend: the objects hold
    // bitcode, and the optimisation that matters happens here. Without it the
    // backend runs at -O0 and a release build ships unoptimised code. Safe to
    // state unconditionally because this whole function is release-only.
    if flavour == .Clang {
        if linking {
            return ["-flto=thin", "-O3", "-Wl,-mllvm,-import-instr-limit=${THIN_LTO_IMPORT_LIMIT}"]
        }
        return ["-flto=thin"]
    }
    // GCC runs its LTRANS jobs through `make -jN`. The count is explicit because
    // `auto` is resolved by the toolchain, and MinGW's resolves it to `-j1`: the
    // whole-program -O3 pass then runs on one core.
    if flavour == .Gcc {
        if linking {
            return ["-flto=${jobs}", "-O3"]
        }
        return ["-flto"]
    }
    return []
}

// Compiler + `-std=c11` + optimisation flags — the single source of truth for
// codegen policy across the mono (`cc_argv`) and split (`cc_compile_argv`)
// builds, so they can't silently drift. `-falign-functions=64` keeps a hot
// loop's alignment stable against unrelated code growth (without it, adding a
// few lines to one runtime fn can shift e.g. `vader_array_push` onto a bad %64
// offset and slow its byte-identical loop ~1.6× — the arr_push regression ;
// +1.3 % binary, neutral on self-compile).

// Append whitespace-split user `--ldflags` tokens to `argv` — no shell quoting
// (a path with spaces is a user bug).
/// Append whitespace-split `--ldflags` tokens to a command line.
///
/// No shell quoting: a path with spaces is a user error, not something to guess
/// at.
///
/// @param argv     the command line being built, appended to in place.
/// @param ldflags  the raw flag string.
/// Append the math library, and on Linux the flag that keeps it linked.
///
/// `--as-needed` — the default there — drops a `-l` nothing references, and
/// nothing DOES reference libm: the compiler reaches `sqrt` and friends only from
/// `@comptime`, through the interpreter, which resolves them in the running
/// process. A library the linker dropped is not in it. Elsewhere `-lm` is inert,
/// macOS and MinGW carrying the math symbols in their C runtime.
///
/// Shared by BOTH link paths — the mono `cc_argv` here and the split
/// `cc_link_argv` in `vader/cli`. Only the split one produces a `--release`
/// build, so a flag added to just one of them leaves the shipped binary
/// without it.
///
/// @param argv  the command line being built, appended to in place.
export push_math_library :: fn(argv: string[]) -> void {
    if VADER_OS == .Linux {
        argv.push("-Wl,--no-as-needed")
        // And EXPORT the executable's own symbols, or the interpreter cannot
        // reach them. An `@extern` naming a `runtime/c/` accessor —
        // `vader_path_kind`, `vader_last_errno`, `vader_dirent_name` — is
        // resolved at the call by `dlsym` on the running process, and on ELF a
        // symbol only enters `.dynsym` when the link asks for it.
        //
        // Nothing else in the tree needed this, which is why it went unnoticed:
        // Mach-O exports every global by default and mingw has `dllexport` in
        // `VADER_HOST_EXPORT`, so macOS and Windows both answered. Linux said
        // `symbol not found` at run time — an FFI error, for a link problem.
        argv.push("-rdynamic")
    }
    argv.push("-lm")
}

/// Split a user `--ldflags` string on spaces and append each token.
///
/// Empty tokens are dropped, so a doubled or trailing space cannot reach `cc`
/// as an empty argument.
///
/// @param argv     the command line being built, appended to in place.
/// @param ldflags  the raw `--ldflags` value, space-separated.
export push_ldflags :: fn(argv: string[], ldflags: string) -> void {
    for tok in ldflags.trim().split(" ") {
        if tok != "" {
            argv.push(tok)
        }
    }
}

/// The directory a quoted `@c_header("\"my.h\"")` resolves against: the entry
/// file's. The generated C is written beside `--out`, not always beside the
/// source, so `cc` is handed this directory as `-iquote`.
///
/// @param entry  the file the build was asked for.
export quote_include_dir :: fn(entry: Path) -> string {
    dir :: canonicalise(entry).parent().as_string()
    if dir == "" {
        return "."
    }
    return dir
}

/// Push the include flags every `cc` compile of emitted code takes.
///
/// Shared by BOTH compile paths, the mono `cc_argv` here and the split
/// `cc_compile_argv` in `vader/cli`. `-I <rt>` reaches `vader.h`. `-iquote <rt>`
/// comes before `quote_dir`: a quoted include searches the `-iquote` list first,
/// so a `vader.h` beside the entry would otherwise stand in for the runtime's.
///
/// @param argv       the command line being built, appended to in place.
/// @param rt         the directory holding `vader.h`.
/// @param quote_dir  where a quoted `@c_header` resolves (`quote_include_dir`).
export push_include_flags :: fn(argv: string[], rt: string, quote_dir: string) -> void {
    argv.push("-I")
    argv.push(rt)
    argv.push("-iquote")
    argv.push(rt)
    argv.push("-iquote")
    argv.push(quote_dir)
}

/// Assemble the `cc` command line for a native link.
///
/// Opt flags, includes (`push_include_flags`), the emitted unit, the runtime
/// unit, user `ldflags`, then `-o <out> -lm`. `-lm` satisfies the runtime's
/// `floor` / `fmod` on glibc and is a no-op elsewhere.
/// @param runtime_root  directory holding `vader_runtime.c` + `vader.h`, or ""
///                      to probe beside the running executable. A build DRIVER
///                      must pass it: the driver binary lives under the
///                      project's `build/`, so the probe would look there.
/// @param quote_dir     where a quoted `@c_header` resolves (`quote_include_dir`).
export cc_argv :: fn(
    cc: string,
    c_file: string,
    out: Path,
    release: bool,
    ldflags: string,
    runtime_root: string,
    quote_dir: string,
) -> string[] {
    argv: string[]: [cc]
    argv.push_all(cc_opt_flags(release))
    rt :: if runtime_root == "" { runtime_c_root() } else { runtime_root }
    push_include_flags(argv, rt, quote_dir)
    argv.push(c_file)
    argv.push("${rt}/vader_runtime.c")
    push_ldflags(argv, ldflags)
    argv.push("-o")
    argv.push(out.as_string())
    push_math_library(argv)
    return argv
}
// Write `content` to `path`, surfacing a write failure as exit 1.
/// Write `content` to `path`, reporting a failure as exit 1.
///
/// @return 0 on success; 1 after printing why, so a caller can just propagate.
export write_out :: fn(path: Path, content: string) -> i32 {
    wr :: write_file_string(path.as_string(), content)
    if wr is IOError {
        eprintln("vader build: cannot write `${path}`: ${wr.message()}")
        return 1
    }
    return 0
}

// ---- native output --------------------------------------------------------

/// The C compiler to invoke when `--cc` names none: `$CC`, else the host's own.
///
/// `$CC` names ONE program — it is spawned as is, never split into a command
/// line. Without it, `cc` is the POSIX-guaranteed name; Windows has none. Keyed
/// on the host and not on the build target: it names a program to spawn HERE, so
/// a cross build has to name its own — `--cc=x86_64-w64-mingw32-gcc` on the
/// command line, `ctx.cc` from a driver.
export default_cc :: fn() -> string {
    from_env :: get_env("CC")
    if from_env != null && from_env != "" {
        return from_env
    }
    return if current_os() == .Windows { "gcc" } else { "cc" }
}

/// Write `c` beside `out` and link it into a native binary.
///
/// The single link path: every caller that produces a native binary goes
/// through here, so the flags cannot drift between them — release opts, the
/// runtime include, `ldflags`, `-lm`. The generated `.c` is KEPT on failure and
/// named in the message, so the user can inspect what was actually produced.
///
/// @param c             the emitted C source.
/// @param out           binary to produce ; the C lands at `<out>.c`.
/// @param cc            C compiler to invoke.
/// @param release       passed to the opt flags.
/// @param ldflags       raw linker flags, appended verbatim.
/// @param runtime_root  see `cc_argv`.
/// @param quote_dir     where a quoted `@c_header` resolves (`quote_include_dir`).
/// @return              0 on success, 1 when the C could not be written or `cc`
///                      failed. `cc`'s own stderr is forwarded as-is.
export link_native :: fn(
    c: string,
    out: Path,
    cc: string,
    release: bool,
    ldflags: string,
    runtime_root: string,
    quote_dir: string,
) -> i32 {
    c_file :: "${out}.c".to_path()
    if write_out(c_file, c) != 0 {
        return 1
    }
    res :: spawn(cc_argv(cc, c_file.as_string(), out, release, ldflags, runtime_root, quote_dir))
    if res is ProcessError {
        eprintln("vader build: ${res.message()}")
        eprintln("(generated C kept at ${c_file})")
        return 1
    }
    if res.exit != 0 {
        eprintln("vader build: ${cc} failed (exit ${res.exit})")
        eprintln(res.stderr)
        eprintln("(generated C kept at ${c_file})")
        return 1
    }
    // Report the file that EXISTS, not the `-o` we asked for: on Windows they
    // differ, and naming one the user cannot find is worse than naming the
    // platform's own convention.
    linked :: linked_binary(out.as_string()) ?? out.as_string()
    eprintln("vader build: wrote ${linked} (and ${c_file})")
    return 0
}

/// A linked executable as the LINKER named it, or null when none appeared.
///
/// `cc -o app` writes `app` on Unix and **`app.exe`** on Windows — gcc appends
/// the suffix when `-o` carries no extension, verified with mingw-w64. The stdlib
/// exposes no platform query, so rather than guess the suffix this asks the
/// filesystem which name turned up.
///
/// This does NOT make `vader build --out=app && ./app` portable, and no design
/// would: on Windows the artefact IS `app.exe`, because an extension-less file is
/// not executable there. What it fixes is the compiler claiming a name it did not
/// produce, and callers that assumed the bare one.
///
/// @param base  the `-o` path handed to the linker.
export linked_binary :: fn(base: string) -> string | null {
    if exists(base) {
        return base
    }
    with_exe :: "${base}.exe"
    if exists(with_exe) {
        return with_exe
    }
    return null
}

/// Default output name for an input: its path minus the recognised suffix.
///
/// What `vader build` derives when `--out` is absent, and what a driver gets
/// when it leaves `ctx.out` empty — the two must agree, which is why this lives
/// here rather than in either caller.
///
/// @param file  entry source, or a `.virt` bytecode dump.
/// @return      the path with `.vader` / `.virt` removed; unchanged otherwise.
export strip_input_suffix :: fn(file: Path) -> Path =
    if file.extension() == "virt" {
        file.as_string().trim_suffix(".virt").to_path()
    } else {
        file.as_string().trim_suffix(".vader").to_path()
    }

/// Emit C from an ALREADY-BUILT bytecode module.
///
/// The seam a single-stream driver needs: it holds the `CfgBytecode` from its
/// own walk and must not re-run the pipeline to get the C.
///
/// @param cfg      bytecode plus the entry mangle it was built with.
/// @param release  optimise, and drop `#line`.
/// @return         the C source. Callers gate on `any_error_diag` first — this
///                 does not check, and emitting from a rejected program yields
///                 something that links but is wrong.
export c_source_of :: fn(cfg: CfgBytecode, release: bool) -> string =
    emit_c(cfg.module, CEmitOptions { .release = release, .entry_mangled = cfg.entry })

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_quote_include_dir_is_the_entry_directory :: fn() -> void {
    assert_eq(quote_include_dir("src/app/main.vader".to_path()), "src/app")
    assert_eq(quote_include_dir("main.vader".to_path()), ".")
}

@test
test_cc_opt_flags_wrap_signed_arithmetic :: fn() -> void {
    assert("-fwrapv" in cc_opt_flags(true), "a release build wraps the wrapping operators")
    assert("-fwrapv" in cc_opt_flags(false), "a debug build wraps the wrapping operators")
}

@test
test_cc_opt_flags_check_overflow_outside_release :: fn() -> void {
    assert("-DNDEBUG" in cc_opt_flags(true), "a release build wraps a checked operation")
    assert(!("-DNDEBUG" in cc_opt_flags(false)), "a debug build checks it")
}

@test
test_lto_flags_gcc_link_names_its_job_count :: fn() -> void {
    link :: lto_flags(.Gcc, true, true, 6)
    assert("-flto=6" in link, "gcc's link line carries the job count it was given")
}
