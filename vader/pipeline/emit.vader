// vader/pipeline/emit — the native link.
//
// Bytecode → C → binary, monolithic: one C unit plus the external runtime, one
// `cc`. The split path (`--parallel`) stays in the CLI, which owns that flag;
// the monolithic build is the canonical one anyway (byte-identical, fully
// inlined).
//
// Here rather than in the CLI because a build driver has to be able to produce
// output, and re-implementing the link in every project is how flags drift —
// release opts, the runtime include path, `ldflags`. See the plan's §15
// (decision 13: the driver returns a binary).
//
// The CLI keeps its own `emit_c_source` / `prepared_module` pair: those carry
// its diagnostic renderer and its `.virt` input path, neither of which a driver
// wants. Only the link helpers moved.

module "vader/pipeline"

import "std/io"
import "std/path"
import "std/string"
import "std/process"
import "vader/diagnostics"
import "vader/resolver"
import "vader/bytecode"
import "vader/c_emit" { EmitOptions as CEmitOptions, default_emit_options as default_c_emit_options }

// Runtime root for `--target=native` linking — resolved next to the executable
// (dist bundle) then the cwd, via the shared `resolve_sidecar` probe (marker
// `vader.h`), so a bundled `vader` finds `runtime/c/` next to itself.
export runtime_c_root :: fn() = resolve_sidecar("runtime/c", "vader.h")
export cc_opt_flags :: fn(release: bool) -> string[] =
    if release { ["-std=c11", "-O3", "-DNDEBUG", "-falign-functions=64"] } else { ["-std=c11", "-O0", "-g"] }

// Append whitespace-split user `--ldflags` tokens to `argv` — no shell quoting
// (a path with spaces is a user bug).
export push_ldflags :: fn(argv: string[]!, ldflags: string) -> void {
    for tok in ldflags.trim().split(" ") {
        if tok != "" {
            argv.push(tok)
        }
    }
}

// Assemble the `cc` command line : runtime include + the emitted C unit + the
// external runtime unit, opt flags, any user `--ldflags`, then `-o <out> -lm`.
// `-lm` satisfies the runtime's `floor` / `fmod` on glibc ; no-op on macOS / MinGW.
export cc_argv :: fn(cc: string, c_file: string, out: Path, release: bool, ldflags: string) -> string[] {
    argv: string[]! = [cc]
    argv.push_all(cc_opt_flags(release))
    rt :: runtime_c_root()
    argv.push("-I")
    argv.push(rt)
    argv.push(c_file)
    argv.push("${rt}/vader_runtime.c")
    push_ldflags(argv, ldflags)
    argv.push("-o")
    argv.push(out.as_string())
    argv.push("-lm")
    return argv
}
// Write `content` to `path`, surfacing a write failure as exit 1.
export write_out :: fn(path: Path, content: string) -> i32 {
    wr :: write_file_string(path.as_string(), content)
    if wr is IOError {
        eprintln("vader build: cannot write `${path}`: ${wr.message()}")
        return 1
    }
    return 0
}

// ---- native output --------------------------------------------------------

/// Compile `file` all the way to a native binary.
///
/// The monolithic path — one C unit plus the external runtime, one `cc`. The
/// split path (`--parallel`) stays in the CLI, which owns that flag; the
/// monolithic build is the canonical one anyway, byte-identical and fully
/// inlined.
///
/// Diagnostics are RETURNED rather than printed: a build driver decides how to
/// surface them (and in what order), and the CLI already has its own renderer.
/// An empty list with a non-zero code means the failure was the link, not the
/// program — `cc`'s own output has already gone to stderr.
///
/// The generated `.c` is KEPT on a link failure and named in the message, so
/// the user can inspect what the compiler actually produced.
///
/// @param file           entry source.
/// @param out            binary to produce ; the C lands at `<out>.c`.
/// @param release        optimise, and drop `#line` from the emitted C.
/// @param cc             C compiler to invoke.
/// @param ldflags        raw linker flags, whitespace-split, appended verbatim.
/// @param include_paths  extra module search roots.
/// @return               `NativeBuild { code, diagnostics }` — `code` 0 on
///                       success, 1 otherwise.
export build_to_native :: fn(
    file: Path, out: Path, release: bool, cc: string, ldflags: string, include_paths: string[],
) -> NativeBuild {
    b :: prepare_cfg_bytecode_with(file, !release, include_paths)
    diags :: merge_diags(b.pre_diags, b.lower_diags)
    // Never emit for a program the front end rejected: the C emitter reads the
    // same bytecode tables and would produce something that links but is wrong.
    if any_error_diag(diags) {
        return NativeBuild { .code = 1, .diagnostics = diags }
    }
    c :: emit_c(b.module, CEmitOptions { .release = release, .entry_mangled = b.entry })
    return NativeBuild { .code = link_native(c, out, cc, release, ldflags), .diagnostics = diags }
}

/// Write `c` beside `out` and link it into a native binary.
///
/// The single link path: every caller that produces a native binary goes
/// through here, so the flags cannot drift between them — release opts, the
/// runtime include, `ldflags`, `-lm`. The generated `.c` is KEPT on failure and
/// named in the message, so the user can inspect what was actually produced.
///
/// @param c        the emitted C source.
/// @param out      binary to produce ; the C lands at `<out>.c`.
/// @param release  passed to the opt flags.
/// @param cc       C compiler to invoke.
/// @param ldflags  raw linker flags, appended verbatim.
/// @return         0 on success, 1 when the C could not be written or `cc`
///                 failed. `cc`'s own stderr is forwarded as-is.
export link_native :: fn(c: string, out: Path, cc: string, release: bool, ldflags: string) -> i32 {
    c_file :: "${out}.c".to_path()
    if write_out(c_file, c) != 0 {
        return 1
    }
    res :: spawn(cc_argv(cc, c_file.as_string(), out, release, ldflags))
    if res is ProcessError as pe {
        eprintln("vader build: ${pe.message()}")
        eprintln("(generated C kept at ${c_file})")
        return 1
    }
    if res.exit != 0 {
        eprintln("vader build: ${cc} failed (exit ${res.exit})")
        eprintln(res.stderr)
        eprintln("(generated C kept at ${c_file})")
        return 1
    }
    eprintln("vader build: wrote ${out} (and ${c_file})")
    return 0
}

/// Emit C from an ALREADY-BUILT bytecode module.
///
/// The seam a single-stream driver needs: it holds the `CfgBytecode` from its
/// own walk and must not re-run the pipeline to get the C.
///
/// @param cfg      bytecode plus the entry mangle it was built with.
/// @param release  optimise, and drop `#line`.
/// @return         the C source. Callers gate on `any_error_diag` first — this
///                 does not check, and emitting from a rejected program yields
///                 something that links but is wrong.
export c_source_of :: fn(cfg: CfgBytecode, release: bool) -> string =
    emit_c(cfg.module, CEmitOptions { .release = release, .entry_mangled = cfg.entry })

/// Compile `file` to C, without linking.
///
/// The other half of decision 13: a driver that wants to post-process the C — or
/// hand it to a toolchain this compiler knows nothing about — should not have to
/// go without. Mirrors `--target=c`.
///
/// @param file           entry source.
/// @param release        optimise, and drop `#line` from the emitted C.
/// @param include_paths  extra module search roots.
/// @return               `CBuild { source, diagnostics }` ; `source` is empty
///                       when the front end rejected the program, which the
///                       diagnostics explain.
export build_to_c :: fn(file: Path, release: bool, include_paths: string[]) -> CBuild {
    b :: prepare_cfg_bytecode_with(file, !release, include_paths)
    diags :: merge_diags(b.pre_diags, b.lower_diags)
    if any_error_diag(diags) {
        return CBuild { .source = "", .diagnostics = diags }
    }
    c :: emit_c(b.module, CEmitOptions { .release = release, .entry_mangled = b.entry })
    return CBuild { .source = c, .diagnostics = diags }
}

/// Outcome of `build_to_c`: the generated C, or "" with the diagnostics that
/// explain why there is none.
export CBuild :: struct {
    source:      string
    diagnostics: Diagnostic[]
}

/// Outcome of `build_to_native`: an exit code plus whatever the front end and
/// lowerer had to say, so the caller renders them in its own order.
export NativeBuild :: struct {
    code:        i32
    diagnostics: Diagnostic[]
}

// Front-end + lower diags in the canonical order the CLI renders them.
merge_diags :: fn(pre: Diagnostic[], lower: Diagnostic[]) -> Diagnostic[] {
    out: Diagnostic[]! = []
    for d in pre    { out.push(d) }
    for d in lower  { out.push(d) }
    return out
}
