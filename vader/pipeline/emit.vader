// vader/pipeline/emit — the native link.
//
// Bytecode → C → binary, monolithic: one C unit plus the external runtime, one
// `cc`. The split path (`--parallel`) stays in the CLI, which owns that flag;
// the monolithic build is the canonical one anyway (byte-identical, fully
// inlined).
//
// Here rather than in the CLI because a build driver has to be able to produce
// output, and re-implementing the link in every project is how flags drift —
// release opts, the runtime include path, `ldflags`. See the plan's §15
// (decision 13: the driver returns a binary).
//
// The CLI keeps its own `emit_c_source` / `prepared_module` pair: those carry
// its diagnostic renderer and its `.virt` input path, neither of which a driver
// wants. Only the link helpers moved.

module "vader/pipeline"

import "std/io"
import "std/path"
import "std/string"
import "std/process"
import "vader/diagnostics"
import "vader/resolver"
import "vader/bytecode"
import "vader/c_emit" { EmitOptions as CEmitOptions, default_emit_options as default_c_emit_options }

// Runtime root for `--target=native` linking — resolved next to the executable
// (dist bundle) then the cwd, via the shared `resolve_sidecar` probe (marker
// `vader.h`), so a bundled `vader` finds `runtime/c/` next to itself.
/// Directory holding the C runtime, for `--target=native` linking.
///
/// Beside the executable first (the `dist/` bundle layout), then the invocation
/// directory — the same sidecar probe the stdlib resolution uses.
export runtime_c_root :: fn() = resolve_sidecar("runtime/c", "vader.h")
/// Optimisation flags for the C compiler.
///
/// Release adds `-falign-functions=64`, measured as worth it on this codebase;
/// debug keeps `-O0 -g` so a `#line`-carrying build is steppable.
export cc_opt_flags :: fn(release: bool) -> string[] =
    if release { ["-std=c11", "-O3", "-DNDEBUG", "-falign-functions=64"] } else { ["-std=c11", "-O0", "-g"] }

// Compiler + `-std=c11` + optimisation flags — the single source of truth for
// codegen policy across the mono (`cc_argv`) and split (`cc_compile_argv`)
// builds, so they can't silently drift. `-falign-functions=64` keeps a hot
// loop's alignment stable against unrelated code growth (without it, adding a
// few lines to one runtime fn can shift e.g. `vader_array_push` onto a bad %64
// offset and slow its byte-identical loop ~1.6× — the arr_push regression ;
// +1.3 % binary, neutral on self-compile).

// Append whitespace-split user `--ldflags` tokens to `argv` — no shell quoting
// (a path with spaces is a user bug).
/// Append whitespace-split `--ldflags` tokens to a command line.
///
/// No shell quoting: a path with spaces is a user error, not something to guess
/// at.
///
/// @param argv     the command line being built, appended to in place.
/// @param ldflags  the raw flag string.
export push_ldflags :: fn(argv: string[]!, ldflags: string) -> void {
    for tok in ldflags.trim().split(" ") {
        if tok != "" {
            argv.push(tok)
        }
    }
}

// Assemble the `cc` command line : runtime include + the emitted C unit + the
// external runtime unit, opt flags, any user `--ldflags`, then `-o <out> -lm`.
// `-lm` satisfies the runtime's `floor` / `fmod` on glibc ; no-op on macOS / MinGW.
/// Assemble the `cc` command line for a native link.
///
/// Runtime include, the emitted unit, the runtime unit, opt flags, user
/// `ldflags`, then `-o <out> -lm`. `-lm` satisfies the runtime's `floor` /
/// `fmod` on glibc and is a no-op elsewhere.
/// @param runtime_root  directory holding `vader_runtime.c` + `vader.h`, or ""
///                      to probe beside the running executable. A build DRIVER
///                      must pass it: the driver binary lives under the
///                      project's `build/`, so the probe would look there.
export cc_argv :: fn(
    cc: string, c_file: string, out: Path, release: bool, ldflags: string, runtime_root: string,
) -> string[] {
    argv: string[]! = [cc]
    argv.push_all(cc_opt_flags(release))
    rt :: if runtime_root == "" { runtime_c_root() } else { runtime_root }
    argv.push("-I")
    argv.push(rt)
    argv.push(c_file)
    argv.push("${rt}/vader_runtime.c")
    push_ldflags(argv, ldflags)
    argv.push("-o")
    argv.push(out.as_string())
    argv.push("-lm")
    return argv
}
// Write `content` to `path`, surfacing a write failure as exit 1.
/// Write `content` to `path`, reporting a failure as exit 1.
///
/// @return 0 on success; 1 after printing why, so a caller can just propagate.
export write_out :: fn(path: Path, content: string) -> i32 {
    wr :: write_file_string(path.as_string(), content)
    if wr is IOError {
        eprintln("vader build: cannot write `${path}`: ${wr.message()}")
        return 1
    }
    return 0
}

// ---- native output --------------------------------------------------------

/// Write `c` beside `out` and link it into a native binary.
///
/// The single link path: every caller that produces a native binary goes
/// through here, so the flags cannot drift between them — release opts, the
/// runtime include, `ldflags`, `-lm`. The generated `.c` is KEPT on failure and
/// named in the message, so the user can inspect what was actually produced.
///
/// @param c        the emitted C source.
/// @param out      binary to produce ; the C lands at `<out>.c`.
/// @param release  passed to the opt flags.
/// @param cc       C compiler to invoke.
/// @param ldflags  raw linker flags, appended verbatim.
/// @return         0 on success, 1 when the C could not be written or `cc`
///                 failed. `cc`'s own stderr is forwarded as-is.
export link_native :: fn(
    c: string, out: Path, cc: string, release: bool, ldflags: string, runtime_root: string,
) -> i32 {
    c_file :: "${out}.c".to_path()
    if write_out(c_file, c) != 0 {
        return 1
    }
    res :: spawn(cc_argv(cc, c_file.as_string(), out, release, ldflags, runtime_root))
    if res is ProcessError as pe {
        eprintln("vader build: ${pe.message()}")
        eprintln("(generated C kept at ${c_file})")
        return 1
    }
    if res.exit != 0 {
        eprintln("vader build: ${cc} failed (exit ${res.exit})")
        eprintln(res.stderr)
        eprintln("(generated C kept at ${c_file})")
        return 1
    }
    // Report the file that EXISTS, not the `-o` we asked for: on Windows they
    // differ, and naming one the user cannot find is worse than naming the
    // platform's own convention.
    linked :: linked_binary(out.as_string()) ?? out.as_string()
    eprintln("vader build: wrote ${linked} (and ${c_file})")
    return 0
}

/// A linked executable as the LINKER named it, or null when none appeared.
///
/// `cc -o app` writes `app` on Unix and **`app.exe`** on Windows — gcc appends
/// the suffix when `-o` carries no extension, verified with mingw-w64. The stdlib
/// exposes no platform query, so rather than guess the suffix this asks the
/// filesystem which name turned up.
///
/// This does NOT make `vader build --out=app && ./app` portable, and no design
/// would: on Windows the artefact IS `app.exe`, because an extension-less file is
/// not executable there. What it fixes is the compiler claiming a name it did not
/// produce, and callers that assumed the bare one.
///
/// @param base  the `-o` path handed to the linker.
export linked_binary :: fn(base: string) -> string | null {
    if exists(base) {
        return base
    }
    with_exe :: "${base}.exe"
    if exists(with_exe) {
        return with_exe
    }
    return null
}

/// Default output name for an input: its path minus the recognised suffix.
///
/// What `vader build` derives when `--out` is absent, and what a driver gets
/// when it leaves `ctx.out` empty — the two must agree, which is why this lives
/// here rather than in either caller.
///
/// @param file  entry source, or a `.virt` bytecode dump.
/// @return      the path with `.vader` / `.virt` removed; unchanged otherwise.
export strip_input_suffix :: fn(file: Path) -> Path =
    if file.extension() == "virt" {
        file.as_string().trim_suffix(".virt").to_path()
    } else {
        file.as_string().trim_suffix(".vader").to_path()
    }

/// Emit C from an ALREADY-BUILT bytecode module.
///
/// The seam a single-stream driver needs: it holds the `CfgBytecode` from its
/// own walk and must not re-run the pipeline to get the C.
///
/// @param cfg      bytecode plus the entry mangle it was built with.
/// @param release  optimise, and drop `#line`.
/// @return         the C source. Callers gate on `any_error_diag` first — this
///                 does not check, and emitting from a rejected program yields
///                 something that links but is wrong.
export c_source_of :: fn(cfg: CfgBytecode, release: bool) -> string =
    emit_c(cfg.module, CEmitOptions { .release = release, .entry_mangled = cfg.entry })

