// vader/pipeline/backend: lower → bytecode, as a callable unit.
//
// `lower_to_entry` runs the front end and lowers; `prepare_cfg_bytecode_with` carries
// that through prune, the CFG passes (`vader/midir/pipeline`) and the bytecode
// emitter; `flush_build_diags` prints what they reported and says whether the
// result may be emitted. With them, the small helpers the chain reaches for
// (`entry_main_name`, `gather_pipeline_diags`, `in_scope_diag_files`,
// `dump_scope`, `scope_or_entry`, `canonicalise`, `module_name_from_file`).
//
// Every driver runs this one chain: the CLI (`vader/tools/cli`), a project's build
// driver (`toolchain/build`) and the bootstrap entry (`vader/bootstrap`). It
// imports none of them.

module "vader/pipeline"

import "std/io"
import "std/path"
import "vader/support/diagnostics"
import "vader/front/resolver"
import "vader/support/target"
import "vader/front/typecheck"
import "vader/core/types"
import "vader/lower"
import "vader/lower/dce"
import "vader/lower/ir"
import "vader/emit/bytecode"
import "vader/midir/pipeline"
import "vader/core/bytecode"
Prof :: import "vader/support/profile"
import "vader/support/opt_report"
import "vader/support/text"

/// Normalise a path to `/` separators.
///
/// Windows hands `\` paths; the resolver keeps `/` as its single internal
/// separator, so every path entering the pipeline passes through here.
export canonicalise :: fn(p: Path) -> Path = p.as_string().to_posix().to_path()
// Canonical `/`-separated form of a path that may have arrived with OS-native
// separators (Windows argv, env vars). `std/path::to_posix` deliberately works on
// the raw string — the compiler's internals are all string-based — so this is the
// one place the CLI does the Path → string → Path round trip.
/// The module filter to dump, defaulting to the entry's own module.
///
/// `--module=a,b` narrows a dump; with no filter the entry module alone is in
/// scope, which is what makes `dump` readable on a large project.
///
/// @param module_filter        the `--module` values, empty when absent.
/// @param entry_display_path   fallback scope: the entry's declared module name.
export scope_or_entry :: fn(module_filter: string[], entry_display_path: string) -> string[] {
    if module_filter.len() > 0 {
        return module_filter
    }
    return [entry_display_path]
}

// The display-path scope for a module-filtered dump : `--module` if given, else
// the entry module's own display path (so the dump shows the entry's subtree).
// `loaded.entry` is the entry FOLDER (the modules-map key), so look up its
// `LoadedModule` to recover the user-declared display path. See `module_in_scope`.
/// `scope_or_entry` resolved against a loaded project.
///
/// @param module_filter  the `--module` values, empty when absent.
/// @param loaded         supplies the entry's display path for the fallback.
export dump_scope :: fn(module_filter: string[], loaded: LoadedProject) -> string[] {
    entry_module :: loaded.modules[loaded.entry]
    entry_dp :: if entry_module is LoadedModule {
        entry_module.module.display_path
    } else {
        loaded.entry
    }
    return scope_or_entry(module_filter, entry_dp)
}

/// Mangled name of the entry module's `main`.
///
/// Resolved from the typed AST rather than from `is_main` flags: a multi-module
/// input can carry several `main`s (the compiler imports `vader/tools/lsp`, which has
/// its own), and only the entry module's counts.
///
/// @param typed  the typed project.
/// @param entry  the entry module's path key.
/// @return       `<module>$main`, or "" when the entry has no `main`.
export entry_main_name :: fn(typed: TypedProject, entry: string) -> string {
    tp :: typed.modules[entry] ?? return ""
    if "main" !in tp.resolved.fn_overloads {
        return ""
    }
    return "${mangle_module_id(tp.resolved.display_path)}\$main"
}

// Module name = the entry file's basename minus the `.vader` extension.
// `to_posix` first so the basename scan works on Windows `\` paths too.
/// Bytecode module name for an input: its basename without the extension.
export module_name_from_file :: fn(file: Path) -> string = canonicalise(file).name()

/// Source files of the modules within `scope`.
///
/// Lets a dump stage filter diagnostics to the code under inspection once the
/// `LoadedProject` has been released.
///
/// @param loaded  the loaded project.
/// @param scope   module display paths, from `dump_scope`.
export in_scope_diag_files :: fn(loaded: LoadedProject, scope: string[]) -> string[] {
    out: string[]: []
    for [id, lm] in loaded.modules {
        if module_in_scope(lm.module.display_path, scope) {
            for f in lm.module.files { out.push(f.path) }
        }
    }
    return out
}

/// Front-end diagnostics of a pipeline, flattened in canonical order.
///
/// Loader, then resolver, then typecheck, then comptime — the order every
/// renderer prints them in, so the flattening lives once rather than at each
/// call site.
export gather_pipeline_diags :: fn(pipeline: EvaluatedPipeline) -> Diagnostic[] {
    out: Diagnostic[]: []
    for d in pipeline.loaded.diags    { out.push(d) }
    for d in pipeline.resolver_diags  { out.push(d) }
    for d in pipeline.typecheck_diags { out.push(d) }
    for d in pipeline.comptime_diags  { out.push(d) }
    return out
}

/// Print the diagnostics of a prepared program to stderr and say whether it may be
/// emitted: an error stops it, a warning or a note prints and lets it through.
///
/// @param pre    the front end's diagnostics (`CfgBytecode.pre_diags`).
/// @param lower  the lowering's and the back end's (`CfgBytecode.lower_diags`).
export flush_build_diags :: fn(pre: Diagnostic[], lower: Diagnostic[]) -> bool {
    all :: pre + lower
    if all.len() > 0 {
        eprintln(all.dump_diagnostics_with_file())
    }
    return !any_error_diag(all)
}

/// CFG → `BytecodeModule`: the optimise-and-emit tail every real emit path runs.
///
/// Build the CFG and run the midir passes (`build_optimised_cfg`), then
/// bytecode emit. The profiling brackets are inert unless `$VADER_PROFILE`.
///
/// @param pruned  lowered project, already pruned of unreachable fns.
/// @param name    bytecode module name (see `module_name_from_file`).
/// @param opts    emit options — `want_debug` gates the per-op debug table.
/// @param diags   accumulator for what the CFG build reports (an identifier it
///                cannot place, M5007) and, under `passes.verify`, the verifier
///                findings. Required: a caller that dropped it would run a
///                program whose broken function was silently cut short.
/// @param passes  the CFG verifier and the bounds proof (`build_optimised_cfg`).
export cfg_to_bytecode :: fn(
    pruned: LoweredProject,
    name: string,
    opts: EmitOptions,
    diags: Diagnostic[],
    passes: CfgPassOptions = CfgPassOptions {},
) -> BytecodeModule {
    forwarded :: build_optimised_cfg(pruned, passes, diags)
    Prof.prof_begin(.Bytecode)
    module :: emit_bytecode_from_cfg(forwarded, name, opts)
    Prof.prof_end(.Bytecode)
    return module
}

// The environment variable of the bounds verification mode (`proves_bounds`).
VERIFY_BOUNDS_VAR :: "VADER_VERIFY_BOUNDS"

/// Whether `$VADER_VERIFY_BOUNDS` is set: a native build of any mode then marks
/// the accesses the range analysis proves, and keeps their index check under a
/// message of its own, so a wrong proof stops the run instead of reading out of
/// bounds.
export bounds_verification_enabled :: fn() -> bool = env_flag_set(VERIFY_BOUNDS_VAR)

/// A lowered project plus what the caller still needs after the pipeline is
/// released: the entry mangle, the diagnostics, and the file set for filtering.
export LoweredEntry :: struct {
    lowered:     LoweredProject
    /// Entry-fn mangle (`…$main`) for the `export main` directive — resolved
    /// from the typed AST before the pipeline is released.
    entry:       string
    /// Loader + resolver + typecheck + comptime diags, pre-flattened in the
    /// canonical order (`gather_pipeline_diags`).
    pre_diags:   Diagnostic[]
    lower_diags: Diagnostic[]
    /// Files of the modules in the entry's subtree — lets the bytecode / C dump
    /// stages filter diagnostics to the code under inspection once the
    /// `LoadedProject` is released. `build` ignores it (it surfaces all modules).
    in_scope_files: string[]
}

/// Run load → typecheck → comptime → lower, resolve the entry-fn name and
/// harvest the diagnostics, then return — letting the `EvaluatedPipeline` and
/// its per-module `MutableMap` side-tables leave scope before the caller's
/// CFG → bytecode tail. This is the live-set lever for `vader run` and
/// `dump --stage=bytecode|c` : the typecheck-era maps no longer coexist with
/// the emitter's own tables at the memory peak.
export lower_to_entry :: fn(file: Path, project_root: string | null) -> LoweredEntry =
    lower_to_entry_with(file, [], project_root)

/// Front end + lower, in one call.
///
/// The convenience over `lower_to_entry_from`: a caller with only a path, and no
/// reason to hold the evaluated pipeline itself.
///
/// @param file                entry source.
/// @param include_path_flags  extra module search roots.
/// @param project_root        the project the entry belongs to, null for a file
///                            on its own (`search_roots`).
/// @param target              platform to lower for ; this machine when null.
/// @param verify              run the IR verifiers between passes (`--verify`).
export lower_to_entry_with :: fn(
    file: Path, include_path_flags: string[], project_root: string | null,
    target: Target | null = null, verify: bool = false,
) -> LoweredEntry =
    lower_to_entry_from(
        prepare_evaluated_project_with(file, include_path_flags, project_root, target),
        verify,
    )

/// Lower an ALREADY-EVALUATED pipeline.
///
/// Split out so a caller holding a pipeline does not pay the front end twice —
/// which is ~45% of a build. `lower_to_entry_with` is this, preceded by the
/// front end.
///
/// @param pipeline  the evaluated project to lower.
/// @param verify    run the IR verifiers between passes (`--verify`).
export lower_to_entry_from :: fn(pipeline: EvaluatedPipeline, verify: bool = false) -> LoweredEntry {
    entry :: entry_main_name(pipeline.typed, pipeline.loaded.entry)
    pre_diags :: gather_pipeline_diags(pipeline)
    // Don't lower a program the front end rejected : feeding the bytecode
    // emitter an ill-typed shape (e.g. a UFCS method on an unimported
    // primitive) trips its `emit_bytecode_from_cfg` backstop panic before the
    // caller's `flush_build_diags` gate runs — a plain user error would ICE.
    lower_diags: Diagnostic[]: []
    // profiling bracket — inert unless $VADER_PROFILE (see prepare_evaluated_project_with).
    Prof.prof_begin(.Lower)
    lowered :: if any_error_diag(pre_diags) {
        new_lowered_project()
    } else {
        lower_project(pipeline.loaded, pipeline.typed, pipeline.evaluated, lower_diags)
    }
    Prof.prof_end(.Lower)
    if verify { verify_lowered(lowered, "lower_project", lower_diags) }
    return LoweredEntry {
        .lowered     = lowered,
        .entry       = entry,
        .pre_diags   = pre_diags,
        .lower_diags = lower_diags,
        .in_scope_files = in_scope_diag_files(pipeline.loaded, dump_scope([], pipeline.loaded)),
    }
}

/// Result of `prepare_cfg_bytecode_with`: the canonical bytecode module plus
/// the bits the caller still needs for diagnostics + entry resolution.
export CfgBytecode :: struct {
    /// Entry-fn mangle (`…$main`), resolved inside `lower_to_entry`.
    entry:       string
    /// Loader + resolver + typecheck + comptime diags, canonical order.
    pre_diags:   Diagnostic[]
    lower_diags: Diagnostic[]
    /// Entry-subtree file set for the dump diagnostic filter (see `LoweredEntry`).
    in_scope_files: string[]
    module:      BytecodeModule
}

/// Front end + lower + prune → CFG → bytecode, in one call.
///
/// @param file                entry source.
/// @param want_debug          populate the per-op debug table (kept only when
///                            the C emit will keep `#line`).
/// @param include_path_flags  extra module search roots.
/// @param project_root        the project the entry belongs to, null for a file
///                            on its own (`search_roots`).
/// @param target              platform to build for ; this machine when null.
/// @param verify              run the IR verifiers between passes (`--verify`).
/// @param prove_bounds        mark the accesses the range analysis proves in
///                            bounds (`proves_bounds`).
export prepare_cfg_bytecode_with :: fn(
    file: Path, want_debug: bool, include_path_flags: string[], project_root: string | null,
    target: Target | null = null, verify: bool = false, prove_bounds: bool = false,
) -> CfgBytecode =
    prepare_cfg_bytecode_from(
        lower_to_entry_with(file, include_path_flags, project_root, target, verify),
        file,
        want_debug,
        verify,
        prove_bounds,
    )

/// Carry an ALREADY-LOWERED entry through prune → CFG → bytecode.
///
/// Same reason as `lower_to_entry_from`: a caller that already lowered does not
/// re-run the front end to reach the bytecode.
///
/// @param le          the lowered entry ; the prune pass rewrites it.
/// @param file        entry path — names the bytecode module.
/// @param want_debug  populate the per-op debug table (kept only when the C
///                    emit will keep `#line`).
/// @param verify        run the IR verifiers between passes (`--verify`).
/// @param prove_bounds  mark the accesses the range analysis proves in bounds
///                      (`proves_bounds`).
export prepare_cfg_bytecode_from :: fn(
    le: LoweredEntry, file: Path, want_debug: bool, verify: bool = false,
    prove_bounds: bool = false,
) -> CfgBytecode {
    // profiling brackets — inert unless $VADER_PROFILE (see prepare_evaluated_project_with).
    Prof.prof_begin(.Prune)
    pruned :: prune_unreachable_fns(le.lowered, false)
    Prof.prof_end(.Prune)
    // The prune rewrites the decl set, so it gets its own check: a dropped
    // decl something still references is what `I7002` / `I7010` look for.
    back_end_diags: Diagnostic[]: []
    if verify { verify_lowered(pruned, "prune_unreachable_fns", back_end_diags) }
    // `want_debug` populates the per-op `debug` table only when the emitted C
    // will keep `#line` (non-release c-emit / `dump --stage=c --line-directives`) ; the VM /
    // bytecode-dump callers pass false to skip the per-op DebugPos alloc.
    opts :: EmitOptions {
        .optimize = true,
        .keep_mangles = [],
        .want_debug = want_debug,
    }
    passes :: CfgPassOptions { .verify = verify, .prove_bounds = prove_bounds }
    module :: cfg_to_bytecode(pruned, module_name_from_file(file), opts, back_end_diags, passes)
    lower_diags :: le.lower_diags + back_end_diags
    return CfgBytecode {
        .entry       = le.entry,
        .pre_diags   = le.pre_diags,
        .lower_diags = lower_diags,
        .in_scope_files = le.in_scope_files,
        .module      = module,
    }
}
