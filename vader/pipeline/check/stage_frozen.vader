// vader/pipeline/check/stage_frozen: the `frozen` check of a program.

module "vader/pipeline/check"

import "toolchain/diagnostics"
Fx :: import "vader/front/effects"

// The writes to frozen values the effect summary found.
Frozen :: struct {}

Frozen implements CheckStage {
    describe :: fn(self) = CheckSpec { .name = "frozen" }

    run :: fn(self, input: Checked) -> Diagnostic[] {
        effects :: input.program.effects else return []
        return Fx.frozen_diagnostics(effects)
    }
}
