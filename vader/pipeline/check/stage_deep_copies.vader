// vader/pipeline/check/stage_deep_copies: the `deep_copies` check of a program.

module "vader/pipeline/check"

import "toolchain/diagnostics"
Fx :: import "vader/front/effects"

// The deep copies the effect summary found unsound.
DeepCopies :: struct {}

DeepCopies implements CheckStage {
    describe :: fn(self) = CheckSpec { .name = "deep_copies" }

    run :: fn(self, input: Checked) -> Diagnostic[] {
        effects :: input.program.effects else return []
        result :: input.program.result else return []
        return Fx.deep_copy_diagnostics(effects, result)
    }
}
