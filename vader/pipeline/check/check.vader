// vader/pipeline/check — the typecheck of a project, and the checks that need it
// settled.
//
// Some checks read the whole typed program: the effect summary decides each array
// argument the typecheck widened (T3102, `vader/front/effects`), and which uses of a
// constant read a fresh value of it for the lowering. The typecheck cannot
// import the passes it feeds, so every client that checks a program, the CLI and
// the LSP alike, comes through here and reports the same diagnostics. A module of
// its own under the pipeline, so that the LSP takes it without the backend.

module "vader/pipeline/check"

import "std/collections"
import "std/iter"
import "vader/front/resolver"
import "vader/front/typecheck"
import "vader/support/diagnostics"
import "vader/support/target"

Fx :: import "vader/front/effects"

/// A typechecked project, with the effect summary the checks read.
export CheckedProject :: struct {
    result: CheckResult
    /// What every function does with what it is lent ; it also says which uses of
    /// a constant read a fresh value of it (`effects.fresh`).
    effects: Fx.EffectSummary
}

/// Typecheck every module of `project`, bodies included, then run the checks that
/// need the whole program typed.
///
/// @param project     the loaded project.
/// @param diags       where the diagnostics go, the typecheck's first.
/// @param dump_types  whether to fill the dump-only tables
///                    (`check_project_with_bodies`).
/// @return            the typed program and its effect summary.
export check_project :: fn(
    project: LoadedProject,
    diags: Diagnostic[],
    dump_types: bool,
) -> CheckedProject {
    result :: check_project_with_bodies(project, diags, dump_types)
    effects :: Fx.summarise_effects(project, result)
    diags.push_all(Fx.widening_diagnostics(effects, result))
    diags.push_all(Fx.frozen_diagnostics(effects))
    return CheckedProject { .result = result, .effects = effects }
}

/// The typed project the comptime engine and the lowering read: every typed
/// module, and the uses of constants the lowering must not share.
///
/// @param checked  the checked project.
export assemble_typed_project :: fn(checked: CheckedProject) -> TypedProject {
    project :: new_typed_project(checked.effects.fresh)
    result :: checked.result
    project.modules[result.typed.resolved.path] = result.typed
    // Every typed module the orchestrator built (entry, imports, std/*), so the
    // passes that query impls by trait see the ones std defines.
    if !result.all_modules.is_empty() {
        for [module_id, module_typed] in result.all_modules {
            project.modules[module_id] = module_typed
        }
        return project
    }
    // A single-module shortcut fills only `others`, which skips std/*.
    for other in result.others {
        project.modules[other.resolved.path] = other
    }
    return project
}

/// Load + typecheck one entry file, returning the project, the typed result,
/// and the *merged* diagnostic set (loader-time diagnostics first, then
/// typecheck diagnostics). This is the single source of truth shared by the
/// CLI typecheck stage and the LSP, so the editor never reports a diagnostic
/// the compiler wouldn't — and vice-versa. The only thing layered on top is the
/// LSP's per-file presentation filter (drop other files' spans).
export FileCheck :: struct {
    project: LoadedProject
    result: CheckResult
    /// The effect summary of the project (`CheckedProject.effects`).
    effects: Fx.EffectSummary
    /// Loader diagnostics (parse / discovery / import-path / collect) followed
    /// by typecheck diagnostics, in that order — the same merge the CLI's
    /// `dump --stage=typed-ast` performs.
    diags: Diagnostic[]
}

/// Load `entry_path` and run the full multi-module typecheck, merging every
/// diagnostic the pipeline produced.
///
/// @param entry_path   the entry file's filesystem path.
/// @param overlay      filesystem path → unsaved source text, consulted before
///                     the disk ; pass an empty map for on-disk CLI behaviour
///                     (`load_project_with_overlay(p, {})` ≡ `load_project(p)`).
/// @param project_root the project the entry belongs to, null for a file on its
///                     own (`search_roots`).
/// @param extra_seeds  modules to load and check beside what the entry imports
///                     (see `load_project_with_overlay`).
/// @return             the loaded project, the typed result, and the merged
///                     loader + typecheck diagnostics.
export check_file :: fn(
    entry_path: string,
    overlay: MutableMap<string, string>,
    include_path_flags: string[],
    project_root: string | null,
    dump_types: bool,
    selection: Selection | null = null,
    extra_seeds: string[] = [],
) -> FileCheck {
    project :: load_project_with_overlay(
        entry_path, overlay, include_path_flags, project_root, selection, extra_seeds,
    )
    diags: Diagnostic[]: []
    checked :: check_project(project, diags, dump_types)
    return FileCheck {
        .project = project,
        .result = checked.result,
        .effects = checked.effects,
        .diags = chain(project.diags, diags).collect(),
    }
}
