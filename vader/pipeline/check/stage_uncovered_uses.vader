// vader/pipeline/check/stage_uncovered_uses: the `uncovered_uses` check of a program.

module "vader/pipeline/check"

import "toolchain/diagnostics"
Fx :: import "vader/front/effects"

// The uses of a declaration the target being built leaves without a body.
UncoveredUses :: struct {}

UncoveredUses implements CheckStage {
    describe :: fn(self) = CheckSpec { .name = "uncovered_uses" }

    run :: fn(self, input: Checked) -> Diagnostic[] {
        effects :: input.program.effects else return []
        result :: input.program.result else return []
        return Fx.uncovered_use_diagnostics(effects, result)
    }
}
