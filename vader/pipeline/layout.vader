// vader/pipeline/layout: where a project build writes what it produces.
//
// A project's binaries go under `build/<profile>-<target>/`, so that a debug and
// a release build, or two targets, never overwrite each other, and its assets are
// copied beside them. Both kinds of project follow it: the driver's stream
// (`toolchain/build`) builds a `vader.json` project and a `build.vader` one
// alike.

module "vader/pipeline"

import "std/collections"
import "std/console"
import "std/fs"
import "std/io"
import "std/path"
import "std/string"
import "toolchain/diagnostics"
import "toolchain/span"
import "vader/front/resolver"
import "vader/support/target"

/// Where a driven build keeps the driver's own binary and C, relative to the
/// project root (`driver_dir`). Under `build/`, so the ignore rule that covers a
/// project's binaries covers its driver too.
export DRIVER_ARTEFACT_DIR :: "build/driver"

// Where a project keeps the adapter libraries of its interpreted runs
// (`ffi_adapters.vader`), relative to its root.
FFI_ADAPTER_DIR :: "build/ffi"

/// Where `vader doc` writes its data, under the project folder.
export DOC_DATA_DIR :: "build/doc"

/// Where `vader doc --search` writes the data of the toolchain's library, under
/// the project folder.
export DOC_LIBRARY_DATA_DIR :: "build/doc-lib"

/// Stamp recording what the cached driver binary was built from, beside it in
/// its `driver_dir`: rewritten each time the driver is compiled.
export DRIVER_STAMP_FILENAME :: "driver.stamp"

/// The folder of the project `dir`'s driver, always a debug build.
///
/// @param dir  the project folder.
/// @return     `<dir>/build/driver`.
export driver_dir :: fn(dir: string) -> string = dir.join_path(DRIVER_ARTEFACT_DIR)

/// Where the stamp of the project `dir`'s driver sits.
///
/// @param dir  the project folder.
export driver_stamp_path :: fn(dir: string) -> string =
    driver_dir(dir).join_path(DRIVER_STAMP_FILENAME)

/// The exit code of `vader info --no-driver-build` for a project whose driver
/// is not compiled, or compiled from another `build.vader` or compiler: nothing
/// is described, and nothing is wrong with the project. Never a driver's own
/// exit code: `vader info` reports any failure of the driver as 1.
export DRIVER_NOT_COMPILED_EXIT: i32: 3

/// The folder a project build writes its binaries to by default.
///
/// @param dir      the project folder.
/// @param release  whether the build is optimised, which names the profile.
/// @param target   the platform built for, the host when null.
/// @return         `<dir>/build/<debug|release>-<os>-<arch>`.
export project_output_dir :: fn(dir: string, release: bool, target: Target | null) -> string =
    dir.join_path("build/${profile_name(release)}-${target else host_target()}")

/// Where a project build writes the binary of one entry, before the linker adds
/// a `.exe`: its name, in `project_output_dir`.
///
/// @param dir      the project folder.
/// @param name     the entry's name, one `entry_name_problem` accepts: it is
///                 joined as a file name.
/// @param release  whether the build is optimised.
/// @param target   the platform built for, the host when null.
export project_entry_stem :: fn(
    dir: string,
    name: string,
    release: bool,
    target: Target | null,
) -> Path = Path(join_path(project_output_dir(dir, release, target), name))

// The profile a build is made with, as the output folder spells it.
profile_name :: fn(release: bool) -> string {
    if release {
        return "release"
    }
    return "debug"
}

/// Where a build writes the code the compiler wrote as source, under the project
/// folder: a diagnostic in that code points there.
export EXPANDED_DIR :: "build/expanded"

/// Write the code the compiler wrote as source for `b` under the `EXPANDED_DIR`
/// of its project, or else of the folder of `file`, and point each of its
/// diagnostics in that code at the file written. A file already holding the code
/// is left alone; one written for the same load that it no longer writes is
/// removed.
///
/// @param b             the prepared program; its diagnostics are repointed.
/// @param file          the entry.
/// @param project_root  the project of the entry, null for a file on its own.
export write_expanded :: fn(b: CfgBytecode, file: Path, project_root: string | null) -> void {
    root :: expansion_root(file, project_root)
    dir :: root.to_path().join(EXPANDED_DIR).normalize().as_string()
    written :: Map<string, string> {}
    names :: Set<string> {}
    for source in b.generated.sources {
        name :: expanded_name(source.file, root) else continue
        names.add(name)
        path :: dir.to_path().join(name).as_string()
        if !holds(path, source.content) && !write_text(path, source.content) {
            continue
        }
        written[source.file] = path
    }
    remove_stale(dir, names, expanded_origin_names(b.generated.origins, root))
    repoint(b.pre_diags, written)
    repoint(b.lower_diags, written)
}

// Remove each file of `dir` the compiler wrote, under a name of `owned` once its
// kind's folder is left out, that `names` no longer holds, then the folders that
// leaves empty. A file of another load, or that the compiler did not write, stays.
remove_stale :: fn(dir: string, names: Set<string>, owned: Set<string>) -> void {
    walker :: walk(dir) else return
    stale: string[]: []
    folders: string[]: []
    for e in walker {
        if e.kind == .Directory {
            folders.push(e.path)
            continue
        }
        if e.kind != .File || e.depth < 2 || e.relative in names {
            continue
        }
        slash :: e.relative.index_of('/') else continue
        if e.relative.byte_slice(slash + 1, e.relative.byte_len()) in owned && is_generated(e.path) {
            stale.push(e.path)
        }
    }
    if stale.is_empty() {
        return
    }
    for path in stale {
        failed :: remove(path) else is IOError {
            eprintln("vader build: cannot remove `${path.to_native()}`: ${failed.message()}")
            continue
        }
    }
    // Deepest first, as the walk lists a folder before what it holds: a folder
    // that still holds an entry is not removed.
    for i in 0..<folders.len() {
        remove(folders[folders.len() - 1 - i])
    }
}

// Whether the file `path` opens with the line the compiler writes first.
is_generated :: fn(path: string) -> bool {
    text :: read_file_string(path) else return false
    return text.starts_with(GENERATED_HEADER)
}

/// The folder whose `EXPANDED_DIR` holds the code the compiler writes for the
/// entry `file`: its project's, else the entry's own.
///
/// @param file          the entry.
/// @param project_root  the project of the entry, null for a file on its own.
export expansion_root :: fn(file: Path, project_root: string | null) -> string =
    project_root else entry_folder_of(file.as_string())

// Whether the file `path` holds `content`.
holds :: fn(path: string, content: string) -> bool {
    current :: read_file_string(path) else return false
    return current == content
}

// Write `content` to the file `path` and its missing folders: false after saying
// it could not.
write_text :: fn(path: string, content: string) -> bool {
    if !ensure_dir(path.to_path().parent().as_string()) {
        return false
    }
    failed :: write_file(path, content) else is IOError {
        eprintln("vader build: cannot write `${path.to_native()}`: ${failed.message()}")
        return false
    }
    return true
}

// Point each diagnostic of `diags` in a file `written` names at the file written
// for it.
repoint :: fn(diags: Diagnostic[], written: Map<string, string>) -> void {
    for i in 0..<diags.len() {
        d :: diags[i]
        path :: written[d.primary.start.file] else continue
        start :: Position { ...d.primary.start, .file = path }
        end :: Position { ...d.primary.end, .file = path }
        diags[i] = Diagnostic { ...d, .primary = Span { .start = start, .end = end } }
    }
}

/// Make the folder `path` when missing, with its missing parents.
///
/// @param path  the folder to make.
/// @return      false after saying it could not be made.
export ensure_dir :: fn(path: string) -> bool {
    made :: create_dir(path) else is IOError {
        eprintln("vader build: cannot create `${path.to_native()}`: ${made.message()}")
        return false
    }
    return true
}

// ---- assets ---------------------------------------------------------------

// The largest asset a build copies: a game's textures and sounds, not a
// stream with no end.
ASSET_READ_LIMIT: i64: 1024 * 1024 * 1024

/// Copy a project's assets beside its binaries.
///
/// Each asset is copied under the same relative path; a folder is copied with
/// everything it holds, and a copy at least as recent as its file is left alone.
/// An asset outside the project is refused earlier, by `read_manifest` for a
/// `vader.json` and by `add_asset` for a driver.
///
/// @param dir     the project folder the assets are relative to.
/// @param assets  the files and folders to copy.
/// @param into    the folder holding the binaries.
/// @return        false after saying which asset could not be copied.
export copy_assets :: fn(dir: string, assets: string[], into: string) -> bool {
    for asset in assets {
        source :: join_path(dir, asset)
        if !exists(source) {
            eprintln("vader build: asset `${asset}` does not exist in `${dir.to_native()}`")
            return false
        }
        target :: join_path(into, asset)
        if !ensure_dir(folder_of(Path(target))) || !refresh_copy(source, target) {
            return false
        }
    }
    return true
}

// Copy the file or folder `source` to `target`, whose folder exists. A copy at
// least as recent as its file is left alone. False after saying what could not
// be copied.
refresh_copy :: fn(source: string, target: string) -> bool {
    if is_dir(source) {
        if !ensure_dir(target) {
            return false
        }
        names :: read_dir(source) else {
            eprintln("vader build: cannot list `${source.to_native()}`: ${names.message()}")
            return false
        }
        for name in names {
            if !refresh_copy(join_path(source, name), join_path(target, name)) {
                return false
            }
        }
        return true
    }
    if is_up_to_date(target, source) {
        return true
    }
    bytes :: read_file_bytes(source, ASSET_READ_LIMIT) else {
        eprintln("vader build: cannot read `${source.to_native()}`: ${bytes.message()}")
        return false
    }
    written :: write_file(target, bytes) else is IOError {
        eprintln("vader build: cannot write `${target.to_native()}`: ${written.message()}")
        return false
    }
    return true
}

// Whether `copy` exists and was written no earlier than `original` changed.
is_up_to_date :: fn(copy: string, original: string) -> bool {
    copied :: modification_time(copy) else return false
    changed :: modification_time(original) else return false
    return copied >= changed
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_project_output_dir_names_profile_and_target :: fn() -> void {
    linux :: Target { .os = .Linux, .arch = .X86_64 }
    assert_eq(project_output_dir("app", true, linux), "app/build/release-linux-x86_64")
    host :: host_target().to_string()
    assert_eq(project_output_dir("app", false, null), "app/build/debug-${host}")
}

@test
test_driver_dir_sits_under_build :: fn() -> void {
    assert_eq(driver_dir("app"), "app/build/driver")
    assert_eq(driver_stamp_path("app"), "app/build/driver/driver.stamp")
}
