// vader/pipeline/driver_request: what a command asks of a driven build, and
// the project the build describes back.
//
// A command that finds a `build.vader` serves the build of its driver with
// this request; the driver itself learns only the mode (ADR 0148). A build
// run with `--describe` or `--prepare` writes the project as the driver
// described it, in the shape of a `vader.json`, to a file the command names
// and reads back at once: `vader info` shows it, and `run`, `dump`, `lint` and
// `graph` take their entry and the project's module search roots from it.

module "vader/pipeline"

import "std/env"
import "std/fs"
import "std/io"
import "toolchain/project"
import "vader/front/resolver"

/// A command's request to a driven build: what to do with the entries, and the
/// build options a `vader build` of a file would take.
export DriverRequest :: struct {
    mode: DriverMode = .Build
    /// The entry `--entry` names, empty for every entry.
    selected: string = ""
    /// Where a build run with `--describe` or `--prepare` writes the project.
    description: string = ""
    /// The build options; `project_root` names the project folder, and an
    /// empty `cc` the default C compiler.
    build: BuildRequest = BuildRequest {}
}

// ---- the project a driver describes --------------------------------------

/// Write the project a driver described, in the shape of a `vader.json`:
/// `includePaths` holds the module search roots as the driver declared them,
/// `entries` the entries chosen, `assets` the files to copy.
///
/// @param path     where the CLI asked for it.
/// @param project  the project as the driver declared it; its search roots may
///                 also sit under `$VADER_HOME`.
/// @error          the `IOError` of a file that could not be written.
export write_driver_description :: fn(path: string, project: Manifest) -> null | IOError =
    write_file(path, stringify_manifest(project))

/// The project a driver described.
///
/// @param path  where the driver wrote it.
/// @return      the project; its `problems` say what a malformed file gets
///              wrong.
/// @error       the `IOError` of a file the driver did not write.
export read_driver_description :: fn(path: string) -> Manifest | IOError {
    text :: read_file_string(path) else return text
    return parse_manifest(text)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_driver_description_reads_back_as_a_manifest :: fn() -> void {
    path :: join_path(temp_dir(), "vader_driver_description.json")
    project :: Manifest { .entries = [ManifestEntry { .name = "app", .path = "src/main.vader" }] }
    written :: write_driver_description(path, project)
    assert(written == null, "the project is written")
    read :: read_driver_description(path)
    remove(path)
    if read is IOError {
        assert(false, "the project reads back")
        return
    }
    assert_eq(read.problems.len(), 0)
    assert_eq(read.entries[0].name, "app")
}
