// vader/pipeline/frontend: the front end as a callable unit.
//
// `load → resolve + typecheck → comptime`, ending in an `EvaluatedPipeline` that
// carries every table a later stage or an observer needs. Lifted out of
// `vader/tools/cli/main.vader` unchanged: the CLI was its only caller, and a build
// driver (`toolchain/build`) needs the same sequence, so leaving it private would
// have forced a second implementation: the one thing guaranteed to drift.
//
// Sits below both callers in the import graph (`vader/tools/cli` and `toolchain/build`
// import this; it imports neither), so no cycle forms.

module "vader/pipeline"

import "std/collections"
import "std/path"
import "vader/support/diagnostics"
import "vader/front/resolver"
import "vader/support/target"
import "vader/front/typecheck"
import "vader/front/comptime"
import "vader/pipeline/comptime_vm"
import "vader/pipeline/check"
Prof :: import "vader/support/profile"

// Pipeline state shared by the comptime + lowerer dump stages : both
// run load → typecheck → comptime and only diverge on the final dump.
export EvaluatedPipeline :: struct {
    loaded:          LoadedProject
    typed:           TypedProject
    evaluated:       EvaluatedProject
    /// Body-walker diagnostics harvested from each `ResolvedModule.diags`.
    /// `check_project_with_bodies` already resolves every module ; this
    /// pipeline just collects the per-module bag so downstream stages
    /// surface the same `# Diagnostics` block as the resolver stage.
    resolver_diags:  Diagnostic[]
    typecheck_diags: Diagnostic[]
    comptime_diags:  Diagnostic[]
}

// Load, typecheck and evaluate `file`. The `--include-paths` search roots are
// threaded to the loader, beside the project the entry belongs to, null for a
// file compiled on its own (`search_roots`). `view` is what the load selects on:
// a build target, or null for this machine.
export prepare_evaluated_project_with :: fn(
    file: Path, include_path_flags: string[], project_root: string | null,
    view: Selection | null = null,
) -> EvaluatedPipeline {
    // Per-pass profiling brackets (here + in lower_to_entry_with /
    // prepare_cfg_bytecode_with / the C emit of `output.vader`). `prof_begin` / `prof_end` are
    // no-ops (one cached env check + early return) unless $VADER_PROFILE is
    // set, in which case the runtime accumulates the per-pass wall / RSS / GC
    // table dumped at the end of the compile. Kept in the pipeline so the
    // self-compile profile (`bun run bench:profile`) stays one flag away ; they
    // never read the clock when off and never touch the emitted output. See
    // vader/support/profile.
    Prof.prof_begin(.Load)
    loaded :: load_project(file.as_string(), include_path_flags, project_root, view)
    Prof.prof_end(.Load)
    typecheck_diags: Diagnostic[]: []
    Prof.prof_begin(.Typecheck)
    checked :: check_project(loaded, typecheck_diags, false)
    resolver_diags :: collect_body_diags(checked.result)
    Prof.prof_end(.Typecheck)
    comptime_diags: Diagnostic[]: []
    Prof.prof_begin(.Comptime)
    // The tree-walk `evaluate_project` always runs : it does the `@comptime`
    // dependency ordering (source of the C4009 cycle diagnostic), folds
    // tree-walkable `@comptime` decls, and force-loads std/core. Only the
    // VM-backed baking is gated on front-end errors: it emits the WHOLE project
    // to bytecode and runs it, which ICEs on the unresolved / malformed IR of a
    // front-end-errored program (a single prelude `@comptime` like std/core's
    // parse-float table would otherwise ICE every errored user compile). A
    // program with front-end errors never reaches codegen, so nothing to bake.
    evaluated :: evaluate_checked(loaded, checked, comptime_diags)
    Prof.prof_end(.Comptime)
    // Only bake when the project is error-free: front end AND comptime. The
    // VM-backed baking stages the WHOLE project to bytecode ; on a front-end-
    // errored program that ICEs on malformed IR, and on a program with a
    // comptime error (e.g. a C4009 `@comptime` dependency cycle) the staging
    // lower recurses on the un-baked cyclic consts and stack-overflows (SIGSEGV).
    // A broken program never reaches codegen, so there is nothing to bake.
    front_end_ok :: !any_error_diag(loaded.diags)
        && !any_error_diag(resolver_diags)
        && !any_error_diag(typecheck_diags)
    if front_end_ok && !any_error_diag(comptime_diags) {
        bake_deferred_values(file, include_path_flags, view, loaded, evaluated, comptime_diags)
    }
    return EvaluatedPipeline {
        .loaded          = loaded,
        .typed           = evaluated.typed,
        .evaluated       = evaluated,
        .resolver_diags  = resolver_diags,
        .typecheck_diags = typecheck_diags,
        .comptime_diags  = comptime_diags,
    }
}

// Bake the `@comptime` decls the tree-walk deferred to the VM
// (`vader/pipeline/comptime_vm`). The VM executes them on the machine the compiler
// runs on, so they need that machine's `@target` bodies: in a build for another OS, they
// run in a second front end that keeps the host's bodies and bakes the target's
// constants (`HostBodies`), whose values are copied into this build. Its own
// profile brackets sit beside this one's, never inside: the profiler pairs them.
bake_deferred_values :: fn(
    file: Path, include_path_flags: string[], view: Selection | null,
    loaded: LoadedProject, evaluated: EvaluatedProject, diags: Diagnostic[],
) -> void {
    if evaluated.vm_required.len() == 0 || view !is Target || view.os == host_target().os {
        bake_with_own_bodies(loaded, evaluated, diags)
        return
    }
    host :: prepare_evaluated_project_with(
        file, include_path_flags, loaded.project_root, HostBodies { .target = view },
    )
    // The host's bodies are another platform's code to this build, and `@target`
    // keeps their errors out of it. When they do not compile, the values are
    // staged with the target's bodies, which serve every value that reaches no
    // `@target` function.
    if any_error_diag(host.loaded.diags) || any_error_diag(host.resolver_diags)
        || any_error_diag(host.typecheck_diags) {
        bake_with_own_bodies(loaded, evaluated, diags)
        return
    }
    for d in host.comptime_diags {
        if d.severity == .Error {
            diags.push(d)
        }
    }
    copy_baked_values(host.evaluated, evaluated, diags)
}

// Bake the deferred values of `evaluated` on the VM, with the bodies `loaded`
// selected.
bake_with_own_bodies :: fn(loaded: LoadedProject, evaluated: EvaluatedProject, diags: Diagnostic[]) -> void {
    Prof.prof_begin(.Comptime)
    resolve_vm_required_decls(loaded, evaluated.typed, evaluated, diags)
    Prof.prof_end(.Comptime)
}

/// Drain non-entry modules' `resolved.diags` (body-walker output)
/// into one flat list. The entry module's R-codes are already
/// forwarded by `check_project_with_bodies` into `typecheck_diags`
/// (orchestrate.vader:163), so we'd double-fire if we pushed them
/// here too.
export collect_body_diags :: fn(result: CheckResult) -> Diagnostic[] {
    out: Diagnostic[]: []
    if result.all_modules.is_empty() { return out }
    for [module_id, module_typed] in result.all_modules {
        if module_id == result.typed.resolved.path { continue }
        for d in module_typed.resolved.diags { out.push(d) }
    }
    return out
}
