// vader/pipeline/ffi_adapters: the library of adapters an interpreted program
// calls C through, built once and kept.
//
// `vader/vm/adapters.vader` names the `@extern`s no trampoline of the
// interpreter covers, and `vader/emit/c/adapters.vader` writes an adapter for
// each. This compiles them into one shared library under
// `<project>/build/ffi/<fingerprint>/`, linked the way the interpreter would
// reach each symbol: a library's archives and `system` libraries, and the
// library the VM would open by `name` when it ships no archive. The fingerprint
// covers what the library is made of (the generated C, the command line, the
// archives, the headers, the compiler that wrote the C), so an unchanged
// program reuses its library, and a changed one never overwrites a library a
// running program holds: Windows refuses to replace a loaded DLL.
//
// Two processes may build the library of one fingerprint at once. Each builds
// in a folder of its own (`create_unique_dir`) and renames it to the
// fingerprint's: the rename of the first puts a whole library in place, and the
// others adopt it.

module "vader/pipeline"

import "crypto"
import "std/env"
import "std/fs"
import "std/io"
import "std/iter"
import "std/path"
import "std/process"
import "std/string"
import "std/target"
import "vader/core/bytecode"
import "vader/emit/c"
import "vader/front/resolver"
VM :: import "vader/vm"

/// Why the adapter library could not be built.
export AdapterBuildError :: struct {
    /// Worded to follow "the adapters", lowercase, no trailing period.
    message: string
}

/// Build the adapter library of the imports `adapted` of `module`, or find it
/// built.
///
/// @param module     the program.
/// @param adapted    the imports to adapt, not empty
///                   (`vader/vm/adapters.vader::adapted_imports`).
/// @param root       the project folder; the library goes under its `build/ffi/`.
/// @param cc         the C compiler (`cc_or_default`).
/// @param quote_dir  where a quoted `@c_header` resolves (`quote_include_dir`).
/// @return           the library's path.
/// @error            `AdapterBuildError` when an archive is missing, a file
///                   cannot be written, or `cc` cannot be started or fails.
export build_ffi_adapters :: fn(
    module: BytecodeModule, adapted: i64[], root: string, cc: string, quote_dir: string,
) -> string | AdapterBuildError {
    native :: native_flags(module)
    if native.missing.len() > 0 {
        return AdapterBuildError { .message = "cannot be built: ${missing_archive_message(native.missing[0])}" }
    }
    units :: emit_adapter_units(module, adapted)
    rt :: runtime_or_probe("")
    flags :: adapter_flags(cc, native, rt, quote_dir)
    links :: adapter_links(module, adapted, native)
    file :: "vader_adapters.${shared_library_extension()}"
    adapters :: root.join_path(FFI_ADAPTER_DIR)
    print :: fingerprint(units, flags, links, rt, quote_dir)
    kept :: adapters.join_path(print)
    if exists(kept.join_path(BUILT_MARK)) {
        return kept.join_path(file)
    }
    dir :: create_unique_dir(adapters, "${print}.") else {
        return AdapterBuildError {
            .message = "cannot be written under `${adapters.to_native()}`: ${dir.message()}",
        }
    }
    library :: dir.join_path(file)
    built :: dir.join_path(BUILT_MARK)
    // Kept out of the fingerprint: these flags refuse a library but never change
    // one, so the toolchain probe their spelling needs runs only when one compiles.
    argv :: flags + header_check_flags(cc_flavour(cc))
    for k in 0..<units.units.len() {
        source :: dir.join_path("${units.names[k]}.c")
        written :: write_file(source, units.units[k]) else is IOError {
            discard(dir)
            return AdapterBuildError { .message = "cannot be written to `${source.to_native()}`: ${written.message()}" }
        }
        argv.push(source)
    }
    argv.push_all(links)
    argv.push("-o")
    argv.push(library)
    compiled :: spawn(argv) else {
        discard(dir)
        why :: "${compiled.message()}\n${compiled.stderr}".trim()
        return AdapterBuildError { .message = "need a C compiler, and `${cc}` did not run: ${why}" }
    }
    // A library that does not compile keeps its folder: the message names it.
    if compiled.exit != 0 {
        _ :: remove(library)
        return AdapterBuildError { .message = "do not compile (`${cc}` exit ${compiled.exit}, sources in `${dir.to_native()}`):\n${compiled.stderr}" }
    }
    marked :: write_file(built, "") else is IOError {
        discard(dir)
        return AdapterBuildError { .message = "cannot be written to `${built.to_native()}`: ${marked.message()}" }
    }
    // The rename is what publishes the library, whole. It fails when the folder
    // is there already: another process published its own in the meantime, and
    // this one's is dropped for it.
    if publish(dir, kept) {
        return kept.join_path(file)
    }
    discard(dir)
    return AdapterBuildError { .message = "cannot be moved to `${kept.to_native()}`" }
}

// Give the folder `dir`, a library built whole, the name `kept`, or drop it for
// the one another process put there first. False when neither holds.
publish :: fn(dir: string, kept: string) -> bool {
    if rename(dir, kept) == null {
        return true
    }
    if exists(kept.join_path(BUILT_MARK)) {
        discard(dir)
        return true
    }
    // A folder published has its mark. One without is what a run cut short left
    // when libraries were built in place: nothing holds it.
    discard(kept)
    return rename(dir, kept) == null
}

// Remove the folder `dir` and what it holds, if it is there.
discard :: fn(dir: string) -> void {
    _ :: remove(dir, RemoveOptions { .recursive = true, .force = true })
}

// The file whose presence says the library of its folder is whole: written once
// the library is linked, before the folder takes its name.
BUILT_MARK :: "built"

// The command line of the adapter library, up to its sources.
adapter_flags :: fn(cc: string, native: NativeFlags, rt: string, quote_dir: string) -> string[] {
    argv: string[]: [cc, "-shared", "-O1"]
    if current_os() != .Windows {
        argv.push("-fPIC")
    }
    // An ELF linker leaves a symbol it cannot resolve to the loader; Mach-O and
    // PE refuse it. So does this, rather than cache a library that cannot open.
    if current_os() == .Linux {
        argv.push("-Wl,-z,defs")
    }
    push_include_flags(argv, rt, quote_dir)
    argv.push_all(native.includes)
    return argv
}

// What the adapter library links: the archives and `system` libraries of every
// binding, and, for an adapted import of a library that ships no archive, the
// library the interpreter would open by its name.
adapter_links :: fn(module: BytecodeModule, adapted: i64[], native: NativeFlags) -> string[] {
    links :: native.links.clone()
    for i in adapted {
        library :: module.imports[i].library else continue
        if library.archives.len() == 0 && library.name != "" && !("-l${library.name}" in links) {
            links.push("-l${library.name}")
        }
    }
    return links
}

// What the library is made of, hashed: its C and its command line, and the
// time of change of each archive it links, of each header it may include, and
// of the compiler that wrote the C.
fingerprint :: fn(units: AdapterUnits, flags: string[], links: string[], rt: string, quote_dir: string) -> string {
    parts: string[]: []
    parts.push_all(flags)
    parts.push_all(links)
    for k in 0..<units.units.len() {
        parts.push(units.names[k])
        parts.push(units.units[k])
    }
    stamped: string[]: [current_executable_location()]
    stamped.push_all(links.filter((link) -> !link.starts_with("-")).collect())
    dirs: string[]: [rt, quote_dir]
    dirs.push_all(include_dirs(flags))
    for dir in dirs {
        stamped.push_all(headers_in(dir))
    }
    for file in stamped {
        changed :: modification_time(file)
        if changed is i64 {
            parts.push("${file}@${changed}")
        }
    }
    return sha256(parts.join("\n"))[0..<16]
}

// The folders the `-I` flags of `flags` name.
include_dirs :: fn(flags: string[]) -> string[] {
    dirs: string[]: []
    for k in 1..<flags.len() {
        if flags[k - 1] == "-I" {
            dirs.push(flags[k])
        }
    }
    return dirs
}

// The headers directly inside the folder `dir`.
headers_in :: fn(dir: string) -> string[] {
    entries :: read_dir(dir) else return []
    return entries.filter((name) -> name.ends_with(".h")).map((name) -> dir.join_path(name)).collect()
}

// The extension the platform's loader expects of a shared library.
shared_library_extension :: fn() -> string = match current_os() {
    .Windows                  -> "dll"
    .Darwin                   -> "dylib"
    .Linux | .Wasi | .Browser -> "so"
}

/// Give `state` the adapters of its program, building them when it has any.
///
/// The library is kept under the `build/` of `project_root`, or of the folder of
/// `entry` for a file on its own; a quoted `@c_header` resolves from that folder
/// too.
///
/// @param state         the program, prepared to run.
/// @param project_root  the project folder, or null for a file on its own.
/// @param entry         the program's entry file.
/// @return              null on success, else why the program cannot run on the
///                      interpreter, worded to follow "vader <command>:".
export attach_ffi_adapters :: fn(
    state: VM.VmState,
    project_root: string | null,
    entry: Path,
) -> string | null {
    adapted :: VM.adapted_imports(state.bc)
    if adapted.len() == 0 {
        return null
    }
    entry_dir :: quote_include_dir(entry)
    built :: build_ffi_adapters(
        state.bc,
        adapted,
        project_root else entry_dir,
        cc_or_default(""),
        entry_dir,
    ) else is AdapterBuildError {
        imp :: state.bc.imports[adapted[0]]
        reason :: VM.adapter_reason(imp, state.bc.types) else ""
        return "extern `${imp.extern_name}` is called through an adapter (${reason}), and the adapters "
            + "${built.message}; or build the program with `vader build`"
    }
    return VM.attach_adapters(state, built, adapted)
}
