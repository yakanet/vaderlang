// vader/integer/interval — intervals of integers, computed without wrapping.
//
// An interval end may be open: below every `i64` for a lower end, past every
// `i64` for an upper one. Arithmetic on the ends opens them rather than
// wrapping, so an interval never holds fewer values than the computation it
// stands for. An open upper end may still be exact, up to `u64.max` : `hi_past`
// says how far past `i64.max` it lies, so that `u64` is `0..=u64.max` exactly.

module "vader/integer"

import "std/math"

// ---- intervals ------------------------------------------------------------

/// The integers from `lo` to `hi`, both included. An open end also holds the
/// extreme `i64` on its side, so that two equal intervals are equal field by
/// field ; an upper end past `i64` compares by `hi_past` (`upper_at_most`).
export Interval :: struct {
    lo: i64
    hi: i64
    /// Below every `i64`; `lo` is then `I64_MIN`.
    lo_open: bool = false
    /// Past every `i64`; `hi` is then `I64_MAX`.
    hi_open: bool = false
    /// With `hi_open`, how far past `i64.max` the upper end lies, from 1 up to
    /// `U64_MAX_PAST_I64` ; 0 for no upper end at all.
    hi_past: u64 = 0
}

// How far `u64.max` lies past `i64.max`.
U64_MAX_PAST_I64: u64: 0x8000_0000_0000_0000

/// The values of `u64`, `0..=u64.max` exactly.
export U64_VALUES :: Interval {
    .lo = 0,
    .hi = I64_MAX,
    .hi_open = true,
    .hi_past = U64_MAX_PAST_I64,
}

/// Every integer.
export ANY_INTEGER :: Interval {
    .lo = I64_MIN,
    .hi = I64_MAX,
    .lo_open = true,
    .hi_open = true,
}

ZERO :: Interval { .lo = 0, .hi = 0 }

/// The interval `lo..=hi`.
export interval :: fn(lo: i64, hi: i64) -> Interval = Interval { .lo = lo, .hi = hi }

/// The integers from `lo` up to `top`, a value up to `u64.max` : its upper end past
/// `i64` where `top` is.
///
/// @param lo   the least, within `i64`.
/// @param top  the greatest, at least `lo`.
export interval_up_to :: fn(lo: i64, top: u64) -> Interval {
    if top <= u64(I64_MAX) {
        return interval(lo, i64(top))
    }
    return Interval {
        .lo = lo,
        .hi = I64_MAX,
        .hi_open = true,
        .hi_past = top - u64(I64_MAX),
    }
}

/// The greatest value of `a`, its upper end past `i64` (`hi_open`), as a `u64` :
/// `u64.max` for an end with no bound.
///
/// @param a  an interval whose upper end is past `i64`.
export upper_past_i64 :: fn(a: Interval) -> u64 {
    if a.hi_past == 0 {
        return u64(I64_MAX) + U64_MAX_PAST_I64
    }
    return u64(I64_MAX) + a.hi_past
}

/// The interval from `lo` to `hi`, an absent end open.
export interval_from_ends :: fn(lo: i64 | null, hi: i64 | null) -> Interval = Interval {
    .lo = lo ?? I64_MIN,
    .hi = hi ?? I64_MAX,
    .lo_open = lo == null,
    .hi_open = hi == null,
}

/// Whether every value of `a` is a value of `outer`.
export interval_within :: fn(a: Interval, outer: Interval) -> bool =
    a.lo >= outer.lo && (outer.lo_open || !a.lo_open) && upper_at_most(a, outer)

/// Whether `a` and `b` hold the same integers.
export same_interval :: fn(a: Interval, b: Interval) -> bool =
    a.lo == b.lo && a.hi == b.hi && a.lo_open == b.lo_open && a.hi_open == b.hi_open
        && a.hi_past == b.hi_past

/// The smallest interval holding both `a` and `b`: what a value is after a join
/// of two paths.
export interval_join :: fn(a: Interval, b: Interval) -> Interval = Interval {
    ...greater_upper(a, b),
    .lo = lesser(a.lo, b.lo),
    .lo_open = a.lo_open || b.lo_open,
}

/// The integers both `a` and `b` hold: what a value is once a test proved both.
///
/// @return  null when they share none.
export interval_meet :: fn(a: Interval, b: Interval) -> Interval | null {
    lo :: greater(a.lo, b.lo)
    upper :: lesser_upper(a, b)
    if lo > upper.hi {
        return null
    }
    return Interval {
        ...upper,
        .lo = lo,
        .lo_open = a.lo_open && b.lo_open,
    }
}

/// Whether the upper end of `a` lies at or below that of `b` : a closed end by its
/// value, below every end past `i64`, these by how far past, below no end at all.
export upper_at_most :: fn(a: Interval, b: Interval) -> bool {
    if !a.hi_open {
        return b.hi_open || a.hi <= b.hi
    }
    if !b.hi_open {
        return false
    }
    return b.hi_past == 0 || a.hi_past != 0 && a.hi_past <= b.hi_past
}

// Of `a` and `b`, the one whose upper end lies the higher.
greater_upper :: fn(a: Interval, b: Interval) -> Interval {
    if upper_at_most(a, b) {
        return b
    }
    return a
}

// Of `a` and `b`, the one whose upper end lies the lower.
lesser_upper :: fn(a: Interval, b: Interval) -> Interval {
    if upper_at_most(a, b) {
        return a
    }
    return b
}

/// `set` without the integers `removed` holds : what a `match` leaves of its
/// scrutinee once an arm took `removed`.
///
/// @param set      disjoint closed intervals, the least first.
/// @param removed  a closed interval.
/// @return         the intervals left, disjoint, the least first.
export interval_remove :: fn(set: Interval[], removed: Interval) -> Interval[] {
    out: Interval[]: []
    for part in set {
        met :: interval_meet(part, removed)
        if met == null {
            out.push(part)
            continue
        }
        if part.lo < met.lo {
            out.push(interval(part.lo, met.lo - 1))
        }
        if met.hi < part.hi {
            out.push(interval(met.hi + 1, part.hi))
        }
    }
    return out
}

export lesser :: fn(a: i64, b: i64) -> i64 {
    if a <= b {
        return a
    }
    return b
}

export greater :: fn(a: i64, b: i64) -> i64 {
    if a >= b {
        return a
    }
    return b
}

// ---- arithmetic -----------------------------------------------------------

/// `a + b` over the integers, unwrapped: an end that leaves `i64` opens.
export interval_add :: fn(a: Interval, b: Interval) -> Interval = interval_from_ends(
    end_sum(a.lo, a.lo_open, b.lo, b.lo_open),
    end_sum(a.hi, a.hi_open, b.hi, b.hi_open),
)

/// `a - b` over the integers, unwrapped.
export interval_sub :: fn(a: Interval, b: Interval) -> Interval = interval_from_ends(
    end_difference(a.lo, a.lo_open, b.hi, b.hi_open),
    end_difference(a.hi, a.hi_open, b.lo, b.lo_open),
)

/// `-a` over the integers.
export interval_negate :: fn(a: Interval) -> Interval = interval_sub(ZERO, a)

/// `a * b` over the integers: the span of its four corner products, every integer
/// when an end is open or a corner leaves `i64`.
export interval_mul :: fn(a: Interval, b: Interval) -> Interval {
    if a.lo_open || a.hi_open || b.lo_open || b.hi_open {
        return ANY_INTEGER
    }
    p1 :: checked_mul(64, false, a.lo, b.lo) ?? return ANY_INTEGER
    p2 :: checked_mul(64, false, a.lo, b.hi) ?? return ANY_INTEGER
    p3 :: checked_mul(64, false, a.hi, b.lo) ?? return ANY_INTEGER
    p4 :: checked_mul(64, false, a.hi, b.hi) ?? return ANY_INTEGER
    return span_of(p1, p2, p3, p4)
}

/// `a / b` over the integers, truncated toward zero as `/` is : the span of the
/// quotients at the corners, `b`'s zero left out (a division by it stops the
/// program). Every integer when an end is open, `b` holds nothing but zero, or a
/// corner leaves `i64` (`i64.min / -1`).
export interval_div :: fn(a: Interval, b: Interval) -> Interval {
    if a.lo_open || a.hi_open || b.lo_open || b.hi_open {
        return ANY_INTEGER
    }
    below :: quotients_over(a, b.lo, lesser(b.hi, -1))
    above :: quotients_over(a, greater(b.lo, 1), b.hi)
    if below == null {
        return above ?? ANY_INTEGER
    }
    if above == null {
        return below
    }
    return interval_join(below, above)
}

// `a / b` for `b` within `lo..=hi`, a span holding no zero : null when it is empty.
quotients_over :: fn(a: Interval, lo: i64, hi: i64) -> Interval | null {
    if lo > hi {
        return null
    }
    if a.lo == I64_MIN && hi == -1 {
        return ANY_INTEGER
    }
    q1 :: a.lo / lo
    q2 :: a.lo / hi
    q3 :: a.hi / lo
    q4 :: a.hi / hi
    return span_of(q1, q2, q3, q4)
}

// The interval from the least of four values to the greatest : what an operation
// monotonic in each operand reaches, from its value at the corners.
span_of :: fn(a: i64, b: i64, c: i64, d: i64) -> Interval =
    interval(lesser(lesser(a, b), lesser(c, d)), greater(greater(a, b), greater(c, d)))

/// `a % b` over the integers, its sign the dividend's as `%` gives it : below
/// `b`'s greatest magnitude, and within `a` on the side its sign allows. Every
/// integer when an end is open or `b` reaches `i64.min`.
export interval_rem :: fn(a: Interval, b: Interval) -> Interval {
    if a.lo_open || a.hi_open || b.lo_open || b.hi_open || b.lo == I64_MIN {
        return ANY_INTEGER
    }
    largest :: greater(abs(b.lo), abs(b.hi)) - 1
    if largest < 0 {
        return ANY_INTEGER
    }
    lo :: greater(lesser(a.lo, 0), -largest)
    hi :: lesser(greater(a.hi, 0), largest)
    return interval(lo, hi)
}

// `x + y` for two ends on one side: null, the end open, when either is or the
// sum leaves `i64`.
end_sum :: fn(x: i64, x_open: bool, y: i64, y_open: bool) -> i64 | null {
    if x_open || y_open {
        return null
    }
    return checked_add(64, false, x, y)
}

// `x - y` for an end `x` and an end `y` of the other side, null as `end_sum`.
end_difference :: fn(x: i64, x_open: bool, y: i64, y_open: bool) -> i64 | null {
    if x_open || y_open {
        return null
    }
    return checked_sub(64, false, x, y)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_interval_join_meet_within :: fn() -> void {
    a :: interval(0, 5)
    b :: interval(3, 9)
    assert(same_interval(interval_join(a, b), interval(0, 9)), "join")
    met :: interval_meet(a, b) ?? ANY_INTEGER
    assert(same_interval(met, interval(3, 5)), "meet")
    assert(interval_meet(interval(0, 1), interval(2, 3)) == null, "disjoint")
    assert(interval_within(interval(1, 2), a), "within")
    assert(!interval_within(b, a), "not within")
    assert(interval_within(a, ANY_INTEGER), "within any")
}

@test
test_interval_open_ends_against_i64 :: fn() -> void {
    whole_i64 :: interval(I64_MIN, I64_MAX)
    assert(interval_within(whole_i64, ANY_INTEGER), "i64 within any")
    assert(!interval_within(ANY_INTEGER, whole_i64), "any is past i64")
    joined :: interval_join(whole_i64, ANY_INTEGER)
    assert(same_interval(joined, ANY_INTEGER), "join opens")
    met :: interval_meet(whole_i64, ANY_INTEGER) ?? ANY_INTEGER
    assert(same_interval(met, whole_i64), "meet closes")
}

@test
test_interval_add_opens_past_i64 :: fn() -> void {
    assert(same_interval(interval_add(interval(0, 9), interval(1, 1)), interval(1, 10)), "shift")
    past :: interval_add(interval(0, I64_MAX), interval(1, 1))
    assert(past.hi_open && past.lo == 1, "upper end opens past i64.max")
    under :: interval_sub(interval(I64_MIN, 0), interval(1, 1))
    assert(under.lo_open && under.hi == -1, "lower end opens below i64.min")
}

@test
test_interval_sub_reaches_i64_max :: fn() -> void {
    diff :: interval_sub(interval(-5, -1), interval(I64_MIN, 0))
    assert(same_interval(diff, interval(-5, I64_MAX)), "-1 - i64.min is i64.max")
}

@test
test_interval_negate_least_i64 :: fn() -> void {
    n :: interval_negate(interval(I64_MIN, 5))
    assert(n.hi_open && n.lo == -5, "-i64.min opens")
}

@test
test_interval_mul_corners :: fn() -> void {
    assert(
        same_interval(interval_mul(interval(-2, 3), interval(4, 5)), interval(-10, 15)),
        "corners",
    )
    big :: interval_mul(interval(0, I64_MAX), interval(2, 2))
    assert(same_interval(big, ANY_INTEGER), "overflowing corner")
}

@test
test_interval_div_truncates_and_skips_zero :: fn() -> void {
    assert(same_interval(interval_div(interval(0, 23), interval(2, 2)), interval(0, 11)), "halves")
    assert(
        same_interval(interval_div(interval(-7, 7), interval(2, 3)), interval(-3, 3)),
        "toward zero",
    )
    around_zero :: interval_div(interval(10, 20), interval(-2, 5))
    assert(same_interval(around_zero, interval(-20, 20)), "zero left out")
    assert(same_interval(interval_div(interval(1, 5), interval(0, 0)), ANY_INTEGER), "only zero")
    least :: interval_div(interval(I64_MIN, 0), interval(-1, -1))
    assert(same_interval(least, ANY_INTEGER), "i64.min / -1")
}

@test
test_interval_rem_takes_the_dividend_sign :: fn() -> void {
    assert(
        same_interval(interval_rem(interval(0, 100), interval(24, 24)), interval(0, 23)),
        "hours",
    )
    assert(same_interval(interval_rem(interval(0, 5), interval(24, 24)), interval(0, 5)), "below")
    signed :: interval_rem(interval(-50, 50), interval(-7, 7))
    assert(same_interval(signed, interval(-6, 6)), "either sign")
    assert(
        same_interval(interval_rem(interval(-9, -1), interval(4, 4)), interval(-3, 0)),
        "negative",
    )
}

@test
test_interval_within_rejects_an_end_with_no_bound :: fn() -> void {
    u8_iv :: interval(0, 255)
    assert(interval_within(interval(1, 10), u8_iv), "fits")
    assert(!interval_within(interval(250, 260), u8_iv), "leaves the type")
    plus_one :: interval_add(U64_VALUES, interval(1, 1))
    assert(!interval_within(plus_one, U64_VALUES), "u64.max + 1 is past u64")
}

@test
test_interval_up_to_closes_within_i64 :: fn() -> void {
    assert(same_interval(interval_up_to(3, 9), interval(3, 9)), "within i64")
    assert(same_interval(interval_up_to(0, u64(I64_MAX)), interval(0, I64_MAX)), "at i64.max")
    assert(same_interval(interval_up_to(0, 18_446_744_073_709_551_615), U64_VALUES), "u64")
    assert_eq(upper_past_i64(U64_VALUES), 18_446_744_073_709_551_615)
}

@test
test_interval_upper_end_past_i64 :: fn() -> void {
    past_by_one :: Interval {
        .lo = 0,
        .hi = I64_MAX,
        .hi_open = true,
        .hi_past = 1,
    }
    assert(interval_within(past_by_one, U64_VALUES), "i64.max + 1 within u64")
    assert(!interval_within(U64_VALUES, past_by_one), "u64 past i64.max + 1")
    assert(interval_within(U64_VALUES, ANY_INTEGER), "u64 within every integer")
    assert(!interval_within(ANY_INTEGER, U64_VALUES), "every integer past u64")
    assert(same_interval(interval_join(past_by_one, U64_VALUES), U64_VALUES), "join")
    met :: interval_meet(past_by_one, U64_VALUES) ?? ANY_INTEGER
    assert(same_interval(met, past_by_one), "meet")
    assert(!same_interval(past_by_one, U64_VALUES), "two ends past i64 differ")
}

@test
test_interval_remove_splits_a_part :: fn() -> void {
    left :: interval_remove([interval(0, 23)], interval(5, 9))
    assert_eq(left.len(), 2)
    assert(same_interval(left[0], interval(0, 4)), "the part below")
    assert(same_interval(left[1], interval(10, 23)), "the part above")
}

@test
test_interval_remove_drops_a_covered_part :: fn() -> void {
    left :: interval_remove([interval(0, 3), interval(8, 9)], interval(0, 5))
    assert_eq(left.len(), 1)
    assert(same_interval(left[0], interval(8, 9)), "only the part out of reach stays")
}
