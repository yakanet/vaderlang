// vader/text/text — low-level byte/text helpers shared across the compiler.
//
// Byte-level ASCII predicates over raw `bytes()` views — name mangling
// (`c_emit`, `comptime`) and identifier-boundary scans (`lsp`) — plus small
// dump/text helpers. Distinct from `std/char` (codepoint-typed) and from the
// lexer's `is_ident_start` / `is_ident_continue`, which classify `char`.

module "vader/text"

// `std/string` for the `chars` free fn `for c in s` lowers to — the impl has to
// be in THIS module's closure, not merely somewhere in the program.
import "std/math"
import "std/string"
import "std/string_builder"

/// Identifier byte — `[A-Za-z0-9_]` (regex `\w`). The byte-level classifier
/// for raw UTF-8 / ASCII `bytes()` views ; bytes outside the class are what
/// `sanitise`-style helpers replace with `_`.
export is_ident_byte :: fn(b: u8) = (b >= 'A' && b <= 'Z') || (b >= 'a' && b <= 'z')
    || (b >= '0' && b <= '9') || b == '_'

/// JSON-style simple escape : wrap `s` in double quotes and escape `"`, `\`,
/// `\n`, `\t`, `\r`. Walks by codepoint so multi-byte UTF-8 passes through
/// unchanged (byte-walking would synthesise U+FFFD on continuation bytes).
/// Shared by the lexer and lower dump formatters.
///
/// @param s  the raw string to quote.
/// @return   `s` wrapped in `"…"` with the five C/JSON escapes applied.
export quote_simple :: fn(s: string) -> string {
    sb :: StringBuilder {}
    sb.append_char('"')
    for c in s {
        if c == '"' { sb.append("\\\"") }
        else if c == '\\' { sb.append("\\\\") }
        else if c == '\n' { sb.append("\\n") }
        else if c == '\t' { sb.append("\\t") }
        else if c == '\r' { sb.append("\\r") }
        else { sb.append_char(c) }
    }
    sb.append_char('"')
    return sb.to_string()
}

/// `text` as a Markdown code span: fenced by more backticks than its longest run
/// of them, and padded with a space where it starts or ends with one.
///
/// @param text  the code, on one line.
export code_span :: fn(text: string) -> string {
    fence :: "`".repeat(longest_backtick_run(text) + 1)
    if text.starts_with("`") || text.ends_with("`") {
        return "${fence} ${text} ${fence}"
    }
    return "${fence}${text}${fence}"
}

longest_backtick_run :: fn(text: string) -> usize {
    longest: usize = 0
    run: usize = 0
    for i in 0..<text.byte_len() {
        if text.byte_at(i) == '`' {
            run += 1
            longest = max(longest, run)
        } else {
            run = 0
        }
    }
    return longest
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_code_span_plain :: fn() -> void {
    assert_eq(code_span("@comptime N = 1"), "`@comptime N = 1`")
}

@test
test_code_span_fences_past_backticks :: fn() -> void {
    assert_eq(code_span("got `==` here"), "``got `==` here``")
}

@test
test_code_span_pads_an_edge_backtick :: fn() -> void {
    assert_eq(code_span("`x`"), "`` `x` ``")
}
