// vader/effects — what each function does with what it is lent.
//
// The summary of a function says, per parameter, what the function may do below
// the value a caller lends it (`effect.vader`): assign a slot, resize an array,
// keep the value past the call, return it. It is computed once, after the
// typecheck, as the smallest fixed point over the call graph (`vader/fixpoint`):
// each function's body is read once into constraints (`walk.vader`), evaluated
// against its callees' summaries until none moves.

module "vader/effects"

import "std/collections"
import "std/iter"
import "vader/fixpoint"
import "vader/resolver"
import "vader/typecheck"

/// The most sweeps one strongly connected component of the call graph may take.
/// A component still moving then is set to any effects at all.
SWEEP_CAP: i32: 64

/// What every function of a project does with what it is lent.
export EffectSummary :: struct {
    index: CalleeIndex
    /// Per node of `index`, one set per parameter.
    facts: ParamEffects[][]
    /// The nodes whose component had not settled at the cap.
    unsettled: i32[]
    /// What the program does with its frozen values (`frozen.vader`).
    frozen: FrozenSite[]
    /// The uses of constants that read a fresh value, for the lowering.
    fresh: FreshReads
    /// The arguments the typecheck widened, and whether their callees allow it
    /// (`variance.vader`).
    widenings: WideningSite[]
}

/// Summarise every function of a checked project.
///
/// @param project  the loaded project, whose declarations hold the bodies.
/// @param checked  its typecheck, with every module's record of calls.
export summarise_effects :: fn(project: LoadedProject, checked: CheckResult) -> EffectSummary {
    index :: index_functions(project, checked.all_modules)
    frozen :: FrozenSites {}
    widenings: PendingWidening[]: []
    skeletons: Skeleton[]: []
    facts: ParamEffects[][]: []
    successors: i32[][]: []
    for node in 0..<index.functions.len() {
        f :: index.functions[node]
        s :: skeleton_of(f.decl, f.typed, index, frozen, widenings, i32(node))
        skeletons.push(s)
        facts.push(s.params.filled(() -> ParamEffects {}))
        successors.push(callee_nodes(s))
    }
    graph :: Graph { .successors = successors }
    components :: component_of_each_node(graph)
    clock :: Clock {
        .grew_at = successors.len().filled(() -> 0),
        .evaluated_at = successors.len().filled(() -> 0),
    }
    step :: (node: i32) -> {
        if !clock.has_news(node, successors[node]) {
            return false
        }
        ctx :: node_ctx(facts, index.paths, components, node)
        return clock.noted(node, settle(skeletons[node], ctx))
    }
    unsettled :: solve_bottom_up(graph, step, SWEEP_CAP)
    for node in unsettled {
        for i in 0..<facts[node].len() {
            facts[node][i] = any_effects()
        }
    }
    note_initialisers(index, frozen, widenings)
    settle_frozen(frozen, facts, index.paths, components)
    return EffectSummary {
        .index = index,
        .facts = facts,
        .unsettled = unsettled,
        .frozen = frozen.sites,
        .fresh = frozen.fresh,
        .widenings = settle_widenings(widenings, facts, index.paths),
    }
}

// Walk what the program evaluates outside a function: each constant's initialiser,
// for the calls it hands a frozen value to, and each field default, which every
// struct built without that field keeps.
note_initialisers :: fn(
    index: CalleeIndex,
    frozen: FrozenSites,
    widenings: PendingWidening[],
) -> void {
    for c in index.constants {
        ctx :: initialiser_ctx(index, frozen, widenings, c, true)
        ctx.discard(c.value)
        ctx.note_frozen_body(-1)
    }
    for d in index.defaults {
        ctx :: initialiser_ctx(index, frozen, widenings, d, false)
        ctx.escape(ctx.value(d.value), .Stored)
        ctx.note_frozen_body(-1)
    }
}

// A walk of `init`, whose own constraints nothing reads.
initialiser_ctx :: fn(
    index: CalleeIndex,
    frozen: FrozenSites,
    widenings: PendingWidening[],
    init: Initialiser,
    in_constant: bool,
) -> WalkCtx! = WalkCtx {
    .s = new_skeleton(0),
    .typed = init.typed,
    .index = index,
    .frozen = frozen,
    .widenings = widenings,
    .in_constant = in_constant,
}

// What evaluating node `node` reads: the facts, the paths, and its component.
node_ctx :: fn(facts: ParamEffects[][], paths: PathTable, components: i32[], node: i32) -> EvalCtx =
    EvalCtx {
        .facts = facts,
        .paths = paths,
        .components = components,
        .node = node,
    }

// The nodes the calls of `s` may run.
callee_nodes :: fn(s: Skeleton) -> i32[] {
    out: i32[]: []
    for site in s.sites {
        for target in site.targets {
            if target is CalleeNode {
                out.push(target.node)
            }
        }
    }
    return out
}

// When each node's fact last grew and when it was last evaluated, on one clock
// that starts at 1: a node none of whose callees grew since its last evaluation
// has nothing new to read, and its step can stop there.
Clock :: struct {
    now: i64 = 0
    grew_at: i64[]!
    /// 0 for a node never evaluated.
    evaluated_at: i64[]!
}

// Whether `node`, whose calls run `callees`, may find its fact moved.
has_news :: fn(clock: Clock, node: i32, callees: i32[]) -> bool {
    last :: clock.evaluated_at[node]
    return last == 0 || callees.any_match((c) -> clock.grew_at[c] > last)
}

// Record that `node` was evaluated now, and grew when `grew` says so ; `grew`.
noted :: fn(clock: Clock, node: i32, grew: bool) -> bool {
    clock.now += 1
    clock.evaluated_at[node] = clock.now
    if grew {
        clock.now += 1
        clock.grew_at[node] = clock.now
    }
    return grew
}

// Add to the fact of `ctx.node` what its body does against its callees' facts ;
// true when it grew. A fact still empty takes the fresh set as it is.
settle :: fn(s: Skeleton, ctx: EvalCtx) -> bool {
    fresh :: evaluate(s, ctx)
    grew := false
    for i in 0..<fresh.len() {
        if ctx.facts[ctx.node][i].accesses.len() == 0 {
            ctx.facts[ctx.node][i] = fresh[i]
            if fresh[i].accesses.len() > 0 {
                grew = true
            }
        } else if ctx.paths.include_all(ctx.facts[ctx.node][i], fresh[i]) {
            grew = true
        }
    }
    return grew
}

// Per node of `g`, the index of its strongly connected component.
component_of_each_node :: fn(g: Graph) -> i32[] {
    out :: g.successors.len().filled(() -> 0)
    components :: components_bottom_up(g)
    for c in 0..<components.len() {
        for node in components[c] {
            out[node] = i32(c)
        }
    }
    return out
}
