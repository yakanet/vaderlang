// vader/effects/callees — what a call may run, as targets of the fixed point.
//
// The typecheck records what each call settles on (`call_sites.vader`, ADR 0056).
// A function with a body is a node of the call graph. A bodyless one does what
// the compiler knows of it: an intrinsic by `intrinsic_effects`, an `@extern` by
// its `@c_out` parameters. A member reached through a trait is the member of that
// name in every impl of the trait, the whole program being compiled. A function
// value, or a site the record could not settle, may do anything.

module "vader/effects"

import "std/collections"
import "std/iter"
import "vader/resolver"
import "vader/typecheck"
import "vader/types"

AST :: import "toolchain/ast"

/// The functions of a project: the nodes of the call graph, and what each
/// bodyless function does.
export CalleeIndex :: struct {
    /// Per node, the function and the module that typed it.
    functions: Function[]! = []
    /// Declaration id → node, for each function with a body.
    nodes: MutableMap<usize, i32>! = MutableMap<usize, i32> {}
    /// Declaration id → what a bodyless function does.
    bodyless: MutableMap<usize, CallTarget>! = MutableMap<usize, CallTarget> {}
    /// The declarations of the intrinsics that hand back a frozen view
    /// (`makes_frozen_view`).
    frozen_views: MutableSet<usize>! = MutableSet<usize> {}
    /// Every module constant's initialiser, which may hand a frozen value on.
    constants: Initialiser[]! = []
    /// Every struct field default, which every struct built without the field keeps.
    defaults: Initialiser[]! = []
    /// The impls of every module, each resolved in the module that declares it.
    impls: ImplRegistry! = ImplRegistry {}
    /// Every path the summary names.
    paths: PathTable! = PathTable {}
    /// The loaded project, whose modules hold the symbols a namespace alias names.
    project: LoadedProject
    /// `trait_key.member` → the members of that name of every impl of the trait.
    members: MutableMap<string, CallTarget[]>! = MutableMap<string, CallTarget[]> {}
    /// Bodyless functions the compiler knows nothing of while they are lent a value
    /// that holds references: each is assumed to do anything with it.
    unknown: string[]! = []
}

/// A function with a body.
export Function :: struct {
    decl: AST.FnDecl
    typed: TypedProgram
}

/// A value the program evaluates outside a function, a constant's initialiser or
/// a field default, and the module that typed it.
export Initialiser :: struct {
    value: AST.Expr
    typed: TypedProgram
    /// The symbol id of the constant it initialises ; null for a field default.
    initialises: i32 | null = null
}

/// Index every function of `project`, and the impls of every module: the
/// typecheck's own registry holds the entry module's alone.
///
/// @param project  the loaded project, whose declarations hold the bodies.
/// @param modules  the typed modules, by the same key as `project.modules`.
index_functions :: fn(
    project: LoadedProject, modules: MutableMap<string, TypedProgram>,
) -> CalleeIndex! {
    index :: CalleeIndex { .project = project }
    for [id, loaded] in project.modules {
        typed :: modules[id] ?? continue
        for file in loaded.module.files {
            index.impls.collect_impls(file.program.decls, typed.resolved)
            for d in file.program.decls {
                match d {
                    is AST.FnDecl     -> { index.register(d, typed) }
                    is AST.ImplDecl   -> {
                        for member in d.members {
                            index.register(member, typed)
                        }
                    }
                    is AST.ConstDecl  -> {
                        sym :: loaded.collected.symbols[d.name] ?? continue
                        initialiser :: Initialiser {
                            .value = d.value,
                            .typed = typed,
                            .initialises = sym.id,
                        }
                        index.constants.push(initialiser)
                    }
                    is AST.StructDecl -> { index.register_defaults(d, typed) }
                    _                 -> {}
                }
            }
        }
    }
    return index
}

// Note each default of `decl`'s fields.
register_defaults :: fn(index: CalleeIndex, decl: AST.StructDecl, typed: TypedProgram) -> void {
    for field in decl.fields {
        value :: field.default ?? continue
        index.defaults.push(Initialiser { .value = value, .typed = typed })
    }
}

// Make `decl` a node when it has a body, else note what it does.
register :: fn(index: CalleeIndex, decl: AST.FnDecl, typed: TypedProgram) -> void {
    if decl.body != null {
        index.nodes[decl.id] = i32(index.functions.len())
        index.functions.push(Function { .decl = decl, .typed = typed })
        return
    }
    index.bodyless[decl.id] = index.bodyless_target(decl, typed)
}

// What the bodyless `decl` does: an `@extern` writes what `@c_out` marks, an
// intrinsic what the table says ; one the table omits does nothing to a parameter
// that holds no references, and anything to one that does.
bodyless_target :: fn(index: CalleeIndex, decl: AST.FnDecl, typed: TypedProgram) -> CallTarget {
    if AST.decorators_have(decl.decorators, "extern") {
        return KnownEffects { .params = decl.params.map(foreign_effects).collect() }
    }
    key :: index.intrinsic_key(decl, typed)
    if makes_frozen_view(key) {
        index.frozen_views.add(decl.id)
    }
    known :: intrinsic_effects(index.paths, key)
    if known != null {
        return KnownEffects { .params = known }
    }
    if decl.params.all_match((p) -> !holds_references(typed.param_types[p.span.hash()])) {
        return KnownEffects { .params = decl.params.map((_) -> none()).collect() }
    }
    index.unknown.push(key)
    return AnyCallee {}
}

// C reads a parameter of an `@extern`, and writes one marked `@c_out`.
foreign_effects :: fn(p: AST.FnParam) -> ParamEffects {
    if AST.decorators_have(p.decorators, "c_out") {
        return effects_of(.Assigned, EVERYWHERE)
    }
    return none()
}

// The key of a bodyless function in `intrinsic_effects`: `trait_key.member` for a
// member of an impl, `module.name` for a free function.
intrinsic_key :: fn(index: CalleeIndex, decl: AST.FnDecl, typed: TypedProgram) -> string {
    entry :: index.impls.member_entry(decl)
    if entry != null {
        return "${entry.trait_key}.${decl.name}"
    }
    return "${typed.resolved.display_path}.${decl.name}"
}

// Whether a value of type `t` may reach something a function could change, as the
// typecheck asks it of a `!` (`is_value_only_type`) ; true when the type is not
// known.
holds_references :: fn(t: Type | null) -> bool {
    known :: t ?? return true
    return !is_value_only_type(known)
}

// ---- targets --------------------------------------------------------------

/// What a call to `callee` may run ; empty for one that runs nothing, a cast or a
/// numeric operator.
///
/// @param index   the project's functions.
/// @param callee  what the record says the call invokes.
targets_of :: fn(index: CalleeIndex, callee: Callee) -> CallTarget[] = match callee {
    is DirectFn    -> index.direct_targets(callee)
    is BoundMember -> index.member_targets(callee.trait_key, callee.member)
    is TraitMember -> index.member_targets(callee.trait_key, callee.member)
    is EachOf      -> each_targets(index, callee.callees)
    is Builtin     -> []
    is FnValue | ErroneousCallee | UnsettledCallee -> [AnyCallee {}]
}

// A direct call runs its declaration ; one chosen against a type parameter runs, at
// an instance, the impl of that instance's own type, which may be any impl's
// member of that name.
direct_targets :: fn(index: CalleeIndex, callee: DirectFn) -> CallTarget[] {
    own :: index.target_of_decl(callee.decl)
    if !callee.per_instance {
        return [own]
    }
    entry :: index.impls.member_entry(callee.decl) ?? return [own]
    out: CallTarget[]: [own]
    out.push_all(index.member_targets(entry.trait_key, callee.decl.name))
    return out
}

each_targets :: fn(index: CalleeIndex, callees: Callee[]) -> CallTarget[] =
    callees.flat_map((c) -> index.targets_of(c)).collect()

// What running `decl` does: its node, or what it does without a body. A
// declaration the index never met (a trait's own member) may do anything.
target_of_decl :: fn(index: CalleeIndex, decl: AST.FnDecl) -> CallTarget {
    node :: index.nodes[decl.id]
    if node != null {
        return CalleeNode { .node = node }
    }
    return index.bodyless[decl.id] ?? AnyCallee {}
}

// The member `member` of every impl of the trait `trait_key`. An impl that lacks it
// runs the trait's default, which the index does not hold: it may do anything.
member_targets :: fn(index: CalleeIndex, trait_key: string, member: string) -> CallTarget[] {
    key :: "${trait_key}.${member}"
    cached :: index.members[key]
    if cached != null {
        return cached
    }
    out: CallTarget[]: []
    for entry in index.impls.all {
        if entry.trait_key != trait_key {
            continue
        }
        decl :: entry.decl.members.find((m) -> m.name == member)
        if decl == null {
            out.push(AnyCallee {})
        } else {
            out.push(index.target_of_decl(decl))
        }
    }
    index.members[key] = out
    return out
}

// ---- intrinsics -----------------------------------------------------------

/// What an intrinsic does with each of its parameters, by its key
/// (`trait_key.member`, or `module.name` for a free function) ; null for one the
/// compiler lists no effects for. A parameter the table leaves empty is only read.
///
/// @param paths  the summary's paths.
/// @param key    the intrinsic's key.
intrinsic_effects :: fn(paths: PathTable, key: string) -> ParamEffects[] | null {
    elements :: paths.path_to(ELEMENT)
    array_ops :: core_trait_key(@type_name(ArrayOps))
    // `ByteAccess` is private to `std/core`: no name to take its key from.
    byte_access :: core_trait_key("ByteAccess")
    if key == "${array_ops}.len"             { return [none()] }
    if key == "${array_ops}.push"            { return push_effects(ROOT) }
    if key == "${array_ops}.push_all"        { return push_effects(elements) }
    if key == "${array_ops}.copy_to"         { return copy_to_effects(elements) }
    if key == "${array_ops}.remove_last"     { return [remove_last_effects(elements)] }
    if key == "${array_ops}.clear"           { return [effects_of(.Shrunk, ROOT)] }
    if key == "${byte_access}.load_u8"       { return [none(), none()] }
    if key == "${byte_access}.store_u8"      { return writes_bytes(elements) }
    if key == "${byte_access}.memory_copy"   { return memory_copy_effects(elements) }
    if key == "${byte_access}.intern_string" { return [none(), none()] }
    if key == "${byte_access}.write_string"  { return writes_bytes(elements) }
    if key == "std/core.bytes_to_string"     { return [none()] }
    if key == "vader/vm.ffi_call"            { return ffi_call_effects(elements) }
    return null
}

// `self.push(value)` and `self.push_all(other)`: `self` grows, and keeps the value
// at `kept` below the argument (the value itself, or the elements of `other`).
push_effects :: fn(kept: i32) -> ParamEffects[] =
    [effects_of(.Resized, ROOT), effects_of(.Stored, kept)]

// `store_u8` and `write_string` write bytes of `self`.
writes_bytes :: fn(elements: i32) -> ParamEffects[] =
    [effects_of(.Assigned, elements), none(), none()]

/// Whether the intrinsic of key `key` hands back a view of a frozen value: the
/// bytes of a string, which alias the interned string (ADR 0053).
///
/// @param key  the intrinsic's key, as `intrinsic_effects` takes it.
makes_frozen_view :: fn(key: string) -> bool = key == "std/core.bytes"

// `self.copy_to(src_off, dst, dst_off, count)`: `self`'s elements go into `dst`.
copy_to_effects :: fn(elements: i32) -> ParamEffects[] =
    [effects_of(.Stored, elements), none(), effects_of(.Assigned, elements), none(), none()]

// `self.remove_last()` shortens `self` and hands back the element it removed.
remove_last_effects :: fn(elements: i32) -> ParamEffects {
    effects :: effects_of(.Shrunk, ROOT)
    effects.insert(Access { .path = elements, .effect = .Returned })
    return effects
}

// `self.memory_copy(d, src, s, n)` writes bytes of `self`, read from `src`.
memory_copy_effects :: fn(elements: i32) -> ParamEffects[] =
    [effects_of(.Assigned, elements), none(), none(), none(), none()]

// `ffi_call(fn_ptr, desc, frame, nfixed)`: the foreign function writes its result
// into `frame`.
ffi_call_effects :: fn(elements: i32) -> ParamEffects[] =
    [none(), none(), effects_of(.Assigned, elements), none()]

none :: fn() -> ParamEffects = ParamEffects {}

// The single access `effect` at `path`.
effects_of :: fn(effect: Effect, path: i32) -> ParamEffects! {
    effects :: ParamEffects {}
    effects.insert(Access { .path = path, .effect = effect })
    return effects
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_intrinsic_effects_push_resizes_and_stores :: fn() -> void {
    effects :: intrinsic_effects(PathTable {}, "${core_trait_key(@type_name(ArrayOps))}.push") ?? []
    assert_eq(effects.len(), 2)
    assert(effects[0].accesses[0].effect == .Resized, "push resizes its receiver")
    assert(effects[1].accesses[0].effect == .Stored, "push keeps its value")
}

@test
test_intrinsic_effects_unknown_key :: fn() -> void {
    assert(intrinsic_effects(PathTable {}, r"std_core$Nothing.here") == null, "an unlisted key")
}

@test
test_holds_references_of_a_value :: fn() -> void {
    assert(!holds_references(TY_BOOL), "bool")
    assert(holds_references(mk_array(TY_BOOL, false)), "bool[]")
    assert(holds_references(null), "an unknown type")
}
