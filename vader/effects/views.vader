// vader/effects/views — the views of a string's bytes, which nothing copies.
//
// `s.bytes()` hands out a view of the string's own bytes. A string is never
// modified, so neither is the view, and no copy is made of it as one is of a
// module constant bound to a name (`frozen.vader`). What holds a view, a use or a
// binding, may read it, lend it to a reader and return it. Written, or lent to a
// callee that modifies it, it is a fault ; kept, or handed to code the summary
// cannot see, it is kept: each is an error that asks for `.clone()`.
//
// A function that returns a view hands one out, as `bytes()` does. Once the facts
// are settled, the bodies that call one are walked again with those calls as
// views, until no new function returns one. A view adds a root and no constraint
// on a parameter: the settled facts stay as they are.

module "vader/effects"

import "std/collections"
import "std/iter"
import "vader/typecheck"
import "vader/types"

// What a root that holds a view comes to, if anything. Its elements are bytes:
// one kept or returned is a value, not the view.
view_outcome :: fn(c: RootCase) -> FrozenKind | null {
    fault :: c.fault_of((a) -> writes_view(c.paths, a))
    if fault != null {
        return fault
    }
    if c.either((a) -> is_the_view(a) && keeps(a)) {
        return .KeptView
    }
    if c.returns_it() {
        return .ReturnedView
    }
    return null
}

// Whether `a` modifies a view the root may hold.
writes_view :: fn(paths: PathTable, a: Access) -> bool = modifies(a) && reaches_view(paths, a)

// Whether `a` keeps what the root holds where the summary no longer follows it:
// handed to unseen code, or stored. A constant's initialiser that stores a view
// keeps it too: a fresh read of the constant would run it again, a new view.
keeps :: fn(a: Access) -> bool = is_unknown(a) || a.effect == .Stored

// Whether the body returns the view itself. A callee that returns it hands it back
// to the body, which decides.
returns_it :: fn(c: RootCase) -> bool =
    c.marked.any_match((a) -> a.effect == .Returned && is_the_view(a))

// Whether `a` acts on the view itself rather than on its bytes.
is_the_view :: fn(a: Access) -> bool = a.path == ROOT || a.path == EVERYWHERE

// Whether `a` may reach the view: not below a narrowing to a type no byte array is
// (`narrowed`).
reaches_view :: fn(paths: PathTable, a: Access) -> bool = !paths.first_step_is(a.path, NARROWED)

// Whether a binding that took the use `h` holds it, not a part of it below a
// narrowing to a type no byte array is.
reaches :: fn(paths: PathTable, h: Root) -> bool = !paths.first_step_is(h.path, NARROWED)

// Whether a value of type `t` may be a byte array, as a view is.
may_hold_bytes :: fn(t: Type | null) -> bool = match t {
    is ArrayType    -> may_be_byte(t.element)
    is UnionType    -> t.variants.any_match(may_hold_bytes)
    is DistinctType -> may_hold_bytes(t.backing)
    is TraitType | TypeParamType | SelfType | AnyType | UnresolvedType | null -> true
    is InferVar -> leaked_infer_var(t)
    is StructType | TupleType | PrimitiveType | EnumType | RangeType | FnType | TypeMetaType
     | FreeIntType | FreeFloatType | FreeCharType | NeverType -> false
}

// Whether a value of type `t` may be a byte, the element of a view.
may_be_byte :: fn(t: Type) -> bool = match t {
    // A range of other bounds than `u8`'s takes no byte by inclusion : no
    // container converts.
    is PrimitiveType | RangeType -> primitive_name(t) == "u8"
    is UnionType     -> t.variants.any_match(may_be_byte)
    is DistinctType  -> may_be_byte(t.backing)
    is TraitType | TypeParamType | SelfType | AnyType | UnresolvedType -> true
    is InferVar -> leaked_infer_var(t)
    is StructType | TupleType | ArrayType | EnumType | FnType | TypeMetaType
     | FreeIntType | FreeFloatType | FreeCharType | NeverType -> false
}

// Whether `r` is a use of a view.
is_view :: fn(r: FrozenRoot) -> bool = r.binding == null && r.origin == .View

// Whether one of the uses `c` holds is a view.
holds_view :: fn(c: RootCase) -> bool =
    c.held.any_match((h) -> c.body.root_record(h.param).is_view())

// Whether a call of `callee` hands back a view: `bytes()`, or a function found to
// return one.
makes_view :: fn(index: CalleeIndex, callee: Callee) -> bool {
    if callee is DirectFn && callee.decl.id in index.frozen_views {
        return true
    }
    if index.view_nodes.is_empty() {
        return false
    }
    return index.targets_of(callee).any_match(
        (t) -> t is CalleeNode && t.node in index.view_nodes,
    )
}

// How a site names the call that makes a view.
view_label :: fn(callee: Callee) -> string = match callee {
    is DirectFn -> "${callee.decl.name}()"
    is BoundMember | TraitMember -> "${callee.member}()"
    is FnValue | EachOf | Builtin | ErroneousCallee | UnsettledCallee -> "a call"
}

// ---- functions that return a view -----------------------------------------

/// Make each function that returns a view hand views out, and walk again the
/// bodies that call one, until no new function returns a view.
///
/// @param index       the functions ; `view_nodes` grows.
/// @param frozen      the bodies that use a frozen value ; those walked again are
///                    replaced.
/// @param skeletons   per node, its skeleton ; those walked again are replaced.
/// @param facts       the settled facts.
/// @param components  per node, its strongly connected component.
/// @param successors  per node, the nodes its calls may run.
spread_views :: fn(
    index: CalleeIndex,
    frozen: FrozenSites,
    skeletons: Skeleton[],
    facts: ParamEffects[][],
    components: i32[],
    successors: i32[][],
) -> void {
    found := view_returners(index, frozen, facts, components)
    for !found.is_empty() {
        for node in found {
            index.view_nodes.add(node)
        }
        for caller in callers_of(successors, found) {
            f :: index.functions[caller]
            again :: FrozenSites {}
            dropped: PendingWidening[]: []
            skeletons[caller] = skeleton_of(f.decl, f.typed, index, again, dropped, caller)
            for body in again.bodies {
                frozen.replace_body(body)
            }
        }
        found = view_returners(index, frozen, facts, components)
    }
}

// The nodes not yet known to hand views out whose body returns one.
view_returners :: fn(
    index: CalleeIndex,
    frozen: FrozenSites,
    facts: ParamEffects[][],
    components: i32[],
) -> i32[] {
    out: i32[]: []
    for body in frozen.bodies {
        if body.node < 0 || body.node in index.view_nodes || !body.roots.any_match(is_view) {
            continue
        }
        ctx :: body_ctx(body, facts, index, components)
        effects :: evaluate_roots(body.skeleton, ctx)
        for r in body.roots {
            c :: root_case(body, r, effects, index.paths) ?? continue
            if c.holds_view() && c.returns_it() {
                out.push(body.node)
                break
            }
        }
    }
    return out
}

// The nodes some call of which may run one of `nodes`.
callers_of :: fn(successors: i32[][], nodes: i32[]) -> i32[] {
    wanted :: MutableSet<i32> {}
    for node in nodes {
        wanted.add(node)
    }
    out: i32[]: []
    for caller in 0..<successors.len() {
        if successors[caller].any_match((node) -> node in wanted) {
            out.push(i32(caller))
        }
    }
    return out
}

// Put `body` in the place of the body of its node, if there is one.
replace_body :: fn(frozen: FrozenSites, body: FrozenBody) -> void {
    for i in 0..<frozen.bodies.len() {
        if frozen.bodies[i].node == body.node {
            frozen.bodies[i] = body
            return
        }
    }
    frozen.bodies.push(body)
}
