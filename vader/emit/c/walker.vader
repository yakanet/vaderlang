// vader/emit/c/walker: a bytecode function body, emitted as C.
//
// The per-op emission core of the C emitter: `emit_functions` drives one C
// definition per `BcFunction` ; `function_definition` walks the op stream
// against a `FnState` (see `stack.vader`), then assembles the signature, the
// local and temporary declarations and the body ; `emit_op` is the exhaustive
// per-op dispatch. Each op family lives in a sibling file of the module:
// `value_ops`, `control_flow`, `closures`, `type_ops`, `structs`, `buffers`,
// `array_slots` and `arrays` ; `may_alloc` decides which functions may collect.

module "vader/emit/c"

import "vader/core/bytecode"
import "vader/emit/c/ast"
// The opcode union pulls in ~120 names ; the namespace form keeps the
// import to one line and tags every op site as `Bc.<Op>` at the match.
Bc :: import "vader/core/bytecode"

/// Per-fn body emit: one C function definition per `BcFunction`, printed as
/// soon as it is built. Delegates to `function_definition`, which
/// walks the op stream against a `FnState` ; `emit_op` is the exhaustive
/// per-op dispatch with a real arm for every `Op` variant.
emit_functions :: fn(ctx: EmitCtx, printer: CPrinter) -> void {
    fns :: ctx.module.functions
    for i in 0..<fns.len() {
        printer.print_item(function_definition(ctx, i32(i), fns[i]))
    }
}

/// One C function definition. Walks the bytecode body op by op into `s.root`,
/// with a deduped `#line` directive before each op whose source position
/// differs from the previous one, then assembles a `CFunction`
/// : the prologue (local + temp declarations, then the GC frame, for a fn
/// that `needs_frame`) above the body.
function_definition :: fn(ctx: EmitCtx, fn_index: i32, function: BcFunction) -> CFunction {
    // Temps are discovered during the walk (materialisation), and their
    // declarations belong in the prologue *above* the body : walk first, then
    // assemble the prologue.
    s :: new_fn_state(ctx, fn_index, function)
    s.scopes = precompute_scopes(function)
    bt :: precompute_branch_targets(function, s.scopes)
    s.continue_targets = bt.continue_targets
    s.break_targets = bt.break_targets
    last_line: i32 = -1
    last_file: string = ""
    for i in 0..<function.body.len() {
        op :: function.body[i]
        // A `call` / `call.import` whose non-void result is dropped immediately
        // was emitted as a bare statement (see `emit_call_result`): the result
        // was never pushed, so skip the paired `drop` rather than pop a live
        // value. The preceding call already invalidated the header cache.
        if s.drop_call_result && op is Bc.Drop {
            s.drop_call_result = false
            continue
        }
        // Positions are recorded only when `#line` is wanted (`want_debug`), so a
        // null entry is the whole switch.
        dbg :: function.debug[i]
        if dbg != null {
            if dbg.line != last_line || dbg.file != last_file {
                directive(s, "#line ${dbg.line} ${c_string_lit(dbg.file)}")
                last_line = dbg.line
                last_file = dbg.file
            }
        }
        // Look ahead : a value-returning direct call consumed by the next op's
        // `drop` needs no result temp: flag `emit_call_result` to emit it bare.
        //
        // NOT for a call handing back several values: the `drop` then consumes
        // ONE of them and the rest are live, so skipping it would leave them on
        // the stack. That is what `assert_stack_empty` catches at the next scope
        // boundary, and the pairing has to see the arity to stay right.
        if op is Bc.Call || op is Bc.CallImport {
            if i + 1 < function.body.len() && function.body[i + 1] is Bc.Drop {
                if callee_result_arity(ctx, op) <= 1 {
                    s.drop_call_result = true
                }
            }
        }
        emit_op(s, i32(i), op)
    }
    // Fall-through restore (void / implicit-end fns) ; explicit returns pop
    // the frame themselves, so a body ending on one needs none.
    if s.needs_frame && !ends_with_return(s.root) {
        s.root.body.push(FRAME_RESTORE)
    }
    // Coalesce operand temps with disjoint live ranges into shared slots: the
    // walk mints one `tN` per materialisation and never recycles, inflating the
    // frame and GC-root set. The declarations below are one per slot. See
    // `ast/coalesce.vader`.
    slot_types :: coalesce_temporaries(s.root, s.temporaries)
    // After the coalescing, whose live ranges read the scopes as the walk built
    // them. See `ast/loops.vader`.
    structure_loops(s.root)
    // GC roots : ref-typed params, then locals + temps (collected by the
    // decl emitters). Order is irrelevant to the GC scan. A fn without a frame
    // skips the whole shadow-stack apparatus.
    // Three root lists: box roots (`vader_box_t*`, for `.Any` slots), raw roots
    // (`void**`, for `.Ref` concrete-ref slots, scanned via scan_raw) and atom
    // roots (`vader_string_t*`, for `string` slots).
    root_addrs: CExpression[]: []
    raw_root_addrs: CExpression[]: []
    atom_root_addrs: CExpression[]: []
    if s.needs_frame {
        params :: function.signature.params
        for i in 0..<params.len() {
            if params[i] == .Ref {
                raw_root_addrs.push(address_of(CLocal { .slot = i32(i) }))
            }
            else if params[i] == .String {
                atom_root_addrs.push(address_of(CLocal { .slot = i32(i) }))
            }
            else if is_ref_val(params[i]) {
                root_addrs.push(address_of(CLocal { .slot = i32(i) }))
            }
        }
    }
    prologue: CStatement[]: []
    emit_local_decls(function, prologue, root_addrs, raw_root_addrs, atom_root_addrs, s.needs_frame)
    emit_temporary_declarations(
        slot_types,
        prologue,
        root_addrs,
        raw_root_addrs,
        atom_root_addrs,
        s.needs_frame,
    )
    if s.needs_frame {
        if root_addrs.len() > 0 {
            prologue.push(array_declaration("vader_box_t*", "gc_roots", root_addrs))
        }
        if raw_root_addrs.len() > 0 {
            prologue.push(array_declaration("void**", "gc_raw_roots", raw_root_addrs))
        }
        box_expr :: if root_addrs.len() > 0 { "gc_roots" } else { "NULL" }
        raw_expr :: if raw_root_addrs.len() > 0 { "gc_raw_roots" } else { "NULL" }
        // Stack-object roots : the escape-stack-allocated GC structs discovered
        // during the walk (see `emit_struct_new`). Their decls are hoisted here so
        // they are function-scoped, and the array is initialised with their
        // addresses: the GC scans each object's FIELDS in place so captured heap
        // refs survive a safepoint. Zero-init'd storage reads as type 0 (a scan
        // no-op) until its `StructNew` writes the real header + fields.
        nstack :: s.stack_storages.len()
        stack_expr :: if nstack > 0 { "gc_stack_objs" } else { "NULL" }
        stack_addrs: CExpression[]: []
        for ss in s.stack_storages {
            prologue.push(declaration(ss.cname, ss.storage, verbatim("{0}")))
            stack_addrs.push(cast("void*", address_of(verbatim(ss.storage))))
        }
        if nstack > 0 {
            prologue.push(array_declaration("void*", "gc_stack_objs", stack_addrs))
        }
        // Atom roots : `string` slots. Emitted last so the frame initializer stays
        // positional, and so a fn with no string slot is byte-identical to before.
        natoms :: atom_root_addrs.len()
        if natoms > 0 {
            prologue.push(array_declaration("vader_string_t*", "gc_atom_roots", atom_root_addrs))
        }
        frame: CExpression[]: [
            verbatim("vader_gc_top"),
            verbatim("${root_addrs.len()}u"),
            verbatim("${raw_root_addrs.len()}u"),
            verbatim(box_expr),
            verbatim(raw_expr),
            verbatim("${nstack}u"),
            verbatim(stack_expr),
        ]
        // The two atom fields are OMITTED when there is none: C partial
        // initialisation reads them as `0` / `NULL`, so a fn holding no string
        // emits exactly the frame it emitted before.
        if natoms > 0 {
            frame.push_all([verbatim("${natoms}u"), verbatim("gc_atom_roots")])
        }
        prologue.push(
            declaration("vader_gc_frame_t", "gc_frame", CInitializerList { .elements = frame }),
        )
        prologue.push(
            CAssign {
                .target = verbatim("vader_gc_top"),
                .value = address_of(verbatim("gc_frame")),
            },
        )
    }
    signature :: signature_for(ctx, fn_index)
    return CFunction { .signature = signature, .prologue = prologue, .body = s.root }
}

/// Declare every non-param local slot, bucketed by ValType in
/// first-appearance order (`<ctype> lA, lB;` per type). In a framed fn a
/// `ref` local gains the `= NULL` GC-init and an `any` local the
/// `= vader_box_null()` one (so the scan reads a valid root before the first
/// write), a `string` local `= 0` ; primitives get a bare decl. A `void*`
/// slot takes its own line ; the names of any other type share a single line,
/// with no PER_LINE chunking (it would only matter past 10 locals of one type).
emit_local_decls :: fn(
    function: BcFunction,
    prologue: CStatement[],
    root_addrs: CExpression[],
    raw_root_addrs: CExpression[],
    atom_root_addrs: CExpression[],
    framed: bool,
) -> void {
    locals :: function.locals
    param_count :: function.signature.params.len()
    vals: ValType[]: []
    names: string[]: []
    for i in 0..<locals.len() {
        if locals[i].val == .Void {
            continue
        }
        vals.push(locals[i].val)
        names.push("l${param_count + i}")
    }
    emit_slot_decls(prologue, vals, names, root_addrs, raw_root_addrs, atom_root_addrs, framed)
}

/// Declare the temp slots `tN`, bucketed like the locals ; `slot_types[N]` is
/// the ValType of `tN`.
emit_temporary_declarations :: fn(
    slot_types: ValType[],
    prologue: CStatement[],
    root_addrs: CExpression[],
    raw_root_addrs: CExpression[],
    atom_root_addrs: CExpression[],
    framed: bool,
) -> void {
    names: string[]: []
    for i in 0..<slot_types.len() {
        names.push("t${i}")
    }
    emit_slot_decls(
        prologue,
        slot_types,
        names,
        root_addrs,
        raw_root_addrs,
        atom_root_addrs,
        framed,
    )
}

/// Declare a group of same-kind C slots (`vals[i]` is the ValType of
/// `names[i]`), bucketed by ValType in first-appearance order :
/// `<ctype> nameA, nameB;` per type. Shared by the local + temp decls.
/// PER_LINE chunking (10 names / line) is deferred: it only
/// diverges past 10 slots of one type.
emit_slot_decls :: fn(
    prologue: CStatement[],
    vals: ValType[],
    names: string[],
    root_addrs: CExpression[],
    raw_root_addrs: CExpression[],
    atom_root_addrs: CExpression[],
    framed: bool,
) -> void {
    emitted: ValType[]: []
    for i in 0..<vals.len() {
        val :: vals[i]
        if val in emitted {
            continue
        }
        emitted.push(val)
        // Rooting. A `.Ref` slot is a raw `void*`: init `NULL`, `&name`
        // chains into the raw root list (scanned via scan_raw). An `.Any` slot is
        // a `vader_box_t`: init `vader_box_null()`, `&name` chains into the box
        // root list. Both give the GC a valid root before the first write.
        // A fn without a frame (and a primitive) gets a bare decl (write-before-read).
        is_raw_ref :: val == .Ref || val == .Pointer
        rooted :: is_ref_val(val) && framed
        // A `string` slot holds an ATOM ID, not a pointer, so it belongs to
        // neither root list above: `ptrs` and `raw` are pointer arrays. It gets
        // its own list; without it an atom's only root is the conservative stack
        // scan, which finds the id only when `cc` spills it instead of keeping
        // it in a register.
        if val == .String && framed {
            for j in 0..<vals.len() {
                if vals[j] == val {
                    prologue.push(declaration("vader_string_t", names[j], verbatim("0")))
                    atom_root_addrs.push(address_of(verbatim(names[j])))
                }
            }
            continue
        }
        if is_raw_ref {
            // `void*` can't be group-declared: `void* a, b` makes `b` a bare
            // `void` (the `*` binds only to `a`). Emit one per line.
            for j in 0..<vals.len() {
                if vals[j] == val {
                    if rooted {
                        prologue.push(declaration("void*", names[j], verbatim("NULL")))
                        raw_root_addrs.push(address_of(verbatim(names[j])))
                    } else {
                        prologue.push(declaration("void*", names[j]))
                    }
                }
            }
        } else {
            group: CDeclarator[]: []
            for j in 0..<vals.len() {
                if vals[j] == val {
                    if rooted {
                        group.push(
                            CDeclarator { .name = names[j], .value = call("vader_box_null", []) },
                        )
                        root_addrs.push(address_of(verbatim(names[j])))
                    } else {
                        group.push(CDeclarator { .name = names[j] })
                    }
                }
            }
            prologue.push(CDeclaration { .type = c_type_for_val_bare(val), .declarators = group })
        }
    }
}

/// Per-op C emit: the function-body walker's dispatch. Exhaustive over
/// every `Op` variant (no `_`), each with a real emit, so adding an
/// opcode trips T3013 here and forces a conscious decision: mirroring
/// `vader/emit/virt/dump.vader::write_op_refs`. The arm order tracks it so the
/// two stay diffable. The only `todo(...)` calls are malformed-
/// bytecode guards inside a handler (e.g. `struct.new` on a non-struct
/// type), never a not-yet-ported placeholder.
emit_op :: fn(s: FnState, pc: i32, op: Bc.Op) -> void {
    invalidate_header_cache(s, op)
    match op {
        is Bc.I32Const              -> push_const(s, op)
        is Bc.I64Const              -> push_const(s, op)
        is Bc.F64Const              -> push_const(s, op)
        is Bc.BoolConst             -> push_const(s, op)
        is Bc.CharConst             -> push_const(s, op)
        is Bc.NullConst             -> push_const(s, op)
        is Bc.StringConst           -> push_const(s, op)
        is Bc.LocalGet              -> emit_local_get(s, op)
        is Bc.LocalSet              -> emit_local_set(s, op.slot, false)
        is Bc.LocalTee              -> emit_local_set(s, op.slot, true)
        is Bc.LocalField            -> emit_local_field(s, op)
        is Bc.Return                -> emit_return(s)
        is Bc.ReturnLit             -> emit_return_lit(s, op.value)
        is Bc.Drop                  -> drop_top(s)
        is Bc.Call                  -> emit_call(s, op)
        is Bc.CallImport            -> emit_call_import(s, op)
        is Bc.CallIndirect          -> emit_call_indirect(s, op)
        is Bc.VirtualCall           -> emit_virtual_call(s, op)
        is Bc.FnRef                 -> emit_fn_ref(s, op)
        is Bc.FnAddr                -> emit_fn_addr(s, op)
        is Bc.MakeClosure           -> emit_make_closure(s, op)
        is Bc.If                    -> emit_if_open(s)
        is Bc.Else                  -> emit_else(s)
        is Bc.End                   -> emit_end(s, pc)
        is Bc.Block                 -> emit_open_scope(s, pc, .Block)
        is Bc.Loop                  -> emit_open_scope(s, pc, .Loop)
        is Bc.Branch                -> emit_branch(s, pc, false)
        is Bc.BranchIf              -> emit_branch(s, pc, true)
        is Bc.BoolNot               -> push_unop(s, "!", .Bool)
        is Bc.StructNew             -> emit_struct_new(s, op)
        is Bc.StructGet             -> emit_struct_get(s, op)
        is Bc.StructSet             -> emit_struct_set(s, op)
        is Bc.UnionFieldGet         -> emit_union_field_get(s, op)
        is Bc.UnionFieldSet         -> emit_union_field_set(s, op)
        is Bc.ArrayNew              -> emit_array_new(s, op)
        is Bc.ArrayLen              -> emit_array_len(s)
        is Bc.ArrayPush             -> emit_array_push(s, op)
        is Bc.ArrayGet              -> emit_array_get(s, op)
        is Bc.ArraySet              -> emit_array_set(s, op)
        is Bc.ArraySlice            -> emit_array_slice(s, op)
        is Bc.ArrayReserve          -> emit_array_reserve(s, op)
        is Bc.ArrayRepeat           -> emit_array_repeat(s)
        is Bc.ArrayPushAll          -> emit_array_push_all(s)
        is Bc.ArrayCopy             -> emit_array_copy(s)
        is Bc.ArrayRemoveLast       -> emit_array_remove_last(s)
        is Bc.ArrayClear            -> emit_array_clear(s)
        is Bc.DataConst             -> emit_data_const_op(s, op)
        is Bc.GlobalGet             -> emit_global_get(s, op)
        is Bc.GlobalSet             -> emit_global_set(s, op)
        is Bc.TypeConst             -> emit_type_const(s, op)
        is Bc.TypeCheck             -> emit_type_check(s, op)
        is Bc.RefCast               -> emit_ref_cast(s, op)
        is Bc.Retag                 -> emit_retag_op(s, op)
        is Bc.Unreachable           -> unreachable(s, op.reason)
        is Bc.Convert               -> emit_convert(s, convert_target_val(op.target), op.from_name)
        is Bc.SizeOfType            -> emit_size_of_type(s)
        is Bc.CheckedArith          -> emit_checked_arith(s, op)
        is Bc.CheckedNeg            -> emit_checked_neg(s, op)
        is Bc.I32Add                -> push_binop(s, .Add, .I32)
        is Bc.I32Sub                -> push_binop(s, .Subtract, .I32)
        is Bc.I32Mul                -> push_binop(s, .Multiply, .I32)
        is Bc.I32Div                -> push_eager(s, .Divide, .I32)
        is Bc.I32Mod                -> push_eager(s, .Remainder, .I32)
        is Bc.I32Neg                -> push_unop(s, "-", .I32)
        is Bc.I32BitNot             -> push_unop(s, "~", .I32)
        is Bc.I32BitAnd             -> push_binop(s, .BitAnd, .I32)
        is Bc.I32BitOr              -> push_binop(s, .BitOr, .I32)
        is Bc.I32BitXor             -> push_binop(s, .BitXor, .I32)
        is Bc.I32Shl                -> push_shift(s, .ShiftLeft, .I32)
        is Bc.I32Shr                -> push_shift(s, .ShiftRight, .I32)
        is Bc.I32ShrU               -> push_shift(s, .ShiftRight, .U32)
        is Bc.I32Eq                 -> push_cmp(s, .Equal, .I32)
        is Bc.I32Ne                 -> push_cmp(s, .NotEqual, .I32)
        is Bc.I32Lt                 -> push_cmp(s, .Less, .I32)
        is Bc.I32Le                 -> push_cmp(s, .LessOrEqual, .I32)
        is Bc.I32Gt                 -> push_cmp(s, .Greater, .I32)
        is Bc.I32Ge                 -> push_cmp(s, .GreaterOrEqual, .I32)
        is Bc.I64Add                -> push_binop(s, .Add, .I64)
        is Bc.I64Sub                -> push_binop(s, .Subtract, .I64)
        is Bc.I64Mul                -> push_binop(s, .Multiply, .I64)
        is Bc.I64Div                -> push_eager(s, .Divide, .I64)
        is Bc.I64Mod                -> push_eager(s, .Remainder, .I64)
        is Bc.I64Neg                -> push_i64_neg(s)
        is Bc.I64BitAnd             -> push_binop(s, .BitAnd, .I64)
        is Bc.I64BitOr              -> push_binop(s, .BitOr, .I64)
        is Bc.I64BitXor             -> push_binop(s, .BitXor, .I64)
        is Bc.I64BitNot             -> push_unop(s, "~", .I64)
        is Bc.I64Shl                -> push_shift(s, .ShiftLeft, .I64)
        is Bc.I64Shr                -> push_shift(s, .ShiftRight, .I64)
        is Bc.I64ShrU               -> push_shift(s, .ShiftRight, .U64)
        is Bc.I64Eq                 -> push_cmp(s, .Equal, .I64)
        is Bc.I64Ne                 -> push_cmp(s, .NotEqual, .I64)
        is Bc.I64Lt                 -> push_cmp(s, .Less, .I64)
        is Bc.I64Le                 -> push_cmp(s, .LessOrEqual, .I64)
        is Bc.I64Gt                 -> push_cmp(s, .Greater, .I64)
        is Bc.I64Ge                 -> push_cmp(s, .GreaterOrEqual, .I64)
        is Bc.U32Div                -> push_eager(s, .Divide, .U32)
        is Bc.U32Mod                -> push_eager(s, .Remainder, .U32)
        is Bc.U32Lt                 -> push_cmp(s, .Less, .U32)
        is Bc.U32Le                 -> push_cmp(s, .LessOrEqual, .U32)
        is Bc.U32Gt                 -> push_cmp(s, .Greater, .U32)
        is Bc.U32Ge                 -> push_cmp(s, .GreaterOrEqual, .U32)
        is Bc.U64Div                -> push_eager(s, .Divide, .U64)
        is Bc.U64Mod                -> push_eager(s, .Remainder, .U64)
        is Bc.U64Lt                 -> push_cmp(s, .Less, .U64)
        is Bc.U64Le                 -> push_cmp(s, .LessOrEqual, .U64)
        is Bc.U64Gt                 -> push_cmp(s, .Greater, .U64)
        is Bc.U64Ge                 -> push_cmp(s, .GreaterOrEqual, .U64)
        is Bc.F64Add                -> push_binop(s, .Add, .F64)
        is Bc.F64Sub                -> push_binop(s, .Subtract, .F64)
        is Bc.F64Mul                -> push_binop(s, .Multiply, .F64)
        is Bc.F64Div                -> push_eager(s, .Divide, .F64)
        is Bc.F64Neg                -> push_unop(s, "-", .F64)
        is Bc.F64Eq                 -> push_cmp(s, .Equal, .F64)
        is Bc.F64Ne                 -> push_cmp(s, .NotEqual, .F64)
        is Bc.F64Lt                 -> push_cmp(s, .Less, .F64)
        is Bc.F64Le                 -> push_cmp(s, .LessOrEqual, .F64)
        is Bc.F64Gt                 -> push_cmp(s, .Greater, .F64)
        is Bc.F64Ge                 -> push_cmp(s, .GreaterOrEqual, .F64)
        is Bc.BoolEq                -> push_binop(s, .Equal, .Bool)
        is Bc.BoolNe                -> push_binop(s, .NotEqual, .Bool)
        is Bc.BoolAnd               -> push_binop(s, .LogicalAnd, .Bool)
        is Bc.BoolOr                -> push_binop(s, .LogicalOr, .Bool)
        is Bc.StringEq              -> push_cmp(s, .Equal, .String)
        is Bc.StringNe              -> push_cmp(s, .NotEqual, .String)
        is Bc.StringCompare         -> emit_string_compare(s)
        is Bc.RefEq                 -> push_binop_any(s, .Equal, .Bool)
        is Bc.RefNe                 -> push_binop_any(s, .NotEqual, .Bool)
        is Bc.DeferPush             -> emit_defer_push(s)
        is Bc.DeferPopExec          -> emit_defer_pop_exec(s, op)
        is Bc.BufferNew             -> emit_buffer_new(s)
        is Bc.LoadU8                -> emit_buffer_load(s, "vader_buffer_load_u8", .I32)
        is Bc.LoadI32               -> emit_buffer_load(s, "vader_buffer_load_i32", .I32)
        is Bc.LoadI64               -> emit_buffer_load(s, "vader_buffer_load_i64", .I64)
        is Bc.LoadF64               -> emit_buffer_load(s, "vader_buffer_load_f64", .F64)
        is Bc.StoreU8               -> emit_buffer_store(s, "vader_buffer_store_u8", "uint8_t")
        is Bc.StoreI32              -> emit_buffer_store(s, "vader_buffer_store_i32", "int32_t")
        is Bc.StoreI64              -> emit_buffer_store(s, "vader_buffer_store_i64", "int64_t")
        is Bc.StoreF64              -> emit_buffer_store(s, "vader_buffer_store_f64", "double")
        is Bc.LoadSlotI32           -> emit_slot_load_prim(s, "int32_t", .I32, op.bounds_safe)
        is Bc.LoadSlotI64           -> emit_slot_load_prim(s, "int64_t", .I64, op.bounds_safe)
        is Bc.LoadSlotF64           -> emit_slot_load_prim(s, "double", .F64, op.bounds_safe)
        is Bc.StoreSlotI32          -> emit_slot_store_prim(s, "int32_t", .I32, op.bounds_safe)
        is Bc.StoreSlotI64          -> emit_slot_store_prim(s, "int64_t", .I64, op.bounds_safe)
        is Bc.StoreSlotF64          -> emit_slot_store_prim(s, "double", .F64, op.bounds_safe)
        is Bc.MemoryCopy            -> emit_memory_copy(s)
        is Bc.BufferToString        -> emit_buffer_to_string(s)
        is Bc.BufferWriteString     -> emit_buffer_write_string(s)
        is Bc.F64ToBits             -> emit_f64_to_bits(s)
        is Bc.BitsToF64             -> emit_bits_to_f64(s)
        is Bc.F32ToBits             -> emit_f32_to_bits(s)
        is Bc.BitsToF32             -> emit_bits_to_f32(s)
    }    // ---- memory opcodes -------------------------------------------------
    // Bytes-only Buffer. `buffer.new` allocates a `vader_buffer_t`; the
    // typed load/store + memory_copy go through the `static inline
    // vader_buffer_*` helpers in vader.h, re-deriving the buffer pointer
    // from its rooted slot on every op: a collection can move the buffer, so
    // its address is never cached across an allocating op. An array element
    // that holds a reference goes through `array.get` / `array.set`, and the
    // store fires the generational write barrier.

}
