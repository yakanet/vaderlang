// vader/emit/c/host — `call.import` host-fn shims.
//
// Every `call.import N` op resolves to a `vader_host_<mangled>(...)` C function
// generated here. Two flavours, switched on `BcImport.is_extern` :
//   - `@intrinsic` stdlib ops (`is_extern = false`) — routed to the
//     runtime's `vader_*` helpers by mangled name (`import_shim`).
//   - `@extern` user FFI (`is_extern = true`) — a forwarding shim that
//     marshals `vader_string_t` args to `const char*` and calls the real
//     foreign symbol (`user_extern_shim`), declared once via an `extern`.
//
// The shims of a `CLibrary`'s `@extern`s get a C unit of their own
// (`emit_library_unit`), the rest of the program reaching them through
// prototypes: two libraries' headers need not agree with each other, as
// `raylib.h` and `<windows.h>` do not (`Rectangle`, `CloseWindow`).
//
// Same module (`vader/emit/c`), so `EmitCtx` + `c_type_for_val_bare` are
// in scope without imports.

module "vader/emit/c"

import "std/collections"
import "std/iter"
import "std/sort"
import "std/string"
import "vader/bytecode"
import "vader/emit/c/ast"

// ---- driver ---------------------------------------------------------------

/// Emit every import's shim plus the once-per-module `extern` declarations of
/// their foreign symbols. Under `ctx.library_units`, a `CLibrary`'s shims are
/// left to its own unit (`emit_library_unit`) and only declared here. Unused
/// imports are pruned upstream, so `module.imports` already carries only the
/// referenced host fns.
emit_import_shims :: fn(ctx: EmitCtx, printer: CPrinter) -> void {
    // Ahead of the shims that dereference them, and of the assertions that check
    // them — both of which name these types. Only under `--split`, where this
    // lands in the per-target imports header; a single file already carries them
    // with the other typedefs.
    if ctx.split {
        emit_mirrored_struct_typedefs(ctx.module.types, ctx.struct_c_names, printer)
    }
    if !ctx.library_units {
        emit_import_group(ctx, printer, ctx.module.imports)
        return
    }
    emit_import_group(ctx, printer, imports_of_library(ctx.module, ""))
    prototypes: CTopLevel[]: []
    for imp in ctx.module.imports {
        if library_name(imp) != "" {
            declared :: CSignature { ...shim_signature(ctx, imp), .storage = .Declaration }
            prototypes.push(CPrototype { .signature = declared })
        }
    }
    printer.print_section(CSection {
        .comment = ["Shims of the `CLibrary` bindings, each defined in its library's unit."],
        .items = prototypes,
    })
}

/// The C unit holding the shims of the `@extern`s of the `CLibrary` named
/// `library`: its header, its layout assertions and its shims, with no other
/// library's header in sight. It needs nothing of the program but the runtime
/// and the mirrors' Vader layout.
///
/// @param ctx      the emit context of the program, under `library_units`.
/// @param library  a name `foreign_libraries` lists.
/// @return         the unit's C source.
emit_library_unit :: fn(ctx: EmitCtx, library: string) -> string {
    printer :: CPrinter {}
    printer.emit_preamble("Generated by vader: do not edit. Foreign library `${library}`.")
    emit_mirrored_struct_typedefs(ctx.module.types, ctx.struct_c_names, printer)
    emit_import_group(ctx, printer, imports_of_library(ctx.module, library))
    return printer.printed_text()
}

/// The names of the `CLibrary` bindings the program's `@extern`s reach, sorted:
/// one C unit each.
///
/// @param module  the program.
foreign_libraries :: fn(module: BytecodeModule) -> string[] {
    names: string[]: []
    for imp in module.imports {
        name :: library_name(imp)
        if name != "" && !(name in names) {
            names.push(name)
        }
    }
    return sort(names, compare_ascending)
}

// The imports whose shims `library` holds ("" for those outside any library).
imports_of_library :: fn(module: BytecodeModule, library: string) -> BcImport[] =
    module.imports.filter((imp) -> library_name(imp) == library).collect()

// The headers, `extern` declarations, assertions and shims of `imports`.
emit_import_group :: fn(ctx: EmitCtx, printer: CPrinter, imports: BcImport[]) -> void {
    types :: ctx.module.types
    emit_foreign_declarations(printer, imports, types, mirror_crossings(imports, types))
    shims: CTopLevel[]: []
    for imp in imports {
        shims.push(import_shim(ctx, imp))
    }
    printer.print_section(CSection { .items = shims })
}

// The headers and `extern` declarations of the foreign symbols `imports` call,
// and the assertions that hold the declarations to them: the `@c_type`
// spellings, and the layout of the mirrors that cross as `crossings` says.
emit_foreign_declarations :: fn(
    printer: CPrinter, imports: BcImport[], types: BcType[], crossings: MirrorCrossings,
) -> void {
    extern_decls: CTopLevel[]: []
    seen_extern: string[]: []
    headers: string[]: []
    for imp in imports {
        if imp.is_extern && !(imp.extern_name in seen_extern) {
            seen_extern.push(imp.extern_name)
            if imp.c_header != "" {
                // The header carries the real prototype. Synthesising one beside
                // it is a CONFLICTING DECLARATION the C compiler refuses — which
                // is what blocked `WriteFile` against `<windows.h>` and
                // `clock_gettime` against `<time.h>`.
                if !(imp.c_header in headers) {
                    headers.push(imp.c_header)
                }
            } else {
                extern_decls.push(extern_decl(imp, types))
            }
        }
    }
    includes: CTopLevel[]: []
    for h in headers {
        includes.push(include_of(h))
    }
    printer.print_section(CSection {
        .comment = ["Headers named by `@c_header` — they own the prototypes below."],
        .items = includes,
    })
    printer.print_section(CSection {
        .comment = ["User @extern foreign symbols — resolved by the linker."],
        .items = extern_decls,
    })
    // A `@c_type` renames a Vader integer for C : the VM hands the real callee
    // the Vader width, in an integer register, so the C type must be an integer
    // of that width. Asserted for every declaration, not once per symbol: two
    // declarations of one symbol may spell it differently.
    printer.print_section(CSection {
        .comment = ["`@c_type` spellings, checked against the C types."],
        .items = c_type_asserts(imports),
    })
    // Layout assertions for every `@c_struct` a shim marshals. `cc` — which has
    // the real header — refuses to compile a mirror whose field width differs
    // from what the library declares, in EITHER direction, or whose offset does.
    // So the field-by-field copy cannot truncate and the interpreter's block
    // cannot drift. `cc` IS the consumer: the check is spent entirely at build
    // time, and nothing reads it at run time.
    printer.print_section(CSection {
        .comment = ["`@c_struct` layout — checked against the real headers."],
        .items = c_struct_layout_asserts(types, crossings),
    })
}

// The `#include` an `@c_header` operand names : `<path>` is a system header,
// `"path"` a local one. An operand written without delimiters is taken as a
// local path, which C also searches on the system path.
include_of :: fn(operand: string) -> CInclude {
    delimited :: operand.len() >= 2
    inner :: if delimited { operand[1..<operand.len() - 1] } else { operand }
    if delimited && operand.starts_with("<") && operand.ends_with(">") {
        return CInclude { .path = inner, .system = true }
    }
    if delimited && operand.starts_with("\"") && operand.ends_with("\"") {
        return CInclude { .path = inner }
    }
    return CInclude { .path = operand }
}

/// How the mirrors the `@extern` declarations name cross the boundary.
///
/// One mirror can do both, through two declarations.
MirrorCrossings :: struct {
    /// Lent by address (`@c_pointer`): C works on the shim's struct, and the
    /// interpreter builds a block of its own for it.
    lent:   MutableSet<i32>
    /// Copied by value: a parameter without `@c_pointer`, or a result.
    copied: MutableSet<i32>
}

/// The type indices of the mirrors each `@extern` of `imports` lends or copies.
///
/// @param imports  the imports scanned.
/// @param types    the module type table.
mirror_crossings :: fn(imports: BcImport[], types: BcType[]) -> MirrorCrossings {
    lent :: MutableSet<i32> {}
    copied :: MutableSet<i32> {}
    for imp in imports {
        if !imp.is_extern {
            continue
        }
        for j in 0..<imp.signature.param_types.len() {
            type_index :: imp.signature.param_types[j]
            if mirror_at(types, type_index) == null {
                continue
            }
            if param_is_by_address(imp.signature, j) {
                lent.add(type_index)
            } else {
                copied.add(type_index)
            }
        }
        result :: bc_single_result_type(imp.signature)
        if mirror_at(types, result) != null {
            copied.add(result)
        }
    }
    return MirrorCrossings { .lent = lent, .copied = copied }
}

/// `_Static_assert` pinning a mirrored field's SIGNEDNESS to the C field's, or
/// `null` when the field's type carries no signedness to compare.
///
/// The shim assigns `v->f_st_mode = p.st_mode`, so C's own conversion applies and
/// uses the C field's signedness, while the interpreter reads the block back
/// using the VADER field's. The two must therefore agree, or a `u64` mirror over
/// an `int32_t` reads `-1` as `4294967295` under the VM and as `-1` natively.
///
/// `(T)-1 < 0` is the constant-expression test for a signed `T`. The cast pins
/// the type before the integer promotion, which preserves the value, so the
/// answer holds for a narrow member too.
///
/// @param types    the module type table, to read the Vader field's own type.
/// @param f        the field.
/// @param c_name   the C type's spelling, e.g. `struct stat`.
/// @param c_field  the C field's name.
/// @return         the assert, or `null` for a non-integer field.
signedness_assert :: fn(
    types: BcType[],
    f: BcField,
    c_name: string,
    c_field: string,
) -> CTopLevel | null {
    v :: c_field_val_type(f, types) ?? return null
    if !is_integer_val(v) {
        return null
    }
    minus_one :: CCastToTypeOf { .model = null_member(c_name, c_field), .value = number(-1) }
    negative :: CParenthesized { .inner = binary(.Less, minus_one, number(0)) }
    want :: number(if is_unsigned_val(v) { 0 } else { 1 })
    return static_assert(binary(.Equal, negative, want), "${c_name}.${c_field} signedness")
}

/// Copy a mirror member by member, descending into a nested one.
///
/// Never a struct assignment and never a `memcpy`: the two sides are different C
/// types, and Vader holds a nested mirror BY POINTER where C has it inline. So a
/// nested field is reached as `v->f_srWindow->f_right` against `p.srWindow.Right`
/// — one scalar copy per leaf, each of which `cc` type-checks.
///
/// @param types   the module type table.
/// @param fields  the fields at this level.
/// @param c_expr  the C side so far (`p0`, then `p0.srWindow`).
/// @param v_expr  the Vader side so far, a pointer already cast to its struct
///                type.
/// @param into_c  true when C READS (fill `p` first), false when C WRITES.
/// @param out     accumulator — the statements before or after the call.
/// @param depth   guards a malformed self-referential mirror.
push_member_copies :: fn(
    types: BcType[], fields: BcField[], c_expr: CExpression, v_expr: CExpression,
    into_c: bool, out: CStatement[], depth: i32,
) -> void {
    if depth >= NEST_CAP {
        return
    }
    for f in fields {
        c_member :: CMember { .base = c_expr, .member = c_field_name(f) }
        v_member :: CMember { .base = v_expr, .member = "f_${f.name}", .arrow = true }
        nested :: nested_mirror(f, types)
        if nested != null {
            inner :: CParenthesized { .inner = cast("${struct_c_name(nested.name)}*", v_member) }
            push_member_copies(types, nested.fields, c_member, inner, into_c, out, depth + 1)
            continue
        }
        // Converted, not assigned raw. A member a mirror only needs to RESERVE
        // SPACE for — `STARTUPINFOA` has eleven before `dwFlags`, four of them
        // pointers — has no Vader type that is both writable and the right
        // shape: `CPointer` has no constructible value, `CPointer | null` is a
        // 16-byte box, and a plain word will not assign to an `LPSTR`. A machine
        // word converts.
        //
        // This cannot hide a LAYOUT error, and only became safe when it stopped
        // being able to: every leaf now carries both a width and an OFFSET
        // `_Static_assert`. What it still allows is a member declared as a word
        // where a pointer was meant — which, for a member reserved and never
        // read, is the intent.
        target :: if into_c { c_member } else { v_member }
        source :: if into_c { v_member } else { c_member }
        converted :: CCastToTypeOf { .model = target, .value = source }
        out.push(CAssign { .target = target, .value = converted })
    }
}

/// The capture, copy and return of a mirror result, which C hands back by value.
///
/// A nested mirror is a separate Vader object, so a result can take several
/// allocations, and any of them can move the ones made before it. Each object
/// is therefore a local declared up front, and the members are rooted while the
/// rest is allocated. They are allocated before the struct that holds them: the
/// outermost is the youngest object, so its stores need no write barrier, and
/// nothing allocates after it. The fields are copied once every object exists.
///
/// @param types       the module type table.
/// @param type_index  the result's mirror.
/// @param mirror      its C type.
/// @param forwarded   the call.
mirror_result :: fn(
    types: BcType[],
    type_index: i32,
    mirror: string,
    forwarded: CExpression,
) -> ForwardedResult {
    names: string[]: []
    declarations: CStatement[]: []
    allocations: CStatement[]: []
    outermost :: push_mirror_allocation(types, type_index, names, declarations, allocations, 0)
    settle: CStatement[]: []
    settle.push_all(declarations)
    if names.len() == 1 {
        settle.push_all(allocations)
    } else {
        roots: CExpression[]: []
        for name in names[1..<names.len()] {
            roots.push(cast("void**", address_of(verbatim(name))))
        }
        frame :: verbatim("__result_frame")
        settle.push(array_declaration("void**", "__result_roots", roots))
        count :: number(roots.len())
        settle.push(perform("VADER_GC_PUSH_RAW", [frame, verbatim("__result_roots"), count]))
        settle.push_all(allocations)
        settle.push(perform("VADER_GC_POP_FRAME", [frame]))
    }
    fields :: bc_struct_fields(types, type_index)
    push_member_copies(types, fields, verbatim("r"), verbatim(outermost), false, settle, 0)
    return ForwardedResult {
        .capture = declaration(mirror, "r", forwarded),
        .settle = settle,
        .returned = verbatim(outermost),
    }
}

// Declare the local for the mirror at `type_index`, named in pre-order so the
// outermost is `obj0`, then allocate its nested members and itself, and link
// each member into it. Returns the local's name.
push_mirror_allocation :: fn(
    types: BcType[],
    type_index: i32,
    names: string[],
    declarations: CStatement[],
    allocations: CStatement[],
    depth: i32,
) -> string {
    name :: "obj${names.len()}"
    names.push(name)
    vader_type :: struct_c_name(bc_struct_name(types, type_index))
    declarations.push(declaration("${vader_type}*", name, NULL_POINTER))
    links: CStatement[]: []
    for f in bc_struct_fields(types, type_index) {
        if nested_mirror(f, types) == null || depth + 1 >= NEST_CAP {
            continue
        }
        member :: push_mirror_allocation(
            types,
            f.type_index,
            names,
            declarations,
            allocations,
            depth + 1,
        )
        target :: CMember { .base = verbatim(name), .member = field_c_name(f.name), .arrow = true }
        links.push(CAssign { .target = target, .value = verbatim(member) })
    }
    allocations.push(CAssign { .target = verbatim(name), .value = gc_allocation(vader_type) })
    allocations.push(perform("vader_obj_header_init", [verbatim(name), verbatim("${type_index}u")]))
    allocations.push_all(links)
    return name
}

/// Emit the width + signedness asserts for every LEAF of a mirror, descending
/// into a nested one.
///
/// A nested field is a C struct member the C side holds INLINE and Vader holds
/// by pointer, so comparing sizes at that level would compare a struct against a
/// `void*`. The comparison belongs at the leaves, where both sides are scalars:
/// the C side accumulates a member path (`srWindow.Right`) and the Vader side
/// changes TYPE, each nested mirror being its own struct.
///
/// @param types      the module type table.
/// @param fields     the fields at this level.
/// @param c_name     the OUTERMOST C type — every path is rooted there.
/// @param c_prefix   the member path reached so far, `""` at the top.
/// @param vader_ty   the Vader C type name holding `fields`.
/// @param base       this level's byte offset inside the INTERPRETER's block.
/// @param out        accumulator for the asserts.
/// @param depth      guards a malformed self-referential mirror.
push_leaf_asserts :: fn(
    types: BcType[], fields: BcField[], c_name: string, c_prefix: string,
    vader_ty: string, base: i64, out: CTopLevel[], depth: i32,
) -> void {
    if depth >= NEST_CAP {
        return
    }
    layout :: c_struct_layout(fields, types)
    for i in 0..<fields.len() {
        f :: fields[i]
        cf :: "${c_prefix}${c_field_name(f)}"
        at :: base + layout.offsets[i]
        nested :: nested_mirror(f, types)
        if nested != null {
            push_leaf_asserts(
                types, nested.fields, c_name, "${cf}.",
                struct_c_name(nested.name), at, out, depth + 1,
            )
            continue
        }
        c_width :: call("sizeof", [null_member(c_name, cf)])
        vader_width :: call("sizeof", [null_member(vader_ty, "f_${f.name}")])
        out.push(static_assert(binary(.Equal, c_width, vader_width), "${c_name}.${cf}"))
        // The OFFSET, which is the interpreter's whole exposure. It builds its
        // block from the declared fields at natural alignment from zero and
        // hands the address to the real callee, so its layout equals C's only
        // while the mirror stays a contiguous LEADING prefix — skip a member,
        // or nest a partial one, and every field after it lands somewhere else.
        // Widths alone do not catch that: they were all correct in the two
        // mirrors this found.
        offset :: call("__builtin_offsetof", [verbatim(c_name), verbatim(cf)])
        out.push(static_assert(binary(.Equal, offset, number(at)), "${c_name}.${cf} offset"))
        sign :: signedness_assert(types, f, c_name, cf)
        if sign != null {
            out.push(sign)
        }
    }
}

/// `_Static_assert` lines pinning each mirrored field's width to the C field it
/// mirrors.
///
/// The shim declares its OWN C struct and copies field by field, by name, so the
/// two layouts never have to agree — `cc` lays the C side out itself. What must
/// hold is per FIELD: a width mismatch would truncate or sign-extend in silence
/// on the way in or out. Naming a field the C type does not have fails the build
/// here too, which is the other half of the check.
///
/// A mirror lent by address may therefore be SHORT: it stops early and ignores
/// the members after it, which is what makes a struct with nested members usable
/// at all. A mirror copied by value may not, since a copy carries only what the
/// mirror names. Neither may be SPARSE: the offset assert below pins each field
/// to `__builtin_offsetof`, so skipping a member is refused.
///
/// Only the mirrors `crossings` names are asserted: the asserts read the C
/// header of the imports that cross them, and a group of imports (the shared
/// one, or one `CLibrary`'s) has only its own headers in sight. A mirror nothing
/// crosses has no layout for the interpreter to agree on.
///
/// @param types      the module type table.
/// @param crossings  how each mirror crosses, which picks the mirrors asserted
///                   and their size asserts.
/// @return           the asserts, empty when no struct mirrors a C type.
c_struct_layout_asserts :: fn(types: BcType[], crossings: MirrorCrossings) -> CTopLevel[] {
    out: CTopLevel[]: []
    for type_index in 0..<types.len() {
        t :: types[type_index]
        if t !is BcStruct {
            continue
        }
        if t.c_name == "" {
            continue
        }
        if t.fields.len() == 0 {
            continue
        }
        // A mirror reached ONLY as a nested member gets no block of its own. It
        // never crosses: the parent's asserts already pin its leaves under the
        // real C path, and the interpreter inlines it into the parent's block
        // rather than laying one out for it. Emitting one anyway adds a
        // `prefix` bound on a block nothing builds, which can reject a
        // perfectly good declaration while naming a type the user put in no
        // signature. A mirror that is BOTH nested and a parameter keeps its
        // block.
        lent :: i32(type_index) in crossings.lent
        copied :: i32(type_index) in crossings.copied
        if !lent && !copied {
            continue
        }
        vt :: struct_c_name(t.name)
        // The layout the VM will compute for itself, pinned here. `cc` owns the
        // real one, so a divergence fails the native build and names the field
        // rather than letting the interpreter write at a wrong offset.
        layout :: c_struct_layout(t.fields, types)
        c_size :: call("sizeof", [verbatim(t.c_name)])
        if copied {
            // A copy names EVERY member. With each leaf's offset pinned below,
            // an equal size leaves no room for a member it skipped, except one
            // small enough to hide in the tail padding.
            is_whole :: binary(.Equal, number(layout.size), c_size)
            message :: "${t.c_name} is mirrored whole, as a by-value crossing requires"
            out.push(static_assert(is_whole, message))
        } else {
            // A mirror lent by address may describe only a PREFIX: the trailing
            // members of a `struct stat` are rarely worth naming. So the
            // computed size must merely FIT.
            fits_prefix :: binary(.LessOrEqual, number(layout.size), c_size)
            out.push(static_assert(fits_prefix, "${t.c_name} prefix"))
        }
        // The C type must fit the block the interpreter allocates, for a mirror
        // it may lend. One that is only copied never gets a block: the
        // interpreter stops at the call first.
        if lent || !copied {
            fits_block :: binary(.LessOrEqual, c_size, number(MIRROR_BLOCK_FLOOR))
            out.push(static_assert(fits_block, "${t.c_name} fits the interpreter block"))
        }
        // The shim would need neither of the per-leaf asserts below: it declares
        // its OWN C struct and copies member by member BY NAME, so `cc` resolves
        // both offsets itself and a Vader offset never meets a C one there.
        //
        // The VM has no such luxury — it lays the block out from these very
        // widths and hands its address to the real callee. That is why each leaf
        // is pinned EXACTLY rather than merely fitting, AND why its offset is
        // pinned too: a wider Vader field, or a skipped member, shifts every
        // field after it under `vader run` alone, and since the interpreter
        // reads its own block back, nothing on the Vader side could see it. A
        // type whose width differs between systems takes one mirror per system.
        push_leaf_asserts(types, t.fields, t.c_name, "", vt, 0, out, 0)
    }
    return out
}

// `_Static_assert(condition, "message");`.
static_assert :: fn(condition: CExpression, message: string) -> CTopLevel = CStaticAssert {
    .condition = condition,
    .message = CStringLiterals { .literals = [c_string_lit(message)] },
}

// `((type*) 0)->member` — a member named without an object, for `sizeof` and
// `__typeof__`.
null_member :: fn(type: string, member: string) -> CExpression = pointer_member(
    "${type}*",
    number(0),
    member,
)

/// `extern <ret> <name>(<params>);` for an `@extern` import — foreign ABI
/// types (`string` → `const char*`), declared once per distinct symbol.
extern_decl :: fn(imp: BcImport, types: BcType[]) -> CTopLevel {
    parameters: CParameter[]: []
    for j in 0..<imp.signature.params.len() {
        parameters.push(CParameter { .type = extern_parameter_type(imp, types, j) })
    }
    result :: extern_result_type(imp, types)
    signature :: CSignature {
        .storage = .Declaration,
        .result = result,
        .name = imp.extern_name,
        .parameters = parameters,
    }
    return CPrototype { .signature = signature }
}

// The C type the foreign symbol declares for parameter `j` of `imp`.
extern_parameter_type :: fn(imp: BcImport, types: BcType[], j: i64) -> string {
    sig :: imp.signature
    writes :: param_is_c_out(sig, j)
    if is_abi_array(types, sig.param_types[j]) {
        // One Vader array = ONE C argument, a bare pointer. A length, when
        // the callee wants one, is an ordinary declared parameter — so the
        // declaration transcribes the C prototype one-to-one, and a callee
        // wanting a NUL-terminated `LPCWSTR` gets exactly one argument.
        // `@c_out` decides `void*` vs `const void*`, through
        // `BcSignature.param_c_out`.
        return pointer_to("void", writes)
    }
    mirror :: mirrored_c_struct(types, sig.param_types[j])
    if mirror != "" {
        // Classified BEFORE `@c_pointer`, as `user_extern_shim` does: the
        // shim spills a real C struct and passes ITS address, so the erased
        // slot type would declare `void**` against a `struct timespec*`.
        // The two cascades must agree on the order or the prototype and the
        // call site disagree. Without `@c_pointer` the struct itself crosses.
        if param_is_by_address(sig, j) {
            return pointer_to(mirror, writes)
        }
        return mirror
    }
    if param_is_by_address(sig, j) {
        // `@c_pointer`: the callee takes `T*`. `const` unless `@c_out` says it
        // writes through it.
        return pointer_to(spilled_c_type(imp, j), writes)
    }
    if is_abi_nullable_pointer(types, sig.param_types[j]) {
        return "void*"
    }
    return param_c_type(imp, j) ?? extern_c_type(sig.params[j])
}

// The C type the foreign symbol declares for the result of `imp`.
extern_result_type :: fn(imp: BcImport, types: BcType[]) -> string {
    result_type :: bc_single_result_type(imp.signature)
    if is_abi_nullable_pointer(types, result_type) {
        return "void*"
    }
    mirror :: mirrored_c_struct(types, result_type)
    if mirror != "" {
        return mirror
    }
    return c_result_type(imp) ?? extern_c_type(bc_single_result(imp.signature))
}

// The C type of the temporary a `@c_pointer` scalar parameter is spilled to.
spilled_c_type :: fn(imp: BcImport, j: i64) -> string =
    param_c_type(imp, j) ?? c_type_for_val_bare(imp.signature.params[j])

// One `_Static_assert` per distinct `@c_type` of the extern `imports` and the
// Vader type it renames.
c_type_asserts :: fn(imports: BcImport[]) -> CTopLevel[] {
    out: CTopLevel[]: []
    seen: string[]: []
    for imp in imports {
        sig :: imp.signature
        for j in 0..<sig.params.len() {
            spelling :: param_c_type(imp, j) ?? continue
            push_c_type_assert(spelling, sig.params[j], seen, out)
        }
        spelling :: c_result_type(imp) ?? continue
        push_c_type_assert(spelling, bc_single_result(sig), seen, out)
    }
    return out
}

// Push the assert that `spelling` is an integer as wide as the Vader `val`, unless
// `seen` holds that pair already.
push_c_type_assert :: fn(spelling: string, val: ValType, seen: string[], out: CTopLevel[]) -> void {
    vader_type :: c_type_for_val_bare(val)
    key :: "${spelling} ${vader_type}"
    if key in seen {
        return
    }
    seen.push(key)
    c_width :: call("sizeof", [verbatim(spelling)])
    wide :: binary(.Equal, c_width, call("sizeof", [verbatim(vader_type)]))
    // An integer type truncates `0.5` to `0` ; a floating one keeps it.
    integral :: binary(.Equal, cast(spelling, verbatim("0.5")), number(0))
    message :: "@c_type(${spelling}) is an integer as wide as ${vader_type}"
    out.push(static_assert(binary(.LogicalAnd, wide, integral), message))
}

// `type*`, or `const type*` when the callee may not write through it.
pointer_to :: fn(type: string, writes: bool) -> string = if writes {
    "${type}*"
} else {
    "const ${type}*"
}

/// True when the slot at `type_index` is `CPointer | null` — the nullable
/// foreign pointer. Inside Vader it stays an ordinary boxed union; the shim
/// converts it to a bare `void*` at the boundary, the same way it already
/// converts a `vader_string_t` atom id to a `const char*`.
///
/// @param types       the module's BcType table.
/// @param type_index  the slot's BcType index, or `-1` when absent.
/// @return            whether the slot needs the null/pointer conversion.
is_abi_nullable_pointer :: fn(types: BcType[], type_index: i32) -> bool {
    if type_index < 0 {
        return false
    }
    if type_index >= i32(types.len()) {
        return false
    }
    u :: types[type_index]
    if u is BcUnion {
        if u.variants.len() != 2 {
            return false
        }
        has_null := false
        has_ptr := false
        for vi in u.variants {
            if vi < 0 || vi >= i32(types.len()) {
                continue
            }
            v :: types[vi]
            if v is BcScalar {
                if v.val == .Null {
                    has_null = true
                }
                if v.val == .Pointer {
                    has_ptr = true
                }
            }
        }
        return has_null && has_ptr
    }
    return false
}

/// Whether the slot at `type_index` is `string | null` — the shape a C function
/// returning a `char*` uses to say "absent" rather than "empty".
///
/// @param types       the module's BcType table.
/// @param type_index  the slot's BcType index, or `-1` when absent.
/// @return            whether the slot is exactly `string | null`.
is_abi_nullable_string :: fn(types: BcType[], type_index: i32) -> bool {
    if type_index < 0 || type_index >= i32(types.len()) {
        return false
    }
    u :: types[type_index]
    if u !is BcUnion {
        return false
    }
    if u.variants.len() != 2 {
        return false
    }
    has_null := false
    has_str := false
    for vi in u.variants {
        if vi < 0 || vi >= i32(types.len()) {
            continue
        }
        v :: types[vi]
        if v is BcScalar {
            if v.val == .Null   { has_null = true }
            if v.val == .String { has_str = true }
        }
    }
    return has_null && has_str
}

/// True when the import slot at `type_index` is a primitive-element array —
/// the shape `validate_extern` admits, and which crosses as ONE bare pointer.
///
/// A length, when the callee wants one, is a parameter of its own.
///
/// @param types       the module's BcType table.
/// @param type_index  the slot's BcType index, or `-1` when absent.
/// @return            whether the slot is lent as a pointer rather than a value.
is_abi_array :: fn(types: BcType[], type_index: i32) -> bool {
    if type_index < 0 {
        return false
    }
    if type_index >= i32(types.len()) {
        return false
    }
    return types[type_index] is BcArray
}

// ---- per-import shim ------------------------------------------------------

/// C name of the shim that serves `imp` — `vader_host_` plus its mangled name,
/// sanitised.
///
/// Named rather than indexed, for two reasons. It says WHICH host the emitted C
/// reaches, where `vader_import_5` said nothing; and it is stable, where an
/// index renumbers every later shim the moment an import is added — which
/// rewrote unrelated lines in every snapshot.
///
/// `host` rather than `import` or `intrinsic`: these shims serve BOTH the
/// stdlib's `@intrinsic` hosts and a user's `@extern` symbols, so neither of the
/// narrower words covers them — and `import` already means a module import in
/// Vader source. It is the word the SPEC, the VM and the diagnostics use.
///
/// @param imp  the import to name.
/// @return     a valid C identifier, unique per import.
export host_shim_name :: fn(imp: BcImport) -> string = "vader_host_${sanitise(imp.mangled_name)}"

/// The `vader_host_*` definition for one import : its erased signature — each
/// parameter `a<j>` — and the body `shim_body` builds.
///
/// @param ctx  the emit context.
/// @param imp  the import the shim serves.
import_shim :: fn(ctx: EmitCtx, imp: BcImport) -> CFunction = CFunction {
    .signature = shim_signature(ctx, imp),
    .body = CBlock { .body = shim_body(imp, ctx.module.types) },
}

// The head of `imp`'s shim. A shim in its `CLibrary`'s unit takes external
// linkage, for the prototypes the other units reach it through. Any other is
// private to each unit that includes it, and `static inline` in a split build,
// because the shim lives in the SHARED HEADER there: a one-line ABI wrapper is
// worth nothing as an out-of-line cross-TU call, and it was the real barrier:
// with the shim in unit 0, wordcount's per-byte read still paid a call per byte
// even after the runtime accessor behind it became inline (+211 % vs mono).
shim_signature :: fn(ctx: EmitCtx, imp: BcImport) -> CSignature {
    signature :: CSignature {
        .storage = .Internal,
        .inline = ctx.split,
        .result = c_type_for_val_bare(bc_single_result(imp.signature)),
        .name = host_shim_name(imp),
        .parameters = value_parameters(imp.signature.params, "a"),
    }
    if ctx.library_units && library_name(imp) != "" {
        return CSignature { ...signature, .storage = .External, .inline = false }
    }
    return signature
}

// The body of a shim opening a library through `opener`, named by the string `name`.
library_open_shim :: fn(opener: string, name: CExpression) -> CStatement[] = [
    declaration("const char*", "c0", call("vader_string_to_cstr", [name])),
    declaration("void*", "r", call(opener, [verbatim("c0")])),
    perform("vader_cstr_free_for", [name, verbatim("c0")]),
    CReturn { .value = address_as_integer(verbatim("r")) },
]

// The body of the `vader_host_*` shim for `imp`. A host `@intrinsic` routes to
// its `vader_*` runtime helper by its IntrinsicId (classified from the mangled
// name by `bytecode/intrinsic_manifest::intrinsic_id_for`, shared with the VM's
// `dispatch_import`). Hosts the
// VM serves but c-emit doesn't — string index_of/last_index_of, the primitive
// Equals/Display (materialised as pure Vader natively), the extra std/math
// overloads — plus non-intrinsics fall through to the @extern forwarder or to a
// loud trap (compiler/runtime version skew). Exhaustive, so a new IntrinsicId
// trips T3013 here.
shim_body :: fn(imp: BcImport, types: BcType[]) -> CStatement[] {
    a0 :: argument(0)
    a1 :: argument(1)
    match intrinsic_id_for(imp.mangled_name) {
    // std/io — implemented by the runtime.
    .AbortPanic -> { return [perform("vader_panic", [a0])] }

    // std/string internals + std/core string intrinsics.
    .ByteLen -> { return [returning("vader_string_byte_len", [a0])] }
    .ByteAt -> { return [returning("vader_string_byte_at", [a0, a1])] }
    .ByteSlice -> { return [returning("vader_string_byte_slice", [a0, a1, argument(2)])] }
    .IsAscii -> { return [returning("vader_string_is_ascii", [a0])] }
    .Bytes -> {
        u8 :: class_index(types, .U8)
        if u8 < 0 { return [trap("bytes: no u8 type")] }
        u8arr :: array_tag(types, u8)
        if u8arr < 0 { return [trap("bytes: no u8[] type")] }
        view :: call("vader_string_bytes_view", [a0, unsigned(i64(u8arr)), unsigned(i64(u8))])
        return [CReturn { .value = cast("void*", view) }]
    }
    // `bytes_to_string` is backed by the runtime symbol `vader_string_as_string`.
    .BytesToString -> { return [returning("vader_string_as_string", [cast("vader_array_t*", a0)])] }
    // `string implements Hash` reads the hash cached on the atom (O(1)).
    .StringHash -> { return [returning("vader_string_hash", [a0])] }

    // std/runtime — GC introspection.
    .RuntimeCollect      -> { return [perform("vader_gc_collect", [])] }
    .RuntimeCollections  -> { return [gc_statistic("total_collections")] }
    .RuntimeBytesUsed    -> { return [gc_statistic("bytes_used")] }
    .RuntimeBytesCopied  -> { return [gc_statistic("total_copied")] }

    // std/runtime — cooperative async scheduler.
    .SchedNow  -> { return [returning("vader_sched_now", [])] }
    .SchedArm  -> { return [perform("vader_sched_arm", [a0])] }
    .SchedPark -> { return [returning("vader_sched_park", [])] }

    // Dynamic foreign calls (vader/vm/ffi.vader). The call shims take the
    // argument slots through `vader_array_bytes`, which already owns the
    // three-case array lend. Addresses ride an `i64` (see the note in
    // `vader/vm/ffi.vader`), so each shim converts through `intptr_t` at the
    // boundary.
    .FfiOpen -> { return library_open_shim("vader_ffi_open", a0) }
    .FfiOpenPath -> { return library_open_shim("vader_ffi_open_path", a0) }
    .FfiSymbol -> {
        symbol :: call("vader_ffi_symbol", [integer_as_address(a0), verbatim("c1")])
        return [
            declaration("const char*", "c1", call("vader_string_to_cstr", [a1])),
            declaration("void*", "r", symbol),
            perform("vader_cstr_free_for", [a1, verbatim("c1")]),
            CReturn { .value = address_as_integer(verbatim("r")) },
        ]
    }
    .FfiCall -> {
        arguments: CExpression[]: [
            integer_as_address(a0),
            cast("vader_array_t*", a1),
            cast("vader_array_t*", argument(2)),
            argument(3),
        ]
        return [returning("vader_ffi_call_n", arguments)]
    }
    .FfiCallFrame -> {
        arguments: CExpression[]: [
            integer_as_address(a0),
            cast("vader_array_t*", a1),
            cast("vader_array_t*", argument(2)),
        ]
        return [returning("vader_ffi_call_frame", arguments)]
    }
    .TargetCurrentOs -> { return [returning("vader_current_os", [])] }
    .TargetCurrentArch -> { return [returning("vader_current_arch", [])] }

    // Served by the VM only — primitive Equals/Display, surfaced there by erased
    // virtual dispatch, materialised as pure Vader natively — plus non-intrinsics.
    // Grouped so a new IntrinsicId variant trips T3013.
    .StringEquals | .PrimIntEquals | .PrimDisplayToString | .NotIntrinsic -> {}
    }
    // User `@extern` — forward to the real C symbol ; everything else is a
    // host fn the c-emit doesn't recognise (version skew) → trap loudly.
    if imp.is_extern {
        return user_extern_shim(imp, types)
    }
    return [trap("unbound import: ${imp.mangled_name}")]
}

// `a<j>`, the shim's `j`-th parameter.
argument :: fn(j: i64) -> CExpression = verbatim("a${j}")

// `vader_trap("message");` — a runtime abort naming what went wrong.
trap :: fn(message: string) -> CStatement = perform("vader_trap", [verbatim(c_string_lit(message))])

// `return (int32_t) vader_gc_get_stats().<field>;`.
gc_statistic :: fn(field: string) -> CStatement = CReturn {
    .value = cast("int32_t", CMember { .base = call("vader_gc_get_stats", []), .member = field }),
}

// `(int64_t) (intptr_t) pointer`: an address riding an `i64` slot.
address_as_integer :: fn(pointer: CExpression) -> CExpression =
    cast("int64_t", cast("intptr_t", pointer))

// `(void*) (intptr_t) value`: the address an `i64` slot carries.
integer_as_address :: fn(value: CExpression) -> CExpression = cast("void*", cast("intptr_t", value))

// ---- @extern forwarding ---------------------------------------------------

/// Forward an `@extern` import to its foreign symbol, marshalling each
/// `string` arg (a `vader_string_t` atom id) to a NUL-terminated
/// `const char*` via `vader_string_to_cstr` : owner atoms hand out their
/// bytes with no copy, slice atoms get a heap dup. Every marshalled arg
/// is paired with `vader_cstr_free_for(atom, cstr)` — the O(1) form that
/// discriminates owner vs dup from the atom id (the id-less
/// `vader_cstr_free` has to scan the atom table, hot at one call per
/// string arg per FFI call). A `string` result is INTERNED before the frees,
/// not merely captured: the pointer can aim INTO an argument, so holding it
/// across the free was exactly the use-after-free this claimed to prevent.
user_extern_shim :: fn(imp: BcImport, types: BcType[]) -> CStatement[] {
    sig :: imp.signature
    call_args: CExpression[]: []
    before: CStatement[]: []
    frees: CStatement[]: []
    write_backs: CStatement[]: []
    write_back_roots: CExpression[]: []
    for j in 0..<sig.params.len() {
        a :: argument(j)
        if is_abi_array(types, sig.param_types[j]) {
            // Lent for the duration of the call. A callback makes that call a
            // safepoint, so `vader_array_bytes` tenures the buffer out of the
            // moving generation first — it owns that and the three lend cases
            // (GC forward, borrowed view, materialised buf); contract in `vader.h`.
            slice :: call("vader_array_bytes", [cast("vader_array_t*", a)])
            before.push(declaration("vader_slice_t", "s${j}", slice))
            // `ptr` is `const void*` ; only a `@c_out` slot needs the cast away.
            // `.len` is deliberately unused : the callee's length, if any, is a
            // parameter of its own (see the note on revision A in the plan).
            bytes :: CMember { .base = verbatim("s${j}"), .member = "ptr" }
            call_args.push(if param_is_c_out(sig, j) { cast("void*", bytes) } else { bytes })
        } else if mirrored_c_struct(types, sig.param_types[j]) != "" {
            // A mirrored struct, lent by address or copied by value. The shim
            // declares a REAL one of the C type and marshals field by field, so
            // `cc` computes every offset from the actual header: nothing here
            // assumes a layout. The `_Static_assert` lines serve the interpreter's
            // block and a copy's completeness (`c_struct_layout_asserts`).
            //
            // Field names are taken as-is: `@c_struct` says the Vader field
            // names ARE the C ones. `c_field_name` is the single place that
            // decides, so an optional per-field `@c_name` slots in there alone.
            mirror :: mirrored_c_struct(types, sig.param_types[j])
            vader_ty :: struct_c_name(bc_struct_name(types, sig.param_types[j]))
            fields :: bc_struct_fields(types, sig.param_types[j])
            spilled :: verbatim("p${j}")
            object :: CParenthesized { .inner = cast("${vader_ty}*", a) }
            // ZERO-INITIALISED. A mirror may be a PREFIX, and where C READS the
            // members it does not name are still passed to the callee — from the
            // stack, uninitialised, if this is left bare. Zero is not necessarily
            // the RIGHT value for an unnamed member, but it is a defined one, and
            // a wrong answer beats undefined behaviour.
            before.push(declaration(mirror, "p${j}", initializer_list([number(0)])))
            // Filled BEFORE the call either way. `@c_out` says C writes; it does not
            // say the value is meaningless on entry, and a C parameter is often
            // IN-OUT — `poll` reads `fd` and `events` to decide what to watch and
            // writes `revents`. Filling a pure-out parameter costs one copy the
            // callee overwrites; NOT filling an in-out one hands C a zeroed struct.
            push_member_copies(types, fields, spilled, object, true, before, 0)
            if !param_is_by_address(sig, j) {
                // By value: C receives a copy of the spilled struct, and the
                // typecheck refuses `@c_out` here, so nothing travels back.
                call_args.push(spilled)
                continue
            }
            if param_is_c_out(sig, j) {
                // And it travels back after the call (see `write_backs` below).
                write_back_roots.push(address_of(a))
                push_member_copies(types, fields, spilled, object, false, write_backs, 0)
            }
            call_args.push(address_of(spilled))
        } else if param_is_by_address(sig, j) {
            // Spill to a stack temporary and hand over its address. The
            // temporary lives for the call and no longer — which is the whole
            // contract, and why no pointer type appears in Vader.
            before.push(declaration(spilled_c_type(imp, j), "p${j}", a))
            // `(void*)` and not a bare `&p`: with `@c_header` the real prototype
            // is visible, and a Vader `u32` is `uint32_t` while Win32 spells the
            // same 32 bits `unsigned long` — distinct pointer types to C, which
            // rejects the mismatch. `void*` converts to either.
            call_args.push(cast("void*", address_of(verbatim("p${j}"))))
        } else if is_abi_nullable_pointer(types, sig.param_types[j]) {
            // The union rides as a box inside Vader; C wants a bare `void*`.
            tag :: CMember { .base = a, .member = "tag" }
            is_null :: binary(.Equal, tag, verbatim("VADER_BOX_TAG_NULL"))
            payload :: CMember { .base = CMember { .base = a, .member = "payload" }, .member = "i" }
            pointer :: CConditional {
                .condition = is_null,
                .then_value = NULL_POINTER,
                .else_value = cast("void*", cast("intptr_t", payload)),
            }
            before.push(declaration("void*", "p${j}", pointer))
            call_args.push(verbatim("p${j}"))
        } else if sig.params[j] == .String {
            before.push(declaration("const char*", "c${j}", call("vader_string_to_cstr", [a])))
            frees.push(perform("vader_cstr_free_for", [a, verbatim("c${j}")]))
            call_args.push(verbatim("c${j}"))
        } else {
            call_args.push(renamed_argument(imp, j, a))
        }
    }
    // C never receives a mirror's Vader address — it gets `&p{j}`, the shim's own
    // temporary. What can move is the object `a{j}` addresses, which the shim
    // writes back through after the call. Rooting it lets the collector rewrite
    // it, and carries any nested child with it: the parent's own ref slot is
    // updated in the same pass. A lent ARRAY is the other shape and is secured
    // in `vader_array_bytes` instead, because there C holds the address itself.
    after: CStatement[]: []
    if write_back_roots.len() > 0 {
        count :: number(write_back_roots.len())
        before.push(array_declaration("void**", "__wb_roots", write_back_roots))
        frame :: verbatim("__wb_frame")
        before.push(perform("VADER_GC_PUSH_RAW", [frame, verbatim("__wb_roots"), count]))
        // Popped first, before the write-back that needs the rewritten pointer.
        after.push(perform("VADER_GC_POP_FRAME", [frame]))
    }
    after.push_all(write_backs)

    // The call's result is captured, the write-backs run, then the frees — and a
    // string result is interned BEFORE the frees: a returned `char*` may point
    // INTO an argument (`strstr` returns a suffix of its haystack), and
    // `vader_cstr_free_for` frees the dup a SLICE atom was marshalled through.
    // Freeing first left `strlen` and the intern reading memory that had just
    // gone back to the allocator.
    direct :: after.len() == 0 && frees.len() == 0
    forwarded :: read_back(imp, call(imp.extern_name, call_args))
    handled :: forwarded_result(sig, types, forwarded, direct)
    if handled.returns {
        before.push(handled.capture)
        return before
    }
    before.push(handled.capture)
    before.push_all(after)
    before.push_all(handled.settle)
    before.push_all(frees)
    before.push(CReturn { .value = handled.returned })
    return before
}

// The call `forwarded` as the shim's own result type : converted back from the
// `@c_type` the callee declares, when it declares one.
read_back :: fn(imp: BcImport, forwarded: CExpression) -> CExpression {
    if c_result_type(imp) == null {
        return forwarded
    }
    return cast(c_type_for_val_bare(bc_single_result(imp.signature)), forwarded)
}

// Argument `a` of parameter `j`, converted to the `@c_type` the callee declares
// for it when it declares one.
renamed_argument :: fn(imp: BcImport, j: i64, a: CExpression) -> CExpression {
    spelling :: param_c_type(imp, j) ?? return a
    return cast(spelling, a)
}

// How a forwarded call's result leaves the shim.
ForwardedResult :: struct {
    /// The call itself, its result kept in `r` when there is one.
    capture: CStatement
    /// The capture already returns the call's value : nothing follows it.
    returns: bool = false
    /// Convert `r` into `out` while the arguments are still alive.
    settle: CStatement[] = []
    /// The shim's return value ; null for a `void` shim.
    returned: CExpression | null = null
}

// The capture, conversion and return of an `@extern` call's result, by the
// shape of the declared result type. `direct` : nothing has to run after the
// call, so a plain result can be returned as it comes.
forwarded_result :: fn(
    sig: BcSignature,
    types: BcType[],
    forwarded: CExpression,
    direct: bool,
) -> ForwardedResult {
    result :: verbatim("r")
    out :: verbatim("out")
    result_type :: bc_single_result_type(sig)
    if bc_single_result(sig) == .Void {
        return ForwardedResult { .capture = CExpressionStatement { .expression = forwarded } }
    }
    if is_abi_nullable_pointer(types, result_type) {
        // Symmetric with the parameter side : a bare `void*` comes back, and
        // `NULL` becomes the union's null variant rather than a tagged pointer.
        boxed :: box_expr(result, .Pointer, present_tag(types, .Pointer))
        return ForwardedResult {
            .capture = declaration("void*", "r", forwarded),
            .returned = null_or(result, boxed),
        }
    }
    if is_abi_nullable_string(types, result_type) {
        // `char*` says "absent" with NULL; folding that onto `""` would lose the
        // distinction `getenv` rests on. Borrowed, like every returned string.
        boxed :: box_call("i64", present_tag(types, .String), cast("int64_t", interned(result)))
        return ForwardedResult {
            .capture = declaration("const char*", "r", forwarded),
            .settle = [declaration("vader_box_t", "out", null_or(result, boxed))],
            .returned = out,
        }
    }
    if bc_single_result(sig) == .String {
        // A C string comes back BORROWED: interned into the atom table, never
        // freed. Not a stopgap — it is the CORRECT semantics for a pointer the
        // library owns (`getenv`, `strerror`, a struct member), which is what
        // every such callee in this tree returns, and its worst case elsewhere
        // is a leak on the C side rather than a corruption.
        //
        // A callee that hands over memory is bound to return `CPointer` and
        // freed explicitly through its own deallocator — `curl_free`,
        // `sqlite3_free` — because ownership is not one bit but a function name.
        // An `@owned` marker was designed and dropped for that reason; it would
        // also have been the only claim on this boundary that `cc` could not
        // check.
        //
        // NULL interns as the empty string: a bare `string` carries no null
        // variant. A callee that must distinguish absent from empty is declared
        // `string | null`, handled by the branch above.
        empty :: call("vader_atom_intern", [verbatim("\"\""), number(0)])
        atom :: CConditional {
            .condition = binary(.Equal, result, NULL_POINTER),
            .then_value = empty,
            .else_value = interned(result),
        }
        return ForwardedResult {
            .capture = declaration("const char*", "r", forwarded),
            .settle = [declaration("vader_string_t", "out", atom)],
            .returned = out,
        }
    }
    mirror :: mirrored_c_struct(types, result_type)
    if mirror != "" {
        return mirror_result(types, result_type, mirror, forwarded)
    }
    if direct {
        return ForwardedResult { .capture = CReturn { .value = forwarded }, .returns = true }
    }
    return ForwardedResult {
        .capture = declaration(c_type_for_val_bare(bc_single_result(sig)), "r", forwarded),
        .returned = result,
    }
}

// `pointer == NULL ? vader_box_null() : boxed` — a nullable result as a box.
null_or :: fn(pointer: CExpression, boxed: CExpression) -> CExpression = CConditional {
    .condition = binary(.Equal, pointer, NULL_POINTER),
    .then_value = call("vader_box_null", []),
    .else_value = boxed,
}

// `vader_atom_intern(text, strlen(text))` — a C string as a Vader string.
interned :: fn(text: CExpression) -> CExpression =
    call("vader_atom_intern", [text, call("strlen", [text])])

/// The C type the struct at `type_index` mirrors, or `""` when the slot is not
/// a `@c_struct` struct.
///
/// @param types       the module type table.
/// @param type_index  the slot ; `-1` is absent.
/// @return            e.g. `"struct timespec"`, or `""`.
mirrored_c_struct :: fn(types: BcType[], type_index: i32) -> string {
    mirror :: mirror_at(types, type_index) ?? return ""
    return mirror.c_name
}

/// The Vader struct name at `type_index`, or `""`.
///
/// @param types       the module type table.
/// @param type_index  the slot.
/// @return            the mangled Vader name.
bc_struct_name :: fn(types: BcType[], type_index: i32) -> string {
    if type_index < 0 || i64(type_index) >= types.len() {
        return ""
    }
    t :: types[type_index]
    if t is BcStruct {
        return t.name
    }
    return ""
}

/// The fields of the struct at `type_index`, or empty.
///
/// @param types       the module type table.
/// @param type_index  the slot.
/// @return            the field list, in declaration order.
bc_struct_fields :: fn(types: BcType[], type_index: i32) -> BcField[] {
    if type_index < 0 || i64(type_index) >= types.len() {
        return []
    }
    t :: types[type_index]
    if t is BcStruct {
        return t.fields
    }
    return []
}

/// The C name of a mirrored field. Today the Vader name IS the C name, which is
/// what `@c_struct` declares; this is the ONE place that decides, so an optional
/// per-field `@c_name` becomes a change here and nowhere else.
///
/// @param f  the field.
/// @return   the C member name.
c_field_name :: fn(f: BcField) -> string = f.name

/// Foreign C-ABI type for an `@extern` slot — identical to
/// `c_type_for_val_bare` except `string`, which the foreign side consumes
/// as `const char*` (the shim marshals between the two).
extern_c_type :: fn(v: ValType) -> string {
    if v == .String { return "const char*" }
    return c_type_for_val_bare(v)
}

// ---- tag lookups ----------------------------------------------------------

/// BcType index of the scalar of class `val`, or `0` when it is absent. A shim
/// referencing an absent tag only runs when the program actually uses that
/// value, by which point the type is present.
present_tag :: fn(types: BcType[], val: ValType) -> i32 {
    tag :: class_index(types, val)
    return if tag < 0 { 0 } else { tag }
}

/// BcType index of the scalar of class `val`, or `-1` when absent.
class_index :: fn(types: BcType[], val: ValType) -> i32 {
    for i in 0..<types.len() {
        t :: types[i]
        if t is BcScalar {
            if t.val == val { return i32(i) }
        }
    }
    return -1
}

/// BcType index of the array whose element is type `elem`, or `-1`.
array_tag :: fn(types: BcType[], elem: i32) -> i32 {
    for i in 0..<types.len() {
        t :: types[i]
        if t is BcArray {
            if t.element == elem { return i32(i) }
        }
    }
    return -1
}

