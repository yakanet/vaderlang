// vader/emit/c/value_ops: constants, locals, arithmetic, comparisons and conversions.
//
// The scalar half of `emit_op` (`walker.vader`): each op pops its operands
// off the `FnState` stack and pushes the C expression of its result.

module "vader/emit/c"

import "std/string"
import "vader/core/bytecode"
import "vader/emit/c/ast"
// The opcode union pulls in ~120 names ; the namespace form keeps the
// import to one line and tags every op site as `Bc.<Op>` at the match.
Bc :: import "vader/core/bytecode"

// ---- constants and locals -------------------------------------------------

/// C source for a constant op: used both for the `return.lit` payload
/// (`emit_return_lit`) and the const-push path (`push_const`). Exhaustive
/// over the closed `ConstOp` union.
///
/// @param ctx  emit context: supplies the null primitive tag and the
///             string-literal atom ids.
/// @param c    the constant op to render.
/// @return     a C expression (no trailing `;`).
const_lit_c :: fn(ctx: EmitCtx, c: Bc.ConstOp) -> CExpression = match c {
    is Bc.I32Const    -> CIntegerLiteral { .class = .I32, .value = i64(c.value) }
    is Bc.I64Const    -> CIntegerLiteral { .class = .I64, .value = c.value }
    is Bc.F64Const    -> verbatim(float_lit(c.value))
    is Bc.BoolConst   -> verbatim(if c.value { "true" } else { "false" })
    is Bc.CharConst   -> verbatim("${u32(c.value)}u")
    is Bc.NullConst   -> verbatim("vader_box_obj(${ctx.null_tag}u, NULL)")
    is Bc.StringConst -> verbatim("${ctx.atom_ids[c.index]}u")
}

/// C literal for an f64 value. A `.0` suffix is appended when the rendered
/// value has no `.`/`e`, so the C literal stays a `double`.
///
/// IEEE non-finite values (`inf` / `-inf` / `nan`, e.g. a comptime-folded
/// `1.0e308 * 100.0`) have no plain C literal: `"${value}"` renders them as
/// the bare words `inf` / `nan`, which the C compiler reads as undeclared
/// identifiers. Emit the equivalent compiler builtins instead : they need no
/// `<math.h>` and, unlike `(1.0/0.0)`, don't trip a div-by-zero constant-fold
/// warning under `-Werror`.
float_lit :: fn(value: f64) -> string {
    s :: "${value}"
    if s == "inf"           { return "__builtin_inf()" }
    if s == "-inf"          { return "(-__builtin_inf())" }
    if s == "nan"           { return "__builtin_nan(\"\")" }
    if "." in s || "e" in s { return s }
    return "${s}.0"
}

/// Push a constant op as a `StackLit`: `const_val` gives the stack
/// ValType, `const_lit_c` the C literal.
push_const :: fn(s: FnState, c: Bc.ConstOp) -> void = push_lit(
    s,
    const_val(c),
    const_lit_c(s.ctx, c),
)

/// Stack ValType produced by a constant op. Exhaustive over `ConstOp`.
/// `NullConst` boxes to `.Any` on the C stack: a deliberate divergence
/// from `emit/bytecode::const_val_type`, which wants `.Null` for its
/// const-propagation slot typing.
const_val :: fn(c: Bc.ConstOp) -> ValType = match c {
    is Bc.I32Const    -> .I32
    is Bc.I64Const    -> .I64
    is Bc.F64Const    -> .F64
    is Bc.BoolConst   -> .Bool
    is Bc.CharConst   -> .Char
    is Bc.NullConst   -> .Any
    is Bc.StringConst -> .String
}

/// `local.get`: push a snapshot of slot `l.slot` (spelled `lN`). A
/// `void` slot carries nothing on the stack, so it is a no-op.
emit_local_get :: fn(s: FnState, l: Bc.LocalGet) -> void {
    val :: slot_val_type(s.function, l.slot)
    if val == .Void {
        return
    }
    push_local_ref(s, l.slot, val)
}

/// `local.set` / `local.tee`: materialise any stack entry the write
/// would invalidate, pop the value, emit `lN = <value>;`, and (for
/// `tee`) re-push the slot. A `void` slot is a no-op. A value whose
/// ValType differs from the slot's is reconciled by `coerce_expr` (box /
/// unbox / cast) before the store.
emit_local_set :: fn(s: FnState, slot: i32, tee: bool) -> void {
    slot_val :: slot_val_type(s.function, slot)
    if slot_val == .Void {
        return
    }
    materialize_stack_for_slot(s, slot)
    v :: pop(s)
    assign(s, CLocal { .slot = slot }, coerced_as(s, v, slot_val))
    if tee {
        push_local_ref(s, slot, slot_val)
    }
}

// ---- arithmetic and comparisons -------------------------------------------

/// Push a binary op result as a `StackExpr`. Equality (`==` / `!=`) stays
/// paren-free so `if (${expr})` doesn't trip `-Wparentheses-equality` ;
/// every other operator is parenthesised for precedence safety.
push_binop :: fn(s: FnState, op: CBinaryOperator, val: ValType) -> void = push_expr(
    s,
    val,
    binary_expression(s, op, val),
)

/// Push a shift whose count keeps its low 5 bits, 6 at a 64-bit `val`, as the
/// comptime fold takes it : C leaves a count past the width undefined, and folds a
/// constant one to anything. A literal count already within the width is left as
/// written.
push_shift :: fn(s: FnState, op: CBinaryOperator, val: ValType) -> void {
    mask :: shift_count_mask(val)
    count :: pop(s)
    if literal_within(count, mask) {
        s.stack.push(count)
    } else {
        push_expr(s, val, CParenthesized {
            .inner = binary(.BitAnd, operand_as(s, count, val), number(mask)),
        })
    }
    push_binop(s, op, val)
}

// The mask of a shift's count at the width of `val`.
shift_count_mask :: fn(val: ValType) -> i64 {
    if val == .I64 || val == .U64 {
        return 63
    }
    return 31
}

// Whether `count` is an integer literal from 0 to `mask`, which the mask keeps.
literal_within :: fn(count: StackVal, mask: i64) -> bool {
    if count !is StackLit {
        return false
    }
    literal :: count.expression
    return literal is CIntegerLiteral && literal.value >= 0 && literal.value <= mask
}

/// Push a comparison as a `StackExpr` of class `.Bool`. The operands carry
/// the op's numeric class (`operand_val`), distinct from the `.Bool` result,
/// so an erased operand (an `any` flowing into `i32.lt` etc.) is unboxed to
/// the right class before the C compare.
push_cmp :: fn(s: FnState, op: CBinaryOperator, operand_val: ValType) -> void = push_expr(
    s,
    .Bool,
    binary_expression(s, op, operand_val),
)

/// Pop the two operands, coerce each to `operand_val` (the op's operand class:
/// identity when already that class, an unbox when an erased `any` reaches
/// the op), and build the infix expression. Equality stays paren-free so an
/// `if` on it doesn't trip `-Wparentheses-equality` ; every other operator is
/// parenthesised for precedence safety.
binary_expression :: fn(s: FnState, op: CBinaryOperator, operand_val: ValType) -> CExpression {
    right :: pop(s)
    left :: pop(s)
    infix :: binary(op, left_operand(s, op, left, right, operand_val), operand_as(s, right, operand_val))
    if op == .Equal || op == .NotEqual {
        return infix
    }
    return CParenthesized { .inner = infix }
}

// `left` as the left operand of `op` at class `class` (`operand_as`), cast to the
// unsigned type of `class` where C would otherwise compare or shift it signed :
// constants, checked-arithmetic temporaries and buffer loads all ride signed
// (`stack_class_of`). A shift takes its signedness from its left operand alone ;
// a comparison turns unsigned once either operand is.
left_operand :: fn(
    s: FnState, op: CBinaryOperator, left: StackVal, right: StackVal, class: ValType,
) -> CExpression {
    value :: operand_as(s, left, class)
    if !signed_under_unsigned(val_of(left), class) {
        return value
    }
    if op == .ShiftRight || signed_under_unsigned(val_of(right), class) {
        return scalar_cast(value, val_of(left), class)
    }
    return value
}

// Whether `from` is the signed class of the unsigned class `to`.
signed_under_unsigned :: fn(from: ValType, to: ValType) -> bool =
    (from == .I64 && to == .U64) || (from == .I32 && to == .U32)

// `value` coerced as an operand of class `class` (`coerce_operand`).
operand_as :: fn(s: FnState, value: StackVal, class: ValType) -> CExpression =
    coerce_operand(s.ctx.module.types, expression_of(value), val_of(value), class)

// `value` coerced to class `class` (`coerce_expr`).
coerced_as :: fn(s: FnState, value: StackVal, class: ValType) -> CExpression =
    coerce_expr(s.ctx.module.types, expression_of(value), val_of(value), class)

/// Push a unary op result as a `StackExpr`. The operand is coerced to `val`
/// (unbox an erased `any`) and wrapped in parens: unary binds tighter than
/// the comparisons, so e.g. `~l0 == 0` would otherwise mis-parse.
push_unop :: fn(s: FnState, op: string, val: ValType) -> void {
    v :: pop(s)
    push_expr(s, val, CUnary { .operator = op, .operand = operand_as(s, v, val) })
}

/// `i64.neg`. Special-cases `-(INT64_MIN)` : the source most-negative
/// literal `-9223372036854775808` reaches the emitter as
/// `i64.const INT64_MIN ; i64.neg`, and spelling that `-(INT64_MIN)`
/// overflows `int64_t` (UB ; trips `-Woverflow` on gcc). Since
/// `-INT64_MIN` wraps back to `INT64_MIN` on two's-complement (exactly
/// the value the source denotes) fold the pair to a bare `INT64_MIN`,
/// identical to how a plain `i64.const INT64_MIN` is spelled. Any other
/// operand negates normally.
push_i64_neg :: fn(s: FnState) -> void {
    v :: pop(s)
    operand :: operand_as(s, v, .I64)
    if operand is CIntegerLiteral && operand.class == .I64 && is_most_negative(operand) {
        push_lit(s, .I64, operand)
    } else {
        push_expr(s, .I64, CUnary { .operator = "-", .operand = operand })
    }
}

/// `f64.to_bits`: reinterpret an f64 as its raw IEEE u64 bits. Emits a C99
/// compound-literal union (well-defined type-punning in C ; the optimiser folds
/// it to a bit-move) so there is NO runtime symbol. The u64 result rides in the
/// `.I64` stack slot (same 64 bits).
emit_f64_to_bits :: fn(s: FnState) -> void {
    v :: pop(s)
    push_expr(s, .I64, around("(int64_t)(((union { double __vd; uint64_t __vu; }){ .__vd = ", operand_as(s, v, .F64), " }).__vu)"))
}

/// `u64.from_bits`, the inverse : reinterpret a u64 bit pattern (in the `.I64`
/// slot) as an f64. Same compound-literal-union technique, no runtime symbol.
emit_bits_to_f64 :: fn(s: FnState) -> void {
    v :: pop(s)
    push_expr(s, .F64, around("(((union { uint64_t __vu; double __vd; }){ .__vu = (uint64_t)(", operand_as(s, v, .I64), ") }).__vd)"))
}

/// `f32.to_bits`: the 32-bit analogue. The u32 result rides in the `.I32`
/// stack slot.
emit_f32_to_bits :: fn(s: FnState) -> void {
    v :: pop(s)
    push_expr(s, .I32, around("(int32_t)(((union { float __vf; uint32_t __vb; }){ .__vf = ", operand_as(s, v, .F32), " }).__vb)"))
}

/// `u32.from_bits`, the inverse : reinterpret a u32 bit pattern (in the `.I32`
/// slot) as an f32. Same compound-literal-union technique, no runtime symbol.
emit_bits_to_f32 :: fn(s: FnState) -> void {
    v :: pop(s)
    push_expr(s, .F32, around("(((union { uint32_t __vb; float __vf; }){ .__vb = (uint32_t)(", operand_as(s, v, .I32), ") }).__vf)"))
}

/// Emit an eager binary op into a fresh temp : `tN = l <op> r;`. Used for
/// `div` / `rem` (every width, incl. f64): materialised unconditionally so a
/// divide-by-zero guard runs whether or not the result is consumed. An integer
/// `div` / `mod` is routed through a `vader_{div,mod}_<width>` runtime helper
/// that traps on a zero divisor (and folds `INT_MIN / -1`), aligning native on
/// the VM ; a bare `a / b` gives a silent zero on arm64 and SIGFPE on x86,
/// neither of which matches the VM's labelled trap. Float divide keeps IEEE
/// `inf` / `nan` and stays a bare `l / r`. Operands are coerced to `val`
/// (unbox an erased `any`).
push_eager :: fn(s: FnState, op: CBinaryOperator, val: ValType) -> void {
    right :: pop(s)
    left :: pop(s)
    dividend :: operand_as(s, left, val)
    divisor :: operand_as(s, right, val)
    helper :: div_mod_helper(op, val)
    if helper == null {
        push_into_temporary(s, binary(op, dividend, divisor), val)
    } else {
        push_into_temporary(s, call(helper, [dividend, divisor]), val)
    }
}

/// A checked `+` / `-` / `*` (`CheckedArith`) : `vader_chk_<op>(<kind>, l, r)`
/// (`runtime/c/vader.h`), which stops the run on overflow outside `--release`
/// and wraps in it. Materialised into a temp like `push_eager`, so the check runs
/// at its op whether or not the result is read. Operands and result ride in the
/// stack class of `kind`.
emit_checked_arith :: fn(s: FnState, op: Bc.CheckedArith) -> void {
    class :: stack_class_of(op.kind)
    right :: pop(s)
    left :: pop(s)
    arguments :: [
        verbatim(Bc.val_type_name(op.kind)),
        operand_as(s, left, class),
        operand_as(s, right, class),
    ]
    push_into_temporary(s, call("vader_chk_${Bc.checked_op_name(op.op)}", arguments), class)
}

/// A checked negation (`CheckedNeg`) : `vader_chk_neg(<kind>, v)`, as
/// `emit_checked_arith`.
emit_checked_neg :: fn(s: FnState, op: Bc.CheckedNeg) -> void {
    class :: stack_class_of(op.kind)
    v :: pop(s)
    arguments :: [verbatim(Bc.val_type_name(op.kind)), operand_as(s, v, class)]
    push_into_temporary(s, call("vader_chk_neg", arguments), class)
}

// The stack class an integer of class `kind` rides in.
stack_class_of :: fn(kind: ValType) -> ValType {
    if Bc.is_64_bit_int_val(kind) {
        return .I64
    }
    return .I32
}

// @partial: only the four integer widths that reach push_eager are guarded ;
// every other ValType (floats, refs) stays a bare operator.
/// Runtime guard-helper name for an integer `div` / `mod`, or `null` for a
/// width the backend leaves as a bare operator (floats: IEEE `inf` / `nan`,
/// no guard). `push_eager` only ever passes `.Divide` or `.Remainder` here. The name is
/// `vader_<div|mod>_<width>` ; the helpers live in `runtime/c/vader.h` and
/// carry trap messages matching the VM's op labels.
div_mod_helper :: fn(op: CBinaryOperator, val: ValType) -> string | null = @partial match val {
    .I32 | .I64 | .U32 | .U64 -> {
        verb :: if op == .Divide { "div" } else { "mod" }
        "vader_${verb}_${Bc.val_type_name(val)}"
    }
    _                         -> null
}

// ---- conversions ----------------------------------------------------------

/// Reinterpret the top value into `target_val` (the `Convert` op, whatever its
/// target width: `char` included). Same type → pass-through ; else a `((to)(from) v)`
/// double-cast where the inner cast pins the *source* signedness.
///
/// The bytecode collapses every integer ≤ 32 bits onto the `I32` stack
/// class, so a `u32` source rides as `.I32` and `val_of(v)` alone would
/// sign-extend it on a widen to 64 bits. When the op records an unsigned
/// source (`from_name` starts with `"u"`) widening to `i64`, reinterpret
/// through `uint32_t` so the bits zero-extend: a `u32` carries a magnitude,
/// not a signed value.
///
/// Kept deliberately narrow to the `i32`-class unsigned source widening to
/// `i64` OR `f64`: the two cases where an `I32`-class `u32` gets extended past
/// its 32 bits. `f64` matters too : `f64(x)` on a `u32` ≥ 2^31 otherwise emits
/// `((double)(int32_t) x)`, reinterpreting the magnitude as a negative int and
/// landing a negative double (the VM zero-extends, so native diverged: CR-a).
/// A BROADER rule (reinterpret *every* unsigned source through its stack-width
/// unsigned type, incl. the `.I64` class → `uint64_t`) regresses the
/// bootstrap : it changes how the compiler's own 64-bit literal rendering
/// compiles and miscompiles large `i64`/`u64` constants (fixed point breaks,
/// `INT64_MAX` emits as `4294967295`). u8/u16 are always < 2^31, so sign- and
/// zero-extension coincide ; u64 is already `.I64` and never widens.
///
/// @param target_val  the result stack class (`I32`/`I64`/`F64`/`Char`).
/// @param from_name   the op's recorded source type name (`"u32"`, `"i64"`,
///                    …) ; `""` when the target is not 64-bit.
emit_convert :: fn(s: FnState, target_val: ValType, from_name: string) -> void {
    v :: pop(s)
    stack_val :: val_of(v)
    from_val :: if (target_val == .I64 || target_val == .F64) && stack_val == .I32 && from_name.starts_with(
        "u",
    ) {
        ValType.U32
    } else {
        stack_val
    }
    if is_ref_val(stack_val) {
        // The value is still BOXED (an erased `any`/`ref` slot, e.g. a
        // `Distinct | null` field narrowed to its raw member) flowing into a
        // numeric convert. Unbox it to the target primitive, like `coerce_expr`:
        // a plain `(int64_t)(vader_box_t)x` cast of a box is invalid C.
        push_expr(s, target_val, unbox_expr(expression_of(v), target_val))
    } else if from_val == target_val {
        push_expr(s, target_val, expression_of(v))
    } else {
        push_expr(s, target_val, CParenthesized { .inner = scalar_cast(expression_of(v), from_val, target_val) })
    }
}

/// `ConvertTarget` enum → its `ValType`.
convert_target_val :: fn(t: Bc.ConvertTarget) -> ValType = match t {
    .I32  -> .I32
    .I64  -> .I64
    .F64  -> .F64
    .Char -> .Char
}

// ---- globals and data constants -------------------------------------------

// `data.const N`: push a zero-copy box over the immortal `.rodata` array
// `vader_data_N` (emitted by `emit_data_pool`). Re-stamps the call-site type_id
// onto the box, mirroring the VM's `DataConst` arm + the static-fn-ref box.
emit_data_const_op :: fn(s: FnState, op: Bc.DataConst) -> void {
    push_object(s, address_of(verbatim("vader_data_${op.pool_index}")))
}

// `global.get N`: the value of `vader_global_N`, read into a temporary: a later
// `global.set` must not change what was read.
emit_global_get :: fn(s: FnState, op: Bc.GlobalGet) -> void {
    val :: global_slot_val(s.ctx.module, op.index)
    push_into_temporary(s, verbatim("vader_global_${op.index}"), val)
}

// `global.set N`: the popped value into `vader_global_N`. The global is a root of
// the permanent frame, scanned at every collection, so no write barrier.
emit_global_set :: fn(s: FnState, op: Bc.GlobalSet) -> void {
    v :: pop(s)
    target :: verbatim("vader_global_${op.index}")
    assign(s, target, coerced_as(s, v, global_slot_val(s.ctx.module, op.index)))
}

// ---- strings --------------------------------------------------------------
//
// Strings are interned atoms (`vader_string_t` = `u32`), so `string.eq` / `.ne`
// are plain `==` / `!=` (atom identity == value equality). Codepoint access
// (`s[i]`, `s[lo..<hi]`) is Vader over the `byte_*` host intrinsics;
// concatenation (`+`), `Display` and `${…}` interpolation are Vader over a byte
// `Buffer`. `ref.eq` compares boxed `ref` / `any` via `vader_box_eq`.

/// Push a boxed-reference equality (`ref.eq` / `ref.ne`). Two boxes compare
/// through `vader_box_eq` (tag + payload word), since C can't compare
/// `vader_box_t` with `==` ; `!=` negates it. Otherwise one side is a raw
/// object pointer, and the two compare as pointers.
push_binop_any :: fn(s: FnState, op: CBinaryOperator, result_val: ValType) -> void {
    r :: pop(s)
    l :: pop(s)
    // A box may hold a scalar, whose payload word can equal null's : the tag has
    // to take part, or `null == 0` holds.
    if val_of(l) == .Any && val_of(r) == .Any {
        equal :: call("vader_box_eq", [expression_of(l), expression_of(r)])
        compared :: if op == .Equal { equal } else { CUnary { .operator = "!", .operand = equal } }
        push_expr(s, result_val, compared)
        return
    }
    // A raw object pointer against a box: compare the object pointers. A `.Ref`
    // is already the pointer ; an `.Any` box carries it in `.payload.obj` (NULL
    // for the null variant). Same object ⇒ same pointer ⇒ same tag, so the
    // pointer compare is identity.
    lp :: object_pointer_of(l)
    rp :: object_pointer_of(r)
    // Paren-free : `ref.eq` / `ref.ne` are equality, so `if (${expr})` would
    // otherwise wrap a bare `==` in a second pair and trip `-Wparentheses-equality`
    // (mirrors `binary_expression`'s equality rule).
    push_expr(s, result_val, binary(op, lp, rp))
}

// `string.compare` : the runtime's three-way byte order of the two atoms.
emit_string_compare :: fn(s: FnState) -> void {
    right :: pop(s)
    left :: pop(s)
    arguments :: [operand_as(s, left, .String), operand_as(s, right, .String)]
    push_expr(s, .I32, call("vader_string_compare", arguments))
}
