// vader/emit/c/closures: fn values, closures, indirect and virtual calls.
//
// Also the per-module wrappers that give every fn value the one erased ABI.

module "vader/emit/c"

import "std/abort"
import "vader/core/bytecode"
import "vader/emit/c/ast"
// The opcode union pulls in ~120 names ; the namespace form keeps the
// import to one line and tags every op site as `Bc.<Op>` at the match.
Bc :: import "vader/core/bytecode"

// ---- closures + dispatch --------------------------------------------------
//
// A fn value is a raw `void*` to a `vader_fn_t` (`.Ref`). A bare `fn.ref`
// pushes the address of the fn's static trampoline ; `make_closure` heap-allocates a
// `vader_fn_t` carrying the lifted-fn wrapper + captured env ; `call.indirect`
// invokes either through the canonical erased ABI (`vader_fn_erased_sig_N_t`),
// boxing every arg so a concrete-typed closure flows through an erased call
// site. `virtual.call` routes through the per-key dispatcher (`dispatch.vader`)
// switching on the receiver's runtime tag. The wrappers themselves are emitted
// once per module by `emit_fn_trampolines` below.

/// Pop `count` args off the operand stack (top is the last arg), box each to
/// the erased `any` ABI, and return them in source order: pop #k lands in
/// slot `count-1-k`. Shared by the erased-call sites (`call.indirect` args,
/// `virtual.call` tail).
pop_args_boxed :: fn(s: FnState, count: i32) -> CExpression[] {
    args: CExpression[]: [verbatim("")] * i64(count)
    for k in 0..<count {
        v :: pop(s)
        slot :: count - 1 - k
        args[slot] = coerced_as(s, v, .Any)
    }
    return args
}

/// A function's C identity, keyed by its own MANGLED name rather than its index
/// in the module table.
///
/// An index is a rank, and a rank shifts: a function reached by one target only
/// renumbers every trampoline behind it, so modules whose code is identical
/// emit different C per target. The mangled name is the function's identity and
/// does not move.
///
/// @param fns    the module's function table.
/// @param index  the function's index in it.
/// @return       the sanitised mangled name.
fn_symbol_name :: fn(fns: BcFunction[], index: i32) -> string {
    if index < 0 || i64(index) >= fns.len() {
        panic("c_emit: op names function ${index}, which the module table does not hold")
    }
    return sanitise(fns[index].name)
}

/// `fn.ref`: push a raw pointer to the fn's static trampoline value. The
/// trampoline (`vader_fn_static_N`) is emitted by `emit_fn_trampolines`.
emit_fn_ref :: fn(s: FnState, op: Bc.FnRef) -> void {
    push_object(
        s,
        address_of(
            verbatim(
                "vader_fn_static_${fn_symbol_name(s.ctx.module.functions, op.function_index)}",
            ),
        ),
    )
}

/// `fn.addr`: the function's own symbol, not `&vader_fn_static_N`. See
/// `core/bytecode/op::FnAddr` for why the two differ.
emit_fn_addr :: fn(s: FnState, op: Bc.FnAddr) -> void {
    // `.Pointer`, NOT `.Ref`: the difference is a GC root. A `.Ref` temp lands
    // in the frame's `raw[]`, and `vader_gc_scan_raw` reads its pointee's header
    // without checking the pointee is on the heap. A function's address is in
    // `.text`, so `hdr->forward` would be machine code (never NULL) and the
    // collector would overwrite the slot. `fn.ref` gets away with `.Ref` because
    // `vader_fn_static_N` carries a real object header whose `forward` IS NULL.
    temporary :: new_temporary(s, .Pointer)
    assign(
        s,
        temporary,
        cast(
            "void*",
            address_of(verbatim(fn_symbol_name(s.ctx.module.functions, op.function_index))),
        ),
    )
    // From here on C can call back into Vader, so a foreign call is a safepoint
    // and anything lent to one can move under it. This is the ONLY way a Vader
    // address reaches C, which is what makes the flag exact rather than a guess:
    // a program that never reaches this line pays nothing for the lend guard in
    // `vader_array_bytes`. The first escape collects, hence `op_may_collect`.
    evaluate(s, call("vader_ffi_callback_escape", []))
    push_temporary(s, temporary, .Pointer)
}

/// `make_closure`: pop the captured env (a struct, raw or boxed), heap-allocate
/// a `vader_fn_t` with `code` = the lifted-fn wrapper + `env` = the env ptr and
/// the closure's fn-type tag in its header, push the raw pointer.
/// `env_type_id` carries the closure's own BcFn type: the field name says
/// `env_type` but the id is the closure's, a misnomer inherited from the
/// lowered node.
emit_make_closure :: fn(s: FnState, op: Bc.MakeClosure) -> void {
    env :: pop(s)
    fn_obj :: aux(s, "closure")
    declare(s, "vader_fn_t*", fn_obj, gc_allocation("vader_fn_t"))
    init_object_header(s, fn_obj, op.env_type_id)
    assign(
        s,
        verbatim("${fn_obj}->code"),
        cast(
            "void*",
            address_of(
                verbatim(
                    "vader_fn_lift_${fn_symbol_name(s.ctx.module.functions, op.function_index)}",
                ),
            ),
        ),
    )
    assign(s, verbatim("${fn_obj}->env"), object_pointer_of(env))
    push_object(s, verbatim(fn_obj))
}

/// `call.indirect`: invoke a `vader_fn_t` value through the canonical erased
/// signature. Every arg is boxed to `vader_box_t` and the `code` pointer cast
/// to `vader_fn_erased_sig_N_t`, so a concrete-typed closure flows through an
/// erased call site without a calling-convention mismatch ; the wrapper unboxes
/// per the underlying fn's concrete sig. The wrapper returns the erased box:
/// coerce it back to the static return class for direct readers.
emit_call_indirect :: fn(s: FnState, op: Bc.CallIndirect) -> void {
    types :: s.ctx.module.types
    t :: types[op.type_id]
    if t is BcFn {
        // `fn_val` is on top: pop it before the args.
        fn_val :: pop(s)
        n :: i32(t.params.len())
        args :: pop_args_boxed(s, n)
        fn_obj :: aux(s, "fnobj")
        declare(s, "vader_fn_t*", fn_obj, cast("vader_fn_t*", object_pointer_of(fn_val)))
        call_args: CExpression[]: [verbatim("${fn_obj}->env")]
        call_args.push_all(args)
        erased :: call("((vader_fn_erased_sig_${n}_t) ${fn_obj}->code)", call_args)
        ret_val :: val_type_of_bc_type(types[t.return_type])
        if ret_val == .Void {
            evaluate(s, erased)
            return
        }
        boxed :: new_temporary(s, .Any)
        assign(s, boxed, erased)
        // The erased ABI returns a `vader_box_t`. `.Any` keeps it boxed ; a `.Ref`
        // (concrete) return unboxes to a raw `void*`, a primitive to its scalar.
        if ret_val == .Any {
            push_temporary(s, boxed, .Any)
            return
        }
        push_into_temporary(s, coerce_expr(types, boxed, .Any, ret_val), ret_val)
    } else {
        todo("call.indirect on non-fn type ${op.type_id}")
    }
}

/// `virtual.call`: trait-method dispatch. Pop the receiver (top of stack),
/// then the tail args below it (source order), box everything to the erased
/// ABI, and call the per-key dispatcher (`vader_vt_<key>`, emitted in
/// `dispatch.vader`) which switches on `recv.tag`. The op carries its result
/// classes but no result-type index, so there is no erasure-boundary repack
/// here: a following `ref.cast` / `convert` handles any per-tag reshape.
emit_virtual_call :: fn(s: FnState, op: Bc.VirtualCall) -> void {
    row :: find_vtable_row(s.ctx, op.vtable_key)
    if row == null {
        // Nothing implements the trait, so no receiver ever reaches this call. It
        // still takes its operands and leaves what it declares, or the paths
        // through it would not agree on the stack.
        for _ in 0..<op.parameter_count {
            drop_top(s)
        }
        unreachable(s, "no vtable for ${op.vtable_key}")
        if bc_results_arity(op.results) == 1 {
            push_temporary(s, new_temporary(s, op.results[0]), op.results[0])
        }
        return
    }
    // Receiver is on top, popped first ; the tail args sit below in source
    // order (`pop_args_boxed` restores it).
    recv :: pop(s)
    all_args: CExpression[]: [coerced_as(s, recv, .Any)]
    all_args.push_all(pop_args_boxed(s, op.parameter_count - 1))
    sig :: vtable_sig_for_row(s.ctx, row)
    dispatch :: call(vtable_helper_name(op.vtable_key), all_args)
    if bc_single_result(sig) == .Void {
        evaluate(s, dispatch)
        return
    }
    push_into_temporary(s, dispatch, bc_single_result(sig))
}

// ---- fn-value wrappers (whole-module scan) --------------------------------

/// Per-fn `fn.ref` trampoline + `make_closure` lift wrappers. Walks every fn
/// body to discover which fns are taken by reference (need a static
/// `vader_fn_t` + a wrapper dropping env) and which are lifted into closures
/// (need a wrapper boxing env). Both expose the canonical erased ABI
/// (`vader_box_t` per arg + return) so one `code` pointer is castable at any
/// `call.indirect` site. Gated on the ops actually appearing: a fn-typed
/// field can exist with no fn-value op.
emit_fn_trampolines :: fn(ctx: EmitCtx, printer: CPrinter) -> void {
    usage :: scan_fn_value_usage(ctx.module.functions)
    if !usage.any {
        return
    }
    n :: ctx.module.functions.len()
    wrappers: CTopLevel[]: []
    for i in 0..<n {
        if usage.fn_ref_type[i] >= 0 {
            emit_fn_ref_tramp(ctx, wrappers, i32(i), usage.fn_ref_type[i])
        }
    }
    for i in 0..<n {
        if usage.is_closure[i] {
            emit_closure_lift(ctx, wrappers, i32(i))
        }
    }
    printer.print_section(CSection { .items = wrappers })
}

/// Which fns are taken as fn-values: the shared scan behind both the
/// trampoline definitions (`emit_fn_trampolines`) and their split-build
/// forward decls (`emit_closure_forward_decls`).
FnValueUsage :: struct {
    /// `BcFn` type tag per `fn.ref` target index, `-1` when never ref'd.
    fn_ref_type: i32[]
    /// true at index `i` when a `make_closure` lifts fn `i`.
    is_closure: bool[]
    /// true when the module has ANY fn-value op (else no wrappers exist).
    any: bool
}

/// Walk every fn body once, recording which fns are taken by `fn.ref`
/// (need a static `vader_fn_t` + trampoline) and which are lifted by
/// `make_closure` (need a lift wrapper). Indices are parallel to `fns`.
scan_fn_value_usage :: fn(fns: BcFunction[]) -> FnValueUsage {
    n :: fns.len()
    fn_ref_type: i32[]: [-1] * n
    is_closure: bool[]: [false] * n
    any := false
    for f in fns {
        for op in f.body {
            if op is Bc.FnRef {
                fn_ref_type[op.function_index] = op.type_id
                any = true
            } else if op is Bc.MakeClosure {
                is_closure[op.function_index] = true
                any = true
            }
        }
    }
    return FnValueUsage { .fn_ref_type = fn_ref_type, .is_closure = is_closure, .any = any }
}

/// Forward decls for the address-taken fn-value closures: split builds only.
///
/// The trampolines (`vader_fn_tramp_N` / `vader_fn_lift_N`) and their static
/// value (`vader_fn_static_N`) are synthesised OUTSIDE `module.functions`, so
/// `emit_forward_decls` never covers them. In a monolithic build the
/// definitions precede every use within the one TU, so no decl is needed ; a
/// split build scatters callers and definitions across TUs → each needs a
/// prototype (fns) / `extern` (the static value) in the shared header. The
/// heads mirror `emit_fn_ref_tramp` / `emit_closure_lift` exactly.
emit_closure_forward_decls :: fn(ctx: EmitCtx, printer: CPrinter) -> void {
    if !ctx.split {
        return
    }
    usage :: scan_fn_value_usage(ctx.module.functions)
    if !usage.any {
        return
    }
    fns :: ctx.module.functions
    declarations: CTopLevel[]: []
    for i in 0..<fns.len() {
        if usage.fn_ref_type[i] >= 0 {
            name :: fn_symbol_name(fns, i32(i))
            trampoline :: trampoline_signature(ctx, name, fns[i].signature)
            declarations.push(CPrototype { .signature = trampoline })
            declarations.push(external("vader_fn_t", "vader_fn_static_${name}", null, false))
        }
    }
    for i in 0..<fns.len() {
        // Mirror `emit_closure_lift`'s guard : a 0-param fn emits no lift.
        if usage.is_closure[i] && fns[i].signature.params.len() > 0 {
            name :: fn_symbol_name(fns, i32(i))
            lift :: lift_signature(ctx, name, fns[i].signature)
            declarations.push(CPrototype { .signature = lift })
        }
    }
    printer.print_section(CSection { .items = declarations })
}

/// Emit the `fn.ref` trampoline (drops env, unboxes args to the fn's concrete
/// sig, boxes the result) + the static `vader_fn_t` value pointing at it.
emit_fn_ref_tramp :: fn(ctx: EmitCtx, items: CTopLevel[], fn_index: i32, type_id: i32) -> void {
    fn_decl :: ctx.module.functions[fn_index]
    cname :: sanitise(fn_decl.name)
    sig :: fn_decl.signature
    body :: CBlock {
        .body = [CExpressionStatement { .expression = cast("void", verbatim("env")) }],
    }
    body.body.push_all(forward_boxed(cname, tramp_unbox_args(sig.params), sig))
    items.push(CFunction { .signature = trampoline_signature(ctx, cname, sig), .body = body })
    value :: initializer_list([
        object_header(unsigned(i64(type_id))),
        cast("void*", address_of(verbatim("vader_fn_tramp_${cname}"))),
        NULL_POINTER,
    ])
    items.push(CGlobal {
        .storage = global_storage(ctx.split),
        .type = "vader_fn_t",
        .declarator = CDeclarator { .name = "vader_fn_static_${cname}", .value = value },
    })
}

/// Emit the `make_closure` lift wrapper : takes `void* env` + the tail args
/// boxed, passes env to the lifted fn's first param (boxed only when that
/// param is erased), unboxes the tail to the concrete sig, boxes the result.
emit_closure_lift :: fn(ctx: EmitCtx, items: CTopLevel[], fn_index: i32) -> void {
    fn_decl :: ctx.module.functions[fn_index]
    cname :: sanitise(fn_decl.name)
    sig :: fn_decl.signature
    if sig.params.len() == 0 {
        return
    }
    // The lifted fn's env param (param 0) is a concrete captured-env struct → a
    // raw `void*` (`.Ref`) ; pass `env` directly. When it's `.Any`
    // (erased), coerce widens it to a box via `vader_ref_box`.
    arguments: CExpression[]: [coerce_expr(ctx.module.types, verbatim("env"), .Ref, sig.params[0])]
    arguments.push_all(lift_unbox_tail(sig.params))
    body :: CBlock { .body = [] }
    body.body.push_all(forward_boxed(cname, arguments, sig))
    items.push(CFunction { .signature = lift_signature(ctx, cname, sig), .body = body })
}

/// Head of an erased-ABI wrapper: a `fn.ref` trampoline or a `make_closure`
/// lift : `env`, then `count` boxes. Shared by the definition and its
/// split-build prototype, which must match.
///
/// @param ctx    the emit context, for the storage.
/// @param name   the wrapper's C name.
/// @param count  the boxed slots after `env`.
erased_wrapper_signature :: fn(ctx: EmitCtx, name: string, count: i64) -> CSignature =
    CSignature {
        .storage = wrapper_storage(ctx.split),
        .result = "vader_box_t",
        .name = name,
        .parameters = erased_parameters(count),
    }

// The `fn.ref` trampoline of the function called `name` takes every parameter
// boxed ; its lift wrapper takes them after the captured environment.
trampoline_signature :: fn(ctx: EmitCtx, name: string, signature: BcSignature) -> CSignature =
    erased_wrapper_signature(ctx, "vader_fn_tramp_${name}", signature.params.len())

lift_signature :: fn(ctx: EmitCtx, name: string, signature: BcSignature) -> CSignature =
    erased_wrapper_signature(ctx, "vader_fn_lift_${name}", signature.params.len() - 1)

/// Unbox `a0..a<n-1>` to the concrete `params` classes: the `fn.ref`
/// trampoline's argument list (params map 1:1 to `a<j>`).
tramp_unbox_args :: fn(params: ValType[]) -> CExpression[] {
    arguments: CExpression[]: []
    for j in 0..<params.len() {
        arguments.push(unbox_expr(verbatim("a${j}"), params[j]))
    }
    return arguments
}

/// Unbox the lift wrapper's tail `a0..` to `params[1..]` (param 0 is the env
/// slot).
lift_unbox_tail :: fn(params: ValType[]) -> CExpression[] {
    arguments: CExpression[]: []
    for j in 1..<params.len() {
        arguments.push(unbox_expr(verbatim("a${j - 1}"), params[j]))
    }
    return arguments
}

/// Call `cname(arguments…)` and return its result boxed for the erased ABI :
/// `vader_box_null()` for a void call, the result as is when already a box
/// (`any`), widened from a raw `ref`, boxed otherwise.
forward_boxed :: fn(cname: string, arguments: CExpression[], sig: BcSignature) -> CStatement[] {
    forward :: call(cname, arguments)
    result :: bc_single_result(sig)
    if result == .Void {
        return [
            CExpressionStatement { .expression = forward },
            CReturn { .value = call("vader_box_null", []) },
        ]
    }
    boxed :: if result == .Any {
        forward
    } else if result == .Ref {
        ref_box(forward)
    } else {
        box_expr(forward, result, bc_single_result_type(sig))
    }
    return [CReturn { .value = boxed }]
}
