// vader/emit/bytecode/retype: rebase a module's type table onto a shared one.
//
// `BytecodeModule.types` is index-addressed, so two targets that compile the
// same program can hold the same type at different slots, and one extra type
// on one target shifts every slot after it. Emitting several targets against
// one C output then differs everywhere by renumbering alone.
//
// This is the type-table half of what `EmitOptions.atom_universe` does for
// string literals. Same shape: a canonical key (`bc_type_key`), a shared order,
// and every reference rewritten to it.

module "vader/emit/bytecode"

import "std/abort"
import "std/collections"
import "std/iter"
import "std/sort"
import "std/string"
import "vader/core/bytecode"

/// Every type's canonical key, indexed like the table itself.
///
/// Computed once per module and handed to both `union_of_type_tables` and
/// `rebase_types`: `bc_type_key` recurses into array elements, union variants
/// and fn signatures, so recomputing it per pass re-derives the whole composite
/// graph each time, once more for every target emitted.
///
/// @param m  the module whose table to key.
/// @return   one key per type index.
export type_keys_of :: fn(m: BytecodeModule) -> string[] {
    keys: string[]: []
    for i in 0..<m.types.len() {
        keys.push(bc_type_key(m.types, i32(i)))
    }
    return keys
}

/// The union of several modules' type tables, as an ordered key list.
///
/// SORTED after the first entry, so the order is a property of the set and not
/// of the order the modules were given.
///
/// SLOT 0 IS PINNED. The runtime requires `type_info_table[0]` to be a scan
/// no-op: stack-object rooting relies on it, and it traps at startup otherwise.
/// A plain sort moves it, which is how this was found.
///
/// @param per_module  each module's key list, from `type_keys_of`, at least one.
/// @return            the reserved slot-0 key, then every other distinct key,
///                    sorted.
export union_of_type_tables :: fn(per_module: string[][]) -> string[] {
    reserved :: per_module[0][0]
    seen: Set<string>: Set<string> {}
    seen.add(reserved)
    keys: string[]: []
    for module_keys in per_module {
        for k in module_keys {
            if seen.add(k) {
                keys.push(k)
            }
        }
    }
    out: string[]: [reserved]
    for k in sort(keys, (a: string, b: string) -> compare_ascending(a, b)) {
        out.push(k)
    }
    return out
}

/// The type table of the universe: each key's type, taken from the first module
/// that holds it, its indices renumbered to the universe.
///
/// A rebased module takes from it the types it does not use, so that its table,
/// and the C that describes it, is the same for every target.
///
/// @param modules   the modules the universe was made from.
/// @param remaps    each module's `remap_onto`.
/// @param universe  the shared key order, from `union_of_type_tables`.
/// @return          one type per universe slot.
export universe_type_table :: fn(
    modules: BytecodeModule[], remaps: i32[][], universe: string[],
) -> BcType[] {
    by_slot :: Map<i32, BcType> {}
    for k in 0..<modules.len() {
        remap :: remaps[k]
        types :: modules[k].types
        for i in 0..<types.len() {
            s :: remap[i]
            if s >= 0 && !by_slot.contains(s) {
                by_slot[s] = remap_type(types[i], remap)
            }
        }
    }
    return universe.len().filled_indexed(
        (i) -> by_slot[i32(i)] else panic("retype: no module holds the type `${universe[i]}`"),
    )
}

/// Each type index of a module, renumbered to its slot in `universe`.
///
/// @param keys      the module's key per type index, from `type_keys_of`.
/// @param universe  the shared key order, from `union_of_type_tables`.
/// @return          the new index of each old one. -1 stays -1: it is the "no
///                  type" marker, not a slot, and remapping it would point at
///                  the universe's first entry.
export remap_onto :: fn(keys: string[], universe: string[]) -> i32[] {
    slot_of :: Map<string, i32> {}
    for i in 0..<universe.len() {
        slot_of[universe[i]] = i32(i)
    }
    return keys.map((k) -> slot_of[k] else -1).collect()
}

/// Rebase `m` so its type table is the universe's, in that order.
///
/// Every index-bearing site is rewritten: the table's own cross-references, both
/// signatures, the ops, the impl table, the vtables, the globals and the data
/// pool. A slot keeps the module's own type where it has one: two targets may
/// give one struct two symbol ids, which the key ignores and the data pool reads.
///
/// @param m      the module to rebase.
/// @param remap  `m`'s `remap_onto`.
/// @param table  the universe's types, from `universe_type_table`.
/// @return       the rebased module.
export rebase_types :: fn(m: BytecodeModule, remap: i32[], table: BcType[]) -> BytecodeModule {
    types :: table.clone()
    for i in 0..<m.types.len() {
        s :: remap[i]
        if s >= 0 {
            types[s] = remap_type(m.types[i], remap)
        }
    }

    fns: BcFunction[]: []
    for f in m.functions {
        body: Op[]: []
        for op in f.body {
            body.push(remap_type_in_op(op, remap))
        }
        fns.push(
            BcFunction {
                ...f,
                .signature = remap_signature(f.signature, remap),
                .body = body,
            },
        )
    }
    imports: BcImport[]: []
    for imp in m.imports {
        imports.push(remap_import(imp, remap))
    }
    impls: ImplEntry[]: []
    for e in m.impl_table {
        impls.push(
            ImplEntry {
                .type_index = remap_idx(remap, e.type_index),
                .trait_name = e.trait_name,
            },
        )
    }
    vts: VtableRow[]: []
    for row in m.vtables {
        entries: VtableEntry[]: []
        for e in row.entries {
            entries.push(
                VtableEntry {
                    .receiver_type_index = remap_idx(remap, e.receiver_type_index),
                    .fn_index = e.fn_index,
                },
            )
        }
        vts.push(VtableRow { .key = row.key, .entries = entries })
    }
    return BytecodeModule {
        ...m,
        .types = types,
        .functions = fns,
        .imports = imports,
        .impl_table = impls,
        .vtables = vts,
        .globals = remap_globals(m.globals, remap),
        .data_pool = remap_data_pool(m.data_pool, remap),
    }
}

// `imp`, every type index it holds renumbered by `remap`.
remap_import :: fn(imp: BcImport, remap: i32[]) -> BcImport = BcImport {
    ...imp,
    .signature = remap_signature(imp.signature, remap),
    .wit_types = remap_type_indices(remap, imp.wit_types),
}

remap_signature :: fn(sig: BcSignature, remap: i32[]) -> BcSignature = BcSignature {
    ...sig,
    .param_types = remap_type_indices(remap, sig.param_types),
    .result_types = remap_type_indices(remap, sig.result_types),
}

// Exhaustive on purpose, with no `_` arm: `BcType` is a closed union, so a new
// variant that carries a type index has to trip T3013 here rather than fall
// through unrewritten and point at a slot from the pre-union numbering.
remap_type :: fn(t: BcType, remap: i32[]) -> BcType = match t {
    // No type index to rewrite : a scalar names its class, a nominal tag its
    // declaration, and an opaque ref only a trait name.
    is BcScalar | BcNominal | BcRef -> t
    is BcStruct -> {
        fields: BcField[]: []
        for f in t.fields {
            fields.push(BcField {
                .name = f.name, .type_index = remap_idx(remap, f.type_index),
            })
        }
        BcStruct { ...t, .fields = fields }
    }
    is BcArray -> BcArray { .element = remap_idx(remap, t.element) }
    is BcUnion -> {
        vs: i32[]: []
        for v in t.variants {
            vs.push(remap_idx(remap, v))
        }
        BcUnion { .variants = vs }
    }
    is BcFn -> {
        ps: i32[]: []
        for p in t.params {
            ps.push(remap_idx(remap, p))
        }
        BcFn { .params = ps, .return_type = remap_idx(remap, t.return_type) }
    }
}
