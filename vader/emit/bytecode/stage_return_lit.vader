// vader/emit/bytecode/stage_return_lit: the `return_lit` rewrite of a function.

module "vader/emit/bytecode"

import "vader/core/bytecode"

// `<Const> ; Return` -> `ReturnLit` again, on the windows `dead_stores` opens: the
// rest of `peephole` would fold the pairs its compaction made adjacent.
ReturnLitStage :: struct {}

ReturnLitStage implements BytecodeStage {
    describe :: fn(self) = BytecodeSpec { .name = "return_lit", .after = [DeadStoresStage {}] }

    run :: fn(self, function: BcFunction) -> BcFunction {
        // `ReturnLit` carries ONE literal, so it can only stand in for a return that
        // hands back one value. A scalarised return leaves several on the stack and
        // the fold would keep the last and drop the rest.
        if bc_result_arity(function.signature) > 1 {
            return function
        }
        body :: function.body
        n :: body.len()
        out: Op[]: []
        out_len: i64 = 0
        old_to_new: i32[]: [-1] * n
        i: i64 = 0
        for i < n {
            op :: body[i]
            if op is Return {
                cur_len :: out.len()
                if cur_len > 0 {
                    prev :: out[cur_len - 1]
                    cv :: const_op_of(prev)
                    if cv !is null {
                        out[cur_len - 1] = ReturnLit { .value = cv }
                        old_to_new[i] = i32(cur_len - 1)
                        i += 1
                        continue
                    }
                }
            }
            push_or_assign(out, out_len, op)
            old_to_new[i] = i32(out_len)
            out_len += 1
            i += 1
        }
        new_body :: out[0..<out_len]
        new_jt :: remap_jump_table(function.jump_table, old_to_new, out_len)
        new_debug :: remap_debug(function.debug, old_to_new, out_len)
        return BcFunction {
            ...function,
            .body = new_body,
            .jump_table = new_jt,
            .debug = new_debug,
        }
    }

    run :: fn(self, function: BcFunction) -> BcFunction {
        // `ReturnLit` carries ONE literal, so it can only stand in for a return that
        // hands back one value. A scalarised return leaves several on the stack and
        // the fold would keep the last and drop the rest.
        if bc_result_arity(function.signature) > 1 {
            return function
        }
        body :: function.body
        n :: body.len()
        out: Op[]: []
        out_len: i64 = 0
        old_to_new: i32[]: [-1] * n
        i: i64 = 0
        for i < n {
            op :: body[i]
            if op is Return {
                cur_len :: out.len()
                if cur_len > 0 {
                    prev :: out[cur_len - 1]
                    cv :: const_op_of(prev)
                    if cv !is null {
                        out[cur_len - 1] = ReturnLit { .value = cv }
                        old_to_new[i] = i32(cur_len - 1)
                        i += 1
                        continue
                    }
                }
            }
            push_or_assign(out, out_len, op)
            old_to_new[i] = i32(out_len)
            out_len += 1
            i += 1
        }
        new_body :: out[0..<out_len]
        new_jt :: remap_jump_table(function.jump_table, old_to_new, out_len)
        new_debug :: remap_debug(function.debug, old_to_new, out_len)
        return BcFunction {
            ...function,
            .body = new_body,
            .jump_table = new_jt,
            .debug = new_debug,
        }
    }
}
