// vader/emit/bytecode/scheduler — stack-pass-through hints.
//
// Recognises CFG patterns where an
// instruction's result is consumed immediately by its single successor's
// first operand, and hints the bytecode emitter to leave the value on
// the operand stack instead of round-tripping through a named local.
// Closes most of the 3-address overhead the converter introduces vs
// the legacy stack-based emit path.
//
// Conditions for elision (per block, intra-block only) :
//   - `cur.dst` is single-use in the whole function (use-count = 1).
//   - `cur` is the immediately-preceding instruction of `next`.
//   - `cur.dst` matches `next`'s first stack-pushed operand.
//
// Same shape for last-instruction → terminator with Return.value /
// CondBranch.cond.
//
// Instructions are keyed by position (`pos_key`, `vader/midir/cfg.vader`).

module "vader/emit/bytecode"

import "std/collections"
import "vader/midir"

/// Stack-pass-through hints for one fn.
ScheduleHints :: struct {
    /// Instructions whose result should be left on the stack
    /// (no `local.set`). Keys = `pos_key(block, instr_idx)`.
    skip_set: MutableSet<i64> = MutableSet<i64> {}
    /// Instructions whose first stack-pushed operand should be read
    /// from the stack (no `local.get`). Same key scheme as skip_set.
    skip_first_get: MutableSet<i64> = MutableSet<i64> {}
    /// Block IDs whose terminator's first read should come from the
    /// stack.
    skip_terminator_get: MutableSet<BlockId> = MutableSet<BlockId> {}
}

schedule_stack :: fn(fn_: CFGFunction) -> ScheduleHints {
    use_count :: count_uses(fn_)
    hints :: ScheduleHints {}
    for b in fn_.blocks {
        for i in 0..<b.instructions.len() {
            if i + 1 >= b.instructions.len() { break }
            cur :: b.instructions[i]
            next :: b.instructions[i + 1]
            if !can_pass_through_stack(cur, next, use_count) { continue }
            hints.skip_set.add(pos_key(b.id, i))
            hints.skip_first_get.add(pos_key(b.id, i + 1))
        }
        // Last instruction → terminator. Same single-use condition,
        // but the consumer is whatever the terminator reads first.
        if b.instructions.len() == 0 { continue }
        last_idx :: b.instructions.len() - 1
        last :: b.instructions[last_idx]
        if !can_pass_through_terminator(last, b.terminator, use_count) { continue }
        hints.skip_set.add(pos_key(b.id, last_idx))
        hints.skip_terminator_get.add(b.id)
    }
    return hints
}

can_pass_through_stack :: fn(
    cur: Instruction, next: Instruction,
    use_count: MutableMap<LocalId, i32>,
) -> bool {
    dst :: dst_of(cur) ?? return false
    count :: use_count[dst] ?? return false
    if count != 1 { return false }
    first_op :: first_stack_operand(next) ?? return false
    return first_op == dst
}

can_pass_through_terminator :: fn(
    cur: Instruction, t: Terminator,
    use_count: MutableMap<LocalId, i32>,
) -> bool {
    dst :: dst_of(cur) ?? return false
    count :: use_count[dst] ?? return false
    if count != 1 { return false }
    first_op :: first_terminator_operand(t) ?? return false
    return first_op == dst
}

/// First operand pushed onto the stack by the instruction's emit
/// sequence. Mirrors the per-instr emit order in `emit.vader`.
/// Returns null for instructions that take no operands.
first_stack_operand :: fn(ins: Instruction) -> LocalId | null {
    match ins {
        is InstrConst     -> { return null }
        is InstrFnRef     -> { return null }
        is InstrFnAddr    -> { return null }
        is InstrDataConst -> { return null }
        is InstrGlobalGet -> { return null }
        is InstrTypeConst -> { return null }
        is InstrMove      -> { return ins.src }
        is InstrBinOp     -> { return ins.lhs }
        is InstrUnOp      -> { return ins.operand }
        is InstrCall      -> { if ins.args.len() > 0 { return ins.args[0] }
            return null }
        is InstrCallIndirect -> { if ins.args.len() > 0 { return ins.args[0] }
            return ins.callee }
        is InstrVirtualCall -> { if ins.args.len() > 0 { return ins.args[0] }
            return ins.receiver }
        is InstrFieldGet      -> { return ins.target }
        is InstrFieldSet      -> { return ins.target }
        is InstrUnionFieldGet -> { return ins.target }
        is InstrUnionFieldSet -> { return ins.target }
        is InstrArrayGet      -> { return ins.target }
        is InstrArraySet      -> { return ins.target }
        is InstrArrayLen      -> { return ins.target }
        is InstrArrayPush     -> { return ins.target }
        is InstrArraySlice    -> { return ins.target }
        is InstrStructNew   -> { if ins.fields.len() > 0 { return ins.fields[0] }
            return null }
        is InstrArrayNew -> { if ins.elements.len() > 0 { return ins.elements[0] }
            return null }
        is InstrTypeCheck   -> { return ins.value }
        is InstrCast        -> { return ins.value }
        is InstrCellNew     -> { return ins.value }
        is InstrCellGet     -> { return ins.cell }
        is InstrCellSet     -> { return ins.cell }
        is InstrGlobalSet   -> { return ins.value }
        is InstrMakeClosure -> { return ins.env }
        is InstrIntrinsic   -> { if ins.args.len() > 0 { return ins.args[0] }
            return null }
        is InstrDeferPush    -> { return ins.value }
        is InstrDeferPopExec -> { return null }
    }
}

first_terminator_operand :: fn(t: Terminator) -> LocalId | null {
    match t {
        is TermBranch      -> { return null }
        is TermUnreachable -> { return null }
        is TermCondBranch  -> { return t.cond }
        // Only a single-value return can hand its operand to the scheduler:
        // with several, the first is pushed BEFORE the rest, so letting it stay
        // on the stack would put the others on top of it.
        is TermReturn      -> { return term_return_single(t) }
    }
}
