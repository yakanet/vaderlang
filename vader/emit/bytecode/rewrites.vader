// vader/emit/bytecode/rewrites: what the rewrites of an emitted function share.
//
// Every rewrite that drops or folds ops remaps `jump_table` and `debug` in
// lock-step with `body` (`remap_jump_table` / `remap_debug`): a branch target or a
// `#line` that lags the rewrite is a silent mis-compile, not a cosmetic slip. The
// rewrites themselves are the stages, one file each (`stage_*.vader`).

module "vader/emit/bytecode"

import "vader/core/bytecode"

/// Remap a debug table from old PC space to new PC space, parallel to
/// `remap_jump_table` but simpler : each surviving op copies its own
/// source position. `old_to_new[old_pc]` is the new PC (or `< 0` when
/// the op was dropped / folded away). When several old PCs fold onto one
/// new PC, the first NON-NULL source among them wins: the folded op
/// keeps its head's real position rather than a synthetic `null`. New
/// slots with no surviving source stay `null`.
///
/// @param old_debug   the pre-rewrite debug table (parallel to old body).
/// @param old_to_new  per-old-PC new PC, `< 0` for removed ops.
/// @param new_len     length of the rewritten body.
/// @return            a fresh debug table of length `new_len`.
remap_debug :: fn(
    old_debug: (DebugPos | null)[],
    old_to_new: i32[],
    new_len: i64,
) -> (DebugPos | null)[] {
    // `old_debug` and `old_to_new` are always parallel to the old body (both
    // grown one entry per op), so a plain walk over `old_debug` is safe.
    new_debug: (DebugPos | null)[]: [null] * new_len
    for i in 0..<old_debug.len() {
        np :: old_to_new[i]
        if np < 0 { continue }
        dst :: i64(np)
        // First non-null wins : only fill while the slot is still empty, so a
        // real position isn't clobbered by a later fold onto the same new pc.
        if dst < new_len && new_debug[dst] == null {
            new_debug[dst] = old_debug[i]
        }
    }
    return new_debug
}

/// Append `value` when the cursor is at the end ; overwrite in place
/// otherwise: the write primitive every peephole in this file goes through.
push_or_assign :: fn(items: Op[], sp: i64, value: Op) -> void {
    if sp == items.len() {
        items.push(value)
    } else {
        items[sp] = value
    }
}

/// Rewrite `ArrayPush.cache_slot` through a slot renumbering, leaving every
/// other op alone. The hint is a SLOT NUMBER, so every pass that renumbers slots
/// has to carry it: `dead_stores` and `coalesce` are the two. A pass
/// that forgets leaves a stale number behind; the emitter checks the hint
/// against the array it actually pops and declines to lift on a mismatch, so the
/// cost of forgetting is a missed optimisation, not a miscompile.
remap_push_cache_slot :: fn(op: Op, remap: i32[]) -> Op {
    if !(op is ArrayPush) {
        return op
    }
    if op.cache_slot < 0 || i64(op.cache_slot) >= remap.len() {
        return op
    }
    return ArrayPush { .type_id = op.type_id, .cache_slot = remap[op.cache_slot] }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_convert_target_of_i32_maps_to_i32 :: fn() -> void {
    target :: convert_target_of(.I32) else {
        assert_eq("expected non-null target", "")
        return
    }
    if target != .I32 {
        assert_eq("expected I32", "")
    }
}

@test test_convert_target_of_i64_widths_collapse_to_i64 :: fn() -> void {
    target :: convert_target_of(.U64) else {
        assert_eq("expected non-null target", "")
        return
    }
    if target != .I64 {
        assert_eq("expected I64", "")
    }
}

@test test_convert_target_of_bool_returns_null :: fn() -> void {
    target :: convert_target_of(.Bool)
    assert_eq(target is null, true)
}

@test test_remap_debug_identity_preserves_positions :: fn() -> void {
    old_debug: (DebugPos | null)[]: []
    old_debug.push(DebugPos { .file = "f", .line = 1, .column = 1 })
    old_debug.push(DebugPos { .file = "f", .line = 2, .column = 1 })
    old_to_new: i32[]: []
    old_to_new.push(0)
    old_to_new.push(1)
    out :: remap_debug(old_debug, old_to_new, 2)
    assert_eq(out.len(), 2)
    [d0, d1] :: out
    if d0 is DebugPos { assert_eq(d0.line, 1) } else { assert_eq("out[0] unexpectedly null", "") }
    if d1 is DebugPos { assert_eq(d1.line, 2) } else { assert_eq("out[1] unexpectedly null", "") }
}

@test test_remap_debug_fold_keeps_first_nonnull :: fn() -> void {
    // Two old ops fold onto the same new pc ; the head's real position wins.
    old_debug: (DebugPos | null)[]: []
    old_debug.push(DebugPos { .file = "f", .line = 10, .column = 1 })
    old_debug.push(DebugPos { .file = "f", .line = 20, .column = 1 })
    old_to_new: i32[]: []
    old_to_new.push(0)
    old_to_new.push(0)
    out :: remap_debug(old_debug, old_to_new, 1)
    assert_eq(out.len(), 1)
    d :: out[0]
    if d is DebugPos { assert_eq(d.line, 10) } else { assert_eq("out[0] unexpectedly null", "") }
}

@test test_remap_debug_null_head_yields_to_real :: fn() -> void {
    // A synthetic (null) head must not shadow a later real position on the
    // same folded slot: first NON-NULL wins.
    synthetic: DebugPos | null: null
    old_debug: (DebugPos | null)[]: []
    old_debug.push(synthetic)
    old_debug.push(DebugPos { .file = "f", .line = 42, .column = 1 })
    old_to_new: i32[]: []
    old_to_new.push(0)
    old_to_new.push(0)
    out :: remap_debug(old_debug, old_to_new, 1)
    assert_eq(out.len(), 1)
    d :: out[0]
    if d is DebugPos { assert_eq(d.line, 42) } else { assert_eq("out[0] unexpectedly null", "") }
}

@test test_remap_debug_drops_removed_ops :: fn() -> void {
    old_debug: (DebugPos | null)[]: []
    old_debug.push(DebugPos { .file = "f", .line = 5, .column = 1 })
    old_debug.push(DebugPos { .file = "f", .line = 6, .column = 1 })
    old_to_new: i32[]: []
    old_to_new.push(-1)   // dropped
    old_to_new.push(0)
    out :: remap_debug(old_debug, old_to_new, 1)
    assert_eq(out.len(), 1)
    d :: out[0]
    if d is DebugPos { assert_eq(d.line, 6) } else { assert_eq("out[0] unexpectedly null", "") }
}
