// vader/emit/bytecode/emit_ctx — per-project emit context + interning.
//
// Owns `EmitOptions` + `EmitterCtx` (the project-wide type / string / fn /
// import tables) and the two interners (`intern_type`, `intern_string`) every
// per-shape emit fn calls.

module "vader/emit/bytecode"

import "std/abort"
import "std/collections"
import "vader/core/bytecode"
import "vader/core/types"
import "vader/midir/select"

/// Knobs threaded through the emit. `optimize` gates the peephole / DCE
/// passes ; `want_debug` gates whether each op carries its source position.
export EmitOptions :: struct {
    optimize: bool
    /// Extra fn mangles to KEEP as roots through the dead-function prune (on
    /// top of main / `@export` / vtable targets). `vader test` passes the
    /// `@test` fn mangles here so they survive to the bytecode and can be run
    /// by name ; empty for normal builds.
    keep_mangles: string[]
    /// Populate the per-op `debug: (DebugPos | null)[]` table with source
    /// positions. The C emitter writes a `#line` wherever one is set, so this
    /// is `!release` on the C-build path, `--line-directives` on
    /// `dump --stage=c`, and `false` everywhere else — the VM never reads
    /// `debug`, so populating it on the run / comptime / self-compile-release
    /// path would allocate one `DebugPos` box per op for nothing.
    want_debug: bool
}

/// Default options : peephole ON, no extra roots, debug table OFF (the VM /
/// comptime / bytecode-dump callers never read it). A debug C build opts in
/// (`want_debug = !release`), and so does `dump --stage=c --line-directives`.
/// @return  a fresh `EmitOptions` with `optimize = true`, `want_debug = false`.
export default_emit_options :: fn() -> EmitOptions = EmitOptions { .optimize = true, .keep_mangles = [], .want_debug = false }

/// Per-project emit context. Built once at the top of
/// `emit/bytecode/emit.vader::emit_bytecode_from_cfg`, threaded through every
/// reservation + body-emit call it makes. Carries the
/// type / string / fn / import interning tables plus the inverse
/// lookups (symbol id → fn / import index) downstream phases query.
///
/// Distinct from `EmitOptions` so the constructor stays cheap and the
/// helpers don't need an `opts` parameter when they only touch the
/// shared state.
export EmitterCtx :: struct {
    /// The module's global slots (`BytecodeModule.globals`), their types interned
    /// before the bodies are emitted.
    globals: BcGlobal[] = []
    /// Type table being built. Index 0 is reserved for the `null`
    /// primitive so unboxed nulls have a well-defined tag at runtime
    /// (matches `VADER_BOX_TAG_NULL = 0` in `runtime/c/vader.h`).
    types: BcType[]
    /// `type_intern_key(t)` → index into `types`. Pre-loaded with
    /// `"null"` at index 0 by `new_emitter_ctx`.
    type_key: MutableMap<string, i32>
    /// `type_intern_hash(t)` → the same index, reached without building the key
    /// string — which is the point: the key is rebuilt half a million times per
    /// self-build to index ~1 600 slots, and every level of its recursion
    /// allocates and interns. A hit is VERIFIED against `type_hash_src` by
    /// `same_intern_class`, so a 64-bit collision falls back to the string path
    /// instead of silently merging two slots.
    type_hash: MutableMap<u64, i32>
    /// The type each SLOT was minted for — the verifier's subject. An array
    /// indexed by slot, not a second map: the verify already knows the index, so
    /// probing a second hash table for it doubles the lookup it is guarding.
    type_by_slot: Type[]

    /// String literal pool. Deduplicated by content via `string_key`.
    strings: string[]
    /// `string content` → index into `strings`.
    string_key: MutableMap<string, i32>

    /// Function table. Each entry mirrors a top-level `LoweredFnDecl`
    /// (regular fns) ; `is_extern`-flagged decls route to `imports`
    /// instead.
    functions: BcFunction[]
    /// `MonoEntry.symbol.id` → index into `functions`. Lets call sites
    /// resolve target fn slots through the symbol id rather than the
    /// mangled name.
    function_index_by_symbol_id: MutableMap<i32, i32>

    /// Mangled fn name → index into `functions`. Generic-instance call
    /// sites resolve by mangle : multiple instances of one generic share
    /// the generic's `symbol.id`, so `function_index_by_symbol_id` can't
    /// distinguish them — the per-instance mangle can.
    function_index_by_mangle: MutableMap<string, i32>

    /// Host-side import table (`@extern` user decls + stdlib
    /// `@intrinsic` shims). Each entry's `signature` mirrors what the
    /// host expects at the C-ABI boundary.
    imports: BcImport[]
    /// `MonoEntry.symbol.id` → index into `imports`. Same role as
    /// `function_index_by_symbol_id` for the import side.
    import_index_by_symbol_id: MutableMap<i32, i32>
    /// Import mangled-name → index into `imports`. Lets a call whose
    /// callee carries only a mangle (synthetic `id = 0`, e.g. an
    /// intrinsic impl-member call surfaced as a bodyless extern) resolve
    /// to a `CallImport`. Mirror of `function_index_by_mangle` for imports.
    import_index_by_mangle: MutableMap<string, i32>

    /// `@export` decls — exposed to the host linker. C-emit's `main`
    /// shim consults this to pick the program entry point.
    exports: BcExport[]

    /// Type indices that aren't directly referenced by any op or fn
    /// signature but must survive `prune_unused_types`, and that aren't
    /// scoped to a single function (the vtable-receiver pins from the
    /// Pass-4 prune setup, already gated on used vtable keys).
    /// Per-call arg/result pins live in `pinned_types_by_fn` instead.
    pinned_types: i32[]

    /// Set once `prune_unused_types` has run. Past that point the table is
    /// FINAL: a slot minted afterwards is invisible to the prune, so it survives
    /// as an orphan `ref` — dead, pinned, and permanent — and any field access
    /// reaching it panics with `emit/bytecode/emit: no field ... on ...`. That is not
    /// hypothetical: `build_vtables_from_entries` did exactly this until
    /// `aba0fcff4`, and its sibling had carried the rule as a comment for months.
    /// A comment is not a guard, hence this flag: `intern_type` refuses to CREATE
    /// while it is set. Lookups stay legal — the builders that run after the
    /// prune are supposed to look types up, just never to mint them.
    types_frozen: bool = false

    /// Per-function arg/result type pins, keyed by fn index. Each Call's
    /// arg + dst static types are pinned here under the emitting function,
    /// so `prune_unused_types` roots them only for SURVIVING functions —
    /// when a function is pruned, its pins drop with it (the roots live on
    /// the op). A global list would keep dead types (and the impl rows /
    /// monomorphised `Range` types they anchor) alive in every program.
    /// `prune_unused_functions` re-keys this by the post-prune index.
    pinned_types_by_fn: MutableMap<i32, i32[]>
}

/// Construct a fresh `EmitterCtx`. Reserves type-table slot 0 for the
/// `null` primitive (runtime depends on the tag invariant).
///
/// @return  a fresh emitter context ready for `emit_bytecode_from_cfg` to fill.
export new_emitter_ctx :: fn() -> EmitterCtx {
    types: BcType[]: []
    types.push(BcScalar { .val = .Null })
    type_key :: MutableMap<string, i32> {}
    type_key["null"] = 0
    type_hash :: MutableMap<u64, i32> {}
    type_hash[type_intern_hash(TY_NULL)] = 0
    type_by_slot: Type[]: [TY_NULL]
    return EmitterCtx {
        .types                       = types,
        .type_key                    = type_key,
        .type_hash                   = type_hash,
        .type_by_slot                = type_by_slot,
        .strings                     = [],
        .string_key                  = MutableMap<string, i32> {},
        .functions                   = [],
        .function_index_by_symbol_id = MutableMap<i32, i32> {},
        .function_index_by_mangle    = MutableMap<string, i32> {},
        .imports                     = [],
        .import_index_by_symbol_id   = MutableMap<i32, i32> {},
        .import_index_by_mangle      = MutableMap<string, i32> {},
        .exports                     = [],
        .pinned_types                = [],
        .pinned_types_by_fn          = MutableMap<i32, i32[]> {},
    }
}

/// Intern a `Type` into the module-wide type table, returning its
/// index. Idempotent : repeat calls with structurally-equal types
/// return the same index.
///
/// Primitive types take a fast path keyed on the primitive name (a
/// short interned string the typechecker already passes around), so
/// the common `i32` / `string` / `bool` cases skip the
/// `display_type` allocation entirely. Composite types fall back to
/// the `display_type` key — conservative but stable across the
/// pipeline.
///
/// @param t    the type to intern.
/// @param ctx  the emit context — its `types` + `type_key` get mutated.
/// @return     the type table index.
export intern_type :: fn(t: Type, ctx: EmitterCtx) -> i32 {
    h :: type_intern_hash(t)
    fast :: ctx.type_hash[h]
    if fast is i32 {
        if i64(fast) in 0..<ctx.type_by_slot.len() {
            if same_intern_class(t, ctx.type_by_slot[fast]) { return fast }
        }
    }
    key :: type_intern_key(t)
    new_index :: i32(ctx.types.len())
    existing :: ctx.type_key.get_or_put(key, new_index)
    if existing != new_index {
        if fast == null {
            ctx.type_hash[h] = existing
            record_slot_type(ctx, existing, t)
        }
        return existing
    }
    if ctx.types_frozen {
        panic("emit/bytecode/emit_ctx: intern_type would mint `${key}` after prune_unused_types — the table is final by then, so the slot would survive as an orphan `ref` and panic at the first field access. Look the type up and skip the entry instead, as `build_impl_table_from_vtable` does.")
    }
    // Reserve placeholder so recursive / self types don't loop. The index is
    // registered above; a `BcRef` placeholder (empty `trait_name`) fills its
    // slot until the proper translation overwrites it. The placeholder is
    // visible to any nested `intern_type` call that re-enters with the
    // same key.
    placeholder: BcType: BcRef { .trait_name = "" }
    ctx.types.push(placeholder)
    if fast == null {
        ctx.type_hash[h] = new_index
    }
    record_slot_type(ctx, new_index, t)
    ctx.types[new_index] = bc_type_of_with_ctx(t, ctx)
    return new_index
}

/// Intern a string literal into the module-wide pool. Returns the
/// pool index. Like `intern_type`, idempotent on identical content.
///
/// @param s    the string to intern.
/// @param ctx  the emit context.
/// @return     the pool index.
export intern_string :: fn(s: string, ctx: EmitterCtx) -> i32 {
    new_index :: i32(ctx.strings.len())
    index :: ctx.string_key.get_or_put(s, new_index)
    if index == new_index {
        ctx.strings.push(s)
    }
    return index
}

/// Intern a synthetic `$Cell<T>` struct type whose only field is
/// `value: T`. Closure-cell construction / read / write all read this
/// type-index off the `$Cell` slot rather than allocating a one-element
/// array (the earlier shortcut). Idempotent : repeat calls with the
/// same `slot_type` return the same index.
///
/// Keyed under `$Cell<<slot-intern-key>>` so the cache is independent
/// of `intern_type`'s keying (the inner `value` field shares its key
/// with the slot type's regular interning).
///
/// @param slot_type  the captured local's type.
/// @param ctx        the emit context.
/// @return           the type-table index of the `$Cell<T>` struct.
export intern_cell_type :: fn(slot_type: Type, ctx: EmitterCtx) -> i32 {
    slot_index :: intern_type(slot_type, ctx)
    key :: "\$Cell<${type_intern_key(slot_type)}>"
    new_index :: i32(ctx.types.len())
    existing :: ctx.type_key.get_or_put(key, new_index)
    if existing != new_index {
        return existing
    }
    field :: BcField { .name = "value", .type_index = slot_index }
    fields: BcField[]: []
    fields.push(field)
    // Name keys on the inner type's intern key, not the (volatile) post-
    // DCE slot — so a closure capturing the same T always materialises
    // with the same `$Cell_<T>` name across re-emits. The slot id approach
    // froze whatever slot the cell happened to land in before DCE
    // remapped it.
    ctx.types.push(BcStruct {
        .name      = "\$Cell_${type_intern_key(slot_type)}",
        .fields    = fields,
        .c_name    = "",
        .symbol_id = -1,
    })
    return new_index
}

/// Context-aware translation : recursively interns element / param /
/// return types so the resulting `BcType` carries the right type-table
/// indices for composite shapes : Struct/Trait → `BcRef { trait_name }`,
/// Array → `BcArray { element }`, Union → `BcUnion { variants }`,
/// Fn → `BcFn { params, return_type }`.
/// Tuple synthesises an anonymous struct named after its shape.
///
/// Exhaustive over `Type` by design (no `_` fall-through) : the bare
/// types that have no first-class bytecode shape (type-params, meta,
/// self, unresolved, free numerics, never) collapse to an opaque
/// `BcRef { "" }`, but listing them keeps the match honest, so adding a
/// new `Type` variant trips T3013 here instead of silently degrading to
/// `ref` (the failure mode that hid the missing `Tuple` case).
///
/// @param t    the type to translate.
/// @param ctx  the emit context — nested types intern through it.
/// @return     the `BcType` for the type table.
bc_type_of_with_ctx :: fn(t: Type, ctx: EmitterCtx) -> BcType {
    match t {
        is PrimitiveType -> { return BcScalar { .val = val_type_of_primitive_name(t.name) } }
        is EnumType | RangeType -> { return BcScalar { .val = val_type_of_type(t) } }
        is DistinctType  -> { return bc_type_of_with_ctx(t.backing, ctx) }
        is StructType    -> { return BcRef { .trait_name = t.symbol.name } }
        is TraitType     -> { return BcRef { .trait_name = trait_key_of(t.symbol) } }
        is ArrayType     -> { return BcArray { .element = intern_type(t.element, ctx) } }
        is UnionType     -> {
            variant_indices: i32[]: []
            for v in t.variants { variant_indices.push(intern_type(v, ctx)) }
            return BcUnion { .variants = variant_indices }
        }
        is FnType -> {
            param_indices: i32[]: []
            for p in t.params { param_indices.push(intern_type(p, ctx)) }
            return BcFn {
                .params = param_indices,
                .return_type = intern_type(t.return_type, ctx),
            }
        }
        // Anonymous struct with positional fields `_0`, `_1`, … , named after
        // the tuple's SHAPE so `[i32, string]` and `[bool, string]` still emit
        // distinct C structs.
        //
        // The name must not depend on the slot's RANK in the type table: a rank
        // shifts when anything interned earlier differs, and a name that shifts
        // makes identical modules emit different C. `type_intern_key` is the
        // same key `intern_type` dedupes on, so two tuples share a name exactly
        // when they share a slot.
        is TupleType -> {
            fields: BcField[]: []
            for i in 0..<t.elements.len() {
                fields.push(BcField {
                    .name       = "_${i}",
                    .type_index = intern_type(t.elements[i], ctx),
                })
            }
            return BcStruct {
                .name      = "__Tuple_${tuple_shape_name(t.elements)}",
                .fields    = fields,
                .c_name    = "",
                .symbol_id = -1,
            }
        }
        // No first-class bytecode shape — opaque `ref`. Listed explicitly
        // (not a `_` catch-all) so a new `Type` variant trips T3013.
        is TypeParamType  -> { return OPAQUE_REF }
        is InferVar       -> { leaked_infer_var(t) }
        is TypeMetaType   -> { return OPAQUE_REF }
        is SelfType       -> { return OPAQUE_REF }
        is UnresolvedType -> { return OPAQUE_REF }
        is FreeIntType    -> { return OPAQUE_REF }
        is FreeCharType   -> { return OPAQUE_REF }
        is FreeFloatType  -> { return OPAQUE_REF }
        is NeverType      -> { return OPAQUE_REF }
        is AnyType        -> { return OPAQUE_REF }
    }
}

/// Opaque `ref` for a `Type` with no first-class bytecode shape.
OPAQUE_REF :: BcRef { .trait_name = "" }

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test test_new_emitter_ctx_reserves_null_slot :: fn() -> void {
    ctx :: new_emitter_ctx()
    assert_eq(ctx.types.len(), 1)
    null_idx :: ctx.type_key["null"]
    match null_idx {
        is i32 -> assert_eq(null_idx, 0)
        _ -> assert_eq("null missing", "")
    }
}

@test test_intern_type_idempotent :: fn() -> void {
    ctx :: new_emitter_ctx()
    a :: intern_type(TY_I32, ctx)
    b :: intern_type(TY_I32, ctx)
    assert_eq(a, b)
}

@test test_intern_type_distinct_primitives_get_distinct_indices :: fn() -> void {
    ctx :: new_emitter_ctx()
    i32_idx :: intern_type(TY_I32, ctx)
    str_idx :: intern_type(TY_STRING, ctx)
    if i32_idx == str_idx { assert_eq("indices should differ", "") }
}

@test test_intern_string_idempotent :: fn() -> void {
    ctx :: new_emitter_ctx()
    a :: intern_string("hello", ctx)
    b :: intern_string("hello", ctx)
    assert_eq(a, b)
}

@test test_intern_string_distinct_strings_get_distinct_indices :: fn() -> void {
    ctx :: new_emitter_ctx()
    a :: intern_string("hello", ctx)
    b :: intern_string("world", ctx)
    if a == b { assert_eq("indices should differ", "") }
}

@test test_default_emit_options :: fn() -> void {
    opts :: default_emit_options()
    assert_eq(opts.optimize, true)
}

/// Remember the type a slot was minted for, padding the array so the index is
/// always addressable. Callers reach slots out of order (`reserve_struct` mints
/// ahead of `intern_type`), so a plain `push` would desync.
export record_slot_type :: fn(ctx: EmitterCtx, index: i32, t: Type) -> void {
    for _ in ctx.type_by_slot.len()..=i64(index) {
        ctx.type_by_slot.push(TY_NULL)
    }
    ctx.type_by_slot[index] = t
}
