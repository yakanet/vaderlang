// vader/emit/wasm/arrays: the arrays, as Wasm GC holds them.
//
// Every array is one struct type, the header, whatever its element:
// `{ type_id: i32, element: i32, length: i64, capacity: i64, offset: i32,
// storage: eqref, shared: i32 }`. `type_id` is the bytecode type the array was
// made as, which `is` reads. `storage` is a WASM array that holds the elements
// from `offset` on: one array type per way of storing (`WasmStorageType`), an
// `i8` for a `u8`, an `eqref` for a reference. `element` says which: the
// position of the element's class in `BOXED_CLASSES`, or `REFERENCE_ELEMENT` for
// elements held by reference, boxed scalars included. An access whose element
// type the bytecode erased (a `T[]` in a shared generic instance) reads `element`
// to reach the storage, as the native runtime reads the element kind off the
// buffer.
//
// A slice is a view: a header over the storage of the array it slices. The
// native rule holds (docs/adr/0108, 0122): a header writes in place only the
// slots `[length, capacity)`, which no other header reads. A view is born with
// `capacity == length`, and a header marked `shared` that shrinks sets
// `capacity = length`, so the next push of either copies into a storage of its
// own. Until then a write through either reaches the other, as natively.
//
// The accesses are functions the emitter writes once per way of storing, as
// `checked.vader` does for the checked ops. They check the index against
// `length`, `bounds_safe` or not, and stop the run (`unreachable`) past it.

module "vader/emit/wasm"

Bc :: import "vader/core/bytecode"
import "std/abort"
import "std/collections"
import "std/iter"
import "std/math"

// The fields of the header.
HEADER_TYPE: i32: 0
HEADER_ELEMENT: i32: 1
HEADER_LENGTH: i32: 2
HEADER_CAPACITY: i32: 3
HEADER_OFFSET: i32: 4
HEADER_STORAGE: i32: 5
HEADER_SHARED: i32: 6

// The `element` of an array whose elements are held by reference.
REFERENCE_ELEMENT: i32: -1

// The ways of storing elements, an array type each.
STORAGES: WasmStorageType[]: [.I8, .I16, .I32, .I64, .F32, .F64, .EqRef]

// Add the storage types, then the header, and list the boxed classes `m` makes
// arrays of: an erased access reaches no other.
add_array_types :: fn(gc: GcTypes, m: Bc.BytecodeModule) -> void {
    for storage in STORAGES {
        gc.storages[storage] = gc.add_type(WasmArrayType { .element = storage })
    }
    header: WasmField[]: [
        WasmField { .type = .I32 },
        WasmField { .type = .I32 },
        WasmField { .type = .I64 },
        WasmField { .type = .I64 },
        WasmField { .type = .I32 },
        WasmField { .type = .EqRef },
        WasmField { .type = .I32 },
    ]
    gc.array_header = gc.add(header)
    for class in BOXED_CLASSES {
        if m.types.any_match((t) -> stores_class(m.types, t, class)) {
            gc.array_classes.push(class)
        }
    }
}

// Whether `t` is an array type whose elements are of the class `class`.
stores_class :: fn(types: Bc.BcType[], t: Bc.BcType, class: Bc.ValType) -> bool {
    if t !is Bc.BcArray {
        return false
    }
    return element_access(types, types[t.element]).class == class
}

// How an access reaches the elements of an array.
ElementAccess :: struct {
    /// The boxed class whose storage holds the elements, null for elements held
    /// by reference.
    class: Bc.ValType | null = null
    /// Whether the element type may hold any value, so that an access reads the
    /// `element` the array records.
    recorded: bool = false
}

REFERENCE_ACCESS :: ElementAccess {}
RECORDED_ACCESS  :: ElementAccess { .recorded = true }

// The access to elements of the type `element`. It differs from
// `Bc.array_kind_of`, the native runtime's: a string is an `i32` atom here,
// stored as itself.
element_access :: fn(types: Bc.BcType[], element: Bc.BcType) -> ElementAccess = match element {
    is Bc.BcScalar                        -> scalar_access(element.val)
    is Bc.BcStruct | Bc.BcArray | Bc.BcFn -> REFERENCE_ACCESS
    is Bc.BcUnion                         -> union_access(types, element)
    is Bc.BcRef                           -> RECORDED_ACCESS
}

scalar_access :: fn(v: Bc.ValType) -> ElementAccess = match v {
    .I8 | .I16 | .I32 | .I64 | .U8 | .U16 | .U32 | .U64 | .F32 | .F64 | .Bool | .Char
        | .String -> ElementAccess { .class = v }
    .Null | .Void | .Ref | .Any -> RECORDED_ACCESS
    .Pointer -> REFERENCE_ACCESS
}

// A union of references, `null` among them, holds no scalar.
union_access :: fn(types: Bc.BcType[], u: Bc.BcUnion) -> ElementAccess {
    if Bc.is_ref_only_element(u, types) {
        return REFERENCE_ACCESS
    }
    return RECORDED_ACCESS
}

// The access to the elements of the array type `type_id`.
array_access :: fn(
    ctx: ModuleCtx,
    type_id: i32,
    function: string,
) -> ElementAccess | WasmUnsupported {
    types :: ctx.module.types
    array :: types[type_id]
    if array !is Bc.BcArray {
        return WasmUnsupported { .reason = "`${function}`: type ${type_id} is no array" }
    }
    return element_access(types, types[array.element])
}

// What the header of an array made with `access` records in `element`.
element_code :: fn(access: ElementAccess) -> i32 {
    class :: access.class else return REFERENCE_ELEMENT
    return class_code(class)
}

class_code :: fn(class: Bc.ValType) -> i32 =
    i32(BOXED_CLASSES.index_of(class) else panic("wasm: no box for an array class"))

storage_of_access :: fn(access: ElementAccess) -> WasmStorageType {
    class :: access.class else return .EqRef
    return storage_of(class)
}

// How an array stores a scalar of the boxed class `class`.
storage_of :: fn(class: Bc.ValType) -> WasmStorageType = match class {
    .U8 | .I8 | .Bool                      -> .I8
    .U16 | .I16                            -> .I16
    .I32 | .U32 | .Char | .String          -> .I32
    .I64 | .U64                            -> .I64
    .F32 | .F64                            -> .F64
    .Null | .Void | .Pointer | .Ref | .Any -> .EqRef
}

extension_of :: fn(class: Bc.ValType) -> Extension = match class {
    .U8 | .Bool | .U16 -> .Unsigned
    .I8 | .I16 -> .Signed
    .I32 | .U32 | .Char | .String | .I64 | .U64 | .F32 | .F64 | .Null | .Void | .Pointer | .Ref
        | .Any -> .None
}

// The type a value stored as `storage` has on the stack.
held_of_storage :: fn(storage: WasmStorageType) -> WasmValType = match storage {
    .I8 | .I16 | .I32 -> .I32
    .I64              -> .I64
    .F32              -> .F32
    .F64              -> .F64
    .EqRef            -> .EqRef
}

storage_name :: fn(storage: WasmStorageType) -> string = match storage {
    .I8    -> "i8"
    .I16   -> "i16"
    .I32   -> "i32"
    .I64   -> "i64"
    .F32   -> "f32"
    .F64   -> "f64"
    .EqRef -> "eqref"
}

extension_name :: fn(extension: Extension) -> string = match extension {
    .None     -> ""
    .Signed   -> "_s"
    .Unsigned -> "_u"
}

storage_type :: fn(gc: GcTypes, storage: WasmStorageType) -> i32 =
    gc.storages[storage] else panic("wasm: no array type for a storage")

// The box of the boxed class `class`.
box_of_class :: fn(gc: GcTypes, class: Bc.ValType) -> i32 =
    gc.of_box[class] else panic("wasm: no box for a boxed class")

// ---- ops ------------------------------------------------------------------

// The array ops `push_array_op` translates.
ArrayOp :: Bc.ArrayNew
         | Bc.ArrayReserve
         | Bc.ArrayLen
         | Bc.ArrayClear
         | Bc.ArrayGet
         | Bc.ArraySet
         | Bc.ArrayPush
         | Bc.ArrayRemoveLast
         | Bc.ArraySlice
         | Bc.ArrayRepeat
         | Bc.ArrayPushAll
         | Bc.ArrayCopy
         | Bc.DataConst
         | Bc.LoadSlotI32
         | Bc.LoadSlotI64
         | Bc.LoadSlotF64
         | Bc.StoreSlotI32
         | Bc.StoreSlotI64
         | Bc.StoreSlotF64

// The translation of an array op. `stack` holds the values under it: an index,
// a count or a bound comes as an `i32` or an `i64`, and the helpers take `i64`.
push_array_op :: fn(
    ctx: ModuleCtx,
    scratch: Scratch,
    stack: OperandStack,
    out: WasmInstr[],
    op: ArrayOp,
    function: string,
) -> void | WasmUnsupported {
    gc :: ctx.gc
    widened :: out.push_widened(scratch, stack, integer_depths(op), function)
        else return widened
    match op {
        is Bc.ArrayNew        -> {
            access :: array_access(ctx, op.type_id, function) else return access
            storage :: storage_type(gc, storage_of_access(access))
            out.push(ArrayNewFixed { .type_index = storage, .length = op.length })
            out.push_header(ctx, scratch, op.type_id, access, i64(op.length))
        }
        is Bc.ArrayReserve    -> {
            access :: array_access(ctx, op.type_id, function) else return access
            out.push_all(
                [
                    I32Const { .value = op.type_id },
                    I32Const { .value = element_code(access) },
                    Call { .function_index = ctx.array_reserve(storage_of_access(access)) },
                ],
            )
        }
        is Bc.ArrayLen        -> {
            out.push_all(
                [
                    header_of(gc),
                    StructGet { .type_index = gc.array_header, .field_index = HEADER_LENGTH },
                ],
            )
        }
        is Bc.ArrayClear      -> { out.push(Call { .function_index = ctx.array_clear() }) }
        is Bc.ArrayGet        -> {
            access :: array_access(ctx, op.type_id, function) else return access
            out.push(Call { .function_index = ctx.get_function(access) })
        }
        is Bc.ArraySet        -> {
            access :: array_access(ctx, op.type_id, function) else return access
            out.push(Call { .function_index = ctx.set_function(access) })
        }
        is Bc.ArrayPush       -> {
            // `type_id` is the element's type, not the array's.
            access :: element_access(ctx.module.types, ctx.module.types[op.type_id])
            out.push(Call { .function_index = ctx.push_function(access) })
        }
        is Bc.ArrayRemoveLast -> { out.push(Call { .function_index = ctx.array_remove_last() }) }
        is Bc.ArraySlice      -> {
            out.push_all(
                [I32Const { .value = op.type_id }, Call { .function_index = ctx.array_slice() }],
            )
        }
        is Bc.ArrayRepeat     -> { out.push(Call { .function_index = ctx.array_repeat() }) }
        is Bc.ArrayPushAll    -> { out.push(Call { .function_index = ctx.array_push_all() }) }
        is Bc.ArrayCopy       -> { out.push(Call { .function_index = ctx.array_copy() }) }
        is Bc.DataConst       -> {
            data :: ctx.data_function(op, function) else return data
            out.push(Call { .function_index = data })
        }
        is Bc.LoadSlotI32     -> { out.push(Call { .function_index = ctx.array_get(.I32, .None) }) }
        is Bc.LoadSlotI64     -> { out.push(Call { .function_index = ctx.array_get(.I64, .None) }) }
        is Bc.LoadSlotF64     -> { out.push(Call { .function_index = ctx.array_get(.F64, .None) }) }
        is Bc.StoreSlotI32    -> { out.push(Call { .function_index = ctx.array_set(.I32) }) }
        is Bc.StoreSlotI64    -> { out.push(Call { .function_index = ctx.array_set(.I64) }) }
        is Bc.StoreSlotF64    -> { out.push(Call { .function_index = ctx.array_set(.F64) }) }
    }
}

// Where the integers `op` reads sit, counted from the top of the stack.
integer_depths :: fn(op: ArrayOp) -> i64[] = match op {
    is Bc.ArrayGet | Bc.LoadSlotI32 | Bc.LoadSlotI64 | Bc.LoadSlotF64 | Bc.ArrayReserve
        | Bc.ArrayRepeat -> [0]
    is Bc.ArraySet | Bc.StoreSlotI32 | Bc.StoreSlotI64 | Bc.StoreSlotF64 -> [1]
    is Bc.ArraySlice -> [0, 1]
    is Bc.ArrayCopy -> [0, 1, 3]
    is Bc.ArrayNew | Bc.ArrayLen | Bc.ArrayClear | Bc.ArrayPush | Bc.ArrayRemoveLast
        | Bc.ArrayPushAll | Bc.DataConst -> []
}

// Widen to `i64` each of the integers `depths` values below the top that the
// bytecode pushed as an `i32`. The values above the deepest wait in scratch
// locals meanwhile, each its own.
push_widened :: fn(
    out: WasmInstr[],
    scratch: Scratch,
    stack: OperandStack,
    depths: i64[],
    function: string,
) -> void | WasmUnsupported {
    count :: stack.types.len()
    at :: (depth: i64) -> stack.types[count - 1 - depth]
    deepest: i64 = -1
    for depth in depths {
        if count <= depth {
            return WasmUnsupported { .reason = "`${function}`: an array op finds no integer" }
        }
        if at(depth) == .I32 {
            deepest = max(deepest, depth)
        } else if at(depth) != .I64 {
            return WasmUnsupported { .reason = "`${function}`: an array index is no integer" }
        }
    }
    if deepest < 0 {
        return
    }
    // The value at `depth` waits in the local of its type past those of the
    // values above it.
    kept: i32[]: []
    for depth in 0..<deepest {
        above :: (0..<depth).filter((d) -> at(d) == at(depth)).count()
        kept.push(scratch.spill_local(at(depth), above))
        out.push(LocalSet { .index = kept[depth] })
    }
    out.push(Plain { .op = .I64ExtendI32S })
    for back in 0..<deepest {
        depth :: deepest - 1 - back
        out.push(LocalGet { .index = kept[depth] })
        if depth in depths && at(depth) == .I32 {
            out.push(Plain { .op = .I64ExtendI32S })
        }
    }
}

// The header of a new array of `length` elements, of the type `type_id`, its
// storage on the stack.
push_header :: fn(
    out: WasmInstr[],
    ctx: ModuleCtx,
    scratch: Scratch,
    type_id: i32,
    access: ElementAccess,
    length: i64,
) -> void {
    storage :: scratch.local_of(.EqRef)
    out.push(LocalSet { .index = storage })
    out.push_on_stack(new_header(ctx.gc, full_fields(type_id, access, length, local_get(storage))))
}

// The function reading an element through `access`.
get_function :: fn(ctx: ModuleCtx, access: ElementAccess) -> i32 {
    if access.recorded {
        return ctx.recorded_array_get()
    }
    class :: access.class else return ctx.array_get(.EqRef, .None)
    return ctx.array_get(storage_of(class), extension_of(class))
}

// The function writing an element through `access`.
set_function :: fn(ctx: ModuleCtx, access: ElementAccess) -> i32 {
    if access.recorded {
        return ctx.recorded_array_set()
    }
    return ctx.array_set(storage_of_access(access))
}

// The function appending an element through `access`.
push_function :: fn(ctx: ModuleCtx, access: ElementAccess) -> i32 {
    if access.recorded {
        return ctx.recorded_array_push()
    }
    return ctx.array_push(storage_of_access(access))
}

// The header of the array on the stack, cast.
header_of :: fn(gc: GcTypes) -> WasmInstr = RefCast { .type_index = gc.array_header }

// ---- typed helpers --------------------------------------------------------

// `(array, index: i64) -> element`, stored as `storage`, read as `extension`.
array_get :: fn(ctx: ModuleCtx, storage: WasmStorageType, extension: Extension) -> i32 {
    key :: "array.get.${storage_name(storage)}${extension_name(extension)}"
    return ctx.helpers[key] else define_get(ctx, key, storage, extension)
}

define_get :: fn(
    ctx: ModuleCtx,
    key: string,
    storage: WasmStorageType,
    extension: Extension,
) -> i32 {
    gc :: ctx.gc
    array :: 0
    index :: 1
    frame :: HelperFrame { .signature = func_of([.EqRef, .I64], [held_of_storage(storage)]) }
    element :: array_get(
        storage_type(gc, storage),
        storage_in(gc, array),
        position_in(gc, array, index),
        extension,
    )
    return ctx.define_tree_helper(key, frame, [bounds_check(ctx, array, index), element])
}

// `(array, index: i64, element) -> ()`, stored as `storage`.
array_set :: fn(ctx: ModuleCtx, storage: WasmStorageType) -> i32 {
    key :: "array.set.${storage_name(storage)}"
    return ctx.helpers[key] else define_set(ctx, key, storage)
}

define_set :: fn(ctx: ModuleCtx, key: string, storage: WasmStorageType) -> i32 {
    gc :: ctx.gc
    array :: 0
    index :: 1
    element :: 2
    frame :: HelperFrame { .signature = func_of([.EqRef, .I64, held_of_storage(storage)], []) }
    store :: array_set(
        storage_type(gc, storage),
        storage_in(gc, array),
        position_in(gc, array, index),
        local_get(element),
    )
    return ctx.define_tree_helper(key, frame, [bounds_check(ctx, array, index), store])
}

// `(array, element) -> ()`, stored as `storage`.
array_push :: fn(ctx: ModuleCtx, storage: WasmStorageType) -> i32 {
    key :: "array.push.${storage_name(storage)}"
    return ctx.helpers[key] else define_push(ctx, key, storage)
}

// When the length reaches the capacity, a storage of its own, twice as large and
// four elements at least, takes the place of the one the header reads, its
// elements copied.
define_push :: fn(ctx: ModuleCtx, key: string, storage: WasmStorageType) -> i32 {
    gc :: ctx.gc
    array :: 0
    element :: 1
    storage_index :: storage_type(gc, storage)
    frame :: HelperFrame { .signature = func_of([.EqRef, held_of_storage(storage)], []) }
    length :: frame.local(.I64)
    capacity :: frame.local(.I32)
    grown :: frame.local(.EqRef)
    copied :: array_copy(
        storage_index,
        ArraySpan { .array = local_get(grown), .at = i32_const(0) },
        ArraySpan {
            .array = header_field(gc, array, HEADER_STORAGE),
            .at = header_field(gc, array, HEADER_OFFSET),
        },
        i32_wrap_i64(local_get(length)),
    )
    grow: WasmExpression[]: [
        local_set(capacity, i32_shl(i32_wrap_i64(local_get(length)), i32_const(1))),
        when(i32_lt_u(local_get(capacity), i32_const(4)), [local_set(capacity, i32_const(4))]),
        local_set(grown, array_new_default(storage_index, local_get(capacity))),
        copied,
        header_set(gc, array, HEADER_STORAGE, local_get(grown)),
        header_set(gc, array, HEADER_OFFSET, i32_const(0)),
        header_set(gc, array, HEADER_CAPACITY, i64_extend_i32_u(local_get(capacity))),
        header_set(gc, array, HEADER_SHARED, i32_const(0)),
    ]
    store :: array_set(
        storage_index,
        header_field(gc, array, HEADER_STORAGE),
        position_in(gc, array, length),
        local_get(element),
    )
    body: WasmExpression[]: [
        local_set(length, header_field(gc, array, HEADER_LENGTH)),
        when(i64_eq(header_field(gc, array, HEADER_CAPACITY), local_get(length)), grow),
        store,
        header_set(gc, array, HEADER_LENGTH, i64_add(local_get(length), i64_const(1))),
    ]
    return ctx.define_tree_helper(key, frame, body)
}

// `(count: i64, type_id: i32, element: i32) -> array`: an empty array with room
// for `count` elements stored as `storage`; none for a negative count.
array_reserve :: fn(ctx: ModuleCtx, storage: WasmStorageType) -> i32 {
    key :: "array.reserve.${storage_name(storage)}"
    return ctx.helpers[key] else define_reserve(ctx, key, storage)
}

define_reserve :: fn(ctx: ModuleCtx, key: string, storage: WasmStorageType) -> i32 {
    count :: 0
    type_id :: 1
    element :: 2
    frame :: HelperFrame { .signature = func_of([.I64, .I32, .I32], [.EqRef]) }
    header :: HeaderFields {
        .type_id = local_get(type_id),
        .element = local_get(element),
        .length = i64_const(0),
        .capacity = local_get(count),
        .storage = array_new_default(storage_type(ctx.gc, storage), i32_wrap_i64(local_get(count))),
    }
    body: WasmExpression[]: [clamp(count, i64_const(0), .I64LtS), new_header(ctx.gc, header)]
    return ctx.define_tree_helper(key, frame, body)
}

// ---- recorded helpers -----------------------------------------------------

// `(array, index: i64) -> eqref` through the `element` the array records: a
// scalar comes out boxed.
recorded_array_get :: fn(ctx: ModuleCtx) -> i32 {
    key :: "array.get.recorded"
    frame :: HelperFrame { .signature = func_of([.EqRef, .I64], [.EqRef]) }
    array :: 0
    index :: 1
    read :: fn(class: Bc.ValType) -> WasmExpression {
        typed :: ctx.array_get(storage_of(class), extension_of(class))
        value :: call(typed, [local_get(array), local_get(index)])
        return struct_new(box_of_class(ctx.gc, class), [value])
    }
    return ctx.helpers[key]
        else ctx.define_recorded(key, frame, read, ctx.array_get(.EqRef, .None))
}

// `(array, index: i64, element: eqref) -> ()` through the `element` the array
// records: a scalar goes in unboxed.
recorded_array_set :: fn(ctx: ModuleCtx) -> i32 {
    key :: "array.set.recorded"
    frame :: HelperFrame { .signature = func_of([.EqRef, .I64, .EqRef], []) }
    array :: 0
    index :: 1
    element :: 2
    write :: fn(class: Bc.ValType) -> WasmExpression {
        unboxed :: struct_get(box_of_class(ctx.gc, class), 0, local_get(element))
        return call(ctx.array_set(storage_of(class)), [local_get(array), local_get(index), unboxed])
    }
    return ctx.helpers[key] else ctx.define_recorded(key, frame, write, ctx.array_set(.EqRef))
}

// `(array, element: eqref) -> ()` through the `element` the array records.
recorded_array_push :: fn(ctx: ModuleCtx) -> i32 {
    key :: "array.push.recorded"
    frame :: HelperFrame { .signature = func_of([.EqRef, .EqRef], []) }
    array :: 0
    element :: 1
    append :: fn(class: Bc.ValType) -> WasmExpression {
        unboxed :: struct_get(box_of_class(ctx.gc, class), 0, local_get(element))
        return call(ctx.array_push(storage_of(class)), [local_get(array), unboxed])
    }
    return ctx.helpers[key] else ctx.define_recorded(key, frame, append, ctx.array_push(.EqRef))
}

// An access through the `element` the array in parameter 0 records: one branch
// per class the module makes arrays of, `typed` the access, then `references`,
// the access to an array of references, which takes the parameters as they are.
// An `element` that names neither stops the run.
define_recorded :: fn(
    ctx: ModuleCtx,
    key: string,
    frame: HelperFrame,
    typed: fn(Bc.ValType) -> WasmExpression,
    references: i32,
) -> i32 {
    array :: 0
    element :: frame.local(.I32)
    body: WasmExpression[]: [local_set(element, header_field(ctx.gc, array, HEADER_ELEMENT))]
    for class in ctx.gc.array_classes {
        body.push(when(is_element(local_get(element), class), [return_([typed(class)])]))
    }
    body.push(trap_if(ctx, i32_ne(local_get(element), i32_const(REFERENCE_ELEMENT))))
    parameters: WasmExpression[]: []
    for parameter in 0..<frame.signature.params.len() {
        parameters.push(local_get(i32(parameter)))
    }
    body.push(call(references, parameters))
    return ctx.define_tree_helper(key, frame, body)
}

// Whether the element code `element` is that of the class `class`.
is_element :: fn(element: WasmExpression, class: Bc.ValType) -> WasmExpression =
    i32_eq(element, i32_const(class_code(class)))

// ---- whole-array helpers --------------------------------------------------

// `(array) -> eqref`: the last element, boxed, taken off; null on an empty
// array.
array_remove_last :: fn(ctx: ModuleCtx) -> i32 =
    ctx.helpers["array.remove_last"] else define_remove_last(ctx)

define_remove_last :: fn(ctx: ModuleCtx) -> i32 {
    gc :: ctx.gc
    array :: 0
    frame :: HelperFrame { .signature = func_of([.EqRef], [.EqRef]) }
    length :: frame.local(.I64)
    last :: frame.local(.EqRef)
    before_end :: i64_sub(local_get(length), i64_const(1))
    body: WasmExpression[]: [
        when(
            i64_eqz(local_tee(length, header_field(gc, array, HEADER_LENGTH))),
            [return_([ref_null()])],
        ),
        local_set(last, call(ctx.recorded_array_get(), [local_get(array), before_end])),
        header_set(gc, array, HEADER_LENGTH, before_end),
        shrunk(gc, array),
        local_get(last),
    ]
    return ctx.define_tree_helper("array.remove_last", frame, body)
}

// `(array) -> ()`: the length set to zero, the storage kept.
array_clear :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["array.clear"] else define_clear(ctx)

define_clear :: fn(ctx: ModuleCtx) -> i32 {
    array :: 0
    frame :: HelperFrame { .signature = func_of([.EqRef], []) }
    body: WasmExpression[]: [
        header_set(ctx.gc, array, HEADER_LENGTH, i64_const(0)),
        shrunk(ctx.gc, array),
    ]
    return ctx.define_tree_helper("array.clear", frame, body)
}

// A header marked `shared` that shrank keeps no room: its next push copies.
shrunk :: fn(gc: GcTypes, array: i32) -> WasmExpression {
    length :: header_field(gc, array, HEADER_LENGTH)
    return when(
        header_field(gc, array, HEADER_SHARED),
        [header_set(gc, array, HEADER_CAPACITY, length)],
    )
}

// `(array, lo: i64, hi: i64, type_id: i32) -> array`: a view on the elements
// `lo..<hi`, the bounds clamped to the array.
array_slice :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["array.slice"] else define_slice(ctx)

// `hi` becomes the length of the view.
define_slice :: fn(ctx: ModuleCtx) -> i32 {
    gc :: ctx.gc
    array :: 0
    lo :: 1
    hi :: 2
    type_id :: 3
    frame :: HelperFrame { .signature = func_of([.EqRef, .I64, .I64, .I32], [.EqRef]) }
    length :: frame.local(.I64)
    view :: HeaderFields {
        .type_id = local_get(type_id),
        .element = header_field(gc, array, HEADER_ELEMENT),
        .length = local_get(hi),
        .capacity = local_get(hi),
        .offset = position_in(gc, array, lo),
        .storage = header_field(gc, array, HEADER_STORAGE),
        .shared = i32_const(1),
    }
    body: WasmExpression[]: [
        local_set(length, header_field(gc, array, HEADER_LENGTH)),
        clamp(lo, i64_const(0), .I64LtS),
        clamp(lo, local_get(length), .I64GtS),
        clamp(hi, local_get(lo), .I64LtS),
        clamp(hi, local_get(length), .I64GtS),
        local_set(hi, i64_sub(local_get(hi), local_get(lo))),
        header_set(gc, array, HEADER_SHARED, i32_const(1)),
        new_header(gc, view),
    ]
    return ctx.define_tree_helper("array.slice", frame, body)
}

// `(destination, source) -> ()`: each element of `source` pushed onto
// `destination`, through the elements both record.
array_push_all :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["array.push_all"] else define_push_all(
    ctx,
)

define_push_all :: fn(ctx: ModuleCtx) -> i32 {
    destination :: 0
    source :: 1
    frame :: HelperFrame { .signature = func_of([.EqRef, .EqRef], []) }
    count :: frame.local(.I64)
    counter :: frame.local(.I64)
    element :: call(ctx.recorded_array_get(), [local_get(source), local_get(counter)])
    body: WasmExpression[]: [
        local_set(count, header_field(ctx.gc, source, HEADER_LENGTH)),
        repeat(
            .I64,
            counter,
            count,
            [call(ctx.recorded_array_push(), [local_get(destination), element])],
        ),
    ]
    return ctx.define_tree_helper("array.push_all", frame, body)
}

// `(array, count: i64) -> array`: the elements of the array `count` times, in a
// fresh array of its type; none for a negative count.
array_repeat :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["array.repeat"] else define_repeat(ctx)

// An empty array repeats to an empty one however large the count; a result past
// `STORAGE_GREATEST` elements stops the run.
define_repeat :: fn(ctx: ModuleCtx) -> i32 {
    gc :: ctx.gc
    array :: 0
    count :: 1
    frame :: HelperFrame { .signature = func_of([.EqRef, .I64], [.EqRef]) }
    result :: frame.local(.EqRef)
    counter :: frame.local(.I64)
    capacity :: frame.local(.I64)
    storage :: frame.local(.EqRef)
    too_many :: fn(value: WasmExpression) -> WasmExpression =
        trap_if(ctx, binary(.I64GtS, value, i64_const(STORAGE_GREATEST)))
    header :: HeaderFields {
        .type_id = header_field(gc, array, HEADER_TYPE),
        .element = header_field(gc, array, HEADER_ELEMENT),
        .length = i64_const(0),
        .capacity = local_get(capacity),
        .storage = local_get(storage),
    }
    body: WasmExpression[]: [
        clamp(count, i64_const(0), .I64LtS),
        when(i64_eqz(header_field(gc, array, HEADER_LENGTH)), [local_set(count, i64_const(0))]),
        too_many(local_get(count)),
        too_many(
            local_tee(capacity, i64_mul(local_get(count), header_field(gc, array, HEADER_LENGTH))),
        ),
        storage_like(gc, array, capacity, storage),
        local_set(result, new_header(gc, header)),
        repeat(
            .I64,
            counter,
            count,
            [call(ctx.array_push_all(), [local_get(result), local_get(array)])],
        ),
        local_get(result),
    ]
    return ctx.define_tree_helper("array.repeat", frame, body)
}

// A storage of as many elements as the `i64` in the local `capacity`, stored as
// the array in the local `array` stores its own, kept in the local `into`.
storage_like :: fn(gc: GcTypes, array: i32, capacity: i32, into: i32) -> WasmExpression {
    new_storage :: fn(storage: WasmStorageType) -> WasmExpression =
        local_set(
            into,
            array_new_default(storage_type(gc, storage), i32_wrap_i64(local_get(capacity))),
        )
    out := new_storage(.EqRef)
    classes :: gc.array_classes
    for k in 0..<classes.len() {
        class :: classes[classes.len() - 1 - k]
        same :: is_element(header_field(gc, array, HEADER_ELEMENT), class)
        out = when_else(same, [new_storage(storage_of(class))], [out])
    }
    return out
}

// `(source, source_start: i64, destination, destination_start: i64, count: i64)
// -> ()`: `count` elements copied in place, the two ranges free to overlap; a
// range past the end of its array stops the run.
array_copy :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["array.copy"] else define_copy(ctx)

// Two arrays that store alike copy with one `array.copy`, which allows the
// overlap; others go through boxes, all gathered in `window` before any is
// written.
define_copy :: fn(ctx: ModuleCtx) -> i32 {
    gc :: ctx.gc
    source :: 0
    source_start :: 1
    destination :: 2
    destination_start :: 3
    count :: 4
    frame :: HelperFrame { .signature = func_of([.EqRef, .I64, .EqRef, .I64, .I64], []) }
    window :: frame.local(.EqRef)
    counter :: frame.local(.I64)
    element :: frame.local(.I32)
    references :: storage_type(gc, .EqRef)
    copy_as :: fn(storage: WasmStorageType) -> WasmExpression[] {
        storage_index :: storage_type(gc, storage)
        to :: ArraySpan {
            .array = storage_in(gc, destination),
            .at = position_in(gc, destination, destination_start),
        }
        from :: ArraySpan {
            .array = storage_in(gc, source),
            .at = position_in(gc, source, source_start),
        }
        return [array_copy(storage_index, to, from, i32_wrap_i64(local_get(count))), return_()]
    }
    alike: WasmExpression[]: []
    for class in gc.array_classes {
        alike.push(when(is_element(local_get(element), class), copy_as(storage_of(class))))
    }
    alike.push_all(copy_as(.EqRef))
    same_element :: i32_eq(
        local_tee(element, header_field(gc, source, HEADER_ELEMENT)),
        header_field(gc, destination, HEADER_ELEMENT),
    )
    at :: i32_wrap_i64(local_get(counter))
    gathered :: call(
        ctx.recorded_array_get(),
        [local_get(source), i64_add(local_get(source_start), local_get(counter))],
    )
    scattered :: call(
        ctx.recorded_array_set(),
        [
            local_get(destination),
            i64_add(local_get(destination_start), local_get(counter)),
            array_get(references, local_get(window), at),
        ],
    )
    body: WasmExpression[]: [
        clamp(count, i64_const(0), .I64LtS),
        clamp(source_start, i64_const(0), .I64LtS),
        clamp(destination_start, i64_const(0), .I64LtS),
        range_check(ctx, source, source_start, count),
        range_check(ctx, destination, destination_start, count),
        when(same_element, alike),
        local_set(window, array_new_default(references, i32_wrap_i64(local_get(count)))),
        repeat(.I64, counter, count, [array_set(references, local_get(window), at, gathered)]),
        repeat(.I64, counter, count, [scattered]),
    ]
    return ctx.define_tree_helper("array.copy", frame, body)
}

// Stop the run when `start + count` passes the length of the array in the local
// `array`.
range_check :: fn(ctx: ModuleCtx, array: i32, start: i32, count: i32) -> WasmExpression {
    end :: i64_add(local_get(start), local_get(count))
    return trap_if(ctx, binary(.I64GtS, end, header_field(ctx.gc, array, HEADER_LENGTH)))
}

// The most elements a storage holds: a position in it is an `i32`.
STORAGE_GREATEST: i64: 0x7FFF_FFFF

// `(value: eqref, type_id: i32) -> i32`: whether the value is an array made as
// `type_id`.
array_is :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["array.is"] else define_is(ctx)

define_is :: fn(ctx: ModuleCtx) -> i32 {
    header :: ctx.gc.array_header
    value :: 0
    type_id :: 1
    frame :: HelperFrame { .signature = func_of([.EqRef, .I32], [.I32]) }
    made_as :: i32_eq(struct_get(header, HEADER_TYPE, local_get(value)), local_get(type_id))
    body: WasmExpression[]: [
        when(ref_test(header, local_get(value)), [return_([made_as])]),
        i32_const(0),
    ]
    return ctx.define_tree_helper("array.is", frame, body)
}

// ---- building blocks ------------------------------------------------------

// Stop the run when the `i64` index in the local `index` is past the length of
// the array in the local `array`.
bounds_check :: fn(ctx: ModuleCtx, array: i32, index: i32) -> WasmExpression {
    length :: header_field(ctx.gc, array, HEADER_LENGTH)
    return trap_if(ctx, binary(.I64GeU, local_get(index), length))
}

// The storage of the array in the local `array`.
storage_in :: fn(gc: GcTypes, array: i32) -> WasmExpression =
    header_field(gc, array, HEADER_STORAGE)

// The position in its storage of the element of the array in the local `array`
// at the `i64` index in the local `index`.
position_in :: fn(gc: GcTypes, array: i32, index: i32) -> WasmExpression =
    i32_add(i32_wrap_i64(local_get(index)), header_field(gc, array, HEADER_OFFSET))

// The field `field` of the header of the array in the local `array` set to
// `value`.
header_set :: fn(gc: GcTypes, array: i32, field: i32, value: WasmExpression) -> WasmExpression =
    struct_set(gc.array_header, field, local_get(array), value)

// The fields of a new header.
HeaderFields :: struct {
    type_id: WasmExpression
    element: WasmExpression
    length: WasmExpression
    capacity: WasmExpression
    offset: WasmExpression = i32_const(0)
    storage: WasmExpression
    shared: WasmExpression = i32_const(0)
}

// The fields of the header of `length` elements of the array type `type_id`, as
// many as `storage` holds.
full_fields :: fn(type_id: i32, access: ElementAccess, length: i64, storage: WasmExpression) =
    HeaderFields {
        .type_id = i32_const(type_id),
        .element = i32_const(element_code(access)),
        .length = i64_const(length),
        .capacity = i64_const(length),
        .storage = storage,
    }

// A new header of `fields`.
new_header :: fn(gc: GcTypes, fields: HeaderFields) -> WasmExpression {
    values: WasmExpression[]: [
        fields.type_id,
        fields.element,
        fields.length,
        fields.capacity,
        fields.offset,
        fields.storage,
        fields.shared,
    ]
    return struct_new(gc.array_header, values)
}

// A new empty array of references, of no type of the bytecode: nothing tests it
// against one.
empty_reference_array :: fn(gc: GcTypes) -> WasmExpression {
    empty :: array_new_fixed(storage_type(gc, .EqRef), [])
    return new_header(gc, full_fields(-1, REFERENCE_ACCESS, 0, empty))
}

// The field `field` of the header of the array in the local `array`.
header_field :: fn(gc: GcTypes, array: i32, field: i32) -> WasmExpression =
    header_get(gc, local_get(array), field)

// The field `field` of the header `array`.
header_get :: fn(gc: GcTypes, array: WasmExpression, field: i32) -> WasmExpression =
    struct_get(gc.array_header, field, array)

// The local `value` set to `bound` when `past` holds between them: `.I64LtS`
// raises an `i64` to the bound, `.I64GtS` lowers it.
clamp :: fn(value: i32, bound: WasmExpression, past: WasmOp) -> WasmExpression =
    when(binary(past, local_get(value), bound), [local_set(value, bound)])

// ---- tests ----------------------------------------------------------------

import "std/testing"

// A program whose `main` runs `body`, over `types`: `i32`, `u8`, `u8[]`, the
// struct `A { x: i32 }`, `A[]`, then a second `u8[]`.
program_over_arrays :: fn(body: Bc.Op[]) -> Bc.BytecodeModule {
    program :: straight(body)
    a :: Bc.BcStruct {
        .name = "A",
        .fields = [Bc.BcField { .name = "x", .type_index = 0 }],
        .c_name = "",
        .symbol_id = -1,
    }
    program.types = [
        Bc.BcScalar { .val = .I32 },
        Bc.BcScalar { .val = .U8 },
        Bc.BcArray { .element = 1 },
        a,
        Bc.BcArray { .element = 3 },
        Bc.BcArray { .element = 1 },
    ]
    return program
}

@test
test_an_array_of_structs_stores_references :: fn() -> void {
    body: Bc.Op[]: [
        Bc.I32Const { .value = 1 },
        Bc.StructNew { .type_id = 3, .stack = false },
        Bc.ArrayNew { .type_id = 4, .length = 1 },
        Bc.Drop {},
        Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } },
    ]
    program :: program_over_arrays(body)
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    made :: wasm.functions[0].body.filter_is<ArrayNewFixed>().collect()
    references :: gc_types_of(program).storages[.EqRef] else -1
    assert(made.len() == 1 && made[0].type_index == references, "an `A[]` stores `eqref`")
}

// `u8[]` read at an `i32` index: the main body, then the read it calls.
u8_read :: fn() -> WasmModule {
    body: Bc.Op[]: [
        Bc.I32Const { .value = 7 },
        Bc.ArrayNew { .type_id = 2, .length = 1 },
        Bc.I32Const { .value = 0 },
        Bc.ArrayGet { .type_id = 2 },
        Bc.Return {},
    ]
    wasm :: wasm_module_of(program_over_arrays(body), "") else panic(wasm.reason)
    return wasm
}

@test
test_a_u8_element_reads_zero_extended :: fn() -> void {
    reads :: u8_read().functions[1].body.filter_is<ArrayGet>().collect()
    assert(reads.len() == 1 && reads[0].extension == .Unsigned, "`array.get_u`")
}

@test
test_an_i32_index_widens_before_an_access :: fn() -> void {
    main :: u8_read().functions[0].body
    // The read is the first call: the array is made by `array.new_fixed`.
    call: i64 = 0
    for main[call] !is Call {
        call += 1
    }
    widened :: main[call - 1]
    assert(widened is Plain && widened.op == .I64ExtendI32S, "the index becomes an `i64`")
}

@test
test_a_pool_array_is_built_once :: fn() -> void {
    body: Bc.Op[]: [
        Bc.DataConst { .pool_index = 0, .type_id = 2 },
        Bc.Drop {},
        Bc.DataConst { .pool_index = 0, .type_id = 2 },
        Bc.Drop {},
        Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } },
    ]
    program :: program_over_arrays(body)
    program.data_pool = [Bc.BcPrimData { .kind = .U8, .items = [1, 2] }]
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    calls :: wasm.functions[0].body.filter_is<Call>().collect()
    assert(wasm.globals.len() == 2, "a global keeps the storage, another the header")
    assert(calls.len() == 2 && calls[0].function_index == calls[1].function_index, "one builder")
}

@test
test_a_pool_read_at_two_types_shares_its_storage :: fn() -> void {
    body: Bc.Op[]: [
        Bc.DataConst { .pool_index = 0, .type_id = 2 },
        Bc.Drop {},
        Bc.DataConst { .pool_index = 0, .type_id = 5 },
        Bc.Drop {},
        Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } },
    ]
    program :: program_over_arrays(body)
    program.data_pool = [Bc.BcPrimData { .kind = .U8, .items = [1, 2] }]
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    assert_eq(wasm.globals.len(), 3)
}

@test
test_a_copy_widens_each_i32_integer :: fn() -> void {
    body: Bc.Op[]: [
        Bc.I32Const { .value = 7 },
        Bc.ArrayNew { .type_id = 2, .length = 1 },
        Bc.I32Const { .value = 0 },
        Bc.I32Const { .value = 7 },
        Bc.ArrayNew { .type_id = 2, .length = 1 },
        Bc.I32Const { .value = 0 },
        Bc.I32Const { .value = 1 },
        Bc.ArrayCopy {},
        Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } },
    ]
    wasm :: wasm_module_of(program_over_arrays(body), "") else panic(wasm.reason)
    plain :: wasm.functions[0].body.filter_is<Plain>().collect()
    widened :: plain.filter((p) -> p.op == .I64ExtendI32S).count()
    assert_eq(widened, 3)
}
