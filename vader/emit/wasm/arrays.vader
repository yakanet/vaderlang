// vader/emit/wasm/arrays: the arrays, as Wasm GC holds them.
//
// Every array is one struct type, the header, whatever its element:
// `{ type_id: i32, element: i32, length: i64, capacity: i64, offset: i32,
// storage: eqref, shared: i32 }`. `type_id` is the bytecode type the array was
// made as, which `is` reads. `storage` is a WASM array that holds the elements
// from `offset` on: one array type per way of storing (`WasmStorageType`), an
// `i8` for a `u8`, an `eqref` for a reference. `element` says which: the
// position of the element's class in `BOXED_CLASSES`, or `REFERENCE_ELEMENT` for
// elements held by reference, boxed scalars included. An access whose element
// type the bytecode erased (a `T[]` in a shared generic instance) reads `element`
// to reach the storage, as the native runtime reads the element kind off the
// buffer.
//
// A slice is a view: a header over the storage of the array it slices. The
// native rule holds (docs/adr/0108, 0122): a header writes in place only the
// slots `[length, capacity)`, which no other header reads. A view is born with
// `capacity == length`, and a header marked `shared` that shrinks sets
// `capacity = length`, so the next push of either copies into a storage of its
// own. Until then a write through either reaches the other, as natively.
//
// The accesses are functions the emitter writes once per way of storing, as
// `checked.vader` does for the checked ops. They check the index against
// `length`, `bounds_safe` or not, and stop the run (`unreachable`) past it.

module "vader/emit/wasm"

Bc :: import "vader/core/bytecode"
import "std/abort"
import "std/collections"
import "std/iter"
import "std/math"

// The fields of the header.
HEADER_TYPE: i32: 0
HEADER_ELEMENT: i32: 1
HEADER_LENGTH: i32: 2
HEADER_CAPACITY: i32: 3
HEADER_OFFSET: i32: 4
HEADER_STORAGE: i32: 5
HEADER_SHARED: i32: 6

// The `element` of an array whose elements are held by reference.
REFERENCE_ELEMENT: i32: -1

// The ways of storing elements, an array type each.
STORAGES: WasmStorageType[]: [.I8, .I16, .I32, .I64, .F32, .F64, .EqRef]

// Add the storage types, then the header, and list the boxed classes `m` makes
// arrays of: an erased access reaches no other.
add_array_types :: fn(gc: GcTypes, m: Bc.BytecodeModule) -> void {
    for storage in STORAGES {
        gc.storages[storage] = gc.add_type(WasmArrayType { .element = storage })
    }
    header: WasmField[]: [
        WasmField { .type = .I32 },
        WasmField { .type = .I32 },
        WasmField { .type = .I64 },
        WasmField { .type = .I64 },
        WasmField { .type = .I32 },
        WasmField { .type = .EqRef },
        WasmField { .type = .I32 },
    ]
    gc.array_header = gc.add(header)
    for class in BOXED_CLASSES {
        if m.types.any_match((t) -> stores_class(m.types, t, class)) {
            gc.array_classes.push(class)
        }
    }
}

// Whether `t` is an array type whose elements are of the class `class`.
stores_class :: fn(types: Bc.BcType[], t: Bc.BcType, class: Bc.ValType) -> bool {
    if t !is Bc.BcArray {
        return false
    }
    return element_access(types, types[t.element]).class == class
}

// How an access reaches the elements of an array.
ElementAccess :: struct {
    /// The boxed class whose storage holds the elements, null for elements held
    /// by reference.
    class: Bc.ValType | null = null
    /// Whether the element type may hold any value, so that an access reads the
    /// `element` the array records.
    recorded: bool = false
}

REFERENCE_ACCESS :: ElementAccess {}
RECORDED_ACCESS  :: ElementAccess { .recorded = true }

// The access to elements of the type `element`. It differs from
// `Bc.array_kind_of`, the native runtime's: a string is an `i32` atom here,
// stored as itself.
element_access :: fn(types: Bc.BcType[], element: Bc.BcType) -> ElementAccess = match element {
    is Bc.BcScalar                        -> scalar_access(element.val)
    is Bc.BcStruct | Bc.BcArray | Bc.BcFn -> REFERENCE_ACCESS
    is Bc.BcUnion                         -> union_access(types, element)
    is Bc.BcRef                           -> RECORDED_ACCESS
}

scalar_access :: fn(v: Bc.ValType) -> ElementAccess = match v {
    .I8 | .I16 | .I32 | .I64 | .U8 | .U16 | .U32 | .U64 | .F32 | .F64 | .Bool | .Char
        | .String -> ElementAccess { .class = v }
    .Null | .Void | .Ref | .Any -> RECORDED_ACCESS
    .Pointer -> REFERENCE_ACCESS
}

// A union of references, `null` among them, holds no scalar.
union_access :: fn(types: Bc.BcType[], u: Bc.BcUnion) -> ElementAccess {
    if Bc.is_ref_only_element(u, types) {
        return REFERENCE_ACCESS
    }
    return RECORDED_ACCESS
}

// The access to the elements of the array type `type_id`.
array_access :: fn(
    ctx: ModuleCtx,
    type_id: i32,
    function: string,
) -> ElementAccess | WasmUnsupported {
    types :: ctx.module.types
    array :: types[type_id]
    if array !is Bc.BcArray {
        return WasmUnsupported { .reason = "`${function}`: type ${type_id} is no array" }
    }
    return element_access(types, types[array.element])
}

// What the header of an array made with `access` records in `element`.
element_code :: fn(access: ElementAccess) -> i32 {
    class :: access.class else return REFERENCE_ELEMENT
    return class_code(class)
}

class_code :: fn(class: Bc.ValType) -> i32 =
    i32(BOXED_CLASSES.index_of(class) else panic("wasm: no box for an array class"))

storage_of_access :: fn(access: ElementAccess) -> WasmStorageType {
    class :: access.class else return .EqRef
    return storage_of(class)
}

// How an array stores a scalar of the boxed class `class`.
storage_of :: fn(class: Bc.ValType) -> WasmStorageType = match class {
    .U8 | .I8 | .Bool                      -> .I8
    .U16 | .I16                            -> .I16
    .I32 | .U32 | .Char | .String          -> .I32
    .I64 | .U64                            -> .I64
    .F32                                   -> .F32
    .F64                                   -> .F64
    .Null | .Void | .Pointer | .Ref | .Any -> .EqRef
}

extension_of :: fn(class: Bc.ValType) -> Extension = match class {
    .U8 | .Bool | .U16 -> .Unsigned
    .I8 | .I16 -> .Signed
    .I32 | .U32 | .Char | .String | .I64 | .U64 | .F32 | .F64 | .Null | .Void | .Pointer | .Ref
        | .Any -> .None
}

// The type a value stored as `storage` has on the stack.
held_of_storage :: fn(storage: WasmStorageType) -> WasmValType = match storage {
    .I8 | .I16 | .I32 -> .I32
    .I64              -> .I64
    .F32              -> .F32
    .F64              -> .F64
    .EqRef            -> .EqRef
}

storage_name :: fn(storage: WasmStorageType) -> string = match storage {
    .I8    -> "i8"
    .I16   -> "i16"
    .I32   -> "i32"
    .I64   -> "i64"
    .F32   -> "f32"
    .F64   -> "f64"
    .EqRef -> "eqref"
}

extension_name :: fn(extension: Extension) -> string = match extension {
    .None     -> ""
    .Signed   -> "_s"
    .Unsigned -> "_u"
}

storage_type :: fn(gc: GcTypes, storage: WasmStorageType) -> i32 =
    gc.storages[storage] else panic("wasm: no array type for a storage")

// The box of the boxed class `class`.
box_of_class :: fn(gc: GcTypes, class: Bc.ValType) -> i32 =
    gc.of_box[class] else panic("wasm: no box for a boxed class")

// ---- ops ------------------------------------------------------------------

// The array ops `push_array_op` translates.
ArrayOp :: Bc.ArrayNew
         | Bc.ArrayReserve
         | Bc.ArrayLen
         | Bc.ArrayClear
         | Bc.ArrayGet
         | Bc.ArraySet
         | Bc.ArrayPush
         | Bc.ArrayRemoveLast
         | Bc.ArraySlice
         | Bc.ArrayRepeat
         | Bc.ArrayPushAll
         | Bc.ArrayCopy
         | Bc.DataConst
         | Bc.LoadSlotI32
         | Bc.LoadSlotI64
         | Bc.LoadSlotF64
         | Bc.StoreSlotI32
         | Bc.StoreSlotI64
         | Bc.StoreSlotF64

// The translation of an array op. `stack` holds the values under it: an index,
// a count or a bound comes as an `i32` or an `i64`, and the helpers take `i64`.
push_array_op :: fn(
    ctx: ModuleCtx,
    scratch: Scratch,
    stack: OperandStack,
    out: WasmInstr[],
    op: ArrayOp,
    function: string,
) -> void | WasmUnsupported {
    gc :: ctx.gc
    widened :: out.push_widened(scratch, stack, integer_depths(op), function)
        else return widened
    match op {
        is Bc.ArrayNew        -> {
            access :: array_access(ctx, op.type_id, function) else return access
            storage :: storage_type(gc, storage_of_access(access))
            out.push(ArrayNewFixed { .type_index = storage, .length = op.length })
            out.push_header(ctx, scratch, op.type_id, access, i64(op.length))
        }
        is Bc.ArrayReserve    -> {
            access :: array_access(ctx, op.type_id, function) else return access
            out.push_all(
                [
                    I32Const { .value = op.type_id },
                    I32Const { .value = element_code(access) },
                    Call { .function_index = ctx.array_reserve(storage_of_access(access)) },
                ],
            )
        }
        is Bc.ArrayLen        -> {
            out.push_all(
                [
                    header_of(gc),
                    StructGet { .type_index = gc.array_header, .field_index = HEADER_LENGTH },
                ],
            )
        }
        is Bc.ArrayClear      -> { out.push(Call { .function_index = ctx.array_clear() }) }
        is Bc.ArrayGet        -> {
            access :: array_access(ctx, op.type_id, function) else return access
            out.push(Call { .function_index = ctx.get_function(access) })
        }
        is Bc.ArraySet        -> {
            access :: array_access(ctx, op.type_id, function) else return access
            out.push(Call { .function_index = ctx.set_function(access) })
        }
        is Bc.ArrayPush       -> {
            // `type_id` is the element's type, not the array's.
            access :: element_access(ctx.module.types, ctx.module.types[op.type_id])
            out.push(Call { .function_index = ctx.push_function(access) })
        }
        is Bc.ArrayRemoveLast -> { out.push(Call { .function_index = ctx.array_remove_last() }) }
        is Bc.ArraySlice      -> {
            out.push_all(
                [I32Const { .value = op.type_id }, Call { .function_index = ctx.array_slice() }],
            )
        }
        is Bc.ArrayRepeat     -> { out.push(Call { .function_index = ctx.array_repeat() }) }
        is Bc.ArrayPushAll    -> { out.push(Call { .function_index = ctx.array_push_all() }) }
        is Bc.ArrayCopy       -> { out.push(Call { .function_index = ctx.array_copy() }) }
        is Bc.DataConst       -> {
            data :: ctx.data_function(op, function) else return data
            out.push(Call { .function_index = data })
        }
        is Bc.LoadSlotI32     -> { out.push(Call { .function_index = ctx.array_get(.I32, .None) }) }
        is Bc.LoadSlotI64     -> { out.push(Call { .function_index = ctx.array_get(.I64, .None) }) }
        is Bc.LoadSlotF64     -> { out.push(Call { .function_index = ctx.array_get(.F64, .None) }) }
        is Bc.StoreSlotI32    -> { out.push(Call { .function_index = ctx.array_set(.I32) }) }
        is Bc.StoreSlotI64    -> { out.push(Call { .function_index = ctx.array_set(.I64) }) }
        is Bc.StoreSlotF64    -> { out.push(Call { .function_index = ctx.array_set(.F64) }) }
    }
}

// Where the integers `op` reads sit, counted from the top of the stack.
integer_depths :: fn(op: ArrayOp) -> i64[] = match op {
    is Bc.ArrayGet | Bc.LoadSlotI32 | Bc.LoadSlotI64 | Bc.LoadSlotF64 | Bc.ArrayReserve
        | Bc.ArrayRepeat -> [0]
    is Bc.ArraySet | Bc.StoreSlotI32 | Bc.StoreSlotI64 | Bc.StoreSlotF64 -> [1]
    is Bc.ArraySlice -> [0, 1]
    is Bc.ArrayCopy -> [0, 1, 3]
    is Bc.ArrayNew | Bc.ArrayLen | Bc.ArrayClear | Bc.ArrayPush | Bc.ArrayRemoveLast
        | Bc.ArrayPushAll | Bc.DataConst -> []
}

// Widen to `i64` each of the integers `depths` values below the top that the
// bytecode pushed as an `i32`. The values above the deepest wait in scratch
// locals meanwhile, each its own.
push_widened :: fn(
    out: WasmInstr[],
    scratch: Scratch,
    stack: OperandStack,
    depths: i64[],
    function: string,
) -> void | WasmUnsupported {
    count :: stack.types.len()
    at :: (depth: i64) -> stack.types[count - 1 - depth]
    deepest: i64 = -1
    for depth in depths {
        if count <= depth {
            return WasmUnsupported { .reason = "`${function}`: an array op finds no integer" }
        }
        if at(depth) == .I32 {
            deepest = max(deepest, depth)
        } else if at(depth) != .I64 {
            return WasmUnsupported { .reason = "`${function}`: an array index is no integer" }
        }
    }
    if deepest < 0 {
        return
    }
    // The value at `depth` waits in the local of its type past those of the
    // values above it.
    kept: i32[]: []
    for depth in 0..<deepest {
        above :: (0..<depth).filter((d) -> at(d) == at(depth)).count()
        kept.push(scratch.spill_local(at(depth), above))
        out.push(LocalSet { .index = kept[depth] })
    }
    out.push(Plain { .op = .I64ExtendI32S })
    for back in 0..<deepest {
        depth :: deepest - 1 - back
        out.push(LocalGet { .index = kept[depth] })
        if depth in depths && at(depth) == .I32 {
            out.push(Plain { .op = .I64ExtendI32S })
        }
    }
}

// The header of a new array of `length` elements, of the type `type_id`, its
// storage on the stack.
push_header :: fn(
    out: WasmInstr[],
    ctx: ModuleCtx,
    scratch: Scratch,
    type_id: i32,
    access: ElementAccess,
    length: i64,
) -> void {
    storage :: scratch.local_of(.EqRef)
    out.push(LocalSet { .index = storage })
    out.push_new_header(
        ctx.gc,
        full_header(type_id, access, length, [LocalGet { .index = storage }]),
    )
}

// A header, each field what its instructions leave.
HeaderParts :: struct {
    type_id: WasmInstr[]
    element: WasmInstr[]
    length: WasmInstr[]
    capacity: WasmInstr[]
    offset: WasmInstr[] = [I32Const { .value = 0 }]
    storage: WasmInstr[]
    shared: WasmInstr[] = [I32Const { .value = 0 }]
}

// The header of `length` elements of the array type `type_id`, as many as its
// storage holds.
full_header :: fn(
    type_id: i32,
    access: ElementAccess,
    length: i64,
    storage: WasmInstr[],
) = HeaderParts {
    .type_id = [I32Const { .value = type_id }],
    .element = [I32Const { .value = element_code(access) }],
    .length = [I64Const { .value = length }],
    .capacity = [I64Const { .value = length }],
    .storage = storage,
}

push_new_header :: fn(body: WasmInstr[], gc: GcTypes, parts: HeaderParts) -> void {
    for field in [
        parts.type_id,
        parts.element,
        parts.length,
        parts.capacity,
        parts.offset,
        parts.storage,
        parts.shared,
    ] {
        body.push_all(field)
    }
    body.push(StructNew { .type_index = gc.array_header })
}

// The function reading an element through `access`.
get_function :: fn(ctx: ModuleCtx, access: ElementAccess) -> i32 {
    if access.recorded {
        return ctx.recorded_array_get()
    }
    class :: access.class else return ctx.array_get(.EqRef, .None)
    return ctx.array_get(storage_of(class), extension_of(class))
}

// The function writing an element through `access`.
set_function :: fn(ctx: ModuleCtx, access: ElementAccess) -> i32 {
    if access.recorded {
        return ctx.recorded_array_set()
    }
    return ctx.array_set(storage_of_access(access))
}

// The function appending an element through `access`.
push_function :: fn(ctx: ModuleCtx, access: ElementAccess) -> i32 {
    if access.recorded {
        return ctx.recorded_array_push()
    }
    return ctx.array_push(storage_of_access(access))
}

// The header of the array on the stack, cast.
header_of :: fn(gc: GcTypes) -> WasmInstr = RefCast { .type_index = gc.array_header }

// ---- typed helpers --------------------------------------------------------

// `(array, index: i64) -> element`, stored as `storage`, read as `extension`.
array_get :: fn(ctx: ModuleCtx, storage: WasmStorageType, extension: Extension) -> i32 {
    key :: "array.get.${storage_name(storage)}${extension_name(extension)}"
    signature :: WasmFuncType { .params = [.EqRef, .I64], .results = [held_of_storage(storage)] }
    return ctx.helpers[key]
        else ctx.define_helper(key, signature, [], get_body(ctx.gc, storage, extension))
}

get_body :: fn(gc: GcTypes, storage: WasmStorageType, extension: Extension) -> WasmInstr[] {
    storage_index :: storage_type(gc, storage)
    body: WasmInstr[]: []
    body.push_bounds_check(gc)
    body.push_storage(gc, 0, storage_index)
    body.push_position(gc, 0, 1)
    body.push(ArrayGet { .type_index = storage_index, .extension = extension })
    return body
}

// `(array, index: i64, element) -> ()`, stored as `storage`.
array_set :: fn(ctx: ModuleCtx, storage: WasmStorageType) -> i32 {
    key :: "array.set.${storage_name(storage)}"
    signature :: WasmFuncType {
        .params = [.EqRef, .I64, held_of_storage(storage)],
        .results = [],
    }
    return ctx.helpers[key] else ctx.define_helper(key, signature, [], set_body(ctx.gc, storage))
}

set_body :: fn(gc: GcTypes, storage: WasmStorageType) -> WasmInstr[] {
    storage_index :: storage_type(gc, storage)
    body: WasmInstr[]: []
    body.push_bounds_check(gc)
    body.push_storage(gc, 0, storage_index)
    body.push_position(gc, 0, 1)
    body.push_all([LocalGet { .index = 2 }, ArraySet { .type_index = storage_index }])
    return body
}

// `(array, element) -> ()`, stored as `storage`.
array_push :: fn(ctx: ModuleCtx, storage: WasmStorageType) -> i32 {
    key :: "array.push.${storage_name(storage)}"
    signature :: WasmFuncType { .params = [.EqRef, held_of_storage(storage)], .results = [] }
    return ctx.helpers[key]
        else ctx.define_helper(key, signature, [.I64, .I32, .EqRef], push_body(ctx.gc, storage))
}

// The locals of `array.push` past its parameters.
PUSH_LENGTH: i32: 2
PUSH_CAPACITY: i32: 3
PUSH_GROWN: i32: 4

push_body :: fn(gc: GcTypes, storage: WasmStorageType) -> WasmInstr[] {
    storage_index :: storage_type(gc, storage)
    body: WasmInstr[]: []
    body.push_header_field(gc, 0, HEADER_LENGTH)
    body.push(LocalSet { .index = PUSH_LENGTH })
    body.push_grow_if_full(gc, storage_index)
    body.push_storage(gc, 0, storage_index)
    body.push_position(gc, 0, PUSH_LENGTH)
    body.push_all([LocalGet { .index = 1 }, ArraySet { .type_index = storage_index }])
    body.push_set_field(
        gc,
        0,
        HEADER_LENGTH,
        [LocalGet { .index = PUSH_LENGTH }, I64Const { .value = 1 }, Plain { .op = .I64Add }],
    )
    return body
}

// When the length reaches the capacity, a storage of its own, twice as large and
// four elements at least, takes the place of the one the header reads, its
// elements copied.
push_grow_if_full :: fn(body: WasmInstr[], gc: GcTypes, storage_index: i32) -> void {
    body.push_header_field(gc, 0, HEADER_CAPACITY)
    body.push_all(
        [
            LocalGet { .index = PUSH_LENGTH },
            Plain { .op = .I64Eq },
            Plain { .op = .If },
            LocalGet { .index = PUSH_LENGTH },
            Plain { .op = .I32WrapI64 },
            I32Const { .value = 1 },
            Plain { .op = .I32Shl },
            LocalSet { .index = PUSH_CAPACITY },
            LocalGet { .index = PUSH_CAPACITY },
            I32Const { .value = 4 },
            Plain { .op = .I32LtU },
            Plain { .op = .If },
            I32Const { .value = 4 },
            LocalSet { .index = PUSH_CAPACITY },
            Plain { .op = .End },
            LocalGet { .index = PUSH_CAPACITY },
            ArrayNewDefault { .type_index = storage_index },
            LocalSet { .index = PUSH_GROWN },
            LocalGet { .index = PUSH_GROWN },
            RefCast { .type_index = storage_index },
            I32Const { .value = 0 },
        ],
    )
    body.push_storage(gc, 0, storage_index)
    body.push_header_field(gc, 0, HEADER_OFFSET)
    body.push_all(
        [
            LocalGet { .index = PUSH_LENGTH },
            Plain { .op = .I32WrapI64 },
            ArrayCopy { .destination = storage_index, .source = storage_index },
        ],
    )
    body.push_set_field(gc, 0, HEADER_STORAGE, [LocalGet { .index = PUSH_GROWN }])
    body.push_set_field(gc, 0, HEADER_OFFSET, [I32Const { .value = 0 }])
    body.push_set_field(
        gc,
        0,
        HEADER_CAPACITY,
        [LocalGet { .index = PUSH_CAPACITY }, Plain { .op = .I64ExtendI32U }],
    )
    body.push_set_field(gc, 0, HEADER_SHARED, [I32Const { .value = 0 }])
    body.push(Plain { .op = .End })
}

// `(count: i64, type_id: i32, element: i32) -> array`: an empty array with room
// for `count` elements stored as `storage`; none for a negative count.
array_reserve :: fn(ctx: ModuleCtx, storage: WasmStorageType) -> i32 {
    key :: "array.reserve.${storage_name(storage)}"
    signature :: WasmFuncType { .params = [.I64, .I32, .I32], .results = [.EqRef] }
    return ctx.helpers[key]
        else ctx.define_helper(key, signature, [], reserve_body(ctx.gc, storage))
}

reserve_body :: fn(gc: GcTypes, storage: WasmStorageType) -> WasmInstr[] {
    count :: 0
    body: WasmInstr[]: []
    body.push_clamp(count, I64Const { .value = 0 }, .I64LtS)
    header :: HeaderParts {
        .type_id = [LocalGet { .index = 1 }],
        .element = [LocalGet { .index = 2 }],
        .length = [I64Const { .value = 0 }],
        .capacity = [LocalGet { .index = count }],
        .storage = [
            LocalGet { .index = count },
            Plain { .op = .I32WrapI64 },
            ArrayNewDefault { .type_index = storage_type(gc, storage) },
        ],
    }
    body.push_new_header(gc, header)
    return body
}

// ---- recorded helpers -----------------------------------------------------

// `(array, index: i64) -> eqref` through the `element` the array records: a
// scalar comes out boxed.
recorded_array_get :: fn(ctx: ModuleCtx) -> i32 {
    signature :: WasmFuncType { .params = [.EqRef, .I64], .results = [.EqRef] }
    read :: fn(class: Bc.ValType) {
        typed :: ctx.array_get(storage_of(class), extension_of(class))
        out: WasmInstr[]: [
            LocalGet { .index = 0 },
            LocalGet { .index = 1 },
            Call { .function_index = typed },
            StructNew { .type_index = box_of_class(ctx.gc, class) },
        ]
        out
    }
    return ctx.helpers["array.get.recorded"]
        else ctx.define_helper(
            "array.get.recorded",
            signature,
            [.I32],
            recorded_body(ctx, 2, read, ctx.array_get(.EqRef, .None)),
        )
}

// `(array, index: i64, element: eqref) -> ()` through the `element` the array
// records: a scalar goes in unboxed.
recorded_array_set :: fn(ctx: ModuleCtx) -> i32 {
    signature :: WasmFuncType { .params = [.EqRef, .I64, .EqRef], .results = [] }
    write :: fn(class: Bc.ValType) {
        out: WasmInstr[]: [
            LocalGet { .index = 0 },
            LocalGet { .index = 1 },
            LocalGet { .index = 2 },
        ]
        out.push_all(unboxed(box_of_class(ctx.gc, class)))
        out.push(Call { .function_index = ctx.array_set(storage_of(class)) })
        out
    }
    return ctx.helpers["array.set.recorded"]
        else ctx.define_helper(
            "array.set.recorded",
            signature,
            [.I32],
            recorded_body(ctx, 3, write, ctx.array_set(.EqRef)),
        )
}

// `(array, element: eqref) -> ()` through the `element` the array records.
recorded_array_push :: fn(ctx: ModuleCtx) -> i32 {
    signature :: WasmFuncType { .params = [.EqRef, .EqRef], .results = [] }
    append :: fn(class: Bc.ValType) {
        out: WasmInstr[]: [LocalGet { .index = 0 }, LocalGet { .index = 1 }]
        out.push_all(unboxed(box_of_class(ctx.gc, class)))
        out.push(Call { .function_index = ctx.array_push(storage_of(class)) })
        out
    }
    return ctx.helpers["array.push.recorded"]
        else ctx.define_helper(
            "array.push.recorded",
            signature,
            [.I32],
            recorded_body(ctx, 2, append, ctx.array_push(.EqRef)),
        )
}

// The body of an access through the `element` the array records, kept in the
// local `element`, the first past the parameters: one branch per class the
// module makes arrays of, `typed` its instructions, then `references`, the
// access to an array of references, which takes the parameters as they are.
// An `element` that names neither stops the run.
recorded_body :: fn(
    ctx: ModuleCtx,
    element: i32,
    typed: fn(Bc.ValType) -> WasmInstr[],
    references: i32,
) -> WasmInstr[] {
    body: WasmInstr[]: []
    body.push_header_field(ctx.gc, 0, HEADER_ELEMENT)
    body.push(LocalSet { .index = element })
    for class in ctx.gc.array_classes {
        body.push_if_element(element, class_code(class))
        body.push_all(typed(class))
        body.push_all([Plain { .op = .Return }, Plain { .op = .End }])
    }
    body.push_all(
        [
            LocalGet { .index = element },
            I32Const { .value = REFERENCE_ELEMENT },
            Plain { .op = .I32Ne },
        ],
    )
    body.push_trap_if()
    for parameter in 0..<element {
        body.push(LocalGet { .index = parameter })
    }
    body.push(Call { .function_index = references })
    return body
}

// ---- whole-array helpers --------------------------------------------------

// `(array) -> eqref`: the last element, boxed, taken off; null on an empty
// array.
array_remove_last :: fn(ctx: ModuleCtx) -> i32 {
    signature :: WasmFuncType { .params = [.EqRef], .results = [.EqRef] }
    return ctx.helpers["array.remove_last"]
        else ctx.define_helper(
            "array.remove_last",
            signature,
            [.I64, .EqRef],
            remove_last_body(ctx),
        )
}

// The locals past the parameter: the length, the element taken off.
remove_last_body :: fn(ctx: ModuleCtx) -> WasmInstr[] {
    gc :: ctx.gc
    read :: ctx.recorded_array_get()
    length :: 1
    last :: 2
    body: WasmInstr[]: []
    body.push_header_field(gc, 0, HEADER_LENGTH)
    body.push_all(
        [
            LocalTee { .index = length },
            Plain { .op = .I64Eqz },
            Plain { .op = .If },
            RefNull {},
            Plain { .op = .Return },
            Plain { .op = .End },
            LocalGet { .index = 0 },
            LocalGet { .index = length },
            I64Const { .value = 1 },
            Plain { .op = .I64Sub },
            Call { .function_index = read },
            LocalSet { .index = last },
        ],
    )
    body.push_set_field(
        gc,
        0,
        HEADER_LENGTH,
        [LocalGet { .index = length }, I64Const { .value = 1 }, Plain { .op = .I64Sub }],
    )
    body.push_shrunk(gc)
    body.push(LocalGet { .index = last })
    return body
}

// `(array) -> ()`: the length set to zero, the storage kept.
array_clear :: fn(ctx: ModuleCtx) -> i32 {
    signature :: WasmFuncType { .params = [.EqRef], .results = [] }
    return ctx.helpers["array.clear"]
        else ctx.define_helper("array.clear", signature, [], clear_body(ctx.gc))
}

clear_body :: fn(gc: GcTypes) -> WasmInstr[] {
    body: WasmInstr[]: []
    body.push_set_field(gc, 0, HEADER_LENGTH, [I64Const { .value = 0 }])
    body.push_shrunk(gc)
    return body
}

// A header marked `shared` that shrank keeps no room: its next push copies.
push_shrunk :: fn(body: WasmInstr[], gc: GcTypes) -> void {
    body.push_header_field(gc, 0, HEADER_SHARED)
    body.push(Plain { .op = .If })
    length: WasmInstr[]: []
    length.push_header_field(gc, 0, HEADER_LENGTH)
    body.push_set_field(gc, 0, HEADER_CAPACITY, length)
    body.push(Plain { .op = .End })
}

// `(array, lo: i64, hi: i64, type_id: i32) -> array`: a view on the elements
// `lo..<hi`, the bounds clamped to the array.
array_slice :: fn(ctx: ModuleCtx) -> i32 {
    signature :: WasmFuncType { .params = [.EqRef, .I64, .I64, .I32], .results = [.EqRef] }
    return ctx.helpers["array.slice"]
        else ctx.define_helper("array.slice", signature, [.I64], slice_body(ctx.gc))
}

// The local past the parameters: the length of the array sliced. `hi` becomes
// the length of the view.
slice_body :: fn(gc: GcTypes) -> WasmInstr[] {
    lo :: 1
    hi :: 2
    type_id :: 3
    length :: 4
    body: WasmInstr[]: []
    body.push_header_field(gc, 0, HEADER_LENGTH)
    body.push(LocalSet { .index = length })
    body.push_clamp(lo, I64Const { .value = 0 }, .I64LtS)
    body.push_clamp(lo, LocalGet { .index = length }, .I64GtS)
    body.push_clamp(hi, LocalGet { .index = lo }, .I64LtS)
    body.push_clamp(hi, LocalGet { .index = length }, .I64GtS)
    body.push_all(
        [
            LocalGet { .index = hi },
            LocalGet { .index = lo },
            Plain { .op = .I64Sub },
            LocalSet { .index = hi },
        ],
    )
    body.push_set_field(gc, 0, HEADER_SHARED, [I32Const { .value = 1 }])
    offset: WasmInstr[]: []
    offset.push_position(gc, 0, lo)
    view :: HeaderParts {
        .type_id = [LocalGet { .index = type_id }],
        .element = header_field(gc, 0, HEADER_ELEMENT),
        .length = [LocalGet { .index = hi }],
        .capacity = [LocalGet { .index = hi }],
        .offset = offset,
        .storage = header_field(gc, 0, HEADER_STORAGE),
        .shared = [I32Const { .value = 1 }],
    }
    body.push_new_header(gc, view)
    return body
}

// `(destination, source) -> ()`: each element of `source` pushed onto
// `destination`, through the elements both record.
array_push_all :: fn(ctx: ModuleCtx) -> i32 {
    signature :: WasmFuncType { .params = [.EqRef, .EqRef], .results = [] }
    return ctx.helpers["array.push_all"]
        else ctx.define_helper("array.push_all", signature, [.I64, .I64], push_all_body(ctx))
}

// The locals past the parameters: the length of the source, the counter.
push_all_body :: fn(ctx: ModuleCtx) -> WasmInstr[] {
    count :: 2
    counter :: 3
    body: WasmInstr[]: []
    body.push_header_field(ctx.gc, 1, HEADER_LENGTH)
    body.push(LocalSet { .index = count })
    each: WasmInstr[]: [
        LocalGet { .index = 0 },
        LocalGet { .index = 1 },
        LocalGet { .index = counter },
        Call { .function_index = ctx.recorded_array_get() },
        Call { .function_index = ctx.recorded_array_push() },
    ]
    body.push_counted_loop(.I64, counter, count, each)
    return body
}

// `(array, count: i64) -> array`: the elements of the array `count` times, in a
// fresh array of its type; none for a negative count.
array_repeat :: fn(ctx: ModuleCtx) -> i32 {
    signature :: WasmFuncType { .params = [.EqRef, .I64], .results = [.EqRef] }
    return ctx.helpers["array.repeat"]
        else ctx.define_helper(
            "array.repeat",
            signature,
            [.EqRef, .I64, .I64, .EqRef],
            repeat_body(ctx),
        )
}

// The locals past the parameters: the result, the counter, its capacity, its
// storage. An empty array repeats to an empty one however large the count; a
// result past `STORAGE_GREATEST` elements stops the run.
repeat_body :: fn(ctx: ModuleCtx) -> WasmInstr[] {
    gc :: ctx.gc
    count :: 1
    result :: 2
    counter :: 3
    capacity :: 4
    storage :: 5
    body: WasmInstr[]: []
    body.push_clamp(count, I64Const { .value = 0 }, .I64LtS)
    body.push_header_field(gc, 0, HEADER_LENGTH)
    body.push_all(
        [
            Plain { .op = .I64Eqz },
            Plain { .op = .If },
            I64Const { .value = 0 },
            LocalSet { .index = count },
            Plain { .op = .End },
            LocalGet { .index = count },
            I64Const { .value = STORAGE_GREATEST },
            Plain { .op = .I64GtS },
        ],
    )
    body.push_trap_if()
    body.push(LocalGet { .index = count })
    body.push_header_field(gc, 0, HEADER_LENGTH)
    body.push_all(
        [
            Plain { .op = .I64Mul },
            LocalTee { .index = capacity },
            I64Const { .value = STORAGE_GREATEST },
            Plain { .op = .I64GtS },
        ],
    )
    body.push_trap_if()
    body.push_storage_like(ctx, capacity, storage)
    header :: HeaderParts {
        .type_id = header_field(gc, 0, HEADER_TYPE),
        .element = header_field(gc, 0, HEADER_ELEMENT),
        .length = [I64Const { .value = 0 }],
        .capacity = [LocalGet { .index = capacity }],
        .storage = [LocalGet { .index = storage }],
    }
    body.push_new_header(gc, header)
    body.push(LocalSet { .index = result })
    each: WasmInstr[]: [
        LocalGet { .index = result },
        LocalGet { .index = 0 },
        Call { .function_index = ctx.array_push_all() },
    ]
    body.push_counted_loop(.I64, counter, count, each)
    body.push(LocalGet { .index = result })
    return body
}

// A storage of as many elements as the `i64` in the local `capacity`, stored as
// the array in local 0 stores its own, kept in the local `into`.
push_storage_like :: fn(body: WasmInstr[], ctx: ModuleCtx, capacity: i32, into: i32) -> void {
    gc :: ctx.gc
    body.push(Plain { .op = .Block })
    for class in gc.array_classes {
        body.push_header_field(gc, 0, HEADER_ELEMENT)
        body.push_all([I32Const { .value = class_code(class) }, Plain { .op = .I32Eq }])
        body.push(Plain { .op = .If })
        body.push_all(new_storage_into(gc, storage_of(class), capacity, into))
        body.push_all([Br { .depth = 1 }, Plain { .op = .End }])
    }
    body.push_all(new_storage_into(gc, .EqRef, capacity, into))
    body.push(Plain { .op = .End })
}

new_storage_into :: fn(
    gc: GcTypes,
    storage: WasmStorageType,
    capacity: i32,
    into: i32,
) -> WasmInstr[] = [
    LocalGet { .index = capacity },
    Plain { .op = .I32WrapI64 },
    ArrayNewDefault { .type_index = storage_type(gc, storage) },
    LocalSet { .index = into },
]

// `(source, source_start: i64, destination, destination_start: i64, count: i64)
// -> ()`: `count` elements copied in place, the two ranges free to overlap; a
// range past the end of its array stops the run.
array_copy :: fn(ctx: ModuleCtx) -> i32 {
    signature :: WasmFuncType {
        .params = [.EqRef, .I64, .EqRef, .I64, .I64],
        .results = [],
    }
    return ctx.helpers["array.copy"]
        else ctx.define_helper("array.copy", signature, [.EqRef, .I64, .I32], copy_body(ctx))
}

// The locals past the parameters: the elements on their way, the counter, the
// `element` of the source. Two arrays that store alike copy with one
// `array.copy`, which allows the overlap; others go through boxes, all gathered
// before any is written.
copy_body :: fn(ctx: ModuleCtx) -> WasmInstr[] {
    gc :: ctx.gc
    source :: 0
    source_start :: 1
    destination :: 2
    destination_start :: 3
    count :: 4
    window :: 5
    counter :: 6
    element :: 7
    references :: storage_type(gc, .EqRef)
    copy_as :: fn(storage: WasmStorageType) {
        storage_index :: storage_type(gc, storage)
        out: WasmInstr[]: []
        out.push_storage(gc, destination, storage_index)
        out.push_position(gc, destination, destination_start)
        out.push_storage(gc, source, storage_index)
        out.push_position(gc, source, source_start)
        out.push_all(
            [
                LocalGet { .index = count },
                Plain { .op = .I32WrapI64 },
                ArrayCopy { .destination = storage_index, .source = storage_index },
                Plain { .op = .Return },
            ],
        )
        out
    }
    body: WasmInstr[]: []
    for local in [count, source_start, destination_start] {
        body.push_clamp(local, I64Const { .value = 0 }, .I64LtS)
    }
    body.push_range_check(gc, source, source_start, count)
    body.push_range_check(gc, destination, destination_start, count)
    body.push_header_field(gc, source, HEADER_ELEMENT)
    body.push(LocalTee { .index = element })
    body.push_header_field(gc, destination, HEADER_ELEMENT)
    body.push_all([Plain { .op = .I32Eq }, Plain { .op = .If }])
    for class in gc.array_classes {
        body.push_if_element(element, class_code(class))
        body.push_all(copy_as(storage_of(class)))
        body.push(Plain { .op = .End })
    }
    body.push_all(copy_as(.EqRef))
    body.push(Plain { .op = .End })
    body.push_all(
        [
            LocalGet { .index = count },
            Plain { .op = .I32WrapI64 },
            ArrayNewDefault { .type_index = references },
            LocalSet { .index = window },
        ],
    )
    gather: WasmInstr[]: [
        LocalGet { .index = window },
        RefCast { .type_index = references },
        LocalGet { .index = counter },
        Plain { .op = .I32WrapI64 },
        LocalGet { .index = source },
        LocalGet { .index = source_start },
        LocalGet { .index = counter },
        Plain { .op = .I64Add },
        Call { .function_index = ctx.recorded_array_get() },
        ArraySet { .type_index = references },
    ]
    body.push_counted_loop(.I64, counter, count, gather)
    scatter: WasmInstr[]: [
        LocalGet { .index = destination },
        LocalGet { .index = destination_start },
        LocalGet { .index = counter },
        Plain { .op = .I64Add },
        LocalGet { .index = window },
        RefCast { .type_index = references },
        LocalGet { .index = counter },
        Plain { .op = .I32WrapI64 },
        ArrayGet { .type_index = references, .extension = .None },
        Call { .function_index = ctx.recorded_array_set() },
    ]
    body.push_counted_loop(.I64, counter, count, scatter)
    return body
}

// `if start + count > length { unreachable }`, the array in the local `array`.
push_range_check :: fn(body: WasmInstr[], gc: GcTypes, array: i32, start: i32, count: i32) -> void {
    body.push_all(
        [LocalGet { .index = start }, LocalGet { .index = count }, Plain { .op = .I64Add }],
    )
    body.push_header_field(gc, array, HEADER_LENGTH)
    body.push(Plain { .op = .I64GtS })
    body.push_trap_if()
}

// The most elements a storage holds: a position in it is an `i32`.
STORAGE_GREATEST: i64: 0x7FFF_FFFF

// `(value: eqref, type_id: i32) -> i32`: whether the value is an array made as
// `type_id`.
array_is :: fn(ctx: ModuleCtx) -> i32 {
    signature :: WasmFuncType { .params = [.EqRef, .I32], .results = [.I32] }
    return ctx.helpers["array.is"]
        else ctx.define_helper("array.is", signature, [], is_body(ctx.gc.array_header))
}

is_body :: fn(header: i32) -> WasmInstr[] = [
    LocalGet { .index = 0 },
    RefTest { .type_index = header },
    Plain { .op = .If },
    LocalGet { .index = 0 },
    RefCast { .type_index = header },
    StructGet { .type_index = header, .field_index = HEADER_TYPE },
    LocalGet { .index = 1 },
    Plain { .op = .I32Eq },
    Plain { .op = .Return },
    Plain { .op = .End },
    I32Const { .value = 0 },
]

// ---- building blocks ------------------------------------------------------

// `if index >= length { unreachable }`, the array in local 0, the index in 1.
push_bounds_check :: fn(body: WasmInstr[], gc: GcTypes) -> void {
    body.push(LocalGet { .index = 1 })
    body.push_header_field(gc, 0, HEADER_LENGTH)
    body.push(Plain { .op = .I64GeU })
    body.push_trap_if()
}

// The field `field` of the header of the array in the local `array`.
header_field :: fn(gc: GcTypes, array: i32, field: i32) -> WasmInstr[] = [
    LocalGet { .index = array },
    header_of(gc),
    StructGet { .type_index = gc.array_header, .field_index = field },
]

push_header_field :: fn(body: WasmInstr[], gc: GcTypes, array: i32, field: i32) -> void =
    body.push_all(header_field(gc, array, field))

// Set the field `field` of the header of the array in the local `array` to what
// `value` leaves.
push_set_field :: fn(
    body: WasmInstr[],
    gc: GcTypes,
    array: i32,
    field: i32,
    value: WasmInstr[],
) -> void {
    body.push_all([LocalGet { .index = array }, header_of(gc)])
    body.push_all(value)
    body.push(StructSet { .type_index = gc.array_header, .field_index = field })
}

// The storage of the array in the local `array`, cast to its array type.
push_storage :: fn(body: WasmInstr[], gc: GcTypes, array: i32, storage_index: i32) -> void {
    body.push_header_field(gc, array, HEADER_STORAGE)
    body.push(RefCast { .type_index = storage_index })
}

// The position in its storage of the element of the array in the local `array`
// at the `i64` index in the local `index`.
push_position :: fn(body: WasmInstr[], gc: GcTypes, array: i32, index: i32) -> void {
    body.push_all([LocalGet { .index = index }, Plain { .op = .I32WrapI64 }])
    body.push_header_field(gc, array, HEADER_OFFSET)
    body.push(Plain { .op = .I32Add })
}

// `if element == code {`, the element in the local `element`.
push_if_element :: fn(body: WasmInstr[], element: i32, code: i32) -> void = body.push_all(
    [
        LocalGet { .index = element },
        I32Const { .value = code },
        Plain { .op = .I32Eq },
        Plain { .op = .If },
    ],
)

// The `i64` in the local `value` set to the `i64` `bound` leaves when `past`
// holds between them: `.I64LtS` raises the value to the bound, `.I64GtS`
// lowers it.
push_clamp :: fn(body: WasmInstr[], value: i32, bound: WasmInstr, past: WasmOp) -> void =
    body.push_all(
        [
            LocalGet { .index = value },
            bound,
            Plain { .op = past },
            Plain { .op = .If },
            bound,
            LocalSet { .index = value },
            Plain { .op = .End },
        ],
    )

// `for counter in 0..<limit { each }`, both locals of the integer type `t`;
// `each` leaves nothing and branches nowhere, or returns.
push_counted_loop :: fn(
    body: WasmInstr[],
    t: WasmValType,
    counter: i32,
    limit: i32,
    each: WasmInstr[],
) -> void {
    body.push_all([integer_of(t, 0), LocalSet { .index = counter }])
    step: WasmInstr[]: [
        LocalGet { .index = counter },
        integer_of(t, 1),
        Plain { .op = if t == .I64 { .I64Add } else { .I32Add } },
        LocalSet { .index = counter },
    ]
    body.push_while_below(t, counter, limit, each + step)
}

// `for x < limit { each }`, both locals of the integer type `t`: `each` moves
// `x` on, leaves nothing and branches nowhere, or returns.
push_while_below :: fn(
    body: WasmInstr[],
    t: WasmValType,
    x: i32,
    limit: i32,
    each: WasmInstr[],
) -> void {
    body.push_all(
        [
            Plain { .op = .Block },
            Plain { .op = .Loop },
            LocalGet { .index = x },
            LocalGet { .index = limit },
            Plain { .op = if t == .I64 { .I64GeS } else { .I32GeS } },
            BrIf { .depth = 1 },
        ],
    )
    body.push_all(each)
    body.push_all([Br { .depth = 0 }, Plain { .op = .End }, Plain { .op = .End }])
}

// The constant `value` of the integer type `t`.
integer_of :: fn(t: WasmValType, value: i32) -> WasmInstr {
    if t == .I64 {
        return I64Const { .value = i64(value) }
    }
    return I32Const { .value = value }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

// A program whose `main` runs `body`, over `types`: `i32`, `u8`, `u8[]`, the
// struct `A { x: i32 }`, `A[]`, then a second `u8[]`.
program_over_arrays :: fn(body: Bc.Op[]) -> Bc.BytecodeModule {
    program :: straight(body)
    a :: Bc.BcStruct {
        .name = "A",
        .fields = [Bc.BcField { .name = "x", .type_index = 0 }],
        .c_name = "",
        .symbol_id = -1,
    }
    program.types = [
        Bc.BcScalar { .val = .I32 },
        Bc.BcScalar { .val = .U8 },
        Bc.BcArray { .element = 1 },
        a,
        Bc.BcArray { .element = 3 },
        Bc.BcArray { .element = 1 },
    ]
    return program
}

@test
test_an_array_of_structs_stores_references :: fn() -> void {
    body: Bc.Op[]: [
        Bc.I32Const { .value = 1 },
        Bc.StructNew { .type_id = 3, .stack = false },
        Bc.ArrayNew { .type_id = 4, .length = 1 },
        Bc.Drop {},
        Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } },
    ]
    program :: program_over_arrays(body)
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    made :: wasm.functions[0].body.filter_is<ArrayNewFixed>().collect()
    references :: gc_types_of(program).storages[.EqRef] else -1
    assert(made.len() == 1 && made[0].type_index == references, "an `A[]` stores `eqref`")
}

// `u8[]` read at an `i32` index: the main body, then the read it calls.
u8_read :: fn() -> WasmModule {
    body: Bc.Op[]: [
        Bc.I32Const { .value = 7 },
        Bc.ArrayNew { .type_id = 2, .length = 1 },
        Bc.I32Const { .value = 0 },
        Bc.ArrayGet { .type_id = 2 },
        Bc.Return {},
    ]
    wasm :: wasm_module_of(program_over_arrays(body), "") else panic(wasm.reason)
    return wasm
}

@test
test_a_u8_element_reads_zero_extended :: fn() -> void {
    reads :: u8_read().functions[1].body.filter_is<ArrayGet>().collect()
    assert(reads.len() == 1 && reads[0].extension == .Unsigned, "`array.get_u`")
}

@test
test_an_i32_index_widens_before_an_access :: fn() -> void {
    main :: u8_read().functions[0].body
    // The read is the first call: the array is made by `array.new_fixed`.
    call: i64 = 0
    for main[call] !is Call {
        call += 1
    }
    widened :: main[call - 1]
    assert(widened is Plain && widened.op == .I64ExtendI32S, "the index becomes an `i64`")
}

@test
test_a_pool_array_is_built_once :: fn() -> void {
    body: Bc.Op[]: [
        Bc.DataConst { .pool_index = 0, .type_id = 2 },
        Bc.Drop {},
        Bc.DataConst { .pool_index = 0, .type_id = 2 },
        Bc.Drop {},
        Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } },
    ]
    program :: program_over_arrays(body)
    program.data_pool = [Bc.BcPrimData { .kind = .U8, .items = [1, 2] }]
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    calls :: wasm.functions[0].body.filter_is<Call>().collect()
    assert(wasm.globals.len() == 2, "a global keeps the storage, another the header")
    assert(calls.len() == 2 && calls[0].function_index == calls[1].function_index, "one builder")
}

@test
test_a_pool_read_at_two_types_shares_its_storage :: fn() -> void {
    body: Bc.Op[]: [
        Bc.DataConst { .pool_index = 0, .type_id = 2 },
        Bc.Drop {},
        Bc.DataConst { .pool_index = 0, .type_id = 5 },
        Bc.Drop {},
        Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } },
    ]
    program :: program_over_arrays(body)
    program.data_pool = [Bc.BcPrimData { .kind = .U8, .items = [1, 2] }]
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    assert_eq(wasm.globals.len(), 3)
}

@test
test_a_copy_widens_each_i32_integer :: fn() -> void {
    body: Bc.Op[]: [
        Bc.I32Const { .value = 7 },
        Bc.ArrayNew { .type_id = 2, .length = 1 },
        Bc.I32Const { .value = 0 },
        Bc.I32Const { .value = 7 },
        Bc.ArrayNew { .type_id = 2, .length = 1 },
        Bc.I32Const { .value = 0 },
        Bc.I32Const { .value = 1 },
        Bc.ArrayCopy {},
        Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } },
    ]
    wasm :: wasm_module_of(program_over_arrays(body), "") else panic(wasm.reason)
    plain :: wasm.functions[0].body.filter_is<Plain>().collect()
    widened :: plain.filter((p) -> p.op == .I64ExtendI32S).count()
    assert_eq(widened, 3)
}
