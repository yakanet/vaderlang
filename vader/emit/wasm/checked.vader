// vader/emit/wasm/checked: the functions behind the checked integer ops.
//
// A `CheckedArith` or a `CheckedNeg` becomes a call to a function the emitter
// writes once per operation and integer class. It computes the result and stops
// the run (`unreachable`) when the exact result leaves the class, as
// `vader/core/bytecode/checked_arith.vader` defines it. A class of 32 bits or
// less lives in an `i32` (a `u32` as its bits, the others as their signed
// value), so its operation runs in `i64`, where the exact result of two such
// operands always fits, and the result is checked against the class bounds.
// `i64` and `u64` test the overflow on the bits of the result.

module "vader/emit/wasm"

Bc :: import "vader/core/bytecode"
import "std/collections"

// The parameters of a helper: its operand, or its two.
LEFT: i32: 0
RIGHT: i32: 1

// The index of the function computing `op` on two operands of `kind`.
checked_helper :: fn(ctx: ModuleCtx, kind: Bc.ValType, op: Bc.CheckedOp) -> i32 {
    key :: "${Bc.val_type_name(kind)}.${Bc.checked_op_name(op)}"
    return ctx.helpers[key] else define_checked(ctx, key, kind, op)
}

// The index of the function negating an operand of `kind`.
checked_neg_helper :: fn(ctx: ModuleCtx, kind: Bc.ValType) -> i32 {
    key :: "${Bc.val_type_name(kind)}.neg"
    return ctx.helpers[key] else define_checked_neg(ctx, key, kind)
}

// The frame of a helper taking `arity` operands of the class `kind` lives in
// and leaving one.
checked_frame :: fn(kind: Bc.ValType, arity: i64) -> HelperFrame {
    value_type :: if Bc.is_64_bit_int_val(kind) { WasmValType.I64 } else { WasmValType.I32 }
    return HelperFrame { .signature = func_of([value_type] * arity, [value_type]) }
}

// Append a helper the module computes `key` with, and return its index.
define_helper :: fn(
    ctx: ModuleCtx,
    key: string,
    signature: WasmFuncType,
    locals: WasmValType[],
    body: WasmInstr[],
) -> i32 {
    helper :: WasmFunction {
        .type_index = ctx.types.intern(signature),
        .locals = locals,
        .body = body,
    }
    index :: ctx.first_helper + i32(ctx.helper_functions.len())
    ctx.helper_functions.push(helper)
    ctx.helpers[key] = index
    return index
}

// The index of the helper `key`, its body given later by `fill_helper`: for a
// helper whose body reaches it again.
reserve_helper :: fn(ctx: ModuleCtx, key: string, signature: WasmFuncType) -> i32 =
    ctx.define_helper(key, signature, [], [])

fill_helper :: fn(ctx: ModuleCtx, index: i32, locals: WasmValType[], body: WasmInstr[]) -> void {
    reserved :: ctx.helper_functions[index - ctx.first_helper]
    reserved.locals = locals
    reserved.body = body
}

// (a, b) -> a op b.
define_checked :: fn(ctx: ModuleCtx, key: string, kind: Bc.ValType, op: Bc.CheckedOp) -> i32 {
    frame :: checked_frame(kind, 2)
    result :: frame.local(.I64)
    if Bc.is_64_bit_int_val(kind) {
        return ctx.define_tree_helper(key, frame, ctx.wide_body(kind, op, result))
    }
    exact :: binary(i64_op(op), widened(kind, local_get(LEFT)), widened(kind, local_get(RIGHT)))
    return ctx.define_tree_helper(key, frame, ctx.bounded(kind, exact, result))
}

// (a) -> -a, which leaves a signed class at its least value and an unsigned
// one at any value but 0.
define_checked_neg :: fn(ctx: ModuleCtx, key: string, kind: Bc.ValType) -> i32 {
    frame :: checked_frame(kind, 1)
    result :: frame.local(.I64)
    if !Bc.is_64_bit_int_val(kind) {
        exact :: i64_sub(i64_const(0), widened(kind, local_get(LEFT)))
        return ctx.define_tree_helper(key, frame, ctx.bounded(kind, exact, result))
    }
    overflows :: if kind == .U64 {
        i64_ne(local_get(LEFT), i64_const(0))
    } else {
        i64_eq(local_get(LEFT), i64_const(I64_LEAST))
    }
    body: WasmExpression[]: [trap_if(ctx, overflows), i64_sub(i64_const(0), local_get(LEFT))]
    return ctx.define_tree_helper(key, frame, body)
}

i64_op :: fn(op: Bc.CheckedOp) -> WasmOp = match op {
    .Add -> .I64Add
    .Sub -> .I64Sub
    .Mul -> .I64Mul
}

// An operand of a class of 32 bits or less, as its exact `i64` value.
widened :: fn(kind: Bc.ValType, operand: WasmExpression) -> WasmExpression =
    unary(if kind == .U32 { .I64ExtendI32U } else { .I64ExtendI32S }, operand)

// `exact`, an exact `i64` result, stopped when it leaves `kind`, else narrowed
// back to the `i32` the class lives in, kept in the local `result` meanwhile.
// One unsigned comparison tests both bounds: below the least value,
// `result - least` wraps past the span.
bounded :: fn(
    ctx: ModuleCtx,
    kind: Bc.ValType,
    exact: WasmExpression,
    result: i32,
) -> WasmExpression[] {
    bits :: Bc.integer_bits(kind)
    one: i64: 1
    least :: if Bc.is_unsigned_val(kind) { 0 } else { -(one << (bits - 1)) }
    past_span :: binary(
        .I64GtU,
        i64_sub(local_tee(result, exact), i64_const(least)),
        i64_const((one << bits) - 1),
    )
    return [trap_if(ctx, past_span), i32_wrap_i64(local_get(result))]
}

I64_LEAST: i64: -0x7FFF_FFFF_FFFF_FFFF - 1

// Whether both `x` and `y`, each the xor of two `i64`s, have their sign bit set:
// each pair differs in sign.
sign_differs_twice :: fn(x: WasmExpression, y: WasmExpression) -> WasmExpression =
    binary(.I64LtS, i64_and(x, y), i64_const(0))

// a op b on `i64` or `u64`, kept in the local `result`, then the test that the
// bits overflowed.
wide_body :: fn(
    ctx: ModuleCtx,
    kind: Bc.ValType,
    op: Bc.CheckedOp,
    result: i32,
) -> WasmExpression[] {
    unsigned :: kind == .U64
    a :: local_get(LEFT)
    b :: local_get(RIGHT)
    exact :: local_get(result)
    overflow: WasmExpression[]: match op {
        // `u64`: the result is below an operand. `i64`: both operands differ in
        // sign from the result.
        .Add -> [
            trap_if(
                ctx,
                if unsigned { binary(.I64LtU, exact, a) } else {
                    sign_differs_twice(i64_xor(a, exact), i64_xor(b, exact))
                },
            ),
        ]
        // `u64`: `a` is below `b`. `i64`: the operands differ in sign, and the
        // result differs from `a`.
        .Sub -> [
            trap_if(
                ctx,
                if unsigned { binary(.I64LtU, a, b) } else {
                    sign_differs_twice(i64_xor(a, b), i64_xor(a, exact))
                },
            ),
        ]
        .Mul -> ctx.mul_overflow(unsigned, result)
    }
    body: WasmExpression[]: [local_set(result, binary(i64_op(op), a, b))]
    body.push_all(overflow)
    body.push(exact)
    return body
}

// The product in the local `result` checked by dividing it back by `a`, when `a`
// is not 0. `i64` also overflows on -1 times the least value, which the
// division would trap on: that case is tested first, and `a` = -1 skips the
// division.
mul_overflow :: fn(ctx: ModuleCtx, unsigned: bool, result: i32) -> WasmExpression[] {
    a :: local_get(LEFT)
    b :: local_get(RIGHT)
    divided :: binary(if unsigned { .I64DivU } else { .I64DivS }, local_get(result), a)
    check_back :: trap_if(ctx, i64_ne(divided, b))
    if unsigned {
        return [when(i64_ne(a, i64_const(0)), [check_back])]
    }
    least_by_minus_one :: i32_and(i64_eq(a, i64_const(-1)), i64_eq(b, i64_const(I64_LEAST)))
    divisible :: i32_and(i64_ne(a, i64_const(0)), i64_ne(a, i64_const(-1)))
    return [trap_if(ctx, least_by_minus_one), when(divisible, [check_back])]
}

// Stop the run when `condition` holds.
trap_if :: fn(ctx: ModuleCtx, condition: WasmExpression) -> WasmExpression =
    when(condition, [stop_run(ctx)])

// Stop the run: through `panic` when the program pushes defers, which runs those
// still pending as the VM runs them when it traps.
stop_run :: fn(ctx: ModuleCtx) -> WasmExpression {
    if ctx.has_defers {
        // The message `panic` takes: it writes none yet.
        return call(ctx.panic_function(), [i32_const(0)])
    }
    return unreachable()
}

// The type a division or a remainder works on, null for any other op.
//
// @partial: every other op is no division.
division_type :: fn(op: WasmOp) -> WasmValType | null = @partial match op {
    .I32DivS | .I32DivU | .I32RemS | .I32RemU -> .I32
    .I64DivS | .I64DivU | .I64RemS | .I64RemU -> .I64
    _                                         -> null
}

// `(a, b) -> a op b` for the division `op` on `t`: a zero `b` stops the run as
// `trap_if` does. The engine's own trap would run no defer.
checked_division :: fn(ctx: ModuleCtx, op: WasmOp, t: WasmValType) -> i32 {
    key :: "divide.${opcode(op)}"
    known :: ctx.helpers[key]
    if known != null {
        return known
    }
    a :: local_get(LEFT)
    b :: local_get(RIGHT)
    zero :: unary(if t == .I64 { .I64Eqz } else { .I32Eqz }, b)
    frame :: HelperFrame { .signature = func_of([t, t], [t]) }
    return ctx.define_tree_helper(key, frame, [trap_if(ctx, zero), binary(op, a, b)])
}
