// vader/emit/wasm/arguments: the `string[]` an entry that takes one receives.
//
// The host hands the arguments through `get-arguments` of
// `wasi:cli/environment`, which `run` calls when the entry takes them, as the
// native runtime's `main` reads `argv`. Its `list<string>` comes back through
// the linear memory, at an address the core function takes, and is read as any
// result of a call (`canonical_lift.vader`).

module "vader/emit/wasm"

import "std/abort"
Bc :: import "vader/core/bytecode"
import "vader/core/wit"

// The interface whose `get-arguments` the entry's arguments come from.
ENVIRONMENT_INTERFACE: string: "wasi:cli/environment@0.3.0"

// `get-arguments: func() -> list<string>`, as `wasi:cli/environment` declares it.
ARGUMENTS_FUNCTION :: ComponentFunction {
    .name = "get-arguments",
    .type = WitFunction { .params = [], .result = WitList { .element = .String } },
}

// Import `get-arguments`, at the next index of `imports`.
add_arguments_import :: fn(imports: ImportedFunctions, types: TypeTable) -> void {
    core_type :: flat_type_of(ARGUMENTS_FUNCTION.type, ARGUMENTS_FUNCTION.name)
        else panic("wasm: `get-arguments` has no core type: ${core_type.reason}")
    imports.arguments = i32(imports.functions.len())
    imports.functions.push(
        WasmImport {
            .module = ENVIRONMENT_INTERFACE,
            .name = ARGUMENTS_FUNCTION.name,
            .type_index = types.intern(core_type),
        },
    )
    imports.add_to_interface(ENVIRONMENT_INTERFACE, ARGUMENTS_FUNCTION)
}

// `() -> string[]`: the program's arguments, its path first, each string the
// atom of its bytes. Null when nothing imports `get-arguments`.
arguments_function :: fn(ctx: ModuleCtx) -> i32 | null {
    get_arguments :: ctx.imports.arguments else return null
    list :: ARGUMENTS_FUNCTION.type.result else panic("wasm: `get-arguments` returns a list")
    strings :: Bc.find_string_array_type_id(ctx.module.types)
    load :: canonical_load(ctx, list, strings, "get-arguments")
        else panic("wasm: the arguments are read as a `string[]`: ${load.reason}")
    frame :: HelperFrame { .signature = func_of([], [.EqRef]) }
    address :: frame.local(.I32)
    value :: frame.local(.EqRef)
    body :: frame.arena_scope(
        [
            local_set(address, ctx.room_for(list)),
            call(get_arguments, [local_get(address)]),
            local_set(value, call(load, [local_get(address)])),
        ],
    )
    body.push(local_get(value))
    return ctx.define_tree_helper("arguments", frame, body)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_arguments_import_takes_the_address_of_its_result :: fn() -> void {
    imports :: ImportedFunctions {}
    types :: TypeTable {}
    imports.add_arguments_import(types)
    assert(imports.arguments == 0, "the first import")
    assert_eq(imports.interfaces[0].name, ENVIRONMENT_INTERFACE)
    assert_eq(canonical_func_type_key(types.types[0]), canonical_func_type_key(func_of([.I32], [])))
}
