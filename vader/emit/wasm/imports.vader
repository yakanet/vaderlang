// vader/emit/wasm/imports: the functions a program imports from component interfaces.
//
// Each bytecode import whose `@extern` names a `WasmInterface` becomes a core
// import, its module the interface as WIT writes it and its name the function.
// Its WIT type is the one the front end derived from the Vader declaration
// (`BcImport.wit`), and its core type is that WIT type flattened by the
// canonical ABI, which for a scalar is the value itself: only scalars are
// lowered so far. The other imports (a C library) have no WASM form yet: a call
// to one stops the emission.

module "vader/emit/wasm"

Bc :: import "vader/core/bytecode"
import "std/collections"
import "std/iter"
import "vader/core/wit"

// The functions a program imports from component interfaces.
ImportedFunctions :: struct {
    // The core module's imports, which come first among its functions.
    functions: WasmImport[] = []
    // The WASM function index of each bytecode import that comes from an
    // interface, by the bytecode import's index.
    by_bytecode_index: Map<i32, i32> = Map<i32, i32> {}
    // The interfaces, each function once, as the component imports them.
    interfaces: ComponentInterface[] = []
}

// The imports of `m`, their core types interned in `types`.
imported_functions :: fn(
    m: Bc.BytecodeModule,
    types: TypeTable,
) -> ImportedFunctions | WasmUnsupported {
    out :: ImportedFunctions {}
    for i in 0..<m.imports.len() {
        imp :: m.imports[i]
        interface :: imp.wasm_interface else continue
        module :: Bc.qualified_interface_name(interface)
        function :: component_function_of(imp) else return function
        core_type :: flat_type_of(imp) else return core_type
        out.by_bytecode_index[i32(i)] = i32(out.functions.len())
        out.functions.push(
            WasmImport {
                .module = module,
                .name = function.name,
                .type_index = types.intern(core_type),
            },
        )
        out.add_to_interface(module, function)
    }
    return out
}

// Add `function` to the interface `module`, unless another declaration of the
// program imports it already.
add_to_interface :: fn(
    imports: ImportedFunctions,
    module: string,
    function: ComponentFunction,
) -> void {
    for interface in imports.interfaces {
        if interface.name == module {
            if !interface.functions.any_match((f) -> f.name == function.name) {
                interface.functions.push(function)
            }
            return
        }
    }
    imports.interfaces.push(ComponentInterface { .name = module, .functions = [function] })
}

// The WIT type of `imp`, a function of a component interface, when every value
// it takes and returns is a scalar the core module holds as itself.
component_function_of :: fn(imp: Bc.BcImport) -> ComponentFunction | WasmUnsupported {
    wit :: imp.wit else {
        return WasmUnsupported { .reason = "`${imp.mangled_name}`: no WIT type" }
    }
    for p in wit.params {
        checked :: flat_scalar(p.type, imp) else return checked
    }
    result :: wit.result
    if result != null {
        checked :: flat_scalar(result, imp) else return checked
    }
    return ComponentFunction { .name = imp.extern_name, .type = wit }
}

// `t` when it is a scalar a core value holds as itself.
flat_scalar :: fn(t: WitType, imp: Bc.BcImport) -> WitScalar | WasmUnsupported {
    if t is WitUnsupported {
        return WasmUnsupported { .reason = "`${imp.mangled_name}`: ${t.reason}" }
    }
    if t !is WitScalar || t == .String {
        return WasmUnsupported {
            .reason = "`${imp.mangled_name}`: no lowering yet for `${wit_type_text(t)}`",
        }
    }
    return t
}

// The core type of `imp`: its scalars as themselves.
flat_type_of :: fn(imp: Bc.BcImport) -> WasmFuncType | WasmUnsupported {
    params :: value_types_of(imp.signature.params, imp.extern_name) else return params
    results :: value_types_of(result_values(imp.signature), imp.extern_name) else return results
    return WasmFuncType { .params = params, .results = results }
}
