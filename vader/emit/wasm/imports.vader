// vader/emit/wasm/imports: the functions a program imports from component interfaces.
//
// Each bytecode import whose `@extern` names a `WasmInterface` becomes a core
// import, its module the interface as WIT writes it and its name the function.
// Its WIT type is the one the front end derived from the Vader declaration
// (`BcImport.wit`), and its core type is that WIT type flattened by the
// canonical ABI: a scalar is itself, a stream or a future its handle. A call
// that opens a stream or waits for a future goes through an adapter, whose
// canonical built-ins come last among the imports (`canonical.vader`). The other
// imports (a C library) have no WASM form yet: a call to one stops the
// emission.

module "vader/emit/wasm"

Bc :: import "vader/core/bytecode"
import "std/collections"
import "std/iter"

// The functions a program imports from component interfaces.
ImportedFunctions :: struct {
    // The core module's imports, which come first among its functions: the
    // interfaces' functions, then the canonical built-ins.
    functions: WasmImport[] = []
    // The WASM function index of each bytecode import that comes from an
    // interface, by the bytecode import's index.
    by_bytecode_index: Map<i32, i32> = Map<i32, i32> {}
    // The bytecode imports a call reaches through an adapter (`canonical.vader`).
    adapted: Set<i32> = Set<i32> {}
    // The interfaces, each function once, as the component imports them.
    interfaces: ComponentInterface[] = []
    // The canonical built-ins the adapters call, each once.
    builtins: CanonicalBuiltin[] = []
    // The WASM function index of each built-in, by `builtin_name`.
    by_builtin: Map<string, i32> = Map<string, i32> {}
    // The WASM function index of `get-arguments`, when the entry takes them
    // (`arguments.vader`).
    arguments: i32 | null = null
}

// The imports of `m`, their core types interned in `types`, and `get-arguments`
// when the entry `takes_arguments`.
imported_functions :: fn(
    m: Bc.BytecodeModule,
    types: TypeTable,
    takes_arguments: bool,
) -> ImportedFunctions | WasmUnsupported {
    out :: ImportedFunctions {}
    for [imp, i] in m.imports.indexed() {
        interface :: imp.wasm_interface else continue
        module :: Bc.qualified_interface_name(interface)
        wit :: imp.wit else {
            return WasmUnsupported { .reason = "`${imp.mangled_name}`: no WIT type" }
        }
        core_type :: flat_type_of(wit, imp.mangled_name) else return core_type
        function :: ComponentFunction { .name = imp.extern_name, .type = wit }
        out.by_bytecode_index[i32(i)] = i32(out.functions.len())
        out.functions.push(
            WasmImport {
                .module = module,
                .name = function.name,
                .type_index = types.intern(core_type),
            },
        )
        out.add_to_interface(module, function)
        if is_adapted(wit) {
            out.adapted.add(i32(i))
            out.add_builtins(builtins_of(wit))
        }
    }
    if takes_arguments {
        out.add_arguments_import(types)
    }
    for b in out.builtins {
        out.by_builtin[builtin_name(b)] = i32(out.functions.len())
        out.functions.push(
            WasmImport {
                .module = CANONICAL_MODULE,
                .name = builtin_name(b),
                .type_index = types.intern(builtin_type(b.kind)),
            },
        )
    }
    return out
}

// Add the built-ins of `builtins` not imported yet.
add_builtins :: fn(imports: ImportedFunctions, builtins: CanonicalBuiltin[]) -> void {
    for b in builtins {
        name :: builtin_name(b)
        if !imports.builtins.any_match((known) -> builtin_name(known) == name) {
            imports.builtins.push(b)
        }
    }
}

// Add `function` to the interface `module`, unless another declaration of the
// program imports it already.
add_to_interface :: fn(
    imports: ImportedFunctions,
    module: string,
    function: ComponentFunction,
) -> void {
    for interface in imports.interfaces {
        if interface.name == module {
            if !interface.functions.any_match((f) -> f.name == function.name) {
                interface.functions.push(function)
            }
            return
        }
    }
    imports.interfaces.push(ComponentInterface { .name = module, .functions = [function] })
}
