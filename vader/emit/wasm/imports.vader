// vader/emit/wasm/imports: the functions a program imports from component interfaces.
//
// Each bytecode import whose `@extern` names a `WasmInterface` becomes a core
// import, its module the interface as WIT writes it and its name the function.
// Its WIT type is the one the front end derived from the Vader declaration
// (`BcImport.wit`), and its core type is that WIT type flattened by the
// canonical ABI (`canonical_layout.vader`). Two declarations of one function (the
// bindings of `std` and the module of an imported interface) share its import.
// A call whose arguments or result
// Vader does not hold as the core function takes them goes through an adapter,
// whose canonical built-ins come last among the imports (`canonical.vader`). A
// program that reads a stream imports `wait-for` as well, which a read with a
// deadline waits on (`canonical_wait.vader`). The other
// imports (a C library) have no WASM form yet: a call to one stops the
// emission.

module "vader/emit/wasm"

Bc :: import "vader/core/bytecode"
import "std/collections"
import "std/iter"
import "vader/core/wit"

// The functions a program imports from component interfaces.
ImportedFunctions :: struct {
    // The core module's imports, which come first among its functions: the
    // interfaces' functions, then the canonical built-ins.
    functions: WasmImport[] = []
    // The WASM function index of each bytecode import that comes from an
    // interface, by the bytecode import's index.
    by_bytecode_index: Map<i32, i32> = Map<i32, i32> {}
    // Each function of an interface imported, by `function_key`.
    by_function: Map<string, ImportedFunction> = Map<string, ImportedFunction> {}
    // The bytecode imports a call reaches through an adapter (`canonical.vader`).
    adapted: Set<i32> = Set<i32> {}
    // The interfaces, each function once, as the component imports them.
    interfaces: ComponentInterface[] = []
    // The canonical built-ins the adapters call, each once.
    builtins: CanonicalBuiltin[] = []
    // The WASM function index of each built-in, by `builtin_name`.
    by_builtin: Map<string, i32> = Map<string, i32> {}
    // The WASM function index of `get-arguments`, when the entry takes them
    // (`arguments.vader`).
    arguments: i32 | null = null
    // The stream or the future the struct holding a handle stands for, by the
    // struct's bytecode type: what a read or a wait of one calls the built-ins of.
    handles: Map<i32, Handled> = Map<i32, Handled> {}
    // The WASM function index of `wait-for`, when the program reads a stream.
    wait_for: i32 | null = null
    // Whether the program starts threads of the component model, which take the
    // built-ins of `THREAD_BUILTINS` (`threads.vader`).
    threads: bool = false
}

// The built-ins of a program that starts threads.
THREAD_BUILTINS: CanonicalKind[]: [
    .ThreadNewIndirect,
    .ThreadResumeLater,
    .ThreadYield,
    .ThreadSuspend,
    .ThreadIndex,
    .ContextGet,
    .ContextSet,
    .ContextGetBlock,
    .ContextSetBlock,
]

// The interface and the function a read with a deadline waits on, as WASI 0.3
// declares it.
WAIT_FOR_INTERFACE: string: "wasi:clocks/monotonic-clock@0.3.0"
WAIT_FOR: ComponentFunction: ComponentFunction {
    .name = "wait-for",
    .type = WitFunction {
        .params = [WitParam { .name = "how-long", .type = .U64 }],
        .result = null,
        .is_async = true,
    },
}

// The built-ins a read with a deadline calls beside those of its stream.
DEADLINE_BUILTINS: CanonicalKind[]: [.WaitableSetPoll, .SubtaskCancel, .SubtaskDrop]

// The imports of `m`, their core types interned in `types`, and `get-arguments`
// when the entry `takes_arguments`.
imported_functions :: fn(
    m: Bc.BytecodeModule,
    types: TypeTable,
    takes_arguments: bool,
) -> ImportedFunctions | WasmUnsupported {
    out :: ImportedFunctions { .threads = starts_threads(m) }
    reads_streams: bool = false
    for [imp, i] in m.imports.indexed() {
        if imp.service == Bc.RuntimeService.WasmStreamRead {
            reads_streams = true
        }
        interface :: imp.wasm_interface else continue
        module :: Bc.qualified_interface_name(interface)
        wit :: imp.wit else {
            return WasmUnsupported { .reason = "`${imp.mangled_name}`: no WIT type" }
        }
        function :: ComponentFunction { .name = imp.extern_name, .type = wit }
        index :: out.import_function(types, module, function, imp.mangled_name) else return index
        out.by_bytecode_index[i32(i)] = index
        if needs_adapter(wit) {
            out.adapted.add(i32(i))
            out.add_builtins(builtins_of(wit))
        }
        result :: wit.result
        if result != null && imp.signature.result_types.len() > 0 {
            holders :: result_holders(imp, wit)
            out.record_handles(m.types, result, imp.signature.result_types[0], holders)
        }
    }
    if takes_arguments {
        added :: out.add_arguments_import(types) else return added
    }
    if reads_streams {
        wait_for :: out.import_function(types, WAIT_FOR_INTERFACE, WAIT_FOR, "wait-for")
            else return wait_for
        out.wait_for = wait_for
        out.add_builtins(
            DEADLINE_BUILTINS.map((kind) -> CanonicalBuiltin { .kind = kind }).collect(),
        )
    }
    if out.threads {
        out.add_builtins(THREAD_BUILTINS.map((kind) -> CanonicalBuiltin { .kind = kind }).collect())
    }
    for b in out.builtins {
        out.by_builtin[builtin_name(b)] = i32(out.functions.len())
        out.functions.push(
            WasmImport {
                .module = CANONICAL_MODULE,
                .name = builtin_name(b),
                .type_index = types.intern(builtin_type(b.kind)),
            },
        )
    }
    return out
}

// Add the built-ins of `builtins` not imported yet.
add_builtins :: fn(imports: ImportedFunctions, builtins: CanonicalBuiltin[]) -> void {
    for b in builtins {
        name :: builtin_name(b)
        if !imports.builtins.any_match((known) -> builtin_name(known) == name) {
            imports.builtins.push(b)
        }
    }
}

// Note the streams and the futures `t` holds as handles, the value of type
// `type_id`: `t` itself, or the elements of a tuple.
record_handles :: fn(
    imports: ImportedFunctions,
    types: Bc.BcType[],
    t: WitType,
    type_id: i32,
    holders: WitHolders,
) -> void {
    if t is WitStream | WitFuture {
        imports.handles[type_id] = Handled { .type = t, .holders = holders }
        return
    }
    if t !is WitTuple {
        return
    }
    held :: types[type_id]
    if held is Bc.BcStruct && held.fields.len() == t.elements.len() {
        for [e, i] in t.elements.indexed() {
            imports.record_handles(types, e, held.fields[i].type_index, child_holders(holders, t, i))
        }
    }
}

// A stream or a future a call returns, and the holders of its tree.
Handled :: struct {
    type: WitStream | WitFuture
    holders: WitHolders
}

// A function of an interface the program imports.
ImportedFunction :: struct {
    // Its WASM function index.
    index: i32
    // Its WIT type, as `wit_function_text` writes it.
    wit: string
}

// The WASM function index of `function` of the interface `module`: the import
// another declaration of it made, or a new one. Two declarations of one function
// must agree on its WIT type; `declared` names this one.
import_function :: fn(
    imports: ImportedFunctions,
    types: TypeTable,
    module: string,
    function: ComponentFunction,
    declared: string,
) -> i32 | WasmUnsupported {
    key :: function_key(module, function.name)
    wit :: wit_function_text(function.type)
    known :: imports.by_function[key]
    if known != null {
        if known.wit != wit {
            return WasmUnsupported {
                .reason = "`${declared}`: `${key}` is imported as `${known.wit}`, not `${wit}`",
            }
        }
        return known.index
    }
    core_type :: flat_type_of(function.type, declared) else return core_type
    index :: i32(imports.functions.len())
    imports.by_function[key] = ImportedFunction { .index = index, .wit = wit }
    imports.functions.push(
        WasmImport {
            .module = module,
            .name = function.name,
            .type_index = types.intern(core_type),
        },
    )
    imports.add_to_interface(module, function)
    return index
}

// A function of an interface: `wasi:cli/stdout@0.3.0#write-via-stream`.
function_key :: fn(module: string, name: string) -> string = "${module}#${name}"

// Add `function` to the interface `module`, which does not hold it yet: among its
// drops when it is the drop of a resource.
add_to_interface :: fn(
    imports: ImportedFunctions,
    module: string,
    function: ComponentFunction,
) -> void {
    interface :: imports.interfaces.find((i) -> i.name == module) else {
        added :: ComponentInterface { .name = module, .functions = [] }
        imports.interfaces.push(added)
        added
    }
    dropped :: dropped_resource(function.name, function.type)
    if dropped != null {
        interface.drops.push(dropped)
    } else {
        interface.functions.push(function)
    }
}
