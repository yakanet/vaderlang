// vader/emit/wasm/expression: the body of a helper the emitter writes, as a tree.
//
// A helper is written as the expressions of its algorithm, each over its operands
// (`i32_add(local_get(size), i32_const(1))`), as the C emitter builds a C tree
// (`vader/emit/c/ast`), then flattened into instructions (`flatten`): operands
// first, then the instruction. The constructors are named after the instructions
// as WAT writes them.
//
// The scopes the emitter writes take the empty block type, so a branch cannot
// leave a value: `choose` passes its value through a local it takes from the
// helper's frame.

module "vader/emit/wasm"

import "std/abort"

// An expression of a helper's body: a value, or an effect.
WasmExpression :: Apply
                | Assign
                | Unpack
                | When
                | Choose
                | Repeat
                | Loop
                | DoWhile
                | Sequence
                | OnStack

// `instruction` over the values of `operands`, the first pushed first.
Apply :: struct {
    instruction: WasmInstr
    operands: WasmExpression[] = []
}

// The local `local` set to `value`.
Assign :: struct {
    local: i32
    value: WasmExpression
}

// The locals `locals` set to the values `value` leaves, the first to the first.
Unpack :: struct {
    locals: i32[]
    value: WasmExpression
}

// `then` when `condition` is not zero, else `otherwise`; leaves nothing.
When :: struct {
    condition: WasmExpression
    then: WasmExpression[]
    otherwise: WasmExpression[] = []
}

// The value of `then` when `condition` is not zero, else of `otherwise`, both of
// type `type`.
Choose :: struct {
    type: WasmValType
    condition: WasmExpression
    then: WasmExpression
    otherwise: WasmExpression
}

// `body` for each value of the local `counter` from 0 below the local `limit`,
// both of the integer type `type`. `body` leaves nothing.
Repeat :: struct {
    type: WasmValType
    counter: i32
    limit: i32
    body: WasmExpression[]
}

// `body` until `exit_when` holds, tested before each turn. `body` leaves nothing
// and branches nowhere, or returns.
Loop :: struct {
    exit_when: WasmExpression
    body: WasmExpression[]
}

// `body`, again while `condition` holds, tested after each turn. `body` leaves
// nothing and branches nowhere, or returns.
DoWhile :: struct {
    body: WasmExpression[]
    condition: WasmExpression
}

// `body`, in order: the values they leave, left.
Sequence :: struct {
    body: WasmExpression[]
}

// The value already on the stack, where the translation of a bytecode op
// flattens an expression over what the ops before it pushed.
OnStack :: struct {}

// The parameters and locals of a helper being written.
HelperFrame :: struct {
    signature: WasmFuncType
    locals: WasmValType[] = []
    /// False for an expression flattened over the stack (`push_on_stack`), which
    /// has no frame of its own to take a local in.
    takes_locals: bool = true
}

// A fresh local of type `t`, past the parameters.
local :: fn(frame: HelperFrame, t: WasmValType) -> i32 {
    if !frame.takes_locals {
        panic("wasm: an expression over the stack takes no local")
    }
    frame.locals.push(t)
    return i32(frame.signature.params.len() + frame.locals.len() - 1)
}

// The instructions of `body`, the locals they take added to `frame`.
flatten :: fn(frame: HelperFrame, body: WasmExpression[]) -> WasmInstr[] {
    out: WasmInstr[]: []
    out.push_body(frame, body)
    return out
}

push_body :: fn(out: WasmInstr[], frame: HelperFrame, body: WasmExpression[]) -> void {
    for e in body {
        out.push_expression(frame, e)
    }
}

push_expression :: fn(out: WasmInstr[], frame: HelperFrame, e: WasmExpression) -> void = match e {
    is Apply    -> {
        for operand in e.operands {
            out.push_expression(frame, operand)
        }
        out.push(e.instruction)
    }
    is Assign   -> {
        out.push_expression(frame, e.value)
        out.push(LocalSet { .index = e.local })
    }
    is Unpack   -> {
        out.push_expression(frame, e.value)
        for k in 0..<e.locals.len() {
            out.push(LocalSet { .index = e.locals[e.locals.len() - 1 - k] })
        }
    }
    is When     -> {
        out.push_expression(frame, e.condition)
        out.push(Plain { .op = .If })
        out.push_body(frame, e.then)
        if !e.otherwise.is_empty() {
            out.push(Plain { .op = .Else })
            out.push_body(frame, e.otherwise)
        }
        out.push(Plain { .op = .End })
    }
    is Choose   -> {
        value :: frame.local(e.type)
        branches :: when_else(
            e.condition,
            [local_set(value, e.then)],
            [local_set(value, e.otherwise)],
        )
        out.push_expression(frame, branches)
        out.push(LocalGet { .index = value })
    }
    is Repeat   -> {
        next :: binary(add_of(e.type), local_get(e.counter), integer_const(e.type, 1))
        step :: local_set(e.counter, next)
        out.push_expression(frame, local_set(e.counter, integer_const(e.type, 0)))
        out.push_expression(frame, while_below(e.type, e.counter, e.limit, e.body + [step]))
    }
    is Loop     -> {
        out.push_all([Plain { .op = .Block }, Plain { .op = .Loop }])
        out.push_expression(frame, e.exit_when)
        out.push(BrIf { .depth = 1 })
        out.push_body(frame, e.body)
        out.push_all([Br { .depth = 0 }, Plain { .op = .End }, Plain { .op = .End }])
    }
    is DoWhile  -> {
        out.push(Plain { .op = .Loop })
        out.push_body(frame, e.body)
        out.push_expression(frame, e.condition)
        out.push_all([BrIf { .depth = 0 }, Plain { .op = .End }])
    }
    is Sequence -> { out.push_body(frame, e.body) }
    is OnStack  -> {}
}

// The body of the helper `index`, reserved by `reserve_helper`, from `frame` and
// `body`.
fill_tree_helper :: fn(
    ctx: ModuleCtx,
    index: i32,
    frame: HelperFrame,
    body: WasmExpression[],
) -> void {
    instructions :: flatten(frame, body)
    ctx.fill_helper(index, frame.locals, instructions)
}

// The instructions of `e`, an expression over the value on the stack
// (`on_stack`), which takes no local.
push_on_stack :: fn(out: WasmInstr[], e: WasmExpression) -> void {
    if e is OnStack {
        return
    }
    frame :: HelperFrame { .signature = func_of([], []), .takes_locals = false }
    out.push_expression(frame, e)
}

// The helper `key` of `frame` and `body`, defined once.
define_tree_helper :: fn(
    ctx: ModuleCtx,
    key: string,
    frame: HelperFrame,
    body: WasmExpression[],
) -> i32 {
    instructions :: flatten(frame, body)
    return ctx.define_helper(key, frame.signature, frame.locals, instructions)
}

// ---- constructors ---------------------------------------------------------

// The value already on the stack.
on_stack :: fn() -> WasmExpression = OnStack {}

// `body`, in order.
sequence :: fn(body: WasmExpression[]) -> WasmExpression = Sequence { .body = body }

// `instruction` over `operands`.
apply :: fn(instruction: WasmInstr, operands: WasmExpression[]) -> WasmExpression =
    Apply { .instruction = instruction, .operands = operands }

// `i32.const value`.
i32_const :: fn(value: i32) -> WasmExpression = Apply { .instruction = I32Const { .value = value } }

// `i64.const value`.
i64_const :: fn(value: i64) -> WasmExpression = Apply { .instruction = I64Const { .value = value } }

// `local.get index`.
local_get :: fn(index: i32) -> WasmExpression = Apply { .instruction = LocalGet { .index = index } }

// The constant `value` of the integer type `t`.
integer_const :: fn(t: WasmValType, value: i32) -> WasmExpression {
    if t == .I64 {
        return i64_const(i64(value))
    }
    return i32_const(value)
}

// The `i32` local `local` plus `n`.
plus :: fn(local: i32, n: i32) -> WasmExpression = i32_add(local_get(local), i32_const(n))

// The `i32` local `local` less `n`.
less :: fn(local: i32, n: i32) -> WasmExpression = i32_sub(local_get(local), i32_const(n))

// `local.set index`.
local_set :: fn(index: i32, value: WasmExpression) -> WasmExpression =
    Assign { .local = index, .value = value }

// `local.tee index`: `value` set to the local, and left.
local_tee :: fn(index: i32, value: WasmExpression) -> WasmExpression =
    apply(LocalTee { .index = index }, [value])

// The locals `locals` set to the values `value` leaves.
unpack :: fn(locals: i32[], value: WasmExpression) -> WasmExpression =
    Unpack { .locals = locals, .value = value }

// `global.get index`.
global_get :: fn(index: i32) -> WasmExpression =
    Apply { .instruction = GlobalGet { .index = index } }

// `global.set index`.
global_set :: fn(index: i32, value: WasmExpression) -> WasmExpression =
    apply(GlobalSet { .index = index }, [value])

// `op` over two operands.
binary :: fn(op: WasmOp, left: WasmExpression, right: WasmExpression) -> WasmExpression =
    Apply { .instruction = Plain { .op = op }, .operands = [left, right] }

// `op` over one operand.
unary :: fn(op: WasmOp, operand: WasmExpression) -> WasmExpression =
    Apply { .instruction = Plain { .op = op }, .operands = [operand] }

i32_add :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I32Add, left, right)

i32_sub :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I32Sub, left, right)

i32_mul :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I32Mul, left, right)

i32_and :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I32And, left, right)

i32_shr_u :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I32ShrU, left, right)

i32_eq :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I32Eq, left, right)

i32_gt_s :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I32GtS, left, right)

i32_wrap_i64 :: fn(operand: WasmExpression) -> WasmExpression = unary(.I32WrapI64, operand)

i32_or :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I32Or, left, right)

i32_shl :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I32Shl, left, right)

i32_ne :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I32Ne, left, right)

i32_lt_u :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I32LtU, left, right)

i32_le_s :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I32LeS, left, right)

i32_ge_s :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I32GeS, left, right)

i64_add :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I64Add, left, right)

i64_sub :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I64Sub, left, right)

i64_mul :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I64Mul, left, right)

i64_and :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I64And, left, right)

i64_or :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I64Or, left, right)

i64_xor :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I64Xor, left, right)

i64_shl :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I64Shl, left, right)

i64_shr_u :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I64ShrU, left, right)

i64_eq :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I64Eq, left, right)

i64_ne :: fn(left: WasmExpression, right: WasmExpression) -> WasmExpression =
    binary(.I64Ne, left, right)

i64_eqz :: fn(operand: WasmExpression) -> WasmExpression = unary(.I64Eqz, operand)

i64_extend_i32_u :: fn(operand: WasmExpression) -> WasmExpression = unary(.I64ExtendI32U, operand)

i32_eqz :: fn(operand: WasmExpression) -> WasmExpression = unary(.I32Eqz, operand)

// A load `op` at `address` plus `offset`.
load :: fn(op: MemoryOp, address: WasmExpression, offset: i32 = 0) -> WasmExpression =
    apply(MemoryAccess { .op = op, .offset = offset }, [address])

// `i32.load` at `address` plus `offset`.
i32_load :: fn(address: WasmExpression, offset: i32 = 0) -> WasmExpression =
    load(.I32Load, address, offset)

// A store `op` of `value` at `address` plus `offset`.
store :: fn(
    op: MemoryOp,
    address: WasmExpression,
    value: WasmExpression,
    offset: i32 = 0,
) -> WasmExpression =
    apply(MemoryAccess { .op = op, .offset = offset }, [address, value])

// `i32.store` of `value` at `address`.
i32_store :: fn(address: WasmExpression, value: WasmExpression) -> WasmExpression =
    store(.I32Store, address, value)

// `memory.size`, in pages.
memory_size :: fn() -> WasmExpression = Apply { .instruction = Plain { .op = .MemorySize } }

// `memory.grow` by `pages`: the old size, or -1.
memory_grow :: fn(pages: WasmExpression) -> WasmExpression = unary(.MemoryGrow, pages)

// `call function` with `arguments`.
call :: fn(function: i32, arguments: WasmExpression[]) -> WasmExpression =
    Apply { .instruction = Call { .function_index = function }, .operands = arguments }

// `return`, leaving `values`.
return_ :: fn(values: WasmExpression[] = []) -> WasmExpression =
    apply(Plain { .op = .Return }, values)

// `drop` of `value`.
drop :: fn(value: WasmExpression) -> WasmExpression = unary(.Drop, value)

// `select`: `first` when `condition` holds, else `second`, both evaluated.
select :: fn(
    first: WasmExpression,
    second: WasmExpression,
    condition: WasmExpression,
) -> WasmExpression =
    apply(Plain { .op = .Select }, [first, second, condition])

// `ref.null eq`.
ref_null :: fn() -> WasmExpression = Apply { .instruction = RefNull {} }

// `struct.set type field` of `value` in `reference`, cast to `type` first.
struct_set :: fn(
    type: i32,
    field: i32,
    reference: WasmExpression,
    value: WasmExpression,
) -> WasmExpression =
    apply(
        StructSet { .type_index = type, .field_index = field },
        [ref_cast(type, reference), value],
    )

// `ref.test type` of `reference`.
ref_test :: fn(type: i32, reference: WasmExpression) -> WasmExpression =
    apply(RefTest { .type_index = type }, [reference])

// `unreachable`: stop the run.
unreachable :: fn() -> WasmExpression = Apply { .instruction = Plain { .op = .Unreachable } }

// `struct.new type` of `fields`, the first pushed first.
struct_new :: fn(type: i32, fields: WasmExpression[]) -> WasmExpression =
    apply(StructNew { .type_index = type }, fields)

// `struct.get type field` of `reference`, cast to `type` first.
struct_get :: fn(type: i32, field: i32, reference: WasmExpression) -> WasmExpression =
    apply(StructGet { .type_index = type, .field_index = field }, [ref_cast(type, reference)])

// `ref.cast type` of `reference`.
ref_cast :: fn(type: i32, reference: WasmExpression) -> WasmExpression =
    apply(RefCast { .type_index = type }, [reference])

// `array.new_default type`: `length` elements, each zero or null.
array_new_default :: fn(type: i32, length: WasmExpression) -> WasmExpression =
    apply(ArrayNewDefault { .type_index = type }, [length])

// `array.new_fixed type` of `elements`, the first pushed first.
array_new_fixed :: fn(type: i32, elements: WasmExpression[]) -> WasmExpression =
    apply(ArrayNewFixed { .type_index = type, .length = i32(elements.len()) }, elements)

// `array.len` of `array`, cast to the array type `type` first.
array_len :: fn(type: i32, array: WasmExpression) -> WasmExpression =
    apply(ArrayLen {}, [ref_cast(type, array)])

// `array.new_data type segment`: the `length` bytes of the data segment
// `segment` from `offset` on.
array_new_data :: fn(
    type: i32,
    segment: i32,
    offset: WasmExpression,
    length: WasmExpression,
) -> WasmExpression =
    apply(ArrayNewData { .type_index = type, .segment = segment }, [offset, length])

// An array and a position in it.
ArraySpan :: struct {
    array: WasmExpression
    at: WasmExpression
}

// `array.copy` of `length` elements of `source` into `destination`, both of the
// array type `type`.
array_copy :: fn(
    type: i32,
    destination: ArraySpan,
    source: ArraySpan,
    length: WasmExpression,
) -> WasmExpression =
    apply(
        ArrayCopy { .destination = type, .source = type },
        [
            ref_cast(type, destination.array),
            destination.at,
            ref_cast(type, source.array),
            source.at,
            length,
        ],
    )

// `array.get type` of `array` at `index`, cast to `type` first, a packed
// element extended by `extension`.
array_get :: fn(
    type: i32,
    array: WasmExpression,
    index: WasmExpression,
    extension: Extension = .None,
) -> WasmExpression =
    apply(ArrayGet { .type_index = type, .extension = extension }, [ref_cast(type, array), index])

// `array.set type` of `value` at `index` of `array`, cast to `type` first.
array_set :: fn(
    type: i32,
    array: WasmExpression,
    index: WasmExpression,
    value: WasmExpression,
) -> WasmExpression =
    apply(ArraySet { .type_index = type }, [ref_cast(type, array), index, value])

// `body` for each value of the local `x` below the local `limit`, both of the
// integer type `type`: `body` moves `x` on.
while_below :: fn(type: WasmValType, x: i32, limit: i32, body: WasmExpression[]) -> WasmExpression =
    Loop { .exit_when = binary(at_least_of(type), local_get(x), local_get(limit)), .body = body }

add_of :: fn(t: WasmValType) -> WasmOp = if t == .I64 { .I64Add } else { .I32Add }

at_least_of :: fn(t: WasmValType) -> WasmOp = if t == .I64 { .I64GeS } else { .I32GeS }

// `then` when `condition` holds.
when :: fn(condition: WasmExpression, then: WasmExpression[]) -> WasmExpression =
    When { .condition = condition, .then = then }

// `then` when `condition` holds, else `otherwise`.
when_else :: fn(
    condition: WasmExpression,
    then: WasmExpression[],
    otherwise: WasmExpression[],
) -> WasmExpression =
    When {
        .condition = condition,
        .then = then,
        .otherwise = otherwise,
    }

// `body` inside a `try_table` that catches the exception of the tag `tag`: what
// it throws of `tag` lands past the scope around it.
catching :: fn(tag: i32, body: WasmExpression[]) -> WasmExpression {
    opened: WasmExpression[]: [
        apply(Plain { .op = .Block }, []),
        apply(TryTable { .tag = tag }, []),
    ]
    closed: WasmExpression[]: [apply(Plain { .op = .End }, []), apply(Plain { .op = .End }, [])]
    return sequence(opened + body + closed)
}

// `body` until `condition` holds, tested before each turn.
loop_until :: fn(condition: WasmExpression, body: WasmExpression[]) -> WasmExpression =
    Loop { .exit_when = condition, .body = body }

// `body`, again while `condition` holds.
do_while :: fn(body: WasmExpression[], condition: WasmExpression) -> WasmExpression =
    DoWhile { .body = body, .condition = condition }

// The value of `then` when `condition` holds, else of `otherwise`.
choose :: fn(
    type: WasmValType,
    condition: WasmExpression,
    then: WasmExpression,
    otherwise: WasmExpression,
) -> WasmExpression =
    Choose {
        .type = type,
        .condition = condition,
        .then = then,
        .otherwise = otherwise,
    }

// `body` for each value of `counter` from 0 below `limit`.
repeat :: fn(
    type: WasmValType,
    counter: i32,
    limit: i32,
    body: WasmExpression[],
) -> WasmExpression =
    Repeat {
        .type = type,
        .counter = counter,
        .limit = limit,
        .body = body,
    }

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_operands_come_before_their_instruction :: fn() -> void {
    frame :: HelperFrame { .signature = func_of([.I32], [.I32]) }
    flat :: flatten(frame, [i32_add(local_get(0), i32_const(1))])
    assert_eq(flat.len(), 3)
    assert(flat[2] is Plain, "the add comes last")
}

@test
test_a_choice_goes_through_a_local_of_its_own :: fn() -> void {
    frame :: HelperFrame { .signature = func_of([.I32], [.I64]) }
    flat :: flatten(frame, [choose(.I64, local_get(0), i64_const(1), i64_const(2))])
    assert(frame.locals.len() == 1 && frame.locals[0] == .I64, "one i64 local taken")
    last :: flat[flat.len() - 1]
    assert(last is LocalGet && last.index == 1, "the value read back past the parameter")
}

@test
test_a_local_is_numbered_past_the_parameters :: fn() -> void {
    frame :: HelperFrame { .signature = func_of([.I32, .I32], []) }
    assert_eq(frame.local(.EqRef), 2)
    assert_eq(frame.local(.I32), 3)
}

@test
test_a_loop_tests_its_exit_before_its_body :: fn() -> void {
    frame :: HelperFrame { .signature = func_of([.I32, .I32], []) }
    flat :: flatten(frame, [while_below(.I32, 0, 1, [local_set(0, local_get(1))])])
    exit :: flat[5]
    assert(exit is BrIf && exit.depth == 1, "the exit leaves the block")
    turn :: flat[8]
    assert(turn is Br && turn.depth == 0, "the turn ends on the loop")
    assert_eq(flat.len(), 11)
}
