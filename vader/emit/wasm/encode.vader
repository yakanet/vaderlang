// vader/emit/wasm/encode: `WasmModule` -> the bytes of a `.wasm` file.
//
// The binary format of the WebAssembly core specification: the magic and the
// version, then the sections in the order the format requires, each written as
// its id, the byte size of its content, then the content. An integer is LEB128,
// a vector is its length followed by its items.

module "vader/emit/wasm"

// ---- encoding -------------------------------------------------------------

/// Write `m` in the WebAssembly binary format.
///
/// @param m  the module.
/// @return   the bytes of a `.wasm` file.
/// @example
///   bytes :: encode_module(WasmModule { .types = [], .functions = [], .exports = [] })
///   bytes.len()   // 8: the magic and the version alone
export encode_module :: fn(m: WasmModule) -> u8[] {
    out: u8[]: [0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00]
    if m.gc_types.len() + m.types.len() > 0 {
        out.push_section(.Type, type_section(m.gc_types, m.types))
    }
    if m.imports.len() > 0 {
        out.push_section(.Import, import_section(m.imports))
    }
    if m.functions.len() > 0 {
        out.push_section(.Function, function_section(m.functions))
    }
    if m.globals.len() > 0 {
        out.push_section(.Global, global_section(m.globals))
    }
    if m.exports.len() > 0 {
        out.push_section(.Export, export_section(m.exports))
    }
    if m.functions.len() > 0 {
        out.push_section(.Code, code_section(m.functions))
    }
    return out
}

// The sections of a module, numbered as the binary format numbers them.
SectionId :: enum(u8) {
    Type     = 1,
    Import   = 2,
    Function = 3,
    Global   = 6,
    Export   = 7,
    Code     = 10,
}

// The bytes that open a function type, a struct type, an array type, and a
// recursion group.
FUNC_TYPE: u8: 0x60
STRUCT_TYPE: u8: 0x5F
ARRAY_TYPE: u8: 0x5E
REC_GROUP: u8: 0x4E
// A mutable field.
MUTABLE: u8: 0x01
// The prefix of the Wasm GC instructions.
GC_PREFIX: u8: 0xFB
// The abstract heap type `eq`.
HEAP_EQ: u8: 0x6D
// The kind of an imported or exported function.
EXTERNAL_FUNCTION: u8: 0x00
// The byte that closes an expression, a function body included.
END: u8: 0x0B

push_section :: fn(out: u8[], id: SectionId, content: u8[]) -> void {
    out.push(u8(id))
    out.push_sized(content)
}

// `content` preceded by its byte size, as a section or a function body is.
push_sized :: fn(out: u8[], content: u8[]) -> void {
    out.push_count(content.len())
    out.push_all(content)
}

// The length of a vector, or any other count.
push_count :: fn(out: u8[], count: i64) -> void = out.push_unsigned(u64(count))

// The struct and array types as one recursion group, then each function type
// alone.
type_section :: fn(gc_types: WasmGcType[], types: WasmFuncType[]) -> u8[] {
    out: u8[]: []
    group_count: i64: if gc_types.len() > 0 { 1 } else { 0 }
    out.push_count(group_count + types.len())
    if gc_types.len() > 0 {
        out.push(REC_GROUP)
        out.push_count(gc_types.len())
        for t in gc_types {
            out.push_gc_type(t)
        }
    }
    for t in types {
        out.push(FUNC_TYPE)
        out.push_value_types(t.params)
        out.push_value_types(t.results)
    }
    return out
}

push_gc_type :: fn(out: u8[], t: WasmGcType) -> void {
    if t is WasmArrayType {
        out.push_all([ARRAY_TYPE, storage_type_byte(t.element), MUTABLE])
        return
    }
    out.push(STRUCT_TYPE)
    out.push_count(t.fields.len())
    for field in t.fields {
        out.push_all([value_type_byte(field.type), MUTABLE])
    }
}

storage_type_byte :: fn(t: WasmStorageType) -> u8 = match t {
    .I8    -> 0x78
    .I16   -> 0x77
    .I32   -> value_type_byte(.I32)
    .I64   -> value_type_byte(.I64)
    .F32   -> value_type_byte(.F32)
    .F64   -> value_type_byte(.F64)
    .EqRef -> value_type_byte(.EqRef)
}

import_section :: fn(imports: WasmImport[]) -> u8[] {
    out: u8[]: []
    out.push_count(imports.len())
    for i in imports {
        out.push_name(i.module)
        out.push_name(i.name)
        out.push(EXTERNAL_FUNCTION)
        out.push_count(i64(i.type_index))
    }
    return out
}

// Each global mutable, its initial value the zero or the null of its type.
global_section :: fn(globals: WasmValType[]) -> u8[] {
    out: u8[]: []
    out.push_count(globals.len())
    for t in globals {
        out.push_all([value_type_byte(t), MUTABLE])
        out.push_zero(t)
        out.push(END)
    }
    return out
}

push_zero :: fn(out: u8[], t: WasmValType) -> void = match t {
    .I32   -> { out.push_all([0x41, 0x00]) }
    .I64   -> { out.push_all([0x42, 0x00]) }
    .F32   -> { out.push_all([0x43, 0x00, 0x00, 0x00, 0x00]) }
    .F64   -> { out.push_all([0x44, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]) }
    .EqRef -> { out.push_all([0xD0, HEAP_EQ]) }
}

function_section :: fn(functions: WasmFunction[]) -> u8[] {
    out: u8[]: []
    out.push_count(functions.len())
    for f in functions {
        out.push_count(i64(f.type_index))
    }
    return out
}

export_section :: fn(exports: WasmExport[]) -> u8[] {
    out: u8[]: []
    out.push_count(exports.len())
    for e in exports {
        out.push_name(e.name)
        out.push(EXTERNAL_FUNCTION)
        out.push_count(i64(e.function_index))
    }
    return out
}

code_section :: fn(functions: WasmFunction[]) -> u8[] {
    out: u8[]: []
    out.push_count(functions.len())
    for f in functions {
        out.push_sized(function_body(f))
    }
    return out
}

// The locals of `f`, one run of a type per entry, then its instructions and
// the `end` that closes them.
function_body :: fn(f: WasmFunction) -> u8[] {
    runs :: local_runs(f.locals)
    out: u8[]: []
    out.push_count(runs.len())
    for run in runs {
        out.push_count(run.count)
        out.push(value_type_byte(run.value_type))
    }
    for instr in f.body {
        out.push_instr(instr)
    }
    out.push(END)
    return out
}

// Consecutive locals of one type, which the format declares as one entry.
LocalRun :: struct {
    count: i64
    value_type: WasmValType
}

local_runs :: fn(locals: WasmValType[]) -> LocalRun[] {
    runs: LocalRun[]: []
    for t in locals {
        if runs.len() > 0 && runs[runs.len() - 1].value_type == t {
            runs[runs.len() - 1].count += 1
        } else {
            runs.push(LocalRun { .count = 1, .value_type = t })
        }
    }
    return runs
}

push_instr :: fn(out: u8[], instr: WasmInstr) -> void {
    match instr {
        is I32Const        -> {
            out.push(0x41)
            out.push_signed(i64(instr.value))
        }
        is I64Const        -> {
            out.push(0x42)
            out.push_signed(instr.value)
        }
        is LocalGet        -> { out.push_indexed(0x20, instr.index) }
        is LocalSet        -> { out.push_indexed(0x21, instr.index) }
        is LocalTee        -> { out.push_indexed(0x22, instr.index) }
        is GlobalGet       -> { out.push_indexed(0x23, instr.index) }
        is GlobalSet       -> { out.push_indexed(0x24, instr.index) }
        is Call            -> { out.push_indexed(0x10, instr.function_index) }
        is Br              -> { out.push_indexed(0x0C, instr.depth) }
        is BrIf            -> { out.push_indexed(0x0D, instr.depth) }
        is StructNew       -> { out.push_gc(0x00, [instr.type_index]) }
        is StructGet       -> { out.push_gc(0x02, [instr.type_index, instr.field_index]) }
        is StructSet       -> { out.push_gc(0x05, [instr.type_index, instr.field_index]) }
        is RefCast         -> { out.push_heap_typed(0x16, instr.type_index) }
        is RefTest         -> { out.push_heap_typed(0x14, instr.type_index) }
        is RefNull         -> { out.push_all([0xD0, HEAP_EQ]) }
        is ArrayNewFixed   -> { out.push_gc(0x08, [instr.type_index, instr.length]) }
        is ArrayNewDefault -> { out.push_gc(0x07, [instr.type_index]) }
        is ArrayGet        -> { out.push_gc(array_get_code(instr.extension), [instr.type_index]) }
        is ArraySet        -> { out.push_gc(0x0E, [instr.type_index]) }
        is ArrayLen        -> { out.push_gc(0x0F, []) }
        is ArrayCopy       -> { out.push_gc(0x11, [instr.destination, instr.source]) }
        is Plain           -> {
            out.push(opcode(instr.op))
            if opens_scope(instr.op) {
                out.push(EMPTY_BLOCK_TYPE)
            }
        }
    }
}

array_get_code :: fn(extension: Extension) -> u8 = match extension {
    .None     -> 0x0B
    .Signed   -> 0x0C
    .Unsigned -> 0x0D
}

// A Wasm GC instruction and its index immediates.
push_gc :: fn(out: u8[], code: u8, immediates: i32[]) -> void {
    out.push(GC_PREFIX)
    out.push_count(i64(code))
    for i in immediates {
        out.push_count(i64(i))
    }
}

// A Wasm GC instruction on the heap type of a struct: a signed LEB128, which a
// type index, never negative, writes as its value.
push_heap_typed :: fn(out: u8[], code: u8, type_index: i32) -> void {
    out.push_gc(code, [])
    out.push_signed(i64(type_index))
}

// The block type of a scope that takes and leaves nothing.
EMPTY_BLOCK_TYPE: u8: 0x40

// An opcode, then the index it names.
push_indexed :: fn(out: u8[], code: u8, index: i32) -> void {
    out.push(code)
    out.push_count(i64(index))
}

opens_scope :: fn(op: WasmOp) -> bool = op == .Block || op == .Loop || op == .If

opcode :: fn(op: WasmOp) -> u8 = match op {
    .Unreachable   -> 0x00
    .Block         -> 0x02
    .Loop          -> 0x03
    .If            -> 0x04
    .Else          -> 0x05
    .End           -> 0x0B
    .Return        -> 0x0F
    .Drop          -> 0x1A
    .I32Eqz        -> 0x45
    .I32Eq         -> 0x46
    .I32Ne         -> 0x47
    .I32LtS        -> 0x48
    .I32LtU        -> 0x49
    .I32GtS        -> 0x4A
    .I32LeS        -> 0x4C
    .I32GeS        -> 0x4E
    .I64Eqz        -> 0x50
    .I64Eq         -> 0x51
    .I64Ne         -> 0x52
    .I64LtS        -> 0x53
    .I64LtU        -> 0x54
    .I64GtS        -> 0x55
    .I64GtU        -> 0x56
    .I64LeS        -> 0x57
    .I64GeS        -> 0x59
    .I64GeU        -> 0x5A
    .I32Add        -> 0x6A
    .I32Sub        -> 0x6B
    .I32Mul        -> 0x6C
    .I32DivS       -> 0x6D
    .I32DivU       -> 0x6E
    .I32RemS       -> 0x6F
    .I32RemU       -> 0x70
    .I32And        -> 0x71
    .I32Or         -> 0x72
    .I32Xor        -> 0x73
    .I32Shl        -> 0x74
    .I32ShrS       -> 0x75
    .I32ShrU       -> 0x76
    .I64Add        -> 0x7C
    .I64Sub        -> 0x7D
    .I64Mul        -> 0x7E
    .I64DivS       -> 0x7F
    .I64DivU       -> 0x80
    .I64RemS       -> 0x81
    .I64RemU       -> 0x82
    .I64And        -> 0x83
    .I64Xor        -> 0x85
    .I32WrapI64    -> 0xA7
    .I64ExtendI32S -> 0xAC
    .I64ExtendI32U -> 0xAD
    .F32Eq         -> 0x5B
    .F64Eq         -> 0x61
    .RefIsNull     -> 0xD1
    .RefEq         -> 0xD3
}

push_value_types :: fn(out: u8[], types: WasmValType[]) -> void {
    out.push_count(types.len())
    for t in types {
        out.push(value_type_byte(t))
    }
}

value_type_byte :: fn(t: WasmValType) -> u8 = match t {
    .I32   -> 0x7F
    .I64   -> 0x7E
    .F32   -> 0x7D
    .F64   -> 0x7C
    .EqRef -> 0x6D
}

// A name is a vector of UTF-8 bytes.
push_name :: fn(out: u8[], name: string) -> void {
    out.push_count(name.byte_len())
    out.push_all(name.bytes())
}

// ---- LEB128 ---------------------------------------------------------------

// Seven bits per byte, the low ones first; the high bit says another byte
// follows.
push_unsigned :: fn(out: u8[], value: u64) -> void {
    rest := value
    for rest >= 0x80 {
        out.push(u8(rest & 0x7F) | 0x80)
        rest = rest >> 7
    }
    out.push(u8(rest))
}

// Seven bits per byte as unsigned, and the last byte ends where the bits left
// are all copies of its sign bit (0x40).
push_signed :: fn(out: u8[], value: i64) -> void {
    rest := value
    done := false
    for !done {
        low :: rest & 0x7F
        rest = rest >> 7
        sign_clear :: low & 0x40 == 0
        done = rest == 0 && sign_clear || rest == -1 && !sign_clear
        out.push(u8(continued_byte(low, done)))
    }
}

continued_byte :: fn(low: i64, last: bool) -> i64 = if last { low } else { low | 0x80 }

// ---- tests ----------------------------------------------------------------

import "std/testing"

unsigned_bytes :: fn(value: u64) -> u8[] {
    out: u8[]: []
    out.push_unsigned(value)
    return out
}

signed_bytes :: fn(value: i64) -> u8[] {
    out: u8[]: []
    out.push_signed(value)
    return out
}

// `assert_eq` takes no array: an array has no `Equals`.
assert_bytes :: fn(actual: u8[], expected: u8[]) -> void =
    assert(actual.content_equals(expected), "expected ${expected}, got ${actual}")

@test
test_unsigned_leb_one_byte :: fn() -> void {
    assert_bytes(unsigned_bytes(0), [0x00])
    assert_bytes(unsigned_bytes(127), [0x7F])
}

@test
test_unsigned_leb_several_bytes :: fn() -> void {
    assert_bytes(unsigned_bytes(128), [0x80, 0x01])
    assert_bytes(unsigned_bytes(624485), [0xE5, 0x8E, 0x26])
}

@test
test_signed_leb_positive :: fn() -> void {
    assert_bytes(signed_bytes(42), [0x2A])
    assert_bytes(signed_bytes(63), [0x3F])
    assert_bytes(signed_bytes(64), [0xC0, 0x00])
}

@test
test_signed_leb_negative :: fn() -> void {
    assert_bytes(signed_bytes(-1), [0x7F])
    assert_bytes(signed_bytes(-64), [0x40])
    assert_bytes(signed_bytes(-65), [0xBF, 0x7F])
    assert_bytes(signed_bytes(-123456), [0xC0, 0xBB, 0x78])
}

@test
test_local_runs_group_consecutive_types :: fn() -> void {
    runs :: local_runs([.I32, .I32, .I64, .I32])
    assert_eq(runs.len(), 3)
    assert_eq(runs[0].count, 2)
    assert(runs[1].value_type == .I64, "the I64 local is a run of its own")
}

// The module `(func (export "main") (result i32) i32.const 42 return)`, as
// `wasm-tools parse` writes it: the header, then one line per section.
@test
test_encode_module_returning_a_constant :: fn() -> void {
    m :: WasmModule {
        .types = [WasmFuncType { .params = [], .results = [.I32] }],
        .functions = [
            WasmFunction {
                .type_index = 0,
                .locals = [],
                .body = [I32Const { .value = 42 }, Plain { .op = .Return }],
            },
        ],
        .exports = [WasmExport { .name = "main", .function_index = 0 }],
    }
    expected: u8[]: [0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00]
    expected.push_all([0x01, 0x05, 0x01, 0x60, 0x00, 0x01, 0x7F])
    expected.push_all([0x03, 0x02, 0x01, 0x00])
    expected.push_all([0x07, 0x08, 0x01, 0x04, 0x6D, 0x61, 0x69, 0x6E, 0x00, 0x00])
    expected.push_all([0x0A, 0x07, 0x01, 0x05, 0x00, 0x41, 0x2A, 0x0F, 0x0B])
    assert_bytes(encode_module(m), expected)
}

// Every instruction the encoder writes, against what `wasm-tools parse` gives
// for the same WAT: a body with no local, the instructions, its `end`.
@test
test_encode_every_instruction :: fn() -> void {
    plain: WasmOp[]: [
        .Unreachable,
        .Return,
        .Drop,
        .I32Eqz,
        .I32Eq,
        .I32Ne,
        .I32LtS,
        .I32LtU,
        .I32GtS,
        .I32LeS,
        .I32GeS,
        .I64Eqz,
        .I64Eq,
        .I64Ne,
        .I64LtS,
        .I64LtU,
        .I64GtS,
        .I64GtU,
        .I64LeS,
        .I64GeS,
        .I64GeU,
        .I32Add,
        .I32Sub,
        .I32Mul,
        .I32DivS,
        .I32DivU,
        .I32RemS,
        .I32RemU,
        .I32And,
        .I32Or,
        .I32Xor,
        .I32Shl,
        .I32ShrS,
        .I32ShrU,
        .I64Add,
        .I64Sub,
        .I64Mul,
        .I64DivS,
        .I64DivU,
        .I64RemS,
        .I64RemU,
        .I64And,
        .I64Xor,
        .I32WrapI64,
        .I64ExtendI32S,
        .I64ExtendI32U,
        .Block,
        .Loop,
        .If,
        .Else,
        .End,
        .End,
        .End,
    ]
    body: WasmInstr[]: []
    for op in plain {
        body.push(Plain { .op = op })
    }
    body.push_all([LocalGet { .index = 300 }, LocalSet { .index = 1 }, LocalTee { .index = 2 }])
    body.push_all([Call { .function_index = 3 }, Br { .depth = 4 }, BrIf { .depth = 5 }])
    f :: WasmFunction { .type_index = 0, .locals = [], .body = body }
    expected: u8[]: [0x00, 0x00, 0x0F, 0x1A]
    expected.push_all([0x45, 0x46, 0x47, 0x48, 0x49, 0x4A, 0x4C, 0x4E])
    expected.push_all([0x50, 0x51, 0x52, 0x53, 0x54, 0x55, 0x56, 0x57, 0x59, 0x5A])
    expected.push_all(
        [0x6A, 0x6B, 0x6C, 0x6D, 0x6E, 0x6F, 0x70, 0x71, 0x72, 0x73, 0x74, 0x75, 0x76],
    )
    expected.push_all([0x7C, 0x7D, 0x7E, 0x7F, 0x80, 0x81, 0x82, 0x83, 0x85])
    expected.push_all([0xA7, 0xAC, 0xAD])
    expected.push_all([0x02, 0x40, 0x03, 0x40, 0x04, 0x40, 0x05, 0x0B, 0x0B, 0x0B])
    expected.push_all(
        [0x20, 0xAC, 0x02, 0x21, 0x01, 0x22, 0x02, 0x10, 0x03, 0x0C, 0x04, 0x0D, 0x05],
    )
    expected.push(0x0B)
    assert_bytes(function_body(f), expected)
}
