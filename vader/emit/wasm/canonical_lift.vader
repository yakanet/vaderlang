// vader/emit/wasm/canonical_lift: a WIT value read out of the linear memory.
//
// What the host writes, a result too large to come back flat or the value of a
// future, is read into the form Vader holds it in: a scalar as itself, a
// `string` as its atom, a `list` as an array header over a new storage, a
// `result` as a union, its payload boxed when it is a scalar, an `option` as
// the union of its value, boxed the same way, and `null`, a `tuple` as the
// struct of its elements, a stream or a future as the struct of its handle
// (`WasmReadable`, `WasmFuture`). One helper per WIT
// type and bytecode type, `(address) -> value`, following `load` of the
// canonical ABI's specification at the layout `canonical_layout.vader` gives;
// a container calls the helper of its elements.
//
// The bytecode type says how Vader holds the value: the front end checked that
// it holds what the WIT type says (ADR 0179).

module "vader/emit/wasm"

Bc :: import "vader/core/bytecode"
import "std/iter"
import "vader/core/wit"

// The helper reading a value of `t` held as the bytecode type `type_id`, null
// when the bytecode erased the union holding it to a reference: a scalar then
// takes the class its WIT type stores it as (`erased_class`). `holders` says
// which variant of a union holds each part of the value (`canonical_holders`).
canonical_load :: fn(
    ctx: ModuleCtx,
    t: WitType,
    type_id: i32 | null,
    holders: WitHolders,
    function: string,
) -> i32 | WasmUnsupported {
    held_as: string: if type_id == null { "erased" } else { "${type_id}" }
    key :: "canonical.load ${wit_type_text(t)} ${held_as} [${holders_text(holders)}]"
    known :: ctx.helpers[key]
    if known != null {
        return known
    }
    held :: held_type_of(ctx, t, type_id, function) else return held
    lift :: Lift {
        .ctx = ctx,
        .function = function,
        .frame = HelperFrame { .signature = func_of([.I32], [held]) },
    }
    body :: lift.load_body(t, type_id, holders) else return body
    return ctx.define_tree_helper(key, lift.frame, body)
}

// The value type a value of `t` held as `type_id` is held as.
held_type_of :: fn(
    ctx: ModuleCtx,
    t: WitType,
    type_id: i32 | null,
    function: string,
) -> WasmValType | WasmUnsupported {
    class :: held_class(ctx, t, type_id) else return .EqRef
    return value_type_of(class, function)
}

// The class of a scalar of `t` held as `type_id`, null for a reference.
held_class :: fn(ctx: ModuleCtx, t: WitType, type_id: i32 | null) -> Bc.ValType | null {
    if type_id == null {
        return erased_class(t)
    }
    held :: ctx.module.types[type_id]
    if held is Bc.BcScalar | Bc.BcNominal {
        return held.val
    }
    return null
}

// The class Vader holds a scalar or an enum of WIT type `t` in, null for any
// other type: an enum is the unsigned integer its case is stored in.
erased_class :: fn(t: WitType) -> Bc.ValType | null = @partial match t {
    // @partial: every other type is held as a reference.
    is WitScalar -> scalar_class(t)
    is WitEnum   -> case_class(t.cases.len())
    _            -> null
}

scalar_class :: fn(s: WitScalar) -> Bc.ValType = match s {
    .Bool   -> .Bool
    .S8     -> .I8
    .U8     -> .U8
    .S16    -> .I16
    .U16    -> .U16
    .S32    -> .I32
    .U32    -> .U32
    .S64    -> .I64
    .U64    -> .U64
    .F32    -> .F32
    .F64    -> .F64
    .Char   -> .Char
    .String -> .String
}

case_class :: fn(count: i64) -> Bc.ValType = match case_bytes(count) {
    1 -> .U8
    2 -> .U16
    _ -> .U32
}

// `value`, the core value a scalar of `t` crosses as, as Vader holds it: a Vader
// `f32` is an `f64`.
held_from_core :: fn(t: WitType, value: WasmExpression) -> WasmExpression {
    if is_f32(t) {
        return unary(.F64PromoteF32, value)
    }
    return value
}

// `value`, a scalar of `t` as Vader holds it, as the core value it crosses as.
core_from_held :: fn(t: WitType, value: WasmExpression) -> WasmExpression {
    if is_f32(t) {
        return unary(.F32DemoteF64, value)
    }
    return value
}

is_f32 :: fn(t: WitType) -> bool = t is WitScalar && t == .F32

// A load helper being written.
Lift :: struct {
    ctx: ModuleCtx
    function: string
    frame: HelperFrame
}

// The parameter of a load helper: where the value is.
ADDRESS: i32: 0

load_body :: fn(
    l: Lift,
    t: WitType,
    type_id: i32 | null,
    holders: WitHolders,
) -> WasmExpression[] | WasmUnsupported = match t {
    is WitScalar             -> [l.scalar_value(t)]
    is WitEnum               -> [load(case_load(t.cases.len()), local_get(ADDRESS))]
    is WitList               -> l.list_body(t, type_id, holders)
    is WitResult             -> l.result_body(t, type_id, holders)
    is WitOption             -> l.option_body(t, type_id, holders)
    is WitTuple              -> l.sequence_body(t, t.elements, type_id, holders)
    is WitStream | WitFuture -> l.handle_body(type_id)
    is WitHandle             -> l.handle_body(type_id)
    is WitRecord             -> l.sequence_body(t, field_types(t), type_id, holders)
    is WitFlags              -> l.flags_body(t, type_id)
    is WitVariant            -> l.variant_body(t, type_id, holders)
    is WitNotLowered         -> l.no_lift(t)
    is WitUnsupported        -> WasmUnsupported { .reason = "`${l.function}`: ${t.reason}" }
}

no_lift :: fn(l: Lift, t: WitType) -> WasmUnsupported =
    WasmUnsupported { .reason = "`${l.function}`: no lifting yet for `${wit_type_text(t)}`" }

// The load of a case stored in the bytes `case_bytes` gives.
case_load :: fn(count: i64) -> MemoryOp = scalar_load(unsigned_of_bytes(case_bytes(count)))

// The load of the bits of `t`.
flags_load :: fn(t: WitFlags) -> MemoryOp =
    scalar_load(unsigned_of_bytes(flags_bytes(t.flags.len())))

scalar_value :: fn(l: Lift, s: WitScalar) -> WasmExpression {
    at :: local_get(ADDRESS)
    if s == .String {
        return call(canonical_string(l.ctx), [i32_load(at), i32_load(at, 4)])
    }
    return held_from_core(s, load(scalar_load(s), at))
}

scalar_load :: fn(s: WitScalar) -> MemoryOp = match s {
    .Bool | .U8                   -> .I32Load8U
    .S8                           -> .I32Load8S
    .U16                          -> .I32Load16U
    .S16                          -> .I32Load16S
    .S32 | .U32 | .Char | .String -> .I32Load
    .S64 | .U64                   -> .I64Load
    .F32                          -> .F32Load
    .F64                          -> .F64Load
}

// A list: its address and its length, each element read at its size into a new
// storage of the array type `type_id`.
list_body :: fn(
    l: Lift,
    t: WitList,
    type_id: i32 | null,
    holders: WitHolders,
) -> WasmExpression[] | WasmUnsupported {
    array_id :: type_id else return WasmUnsupported { .reason = "`${l.function}`: an erased list" }
    types :: l.ctx.module.types
    array :: types[array_id]
    if array !is Bc.BcArray {
        return WasmUnsupported { .reason = "`${l.function}`: a list held as no array" }
    }
    access :: element_access(types, types[array.element])
    elements :: child_holders(holders, t, 0)
    load_element :: canonical_load(l.ctx, t.element, array.element, elements, l.function)
        else return load_element
    storage_type_index :: storage_type(l.ctx.gc, storage_of_access(access))
    items :: l.frame.local(.I32)
    count :: l.frame.local(.I32)
    storage :: l.frame.local(.EqRef)
    at :: l.frame.local(.I32)
    element_size :: i32_const(size_of(t.element))
    element_address :: i32_add(local_get(items), i32_mul(local_get(at), element_size))
    element :: call(load_element, [element_address])
    length :: i64_extend_i32_u(local_get(count))
    header :: HeaderFields {
        .type_id = i32_const(array_id),
        .element = i32_const(element_code(access)),
        .length = length,
        .capacity = length,
        .storage = local_get(storage),
    }
    return [
        local_set(items, i32_load(local_get(ADDRESS))),
        local_set(count, i32_load(local_get(ADDRESS), 4)),
        local_set(storage, array_new_default(storage_type_index, local_get(count))),
        repeat(
            .I32,
            at,
            count,
            [array_set(storage_type_index, local_get(storage), local_get(at), element)],
        ),
        new_header(l.ctx.gc, header),
    ]
}

// A tuple or a record `t` of `types`: each element read where it lies, into the
// struct `type_id` that holds them in their order.
sequence_body :: fn(
    l: Lift,
    t: WitType,
    types: WitType[],
    type_id: i32 | null,
    holders: WitHolders,
) -> WasmExpression[] | WasmUnsupported {
    struct_id :: type_id else return WasmUnsupported {
        .reason = "`${l.function}`: an erased tuple or record",
    }
    held :: sequence_struct(l.ctx, struct_id, types, l.function) else return held
    starts :: sequence_offsets(types).starts
    elements: WasmExpression[]: []
    for [e, i] in types.indexed() {
        field_type :: held.fields[i].type_index
        load_element :: canonical_load(l.ctx, e, field_type, child_holders(holders, t, i), l.function)
            else return load_element
        elements.push(call(load_element, [i32_add(local_get(ADDRESS), i32_const(starts[i]))]))
    }
    tuple :: struct_type(l.ctx, struct_id, l.function) else return tuple
    return [struct_new(tuple, elements)]
}

// The struct `type_id` that holds a tuple or a record of `types`, a field each.
sequence_struct :: fn(
    ctx: ModuleCtx,
    type_id: i32,
    types: WitType[],
    function: string,
) -> Bc.BcStruct | WasmUnsupported {
    held :: ctx.module.types[type_id]
    if held !is Bc.BcStruct || held.fields.len() != types.len() {
        return WasmUnsupported { .reason = "`${function}`: a tuple or a record held as no struct" }
    }
    return held
}

// Flags: one `bool` per bit, into the struct `type_id` of as many fields.
flags_body :: fn(l: Lift, t: WitFlags, type_id: i32 | null) -> WasmExpression[] | WasmUnsupported {
    struct_id :: type_id else return WasmUnsupported { .reason = "`${l.function}`: erased flags" }
    held :: struct_type(l.ctx, struct_id, l.function) else return held
    bits :: l.frame.local(.I32)
    fields: WasmExpression[]: []
    for i in 0..<t.flags.len() {
        fields.push(i32_and(i32_shr_u(local_get(bits), i32_const(i32(i))), i32_const(1)))
    }
    return [
        local_set(bits, load(flags_load(t), local_get(ADDRESS))),
        struct_new(held, fields),
    ]
}

// The handle of a stream or a future, in the struct `type_id` that holds it.
handle_body :: fn(l: Lift, type_id: i32 | null) -> WasmExpression[] | WasmUnsupported {
    struct_id :: type_id else return WasmUnsupported {
        .reason = "`${l.function}`: an erased handle",
    }
    held :: struct_type(l.ctx, struct_id, l.function) else return held
    return [struct_new(held, [i32_load(local_get(ADDRESS))])]
}

// A result: its case, then the value of that case past it, as the union
// `type_id` holds it: `void` for a side with nothing, the ok side in its wrapper
// when the module wraps it.
result_body :: fn(
    l: Lift,
    t: WitResult,
    type_id: i32 | null,
    holders: WitHolders,
) -> WasmExpression[] | WasmUnsupported {
    union_id :: type_id else return l.no_lift(t)
    error :: t.error else return l.no_lift(t)
    offset :: payload_offset([t.ok, t.error])
    ok_value :: l.ok_value(t, holders, union_id, offset) else return ok_value
    error_holders :: child_holders(holders, t, wit_children(t).len() - 1)
    error_value :: l.side_value(error, error_holders, union_id, offset) else return error_value
    is_ok :: i32_eqz(load(.I32Load8U, local_get(ADDRESS)))
    return [choose(.EqRef, is_ok, ok_value, error_value)]
}

// The ok side of `t`: `void` when it carries nothing.
ok_value :: fn(
    l: Lift,
    t: WitResult,
    holders: WitHolders,
    union_id: i32,
    offset: i32,
) -> WasmExpression | WasmUnsupported {
    ok :: t.ok else return struct_new(l.ctx.gc.void_box, [])
    return l.value_of_side(ok, child_holders(holders, t, 0), holders, union_id, offset)
}

// An option: its case, then the value past it when the case is `some`, as the
// union `type_id` holds it, of the value, in its wrapper when the module wraps
// it, and `null`.
option_body :: fn(
    l: Lift,
    t: WitOption,
    type_id: i32 | null,
    holders: WitHolders,
) -> WasmExpression[] | WasmUnsupported {
    union_id :: type_id else return l.no_lift(t)
    offset :: payload_offset([null, t.value])
    value :: l.value_of_side(t.value, child_holders(holders, t, 0), holders, union_id, offset)
        else return value
    is_none :: i32_eqz(load(.I32Load8U, local_get(ADDRESS)))
    return [choose(.EqRef, is_none, ref_null(), value)]
}

// The value of a side of a result, or of an option, `parent` the holders of the
// result or the option: in the wrapper they name, if any, or as its union holds
// it.
value_of_side :: fn(
    l: Lift,
    t: WitType,
    holders: WitHolders,
    parent: WitHolders,
    union_id: i32,
    offset: i32,
) -> WasmExpression | WasmUnsupported {
    wrapper :: l.wrapper_of(parent) else return l.side_value(t, holders, union_id, offset)
    return l.wrapped(t, wrapper, holders, i32_add(local_get(ADDRESS), i32_const(offset)))
}

// A value of `t` read at `at` into the struct `struct_id` of one field that
// wraps it: the `<Function>Ok` of a returned value, the struct of a case of a
// variant.
wrapped :: fn(
    l: Lift,
    t: WitType,
    struct_id: i32,
    holders: WitHolders,
    at: WasmExpression,
) -> WasmExpression | WasmUnsupported {
    held :: l.ctx.module.types[struct_id]
    if held !is Bc.BcStruct || held.fields.len() != 1 {
        return no_holder(t, l.function)
    }
    field_type :: held.fields[0].type_index
    load_value :: canonical_load(l.ctx, t, field_type, rooted(holders, field_type), l.function)
        else return load_value
    wasm_struct :: struct_type(l.ctx, struct_id, l.function) else return wasm_struct
    return struct_new(wasm_struct, [call(load_value, [at])])
}

// The wrapper of the value of a result or an option, when the module wraps it:
// the struct its holders name in place of the union.
wrapper_of :: fn(l: Lift, holders: WitHolders) -> i32 | null {
    id :: holder_of(holders) else return null
    if l.ctx.module.types[id] is Bc.BcStruct {
        return id
    }
    return null
}

// The value of one side of a result, or of an option, at `offset` past the
// address, as the variant of the union `union_id` its holders name: a variant
// with a payload spreads over the variants of the union.
side_value :: fn(
    l: Lift,
    t: WitType,
    holders: WitHolders,
    union_id: i32,
    offset: i32,
) -> WasmExpression | WasmUnsupported {
    at :: i32_add(local_get(ADDRESS), i32_const(offset))
    if t is WitVariant && wit_children(t).len() > 0 {
        return l.spread_variant(t, holders, union_id, at)
    }
    held :: l.variant_of(union_id, holder_of(holders)) else return no_holder(t, l.function)
    return l.payload_value(t, held, holders, offset)
}

// A variant that is the type `type_id` itself: its enum when no case carries a
// payload, the union of its enum and of the structs of its cases otherwise.
variant_body :: fn(
    l: Lift,
    t: WitVariant,
    type_id: i32 | null,
    holders: WitHolders,
) -> WasmExpression[] | WasmUnsupported {
    if wit_children(t).len() == 0 {
        return [load(case_load(t.cases.len()), local_get(ADDRESS))]
    }
    union_id :: type_id else return l.no_lift(t)
    value :: l.spread_variant(t, holders, union_id, local_get(ADDRESS)) else return value
    return [value]
}

// A variant with a payload, read at `address`, as the union `union_id` holds it:
// the enum of its bare cases, boxed, or the struct of its case with a payload.
spread_variant :: fn(
    l: Lift,
    t: WitVariant,
    holders: WitHolders,
    union_id: i32,
    address: WasmExpression,
) -> WasmExpression | WasmUnsupported {
    cases :: case_types(t)
    case :: l.frame.local(.I32)
    read_case :: local_set(case, load(case_load(cases.len()), address))
    payload_at :: i32_add(address, i32_const(payload_offset(cases)))
    value: WasmExpression | null = null
    if has_bare_cases(t) {
        bare :: l.bare_cases_value(t, holders, union_id, case) else return bare
        value = bare
    }
    carried: i64 = 0
    for [c, i] in t.cases.indexed() {
        payload :: c.type else continue
        case_holders :: child_holders(holders, t, carried)
        carried += 1
        this :: l.case_value(t, payload, case_holders, union_id, payload_at) else return this
        if value == null {
            value = this
        } else {
            value = choose(.EqRef, i32_eq(local_get(case), i32_const(i32(i))), this, value)
        }
    }
    found :: value else return no_holder(t, l.function)
    return sequence([read_case, found])
}

// The bare cases of `t`, the case read into the local `case`: its position
// among the bare cases, boxed as the enum `holders` names.
bare_cases_value :: fn(
    l: Lift,
    t: WitVariant,
    holders: WitHolders,
    union_id: i32,
    case: i32,
) -> WasmExpression | WasmUnsupported {
    enum_id :: l.variant_of(union_id, holder_of(holders)) else return no_holder(t, l.function)
    held :: l.ctx.module.types[enum_id]
    if held !is Bc.BcScalar | Bc.BcNominal {
        return no_holder(t, l.function)
    }
    // The position of the case among the bare ones: each case with a payload
    // before it moves it back by one.
    ordinal: WasmExpression = local_get(case)
    for [c, i] in t.cases.indexed() {
        if c.type != null {
            ordinal = i32_sub(ordinal, binary(.I32GtU, local_get(case), i32_const(i32(i))))
        }
    }
    return struct_new(box_of_class(l.ctx.gc, held.val), [ordinal])
}

// A case of `t` that carries `payload`, read at `payload_at`, in the struct of
// that case `holders` names.
case_value :: fn(
    l: Lift,
    t: WitVariant,
    payload: WitType,
    holders: WitHolders,
    union_id: i32,
    payload_at: WasmExpression,
) -> WasmExpression | WasmUnsupported {
    struct_id :: l.variant_of(union_id, holder_of(holders)) else return no_holder(t, l.function)
    return l.wrapped(payload, struct_id, holders, payload_at)
}

// `id` when it is a variant of the union `union_id`, null otherwise.
variant_of :: fn(l: Lift, union_id: i32, id: i32 | null) -> i32 | null {
    variant :: id else return null
    union :: l.ctx.module.types[union_id]
    if union is Bc.BcUnion && variant in union.variants {
        return variant
    }
    return null
}

no_holder :: fn(t: WitType, function: string) -> WasmUnsupported = WasmUnsupported {
    .reason = "`${function}`: no variant of the union that holds `${wit_type_text(t)}` is known",
}

// The payload of type `t` at `offset` past the address, boxed when it is a
// scalar, as a union holds it.
payload_value :: fn(
    l: Lift,
    t: WitType,
    type_id: i32 | null,
    holders: WitHolders,
    offset: i32,
) -> WasmExpression | WasmUnsupported {
    load_payload :: canonical_load(l.ctx, t, type_id, holders, l.function) else return load_payload
    value :: call(load_payload, [i32_add(local_get(ADDRESS), i32_const(offset))])
    class :: held_class(l.ctx, t, type_id) else return value
    return struct_new(box_of_class(l.ctx.gc, class), [value])
}

// `(address, length) -> atom`: the string of the `length` bytes at `address`.
canonical_string :: fn(ctx: ModuleCtx) -> i32 =
    ctx.helpers["canonical.string"] else define_string(ctx)

define_string :: fn(ctx: ModuleCtx) -> i32 {
    address :: 0
    length :: 1
    frame :: HelperFrame { .signature = func_of([.I32, .I32], [.I32]) }
    bytes :: frame.local(.EqRef)
    at :: frame.local(.I32)
    byte_storage :: storage_type(ctx.gc, .I8)
    byte :: load(.I32Load8U, i32_add(local_get(address), local_get(at)))
    body: WasmExpression[]: [
        local_set(bytes, array_new_default(byte_storage, local_get(length))),
        repeat(.I32, at, length, [array_set(byte_storage, local_get(bytes), local_get(at), byte)]),
        call(ctx.atom_intern(), [local_get(bytes), i32_const(0), local_get(length), i32_const(0)]),
    ]
    return ctx.define_tree_helper("canonical.string", frame, body)
}
