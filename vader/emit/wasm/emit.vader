// vader/emit/wasm/emit: `BytecodeModule` -> `WasmComponent`.
//
// The core module imports first the functions of component interfaces the
// program calls, one per `@extern` naming a `WasmInterface`. One WASM function
// per bytecode function follows, in the same order, so that a function index is
// the bytecode's shifted by the imports; then the functions behind the checked
// ops (`checked.vader`), and last `run`, which calls the entry and is what the
// component exports (`component.vader`). A local keeps its slot as its index:
// WASM counts the parameters first, as the bytecode does.
//
// The scalar code is translated so far: the integer and `bool` values, the
// locals, the calls between the program's functions and to imported ones whose
// types are scalars, the scopes and the branches. Any other op, or a value type
// with no WASM form yet, stops the emission with `WasmUnsupported`, which names
// it.

module "vader/emit/wasm"

Bc :: import "vader/core/bytecode"
import "std/abort"
import "std/collections"
import "std/iter"
import "std/string_builder"
import "vader/emit/virt"

/// Why a program could not be emitted for WASM: it uses what the emitter does
/// not translate yet.
export WasmUnsupported :: struct {
    /// What is missing, worded to follow `vader build: `.
    reason: string
}

WasmUnsupported implements Error -> self.reason

/// Translate a program to the bytes of a `.wasm` file.
///
/// @param m              the program's bytecode.
/// @param entry_mangled  the mangled name of its entry (`entry_function_index`).
/// @return               a component exporting `wasi:cli/run`, whose `run`
///                       calls the entry.
/// @error                `WasmUnsupported` on the first op or value type the
///                       emitter does not translate yet.
export wasm_binary_of :: fn(m: Bc.BytecodeModule, entry_mangled: string) -> u8[] | WasmUnsupported {
    component :: wasm_component_of(m, entry_mangled) else return component
    return encode_component(component)
}

/// Translate a program to a component.
///
/// @param m              the program's bytecode.
/// @param entry_mangled  the mangled name of its entry (`entry_function_index`).
/// @return               the core module of `wasm_module_of` and the interfaces
///                       its imports come from.
/// @error                `WasmUnsupported` on the first op or value type the
///                       emitter does not translate yet, or when the program
///                       has no entry.
export wasm_component_of :: fn(
    m: Bc.BytecodeModule,
    entry_mangled: string,
) -> WasmComponent | WasmUnsupported {
    component :: translate(m, entry_mangled) else return component
    if component.core.exports.len() == 0 {
        return WasmUnsupported { .reason = "the program has no entry for `run` to call" }
    }
    return component
}

/// Translate a program to a core WASM module.
///
/// @param m              the program's bytecode.
/// @param entry_mangled  the mangled name of its entry (`entry_function_index`).
/// @return               the imported functions, one function per bytecode
///                       function in the same order, the functions behind the
///                       checked ops, and `run`, exported, when there is an
///                       entry.
/// @error                `WasmUnsupported` on the first op or value type the
///                       emitter does not translate yet.
export wasm_module_of :: fn(
    m: Bc.BytecodeModule,
    entry_mangled: string,
) -> WasmModule | WasmUnsupported {
    component :: translate(m, entry_mangled) else return component
    return component.core
}

// The core module of `wasm_module_of`, with the interfaces its imports come from.
translate :: fn(m: Bc.BytecodeModule, entry_mangled: string) -> WasmComponent | WasmUnsupported {
    entry :: Bc.entry_function_index(m, entry_mangled)
    takes_arguments :: entry != null && m.functions[entry].signature.params.len() > 0
    ctx :: module_context_of(m, takes_arguments) else return ctx
    functions: WasmFunction[]: []
    for f in m.functions {
        signature :: func_type_of(f) else return signature
        locals :: value_types_of(f.locals.map((l) -> l.val).collect(), f.name) else return locals
        scratch :: Scratch { .first = i32(f.signature.params.len() + locals.len()) }
        body :: body_of(ctx, scratch, f) else return body
        locals.push_all(scratch.locals)
        functions.push(
            WasmFunction {
                .type_index = ctx.types.intern(signature),
                .locals = locals,
                .body = body,
            },
        )
    }
    exports: WasmExport[]: []
    arguments :: ctx.arguments_function()
    // The table is built before the entry runs, when a helper reads it.
    init :: if entry != null && ctx.atoms != null { ctx.atom_init() } else { null }
    functions.push_all(ctx.helper_functions)
    if entry != null {
        run :: run_function(ctx, m.functions[entry], ctx.first_function + entry, init, arguments)
            else return run
        exports.push(
            WasmExport {
                .name = RUN_EXPORT,
                .function_index = ctx.first_function + i32(functions.len()),
            },
        )
        functions.push(run)
    }
    core :: WasmModule {
        .gc_types = ctx.gc.types,
        .globals = ctx.globals,
        .types = ctx.types.types,
        .imports = ctx.imports.functions,
        .functions = functions,
        .exports = exports,
        .data = ctx.segments,
        .table = ctx.table,
        .table_read = ctx.table_read,
        .memory_import = memory_import_of(ctx.imports),
    }
    return WasmComponent {
        .core = core,
        .interfaces = ctx.imports.interfaces,
        .builtins = ctx.imports.builtins,
    }
}

// The canonical built-ins and `get-arguments` read and write the memory the
// component defines.
memory_import_of :: fn(imports: ImportedFunctions) -> string | null {
    if imports.builtins.is_empty() && imports.arguments == null {
        return null
    }
    return CANONICAL_MODULE
}

// The context of `m`'s translation, before its first function: its struct types,
// then the imported functions, which take the first function indices, and its
// globals, which take the first global indices.
module_context_of :: fn(m: Bc.BytecodeModule, takes_arguments: bool) -> ModuleCtx | WasmUnsupported {
    gc :: gc_types_of(m)
    types :: TypeTable { .first = i32(gc.types.len()) }
    imports :: imported_functions(m, types, takes_arguments) else return imports
    return ModuleCtx {
        .module = m,
        .gc = gc,
        .types = types,
        .imports = imports,
        .first_function = i32(imports.functions.len()),
        .first_helper = i32(imports.functions.len() + m.functions.len()),
        .literals = literals_of(m),
        .globals = m.globals.map((g) -> field_type_of(m.types[g.type_id])).collect(),
    }
}

// What the translation of a module carries from one function to the next.
ModuleCtx :: struct {
    module: Bc.BytecodeModule
    gc: GcTypes
    types: TypeTable
    imports: ImportedFunctions
    // The index of the first bytecode function: past the imported ones.
    first_function: i32
    // The index of the first helper: past the bytecode functions.
    first_helper: i32
    // The index of each helper, by what it computes (`checked.vader`).
    helpers: Map<string, i32> = Map<string, i32> {}
    // The helpers, in the order of their indices.
    helper_functions: WasmFunction[] = []
    // The type of each global, in the order of their indices.
    globals: WasmValType[] = []
    // The literals, as the atom table starts with them (`strings.vader`).
    literals: Literals
    // The globals of the atom table, once a helper reads it.
    atoms: AtomGlobals | null = null
    // The passive data segments.
    segments: u8[][] = []
    // The functions of the table, in the order of their slots (`closures.vader`).
    table: i32[] = []
    // The slot of each entry of the table, by what it calls.
    table_slots: Map<string, i32> = Map<string, i32> {}
    // Whether a `call_indirect` reads the table.
    table_read: bool = false
    // The global of the defer stack, once a helper reads it (`closures.vader`).
    defers: i32 | null = null
}

// `run`, the core export the component lifts: it calls `init` when there is one,
// then the entry, at `entry`, on what `arguments` reads when it takes them, and
// returns the case of `result` the host reads, `ok` (0) for an entry that returns
// nothing or 0, `err` (1) for any other code.
run_function :: fn(
    ctx: ModuleCtx,
    entry: Bc.BcFunction,
    index: i32,
    init: i32 | null,
    arguments: i32 | null,
) -> WasmFunction | WasmUnsupported {
    body: WasmInstr[]: []
    if init != null {
        body.push(Call { .function_index = init })
    }
    if arguments != null {
        body.push(Call { .function_index = arguments })
    }
    body.push(Call { .function_index = index })
    results :: result_values(entry.signature.results)
    if results.len() == 0 {
        body.push(I32Const { .value = 0 })
    } else if results.len() == 1 && results[0] == .I32 {
        body.push_all([I32Const { .value = 0 }, Plain { .op = .I32Ne }])
    } else {
        return WasmUnsupported {
            .reason = "`${entry.name}`: an entry returns nothing or an `i32` code",
        }
    }
    run_type :: WasmFuncType { .params = [], .results = [.I32] }
    return WasmFunction {
        .type_index = ctx.types.intern(run_type),
        .locals = [],
        .body = body,
    }
}

// The function types of a module, each once, as the format wants them.
TypeTable :: struct {
    // The index of the first function type: past the struct types.
    first: i32 = 0
    types: WasmFuncType[] = []
    // The position in `types` of each `canonical_func_type_key`.
    positions: Map<string, i32> = Map<string, i32> {}
}

// The type index of `t`, appended to the table when it is not there yet.
intern :: fn(table: TypeTable, t: WasmFuncType) -> i32 {
    position :: table.positions.get_or_put(canonical_func_type_key(t), i32(table.types.len()))
    if position == table.types.len() {
        table.types.push(t)
    }
    return table.first + position
}

// The locals a function's translation adds past the bytecode's, one per value
// type, which an op uses only within its own instructions.
Scratch :: struct {
    // The index of the first: past the parameters and the bytecode's locals.
    first: i32
    locals: WasmValType[] = []
}

// The scratch local of type `t`, added the first time it is asked for.
local_of :: fn(scratch: Scratch, t: WasmValType) -> i32 = scratch.spill_local(t, 0)

// The scratch local of type `t` past `before` others of that type: values kept
// aside together each take their own.
spill_local :: fn(scratch: Scratch, t: WasmValType, before: i64) -> i32 {
    seen: i64 = 0
    for i in 0..<scratch.locals.len() {
        if scratch.locals[i] == t {
            if seen == before {
                return scratch.first + i32(i)
            }
            seen += 1
        }
    }
    for seen <= before {
        scratch.locals.push(t)
        seen += 1
    }
    return scratch.first + i32(scratch.locals.len() - 1)
}

canonical_func_type_key :: fn(t: WasmFuncType) -> string {
    sb :: StringBuilder {}
    for p in t.params {
        sb.append("${value_type_byte(p)},")
    }
    sb.append("->")
    for r in t.results {
        sb.append("${value_type_byte(r)},")
    }
    return sb.to_string()
}

func_type_of :: fn(f: Bc.BcFunction) -> WasmFuncType | WasmUnsupported {
    params :: value_types_of(f.signature.params, f.name) else return params
    results :: value_types_of(result_values(f.signature.results), f.name) else return results
    return WasmFuncType { .params = params, .results = results }
}

// The function a `call` of `function_index` reaches, its arguments on top of
// `stack`: the function itself when each argument is held as it takes it, else a
// helper that brings each one to its form first. The bytecode passes a scalar
// unboxed to the `Any` parameter of a generic instance, which the VM does not
// tell apart.
call_target :: fn(
    ctx: ModuleCtx,
    stack: OperandStack,
    function_index: i32,
    function: string,
) -> i32 | WasmUnsupported {
    direct :: ctx.first_function + function_index
    callee :: ctx.module.functions[function_index]
    params :: value_types_of(callee.signature.params, callee.name) else return params
    if held_alike(stack, params) {
        return direct
    }
    site :: site_of(stack, params.len())
    results :: value_types_of(result_values(callee.signature.results), callee.name)
        else return results
    signature :: WasmFuncType { .params = site, .results = results }
    key :: "call ${function_index} ${canonical_func_type_key(signature)}"
    known :: ctx.helpers[key]
    if known != null {
        return known
    }
    body: WasmInstr[]: []
    for i in 0..<params.len() {
        body.push(LocalGet { .index = i32(i) })
        class :: if params[i] == .EqRef { class_held_as(site[i]) } else {
            callee.signature.params[i]
        }
        adapted :: body.push_adapted(ctx, site[i], class, params[i], function) else return adapted
    }
    body.push(Call { .function_index = direct })
    return ctx.define_helper(key, signature, [], body)
}

// Whether the `params.len()` values on top of `stack` are held as `params` are.
held_alike :: fn(stack: OperandStack, params: WasmValType[]) -> bool {
    base :: stack.types.len() - params.len()
    for i in 0..<params.len() {
        if stack.types[base + i] != params[i] {
            return false
        }
    }
    return true
}

// The class a value held as `held` is boxed in where nothing names it: the
// signed class of its form, as the VM's value of that form reads (`I32Val`,
// `I64Val`, `F64Val`). A reference needs no box.
class_held_as :: fn(held: WasmValType) -> Bc.ValType = match held {
    .I32        -> .I32
    .I64        -> .I64
    .F32 | .F64 -> .F64
    .EqRef      -> .Any
}

// The values a call leaves: none for a `void` one, whose results still carry
// one `Void` entry.
result_values :: fn(results: Bc.ValType[]) -> Bc.ValType[] =
    if Bc.bc_results_arity(results) == 0 { [] } else { results }

value_types_of :: fn(values: Bc.ValType[], function: string) -> WasmValType[] | WasmUnsupported {
    out: WasmValType[]: []
    for v in values {
        t :: value_type_of(v, function) else return t
        out.push(t)
    }
    return out
}

value_type_of :: fn(v: Bc.ValType, function: string) -> WasmValType | WasmUnsupported = match v {
    .I8 | .I16 | .I32 | .I64 | .U8 | .U16 | .U32 | .U64 | .F32 | .F64 | .Bool | .Char | .String
        | .Ref | .Any | .Null -> scalar_field_type(v)
    .Void | .Pointer -> WasmUnsupported {
        .reason = "`${function}`: no WASM form yet for a `${Bc.val_type_name(v)}` value",
    }
}

// ---- bodies ---------------------------------------------------------------

// The instructions of `f`. A body that leaves a value ends on `unreachable`:
// WASM checks the end of a body as reachable, after scopes whose every path
// returned included.
body_of :: fn(ctx: ModuleCtx, scratch: Scratch, f: Bc.BcFunction) -> WasmInstr[] | WasmUnsupported {
    ends :: matching_ends(f.body)
    // Per open scope, the pc a branch that leaves it targets, less one: a loop
    // starts again right after its opener, a block or an `if` goes on right
    // after its `End`.
    anchors: i64[]: []
    stack :: OperandStack {}
    out: WasmInstr[]: []
    for pc in 0..<f.body.len() {
        op :: f.body[pc]
        match op {
            is Bc.Block | Bc.Loop | Bc.If -> {
                anchors.push(if op is Bc.Loop { pc } else { ends[pc] })
                out.push_plain(scope_opener(op))
            }
            is Bc.Else                    -> {
                out.push_plain(.Else)
            }
            is Bc.End                     -> {
                anchors.drop_last()
                out.push_plain(.End)
            }
            is Bc.Branch | Bc.BranchIf    -> {
                depth :: branch_depth(anchors, f.jump_table[pc]) else {
                    return WasmUnsupported {
                        .reason = "`${f.name}`: the branch at pc ${pc} leaves no open scope",
                    }
                }
                out.push(branch_to(op, depth))
            }
            is Bc.RefCast                 -> {
                pinned :: push_pin(ctx, out, op, stack.types.last(), f.name) else return pinned
            }
            _                             -> {
                pushed :: push_op(ctx, scratch, stack, out, op, f.name) else return pushed
            }
        }
        stepped :: step(ctx, f, stack, op) else return stepped
    }
    if Bc.bc_result_arity(f.signature) > 0 {
        out.push_plain(.Unreachable)
    }
    return out
}

scope_opener :: fn(op: Bc.Block | Bc.Loop | Bc.If) -> WasmOp = match op {
    is Bc.Block -> .Block
    is Bc.Loop  -> .Loop
    is Bc.If    -> .If
}

branch_to :: fn(op: Bc.Branch | Bc.BranchIf, depth: i32) -> WasmInstr = match op {
    is Bc.Branch   -> Br { .depth = depth }
    is Bc.BranchIf -> BrIf { .depth = depth }
}

// The pc of the `End` that closes the scope each opener opens, -1 elsewhere.
// `Else` keeps its `If` open.
matching_ends :: fn(body: Bc.Op[]) -> i64[] {
    ends: i64[]: [-1] * body.len()
    open: i64[]: []
    for pc in 0..<body.len() {
        op :: body[pc]
        if op is Bc.Block | Bc.Loop | Bc.If {
            open.push(pc)
        } else if op is Bc.End {
            opener :: open.remove_last() else panic("bytecode: an `end` closes no scope")
            ends[opener] = pc
        }
    }
    return ends
}

// The WASM depth of the open scope a branch to `target_pc` leaves, the
// innermost first, as `vader/emit/virt` reads it.
branch_depth :: fn(anchors: i64[], target_pc: i32) -> i32 | null {
    i: i64 = anchors.len() - 1
    for i >= 0 {
        if anchors[i] + 1 == target_pc {
            return i32(anchors.len() - 1 - i)
        }
        i -= 1
    }
    return null
}

push_plain :: fn(out: WasmInstr[], op: WasmOp) -> void = out.push(Plain { .op = op })

// Append the translation of `op`, which is not a scope, a branch or a `ref.cast`.
// `stack` holds the values under it.
push_op :: fn(
    ctx: ModuleCtx,
    scratch: Scratch,
    stack: OperandStack,
    out: WasmInstr[],
    op: Bc.Op,
    function: string,
) -> void | WasmUnsupported {
    plain :: plain_op_of(op)
    if plain != null {
        out.push_plain(plain)
        return
    }
    match op {
        is Bc.I32Const | Bc.I64Const | Bc.F64Const | Bc.BoolConst | Bc.CharConst
            | Bc.StringConst -> {
            literal :: constant_of(ctx, op, function) else return literal
            out.push(literal)
        }
        is Bc.ReturnLit -> {
            literal :: constant_of(ctx, op.value, function) else return literal
            out.push(literal)
            out.push_plain(.Return)
        }
        is Bc.LocalGet -> { out.push(LocalGet { .index = op.slot }) }
        is Bc.LocalSet -> { out.push(LocalSet { .index = op.slot }) }
        is Bc.LocalTee -> { out.push(LocalTee { .index = op.slot }) }
        is Bc.GlobalGet -> { out.push(GlobalGet { .index = op.index }) }
        is Bc.GlobalSet -> { out.push(GlobalSet { .index = op.index }) }
        is Bc.Call -> {
            index :: ctx.call_target(stack, op.function_index, function) else return index
            out.push(Call { .function_index = index })
        }
        is Bc.CallImport -> {
            index :: ctx.imported_function(op, function) else return index
            out.push(Call { .function_index = index })
        }
        is Bc.VirtualCall -> { return push_virtual_call(ctx, stack, out, op, function) }
        is ClosureOp -> { return push_closure_op(ctx, stack, out, op, function) }
        is Bc.BufferNew -> { out.push(Call { .function_index = ctx.buffer_new() }) }
        is Bc.BufferWriteString -> {
            out.push(Call { .function_index = ctx.buffer_write_string() })
        }
        is Bc.BufferToString -> { out.push(Call { .function_index = ctx.buffer_to_string() }) }
        is Bc.StringCompare -> { out.push(Call { .function_index = ctx.string_compare() }) }
        is Bc.LoadU8 -> { out.push(Call { .function_index = ctx.buffer_load_u8() }) }
        is Bc.StoreU8 -> { out.push(Call { .function_index = ctx.buffer_store_u8() }) }
        is Bc.MemoryCopy -> { out.push(Call { .function_index = ctx.buffer_memory_copy() }) }
        // WASM has no negation or complement: times -1, and xor with -1.
        is Bc.I32Neg -> { out.push_all([I32Const { .value = -1 }, Plain { .op = .I32Mul }]) }
        is Bc.I64Neg -> { out.push_all([I64Const { .value = -1 }, Plain { .op = .I64Mul }]) }
        is Bc.I32BitNot -> { out.push_all([I32Const { .value = -1 }, Plain { .op = .I32Xor }]) }
        is Bc.I64BitNot -> { out.push_all([I64Const { .value = -1 }, Plain { .op = .I64Xor }]) }
        is Bc.Convert -> { return push_convert(ctx, out, op, stack.types.last(), function) }
        is Bc.F32ToBits -> {
            out.push_all([Plain { .op = .F32DemoteF64 }, Plain { .op = .I32ReinterpretF32 }])
        }
        is Bc.BitsToF32 -> {
            out.push_all([Plain { .op = .F32ReinterpretI32 }, Plain { .op = .F64PromoteF32 }])
        }
        is Bc.CheckedArith -> {
            out.push(Call { .function_index = ctx.checked_helper(op.kind, op.op) })
        }
        is Bc.CheckedNeg -> { out.push(Call { .function_index = ctx.checked_neg_helper(op.kind) }) }
        is Bc.NullConst -> { out.push(RefNull {}) }
        is Bc.TypeConst -> { out.push(Call { .function_index = ctx.type_constant(op.type_id) }) }
        is Bc.SizeOfType -> { out.push(Call { .function_index = ctx.size_of_type() }) }
        is Bc.VoidConst -> { out.push(StructNew { .type_index = ctx.gc.void_box }) }
        is Bc.StructNew -> {
            t :: struct_type(ctx, op.type_id, function) else return t
            out.push(StructNew { .type_index = t })
        }
        is Bc.StructGet -> {
            return push_field_read(ctx, out, op.type_id, op.field_index, function)
        }
        is Bc.LocalField -> {
            out.push(LocalGet { .index = op.slot })
            return push_field_read(ctx, out, op.type_id, op.field_index, function)
        }
        is Bc.StructSet -> { return push_field_write(ctx, scratch, out, op, function) }
        is Bc.UnionFieldGet | Bc.UnionFieldSet -> {
            index :: ctx.union_field(op, function) else return index
            out.push(Call { .function_index = index })
        }
        is Bc.Retag -> { return push_retag(ctx, out, op, function) }
        is Bc.TypeCheck -> { return push_single_test(ctx, out, op.type_id, function) }
        is Bc.ArrayNew | Bc.ArrayReserve | Bc.ArrayLen | Bc.ArrayClear | Bc.ArrayGet | Bc.ArraySet
            | Bc.ArrayPush | Bc.ArrayRemoveLast | Bc.ArraySlice | Bc.ArrayRepeat | Bc.ArrayPushAll
            | Bc.ArrayCopy | Bc.DataConst | Bc.LoadSlotI32 | Bc.LoadSlotI64 | Bc.LoadSlotF64
            | Bc.StoreSlotI32 | Bc.StoreSlotI64 | Bc.StoreSlotF64 -> {
            return push_array_op(ctx, scratch, stack, out, op, function)
        }
        is Bc.RefEq -> { out.push(Call { .function_index = ctx.reference_equality() }) }
        is Bc.RefNe -> {
            out.push(Call { .function_index = ctx.reference_equality() })
            out.push_plain(.I32Eqz)
        }
        _ -> { return unsupported_op(op, function) }
    }
}

// The one WASM instruction an op is, when it is one.
//
// @partial: the ops whose translation takes more than one plain instruction, or
// none yet, are `push_op`'s.
plain_op_of :: fn(op: Bc.Op) -> WasmOp | null = @partial match op {
    is Bc.Unreachable -> .Unreachable
    is Bc.Return      -> .Return
    is Bc.Drop        -> .Drop
    is Bc.I32Add      -> .I32Add
    is Bc.I32Sub      -> .I32Sub
    is Bc.I32Mul      -> .I32Mul
    is Bc.I32Div      -> .I32DivS
    is Bc.I32Mod      -> .I32RemS
    is Bc.U32Div      -> .I32DivU
    is Bc.U32Mod      -> .I32RemU
    is Bc.I32Eq       -> .I32Eq
    is Bc.I32Ne       -> .I32Ne
    is Bc.I32Lt       -> .I32LtS
    is Bc.I32Le       -> .I32LeS
    is Bc.I32Gt       -> .I32GtS
    is Bc.I32Ge       -> .I32GeS
    is Bc.U32Lt       -> .I32LtU
    is Bc.U32Le       -> .I32LeU
    is Bc.U32Gt       -> .I32GtU
    is Bc.U32Ge       -> .I32GeU
    is Bc.I32BitAnd   -> .I32And
    is Bc.I32BitOr    -> .I32Or
    is Bc.I32BitXor   -> .I32Xor
    is Bc.I32Shl      -> .I32Shl
    is Bc.I32Shr      -> .I32ShrS
    is Bc.I32ShrU     -> .I32ShrU
    is Bc.I64Add      -> .I64Add
    is Bc.I64Sub      -> .I64Sub
    is Bc.I64Mul      -> .I64Mul
    is Bc.I64Div      -> .I64DivS
    is Bc.I64Mod      -> .I64RemS
    is Bc.U64Div      -> .I64DivU
    is Bc.U64Mod      -> .I64RemU
    is Bc.I64Eq       -> .I64Eq
    is Bc.I64Ne       -> .I64Ne
    is Bc.I64Lt       -> .I64LtS
    is Bc.I64Le       -> .I64LeS
    is Bc.I64Gt       -> .I64GtS
    is Bc.I64Ge       -> .I64GeS
    is Bc.U64Lt       -> .I64LtU
    is Bc.U64Le       -> .I64LeU
    is Bc.U64Gt       -> .I64GtU
    is Bc.U64Ge       -> .I64GeU
    is Bc.I64BitAnd   -> .I64And
    is Bc.I64BitOr    -> .I64Or
    is Bc.I64BitXor   -> .I64Xor
    is Bc.I64Shl      -> .I64Shl
    is Bc.I64Shr      -> .I64ShrS
    is Bc.I64ShrU     -> .I64ShrU
    is Bc.BoolEq      -> .I32Eq
    is Bc.BoolNe      -> .I32Ne
    is Bc.BoolAnd     -> .I32And
    is Bc.BoolOr      -> .I32Or
    is Bc.BoolNot     -> .I32Eqz
    // A string is an atom: two strings with the same bytes are the same atom.
    is Bc.StringEq    -> .I32Eq
    is Bc.StringNe    -> .I32Ne
    is Bc.F64Add      -> .F64Add
    is Bc.F64Sub      -> .F64Sub
    is Bc.F64Mul      -> .F64Mul
    is Bc.F64Div      -> .F64Div
    is Bc.F64Neg      -> .F64Neg
    is Bc.F64Eq       -> .F64Eq
    is Bc.F64Ne       -> .F64Ne
    is Bc.F64Lt       -> .F64Lt
    is Bc.F64Le       -> .F64Le
    is Bc.F64Gt       -> .F64Gt
    is Bc.F64Ge       -> .F64Ge
    is Bc.F64ToBits   -> .I64ReinterpretF64
    is Bc.BitsToF64   -> .F64ReinterpretI64
    _                 -> null
}

// The function a call to the import of `op` reaches: the import of a component
// interface, or the helper behind a member of `Intrinsic`.
imported_function :: fn(
    ctx: ModuleCtx,
    op: Bc.CallImport,
    function: string,
) -> i32 | WasmUnsupported {
    if op.index in ctx.imports.adapted {
        return ctx.canonical_adapter(op.index, function)
    }
    imported :: ctx.imports.by_bytecode_index[op.index]
    if imported != null {
        return imported
    }
    imp :: ctx.module.imports[op.index]
    if imp.intrinsic == .NotIntrinsic {
        return unsupported_op(op, function)
    }
    return intrinsic_function(ctx, imp, function)
}

// `(message: atom) -> ()`: runs every pending defer, the last pushed first, as
// the VM unwinds, then stops the run. The message reaches no stream yet:
// writing it needs the WASI stderr the library imports, which the emitter does
// not name.
panic_function :: fn(ctx: ModuleCtx) -> i32 {
    known :: ctx.helpers["panic"]
    if known != null {
        return known
    }
    body: WasmInstr[]: []
    body.push_defer_count(ctx)
    body.push_all(
        [
            Plain { .op = .I32WrapI64 },
            Call { .function_index = ctx.defer_pop_exec() },
            Plain { .op = .Unreachable },
        ],
    )
    signature :: WasmFuncType { .params = [.I32], .results = [] }
    return ctx.define_helper("panic", signature, [], body)
}

// The function a call to the `Intrinsic` member `imp` reaches.
intrinsic_function :: fn(
    ctx: ModuleCtx,
    imp: Bc.BcImport,
    function: string,
) -> i32 | WasmUnsupported {
    // @partial: the members with no WASM form yet stop the emission.
    return @partial match imp.intrinsic {
        .ByteLen       -> ctx.string_byte_len()
        .ByteAt        -> ctx.string_byte_at()
        .ByteSlice     -> ctx.string_byte_slice()
        .IsAscii       -> ctx.string_is_ascii()
        .BytesToString -> ctx.bytes_to_string()
        .Bytes         -> ctx.string_bytes(imp.signature.result_types[0])
        .StringHash    -> ctx.string_hash()
        .AbortPanic    -> ctx.panic_function()
        _              -> WasmUnsupported {
            .reason = "`${function}`: no WASM form yet for `${imp.extern_name}`",
        }
    }
}

constant_of :: fn(
    ctx: ModuleCtx,
    c: Bc.ConstOp,
    function: string,
) -> WasmInstr | WasmUnsupported = match c {
    is Bc.I32Const    -> I32Const { .value = c.value }
    is Bc.I64Const    -> I64Const { .value = c.value }
    is Bc.BoolConst   -> I32Const { .value = if c.value { 1 } else { 0 } }
    is Bc.CharConst   -> I32Const { .value = i32(c.value) }
    is Bc.NullConst   -> RefNull {}
    is Bc.StringConst -> I32Const { .value = ctx.literals.atom_of[c.index] }
    is Bc.F64Const    -> F64Const { .value = c.value }
}

// A conversion between storage classes: an integer of 32 bits or less and a
// `char` share the `i32`, a 64-bit integer the `i64`, a float the `f64`. An
// unsigned source widens with zeros. A float becomes an integer as the VM makes
// it one, through an `i64` (`i32(i64(x))`), saturated where it does not fit. A
// source still boxed, `source` held as a reference, is unboxed first: the result
// of a generic call, say.
push_convert :: fn(
    ctx: ModuleCtx,
    out: WasmInstr[],
    op: Bc.Convert,
    source: WasmValType | null,
    function: string,
) -> void | WasmUnsupported {
    from :: Bc.parse_val_type(op.from_name) else return unsupported_op(op, function)
    from_class :: value_type_of(from, function) else return from_class
    if source == WasmValType.EqRef && from_class != .EqRef {
        unboxed :: out.push_adapted(ctx, .EqRef, from, from_class, function) else return unboxed
    }
    match op.target {
        .I32 | .Char -> {
            if from_class == .F64 {
                out.push_plain(.I64TruncSatF64S)
            }
            if from_class != .I32 {
                out.push_plain(.I32WrapI64)
            }
        }
        .I64         -> {
            if from_class == .I32 {
                out.push_plain(widening_of(from))
            }
            if from_class == .F64 {
                out.push_plain(.I64TruncSatF64S)
            }
        }
        .F64         -> {
            if from_class != .F64 {
                out.push_plain(float_of(from))
            }
        }
    }
}

// The conversion of an integer of `from` to an `f64`.
float_of :: fn(from: Bc.ValType) -> WasmOp {
    unsigned :: Bc.is_unsigned_val(from) || from == .Char
    if from == .I64 || from == .U64 {
        return if unsigned { .F64ConvertI64U } else { .F64ConvertI64S }
    }
    return if unsigned { .F64ConvertI32U } else { .F64ConvertI32S }
}

widening_of :: fn(from: Bc.ValType) -> WasmOp =
    if Bc.is_unsigned_val(from) { .I64ExtendI32U } else { .I64ExtendI32S }

unsupported_op :: fn(op: Bc.Op, function: string) -> WasmUnsupported {
    sb :: StringBuilder {}
    sb.write_op(op)
    return WasmUnsupported {
        .reason = "`${function}`: no WASM translation yet for `${sb.to_string()}`",
    }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"
import "vader/core/wit"

// A program of one function, the entry, returning an `i32` through `body`.
program_of :: fn(body: Bc.Op[], jump_table: i32[]) -> Bc.BytecodeModule {
    signature :: Bc.BcSignature {
        .params = [],
        .results = [.I32],
        .param_types = [],
        .result_types = [2],
        .param_names = [],
    }
    main :: Bc.BcFunction {
        .name = "snippet\$main",
        .is_main = true,
        .signature = signature,
        .locals = [],
        .body = body,
        .debug = [],
        .jump_table = jump_table,
    }
    return Bc.BytecodeModule {
        .name = "_main",
        .types = [],
        .strings = [],
        .data_pool = [],
        .functions = [main],
        .imports = [],
        .exports = [],
        .impl_table = [],
        .vtables = [],
    }
}

// No branch: every op jumps nowhere.
straight :: fn(body: Bc.Op[]) -> Bc.BytecodeModule = program_of(body, [-1] * body.len())

@test
test_wasm_module_of_returns_a_constant :: fn() -> void {
    program :: straight([Bc.ReturnLit { .value = Bc.I32Const { .value = 42 } }])
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    assert_eq(wasm.types.len(), 1)
    assert(
        wasm.types[0].results.len() == 1 && wasm.types[0].results[0] == .I32,
        "main returns one i32",
    )
    // The constant, `return`, then the `unreachable` that closes a body
    // leaving a value.
    assert_eq(wasm.functions[0].body.len(), 3)
    assert_eq(wasm.exports[0].name, RUN_EXPORT)
}

// `run` calls the entry and turns its code into the case of `result`.
@test
test_run_calls_the_entry_and_tests_its_code :: fn() -> void {
    program :: straight([Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } }])
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    run :: wasm.functions[wasm.exports[0].function_index].body
    call :: run[0]
    assert(call is Call && call.function_index == 0, "run calls main")
    code_test :: run[2]
    assert(code_test is Plain && code_test.op == .I32Ne, "a code other than 0 is `err`")
}

// An import from an interface comes first among the functions, and a call to it
// names it there.
@test
test_an_interface_import_precedes_the_functions :: fn() -> void {
    program :: straight(
        [
            Bc.CallImport { .index = 0 },
            Bc.Drop {},
            Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } },
        ],
    )
    signature :: Bc.BcSignature {
        .params = [],
        .results = [.U64],
        .param_types = [],
        .result_types = [0],
        .param_names = [],
    }
    clock :: WasmInterface {
        .package = "wasi:clocks",
        .name = "monotonic-clock",
        .version = "0.3.0",
    }
    program.imports.push(
        Bc.BcImport {
            .extern_name = "now",
            .mangled_name = "clock\$now",
            .signature = signature,
            .is_extern = true,
            .wasm_interface = clock,
            .wit = WitFunction { .params = [], .result = .U64 },
        },
    )
    component :: wasm_component_of(program, "") else panic(component.reason)
    assert_eq(component.core.imports[0].module, "wasi:clocks/monotonic-clock@0.3.0")
    call :: component.core.functions[0].body[0]
    assert(call is Call && call.function_index == 0, "the call names the import")
    assert_eq(component.core.exports[0].function_index, 2)
    now :: component.interfaces[0].functions[0]
    assert(now.type.result is WitScalar, "`now` returns a WIT scalar")
}

@test
test_an_entry_taking_argv_reads_get_arguments :: fn() -> void {
    program :: straight([Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } }])
    program.functions[0].signature.params = [.Ref]
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    assert(wasm.imports[0].name == "get-arguments", "`get-arguments` is imported")
    assert(wasm.memory_import != null, "the host writes the arguments into the memory")
}

@test
test_wasm_module_of_names_an_unsupported_op :: fn() -> void {
    body: Bc.Op[]: [Bc.LoadF64 {}, Bc.Return {}]
    failure :: wasm_module_of(straight(body), "")
    assert(failure is WasmUnsupported, "a float read in a buffer is not translated yet")
    if failure is WasmUnsupported {
        assert(failure.reason.contains("load_f64"), "the reason names the op")
    }
}

// A bytecode global takes the first global index, held as its type is.
@test
test_a_bytecode_global_takes_the_first_global :: fn() -> void {
    body: Bc.Op[]: [
        Bc.GlobalGet { .index = 0 },
        Bc.Drop {},
        Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } },
    ]
    program :: straight(body)
    program.types = [Bc.BcScalar { .val = .I64 }]
    program.globals = [Bc.BcGlobal { .name = "count", .type_id = 0 }]
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    assert(wasm.globals.len() == 1 && wasm.globals[0] == .I64, "one `i64` global")
    read :: wasm.functions[0].body[0]
    assert(read is GlobalGet && read.index == 0, "read at index 0")
}

// A scalar passed unboxed to the `Any` parameter of a generic instance goes
// through a helper that boxes it.
@test
test_a_scalar_passed_to_an_any_parameter_is_boxed :: fn() -> void {
    body: Bc.Op[]: [Bc.I32Const { .value = 7 }, Bc.Call { .function_index = 1 }, Bc.Return {}]
    program :: straight(body)
    twice :: Bc.BcFunction {
        ...program.functions[0],
        .name = "twice",
        .is_main = false,
        .signature = Bc.BcSignature { ...program.functions[0].signature, .params = [.Any] },
        .body = [Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } }],
        .jump_table = [-1],
    }
    program.functions.push(twice)
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    call :: wasm.functions[0].body[1]
    assert(call is Call && call.function_index == 2, "main calls the helper, not `twice`")
    i32_box :: gc_types_of(program).of_box[.I32] else -1
    boxed :: wasm.functions[2].body.filter_is<StructNew>().collect()
    assert(boxed.len() == 1 && boxed[0].type_index == i32_box, "the helper boxes the `i32`")
}

// Two values of one type are one reference, made once.
@test
test_a_type_value_is_made_once :: fn() -> void {
    body: Bc.Op[]: [
        Bc.TypeConst { .type_id = 0 },
        Bc.TypeConst { .type_id = 0 },
        Bc.RefEq {},
        Bc.Return {},
    ]
    program :: straight(body)
    program.types = [Bc.BcScalar { .val = .I32 }]
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    calls :: wasm.functions[0].body.filter_is<Call>().collect()
    assert(calls[0].function_index == calls[1].function_index, "both read one cached value")
}

// A float becomes an `i32` through a saturated `i64`, as the VM converts it.
@test
test_a_float_converts_to_an_i32_through_an_i64 :: fn() -> void {
    body: Bc.Op[]: [
        Bc.F64Const { .value = 2.5 },
        Bc.Convert { .from_name = "f64", .target = .I32 },
        Bc.Return {},
    ]
    wasm :: wasm_module_of(straight(body), "") else panic(wasm.reason)
    instrs :: wasm.functions[0].body
    constant :: instrs[0]
    assert(constant is F64Const && constant.value == 2.5, "the constant is an `f64.const`")
    truncated :: instrs[1]
    wrapped :: instrs[2]
    assert(truncated is Plain && truncated.op == .I64TruncSatF64S, "saturated to an `i64`")
    assert(wrapped is Plain && wrapped.op == .I32WrapI64, "then wrapped")
}

// `loop { br_if 0 } ; block { br 0 }`: the loop's branch starts it again, the
// block's goes on past its `end`.
@test
test_branch_depth_of_a_loop_and_a_block :: fn() -> void {
    body: Bc.Op[]: [
        Bc.Loop {},
        Bc.BoolConst { .value = false },
        Bc.BranchIf {},
        Bc.End {},
        Bc.Block {},
        Bc.Block {},
        Bc.Branch {},
        Bc.End {},
        Bc.End {},
        Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } },
    ]
    jump_table: i32[]: [-1, -1, 1, -1, -1, -1, 9, -1, -1, -1]
    wasm :: wasm_module_of(program_of(body, jump_table), "") else panic(wasm.reason)
    instrs :: wasm.functions[0].body
    loop_branch :: instrs[2]
    assert(loop_branch is BrIf && loop_branch.depth == 0, "the loop starts again")
    block_branch :: instrs[6]
    assert(block_branch is Br && block_branch.depth == 1, "the branch leaves both blocks")
}

@test
test_a_checked_add_calls_one_helper_per_class :: fn() -> void {
    body: Bc.Op[]: [
        Bc.I32Const { .value = 1 },
        Bc.I32Const { .value = 2 },
        Bc.CheckedArith { .kind = .I32, .op = .Add },
        Bc.I32Const { .value = 3 },
        Bc.CheckedArith { .kind = .I32, .op = .Add },
        Bc.Return {},
    ]
    wasm :: wasm_module_of(straight(body), "") else panic(wasm.reason)
    // `main`, the helper, `run`.
    assert_eq(wasm.functions.len(), 3)
    first :: wasm.functions[0].body[2]
    second :: wasm.functions[0].body[4]
    assert(first is Call && first.function_index == 1, "the helper follows main")
    assert(second is Call && second.function_index == 1, "and serves both adds")
}
