// vader/emit/wasm/canonical: the calls to the functions of an interface.
//
// A call whose arguments or result are more than scalars Vader holds as the
// core function takes them goes through an adapter, a helper with the Vader
// signature (`needs_adapter`). It lowers the arguments: a stream (an array)
// is opened, passed by its readable end, then written whole and closed after the
// call. It calls the import, then lifts the result (`canonical_lift.vader`): one
// too large to come back flat is read from the room it was written to, a stream
// or a future the call returns is held as the handle the host gave
// (`WasmReadable`, `WasmFuture`), which the program reads and waits for later
// (`canonical_wait.vader`). An async function is called async and waited for, so
// the call is synchronous on the Vader side. The arena is released before the
// adapter returns (`arena.vader`).
//
// The adapter reaches the host through the canonical built-ins
// (`stream.new`, `stream.write`, `future.read`, the waitable sets), which the
// core module imports from `CANONICAL_MODULE` with the linear memory they read and
// write. The component defines both (`component.vader`).
//
// The memory holds, from address 0: the event a wait reports, the top of the
// arena, a list being lifted, the items of a stream, copied out of their GC
// array or read from the host one chunk at a time, then the arena.

module "vader/emit/wasm"

Bc :: import "vader/core/bytecode"
import "std/abort"
import "std/collections"
import "std/iter"
import "vader/core/wit"

/// The module name the core module imports the canonical built-ins and the
/// memory under.
export CANONICAL_MODULE: string: "canonical"

/// A canonical built-in the core module imports.
export CanonicalBuiltin :: struct {
    kind: CanonicalKind
    /// The stream or future type it works on, null for a waitable set.
    type: WitType | null = null
}

/// The canonical built-ins an adapter calls.
export CanonicalKind :: enum {
    StreamNew,
    StreamRead,
    StreamWrite,
    StreamCancelRead,
    StreamDropReadable,
    StreamDropWritable,
    FutureRead,
    FutureDropReadable,
    WaitableSetNew,
    WaitableJoin,
    WaitableSetWait,
    WaitableSetPoll,
    WaitableSetDrop,
    SubtaskCancel,
    SubtaskDrop,
}

// Where the memory holds what crosses it: the event a wait reports (the
// waitable, then the payload), the top of the arena (`arena.vader`), the address
// and the length of a list being lifted, the chunk of a stream being written or
// read, then the arena.
EVENT_ADDRESS: i32: 0
EVENT_PAYLOAD: i32: 4
LIST_ADDRESS: i32: 16
CHUNK_ADDRESS: i32: 1024
CHUNK_SIZE: i32: 4096
ALLOCATION_ADDRESS: i32: CHUNK_ADDRESS + CHUNK_SIZE

// What a built-in that starts a copy returns when the copy has to wait.
BLOCKED: i32: -1

// The low bits of a copy's result say how it ended, the others how many items
// it moved. A copy that did not complete, the other end dropped, ends a stream.
COPY_STATUS_MASK: i32: 0xF
COPY_COUNT_SHIFT: i32: 4
COPY_DROPPED: i32: 1

// The low bits of what an async call returns say its state, the others the
// handle of its subtask while it runs.
SUBTASK_STATE_MASK: i32: 0xF
SUBTASK_HANDLE_SHIFT: i32: 4
SUBTASK_RETURNED: i32: 2

// The event a wait reports for a read of a stream.
EVENT_STREAM_READ: i32: 2

// The payload of the event the last wait reported.
event_payload :: fn() -> WasmExpression = i32_load(i32_const(EVENT_ADDRESS), EVENT_PAYLOAD)

// The core import name of `b`, one per built-in and type.
builtin_name :: fn(b: CanonicalBuiltin) -> string {
    t :: b.type else return canonical_name(b.kind)
    return "${canonical_name(b.kind)} ${wit_type_text(t)}"
}

canonical_name :: fn(k: CanonicalKind) -> string = match k {
    .StreamNew          -> "stream.new"
    .StreamRead         -> "stream.read"
    .StreamWrite        -> "stream.write"
    .StreamCancelRead   -> "stream.cancel-read"
    .StreamDropReadable -> "stream.drop-readable"
    .StreamDropWritable -> "stream.drop-writable"
    .FutureRead         -> "future.read"
    .FutureDropReadable -> "future.drop-readable"
    .WaitableSetNew     -> "waitable-set.new"
    .WaitableJoin       -> "waitable.join"
    .WaitableSetWait    -> "waitable-set.wait"
    .WaitableSetPoll    -> "waitable-set.poll"
    .WaitableSetDrop    -> "waitable-set.drop"
    .SubtaskCancel      -> "subtask.cancel"
    .SubtaskDrop        -> "subtask.drop"
}

// The core type of `k`, as the canonical ABI lowers it.
builtin_type :: fn(k: CanonicalKind) -> WasmFuncType = match k {
    .StreamNew          -> func_of([], [.I64])
    .StreamRead         -> func_of([.I32, .I32, .I32], [.I32])
    .StreamWrite        -> func_of([.I32, .I32, .I32], [.I32])
    .StreamCancelRead   -> func_of([.I32], [.I32])
    .StreamDropReadable -> func_of([.I32], [])
    .StreamDropWritable -> func_of([.I32], [])
    .FutureRead         -> func_of([.I32, .I32], [.I32])
    .FutureDropReadable -> func_of([.I32], [])
    .WaitableSetNew     -> func_of([], [.I32])
    .WaitableJoin       -> func_of([.I32, .I32], [])
    .WaitableSetWait    -> func_of([.I32, .I32], [.I32])
    .WaitableSetPoll    -> func_of([.I32, .I32], [.I32])
    .WaitableSetDrop    -> func_of([.I32], [])
    .SubtaskCancel      -> func_of([.I32], [.I32])
    .SubtaskDrop        -> func_of([.I32], [])
}

func_of :: fn(params: WasmValType[], results: WasmValType[]) -> WasmFuncType =
    WasmFuncType { .params = params, .results = results }

// The built-ins the adapter of `f` calls, and those that read and wait for the
// streams and the futures it returns.
builtins_of :: fn(f: WitFunction) -> CanonicalBuiltin[] {
    out: CanonicalBuiltin[]: []
    for p in f.params.filter((p) -> p.type is WitStream) {
        out.push(CanonicalBuiltin { .kind = .StreamNew, .type = p.type })
        out.push(CanonicalBuiltin { .kind = .StreamWrite, .type = p.type })
        out.push(CanonicalBuiltin { .kind = .StreamDropWritable, .type = p.type })
    }
    for t in returned_handles(f.result) {
        kinds: CanonicalKind[]: if t is WitStream { STREAM_READ_BUILTINS } else {
            FUTURE_READ_BUILTINS
        }
        for kind in kinds {
            out.push(CanonicalBuiltin { .kind = kind, .type = t })
        }
    }
    if f.is_async {
        out.push(CanonicalBuiltin { .kind = .SubtaskDrop })
    }
    // No waitable set without a stream, a future or a subtask to wait for.
    if out.is_empty() {
        return out
    }
    for kind in WAITABLE_SET_BUILTINS {
        out.push(CanonicalBuiltin { .kind = kind })
    }
    return out
}

STREAM_READ_BUILTINS: CanonicalKind[]: [.StreamRead, .StreamCancelRead, .StreamDropReadable]
FUTURE_READ_BUILTINS: CanonicalKind[]: [.FutureRead, .FutureDropReadable]

// The streams and the futures `t` holds as the handles the host gives: `t`
// itself, or the elements of a tuple.
returned_handles :: fn(t: WitType | null) -> (WitStream | WitFuture)[] {
    out: (WitStream | WitFuture)[]: []
    out.push_handles(t)
    return out
}

push_handles :: fn(out: (WitStream | WitFuture)[], t: WitType | null) -> void {
    if t is WitStream | WitFuture {
        out.push(t)
    } else if t is WitTuple {
        for e in t.elements {
            out.push_handles(e)
        }
    }
}

WAITABLE_SET_BUILTINS: CanonicalKind[]: [
    .WaitableSetNew,
    .WaitableJoin,
    .WaitableSetWait,
    .WaitableSetDrop,
]

// ---- the adapter ----------------------------------------------------------

// Whether a call to `f` goes through an adapter: unless it is synchronous and
// every parameter and the result are scalars a Vader value passes as they are.
needs_adapter :: fn(f: WitFunction) -> bool {
    if f.is_async || f.params.any_match((p) -> !passes_as_is(p.type)) {
        return true
    }
    result :: f.result else return false
    return !passes_as_is(result)
}

// A scalar the core function takes or returns as Vader holds it: neither a
// string, which crosses as an address and a length, nor an `f32`, which Vader
// holds as an `f64`.
passes_as_is :: fn(t: WitType) -> bool = is_flat_scalar(t) && !is_f32(t)

// A scalar that crosses as one core value: anything but a string.
is_flat_scalar :: fn(t: WitType) -> bool {
    if t is WitEnum {
        return true
    }
    return t is WitScalar && t != .String
}

// The adapter of the bytecode import `index`, a function of an interface whose
// call `needs_adapter`: the Vader signature, the import behind it. It lowers the
// arguments, calls the import, lifts what it returns, then takes the arena back
// to where it found it.
canonical_adapter :: fn(ctx: ModuleCtx, index: i32, function: string) -> i32 | WasmUnsupported {
    key :: "canonical.adapter ${index}"
    known :: ctx.helpers[key]
    if known != null {
        return known
    }
    imp :: ctx.module.imports[index]
    wit :: imp.wit else panic("wasm: an adapted import without its WIT type")
    params :: value_types_of(imp.signature.params, function) else return params
    results :: value_types_of(result_values(imp.signature.results), function)
        else return results
    core_type :: flat_type_of(wit, function) else return core_type
    a :: Adapter {
        .ctx = ctx,
        .imp = imp,
        .function = function,
        .frame = HelperFrame { .signature = func_of(params, results) },
    }
    value :: a.push_call(wit, index, core_type) else is WasmUnsupported { return value }
    body: WasmExpression[]: if uses_arena(wit, core_type) {
        a.frame.arena_scope(a.body)
    } else {
        a.body
    }
    if value != null {
        body.push(local_get(value))
    }
    return ctx.define_tree_helper(key, a.frame, body)
}

// An adapter being written.
Adapter :: struct {
    ctx: ModuleCtx
    imp: Bc.BcImport
    function: string
    frame: HelperFrame
    body: WasmExpression[] = []
}

// Whether a call to `f` of the core type `core_type` takes room in the arena: for
// a result the host writes to the memory, as it does for every async call.
uses_arena :: fn(f: WitFunction, core_type: WasmFuncType) -> bool {
    if f.result == null {
        return false
    }
    return f.is_async || core_type.results.is_empty()
}

// What an argument takes: what is done before the call, the value passed, what
// is done after the call.
Lowered :: struct {
    before: WasmExpression[] = []
    argument: WasmExpression
    after: WasmExpression[] = []
}

// Lower the arguments, call the import, and lift what it returns into a local,
// returned; null for nothing. A result too large to come back flat, or the
// result of an async call, is written to room passed last; a value that comes
// back flat is kept while what the arguments do after the call is done. An async
// call is waited for once the arguments are written.
push_call :: fn(
    a: Adapter,
    wit: WitFunction,
    index: i32,
    core_type: WasmFuncType,
) -> i32 | null | WasmUnsupported {
    import_index :: a.ctx.imports.by_bytecode_index[index]
        else panic("wasm: an adapted import that is not imported")
    arguments: WasmExpression[]: []
    after: WasmExpression[]: []
    for [p, i] in wit.params.indexed() {
        lowered :: a.lower_param(p.type, i32(i)) else return lowered
        a.body.push_all(lowered.before)
        arguments.push(lowered.argument)
        after.push_all(lowered.after)
    }
    result :: wit.result
    if result != null && !wit.is_async && !core_type.results.is_empty() {
        value :: a.result_local() else return value
        lifted :: a.lift_flat(result, call(import_index, arguments)) else return lifted
        a.body.push(local_set(value, lifted))
        a.body.push_all(after)
        return value
    }
    address :: a.frame.local(.I32)
    if result != null {
        a.body.push(local_set(address, a.ctx.room_for(result)))
        arguments.push(local_get(address))
    }
    called :: call(import_index, arguments)
    if wit.is_async {
        state :: a.frame.local(.I32)
        a.body.push(local_set(state, called))
        a.body.push_all(after)
        a.body.push(call(a.ctx.canonical_subtask_wait(), [local_get(state)]))
    } else {
        a.body.push(called)
        a.body.push_all(after)
    }
    if result == null {
        return null
    }
    return a.push_load(result, address)
}

// The local the result goes to, of the type the Vader signature returns.
result_local :: fn(a: Adapter) -> i32 | WasmUnsupported {
    results :: a.frame.signature.results
    if results.is_empty() {
        return WasmUnsupported { .reason = "`${a.function}`: a result the Vader signature drops" }
    }
    return a.frame.local(results[0])
}

// Read the result of type `t` the host wrote at the address in the local
// `address`, into the local returned.
push_load :: fn(a: Adapter, t: WitType, address: i32) -> i32 | WasmUnsupported {
    value :: a.result_local() else return value
    load :: canonical_load(a.ctx, t, a.imp.signature.result_types[0], a.function)
        else return load
    a.body.push(local_set(value, call(load, [local_get(address)])))
    return value
}

// `value`, the flat result of type `t`, as Vader holds it: a stream or a future
// is its handle in a struct of its own.
lift_flat :: fn(a: Adapter, t: WitType, value: WasmExpression) -> WasmExpression | WasmUnsupported {
    if t is WitStream | WitFuture {
        held :: struct_type(a.ctx, a.imp.signature.result_types[0], a.function) else return held
        return struct_new(held, [value])
    }
    return held_from_core(t, value)
}

// The parameter `index` of type `t`, lowered: a stream is opened, passed by its
// readable end, then written and closed after the call; a scalar is passed as
// itself, an `f32` narrowed.
lower_param :: fn(a: Adapter, t: WitType, index: i32) -> Lowered | WasmUnsupported {
    if t is WitStream {
        return a.lower_stream(t, index)
    }
    if is_flat_scalar(t) {
        return Lowered { .argument = core_from_held(t, local_get(index)) }
    }
    return no_lowering(t, a.function)
}

lower_stream :: fn(a: Adapter, t: WitStream, index: i32) -> Lowered | WasmUnsupported {
    if !is_byte_stream(t) {
        return no_lowering(t, a.function)
    }
    pair :: a.frame.local(.I64)
    writable :: a.frame.local(.I32)
    // `stream.new` returns the readable end in the low half, the writable end in
    // the high half.
    writable_end :: unary(.I32WrapI64, binary(.I64ShrU, local_get(pair), i64_const(32)))
    return Lowered {
        .before = [
            local_set(pair, call(a.ctx.builtin(.StreamNew, t), [])),
            local_set(writable, writable_end),
        ],
        .argument = unary(.I32WrapI64, local_get(pair)),
        .after = [
            call(a.ctx.canonical_write(t), [local_get(writable), local_get(index)]),
            call(a.ctx.builtin(.StreamDropWritable, t), [local_get(writable)]),
        ],
    }
}

no_lowering :: fn(t: WitType, function: string) -> WasmUnsupported =
    WasmUnsupported { .reason = "`${function}`: no lowering yet for `${wit_type_text(t)}`" }

// A stream of bytes, the only one an adapter writes so far.
is_byte_stream :: fn(t: WitStream) -> bool {
    element :: t.element
    return element is WitScalar && element == .U8
}

// The function index of the built-in `kind` on `type`, which
// `imported_functions` imports for every adapted call.
builtin :: fn(ctx: ModuleCtx, kind: CanonicalKind, type: WitType | null) -> i32 {
    b :: CanonicalBuiltin { .kind = kind, .type = type }
    name :: builtin_name(b)
    return ctx.imports.by_builtin[name] else panic("wasm: `${name}` not imported")
}

// ---- the helpers ----------------------------------------------------------

// `(waitable) -> void`: wait until `waitable` signals, through a waitable set of
// its own, which leaves the event at `EVENT_ADDRESS`.
canonical_wait :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["canonical.wait"] else define_wait(ctx)

define_wait :: fn(ctx: ModuleCtx) -> i32 {
    waitable :: 0
    frame :: HelperFrame { .signature = func_of([.I32], []) }
    set :: frame.local(.I32)
    wait :: call(ctx.builtin(.WaitableSetWait, null), [local_get(set), i32_const(EVENT_ADDRESS)])
    body: WasmExpression[]: [
        local_set(set, call(ctx.builtin(.WaitableSetNew, null), [])),
        call(ctx.builtin(.WaitableJoin, null), [local_get(waitable), local_get(set)]),
        drop(wait),
        // Joining the set 0 takes the waitable out of its set.
        call(ctx.builtin(.WaitableJoin, null), [local_get(waitable), i32_const(0)]),
        call(ctx.builtin(.WaitableSetDrop, null), [local_get(set)]),
    ]
    return ctx.define_tree_helper("canonical.wait", frame, body)
}

// `(writable, items: u8[]) -> void`: write every item to the stream `stream`,
// one chunk of the memory at a time, until they are all written or the reader
// is gone.
canonical_write :: fn(ctx: ModuleCtx, stream: WitType) -> i32 {
    key :: "canonical.write ${wit_type_text(stream)}"
    return ctx.helpers[key] else define_write(ctx, key, stream)
}

define_write :: fn(ctx: ModuleCtx, key: string, stream: WitType) -> i32 {
    gc :: ctx.gc
    writable :: 0
    items :: 1
    frame :: HelperFrame { .signature = func_of([.I32, .EqRef], []) }
    length :: frame.local(.I32)
    offset :: frame.local(.I32)
    storage :: frame.local(.EqRef)
    // How many items are sent, how many the chunk holds, how many of those are
    // written, and how the last write ended.
    sent :: frame.local(.I32)
    chunk :: frame.local(.I32)
    done :: frame.local(.I32)
    status :: frame.local(.I32)
    k :: frame.local(.I32)
    bytes :: storage_type(gc, .I8)
    at :: i32_add(i32_add(local_get(offset), local_get(sent)), local_get(k))
    byte :: array_get(bytes, local_get(storage), at, .Unsigned)
    chunk_byte :: i32_add(i32_const(CHUNK_ADDRESS), local_get(k))
    unwritten :: i32_add(i32_const(CHUNK_ADDRESS), local_get(done))
    write :: call(
        ctx.builtin(.StreamWrite, stream),
        [local_get(writable), unwritten, i32_sub(local_get(chunk), local_get(done))],
    )
    written :: i32_shr_u(local_get(status), i32_const(COPY_COUNT_SHIFT))
    write_some: WasmExpression[]: [
        local_set(status, write),
        when(
            i32_eq(local_get(status), i32_const(BLOCKED)),
            [
                call(ctx.canonical_wait(), [local_get(writable)]),
                // The result of the copy, the payload of its event.
                local_set(status, event_payload()),
            ],
        ),
        when(i32_and(local_get(status), i32_const(COPY_STATUS_MASK)), [return_()]),
        local_set(done, i32_add(local_get(done), written)),
    ]
    each_chunk: WasmExpression[]: [
        local_set(chunk, i32_sub(local_get(length), local_get(sent))),
        when(
            i32_gt_s(local_get(chunk), i32_const(CHUNK_SIZE)),
            [local_set(chunk, i32_const(CHUNK_SIZE))],
        ),
        repeat(.I32, k, chunk, [store(.I32Store8, chunk_byte, byte)]),
        local_set(done, i32_const(0)),
        while_below(.I32, done, chunk, write_some),
        local_set(sent, i32_add(local_get(sent), local_get(chunk))),
    ]
    body: WasmExpression[]: [
        local_set(length, i32_wrap_i64(header_field(gc, items, HEADER_LENGTH))),
        local_set(offset, header_field(gc, items, HEADER_OFFSET)),
        local_set(storage, header_field(gc, items, HEADER_STORAGE)),
        local_set(sent, i32_const(0)),
        while_below(.I32, sent, length, each_chunk),
    ]
    return ctx.define_tree_helper(key, frame, body)
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

WRITE_OUTCOME: WitFuture: WitFuture {
    .value = WitResult { .error = WitEnum { .name = "error-code", .cases = ["io", "pipe"] } },
}

STDOUT_WRITE: WitFunction: WitFunction {
    .params = [WitParam { .name = "data", .type = WitStream { .element = .U8 } }],
    .result = WRITE_OUTCOME,
}

@test
test_a_function_taking_a_stream_is_adapted :: fn() -> void {
    assert(needs_adapter(STDOUT_WRITE), "a stream parameter takes an adapter")
    scalar :: WitFunction { .params = [], .result = .U64 }
    assert(!needs_adapter(scalar), "a scalar result takes none")
}

@test
test_an_f32_is_adapted :: fn() -> void {
    result :: WitFunction { .params = [], .result = .F32 }
    assert(needs_adapter(result), "Vader holds an f32 result as an f64")
    param :: WitFunction { .params = [WitParam { .name = "x", .type = .F32 }], .result = null }
    assert(needs_adapter(param), "Vader holds an f32 parameter as an f64")
}

@test
test_the_builtins_of_a_stream_write :: fn() -> void {
    names :: builtins_of(STDOUT_WRITE).map(builtin_name).collect()
    assert_eq(names.len(), 9)
    assert_eq(names[0], "stream.new stream<u8>")
    assert_eq(names[3], "future.read future<result<_,enum:error-code{io,pipe}>>")
    assert_eq(names[8], "waitable-set.drop")
}

@test
test_the_builtins_of_a_stream_returned_in_a_tuple :: fn() -> void {
    read_via_stream :: WitFunction {
        .params = [],
        .result = WitTuple { .elements = [WitStream { .element = .U8 }, WRITE_OUTCOME] },
    }
    names :: builtins_of(read_via_stream).map(builtin_name).collect()
    assert_eq(names[0], "stream.read stream<u8>")
    assert_eq(names[2], "stream.drop-readable stream<u8>")
    assert_eq(names[3], "future.read future<result<_,enum:error-code{io,pipe}>>")
    assert_eq(names.len(), 9)
}

@test
test_an_async_call_is_adapted_and_waits_for_its_subtask :: fn() -> void {
    wait_for :: WitFunction {
        .params = [WitParam { .name = "how-long", .type = .U64 }],
        .result = null,
        .is_async = true,
    }
    assert(needs_adapter(wait_for), "an async call returns its state")
    names :: builtins_of(wait_for).map(builtin_name).collect()
    assert_eq(names[0], "subtask.drop")
}
