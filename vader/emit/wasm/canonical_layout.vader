// vader/emit/wasm/canonical_layout: how the canonical ABI lays out a WIT value.
//
// A value crosses a call either flat, as core values, or through the linear
// memory, at the size and the alignment its type has there. Each function
// follows the definition of the same name in the canonical ABI's specification
// (`CanonicalABI.md`: `flatten_type`, `elem_size`, `alignment`), one arm per
// constructor of `WitType`. A `result` is the variant of its two cases.

module "vader/emit/wasm"

import "std/abort"
import "std/iter"
import "std/math"
import "vader/core/wit"

// How many flat values a call passes at most as parameters, and returns at most
// as results: past them, the values cross through the memory.
MAX_FLAT_PARAMS: i64: 16
MAX_FLAT_RESULTS: i64: 1
// How many flat values an async call passes at most as parameters.
MAX_FLAT_ASYNC_PARAMS: i64: 4

// The core type of `f` lowered by `canon lower`: its parameters flat when they
// hold `MAX_FLAT_PARAMS` values at most, else the address of a block holding
// them; its result flat when it holds one value, else the address the host
// writes it to, passed last. An async function is lowered async: its parameters
// flat up to `MAX_FLAT_ASYNC_PARAMS` values, its result always written to the
// memory, and it returns the state of the call (`canonical.vader`).
flat_type_of :: fn(f: WitFunction, function: string) -> WasmFuncType | WasmUnsupported {
    params: WasmValType[]: []
    for p in f.params {
        flat :: flat_types_of(p.type) else return unsupported_in(flat, function)
        params.push_all(flat)
    }
    if i64(params.len()) > flat_params_limit(f) {
        params.clear()
        params.push(.I32)
    }
    if f.is_async {
        if f.result != null {
            params.push(.I32)
        }
        return func_of(params, [.I32])
    }
    result :: f.result else return func_of(params, [])
    results :: flat_types_of(result) else return unsupported_in(results, function)
    if results.len() > MAX_FLAT_RESULTS {
        params.push(.I32)
        return func_of(params, [])
    }
    return func_of(params, results)
}

flat_params_limit :: fn(f: WitFunction) -> i64 = if f.is_async { MAX_FLAT_ASYNC_PARAMS } else {
    MAX_FLAT_PARAMS
}

// Whether the parameters of `f` cross as the address of a block holding them:
// they flatten to more values than `flat_params_limit`.
params_through_memory :: fn(f: WitFunction) -> bool {
    count: i64 = 0
    for p in f.params {
        flat :: flat_types_of(p.type) else return false
        count += flat.len()
    }
    return count > flat_params_limit(f)
}

// Whether the host reads a parameter of `f` from the memory: a block of them, or
// a string or a list one of them points to.
reads_params_from_memory :: fn(f: WitFunction) -> bool =
    params_through_memory(f) || f.params.any_match((p) -> holds_room(p.type))

unsupported_in :: fn(t: WasmUnsupported, function: string) -> WasmUnsupported =
    WasmUnsupported { .reason = "`${function}`: ${t.reason}" }

// The core values a value of `t` flattens to.
flat_types_of :: fn(t: WitType) -> WasmValType[] | WasmUnsupported = match t {
    is WitScalar                       -> flat_scalar_types(t)
    is WitEnum | WitStream | WitFuture -> [.I32]
    is WitHandle                       -> [.I32]
    is WitList                         -> [.I32, .I32]
    is WitResult                       -> flat_variant_types([t.ok, t.error])
    is WitOption                       -> flat_variant_types([null, t.value])
    is WitTuple                        -> flat_sequence_types(t.elements)
    is WitRecord                       -> flat_sequence_types(field_types(t))
    is WitVariant                      -> flat_variant_types(case_types(t))
    is WitFlags                        -> flat_flags_types(t)
    is WitUnsupported                  -> WasmUnsupported { .reason = t.reason }
    is WitNotLowered                   -> WasmUnsupported {
        .reason = "no canonical ABI yet for `${wit_type_text(t)}`",
    }
}

// The WIT types read from a `.wit` file that the canonical ABI does not cross yet.
WitNotLowered :: WitResource | WitAlias

flat_scalar_types :: fn(s: WitScalar) -> WasmValType[] = match s {
    .Bool | .S8 | .U8 | .S16 | .U16 | .S32 | .U32 | .Char -> [.I32]
    .S64 | .U64 -> [.I64]
    .F32 -> [.F32]
    .F64 -> [.F64]
    .String -> [.I32, .I32]
}

// A tuple or a record flattens to its elements, one after the other.
flat_sequence_types :: fn(types: WitType[]) -> WasmValType[] | WasmUnsupported {
    out: WasmValType[]: []
    for e in types {
        flat :: flat_types_of(e) else return flat
        out.push_all(flat)
    }
    return out
}

// Flags flatten to one `i32` of their bits, as long as they fit one.
flat_flags_types :: fn(t: WitFlags) -> WasmValType[] | WasmUnsupported {
    if t.flags.len() > MAX_FLAGS {
        return WasmUnsupported { .reason = "more than ${MAX_FLAGS} flags in `${t.name}`" }
    }
    return [.I32]
}

// How many flags one `i32` holds.
MAX_FLAGS: i64: 32

// The bytes flags of `count` names are stored in.
flags_bytes :: fn(count: i64) -> i32 {
    if count <= 8 {
        return 1
    }
    if count <= 16 {
        return 2
    }
    return 4
}

// The unsigned scalar of `bytes` bytes, which a case or flags are stored as.
unsigned_of_bytes :: fn(bytes: i32) -> WitScalar = match bytes {
    1 -> .U8
    2 -> .U16
    _ -> .U32
}

field_types :: fn(r: WitRecord) -> WitType[] = r.fields.map((f) -> f.type).collect()

// What each case of `v` carries, null for nothing.
case_types :: fn(v: WitVariant) -> (WitType | null)[] = v.cases.map((c) -> c.type).collect()

// A variant flattens to its case, then the values of its payloads, each position
// the join of what the cases hold there.
flat_variant_types :: fn(cases: (WitType | null)[]) -> WasmValType[] | WasmUnsupported {
    joined: WasmValType[]: []
    for c in cases {
        payload :: c else continue
        flat :: flat_types_of(payload) else return flat
        for [v, i] in flat.indexed() {
            if i < joined.len() {
                joined[i] = join_flat(joined[i], v)
            } else {
                joined.push(v)
            }
        }
    }
    out: WasmValType[]: [.I32]
    out.push_all(joined)
    return out
}

// The core type two payloads share a position as.
join_flat :: fn(a: WasmValType, b: WasmValType) -> WasmValType {
    if a == b {
        return a
    }
    if a == .I32 && b == .F32 || a == .F32 && b == .I32 {
        return .I32
    }
    return .I64
}

// The bytes a value of `t` takes in the memory, padding included.
size_of :: fn(t: WitType) -> i32 = match t {
    is WitScalar             -> scalar_size(t)
    is WitEnum               -> case_bytes(t.cases.len())
    is WitStream | WitFuture -> 4
    is WitHandle             -> 4
    is WitList               -> 8
    is WitResult             -> variant_size([t.ok, t.error])
    is WitOption             -> variant_size([null, t.value])
    is WitTuple              -> sequence_size(t.elements)
    is WitRecord             -> sequence_size(field_types(t))
    is WitVariant            -> variant_size(case_types(t))
    is WitFlags              -> flags_bytes(t.flags.len())
    is WitUnsupported        -> no_layout(t.reason)
    is WitNotLowered         -> no_layout(wit_type_text(t))
}

// The alignment of a value of `t` in the memory.
alignment_of :: fn(t: WitType) -> i32 = match t {
    is WitScalar                       -> scalar_alignment(t)
    is WitEnum                         -> case_bytes(t.cases.len())
    is WitStream | WitFuture | WitList -> 4
    is WitHandle                       -> 4
    is WitResult                       -> variant_alignment([t.ok, t.error])
    is WitOption                       -> variant_alignment([null, t.value])
    is WitTuple                        -> max_alignment(t.elements)
    is WitRecord                       -> max_alignment(field_types(t))
    is WitVariant                      -> variant_alignment(case_types(t))
    is WitFlags                        -> flags_bytes(t.flags.len())
    is WitUnsupported                  -> no_layout(t.reason)
    is WitNotLowered                   -> no_layout(wit_type_text(t))
}

// Where each element of `t` starts in the memory, and where the last ends: each
// at the next multiple of its alignment.
ElementOffsets :: struct {
    starts: i32[]
    end: i32
}

element_offsets :: fn(t: WitTuple) -> ElementOffsets = sequence_offsets(t.elements)

// Where each of `types`, laid one after the other, starts, and where the last ends.
sequence_offsets :: fn(types: WitType[]) -> ElementOffsets {
    starts: i32[]: []
    at: i32 = 0
    for e in types {
        at = align_to(at, alignment_of(e))
        starts.push(at)
        at += size_of(e)
    }
    return ElementOffsets { .starts = starts, .end = at }
}

// The bytes of `types` laid one after the other, padded to their alignment.
sequence_size :: fn(types: WitType[]) -> i32 =
    align_to(sequence_offsets(types).end, max_alignment(types))

max_alignment :: fn(types: WitType[]) -> i32 {
    out: i32 = 1
    for t in types {
        out = max(out, alignment_of(t))
    }
    return out
}

// `flat_types_of` turned the type down before any layout is asked of it.
no_layout :: fn(what: string) -> i32 = panic(
    "wasm: no layout for a type without canonical form: ${what}",
)

scalar_size :: fn(s: WitScalar) -> i32 {
    if s == .String {
        return 8
    }
    return scalar_alignment(s)
}

scalar_alignment :: fn(s: WitScalar) -> i32 = match s {
    .Bool | .S8 | .U8                    -> 1
    .S16 | .U16                          -> 2
    .S32 | .U32 | .F32 | .Char | .String -> 4
    .S64 | .U64 | .F64                   -> 8
}

// The bytes the case of a variant of `count` cases is stored in.
case_bytes :: fn(count: i64) -> i32 = i32(enum_case_bits(count) / 8)

variant_size :: fn(cases: (WitType | null)[]) -> i32 {
    largest: i32 = 0
    for c in cases {
        payload :: c else continue
        largest = max(largest, size_of(payload))
    }
    return align_to(payload_offset(cases) + largest, variant_alignment(cases))
}

variant_alignment :: fn(cases: (WitType | null)[]) -> i32 =
    max(case_bytes(cases.len()), max_payload_alignment(cases))

max_payload_alignment :: fn(cases: (WitType | null)[]) -> i32 {
    out: i32 = 1
    for c in cases {
        payload :: c else continue
        out = max(out, alignment_of(payload))
    }
    return out
}

// Where the payload of a variant of `cases` starts, past its case.
payload_offset :: fn(cases: (WitType | null)[]) -> i32 =
    align_to(case_bytes(cases.len()), max_payload_alignment(cases))

// `at` rounded up to a multiple of `alignment`, a power of two.
align_to :: fn(at: i32, alignment: i32) -> i32 = (at + alignment - 1) & -alignment

// Whether the result of `f` comes back through the memory: it takes more flat
// values than a call returns.
returns_through_memory :: fn(f: WitFunction) -> bool {
    result :: f.result else return false
    flat :: flat_types_of(result) else return false
    return flat.len() > MAX_FLAT_RESULTS
}

// Whether the host writes a result of `f` into room it asks the memory's
// allocator for: one that holds a string or a list.
allocates :: fn(f: WitFunction) -> bool = holds_room(f.result)

holds_room :: fn(t: WitType | null) -> bool {
    if t == null {
        return false
    }
    return match t {
        is WitScalar -> t == .String
        is WitList -> true
        is WitResult -> holds_room(t.ok) || holds_room(t.error)
        is WitOption -> holds_room(t.value)
        is WitTuple -> t.elements.any_match((e) -> holds_room(e))
        is WitRecord -> t.fields.any_match((f) -> holds_room(f.type))
        is WitVariant -> t.cases.any_match((c) -> holds_room(c.type))
        is WitEnum | WitFlags | WitStream | WitFuture | WitHandle -> false
        is WitUnsupported | WitNotLowered -> false
    }
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

ERROR_CODE: WitEnum: WitEnum {
    .name = "error-code",
    .cases = ["io", "illegal-byte-sequence", "pipe"],
}

@test
test_a_string_flattens_to_its_address_and_length :: fn() -> void {
    flat :: flat_types_of(.String) else panic("a string flattens")
    assert_eq(flat.len(), 2)
}

@test
test_a_result_of_an_enum_flattens_to_its_case_and_the_enum :: fn() -> void {
    flat :: flat_types_of(WitResult { .error = ERROR_CODE }) else panic("a result flattens")
    assert_eq(flat.len(), 2)
}

@test
test_a_result_joins_an_i32_and_an_i64_as_an_i64 :: fn() -> void {
    t :: WitResult { .ok = .U32, .error = .U64 }
    flat :: flat_types_of(t) else panic("a result flattens")
    assert(flat.len() == 2 && flat[1] == .I64, "the payload position joins to i64")
}

@test
test_a_result_of_an_enum_takes_two_bytes :: fn() -> void {
    t :: WitResult { .error = ERROR_CODE }
    assert_eq(size_of(t), 2)
    assert_eq(alignment_of(t), 1)
    assert_eq(payload_offset([t.ok, t.error]), 1)
}

@test
test_a_result_of_a_string_aligns_its_payload_on_four :: fn() -> void {
    t :: WitResult { .ok = .String, .error = ERROR_CODE }
    assert_eq(size_of(t), 12)
    assert_eq(alignment_of(t), 4)
}

@test
test_an_option_of_a_string_flattens_to_its_case_and_the_string :: fn() -> void {
    flat :: flat_types_of(WitOption { .value = .String }) else panic("an option flattens")
    assert_eq(flat.len(), 3)
}

@test
test_an_option_of_a_string_aligns_its_value_on_four :: fn() -> void {
    t :: WitOption { .value = .String }
    assert_eq(size_of(t), 12)
    assert_eq(alignment_of(t), 4)
    assert_eq(payload_offset([null, t.value]), 4)
}

@test
test_a_list_takes_its_address_and_length :: fn() -> void {
    t :: WitList { .element = .String }
    assert_eq(size_of(t), 8)
    assert_eq(alignment_of(t), 4)
}

@test
test_a_list_result_comes_back_through_the_memory :: fn() -> void {
    f :: WitFunction { .params = [], .result = WitList { .element = .String } }
    t :: flat_type_of(f, "get-arguments") else panic("the function lowers")
    assert(t.params.len() == 1 && t.results.len() == 0, "the result's address is the parameter")
}

@test
test_a_stream_and_a_future_flatten_to_handles :: fn() -> void {
    f :: WitFunction {
        .params = [WitParam { .name = "data", .type = WitStream { .element = .U8 } }],
        .result = WitFuture { .value = WitResult { .error = ERROR_CODE } },
    }
    flat :: flat_type_of(f, "write-via-stream") else panic("a stream write flattens")
    assert_eq(flat.params.len(), 1)
    assert(flat.params[0] == .I32 && flat.results[0] == .I32, "two handles")
}

@test
test_a_tuple_of_two_handles_comes_back_through_the_memory :: fn() -> void {
    t :: WitTuple {
        .elements = [
            WitStream { .element = .U8 },
            WitFuture { .value = WitResult { .error = ERROR_CODE } },
        ],
    }
    assert_eq(size_of(t), 8)
    assert_eq(element_offsets(t).starts[1], 4)
    f :: WitFunction { .params = [], .result = t }
    flat :: flat_type_of(f, "read-via-stream") else panic("a tuple flattens")
    assert(
        flat.params.len() == 1 && flat.results.is_empty(),
        "the result's address is the parameter",
    )
}

@test
test_an_async_call_returns_its_state_and_takes_room_for_its_result :: fn() -> void {
    f :: WitFunction { .params = [], .result = .U64, .is_async = true }
    flat :: flat_type_of(f, "now") else panic("an async call lowers")
    assert(flat.params.len() == 1 && flat.results.len() == 1, "the room in, the state out")
}

@test
test_a_tuple_aligns_each_element :: fn() -> void {
    t :: WitTuple { .elements = [.U8, .U64, .U16] }
    assert_eq(element_offsets(t).starts[1], 8)
    assert_eq(size_of(t), 24)
    assert_eq(alignment_of(t), 8)
}

TEST_OWNER: WitOwner: WitOwner {
    .package = WitPackageName { .namespace = "wasi", .name = "filesystem" },
    .interface = "types",
}

@test
test_flags_take_the_bytes_their_count_needs :: fn() -> void {
    four :: WitFlags { .name = "open-flags", .owner = TEST_OWNER, .flags = ["a", "b", "c", "d"] }
    assert_eq(size_of(four), 1)
    nine :: WitFlags { ...four, .flags = ["a", "b", "c", "d", "e", "f", "g", "h", "i"] }
    assert_eq(size_of(nine), 2)
    assert_eq(alignment_of(nine), 2)
    flat :: flat_types_of(nine) else panic("flags flatten")
    assert_eq(flat.len(), 1)
}

@test
test_a_record_lays_out_its_fields_as_a_tuple :: fn() -> void {
    fields :: [WitParam { .name = "kind", .type = .U8 }, WitParam { .name = "size", .type = .U64 }]
    t :: WitRecord { .name = "stat", .owner = TEST_OWNER, .fields = fields }
    assert_eq(size_of(t), 16)
    assert_eq(alignment_of(t), 8)
    flat :: flat_types_of(t) else panic("a record flattens")
    assert(flat.len() == 2 && flat[1] == .I64, "one value per field")
}

@test
test_a_variant_places_its_payload_past_its_case :: fn() -> void {
    cases :: [
        WitCase { .name = "access" },
        WitCase { .name = "other", .type = WitOption { .value = .String } },
    ]
    t :: WitVariant { .name = "error-code", .owner = TEST_OWNER, .cases = cases }
    assert_eq(size_of(t), 16)
    assert_eq(alignment_of(t), 4)
    flat :: flat_types_of(t) else panic("a variant flattens")
    assert_eq(flat.len(), 4)
}

@test
test_the_parameters_of_open_at_cross_through_the_memory :: fn() -> void {
    flags :: WitFlags { .name = "path-flags", .owner = TEST_OWNER, .flags = ["symlink-follow"] }
    params :: [
        WitParam { .name = "path-flags", .type = flags },
        WitParam { .name = "path", .type = .String },
        WitParam { .name = "open-flags", .type = flags },
    ]
    sync :: WitFunction { .params = params, .result = null }
    assert(!params_through_memory(sync), "four values pass flat to a synchronous call")
    asynchronous :: WitFunction { ...sync, .is_async = true }
    assert(!params_through_memory(asynchronous), "four values pass flat to an async call")
    extra :: params.clone()
    extra.push(params[0])
    five :: WitFunction { ...asynchronous, .params = extra }
    assert(params_through_memory(five), "five do not")
    flat :: flat_type_of(five, "open-at") else panic("open-at lowers")
    assert_eq(flat.params.len(), 1)
}
