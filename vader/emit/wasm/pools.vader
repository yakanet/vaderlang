// vader/emit/wasm/pools: the read-only arrays of the data pool, `data.const`.
//
// A `data.const` reads an entry of the module's data pool as an array of the
// type its site names. Each type has its header, built on its first read and
// kept in a global, over the storage the entry builds once for every type that
// stores alike, as the VM shares the elements. A primitive entry stores its
// bits, a string entry the atoms of its strings, an aggregate entry the values it
// bakes: each struct and nested array is built as `struct.new` and an array
// literal would build it, every read sharing them.

module "vader/emit/wasm"

Bc :: import "vader/core/bytecode"

// The most elements one `array.new_fixed` makes: engines refuse more.
NEW_FIXED_GREATEST: i64: 10_000

// `() -> array`: the pool entry a `data.const` reads, as an array of the site's
// type.
data_function :: fn(ctx: ModuleCtx, op: Bc.DataConst, function: string) -> i32 | WasmUnsupported {
    key :: "data.${op.pool_index}.${op.type_id}"
    known :: ctx.helpers[key]
    if known != null {
        return known
    }
    entry :: ctx.module.data_pool[op.pool_index]
    access :: array_access(ctx, op.type_id, function) else return access
    storage :: ctx.data_storage(op.pool_index, entry, storage_of_access(access), function)
        else return storage
    elements: WasmInstr[]: [Call { .function_index = storage }]
    count :: values_of(entry).len()
    header: WasmInstr[]: []
    header.push_new_header(ctx.gc, full_header(op.type_id, access, count, elements))
    return ctx.define_cached(key, header)
}

// The values of the pool entry `entry`, each a leaf or an aggregate.
values_of :: fn(entry: Bc.BcDataEntry) -> Bc.BcDataValue[] {
    if entry is Bc.BcAggregateData {
        return entry.elements
    }
    out: Bc.BcDataValue[]: []
    if entry is Bc.BcPrimData {
        for bits in entry.items {
            out.push(Bc.BcValPrim { .kind = entry.kind, .bits = bits })
        }
    } else {
        for value in entry.values {
            out.push(Bc.BcValStr { .value = value })
        }
    }
    return out
}

// `() -> storage`: the elements of the pool entry `entry`, stored as `storage`.
data_storage :: fn(
    ctx: ModuleCtx,
    pool_index: i32,
    entry: Bc.BcDataEntry,
    storage: WasmStorageType,
    function: string,
) -> i32 | WasmUnsupported {
    key :: "data.${pool_index}.${storage_name(storage)}"
    known :: ctx.helpers[key]
    if known != null {
        return known
    }
    elements: WasmInstr[]: []
    built :: elements.push_storage_of(ctx, values_of(entry), storage, function) else return built
    return ctx.define_cached(key, elements)
}

// Push a storage of `storage` holding `values`.
push_storage_of :: fn(
    body: WasmInstr[],
    ctx: ModuleCtx,
    values: Bc.BcDataValue[],
    storage: WasmStorageType,
    function: string,
) -> void | WasmUnsupported {
    if values.len() > NEW_FIXED_GREATEST {
        return WasmUnsupported {
            .reason = "`${function}`: a pool of over ${NEW_FIXED_GREATEST} elements",
        }
    }
    held :: held_of_storage(storage)
    for value in values {
        pushed :: body.push_value(ctx, value, held, function) else return pushed
    }
    body.push(
        ArrayNewFixed { .type_index = storage_type(ctx.gc, storage), .length = i32(values.len()) },
    )
}

// Push the baked value `value`, held as `held`.
push_value :: fn(
    body: WasmInstr[],
    ctx: ModuleCtx,
    value: Bc.BcDataValue,
    held: WasmValType,
    function: string,
) -> void | WasmUnsupported {
    match value {
        is Bc.BcValPrim   -> {
            class :: class_of_kind(value.kind)
            constant :: data_constant(storage_of(class), value.bits) else {
                return WasmUnsupported {
                    .reason = "`${function}`: no WASM form yet for a pool of floats",
                }
            }
            body.push(constant)
            return body.push_baked_as(ctx, class, held, function)
        }
        is Bc.BcValStr    -> {
            atom :: ctx.literals.atoms[value.value] else {
                return WasmUnsupported {
                    .reason = "`${function}`: a pooled string out of the table",
                }
            }
            body.push(I32Const { .value = atom })
            return body.push_baked_as(ctx, .String, held, function)
        }
        is Bc.BcValStruct -> {
            types :: ctx.module.types
            index :: Bc.struct_symbol_type_index(types, value.symbol_id)
            declared :: Bc.struct_at(types, index) else {
                return WasmUnsupported {
                    .reason = "`${function}`: a pooled struct out of the table",
                }
            }
            for i in 0..<value.fields.len() {
                field_held :: field_type_of(types[declared.fields[i].type_index])
                pushed :: body.push_value(ctx, value.fields[i], field_held, function)
                    else return pushed
            }
            made :: struct_type(ctx, index, function) else return made
            body.push(StructNew { .type_index = made })
        }
        is Bc.BcValArray  -> {
            access :: array_access(ctx, value.type_id, function) else return access
            elements: WasmInstr[]: []
            built :: elements.push_storage_of(
                ctx,
                value.elements,
                storage_of_access(access),
                function,
            )
                else return built
            count :: value.elements.len()
            body.push_new_header(ctx.gc, full_header(value.type_id, access, count, elements))
        }
    }
}

// Bring a baked scalar of `class`, on the stack as its class holds it, to
// being held as `held`.
push_baked_as :: fn(
    body: WasmInstr[],
    ctx: ModuleCtx,
    class: Bc.ValType,
    held: WasmValType,
    function: string,
) -> void | WasmUnsupported {
    if !body.push_held_as(ctx.gc, scalar_field_type(class), held, class) {
        return WasmUnsupported { .reason = "`${function}`: a baked value changes class" }
    }
}

// The class of a baked scalar of `kind`.
class_of_kind :: fn(kind: Bc.ArrayKind) -> Bc.ValType = match kind {
    .U8           -> .U8
    .U16          -> .U16
    .U32          -> .U32
    .U64          -> .U64
    .I8           -> .I8
    .I16          -> .I16
    .I32          -> .I32
    .I64          -> .I64
    .F32          -> .F32
    .F64          -> .F64
    .Char         -> .Char
    .Bool         -> .Bool
    .Boxed | .Ref -> .Any
}

// `() -> eqref`: what `build` leaves, built on the first call and kept in a
// global, which every later call returns.
define_cached :: fn(ctx: ModuleCtx, key: string, build: WasmInstr[]) -> i32 {
    global :: i32(ctx.globals.len())
    ctx.globals.push(.EqRef)
    body: WasmInstr[]: [
        GlobalGet { .index = global },
        Plain { .op = .RefIsNull },
        Plain { .op = .If },
    ]
    body.push_all(build)
    body.push_all(
        [
            GlobalSet { .index = global },
            Plain { .op = .End },
            GlobalGet { .index = global },
        ],
    )
    signature :: WasmFuncType { .params = [], .results = [.EqRef] }
    return ctx.define_helper(key, signature, [], body)
}

// The constant of an element of a pool, its bits at the element's width.
data_constant :: fn(storage: WasmStorageType, bits: u64) -> WasmInstr | null = match storage {
    .I8 | .I16 | .I32    -> I32Const { .value = i32(u32(bits & 0xFFFF_FFFF)) }
    .I64                 -> I64Const { .value = i64(bits) }
    .F32 | .F64 | .EqRef -> null
}

// ---- tests ----------------------------------------------------------------

import "std/abort"
import "std/iter"
import "std/testing"

// The body of the one function of `wasm` that builds a storage.
storage_body :: fn(wasm: WasmModule) -> WasmInstr[] {
    for f in wasm.functions {
        if f.body.filter_is<ArrayNewFixed>().count() > 0 {
            return f.body
        }
    }
    panic("no function builds a storage")
}

// `main` reads the pool entry 0 as an array of type `type_id`.
program_over_pool :: fn(entry: Bc.BcDataEntry, type_id: i32) -> Bc.BytecodeModule {
    body: Bc.Op[]: [
        Bc.DataConst { .pool_index = 0, .type_id = type_id },
        Bc.Drop {},
        Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } },
    ]
    program :: program_over_arrays(body)
    program.types.push_all([Bc.BcScalar { .val = .String }, Bc.BcArray { .element = 6 }])
    program.data_pool = [entry]
    return program
}

@test
test_a_pool_of_strings_stores_their_atoms :: fn() -> void {
    program :: program_over_pool(Bc.BcStrData { .values = ["hi", ""] }, 7)
    program.strings = ["hi"]
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    atoms :: storage_body(wasm).filter_is<I32Const>().map((c) -> c.value).collect()
    assert(atoms.content_equals([1, 0]), "`hi` is atom 1, the empty string atom 0")
}

@test
test_a_pool_of_structs_builds_each_struct :: fn() -> void {
    point :: Bc.BcValStruct {
        .symbol_id = 5,
        .fields = [Bc.BcValPrim { .kind = .I32, .bits = 3 }],
    }
    program :: program_over_pool(Bc.BcAggregateData { .elements = [point, point] }, 4)
    program.types[3] = Bc.BcStruct {
        ...Bc.struct_at(program.types, 3) else panic("A"),
        .symbol_id = 5,
    }
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    a :: gc_types_of(program).of_struct[3] else -1
    built :: storage_body(wasm).filter_is<StructNew>().filter((s) -> s.type_index == a).count()
    assert_eq(built, 2)
}
