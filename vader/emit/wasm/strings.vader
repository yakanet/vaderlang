// vader/emit/wasm/strings: the strings, as atoms of a table the module keeps.
//
// A string is an atom, an `i32` that numbers its entry in the table, as natively
// (docs/RUNTIME.md, *Strings*): two strings with the same bytes are the same
// atom, so `==` compares two integers. An entry is a struct
// `{ bytes, start, length, hash, ascii }`: its bytes are `length` elements of an
// `i8` storage from `start` on, which a slice shares with its owner. The table
// lives in globals, built by `atom.init`, which `run` calls first: the entries,
// how many there are, and the index, an open-addressing hash table of `i64`
// slots, each the low 32 bits of a hash over an atom, 0 for an empty slot.
//
// Atom 0 is the empty string, which the index never holds. The literals follow,
// each once, in the order of the bytecode's string table: their atoms are known
// when the module is emitted. Their bytes are one passive data segment, read
// once, each literal a slice of it.
//
// The hash is the native runtime's, wyhash in its final version 4
// (`runtime/c/rt/atoms.c`): a program reads it (`hash()`), and a value the
// compiler computed meets it, so every target computes the same value from the
// same bytes. WASM has no 64 x 64 -> 128-bit multiply: `atom.mum` takes it in
// 32-bit halves.

module "vader/emit/wasm"

Bc :: import "vader/core/bytecode"
import "std/collections"
import "std/math"

// The fields of an entry.
ATOM_BYTES: i32: 0
ATOM_START: i32: 1
ATOM_LENGTH: i32: 2
ATOM_HASH: i32: 3
ATOM_ASCII: i32: 4

// The constants of the hash. `-0x7447_B46C_69D1_5337` is `0x8bb8_4b93_962e_acc9`
// and `-0x357E_C40B_3854_0F57` is `0xca81_3bf4_c7ab_f0a9`, as `i64`s.
HASH_S0: i64: 0x2d35_8dcc_aa6c_78a5
HASH_S1: i64: -0x7447_B46C_69D1_5337
HASH_S2: i64: 0x4b33_a62e_d433_d4a3
HASH_S3: i64: 0x4d5a_2da5_1de1_aa47
HASH_SEED: i64: -0x357E_C40B_3854_0F57

// The low 32 bits of an `i64`.
LOW_HALF: i64: 0xFFFF_FFFF

// The struct type of an entry.
add_string_types :: fn(gc: GcTypes) -> void {
    entry: WasmField[]: [
        WasmField { .type = .EqRef },
        WasmField { .type = .I32 },
        WasmField { .type = .I32 },
        WasmField { .type = .I64 },
        WasmField { .type = .I32 },
    ]
    gc.atom = gc.add(entry)
}

// ---- literals -------------------------------------------------------------

/// The literals of a module, as the atom table starts with them.
Literals :: struct {
    /// The atom of each string of the bytecode's table, by its index.
    atom_of: i32[] = []
    /// The bytes of every literal past the empty string, each once, end to end.
    bytes: u8[] = []
    /// Where each of them starts in `bytes`, atom 1 first.
    starts: i32[] = []
    /// The length of each of them.
    lengths: i32[] = []
    /// The atom of each literal, by its text.
    atoms: Map<string, i32> = Map<string, i32> {}
}

// The literals of `m`: the empty string is atom 0, the others take the next
// atoms in the order they first appear.
literals_of :: fn(m: Bc.BytecodeModule) -> Literals {
    out :: Literals {}
    out.atoms[""] = 0
    for s in m.strings {
        next :: i32(out.starts.len() + 1)
        atom :: out.atoms.get_or_put(s, next)
        out.atom_of.push(atom)
        if atom == next {
            out.starts.push(i32(out.bytes.len()))
            out.lengths.push(i32(s.byte_len()))
            out.bytes.push_all(s.bytes())
        }
    }
    return out
}

// ---- the table ------------------------------------------------------------

// The globals of the atom table.
AtomGlobals :: struct {
    // The entries, an `eqref` storage.
    entries: i32
    // How many atoms there are.
    count: i32
    // The index, an `i64` storage whose length is a power of two.
    slots: i32
    // How many slots of the index are taken.
    used: i32
}

// The globals of the table, made on the first ask.
atom_globals :: fn(ctx: ModuleCtx) -> AtomGlobals = ctx.atoms else new_atom_globals(ctx)

new_atom_globals :: fn(ctx: ModuleCtx) -> AtomGlobals {
    first :: i32(ctx.globals.len())
    ctx.globals.push_all([.EqRef, .I32, .EqRef, .I32])
    table :: AtomGlobals {
        .entries = first,
        .count = first + 1,
        .slots = first + 2,
        .used = first + 3,
    }
    ctx.atoms = table
    return table
}

// The entry of the atom `atom`.
entry_at :: fn(ctx: ModuleCtx, atom: WasmExpression) -> WasmExpression {
    entries :: global_get(atom_globals(ctx).entries)
    return ref_cast(ctx.gc.atom, array_get(storage_type(ctx.gc, .EqRef), entries, atom))
}

// The field `field` of the entry `entry`.
entry_get :: fn(ctx: ModuleCtx, entry: WasmExpression, field: i32) -> WasmExpression =
    struct_get(ctx.gc.atom, field, entry)

// The field `field` of the entry in the local `entry`.
entry_field :: fn(ctx: ModuleCtx, entry: i32, field: i32) -> WasmExpression =
    entry_get(ctx, local_get(entry), field)

// The byte of the `i8` storage `bytes` at `at`, as an unsigned `i32`.
byte_in :: fn(gc: GcTypes, bytes: WasmExpression, at: WasmExpression) -> WasmExpression =
    array_get(storage_type(gc, .I8), bytes, at, .Unsigned)

// `() -> ()`: the table with the empty string and the literals, `ctx.literals`.
// `run` calls it before the entry.
atom_init :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["atom.init"] else define_init(ctx)

define_init :: fn(ctx: ModuleCtx) -> i32 {
    gc :: ctx.gc
    table :: atom_globals(ctx)
    literals :: ctx.literals
    count :: i64(literals.starts.len()) + 1
    references :: storage_type(gc, .EqRef)
    entries :: i32(max(16, count * 2))
    slots :: i32(power_of_two_from(max(64, count * 4)))
    frame :: HelperFrame { .signature = func_of([], []) }
    // The bytes of the literals.
    bytes :: frame.local(.EqRef)
    empty :: struct_new(
        gc.atom,
        [
            local_get(bytes),
            i32_const(0),
            i32_const(0),
            call(ctx.atom_hash(), [local_get(bytes), i32_const(0), i32_const(0)]),
            i32_const(1),
        ],
    )
    body: WasmExpression[]: [
        global_set(table.entries, array_new_default(references, i32_const(entries))),
        global_set(table.slots, array_new_default(storage_type(gc, .I64), i32_const(slots))),
        local_set(bytes, ctx.literal_bytes()),
        // Atom 0, the empty string, which no slot of the index holds.
        array_set(references, global_get(table.entries), i32_const(0), empty),
        global_set(table.count, i32_const(1)),
    ]
    for k in 0..<literals.starts.len() {
        at :: i32_const(literals.starts[k])
        length :: i32_const(literals.lengths[k])
        body.push(drop(call(ctx.atom_intern(), [local_get(bytes), at, length, i32_const(0)])))
    }
    return ctx.define_tree_helper("atom.init", frame, body)
}

// The bytes of every literal, an `i8` storage read from their data segment.
literal_bytes :: fn(ctx: ModuleCtx) -> WasmExpression {
    bytes :: ctx.literals.bytes
    i8_storage :: storage_type(ctx.gc, .I8)
    if bytes.is_empty() {
        return array_new_default(i8_storage, i32_const(0))
    }
    segment :: i32(ctx.segments.len())
    ctx.segments.push(bytes)
    return array_new_data(i8_storage, segment, i32_const(0), i32_const(i32(bytes.len())))
}

// The least power of two at or above `n`.
power_of_two_from :: fn(n: i64) -> i64 {
    out: i64 = 1
    for out < n {
        out *= 2
    }
    return out
}

// `(bytes, start: i32, length: i32, copy: i32) -> atom`: the atom of the
// `length` bytes of the `i8` storage `bytes` from `start` on, made when there is
// none yet. A new entry holds a copy of the bytes when `copy` is not zero, which
// a buffer the program goes on writing needs, else the storage itself.
//
// Every string the program makes goes through it: `==` on two strings compares
// their atoms, which holds only while two strings of the same bytes are one
// atom.
atom_intern :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["atom.intern"] else define_intern(ctx)

// A slot of the index holds the low half of the hash over the atom. The index
// cannot move before the new slot is written: it doubles last.
define_intern :: fn(ctx: ModuleCtx) -> i32 {
    gc :: ctx.gc
    table :: atom_globals(ctx)
    bytes :: 0
    start :: 1
    length :: 2
    copy :: 3
    frame :: HelperFrame { .signature = func_of([.EqRef, .I32, .I32, .I32], [.I32]) }
    hash :: frame.local(.I64)
    low :: frame.local(.I64)
    index :: frame.local(.EqRef)
    mask :: frame.local(.I32)
    position :: frame.local(.I32)
    slot :: frame.local(.I64)
    atom :: frame.local(.I32)
    entry :: frame.local(.EqRef)
    // The owner of the bytes of the new atom, and where they start in it.
    owner :: frame.local(.EqRef)
    owner_start :: frame.local(.I32)
    i8_storage :: storage_type(gc, .I8)
    i64_storage :: storage_type(gc, .I64)
    same_bytes :: call(
        ctx.atom_equal(),
        [
            entry_field(ctx, entry, ATOM_BYTES),
            entry_field(ctx, entry, ATOM_START),
            local_get(bytes),
            local_get(start),
            local_get(length),
        ],
    )
    same_length :: i32_eq(entry_field(ctx, entry, ATOM_LENGTH), local_get(length))
    found: WasmExpression[]: [
        local_set(atom, i32_wrap_i64(local_get(slot))),
        local_set(entry, ctx.entry_at(local_get(atom))),
        when(same_length, [when(same_bytes, [return_([local_get(atom)])])]),
    ]
    slot_read :: local_tee(slot, array_get(i64_storage, local_get(index), local_get(position)))
    slot_hash :: i64_shr_u(local_get(slot), i64_const(32))
    copied: WasmExpression[]: [
        local_set(owner, array_new_default(i8_storage, local_get(length))),
        array_copy(
            i8_storage,
            ArraySpan { .array = local_get(owner), .at = i32_const(0) },
            ArraySpan { .array = local_get(bytes), .at = local_get(start) },
            local_get(length),
        ),
    ]
    shared: WasmExpression[]: [
        local_set(owner, local_get(bytes)),
        local_set(owner_start, local_get(start)),
    ]
    ascii :: call(ctx.atom_ascii(), [local_get(owner), local_get(owner_start), local_get(length)])
    new_entry :: struct_new(
        gc.atom,
        [
            local_get(owner),
            local_get(owner_start),
            local_get(length),
            local_get(hash),
            ascii,
        ],
    )
    new_slot :: i64_or(i64_shl(local_get(low), i64_const(32)), i64_extend_i32_u(local_get(atom)))
    three_quarters :: i32_mul(i32_shr_u(local_get(mask), i32_const(2)), i32_const(3))
    body: WasmExpression[]: [
        when(i32_eqz(local_get(length)), [return_([i32_const(0)])]),
        local_set(
            hash,
            call(ctx.atom_hash(), [local_get(bytes), local_get(start), local_get(length)]),
        ),
        local_set(low, i64_and(local_get(hash), i64_const(LOW_HALF))),
        local_set(index, global_get(table.slots)),
        local_set(mask, i32_sub(array_len(i64_storage, local_get(index)), i32_const(1))),
        local_set(position, i32_and(local_get(mask), i32_wrap_i64(local_get(hash)))),
        // Probe until an empty slot: a miss.
        loop_until(
            i64_eqz(slot_read),
            [when(i64_eq(slot_hash, local_get(low)), found), next_slot(position, mask)],
        ),
        when_else(local_get(copy), copied, shared),
        // The new atom, the next one.
        call(ctx.atom_room(), []),
        local_set(atom, global_get(table.count)),
        array_set(storage_type(gc, .EqRef), global_get(table.entries), local_get(atom), new_entry),
        global_set(table.count, plus(atom, 1)),
        // Its slot, the empty one the probe stopped at.
        array_set(i64_storage, local_get(index), local_get(position), new_slot),
        global_set(table.used, i32_add(global_get(table.used), i32_const(1))),
        // Past three quarters taken, the index doubles: a probe always meets an
        // empty slot.
        when(i32_gt_s(global_get(table.used), three_quarters), [call(ctx.atom_rehash(), [])]),
        local_get(atom),
    ]
    return ctx.define_tree_helper("atom.intern", frame, body)
}

// The local `position` moved to the next slot of an index of mask `mask`.
next_slot :: fn(position: i32, mask: i32) -> WasmExpression =
    local_set(position, i32_and(plus(position, 1), local_get(mask)))

// `() -> ()`: room for one more entry, the entries doubled when full.
atom_room :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["atom.room"] else define_room(ctx)

define_room :: fn(ctx: ModuleCtx) -> i32 {
    table :: atom_globals(ctx)
    references :: storage_type(ctx.gc, .EqRef)
    frame :: HelperFrame { .signature = func_of([], []) }
    grown :: frame.local(.EqRef)
    full :: i32_eq(global_get(table.count), array_len(references, global_get(table.entries)))
    body: WasmExpression[]: [
        when(
            full,
            [
                local_set(
                    grown,
                    array_new_default(references, i32_shl(global_get(table.count), i32_const(1))),
                ),
                array_copy(
                    references,
                    ArraySpan { .array = local_get(grown), .at = i32_const(0) },
                    ArraySpan { .array = global_get(table.entries), .at = i32_const(0) },
                    global_get(table.count),
                ),
                global_set(table.entries, local_get(grown)),
            ],
        ),
    ]
    return ctx.define_tree_helper("atom.room", frame, body)
}

// `() -> ()`: the index twice as large, each slot moved where its hash puts it.
atom_rehash :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["atom.rehash"] else define_rehash(ctx)

define_rehash :: fn(ctx: ModuleCtx) -> i32 {
    table :: atom_globals(ctx)
    i64_storage :: storage_type(ctx.gc, .I64)
    frame :: HelperFrame { .signature = func_of([], []) }
    old :: frame.local(.EqRef)
    grown :: frame.local(.EqRef)
    length :: frame.local(.I32)
    i :: frame.local(.I32)
    slot :: frame.local(.I64)
    at :: frame.local(.I32)
    mask :: frame.local(.I32)
    taken :: array_get(i64_storage, local_get(grown), local_get(at))
    moved: WasmExpression[]: [
        local_set(
            at,
            i32_and(i32_wrap_i64(i64_shr_u(local_get(slot), i64_const(32))), local_get(mask)),
        ),
        loop_until(i64_eqz(taken), [next_slot(at, mask)]),
        array_set(i64_storage, local_get(grown), local_get(at), local_get(slot)),
    ]
    body: WasmExpression[]: [
        local_set(old, global_get(table.slots)),
        local_set(length, array_len(i64_storage, local_get(old))),
        local_set(mask, i32_shl(local_get(length), i32_const(1))),
        local_set(grown, array_new_default(i64_storage, local_get(mask))),
        local_set(mask, less(mask, 1)),
        repeat(
            .I32,
            i,
            length,
            [
                local_set(slot, array_get(i64_storage, local_get(old), local_get(i))),
                when(i64_ne(local_get(slot), i64_const(0)), moved),
            ],
        ),
        global_set(table.slots, local_get(grown)),
    ]
    return ctx.define_tree_helper("atom.rehash", frame, body)
}

// `(x, x_start: i32, y, y_start: i32, length: i32) -> i32`: whether two runs of
// `length` bytes of `i8` storages are the same.
atom_equal :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["atom.equal"] else define_equal(ctx)

define_equal :: fn(ctx: ModuleCtx) -> i32 {
    gc :: ctx.gc
    x :: 0
    x_start :: 1
    y :: 2
    y_start :: 3
    length :: 4
    frame :: HelperFrame { .signature = func_of([.EqRef, .I32, .EqRef, .I32, .I32], [.I32]) }
    k :: frame.local(.I32)
    x_byte :: byte_in(gc, local_get(x), i32_add(local_get(x_start), local_get(k)))
    y_byte :: byte_in(gc, local_get(y), i32_add(local_get(y_start), local_get(k)))
    body: WasmExpression[]: [
        repeat(.I32, k, length, [when(i32_ne(x_byte, y_byte), [return_([i32_const(0)])])]),
        i32_const(1),
    ]
    return ctx.define_tree_helper("atom.equal", frame, body)
}

// `(bytes, start: i32, length: i32) -> i32`: whether every byte of the run is
// below 0x80.
atom_ascii :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["atom.ascii"] else define_ascii(ctx)

define_ascii :: fn(ctx: ModuleCtx) -> i32 {
    bytes :: 0
    start :: 1
    length :: 2
    frame :: HelperFrame { .signature = func_of([.EqRef, .I32, .I32], [.I32]) }
    k :: frame.local(.I32)
    // The bits of every byte.
    bits :: frame.local(.I32)
    byte :: byte_in(ctx.gc, local_get(bytes), i32_add(local_get(start), local_get(k)))
    body: WasmExpression[]: [
        repeat(.I32, k, length, [local_set(bits, i32_or(local_get(bits), byte))]),
        i32_lt_u(local_get(bits), i32_const(0x80)),
    ]
    return ctx.define_tree_helper("atom.ascii", frame, body)
}

// ---- the hash -------------------------------------------------------------

// `(bytes, start: i32, length: i32) -> i64`: the hash of a run of an `i8`
// storage, `vader_atom_hash64`'s.
atom_hash :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["atom.hash"] else define_hash(ctx)

// The locals are named as `vader_atom_hash64` names them: the position read, the
// bytes left, the seed and the two others of the long runs, the two words mixed
// last, the offset of the second word of a short run.
define_hash :: fn(ctx: ModuleCtx) -> i32 {
    bytes :: 0
    start :: 1
    length :: 2
    frame :: HelperFrame { .signature = func_of([.EqRef, .I32, .I32], [.I64]) }
    p :: frame.local(.I32)
    left :: frame.local(.I32)
    seed :: frame.local(.I64)
    seed1 :: frame.local(.I64)
    seed2 :: frame.local(.I64)
    a :: frame.local(.I64)
    b :: frame.local(.I64)
    q :: frame.local(.I32)
    read8 :: ctx.atom_read(8)
    read4 :: ctx.atom_read(4)
    mix :: ctx.atom_mix()
    // The word `read` takes at `p` plus `offset`, if any.
    word :: fn(read: i32, offset: WasmExpression | null) -> WasmExpression {
        if offset == null {
            return call(read, [local_get(bytes), local_get(p)])
        }
        return call(read, [local_get(bytes), i32_add(local_get(p), offset)])
    }
    // `into = mix(read8(p + at) ^ s, read8(p + at + 8) ^ into)`.
    round :: fn(into: i32, at: i32, s: i64) -> WasmExpression {
        first :: i64_xor(word(read8, offset_by(at)), i64_const(s))
        second :: i64_xor(word(read8, i32_const(at + 8)), local_get(into))
        return local_set(into, call(mix, [first, second]))
    }
    // Past `n` bytes.
    advance :: fn(n: i32) -> WasmExpression[] = [
        local_set(p, plus(p, n)),
        local_set(left, less(left, n)),
    ]
    // `(high << 32) | low`, the two words `read4` takes at their offsets.
    joined :: fn(high: WasmExpression | null, low: WasmExpression) -> WasmExpression =
        i64_or(i64_shl(word(read4, high), i64_const(32)), word(read4, low))
    // Where the last word of a run of 4 to 16 bytes starts.
    last_word :: less(length, 4)
    // A run of 4 to 16 bytes: two pairs of words.
    short: WasmExpression[]: [
        local_set(q, i32_shl(i32_shr_u(local_get(length), i32_const(3)), i32_const(2))),
        local_set(a, joined(null, local_get(q))),
        local_set(b, joined(last_word, i32_sub(last_word, local_get(q)))),
    ]
    tiny :: when(
        local_get(length),
        [local_set(a, call(ctx.atom_read3(), [local_get(bytes), local_get(p), local_get(length)]))],
    )
    blocks_of_48: WasmExpression[]: [
        round(seed, 0, HASH_S1),
        round(seed1, 16, HASH_S2),
        round(seed2, 32, HASH_S3),
    ]
    blocks_of_48.push_all(advance(48))
    block_of_16: WasmExpression[]: [round(seed, 0, HASH_S1)]
    block_of_16.push_all(advance(16))
    long: WasmExpression[]: [
        local_set(left, local_get(length)),
        when(
            i32_gt_s(local_get(left), i32_const(48)),
            [
                local_set(seed2, local_tee(seed1, local_get(seed))),
                do_while(blocks_of_48, i32_gt_s(local_get(left), i32_const(48))),
                local_set(
                    seed,
                    i64_xor(i64_xor(local_get(seed), local_get(seed1)), local_get(seed2)),
                ),
            ],
        ),
        loop_until(i32_le_s(local_get(left), i32_const(16)), block_of_16),
        // The last 16 bytes, which may overlap the blocks read before.
        local_set(a, word(read8, less(left, 16))),
        local_set(b, word(read8, less(left, 8))),
    ]
    mum :: call(
        ctx.atom_mum(),
        [i64_xor(local_get(a), i64_const(HASH_S1)), i64_xor(local_get(b), local_get(seed))],
    )
    first :: i64_xor(i64_xor(local_get(a), i64_const(HASH_S0)), i64_extend_i32_u(local_get(length)))
    body: WasmExpression[]: [
        local_set(p, local_get(start)),
        local_set(seed, i64_const(HASH_SEED)),
        when_else(
            i32_le_s(local_get(length), i32_const(16)),
            [when_else(i32_ge_s(local_get(length), i32_const(4)), short, [tiny])],
            long,
        ),
        unpack([a, b], mum),
        call(mix, [first, i64_xor(local_get(b), i64_const(HASH_S1))]),
    ]
    return ctx.define_tree_helper("atom.hash", frame, body)
}

// The constant `n`, null for 0.
offset_by :: fn(n: i32) -> WasmExpression | null {
    if n == 0 {
        return null
    }
    return i32_const(n)
}

// `(bytes, at: i32) -> i64`: the `width` bytes from `at` on, little-endian.
atom_read :: fn(ctx: ModuleCtx, width: i32) -> i32 {
    key :: "atom.read${width}"
    return ctx.helpers[key] else define_read(ctx, key, width)
}

define_read :: fn(ctx: ModuleCtx, key: string, width: i32) -> i32 {
    bytes :: 0
    at :: 1
    frame :: HelperFrame { .signature = func_of([.EqRef, .I32], [.I64]) }
    value := i64_extend_i32_u(byte_in(ctx.gc, local_get(bytes), local_get(at)))
    for k in 1..<width {
        byte :: i64_extend_i32_u(byte_in(ctx.gc, local_get(bytes), plus(at, k)))
        value = i64_or(value, i64_shl(byte, i64_const(i64(8 * k))))
    }
    return ctx.define_tree_helper(key, frame, [value])
}

// `(bytes, at: i32, length: i32) -> i64`: a run of 1 to 3 bytes as wyhash
// folds it, `p[0] << 16 | p[length >> 1] << 8 | p[length - 1]`.
atom_read3 :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["atom.read3"] else define_read3(ctx)

define_read3 :: fn(ctx: ModuleCtx) -> i32 {
    bytes :: 0
    at :: 1
    length :: 2
    frame :: HelperFrame { .signature = func_of([.EqRef, .I32, .I32], [.I64]) }
    byte :: fn(position: WasmExpression) -> WasmExpression =
        i64_extend_i32_u(byte_in(ctx.gc, local_get(bytes), position))
    middle :: i32_add(local_get(at), i32_shr_u(local_get(length), i32_const(1)))
    last :: i32_sub(i32_add(local_get(at), local_get(length)), i32_const(1))
    first_two :: i64_or(
        i64_shl(byte(local_get(at)), i64_const(16)),
        i64_shl(byte(middle), i64_const(8)),
    )
    return ctx.define_tree_helper("atom.read3", frame, [i64_or(first_two, byte(last))])
}

// `(a: i64, b: i64) -> (low: i64, high: i64)`: the 128-bit product, from the
// products of their 32-bit halves.
atom_mum :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["atom.mum"] else define_mum(ctx)

define_mum :: fn(ctx: ModuleCtx) -> i32 {
    a :: 0
    b :: 1
    frame :: HelperFrame { .signature = func_of([.I64, .I64], [.I64, .I64]) }
    a_low :: frame.local(.I64)
    a_high :: frame.local(.I64)
    b_low :: frame.local(.I64)
    b_high :: frame.local(.I64)
    low_low :: frame.local(.I64)
    low_high :: frame.local(.I64)
    high_low :: frame.local(.I64)
    middle :: frame.local(.I64)
    product :: fn(x: i32, y: i32) -> WasmExpression = i64_mul(local_get(x), local_get(y))
    body: WasmExpression[]: [
        local_set(a_low, half_low(a)),
        local_set(a_high, half_high(a)),
        local_set(b_low, half_low(b)),
        local_set(b_high, half_high(b)),
        local_set(low_low, product(a_low, b_low)),
        local_set(low_high, product(a_low, b_high)),
        local_set(high_low, product(a_high, b_low)),
        // middle = (low_low >> 32) + low(low_high) + low(high_low)
        local_set(
            middle,
            i64_add(i64_add(half_high(low_low), half_low(low_high)), half_low(high_low)),
        ),
        // low = low(low_low) | middle << 32
        i64_or(half_low(low_low), i64_shl(local_get(middle), i64_const(32))),
        // high = a_high * b_high + (low_high >> 32) + (high_low >> 32) + (middle >> 32)
        i64_add(
            i64_add(i64_add(product(a_high, b_high), half_high(low_high)), half_high(high_low)),
            half_high(middle),
        ),
    ]
    return ctx.define_tree_helper("atom.mum", frame, body)
}

// The low 32 bits of the `i64` local `x`.
half_low :: fn(x: i32) -> WasmExpression = i64_and(local_get(x), i64_const(LOW_HALF))

// The high 32 bits of the `i64` local `x`, shifted down.
half_high :: fn(x: i32) -> WasmExpression = i64_shr_u(local_get(x), i64_const(32))

// `(a: i64, b: i64) -> i64`: the two halves of their 128-bit product, xored.
atom_mix :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["atom.mix"] else define_mix(ctx)

define_mix :: fn(ctx: ModuleCtx) -> i32 {
    frame :: HelperFrame { .signature = func_of([.I64, .I64], [.I64]) }
    // The xor takes both halves the product leaves.
    halves :: call(ctx.atom_mum(), [local_get(0), local_get(1)])
    return ctx.define_tree_helper("atom.mix", frame, [apply(Plain { .op = .I64Xor }, [halves])])
}

// ---- string ops -----------------------------------------------------------

// `(atom) -> i64`: the length in bytes.
string_byte_len :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["string.byte_len"]
    else ctx.define_entry_read(
        "string.byte_len",
        .I64,
        (e) -> i64_extend_i32_u(entry_get(ctx, e, ATOM_LENGTH)),
    )

// `(atom) -> i64`: the hash the entry keeps.
string_hash :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["string.hash"]
    else ctx.define_entry_read("string.hash", .I64, (e) -> entry_get(ctx, e, ATOM_HASH))

// `(atom) -> bool`: whether every byte of the string is below 0x80, which its
// entry keeps.
string_is_ascii :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["string.is_ascii"]
    else ctx.define_entry_read("string.is_ascii", .I32, (e) -> entry_get(ctx, e, ATOM_ASCII))

// `(atom) -> result`: what `read` takes from the atom's entry.
define_entry_read :: fn(
    ctx: ModuleCtx,
    key: string,
    result: WasmValType,
    read: fn(WasmExpression) -> WasmExpression,
) -> i32 {
    frame :: HelperFrame { .signature = func_of([.I32], [result]) }
    return ctx.define_tree_helper(key, frame, [read(ctx.entry_at(local_get(0)))])
}

// `(atom, index: i64) -> i32`: the byte at `index`; past the end, the run stops.
string_byte_at :: fn(ctx: ModuleCtx) -> i32 =
    ctx.helpers["string.byte_at"] else define_byte_at(ctx)

define_byte_at :: fn(ctx: ModuleCtx) -> i32 {
    atom :: 0
    index :: 1
    frame :: HelperFrame { .signature = func_of([.I32, .I64], [.I32]) }
    entry :: frame.local(.EqRef)
    length :: i64_extend_i32_u(entry_field(ctx, entry, ATOM_LENGTH))
    at :: i32_add(entry_field(ctx, entry, ATOM_START), i32_wrap_i64(local_get(index)))
    body: WasmExpression[]: [
        local_set(entry, ctx.entry_at(local_get(atom))),
        trap_if(ctx, binary(.I64GeU, local_get(index), length)),
        byte_in(ctx.gc, entry_field(ctx, entry, ATOM_BYTES), at),
    ]
    return ctx.define_tree_helper("string.byte_at", frame, body)
}

// `(a: atom, b: atom) -> i32`: -1, 0 or 1 as `a` orders before, with or after
// `b`, byte by byte, a proper prefix first, as `string.compare` orders.
string_compare :: fn(ctx: ModuleCtx) -> i32 =
    ctx.helpers["string.compare"] else define_compare(ctx)

define_compare :: fn(ctx: ModuleCtx) -> i32 {
    a :: 0
    b :: 1
    frame :: HelperFrame { .signature = func_of([.I32, .I32], [.I32]) }
    side_a :: frame.side_of(ctx, a)
    side_b :: frame.side_of(ctx, b)
    at :: frame.local(.I32)
    shorter :: frame.local(.I32)
    difference :: frame.local(.I32)
    byte_a :: byte_in(
        ctx.gc,
        local_get(side_a.bytes),
        i32_add(local_get(side_a.start), local_get(at)),
    )
    byte_b :: byte_in(
        ctx.gc,
        local_get(side_b.bytes),
        i32_add(local_get(side_b.start), local_get(at)),
    )
    length_a :: local_get(side_a.length)
    length_b :: local_get(side_b.length)
    differs :: local_tee(difference, i32_sub(byte_a, byte_b))
    body: WasmExpression[]: [when(i32_eq(local_get(a), local_get(b)), [return_([i32_const(0)])])]
    body.push_all(side_a.reads)
    body.push_all(side_b.reads)
    body.push_all(
        [
            local_set(shorter, select(length_a, length_b, i32_lt_u(length_a, length_b))),
            repeat(.I32, at, shorter, [when(differs, [return_([sign_of(difference)])])]),
            local_set(difference, i32_sub(length_a, length_b)),
            sign_of(difference),
        ],
    )
    return ctx.define_tree_helper("string.compare", frame, body)
}

// The bytes, start and length of one side of a comparison, in locals, and what
// reads them from the entry of the atom in its parameter.
CompareSide :: struct {
    bytes: i32
    start: i32
    length: i32
    reads: WasmExpression[]
}

side_of :: fn(frame: HelperFrame, ctx: ModuleCtx, atom: i32) -> CompareSide {
    entry :: frame.local(.EqRef)
    bytes :: frame.local(.EqRef)
    start :: frame.local(.I32)
    length :: frame.local(.I32)
    return CompareSide {
        .bytes = bytes,
        .start = start,
        .length = length,
        .reads = [
            local_set(entry, ctx.entry_at(local_get(atom))),
            local_set(bytes, entry_field(ctx, entry, ATOM_BYTES)),
            local_set(start, entry_field(ctx, entry, ATOM_START)),
            local_set(length, entry_field(ctx, entry, ATOM_LENGTH)),
        ],
    }
}

// -1, 0 or 1 as the `i32` local `x` is negative, zero or positive.
sign_of :: fn(x: i32) -> WasmExpression =
    i32_sub(i32_gt_s(local_get(x), i32_const(0)), binary(.I32LtS, local_get(x), i32_const(0)))

// `(atom, from: i64, to: i64) -> atom`: the bytes `from..<to`, the bounds clamped
// to the string as an array slice clamps them, as a string that shares the
// bytes.
string_byte_slice :: fn(ctx: ModuleCtx) -> i32 =
    ctx.helpers["string.byte_slice"] else define_byte_slice(ctx)

define_byte_slice :: fn(ctx: ModuleCtx) -> i32 {
    atom :: 0
    from :: 1
    to :: 2
    frame :: HelperFrame { .signature = func_of([.I32, .I64, .I64], [.I32]) }
    entry :: frame.local(.EqRef)
    length :: frame.local(.I64)
    start :: i32_add(entry_field(ctx, entry, ATOM_START), i32_wrap_i64(local_get(from)))
    count :: i32_wrap_i64(binary(.I64Sub, local_get(to), local_get(from)))
    body: WasmExpression[]: [
        local_set(entry, ctx.entry_at(local_get(atom))),
        local_set(length, i64_extend_i32_u(entry_field(ctx, entry, ATOM_LENGTH))),
        clamp(from, i64_const(0), .I64LtS),
        clamp(to, i64_const(0), .I64LtS),
        clamp(from, local_get(length), .I64GtS),
        clamp(to, local_get(from), .I64LtS),
        clamp(to, local_get(length), .I64GtS),
        call(ctx.atom_intern(), [entry_field(ctx, entry, ATOM_BYTES), start, count, i32_const(0)]),
    ]
    return ctx.define_tree_helper("string.byte_slice", frame, body)
}

// `(array) -> atom`: the string of the elements of a `u8[]`, a copy of them
// when new: the array may change after.
bytes_to_string :: fn(ctx: ModuleCtx) -> i32 =
    ctx.helpers["string.bytes_to_string"] else define_bytes_to_string(ctx)

define_bytes_to_string :: fn(ctx: ModuleCtx) -> i32 {
    frame :: HelperFrame { .signature = func_of([.EqRef], [.I32]) }
    arguments: WasmExpression[]: [
        header_field(ctx.gc, 0, HEADER_STORAGE),
        header_field(ctx.gc, 0, HEADER_OFFSET),
        i32_wrap_i64(header_field(ctx.gc, 0, HEADER_LENGTH)),
        i32_const(1),
    ]
    return ctx.define_tree_helper(
        "string.bytes_to_string",
        frame,
        [call(ctx.atom_intern(), arguments)],
    )
}

// `(atom) -> array`: the bytes of the string, an array of the type `type_id`
// over the entry's storage, marked `shared` so that a push copies them first.
string_bytes :: fn(ctx: ModuleCtx, type_id: i32) -> i32 {
    key :: "string.bytes.${type_id}"
    return ctx.helpers[key] else define_string_bytes(ctx, key, type_id)
}

define_string_bytes :: fn(ctx: ModuleCtx, key: string, type_id: i32) -> i32 {
    atom :: 0
    frame :: HelperFrame { .signature = func_of([.I32], [.EqRef]) }
    entry :: frame.local(.EqRef)
    length :: i64_extend_i32_u(entry_field(ctx, entry, ATOM_LENGTH))
    header :: HeaderFields {
        .type_id = i32_const(type_id),
        .element = i32_const(class_code(.U8)),
        .length = length,
        .capacity = length,
        .offset = entry_field(ctx, entry, ATOM_START),
        .storage = entry_field(ctx, entry, ATOM_BYTES),
        .shared = i32_const(1),
    }
    body: WasmExpression[]: [
        local_set(entry, ctx.entry_at(local_get(atom))),
        new_header(ctx.gc, header),
    ]
    return ctx.define_tree_helper(key, frame, body)
}

// ---- buffers --------------------------------------------------------------
//
// A `Buffer` is an `i8` storage itself, with no header: the bytecode reaches it
// only through the buffer ops. An offset past the greatest storage stops the run
// rather than wrap to 32 bits; one past the end of the buffer traps in the
// access.

// Stop the run when the `i64` local `offset` is, unsigned, past the greatest
// storage: a negative offset is past any.
offset_check :: fn(ctx: ModuleCtx, offset: i32) -> WasmExpression =
    trap_above(ctx, local_get(offset), i64_const(STORAGE_GREATEST))

// Stop the run when the `i64` `value` is, unsigned, above `limit`.
trap_above :: fn(ctx: ModuleCtx, value: WasmExpression, limit: WasmExpression) -> WasmExpression =
    trap_if(ctx, binary(.I64GtU, value, limit))

// `(size: i64) -> buffer`: `size` zero bytes, an `i8` storage.
buffer_new :: fn(ctx: ModuleCtx) -> i32 = ctx.helpers["buffer.new"] else define_buffer_new(ctx)

define_buffer_new :: fn(ctx: ModuleCtx) -> i32 {
    size :: 0
    frame :: HelperFrame { .signature = func_of([.I64], [.EqRef]) }
    body: WasmExpression[]: [
        offset_check(ctx, size),
        array_new_default(storage_type(ctx.gc, .I8), i32_wrap_i64(local_get(size))),
    ]
    return ctx.define_tree_helper("buffer.new", frame, body)
}

// `(buffer, offset: i64, atom) -> ()`: the bytes of the string written into the
// buffer from `offset` on; past its end, the run stops.
buffer_write_string :: fn(ctx: ModuleCtx) -> i32 =
    ctx.helpers["buffer.write_string"] else define_write_string(ctx)

define_write_string :: fn(ctx: ModuleCtx) -> i32 {
    buffer :: 0
    offset :: 1
    atom :: 2
    frame :: HelperFrame { .signature = func_of([.EqRef, .I64, .I32], []) }
    entry :: frame.local(.EqRef)
    body: WasmExpression[]: [
        offset_check(ctx, offset),
        local_set(entry, ctx.entry_at(local_get(atom))),
        array_copy(
            storage_type(ctx.gc, .I8),
            ArraySpan { .array = local_get(buffer), .at = i32_wrap_i64(local_get(offset)) },
            ArraySpan {
                .array = entry_field(ctx, entry, ATOM_BYTES),
                .at = entry_field(ctx, entry, ATOM_START),
            },
            entry_field(ctx, entry, ATOM_LENGTH),
        ),
    ]
    return ctx.define_tree_helper("buffer.write_string", frame, body)
}

// `(buffer, length: i64) -> atom`: the string of the first `length` bytes of the
// buffer, copied when new; past its end, the run stops.
buffer_to_string :: fn(ctx: ModuleCtx) -> i32 =
    ctx.helpers["buffer.to_string"] else define_buffer_to_string(ctx)

define_buffer_to_string :: fn(ctx: ModuleCtx) -> i32 {
    buffer :: 0
    length :: 1
    frame :: HelperFrame { .signature = func_of([.EqRef, .I64], [.I32]) }
    size :: i64_extend_i32_u(array_len(storage_type(ctx.gc, .I8), local_get(buffer)))
    string :: call(
        ctx.atom_intern(),
        [local_get(buffer), i32_const(0), i32_wrap_i64(local_get(length)), i32_const(1)],
    )
    body: WasmExpression[]: [trap_above(ctx, local_get(length), size), string]
    return ctx.define_tree_helper("buffer.to_string", frame, body)
}

// `(buffer, offset: i64) -> i32`: the byte at `offset`, unsigned.
buffer_load_u8 :: fn(ctx: ModuleCtx) -> i32 =
    ctx.helpers["buffer.load_u8"] else define_load_u8(ctx)

define_load_u8 :: fn(ctx: ModuleCtx) -> i32 {
    buffer :: 0
    offset :: 1
    frame :: HelperFrame { .signature = func_of([.EqRef, .I64], [.I32]) }
    byte :: byte_in(ctx.gc, local_get(buffer), i32_wrap_i64(local_get(offset)))
    return ctx.define_tree_helper("buffer.load_u8", frame, [offset_check(ctx, offset), byte])
}

// `(buffer, offset: i64, byte: i32) -> ()`: the byte written at `offset`.
buffer_store_u8 :: fn(ctx: ModuleCtx) -> i32 =
    ctx.helpers["buffer.store_u8"] else define_store_u8(ctx)

define_store_u8 :: fn(ctx: ModuleCtx) -> i32 {
    buffer :: 0
    offset :: 1
    byte :: 2
    frame :: HelperFrame { .signature = func_of([.EqRef, .I64, .I32], []) }
    at :: i32_wrap_i64(local_get(offset))
    store :: array_set(storage_type(ctx.gc, .I8), local_get(buffer), at, local_get(byte))
    return ctx.define_tree_helper("buffer.store_u8", frame, [offset_check(ctx, offset), store])
}

// `(destination, at: i64, source, from: i64, count: i64) -> ()`: `count` bytes of
// `source` from `from` on copied into `destination` from `at` on, the two runs
// free to overlap.
buffer_memory_copy :: fn(ctx: ModuleCtx) -> i32 =
    ctx.helpers["buffer.memory_copy"] else define_memory_copy(ctx)

define_memory_copy :: fn(ctx: ModuleCtx) -> i32 {
    destination :: 0
    at :: 1
    source :: 2
    from :: 3
    count :: 4
    frame :: HelperFrame { .signature = func_of([.EqRef, .I64, .EqRef, .I64, .I64], []) }
    copy :: array_copy(
        storage_type(ctx.gc, .I8),
        ArraySpan { .array = local_get(destination), .at = i32_wrap_i64(local_get(at)) },
        ArraySpan { .array = local_get(source), .at = i32_wrap_i64(local_get(from)) },
        i32_wrap_i64(local_get(count)),
    )
    body: WasmExpression[]: [
        offset_check(ctx, at),
        offset_check(ctx, from),
        offset_check(ctx, count),
        copy,
    ]
    return ctx.define_tree_helper("buffer.memory_copy", frame, body)
}

// ---- tests ----------------------------------------------------------------

import "std/abort"
import "std/iter"
import "std/testing"

@test
test_literals_take_atoms_in_order_each_once :: fn() -> void {
    program :: straight([Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } }])
    program.strings = ["ab", "", "c", "ab"]
    literals :: literals_of(program)
    assert(literals.atom_of.content_equals([1, 0, 2, 1]), "the empty string is atom 0")
    assert(literals.bytes.content_equals([0x61, 0x62, 0x63]), "one copy of each literal")
    assert(literals.starts.content_equals([0, 2]), "each literal a slice of the segment")
}

// `"ab".byte_len()`: a program that reads the table.
byte_len_program :: fn() -> Bc.BytecodeModule {
    program :: straight(
        [
            Bc.StringConst { .index = 0 },
            Bc.StringByteLen {},
            Bc.Drop {},
            Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } },
        ],
    )
    program.strings = ["ab"]
    return program
}

@test
test_run_builds_the_atom_table_before_the_entry :: fn() -> void {
    wasm :: wasm_module_of(byte_len_program(), "") else panic(wasm.reason)
    assert_eq(wasm.data.len(), 1)
    run :: wasm.functions[wasm.exports[0].function_index].body
    init :: run[0]
    entry :: run[1]
    assert(init is Call && init.function_index != 0, "`run` calls the init first")
    assert(entry is Call && entry.function_index == 0, "then the entry")
}

@test
test_a_string_literal_is_its_atom :: fn() -> void {
    wasm :: wasm_module_of(byte_len_program(), "") else panic(wasm.reason)
    literal :: wasm.functions[0].body[0]
    assert(literal is I32Const && literal.value == 1, "`ab` is atom 1")
}

// A program with no literal that makes a string from a buffer still builds the
// table first.
@test
test_a_string_made_at_run_time_builds_the_table :: fn() -> void {
    body: Bc.Op[]: [
        Bc.I64Const { .value = 2 },
        Bc.BufferNew {},
        Bc.I64Const { .value = 2 },
        Bc.BufferToString {},
        Bc.Drop {},
        Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } },
    ]
    wasm :: wasm_module_of(straight(body), "") else panic(wasm.reason)
    assert_eq(wasm.data.len(), 0)
    run :: wasm.functions[wasm.exports[0].function_index].body
    assert_eq(run.filter_is<Call>().count(), 2)
}

@test
test_a_program_without_strings_has_no_table :: fn() -> void {
    wasm :: wasm_module_of(straight([Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } }]), "")
        else panic(wasm.reason)
    assert_eq(wasm.data.len(), 0)
    assert_eq(wasm.globals.len(), 0)
}
