// vader/emit/wasm/structs: the references, as Wasm GC holds them.
//
// Every reference is held as `(ref null eq)`, in a local as in a field: a
// struct, a box, null. An access to a struct casts it first (`ref.cast`), so the
// function types and the fields name no struct type, and two struct types never
// depend on each other. Each `BcStruct` of the bytecode is a struct type, and so
// is the box of each scalar class, which holds a scalar where an `any`, a union
// or a nullable slot is: one box per class, so that `is u8` tells a `u8` from an
// `i32`. All of them are in one recursion group, which keeps two of one shape
// distinct for `ref.test`. `void` held in such a slot is the box of no field.

module "vader/emit/wasm"

Bc :: import "vader/core/bytecode"
import "std/abort"
import "std/collections"
import "std/iter"
import "std/string_builder"
import "vader/core/mangle"

/// The struct and array types of a module, and where each Vader type finds its
/// own.
export GcTypes :: struct {
    types: WasmGcType[] = []
    /// The WASM type of each `BcStruct`, by its index in the bytecode types.
    of_struct: Map<i32, i32> = Map<i32, i32> {}
    /// The supertype a struct shares with its layout siblings, by its index in
    /// the bytecode types; a struct with no sibling has none.
    of_layout: Map<i32, i32> = Map<i32, i32> {}
    /// The box of each scalar class.
    of_box: Map<Bc.ValType, i32> = Map<Bc.ValType, i32> {}
    /// The box of `void`, which holds nothing.
    void_box: i32 = -1
    /// The array type of each way of storing elements (`arrays.vader`).
    storages: Map<WasmStorageType, i32> = Map<WasmStorageType, i32> {}
    /// The one struct type every array is (`arrays.vader`).
    array_header: i32 = -1
    /// The boxed classes some array type of the module has for elements, in the
    /// order of `BOXED_CLASSES`.
    array_classes: Bc.ValType[] = []
    /// The struct type of an entry of the atom table (`strings.vader`).
    atom: i32 = -1
    /// The struct type of a function value (`closures.vader`).
    closure: i32 = -1
    /// The struct type of a `type` value: the index of the type it names.
    type_value: i32 = -1
    /// The struct type of a thread's record, in a program that starts threads
    /// (`threads.vader`).
    thread: i32 = -1
}

// The scalar classes a box exists for.
BOXED_CLASSES: Bc.ValType[]: [
    .I8,
    .I16,
    .I32,
    .I64,
    .U8,
    .U16,
    .U32,
    .U64,
    .F32,
    .F64,
    .Bool,
    .Char,
    .String,
]

/// The struct and array types of `m`: its structs in the order of its types,
/// then the boxes, the box of `void`, and the types every array is made of.
///
/// @param m  the program's bytecode.
export gc_types_of :: fn(m: Bc.BytecodeModule) -> GcTypes {
    out :: GcTypes {}
    keys :: m.types.map((t) -> layout_key(m, t)).collect()
    siblings :: Map<string, i32> {}
    for key in keys {
        if key != null {
            siblings[key] = (siblings[key] else 0) + 1
        }
    }
    layouts :: Map<string, i32> {}
    for i in 0..<m.types.len() {
        t :: m.types[i]
        if t is Bc.BcStruct {
            fields :: fields_of(m, t)
            key :: keys[i]
            if key == null || siblings[key] else 0 < 2 {
                out.of_struct[i32(i)] = out.add(fields)
                continue
            }
            layout :: layouts.get_or_put_with(
                key,
                () -> out.add_type(WasmStructType {
                    .fields = fields,
                    .open = true,
                }),
            )
            out.of_layout[i32(i)] = layout
            out.of_struct[i32(i)] = out.add_type(
                WasmStructType { .fields = fields, .supertype = layout },
            )
        }
    }
    for class in BOXED_CLASSES {
        out.of_box[class] = out.add([WasmField { .type = scalar_field_type(class) }])
    }
    out.void_box = out.add([])
    out.add_array_types(m)
    out.add_string_types()
    out.closure = out.add(
        [WasmField { .type = .EqRef }, WasmField { .type = .I32 }, WasmField { .type = .I32 }],
    )
    out.type_value = out.add([WasmField { .type = .I32 }])
    if starts_threads(m) {
        out.thread = out.add([WasmField { .type = .EqRef }, WasmField { .type = .EqRef }])
    }
    return out
}

// How each field of `t` is held.
fields_of :: fn(m: Bc.BytecodeModule, t: Bc.BcStruct) -> WasmField[] {
    fields: WasmField[]: []
    for f in t.fields {
        fields.push(WasmField { .type = field_type_of(m.types[f.type_index]) })
    }
    return fields
}

// The layout siblings of a struct are the instances of one generic struct, or
// two anonymous tuples, whose fields are held alike: the bytecode makes a value
// as one and reads it as another (a generic body erased to `Any` makes the
// `Box<Any>` its caller reads as a `Box<Point>`). They share a supertype, which
// the field accesses cast to, while `struct.new` and `is` keep each one's own
// type. Null for a type that belongs to no group.
layout_key :: fn(m: Bc.BytecodeModule, t: Bc.BcType) -> string | null {
    if t !is Bc.BcStruct {
        return null
    }
    group :: layout_group(t) else return null
    sb :: StringBuilder {}
    sb.append(group)
    for f in fields_of(m, t) {
        sb.append(":${value_type_byte(f.type)}")
    }
    return sb.to_string()
}

layout_group :: fn(t: Bc.BcStruct) -> string | null {
    if t.symbol_id >= 0 {
        return "s${t.symbol_id}"
    }
    if is_tuple_struct_name(t.name) {
        return "tuple"
    }
    return null
}

add :: fn(gc: GcTypes, fields: WasmField[]) -> i32 = gc.add_type(
    WasmStructType { .fields = fields },
)

add_type :: fn(gc: GcTypes, t: WasmGcType) -> i32 {
    gc.types.push(t)
    return i32(gc.types.len() - 1)
}

// The type of the field `field_index` of the struct type `t`.
field_held_as :: fn(gc: GcTypes, t: i32, field_index: i32) -> WasmValType {
    s :: gc.types[t]
    if s is WasmStructType {
        return s.fields[field_index].type
    }
    panic("wasm: type ${t} is no struct type")
}

// How a value of `t` is held: a scalar as itself, anything else as a reference.
field_type_of :: fn(t: Bc.BcType) -> WasmValType = match t {
    is Bc.BcScalar | Bc.BcNominal -> scalar_field_type(t.val)
    is Bc.BcStruct | Bc.BcArray | Bc.BcUnion | Bc.BcRef | Bc.BcFn -> .EqRef
}

// A string is an `i32` atom (ADR 0175). `void` in a slot is its box. A foreign
// pointer never reaches WASM code, only a field declared with it.
scalar_field_type :: fn(v: Bc.ValType) -> WasmValType = match v {
    .I8 | .I16 | .I32 | .U8 | .U16 | .U32 | .Bool | .Char | .String -> .I32
    .I64 | .U64 | .Pointer -> .I64
    // An `f32` is held at the width of an `f64`, as the VM holds it: it rounds
    // to 32 bits where its bits are read (`f32.to_bits`) and nowhere else.
    .F32 | .F64 -> .F64
    .Null | .Void | .Ref | .Any -> .EqRef
}

// The box a value of `t` is held in where any type may be, null for a type held
// as a reference, or a foreign pointer.
box_of :: fn(gc: GcTypes, t: Bc.BcType) -> i32 | null {
    // An enum's own tag is held in the box of its representation.
    if t is Bc.BcNominal {
        return gc.of_box[t.val]
    }
    if t !is Bc.BcScalar {
        return null
    }
    if t.val == .Void {
        return gc.void_box
    }
    return gc.of_box[t.val]
}

// The scalar the box `box` holds.
unboxed :: fn(box: i32, value: WasmExpression) -> WasmExpression = struct_get(box, 0, value)

// `value`, a value of the scalar class `class` held as `from`, held as `to`: out
// of its box, into it, or as it is when both hold it alike. Null when the two
// meet at no box.
held_as :: fn(
    gc: GcTypes,
    value: WasmExpression,
    from: WasmValType,
    to: WasmValType,
    class: Bc.ValType,
) -> WasmExpression | null {
    if from == to {
        return value
    }
    box :: box_of(gc, Bc.BcScalar { .val = class }) else return null
    if from == .EqRef {
        return unboxed(box, value)
    }
    if to == .EqRef {
        return struct_new(box, [value])
    }
    return null
}

// `value`, held as `from`, held as `to`, in the box of `class` when one of the
// two is a reference; refused when they meet at no box.
adapted :: fn(
    ctx: ModuleCtx,
    value: WasmExpression,
    from: WasmValType,
    class: Bc.ValType,
    to: WasmValType,
    function: string,
) -> WasmExpression | WasmUnsupported {
    held :: held_as(ctx.gc, value, from, to, class)
        else return WasmUnsupported { .reason = "`${function}`: a value changes class" }
    return held
}

// `value`, of the class `from`, in the form of the class `to`: boxed or unboxed
// when one of the two is held as a reference.
class_changed :: fn(
    ctx: ModuleCtx,
    value: WasmExpression,
    from: Bc.ValType,
    to: Bc.ValType,
    function: string,
) -> WasmExpression | WasmUnsupported {
    to_held :: scalar_field_type(to)
    scalar :: if to_held == .EqRef { from } else { to }
    return adapted(ctx, value, scalar_field_type(from), scalar, to_held, function)
}

// The value on the stack, as `adapted` brings it.
push_adapted :: fn(
    body: WasmInstr[],
    ctx: ModuleCtx,
    from: WasmValType,
    class: Bc.ValType,
    to: WasmValType,
    function: string,
) -> void | WasmUnsupported {
    held :: adapted(ctx, on_stack(), from, class, to, function) else return held
    body.push_on_stack(held)
}

// ---- ops ------------------------------------------------------------------

// The WASM struct type of the bytecode struct `type_id`.
struct_type :: fn(ctx: ModuleCtx, type_id: i32, function: string) -> i32 | WasmUnsupported {
    return ctx.gc.of_struct[type_id] else return WasmUnsupported {
        .reason = "`${function}`: type ${type_id} is no struct, which only unions of structs reach",
    }
}

// The WASM type a field access of the bytecode struct `type_id` casts to: the
// supertype it shares with its layout siblings, else its own.
layout_type :: fn(ctx: ModuleCtx, type_id: i32, function: string) -> i32 | WasmUnsupported {
    layout :: ctx.gc.of_layout[type_id]
    if layout != null {
        return layout
    }
    return struct_type(ctx, type_id, function)
}

// `struct.get` of a bytecode struct, the reference on the stack.
push_field_read :: fn(
    ctx: ModuleCtx,
    out: WasmInstr[],
    type_id: i32,
    field_index: i32,
    function: string,
) -> void | WasmUnsupported {
    t :: layout_type(ctx, type_id, function) else return t
    out.push_all(
        [RefCast { .type_index = t }, StructGet { .type_index = t, .field_index = field_index }],
    )
}

// `struct.set` of a bytecode struct, the reference then the value on the stack:
// the value waits in a scratch local while the reference is cast.
push_field_write :: fn(
    ctx: ModuleCtx,
    scratch: Scratch,
    out: WasmInstr[],
    op: Bc.StructSet,
    function: string,
) -> void | WasmUnsupported {
    t :: layout_type(ctx, op.type_id, function) else return t
    value_type :: ctx.gc.field_held_as(t, op.field_index)
    held :: scratch.local_of(value_type)
    out.push_all(
        [
            LocalSet { .index = held },
            RefCast { .type_index = t },
            LocalGet { .index = held },
            StructSet { .type_index = t, .field_index = op.field_index },
        ],
    )
}

// `(value: eqref) -> field` for a `union.get`, `(value: eqref, field) -> ()` for a
// `union.set`: the field every variant of the union places at one slot, read or
// written through the variant the value is, tested in turn.
union_field :: fn(
    ctx: ModuleCtx,
    op: Bc.UnionFieldGet | Bc.UnionFieldSet,
    function: string,
) -> i32 | WasmUnsupported {
    reads :: op is Bc.UnionFieldGet
    kind :: if reads { "get" } else { "set" }
    key :: "union.${kind} ${op.type_id} ${op.field_index}"
    known :: ctx.helpers[key]
    if known != null {
        return known
    }
    types :: ctx.module.types
    union :: types[op.type_id]
    layout :: Bc.union_layout_struct(types, op.type_id) else {
        return WasmUnsupported {
            .reason = "`${function}`: type ${op.type_id} is no union of structs",
        }
    }
    if union !is Bc.BcUnion {
        return WasmUnsupported { .reason = "`${function}`: type ${op.type_id} is no union" }
    }
    shape :: Bc.struct_at(types, layout) else {
        return WasmUnsupported { .reason = "`${function}`: type ${layout} is no struct" }
    }
    held :: field_type_of(types[shape.fields[op.field_index].type_index])
    signature :: if reads {
        WasmFuncType { .params = [.EqRef], .results = [held] }
    } else {
        WasmFuncType { .params = [.EqRef, held], .results = [] }
    }
    value :: 0
    field :: 1
    body: WasmExpression[]: []
    for variant in union.variants {
        cast :: layout_type(ctx, variant, function) else return cast
        tested :: single_test(ctx, local_get(value), variant, function) else return tested
        access :: if reads {
            struct_get(cast, op.field_index, local_get(value))
        } else {
            struct_set(cast, op.field_index, local_get(value), local_get(field))
        }
        body.push(when(tested, [return_([access])]))
    }
    body.push(unreachable())
    return ctx.define_tree_helper(key, HelperFrame { .signature = signature }, body)
}

// `() -> type`: the value of the type `type_id`, made once, so that two values
// of one type are the same reference, as `ref.eq` compares them.
type_constant :: fn(ctx: ModuleCtx, type_id: i32) -> i32 {
    key :: "type.${type_id}"
    known :: ctx.helpers[key]
    if known != null {
        return known
    }
    return ctx.define_cached(key, struct_new(ctx.gc.type_value, [i32_const(type_id)]))
}

// `(type) -> i64`: the size of the type a `type` value names, read in a table
// of the size of every type of the module, made once.
size_of_type :: fn(ctx: ModuleCtx) -> i32 {
    known :: ctx.helpers["size_of.type"]
    if known != null {
        return known
    }
    sizes: WasmExpression[]: []
    for t in ctx.module.types {
        sizes.push(i64_const(Bc.size_of_bc_type(t)))
    }
    storage :: storage_type(ctx.gc, .I64)
    table :: ctx.define_cached("size_of.table", array_new_fixed(storage, sizes))
    named :: 0
    frame :: HelperFrame { .signature = func_of([.EqRef], [.I64]) }
    type_id :: struct_get(ctx.gc.type_value, 0, local_get(named))
    body: WasmExpression[]: [array_get(storage, call(table, []), type_id)]
    return ctx.define_tree_helper("size_of.type", frame, body)
}

// `ref.cast` of the bytecode: a value read out of a slot that holds any type, an
// erased field say, pinned to the type it has. Out of a reference into a scalar
// it unboxes; between two of one class it is nothing, every reference being held
// alike. `source` is how the value on the stack is held, null on an empty stack.
push_pin :: fn(
    ctx: ModuleCtx,
    out: WasmInstr[],
    op: Bc.RefCast,
    source: WasmValType | null,
    function: string,
) -> void | WasmUnsupported {
    target :: ctx.module.types[op.type_id]
    if source == null {
        return WasmUnsupported {
            .reason = "`${function}`: no class known for what `ref.cast` reads",
        }
    }
    to :: field_type_of(target)
    if source == to {
        return
    }
    if target is Bc.BcScalar {
        held :: held_as(ctx.gc, on_stack(), source, to, target.val)
        if held != null {
            out.push_on_stack(held)
            return
        }
    }
    return unsupported_op(op, function)
}

// `retag`: a scalar stored where any type may be, boxed in its class's box. The
// bytecode retags a scalar only, of the type `op` names.
push_retag :: fn(
    ctx: ModuleCtx,
    out: WasmInstr[],
    op: Bc.Retag,
    function: string,
) -> void | WasmUnsupported {
    box :: box_of(ctx.gc, ctx.module.types[op.type_id]) else return unsupported_op(op, function)
    out.push(StructNew { .type_index = box })
}

// `type_check`, and every test of a type: whether `value` is of `type_id`.
single_test :: fn(
    ctx: ModuleCtx,
    value: WasmExpression,
    type_id: i32,
    function: string,
) -> WasmExpression | WasmUnsupported {
    target :: ctx.module.types[type_id]
    if target is Bc.BcStruct {
        t :: struct_type(ctx, type_id, function) else return t
        return ref_test(t, value)
    }
    if target is Bc.BcArray {
        return call(ctx.array_is(), [value, i32_const(type_id)])
    }
    if target is Bc.BcScalar && target.val == .Null {
        return unary(.RefIsNull, value)
    }
    if target is Bc.BcUnion | Bc.BcRef {
        test :: ctx.type_test(type_id, function) else return test
        return call(test, [value])
    }
    // A function value is of no type a test names, as the VM has it; a dispatch
    // still tells its function type (`receiver_test`).
    if target is Bc.BcFn {
        return sequence([drop(value), i32_const(0)])
    }
    box :: box_of(ctx.gc, target) else {
        return WasmUnsupported {
            .reason = "`${function}`: no WASM test yet for type ${type_id}",
        }
    }
    return ref_test(box, value)
}

// The value on the stack, tested as `single_test` tests it.
push_single_test :: fn(
    ctx: ModuleCtx,
    out: WasmInstr[],
    type_id: i32,
    function: string,
) -> void | WasmUnsupported {
    test :: single_test(ctx, on_stack(), type_id, function) else return test
    out.push_on_stack(test)
}

// Return `answer` when `condition` holds.
answer_if :: fn(condition: WasmExpression, answer: i32) -> WasmExpression =
    when(condition, [return_([i32_const(answer)])])

// `(value: eqref) -> i32`: whether the value is of the union or the trait
// `type_id`. A union holds a value of one of its variants; a trait one of a type
// the impl table says implements it; `ref _` any reference that is no box.
type_test :: fn(ctx: ModuleCtx, type_id: i32, function: string) -> i32 | WasmUnsupported {
    key :: "is.${type_id}"
    known :: ctx.helpers[key]
    if known != null {
        return known
    }
    value :: 0
    target :: ctx.module.types[type_id]
    body: WasmExpression[]: []
    if target is Bc.BcRef && target.trait_name == "" {
        boxes: i32[]: [ctx.gc.void_box, ctx.gc.type_value]
        for class in BOXED_CLASSES {
            box :: ctx.gc.of_box[class] else continue
            boxes.push(box)
        }
        body.push(answer_if(unary(.RefIsNull, local_get(value)), 0))
        for box in boxes {
            body.push(answer_if(ref_test(box, local_get(value)), 0))
        }
        body.push(i32_const(1))
    } else {
        for member in members_of(ctx.module, target) {
            tested :: single_test(ctx, local_get(value), member, function) else return tested
            body.push(answer_if(tested, 1))
        }
        body.push(i32_const(0))
    }
    frame :: HelperFrame { .signature = func_of([.EqRef], [.I32]) }
    return ctx.define_tree_helper(key, frame, body)
}

// The types a value of `t` may be: a union's variants, or the types that
// implement a trait.
members_of :: fn(m: Bc.BytecodeModule, t: Bc.BcType) -> i32[] {
    if t is Bc.BcUnion {
        return t.variants
    }
    out: i32[]: []
    if t is Bc.BcRef {
        for row in m.impl_table {
            if row.trait_name == t.trait_name {
                out.push(row.type_index)
            }
        }
    }
    return out
}

// ---- equality -------------------------------------------------------------

// The index of the helper behind `ref.eq` / `ref.ne`: two references are equal
// when they are the same, and two boxes when they hold the same value, as the
// native boxes compare.
reference_equality :: fn(ctx: ModuleCtx) -> i32 =
    ctx.helpers["ref.eq"] else define_reference_equality(ctx)

define_reference_equality :: fn(ctx: ModuleCtx) -> i32 {
    a :: local_get(0)
    b :: local_get(1)
    body: WasmExpression[]: [answer_if(binary(.RefEq, a, b), 1)]
    for [class, box] in ctx.gc.of_box {
        both_boxed :: i32_and(ref_test(box, a), ref_test(box, b))
        same_payload :: binary(payload_equality(class), unboxed(box, a), unboxed(box, b))
        body.push(when(both_boxed, [return_([same_payload])]))
    }
    body.push(i32_const(0))
    frame :: HelperFrame { .signature = func_of([.EqRef, .EqRef], [.I32]) }
    return ctx.define_tree_helper("ref.eq", frame, body)
}

payload_equality :: fn(class: Bc.ValType) -> WasmOp = match scalar_field_type(class) {
    .I32   -> .I32Eq
    .I64   -> .I64Eq
    .F32   -> .F32Eq
    .F64   -> .F64Eq
    .EqRef -> .RefEq
}

// ---- tests ----------------------------------------------------------------

import "std/testing"

@test
test_each_scalar_class_has_a_box_of_its_own :: fn() -> void {
    gc :: gc_types_of(straight([]))
    u8_box :: gc.of_box[.U8] else -1
    i32_box :: gc.of_box[.I32] else -1
    assert(u8_box >= 0 && i32_box >= 0 && u8_box != i32_box, "`u8` and `i32` box apart")
    void_box :: gc.types[gc.void_box]
    assert(
        void_box is WasmStructType && void_box.fields.len() == 0,
        "the box of void holds nothing",
    )
}

// A program whose `main` runs `body`, over `types`: an `i32`, then the struct
// `A { x: i32 }` and its twin `B`, then the union `A | B`.
program_over_structs :: fn(body: Bc.Op[]) -> Bc.BytecodeModule {
    program :: straight(body)
    field :: Bc.BcField { .name = "x", .type_index = 0 }
    a :: Bc.BcStruct {
        .name = "A",
        .fields = [field],
        .c_name = "",
        .symbol_id = -1,
    }
    b :: Bc.BcStruct { ...a, .name = "B" }
    program.types = [Bc.BcScalar { .val = .I32 }, a, b, Bc.BcUnion { .variants = [1, 2] }]
    return program
}

@test
test_a_field_read_casts_the_reference_first :: fn() -> void {
    body: Bc.Op[]: [
        Bc.I32Const { .value = 3 },
        Bc.StructNew { .type_id = 1, .stack = false },
        Bc.StructGet { .type_id = 1, .field_index = 0 },
        Bc.Return {},
    ]
    wasm :: wasm_module_of(program_over_structs(body), "") else panic(wasm.reason)
    instrs :: wasm.functions[0].body
    cast :: instrs[2]
    read :: instrs[3]
    assert(cast is RefCast && cast.type_index == 0, "the reference is cast to `A`")
    assert(read is StructGet && read.type_index == 0 && read.field_index == 0, "then read")
}

@test
test_a_field_write_keeps_the_value_aside :: fn() -> void {
    body: Bc.Op[]: [
        Bc.I32Const { .value = 3 },
        Bc.StructNew { .type_id = 1, .stack = false },
        Bc.I32Const { .value = 4 },
        Bc.StructSet { .type_id = 1, .field_index = 0, .stack = false },
        Bc.ReturnLit { .value = Bc.I32Const { .value = 0 } },
    ]
    wasm :: wasm_module_of(program_over_structs(body), "") else panic(wasm.reason)
    main :: wasm.functions[0]
    assert(main.locals.len() == 1 && main.locals[0] == .I32, "one `i32` scratch local")
    aside :: main.body[3]
    assert(aside is LocalSet && aside.index == 0, "the value waits in it")
}

@test
test_an_is_on_a_union_tests_each_variant :: fn() -> void {
    body: Bc.Op[]: [
        Bc.I32Const { .value = 3 },
        Bc.StructNew { .type_id = 2, .stack = false },
        Bc.TypeCheck { .type_id = 3 },
        Bc.Return {},
    ]
    wasm :: wasm_module_of(program_over_structs(body), "") else panic(wasm.reason)
    tests :: wasm.functions[1].body.filter_is<RefTest>().collect()
    assert(tests.len() == 2, "one test per variant")
    assert(tests[0].type_index == 0 && tests[1].type_index == 1, "`A`, then `B`")
}

// The value a cast reads is the one on top of the stack, whichever op pushed it.
@test
test_a_cast_reads_the_value_under_a_drop :: fn() -> void {
    body: Bc.Op[]: [
        Bc.I32Const { .value = 3 },
        Bc.Retag { .type_id = 0 },
        Bc.LocalSet { .slot = 0 },
        Bc.LocalGet { .slot = 0 },
        Bc.I32Const { .value = 1 },
        Bc.Drop {},
        Bc.RefCast { .type_id = 0 },
        Bc.Return {},
    ]
    program :: program_over_structs(body)
    program.functions[0].locals = [Bc.BcLocal { .name = "x", .val = .Any }]
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    i32_box :: gc_types_of(program).of_box[.I32] else -1
    casts :: wasm.functions[0].body.filter_is<RefCast>().collect()
    assert(casts.len() == 1 && casts[0].type_index == i32_box, "the `any` is unboxed as an `i32`")
}

// Two instances of one generic struct, held alike, share a supertype that a
// field read casts to, while each keeps its own type for `is`.
@test
test_layout_siblings_share_the_supertype_a_read_casts_to :: fn() -> void {
    body: Bc.Op[]: [
        Bc.I32Const { .value = 3 },
        Bc.StructNew { .type_id = 1, .stack = false },
        Bc.StructGet { .type_id = 2, .field_index = 0 },
        Bc.Return {},
    ]
    program :: program_over_structs(body)
    for i in [1, 2] {
        program.types[i] = Bc.BcStruct {
            ...Bc.struct_at(program.types, i) else panic("A"),
            .symbol_id = 7,
        }
    }
    gc :: gc_types_of(program)
    layout :: gc.of_layout[1] else -1
    assert(layout >= 0 && gc.of_layout[2] == layout, "`A` and `B` share a supertype")
    assert(gc.of_struct[1] != gc.of_struct[2], "each keeps its own type")
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    cast :: wasm.functions[0].body.filter_is<RefCast>().collect()[0]
    assert(cast.type_index == layout, "the read casts to the supertype")
}

// A field every variant places at one slot is read through the variant the
// value is.
@test
test_a_union_field_read_tests_each_variant :: fn() -> void {
    body: Bc.Op[]: [
        Bc.I32Const { .value = 3 },
        Bc.StructNew { .type_id = 2, .stack = false },
        Bc.UnionFieldGet { .type_id = 3, .field_index = 0 },
        Bc.Return {},
    ]
    wasm :: wasm_module_of(program_over_structs(body), "") else panic(wasm.reason)
    helper :: wasm.functions[1].body
    tests :: helper.filter_is<RefTest>().collect()
    assert(
        tests.len() == 2 && tests[0].type_index == 0 && tests[1].type_index == 1,
        "`A`, then `B`",
    )
    assert_eq(helper.filter_is<StructGet>().count(), 2)
}

// A value is of a trait when the impl table says its type implements it.
@test
test_a_trait_test_tests_each_implementer :: fn() -> void {
    body: Bc.Op[]: [
        Bc.I32Const { .value = 3 },
        Bc.StructNew { .type_id = 2, .stack = false },
        Bc.TypeCheck { .type_id = 4 },
        Bc.Return {},
    ]
    program :: program_over_structs(body)
    program.types.push(Bc.BcRef { .trait_name = "Shape" })
    program.impl_table = [Bc.ImplEntry { .type_index = 2, .trait_name = "Shape" }]
    wasm :: wasm_module_of(program, "") else panic(wasm.reason)
    tests :: wasm.functions[1].body.filter_is<RefTest>().collect()
    assert(tests.len() == 1 && tests[0].type_index == 1, "only `B` implements `Shape`")
}
