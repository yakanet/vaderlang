// vader/emit/wasm/module: the WASM module the emitter builds, before its bytes.
//
// A typed value: `encode.vader` writes it in the binary format, and a WAT text
// can be printed from the same value. It holds what the emitter produces so far
// (function types, imported and defined functions, exports, the instructions of
// scalar code) and grows with it. The component around it is
// `component.vader`'s.

module "vader/emit/wasm"

/// A WASM value type.
export WasmValType :: enum { I32, I64, F32, F64 }

/// A function type: what a function takes, and what it leaves on the stack.
export WasmFuncType :: struct {
    params: WasmValType[]
    results: WasmValType[]
}

/// One function the module defines.
export WasmFunction :: struct {
    /// Its type, an index into `WasmModule.types`.
    type_index: i32
    /// The locals declared past the parameters.
    locals: WasmValType[]
    /// The instructions, without the `end` that closes the body: the encoder
    /// writes it.
    body: WasmInstr[]
}

/// A function the module imports. The imported functions come first in the
/// index space of the functions, before the ones the module defines.
export WasmImport :: struct {
    /// The module name, which the component that instantiates the module
    /// supplies an instance for.
    module: string
    name: string
    /// Its type, an index into `WasmModule.types`.
    type_index: i32
}

/// A function the module exports under a name.
export WasmExport :: struct {
    name: string
    /// An index into the functions, the imported ones counted first.
    function_index: i32
}

/// A core WASM module.
export WasmModule :: struct {
    types: WasmFuncType[]
    imports: WasmImport[] = []
    functions: WasmFunction[]
    exports: WasmExport[]
}

/// A WASM instruction.
export WasmInstr :: I32Const | I64Const | LocalGet | LocalSet | LocalTee | Call | Br | BrIf | Plain

/// `i32.const value`.
export I32Const :: struct { value: i32 }

/// `i64.const value`.
export I64Const :: struct { value: i64 }

/// `local.get index`: a parameter, then the declared locals, count from 0.
export LocalGet :: struct { index: i32 }

/// `local.set index`.
export LocalSet :: struct { index: i32 }

/// `local.tee index`: set the local and keep the value on the stack.
export LocalTee :: struct { index: i32 }

/// `call function_index`, the imported functions counted first.
export Call :: struct { function_index: i32 }

/// `br depth`: leave the `depth` innermost scopes past the current one, out of
/// a block, or back to the start of a loop.
export Br :: struct { depth: i32 }

/// `br_if depth`: `br depth` when the popped `i32` is not zero.
export BrIf :: struct { depth: i32 }

/// An instruction without an immediate.
export Plain :: struct { op: WasmOp }

/// The instructions `Plain` carries. `Block`, `Loop` and `If` take the empty
/// block type: the scopes of the bytecode leave nothing on the stack.
export WasmOp :: enum {
    Unreachable,
    Block,
    Loop,
    If,
    Else,
    End,
    Return,
    Drop,
    I32Eqz,
    I32Eq,
    I32Ne,
    I32LtS,
    I32GtS,
    I32LeS,
    I32GeS,
    I64Eqz,
    I64Eq,
    I64Ne,
    I64LtS,
    I64LtU,
    I64GtS,
    I64GtU,
    I64LeS,
    I64GeS,
    I32Add,
    I32Sub,
    I32Mul,
    I32DivS,
    I32DivU,
    I32RemS,
    I32RemU,
    I32And,
    I32Or,
    I32Xor,
    I32Shl,
    I32ShrS,
    I32ShrU,
    I64Add,
    I64Sub,
    I64Mul,
    I64DivS,
    I64DivU,
    I64RemS,
    I64RemU,
    I64And,
    I64Xor,
    I32WrapI64,
    I64ExtendI32S,
    I64ExtendI32U,
}
