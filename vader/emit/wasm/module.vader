// vader/emit/wasm/module: the WASM module the emitter builds, before its bytes.
//
// A typed value: `encode.vader` writes it in the binary format, and a WAT text
// can be printed from the same value. It holds what the emitter produces so far
// (function types, imported and defined functions, exports, the instructions of
// scalar code) and grows with it. The component around it is
// `component.vader`'s.

module "vader/emit/wasm"

/// A WASM value type. `EqRef` is `(ref null eq)`, what every Vader reference
/// is held as: a struct, an array, a box, or null.
export WasmValType :: enum { I32, I64, F32, F64, EqRef }

/// A composite type of Wasm GC, in the recursion group.
export WasmGcType :: WasmStructType | WasmArrayType

/// A struct type of Wasm GC.
export WasmStructType :: struct {
    fields: WasmField[]
}

/// An array type of Wasm GC, its elements mutable.
export WasmArrayType :: struct { element: WasmStorageType }

/// How an array stores its elements: as a value type, or packed in 8 or 16 bits
/// that read back as an `i32`.
export WasmStorageType :: enum { I8, I16, I32, I64, F32, F64, EqRef }

/// A field of a struct type, every one mutable.
export WasmField :: struct {
    type: WasmValType
}

/// A function type: what a function takes, and what it leaves on the stack.
export WasmFuncType :: struct {
    params: WasmValType[]
    results: WasmValType[]
}

/// One function the module defines.
export WasmFunction :: struct {
    /// Its type, an index into `WasmModule.types`.
    type_index: i32
    /// The locals declared past the parameters.
    locals: WasmValType[]
    /// The instructions, without the `end` that closes the body: the encoder
    /// writes it.
    body: WasmInstr[]
}

/// A function the module imports. The imported functions come first in the
/// index space of the functions, before the ones the module defines.
export WasmImport :: struct {
    /// The module name, which the component that instantiates the module
    /// supplies an instance for.
    module: string
    name: string
    /// Its type, an index into `WasmModule.types`.
    type_index: i32
}

/// A function the module exports under a name.
export WasmExport :: struct {
    name: string
    /// An index into the functions, the imported ones counted first.
    function_index: i32
}

/// A core WASM module. The type index space holds the struct and array types
/// first, all in one recursion group so that two of one shape stay distinct,
/// then the function types: a type index past the group names `types`.
export WasmModule :: struct {
    gc_types: WasmGcType[] = []
    /// The globals, each mutable and zero or null until first written.
    globals: WasmValType[] = []
    types: WasmFuncType[]
    imports: WasmImport[] = []
    functions: WasmFunction[]
    exports: WasmExport[]
}

/// A WASM instruction.
export WasmInstr :: I32Const
           | I64Const
           | LocalGet
           | LocalSet
           | LocalTee
           | Call
           | Br
           | BrIf
           | StructNew
           | StructGet
           | StructSet
           | RefCast
           | RefTest
           | RefNull
           | ArrayNewFixed
           | ArrayNewDefault
           | ArrayGet
           | ArraySet
           | ArrayLen
           | ArrayCopy
           | GlobalGet
           | GlobalSet
           | Plain

/// `i32.const value`.
export I32Const :: struct { value: i32 }

/// `i64.const value`.
export I64Const :: struct { value: i64 }

/// `local.get index`: a parameter, then the declared locals, count from 0.
export LocalGet :: struct { index: i32 }

/// `local.set index`.
export LocalSet :: struct { index: i32 }

/// `local.tee index`: set the local and keep the value on the stack.
export LocalTee :: struct { index: i32 }

/// `call function_index`, the imported functions counted first.
export Call :: struct { function_index: i32 }

/// `br depth`: leave the `depth` innermost scopes past the current one, out of
/// a block, or back to the start of a loop.
export Br :: struct { depth: i32 }

/// `br_if depth`: `br depth` when the popped `i32` is not zero.
export BrIf :: struct { depth: i32 }

/// `struct.new type_index`: a struct from its fields, the first pushed first.
export StructNew :: struct { type_index: i32 }

/// `struct.get type_index field_index`.
export StructGet :: struct {
    type_index: i32
    field_index: i32
}

/// `struct.set type_index field_index`: the struct, then the value, are popped.
export StructSet :: struct {
    type_index: i32
    field_index: i32
}

/// `ref.cast (ref type_index)`: stops the run when the popped reference is null
/// or of another type.
export RefCast :: struct { type_index: i32 }

/// `ref.test (ref type_index)`: whether the popped reference is of the type.
export RefTest :: struct { type_index: i32 }

/// `ref.null eq`.
export RefNull :: struct {}

/// `array.new_fixed type_index length`: an array of the `length` values on top,
/// the first pushed first.
export ArrayNewFixed :: struct {
    type_index: i32
    length: i32
}

/// `global.get index`.
export GlobalGet :: struct { index: i32 }

/// `global.set index`.
export GlobalSet :: struct { index: i32 }

/// `array.new_default type_index`: an array of the `i32` length on top, each
/// element zero or null.
export ArrayNewDefault :: struct { type_index: i32 }

/// `array.get type_index`, its index an `i32`. A packed element reads back
/// extended to an `i32`, as `extension` says.
export ArrayGet :: struct {
    type_index: i32
    extension: Extension
}

/// How a packed element widens: `None` for an element stored whole.
export Extension :: enum { None, Signed, Unsigned }

/// `array.set type_index`: the array, the `i32` index, then the value.
export ArraySet :: struct { type_index: i32 }

/// `array.len`: the length of any array, an `i32`.
export ArrayLen :: struct {}

/// `array.copy destination source`: the destination and its offset, the source
/// and its offset, then the count, each an `i32`.
export ArrayCopy :: struct {
    destination: i32
    source: i32
}

/// An instruction without an immediate.
export Plain :: struct { op: WasmOp }

/// The instructions `Plain` carries. `Block`, `Loop` and `If` take the empty
/// block type: the scopes of the bytecode leave nothing on the stack.
export WasmOp :: enum {
    Unreachable,
    Block,
    Loop,
    If,
    Else,
    End,
    Return,
    Drop,
    I32Eqz,
    I32Eq,
    I32Ne,
    I32LtS,
    I32LtU,
    I32GtS,
    I32LeS,
    I32GeS,
    I64Eqz,
    I64Eq,
    I64Ne,
    I64LtS,
    I64LtU,
    I64GtS,
    I64GtU,
    I64LeS,
    I64GeS,
    I64GeU,
    I32Add,
    I32Sub,
    I32Mul,
    I32DivS,
    I32DivU,
    I32RemS,
    I32RemU,
    I32And,
    I32Or,
    I32Xor,
    I32Shl,
    I32ShrS,
    I32ShrU,
    I64Add,
    I64Sub,
    I64Mul,
    I64DivS,
    I64DivU,
    I64RemS,
    I64RemU,
    I64And,
    I64Xor,
    I32WrapI64,
    I64ExtendI32S,
    I64ExtendI32U,
    RefIsNull,
    RefEq,
    F32Eq,
    F64Eq,
}
