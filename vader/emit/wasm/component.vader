// vader/emit/wasm/component: the component around the core module, and its bytes.
//
// A program is a component of the component model: it imports the interfaces
// its `@extern` declarations name, and exports `wasi:cli/run`, whose `run` the
// host calls. The core module inside does the work. The component is written
// in one fixed shape:
//
// - one imported instance per interface, typed by the functions the program
//   calls and the types they name, an enum exported under its name. A resource
//   is exported by the interface that owns it, imported before the others, even
//   when the program calls none of its functions; the component aliases it out
//   of that instance, and the instances after name it by that alias. A handle
//   the program receives is not dropped yet;
// - when the core module calls an async function (`canonical.vader`), a module that
//   only defines a linear memory, instantiated first;
// - the core module;
// - each imported function aliased out of its instance and lowered to a core
//   function;
// - the canonical built-ins the core module calls, on types of their own, an
//   enum aliased out of the instance that exports it;
// - the lowered functions gathered into one core instance per interface, the
//   memory and the built-ins into one more, and the core module instantiated
//   with them under the names its imports use;
// - its `run` export lifted, put in an instance, and exported as
//   `wasi:cli/run`.
//
// The binary format is the component model's (`Binary.md` of the
// `WebAssembly/component-model` repository): sections as in a core module,
// under the component's own version and layer.

module "vader/emit/wasm"

import "std/abort"
import "std/collections"
import "std/iter"
import "vader/core/wit"

/// A function the component imports from an interface.
export ComponentFunction :: struct {
    name: string
    type: WitFunction
}

/// An interface the component imports, with the functions the program calls.
export ComponentInterface :: struct {
    /// As WIT writes it: `wasi:clocks/monotonic-clock@0.3.0`.
    name: string
    functions: ComponentFunction[]
}

/// A program as a component.
export WasmComponent :: struct {
    /// The core module. Its imports name an interface of `interfaces` as their
    /// module and one of its functions as their name, then `CANONICAL_MODULE` and a
    /// built-in of `builtins`, and it exports `run`.
    core: WasmModule
    interfaces: ComponentInterface[]
    /// The canonical built-ins the core module imports, in the order of its
    /// imports. The memory comes with them.
    builtins: CanonicalBuiltin[] = []
}

/// The interface a program exports, whose `run` the host calls.
export RUN_INTERFACE: string: "wasi:cli/run@0.3.0"

/// The core export the component lifts as `run`.
export RUN_EXPORT: string: "run"

/// Write `c` in the binary format of the component model.
///
/// @param c  the component.
/// @return   the bytes of a `.wasm` file holding a component.
export encode_component :: fn(component: WasmComponent) -> u8[] {
    out: u8[]: [0x00, 0x61, 0x73, 0x6D, 0x0D, 0x00, 0x01, 0x00]
    // Every index below follows the order of `c.interfaces`, never `component`'s.
    c :: WasmComponent { ...component, .interfaces = import_order(component.interfaces) }
    interface_count :: i64(c.interfaces.len())
    function_count :: count_functions(c.interfaces)
    has_memory :: c.core.memory_import != null
    allocating :: c.interfaces.any_match((i) -> i.functions.any_match((f) -> allocates(f.type)))
        || c.builtins.any_match((b) -> builtin_allocates(b))
    imported :: out.push_interface_imports(c.interfaces)
    scopes :: imported.scopes
    if has_memory {
        table_slots: i64 | null: if c.core.table_import { c.core.table.len() } else { null }
        out.push_component_section(.CoreModule, encode_memory_module(allocating, table_slots))
        out.push_component_section(.CoreInstance, [1, INSTANTIATE, 0, 0])
        out.push_component_section(.Alias, memory_aliases(allocating))
    }
    if c.core.table_import {
        out.push_thread_sections()
    }
    out.push_component_section(.CoreModule, encode_module(c.core))
    // The allocator, when there is one, is the first core function.
    first_lowered :: allocator_count(allocating)
    if function_count > 0 {
        out.push_component_section(.Alias, function_aliases(c.interfaces, function_count))
        out.push_component_section(.Canonical, lowered_functions(c.interfaces))
    }
    types :: TypeScope { .next = imported.type_count }
    if c.builtins.len() > 0 {
        out.push_builtin_sections(c.builtins, scopes, types)
    }
    // The memory's instance comes first when there is one.
    first_instance :: core_instance_base(has_memory)
    out.push_component_section(.CoreInstance, core_instances(c, first_instance, first_lowered))
    out.push_run_sections(
        RunIndices {
            .result_type = types.next,
            .main_instance = first_instance + interface_count + core_instance_base(has_memory),
            .core_run = first_lowered + function_count + i64(c.builtins.len()),
            .lifted_run = function_count,
            .run_instance = interface_count,
        },
    )
    return out
}

// The core instances before the interfaces' own: the memory's, when there is one.
core_instance_base :: fn(has_memory: bool) -> i64 = if has_memory { 1 } else { 0 }

// The core functions before the lowered ones: the allocator, when there is one.
allocator_count :: fn(allocating: bool) -> i64 = if allocating { 1 } else { 0 }

// The memory out of its module's instance, and the allocator when the host
// writes a result into room it asks for.
memory_aliases :: fn(allocating: bool) -> u8[] {
    out: u8[]: []
    out.push_count(1 + allocator_count(allocating))
    out.push_all([CORE_SORT, CORE_MEMORY, ALIAS_CORE_EXPORT, 0])
    out.push_name(MEMORY_NAME)
    if allocating {
        out.push_all([CORE_SORT, CORE_FUNC, ALIAS_CORE_EXPORT, 0])
        out.push_name(REALLOC_NAME)
    }
    return out
}

// The table out of the memory's instance, then the type of its entries that
// `thread.new-indirect` calls: the first core table and the first core type of
// the component.
push_thread_sections :: fn(out: u8[]) -> void {
    alias: u8[]: [1, CORE_SORT, CORE_TABLE, ALIAS_CORE_EXPORT, 0]
    alias.push_name(TABLE_NAME)
    out.push_component_section(.Alias, alias)
    entry :: WasmFuncType { .params = [.I32], .results = [] }
    out.push_component_section(.CoreType, type_section([], [entry]))
}

// Where the sections that export `run` find what they name.
RunIndices :: struct {
    // The `result` `run` returns; the type of `run` follows it.
    result_type: i64
    // The core module's instance, which exports the core `run`.
    main_instance: i64
    // The core `run`, past the lowered functions and the built-ins.
    core_run: i64
    // The lifted `run`, past the functions aliased out of the interfaces.
    lifted_run: i64
    // The instance that holds it, past the imported ones.
    run_instance: i64
}

push_run_sections :: fn(out: u8[], at: RunIndices) -> void {
    run_types: u8[]: [2, RESULT_TYPE, NO_TYPE, NO_TYPE]
    // `run` takes no parameter and returns the `result`.
    run_types.push_all([ASYNC_FUNC_TYPE, 0, ONE_RESULT])
    run_types.push_count(at.result_type)
    out.push_component_section(.Type, run_types)
    run_alias: u8[]: [1, CORE_SORT, CORE_FUNC, ALIAS_CORE_EXPORT]
    run_alias.push_count(at.main_instance)
    run_alias.push_name(RUN_EXPORT)
    out.push_component_section(.Alias, run_alias)
    lift: u8[]: [1, CANONICAL_LIFT, CORE_FUNC]
    lift.push_count(at.core_run)
    lift.push(NO_OPTIONS)
    lift.push_count(at.result_type + 1)
    out.push_component_section(.Canonical, lift)
    run_instance: u8[]: [1, INSTANCE_OF_EXPORTS, 1, PLAIN_NAME]
    run_instance.push_name(RUN_EXPORT)
    run_instance.push(SORT_FUNC)
    run_instance.push_count(at.lifted_run)
    out.push_component_section(.Instance, run_instance)
    export_run: u8[]: [1, PLAIN_NAME]
    export_run.push_name(RUN_INTERFACE)
    export_run.push(SORT_INSTANCE)
    export_run.push_count(at.run_instance)
    export_run.push(NO_TYPE_ASCRIPTION)
    out.push_component_section(.Export, export_run)
}

// The sections of a component, numbered as the binary format numbers them.
ComponentSectionId :: enum(u8) {
    CoreModule   = 1,
    CoreInstance = 2,
    CoreType     = 3,
    Instance     = 5,
    Alias        = 6,
    Type         = 7,
    Canonical    = 8,
    Import       = 10,
    Export       = 11,
}

push_component_section :: fn(out: u8[], id: ComponentSectionId, content: u8[]) -> void {
    out.push(u8(id))
    out.push_sized(content)
}

INSTANCE_TYPE: u8: 0x42
FUNC_TYPE_SYNC: u8: 0x40
ASYNC_FUNC_TYPE: u8: 0x43
RESULT_TYPE: u8: 0x6A
RECORD_TYPE: u8: 0x72
VARIANT_TYPE: u8: 0x71
FLAGS_TYPE: u8: 0x6E
OWN_TYPE: u8: 0x69
BORROW_TYPE: u8: 0x68
OPTION_TYPE: u8: 0x6B
ENUM_TYPE: u8: 0x6D
STREAM_TYPE: u8: 0x66
FUTURE_TYPE: u8: 0x65
LIST_TYPE: u8: 0x70
TUPLE_TYPE: u8: 0x6F

// An instance-type declaration of a type, of an alias, and of an export.
DECLARE_TYPE: u8: 0x01
DECLARE_ALIAS: u8: 0x02
DECLARE_EXPORT: u8: 0x04

// The sorts, and the prefix that turns a sort byte into a core sort.
CORE_SORT: u8: 0x00
CORE_FUNC: u8: 0x00
CORE_TABLE: u8: 0x01
CORE_MEMORY: u8: 0x02
SORT_FUNC: u8: 0x01
SORT_TYPE: u8: 0x03
SORT_INSTANCE: u8: 0x05
CORE_SORT_INSTANCE: u8: 0x12

// A type exported as equal to the type it names, or as a resource of its own.
TYPE_BOUND_EQ: u8: 0x00
TYPE_BOUND_SUB_RESOURCE: u8: 0x01

// A function type's results: one unnamed value, or none.
ONE_RESULT: u8: 0x00
NO_RESULT: u8[]: [0x01, 0x00]
// A case of a variant that refines none of the others.
NO_REFINEMENT: u8: 0x00
// An optional type left out, or given.
NO_TYPE: u8: 0x00
SOME_TYPE: u8: 0x01
// The empty list of canonical options.
NO_OPTIONS: u8: 0x00
// The options of a built-in that copies through the memory 0 and returns
// `BLOCKED` rather than wait.
ASYNC_WITH_MEMORY: u8[]: [0x02, 0x06, 0x03, 0x00]
// The options of a lowered function: async for an async function; UTF-8
// strings and the allocator, the core function 0, for one that `allocates`; the
// memory 0 for those and for one whose result comes back through the memory.
lowering_options :: fn(f: WitFunction) -> u8[] {
    allocating :: allocates(f)
    options: u8[][]: []
    if f.is_async {
        options.push([ASYNC_OPTION])
    }
    if allocating {
        options.push([UTF8_OPTION])
    }
    if f.is_async || allocating || returns_through_memory(f) || reads_params_from_memory(f) {
        options.push(MEMORY_OPTION)
    }
    if allocating {
        options.push(REALLOC_OPTION)
    }
    out: u8[]: [u8(options.len())]
    for o in options {
        out.push_all(o)
    }
    return out
}

ASYNC_OPTION: u8: 0x06
UTF8_OPTION: u8: 0x00
MEMORY_OPTION: u8[]: [0x03, 0x00]
REALLOC_OPTION: u8[]: [0x04, 0x00]
// The option of a cancellation that returns once the copy or the subtask has
// stopped.
NOT_ASYNC: u8: 0x00
// `waitable-set.wait` and `poll` on the memory 0, which no cancellation
// interrupts.
NOT_CANCELLABLE_ON_MEMORY: u8[]: [0x00, 0x00]
// An import or export name that is a plain name, with no version or URL.
PLAIN_NAME: u8: 0x00
// An export whose type is not ascribed.
NO_TYPE_ASCRIPTION: u8: 0x00

ALIAS_EXPORT: u8: 0x00
ALIAS_CORE_EXPORT: u8: 0x01
// An alias of a type of an enclosing scope: the component, one level up.
ALIAS_OUTER: u8: 0x02
ENCLOSING_COMPONENT: u8: 0x01

CANONICAL_LIFT: u8: 0x00
CANONICAL_LOWER: u8: 0x01

INSTANTIATE: u8: 0x00
INSTANCE_OF_EXPORTS: u8: 0x01

count_functions :: fn(interfaces: ComponentInterface[]) -> i64 {
    count: i64 = 0
    for i in interfaces {
        count += i.functions.len()
    }
    return count
}

// ---- types ----------------------------------------------------------------

// The type indices of one scope, an instance type or the component itself, and
// the definitions written in it. A type is defined once, before the first
// definition that names it.
TypeScope :: struct {
    // In an instance type, each definition is a declaration, and an enum is
    // exported under its name: an interface's functions name it by it.
    in_instance: bool = false
    // The declarations, or the definitions, in order.
    items: u8[] = []
    count: i64 = 0
    // The index the next type takes.
    next: i64 = 0
    // The index of each type, by its `wit_type_text`.
    indices: Map<string, i64> = Map<string, i64> {}
    // In an instance type: the interface it types, and the component's type of
    // each resource of another interface, by its `wit_type_text`.
    interface: string = ""
    outer: Map<string, i64> = Map<string, i64> {}
}

// The instance type of `interface`: the resources of its own that other
// interfaces name, exported first, then each function declares its type and
// exports itself under it. A resource of another interface is the component's
// type `outer` holds for it.
instance_scope_of :: fn(
    interface: ComponentInterface,
    owned: WitResource[],
    outer: Map<string, i64>,
) -> TypeScope {
    scope :: TypeScope { .in_instance = true, .interface = interface.name, .outer = outer }
    for r in owned {
        scope.resource_index(r)
    }
    for f in interface.functions {
        func_type :: scope.define(func_type_of(scope, f.type))
        scope.declare_export(f.name, [SORT_FUNC], func_type)
    }
    return scope
}

instance_types :: fn(scopes: TypeScope[]) -> u8[] {
    out: u8[]: []
    out.push_count(scopes.len())
    for scope in scopes {
        out.push(INSTANCE_TYPE)
        out.push_count(scope.count)
        out.push_all(scope.items)
    }
    return out
}

func_type_of :: fn(scope: TypeScope, f: WitFunction) -> u8[] {
    out: u8[]: [if f.is_async { ASYNC_FUNC_TYPE } else { FUNC_TYPE_SYNC }]
    out.push_count(f.params.len())
    for p in f.params {
        out.push_name(p.name)
        out.push_value_type(scope, p.type)
    }
    result :: f.result
    if result == null {
        out.push_all(NO_RESULT)
    } else {
        out.push(ONE_RESULT)
        out.push_value_type(scope, result)
    }
    return out
}

// `t` as a value type: a primitive by its byte, any other type by the index of
// its definition, written into the scope first when it is not there yet.
push_value_type :: fn(out: u8[], scope: TypeScope, t: WitType) -> void {
    if t is WitScalar {
        out.push(wit_scalar_byte(t))
        return
    }
    out.push_signed(scope.type_index(t))
}

push_optional_type :: fn(out: u8[], scope: TypeScope, t: WitType | null) -> void {
    if t == null {
        out.push(NO_TYPE)
    } else {
        out.push(SOME_TYPE)
        out.push_value_type(scope, t)
    }
}

// The index of the type `t` in `scope`, defined there when it is not yet.
type_index :: fn(scope: TypeScope, t: WitType) -> i64 {
    key :: wit_type_text(t)
    known :: scope.indices[key]
    if known != null {
        return known
    }
    definition: u8[]: []
    match t {
        is WitEnum -> {
            definition.push(ENUM_TYPE)
            definition.push_count(t.cases.len())
            for c in t.cases {
                definition.push_name(c)
            }
        }
        is WitResult -> {
            definition.push(RESULT_TYPE)
            definition.push_optional_type(scope, t.ok)
            definition.push_optional_type(scope, t.error)
        }
        is WitRecord -> {
            definition.push(RECORD_TYPE)
            definition.push_count(t.fields.len())
            for f in t.fields {
                definition.push_name(f.name)
                definition.push_value_type(scope, f.type)
            }
        }
        is WitVariant -> {
            definition.push(VARIANT_TYPE)
            definition.push_count(t.cases.len())
            for c in t.cases {
                definition.push_name(c.name)
                definition.push_optional_type(scope, c.type)
                definition.push(NO_REFINEMENT)
            }
        }
        is WitFlags -> {
            definition.push(FLAGS_TYPE)
            definition.push_count(t.flags.len())
            for f in t.flags {
                definition.push_name(f)
            }
        }
        is WitHandle -> {
            definition.push(handle_type_byte(t))
            definition.push_count(scope.resource_index(t.resource))
        }
        is WitOption -> {
            definition.push(OPTION_TYPE)
            definition.push_value_type(scope, t.value)
        }
        is WitList -> {
            definition.push(LIST_TYPE)
            definition.push_value_type(scope, t.element)
        }
        is WitStream -> {
            definition.push(STREAM_TYPE)
            definition.push_optional_type(scope, t.element)
        }
        is WitFuture -> {
            definition.push(FUTURE_TYPE)
            definition.push_optional_type(scope, t.value)
        }
        is WitTuple -> {
            definition.push(TUPLE_TYPE)
            definition.push_count(t.elements.len())
            for e in t.elements {
                definition.push_value_type(scope, e)
            }
        }
        is WitScalar | WitUnsupported | WitNotLowered -> {
            panic("wasm: no component type to define for `${key}`")
        }
    }
    defined :: scope.define(definition)
    index :: scope.exported(t, defined)
    scope.indices[key] = index
    return index
}

// Write the definition of a type and return its index.
define :: fn(scope: TypeScope, definition: u8[]) -> i64 {
    if scope.in_instance {
        scope.items.push(DECLARE_TYPE)
    }
    scope.items.push_all(definition)
    scope.count += 1
    return scope.take_index()
}

// The index of the resource `t` in `scope`, an instance type. The interface that
// owns it exports it under its name as a type of its own, which the host's
// resource takes when the instance is imported; another interface aliases the
// component's type of it.
resource_index :: fn(scope: TypeScope, t: WitType) -> i64 {
    key :: wit_type_text(t)
    known :: scope.indices[key]
    if known != null {
        return known
    }
    if t !is WitResource || !scope.in_instance {
        panic("wasm: no component type to define for `${key}`")
    }
    if wit_owner_text(t.owner) == scope.interface {
        scope.items.push_all([DECLARE_EXPORT, PLAIN_NAME])
        scope.items.push_name(t.name)
        scope.items.push_all([SORT_TYPE, TYPE_BOUND_SUB_RESOURCE])
    } else {
        outer :: scope.outer[key] else panic("wasm: `${key}` named before its interface")
        scope.items.push_all([DECLARE_ALIAS, SORT_TYPE, ALIAS_OUTER, ENCLOSING_COMPONENT])
        scope.items.push_count(outer)
    }
    scope.count += 1
    index :: scope.take_index()
    scope.indices[key] = index
    return index
}

handle_type_byte :: fn(h: WitHandle) -> u8 = if h.is_borrow { BORROW_TYPE } else { OWN_TYPE }

// The index the functions of `scope` name the type `t` defined at `defined` by:
// in an instance type, a named type is exported under its name, which the
// component model asks of every type an instance's function names, and the
// export's index is the one they name.
exported :: fn(scope: TypeScope, t: WitType, defined: i64) -> i64 {
    if !scope.in_instance {
        return defined
    }
    return match t {
        is WitEnum | WitRecord | WitVariant | WitFlags -> scope.export_type(t.name, defined)
        is WitScalar | WitList | WitResult | WitTuple | WitOption -> defined
        is WitStream | WitFuture | WitHandle | WitUnsupported | WitNotLowered -> defined
    }
}

// Export the type `index` of an instance type under `name`, which gives it the
// index the functions name.
export_type :: fn(scope: TypeScope, name: string, index: i64) -> i64 {
    scope.declare_export(name, [SORT_TYPE, TYPE_BOUND_EQ], index)
    return scope.take_index()
}

// Declare the export of `index` under `name`, of the sort `sort` opens.
declare_export :: fn(scope: TypeScope, name: string, sort: u8[], index: i64) -> void {
    scope.items.push_all([DECLARE_EXPORT, PLAIN_NAME])
    scope.items.push_name(name)
    scope.items.push_all(sort)
    scope.items.push_count(index)
    scope.count += 1
}

take_index :: fn(scope: TypeScope) -> i64 {
    index :: scope.next
    scope.next += 1
    return index
}

// ---- imports --------------------------------------------------------------

// The instance types of the interfaces and the component types past them.
ImportedInterfaces :: struct {
    scopes: TypeScope[]
    // The component's types: an instance type per interface, an alias per
    // resource another interface names.
    type_count: i64
}

// Each interface in turn: its instance type, its import as the instance `i`, then
// the resources of its own that the interfaces after it name, aliased out of it.
push_interface_imports :: fn(out: u8[], interfaces: ComponentInterface[]) -> ImportedInterfaces {
    named_elsewhere :: resources_named_elsewhere(interfaces)
    outer: Map<string, i64>: Map<string, i64> {}
    scopes: TypeScope[]: []
    type_count: i64 = 0
    for [interface, i] in interfaces.indexed() {
        owned :: named_elsewhere[interface.name] else []
        scope :: instance_scope_of(interface, owned, outer)
        scopes.push(scope)
        out.push_component_section(.Type, instance_types([scope]))
        imports: u8[]: [1, PLAIN_NAME]
        imports.push_name(interface.name)
        imports.push(SORT_INSTANCE)
        imports.push_count(type_count)
        out.push_component_section(.Import, imports)
        type_count += 1
        if owned.is_empty() {
            continue
        }
        aliases: u8[]: []
        aliases.push_count(owned.len())
        for r in owned {
            aliases.push_all([SORT_TYPE, ALIAS_EXPORT])
            aliases.push_count(i)
            aliases.push_name(r.name)
            outer[wit_type_text(r)] = type_count
            type_count += 1
        }
        out.push_component_section(.Alias, aliases)
    }
    return ImportedInterfaces { .scopes = scopes, .type_count = type_count }
}

// The interfaces in the order the component imports them: each one that owns a
// resource another names before the others. One the program calls no function
// of is added with none: the core module is still instantiated with its empty
// core instance, which keeps the instance of interface `i` at index `i`
// everywhere.
import_order :: fn(interfaces: ComponentInterface[]) -> ComponentInterface[] {
    owners: string[]: resources_named_elsewhere(interfaces).keys().collect()
    ordered: ComponentInterface[]: []
    for owner in owners {
        found :: interfaces.find((i) -> i.name == owner)
            else ComponentInterface { .name = owner, .functions = [] }
        ordered.push(found)
    }
    for interface in interfaces {
        if !owners.contains(interface.name) {
            ordered.push(interface)
        }
    }
    return ordered
}

// The resources an interface owns that another one of `interfaces` names, by the
// name of the owner, each once. A handle names its resource itself, the WIT
// stage having taken its aliases out.
resources_named_elsewhere :: fn(interfaces: ComponentInterface[]) -> Map<string, WitResource[]> {
    out :: Map<string, WitResource[]> {}
    for interface in interfaces {
        for f in interface.functions {
            types :: f.type.params.flat_map((p) -> nested_types_of(p.type)).collect()
            types.push_all(nested_types_of(f.type.result))
            for r in types.filter_is<WitResource>() {
                owner :: wit_owner_text(r.owner)
                if owner == interface.name {
                    continue
                }
                known :: out[owner] else []
                if !known.any_match((k) -> wit_type_text(k) == wit_type_text(r)) {
                    known.push(r)
                }
                out[owner] = known
            }
        }
    }
    return out
}

// Each imported function out of the instance of its interface, in order: the
// component function `k` is the `k`-th function of the interfaces in a row.
function_aliases :: fn(interfaces: ComponentInterface[], count: i64) -> u8[] {
    out: u8[]: []
    out.push_count(count)
    for i in 0..<interfaces.len() {
        for f in interfaces[i].functions {
            out.push_all([SORT_FUNC, ALIAS_EXPORT])
            out.push_count(i)
            out.push_name(f.name)
        }
    }
    return out
}

// The component function `k` lowered to the core function past the allocator,
// one that `allocates` through the memory 0 and the allocator, its strings UTF-8.
lowered_functions :: fn(interfaces: ComponentInterface[]) -> u8[] {
    out: u8[]: []
    out.push_count(count_functions(interfaces))
    k: i64 = 0
    for interface in interfaces {
        for f in interface.functions {
            out.push_all([CANONICAL_LOWER, CORE_FUNC])
            out.push_count(k)
            out.push_all(lowering_options(f.type))
            k += 1
        }
    }
    return out
}

// ---- built-ins ------------------------------------------------------------

// The types the built-ins work on, then the built-ins, core functions past the
// lowered ones. An enum is the type the instance that declares it exports: the
// futures the host hands back are of that type.
push_builtin_sections :: fn(
    out: u8[],
    builtins: CanonicalBuiltin[],
    scopes: TypeScope[],
    types: TypeScope,
) -> void {
    enums: WitEnum[]: []
    for b in builtins {
        enums.push_enums_of(b.type)
    }
    if enums.len() > 0 {
        aliases: u8[]: []
        aliases.push_count(enums.len())
        for e in enums {
            aliases.push_all([SORT_TYPE, ALIAS_EXPORT])
            aliases.push_count(exporting_instance(scopes, e))
            aliases.push_name(e.name)
            types.indices[wit_type_text(e)] = types.take_index()
        }
        out.push_component_section(.Alias, aliases)
    }
    canonical: u8[]: []
    canonical.push_count(builtins.len())
    for b in builtins {
        canonical.push(canonical_opcode(b.kind))
        t :: b.type
        if t != null {
            canonical.push_count(types.type_index(t))
        }
        canonical.push_all(builtin_options(b))
    }
    if types.count > 0 {
        definitions: u8[]: []
        definitions.push_count(types.count)
        definitions.push_all(types.items)
        out.push_component_section(.Type, definitions)
    }
    out.push_component_section(.Canonical, canonical)
}

// Add the enums `t` names that `out` holds not yet.
push_enums_of :: fn(out: WitEnum[], t: WitType | null) -> void {
    for e in nested_types_of(t).filter_is<WitEnum>() {
        if !out.any_match((known) -> wit_type_text(known) == wit_type_text(e)) {
            out.push(e)
        }
    }
}

// `t` and every type it holds, the outer first; none for null.
nested_types_of :: fn(t: WitType | null) -> WitType[] {
    out: WitType[]: []
    out.push_nested(t)
    return out
}

push_nested :: fn(out: WitType[], t: WitType | null) -> void {
    if t == null {
        return
    }
    out.push(t)
    match t {
        is WitResult -> {
            out.push_nested(t.ok)
            out.push_nested(t.error)
        }
        is WitList -> out.push_nested(t.element)
        is WitOption -> out.push_nested(t.value)
        is WitHandle -> out.push_nested(t.resource)
        is WitStream -> out.push_nested(t.element)
        is WitFuture -> out.push_nested(t.value)
        is WitTuple -> {
            for e in t.elements {
                out.push_nested(e)
            }
        }
        is WitRecord -> {
            for f in t.fields {
                out.push_nested(f.type)
            }
        }
        is WitVariant -> {
            for c in t.cases {
                out.push_nested(c.type)
            }
        }
        is WitScalar | WitEnum | WitFlags | WitUnsupported | WitNotLowered -> {}
    }
}

// The imported instance whose type exports `e`.
exporting_instance :: fn(scopes: TypeScope[], e: WitEnum) -> i64 {
    key :: wit_type_text(e)
    for i in 0..<scopes.len() {
        if key in scopes[i].indices {
            return i
        }
    }
    panic("wasm: no interface exports `${e.name}`")
}

canonical_opcode :: fn(k: CanonicalKind) -> u8 = match k {
    .SubtaskCancel      -> 0x06
    .SubtaskDrop        -> 0x0D
    .StreamNew          -> 0x0E
    .StreamRead         -> 0x0F
    .StreamWrite        -> 0x10
    .StreamCancelRead   -> 0x11
    .StreamDropReadable -> 0x13
    .StreamDropWritable -> 0x14
    .FutureRead         -> 0x16
    .FutureDropReadable -> 0x1A
    .WaitableSetNew     -> 0x1F
    .WaitableSetWait    -> 0x20
    .WaitableSetPoll    -> 0x21
    .WaitableSetDrop    -> 0x22
    .WaitableJoin       -> 0x23
    .ThreadYield        -> 0x0C
    .ContextGet         -> 0x0A
    .ContextSet         -> 0x0B
    .ThreadIndex        -> 0x26
    .ThreadNewIndirect  -> 0x27
    .ThreadResumeLater  -> 0x28
    .ThreadSuspend      -> 0x29
}

// The options of the built-in `b`: a read that the host writes a string or a list
// into takes the allocator, its strings UTF-8.
builtin_options :: fn(b: CanonicalBuiltin) -> u8[] {
    if builtin_allocates(b) {
        return ASYNC_WITH_ALLOCATOR
    }
    return kind_options(b.kind)
}

// Whether the host writes into room it asks the allocator for when `b` runs: a
// read of a stream or a future whose values hold a string or a list.
builtin_allocates :: fn(b: CanonicalBuiltin) -> bool {
    if b.kind != .StreamRead && b.kind != .FutureRead {
        return false
    }
    t :: b.type else return false
    if t is WitStream {
        return holds_room(t.element)
    }
    if t is WitFuture {
        return holds_room(t.value)
    }
    return false
}

// The options of a read that copies through the memory 0, its strings UTF-8 in
// room the allocator gives, and returns `BLOCKED` rather than wait.
ASYNC_WITH_ALLOCATOR: u8[]: [0x04, 0x06, 0x00, 0x03, 0x00, 0x04, 0x00]

kind_options :: fn(k: CanonicalKind) -> u8[] = match k {
    .StreamNew          -> []
    .StreamRead         -> ASYNC_WITH_MEMORY
    .StreamWrite        -> ASYNC_WITH_MEMORY
    .StreamCancelRead   -> [NOT_ASYNC]
    .StreamDropReadable -> []
    .StreamDropWritable -> []
    .FutureRead         -> ASYNC_WITH_MEMORY
    .FutureDropReadable -> []
    .WaitableSetNew     -> []
    .WaitableJoin       -> []
    .WaitableSetWait    -> NOT_CANCELLABLE_ON_MEMORY
    .WaitableSetPoll    -> NOT_CANCELLABLE_ON_MEMORY
    .WaitableSetDrop    -> []
    .SubtaskCancel      -> [NOT_ASYNC]
    .SubtaskDrop        -> []
    // The type the table's entries take, and the table, both the first of the
    // component's core index spaces (`push_thread_sections`).
    .ThreadNewIndirect  -> [0x00, 0x00]
    .ThreadResumeLater  -> []
    .ThreadYield        -> [NOT_CANCELLABLE]
    .ThreadSuspend      -> [NOT_CANCELLABLE]
    .ThreadIndex        -> []
    .ContextGet         -> CONTEXT_SLOT
    .ContextSet         -> CONTEXT_SLOT
}

// A yield or a suspension a cancellation of the task does not end.
NOT_CANCELLABLE: u8: 0x00

// The one slot of the thread's context the module uses, an `i32`: `context.get
// i32 0` and `context.set i32 0`.
CONTEXT_SLOT: u8[]: [0x7F, 0x00]

// ---- instances ------------------------------------------------------------

// One core instance per interface, exporting its lowered functions, then one of
// the memory and the built-ins when there are, then the core module instantiated
// with them. The interfaces' instances start at `first`, their functions at the
// core function `first_lowered`, the built-ins past them.
core_instances :: fn(c: WasmComponent, first: i64, first_lowered: i64) -> u8[] {
    has_memory :: c.core.memory_import != null
    out: u8[]: []
    out.push_count(c.interfaces.len() + 1 + core_instance_base(has_memory))
    k: i64 = first_lowered
    for interface in c.interfaces {
        out.push(INSTANCE_OF_EXPORTS)
        out.push_count(interface.functions.len())
        for f in interface.functions {
            out.push_name(f.name)
            out.push(CORE_FUNC)
            out.push_count(k)
            k += 1
        }
    }
    if has_memory {
        out.push(INSTANCE_OF_EXPORTS)
        out.push_count(c.builtins.len() + 1 + count_of(c.core.table_import))
        out.push_name(MEMORY_NAME)
        out.push_all([CORE_MEMORY, 0])
        if c.core.table_import {
            out.push_name(TABLE_NAME)
            out.push_all([CORE_TABLE, 0])
        }
        for i in 0..<c.builtins.len() {
            out.push_name(builtin_name(c.builtins[i]))
            out.push(CORE_FUNC)
            out.push_count(k + i)
        }
    }
    // The core module past the memory's.
    out.push(INSTANTIATE)
    out.push_count(first)
    out.push_count(c.interfaces.len() + core_instance_base(has_memory))
    for i in 0..<c.interfaces.len() {
        out.push_name(c.interfaces[i].name)
        out.push(CORE_SORT_INSTANCE)
        out.push_count(first + i)
    }
    if has_memory {
        out.push_name(CANONICAL_MODULE)
        out.push(CORE_SORT_INSTANCE)
        out.push_count(first + c.interfaces.len())
    }
    return out
}

wit_scalar_byte :: fn(t: WitScalar) -> u8 = match t {
    .Bool   -> 0x7F
    .S8     -> 0x7E
    .U8     -> 0x7D
    .S16    -> 0x7C
    .U16    -> 0x7B
    .S32    -> 0x7A
    .U32    -> 0x79
    .S64    -> 0x78
    .U64    -> 0x77
    .F32    -> 0x76
    .F64    -> 0x75
    .Char   -> 0x74
    .String -> 0x73
}

// ---- tests ----------------------------------------------------------------

// A component importing `wasi:clocks/monotonic-clock@0.3.0`'s `now` and whose
// `run` returns `now() == 0`, against what `wasm-tools parse` writes for it.
@test
test_encode_component_importing_a_clock :: fn() -> void {
    interface :: "wasi:clocks/monotonic-clock@0.3.0"
    core :: WasmModule {
        .types = [
            WasmFuncType { .params = [], .results = [.I64] },
            WasmFuncType { .params = [], .results = [.I32] },
        ],
        .imports = [WasmImport { .module = interface, .name = "now", .type_index = 0 }],
        .functions = [
            WasmFunction {
                .type_index = 1,
                .locals = [],
                .body = [Call { .function_index = 0 }, Plain { .op = .I64Eqz }],
            },
        ],
        .exports = [WasmExport { .name = RUN_EXPORT, .function_index = 1 }],
    }
    now :: ComponentFunction {
        .name = "now",
        .type = WitFunction { .params = [], .result = .U64 },
    }
    component :: WasmComponent {
        .core = core,
        .interfaces = [ComponentInterface { .name = interface, .functions = [now] }],
    }
    module_bytes :: encode_module(core)
    expected: u8[]: [0x00, 0x61, 0x73, 0x6D, 0x0D, 0x00, 0x01, 0x00]
    expected.push_all([0x07, 0x10, 0x01, 0x42, 0x02, 0x01, 0x40, 0x00, 0x00, 0x77])
    expected.push_all([0x04, 0x00, 0x03, 0x6E, 0x6F, 0x77, 0x01, 0x00])
    expected.push_all([0x0A, 0x26, 0x01, 0x00, 0x21])
    expected.push_all(interface.bytes())
    expected.push_all([0x05, 0x00])
    expected.push(0x01)
    expected.push_sized(module_bytes)
    expected.push_all([0x06, 0x08, 0x01, 0x01, 0x00, 0x00, 0x03, 0x6E, 0x6F, 0x77])
    expected.push_all([0x08, 0x05, 0x01, 0x01, 0x00, 0x00, 0x00])
    expected.push_all([0x02, 0x30, 0x02, 0x01, 0x01, 0x03, 0x6E, 0x6F, 0x77, 0x00, 0x00])
    expected.push_all([0x00, 0x00, 0x01, 0x21])
    expected.push_all(interface.bytes())
    expected.push_all([0x12, 0x00])
    expected.push_all([0x07, 0x08, 0x02, 0x6A, 0x00, 0x00, 0x43, 0x00, 0x00, 0x01])
    expected.push_all([0x06, 0x09, 0x01, 0x00, 0x00, 0x01, 0x01, 0x03, 0x72, 0x75, 0x6E])
    expected.push_all([0x08, 0x06, 0x01, 0x00, 0x00, 0x01, 0x00, 0x02])
    expected.push_all([0x05, 0x0A, 0x01, 0x01, 0x01, 0x00, 0x03, 0x72, 0x75, 0x6E, 0x01, 0x01])
    expected.push_all([0x0B, 0x18, 0x01, 0x00, 0x12])
    expected.push_all(RUN_INTERFACE.bytes())
    expected.push_all([0x05, 0x01, 0x00])
    assert_bytes(encode_component(component), expected)
}

// `wasi:cli/stdout@0.3.0` as the program calls it: each type defined before the
// first that names it, the enum exported under its name, as `wasm-tools` encodes
// each of them.
@test
test_instance_type_exports_the_enum_its_function_names :: fn() -> void {
    error_code :: WitEnum { .name = "error-code", .cases = ["io", "illegal-byte-sequence", "pipe"] }
    write :: ComponentFunction {
        .name = "write-via-stream",
        .type = WitFunction {
            .params = [WitParam { .name = "data", .type = WitStream { .element = .U8 } }],
            .result = WitFuture { .value = WitResult { .error = error_code } },
        },
    }
    stdout :: ComponentInterface { .name = "wasi:cli/stdout@0.3.0", .functions = [write] }
    expected: u8[]: [0x01, 0x42, 0x07]
    expected.push_all([0x01, 0x66, 0x01, 0x7D])
    expected.push_all([0x01, 0x6D, 0x03])
    for c in error_code.cases {
        expected.push_name(c)
    }
    expected.push_all([0x04, 0x00])
    expected.push_name("error-code")
    expected.push_all([0x03, 0x00, 0x01])
    expected.push_all([0x01, 0x6A, 0x00, 0x01, 0x02])
    expected.push_all([0x01, 0x65, 0x01, 0x03])
    expected.push_all([0x01, 0x40, 0x01])
    expected.push_name("data")
    expected.push_all([0x00, 0x00, 0x04])
    expected.push_all([0x04, 0x00])
    expected.push_name("write-via-stream")
    expected.push_all([0x01, 0x05])
    assert_bytes(instance_types([instance_scope_of(stdout, [], Map<string, i64> {})]), expected)
}
