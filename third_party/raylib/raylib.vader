// third_party/raylib/raylib: Vader binding to raylib, a library for games and
// graphics programs.
//
// Covers what the examples use. Each function keeps raylib's behaviour under a
// snake_case name. raylib's colours are macros, with no symbol to bind, so the
// constants below restate their values. Vector arithmetic is in `math.vader`.
//
// raylib passes its structs by value and ships as a static archive, neither of
// which the VM's trampolines reach: under `vader run` every call goes through an
// adapter compiled with `cc` (`vader/vm/adapters.vader`). Where each archive
// comes from is in README.md.

module "raylib"

import "std/ffi"
import "std/target"

// ---- library --------------------------------------------------------------

/// raylib, linked statically from the archive shipped beside this module.
///
/// The archives load OpenGL and the window system themselves (`dlopen` on
/// Linux), so a build machine needs no OpenGL development package. On Linux,
/// raylib's image clipboard calls X11 directly, hence `"X11"` below; README.md
/// says what that asks of a build machine.
export RAYLIB: CLibrary: CLibrary {
    .name = "raylib",
    .header = "raylib.h",
    .include = "include",
    .archives = ["lib/${VADER_OS}-${VADER_ARCH}/libraylib.a"],
    .system = match VADER_OS {
        .Darwin          -> ["Cocoa.framework", "IOKit.framework", "QuartzCore.framework"]
        .Linux           -> ["m", "pthread", "dl", "rt", "X11"]
        .Windows         -> ["opengl32", "gdi32", "winmm"]
        .Wasi | .Browser -> []
    },
}

// ---- types ----------------------------------------------------------------

/// An RGBA colour, 8 bits per channel.
@c_struct
export Color :: struct {
    r: u8
    g: u8
    b: u8
    a: u8
}

/// A point or a vector on the screen, in pixels.
@c_struct
export Vector2 :: struct {
    x: f32
    y: f32
}

/// A point or a vector in 3D space.
@c_struct
export Vector3 :: struct {
    x: f32
    y: f32
    z: f32
}

/// A rectangle on the screen or in a texture, in pixels.
@c_struct
export Rectangle :: struct {
    x: f32
    y: f32
    width: f32
    height: f32
}

/// A texture in GPU memory. Read `width` and `height`; the rest is raylib's.
@c_struct
export Texture2D :: struct {
    /// OpenGL texture id, 0 when loading failed.
    id: u32
    width: i32
    height: i32
    mipmaps: i32
    /// A raylib `PixelFormat` value.
    format: i32
}

/// An image in CPU memory, decoded and not yet on the GPU. raylib owns its
/// pixels until `UnloadImage`.
@c_struct
Image :: struct {
    data: CPointer
    width: i32
    height: i32
    mipmaps: i32
    format: i32
}

/// Audio samples in CPU memory, decoded and not yet playable. raylib owns
/// `data` until `UnloadWave`.
@c_struct
Wave :: struct {
    frameCount: u32
    sampleRate: u32
    sampleSize: u32
    channels: u32
    data: CPointer
}

/// The stream a sound plays through. Every member is raylib's.
@c_struct
export AudioStream :: struct {
    buffer: CPointer
    processor: CPointer
    sampleRate: u32
    sampleSize: u32
    channels: u32
}

/// A sound held in memory, ready to play over and over.
@c_struct
export Sound :: struct {
    stream: AudioStream
    frameCount: u32
}

/// The keys this binding names, by their GLFW key codes, which raylib reuses.
///
/// A letter names a key by where it sits on a US keyboard, whatever the layout
/// prints on it: `W` is the key an AZERTY keyboard labels Z.
export KeyboardKey :: enum(i32) {
    /// No key: given to `set_exit_key`, no key closes the window.
    Null        = 0,
    Space       = 32,
    A           = 65,
    D           = 68,
    E           = 69,
    M           = 77,
    P           = 80,
    Q           = 81,
    S           = 83,
    W           = 87,
    Escape      = 256,
    Enter       = 257,
    Right       = 262,
    Left        = 263,
    Down        = 264,
    Up          = 265,
    F11         = 300,
    LeftControl = 341,
}

/// The mouse buttons this binding names, by raylib's numbers.
export MouseButton :: enum(i32) {
    Left = 0,
}

// ---- colours --------------------------------------------------------------

/// raylib's off-white, its usual background.
export RAYWHITE :: Color {
    .r = 245,
    .g = 245,
    .b = 245,
    .a = 255,
}

/// Opaque white: as a tint, it leaves a texture unchanged.
export WHITE :: Color {
    .r = 255,
    .g = 255,
    .b = 255,
    .a = 255,
}

/// Opaque black.
export BLACK :: Color {
    .r = 0,
    .g = 0,
    .b = 0,
    .a = 255,
}

/// A dark grey for text.
export DARKGRAY :: Color {
    .r = 80,
    .g = 80,
    .b = 80,
    .a = 255,
}

// ---- window ---------------------------------------------------------------

/// Open a window and create its OpenGL context.
@extern(RAYLIB, "InitWindow")
export init_window :: fn(width: i32, height: i32, title: string) -> void

/// Whether `init_window` opened the window: it fails on a machine with no display
/// to open one on, and logs why.
@extern(RAYLIB, "IsWindowReady")
export is_window_ready :: fn() -> bool

/// Close the window and release its OpenGL context.
@extern(RAYLIB, "CloseWindow")
export close_window :: fn() -> void

/// Whether the user asked to close the window: its close button, or the exit key
/// (Escape unless `set_exit_key` named another).
@extern(RAYLIB, "WindowShouldClose")
export window_should_close :: fn() -> bool

/// Let the user resize the window, given to `set_config_flags`.
export FLAG_WINDOW_RESIZABLE: u32: 0x0000_0004

/// Set how the window is created: the `FLAG_*` values, or-ed together. Takes
/// effect at the next `init_window`.
@extern(RAYLIB, "SetConfigFlags")
export set_config_flags :: fn(flags: u32) -> void

/// Name the key that makes `window_should_close` true; `.Null` for none.
@extern(RAYLIB, "SetExitKey")
export set_exit_key :: fn(key: KeyboardKey) -> void

/// Switch between a window and a borderless window covering the whole monitor.
@extern(RAYLIB, "ToggleBorderlessWindowed")
export toggle_borderless_windowed :: fn() -> void

/// The window's width, in screen coordinates: what `draw_text` and the other
/// draw calls are placed in.
@extern(RAYLIB, "GetScreenWidth")
export get_screen_width :: fn() -> i32

/// The window's height, in screen coordinates.
@extern(RAYLIB, "GetScreenHeight")
export get_screen_height :: fn() -> i32

/// Cap the frame rate: `end_drawing` waits out the rest of each frame.
@extern(RAYLIB, "SetTargetFPS")
export set_target_fps :: fn(fps: i32) -> void

/// Seconds the last frame took, to scale movement by.
@extern(RAYLIB, "GetFrameTime")
export get_frame_time :: fn() -> f32

/// Save what the window shows as an image file, in the working directory: raylib
/// keeps only the file name of `file_name`, and its extension picks the format.
@extern(RAYLIB, "TakeScreenshot")
export take_screenshot :: fn(file_name: string) -> void

/// Hide the cursor and keep it in the window, so that the mouse turns the view
/// instead of leaving it.
@extern(RAYLIB, "DisableCursor")
export disable_cursor :: fn() -> void

/// Show the cursor again and let it leave the window.
@extern(RAYLIB, "EnableCursor")
export enable_cursor :: fn() -> void

// ---- drawing --------------------------------------------------------------

/// Start a frame. Every draw call sits between this and `end_drawing`.
@extern(RAYLIB, "BeginDrawing")
export begin_drawing :: fn() -> void

/// Show the frame, then wait for the next one.
@extern(RAYLIB, "EndDrawing")
export end_drawing :: fn() -> void

/// Fill the whole frame with one colour.
@extern(RAYLIB, "ClearBackground")
export clear_background :: fn(color: Color) -> void

/// Draw `text` in raylib's default font, its top-left corner at `x`, `y`.
@extern(RAYLIB, "DrawText")
export draw_text :: fn(text: string, x: i32, y: i32, font_size: i32, color: Color) -> void

/// The width `text` takes drawn at `font_size` with raylib's default font, in
/// pixels.
@extern(RAYLIB, "MeasureText")
export measure_text :: fn(text: string, font_size: i32) -> i32

/// Draw the current frame rate, its top-left corner at `x`, `y`.
@extern(RAYLIB, "DrawFPS")
export draw_fps :: fn(x: i32, y: i32) -> void

/// How many frames were drawn over the last second.
@extern(RAYLIB, "GetFPS")
export get_fps :: fn() -> i32

// ---- textures -------------------------------------------------------------

@extern(RAYLIB, "LoadImageFromMemory")
load_image_from_memory :: fn(file_type: string, data: u8[], size: i32) -> Image

@extern(RAYLIB, "GenImageColor")
gen_image_color :: fn(width: i32, height: i32, color: Color) -> Image

@extern(RAYLIB, "LoadTextureFromImage")
load_texture_from_image :: fn(image: Image) -> Texture2D

@extern(RAYLIB, "UnloadImage")
unload_image :: fn(image: Image) -> void

@extern(RAYLIB, "IsImageValid")
is_image_valid :: fn(image: Image) -> bool

@extern(RAYLIB, "IsTextureValid")
is_texture_valid :: fn(texture: Texture2D) -> bool

/// Load an image file held in memory into GPU memory: one baked into the program
/// by `@comptime`, which then needs no file beside it.
///
/// @param file_type  the file's extension, dot included: `".png"`.
/// @param data       the file's bytes.
/// @return           the texture, or `null` when the bytes do not decode
///                   (raylib logs why).
export load_texture_from_memory :: fn(file_type: string, data: u8[]) -> Texture2D | null {
    image :: load_image_from_memory(file_type, data, i32(data.len()))
    if !is_image_valid(image) {
        return null
    }
    texture :: load_texture_from_image(image)
    unload_image(image)
    if !is_texture_valid(texture) {
        return null
    }
    return texture
}

/// A black texture of `width` by `height` pixels in GPU memory, in raylib's RGBA
/// layout: `update_texture` then fills it with one RGBA pixel per `u32`.
export load_blank_texture :: fn(width: i32, height: i32) -> Texture2D {
    image :: gen_image_color(width, height, BLACK)
    texture :: load_texture_from_image(image)
    unload_image(image)
    return texture
}

/// Release a texture's GPU memory.
@extern(RAYLIB, "UnloadTexture")
export unload_texture :: fn(texture: Texture2D) -> void

/// Draw a texture, its top-left corner at `position`.
///
/// @param tint  multiplied into every pixel; `WHITE` draws the texture as is.
@extern(RAYLIB, "DrawTextureV")
export draw_texture_v :: fn(texture: Texture2D, position: Vector2, tint: Color) -> void

/// Draw the part `source` of a texture into `target`, scaled to fit it.
///
/// @param origin    the point of `target` that `rotation` turns around, from its
///                  top-left corner.
/// @param rotation  in degrees, clockwise.
/// @param tint      multiplied into every pixel; `WHITE` draws the texture as is.
@extern(RAYLIB, "DrawTexturePro")
export draw_texture_pro :: fn(
    texture: Texture2D,
    source: Rectangle,
    target: Rectangle,
    origin: Vector2,
    rotation: f32,
    tint: Color,
) -> void

/// Replace every pixel of a texture: `pixels` holds one RGBA pixel per `u32`,
/// red in the low byte, row-major, `width * height` of them.
@extern(RAYLIB, "UpdateTexture")
export update_texture :: fn(texture: Texture2D, pixels: u32[]) -> void

// ---- input ----------------------------------------------------------------

/// Whether `key` is held down during this frame.
@extern(RAYLIB, "IsKeyDown")
export is_key_down :: fn(key: KeyboardKey) -> bool

/// Whether `key` went down during this frame: once per press, however long it
/// is held.
@extern(RAYLIB, "IsKeyPressed")
export is_key_pressed :: fn(key: KeyboardKey) -> bool

/// How far the mouse moved since the last frame, in pixels.
@extern(RAYLIB, "GetMouseDelta")
export get_mouse_delta :: fn() -> Vector2

/// Whether `button` is held down during this frame.
@extern(RAYLIB, "IsMouseButtonDown")
export is_mouse_button_down :: fn(button: MouseButton) -> bool

// ---- audio ----------------------------------------------------------------

/// Open the default audio device: `load_sound_from_memory` and `play_sound`
/// need it open.
@extern(RAYLIB, "InitAudioDevice")
export init_audio_device :: fn() -> void

/// Close the audio device, once every sound is unloaded.
@extern(RAYLIB, "CloseAudioDevice")
export close_audio_device :: fn() -> void

/// Scale the volume of every sound, those already playing included: `1.0` plays
/// them as recorded. The audio device must be open.
@extern(RAYLIB, "SetMasterVolume")
export set_master_volume :: fn(volume: f32) -> void

@extern(RAYLIB, "LoadWaveFromMemory")
load_wave_from_memory :: fn(file_type: string, data: u8[], size: i32) -> Wave

@extern(RAYLIB, "LoadSoundFromWave")
load_sound_from_wave :: fn(wave: Wave) -> Sound

@extern(RAYLIB, "UnloadWave")
unload_wave :: fn(wave: Wave) -> void

@extern(RAYLIB, "IsWaveValid")
is_wave_valid :: fn(wave: Wave) -> bool

/// Load a sound file held in memory: one baked into the program by `@comptime`,
/// which then needs no file beside it.
///
/// @param file_type  the file's extension, dot included: `".wav"`.
/// @param data       the file's bytes.
/// @return           the sound, or `null` when the bytes do not decode (raylib
///                   logs why).
export load_sound_from_memory :: fn(file_type: string, data: u8[]) -> Sound | null {
    wave :: load_wave_from_memory(file_type, data, i32(data.len()))
    if !is_wave_valid(wave) {
        return null
    }
    sound :: load_sound_from_wave(wave)
    unload_wave(wave)
    return sound
}

/// Release a sound's memory.
@extern(RAYLIB, "UnloadSound")
export unload_sound :: fn(sound: Sound) -> void

/// Play a sound from its start, cutting it short if it is still playing.
@extern(RAYLIB, "PlaySound")
export play_sound :: fn(sound: Sound) -> void
