#!/usr/bin/env bash
# Refuse to publish a commit whose committed C seed is stale.
#
# WHY. The seed used to be regenerated after every chantier — ~10 reseeds a day
# against ~1.5 pushes. Measured on 8 real consecutive seeds over the same
# development interval, batching to one reseed per push takes the accumulated
# history from 460 KB to 60 KB (−87 %). Moving the reseed to the push boundary is
# what produces that batching ; this hook is what keeps the resulting invariant
# honest:
#
#     every PUSHED commit carries a byte-fresh seed.
#
# Intermediate *local* commits may carry a slightly stale one. That is fine and is
# the whole point: a stale seed still builds the tree, which the CI `seed-rebuild`
# job proves on every push.
#
# The freshness question itself belongs to `bootstrap/seed.sh check` — including its
# cheap git-only path, so a docs-only push costs no compile at all.
#
# The happy path in one command:  bootstrap/seed.sh push
# To publish anyway:              git push --no-verify
#
# Installed via `git config core.hooksPath .githooks` — see bootstrap/README.md.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ -t 2 ]; then bold='\033[1m'; yellow='\033[1;33m'; reset='\033[0m'; else bold=''; yellow=''; reset=''; fi
log() { printf '%b[pre-push]%b %s\n' "$1" "$reset" "$2" >&2; }

# ---- is this push even publishing HEAD? -----------------------------------

# git feeds us one `<local ref> <local sha> <remote ref> <remote sha>` line per
# ref. A tag of an older commit, or a branch deletion, says nothing about the seed
# at HEAD — don't vet those. Defaults to vetting, so an empty stdin (or a shape we
# don't recognise) errs towards checking rather than towards silence.
head_sha="$(git rev-parse HEAD)"
vet=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  vet=0
  if [ "$local_sha" = "$head_sha" ]; then
    vet=1
    break
  fi
done
if [ "$vet" = 0 ]; then
  exit 0
fi

# ---- ask the one script that owns the question ----------------------------

# stdout carries the resolved compiler path, which is of no interest here — only
# the verdict (exit code) and the diagnosis (stderr) are.
set +e
./bootstrap/seed.sh check >/dev/null
verdict=$?
set -e

case "$verdict" in
  0) exit 0 ;;
  2)
    # Could not conclude. Warn, but let the push through: demanding a full
    # `bun run build` (~1 min 40) before every push would cost far more than the
    # ~60 KB a missed reseed adds, and CI still checks that the seed can build the
    # tree on every push.
    log "$yellow" "letting the push through — 'unknown' is not 'stale'."
    exit 0
    ;;
esac

log "$bold" "STALE SEED — bootstrap/bootstrap.c no longer matches bootstrap.vader."
log "$bold" ""
log "$bold" "  Every pushed commit is meant to carry a byte-fresh seed. Reseed, then push:"
log "$bold" ""
log "$bold" "    bootstrap/seed.sh regenerate"
log "$bold" "    git commit -m 'chore(bootstrap): bump seed' bootstrap/bootstrap.c bootstrap/VERSION"
log "$bold" "    git push"
log "$bold" ""
log "$bold" "  Or in one command:  bootstrap/seed.sh push"
log "$bold" "  To publish anyway:  git push --no-verify"
exit 1
