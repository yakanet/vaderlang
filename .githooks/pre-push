#!/usr/bin/env bash
# Refuse to publish a commit whose committed C seed is stale.
#
# WHY. The seed used to be regenerated after every chantier — ~10 reseeds a day
# against ~1.5 pushes. Measured on 8 real consecutive seeds over the same
# development interval, batching to one reseed per push takes the accumulated
# history from 460 KB to 60 KB (−87 %). Moving the reseed to the push boundary is
# what produces that batching ; this hook is what keeps the resulting invariant
# honest:
#
#     every PUSHED commit carries a byte-fresh seed.
#
# Intermediate *local* commits may carry a slightly stale one. That is fine and
# is the whole point: a stale seed still builds the tree, which the CI
# `seed-rebuild` job proves on every push.
#
# The happy path in one command:  bootstrap/push.sh
# To publish anyway:              git push --no-verify
#
# Installed via `git config core.hooksPath .githooks` — see bootstrap/README.md.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ -t 2 ]; then b='\033[1m'; y='\033[1;33m'; r='\033[0m'; else b=''; y=''; r=''; fi
say()  { printf '%b[pre-push]%b %s\n' "$b" "$r" "$*" >&2; }
warn() { printf '%b[pre-push]%b %s\n' "$y" "$r" "$*" >&2; }

# ---- is this push even publishing HEAD? -----------------------------------

# git feeds us one `<local ref> <local sha> <remote ref> <remote sha>` line per
# ref. A tag of an older commit, or a branch deletion, says nothing about the
# seed at HEAD — don't vet those.
head_sha="$(git rev-parse HEAD)"
saw_line=0
pushing_head=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  saw_line=1
  if [ "$local_sha" = "$head_sha" ]; then
    pushing_head=1
  fi
done
if [ "$saw_line" = 1 ] && [ "$pushing_head" = 0 ]; then
  exit 0
fi

# ---- cheap short-circuit --------------------------------------------------

# If nothing the emitted C could depend on has changed since the last reseed,
# the seed is fresh and there is nothing to compile.
#
# The path set is deliberately BROAD — all of vader/, stdlib/, runtime/c/ —
# rather than bootstrap.vader's actual import closure. A hand-maintained closure
# list would silently rot the day an import changes, and a false "fresh" is
# precisely the answer this hook must never give. Being over-conservative only
# costs the few seconds of the real check below, and this still short-circuits
# the common docs- / tests- / plans-only push to zero.
last_reseed="$(git rev-list -1 HEAD -- bootstrap/bootstrap.c || true)"
if [ -n "$last_reseed" ] &&
   [ -z "$(git diff --name-only "$last_reseed" HEAD -- vader/ stdlib/ runtime/c/)" ]; then
  exit 0
fi

# ---- the real check -------------------------------------------------------

# check-seed.sh reports its own diagnosis on stderr, so call it exactly once —
# it costs a full seed re-emission (~4 s) and running it twice for a nicer
# message would be silly.
set +e
./bootstrap/check-seed.sh
verdict=$?
set -e

case "$verdict" in
  0) exit 0 ;;
  2)
    # Could not conclude. Warn, but let the push through: demanding a full
    # `bun run build` (~1 min 40) before every push would cost far more than the
    # ~60 KB a missed reseed adds, and CI still checks that the seed can build
    # the tree on every push.
    warn "letting the push through — 'unknown' is not 'stale'."
    exit 0
    ;;
esac

say "STALE SEED — bootstrap/bootstrap.c no longer matches bootstrap.vader."
say ""
say "  Every pushed commit is meant to carry a byte-fresh seed. Reseed, then push:"
say ""
say "    bootstrap/regenerate.sh"
say "    git commit -m 'chore(bootstrap): bump seed' bootstrap/bootstrap.c bootstrap/VERSION"
say "    git push"
say ""
say "  Or in one command:  bootstrap/push.sh"
say "  To publish anyway:  git push --no-verify"
exit 1
